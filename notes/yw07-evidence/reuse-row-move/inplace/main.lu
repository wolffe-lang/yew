struct Match { pos: List[int] }

struct Row {
    bytes: List[byte],
    ranked: List[byte],
    suffix: List[byte],
    m: Match,
    detail: str,
    kind: int,
    score: int,
    offset: int,
    flag: bool,
}

struct Rows {
    items: List[Row],
    spare: List[Row],
}

fn empty() -> Row {
    Row { bytes: List[byte](), ranked: List[byte](), suffix: List[byte](), m: Match { pos: List[int]() },
        detail: "", kind: 0, score: 0, offset: 0, flag: false }
}

fn reserve(mut pool: Rows, n: int) {
    (mut pool.items).reserve(n)
    while pool.items.len < n { (mut pool.items).push(empty()) }
}

fn bytes_refill(mut dst: List[byte], src: List[byte]) {
    (mut dst).reset()
    (mut dst).reserve(src.len)
    for b in src { (mut dst).push(b) }
}

fn refill_inside(mut pool: Rows, source: List[Row]) {
    for i in 0..source.len {
        bytes_refill(mut pool.items[i].bytes, source[i].bytes)
        bytes_refill(mut pool.items[i].ranked, source[i].ranked)
        bytes_refill(mut pool.items[i].suffix, source[i].suffix)
        (mut pool.items[i].m.pos).reset()
        (mut pool.items[i].m.pos).reserve(source[i].m.pos.len)
        for pos in source[i].m.pos { (mut pool.items[i].m.pos).push(pos) }
        pool.items[i].detail = "owned"
        pool.items[i].score = source[i].score
    }
}

fn refill(mut pool: Rows, n: int) {
    reserve(mut pool, n)
    region scratch {
        var source = List[Row]()
        for i in 0..n {
            var row = empty()
            for b in "payload".bytes() {
                (mut row.bytes).push(b)
                (mut row.ranked).push(b)
                (mut row.suffix).push(b)
            }
            (mut row.m.pos).push(i)
            row.score = i
            (mut source).push(row)
        }
        refill_inside(mut pool, source)
    }
}

fn main() {
    var pool = Rows { items: List[Row](), spare: List[Row]() }
    for _ in 0..100 {
        refill(mut pool, 2)
        refill(mut pool, 1)
        assert(pool.items[0].bytes.len == 7)
        assert(pool.items[0].bytes[0] == 112 as byte)
    }
    print("two-list row refill: PASS")
}
