use vmlib

fn add(mut vm: vmlib.Vm, n: int) -> int {
    (mut vm.stack).push(n)
    vm.total += n
    vm.total
}

fn main() {
    var natives = List[vmlib.Native]()
    (mut natives).push(vmlib.Native { invoke: add })
    var vm = vmlib.Vm { stack: List[int](), natives: natives, total: 0 }
    assert(vmlib.call(mut vm, 0, 7) == 7)
    assert(vmlib.call(mut vm, 0, 5) == 12)
    assert(vm.stack.len == 2 && vm.stack[0] == 7 && vm.stack[1] == 5)
    print("mut-vm: 12, two pushes: PASS")
}
