/// The toy native table has the same mutable-owner seam the real VM needs.
pub struct Vm {
    stack: List[int],
    natives: List[Native],
    total: int,
}

/// One native, stored by its owning VM rather than process-global state.
pub struct Native {
    invoke: fn(Vm, int) -> int,
}

/// Call a table value after binding its type explicitly (G47).
pub fn call(mut vm: Vm, which: int, n: int) -> int {
    let invoke = vm.natives[which].invoke
    invoke(mut vm, n)
}
