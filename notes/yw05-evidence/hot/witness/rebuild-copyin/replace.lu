//! yw05-hot's witness (deliverable 6, the prompt's per-keystroke rebuild):
//! at wolf 0.2.34 a rebuild's rows reach a session-long value only by an
//! allocation in the session's region. `replace.lu` is yw04's form (the
//! rows built in a `copy region`, then assigned): it compiles, and every
//! rebuild's copy-out is held to the end (VmRSS grows with the
//! rebuilds, `run.txt`). `copyin.lu` writes the region's rows INTO the
//! value's existing rows instead (clear and push, the storage reused),
//! which would allocate nothing once the rows have grown: E1010, the
//! value "still holds a value allocated in region" (a push may grow the
//! outer list inside the region: wolf-lang#839's [mem.region.outer-write],
//! with `List.reset`/`reserve`, is s255's, wolf 0.2.35). The editor's
//! menu rows (`edit.cmdline_comp`'s `cl_refilter_as`) are this shape.

struct Item {
    text: List[byte],
    score: int,
}

struct S {
    items: List[Item],
}

fn build(n: int, salt: int) -> List[Item] {
    copy region rows {
        var out = List[Item]()
        var i = 0
        while i < n {
            var t = List[byte]()
            var k = 0
            while k < 12 {
                (mut t).push((97 + (i + k + salt) % 26) as byte)
                k += 1
            }
            (mut out).push(Item { text: t, score: i })
            i += 1
        }
        out
    }
}

fn rss_kb() -> int {
    let s = fs_read_text("/proc/self/status") else ""
    for line in s.split("\n") {
        if line.starts_with("VmRSS:") {
            var n = 0
            for b in line.bytes() {
                if b >= 48 as byte && b <= 57 as byte {
                    n = n * 10 + (b as int - 48)
                }
            }
            return n
        }
    }
    -1
}

fn main() {
    var s = S { items: build(50, 0) }
    let r0 = rss_kb()
    var k = 0
    while k < 20000 {
        s.items = build(50, k)
        k += 1
    }
    let r1 = rss_kb()
    print("replace: {s.items.len} rows, {(r1 - r0) * 1024 / 20000} B a rebuild held")
}
