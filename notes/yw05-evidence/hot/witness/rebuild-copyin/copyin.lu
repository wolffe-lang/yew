//! yw05-hot's witness: the copy-in form of `replace.lu` (its header says
//! what this shows). Expected: E1010.

struct Item {
    text: List[byte],
    score: int,
}

struct S {
    items: List[Item],
}

fn refill(mut s: S, n: int, salt: int) {
    region rows {
        var fresh = List[Item]()
        var i = 0
        while i < n {
            var t = List[byte]()
            var k = 0
            while k < 12 {
                (mut t).push((97 + (i + k + salt) % 26) as byte)
                k += 1
            }
            (mut fresh).push(Item { text: t, score: i })
            i += 1
        }
        var j = 0
        while j < fresh.len && j < s.items.len {
            while s.items[j].text.len != 0 {
                let _ = (mut s.items[j].text).pop() else 0 as byte
            }
            for b in fresh[j].text {
                (mut s.items[j].text).push(b)
            }
            s.items[j].score = fresh[j].score
            j += 1
        }
    }
}

fn main() {
    var s = S { items: List[Item]() }
    var i = 0
    while i < 50 {
        (mut s.items).push(Item { text: List[byte](), score: 0 })
        i += 1
    }
    var k = 0
    while k < 20000 {
        refill(mut s, 50, k)
        k += 1
    }
    print("copyin: {s.items.len} rows, {s.items[0].score}")
}
