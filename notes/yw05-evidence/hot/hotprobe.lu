//! member: false
//!
//! yw05-hot: the in-process memory probe of deliverable 6 (yw04's
//! `notes/yw04-evidence/prompt/memprobe.lu`, widened to one row per draw
//! component). VmRSS growth per call of each piece of a frame, over the
//! driver's session (`driver.lu`'s `ed_run` without the terminal: the
//! config read, a real file, not `--clean`, 24x80, truecolor) — so the
//! PTY drivers' B/key can be split into its parts. A diagnostic, not the
//! measurement of record (that is `ptymem-hot.py`, C beside the port).
//!
//! Run (bin-hot/probe.sh does it): copy to `src/zzhot_probe.lu`, copy
//! README.md to `target/verify/hot-*.txt`, `.wolf-bin/wolf build [--release]
//! src/zzhot_probe.lu -o target/verify/zzhot`, run from the tree root in
//! the container, delete the copy. `zzhot PHASE` runs one phase, `zzhot`
//! every one, each over a fresh editor and a fresh copy of the file.

use edit
use term
use text

fn rss_kb() -> int {
    let s = fs_read_text("/proc/self/status") else ""
    for line in s.split("\n") {
        if line.starts_with("VmRSS:") {
            var n = 0
            for b in line.bytes() {
                if b >= 48 as byte && b <= 57 as byte {
                    n = n * 10 + (b as int - 48)
                }
            }
            return n
        }
    }
    -1
}

// The driver's session (driver.lu's ed_run) without the terminal, over a
// fresh copy of README.md named for the phase.
fn init_real(tag: str, src: str) -> edit.Ed {
    let path = "target/verify/hot-{tag}.txt"
    let body = fs_read_bytes(src) else List[byte]()
    fs_write_bytes(path, body) else |_| {
        print("zzhot: cannot write {path}")
    }
    var ed = edit.ed_new()
    ed.clean = false
    ed.ws_dir = text.file_realpath(".") else "."
    var caps = term.caps_new()
    caps.truecolor = true
    ed.input = term.input_new(caps)
    ed.input_ready = true
    edit.ed_open_scratch(mut ed)
    let bootstrap = ed.tabs[0].tab_id
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    ed.render = term.render_new(caps, term.env_process())
    ed.render_ready = true
    var st = edit.startup_default()
    st.clean = false
    edit.ed_load_config(mut ed, st)
    let idx = edit.tab_open(mut ed, path)
    assert(idx >= 0 && edit.tab_hydrate(mut ed, idx) == 0, "the file opens")
    edit.tab_switch(mut ed, idx)
    if ed.tabs.len > 1 {
        let b = edit.tab_index_of_id(ed, bootstrap)
        if b >= 0 {
            let _ = edit.tab_close(mut ed, b)
        }
    }
    edit.ed_layout(mut ed)
    edit.ed_render(mut ed)
    ed
}

// One turn of the loop after its read (`loop.lu`'s `loop_turn`, from its
// pub pieces): the bytes fed, every event dispatched, the tick, the
// timers, the completion pump, layout, one render.
fn turn(mut ed: edit.Ed, mut key: term.Key, now: int, bytes: List[byte]) {
    turn_r(mut ed, mut key, now, bytes, true)
}

// The turn, its render left out when `render` is false (the prompt's own
// work, apart from the frame it asks for).
fn turn_r(mut ed: edit.Ed, mut key: term.Key, now: int, bytes: List[byte], render: bool) {
    let raw = bytes.len > 0
    if raw {
        term.input_feed(mut ed.input, bytes, 0, bytes.len)
    }
    ed.now_ms = now
    var had = false
    while term.input_next(mut ed.input, now, mut key) {
        had = true
        edit.loop_dispatch_event(mut ed, key, now)
    }
    edit.dispatch_tick(mut ed, now)
    edit.ed_timers_fire(mut ed, now)
    let _ = edit.cmdline_comp_tick(mut ed)
    if !had && !raw {
        let _ = edit.cmdline_comp_idle(mut ed)
    }
    if ed.layout_dirty {
        edit.ed_layout(mut ed)
    }
    if render {
        edit.ed_render(mut ed)
    }
}

fn bytes1(c: int) -> List[byte] {
    var v = List[byte]()
    (mut v).push(c as byte)
    v
}

fn bytes3(a: int, b: int, c: int) -> List[byte] {
    var v = List[byte]()
    (mut v).push(a as byte)
    (mut v).push(b as byte)
    (mut v).push(c as byte)
    v
}

fn clear_frame(mut ed: edit.Ed) {
    while ed.frame.len != 0 {
        let _ = (mut ed.frame).pop() else 0 as byte
    }
}

// One call of component `what` (the editor already in the phase's state).
fn component(mut ed: edit.Ed, what: str) {
    let wi = ed.win
    if what == "full" {
        ed.full_damage = true
        edit.ed_render(mut ed)
    } else if what == "doc" {
        edit.draw_document_rows(mut ed, wi, 0, ed.wins[wi].rect.h)
    } else if what == "gutter" {
        edit.gutter_draw(mut ed, wi, 0, ed.wins[wi].rect.h)
    } else if what == "footer" {
        edit.draw_footer(mut ed, wi)
    } else if what == "strip" {
        let tr = copy ed.tab_strip_rect
        edit.tab_strip_draw(mut ed, tr)
    } else if what == "panes" {
        edit.draw_panes(mut ed)
    } else if what == "cursor" {
        edit.draw_cursor(mut ed, wi)
    } else if what == "frame" {
        term.grid_mark_all(mut ed.grid)
        clear_frame(mut ed)
        let _ = term.render_frame(mut ed.render, ed.grid, mut ed.frame)
    } else if what == "flip" {
        term.grid_mark_all(mut ed.grid)
        term.grid_flip(mut ed.grid)
    } else if what == "idle" {
        edit.ed_render(mut ed)
    }
}

// Component `what`, `n` calls after 20 warm ones; prompt open when asked.
// The editor lives in region `p`, so the ledger (`region_bytes`) counts
// every byte the calls allocate, exactly; VmRSS is read beside it. The
// ledger's units are per tier: compare relations (0 is 0 on every tier).
fn comp(what: str, n: int, prompt: bool, pane2: bool, src: str) {
    let tag = "c-{what}-{if prompt then 1 else 0}-{if pane2 then 1 else 0}"
    var ledger = 0
    var r0 = 0
    var r1 = 0
    var panes = 0
    region p {
        var ed = init_real(tag, src)
        var key = term.key_new()
        var now = 1000
        if pane2 {
            turn(mut ed, mut key, now, bytes1(23))
            now += 30
            turn(mut ed, mut key, now, bytes1(115))
            now += 30
        }
        turn(mut ed, mut key, now, bytes1(if prompt then 58 else 27))
        var i = 0
        while i < 20 {
            component(mut ed, what)
            i += 1
        }
        r0 = rss_kb()
        let b0 = region_bytes(p)
        i = 0
        while i < n {
            component(mut ed, what)
            i += 1
        }
        ledger = region_bytes(p) - b0
        r1 = rss_kb()
        panes = ed.wins.len
    }
    print(
        "zzhot: comp {what} prompt={prompt} panes={panes} n={n}: ledger {ledger / n} B/call, rss {(r1 - r0) * 1024 / n} B/call (rss {r0} -> {r1} kb)",
    )
}

// `n` keys of phase `ph` through the turn, after 20 warm ones (the
// ledger and VmRSS as `comp`).
fn keys(ph_in: str, n: int, src: str) {
    let render = !ph_in.ends_with("-norender")
    let ph = if render then ph_in else ph_in[0..ph_in.len - 9]
    var ledger = 0
    var r0 = 0
    var r1 = 0
    var panes = 0
    var active = false
    var flen = 0
    region p {
        var ed = init_real("k-{ph_in}", src)
        var key = term.key_new()
        var now = 1000
        let pane2 = ph.starts_with("pane-")
        if pane2 {
            turn(mut ed, mut key, now, bytes1(23))
            now += 30
            turn(mut ed, mut key, now, bytes1(115))
            now += 30
        }
        let prompt = ph.ends_with("prompt-menu") || ph.ends_with("prompt-type")
        if prompt {
            turn(mut ed, mut key, now, bytes1(58))
            now += 30
        } else if ph.ends_with("type") {
            turn(mut ed, mut key, now, bytes1(105))
            now += 30
        }
        var b0 = 0
        var i = 0
        while i < n + 20 {
            if i == 20 {
                r0 = rss_kb()
                b0 = region_bytes(p)
            }
            let b = if ph.ends_with("prompt-menu") {
                if i % 2 == 0 then bytes1(102) else bytes1(127)
            } else if ph.ends_with("type") {
                if i % 2 == 0 then bytes1(98) else bytes1(97)
            } else if ph.ends_with("arrows") {
                if i / 500 % 2 == 0 then bytes3(27, 91, 66) else bytes3(27, 91, 65)
            } else if ph.ends_with("lines40") {
                if i / 40 % 2 == 0 then bytes3(27, 91, 66) else bytes3(27, 91, 65)
            } else if i / 40 % 2 == 0 then bytes3(27, 91, 67) else bytes3(27, 91, 68)
            now += 30
            turn_r(mut ed, mut key, now, b, render)
            i += 1
        }
        ledger = region_bytes(p) - b0
        r1 = rss_kb()
        panes = ed.wins.len
        active = ed.cmdline.active
        flen = ed.frame.len
    }
    print(
        "zzhot: keys {ph_in} over {src} n={n}: ledger {ledger / n} B/key, rss {(r1 - r0) * 1024 / n} B/key (rss {r0} -> {r1} kb) panes={panes} prompt={active} frame={flen}",
    )
}

// `text.grapheme_next_boundary` over every byte of the buffer, `rounds`
// times: the per-cluster query a non-ASCII document row makes.
fn gnb(rounds: int, src: str) {
    var ledger = 0
    var calls = 0
    region p {
        var ed = init_real("gnb", src)
        let bi = ed.wins[ed.win].buf
        let len = text.textbuf_len(ed.bufs[bi].ec.tb)
        let b0 = region_bytes(p)
        var r = 0
        while r < rounds {
            var pos = 0
            while pos < len {
                pos = text.grapheme_next_boundary(ed.bufs[bi].ec.tb, pos as text.ByteOff) as int
                calls += 1
            }
            r += 1
        }
        ledger = region_bytes(p) - b0
    }
    print("zzhot: gnb calls={calls}: ledger {ledger / calls} B/call")
}

// After-a-key components: each iteration feeds one key of phase `mode`
// without rendering (not counted), then calls component `what` (counted):
// which part of a typed key's frame allocates.
fn after_key(what: str, mode: str, n: int, src: str) {
    var ledger = 0
    region p {
        var ed = init_real("a-{what}-{mode}", src)
        var key = term.key_new()
        var now = 1000
        let prompt = mode.starts_with("prompt-")
        if mode != "lines40" {
            turn(mut ed, mut key, now, bytes1(if prompt then 58 else 105))
        }
        var i = 0
        while i < n + 20 {
            let b = if mode == "prompt-menu" {
                if i % 2 == 0 then bytes1(102) else bytes1(127)
            } else if mode == "lines40" {
                if i / 40 % 2 == 0 then bytes3(27, 91, 66) else bytes3(27, 91, 65)
            } else if i % 2 == 0 then bytes1(98) else bytes1(97)
            now += 30
            turn_r(mut ed, mut key, now, b, false)
            let wi = ed.win
            let bi = ed.wins[wi].buf
            let b0 = region_bytes(p)
            var b1 = 0
            if what == "render" {
                edit.ed_render(mut ed)
                b1 = region_bytes(p)
            } else {
                if what == "follow" {
                    edit.vp_follow(mut ed.wins[wi], ed.bufs[bi].ec.tb)
                } else if what == "gcol" {
                    let pos = ed.wins[wi].cs.curs[ed.wins[wi].cs.primary].pos
                    let line = text.textbuf_line_of(ed.bufs[bi].ec.tb, pos as text.ByteOff)
                    let sp = text.textbuf_line_span(ed.bufs[bi].ec.tb, line)
                    let _ = text.off_to_gcol(mut ed.bufs[bi].ec.tb, sp, pos as text.ByteOff)
                } else if what == "status" {
                    edit.statusline_build_into(mut ed, wi, 80)
                } else if what == "footer" {
                    edit.draw_footer(mut ed, wi)
                } else if what == "doc" {
                    edit.draw_document_rows(mut ed, wi, 0, ed.wins[wi].rect.h)
                } else if what == "cursor" {
                    edit.draw_cursor(mut ed, wi)
                } else if what == "panes" {
                    edit.draw_panes(mut ed)
                } else if what == "parse" {
                    // The refilter's parse of the line (`cmd_parse_point`),
                    // as `cl_refilter_as` asks it once a key.
                    let line = edit.cmdline_text(ed)
                    let caret = edit.cmdline_caret(ed)
                    let pt = edit.cmd_parse_point(mut ed, line, caret) else edit.cmdparsepoint_new()
                    if pt.token_index < -5 {
                        print("?")
                    }
                } else if what == "text" {
                    let line = edit.cmdline_text(ed)
                    if line.len < 0 {
                        print("?")
                    }
                } else if what == "marks" {
                    let m = edit.tab_marks(ed)
                    if m.len > 100000 {
                        print("?")
                    }
                } else if what == "frame" || what == "clip" {
                    // The frame's draws uncounted, then the encoding (or
                    // the clipboard's after-frame pass) counted.
                    edit.draw_panes(mut ed)
                    edit.draw_footer(mut ed, wi)
                    if !ed.cmdline.active {
                        edit.draw_cursor(mut ed, wi)
                    }
                    clear_frame(mut ed)
                    let c0 = region_bytes(p)
                    if what == "frame" {
                        let _ = term.render_frame(mut ed.render, ed.grid, mut ed.frame)
                    } else {
                        text.clip_after_render(mut ed.regs.clip, mut ed.render, mut ed.frame, now)
                    }
                    let c1 = region_bytes(p)
                    if i >= 20 {
                        ledger += c1 - c0
                    }
                    term.grid_flip(mut ed.grid)
                }
                b1 = if what == "frame" || what == "clip" then b0 else region_bytes(p)
                edit.ed_render(mut ed)
            }
            if i >= 20 {
                ledger += b1 - b0
            }
            i += 1
        }
    }
    print(
        "zzhot: after a {mode} key: {what}: ledger {ledger / n} B/key (the render after it not counted)",
    )
}

// The prompt row's parts with `seed` typed at a `:` prompt.
fn prow(seed: str, what: str, n: int, src: str) {
    var ledger = 0
    region p {
        var ed = init_real("p-{what}", src)
        edit.cmdline_open(mut ed, edit.PROMPT_CMD, seed)
        edit.ed_render(mut ed)
        let wi = ed.win
        var i = 0
        while i < n + 3 {
            let b0 = region_bytes(p)
            if what == "footer" {
                edit.draw_footer(mut ed, wi)
            } else if what == "ghost" {
                edit.cmdline_ghost_into(mut ed)
            } else if what == "hist" {
                let (h, _) = edit.cmdline_hist_match(ed)
                if h && n < 0 {
                    print("?")
                }
            } else if what == "sel" {
                let (h, _) = edit.cmdline_selection(ed)
                if h && n < 0 {
                    print("?")
                }
            } else {
                let c = edit.cmdline_caret(ed)
                if c < 0 {
                    print("?")
                }
            }
            if i >= 3 {
                ledger += region_bytes(p) - b0
            }
            i += 1
        }
    }
    print("zzhot: prompt row '{seed}': {what}: ledger {ledger / n} B/call")
}

fn put_str_bytes(mut g: term.Grid, s: str) {
    let _ = term.grid_put(
        mut g,
        3,
        4,
        s.bytes(),
        0,
        s.len,
        term.color_default(),
        term.color_default(),
        0,
    )
}

fn empty_list() -> List[byte] {
    List[byte]()
}

// One grid primitive `n` times in a region: `gput` a two-byte cluster,
// `gputa` one ASCII byte, `gfill` a blank fill of ten cells, `elist` an
// empty `List[byte]` made and dropped; `blit`, `bheap`, `bparam` a cell
// put from a `str`'s `.bytes()` passed as the argument (a literal, a
// built `str`, a literal through a `str` parameter).
fn prim(what: str, n: int) {
    var ledger = 0
    region p {
        var g = term.grid_new(24, 80)
        var e = List[byte]()
        (mut e).push(195 as byte)
        (mut e).push(169 as byte)
        var a = List[byte]()
        (mut a).push(97 as byte)
        let blank = copy g.blank
        let heap = str_from_utf8(a) else "?"
        let b0 = region_bytes(p)
        var i = 0
        while i < n {
            if what == "gput" {
                let _ = term.grid_put(
                    mut g,
                    3,
                    i % 70,
                    e,
                    0,
                    2,
                    term.color_default(),
                    term.color_default(),
                    0,
                )
            } else if what == "gputa" {
                let _ = term.grid_put(
                    mut g,
                    3,
                    i % 70,
                    a,
                    0,
                    1,
                    term.color_default(),
                    term.color_default(),
                    0,
                )
            } else if what == "gfill" {
                term.grid_fill(mut g, 3, 5, 15, copy blank)
            } else if what == "blit" {
                let lit = if i % 2 == 0 then ":" else "/"
                let _ = term.grid_put(
                    mut g,
                    3,
                    4,
                    lit.bytes(),
                    0,
                    1,
                    term.color_default(),
                    term.color_default(),
                    0,
                )
            } else if what == "bheap" {
                let _ = term.grid_put(
                    mut g,
                    3,
                    4,
                    heap.bytes(),
                    0,
                    1,
                    term.color_default(),
                    term.color_default(),
                    0,
                )
            } else if what == "bparam" {
                put_str_bytes(mut g, if i % 2 == 0 then ":" else "/")
            } else {
                let x = empty_list()
                if x.len != 0 {
                    print("?")
                }
            }
            i += 1
        }
        ledger = region_bytes(p) - b0
    }
    print("zzhot: prim {what} n={n}: ledger {ledger / n} B/call ({ledger} total)")
}

fn run(ph: str, src: str) {
    if ph == "prim" {
        prim("gput", 10000)
        prim("gputa", 10000)
        prim("gfill", 10000)
        prim("elist", 10000)
        prim("blit", 10000)
        prim("bheap", 10000)
        prim("bparam", 10000)
    }
    let all = ph == "all"
    if all || ph == "comp" {
        comp("full", 400, false, false, src)
        comp("full", 400, true, false, src)
        comp("doc", 400, false, false, src)
        comp("gutter", 2000, false, false, src)
        comp("footer", 2000, false, false, src)
        comp("footer", 2000, true, false, src)
        comp("strip", 2000, false, false, src)
        comp("cursor", 2000, false, false, src)
        comp("frame", 2000, false, false, src)
        comp("flip", 2000, false, false, src)
        comp("idle", 2000, false, false, src)
        comp("full", 200, false, true, src)
        comp("panes", 200, false, true, src)
        gnb(20, src)
    }
    if all || ph == "keys" {
        keys("prompt-menu", 400, src)
        keys("prompt-menu-norender", 400, src)
        keys("prompt-type", 400, src)
        keys("prompt-type-norender", 400, src)
        keys("type", 400, src)
        keys("type-norender", 400, src)
        keys("lines40", 400, src)
        keys("pane-lines40", 400, src)
        keys("pane-prompt-menu", 400, src)
    }
    if ph == "after" {
        for m in ["type", "prompt-type", "prompt-menu", "lines40"] {
            for w in [
                "render",
                "follow",
                "gcol",
                "status",
                "footer",
                "doc",
                "cursor",
                "panes",
                "marks",
                "frame",
                "clip",
            ] {
                after_key(w, m, 300, src)
            }
        }
        for m in ["prompt-type", "prompt-menu"] {
            for w in ["parse", "text"] {
                after_key(w, m, 300, src)
            }
        }
    }
    if ph == "prow" {
        for seed in ["", "wri", "zzzz no such command"] {
            for w in ["footer", "ghost", "hist", "sel", "status"] {
                prow(seed, w, 200, src)
            }
        }
    }
    if ph == "keys10k" {
        keys("arrows", 1000, src)
        keys("arrows-norender", 1000, src)
        keys("type", 400, src)
        keys("type-norender", 400, src)
    }
}

// `env_args()` holds the arguments only (no program name).
fn main() {
    let argv = env_args()
    let ph = if argv.len > 0 then argv[0] else "all"
    let src = if argv.len > 1 then argv[1] else "README.md"
    print("zzhot: phase {ph} over {src}")
    run(ph, src)
}
