#!/bin/bash
# yw05: forksetup NAME -> ~/lanes/yw05-NAME/yew, a clone of yew at origin/yw05
# (branch yw05-NAME, or the existing origin/yw05-NAME), commit.gpgsign false
# (local), the pinned toolchain and the built oracle copied from the lane tree
# (~/lanes/yw05/yew), and the oracle's PTY runner REBUILT in the copy (its
# fixture paths are absolute: yw04's correction).
set -e
n=$1; d=~/lanes/yw05-$n
mkdir -p $d && cd $d
[ -d yew ] || git clone -q https://github.com/wolffe-lang/yew.git yew
cd yew && git fetch -q origin
if git rev-parse -q --verify origin/yw05-$n >/dev/null; then git checkout -q -B yw05-$n origin/yw05-$n; else git checkout -q -B yw05-$n origin/yw05; fi
git config commit.gpgsign false
[ -d .wolf-bin ] || cp -a ~/lanes/yw05/yew/.wolf-bin .wolf-bin
mkdir -p target
if [ ! -d target/oracle ]; then
  cp -a ~/lanes/yw05/yew/target/oracle target/oracle
  (cd target/oracle/sagitta && rm -f build-gcc/pty_runner build-gcc/tests/pty/registry.o && make -s CC=gcc BUILD=build-gcc -W tests/pty/registry.c build-gcc/pty_runner >/dev/null)
fi
echo forksetup: $d/yew at $(git log --oneline -1)
