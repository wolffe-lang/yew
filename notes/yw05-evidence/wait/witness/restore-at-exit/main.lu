//! yw05-wait witness: which deaths `os_term_restore_at_exit` (G1,
//! wolf-lang#794, `[os.term.restore]`) restores at wolf 0.2.34.
//!
//! Registers the saved mode and the bytes `RESTORED` for the terminal on
//! stdin, enters the editor's raw mode (the mode int with RAW_CR and
//! RAW_OUTPUT), prints `READY`, and parks in `os_signal_wait_fds` over the
//! terminal (listening for RESIZE only). A byte then picks the exit: `t` a
//! trap (an index past the end), `q` `os_exit(3)`, `e` `os_exit_signal` of
//! TERMINATE, anything else a return from `main`. `drive.py` runs it under
//! a pseudo-terminal and sends each outside signal while it is parked.
use std.fs

fn main() {
    let fd = fs.stdin().fd
    let saved = os_term_mode(fd) else {
        print("mode refused")
        return
    }
    os_term_restore_at_exit(fd, saved, "RESTORED".bytes()) else |_| {
        print("register refused")
        return
    }
    os_signal_listen(16384) else |_| {}
    os_term_set_mode(fd, 32 + 64 + 256) else |_| {
        print("raw refused")
        return
    }
    print("READY")
    var fds = List[int]()
    (mut fds).push(fd)
    let (i, m) = os_signal_wait_fds(fds, 16384, -1) else |_| {
        print("wait refused")
        return
    }
    if i != 0 {
        print("woke {i} {m}")
        return
    }
    var tin = fs.stdin()
    let got = fs.read_chunk(mut tin, 16) else |_| List[byte]()
    if got.len == 0 {
        return
    }
    let c = got[0] as int
    if c == 116 {
        let xs = List[int]()
        let n = xs[got.len + 5]
        print("unreached {n}")
    } else if c == 113 {
        os_exit(3)
    } else if c == 101 {
        os_exit_signal(2) else |_| {}
    }
}
