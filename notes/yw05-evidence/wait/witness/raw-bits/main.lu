//! yw05-wait witness: what `[os.term.mode]`'s bits 5 and 6 (G34,
//! wolf-lang#802) change under a pseudo-terminal at wolf 0.2.34. Sets the
//! mode int the argument names (the port's `rawios`, 32 + 64 + 256, or the
//! same without `RAW_CR`/`RAW_OUTPUT`), writes `A\nB` and prints, after the
//! bytes a typed CR arrives as, what the runtime reads back.
use std.fs

fn main() {
    let args = env_args()
    var want = 352
    if args.len > 0 {
        want = args[0].to_int() else 352
    }
    let fd = fs.stdin().fd
    os_term_set_mode(fd, want) else |_| {
        print("set refused")
        return
    }
    let back = os_term_mode(fd) else -1
    var out = fs.stdout()
    fs.write_chunk(mut out, "READY A\nB|".bytes()) else |_| {}
    var tin = fs.stdin()
    let got = fs.read_chunk(mut tin, 16) else |_| List[byte]()
    var s = "mode {want} read back {back}; typed CR arrives as"
    for b in got {
        s = s + " {b as int}"
    }
    fs.write_chunk(mut out, "{s}|".bytes()) else |_| {}
}
