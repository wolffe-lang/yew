//! member: false
//!
//! yw04-prompt memory probe (prediction #7): VmRSS growth per keystroke
//! and per full repaint, in process, through the loop's own turn
//! (`loop.lu`'s `loop_turn`, replayed from its pub pieces) over either the
//! unit tests' fixture or the driver's session (`driver.lu`'s `ed_run`
//! without the terminal: config, a real file, not `--clean`). Copy it to
//! `src/zzmem_prompt_test.lu`, `cp README.md target/verify/m.txt`, build
//! with `.wolf-bin/wolf build src/zzmem_prompt_test.lu -o
//! target/verify/zzmem`, run in the container from the root, delete the
//! copy. `ptymem.txt` beside it has the runs. A phase opening m.txt after
//! another has left its crash journal meets the recovery question, so
//! read `active=` before trusting a prompt phase.

use edit
use term
use text

fn rss_kb() -> int {
    let s = fs_read_text("/proc/self/status") else ""
    for line in s.split("\n") {
        if line.starts_with("VmRSS:") {
            var n = 0
            for b in line.bytes() {
                if b >= 48 as byte && b <= 57 as byte {
                    n = n * 10 + (b as int - 48)
                }
            }
            return n
        }
    }
    -1
}

fn init() -> edit.Ed {
    var ed = edit.ed_new_test(fs_read_bytes("runtime/init.fl") else List[byte](), "")
    let name = ed.opts.theme
    edit.ed_theme_set(mut ed, name)
    ed.clean = true
    ed.regs.clipboard_sync = text.CLIP_SYNC_OFF
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    var caps = term.caps_new()
    caps.truecolor = true
    ed.render = term.render_new(caps, term.env_process())
    ed.render_ready = true
    edit.ed_layout(mut ed)
    ed
}


// The driver's session (driver.lu's ed_run) without the terminal.
fn init_real(clean: bool, file: bool) -> edit.Ed {
    var ed = edit.ed_new()
    ed.clean = clean
    ed.ws_dir = text.file_realpath(".") else "."
    var caps = term.caps_new()
    caps.truecolor = true
    ed.input = term.input_new(caps)
    ed.input_ready = true
    edit.ed_open_scratch(mut ed)
    let bootstrap = ed.tabs[0].tab_id
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    ed.render = term.render_new(caps, term.env_process())
    ed.render_ready = true
    var st = edit.startup_default()
    st.clean = clean
    edit.ed_load_config(mut ed, st)
    if file {
        let idx = edit.tab_open(mut ed, "target/verify/m.txt")
        assert(idx >= 0 && edit.tab_hydrate(mut ed, idx) == 0, "the file opens")
        edit.tab_switch(mut ed, idx)
        if ed.tabs.len > 1 {
            let b = edit.tab_index_of_id(ed, bootstrap)
            if b >= 0 {
                let _ = edit.tab_close(mut ed, b)
            }
        }
    }
    edit.ed_layout(mut ed)
    edit.ed_render(mut ed)
    ed
}

// skip: 0 none, 1 comp_tick, 2 comp_idle, 3 timers+dispatch_tick, 4 render
fn turn(mut ed: edit.Ed, mut key: term.Key, now: int, bytes: List[byte], skip: int) {
    let raw = bytes.len > 0
    if raw {
        term.input_feed(mut ed.input, bytes, 0, bytes.len)
    }
    ed.now_ms = now
    var had = false
    while term.input_next(mut ed.input, now, mut key) {
        had = true
        edit.loop_dispatch_event(mut ed, key, now)
    }
    if skip != 3 {
        edit.dispatch_tick(mut ed, now)
        edit.ed_timers_fire(mut ed, now)
    }
    if skip != 1 {
        let _ = edit.cmdline_comp_tick(mut ed)
    }
    if skip != 2 && !had && !raw {
        let _ = edit.cmdline_comp_idle(mut ed)
    }
    if ed.layout_dirty {
        edit.ed_layout(mut ed)
    }
    if skip != 4 {
        edit.ed_render(mut ed)
    }
}

fn one(c: int) -> List[byte] {
    var v = List[byte]()
    (mut v).push(c as byte)
    v
}

fn phase(name: str, n: int, prompt: bool, idle: bool, skip: int) {
    phase_on(name, n, prompt, idle, skip, 0)
}

fn phase_on(name: str, n: int, prompt: bool, idle: bool, skip: int, setup: int) {
    var ed = if setup == 0 then init() else init_real(setup == 2 || setup == 4, setup <= 2)
    var key = term.key_new()
    var now = 1000
    turn(mut ed, mut key, now, one(if prompt then 58 else 105), skip)
    var i = 0
    var turns = 0
    while i < n + 20 {
        if i == 20 {
            turns = 0
        }
        let before_warm = i == 20
        let b = if prompt then (if i % 2 == 0 then one(102) else one(127)) else (if i % 2 == 0 then one(97) else one(98))
        now += 30
        turn(mut ed, mut key, now, b, skip)
        turns += 1
        if idle {
            var k = 0
            while k < 8 && edit.loop_deadline(ed, now) >= 0 {
                now += 20
                turn(mut ed, mut key, now, List[byte](), skip)
                turns += 1
                k += 1
            }
        }
        i += 1
        if i == 20 {
            unsafe_mark(rss_kb())
        }
    }
    print("zzmem: {name}: n={n} turns={turns} after={rss_kb()} kb; growth {(rss_kb() - mark_get()) * 1024 / n} B/key; active={ed.cmdline.active} line='{str_from_utf8(edit.cmdline_text(ed)) else "?"}'")
}

var mark: int = 0

fn unsafe_mark(v: int) {
    unsafe {
        // # Safety: single-threaded probe.
        mark = v
    }
}

fn mark_get() -> int {
    unsafe {
        // # Safety: single-threaded probe.
        mark
    }
}


fn frames(name: str, n: int, setup: int, prompt: bool) {
    var ed = if setup == 0 then init() else init_real(false, setup == 1)
    var key = term.key_new()
    turn(mut ed, mut key, 1000, one(if prompt then 58 else 27), 0)
    var i = 0
    while i < 20 {
        ed.full_damage = true
        edit.ed_render(mut ed)
        i += 1
    }
    let before = rss_kb()
    i = 0
    while i < n {
        ed.full_damage = true
        edit.ed_render(mut ed)
        i += 1
    }
    print("zzmem: {name}: n={n} growth {(rss_kb() - before) * 1024 / n} B/frame")
}

fn main() {
    frames("full repaint, real session, file, prompt open", 600, 1, true)
    frames("full repaint, real session, file, L mode", 600, 1, false)
    frames("full repaint, real session, scratch, prompt open", 600, 2, true)
    phase_on("prompt keys, real session, file, no render", 600, true, true, 4, 1)
    phase_on("prompt keys, real session, file", 600, true, true, 0, 1)
    phase_on("prompt keys, real session, scratch", 600, true, true, 0, 3)
}
