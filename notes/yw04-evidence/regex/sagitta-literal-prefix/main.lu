use search
use text

fn main() {
    let hay = "--abcdefghijklmnopqrstuvwxyz012345XXXXXXXX--"
    let tb0 = text.textbuf_new()
    for pat in "abcdefghijklmnopqrstuvwxyz0123456789ABCD abcdefghijklmnopqrstuvwxyz012345".words() {
        var err = search.re_err_new()
        let re = search.re_compile_str(pat, search.RE_LITERAL, mut err) else {
            print("compile failed")
            return
        }
        var m = search.re_match_new()
        let got = search.re_search(re, tb0, hay.bytes(), search.re_input_bytes(hay.len), 0 as text.ByteOff, mut m)
        print("port: literal {pat.len} bytes: got={got} span={m.lo[0]}..{m.hi[0]} whole={search.re_whole_literal_bytes(re)}")
    }
}
