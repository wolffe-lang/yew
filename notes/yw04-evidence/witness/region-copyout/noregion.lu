struct Item {
    text: List[byte],
    score: int,
}

fn build(n: int, salt: int) -> List[Item] {
    {
        var tmp = List[Item]()
        var i = 0
        while i < n * 4 {
            var t = List[byte]()
            var k = 0
            while k < 10 {
                (mut t).push((48 + (i + k + salt) % 10) as byte)
                k += 1
            }
            (mut tmp).push(Item { text: t, score: i })
            i += 1
        }
        var keep = List[Item]()
        var j = 0
        while j < n {
            (mut keep).push(copy tmp[j * 4])
            j += 1
        }
        keep
    }
}

struct Holder {
    items: List[Item],
}

fn rss() -> int {
    let raw = fs_read_bytes("/proc/self/statm") else |_| {
        return -1
    }
    let t = str_from_utf8(raw) else |_| {
        return -1
    }
    let w = t.words()
    (w[1].to_int() else -1) * 4096
}

fn main() {
    var h = Holder { items: List[Item]() }
    let r0 = rss()
    var k = 0
    while k < 2000 {
        h.items = build(500, k)
        k += 1
    }
    let r1 = rss()
    print("region probe: {h.items.len} items, rss growth {(r1 - r0) / 2000} B a rebuild")
}
