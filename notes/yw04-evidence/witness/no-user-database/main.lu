// G37 witness: C completes `~name/` from getpwent(3) and resolves `~name`
// and the login shell through getpwnam(3)/getpwuid(3) (sagitta
// src/ui/cmdcomp.c:1822-1865, src/ui/shctx.c:793-797, src/edit/job.c:
// 415-429), which ask NSS: files, LDAP, systemd-homed, macOS Directory
// Services. wolf 0.2.33's only account surface is std.os.users, a PURE
// parser of passwd(5) text the program reads itself ("Nothing in this
// module ... asks a name service", its module doc); there is no lookup
// by name or id that reaches the host. The port therefore reads
// /etc/passwd, and an account kept elsewhere is invisible to it.
use std.fs
use std.os.users

fn main() {
    let text = fs.read_text("/etc/passwd") else |_| {
        print("no /etc/passwd")
        return
    }
    let all = users.users(text)
    print("accounts in /etc/passwd: {all.len}")
    let root = users.user_named(text, "root") else |_| {
        print("root: not in the files source")
        return
    }
    print("root: home {root.home} shell {root.shell}")
    // The call C makes has no wolf counterpart: there is no
    // `users.lookup("root")` / `os.getpwnam` that asks the host.
}
