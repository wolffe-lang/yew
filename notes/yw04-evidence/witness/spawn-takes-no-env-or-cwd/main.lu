// G36 witness: a child's environment and working directory are set on
// the Command before it starts (C: posix_spawn_file_actions_addchdir and
// an envp, sagitta src/edit/job.c). wolf 0.2.33's std.process has
// neither: `exec` alone takes an environment (it replaces this process).
use std.process

fn main() {
    var c = process.from_argv(["/bin/pwd"])
    process.set_cwd(mut c, "/tmp")
    process.set_env(mut c, ["YEW_JOB=1"])
    let ch = process.start(c) else |_| { return }
    let _ = process.wait_status(take ch) else |_| { return }
}
