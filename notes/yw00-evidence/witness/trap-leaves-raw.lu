//! G1 witness: a wolf program that puts its terminal in raw mode and
//! then traps leaves the terminal raw — the runtime restores nothing on
//! the trap path (`[os.term.mode]`) and no wolf code runs after a trap.
//! Run from a terminal: `wolf run trap-leaves-raw.lu; stty -a | head -3`
//! shows `-icanon -echo` after the `wolf-trap: bounds` line. C yew's
//! `yew_tty_fatal` restores from the handler (`src/term/tty.c`).
use std.fs
use std.term

fn main() {
    let tty = fs.stdin()
    let saved = term.mode(tty) else {
        print("not a terminal; nothing to witness")
        return
    }
    term.set_mode(tty, term.raw(saved)) else {
        print("cannot set raw mode")
        return
    }
    // Nothing here can run after the trap: no defer, no handler.
    let xs = List[int]()
    print("raw; now trapping: {xs[1]}")
}
