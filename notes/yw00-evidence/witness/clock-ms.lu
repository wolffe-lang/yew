//! G8 witness: the finest clock wolf 0.2.32 has is milliseconds
//! (`time_now_ms` (the prelude also names `clock_ms`, not callable from a program)), so a 100-microsecond piece of work
//! measures as 0 — the perf gates are nanoseconds (`budgets.txt`).
fn main() {
    var zeros = 0
    var round = 0
    while round < 20 {
        let a = time_now_ms()
        var acc: int = 0
        var i = 0
        while i < 20000 {
            acc += i % 7
            i += 1
        }
        let b = time_now_ms()
        if b - a == 0 {
            zeros += 1
        }
        round += 1
    }
    print("{zeros} of 20 rounds of ~100 us of work measured as 0 ms")
}
