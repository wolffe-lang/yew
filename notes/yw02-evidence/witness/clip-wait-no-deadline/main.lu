// [reg] witness rg3: no timed wait on a pipe at 0.2.33. sagitta's clipboard
// reader (clipboard.c:1000-1068) polls its pipe 20 ms at a time against a
// YEW_CLIPBOARD_TIMEOUT_MS deadline, so a tool that hangs (fakeclip `hang`)
// fails in 10 ms (test_clipboard.c:534-541). `signal.wait_fd` takes one
// descriptor and NO deadline: on a pipe whose writer never writes it waits
// forever (run under `timeout 3`, the exit is 124). The deadline form,
// os_signal_wait_fds (wolf-lang#795), is 0.2.34; at 0.2.33 it is not in
// scope (rg3b).
use std.process
use std.signal

fn main() {
    let p = process.pipe() else |_| {
        print("rg3: no pipe")
        return
    }
    print("rg3: waiting on a pipe nobody writes, no deadline possible")
    let m = signal.wait_fd(p.read, signal.child()) else |_| {
        print("rg3: wait failed")
        return
    }
    print("rg3: woke with {m} (not reached at 0.2.33)")
    let _ = p.write
}
