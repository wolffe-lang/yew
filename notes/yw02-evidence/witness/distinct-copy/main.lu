// G24: a `distinct int` is not Copy at wolf 0.2.33: `a as int` moves `a`,
// so a second read is E1001, and there is no `Copy` to opt in (E0301).
type ByteOff = distinct int

fn twice(a: ByteOff) -> int {
    let x = a as int
    let y = a as int
    x + y
}

fn main() {
    print("{twice(3 as ByteOff)}")
}
