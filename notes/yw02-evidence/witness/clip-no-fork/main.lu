// [reg] witness rg2: no fork at 0.2.33. sagitta's clipboard writer double
// forks (clipboard.c:593-644) so the clipboard tool is no child of the
// editor (test_clipboard.c:719-726 asserts waitpid answers ECHILD for every
// tool pid); `os_spawn*` makes a direct child only. `os_fork` is wolf-lang
// s247 (merged at 808ce11a, released in 0.2.34).
fn main() {
    let pid = os_fork() else |_| {
        print("rg2: fork failed")
        return
    }
    print("rg2: forked {pid}")
}
