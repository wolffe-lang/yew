// G25's other half: refused the same way when NO reachable function reads
// the const (in the yew package, text_piece_test built with undo.lu's
// consts present and text_journal_test, whose calls reach them, did not:
// the refusal's reach inside a package is not what a single file shows).
const PRIME: wrapping[u64] = 11400714819323198485

fn mix(x: wrapping[u64]) -> wrapping[u64] {
    x * PRIME
}

fn main() {
    print("built")
}
