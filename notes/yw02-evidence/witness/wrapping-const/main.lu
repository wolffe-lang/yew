// G25: a module `const` of `wrapping[u64]` is refused at 0.2.33 ("module
// state of a type that is not static data", [mem.static.3], exit 4) —
// an integer literal, which `[mem.static.2]` would read as static data.
// The port's undo hash primes are zero-argument functions instead.
const PRIME: wrapping[u64] = 11400714819323198485

fn mix(x: wrapping[u64]) -> wrapping[u64] {
    x * PRIME
}

fn main() {
    let v: wrapping[u64] = 3
    print("{(mix(v) & 255) as int}")
}
