// G28 (E1004 conservatism): storing `copy g(mut t)` — g answers a struct
// of scalars — into a field of a second `mut` parameter is refused as a
// store "from t's region"; a fresh literal of the same scalars builds.
struct Snap {
    a: int,
    b: int,
}

struct Tb {
    xs: List[int],
}

struct Meta {
    s: Snap,
}

fn g(mut t: Tb) -> Snap {
    (mut t.xs).push(1)
    Snap { a: t.xs.len, b: 2 }
}

fn set(mut m: Meta, mut t: Tb) {
    m.s = copy g(mut t)
}

fn main() {
    var t = Tb { xs: List[int]() }
    var m = Meta { s: Snap { a: 0, b: 0 } }
    set(mut m, mut t)
    print("{m.s.a}")
}
