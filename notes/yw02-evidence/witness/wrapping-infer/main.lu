// A foot-gun, not a bug: the literal 15 is inferred `wrapping[u64]` from
// its use in a shift of a wrapping value, so `i >= 0` never fails and the
// countdown wraps; the program stops itself after 40 turns to show it.
fn main() {
    let h: wrapping[u64] = 4952883123889572249
    var i = 15
    var turns = 0
    var acc: wrapping[u64] = 0
    while i >= 0 {
        acc = acc ^ (h >> (i * 4)) & 15
        i -= 1
        turns += 1
        if turns == 40 {
            break
        }
    }
    print("turns={turns} (16 if i were an int) acc={(acc & 15) as int}")
}
