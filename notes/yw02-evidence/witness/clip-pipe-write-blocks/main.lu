// [reg] witness rg1: a pipe write blocks; no wolf call makes it O_NONBLOCK.
// sagitta's clipboard writer (clipboard.c:582-584, 846-861) sets O_NONBLOCK
// on the write end so a tool that never reads costs the editor nothing
// (EAGAIN, retried from the loop). Here 1 MiB into a pipe nobody reads
// never returns: run under `timeout 3`, the exit is 124.
use std.fs
use std.process

fn main() {
    let p = process.pipe() else |_| {
        print("rg1: no pipe")
        return
    }
    var w = p.write
    var big = List[byte]()
    var i = 0
    while i < 1048576 {
        (mut big).push(120 as byte)
        i += 1
    }
    print("rg1: writing 1 MiB into a pipe nobody reads")
    fs.write_chunk(mut w, big) else |_| {
        print("rg1: write failed")
        return
    }
    print("rg1: write returned (not reached at 0.2.33)")
    let _ = p.read
}
