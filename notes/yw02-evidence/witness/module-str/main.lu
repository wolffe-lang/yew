// E1010 as a design fact (G27): a process-wide registry of run-time
// strings (C's journal owner list, `journal.c`) cannot live in a module
// `var`: "module state outlives every call, but this value is allocated
// in the caller's region". The port threads a value (`text.JournalSet`).
var OWNERS: str = ""

fn own(path: str) {
    unsafe {
        // # Safety: single-threaded witness.
        OWNERS = OWNERS + path + "\n"
    }
}

fn main() {
    own("/tmp/a")
    print("{OWNERS.len}")
}
