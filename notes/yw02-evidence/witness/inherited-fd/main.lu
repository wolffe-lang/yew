// G26: a descriptor the program inherited (>= 3) is not a handle: the
// write answers `io`. Run as `./p 5>out.txt`; out.txt stays empty.
fn main() -> int {
    var r = List[byte]()
    (mut r).push(82 as byte)
    fs_write_chunk(5, r) else |e| match e {
        invalid => {
            eprint("invalid")
            return 1
        },
        io => {
            eprint("io")
            return 1
        },
    }
    0
}
