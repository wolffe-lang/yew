2026-10-23T08:30:03.3613840Z cases="$cases s15_degenerate s15_gutter_abs_1 s15_gutter_hybrid_10 s15_gutter_hybrid_100 s15_gutter_rel_9 s15_metadata_binary_invalid s15_metadata_bom s15_metadata_crlf s15_metadata_mixed s15_mode_i s15_mode_l s15_nowrap_cjk s15_position_unicode s15_resize_roundtrip s15_wrap_cjk"
