2026-10-23T08:30:03.3622550Z cases="$cases s17_char_delete_matches_highlight s17_char_selection_unicode_tab s17_h_b_extends_by_block s17_h_c_extends_by_character s17_h_l_extends_by_line s17_h_w_extends_by_word s17_h_w_keyboard_entry s17_lift_ends_draws_two_cursors s17_lift_lines_draws_seven_cursors s17_lift_lines_draws_thousand_cursors s17_line_selection_unicode_tab s17_modal_milestone_saves s17_multicursor_typing_is_simultaneous s17_one_undo_reverts_multicursor_typing s17_rect_selection_unicode_tab s17_secondary_cursors_draw_at_eol"
2026-10-23T08:30:03.3627380Z # macOS: the two outside-signal restore cases (SIGSEGV and SIGKILL
2026-10-23T08:30:03.3628620Z # from the harness: no code of the process runs, so the guard
2026-10-23T08:30:03.3629330Z # restores after the death, G1) run in the advisory step below, as
2026-10-23T08:30:03.3629780Z # campaign 01's restore_bus does (R-yw01-1; run 39490908160 lost
2026-10-23T08:30:03.3630130Z # notepad_restore_segv's reap-time check there).
2026-10-23T08:30:03.3631440Z # The two burst cases are gated on macOS again since yw05 (yew#28):
2026-10-23T08:30:03.3631910Z # sagitta's harness writes a 4 KiB burst without reading the
2026-10-23T08:30:03.3632280Z # child's output (`write_master`, `tests/pty/harness.c:267-298`),
2026-10-23T08:30:03.3632750Z # and at wolf 0.2.33 the port's wait switched termios modes (the
2026-10-23T08:30:03.3633220Z # VTIME tick, the drain, the fine wait), each a
2026-10-23T08:30:03.3633580Z # tcsetattr(TCSADRAIN) that could wait on output nobody read
2026-10-23T08:30:03.3633950Z # (runs 39674542106, 39688445786). Since the 0.2.34 pin the wait is
2026-10-23T08:30:03.3635520Z # one os_signal_wait_fds and the raw mode is set once.
2026-10-23T08:30:03.3635810Z want=62
2026-10-23T08:30:03.3636020Z if [ "$RUNNER_OS" = macOS ]; then
2026-10-23T08:30:03.3636760Z   cases=$(echo "$cases" | tr ' ' '\n' | grep -vx -e notepad_restore_segv -e notepad_restore_kill | tr '\n' ' ')
2026-10-23T08:30:03.3637240Z   want=60
2026-10-23T08:30:03.3637840Z fi
2026-10-23T08:30:03.3638030Z n=0
2026-10-23T08:30:03.3638220Z for c in $cases; do
2026-10-23T08:30:03.3638600Z   tools/goldens --yew target/release/yew --demo target/tools/demo_paint --suite pty --case "$c"
2026-10-23T08:30:03.3639910Z   grep -q "^pty: $c: ok\$" target/oracle/goldens/pty.log
2026-10-23T08:30:03.3640240Z   n=$((n + 1))
2026-10-23T08:30:03.3640430Z done
2026-10-23T08:30:03.3640630Z echo "campaign 03: $n goldens green by name"
2026-10-23T08:30:03.3640870Z [ "$n" = "$want" ]
2026-10-23T08:30:03.3695910Z shell: /bin/bash --noprofile --norc -e -o pipefail {0}
