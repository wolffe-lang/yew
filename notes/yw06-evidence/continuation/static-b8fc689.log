#!/bin/bash
# yw06 deliverable 7: tools/build --static in localhost/px13-ubuntu (Ubuntu
# 24.04.5, glibc 2.39-0ubuntu8.9), never kasumi CachyOS glibc: a fresh clone
# of REV from the lane tree, the pin fetched by digest inside, readelf, the
# --version run, sha256 read twice and the byte count. Run on the host.
set -u
rev=$(git -C $HOME/lanes/yw06/main rev-parse "$1") || exit 2
root=$HOME/lanes/yw06
out=$root/static-$rev
rm -rf "$out"; mkdir -p "$out/home"
git init -q "$out/yew" && git -C "$out/yew" fetch -q $root/main "$rev" && git -C "$out/yew" checkout -q --detach FETCH_HEAD || exit 2
echo "clone head=$(git -C $out/yew rev-parse HEAD)"
podman run --rm --userns=keep-id --init --ulimit core=0 --memory 8g   -v "$out:$out" -w "$out/yew" -e HOME="$out/home" -e TMPDIR="$out/home"   localhost/px13-ubuntu taskset -c 8-11 bash -c "
set -u
head -1 /etc/os-release; dpkg-query -W libc6; uname -m
tools/fetch-toolchain || exit 3
.wolf-bin/wolf --version | head -1
tools/build --static; echo BUILD rc=\$?
f=target/static/yew
[ -f \$f ] || exit 4
readelf -h \$f | grep -E \"Type:|Machine:\"
echo PT_INTERP=\$(readelf -l \$f | grep -c INTERP)
file \$f
\$f --version; echo VERSION rc=\$?
sha256sum \$f; sha256sum \$f; stat -c \"bytes %s\" \$f
"
echo "static rc=$?"
