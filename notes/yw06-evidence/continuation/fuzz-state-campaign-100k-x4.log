#!/bin/bash
# s25 DoD 12's fuzz_state campaign at full size: 100,000 cases at each of the
# four seeds, the port's release driver (built at 23b3851; later commits are
# formatting only) and C's build/fuzz_state, the report lines compared.
# niced: the lane's forks build on the same four cores.
set -u
export YEW_LOG=/dev/null
sha256sum target/tools/fuzz-state
fail=0
for s in 1 0x243f6a8885a308d3 0x9e3779b97f4a7c15 0xd1b54a32d192ed03; do
  date -u +%FT%TZ
  p=$(nice -n 19 /usr/bin/time -f "port seed=$s wall=%e rss=%M" target/tools/fuzz-state --iters=${ITERS:-100000} --seed=$s 2>target/fuzz-port-$s.err); prc=$?
  cat target/fuzz-port-$s.err
  echo "port: $p (rc=$prc)"
  c=$(cd target/oracle/sagitta && nice -n 19 /usr/bin/time -f "c seed=$s wall=%e rss=%M" build/fuzz_state --iters=${ITERS:-100000} --seed=$s 2>../../fuzz-c-$s.err); crc=$?
  cat target/fuzz-c-$s.err
  echo "C:    $c (rc=$crc)"
  if [ "$prc" != 0 ] || [ "$crc" != 0 ] || [ "$p" != "$c" ]; then echo "DIFFERENT or RED at seed $s"; fail=1; else echo "EQUAL at seed $s"; fi
done
echo "fuzz-full fail=$fail"
exit $fail
