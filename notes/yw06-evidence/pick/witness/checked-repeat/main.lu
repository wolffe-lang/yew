//! checked-repeat — where test_picker's large custom-search case spends
//! the checked machine's time: an N-byte `str` made by the builtin
//! `repeat` against one made by `push` and `str_from_utf8`, N from
//! PROBE_N, the maker from PROBE_HOW. Run by run.sh under
//! `conform-run --checked` with a wall-clock bound.

fn main() -> int {
    let n = (env_get("PROBE_N") else "65536").to_int() else 65536
    let how = env_get("PROBE_HOW") else "repeat"
    if how == "repeat" {
        let t = "x".repeat(n)
        print("repeat len={t.len}")
    } else {
        var b = List[byte]()
        var i = 0
        while i < n {
            (mut b).push(120 as byte)
            i += 1
        }
        let t = str_from_utf8(b) else ""
        print("push len={t.len}")
    }
    0
}
