// Probe: does `s.bytes()` handed to a function that only reads it
// allocate? The filter passes every label's bytes to the scorer, 100,000
// times a keystroke (filter.c:123, :137). Region ledger deltas, three
// shapes: a literal, a run-time str in a list element's field, and the
// inline index read.

struct Item {
    label: str,
}

fn count(b: List[byte]) -> int {
    b.len
}

fn main() {
    var items = List[Item]()
    var i = 0
    while i < 10 {
        (mut items).push(Item { label: "src/ui/some/label/number/{i}.c" })
        i += 1
    }
    var total = 0
    var d_lit = 0
    var d_field = 0
    var d_index = 0
    region a {
        let b0 = region_bytes(a)
        var k = 0
        while k < 1000 {
            total += count("a literal label, forty bytes give or take".bytes())
            k += 1
        }
        d_lit = region_bytes(a) - b0
    }
    region b {
        let b0 = region_bytes(b)
        var k = 0
        while k < 1000 {
            total += count(items[k % 10].label.bytes())
            k += 1
        }
        d_field = region_bytes(b) - b0
    }
    region c {
        let b0 = region_bytes(c)
        var k = 0
        while k < 1000 {
            total += items[k % 10].label.bytes()[3] as int
            k += 1
        }
        d_index = region_bytes(c) - b0
    }
    print("literal.bytes() to a call x1000: {d_lit} region bytes")
    print("item.label.bytes() to a call x1000: {d_field} region bytes")
    print("item.label.bytes()[i] inline x1000: {d_index} region bytes")
    print("total {total}")
}
