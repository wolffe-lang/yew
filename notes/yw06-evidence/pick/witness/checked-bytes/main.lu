//! checked-bytes — whether an inline `field.bytes()[i]` (picker.lu's
//! custom search reads its source text so, `picker.c:376-453`'s byte
//! loop) costs the checked machine the text's length on every read: N
//! bytes of text held in a struct field, read ITERS times inline.
//! Constant time a read scales with ITERS only; a copy a read scales
//! with N x ITERS. Run by run.sh under `conform-run --checked`.

struct Holder {
    text: str,
    off: int,
}

fn main() -> int {
    let n = (env_get("PROBE_N") else "1024").to_int() else 1024
    let iters = (env_get("PROBE_ITERS") else "1000").to_int() else 1000
    var h = Holder { text: "x".repeat(n), off: 0 }
    var sum = 0
    var i = 0
    while i < iters {
        sum += h.text.bytes()[h.off] as int
        h.off = (h.off + 1) % n
        i += 1
    }
    print("n={n} iters={iters} sum={sum}")
    0
}
