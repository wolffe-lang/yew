//! b: a generic stable insertion sort over a caller's relation.

pub fn sort[T](mut xs: List[T], less: fn(T, T) -> bool) {
    var i = 1
    while i < xs.len {
        var j = i
        while j > 0 && less(xs[j], xs[j - 1]) {
            let t = copy xs[j]
            xs[j] = copy xs[j - 1]
            xs[j - 1] = t
            j -= 1
        }
        i += 1
    }
}
