//! The entry makes the dedup TWIN of `a.finish`'s closure: once each
//! closure has inlined its own `less`, the two are one body.
use a
use b

fn less(x: int, y: int) -> bool {
    x < y
}

fn main() {
    var xs = List[int]()
    var ys = List[int]()
    var n = 0
    for w in "3 1 2".words() {
        let v = w.to_int() else 0
        (mut xs).push(v)
        (mut ys).push(v + n)
        n += 10
    }
    a.finish(mut xs)
    b.sort(mut ys, fn(x: int, y: int) less(x, y))
    print("{xs[0]} {xs[1]} {xs[2]} {ys[0]} {ys[1]} {ys[2]}")
}
