//! a: a closure over a private relation by name, as yew's
//! `ws.state_records_finish` passes `fn(a, b) state_record_less(a, b)`
//! to `util.sort_stable`.
use b

fn less(x: int, y: int) -> bool {
    x < y
}

/// Sorts `xs` ascending through `b.sort`.
pub fn finish(mut xs: List[int]) {
    b.sort(mut xs, fn(x: int, y: int) less(x, y))
}
