// G28's read-parameter twin (yw06-ctx, ctxmenu.c:133-136's target rect):
// a struct of scalars passed READ and stored into a field of a `mut`
// parameter. Variant: plain.
struct Rect {
    x: int,
    y: int,
    w: int,
    h: int,
}

struct Menu {
    r: Rect,
}

fn set(mut m: Menu, r: Rect) {
    m.r = r
}

fn main() {
    var m = Menu { r: Rect { x: 0, y: 0, w: 0, h: 0 } }
    set(mut m, Rect { x: 3, y: 9, w: 1, h: 1 })
    print("{m.r.x} {m.r.y}")
}
