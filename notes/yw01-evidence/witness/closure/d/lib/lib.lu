//! member: true
fn lookup(name: str) -> (str, bool) {
    let v = env_get(name) else {
        return ("", false)
    }
    (v, true)
}

/// Tier over a lookup.
pub fn tier(getv: fn(str) -> (str, bool)) -> int {
    let (t, has) = getv("TERM")
    if has && t == "dumb" then 0 else 1
}

/// Tier over the environment.
pub fn tier_env() -> int {
    tier(fn(k: str) lookup(k))
}
