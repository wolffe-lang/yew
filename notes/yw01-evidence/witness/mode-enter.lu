//! mode-enter — the Enter witness for the mode-bit gap ([os.term.mode]).
//!
//! Sets raw mode on the controlling terminal with std.term and reads ONE
//! byte. Under a PTY whose master writes a carriage return (CR, 0x0D),
//! the byte the editor reads is CR 0x0D when `ICRNL` is cleared (what C
//! yew does, sagitta `src/term/tty.c:521-543`), and LF 0x0A when it is
//! not. std.term's `raw` / `os_term_set_mode` cannot reach `ICRNL`
//! (`[os.term.mode]`: the mode int has no bit for it, and "every other
//! field is left as found"), so the port reads 0x0A: Enter is
//! indistinguishable from Ctrl-J. Prints the byte's decimal value.

use std.fs
use std.term as std_term

fn main() -> int ! {unsupported, invalid, io, eof} {
    let tty = fs.stdin()
    let saved = std_term.mode(tty)?
    std_term.set_mode(tty, std_term.raw(saved))?
    var got = fs.stdin()
    let b = fs.read_chunk(mut got, 1)?
    std_term.set_mode(tty, saved)?
    if b.len == 0 {
        print("eof")
        return 0
    }
    print("{b[0] as int}")
    0
}
