//! mode-opost — the output-processing witness for the mode-bit gap.
//!
//! Sets raw mode on the controlling terminal with std.term and writes a
//! single LF (0x0A) to stdout. Under a PTY the master reads back LF alone
//! (0x0A) when `OPOST`/`ONLCR` is cleared (C yew, sagitta
//! `src/term/tty.c:528-531`), and CR LF (0x0D 0x0A) when it is not. The
//! mode int (`[os.term.mode]`) has no `OPOST` bit, so the port leaves it
//! as the PTY's default (ON): the renderer's bytes would be rewritten on
//! the wire, which a byte-pinned golden cannot survive. Writes one LF;
//! the driver reads the master and reports the bytes it saw.

use std.fs
use std.term as std_term

fn main() -> int ! {unsupported, invalid, io} {
    let tty = fs.stdin()
    let saved = std_term.mode(tty)?
    std_term.set_mode(tty, std_term.raw(saved))?
    var out = fs.stdout()
    var one = List[byte]()
    (mut one).push(0x0A as byte)
    fs.write_chunk(mut out, one)?
    std_term.set_mode(tty, saved)?
    0
}
