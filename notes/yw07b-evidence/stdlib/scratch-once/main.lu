//! Exact native-scratch ownership probe: new physical GC slots and payloads.
use fl
fn main() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    for round in 0..1 {
        region native_scratch {
            var bytes = List[byte]()
            for i in 0..100000 + round * 1024 { (mut bytes).push((i % 251) as byte) }
            let s = fl.fl_str_new(mut vm, bytes)
            let l = fl.fl_list_new(mut vm)
            for _ in 0..64 + round { fl.fl_list_push(mut vm, l, s) }
            vm.stack[0] = l
            vm.sp = 1
        }
        let l = copy vm.stack[0]
        let s = fl.fl_list_get(vm, l, 0) else fl.fl_nil()
        assert(fl.fl_str_len(vm, s) == 100000 + round * 1024)
        let at = fl.fl_obj_index(vm, s)
        assert(vm.gc.slots[at].bytes[99999] == (99999 % 251) as byte)
        fl.fl_gc_collect(mut vm)
        let live = fl.fl_list_get(vm, vm.stack[0], 0) else fl.fl_nil()
        assert(fl.fl_str_len(vm, live) == 100000 + round * 1024)
    }
    print("native scratch constructors survive outside region and collection")
}
