# io.glob witness: each pattern's matches, one a line, as the binary answers.
import io
let d = io.env("IOW")
fn show(label, pat, root) {
    io.print("== " + label)
    try {
        let got = nil
        if root == nil { got = io.glob(pat) } else { got = io.glob(pat, root) }
        for p in got { io.print(p) }
    } catch e {
        io.print("!" + e.kind + ": " + e.msg)
    }
}
show("star txt", "*.txt", d)
show("question", "?.md", d)
show("class", "[ab]*", d)
show("negated class", "[!ab]*", d)
show("caret class", "[^ab]*", d)
show("range class", "[a-b]*", d)
show("literal bracket first", "[]c]*", d)
show("escaped star", "\\**", d)
show("unterminated class", "q[x", d)
show("dash literal", "a[-_]b", d)
show("sub star", "sub/*", d)
show("double star", "**", d)
show("double star txt", "**/*.txt", d)
show("double star c", "**/c.txt", d)
show("double double", "**/**/c.txt", d)
show("star slash star", "*/*", d)
show("dot files", ".*", d)
show("dot in sub", "sub/.*/*", d)
show("double then dot", "**/.dot", d)
show("trailing slash", "sub/", d)
show("doubled slash", "sub//b.txt", d)
show("nothing", "nothing/*", d)
show("absolute", d + "/*.txt", nil)
show("absolute with root", d + "/*.txt", d)
show("root slash", "*", "/")
show("root trailing slashes", "*.md", d + "///")
show("root empty", "*", "")
show("pattern empty", "", d)
show("pattern only slashes", "///", d)
show("pattern nul", "a\x00b", d)
show("root missing", "*", d + "/nope")
show("locked dir", "locked/*", d)
show("bad names", "bad*", d)
show("into bad dir", "bad*/*", d)
show("default root", "*.fl", nil)
# `**` with two components after it: C's stale `here` decides the descent.
show("double then name then star", "**/deep/*.txt", d)
show("double then star then name", "**/*/c.txt", d)
show("double sub double", "**/sub/**", d)
show("double star dir", "**/*/*", d)
show("root nul leaf", "*.txt", d + "\x00zz")
show("root nul double", "**/q.txt", d + "\x00zz")
