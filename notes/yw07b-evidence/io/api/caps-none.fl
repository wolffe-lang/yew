# Run with --caps none: a command's capability is checked before the editor.
import io
import buf
import ed
fn show(label, thunk) {
    try {
        thunk()
        io.print(label + ": ok")
    } catch e {
        io.print(label + ": " + e.kind + ": " + e.msg)
    }
}
show("buf.open", fn() { return buf.open("missing") })
show("buf.save", fn() { return buf.save(42) })
show("buf.close", fn() { return buf.close(42) })
show("ed.run", fn() { return ed.run("ed.buf.open", {}) })
