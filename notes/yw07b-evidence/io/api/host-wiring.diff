+use edit
 use fl
 use std.fs as fs
 use std.io as std_io
@@ -77,6 +78,14 @@ fn run_open(kind: int, caps: int) -> FlRun {
     var vm = fl.fl_vm_new(take strings)
     vm.dc.echo = true
     fl.fl_std_register(mut vm)
+    // SCRATCH (io fork's API witness): the host hands over edit's registry.
+    let reg = edit.cmdreg_builtin()
