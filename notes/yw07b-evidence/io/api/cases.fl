# The editor API headless: every native of 34-editor.fl and kind_handle.fl,
# its error as `kind: msg`, as the binary under test answers it.
import io
import buf
import win
import cur
import span
import opt
import ed
import ai
import list
fn show(label, thunk) {
    try {
        let v = thunk()
        io.print(label + ": ok")
    } catch e {
        io.print(label + ": " + e.kind + ": " + e.msg)
    }
}
show("buf.current", fn() { return buf.current() })
show("buf.len 42", fn() { return buf.len(42) })
show("buf.path str", fn() { return buf.path("not a handle") })
show("buf.text nil", fn() { return buf.text(nil) })
show("buf.list", fn() { return buf.list() })
show("ed.msg", fn() { return ed.msg("hello") })
show("ed.mode", fn() { return ed.mode() })
show("ed.recording", fn() { return ed.recording() })
show("ed.register", fn() { return ed.register("a") })
show("ed.fuss", fn() { return ed.fuss() })
show("ed.workspace", fn() { return ed.workspace() })
show("ai.backend", fn() { return ai.backend("local", {}) })
show("buf.open", fn() { return buf.open("missing") })
show("buf.close", fn() { return buf.close(42) })
show("buf.save", fn() { return buf.save(42) })
show("buf.name", fn() { return buf.name(42) })
show("buf.lang", fn() { return buf.lang(42) })
show("buf.lines", fn() { return buf.lines(42) })
show("buf.line", fn() { return buf.line(42, 1) })
show("buf.span", fn() { return buf.span(42, 0, 0) })
show("buf.line_span", fn() { return buf.line_span(42, 1) })
show("buf.insert", fn() { return buf.insert(42, 0, "x") })
show("buf.delete", fn() { return buf.delete(42, nil) })
show("buf.find", fn() { return buf.find(42, nil) })
show("buf.find_all", fn() { return buf.find_all(42, nil) })
show("buf.dirty", fn() { return buf.dirty(42) })
show("buf.opt", fn() { return buf.opt(42, "save.strategy") })
show("buf.opt_set", fn() { return buf.opt_set(42, "save.strategy", "auto") })
show("buf.readonly", fn() { return buf.readonly(42) })
show("buf.mark", fn() { return buf.mark(42, 0) })
show("buf.undo_depth", fn() { return buf.undo_depth(42) })
show("win.current", fn() { return win.current() })
show("win.list", fn() { return win.list() })
show("win.buf", fn() { return win.buf(42) })
show("win.cursors", fn() { return win.cursors(42) })
show("win.selection", fn() { return win.selection(42) })
show("win.split", fn() { return win.split(42, "right") })
show("win.close", fn() { return win.close(42) })
show("win.focus", fn() { return win.focus(42) })
show("win.viewport", fn() { return win.viewport(42) })
show("win.set_cursors", fn() { return win.set_cursors(42, []) })
show("cur.pos", fn() { return cur.pos(42) })
show("cur.line", fn() { return cur.line(42) })
show("cur.col", fn() { return cur.col(42) })
show("cur.anchor", fn() { return cur.anchor(42) })
show("cur.span", fn() { return cur.span(42) })
show("cur.goto", fn() { return cur.goto(42, 0) })
show("cur.move", fn() { return cur.move(42, "word", "next") })
show("cur.word", fn() { return cur.word(42) })
show("cur.line_span", fn() { return cur.line_span(42) })
show("cur.insert", fn() { return cur.insert(42, "x") })
show("cur.is_primary", fn() { return cur.is_primary(42) })
show("cur.valid", fn() { return cur.valid(42) })
show("span.lo", fn() { return span.lo(42) })
show("span.hi", fn() { return span.hi(42) })
show("span.len", fn() { return span.len(42) })
show("span.text", fn() { return span.text(42) })
show("span.lines", fn() { return span.lines(42) })
show("span.replace", fn() { return span.replace(42, "x") })
show("span.replace_lines", fn() { return span.replace_lines(42, ["x"]) })
show("span.prepend", fn() { return span.prepend(42, "x") })
show("span.append", fn() { return span.append(42, "x") })
show("span.delete", fn() { return span.delete(42) })
show("span.yank", fn() { return span.yank(42) })
show("span.valid", fn() { return span.valid(42) })
show("opt.get", fn() { return opt.get("tabwidth") })
show("opt.set", fn() { return opt.set("tabwidth", 4) })
show("ed.run", fn() { return ed.run("ed.mode.normal", {}) })
show("ed.run bad args", fn() { return ed.run(42, 42) })
show("bind", fn() { return bind("H", "s", fn() { return 1 }) })
show("unbind", fn() { return unbind("H", "s") })
show("set map", fn() { return set({tabwidth: 4}) })
show("set empty", fn() { return set({}) })
show("set int", fn() { return set(42) })
show("on", fn() { return on("buf.open", fn() { return 1 }) })
show("on bad", fn() { return on(1, 2) })
show("record", fn() { return record("q") })
show("replay", fn() { return replay("q") })
show("replay 2", fn() { return replay("q", 2) })
show("ai.backend bad", fn() { return ai.backend(1, 2) })
show("buf.len arity", fn() { return buf.len() })
show("method on int", fn() { return (42).len() })
let cmds = ed.commands()
io.print("ed.commands count", list.len(cmds))
for i, row in cmds {
    if i < 3 or (row.word != nil and i < 12) or i == list.len(cmds) - 1 {
        io.print(i, row.name, "|", row.help, "|", row.flags, "|", row.word)
    }
}
