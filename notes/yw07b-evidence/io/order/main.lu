// Order of descriptor-1/2 chunk writes beside print/eprint, one sink.
fn chunk(fd: int, s: str) {
    var b = List[byte]()
    for x in s.bytes() { (mut b).push(x) }
    fs_write_chunk(fd, b) else |_| {}
}

fn main() {
    chunk(1, "1 chunk-stdout\n")
    chunk(2, "2 chunk-stderr\n")
    print("3 print")
    eprint("4 eprint")
    chunk(1, "5 chunk-stdout\n")
    chunk(2, "6 chunk-stderr\n")
    print("7 print")
}
