// errno witness, wolf half: each failure's row and os_error() on this host.
fn row(tag: str, what: str) { print("{what}: row={tag} os_error={os_error()} host={os_name()}") }

fn main() {
    let d = "/tmp/yew-io-errno-probe"
    let _ = fs_remove_dir_all(d) else |_| {}
    fs_create_dir_mode(d, 511) else |_| { assert(false) }
    fs_write_text("{d}/file", "x") else |_| { assert(false) }
    fs_create_dir_mode("{d}/full", 511) else |_| { assert(false) }
    fs_write_text("{d}/full/x", "x") else |_| { assert(false) }
    fs_create_dir_mode("{d}/ro", 511) else |_| { assert(false) }
    fs_write_text("{d}/noperm", "x") else |_| { assert(false) }
    fs_set_mode("{d}/noperm", 0) else |_| { assert(false) }
    fs_symlink("{d}/loop", "{d}/loop") else |_| { assert(false) }
    let _ = fs_open("{d}/nope") else |e| { row("{e}", "open missing"); 0 }
    let _ = fs_open("{d}/file/x") else |e| { row("{e}", "open under file"); 0 }
    let _ = fs_open("{d}/noperm") else |e| { row("{e}", "open noperm"); 0 }
    let _ = fs_open("{d}/loop") else |e| { row("{e}", "open loop"); 0 }
    var long = d
    for _ in 0..300 { long = long + "/aaaaaaaaaaaaaaa" }
    let _ = fs_open(long) else |e| { row("{e}", "open long"); 0 }
    var longname = "{d}/"
    for _ in 0..300 { longname = longname + "a" }
    let _ = fs_open(longname) else |e| { row("{e}", "open longname"); 0 }
    let fd = fs_open(d) else |e| { row("{e}", "open dir"); -1 }
    if fd >= 0 {
        let w = fs_fstat_record(fd) else |e| { row("{e}", "fstat dir"); List[int]() }
        print("open dir: ok fd kind={w[0]}")
        let _ = fs_read_chunk(fd, 16) else |e| { row("{e}", "read dir"); List[byte]() }
        fs_close(fd) else |_| {}
    }
    let _ = fs_read_bytes(d) else |e| { row("{e}", "read_bytes dir"); List[byte]() }
    let _ = fs_stat("{d}/nope") else |e| { row("{e}", "stat missing"); List[int]() }
    let _ = fs_stat("{d}/file/x") else |e| { row("{e}", "stat under file"); List[int]() }
    let _ = fs_lstat("{d}/nope") else |e| { row("{e}", "lstat missing"); List[int]() }
    fs_remove_dir("{d}/full") else |e| { row("{e}", "rmdir full") }
    fs_remove("{d}/nope") else |e| { row("{e}", "unlink missing") }
    fs_remove("{d}/file/x") else |e| { row("{e}", "unlink under file") }
    fs_remove("{d}/full") else |e| { row("{e}", "unlink dir") }
    fs_create_dir_mode("{d}/q/r", 511) else |e| { row("{e}", "mkdir missing parent") }
    fs_create_dir_mode("{d}/full", 511) else |e| { row("{e}", "mkdir exists") }
    fs_create_dir_mode("{d}/file/x", 511) else |e| { row("{e}", "mkdir under file") }
    let _ = fs_open_perm("{d}", 2, 438) else |e| { row("{e}", "append dir"); 0 }
    let _ = fs_open_perm("{d}/q/x", 2, 438) else |e| { row("{e}", "append missing parent"); 0 }
    let _ = fs_open_perm("{d}/file/x", 2, 438) else |e| { row("{e}", "append under file"); 0 }
    let _ = fs_open_perm("{d}/noperm", 2, 438) else |e| { row("{e}", "append noperm"); 0 }
    fs_set_mode("{d}/ro", 365) else |_| { assert(false) }
    let _ = fs_open_perm("{d}/ro/.t", 4, 438) else |e| { row("{e}", "create in ro dir"); 0 }
    fs_rename("{d}/file", "{d}/full") else |e| { row("{e}", "rename file over dir") }
    let _ = env_get("YEW_IO_PROBE_UNSET") else |e| { row("{e}", "env unset"); "" }
    fs_set_mode("{d}/ro", 493) else |_| {}
    let _ = fs_remove_dir_all(d) else |_| {}
}
