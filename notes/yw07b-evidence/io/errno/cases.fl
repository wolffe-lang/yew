# errno witness: every io failure the port maps, as C yew answers it.
# The tree is made by setup.sh before the run; IOW names it (c-run.sh).
import io
import list
let d = io.env("IOW")
fn show(label, thunk) {
    try {
        thunk()
        io.print(label + ": ok")
    } catch e {
        io.print(label + ": " + e.kind + ": " + e.msg)
    }
}
show("read missing", fn() { io.read(d + "/nope") })
show("read dir", fn() { io.read(d + "/full") })
show("read under file", fn() { io.read(d + "/file/x") })
show("read noperm", fn() { io.read(d + "/noperm") })
show("read loop", fn() { io.read(d + "/loop") })
show("read long", fn() { io.read(d + "/" + io.env("IOW_LONG")) })
show("read_lines missing", fn() { io.read_lines(d + "/nope") })
show("read_lines dir", fn() { io.read_lines(d + "/full") })
show("write missing parent", fn() { io.write(d + "/q/x", "a") })
show("write onto dir", fn() { io.write(d + "/full", "a") })
show("write under file", fn() { io.write(d + "/file/x", "a") })
show("write ro dir", fn() { io.write(d + "/ro/x", "a") })
show("write loop", fn() { io.write(d + "/loop", "a") })
show("append missing parent", fn() { io.append(d + "/q/x", "a") })
show("append dir", fn() { io.append(d + "/full", "a") })
show("append under file", fn() { io.append(d + "/file/x", "a") })
show("append noperm", fn() { io.append(d + "/noperm", "a") })
show("append loop", fn() { io.append(d + "/loop", "a") })
show("size missing", fn() { io.size(d + "/nope") })
show("size under file", fn() { io.size(d + "/file/x") })
show("size loop", fn() { io.size(d + "/loop") })
show("size noperm", fn() { io.size(d + "/ro/k") })
show("remove missing", fn() { io.remove(d + "/nope") })
show("remove full", fn() { io.remove(d + "/full") })
show("remove under file", fn() { io.remove(d + "/file/x") })
show("remove in ro dir", fn() { io.remove(d + "/ro/k") })
show("remove empty dir in ro dir", fn() { io.remove(d + "/ro/e") })
show("mkdir missing parent", fn() { io.mkdir(d + "/q/r") })
show("mkdir exists", fn() { io.mkdir(d + "/full") })
show("mkdir exists file", fn() { io.mkdir(d + "/file") })
show("mkdir under file", fn() { io.mkdir(d + "/file/x") })
show("mkdir in ro dir", fn() { io.mkdir(d + "/ro/n") })
show("mkdir parents through file", fn() { io.mkdir(d + "/file/x/y", true) })
show("mkdir parents in ro dir", fn() { io.mkdir(d + "/ro/n/m", true) })
show("mkdir parents leaf is file", fn() { io.mkdir(d + "/file", true) })
show("mkdir parents trailing slash", fn() { io.mkdir(d + "/t1/t2/", true) })
show("exists noperm child", fn() { if io.exists(d + "/ro/k") { error("x") } })
show("glob unreadable", fn() { io.print(list.len(io.glob("*", d + "/nope"))) })
# Beyond the tree: the host's own special files, for names the tree cannot reach.
show("append dev full", fn() { io.append("/dev/full", "x") })
show("remove dot", fn() { io.remove(".") })
show("read proc mem", fn() { io.read("/proc/self/mem") })
show("mkdir sys", fn() { io.mkdir("/sys/yew-io-x") })
show("append proc sys", fn() { io.append("/proc/sys/kernel/hostname", "x") })
show("remove proc", fn() { io.remove("/proc") })
show("remove proc self", fn() { io.remove("/proc/self") })
show("mkdir proc", fn() { io.mkdir("/proc/yew-io-x") })
show("write dev null", fn() { io.write("/dev/null", "x") })
show("remove dev null", fn() { io.remove("/dev/null") })
show("size proc mem", fn() { io.print(io.size("/proc/self/mem")) })
