# G40 witness: io paths and environment bytes that are not UTF-8.
import io
import str
let d = io.env("IOW")
let bad = d + "/bad" + str.from_bytes([255]) + ".txt"
fn show(label, thunk) {
    try {
        let v = thunk()
        io.print(label + ": ok", v)
    } catch e {
        io.print(label + ": " + e.kind + ": " + e.msg)
    }
}
show("write", fn() { return io.write(bad, "x") })
show("append", fn() { return io.append(bad, "y") })
show("read", fn() { return io.read(bad) })
show("read_lines", fn() { return io.read_lines(bad) })
show("exists", fn() { return io.exists(bad) })
show("is_dir", fn() { return io.is_dir(bad) })
show("size", fn() { return io.size(bad) })
show("glob leaf", fn() { return io.glob("bad*", d) })
show("remove", fn() { return io.remove(bad) })
show("mkdir", fn() { return io.mkdir(bad) })
fn descend() {
    io.write(bad + "/in.txt", "z")
    return io.glob("bad*/*", d)
}
show("glob descend", descend)
show("glob root", fn() { return io.glob("*", bad) })
show("env value", fn() { return io.env("IOW_BAD") })
show("env name", fn() { return io.env("IOW_" + str.from_bytes([255])) })
