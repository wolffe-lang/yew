+
+// Derived execution cache, not another instruction set: bits 0..7 opcode,
+// 8..23 operand 1, 24..39 operand 2, 40.. base width. PCs remain byte PCs;
+// CLOSURE's capture pairs stay in code and are decoded by its own arm.
+fn fl_decode_word(vm: FlVm, fun: int, pc: int) -> int {
+    let op = vm.gc.slots[fun].code[pc] as int
+    var cursor = pc + 1
+    var packed = op
+    var shift: int = 8
+    for shape in fl_op_operands(op).bytes() {
+        var value = vm.gc.slots[fun].code[cursor] as int
+        cursor += 1
+        if shape == 119 as byte {
+            value = value | vm.gc.slots[fun].code[cursor] as int << 8
+            cursor += 1
+        }
+        packed = packed | value << shift
+        shift += 16
+    }
+    packed | (cursor - pc) << 40
+}
+fn fl_decode_cache(mut vm: FlVm, fun: FlValue) {
+    let at = fl_obj_index(vm, fun)
+    (mut vm.gc.slots[at].idx).reset()
+    for _ in 0..vm.gc.slots[at].code.len { (mut vm.gc.slots[at].idx).push(0) }
+    var pc: int = 0
+    while pc < vm.gc.slots[at].code.len {
+        vm.gc.slots[at].idx[pc] = fl_decode_word(vm, at, pc)
+        pc += fl_op_length(vm, fun, pc)
+    }
+}
