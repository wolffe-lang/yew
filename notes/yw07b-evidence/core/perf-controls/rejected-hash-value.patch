 /// Find a map key; none means absent or unhashable.
 pub fn fl_map_get(vm: FlVm, m: FlValue, k: FlValue) -> FlValue ! {none} {
     if !fl_hashable(k) { return none }
-    let at = fl_obj_index(vm, m)
