+
+// The compiler caches immutable constant-key hashes for the global opcodes.
+// Other callers use fl_map_get, so the supplied hash never crosses the API.
+fn fl_map_get_hashed(vm: FlVm, m: FlValue, k: FlValue, hash: int) -> FlValue ! {none} {
+    let at = fl_obj_index(vm, m)
+    let (p, found) = fl_map_probe(vm, at, k, hash)
     if !found { return none }
     copy vm.gc.slots[at].ents[vm.gc.slots[at].idx[p] - 1].v
 }
