//! fmt black-box differential, the port's half: each line of cases.txt is a
//! Fletch body run through flfix (sagitta tests/unit/flfix.c:137-200's
//! rendering) after the shared prelude; one line of hex per case, as
//! c-cases.py prints C yew's io.print of the same body.

use flfix

fn hex(b: List[byte]) -> str {
    var out = List[byte]()
    for x in b {
        (mut out).push("0123456789abcdef".bytes()[x as int / 16])
        (mut out).push("0123456789abcdef".bytes()[x as int % 16])
    }
    str_from_utf8(out) else ""
}

fn main() -> int {
    let args = env_args()
    if args.len != 1 { eprint("usage: probe CASES"); return 2 }
    let text = fs_read_bytes(args[0]) else |_| { eprint("cannot read {args[0]}"); return 2 }
    let src = str_from_utf8(text) else { return 2 }
    let prelude = "import fmt\nimport math\nimport map\nimport list\nimport str\n"
    var f = flfix.open()
    for line in src.lines() {
        if line.len == 0 { continue }
        let out = flfix.run_bytes(mut f, prelude + line + "\n")
        print(hex(out))
    }
    flfix.close(mut f)
    0
}
