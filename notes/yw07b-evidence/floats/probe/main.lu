//! Black-box R-yw07-4 probe; only public std conversion APIs used.
use std.fmt.decimal as dec
use std.math.float as flt
fn show(bits: int) {
    let x = flt.from_bits(bits)
    print("bits={bits} back={flt.to_bits(x)} str={dec.to_str(x)}")
    for p in 0..3 { print("p={p} f={dec.to_str_fixed(x, p)} e={dec.to_str_exp(x, p)}") }
}
fn main() {
    show(0)
    show(-9223372036854775807 - 1)
    show(4607632778762754458)
    show(1)
    show(9218868437227405312)
    show(-4503599627370496)
    show(9221120237041090560)
    show(-2251799813685248)
    for s in ["1.5", "1e309", "nan", "inf", "0x1p2", " 1.5", "1.5 ", "-0.0"] {
        let x = dec.parse_float(s) else |e| { print("parse {s}: {e}"); continue }
        print("parse {s}: {flt.to_bits(x)}")
    }
}
