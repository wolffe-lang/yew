//! R4 black-box public conversion corpus. Staged next to src/fl at build.

use fl
use std.math.float as floats

fn emit(mut out: List[byte], kind: str, p: int, text: str) {
    for b in "{kind}:{p}:{text}\n".bytes() { (mut out).push(b) }
}

fn main() -> int {
    let fd = fs_open_mode("/dev/stdout", 2) else |_| { return 1 }
    loop {
        region row {
            let line = read_line() else |e| match e {
                eof => { break },
                _ => { return 2 },
            }
            var out = List[byte]()
            if line.starts_with("P ") {
                let (value, end) = fl.float_scan(line[2..])
                emit(mut out, "parse", end, "{floats.to_bits(value)}")
            } else {
                let bits = line[2..].to_int() else { return 3 }
                let value = floats.from_bits(bits)
                emit(mut out, "bits", 0, "{floats.to_bits(value)}")
                for p in 0..=17 {
                    emit(mut out, "fixed", p, fl.float_fixed(value, p))
                    emit(mut out, "exp", p, fl.float_exp(value, p))
                }
                for p in 15..=17 { emit(mut out, "general", p, fl.float_general(value, p)) }
                emit(mut out, "shortest", 0, fl.float_shortest(value))
            }
            fs_write_chunk(fd, out) else |_| { return 4 }
        }
    }
    fs_close(fd) else |_| { return 5 }
    0
}
