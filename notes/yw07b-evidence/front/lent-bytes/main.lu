//! Reduced fl_diag_add_file witness: a lent byte view copied into a field.
struct File { src: List[byte] }
fn add(mut files: List[File], src: List[byte]) {
    (mut files).push(File { src: copy src })
}
fn main() {
    var files = List[File]()
    add(mut files, "abc".bytes())
    assert(files[0].src.len == 3)
}
