import list
import fmt
import io
let log = []
fn cmp(a, b) {
  list.push(log, [a, b])
  return a - b
}
let l = [3, 1, 2]
list.sort(l, cmp)
io.print(fmt.repr(l))
io.print(fmt.repr(log))
log = []
l = [5, 3, 8, 1, 9, 2, 7]
list.sort(l, cmp)
io.print(fmt.repr(l))
io.print(fmt.repr(log))
log = []
l = [4, 4, 1, 4, 0, 9, 9, 2, 6, 5, 3, 8, 7]
list.sort(l, cmp)
io.print(fmt.repr(l))
io.print(fmt.repr(log))
let n = 0
fn bad(a, b) {
  n = n + 1
  if n == 2 { return 1 / 0 }
  return a - b
}
l = [3, 2, 1]
let r = nil
try { list.sort(l, bad) } catch e { r = e }
io.print(fmt.repr(r))
io.print(fmt.repr(l) + " " + fmt.repr(n))
n = 0
fn flt(a, b) { n = n + 1
 return 1.5 }
r = nil
try { list.sort(l, flt) } catch e { r = e }
io.print(fmt.repr(r) + " " + fmt.repr(n))
let nan = 0.0 / 0.0
l = [2, nan, 1, 0.5, nan, -1]
list.sort(l)
for x in l { if x != x { io.print("nan") } else { io.print(fmt.repr(x)) } }
l = ["s", 1, nil, true, 1.5, -2, false, "", "ab", "a", "b"]
list.sort(l)
io.print(fmt.repr(l))
let a = [1]
let b = [2]
let m1 = {}
let m2 = {}
l = [m2, b, cmp, m1, a, bad, "z"]
list.sort(l)
io.print(fmt.repr(l[0]) + fmt.repr(l[1]) + fmt.repr(l[2]))
io.print(fmt.repr(l[3] == m1) + fmt.repr(l[4] == m2) + fmt.repr(l[5] == cmp) + fmt.repr(l[6] == bad))
