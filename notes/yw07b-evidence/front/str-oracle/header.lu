//! member: false
//! Direct coverage of the str natives, every row's answer the pinned C
//! yew's. sagitta 9ace98c2 src/fl/stdstr.c:35-975. GENERATED by
//! notes/yw07b-evidence/front/str-oracle/gen.py from the table that also
//! wrote the C program (cases.fl) whose output (cases.out) is each row's
//! expected answer; edit the table and regenerate (then wolf fmt), never
//! this file. Each row calls fl_std_str_dispatch directly, its arguments
//! in the VM's first stack slots, and renders the outcome as the C program
//! does: a str's bytes, an int, true/false, nil, a raise as `!kind: msg`, a
//! list as `L<n>:` and its items (strs joined by 0x01, ints each followed
//! by a comma), and a float as nan, inf, -inf or C's fmt.repr text,
//! compared by value and sign once float_scan has read that text back.

use fl
use std.math.float as floats

fn vm_new() -> fl.FlVm {
    var strings = fl.fl_strings()
    fl.fl_vm_new(take strings)
}

fn nibble(c: byte) -> int {
    let x = c as int
    if x <= 57 then x - 48 else x - 87
}

fn unhex(h: str) -> List[byte] {
    var out = List[byte]()
    var i = 0
    while i + 1 < h.len {
        (mut out).push((nibble(h.bytes()[i]) * 16 + nibble(h.bytes()[i + 1])) as byte)
        i += 2
    }
    out
}

fn tohex(b: List[byte]) -> str {
    let digits = "0123456789abcdef"
    var out = List[byte]()
    for x in b {
        (mut out).push(digits.bytes()[x as int / 16])
        (mut out).push(digits.bytes()[x as int % 16])
    }
    str_from_utf8(out) else ""
}

fn s(mut vm: fl.FlVm, h: str) -> fl.FlValue { fl.fl_str_new(mut vm, unhex(h)) }

fn lv(mut vm: fl.FlVm, items: List[fl.FlValue]) -> fl.FlValue {
    let l = fl.fl_list_new(mut vm)
    for x in items { fl.fl_list_push(mut vm, l, x) }
    l
}

fn put(mut out: List[byte], text: str) {
    for b in text.bytes() { (mut out).push(b) }
}

fn put_obj(mut out: List[byte], vm: fl.FlVm, v: fl.FlValue) {
    for b in vm.gc.slots[fl.fl_obj_index(vm, v)].bytes { (mut out).push(b) }
}

fn render(mut vm: fl.FlVm, v: fl.FlValue, k: str) -> List[byte] {
    var out = List[byte]()
    if vm.raised {
        let kk = fl.fl_str_text(mut vm, "kind")
        let mk = fl.fl_str_text(mut vm, "msg")
        let kind = fl.fl_map_get(vm, vm.err, kk) else fl.fl_nil()
        let msg = fl.fl_map_get(vm, vm.err, mk) else fl.fl_nil()
        put(mut out, "!")
        put_obj(mut out, vm, kind)
        put(mut out, ": ")
        put_obj(mut out, vm, msg)
        return out
    }
    if k == "s" && v.t == 4 {
        put_obj(mut out, vm, v)
    } else if (k == "i" || k == "n") && v.t == 2 {
        put(mut out, "{v.i}")
    } else if (k == "n" || k == "f") && v.t == 0 {
        put(mut out, "nil")
    } else if k == "b" && v.t == 1 {
        put(mut out, if v.i != 0 then "true" else "false")
    } else if k == "f" && v.t == 3 {
        if floats.is_nan(v.f) {
            put(mut out, "nan")
        } else if floats.is_inf(v.f) {
            put(mut out, if v.f > 0.0 then "inf" else "-inf")
        } else {
            put(mut out, "<finite>")
        }
    } else if (k == "ls" || k == "li") && v.t == 5 {
        let n = fl.fl_list_len(vm, v)
        put(mut out, "L{n}:")
        for i in 0..n {
            let x = fl.fl_list_get(vm, v, i) else fl.fl_nil()
            if k == "ls" {
                if i > 0 { (mut out).push(1 as byte) }
                put_obj(mut out, vm, x)
            } else {
                put(mut out, "{x.i},")
            }
        }
    } else {
        put(mut out, "<{fl.fl_type_name(v.t)}>")
    }
    out
}

// C's fmt.repr text for a finite float, read back by the corpus-checked
// strtod port and compared with the native's answer by value and sign.
fn same_float(v: fl.FlValue, want: List[byte]) -> bool {
    if v.t != 3 { return false }
    let text = str_from_utf8(want) else { return false }
    let (x, n) = fl.float_scan(text)
    n == text.len && x == v.f && floats.is_sign_negative(x) == floats.is_sign_negative(v.f)
}

fn row(mut vm: fl.FlVm, idx: int, kind: int, args: List[fl.FlValue], k: str, want: str) {
    vm.raised = false
    vm.err = fl.fl_nil()
    vm.sp = args.len
    for i in 0..args.len { vm.stack[i] = copy args[i] }
    let defs = fl.fl_str_defs()
    let name = "str.{defs[kind].name}"
    vm.cur_native = fl.fl_intern(mut vm.strings, name.bytes(), 0, name.len)
    let v = fl.fl_std_str_dispatch(mut vm, kind, 0, args.len)
    assert(vm.temp.len == 0)
    let raised = vm.raised
    let got = render(mut vm, v, k)
    var ok = tohex(got) == want
    if !ok && k == "f" && !raised { ok = same_float(v, unhex(want)) }
    if !ok {
        let shown = tohex(got)
        eprint("row {idx} {name}: got {shown} want {want}")
    }
    assert(ok)
}
