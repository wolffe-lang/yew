import str
import fmt
import io
import list
fn hex(s) {
  let out = ""
  for b in str.bytes(s) { out = out + fmt.hex(b, 2) }
  return out
}
fn rs(v) { return v }
fn ri(v) { return fmt.str(v) }
fn rb(v) {
  if v { return "true" }
  return "false"
}
fn rn(v) {
  if v == nil { return "nil" }
  return fmt.str(v)
}
fn rf(v) {
  if v == nil { return "nil" }
  if v != v { return "nan" }
  if v == 1.0 / 0.0 { return "inf" }
  if v == -1.0 / 0.0 { return "-inf" }
  return fmt.repr(v)
}
fn rls(v) { return "L" + fmt.str(list.len(v)) + ":" + str.join(v, "\x01") }
fn rli(v) {
  let out = "L" + fmt.str(list.len(v)) + ":"
  for x in v { out = out + fmt.str(x) + "," }
  return out
}
