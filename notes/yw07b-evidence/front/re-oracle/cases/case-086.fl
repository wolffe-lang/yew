import re
import str
import list
import map
import io
fn istr(n) {
  if n == 0 { return "0" }
  let neg = n < 0
  let digits = "0123456789"
  let out = ""
  while n != 0 {
    let d = n % 10
    if d < 0 { d = 0 - d }
    out = str.at(digits, d) + out
    n = n / 10
  }
  if neg { return "-" + out }
  return out
}
fn R(v) {
  if v == nil { return "nil" }
  if v == true { return "true" }
  if v == false { return "false" }
  let k = 0
  try {
    str.len_bytes(v)
    k = 1
  } catch e { k = 0 }
  if k == 1 { return "'" + v + "'" }
  try {
    list.len(v)
    k = 2
  } catch e { k = 0 }
  if k == 2 {
    let out = "["
    let first = true
    for x in v {
      if first == false { out = out + "," }
      first = false
      out = out + R(x)
    }
    return out + "]"
  }
  try {
    map.len(v)
    k = 3
  } catch e { k = 0 }
  if k == 3 {
    let out = "{"
    let first = true
    for key, val in v {
      if first == false { out = out + "," }
      first = false
      out = out + key + "=" + R(val)
    }
    return out + "}"
  }
  return istr(v)
}
fn body() {
  return re.replace("a1b", "([a-z])([0-9])", "${12}")
}
let r = nil
try { r = R(body()) } catch e { r = "!" + e.kind + ": " + e.msg }
io.print(r)
