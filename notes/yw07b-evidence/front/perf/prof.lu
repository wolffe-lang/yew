//! The parse_only row's timed region alone (core's headless main.lu:36-42:
//! fl_diag_add_file + fl_parse of runtime/init.fl), repeated in a fresh
//! region per turn so a profile and an A/B see the front end only.
//!   prof INIT.FL TURNS   -> median and min ns per turn
use fl
use util

fn less(a: int, b: int) -> bool { a < b }

fn main() -> int {
    let args = env_args()
    if args.len != 2 { return 2 }
    let source = fs_read_bytes(args[0]) else { return 3 }
    let turns = args[1].to_int() else { return 2 }
    var times = List[int]()
    var nodes = 0
    for _ in 0..turns {
        var dt = 0
        region trial {
            var strings = fl.fl_strings()
            var dc = fl.fl_diag_init()
            let begin = os_clock_ns()
            let id = fl.fl_diag_add_file(mut dc, "runtime/init.fl", source)
            let p = fl.fl_parse(source, id, mut dc, mut strings)
            dt = os_clock_ns() - begin
            if p.had_error { return 1 }
            nodes = p.nodes.len
        }
        // G50: never grow a List owned outside the region from inside it.
        (mut times).push(dt)
    }
    util.sort_stable(mut times, less)
    print("turns={turns} nodes={nodes} median_ns={times[times.len / 2]} min_ns={times[0]}")
    0
}
