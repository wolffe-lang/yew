//! G18/G33's witness at the editor's scale (yw03): a session-long value
//! mutated once a turn cannot have the turn's temporaries freed. Every
//! string `render` interpolates lands in its caller's region — the
//! loop's, the session's — so `without-region.lu` holds all 200,000
//! (VmRSS ~8.7 MB, `run.txt`); wrapping the turn in `region turn { }`
//! (`with-region.lu`) is E1010, the mutated value "still holds a value
//! allocated in region `turn`" (its frame bytes, pushed into storage
//! the value already owns). The editor's line move retains ~630 B a key
//! this way (notes/yw03-the-modal-core.md §4.6).

struct S {
    v: List[int],
    frame: List[byte],
    n: int,
}

fn render(mut s: S, i: int) {
    let t = "row {i}: {s.n} {i * 7}"
    while s.frame.len != 0 {
        let _ = (mut s.frame).pop() else 0 as byte
    }
    for b in t.bytes() {
        (mut s.frame).push(b)
    }
    s.v[0] = t.len
    s.n += 1
}

fn main() {
    var s = S { v: List[int](), frame: List[byte](), n: 0 }
    (mut s.v).push(0)
    var i = 0
    while i < 200000 {
        render(mut s, i)
        i += 1
    }
    let st = fs_read_bytes("/proc/self/status") else |_| List[byte]()
    let txt = str_from_utf8(st) else ""
    for line in txt.lines() {
        if line.starts_with("VmRSS") {
            print("{s.n} {s.v[0]} {line}")
        }
    }
}
