//! G35's witness (yw03): a `take` parameter stored into a `mut`
//! parameter's container is E1004 — "parameter regions are independent
//! by default" — though `take` hands the value over. The editor's
//! `finish_lift` had this shape (`edit_cmds.lu`, before `efcc7a4`); the
//! port stores the lifted set in the CALLER, where it was built.
//!
//! The same store of a whole list ELEMENT (`h.boxes[0] = b`, with `b` a
//! `take` parameter) builds at 0.2.33; the store into a FIELD of an
//! element (`ed.wins[w].cs = replacement`) is the refused one
//! (`run.txt`, `wolf build main.lu`, exit 2).

struct Set {
    items: List[int],
    primary: int,
}

struct Win {
    cs: Set,
    id: int,
}

struct Ed {
    wins: List[Win],
    mode: int,
}

fn bounds(s: Set) -> int {
    if s.items.len == 0 then 0 else s.items[0]
}

fn install(mut ed: Ed, w: int, take replacement: Set, has: bool) -> int {
    if !has || replacement.items.len == 0 {
        return 0
    }
    let lo = bounds(replacement)
    ed.wins[w].cs = replacement
    lo
}

fn main() {
    var ed = Ed { wins: List[Win](), mode: 0 }
    (mut ed.wins).push(Win { cs: Set { items: List[int](), primary: 0 }, id: 1 })
    var s = Set { items: List[int](), primary: 0 }
    (mut s.items).push(1)
    let r = install(mut ed, 0, take s, true)
    print("{r} {ed.wins[0].cs.items.len}")
}
