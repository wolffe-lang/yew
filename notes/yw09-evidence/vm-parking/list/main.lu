//! member: false
//! yw09 VM parking through a retained one-element slot list. Empty means
//! the VM is executing; a command temporarily parks it for synchronous hooks.

struct Vm { stack: List[int] }

struct Editor { slots: List[Vm], seen: int }

fn unreachable_vm() -> Vm { assert(false); Vm { stack: List[int]() } }

fn nested(mut ed: Editor) {
    var vm = (mut ed.slots).pop() else unreachable_vm()
    (mut vm.stack).push(7)
    ed.seen = vm.stack.len
    (mut ed.slots).push(vm)
}

fn bridge(mut vm: Vm, mut ed: Editor) {
    assert(ed.slots.len == 0)
    (mut ed.slots).push(vm)
    nested(mut ed)
    vm = (mut ed.slots).pop() else unreachable_vm()
}

fn main() {
    var vm = Vm { stack: [1] }
    var ed = Editor { slots: List[Vm](), seen: 0 }
    bridge(mut vm, mut ed)
    assert(ed.seen == 2 && vm.stack.len == 2 && vm.stack[1] == 7 && ed.slots.len == 0)
    print("VM parking: PASS")
}
