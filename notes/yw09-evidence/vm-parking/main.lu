//! member: false
//! yw09 ownership witness: park a live VM in its editor while a synchronous
//! editor command may re-enter it, then restore the caller's VM before return.

struct Vm { stack: List[int] }

enum Slot { Empty, Live(Vm) }

struct Editor { slot: Slot, seen: int }

fn nested(mut ed: Editor) {
    let held = ed.slot
    ed.slot = Slot.Empty
    match held {
        Slot.Live(value) => {
            var vm = value
            (mut vm.stack).push(7)
            ed.seen = vm.stack.len
            ed.slot = Slot.Live(vm)
        },
        Slot.Empty => { assert(false) },
    }
}

fn unreachable_vm() -> Vm { assert(false); Vm { stack: List[int]() } }

fn bridge(mut vm: Vm, mut ed: Editor) {
    ed.slot = Slot.Live(vm)
    nested(mut ed)
    let held = ed.slot
    ed.slot = Slot.Empty
    vm = match held {
        Slot.Live(value) => value,
        Slot.Empty => unreachable_vm(),
    }
}

fn main() {
    var vm = Vm { stack: [1] }
    var ed = Editor { slot: Slot.Empty, seen: 0 }
    bridge(mut vm, mut ed)
    assert(ed.seen == 2 && vm.stack.len == 2 && vm.stack[1] == 7)
    print("VM parking: PASS")
}
