//! member: false
//! yw09 generic host witness with an entry-local nominal receiver.

use core

struct Editor { value: int }

impl core.Host for Editor {
    fn invoke(mut self, mut vm: core.Vm, kind: int) -> int {
        match kind {
            1 => { self.value += 7; self.value },
            2 => core.run(mut vm, mut self, 1),
            _ => 0,
        }
    }
}

fn nested_argument() -> int { 2 }

fn main() {
    var vm = core.Vm { calls: 0 }
    var ed = Editor { value: 0 }
    assert(core.run(mut vm, mut ed, nested_argument()) == 7)
    assert(vm.calls == 2 && ed.value == 7)
    print("host seam: nested dispatch 7, calls 2")
    assert(core.headless(mut vm) == 3)
}
