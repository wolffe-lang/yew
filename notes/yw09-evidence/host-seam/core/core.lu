//! A small mutable host seam: the VM is lower than its editor owner.

/// Count entries through the same execution body.
pub struct Vm { calls: int }

/// Static dispatch across the lower VM and upper host boundary.
pub trait Host {
    fn invoke(mut self, mut vm: Vm, kind: int) -> int
}

/// Enter the VM and invoke the selected host command.
pub fn run[H: Host](mut vm: Vm, mut host: H, kind: int) -> int {
    vm.calls += 1
    execute(mut vm, mut host, kind)
}

fn execute[H: Host](mut vm: Vm, mut host: H, kind: int) -> int {
    dispatch(mut vm, mut host, kind)
}

/// A second concrete implementation of the same host trait.
pub struct Null { calls: int }

impl Host for Null {
    fn invoke(mut self, mut vm: Vm, kind: int) -> int {
        self.calls += 1
        vm.calls += 1
        kind
    }
}

/// The headless wrapper instantiates the same generic VM body.
pub fn headless(mut vm: Vm) -> int {
    var host = Null { calls: 0 }
    run(mut vm, mut host, 3)
}
