use core

/// The upper host keeps its state outside the lower VM.
pub struct Editor { value: int }

/// Make the empty host used by the nesting witness.
pub fn new() -> Editor { Editor { value: 0 } }

impl core.Host for Editor {
    fn invoke(mut self, mut vm: core.Vm, kind: int) -> int {
        match kind {
            1 => { self.value += 7; self.value },
            2 => core.run(mut vm, mut self, 1),
            _ => 0,
        }
    }
}
