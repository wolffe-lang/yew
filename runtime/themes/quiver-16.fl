# Quiver 16 — explicit indexed syntax for a dark sixteen-colour document.
{
    theme: 1,
    name: "quiver-16",
    kind: "dark",
    palette: {
        bg: "#12141a", fg: "#c8ccd4", violet: "#c678dd",
        cyan: "#56b6c2", yellow: "#e5c07b", orange: "#d19a66",
        green: "#98c379", blue: "#61afef", red: "#e06c75",
        magenta: "#ff79c6", grey: "#5c6370",
    },
    ui: {
        bg: { idx: 0 }, fg: { idx: 7 },
        sel: { bg: "#2c313a", mono: "reverse" },
        cursor: { bg: "@fg", fg: "@bg", mono: "reverse" },
        "cursor.secondary": { reverse: true, mono: "reverse" },
        gutter: { fg: "#4b5263" },
        "gutter.cursor": { fg: "@fg", bold: true, mono: "bold" },
        "tab.bar": { bg: "#1b202a", fg: "@grey", mono: "plain" },
        "tab.active": { bg: "#2c313a", fg: "@fg", bold: true, mono: "reverse" },
        "tab.inactive": { bg: "#1b202a", fg: "@grey", mono: "plain" },
        "tab.modified": { bg: "#1b202a", fg: "@yellow", bold: true, mono: "bold" },
        "tab.orphan": { bg: "#1b202a", fg: "@grey", dim: true, mono: "dim" },
        "tab.add": { bg: "#1b202a", fg: "@blue", bold: true, mono: "bold" },
        # Context menus (s57.13 §6).  `menu.surface` paints the box and its
        # border; the widget itself knows no colours.
        "menu.surface": { bg: "#1b202a", fg: "#4b5263", mono: "plain" },
        "menu.row": { fg: "@fg", mono: "plain" },
        "menu.hover": { bg: "#2c313a", fg: "@fg", bold: true, mono: "reverse" },
        "menu.disabled": { fg: "@grey", dim: true, mono: "dim" },
        "menu.accel": { fg: "@grey", mono: "dim" },
        "menu.sep": { fg: "#4b5263", mono: "dim" },
        "mode.line": { bg: "@blue", fg: "@bg", mono: "bold" },
        "mode.word": { bg: "@cyan", fg: "@bg", mono: "bold" },
        "mode.block": { bg: "@violet", fg: "@bg", mono: "bold" },
        "mode.highlight": { bg: "@yellow", fg: "@bg", mono: "bold" },
        "mode.insert": { bg: "@green", fg: "@bg", mono: "bold" },
        "mode.explore": { bg: "@orange", fg: "@bg", mono: "bold" },
        "mode.git": { bg: "@magenta", fg: "@bg", mono: "bold" },
        # Compatibility for configurations that still reference the old role.
        "mode.fuss": { bg: "@red", fg: "@bg", mono: "bold" },
        "git.drawer": { bg: "#1b202a", fg: "@fg" },
        "git.drawer.edge": { fg: "#ffffff", bold: true, mono: "bold" },
        "git.staged": { fg: "@green", mono: "bold" },
        "git.modified": { fg: "@red", mono: "bold" },
        "git.untracked": { fg: "@grey", mono: "dim" },
        "git.incoming": { fg: "@blue", mono: "underline" },
        "git.conflict": { fg: "@red", bold: true, mono: "bold" },
        "git.ignored": { fg: "@grey", mono: "dim" },
        "git.blame": { fg: "@grey", dim: true, mono: "dim" },
        "git.blame.stale": { fg: "#3a3f4b", dim: true, mono: "dim" },
        "git.sign.add": { fg: "@green", mono: "bold" },
        "git.sign.mod": { fg: "@yellow", mono: "bold" },
        "git.sign.del": { fg: "@red", mono: "bold" },
        "git.sign.conflict": { fg: "@magenta", mono: "bold" },
        "git.sign.unknown": { fg: "@grey", dim: true, mono: "dim" },
        "git.diff.add": { bg: "#1e3326", fg: "@green", mono: "bold" },
        "git.diff.del": { bg: "#3b2429", fg: "@red", mono: "bold" },
        "git.diff.mod": { bg: "#3a3322", fg: "@yellow", mono: "bold" },
        "git.diff.filler": { fg: "@grey", mono: "dim" },
        "git.diff.intra.add": { bg: "#31573c", fg: "@green", mono: "reverse" },
        "git.diff.intra.del": { bg: "#64343b", fg: "@red", mono: "reverse" },
        "search.match": { bg: "#3e4451", mono: "bold" },
        "search.current": { bg: "@yellow", fg: "@bg", mono: "underline" },
        "shadow.index": { fg: "@blue", mono: "dim" },
        "shadow.lsp": { fg: "@violet", mono: "italic" },
        "shadow.ai": { fg: "@orange", mono: "underline" },
        "compl.word": { fg: "@fg", mono: "plain" },
        "compl.func": { fg: "@blue", mono: "bold" },
        "compl.type": { fg: "@yellow", mono: "bold" },
        "compl.macro": { fg: "@orange", mono: "plain" },
        "compl.keyword": { fg: "@violet", mono: "dim" },
        "lsp.hover_range": { bg: "#2c313a", underline: true, mono: "underline" },
        "lsp.highlight_read": { bg: "#2c313a", underline: true, mono: "underline" },
        "lsp.highlight_write": { bg: "#4a3640", bold: true, mono: "bold" },
        "diag.error": { fg: "@red", mono: "bold" },
        "diag.warn": { fg: "@yellow", mono: "bold" },
        "diag.info": { fg: "@blue", mono: "underline" },
        "diag.hint": { fg: "@cyan", mono: "plain" },
        "diag.unnecessary": { fg: "#5c6370", dim: true, mono: "dim" },
        "diag.deprecated": { fg: "@orange", strike: true, mono: "dim" },
        ul: { error: "#ff5f5f", warn: "#e5c07b", info: "#61afef" },
    },
    attrs: {
        text:               { fg: { idx: 7 }, mono: "plain" },
        keyword:            { fg: { idx: 13 }, mono: "plain" },
        "keyword.control":  { fg: { idx: 13 }, bold: true, mono: "bold" },
        "keyword.op":       { fg: { idx: 14 }, mono: "plain" },
        "keyword.storage":  { fg: { idx: 13 }, italic: true, mono: "italic" },
        type:               { fg: { idx: 11 }, mono: "plain" },
        "type.builtin":     { fg: { idx: 11 }, italic: true, mono: "italic" },
        constant:           { fg: { idx: 11 }, mono: "plain" },
        "constant.builtin": { fg: { idx: 11 }, bold: true, mono: "bold" },
        number:             { fg: { idx: 11 }, mono: "plain" },
        boolean:            { fg: { idx: 11 }, bold: true, mono: "bold" },
        character:          { fg: { idx: 10 }, mono: "plain" },
        string:             { fg: { idx: 10 }, mono: "plain" },
        "string.escape":    { fg: { idx: 14 }, mono: "plain" },
        "string.interp":    { fg: { idx: 14 }, mono: "plain" },
        "string.special":   { fg: { idx: 10 }, italic: true, mono: "italic" },
        comment:            { fg: { idx: 2 }, italic: true, mono: "italic" },
        "comment.doc":      { fg: { idx: 6 }, italic: true, mono: "italic" },
        "comment.todo":     { fg: { idx: 11 }, bold: true, mono: "reverse" },
        function:           { fg: { idx: 14 }, mono: "plain" },
        "function.builtin": { fg: { idx: 14 }, italic: true, mono: "italic" },
        "function.macro":   { fg: { idx: 14 }, bold: true, mono: "bold" },
        method:             { fg: { idx: 14 }, mono: "plain" },
        variable:           { fg: { idx: 7 }, mono: "plain" },
        "variable.builtin": { fg: { idx: 9 }, italic: true, mono: "italic" },
        "variable.param":   { fg: { idx: 7 }, italic: true, mono: "italic" },
        "variable.member":  { fg: { idx: 9 }, mono: "plain" },
        namespace:          { fg: { idx: 14 }, mono: "plain" },
        label:              { fg: { idx: 13 }, mono: "underline" },
        attribute:          { fg: { idx: 11 }, mono: "plain" },
        preproc:            { fg: { idx: 13 }, mono: "plain" },
        operator:           { fg: { idx: 14 }, mono: "plain" },
        punct:              { fg: { idx: 7 }, mono: "plain" },
        "punct.bracket":    { fg: { idx: 7 }, mono: "plain" },
        "punct.delim":      { fg: { idx: 7 }, mono: "plain" },
        tag:                { fg: { idx: 9 }, mono: "bold" },
        "tag.attr":         { fg: { idx: 11 }, mono: "plain" },
        heading:            { fg: { idx: 15 }, bold: true, mono: "bold" },
        link:               { fg: { idx: 14 }, underline: true, mono: "underline" },
        emphasis:           { fg: { idx: 7 }, italic: true, mono: "italic" },
        strong:             { fg: { idx: 15 }, bold: true, mono: "bold" },
        code:               { fg: { idx: 10 }, mono: "plain" },
        list:               { fg: { idx: 13 }, mono: "plain" },
        quote:              { fg: { idx: 2 }, italic: true, mono: "italic" },
        "diff.add":         { fg: { idx: 10 }, mono: "plain" },
        "diff.del":         { fg: { idx: 9 }, mono: "plain" },
        error:              { fg: { idx: 9 }, bold: true, undercurl: true,
                              ul: "error", mono: "reverse" },
        warning:            { fg: { idx: 11 }, undercurl: true,
                              ul: "warn", mono: "underline" },
        "whitespace.special": { fg: { idx: 9 }, mono: "plain" },
        "motion.unit":      { fg: { idx: 13 }, bold: true, mono: "bold" },
        "motion.arrow":     { fg: { idx: 14 }, mono: "plain" },
        "motion.count":     { fg: { idx: 11 }, mono: "plain" },
        "motion.cmd":       { fg: { idx: 14 }, mono: "plain" },
        "ui.invisible":     { fg: { idx: 8 }, mono: "plain" },
    },
}
