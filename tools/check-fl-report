#!/bin/sh
# The allocation-free formatter, measured natively (G53 excludes checked
# List.reset accounting). Build failures are fatal, never skips/advisories.
set -eu
YEW_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh
. tools/lib-test-env.sh
test_env_begin
export YEW_RUNTIME_DIR="$YEW_ROOT/runtime"
mkdir -p target/tools
"$WOLF" build --deny-warnings src/fl_bug_report_test.lu -o target/tools/fl-report-check
YEW_FL_BUG_REPORT_NATIVE=1 target/tools/fl-report-check
