#!/bin/sh
# Exercise the actual private guards, not mocks. The entry and mutations
# exist only in this driver-owned snapshot, never in the shipping package.
set -eu
YEW_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh
. tools/lib-test-env.sh
test_env_begin
export YEW_RUNTIME_DIR="$YEW_ROOT/runtime"
unset YEW_FL_DUMP_BAD_CHUNK
stage="$YEW_ROOT/target/fl-invariant-check"
case "$stage" in "$YEW_ROOT/target/fl-invariant-check") ;; *) exit 2 ;; esac
rm -rf -- "$stage"
mkdir -p "$stage" target/tools target/fl-invariant-results
cp -R src/. "$stage/"
find "$stage" -maxdepth 1 -type f -name '*.lu' -delete
find "$stage" -type f -name '*_test.lu' -delete
cp src/fl/*.lu "$stage/"
rm -rf -- "$stage/fl"
cp tools/fl-invariant-check/main.lu "$stage/main.lu"
"$WOLF" build --deny-warnings "$stage/main.lu" -o target/tools/fl-invariant-check
n=0
while IFS='|' read -r name why; do
    set +e
    target/tools/fl-invariant-check "$name" >"target/fl-invariant-results/$name.out" 2>"target/fl-invariant-results/$name.err"
    rc=$?
    set -e
    [ "$rc" = 4 ] || { echo "fl-invariant $name: FAIL exit=$rc want=4"; exit 1; }
    for field in "$why" 'opcode :' 'fn     :' 'frames :' 'build  :' 'hint   :' 'please report this internal error'; do
        grep -F "$field" "target/fl-invariant-results/$name.err" >/dev/null || { echo "fl-invariant $name: FAIL missing $field"; exit 1; }
    done
    where=src/fl/vm.lu
    [ "$name" != white ] || where=src/fl/gc.lu
    grep -F "internal error at $where:" "target/fl-invariant-results/$name.err" >/dev/null || { echo "fl-invariant $name: FAIL wrong owner"; exit 1; }
    echo "fl-invariant $name: exit 4, structured $why: PASS"
    n=$((n + 1))
done <<'CASES'
opcode|unknown opcode
underflow|stack underflow
stack-top|stack pointer past the top
constant|constant index out of range
local|local slot outside the frame
upvalue|upvalue index out of range
handler-empty|handler stack underflow
handler-full|handler stack overflow
edit-empty|edit depth underflow
edit-full|edit depth overflow
frame|frame underflow on RETURN
white|reachable-but-white object
pc|instruction pointer outside the chunk
CASES
[ "$n" = 13 ]
echo 'fl-invariants: 13 rows GREEN'
