#!/usr/bin/env bash
# run-fuzz-flapi — Sprint 34 §8's editor-API fuzz: generational handles
# (held, released, crafted {kind, slot, gen}, dropped with their buffer, and
# nil) and `ed.run`'s generic marshalling against a real scratch editor;
# every refusal a `handle` or `type` raise, no crafted handle resolving
# while dead, every failed run one of the 13 kinds of tests/fuzz/
# fl_kinds.h, the run envelope opened and closed around each.
#
#   tools/run-fuzz-flapi [--native] [--against-oracle] [--iters=N] [--seed=N]
#
# Builds tools/fuzz-flapi/main.lu (tools/build-fuzz-flapi; FUZZ_PREBUILT=1
# runs the driver already built), runs its own controls, then the campaign
# from the repository root. The defaults are sagitta's (200,000 iterations,
# seed 1: `make fuzz-iter`, Makefile:2270). `--against-oracle` also runs
# C's own driver ($SAGITTA_TREE/build/fuzz_flapi, default
# target/oracle/sagitta, which tools/oracle builds) with the same
# arguments and requires the two report lines to be equal byte for byte; a
# missing C driver is exit 2, never a silent pass. Exit is the driver's: 0
# when every input held, 1 with the failing input printed as hex, 2 on a
# usage error.
set -euo pipefail
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
native=; oracle=0; args=()
for a in "$@"; do
    case "$a" in
    --native) native=--native ;;
    --against-oracle) oracle=1 ;;
    --iters=*|--seed=*) args+=("$a") ;;
    *) echo "run-fuzz-flapi: unknown argument $a" >&2; exit 2 ;;
    esac
done
tree=${SAGITTA_TREE:-target/oracle/sagitta}
if [ "$oracle" = 1 ] && [ ! -x "$tree/build/fuzz_flapi" ]; then
    echo "run-fuzz-flapi: $tree/build/fuzz_flapi is not built (tools/oracle builds it)" >&2
    exit 2
fi
if [ "${FUZZ_PREBUILT:-0}" != 1 ]; then tools/build-fuzz-flapi $native; fi
# Private HOME/XDG roots for the run (yew#11); the build above needs none.
. tools/lib-test-env.sh
test_env_begin
export YEW_RUNTIME_DIR="$YEW_ROOT/runtime"
target/tools/fuzz-flapi --selftest
rc=0
mkdir -p target/fuzz-flapi
err=target/fuzz-flapi/driver.stderr
port=$(target/tools/fuzz-flapi "${args[@]}" 2>"$err") || rc=$?
cat "$err" >&2
echo "port: $port"
[ "$rc" = 0 ] || { echo "run-fuzz-flapi: the port's driver exited $rc" >&2; exit "$rc"; }
# The report line's hash covers the generated stream, not the check, so a
# driver that skipped its body would still equal C's. The tally (stderr)
# must show the campaign executed: operations ran, resolves were refused,
# and ed.run ran and raised.
tally=$(grep -E '^fuzz_flapi: ops=[0-9]+ resolved=[0-9]+ refused=[0-9]+ crafted_alive=[0-9]+ runs=[0-9]+ run_raised=[0-9]+$' "$err" | tail -1) || true
[ -n "$tally" ] || { echo "run-fuzz-flapi: the driver printed no tally" >&2; exit 1; }
field() { printf '%s\n' "$tally" | sed -E "s/.* $1=([0-9]+).*/\\1/"; }
ops=$(field ops); refused=$(field refused); runs=$(field runs); raised=$(field run_raised)
if [ "$ops" -lt 1 ] || [ "$refused" -lt 1 ] || [ "$runs" -lt 1 ] || [ "$raised" -lt 1 ]; then
    echo "run-fuzz-flapi: the campaign did not execute its inputs (ops=$ops refused=$refused runs=$runs run_raised=$raised)" >&2
    exit 1
fi
if [ "$oracle" = 1 ]; then
    c=$(cd "$tree" && build/fuzz_flapi "${args[@]}") || { echo "C:    $c"; exit 1; }
    echo "C:    $c"
    if [ "$port" != "$c" ]; then
        echo "run-fuzz-flapi: the port's report differs from C's" >&2
        exit 1
    fi
    echo "PASS: oracle/port report lines identical"
fi
