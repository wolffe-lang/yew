#!/bin/sh
# run-perf-editor — the 2× gate on the EDITOR (yw03 contract §6): sagitta's
# own editor harnesses, tests/perf/perf_startup.c (`perf_startup_s56`:
# cold start → first paint, default / --clean / TERM=dumb, and the
# spawn floor) and tests/perf/latency.c (`perf_latency`: cold open, 10,000
# keypresses, arrows free and paced, the kitty Backspace pair), run over
# C yew and the port from the same run — C, the port, then C again (the
# rig's drift, reported, not used) — and each metric's port/C ratio
# printed, red above 2.0 except exact host/metric MISS rows in
# tools/perf-editor-misses.txt (owner and issue printed on the row).
# yew#53 is the pre-existing first-backspace ratchet. yew#55 tracks the
# pin-attributed clean/cold startup MISS, owned by s265 / wolf-lang#918.
# Cold-open attribution: G49, wolf-lang#918. R-yw07-12 gates the median
# of five C-stable triples for EVERY ratio row, all raw trials recorded.
# Drift is max(C,C-again)/min(C,C-again); >1.25 discards that metric's
# trial and asks for another. The first five valid triples are final;
# never select by port speed. At most 20 triples, then a harness fault.
# C's harness is never modified.
#
#   tools/run-perf-editor [--cpus 0-3] [--yew BIN] [--c-yew BIN] [--workspace]
#
# The harnesses are the oracle's (tools/oracle builds them); their own
# absolute budgets print beside each row but are advisory here
# (`YEW_PERF_ADVISORY=1`): the gate is the ratio. They refuse to measure
# unless YEW_RUNTIME_DIR is the checkout's runtime/ and they run from the
# checkout (`perf_runtime.h:37-62`), so both editors read sagitta's
# runtime/ — the port's embedded copy is the same bytes (tools/check-
# runtime). HOME and XDG_CONFIG_HOME are a scratch directory, so neither
# editor reads a user configuration. The startup harness's batch row
# needs --batch (yw09): not passed, so it prints it UNSUPPORTED, as it
# does without it. `--workspace` (yw06) adds the workspace50 row:
# `--workspace DIR buf-00.c … buf-49.c`, fifty copies of the oracle's
# tests/perf/fixtures/syn/c_kitchen.c as `make perf-startup-s56` builds
# them (Makefile:3315-3323), every tab deferred but the last; C highlights
# that first painted `.c` buffer and the port cannot until yw10, so the
# ratio is read beside that caveat.
#
# The harnesses SIGKILL a child that does not quit (`live_pty.c:489-501`):
# on the pool this runs inside a container (sprints/RULES.md §5).
#
# Exit 0 for PASS or named MISS, 1 for any unlisted ratio failure,
# 2 on a harness/ledger fault. Harness failures are never a MISS.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"

cpus=
tree=$YEW_ROOT/target/oracle/sagitta
yew=$YEW_ROOT/target/release/yew
c_yew=$tree/build/yew
workspace=0
while [ $# -gt 0 ]; do
    case "$1" in
    --workspace) workspace=1; shift ;;
    --cpus) cpus=$2; shift 2 ;;
    --yew) yew=$2; shift 2 ;;
    --c-yew) c_yew=$2; shift 2 ;;
    *) echo "run-perf-editor: unknown option $1" >&2; exit 2 ;;
    esac
done
b=$tree/build
for f in "$b/perf_startup_s56" "$b/perf_latency" "$b/perf_nullexec" "$c_yew" "$yew"; do
    [ -x "$f" ] || { echo "run-perf-editor: missing $f (tools/oracle, tools/build --release)" >&2; exit 2; }
done
case "$yew" in /*) ;; *) yew=$YEW_ROOT/$yew ;; esac
pin=
if [ -n "$cpus" ]; then
    command -v taskset >/dev/null || { echo "run-perf-editor: --cpus needs taskset" >&2; exit 2; }
    pin="taskset -c $cpus"
fi
out=$YEW_ROOT/target/perf-editor
rm -rf "$out"
mkdir -p "$out/home/config" "$out/fixtures"
: >"$out/fixtures/empty.c"
wsarg=
if [ "$workspace" = 1 ]; then
    mkdir -p "$out/many"
    n=0
    while [ $n -lt 50 ]; do
        cp "$tree/tests/perf/fixtures/syn/c_kitchen.c" "$out/many/buf-$(printf '%02d' $n).c"
        n=$((n + 1))
    done
    wsarg="--workspace $out/many"
fi
export HOME=$out/home XDG_CONFIG_HOME=$out/home/config
export YEW_RUNTIME_DIR=$tree/runtime YEW_PERF_ADVISORY=1
baseline=$tree/tests/perf/baselines/latency-x86_64-linux-gnu.txt

metrics="startup.first_paint.default startup.first_paint.clean startup.first_paint.dumb \
    cold_open_to_first_paint keypress_to_paint_p99 cursor_arrow_to_paint_p99 \
    cursor_arrow_to_paint_p99_paced wolf_kitty_first_backspace_to_paint \
    wolf_kitty_backspace_to_paint_max"
[ "$workspace" = 1 ] && metrics="$metrics startup.first_paint.workspace50"

# Each trial is the same original C startup + latency pair.
run_trial() {
    label=$1; binary=$2; trial=$3
    rm -rf "$out/state-$label-$trial"
    mkdir -p "$out/state-$label-$trial"
    set +e
    (cd "$tree" && $pin "$b/perf_startup_s56" --yew "$binary" --nullexec "$b/perf_nullexec" \
        --fixture "$out/fixtures/empty.c" --state "$out/state-$label-$trial" \
        --budgets tests/perf/budgets.txt $wsarg) >"$out/startup-$label-$trial.txt" 2>&1
    startup_rc=$?
    (cd "$tree" && $pin "$b/perf_latency" --yew "$binary" --baseline "$baseline") >"$out/latency-$label-$trial.txt" 2>&1
    latency_rc=$?
    set -e
    sed "s/^/$label.trial-$trial: /" "$out/startup-$label-$trial.txt" "$out/latency-$label-$trial.txt"
    if [ "$startup_rc" -gt 1 ] || [ "$latency_rc" -gt 1 ]; then
        echo "run-perf-editor: $label trial $trial harness fault (startup=$startup_rc latency=$latency_rc)" >&2
        exit 2
    fi
}
trial=1
ready=0
while [ "$trial" -le 20 ]; do
    run_trial c "$c_yew" "$trial"
    run_trial wolf "$yew" "$trial"
    run_trial c2 "$c_yew" "$trial"
    set +e
    # shellcheck disable=SC2086
    python3 -I "$YEW_ROOT/tools/perf-editor-samples" "$out" "$trial" $metrics
    sampled=$?
    set -e
    if [ "$sampled" = 0 ]; then ready=1; break; fi
    [ "$sampled" = 3 ] || exit 2
    trial=$((trial + 1))
done
[ "$ready" = 1 ] || { echo "run-perf-editor: fewer than five C-stable trials after 20 triples" >&2; exit 2; }

# value <label> <metric>: the row's nanoseconds.
value() { cat "$out/median-$2-$1.txt"; }
rc=0
for metric in $metrics; do
    c=$(value c "$metric")
    w=$(value wolf "$metric")
    c2=$(value c2 "$metric")
    [ -n "$c" ] && [ -n "$w" ] && [ -n "$c2" ] || { echo "run-perf-editor: $metric: a run printed no value" >&2; exit 2; }
    ratio=$(awk -v w="$w" -v c="$c" 'BEGIN { printf "%.2f", w / c }')
    drift=$(awk -v a="$c" -v b="$c2" 'BEGIN { printf "%.2f", b / a }')
    verdict=$(python3 -I "$YEW_ROOT/tools/perf-editor-verdict" "$metric" "$ratio")
    accepted=$(cat "$out/accepted-$metric.txt")
    echo "ratio.$metric wolf/c=$ratio (c=${c}ns, wolf=${w}ns, c again=${c2}ns, drift=$drift) limit=2.0 verdict=$verdict median=5 accepted=$accepted"
    case "$verdict" in
        PASS | MISS\ *) ;;
        FAIL) rc=1 ;;
        *) echo "run-perf-editor: invalid verdict: $verdict" >&2; exit 2 ;;
    esac
done
# mem.workspace50 (`budgets.txt:62`, `make perf-mem-s56`'s recipe,
# Makefile:3371-3437): the workspace start once more per editor under
# YEW_PROF=1 with its log kept, and sagitta's perf_mem reading the
# editor's own `rss checkpoint=paint` line (the port writes it since yw06,
# `util.rss`); C's number beside the port's, the ratio a FINDING (the
# memory budget is C's, not a 2x gate).
if [ "$workspace" = 1 ]; then
    [ -x "$b/perf_mem_s56" ] || { echo "run-perf-editor: missing $b/perf_mem_s56 (tools/oracle)" >&2; exit 2; }
    mem() {
        rm -rf "$out/mem-$1.log" "$out/mstate-$1"
        mkdir -p "$out/mstate-$1"
        (cd "$tree" && YEW_PROF=1 PERF_GATE=0 YEW_PERF_LOG_WORKSPACE="$out/mem-$1.log" \
            $pin "$b/perf_startup_s56" --yew "$2" --nullexec "$b/perf_nullexec" \
            --fixture "$out/fixtures/empty.c" --state "$out/mstate-$1" \
            --budgets tests/perf/budgets.txt --workspace "$out/many") >"$out/memstart-$1.txt" 2>&1 || true
        (cd "$tree" && PERF_GATE=0 "$b/perf_mem_s56" --budgets tests/perf/budgets.txt \
            --yew "$2" --state "$out/mstate-$1" --log-workspace "$out/mem-$1.log") >"$out/memrep-$1.txt" 2>&1 || true
        sed "s/^/$1: /" "$out/memrep-$1.txt" | grep "mem.workspace50" || true
    }
    mem c "$c_yew"
    mem wolf "$yew"
    mc=$(sed -n 's/^mem.workspace50 value_bytes=\([0-9]*\).*/\1/p' "$out/memrep-c.txt")
    mw=$(sed -n 's/^mem.workspace50 value_bytes=\([0-9]*\).*/\1/p' "$out/memrep-wolf.txt")
    if [ -n "$mc" ] && [ -n "$mw" ]; then
        echo "mem.workspace50 wolf/c=$(awk -v w="$mw" -v c="$mc" 'BEGIN { printf "%.2f", w / c }') (c=${mc} bytes, wolf=${mw} bytes; budget 41943040)"
    else
        echo "mem.workspace50: a run printed no value (c=${mc:-none}, wolf=${mw:-none})"
    fi
fi
exit $rc
