#!/usr/bin/env bash
# oracle — C yew at the pin: fetch, build, run its own suites, record.
#
#   tools/oracle [--cc CC]... [--unit | --test | --build-only] [--jobs N]
#
# Fetches tenseleyFlow/sagitta at `sagitta.pin`'s commit into
# `target/oracle/sagitta` (under the gitignored target/; refused unless HEAD is that commit; NOT a dot-directory — sagitta's tutor_ch06 fails under one, notes/yw00-the-map.md §2),
# builds it with each `--cc` (default: clang and gcc, as sagitta's own
# CI does; macOS has only clang, where `gcc` is clang) — the editor, its
# unit binary, and everything `tools/goldens` drives: the PTY runner and
# demo, the script and Fletch runners, the test helpers and the torture
# binaries — and runs its unit suite (`--unit`, the default) or its
# whole `make test` (`--test`, hours) under the LAST compiler given.
# Each run's log is `target/oracle/<target>.<cc>.log` and one line per step
# goes to stdout: `oracle: <step>: <verdict> (<seconds> s)`. Exit 0 only
# when every step passed.
#
# The oracle is a program we build from the maintainer's own source and
# RUN; nothing here changes it (track rule 2). A compiler that refuses
# it (kasumi's clang 23 trips `-Wunused-but-set-global` under -Werror,
# notes/yw00-the-map.md) is reported, not patched around: pass `--cc
# gcc`, or a `--cc` string carrying the flag the host needs, and say so
# in the evidence.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. ./sagitta.pin

mode=unit
jobs=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)
ccs=()
while [ $# -gt 0 ]; do
    case "$1" in
    --cc) ccs+=("$2"); shift 2 ;;
    --unit) mode=unit; shift ;;
    --test) mode=test; shift ;;
    --build-only) mode=build; shift ;;
    --jobs) jobs=$2; shift 2 ;;
    *) echo "oracle: unknown option $1" >&2; exit 2 ;;
    esac
done
if [ ${#ccs[@]} -eq 0 ]; then
    ccs=(clang gcc)
fi

mkdir -p target/oracle
log_dir=$YEW_ROOT/target/oracle
tree=$YEW_ROOT/target/oracle/sagitta
status=0

say() { echo "oracle: $*"; }
# step <name> <cc> <command...>: run, log, time, one line.
step() {
    local name=$1 cc=$2; shift 2
    local log="$log_dir/$name.$cc.log"
    local start end rc
    start=$(date +%s)
    set +e
    "$@" >"$log" 2>&1
    rc=$?
    set -e
    end=$(date +%s)
    if [ $rc -eq 0 ]; then
        say "$name [$cc]: ok ($((end - start)) s; $log)"
    else
        say "$name [$cc]: FAILED exit $rc ($((end - start)) s; $log)"
        tail -20 "$log" | sed 's/^/oracle:   /'
        status=1
    fi
    return 0
}

# 1. The tree at the pin.
if [ ! -d "$tree/.git" ]; then
    say "fetching $SAGITTA_REPO at $SAGITTA_REV"
    mkdir -p "$tree"
    git -C "$tree" init -q
    git -C "$tree" fetch -q --depth 1 "$SAGITTA_REPO" "$SAGITTA_REV"
    git -C "$tree" checkout -q --detach FETCH_HEAD
fi
have=$(git -C "$tree" rev-parse HEAD)
if [ "$have" != "$SAGITTA_REV" ]; then
    echo "oracle: REFUSED — target/oracle/sagitta is at $have, the pin is $SAGITTA_REV (remove target/oracle/ to refetch)" >&2
    exit 1
fi
say "sagitta $SAGITTA_REV ($(git -C "$tree" log -1 --format=%s))"

# 2. Build with each compiler. sagitta's Makefile is one tree per
# BUILD directory; a compiler gets its own so objects never mix.
targets="build/yew build/unit_tests build/pty_runner build/demo_paint \
  build/script_runner build/fletch_run build/help_fixture \
  build/tests/helpers/fakelsp build/tests/helpers/mockai \
  build/tests/helpers/mockcurl build/perf_unicode build/perf_piece \
  build/perf_textbuf build/gen-bigfile build/perf_startup_s56 \
  build/perf_latency build/perf_nullexec build/fuzz_cmdparse \
  build/fuzz_shctx build/fuzz_comphelp torture-build \
  build/fuzz_search build/perf_search_latency build/perf_latency_s56 \
  build/perf_echo_child build/perf_cmdcomp build/perf_re_pathological \
  build/perf_re_throughput build/fuzz_panes build/fuzz_groups"
last=
for cc in "${ccs[@]}"; do
    tag=$(echo "$cc" | tr -c 'A-Za-z0-9' '_' | sed 's/_*$//')
    # shellcheck disable=SC2086
    step build "$tag" make -C "$tree" --no-print-directory -j"$jobs" \
        CC="$cc" BUILD="build-$tag" $(echo "$targets" | sed "s#build/#build-$tag/#g")
    last=$tag
    lastcc=$cc
done
[ $status -eq 0 ] || exit 1

# 3. The suite, under the last compiler.
case $mode in
build) ;;
unit)
    step test-unit "$last" make -C "$tree" --no-print-directory CC="$lastcc" BUILD="build-$last" test-unit
    grep -E '^unit: ' "$log_dir/test-unit.$last.log" | sed 's/^/oracle:   /' || true
    ;;
test)
    step test "$last" make -C "$tree" --no-print-directory CC="$lastcc" BUILD="build-$last" test
    ;;
esac

# The build tools/goldens drives is the last compiler's; say which.
ln -sfn "build-$last" "$tree/build"
say "build -> build-$last"
exit $status
