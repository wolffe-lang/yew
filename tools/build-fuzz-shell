#!/bin/sh
# build-fuzz-shell — the shell work's fuzz drivers, tools/fuzz-shctx and
# tools/fuzz-comphelp (the ports of sagitta's tests/fuzz/fuzz_shctx.c and
# fuzz_comphelp.c over fuzzlib.c's generator, tools/fuzzgen), built on
# the release tier into target/tools/fuzz-shctx and fuzz-comphelp.
#
#   tools/build-fuzz-shell [--native] [shctx|comphelp]...
#
# `use edit` resolves beside the ENTRY file (D32), so every module under
# src/ and the generator are staged beside a copy of each driver under
# target/fuzz-<name>/. Nothing there is committed.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

tier=release
names=
for a in "$@"; do
    case "$a" in
    --native) tier=native ;;
    shctx | comphelp) names="$names $a" ;;
    *)
        echo "build-fuzz-shell: unknown argument $a" >&2
        exit 2
        ;;
    esac
done
[ -n "$names" ] || names="shctx comphelp"
mkdir -p target/tools
for n in $names; do
    stage="${YEW_ROOT:?}/target/fuzz-${n:?}"
    rm -rf "${stage:?}"
    mkdir -p "$stage/fuzzgen"
    cp "tools/fuzz-$n/main.lu" "$stage/main.lu"
    cp tools/fuzzgen/*.lu "$stage/fuzzgen/"
    for d in src/*/; do
        m=$(basename "$d")
        cp -R "src/$m" "$stage/$m"
        find "$stage/$m" -maxdepth 1 -name '*_test.lu' -exec rm -f {} +
    done
    if [ "$tier" = release ]; then
        "$WOLF" build --release --deny-warnings "$stage/main.lu" -o "target/tools/fuzz-$n"
    else
        "$WOLF" build --deny-warnings "$stage/main.lu" -o "target/tools/fuzz-$n"
    fi
    echo "build-fuzz-shell: target/tools/fuzz-$n ($tier)"
done
