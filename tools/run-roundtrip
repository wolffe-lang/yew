#!/usr/bin/env bash
# run-roundtrip — Sprint 35's round-trip law (R-yw09-1 A): the port's
# runner, src/edit_record_roundtrip.lu (sagitta tests/roundtrip/runner.c and
# gen.c), at C's 2,000 seeds over the six fixtures, the four fixed
# fixtures, the count sentinel and the 21 recorder corpus files, its report
# line compared byte for byte to C's runner's; then `make test-roundtrip`'s
# planted-fault self-test (Makefile:4030-4041): the folded TAKES_COUNT run
# must exit 1 and shrink to the three-event prefix naming ed.move.buf.end.
#
#   tools/run-roundtrip [--native] [--against-oracle]
#
# Both runners read runtime/init.fl and tests/corpus/recorder/ relative to
# the pinned oracle tree ($SAGITTA_TREE, default target/oracle/sagitta),
# which is where C's Makefile runs its own. `--against-oracle` runs C's
# build/roundtrip_runner (tools/oracle builds it) beside the port's; a
# missing C runner is exit 2, never a silent pass. YEW_RT_SEEDS and
# YEW_RT_BASE_SEED pass through to both.
set -euo pipefail
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
tier=--release; oracle=0
for a in "$@"; do
    case "$a" in
    --native) tier= ;;
    --against-oracle) oracle=1 ;;
    *) echo "run-roundtrip: unknown argument $a" >&2; exit 2 ;;
    esac
done
tree=${SAGITTA_TREE:-target/oracle/sagitta}
case "$tree" in /*) ;; *) tree=$YEW_ROOT/$tree ;; esac
[ -d "$tree/tests/corpus/recorder" ] || { echo "run-roundtrip: no pinned tree at $tree (tools/oracle)" >&2; exit 2; }
if [ "$oracle" = 1 ] && [ ! -x "$tree/build/roundtrip_runner" ]; then
    echo "run-roundtrip: $tree/build/roundtrip_runner is not built (tools/oracle builds it)" >&2
    exit 2
fi
. tools/lib-toolchain.sh
mkdir -p target/tools target/roundtrip/tmp
if [ "${ROUNDTRIP_PREBUILT:-0}" != 1 ]; then
    # shellcheck disable=SC2086
    "$WOLF" build $tier --deny-warnings src/edit_record_roundtrip.lu -o target/tools/roundtrip_runner
fi
. tools/lib-test-env.sh
test_env_begin
export YEW_RUNTIME_DIR="$tree/runtime"
bin=$YEW_ROOT/target/tools/roundtrip_runner
tmp=$YEW_ROOT/target/roundtrip/tmp
rc=0
port=$(cd "$tree" && YEW_RT_TMP=$tmp LC_ALL=C "$bin") || rc=$?
echo "port: $port"
[ "$rc" = 0 ] || { echo "run-roundtrip: the port's runner exited $rc" >&2; exit 1; }
case "$port" in "roundtrip: ok "*) ;; *) echo "run-roundtrip: no ok line" >&2; exit 1 ;; esac
# The planted fault (Makefile:4031-4041).
log=$YEW_ROOT/target/roundtrip/selftest.txt
set +e
(cd "$tree" && YEW_RT_SELFTEST=1 YEW_RT_TMP=$tmp LC_ALL=C "$bin") >"$log" 2>&1
st=$?
set -e
[ "$st" = 1 ] || { echo "run-roundtrip: the self-test exited $st, expected 1" >&2; cat "$log" >&2; exit 1; }
grep -Fq 'property=SELFTEST/P1' "$log"
grep -Eq 'diverged at event [0-9]+ of [123]; shrunk from 96' "$log"
grep -Fq 'op: ed.move.buf.end' "$log"
grep -Fq 'detail: TAKES_COUNT run was illegally folded' "$log"
echo "run-roundtrip: planted folding fault shrank to the right operation"
if [ "$oracle" = 1 ]; then
    c=$(cd "$tree" && YEW_RT_TMP=$tmp LC_ALL=C build/roundtrip_runner) || { echo "C:    $c"; exit 1; }
    echo "C:    $c"
    if [ "$port" != "$c" ]; then
        echo "run-roundtrip: the port's report differs from C's" >&2
        exit 1
    fi
    echo "PASS: oracle/port report lines identical"
fi
