//! perf-record — Sprint 35's recorder costs, sagitta 9ace98c2
//! tests/perf/perf_record.c:1-221: the record tap's per-command overhead
//! (1e6 `ed.mode.escape` invocations recorded against the same loop with
//! the tap off, the median of seven delta samples, 200 ns budget) and the
//! emission of a 10,000-event recording (the median of seven, 10 ms). C's
//! output lines and its strict/advisory/sanity policy (perf_policy.h),
//! `--gate` strict unless YEW_PERF_ADVISORY says otherwise and an ungated
//! run advisory; R-yw09-3 A records it beside C's from the same run
//! (tools/run-perf-record), the gate being yw08's 2x bar on the two
//! numbers.

use edit

// perf_record.c:13-19.
const TAP_ITERS: int = 1000000

const EMIT_EVENTS: int = 10000

const PERF_SAMPLES: int = 7

const TAP_BUDGET_NS: int = 200

const EMIT_BUDGET_NS: int = 10000000

// perf_policy.h YEW_PERF_ADVISORY_SANITY_MULTIPLIER.
const SANITY: int = 100

fn advisory_env() -> bool {
    let v = env_get("YEW_PERF_ADVISORY") else { return false }
    v != "0"
}

fn sample_failed(value: int, budget: int, advisory: bool) -> bool {
    value > (if advisory then budget * SANITY else budget)
}

fn verdict(value: int, budget: int, advisory: bool) -> str {
    if sample_failed(value, budget, true) { return " SANITY-FAIL" }
    if value > budget { return if advisory then " WARN" else " REGRESSION" }
    " ok"
}

// record_failed (perf_record.c:96-103): a negative overhead is noise.
fn record_failed(overhead: int, emit: int, advisory: bool) -> bool {
    overhead > 0 && sample_failed(overhead, TAP_BUDGET_NS, advisory) || sample_failed(emit, EMIT_BUDGET_NS, advisory)
}

// selftest_policy (perf_record.c:105-124).
fn selftest_policy() -> int {
    let m = SANITY
    if record_failed(TAP_BUDGET_NS, EMIT_BUDGET_NS, false) ||
        record_failed(-5, 0, false) ||
        !record_failed(TAP_BUDGET_NS + 1, EMIT_BUDGET_NS, false) ||
        !record_failed(0, EMIT_BUDGET_NS + 1, false) ||
        record_failed(TAP_BUDGET_NS + 1, EMIT_BUDGET_NS + 1, true) ||
        record_failed(TAP_BUDGET_NS * m, EMIT_BUDGET_NS * m, true) ||
        !record_failed(TAP_BUDGET_NS * m + 1, 0, true) ||
        !record_failed(0, EMIT_BUDGET_NS * m + 1, true) {
        eprint("perf_record: policy selftest failed")
        return 1
    }
    print("perf-record-policy: strict/advisory/sanity ok")
    0
}

// invoke_many (perf_record.c:33-49): (ok, elapsed).
fn invoke_many(mut ed: edit.Ed, id: int, count: int) -> (bool, int) {
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    cx.count = 1
    let start = os_clock_ns()
    for _ in 0..count {
        if edit.cmd_invoke(mut ed, id, mut cx) != edit.CMD_OK { return (false, 0) }
    }
    (true, os_clock_ns() - start)
}

fn median(mut v: List[int]) -> int {
    var i = 1
    while i < v.len {
        let value = v[i]
        var j = i
        while j != 0 && v[j - 1] > value {
            v[j] = v[j - 1]
            j -= 1
        }
        v[j] = value
        i += 1
    }
    v[v.len / 2]
}

fn main() -> int {
    let args = env_args()
    let gate = args.len == 1 && args[0] == "--gate"
    let advisory = !gate || advisory_env()
    if args.len == 1 && args[0] == "--selftest-policy" { return selftest_policy() }
    if args.len > 1 || args.len == 1 && !gate {
        eprint("usage: perf-record [--gate|--selftest-policy]")
        return 2
    }
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    let escape = edit.cmd_lookup(ed.reg, "ed.mode.escape")
    if escape == 0 { return 2 }
    (mut ed.rec.ev).reserve(TAP_ITERS)
    var taps = List[int]()
    for _ in 0..PERF_SAMPLES {
        edit.cmd_set_record_tap(mut ed.reg, edit.TAP_NONE)
        let (ok1, baseline) = invoke_many(mut ed, escape, TAP_ITERS)
        if !ok1 { return 2 }
        ed.rec.active = true
        ed.rec.reg = 'a' as int
        ed.rec.mode_at_start = edit.MODE_L
        (mut ed.rec.ev).reset()
        edit.cmd_set_record_tap(mut ed.reg, edit.TAP_RECORDER)
        let (ok2, recorded) = invoke_many(mut ed, escape, TAP_ITERS)
        if !ok2 { return 2 }
        ed.rec.active = false
        // elapsed_delta (perf_record.c:51-56): integer per-op, toward zero.
        let delta = if recorded >= baseline then (recorded - baseline) / TAP_ITERS else -((baseline - recorded) / TAP_ITERS)
        (mut taps).push(delta)
    }
    let overhead = median(taps)
    (mut ed.rec.ev).reset()
    let cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    ed.rec.active = true
    for _ in 0..EMIT_EVENTS { edit.record_tap(mut ed, escape, cx) }
    ed.rec.active = false
    var emits = List[int]()
    var emitted = 0
    for _ in 0..PERF_SAMPLES {
        let start = os_clock_ns()
        let out = edit.record_emit(ed.reg, ed.rec)
        (mut emits).push(os_clock_ns() - start)
        emitted += out.len
    }
    let emit = median(emits)
    if emitted == 0 { return 2 }
    let mode = if advisory then "ADVISORY" else "GATING"
    print("record mode {mode}")
    print("tap_overhead_ns {overhead} budget {TAP_BUDGET_NS} median_samples {PERF_SAMPLES}{verdict(if overhead > 0 then overhead else 0, TAP_BUDGET_NS, advisory)}")
    print("emit_10k_ns {emit} budget {EMIT_BUDGET_NS}{verdict(emit, EMIT_BUDGET_NS, advisory)}")
    edit.cmd_set_record_tap(mut ed.reg, edit.TAP_RECORDER)
    if record_failed(overhead, emit, advisory) { return 1 }
    0
}
