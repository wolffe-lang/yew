#!/bin/sh
# Build the nonshipping frontend test driver using only the pinned toolchain.
set -eu
YEW_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh
tier=--release
case ${1:-} in '') ;; --native) tier= ;; *) echo 'usage: build-fl-front [--native]' >&2; exit 2;; esac
stage="$YEW_ROOT/target/fl-front"
rm -rf "${stage:?}"
mkdir -p "$stage" target/tools
cp tools/fl-front/main.lu "$stage/main.lu"
# Every module under src/: fl reaches text and search since io and re landed.
for d in src/*/; do
    name=$(basename "$d")
    mkdir -p "$stage/$name"
    cp src/"$name"/*.lu "$stage/$name/"
    find "$stage/$name" -maxdepth 1 -name '*_test.lu' -delete
done
mkdir -p "$stage/fuzzgen"
cp tools/fuzzgen/*.lu "$stage/fuzzgen/"
"$WOLF" build $tier --deny-warnings "$stage/main.lu" -o target/tools/fl-front
