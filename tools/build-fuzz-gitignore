#!/bin/sh
# build-fuzz-gitignore — Sprint 26 §4's matcher fuzz driver,
# tools/fuzz-gitignore/main.lu (the port of sagitta's
# tests/fuzz/fuzz_gitignore.c over fuzzlib.c's generator, tools/fuzzgen),
# built on the release tier into target/tools/fuzz-gitignore.
#
#   tools/build-fuzz-gitignore [--native]
#
# `use ws` resolves beside the ENTRY file (D32), so every module under
# src/ and the generator are staged beside a copy of the driver under
# target/fuzz-gitignore/, as tools/build-fuzz-groups stages its driver.
# Nothing there is committed.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

tier=release
case "${1:-}" in
"") ;;
--native) tier=native ;;
*)
    echo "build-fuzz-gitignore: unknown option $1" >&2
    exit 2
    ;;
esac

stage="${YEW_ROOT:?}/target/fuzz-gitignore"
rm -rf "${stage:?}"
mkdir -p "$stage/fuzzgen" target/tools
cp tools/fuzz-gitignore/main.lu "$stage/main.lu"
cp tools/fuzzgen/*.lu "$stage/fuzzgen/"
for d in src/*/; do
    m=$(basename "$d")
    cp -R "src/$m" "$stage/$m"
    find "$stage/$m" -maxdepth 1 -name '*_test.lu' -exec rm -f {} +
done
if [ "$tier" = release ]; then
    "$WOLF" build --release --deny-warnings "$stage/main.lu" -o target/tools/fuzz-gitignore
else
    "$WOLF" build --deny-warnings "$stage/main.lu" -o target/tools/fuzz-gitignore
fi
echo "build-fuzz-gitignore: target/tools/fuzz-gitignore ($tier)"
