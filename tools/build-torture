#!/bin/sh
# build-torture — the port's torture child, tools/yew-torture/main.lu,
# built on the release tier into target/tools/yew-torture: the binary
# sagitta's `kill9` driver and fault shim run in place of C's
# `build/yew-torture` (M-YW2, notes/yw02-the-text-engine.md).
#
#   tools/build-torture [--native]
#
# `use text` resolves beside the ENTRY file (D32), so the port's modules
# are staged beside a copy under target/torture/, as tools/build-demo
# stages the demo. Nothing there is committed.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

tier=release
case "${1:-}" in
"") ;;
--native) tier=native ;;
*)
    echo "build-torture: unknown option $1" >&2
    exit 2
    ;;
esac

stage=$YEW_ROOT/target/torture
rm -rf "$stage"
mkdir -p "$stage" target/tools
cp tools/yew-torture/main.lu "$stage/main.lu"
for m in util unicode term text; do
    cp -R "src/$m" "$stage/$m"
    rm -f "$stage/$m"/*_test.lu
done
if [ "$tier" = release ]; then
    "$WOLF" build --release --deny-warnings "$stage/main.lu" -o target/tools/yew-torture
else
    "$WOLF" build --deny-warnings "$stage/main.lu" -o target/tools/yew-torture
fi
echo "build-torture: target/tools/yew-torture ($tier)"
