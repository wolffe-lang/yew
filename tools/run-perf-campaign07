#!/usr/bin/env bash
# run-perf-campaign07 — R-yw09-3 A's recorded rows beside C's from the same
# run: perf_record (the record tap's per-command overhead and a 10k-event
# emission: C's build/perf_record against tools/perf-record), perf_batch
# (C's own build/perf_batch, 101 forks of `--clean --batch empty.fl
# small.txt`, pointed at C's yew and then the port's) and the script suite's
# wall time (C's build/perf_script_suite over C's runner, at C's baseline,
# pointed at each yew with the same exclude list: the 25 deferred scripts of
# tools/scripts-deferred.txt and 57_embedded_gate).
#
#   tools/run-perf-campaign07 [--native] [--oracle-tree DIR]
#
# Each pair prints one RECORDED line, port/C, flagged MISS over the track's
# 2x bar (ruling #89 R3); every MISS must be named in the lane note with its
# issue. Timing is always ADVISORY here (YEW_PERF_ADVISORY=1): only a
# sanity failure, a crash or a malformed line exits nonzero. kasumi under
# taskset in a container is the record.
set -euo pipefail
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
tier=--release
tree=$YEW_ROOT/target/oracle/sagitta
while [ $# -gt 0 ]; do
    case "$1" in
    --native) tier=; shift ;;
    --oracle-tree) tree=$2; shift 2 ;;
    *) echo "run-perf-campaign07: unknown argument $1" >&2; exit 2 ;;
    esac
done
for b in perf_record perf_batch perf_script_suite script_runner yew tests/helpers/fakelsp; do
    [ -x "$tree/build/$b" ] || { echo "run-perf-campaign07: $tree/build/$b is not built (tools/oracle)" >&2; exit 2; }
done
[ -x target/release/yew ] || { echo "run-perf-campaign07: target/release/yew is not built (tools/build --release)" >&2; exit 2; }
. tools/lib-toolchain.sh
. tools/lib-test-env.sh
test_env_begin
export YEW_PERF_ADVISORY=1
out=$YEW_ROOT/target/perf-campaign07
mkdir -p "$out" target/tools
# The record driver links the editor: staged as build-fl-core stages its own.
stage=$YEW_ROOT/target/perf-record-stage
rm -rf -- "$stage"
mkdir -p "$stage"
cp -R src/. "$stage/"
find "$stage" -maxdepth 1 -type f -name '*.lu' -delete
find "$stage" -type f -name '*_test.lu' -delete
cp tools/perf-record/main.lu "$stage/main.lu"
# shellcheck disable=SC2086
"$WOLF" build $tier --deny-warnings "$stage/main.lu" -o target/tools/perf-record
target/tools/perf-record --selftest-policy
"$tree/build/perf_record" --selftest-policy
miss=0
ratio() { # name c port
    awk -v n="$1" -v c="$2" -v p="$3" 'BEGIN {
        if (c <= 0 || p <= 0) { printf "ERROR %s: nonpositive C=%s port=%s\n", n, c, p; exit 1 }
        r = p / c; printf "%s campaign07/%s: port=%s C=%s ratio=%.3fx\n", (r > 2 ? "MISS" : "RECORDED"), n, p, c, r
        exit (r > 2 ? 3 : 0) }'
}
note() { local rc=0; ratio "$@" || rc=$?; [ "$rc" = 3 ] && miss=$((miss + 1)); [ "$rc" = 1 ] && exit 1; return 0; }
field() { sed -nE "s/^$1 (-?[0-9]+).*/\\1/p" "$2" | tail -1; }
# C's drivers measure their own checkout's runtime/ and nothing else
# (tests/perf/perf_runtime.h:11-14: YEW_RUNTIME_DIR must be ./runtime).
(cd "$tree" && YEW_RUNTIME_DIR="$tree/runtime" build/perf_record) > "$out/record-C.txt"
target/tools/perf-record > "$out/record-port.txt"
cat "$out/record-C.txt" "$out/record-port.txt"
c_tap=$(field tap_overhead_ns "$out/record-C.txt"); p_tap=$(field tap_overhead_ns "$out/record-port.txt")
c_emit=$(field emit_10k_ns "$out/record-C.txt"); p_emit=$(field emit_10k_ns "$out/record-port.txt")
# A tap overhead at or under zero is noise (perf_record.c:93-95): floor 1 ns.
[ "${c_tap:-0}" -gt 0 ] || c_tap=1
[ "${p_tap:-0}" -gt 0 ] || p_tap=1
note record_tap_overhead "$c_tap" "$p_tap"
note record_emit_10k "$c_emit" "$p_emit"
(cd "$tree" && YEW_RUNTIME_DIR="$tree/runtime" build/perf_batch --yew "$tree/build/yew") > "$out/batch-C.txt"
(cd "$tree" && YEW_RUNTIME_DIR="$tree/runtime" build/perf_batch --yew "$YEW_ROOT/target/release/yew") > "$out/batch-port.txt"
cat "$out/batch-C.txt" "$out/batch-port.txt"
note batch_startup_median "$(field batch_startup_median_ns "$out/batch-C.txt")" "$(field batch_startup_median_ns "$out/batch-port.txt")"
exclude="57_embedded_gate,$(grep -v '^#' tools/scripts-deferred.txt | cut -f1 | paste -sd, -)"
for who in C port; do
    yew=$tree/build/yew
    [ "$who" = port ] && yew=$YEW_ROOT/target/release/yew
    (cd "$tree" && YEW_RUNTIME_DIR="$tree/runtime" LC_ALL=C build/perf_script_suite --runner "$tree/build/script_runner" --yew "$yew" \
        --baseline tests/perf/baselines/script-x86_64-linux-gnu.txt \
        --fakelsp "$tree/build/tests/helpers/fakelsp" --exclude "$exclude") > "$out/script-$who.txt" || true
    cat "$out/script-$who.txt"
done
note script_suite_wall "$(field script_suite_wall_ns "$out/script-C.txt")" "$(field script_suite_wall_ns "$out/script-port.txt")"
echo "campaign07 perf: MISS=$miss (each named in the lane note with its issue)"
