#!/usr/bin/env bash
# goldens-selftest — the harness sees a difference (the planted red).
#
#   tools/goldens-selftest
#
# Three binaries through tools/goldens, each with a known verdict:
#   1. the oracle's own build/yew          -> GREEN on every suite
#   2. a planted wrong binary that prints  -> RED on every suite but
#      C yew's version and exits 1 for      version, which is green
#      anything else (the shape of the
#      port's first row, yw00's stub)
#   3. a binary that prints nothing and    -> RED everywhere, version
#      exits 0                                included
#   4. the oracle, except that one script   -> GREEN, with that case
#      case exits 126 without a word the       named in a RERUN line
#      first time it is run
#   5. the same, every time                 -> RED on that case, with
#                                              its RERUN line
# 4 and 5 are the shape of a child the script runner never started: on
# macOS the runner and its child race to set the child's process group,
# and the loser leaves a silent 126 or `runner setup failed`
# (tests/script/runner.c:990, 1228). tools/goldens runs such a case once
# more by name; 5 is the control that a case red twice stays red.
# A harness that cannot tell 1 from 2 and 3 proves nothing; this is the
# gate on tools/goldens itself (pelt's difftest-selftest, boreutils'
# *-selftest discipline). It runs the fast suites (version, the four
# `startup_` PTY cases — the ones that spawn the --yew binary itself,
# not the C demo — the whole script suite, fletch, syn) so it finishes
# in minutes; the torture lane is driven by tools/goldens by hand and
# in CI.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
# The `startup_` cases settle on the harness's default 50 ms of quiet:
# startup_multiple_files snapshots its `:buffers` picker 50 ms after the
# last output (tests/pty/registry.c:8601-8606). A slow hosted runner can
# leave the editor silent longer than that with the picker still to come,
# and C yew's own two runs then disagree, an "unstable snapshot" on the
# oracle (run 42384862517's macOS leg, at a head whose same job was green
# twice on its pull request). The harness scales every quiet window by
# one number for slow hosts (YEW_PTY_QUIET_SCALE, tests/pty/harness.c:
# 368-395); the selftest waits four times as long unless its caller sets
# the scale. No golden moves: only how long a quiet gap is waited for.
: "${YEW_PTY_QUIET_SCALE:=4}"
export YEW_PTY_QUIET_SCALE
echo "goldens-selftest: quiet windows scaled by $YEW_PTY_QUIET_SCALE (YEW_PTY_QUIET_SCALE)"
tree=$YEW_ROOT/target/oracle/sagitta
build=$tree/build
[ -x "$build/yew" ] || { echo "goldens-selftest: no oracle build; run tools/oracle first" >&2; exit 2; }
scratch=$YEW_ROOT/target/oracle/selftest
rm -rf "$scratch"
mkdir -p "$scratch"

# A binary that answers --version as the port does (the manifest's number, C yew's
# modules line) and refuses the rest.
ver=$(python3 -I tools/check-version --print)
cat >"$scratch/version-only" <<EOF
#!/bin/sh
if [ "\$#" -eq 1 ] && [ "\$1" = --version ]; then
    printf 'yew $ver\nmodules: lsp ai fuss plugins\n'
    exit 0
fi
echo 'version-only: not an editor' >&2
exit 1
EOF
# A binary that prints nothing and exits 0.
printf '#!/bin/sh\nexit 0\n' >"$scratch/silent"
chmod +x "$scratch/version-only" "$scratch/silent"

# The oracle but for one script case, which exits 126 with no output:
# once, then never again; and always.
cat >"$scratch/unstarted-once" <<EOF
#!/bin/sh
for a in "\$@"; do
    case \$a in *07_functions.fl)
        if [ ! -e "$scratch/unstarted-once.seen" ]; then
            : >"$scratch/unstarted-once.seen"
            exit 126
        fi ;;
    esac
done
exec "$build/yew" "\$@"
EOF
cat >"$scratch/unstarted-always" <<EOF
#!/bin/sh
for a in "\$@"; do
    case \$a in *07_functions.fl) exit 126 ;; esac
done
exec "$build/yew" "\$@"
EOF
chmod +x "$scratch/unstarted-once" "$scratch/unstarted-always"

fast="version,pty,script,fletch,syn"
expect() { # name binary want-exit want-version-pass [want-detail [suites]]
    local name=$1 bin=$2 want=$3 wantv=$4 detail=${5:-} suites=${6:-$fast} out rc
    set +e
    out=$(tools/goldens --yew "$bin" --suite "$suites" --filter startup_ 2>&1)
    rc=$?
    set -e
    echo "$out" | sed "s/^/goldens-selftest: [$name] /"
    if [ "$rc" != "$want" ]; then
        echo "goldens-selftest: FAIL — $name exited $rc, expected $want" >&2
        exit 1
    fi
    if ! echo "$out" | grep -q "^goldens: version: pass=$wantv "; then
        echo "goldens-selftest: FAIL — $name's version row is not pass=$wantv" >&2
        exit 1
    fi
    # A red script case must carry what its child said. The runner prints
    # it under the FAIL line (tests/script/runner.c:2518-2529), and a hosted
    # run keeps only what tools/goldens prints: a lone `FAIL 07_functions
    # (exit 126)` once left nothing to say which step had failed.
    if [ -n "$detail" ] && ! echo "$out" | grep -qF -- "$detail"; then
        echo "goldens-selftest: FAIL — $name's output lacks: $detail" >&2
        exit 1
    fi
}
expect oracle "$build/yew" 0 1
expect version-only "$scratch/version-only" 1 1 'goldens:       version-only: not an editor'
expect silent "$scratch/silent" 1 0
expect unstarted-once "$scratch/unstarted-once" 0 1 \
    'goldens:   RERUN 07_functions (exit 126): the runner never started the editor; not red on a second run' version,script
expect unstarted-always "$scratch/unstarted-always" 1 1 \
    'goldens:   RERUN 07_functions (exit 126): red again on a second run' version,script
echo "goldens-selftest: ok — green on the oracle, red on both plants; a case never started is run once more, and red twice is red"
