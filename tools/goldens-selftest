#!/usr/bin/env bash
# goldens-selftest — the harness sees a difference (the planted red).
#
#   tools/goldens-selftest
#
# Three binaries through tools/goldens, each with a known verdict:
#   1. the oracle's own build/yew          -> GREEN on every suite
#   2. a planted wrong binary that prints  -> RED on every suite but
#      C yew's version and exits 1 for      version, which is green
#      anything else (the shape of the
#      port's first row, yw00's stub)
#   3. a binary that prints nothing and    -> RED everywhere, version
#      exits 0                                included
# A harness that cannot tell 1 from 2 and 3 proves nothing; this is the
# gate on tools/goldens itself (pelt's difftest-selftest, boreutils'
# *-selftest discipline). It runs the fast suites (version, the four
# `startup_` PTY cases — the ones that spawn the --yew binary itself,
# not the C demo — the whole script suite, fletch, syn) so it finishes
# in minutes; the torture lane is driven by tools/goldens by hand and
# in CI.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
tree=$YEW_ROOT/target/oracle/sagitta
build=$tree/build
[ -x "$build/yew" ] || { echo "goldens-selftest: no oracle build; run tools/oracle first" >&2; exit 2; }
scratch=$YEW_ROOT/target/oracle/selftest
rm -rf "$scratch"
mkdir -p "$scratch"

# A binary that answers --version as C yew does and refuses the rest.
cat >"$scratch/version-only" <<EOF
#!/bin/sh
if [ "\$#" -eq 1 ] && [ "\$1" = --version ]; then
    printf 'yew 1.0.0-dev\nmodules: lsp ai fuss plugins\n'
    exit 0
fi
echo 'version-only: not an editor' >&2
exit 1
EOF
# A binary that prints nothing and exits 0.
printf '#!/bin/sh\nexit 0\n' >"$scratch/silent"
chmod +x "$scratch/version-only" "$scratch/silent"

fast="version,pty,script,fletch,syn"
expect() { # name binary want-exit want-version-pass
    local name=$1 bin=$2 want=$3 wantv=$4 out rc
    set +e
    out=$(tools/goldens --yew "$bin" --suite "$fast" --filter startup_ 2>&1)
    rc=$?
    set -e
    echo "$out" | sed "s/^/goldens-selftest: [$name] /"
    if [ "$rc" != "$want" ]; then
        echo "goldens-selftest: FAIL — $name exited $rc, expected $want" >&2
        exit 1
    fi
    if ! echo "$out" | grep -q "^goldens: version: pass=$wantv "; then
        echo "goldens-selftest: FAIL — $name's version row is not pass=$wantv" >&2
        exit 1
    fi
}
expect oracle "$build/yew" 0 1
expect version-only "$scratch/version-only" 1 1
expect silent "$scratch/silent" 1 0
echo "goldens-selftest: ok — the harness is green on the oracle and red on both plants"
