#!/usr/bin/env bash
# run-fuzz-re — the regex engine's fuzz campaigns (s20 DoD 6-7, s21 DoD
# 13), the port's driver on the release tier (tools/build-fuzz-re).
#
#   tools/run-fuzz-re [--target=T] [--iters=N] [--seed=S]   one run
#   tools/run-fuzz-re --campaign                            the DoD counts
#   tools/run-fuzz-re --ci                                  CI-sized
#
# One run passes its arguments to the driver (target compile, diff or
# quote; sagitta's defaults: 200,000 iterations, seed 1). `--campaign` is
# the contract's bar: fuzz_re_diff at 312,500 iterations (sixteen
# generated pairs each: 5,000,000 pairs) on each of four seeds,
# fuzz_re_compile at 1,000,000 inputs, fuzz_re_quote at 200,000. `--ci`
# runs each target at 20,000 iterations, seed 1. Every run is bounded by
# `timeout` (the driver has no CPU watchdog; C's is a SIGPROF timer). Exit
# is the first failing run's, read directly.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"

tools/build-fuzz-re
driver=target/tools/fuzz-re
case "${1:-}" in
--campaign)
    for seed in 1 0x243f6a8885a308d3 0x9e3779b97f4a7c15 0xd1b54a32d192ed03; do
        timeout 7200 "$driver" --target=diff --iters=312500 --seed="$seed"
    done
    timeout 7200 "$driver" --target=compile --iters=1000000 --seed=1
    timeout 3600 "$driver" --target=quote --iters=200000 --seed=1
    ;;
--ci)
    for t in compile diff quote; do
        timeout 1800 "$driver" --target="$t" --iters=20000 --seed=1
    done
    ;;
*)
    exec timeout 7200 "$driver" "$@"
    ;;
esac
