#!/usr/bin/env bash
# run-fuzz-re — the regex engine's fuzz campaigns (s20 DoD 6-7, s21 DoD
# 13), the port's driver on the release tier (tools/build-fuzz-re).
#
#   tools/run-fuzz-re [--prebuilt] [--target=T] [--iters=N] [--seed=S]   one run
#   tools/run-fuzz-re [--prebuilt] --campaign                            the DoD counts
#   tools/run-fuzz-re [--prebuilt] --ci                                  CI-sized
#
# `--prebuilt` runs the driver already built (target/tools/fuzz-re): the
# release tier needs clang, so a container without it runs what the host
# built (RULES §5's runs, docs/MAP.md).
#
# One run passes its arguments to the driver (target compile, diff or
# quote; sagitta's defaults: 200,000 iterations, seed 1). `--campaign` is
# the contract's bar: fuzz_re_diff at 312,500 iterations (sixteen
# generated pairs each: 5,000,000 pairs) on each of four seeds,
# fuzz_re_compile at 1,000,000 inputs, fuzz_re_quote at 200,000. `--ci`
# runs each target at 20,000 iterations, seed 1. Every run is bounded by
# `timeout` (the driver has no CPU watchdog; C's is a SIGPROF timer). Exit
# is the first failing run's, read directly.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"

if [ "${1:-}" = --prebuilt ]; then
    shift
    [ -x target/tools/fuzz-re ] || {
        echo "run-fuzz-re: --prebuilt but no target/tools/fuzz-re (run tools/build-fuzz-re)" >&2
        exit 2
    }
else
    tools/build-fuzz-re
fi
driver=target/tools/fuzz-re
# A wall-clock bound on each run: GNU `timeout` where the host has it
# (linux, Homebrew's `gtimeout` on macOS); macOS's base system has
# neither, and there the CI step's own `timeout-minutes` is the bound.
bounded() {
    local secs=$1
    shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "$secs" "$@"
    elif command -v gtimeout >/dev/null 2>&1; then
        gtimeout "$secs" "$@"
    else
        "$@"
    fi
}

case "${1:-}" in
--campaign)
    for seed in 1 0x243f6a8885a308d3 0x9e3779b97f4a7c15 0xd1b54a32d192ed03; do
        bounded 7200 "$driver" --target=diff --iters=312500 --seed="$seed"
    done
    bounded 7200 "$driver" --target=compile --iters=1000000 --seed=1
    bounded 3600 "$driver" --target=quote --iters=200000 --seed=1
    ;;
--ci)
    for t in compile diff quote; do
        bounded 1800 "$driver" --target="$t" --iters=20000 --seed=1
    done
    ;;
*)
    bounded 7200 "$driver" "$@"
    ;;
esac
