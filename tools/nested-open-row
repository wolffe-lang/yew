#!/usr/bin/env python3
"""nested-open-row: `:!yew PATH` opens in the running editor (yew#129).

    python3 -I tools/nested-open-row YEW_BIN [--keep DIR] [--case NAME]...
                                     [--tabs N] [--term TERM] [--list]

Every case runs yew in a pseudo-terminal, 24 by 80, with a scratch HOME
(and XDG directories under it), SHELL=/bin/sh, YEW_LOG a scratch file at
the info level, and a workspace of N files (default 26) plus
`paths_test.lu`. The seed: `yew` with every file (the workspace's first
start), `:q`, then `yew` with no file (a resume, as a day's editor
starts), so the first editor holds N + 2 tabs: the untitled buffer a
resume keeps and the N + 1 files. Each case then types its `:` lines into
that editor, one at a time, waiting for the screen to settle, and reads:

  - the workspace's saved state (`tabs`' records, `active_tab`), after the
    debounced save;
  - yew's log: the restores (`tab record(s) dropped` and the `workspace
    state` lines) and the ownership lines;
  - the processes running this yew binary below the row (`/proc`): a
    second editor is one more of them.

The cases (`--case`, repeatable; every case by default):

  newdir      the owner's lines: `:!mkdir identity`, `:!yew
              identity/identity.lu`, `:!touch identity_test.lu`, `:!yew
              identity_test.lu`. Both files are tabs of the first editor;
              it keeps every tab; no second editor starts.
  cd          `:!mkdir sub`, `:!cd sub`, `:!touch x.lu`, `:!yew x.lu`: the
              operand is the session's, so the tab is `sub/x.lu`.
  refuse      `:!yew sub` (a directory), `:!yew $HOME/x.lu` (a word the
              shell must expand), `:!yew --clean x.lu` (an editor option): each is
              refused by name on the message line, no job runs it, and
              no yew starts.
  passthru    `:!yew --version`: not an editor start, so it still runs in
              the session (its job buffer holds `yew `).
  bangbang    `:!!yew identity.lu`: the terminal handed to a second
              editor in the same workspace. It logs that pid N owns the
              state and saves nothing; after it quits, the first
              editor's tabs are the saved state.
  reader      a second editor started beside the first in another
              terminal is a reader: it says so, and saves nothing while the
              first runs or after; once the first quits (its tabs saved),
              a third editor owns the state, and the reader's quit leaves
              the third's state as it was.
  stale       a lease and an owner record naming pid 1 (alive, and no
              editor: a pid a reboot gave to another program) before the
              resume: the editor owns the state, logs no owner, and its
              pid is the lease.
  dropped     the resume's untitled tab is not logged as a dropped
              record, and a saved `active_tab` names a saved tab.

One line per check, `FAIL <case>_<check>` for each red, then
`nested-open-row: GREEN` or `nested-open-row: RED` (exit 1). Exit 2 when
the row cannot run (no saved state, a session that does not quit).

yew's processes are only read (`/proc`) and spoken to through their
terminals; none is ever signalled. Each quits by `:q`.
"""
import argparse
import fcntl
import glob
import os
import pty
import re
import select
import shutil
import struct
import sys
import tempfile
import termios
import time

ROWS, COLS = 24, 80
QUIET_S = 0.5
SAVE_WAIT_S = 2.8
CASES = ["newdir", "cd", "refuse", "passthru", "bangbang", "reader", "stale", "dropped"]


class Cant(Exception):
    """The row cannot run: exit 2."""


class Session:
    def __init__(self, yew, cwd, env, argv, log):
        self.raw = bytearray()
        self.log = log
        pid, fd = pty.fork()
        if pid == 0:
            os.chdir(cwd)
            os.execve(yew, [yew] + argv, env)
        self.pid, self.fd = pid, fd
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", ROWS, COLS, 0, 0))
        self.status = None

    def pump(self, seconds):
        end = time.monotonic() + seconds
        got = 0
        while True:
            left = end - time.monotonic()
            if left <= 0:
                return got
            r, _, _ = select.select([self.fd], [], [], left)
            if not r:
                return got
            try:
                data = os.read(self.fd, 65536)
            except OSError:
                return got
            if not data:
                return got
            self.raw += data
            self.log.write(data)
            got += len(data)

    def settle(self, quiet=QUIET_S, limit=10.0):
        start = time.monotonic()
        while time.monotonic() - start < limit:
            if self.pump(quiet) == 0:
                return True
        return False

    def send(self, data):
        os.write(self.fd, data)

    def ex(self, line, settle=QUIET_S):
        """Type `:LINE` and Enter in L mode."""
        self.send(b"\x1b")
        self.pump(0.15)
        self.send(b":")
        self.pump(0.1)
        for i in range(0, len(line), 16):
            self.send(line[i:i + 16].encode())
            self.pump(0.02)
        self.send(b"\r")
        self.settle(settle)

    def since(self, mark):
        return bytes(self.raw[mark:])

    def alive(self):
        if self.status is not None:
            return False
        pid, status = os.waitpid(self.pid, os.WNOHANG)
        if pid == self.pid:
            self.status = status
            return False
        return True

    def quit(self, limit=8.0):
        if not self.alive():
            os.close(self.fd)
            return True
        self.send(b"\x1b")
        self.pump(0.15)
        self.send(b":q\r")
        end = time.monotonic() + limit
        while time.monotonic() < end:
            self.pump(0.05)
            if not self.alive():
                break
            # A modified buffer asks; the row's buffers are never modified.
        os.close(self.fd)
        return self.status is not None


def env_for(scratch, term):
    home = os.path.join(scratch, "home")
    for d in ("", ".config", ".local/state", ".local/share", ".cache", "tmp"):
        os.makedirs(os.path.join(home, d), exist_ok=True)
    return {
        "HOME": home,
        "XDG_CONFIG_HOME": os.path.join(home, ".config"),
        "XDG_STATE_HOME": os.path.join(home, ".local", "state"),
        "XDG_DATA_HOME": os.path.join(home, ".local", "share"),
        "XDG_CACHE_HOME": os.path.join(home, ".cache"),
        "TMPDIR": os.path.join(home, "tmp"),
        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
        "SHELL": "/bin/sh",
        "TERM": term,
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "YEW_TTY_PROBE": "0",
        "YEW_CLIPBOARD": "none",
        "YEW_COLORS": "16",
        "YEW_LOG": os.path.join(scratch, "yew.log"),
        "YEW_LOG_LEVEL": "info",
        "COLUMNS": str(COLS),
        "LINES": str(ROWS),
    }


def state_dir(env):
    found = glob.glob(os.path.join(env["XDG_STATE_HOME"], "yew", "workspaces", "*", "state.fl"))
    return os.path.dirname(found[0]) if len(found) == 1 else None


TAB_ID = re.compile(r"^      id: (\d+),$")
TAB_PATH = re.compile(r'^      path: (nil|"(.*)"),$')


def read_state(env):
    """(tab records [(id, path or None)], active_tab, lock pid) or None."""
    d = state_dir(env)
    if d is None:
        return None
    text = open(os.path.join(d, "state.fl"), encoding="utf-8", errors="replace").read().splitlines()
    tabs, active, inside, rid = [], None, False, None
    for line in text:
        if line == "  tabs: [":
            inside = True
            continue
        if inside and line == "  ],":
            inside = False
            continue
        if inside:
            m = TAB_ID.match(line)
            if m:
                rid = int(m.group(1))
                continue
            m = TAB_PATH.match(line)
            if m and rid is not None:
                tabs.append((rid, None if m.group(1) == "nil" else m.group(2)))
                rid = None
            continue
        m = re.match(r"^  active_tab: (\d+),$", line)
        if m:
            active = int(m.group(1))
    lock = None
    try:
        lock = int(open(os.path.join(d, "lock")).read().strip() or "0")
    except (OSError, ValueError):
        pass
    return tabs, active, lock


def log_lines(env):
    try:
        return open(env["YEW_LOG"], encoding="utf-8", errors="replace").read().splitlines()
    except OSError:
        return []


def yews_below(root_pid, yew):
    """Pids running `yew` (by /proc/PID/exe) that descend from root_pid."""
    want = os.path.realpath(yew)
    parent, exe = {}, {}
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        try:
            with open(f"/proc/{p}/stat") as f:
                parent[int(p)] = int(f.read().rsplit(")", 1)[1].split()[1])
            exe[int(p)] = os.path.realpath(f"/proc/{p}/exe")
        except OSError:
            continue
    out = []
    for p, e in exe.items():
        if e != want:
            continue
        q, hops = p, 0
        while q in parent and hops < 64:
            if q == root_pid:
                out.append(p)
                break
            q = parent[q]
            hops += 1
    return sorted(out)


class Row:
    def __init__(self, args):
        self.args = args
        self.reds = []
        self.lines = []

    def check(self, case, name, ok, detail):
        self.lines.append(f"{case}: {name}: {'ok' if ok else 'RED'} ({detail})")
        print(self.lines[-1], flush=True)
        if not ok:
            self.reds.append(f"{case}_{name}")


def seed(yew, scratch, args, log):
    env = env_for(scratch, args.term)
    ws = os.path.join(scratch, "ws")
    os.makedirs(ws)
    names = [f"f{i:02d}.lu" for i in range(1, args.tabs + 1)] + ["paths_test.lu"]
    for n in names:
        with open(os.path.join(ws, n), "w") as f:
            f.write(f"// {n}\nfn main() {{}}\n")
    s = Session(yew, ws, env, names, log)
    s.settle(1.0)
    s.pump(SAVE_WAIT_S)
    if not s.quit():
        raise Cant("the seeding editor did not quit")
    st = read_state(env)
    if st is None or len(st[0]) < args.tabs:
        raise Cant(f"the seed saved no state of {args.tabs}+ tabs: {st}")
    first = Session(yew, ws, env, [], log)
    first.settle(1.0)
    first.pump(SAVE_WAIT_S)
    return env, ws, first, len(names)


def tab_paths(st):
    return [p for _, p in st[0]]


def case_newdir(row, yew, scratch, args, log):
    env, ws, s, n = seed(yew, scratch, args, log)
    before = len([l for l in log_lines(env) if "tab record(s) dropped" in l or "workspace state" in l])
    seen = set()
    for line in ("!mkdir identity", "!yew identity/identity.lu", "!touch identity_test.lu", "!yew identity_test.lu"):
        s.ex(line)
        seen.update(yews_below(os.getpid(), yew))
        s.pump(0.3)
        seen.update(yews_below(os.getpid(), yew))
    s.pump(SAVE_WAIT_S)
    st = read_state(env)
    paths = tab_paths(st)
    a = os.path.join(ws, "identity", "identity.lu")
    b = os.path.join(ws, "identity_test.lu")
    row.check("newdir", "opened_here", a in paths and b in paths, f"{len(paths)} saved tabs, identity tabs {a in paths} {b in paths}")
    row.check("newdir", "kept_tabs", len(paths) >= n + 2, f"{len(paths)} saved tabs, {n} files seeded")
    after = [l for l in log_lines(env) if "tab record(s) dropped" in l or "workspace state" in l]
    row.check("newdir", "one_editor", seen == {s.pid} and len(after) == before,
              f"yew pids {sorted(seen)}, first {s.pid}; state lines {before} -> {len(after)}")
    if not s.quit():
        raise Cant("newdir: the first editor did not quit")
    st = read_state(env)
    row.check("newdir", "saved_after_quit", len(tab_paths(st)) >= n + 2, f"{len(tab_paths(st))} saved tabs")


def case_cd(row, yew, scratch, args, log):
    env, ws, s, n = seed(yew, scratch, args, log)
    for line in ("!mkdir sub", "!cd sub", "!touch x.lu", "!yew x.lu"):
        s.ex(line)
    s.pump(SAVE_WAIT_S)
    st = read_state(env)
    want = os.path.join(ws, "sub", "x.lu")
    active = [p for i, p in st[0] if i == st[1]]
    row.check("cd", "session_cwd", active == [want], f"active {active}, wanted {want}")
    row.check("cd", "no_root_file", os.path.join(ws, "x.lu") not in tab_paths(st), "no tab for the root's x.lu")
    if not s.quit():
        raise Cant("cd: the editor did not quit")


def case_refuse(row, yew, scratch, args, log):
    env, ws, s, n = seed(yew, scratch, args, log)
    os.makedirs(os.path.join(ws, "sub"))
    for line, word in (("!yew sub", "sub"), ("!yew $HOME/x.lu", "$HOME/x.lu"), ("!yew --clean x.lu", "--clean")):
        mark = len(s.raw)
        seen = set()
        s.ex(line, settle=0.3)
        seen.update(yews_below(os.getpid(), yew))
        s.settle(0.6)
        seen.update(yews_below(os.getpid(), yew))
        out = s.since(mark)
        named = b":!yew" in out and b"not opened here" in out
        jobbuf = b"*job:" in out
        tag = word.strip("$-/").replace("/", "_").replace(".", "_").lower()
        row.check("refuse", f"{tag}_named", named, "the message names the refusal" if named else "no refusal on the screen")
        row.check("refuse", f"{tag}_no_job", not jobbuf and seen == {s.pid},
                  f"job buffer {jobbuf}, yew pids {sorted(seen)}")
    if not s.quit():
        raise Cant("refuse: the editor did not quit")


def case_passthru(row, yew, scratch, args, log):
    env, ws, s, n = seed(yew, scratch, args, log)
    mark = len(s.raw)
    s.ex("!yew --version", settle=1.0)
    out = s.since(mark)
    row.check("passthru", "version_runs", b"*job:" in out and b"yew " in out, "a job buffer with yew's version line")
    if not s.quit():
        raise Cant("passthru: the editor did not quit")


def case_bangbang(row, yew, scratch, args, log):
    env, ws, s, n = seed(yew, scratch, args, log)
    with open(os.path.join(ws, "identity.lu"), "w") as f:
        f.write("// identity\n")
    lines0 = len(log_lines(env))
    s.ex("!!yew identity.lu", settle=1.5)
    s.pump(SAVE_WAIT_S)
    nested = [p for p in yews_below(os.getpid(), yew) if p != s.pid]
    new = log_lines(env)[lines0:]
    owned = [l for l in new if f"owned by pid {s.pid}" in l]
    row.check("bangbang", "second_started", len(nested) == 1, f"nested yew pids {nested}")
    row.check("bangbang", "second_is_reader", len(owned) == 1, owned[0] if owned else "no ownership line: " + " | ".join(new[-4:]))
    # The nested editor quits; the first takes the terminal back.
    s.send(b"\x1b")
    s.pump(0.2)
    s.send(b":q\r")
    s.settle(1.5)
    s.pump(SAVE_WAIT_S)
    st = read_state(env)
    row.check("bangbang", "first_tabs_kept", len(tab_paths(st)) >= n + 2, f"{len(tab_paths(st))} saved tabs after the nested quit")
    row.check("bangbang", "lock_is_first", st[2] == s.pid, f"lock {st[2]}, first {s.pid}")
    if not s.quit():
        raise Cant("bangbang: the first editor did not quit")
    st = read_state(env)
    row.check("bangbang", "saved_after_quit", len(tab_paths(st)) >= n + 2, f"{len(tab_paths(st))} saved tabs")


def case_reader(row, yew, scratch, args, log):
    env, ws, first, n = seed(yew, scratch, args, log)
    lines0 = len(log_lines(env))
    reader = Session(yew, ws, env, [], log)
    reader.settle(1.0)
    new = log_lines(env)[lines0:]
    row.check("reader", "reader_told", any(f"owned by pid {first.pid}" in l for l in new), " | ".join(new[-3:]))
    with open(os.path.join(ws, "late.lu"), "w") as f:
        f.write("// late\n")
    late = os.path.join(ws, "late.lu")
    reader.ex("e late.lu", settle=1.0)
    reader.pump(SAVE_WAIT_S)
    st = read_state(env)
    row.check("reader", "reader_saves_nothing", late not in tab_paths(st) and st[2] == first.pid,
              f"late.lu saved {late in tab_paths(st)}, lock {st[2]}, first {first.pid}")
    if not first.quit():
        raise Cant("reader: the first editor did not quit")
    st = read_state(env)
    row.check("reader", "first_saved", len(tab_paths(st)) >= n + 2 and late not in tab_paths(st),
              f"{len(tab_paths(st))} saved tabs, late.lu {late in tab_paths(st)}")
    lines1 = len(log_lines(env))
    third = Session(yew, ws, env, [], log)
    third.settle(1.0)
    third.pump(SAVE_WAIT_S)
    new = log_lines(env)[lines1:]
    st = read_state(env)
    row.check("reader", "third_owns", not any("owned by pid" in l for l in new) and st[2] == third.pid,
              f"lock {st[2]}, third {third.pid}; " + " | ".join(new[-3:]))
    if not reader.quit():
        raise Cant("reader: the reader did not quit")
    st2 = read_state(env)
    row.check("reader", "reader_quit_saves_nothing", tab_paths(st2) == tab_paths(st) and late not in tab_paths(st2),
              f"{len(tab_paths(st2))} saved tabs after the reader quit, late.lu {late in tab_paths(st2)}")
    if not third.quit():
        raise Cant("reader: the third editor did not quit")


def case_stale(row, yew, scratch, args, log):
    env = env_for(scratch, args.term)
    ws = os.path.join(scratch, "ws")
    os.makedirs(ws)
    names = [f"f{i:02d}.lu" for i in range(1, args.tabs + 1)] + ["paths_test.lu"]
    for n in names:
        with open(os.path.join(ws, n), "w") as f:
            f.write(f"// {n}\nfn main() {{}}\n")
    s = Session(yew, ws, env, names, log)
    s.settle(1.0)
    s.pump(SAVE_WAIT_S)
    if not s.quit():
        raise Cant("stale: the seeding editor did not quit")
    d = state_dir(env)
    if d is None:
        raise Cant("stale: the seed saved no state")
    for name in ("lock", "lock.owner"):
        with open(os.path.join(d, name), "w") as f:
            f.write("1\n")
    lines0 = len(log_lines(env))
    e = Session(yew, ws, env, [], log)
    e.settle(1.0)
    e.ex("e paths_test.lu", settle=0.5)
    e.pump(SAVE_WAIT_S)
    new = log_lines(env)[lines0:]
    st = read_state(env)
    row.check("stale", "owns_the_state", not any("owned by pid 1;" in l for l in new) and st[2] == e.pid,
              f"lock {st[2]}, editor {e.pid}; " + " | ".join(new[-3:]))
    if not e.quit():
        raise Cant("stale: the editor did not quit")


def case_dropped(row, yew, scratch, args, log):
    env, ws, s, n = seed(yew, scratch, args, log)
    if not s.quit():
        raise Cant("dropped: the editor did not quit")
    st = read_state(env)
    ids = [i for i, _ in st[0]]
    row.check("dropped", "active_saved", st[1] in ids, f"active_tab {st[1]}, record ids {ids[:4]}...{ids[-2:]}")
    lines0 = len(log_lines(env))
    again = Session(yew, ws, env, [], log)
    again.settle(1.0)
    new = log_lines(env)[lines0:]
    drops = [l for l in new if "dropped" in l]
    row.check("dropped", "no_drop_logged", not drops, drops[0] if drops else "no dropped record logged")
    if not again.quit():
        raise Cant("dropped: the second resume did not quit")


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("yew")
    ap.add_argument("--keep")
    ap.add_argument("--case", action="append", choices=CASES)
    ap.add_argument("--tabs", type=int, default=26)
    ap.add_argument("--term", default="xterm-256color")
    args = ap.parse_args()
    yew = os.path.realpath(args.yew)
    cases = args.case or CASES
    top = args.keep or tempfile.mkdtemp(prefix="nested-open-row.")
    os.makedirs(top, exist_ok=True)
    row = Row(args)
    status = 0
    try:
        for c in cases:
            scratch = os.path.join(top, c)
            if os.path.exists(scratch):
                shutil.rmtree(scratch)
            os.makedirs(scratch)
            with open(os.path.join(scratch, "pty.raw"), "wb") as log:
                globals()["case_" + c](row, yew, scratch, args, log)
            for l in log_lines(env_for(scratch, args.term)):
                print(f"  log {c}: {l}", flush=True)
    except Cant as e:
        print(f"nested-open-row: cannot run: {e}", flush=True)
        status = 2
    finally:
        if not args.keep:
            shutil.rmtree(top, ignore_errors=True)
    if status == 2:
        sys.exit(2)
    for r in row.reds:
        print(f"FAIL {r}", flush=True)
    print("nested-open-row: " + ("RED" if row.reds else "GREEN"), flush=True)
    sys.exit(1 if row.reds else 0)


if __name__ == "__main__":
    main()
