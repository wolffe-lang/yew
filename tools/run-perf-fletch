#!/bin/sh
# Gate on the pool in its taskset/container; hosted CI explicitly uses --advisory.
set -eu
YEW_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh
oracle="$YEW_ROOT/target/oracle/sagitta"
tier=release
advisory=
rows=all
while [ "$#" -gt 0 ]; do
  case "$1" in
    --advisory) advisory=--advisory ;;
    --native) tier=native ;;
    --release) tier=release ;;
    --oracle-tree) shift; oracle=${1:?missing oracle tree} ;;
    --rows) shift; rows=${1:?missing row list} ;;
    *) echo 'usage: run-perf-fletch [--native|--release] [--advisory] [--oracle-tree DIR] [--rows CSV of rows, smoke, headless, editor]' >&2; exit 2 ;;
  esac
  shift
done
if [ "${YEW_FL_GC_STRESS+x}" = x ] || [ "${FL_GC_STRESS+x}" = x ]; then
  echo 'run-perf-fletch: REFUSED: GC stress is set; timings would be meaningless' >&2
  exit 2
fi
# The three driver families by name (compare.py's SMOKE, HEADLESS, EDITOR):
# `--rows editor` runs the six editor rows, `--rows smoke,headless` the
# thirteen of yw08; only the drivers a selected row needs are built (the
# editor driver is a release build of the whole editor).
smoke_rows=fib24,map10k,motion100k
headless_rows=startup,parse_only,motion_dispatch,fib27,map_heavy,gc_pause,strbuild_join,strbuild_concat,join5k,list_sort
editor_rows=config_load,config_reload_500,macrolib_scan_200,motion_editor,query_cur_pos,insert_100k
if [ "$rows" != all ]; then
  expanded=
  for r in $(printf '%s\n' "$rows" | tr ',' ' '); do
    case "$r" in
      smoke) r=$smoke_rows ;;
      headless) r=$headless_rows ;;
      editor) r=$editor_rows ;;
    esac
    expanded=${expanded:+$expanded,}$r
  done
  rows=$expanded
fi
wants() {
  [ "$rows" = all ] && return 0
  for r in $(printf '%s\n' "$1" | tr ',' ' '); do
    case ",$rows," in *,"$r",*) return 0 ;; esac
  done
  return 1
}
. tools/lib-test-env.sh
test_env_begin
export YEW_RUNTIME_DIR="$YEW_ROOT/runtime"
tools/build-fl-perf-oracle "$oracle"
if wants "$smoke_rows"; then tools/build-fl-core "--$tier"; fi
if wants "$headless_rows"; then tools/build-fl-core --headless "--$tier"; fi
if wants "$editor_rows"; then tools/build-fl-core --editor "--$tier"; fi
python3 -I tools/fl-headless/compare.py --selftest
python3 -I tools/fl-headless/compare.py --oracle-tree "$oracle" --tier "$tier" --rows "$rows" $advisory
