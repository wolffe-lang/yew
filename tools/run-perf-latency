#!/bin/sh
# run-perf-latency — the 2× gate (yw01 contract §7, ruling #89 R3):
# cold start → first paint and keypress → paint, the port's demo_paint
# beside C yew's from the same run, the ratio printed, red above 2.0.
#
#   tools/run-perf-latency [--cpus 0-3] [--starts N] [--keys K]
#                          [--c-demo PATH] [--yew-demo PATH]
#
# sagitta's own tests/perf/perf_latency.c and perf_startup.c drive the
# EDITOR (`--workspace`, `--config`, a file), which is campaign 03's; at
# yw01 the same two points are measured over the demo's `basic` and
# `damage` scenes by tools/perf-demo/measure.py, each binary in a PTY
# under the harness's pinned environment. With --cpus the two runs are
# pinned with taskset (kasumi: `--cpus 0-3`, the contract's rig; the
# hosted runner has no taskset and no quiet, so CI runs this step as an
# announced advisory until a designated runner exists, as sagitta's
# `enforcement=budget` rows do).
#
# Exit 0 within 2.0 on both ratios, 1 above, 2 on a harness fault.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"

cpus=
starts=20
keys=300
c_demo=$YEW_ROOT/target/oracle/sagitta/build/demo_paint
yew_demo=$YEW_ROOT/target/tools/demo_paint
while [ $# -gt 0 ]; do
    case "$1" in
    --cpus) cpus=$2; shift 2 ;;
    --starts) starts=$2; shift 2 ;;
    --keys) keys=$2; shift 2 ;;
    --c-demo) c_demo=$2; shift 2 ;;
    --yew-demo) yew_demo=$2; shift 2 ;;
    *) echo "run-perf-latency: unknown option $1" >&2; exit 2 ;;
    esac
done
[ -x "$c_demo" ] || { echo "run-perf-latency: no C demo at $c_demo; run tools/oracle first" >&2; exit 2; }
[ -x "$yew_demo" ] || { echo "run-perf-latency: no port demo at $yew_demo; run tools/build-demo first" >&2; exit 2; }
pin=
if [ -n "$cpus" ]; then
    command -v taskset >/dev/null || { echo "run-perf-latency: --cpus needs taskset" >&2; exit 2; }
    pin="taskset -c $cpus"
fi
out=$YEW_ROOT/target/perf
rm -rf "$out"
mkdir -p "$out"

# C first, then the port, then C again: the second C run shows the
# drift of the rig during the measurement (reported, not used).
$pin python3 tools/perf-demo/measure.py --bin "$c_demo" --label c --starts "$starts" --keys "$keys" --state "$out/state-c" | tee "$out/c.txt"
$pin python3 tools/perf-demo/measure.py --bin "$yew_demo" --label wolf --starts "$starts" --keys "$keys" --state "$out/state-wolf" | tee "$out/wolf.txt"
$pin python3 tools/perf-demo/measure.py --bin "$c_demo" --label c2 --starts "$starts" --keys "$keys" --state "$out/state-c2" | tee "$out/c2.txt"

p50() { sed -n "s/^$1\.$2 p50_ns=\([0-9]*\).*/\1/p" "$out/$3.txt"; }
rc=0
for metric in startup.first_paint keypress_to_paint; do
    c=$(p50 "$metric" c c)
    w=$(p50 "$metric" wolf wolf)
    c2=$(p50 "$metric" c2 c2)
    [ -n "$c" ] && [ -n "$w" ] && [ -n "$c2" ] || { echo "run-perf-latency: $metric: a run printed no p50" >&2; exit 2; }
    ratio=$(awk -v w="$w" -v c="$c" 'BEGIN { printf "%.2f", w / c }')
    drift=$(awk -v a="$c" -v b="$c2" 'BEGIN { printf "%.2f", b / a }')
    verdict=$(awk -v r="$ratio" 'BEGIN { print (r <= 2.0) ? "PASS" : "FAIL" }')
    echo "ratio.$metric wolf/c=$ratio (c p50=${c}ns, wolf p50=${w}ns, c again=${c2}ns, drift=$drift) limit=2.0 verdict=$verdict"
    [ "$verdict" = PASS ] || rc=1
done
exit $rc
