#!/usr/bin/env bash
# run-fuzz-groups — Sprint 24's group fuzz (s24 Testing Strategy, DoD 3
# and 10): the 400-step membership storm against a naive oracle (no empty
# group survives any sequence, every count and order recomputed and
# compared after EVERY step and every walk step) and the 400-key picker
# storm (no invented path), one editor session per generated input.
#
#   tools/run-fuzz-groups [--native] [--iters=N] [--seed=N]
#   tools/run-fuzz-groups --campaign [--against-oracle] [--seeds="S..."] [--sessions=N]
#
# Builds tools/fuzz-groups/main.lu (tools/build-fuzz-groups; FUZZ_PREBUILT=1
# runs the driver already built) and runs it from the repository root.
# The defaults are sagitta's generator's (200,000 iterations, seed 1).
# C counts this target in SESSIONS, not FUZZ_ITERS (Makefile:180-195:
# one session builds a whole editor): `make fuzz-groups` runs 250 sessions
# at each of four seeds, so `--campaign` does the same — GROUPS_FUZZ_SEEDS
# "1 0x243f6a8885a308d3 0x9e3779b97f4a7c15 0xd1b54a32d192ed03", 250
# sessions each (100,000 membership steps a seed: s24's "5k-op membership
# storm" twenty times over). The report line's `hash=` is C's for the same
# seed and sessions (the generator is C's bit for bit). `--against-oracle`
# also runs C's own driver (target/oracle/sagitta/build/fuzz_groups, which
# tools/oracle builds) with the same arguments and requires the two report
# lines to be equal byte for byte; a missing C driver is exit 2, never a
# silent pass. Exit is the driver's, read directly: 0 when every input
# held, 1 with the failing input printed as hex, 2 on a usage error.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"

native=
if [ "${1:-}" = --native ]; then
    native=--native
    shift
fi
if [ "${FUZZ_PREBUILT:-0}" != 1 ]; then
    tools/build-fuzz-groups $native
fi
driver=target/tools/fuzz-groups
if [ "${1:-}" = --campaign ]; then
    shift
    oracle=0
    seeds="1 0x243f6a8885a308d3 0x9e3779b97f4a7c15 0xd1b54a32d192ed03"
    sessions=250
    for a in "$@"; do
        case "$a" in
        --against-oracle) oracle=1 ;;
        --seeds=*) seeds=${a#--seeds=} ;;
        --sessions=*) sessions=${a#--sessions=} ;;
        *)
            echo "run-fuzz-groups: unknown argument $a" >&2
            exit 2
            ;;
        esac
    done
    c=target/oracle/sagitta/build/fuzz_groups
    if [ "$oracle" = 1 ] && [ ! -x "$c" ]; then
        echo "run-fuzz-groups: $c is not built (tools/oracle's targets must list build/fuzz_groups)" >&2
        exit 2
    fi
    for s in $seeds; do
        port_line=$("$driver" --iters="$sessions" --seed="$s") || {
            echo "port: $port_line"
            exit 1
        }
        echo "port: $port_line"
        if [ "$oracle" = 1 ]; then
            c_line=$(cd target/oracle/sagitta && build/fuzz_groups --iters="$sessions" --seed="$s") || {
                echo "C:    $c_line"
                exit 1
            }
            echo "C:    $c_line"
            if [ "$port_line" != "$c_line" ]; then
                echo "run-fuzz-groups: the port's report differs from C's at seed $s" >&2
                exit 1
            fi
        fi
    done
    exit 0
fi
exec "$driver" "$@"
