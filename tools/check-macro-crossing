#!/usr/bin/env python3
"""A macro file crosses between the port and C yew in both directions.

  tools/check-macro-crossing --port PORT_YEW --oracle C_YEW

The port records `# recorded-with: yew <its version>`. C yew loads such a
macro, and warns that it was recorded with a different major version (its
loader's text), and the macro works. The port loads a macro recorded by C yew
(major 1) or by itself without any such warning, and the macro works.
Both run headless (`--batch --test`) in a scratch directory with scratch
state directories.
"""
import argparse
import os
from pathlib import Path
import subprocess
import tempfile

WARNING = 'has a different major version from yew'
SCRIPT = '''import buf
import ed
import opt
let b = buf.current()
edit { opt.set("macro.dir", "lib") }
ed.run("ed.macro.replay", {sarg: "edit.add_x"})
t.text(b, "x")
t.undo(b, 2)
'''


def first_line(binary):
    out = subprocess.run([binary, '--version'], capture_output=True, text=True)
    assert out.returncode == 0, 'crossing-version-flag %s' % binary
    return out.stdout.splitlines()[0]


def load(binary, recorded_with):
    """Run SCRIPT under BINARY with a macro whose header says RECORDED_WITH."""
    with tempfile.TemporaryDirectory(prefix='macro-crossing-') as t:
        base = Path(t)
        for name in ('home', 'state', 'config', 'cache'):
            (base / name).mkdir()
        work = base / 'work'
        work.mkdir()
        (work / 'lib').mkdir()
        (work / 'lib/edit.fl').write_text(
            '# yew-macro: 1\n# recorded-with: %s\nmacro add_x = @[ i"x" ]\n' % recorded_with)
        (work / 'case.fl').write_text(SCRIPT)
        env = dict(os.environ, HOME=str(base / 'home'), XDG_STATE_HOME=str(base / 'state'),
                   XDG_CONFIG_HOME=str(base / 'config'), XDG_CACHE_HOME=str(base / 'cache'),
                   SHELL='/bin/sh', LC_ALL='C')
        run = subprocess.run([binary, '--batch', '--test', 'case.fl'], cwd=work, env=env,
                             capture_output=True, text=True, timeout=120)
        return run.returncode, run.stdout + run.stderr


def main():
    p = argparse.ArgumentParser()
    p.add_argument('--port', required=True)
    p.add_argument('--oracle', required=True)
    a = p.parse_args()
    a.port = str(Path(a.port).resolve())
    a.oracle = str(Path(a.oracle).resolve())
    ours = first_line(a.port)
    assert ours.startswith('yew '), ours
    # C yew loads the port's macro, warns, and the macro works.
    rc, text = load(a.oracle, ours)
    assert rc == 0, 'crossing-oracle-load-failed rc=%d\n%s' % (rc, text)
    assert WARNING in text and ours in text and 'loading anyway' in text, \
        'crossing-oracle-warning-missing\n%s' % text
    # The port loads its own macro and C yew's, silently, and they work.
    for recorded in (ours, first_line(a.oracle)):
        rc, text = load(a.port, recorded)
        assert rc == 0, 'crossing-port-load-failed (%s) rc=%d\n%s' % (recorded, rc, text)
        assert WARNING not in text, 'crossing-port-warned (%s)\n%s' % (recorded, text)
    print('PASS macro-crossing oracle-warns-and-loads port-loads-both-silently')


if __name__ == '__main__':
    try:
        main()
    except AssertionError as error:
        print('FAIL ' + str(error))
        raise SystemExit(1)
