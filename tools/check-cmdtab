#!/bin/sh
# check-cmdtab — src/edit/cmdtab.lu is what tools/gen-cmdtab makes from
# sagitta's command registry at the pin (`cmd.c`'s descriptor tables, the
# E-mode grammar, each handler's declaring file): the drift check, as
# tools/check-tables is the Unicode tables'.
#
#   tools/check-cmdtab [SAGITTA]   regenerate into target/tools/ and
#                                  compare; exit 1 on drift
#
# SAGITTA defaults to the oracle tree tools/oracle fetched at the pin
# (target/oracle/sagitta).
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$YEW_ROOT"
tree=${1:-target/oracle/sagitta}
if [ ! -f "$tree/src/edit/cmd.c" ]; then
    echo "check-cmdtab: no sagitta tree at $tree (run tools/oracle first)" >&2
    exit 2
fi
mkdir -p target/tools
python3 -I tools/gen-cmdtab/gen.py "$tree" target/tools/cmdtab.lu
if cmp -s target/tools/cmdtab.lu src/edit/cmdtab.lu; then
    rows=$(grep -c '\\x1f' src/edit/cmdtab.lu)
    echo "check-cmdtab: src/edit/cmdtab.lu is the generator's ($rows rows from $tree)"
else
    echo "check-cmdtab: src/edit/cmdtab.lu DIFFERS from the generator's output" >&2
    diff target/tools/cmdtab.lu src/edit/cmdtab.lu | head -10 >&2 || true
    exit 1
fi
