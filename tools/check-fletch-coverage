#!/bin/bash
# check-fletch-coverage — s33 §3/§4's coverage gate against the port (yw08,
# the adopted contract's deliverable 5). sagitta's own
# scripts/check-fletch-coverage.sh, run unchanged from the pinned tree with
# its YEW pointed at BIN:
#   checks 1-6, `fletch_run --check` (run.c:1643-1790): every spec section
#     has a `# SPEC:` file, every EBNF nonterminal, every native BIN's
#     `yew fl --list-natives` prints (run.c:1455-1482, check 3's source of
#     truth), every §9 kind and every opcode appear in a `# COVERS:`;
#   check 7, `fletch_run --ledger` byte-identical to the pinned
#     tests/fletch/ledger.txt (compared through a temporary file; the tree
#     is never written).
# Then the ledger half of `test-fletch-determinism` (Makefile:4021-4025, the
# ledger generated twice and byte-compared; tools/check-fletch-goldens holds
# the suite half), and BIN's --list-natives against C yew's byte for byte.
# Two controls run first, each through a wrapper around BIN that the runner
# execs as `yew`: one drops the last native, one invents a native no file
# covers; the gate must go red on both, or this exits 1 before it judges BIN.
#     tools/check-fletch-coverage BIN
set -u
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
bin=${1:?usage: tools/check-fletch-coverage BIN}
case "$bin" in /*) ;; *) bin=$PWD/$bin ;; esac
[ -x "$bin" ] || { echo "check-fletch-coverage: $bin is not executable" >&2; exit 2; }
tree=${SAGITTA_TREE:-$YEW_ROOT/target/oracle/sagitta}
case "$tree" in /*) ;; *) tree=$YEW_ROOT/$tree ;; esac
for need in build/fletch_run build/yew scripts/check-fletch-coverage.sh tests/fletch/ledger.txt; do
    [ -e "$tree/$need" ] || {
        echo "check-fletch-coverage: $tree/$need is missing (tools/oracle builds the tree)" >&2
        exit 2
    }
done
work=$YEW_ROOT/target/fletch-coverage
rm -rf "$work"
mkdir -p "$work"
gate() { # YEW LOG: C's own coverage script, its exit code
    (cd "$tree" && LC_ALL=C BUILD=build YEW="$1" scripts/check-fletch-coverage.sh) >"$2" 2>&1
}
red=0

# The controls: a missing native and an invented one, each red by check 3
# or check 7, never green.
cat >"$work/drop-native" <<EOF
#!/bin/sh
if [ "\$1" = fl ] && [ "\$2" = --list-natives ] && [ \$# = 2 ]; then
    "$bin" fl --list-natives | sed '\$d'; exit 0
fi
exec "$bin" "\$@"
EOF
cat >"$work/extra-native" <<EOF
#!/bin/sh
if [ "\$1" = fl ] && [ "\$2" = --list-natives ] && [ \$# = 2 ]; then
    "$bin" fl --list-natives; echo zz.uncovered_native; exit 0
fi
exec "$bin" "\$@"
EOF
chmod +x "$work/drop-native" "$work/extra-native"
for control in drop-native extra-native; do
    if gate "$work/$control" "$work/$control.log"; then
        echo "check-fletch-coverage: control $control passed the gate (it must be red)"
        sed 's/^/check-fletch-coverage:   /' "$work/$control.log" | tail -8
        exit 1
    fi
    echo "check-fletch-coverage: control $control red as it must be: $(grep -m1 -E '^check [0-9]' "$work/$control.log" || tail -1 "$work/$control.log")"
done

# The gate itself, against C yew (the pin's own verdict) and against BIN.
for who in C port; do
    if [ "$who" = C ]; then y=$tree/build/yew; else y=$bin; fi
    if gate "$y" "$work/gate-$who.log"; then
        echo "check-fletch-coverage: $who: $(tail -1 "$work/gate-$who.log")"
    else
        echo "check-fletch-coverage: $who: RED"
        sed 's/^/check-fletch-coverage:   /' "$work/gate-$who.log" | tail -40
        red=1
    fi
done

# The ledger twice (the determinism target's second half), and BIN's
# ledger against the pinned file once more by name.
for n in 1 2; do
    (cd "$tree" && LC_ALL=C build/fletch_run --ledger --yew "$bin") >"$work/ledger-$n.txt" 2>"$work/ledger-$n.err" ||
        { echo "check-fletch-coverage: fletch_run --ledger exited nonzero (run $n)"; red=1; }
done
if cmp -s "$work/ledger-1.txt" "$work/ledger-2.txt"; then
    echo "check-fletch-coverage: ledger twice, byte-identical ($(wc -l <"$work/ledger-1.txt" | tr -d ' ') lines)"
else
    echo "check-fletch-coverage: the two ledgers differ"; red=1
fi
if cmp -s "$work/ledger-1.txt" "$tree/tests/fletch/ledger.txt"; then
    echo "check-fletch-coverage: ledger = tests/fletch/ledger.txt at the pin: $(tail -1 "$work/ledger-1.txt")"
else
    echo "check-fletch-coverage: ledger differs from tests/fletch/ledger.txt"
    diff -u "$tree/tests/fletch/ledger.txt" "$work/ledger-1.txt" | head -20
    red=1
fi

# Check 3's source of truth, byte for byte against C's.
"$tree/build/yew" fl --list-natives >"$work/natives-C.txt" 2>&1 || red=1
"$bin" fl --list-natives >"$work/natives-port.txt" 2>&1 || red=1
if cmp -s "$work/natives-C.txt" "$work/natives-port.txt"; then
    echo "check-fletch-coverage: --list-natives = C's ($(wc -l <"$work/natives-port.txt" | tr -d ' ') natives)"
else
    echo "check-fletch-coverage: --list-natives differs from C's"
    diff -u "$work/natives-C.txt" "$work/natives-port.txt" | head -20
    red=1
fi
[ $red = 0 ] && echo "check-fletch-coverage: GREEN" || echo "check-fletch-coverage: RED"
exit $red
