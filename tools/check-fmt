#!/bin/sh
# check-fmt — wolf fmt --check over every .lu in the tree: the port's
# sources, its tests, and the tools written in wolf.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh
"$WOLF" fmt --check src
for d in tools/*/; do
    [ -f "$d/main.lu" ] && "$WOLF" fmt --check "$d"
done
