#!/bin/sh
# check-fmt — wolf fmt --check over every .lu in the tree: the port's
# sources, its tests, and the tools written in wolf.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh
# Every path is checked and named before the verdict: under `set -e` the
# first miss used to hide the rest (yw08: src/util/log.lu masked the tools).
rc=0
"$WOLF" fmt --check src || rc=1
for d in tools/*/; do
    if [ -f "$d/main.lu" ]; then "$WOLF" fmt --check "$d" || rc=1; fi
done
exit "$rc"
