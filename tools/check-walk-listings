#!/bin/bash
# check-walk-listings — R-yw06-10's gate: the port's walk and .gitignore
# over the two fixture trees of the C input witness (tools/walk-listings/
# witness.py builds them: `.git/info/exclude` beside a blocked file, which
# C does NOT read; `.git/info/.gitignore`, which it does; a nested
# `/build/` whose anchor has a NULL base on disk and `sub` in memory),
# listed by src/ws_walk_lister.lu, the JSON compared byte for byte with
# C's own (tools/walk-listings/c.json: pinned C's walk_oracle.c over the
# same trees, notes/yw06-evidence/finder-inputs/run-witness.sh at
# 9ace98c2; the pin does not move, so its answer is recorded once).
#
#   tools/check-walk-listings
#
# Exit 0 when the listings are C's, 1 when they differ (the diff printed),
# 2 on a build error.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh
export YEW_LOG=/dev/null
out=target/walk-listings
rm -rf "$out"
mkdir -p "$out"
"$WOLF" build --deny-warnings src/ws_walk_lister.lu -o "$out/walk-lister" || exit 2
python3 -I tools/walk-listings/witness.py "$out/walk-lister" "$out/fixtures" > "$out/port.json"
if cmp -s tools/walk-listings/c.json "$out/port.json"; then
    echo "check-walk-listings: the port's listings are C's ($(grep -c '"exit"' "$out/port.json") cases)"
else
    diff -u tools/walk-listings/c.json "$out/port.json" || true
    echo "check-walk-listings: the port's listings DIFFER from C's" >&2
    exit 1
fi
