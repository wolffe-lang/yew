#!/bin/sh
# build-perf-search — Sprint 21's search-latency harness,
# tools/perf-search/main.lu (the port of sagitta's
# tests/perf/search_latency.c, run beside it), built on the
# release tier into target/tools/perf-search.
#
#   tools/build-perf-search [--native]
#
# `use edit` resolves beside the ENTRY file (D32), so the port's modules
# are staged beside a copy under target/perf-search/, as
# tools/build-demo stages the demo. Nothing there is committed.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

tier=release
case "${1:-}" in
"") ;;
--native) tier=native ;;
*)
    echo "build-perf-search: unknown option $1" >&2
    exit 2
    ;;
esac

stage=$YEW_ROOT/target/perf-search
rm -rf "$stage"
mkdir -p "$stage" target/tools
cp tools/perf-search/main.lu "$stage/main.lu"
for m in util unicode term text search ws edit; do
    cp -R "src/$m" "$stage/$m"
    rm -f "$stage/$m"/*_test.lu
done
if [ "$tier" = release ]; then
    "$WOLF" build --release --deny-warnings "$stage/main.lu" -o target/tools/perf-search
else
    "$WOLF" build --deny-warnings "$stage/main.lu" -o target/tools/perf-search
fi
echo "build-perf-search: target/tools/perf-search ($tier)"
