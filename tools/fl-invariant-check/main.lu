//! Nonshipping white-box test entry. tools/check-fl-invariants stages this
//! beside copied fl sources so private VM guards can be tested without
//! adding a production mutator API. No foreign bytecode is loaded.

fn witness_program(mut vm: FlVm, src: str) -> FlValue {
    let id = fl_diag_add_file(mut vm.dc, "invariant-test.fl", src.bytes())
    let p = fl_parse(src.bytes(), id, mut vm.dc, mut vm.strings)
    let origin = copy vm.root_origin
    fl_compile(mut vm, p, id, origin) else { assert(false); fl_nil() }
}

fn witness_code(mut vm: FlVm, fun: FlValue, bytes: List[int]) {
    let at = fl_obj_index(vm, fun)
    (mut vm.gc.slots[at].code).reset()
    for b in bytes { (mut vm.gc.slots[at].code).push(b as byte) }
}

fn witness_frame(mut vm: FlVm, fun: FlValue) {
    let cl = fl_closure_new(mut vm, fun)
    fl_push(mut vm, cl)
    assert(fl_frame_push(mut vm, cl, 0, 0, 0, 0))
}

fn main() -> int {
    let args = env_args()
    if args.len != 1 { return 2 }
    let which = args[0]
    var strings = fl_strings()
    var vm = fl_vm_new(take strings)
    vm.checks = true
    let fun = witness_program(mut vm, "return \"x\"\n")
    if which == "frame" { let _ = fl_return_frame(mut vm); return 1 }
    if which == "white" {
        let obj = fl_str_text(mut vm, "rooted witness")
        vm.stack[0] = obj
        vm.sp = 1
        vm.gc.remap[fl_obj_index(vm, obj)] = -1
        let _ = fl_remap(mut vm, obj)
        return 1
    }
    if which == "opcode" {
        witness_code(mut vm, fun, [254, 56])
    } else if which == "underflow" {
        witness_code(mut vm, fun, [6, 6, 56])
    } else if which == "constant" {
        witness_code(mut vm, fun, [0, 255, 255, 56])
    } else if which == "local" {
        witness_code(mut vm, fun, [9, 255, 56])
    } else if which == "upvalue" {
        witness_code(mut vm, fun, [11, 0, 56])
    } else if which == "handler-empty" {
        witness_code(mut vm, fun, [55, 56])
    } else if which == "edit-empty" {
        witness_code(mut vm, fun, [52, 56])
    } else if which == "edit-full" {
        witness_code(mut vm, fun, [51, 56])
    } else if which != "stack-top" && which != "handler-full" && which != "pc" {
        return 2
    }
    witness_frame(mut vm, fun)
    if which == "stack-top" { vm.sp = vm.stack.len + 1 }
    if which == "handler-full" {
        for _ in 0..65 { (mut vm.handlers).push(FlHandler { pc: 0, sp: 0, frame: 0, edit_depth: 0 }) }
    }
    if which == "edit-full" { vm.edit_depth = 4294967295 }
    if which == "pc" { vm.frames[0].ip = -1 }
    let _ = fl_vm_exec(mut vm, 0)
    1
}
