#!/usr/bin/env bash
# run-perf-mouse — Sprint 27 DoD 13's motion-burst gate (and s57.13 §3's
# menu hover, s57.15 §2's chevron hover), the port beside C.
#
#   tools/run-perf-mouse [--cpus 8-11] [--build-only [--native]]
#
# Runs sagitta's own perf_mouse (`build/perf_mouse`, built into the oracle
# tree from its Makefile if tools/oracle has not; run from the oracle
# tree's root, where its allocation scan reads src/ui/mouse.c) and the
# port's twin (tools/perf-mouse/main.lu, release tier, staged beside the
# port's modules — D32), both under `taskset` on the CPUs given (yw06 ran
# on kasumi 8-11: 0-3 were another lane's), C first, the port, C again,
# and prints one ratio line: each timing as the port's over C's (the two
# C runs averaged), and every render count beside C's.
#
# --build-only is the hard compile gate: build both harnesses, run
# neither (`--native` builds the port's on the default tier; a
# measurement is always release). Exit 0 but on a harness fault (2) or a
# broken correctness gate in the port (1: a render during the burst, more
# frames than rows over the menu or than reveal steps over the chevron,
# or a router that charged the ledger); the times are a FINDING for the
# note, their verdicts printed.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

cpus=8-11
build_only=0
tier=--release
while [ $# -gt 0 ]; do
    case "$1" in
    --cpus) cpus=$2; shift 2 ;;
    --build-only) build_only=1; shift ;;
    --native) tier=""; shift ;;
    *) echo "run-perf-mouse: unknown option $1" >&2; exit 2 ;;
    esac
done

if [ "$build_only" = 0 ] && [ -z "$tier" ]; then
    echo "run-perf-mouse: --native is for --build-only: a measurement is the release tier's" >&2
    exit 2
fi
oracle=$YEW_ROOT/target/oracle/sagitta
[ -d "$oracle" ] || { echo "run-perf-mouse: no oracle tree (tools/oracle)" >&2; exit 2; }
build=$(readlink "$oracle/build" || echo build-gcc)
cc=gcc
case "$build" in build-clang) cc=clang ;; esac
if [ ! -x "$oracle/$build/perf_mouse" ]; then
    make -C "$oracle" --no-print-directory CC="$cc" BUILD="$build" "$build/perf_mouse" >/dev/null
fi

stage=$YEW_ROOT/target/perf-mouse
if [ "$build_only" = 1 ] || [ "${PERF_PREBUILT:-0}" != 1 ] || [ ! -x "$stage/perf-mouse" ]; then
    rm -rf "$stage"
    mkdir -p "$stage"
    cp tools/perf-mouse/main.lu "$stage/main.lu"
    for d in src/*/; do
        m=$(basename "$d")
        cp -R "src/$m" "$stage/$m"
        rm -f "$stage/$m"/*_test.lu
    done
    # shellcheck disable=SC2086
    "$WOLF" build $tier --deny-warnings "$stage/main.lu" -o "$stage/perf-mouse"
fi
if [ "$build_only" = 1 ]; then
    echo "run-perf-mouse: build-only: C and port harnesses built; no measurement"
    exit 0
fi

runc() {
    (cd "$oracle" && YEW_RUNTIME_DIR="$oracle/runtime" taskset -c "$cpus" "$build/perf_mouse")
}
c1=$(runc) || { echo "$c1"; echo "run-perf-mouse: C's perf_mouse failed" >&2; }
port_rc=0
port=$(YEW_LOG=/dev/null taskset -c "$cpus" "$stage/perf-mouse") || port_rc=$?
c2=$(runc) || true
echo "$c1" | sed 's/^/C (first): /'
echo "$port"
echo "$c2" | sed 's/^/C (again): /'
echo "run-perf-mouse: taskset -c $cpus; port exit $port_rc"
python3 -I - "$c1" "$c2" "$port" <<'PY'
import re, sys
c1, c2, port = sys.argv[1], sys.argv[2], sys.argv[3]
def c_ms(text, key):
    m = re.search(key + r'[^\n]*?ms=([0-9.]+)', text)
    return float(m.group(1)) if m else None
def p_ms(text, key):
    m = re.search(key + r'_ns=([0-9]+)', text)
    return int(m.group(1)) / 1e6 if m else None
def renders(text, key):
    m = re.search(key + r' burst=[0-9]+ renders=([0-9]+)', text)
    return int(m.group(1)) if m else None
rows = []
for name, ckey, pkey in (('burst', 'events_', 'events'),
                         ('menu_hover', 'menu_hover', 'hover'),
                         ('chevron_hover', 'chevron_hover', 'chevron')):
    a, b, p = c_ms(c1, ckey), c_ms(c2, ckey), p_ms(port, pkey)
    if a is None or b is None or p is None:
        print("run-perf-mouse: %s missing (C %s/%s, port %s)" % (name, a, b, p))
        sys.exit(2)
    c = (a + b) / 2
    rows.append("%s %.3f/%.3f ms = %.2f" % (name, p, c, p / c if c else float('inf')))
burst_re = re.compile(r'events_[nm]s=[0-9.]+ \(budget [0-9.]+\) (?:ok|FAIL)[^\n]* renders=([0-9]+)')
pb = burst_re.search(port); cb = burst_re.search(c1)
counts = "burst renders port=%s C=%s | menu renders port=%s C=%s | chevron renders port=%s C=%s" % (
    pb.group(1) if pb else None, cb.group(1) if cb else None,
    renders(port, 'menu_hover'), renders(c1, 'menu_hover'),
    renders(port, 'chevron_hover'), renders(c1, 'chevron_hover'))
print("perf-mouse: port/C: " + " | ".join(rows) + " | " + counts)
bad = 0
for line in port.splitlines():
    if line.startswith('perf-mouse: menu_hover') or line.startswith('perf-mouse: chevron_hover') \
            or line.startswith('perf-mouse: router_bytes'):
        if line.endswith(' FAIL'):
            bad = 1
    if line.startswith('perf-mouse: burst=') and 'renders=' in line and not line.endswith('(budget 0) ok'):
        bad = 1
sys.exit(bad)
PY
