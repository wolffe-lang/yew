#!/bin/sh
# check-tables — src/unicode/tables.lu is what tools/gen-unicode-tables
# makes from ucd/16.0.0/ (the drift check, `s02` §8's CI `unicode`
# lane), and its arrays are sagitta's (`--dump` against the C fixture).
#
#   tools/check-tables          regenerate in memory and compare; diff
#                               the dump against tests/fixtures/unicode/
#                               tables-c.txt; exit 1 on either drift
#   tools/check-tables --write  regenerate the file (a Unicode bump)
#
# The generator is a wolf program (tools/gen-unicode-tables/main.lu),
# built with the pinned wolf on first use into target/tools/.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

mkdir -p target/tools
gen=target/tools/gen-unicode-tables
if [ ! -x "$gen" ] || [ tools/gen-unicode-tables/main.lu -nt "$gen" ]; then
    "$WOLF" build --release --deny-warnings tools/gen-unicode-tables/main.lu -o "$gen"
fi

case "${1:-}" in
--write)
    "$gen" ucd/16.0.0 src/unicode/tables.lu
    ;;
"")
    "$gen" --check ucd/16.0.0 src/unicode/tables.lu
    "$gen" --dump ucd/16.0.0 >target/tools/tables-dump.txt
    if cmp -s target/tools/tables-dump.txt tests/fixtures/unicode/tables-c.txt; then
        echo "check-tables: the arrays are sagitta's (tests/fixtures/unicode/tables-c.txt)"
    else
        echo "check-tables: the arrays DIFFER from sagitta's tables.c" >&2
        diff target/tools/tables-dump.txt tests/fixtures/unicode/tables-c.txt | head -5 >&2 || true
        exit 1
    fi
    ;;
*)
    echo "usage: tools/check-tables [--write]" >&2
    exit 2
    ;;
esac
