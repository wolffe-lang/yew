#!/bin/sh
# run-perf-search — Sprint 21's search-latency ratios (s21 DoD 5): the
# port's harness (tools/perf-search/main.lu, release tier) beside
# sagitta's own `perf_search_latency` (tests/perf/search_latency.c, which
# links the C editor in-process; built in the oracle tree), on the same
# buffer size and CPUs, and the port/C ratio of each line:
#
#   tools/run-perf-search [--taskset 0-3] [--bytes N] [--reps N]
#
#   perf-search: <metric> C=<n> wolf=<n> ratio=<x.xx>
#
#   keypress_p99   the eight `ZQNEEDLE` prefixes' worst compile+refresh
#   step_mean      1,000 `n` steps through `compute_value`
#   overlay_rss    the resident high-water mark's growth (bytes)
#
# C's limits file is tests/perf/component-limits.txt at the pin; a C line
# over its limit is C's own verdict, printed as it prints it. The bytes
# default to 104,857,600 here (sagitta's default is 1 GiB:
# YEW_SEARCH_LATENCY_BYTES; pass --bytes 1073741824 on the record rig).
# Exit 0 but on a harness fault (2): the ratios are a FINDING for the
# note (the 2x gate is the lane's to record).
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
pin=
bytes=104857600
reps=50
while [ $# -gt 0 ]; do
    case "$1" in
    --taskset) pin=$2; shift 2 ;;
    --bytes) bytes=$2; shift 2 ;;
    --reps) reps=$2; shift 2 ;;
    *) echo "run-perf-search: unknown option $1" >&2; exit 2 ;;
    esac
done
run() { if [ -n "$pin" ]; then taskset -c "$pin" "$@"; else "$@"; fi; }
export YEW_LOG=/dev/null
# C's perf harnesses refuse to run outside make without the runtime dir.
export YEW_RUNTIME_DIR="$YEW_ROOT/target/oracle/sagitta/runtime"
tree=$YEW_ROOT/target/oracle/sagitta
c=$tree/build/perf_search_latency
if [ ! -x "$c" ]; then
    echo "run-perf-search: $c is not built (tools/oracle's targets must list build/perf_search_latency)" >&2
    exit 2
fi
if [ "${PERF_PREBUILT:-0}" != 1 ]; then
    tools/build-perf-search >/dev/null
fi
out=$YEW_ROOT/target/perf-search
mkdir -p "$out"
(cd "$tree" && YEW_SEARCH_LATENCY_BYTES=$bytes run "$c" --baseline tests/perf/component-limits.txt) >"$out/c.txt" 2>&1 || true
YEW_SEARCH_LATENCY_BYTES=$bytes run target/tools/perf-search --reps="$reps" >"$out/wolf.txt" 2>&1 || {
    cat "$out/wolf.txt" >&2
    exit 2
}
cat "$out/c.txt"
cat "$out/wolf.txt"
num() { awk -v k="$1" '$1 == k { print $2; exit }' "$2"; }
for m in keypress_p99 step_mean overlay_rss; do
    cv=$(num "search.$m" "$out/c.txt")
    wv=$(num "search.$m" "$out/wolf.txt")
    if [ -z "$cv" ] || [ -z "$wv" ]; then
        echo "run-perf-search: $m missing (C=$cv wolf=$wv)" >&2
        exit 2
    fi
    awk -v m="$m" -v c="$cv" -v w="$wv" 'BEGIN { r = (c > 0) ? w / c : 0; printf "perf-search: %s C=%d wolf=%d ratio=%.2f\n", m, c, w, r }'
done
