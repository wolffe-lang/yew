#!/usr/bin/env bash
# torture-live — the live-editor torture lane (yw04, deliverable 6;
# R-yw02-1 = A): sagitta's `kill9` driver with its fault shim over the
# port's LIVE editor, then the port's replica for the lanes the driver
# does not run (the 500 external SIGKILLs; the determinism lane with a
# state home per run).
#
#   tools/torture-live --yew BIN [--iters N]
#
# Run it inside a container (sprints/RULES.md §5): the driver and the
# replica SIGKILL their own children.
#
# 1. The driver (`tests/torture/kill9.c` with `YEW_TORTURE_LANE=
#    live-editor`, as `tools/goldens --suite torture` runs it): sagitta's
#    `yew-live-torture` opens the editor on a PTY, types `Ndd`, a
#    bracketed paste, `s` and `:ed.quit_force\r` (`yew-live-torture.c:
#    181-219`), arming the shim with SIGUSR2 before the save. The port's
#    binary stays dynamically linked so `LD_PRELOAD` reaches it. The lanes
#    run in order and stop at the first red (`kill9.c:1159-1203`): the
#    clean save, the atomic sweeps at four seeds, the hard-link sweep,
#    EINTR, ENOSPC and the determinism order must all hold — since the
#    0.2.34 pin the save syncs (G3, wolf-lang#796), so G3's KNOWN-RED
#    acceptance is gone (yw05).
# 2. The replica (`tools/torture-replica.py --live`): the determinism lane
#    again and the 500 external SIGKILLs the driver never reaches, every
#    one old-or-new with the journal recovering. The determinism lane runs
#    with kill9's one shared state home and must reproduce exactly: since
#    yw06 the port's `:` history is per workspace as C's is (s25 §8,
#    `cmdline_hist` scoped by the workspace key), so the second run no
#    longer sees the first's history append. Until yw06 it did, and this
#    lane accepted that one difference by name (KNOWN-RED, seen red at
#    yew run 39892355530's oracle job: "determinism same seed, same log:
#    NO") after a second run with a state home per run; both are gone.
set -u
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$YEW_ROOT"
bin=
iters=500
while [ $# -gt 0 ]; do
  case $1 in
    --yew) bin=$2; shift 2 ;;
    --iters) iters=$2; shift 2 ;;
    *) echo "torture-live: unknown argument $1" >&2; exit 2 ;;
  esac
done
[ -n "$bin" ] || { echo "usage: tools/torture-live --yew BIN [--iters N]" >&2; exit 2; }
case $bin in /*) ;; *) bin=$YEW_ROOT/$bin ;; esac
tree=$YEW_ROOT/target/oracle/sagitta
b=$tree/build
for f in "$b/kill9" "$b/yew-live-torture" "$b/yew-torture" "$b/tests/torture/faultshim.so" "$bin"; do
  [ -x "$f" ] || [ -f "$f" ] || { echo "torture-live: missing $f (tools/oracle builds the torture binaries)" >&2; exit 2; }
done
out=$YEW_ROOT/target/tests/torture-live
mkdir -p "$out"
export YEW_TORTURE_CHECKER=$b/yew-torture YEW_TORTURE_YEW=$bin YEW_RUNTIME_DIR=$tree/runtime
echo "torture-live: editor $bin ($(sha256sum "$bin" | cut -c1-12))"

( cd "$tree" && YEW_TORTURE_LANE=live-editor YEW_TORTURE_SIGKILL_ITERS=$iters \
  "$b/kill9" "$b/yew-live-torture" "$b/tests/torture/faultshim.so" ) >"$out/driver.log" 2>&1
drc=$?
sed 's/^/torture-live: driver: /' "$out/driver.log"
ok=1
if [ $drc -eq 0 ]; then
  echo "torture-live: driver GREEN"
else
  echo "torture-live: driver RED (exit $drc)"; ok=0
fi

python3 tools/torture-replica.py --live --child "$b/yew-live-torture" --checker "$b/yew-torture" \
  --shim "$b/tests/torture/faultshim.so" --iters "$iters" --lanes determinism,sigkill >"$out/replica.log" 2>&1
sed 's/^/torture-live: /' "$out/replica.log"
o=$out/replica.log
grep -q "^replica: determinism same seed, same log: yes$" $o ||
  { echo "torture-live: replica's determinism red (same seed, different log)"; ok=0; }
grep -qE "^replica: external-sigkill iterations=$iters attempts=[0-9]+ old=[0-9]+ new=[0-9]+ ok$" $o ||
  { echo "torture-live: external SIGKILL lane red"; ok=0; }
[ "$(grep -c '^replica: determinism run [01]: exit=0 check=1 order=ok ' $o)" = 2 ] ||
  { echo "torture-live: replica's determinism order red"; ok=0; }
if [ $ok = 1 ]; then
  echo "torture-live: GREEN"
  exit 0
fi
echo "torture-live: RED"
exit 1
