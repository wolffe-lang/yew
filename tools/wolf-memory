#!/bin/sh
# Keep the verified real compiler separate; never shadow wolf on PATH.
# $WOLF can reach a caller as a bare path (tools/check-test-cases keeps only
# the path a subshell printed), so when the library's export did not come
# along, find the real compiler the way tools/lib-toolchain.sh found it.
if [ -n "${YEW_MEMORY_REAL_WOLF-}" ]; then
    real=$YEW_MEMORY_REAL_WOLF
elif [ -n "${YEW_ROOT-}" ]; then
    real=${WOLF_BIN:-$YEW_ROOT/.wolf-bin/wolf}
else
    echo "wolf-memory: no YEW_ROOT to find the real compiler from" >&2
    exit 127
fi
if [ ! -x "$real" ] || [ "$real" -ef "$0" ]; then
    echo "wolf-memory: no real compiler at $real" >&2
    exit 127
fi
# Only an explicit build is observed; anything else is the compiler itself.
[ "${1-}" = build ] || exec "$real" "$@"
exec python3 -I "$YEW_ROOT/ci/build-memory.py" wolf "$real" "$@"
