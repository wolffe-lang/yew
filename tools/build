#!/bin/sh
# build — compile yew on one tier or both.
#
# The program is `src/yew.lu` (marked `//! member: false`) over the
# modules under `src/` (`util`, `unicode`, …, one directory each, named
# as sagitta's `src/` directories are). Usage:
#   tools/build [--native|--release|--all|--static]
#   --native   the fast default backend  -> target/native/yew
#   --release  LLVM with the mid-end on  -> target/release/yew
#   --all      both (the default)
#   --static   the release tier linked with `cc -static` (linux)
#                                        -> target/static/yew
#              the shape PAX runs (`pax/tools/mkpelt`): wolf has no
#              `--static`, so a `cc` that adds the flag is put first on
#              PATH for the link. Not part of --all; track rule 7 makes
#              it a CI step from M-YW5.
# Every build denies warnings.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

tiers="native release"
case "${1:-}" in
--native) tiers=native ;;
--release) tiers=release ;;
--all | "") ;;
--static) tiers=static ;;
*)
    echo "build: unknown option $1" >&2
    exit 2
    ;;
esac

for tier in $tiers; do
    mkdir -p "target/$tier"
    if [ "$tier" = static ]; then
        real=$(command -v cc)
        mkdir -p target/static/bin
        printf '#!/bin/sh\nexec %s -static "$@"\n' "$real" >target/static/bin/cc
        chmod +x target/static/bin/cc
        PATH="$YEW_ROOT/target/static/bin:$PATH" \
            "$WOLF" build --release --no-cache --deny-warnings src/yew.lu -o target/static/yew
    elif [ "$tier" = release ]; then
        "$WOLF" build --release --deny-warnings src/yew.lu -o "target/$tier/yew"
    else
        "$WOLF" build --deny-warnings src/yew.lu -o "target/$tier/yew"
    fi
    echo "build: target/$tier/yew"
done
