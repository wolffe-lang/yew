#!/usr/bin/env python3
"""Emit the pinned builtin registry/detection DATA, not a tokenizer.

    tools/gen-syn-registry ORACLE/src/syn/langs_gen.c

The checked-in C generated table is the source of truth. Refuse a partial
parse: all 48 identities and the existing detection-index arrays are owned.
"""
from pathlib import Path
import re
import sys


def quote(value):
    return value.replace('\\', '\\\\').replace('"', '\\"').replace('{', '{{').replace('}', '}}').replace('\t', '\\t')


def generate(path):
    text = Path(path).read_text()
    pattern = r'\{\s*(\d+)U,\s*"([^"\\]+)",\s*"(runtime/syntax/[^"\\]+\.fl)",(?:[^{}]|\{[^{}]*\})*?,\s*(-?\d+),\s*\{'
    rows = re.findall(pattern, text)
    if len(rows) != 48 or [int(r[0]) for r in rows] != list(range(1, 49)):
        raise ValueError('builtin registry parse did not yield ids 1..48')
    if len({r[1] for r in rows}) != 48 or len({r[2] for r in rows}) != 48:
        raise ValueError('duplicate builtin identity or path')
    out = ['//! syn.builtin_data — GENERATED from pinned sagitta src/syn/langs_gen.c.',
           '//! tools/gen-syn-registry owns this complete 48-language index.', '']

    def emit(name, items, doc):
        out.extend(['/// ' + doc, 'pub const ' + name + ': str = "' +
                    '\\n'.join(quote(s) for s in items) + '\\n"', ''])

    emit('SYN_BUILTINS', [f'{i} {n} {priority} {p}' for i, n, p, priority in rows],
         'Stable id, name, priority and source path, in builtin-id order.')
    for kind, dest in [('extensions', 'SYN_BUILTIN_EXTENSIONS'),
                       ('filenames', 'SYN_BUILTIN_FILENAMES'),
                       ('shebangs', 'SYN_BUILTIN_SHEBANGS')]:
        items = []
        for i, _, _, _ in rows:
            found = re.search(r'static const char \*const lang_' + i + '_' + kind +
                              r'\[\] = \{(.*?)\};', text, re.S)
            values = re.findall(r'"((?:[^"\\]|\\.)*)"', found[1]) if found else []
            if any(',' in v or '\\' in v for v in values):
                raise ValueError(kind + ' value needs a different row encoding')
            items.append(i + '\t' + ','.join(values))
        emit(dest, items, 'Each builtin\'s ' + kind + ' in seed order, by id; comma-separated.')
    for source, dest, split in [('builtin_exact', 'SYN_DETECT_EXACT', False),
                                ('builtin_extensions', 'SYN_DETECT_EXTENSIONS', False),
                                ('builtin_globs', 'SYN_DETECT_GLOBS', True),
                                ('builtin_shebangs', 'SYN_DETECT_SHEBANGS', False),
                                ('builtin_first_lines', 'SYN_DETECT_FIRST_LINES', False)]:
        found = re.search(r'static const SynDetectEntry ' + source + r'\[\] = \{(.*?)\n\};', text, re.S)
        if not found:
            raise ValueError('missing detection array ' + source)
        entries = re.findall(r'\{"((?:[^"\\]|\\.)*)", (\d+)U, (\d+)U, (\d+)U\}', found[1])
        items = []
        for key, language, length, cut in entries:
            if int(language) == 0:
                continue
            if not 1 <= int(language) <= 48:
                raise ValueError('detection id outside registry')
            # C literals here are generated ASCII. Decode their escapes once;
            # the Wolf literal encoder below then owns the output spelling.
            decoded = bytes(key, 'ascii').decode('unicode_escape')
            if any(c in decoded for c in '\r\n\t'):
                raise ValueError('detection key needs a different row encoding')
            items.append(f'{decoded}\t{cut}\t{language}' if split else f'{decoded}\t{language}')
        emit(dest, items, source + ' in the oracle order; tab-separated fields.')
    return '\n'.join(out).rstrip() + '\n'


if __name__ == '__main__':
    if len(sys.argv) != 2:
        raise SystemExit('usage: gen-syn-registry ORACLE/src/syn/langs_gen.c')
    try:
        sys.stdout.write(generate(sys.argv[1]))
    except (OSError, ValueError) as error:
        raise SystemExit('gen-syn-registry: ' + str(error))
