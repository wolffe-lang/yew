#!/bin/sh
# build-fuzz-re — the regex engine's fuzz driver, tools/fuzz-re/main.lu
# (the port of sagitta's fuzzlib.c loop with fuzz_re_compile.c,
# fuzz_re_diff.c + re_ref.c and fuzz_re_quote.c), built on the release
# tier into target/tools/fuzz-re.
#
#   tools/build-fuzz-re [--native]
#
# `use search` resolves beside the ENTRY file (D32), so the port's
# modules are staged beside a copy under target/fuzz-re/, as
# tools/build-fuzz-textbuf stages its driver. Nothing there is committed.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

tier=release
case "${1:-}" in
"") ;;
--native) tier=native ;;
*)
    echo "build-fuzz-re: unknown option $1" >&2
    exit 2
    ;;
esac

stage=$YEW_ROOT/target/fuzz-re
rm -rf "$stage"
mkdir -p "$stage" target/tools
cp tools/fuzz-re/main.lu "$stage/main.lu"
for m in util unicode term text search; do
    cp -R "src/$m" "$stage/$m"
    rm -f "$stage/$m"/*_test.lu
done
if [ "$tier" = release ]; then
    "$WOLF" build --release --deny-warnings "$stage/main.lu" -o target/tools/fuzz-re
else
    "$WOLF" build --deny-warnings "$stage/main.lu" -o target/tools/fuzz-re
fi
echo "build-fuzz-re: target/tools/fuzz-re ($tier)"
