//! fuzz-state — Sprint 25's state fuzz: the port of sagitta
//! `tests/fuzz/fuzz_state.c` (418 lines) over the generator of
//! `tests/fuzz/fuzzlib.c` (`yew_fuzz_main`) at 9ace98c2, which
//! `tools/fuzzgen` ports C's bit for bit — with fuzz_state's dictionary
//! (`tests/fuzz/dict/fuzz_state.txt`, copied verbatim) as the eleventh
//! mutator — so a seed's `hash=` is C's for the same seed and iterations,
//! the witness that the port ran C's cases.
//!
//! The check is C's `run_session` (`fuzz_state.c:363-414`): the case's
//! raw bytes, then 24 rounds of a frozen corpus document mutated to break
//! STRUCTURE (`mutate`, `:153-260`: a byte, a truncation, a deleted or
//! duplicated run, every `}` or `]` dropped, a second document spliced
//! in, a 1-64 deep `{ a: ` prefix, a 4,000-4,399-byte string, NULs),
//! the round RNG C's LCG seeded from the case's bytes. Each document goes
//! through the parser — a tree inside the caps (8 MiB, a million nodes,
//! depth 32, 4,096-byte strings) or a rejection with a line — and through
//! the SCHEMA layer on a fresh editor (`run_one`, `:296-361`): the result
//! is a `YewWsResult`, a tab is left, no quit, a pane tree and a window.
//! The parser is the port's hand codec (R-yw06-1 = A: C's shipping path
//! is Sprint 36's Fletch reader, the same frozen format). A failure is a
//! `FAIL` line naming the case and the hex input, exit 1, as C's.
//!
//! One divergence, which no report line sees: C loads its 32 seeds in
//! `readdir` order (`seeds_load_dir`, `:85-128`), so WHICH of the 45
//! small corpus documents fill the 32 slots is the filesystem's choice;
//! the port takes them name-sorted (determinism, CLAUDE.md). The `hash=`
//! covers only the generator's cases, never the seeds' order.
//!
//!   fuzz-state [--iters=N] [--seed=N]
//!
//! Defaults are C's (`--iters=200000 --seed=1`, Makefile:2264; s25 §DoD
//! 12 asks 100,000 cases at four seeds: `tools/run-fuzz-state
//! --campaign`). One region a case: its editors die with it (G33).

use edit
use fuzzgen
use util
use ws

const EPOCH: int = 64

// `FZ_MAX_SEEDS`, `FZ_SEED_MAX_BYTES` (`fuzz_state.c:79-82`).
const FZ_MAX_SEEDS: int = 32

const FZ_SEED_MAX_BYTES: int = 65536

// `FZ_CORPUS_DIR` (`fuzz_state.c:49`).
const FZ_CORPUS_DIR: str = "tests/unit/fixtures/wsstate/v1"

// `rng_next` (`fuzz_state.c:55-59`): C's LCG, the top 31 bits.
fn rng_next(mut seed: wrapping[u64]) -> int {
    seed = seed * 6364136223846793005 + 1442695040888963407
    (seed >> 33) as int
}

// `rng_below` (`fuzz_state.c:61-64`).
fn rng_below(mut seed: wrapping[u64], n: int) -> int {
    if n == 0 then 0 else rng_next(mut seed) % n
}

fn append(mut out: List[byte], src: List[byte], lo: int, hi: int) {
    var i = lo
    while i < hi {
        (mut out).push(src[i])
        i += 1
    }
}

// wolf 0.2.35 admits this cross-module closure (G20, wolf-lang#806).
fn sort_names(mut names: List[str]) {
    util.sort_stable(mut names, fn(a: str, b: str) a < b)
}

// `seeds_load` (`fuzz_state.c:85-140`): the frozen corpus's three
// directories, each `.fl` of 1..64 KiB, at most 32 (name-sorted: see the
// header).
fn seeds_load() -> List[List[byte]] {
    var seeds = List[List[byte]]()
    for dir in [FZ_CORPUS_DIR, "{FZ_CORPUS_DIR}/noncanonical", "{FZ_CORPUS_DIR}/invalid"] {
        var names = fs_read_dir(dir) else List[str]()
        sort_names(mut names)
        for name in names {
            if seeds.len >= FZ_MAX_SEEDS { break }
            if name.len < 4 || !name.ends_with(".fl") { continue }
            let bytes = fs_read_bytes("{dir}/{name}") else List[byte]()
            if bytes.len == 0 || bytes.len > FZ_SEED_MAX_BYTES { continue }
            (mut seeds).push(bytes)
        }
    }
    seeds
}

// `mutate` (`fuzz_state.c:153-260`).
fn mutate(mut rng: wrapping[u64], seed: List[byte], seeds: List[List[byte]]) -> List[byte] {
    let kind = rng_below(mut rng, 9)
    let n = seed.len
    var out = List[byte]()
    if n == 0 { return out }
    match kind {
        0 => {
            out = copy seed
            let at = rng_below(mut rng, n)
            out[at] = rng_below(mut rng, 256) as byte
        },
        1 => {
            let at = rng_below(mut rng, n)
            append(mut out, seed, 0, at)
        },
        2 => {
            let at = rng_below(mut rng, n)
            append(mut out, seed, 0, at)
            let skip = 1 + rng_below(mut rng, 32)
            if at + skip < n { append(mut out, seed, at + skip, n) }
        },
        3 => {
            let at = rng_below(mut rng, n)
            append(mut out, seed, 0, at)
            let want = 1 + rng_below(mut rng, 64)
            let run = if at + want > n then n - at else want
            append(mut out, seed, at, at + run)
            append(mut out, seed, at, at + run)
            append(mut out, seed, at, n)
        },
        4 => {
            let drop = if rng_below(mut rng, 2) != 0 then 125 else 93
            for b in seed {
                if b as int != drop { (mut out).push(b) }
            }
        },
        5 => {
            let at = rng_below(mut rng, n)
            append(mut out, seed, 0, at)
            if seeds.len > 0 {
                let j = rng_below(mut rng, seeds.len)
                append(mut out, seeds[j], 0, seeds[j].len)
            }
            append(mut out, seed, at, n)
        },
        6 => {
            let depth = 1 + rng_below(mut rng, 64)
            for _ in 0..depth { append(mut out, "{{ a: ".bytes(), 0, 5) }
            append(mut out, seed, 0, n)
        },
        7 => {
            let len = 4000 + rng_below(mut rng, 400)
            append(mut out, "{{ version: 1, path: \"".bytes(), 0, 21)
            for i in 0..len { (mut out).push((97 + i % 26) as byte) }
            append(mut out, "\", }}\n".bytes(), 0, 5)
        },
        _ => {
            out = copy seed
            let hits = 1 + rng_below(mut rng, 8)
            for _ in 0..hits {
                let at = rng_below(mut rng, n)
                out[at] = 0 as byte
            }
        },
    }
    out
}

// A failure as numbers, so nothing a region allocates outlives it
// (E1010): the code names C's `why` (`fuzz_state.c:271-414`), `detail`
// its number; `why_text` spells it outside the regions.
const WHY_OK: int = 0

const WHY_NODES: int = 1

const WHY_DEPTH: int = 2

const WHY_STRING: int = 3

const WHY_NO_LINE: int = 4

const WHY_RESULT: int = 5

const WHY_NO_TABS: int = 6

const WHY_QUIT: int = 7

const WHY_NO_PANES: int = 8

const WHY_SEEDS: int = 9

fn why_text(code: int, detail: int) -> str {
    match code {
        1 => "tree exceeds the node cap",
        2 => "tree exceeds depth {ws.FL_MAX_DEPTH}",
        3 => "string of {detail} bytes past the cap",
        4 => "rejected without a line number",
        5 => "result {detail} is not a YewWsResult",
        6 => "no tabs left after apply",
        7 => "apply asked the editor to quit",
        8 => "apply left no pane tree or window",
        9 => "only {detail} corpus seeds loaded from {FZ_CORPUS_DIR} (run from the repo root)",
        _ => "",
    }
}

// `tree_within_caps` (`fuzz_state.c:271-293`), over an explicit stack
// (G41).
fn tree_within_caps(doc: ws.FlDoc) -> (int, int) {
    if doc.nodes.len > ws.FL_MAX_NODES { return (WHY_NODES, 0) }
    var nodes = List[int]()
    var depths = List[int]()
    (mut nodes).push(doc.root)
    (mut depths).push(0)
    while nodes.len > 0 {
        let n = (mut nodes).pop() else -1
        let depth = (mut depths).pop() else -1
        if n < 0 { return (WHY_NODES, 0) }
        if depth > ws.FL_MAX_DEPTH { return (WHY_DEPTH, depth) }
        if doc.nodes[n].kind == ws.FL_STR && doc.nodes[n].text.len > ws.FL_MAX_STRING {
            return (WHY_STRING, doc.nodes[n].text.len)
        }
        for child in doc.nodes[n].items {
            (mut nodes).push(child)
            (mut depths).push(depth + 1)
        }
    }
    (WHY_OK, 0)
}

// `run_one` (`fuzz_state.c:296-361`): one document through the parser and
// the schema layer on a fresh editor.
fn run_one(bytes: List[byte]) -> (int, int) {
    let parsed = ws.fl_parse(bytes, 0, bytes.len)
    if parsed.ok {
        let (code, detail) = tree_within_caps(parsed.doc)
        if code != WHY_OK { return (code, detail) }
    } else if parsed.err.line == 0 && bytes.len != 0 {
        return (WHY_NO_LINE, 0)
    }
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    let r = edit.state_apply(mut ed, bytes)
    var code = WHY_OK
    if r != edit.WS_FRESH && r != edit.WS_RESTORED && r != edit.WS_RECOVERED {
        code = WHY_RESULT
    } else if ed.tabs.len < 1 {
        code = WHY_NO_TABS
    } else if ed.quit {
        code = WHY_QUIT
    } else if ed.win < 0 || !edit.pane_live(ed, ed.pane_root) {
        code = WHY_NO_PANES
    }
    edit.state_dispose(mut ed)
    (code, r)
}

// `run_session` (`fuzz_state.c:363-414`).
fn run_session(data: List[byte], seeds: List[List[byte]]) -> (int, int) {
    if seeds.len < 20 {
        return (WHY_SEEDS, seeds.len)
    }
    var rng: wrapping[u64] = 0x9E3779B97F4A7C15
    for b in data { rng = rng * 31 + b as int as wrapping[u64] }
    var code = WHY_OK
    var detail = 0
    region raw {
        let (c, d) = run_one(data)
        code = c
        detail = d
    }
    if code != WHY_OK { return (code, detail) }
    var i = 0
    while i < 24 {
        let j = rng_below(mut rng, seeds.len)
        region mutated {
            let bytes = mutate(mut rng, seeds[j], seeds)
            if bytes.len <= ws.FL_MAX_BYTES {
                let (c, d) = run_one(bytes)
                code = c
                detail = d
            }
        }
        if code != WHY_OK { return (code, detail) }
        i += 1
    }
    (WHY_OK, 0)
}

fn main() -> int {
    let (ok, seed, iters) = fuzzgen.parse_args(env_args())
    if !ok {
        eprint("usage: fuzz-state [--seed=N] [--iters=N]")
        return 2
    }
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let (cok, corpus, dict) = fuzzgen.corpus_dict_for("fuzz_state")
    if !cok {
        return 2
    }
    let seeds = seeds_load()
    let start = fuzzgen.run_new(seed)
    var state = start.state
    var hash = start.hash
    var done = 0
    var failed = false
    while done < iters && !failed {
        let n = if iters - done > EPOCH then EPOCH else iters - done
        region epoch {
            var r = fuzzgen.Run { state: state, hash: hash }
            var k = 0
            while k < n {
                let which = fuzzgen.choose(mut r, corpus.len)
                var input = copy corpus[which].bytes
                let mutations = 1 + fuzzgen.choose(mut r, 4)
                var op = 0
                var m = 0
                while m < mutations {
                    let (next, o) = fuzzgen.mutate_dict(mut r, input, corpus, dict)
                    input = next
                    op = o
                    m += 1
                }
                fuzzgen.hash_bytes(mut r, input)
                var code = WHY_OK
                var detail = 0
                region session {
                    let (c, d) = run_session(input, seeds)
                    code = c
                    detail = d
                }
                if code != WHY_OK {
                    eprint(
                        "fuzz_state: FAIL seed={seed} iter={done + k} corpus={corpus[which].name} op={fuzzgen.op_name(op)}: {why_text(code, detail)}",
                    )
                    eprint("fuzz_state: input={fuzzgen.hex_of(input)}")
                    failed = true
                    break
                }
                k += 1
            }
            state = r.state
            hash = r.hash
        }
        done += n
    }
    if failed {
        return 1
    }
    print("fuzz_state: seed={seed} iters={iters} corpus={corpus.len} hash={fuzzgen.hex16(hash)} ok")
    0
}
