#!/usr/bin/env python3
"""check-staged-modules: every harness that stages its own source tree
(`for m in … ; do cp -R "src/$m" …`) copies every module the staged
modules import, transitively.

A harness builds `main.lu` beside copies of chosen `src/<module>/` trees, so
a module that a staged one imports but the list leaves out fails the
harness's `wolf build` with E0301 ("there is no module named X"). yw13's
`git` module did that to build-demo, build-fuzz-cmdparse, build-fuzz-search,
build-perf-search and run-perf-cmdcomp (yew#102's run 41500851220). This
reads each list, follows `use M` lines through `src/M/*.lu` (std's own
`use std…` aside), and names any module the closure needs and the list
lacks.

A harness's fixture is held the same way: a test that copies
`tools/<harness>` into a scratch root and makes the `src/<module>`
directories the harness copies (`for module in ("util", …):` beside
`"src" / module`) must make every module the harness's lists stage, or
the harness's `cp -R "src/$m"` fails before the behaviour under test.
`tools/check-perf-cmdcomp-build`'s fixture lacked `git` once ce71e59 put
it in `tools/run-perf-cmdcomp`'s list (yew#102's run 41555906630: `cp:
cannot stat 'src/git'`).

  tools/check-staged-modules            the harnesses under tools/
  tools/check-staged-modules --selftest a list or a fixture missing a module is refused
"""
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parent.parent
LIST = re.compile(r'^\s*for m in ([a-z_ ]+); do\s*$', re.M)
COPY = re.compile(r'cp -R "src/\$m"')
USE = re.compile(r'^use ([a-z_]+)', re.M)
FIXTURE = re.compile(r'for module in \(([^)]*)\):')
FIXTURE_DIR = re.compile(r'"src" / module')
HARNESS = re.compile(r'copyfile\(ROOT / "tools/([A-Za-z0-9_.-]+)"')


def modules():
    return {p.name for p in (ROOT / "src").iterdir() if p.is_dir()}


def imports(mod, known):
    out = set()
    for f in sorted((ROOT / "src" / mod).glob("*.lu")):
        if f.name.endswith("_test.lu"):
            continue
        for m in USE.findall(f.read_text(encoding="utf-8")):
            if m in known:
                out.add(m)
    return out


def closure(staged, known):
    need, todo = set(staged), list(staged)
    while todo:
        m = todo.pop()
        for d in imports(m, known):
            if d not in need:
                need.add(d)
                todo.append(d)
    return need


def lists(text):
    found = []
    for m in LIST.finditer(text):
        tail = text[m.end():m.end() + 200]
        if COPY.search(tail):
            found.append(m.group(1).split())
    return found


def check(name, text, known):
    bad = []
    for staged in lists(text):
        missing = sorted(closure(staged, known) - set(staged))
        if missing:
            bad.append(f"{name}: stages {' '.join(staged)} but not {', '.join(missing)}")
    return bad


def fixtures(text):
    """Each fixture's module tuple, when the src/<module> mkdir follows it."""
    found = []
    for m in FIXTURE.finditer(text):
        if FIXTURE_DIR.search(text[m.end():m.end() + 200]):
            found.append(re.findall(r'"([a-z_]+)"', m.group(1)))
    return found


def check_fixture(name, text, harness_text):
    """A fixture tree must hold every module the harness it copies stages."""
    bad = []
    want = set()
    for staged in lists(harness_text):
        want |= set(staged)
    for made in fixtures(text):
        missing = sorted(want - set(made))
        if missing:
            bad.append(f"{name}: its fixture tree makes {' '.join(made)} but its harness stages {', '.join(missing)} too")
    return bad


def main(argv):
    known = modules()
    if argv[1:] == ["--selftest"]:
        plant = 'for m in util unicode term text search ws fl edit; do\n    cp -R "src/$m" "$stage/$m"\ndone\n'
        whole = sorted(closure(["edit"], known))
        good = "for m in " + " ".join(whole) + '; do\n    cp -R "src/$m" "$stage/$m"\ndone\n'
        if not check("plant", plant, known):
            print("check-staged-modules: selftest: a list without git was let be")
            return 1
        if check("good", good, known):
            print("check-staged-modules: selftest: the full closure was refused")
            return 1
        harness = "    for m in " + " ".join(whole) + '; do\n        cp -R "src/$m" "$stage/$m"\n'
        short = [m for m in whole if m != "git"]
        def fixture(mods):
            return ('shutil.copyfile(ROOT / "tools/run-x", root / "tools/run-x")\n'
                    "    for module in (" + ", ".join('"%s"' % m for m in mods) + "):\n"
                    '        (root / "src" / module).mkdir(parents=True)\n')
        if not check_fixture("plant", fixture(short), harness):
            print("check-staged-modules: selftest: a fixture without git was let be")
            return 1
        if check_fixture("good", fixture(whole), harness):
            print("check-staged-modules: selftest: a fixture making every staged module was refused")
            return 1
        print("check-staged-modules: selftest: the list and the fixture without git refused, the closures let be")
        return 0
    bad, n, nf = [], 0, 0
    for path in sorted((ROOT / "tools").iterdir()):
        if not path.is_file():
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        found = lists(text)
        n += len(found)
        bad += check(f"tools/{path.name}", text, known)
        for h in HARNESS.findall(text):
            # this file's own selftest plants carry the pattern as text
            if path.name == "check-staged-modules" or not fixtures(text):
                continue
            nf += len(fixtures(text))
            harness_text = (ROOT / "tools" / h).read_text(encoding="utf-8")
            bad += check_fixture(f"tools/{path.name}", text, harness_text)
    for line in bad:
        print("check-staged-modules: RED " + line)
    if bad:
        return 1
    print(f"check-staged-modules: ok ({n} staged lists, every import closed; {nf} fixture trees, every staged module made)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
