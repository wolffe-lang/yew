//! perf-unicode — campaign 00's performance gate, the port's half.
//!
//! Ports sagitta `tests/perf/perf_unicode.c` (260 lines) at 9ace98c2:
//! segment + width over 1 MiB each of ASCII (`a`), CJK (U+6F22) and
//! emoji (the ZWJ family, 25 bytes), the same scan (`scan`, lines
//! 62-140: `gb_boundary` per codepoint with the ASCII fast path,
//! `cluster_width` per cluster, counts and cells summed), best of seven
//! rounds, one line per case in sagitta's shape:
//!
//!   unicode-perf: <name> bytes=N clusters=N cells=N best_us=N
//!
//! The ASCII megabyte's budget is 5 ms in sagitta (`s02` DoD 11, a
//! keypress budget); here every number is RECORDED and the ratio to C
//! yew's own `perf_unicode` from the same run is the finding
//! (`tools/perf-unicode`, the wrapper, prints both). Ruling #89 R3: 2x
//! is the gate from the first paint, and the ratio ratchets by ruling.
//!
//! `use unicode` resolves under the entry's directory (D32), so the
//! wrapper (`tools/run-perf-unicode`) copies `src/unicode` beside a copy
//! of this file under target/perf/ before building; nothing there is
//! committed. The clock is milliseconds, so a round is a batch of scans
//! (`measure`).

use std.time
use unicode

struct PerfCase {
    name: str,
    pattern: List[byte],
    data: List[byte],
    clusters: int,
    cells: int,
    best_ns: int,
}

fn bytes_of(xs: List[int]) -> List[byte] {
    var out = List[byte]()
    for x in xs {
        (mut out).push(x as byte)
    }
    out
}

fn prepare(mut pc: PerfCase) {
    let corpus_min = 1024 * 1024
    let repeats = (corpus_min + pc.pattern.len - 1) / pc.pattern.len
    var data = List[byte]()
    var i = 0
    while i < repeats {
        for b in pc.pattern {
            (mut data).push(b)
        }
        i += 1
    }
    pc.data = data
}

/// sagitta's `scan`: clusters and cells over `s`, with the ASCII fast
/// path (a printable byte after an Other is its own cluster of one cell
/// without a width lookup).
fn scan(s: List[byte]) -> (int, int) {
    let len = s.len
    var state = unicode.gb_init()
    var pos = 0
    var cluster_start = 0
    var count = 0
    var width = 0
    var have_cluster = false
    var simple_ascii = false
    while pos < len {
        let b = s[pos] as int
        if state.prev_gcb == unicode.GCB_OTHER && b >= 32 && b <= 126 {
            if have_cluster {
                width += if simple_ascii then 1 else unicode.cluster_width(s, cluster_start, pos)
                count += 1
            }
            let boundary = unicode.gb_boundary(mut state, b)
            assert(boundary, "perf: an ASCII byte after Other is a boundary")
            cluster_start = pos
            have_cluster = true
            simple_ascii = true
            pos += 1
            continue
        }
        let (cp, used) = unicode.utf8_decode(s, pos, len)
        assert(used > 0 && used <= len - pos, "perf: decode progresses")
        let boundary = unicode.gb_boundary(mut state, cp)
        if boundary && have_cluster {
            width += if simple_ascii then 1 else unicode.cluster_width(s, cluster_start, pos)
            count += 1
        }
        if boundary {
            cluster_start = pos
        }
        simple_ascii = false
        have_cluster = true
        pos += used
    }
    if have_cluster {
        width += if simple_ascii then 1 else unicode.cluster_width(s, cluster_start, len)
        count += 1
    }
    (count, width)
}

/// Best of seven rounds, as sagitta; a round is BATCH scans because the
/// clock is milliseconds (`std.time`, `clock_ms`): `best_ns` is the best
/// round divided by BATCH, a resolution of a millisecond over BATCH.
const BATCH: int = 32

fn measure(mut pc: PerfCase) {
    let (clusters, cells) = scan(pc.data)
    pc.clusters = clusters
    pc.cells = cells
    pc.best_ns = -1
    var round = 0
    while round < 7 {
        let start = time.now()
        var k = 0
        while k < BATCH {
            let (c, w) = scan(pc.data)
            assert(c == pc.clusters && w == pc.cells, "perf: a scan agrees with the first")
            k += 1
        }
        let elapsed = time.as_millis(time.elapsed(start)) * 1000000 / BATCH
        if pc.best_ns < 0 || elapsed < pc.best_ns {
            pc.best_ns = elapsed
        }
        round += 1
    }
}

fn run_case(name: str, pattern: List[int]) {
    var pc = PerfCase {
        name: name,
        pattern: bytes_of(pattern),
        data: List[byte](),
        clusters: 0,
        cells: 0,
        best_ns: 0,
    }
    prepare(mut pc)
    measure(mut pc)
    print(
        "unicode-perf: {pc.name} bytes={pc.data.len} clusters={pc.clusters} cells={pc.cells} best_us={pc.best_ns / 1000}",
    )
}

fn main() -> int {
    print("unicode-perf: mode wolf")
    run_case("ascii", [97])
    run_case("cjk", [230, 188, 162])
    run_case(
        "emoji",
        [
            240,
            159,
            145,
            168,
            226,
            128,
            141,
            240,
            159,
            145,
            169,
            226,
            128,
            141,
            240,
            159,
            145,
            167,
            226,
            128,
            141,
            240,
            159,
            145,
            166,
        ],
    )
    0
}
