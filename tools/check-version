#!/usr/bin/env python3
"""yew's version has one source: the package manifest (wolf.pkg) names it, one
constant (src/util/base.lu) holds it for the program, and `--version` prints
it. This row fails when they disagree, and when a second copy of the number
is written anywhere the program, the rows or the workflows could read it.

  tools/check-version [--root DIR] [--yew BIN]
  tools/check-version --print        the manifest's version, nothing else
  tools/check-version --self-test

With --yew it also runs `BIN --version` and requires exactly
`yew <version>` then the modules line.
"""
import argparse
import pathlib
import re
import subprocess
import tempfile

ROOT = pathlib.Path(__file__).resolve().parents[1]
CONST = re.compile(r'^pub const VERSION: str = "([^"]*)"$', re.M)
# A pre-release number in any spelling (a regex's escaped dots included), and
# `yew N.N.N` outside tests, which parse headers of other versions on purpose.
DEV = re.compile(r'[0-9]+(?:\\)?\.[0-9]+(?:\\)?\.[0-9]+-dev')
PRINTED = re.compile(r'\byew [0-9]+\.[0-9]+\.[0-9]+')
MODULES = 'modules: lsp ai fuss plugins\n'
SKIP_DIRS = {'.git', 'notes', 'target', 'ucd', 'fuzz', 'oracle-vt', 'divergences', 'fixtures'}


def manifest_version(root):
    text = re.sub(r'//[^\n]*', '', (root / 'wolf.pkg').read_text())
    fields = re.findall(r'\bversion\s*:\s*"([^"]*)"', text)
    if len(fields) != 1:
        raise SystemExit('FAIL version-manifest-field-count %d' % len(fields))
    return fields[0]


def source_version(root):
    found = CONST.findall((root / 'src/util/base.lu').read_text())
    if len(found) != 1:
        raise SystemExit('FAIL version-constant-count %d' % len(found))
    return found[0]


def files(root):
    for path in sorted(root.rglob('*')):
        rel = path.relative_to(root)
        if not path.is_file() or SKIP_DIRS & set(rel.parts) or rel.as_posix() in (
                'tools/check-version', 'src/util/base.lu', 'CHANGELOG.md'):
            continue
        if path.suffix in ('.golden', '.json', '.pyc', '.bytes', '.log'):
            continue
        yield rel, path


def check(root, binary=None):
    manifest = manifest_version(root)
    source = source_version(root)
    if manifest != source:
        raise SystemExit('FAIL version-source-disagree manifest=%s source=%s' % (manifest, source))
    for rel, path in files(root):
        try:
            text = path.read_text()
        except UnicodeDecodeError:
            continue
        if DEV.search(text):
            raise SystemExit('FAIL version-second-literal %s' % rel)
        if not rel.name.endswith('_test.lu') and PRINTED.search(text):
            raise SystemExit('FAIL version-second-literal %s' % rel)
    if binary:
        if not pathlib.Path(binary).is_file():
            raise SystemExit('FAIL version-binary-missing %s' % binary)
        out = subprocess.run([binary, '--version'], capture_output=True, text=True)
        want = 'yew %s\n%s' % (manifest, MODULES)
        if out.returncode != 0 or out.stdout != want:
            raise SystemExit('FAIL version-printed-disagrees manifest=%s printed=%r' % (manifest, out.stdout))
    print('PASS version %s%s' % (manifest, ' printed' if binary else ''))


def tree(base, pkg_version, const_version, extra=''):
    (base / 'src/util').mkdir(parents=True)
    (base / 'tools').mkdir()
    (base / 'wolf.pkg').write_text('pkg { name: "yew", version: "%s", edition: "1" }\n' % pkg_version)
    (base / 'src/util/base.lu').write_text('pub const VERSION: str = "%s"\n' % const_version)
    (base / 'tools/row').write_text(extra)


def self_test():
    def refused(why, **kw):
        with tempfile.TemporaryDirectory() as t:
            base = pathlib.Path(t)
            tree(base, **kw)
            try:
                check(base)
            except SystemExit as e:
                assert why in str(e), (why, e)
                return
            raise AssertionError('not refused: ' + why)
    with tempfile.TemporaryDirectory() as t:
        tree(pathlib.Path(t), '1.2.3', '1.2.3')
        check(pathlib.Path(t))
    refused('version-source-disagree', pkg_version='1.2.4', const_version='1.2.3')
    refused('version-second-literal', pkg_version='1.2.3', const_version='1.2.3', extra="printf 'yew 1.2.3'\n")
    refused('version-second-literal', pkg_version='1.2.3', const_version='1.2.3', extra='grep "1\\.2\\.3-dev"\n')
    with tempfile.TemporaryDirectory() as t:
        base = pathlib.Path(t)
        tree(base, '1.2.3', '1.2.3')
        (base / 'wolf.pkg').write_text('pkg { version: "1.2.3", version: "1.2.3" }\n')
        try:
            check(base)
            raise AssertionError('two fields not refused')
        except SystemExit as e:
            assert 'version-manifest-field-count' in str(e)
    print('PASS version-self-test agree disagree second-literal dev-spelling two-fields')


def main():
    p = argparse.ArgumentParser()
    p.add_argument('--root', type=pathlib.Path, default=ROOT)
    p.add_argument('--yew')
    p.add_argument('--print', action='store_true')
    p.add_argument('--self-test', action='store_true')
    a = p.parse_args()
    if a.self_test:
        self_test()
    elif a.print:
        print(manifest_version(a.root))
    else:
        check(a.root, a.yew)


if __name__ == '__main__':
    main()
