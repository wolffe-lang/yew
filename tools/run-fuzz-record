#!/usr/bin/env bash
# run-fuzz-record — Sprint 35's recorder fuzz: arbitrary recorder events
# (any command id, count, flags, range, mode, source and blob slice) must
# always emit Fletch that parses with no error, neither had_error nor
# incomplete (sagitta tests/fuzz/fuzz_record.c).
#
#   tools/run-fuzz-record [--native] [--against-oracle] [--corpus-only] [--iters=N] [--seed=N]
#
# Builds tools/fuzz-record/main.lu (tools/build-fuzz-record; FUZZ_PREBUILT=1
# runs the driver already built), then the campaign from the repository
# root. The defaults are sagitta's (200,000 iterations, seed 1: `make
# fuzz-record`, Makefile:2372); `--corpus-only` is `make test-record-corpus`
# (Makefile:2401), one exact replay of the corpus. `--against-oracle` also
# runs C's own driver ($SAGITTA_TREE/build/fuzz_record, default
# target/oracle/sagitta, which tools/oracle builds) with the same arguments
# and requires the two report lines to be equal byte for byte; a missing C
# driver is exit 2, never a silent pass.
set -euo pipefail
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
native=; oracle=0; args=()
for a in "$@"; do
    case "$a" in
    --native) native=--native ;;
    --against-oracle) oracle=1 ;;
    --corpus-only|--iters=*|--seed=*) args+=("$a") ;;
    *) echo "run-fuzz-record: unknown argument $a" >&2; exit 2 ;;
    esac
done
tree=${SAGITTA_TREE:-target/oracle/sagitta}
if [ "$oracle" = 1 ] && [ ! -x "$tree/build/fuzz_record" ]; then
    echo "run-fuzz-record: $tree/build/fuzz_record is not built (tools/oracle builds it)" >&2
    exit 2
fi
if [ "${FUZZ_PREBUILT:-0}" != 1 ]; then tools/build-fuzz-record $native; fi
. tools/lib-test-env.sh
test_env_begin
export YEW_RUNTIME_DIR="$YEW_ROOT/runtime"
rc=0
mkdir -p target/fuzz-record
err=target/fuzz-record/driver.stderr
port=$(target/tools/fuzz-record "${args[@]+"${args[@]}"}" 2>"$err") || rc=$?
cat "$err" >&2
echo "port: $port"
[ "$rc" = 0 ] || { echo "run-fuzz-record: the port's driver exited $rc" >&2; exit "$rc"; }
# The hash covers the generated stream, not the check: the tally must show
# the check emitted and parsed events.
tally=$(grep -E '^fuzz_record: inputs=[0-9]+ events=[0-9]+ source_bytes=[0-9]+$' "$err" | tail -1) || true
[ -n "$tally" ] || { echo "run-fuzz-record: the driver printed no tally" >&2; exit 1; }
field() { printf '%s\n' "$tally" | sed -E "s/.* $1=([0-9]+).*/\\1/"; }
inputs=$(field inputs); events=$(field events)
if [ "$inputs" -lt 1 ] || [ "$events" -lt 1 ]; then
    echo "run-fuzz-record: the campaign did not execute its inputs (inputs=$inputs events=$events)" >&2
    exit 1
fi
if [ "$oracle" = 1 ]; then
    c=$(cd "$tree" && build/fuzz_record "${args[@]+"${args[@]}"}") || { echo "C:    $c"; exit 1; }
    echo "C:    $c"
    if [ "$port" != "$c" ]; then
        echo "run-fuzz-record: the port's report differs from C's" >&2
        exit 1
    fi
    echo "PASS: oracle/port report lines identical"
fi
