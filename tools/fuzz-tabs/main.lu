//! fuzz-tabs — Sprint 23's tab oracle (s23 DoD 2): the port of sagitta
//! `tests/fuzz/fuzz_tabs.c` (235 lines) over the generator of
//! `tests/fuzz/fuzzlib.c` (`yew_fuzz_main`) at 9ace98c2, which
//! `tools/fuzzgen` ports C's bit for bit, so a seed's `hash=` is C's for
//! the same seed and iterations — the witness that the port ran the same
//! sessions.
//!
//! The check is C's `run_session` (`fuzz_tabs.c:109-230`): a fresh editor
//! on a scratch buffer, the input's own LCG seeded from its bytes, 80 to
//! 159 operations — open a new path (two weights in five; a refusal at the
//! cap moves nothing), close a random tab, switch to one, or reorder one
//! (an insertion) — against a NAIVE oracle: a plain list of tab ids in
//! visible order and the active position, kept with obvious code that
//! shares nothing with `edit.tabs` (an oracle that calls what it checks
//! proves nothing). The close's survivor is mirrored independently (not
//! the active tab: the active keeps its id; the active one: its right
//! neighbour, else its left). After EVERY operation the two agree on the
//! whole id list AND on which id is active — the half that catches an
//! index kept where an id was needed, which is how facsimile wrote one
//! file's text over another's (`fuzz_tabs.c:1-14`). The one place the
//! oracle uses the implementation is C's: `yew_tab_shifted_index` for the
//! active position after a reorder (`fuzz_tabs.c:216`), which
//! `test_tabs`' exhaustive row checks against a simulation. A trap
//! anywhere is the crash C reports.
//!
//!   fuzz-tabs [--iters=N] [--seed=N]
//!
//! Defaults are C's (`--iters=200000 --seed=1`). One region a session: its
//! editor dies with it (G33).

use edit
use fuzzgen

const EPOCH: int = 4096

struct Rng {
    s: wrapping[u64],
}

// `rng_next` (`fuzz_tabs.c:26-30`): the input's LCG.
fn rng_next(mut r: Rng) -> int {
    r.s = r.s * 6364136223846793005 + 1442695040888963407
    (r.s >> 33) as int
}

// `rng_below` (`fuzz_tabs.c:32-35`).
fn rng_below(mut r: Rng, n: int) -> int {
    if n == 0 {
        return 0
    }
    rng_next(mut r) % n
}

// `Oracle` (`fuzz_tabs.c:37-42`): ids in visible order, and which one is
// active.
struct Oracle {
    id: List[int],
    active: int,
}

// `oracle_insert` (`fuzz_tabs.c:44-54`).
fn oracle_insert(mut o: Oracle, at: int, id: int) {
    if o.id.len >= edit.TAB_MAX {
        return
    }
    (mut o.id).push(0)
    var i = o.id.len - 1
    while i > at {
        o.id[i] = o.id[i - 1]
        i -= 1
    }
    o.id[at] = id
}

// `oracle_remove` (`fuzz_tabs.c:56-63`).
fn oracle_remove(mut o: Oracle, at: int) {
    var i = at
    while i < o.id.len - 1 {
        o.id[i] = o.id[i + 1]
        i += 1
    }
    let _ = (mut o.id).pop()
}

// `oracle_agrees` (`fuzz_tabs.c:65-107`): "" when the editor and the
// oracle agree on the set and the active id, else why.
fn oracle_agrees(ed: edit.Ed, o: Oracle) -> str {
    let n = o.id.len
    if edit.tab_count(ed) != n {
        return "tab count {edit.tab_count(ed)}, oracle says {n}"
    }
    var i = 0
    while i < n {
        let got = ed.tabs[i].tab_id
        if got != o.id[i] {
            return "tab {i} has id {got}, oracle says {o.id[i]}"
        }
        i += 1
    }
    // The half that catches an index kept where an id was needed.
    if o.active >= 0 && o.active < n {
        let want = o.id[o.active]
        let at = ed.tab_active
        if at < 0 || at >= n {
            return "active index {at} out of range"
        }
        if ed.tabs[at].tab_id != want {
            return "active tab has id {ed.tabs[at].tab_id}, oracle says {want}"
        }
    }
    ""
}

// `run_session` (`fuzz_tabs.c:109-230`): "" when every operation held.
fn run_session(data: List[byte]) -> str {
    var rng = Rng { s: 11400714819323198485 }
    for b in data {
        rng.s = rng.s * 31 + b as int as wrapping[u64]
    }
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    if edit.tab_count(ed) != 1 {
        return "cannot open a buffer"
    }
    var o = Oracle { id: List[int](), active: 0 }
    (mut o.id).push(ed.tabs[0].tab_id)
    let ops = 80 + data.len % 80
    var op = 0
    while op < ops {
        let what = rng_below(mut rng, 5)
        if what == 0 || what == 1 {
            // open
            let path = "/tmp/yew-fz-{(rng.s & 65535) as int}-{op}.txt"
            let idx = edit.tab_open(mut ed, path)
            if idx >= 0 {
                oracle_insert(mut o, idx, ed.tabs[idx].tab_id)
            }
        } else if what == 2 {
            // close
            if o.id.len > 1 {
                let at = rng_below(mut rng, o.id.len)
                // The survivor rule, mirrored INDEPENDENTLY.
                var survivor = 0
                if o.active != at {
                    survivor = o.id[o.active]
                } else if at + 1 < o.id.len {
                    survivor = o.id[at + 1]
                } else if at - 1 >= 0 {
                    survivor = o.id[at - 1]
                }
                if !edit.tab_close(mut ed, at) {
                    return "close({at}) refused"
                }
                oracle_remove(mut o, at)
                o.active = -1
                var i = 0
                while i < o.id.len {
                    if o.id[i] == survivor {
                        o.active = i
                        break
                    }
                    i += 1
                }
                if o.active < 0 && o.id.len > 0 {
                    o.active = 0
                }
            }
        } else if what == 3 {
            // switch
            let at = rng_below(mut rng, o.id.len)
            edit.tab_switch(mut ed, at)
            o.active = at
        } else if o.id.len >= 2 {
            // reorder (the default case; fewer than two tabs: nothing)
            let from = rng_below(mut rng, o.id.len)
            let to = rng_below(mut rng, o.id.len)
            if from != to {
                edit.tab_reorder(mut ed, from, to)
                let moved = o.id[from]
                oracle_remove(mut o, from)
                oracle_insert(mut o, to, moved)
                o.active = edit.tab_shifted_index(o.active, from, to)
            }
        }
        let why = oracle_agrees(ed, o)
        if why.len != 0 {
            return why
        }
        op += 1
    }
    ""
}

fn main() -> int {
    let (ok, seed, iters) = fuzzgen.parse_args(env_args())
    if !ok {
        eprint("usage: fuzz-tabs [--seed=N] [--iters=N]")
        return 2
    }
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let (cok, corpus) = fuzzgen.corpus_for("fuzz_tabs")
    if !cok {
        return 2
    }
    let start = fuzzgen.run_new(seed)
    var state = start.state
    var hash = start.hash
    var done = 0
    var failed = false
    while done < iters && !failed {
        let n = if iters - done > EPOCH then EPOCH else iters - done
        region epoch {
            var r = fuzzgen.Run { state: state, hash: hash }
            var k = 0
            while k < n {
                let which = fuzzgen.choose(mut r, corpus.len)
                var input = copy corpus[which].bytes
                let mutations = 1 + fuzzgen.choose(mut r, 4)
                var op = 0
                var m = 0
                while m < mutations {
                    let (next, o) = fuzzgen.mutate(mut r, input, corpus)
                    input = next
                    op = o
                    m += 1
                }
                fuzzgen.hash_bytes(mut r, input)
                var bad = false
                region session {
                    let why = run_session(input)
                    if why.len != 0 {
                        eprint(
                            "fuzz_tabs: FAIL seed={seed} iter={done + k} corpus={corpus[which].name} op={fuzzgen.op_name(op)}: {why}",
                        )
                        eprint("fuzz_tabs: input={fuzzgen.hex_of(input)}")
                        bad = true
                    }
                }
                if bad {
                    failed = true
                    break
                }
                k += 1
            }
            state = r.state
            hash = r.hash
        }
        done += n
    }
    if failed {
        return 1
    }
    print("fuzz_tabs: seed={seed} iters={iters} corpus={corpus.len} hash={fuzzgen.hex16(hash)} ok")
    0
}
