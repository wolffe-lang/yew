#!/bin/bash
# check-fletch-goldens — deliverable 8's Fletch gate (yw07b): C yew's own
# conformance runner (`fletch_run --yew BIN`, tools/goldens --suite fletch)
# over the 39 units of tools/fletch-units.txt, green BY NAME: each name's
# `PASS` line read, never a count alone. Then the same suite under
# YEW_FL_GC_STRESS=1 (s33's stress run, sagitta Makefile:4010-4012; the
# runner's child inherits it, run.c:1797) and a second normal run whose
# per-unit verdict lines must equal the first byte for byte
# (Makefile:4015-4026's determinism half; the ledger half is yw08's).
#     tools/check-fletch-goldens BIN
set -u
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
bin=${1:?usage: tools/check-fletch-goldens BIN}
log=$YEW_ROOT/target/oracle/goldens/fletch.log
units=$(grep -v '^#' "$YEW_ROOT/tools/fletch-units.txt")
want=$(echo "$units" | wc -l | tr -d ' ')
red=0
verdicts() { grep -E '^(PASS|FAIL|SKIP|XFAIL|XPASS) ' "$1" | LC_ALL=C sort; }
one() { # label
    "$YEW_ROOT/tools/goldens" --yew "$bin" --suite fletch >/dev/null 2>&1
    local n=0 missing=0
    for u in $units; do
        if grep -qxF "PASS $u" "$log"; then n=$((n + 1)); else
            missing=$((missing + 1)); echo "check-fletch-goldens: $1: not PASS: $u"
            grep -A3 -F -- "FAIL $u" "$log" | head -4 | sed 's/^/check-fletch-goldens:   /'
        fi
    done
    echo "check-fletch-goldens: $1: $n of $want units PASS by name"
    [ "$missing" = 0 ] || red=1
    verdicts "$log" >"$YEW_ROOT/target/oracle/goldens/fletch-$1.verdicts"
}
one normal
YEW_FL_GC_STRESS=1 one stress
one again
if cmp -s "$YEW_ROOT/target/oracle/goldens/fletch-normal.verdicts" "$YEW_ROOT/target/oracle/goldens/fletch-again.verdicts"; then
    echo "check-fletch-goldens: two runs byte-identical"
else
    echo "check-fletch-goldens: the two runs differ"; red=1
fi
[ $red = 0 ] && echo "check-fletch-goldens: GREEN" || echo "check-fletch-goldens: RED"
exit $red
