#!/bin/sh
# build-fuzz-fl-vm — Sprint 32's VM fuzz driver, tools/fuzz-fl-vm/main.lu
# (the port of sagitta's tests/fuzz/fuzz_fl_vm.c over fuzzlib.c's
# generator, tools/fuzzgen), built on the release tier into
# target/tools/fuzz-fl-vm.
#
#   tools/build-fuzz-fl-vm [--native]
#
# `use fl` resolves beside the ENTRY file (D32), so every module under src/
# and the generator are staged beside a copy of the driver under
# target/fuzz-fl-vm/, as tools/build-fl-front stages its driver. Nothing
# there is committed.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

tier=release
case "${1:-}" in
"") ;;
--native) tier=native ;;
*)
    echo "build-fuzz-fl-vm: unknown option $1" >&2
    exit 2
    ;;
esac

stage="${YEW_ROOT:?}/target/fuzz-fl-vm"
rm -rf "${stage:?}"
mkdir -p "$stage/fuzzgen" target/tools
cp tools/fuzz-fl-vm/main.lu "$stage/main.lu"
cp tools/fuzzgen/*.lu "$stage/fuzzgen/"
# Every module under src/: fl reaches text and search since io and re landed.
for d in src/*/; do
    name=$(basename "$d")
    mkdir -p "$stage/$name"
    cp src/"$name"/*.lu "$stage/$name/"
    find "$stage/$name" -maxdepth 1 -name '*_test.lu' -exec rm -f {} +
done
if [ "$tier" = release ]; then
    "$WOLF" build --release --deny-warnings "$stage/main.lu" -o target/tools/fuzz-fl-vm
else
    "$WOLF" build --deny-warnings "$stage/main.lu" -o target/tools/fuzz-fl-vm
fi
echo "build-fuzz-fl-vm: target/tools/fuzz-fl-vm ($tier)"
