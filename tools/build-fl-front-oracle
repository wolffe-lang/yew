#!/bin/bash
# Reuse the pinned fl_smoke's exact core object set, without oracle edits.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
oracle=${1:-$root/target/oracle/sagitta}
[ -d "$oracle/.git" ] || { echo 'oracle clone missing' >&2; exit 2; }
pin=$(sed -n 's/^SAGITTA_REV=//p' "$root/sagitta.pin")
[ "$(git -C "$oracle" rev-parse HEAD)" = "$pin" ] || { echo 'oracle HEAD differs from pin' >&2; exit 2; }
mkdir -p "$root/target/front"
make -s -j4 -C "$oracle" build/fl_smoke build/fuzz_fl_lex build/fuzz_fl_parse
objects=$(make --no-print-directory -s -C "$oracle" --eval 'front-objects:;@echo $(PERF_CORE_OBJ)' front-objects)
cd "$oracle"
# Object names are the pinned Makefile's, not user-controlled paths.
${CC:-cc} -std=c11 -O2 -Wall -Wextra -Werror -I src \
    "$root/notes/yw07b-evidence/front/oracle-front.c" $objects -lm \
    -o "$root/target/front/oracle-front"
