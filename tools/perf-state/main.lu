//! perf-state — Sprint 25 §9's workspace-state latency gates: the port of
//! sagitta `tests/perf/perf_state.c` (383 lines) at 9ace98c2, in process,
//! the same fixtures C builds (`build_maximal`, `:103-139`: 512 tabs at
//! `/w/max/fNNN.txt`, the second tab split toward 16 leaves on a 240x96
//! screen; a 40-tab workspace at `/w/r/fNN.txt`), the same 3 warm-ups and
//! 11 samples and the upper median (`median_of`, `:83-87`), each timed
//! with `os_clock_ns` around the operation alone (C's `CLOCK_MONOTONIC`):
//! emit <= 5 ms on the 512-tab document, parse <= 10 ms on it (the port's
//! hand codec, R-yw06-1 = A; C's `yew_fl_parse_fletch`), a 40-tab restore
//! (apply and layout) <= 20 ms AND one file read at most (`file_reads`,
//! the count that explains the time, `:194-200`). Strict verdicts here;
//! `tools/run-perf-state` runs C's own `build/perf_state` beside it from
//! the same run and prints the port/C ratios. As in C, the maximal
//! fixture's counts are what the constructors make (the scratch takes a
//! tab slot; minimum pane geometry may stop the splits): the line prints
//! the actual tabs and leaves.
//!
//!   perf-state            measure, one line per gate
//!   perf-state --fixtures BIG FORTY
//!                         write the two documents (the oracle witness)

use edit
use text
use ws

fn opened() -> edit.Ed {
    var ed = edit.ed_new()
    ed.ws_dir = "/w"
    edit.ed_open_scratch(mut ed)
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 240, 96))
    ed
}

fn padded(n: int, width: int) -> str {
    var s = "{n}"
    while s.len < width { s = "0{s}" }
    s
}

fn maximal() -> edit.Ed {
    var ed = opened()
    var i = 0
    while i < 512 {
        if edit.tab_open(mut ed, "/w/max/f{padded(i, 3)}.txt") < 0 { break }
        i += 1
    }
    edit.tab_switch(mut ed, 1)
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 240, 96))
    i = 1
    while i < 16 {
        let dir = if i % 2 == 0 then edit.SPLIT_H else edit.SPLIT_V
        let nu = edit.pane_split(mut ed, ed.focus, dir)
        if nu < 0 { break }
        ed.focus = nu
        ed.tabs[1].focus = nu
        edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 240, 96))
        i += 1
    }
    ed
}

fn forty() -> edit.Ed {
    var ed = opened()
    var i = 0
    while i < 40 {
        if edit.tab_open(mut ed, "/w/r/f{padded(i, 2)}.txt") < 0 { break }
        i += 1
    }
    ed
}

fn median(mut samples: List[int]) -> int {
    var i = 1
    while i < samples.len {
        let key = samples[i]
        var k = i
        while k > 0 && samples[k - 1] > key {
            samples[k] = samples[k - 1]
            k -= 1
        }
        samples[k] = key
        i += 1
    }
    samples[samples.len / 2]
}

fn emit(ed: edit.Ed) -> (int, int) {
    var samples = List[int]()
    var size = 0
    var t = 0
    while t < 14 {
        var dt = 0
        region trial {
            let start = os_clock_ns()
            let doc = edit.state_emit(ed)
            let end = os_clock_ns()
            assert(end > start)
            dt = end - start
            size = doc.len
        }
        // The sample is pushed outside the trial's region: a list grown
        // inside it would hold region storage (E1010).
        if t >= 3 { (mut samples).push(dt) }
        t += 1
    }
    (median(mut samples), size)
}

fn parse(doc: List[byte]) -> int {
    var samples = List[int]()
    var t = 0
    while t < 14 {
        var dt = 0
        region trial {
            let start = os_clock_ns()
            let parsed = ws.fl_parse(doc, 0, doc.len)
            let end = os_clock_ns()
            assert(parsed.ok)
            assert(end > start)
            dt = end - start
        }
        if t >= 3 { (mut samples).push(dt) }
        t += 1
    }
    median(mut samples)
}

fn restore(doc: List[byte]) -> (int, int) {
    var samples = List[int]()
    var reads = 0
    var t = 0
    while t < 14 {
        var dt = 0
        region trial {
            var ed = opened()
            text.file_load_count_reset()
            let start = os_clock_ns()
            let result = edit.state_apply(mut ed, doc)
            edit.ed_layout(mut ed)
            let end = os_clock_ns()
            assert(result == edit.WS_RESTORED)
            assert(end > start)
            reads = text.file_load_count()
            dt = end - start
            edit.state_dispose(mut ed)
        }
        if t >= 3 { (mut samples).push(dt) }
        t += 1
    }
    (median(mut samples), reads)
}

fn main() -> int {
    let args = env_args()
    if args.len != 0 && args.len != 3 { return 2 }
    var big = maximal()
    let big_tabs = big.tabs.len
    let big_leaves = edit.pane_leaf_count(big, big.pane_root)
    var small = forty()
    let forty_tabs = small.tabs.len
    if args.len == 3 {
        if args[0] != "--fixtures" { return 2 }
        let a = edit.state_emit_at(big, 0)
        let b = edit.state_emit_at(small, 0)
        if text.file_write_atomic(args[1], a, 384) != text.SAVE_OK { return 2 }
        if text.file_write_atomic(args[2], b, 384) != text.SAVE_OK { return 2 }
        return 0
    }
    let (emit_ns, bytes) = emit(big)
    let big_doc = edit.state_emit(big)
    edit.state_dispose(mut big)
    let parse_ns = parse(big_doc)
    let forty_doc = edit.state_emit(small)
    edit.state_dispose(mut small)
    let (restore_ns, reads) = restore(forty_doc)
    print(
        "perf-state: port tabs={big_tabs} leaves={big_leaves} bytes={bytes} emit_ns={emit_ns} (budget 5000000) parse_ns={parse_ns} (budget 10000000)",
    )
    print(
        "perf-state: port restore_tabs={forty_tabs} restore_ns={restore_ns} (budget 20000000) file_reads={reads} (expected 1){if reads <= 1 then " ok" else " FAIL"}",
    )
    if emit_ns > 5000000 || parse_ns > 10000000 || restore_ns > 20000000 || reads > 1 {
        1
    } else {
        0
    }
}
