#!/usr/bin/env python3
"""check-fl-cases: the 198-case aggregate (yw07b). Every row of
tools/fl-cases.txt names a pinned C case (sagitta 9ace98c2,
tests/unit/test_fl_*.c, in registry.c's order). Each must be a `fn <name>()`
in src/fl_<file>_test.lu, called (from main or its case dispatch) in the
listed order, exactly once per file. --selftest plants a missing, a
duplicate and a reordered case and must see each refused."""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
WANT = 198


def rows(text):
    out = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        f, name = line.split()
        out.append((f, name))
    return out


def check(table, read):
    errs = []
    if len(table) != WANT:
        errs.append(f'{len(table)} rows, want {WANT}')
    seen = set()
    for f, name in table:
        if (f, name) in seen:
            errs.append(f'duplicate row {f} {name}')
        seen.add((f, name))
    files = []
    for f, _ in table:
        if f not in files:
            files.append(f)
    for f in files:
        names = [n for g, n in table if g == f]
        src = read(f)
        if src is None:
            errs.append(f'src/fl_{f}_test.lu missing ({len(names)} cases)')
            continue
        calls = []
        for n in names:
            if not re.search(rf'^fn {re.escape(n)}\(\)', src, re.M):
                errs.append(f'{f}: no fn {n}()')
                continue
            body = re.sub(rf'^fn {re.escape(n)}\(\).*$', '', src, flags=re.M)
            hits = [m.start() for m in re.finditer(rf'\b{re.escape(n)}\(\)', body)]
            if len(hits) != 1:
                errs.append(f'{f}: {n}() called {len(hits)} times, want 1')
                continue
            calls.append((hits[0], n))
        order = [n for _, n in sorted(calls)]
        listed = [n for n in names if n in order]
        if order != listed:
            errs.append(f'{f}: cases called out of registry order')
    return errs


def from_disk(f):
    p = ROOT / 'src' / f'fl_{f}_test.lu'
    return p.read_text() if p.exists() else None


def main():
    table = rows((ROOT / 'tools/fl-cases.txt').read_text())
    if sys.argv[1:] == ['--selftest']:
        f, a = table[0]
        b = next(n for g, n in table if g == f and n != a)
        good = f'fn {a}() {{}}\nfn {b}() {{}}\nfn main() {{\n    {a}()\n    {b}()\n}}\n'
        small = [(f, a), (f, b)]
        global WANT
        WANT = 2
        assert not check(small, lambda g: good), 'clean plant refused'
        assert check(small, lambda g: good.replace(f'fn {b}() {{}}\n', '')), 'missing fn accepted'
        assert check(small, lambda g: good + f'fn x() {{ {a}() }}\n'), 'duplicate call accepted'
        assert check(small, lambda g: good.replace(f'    {a}()\n    {b}()', f'    {b}()\n    {a}()')), 'reorder accepted'
        assert check(small + [(f, a)], lambda g: good), 'duplicate row accepted'
        print('check-fl-cases: selftest ok (missing, duplicate, reordered refused)')
        return 0
    errs = check(table, from_disk)
    per = {}
    for f, _ in table:
        per[f] = per.get(f, 0) + 1
    for e in errs:
        print(f'check-fl-cases: {e}')
    print(f'check-fl-cases: {len(table)} rows over {len(per)} files; ' + ('ok' if not errs else f'{len(errs)} problems'))
    return 1 if errs else 0


if __name__ == '__main__':
    sys.exit(main())
