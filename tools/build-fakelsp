#!/usr/bin/env bash
# build-fakelsp — C's fake language server, alone (yw11b).
#
#   tools/build-fakelsp [--cc CC]
#
# The LSP unit rows that need a real server (edit_lsp_life_test,
# edit_lsp_transport_test, edit_lsp_gate_test) spawn the oracle's own
# build of C's fake server, `target/oracle/sagitta/build/tests/helpers/
# fakelsp`, and SKIP by name when it is missing. tools/oracle builds it
# with everything else for the oracle job; a unit job needs only this
# helper, so this fetches sagitta at `sagitta.pin` exactly as
# tools/build-fakeclip does (the same tree, the same refusal of any other
# commit), builds `build-<cc>/tests/helpers/fakelsp` with sagitta's own
# Makefile, and points `build` at that tree when no build is there yet
# (tools/oracle's own link wins when it ran first). Nothing of the oracle
# is changed (track rule 2). Exit 0 only when the helper is built and
# executable.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$YEW_ROOT"
. ./sagitta.pin

cc=cc
while [ $# -gt 0 ]; do
    case "$1" in
    --cc) cc=$2; shift 2 ;;
    *) echo "build-fakelsp: unknown option $1" >&2; exit 2 ;;
    esac
done

tree=$YEW_ROOT/target/oracle/sagitta
if [ ! -d "$tree/.git" ] && [ ! -f "$tree/.git" ]; then
    echo "build-fakelsp: fetching $SAGITTA_REPO at $SAGITTA_REV"
    mkdir -p "$tree"
    git -C "$tree" init -q
    git -C "$tree" fetch -q --depth 1 "$SAGITTA_REPO" "$SAGITTA_REV"
    git -C "$tree" checkout -q --detach FETCH_HEAD
fi
have=$(git -C "$tree" rev-parse HEAD)
if [ "$have" != "$SAGITTA_REV" ]; then
    echo "build-fakelsp: REFUSED — target/oracle/sagitta is at $have, the pin is $SAGITTA_REV (remove target/oracle/ to refetch)" >&2
    exit 1
fi

tag=$(echo "$cc" | tr -c 'A-Za-z0-9' '_' | sed 's/_*$//')
make -C "$tree" --no-print-directory CC="$cc" BUILD="build-$tag" "build-$tag/tests/helpers/fakelsp"
if [ ! -e "$tree/build" ]; then
    ln -s "build-$tag" "$tree/build"
fi
tool=$tree/build/tests/helpers/fakelsp
if [ ! -x "$tool" ]; then
    echo "build-fakelsp: $tool is not executable (build points at $(readlink "$tree/build"))" >&2
    exit 1
fi
echo "build-fakelsp: $tool (sagitta $SAGITTA_REV, $cc)"
