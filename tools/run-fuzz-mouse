#!/usr/bin/env bash
# run-fuzz-mouse — Sprint 27's router fuzz (s27 Testing Strategy, with
# s57.13's 35-motion and ctrl+left mix and s57.15's 1003 if-and-only-if):
# mouse reports written as a terminal writes them, fed through the real
# decoder into the router, 25,000 events a session — no stuck phase, no
# tab-array mutation without its release, 1003 off whenever no menu is
# open and no chevron is drawn.
#
#   tools/run-fuzz-mouse [--native] [--iters=N] [--seed=N]
#   tools/run-fuzz-mouse [--native] --campaign [--against-oracle] [--seeds="S..."] [--events=N]
#
# Builds tools/fuzz-mouse/main.lu (tools/build-fuzz-mouse; FUZZ_PREBUILT=1
# runs the driver already built) and runs it from the repository root.
# The defaults are sagitta's generator's (200,000 iterations, seed 1).
# C counts this target in EVENTS, by session (Makefile:173-178,
# 2309-2314): `make fuzz-mouse` runs (MOUSE_FUZZ_EVENTS + 24999) / 25000
# sessions — 4 at the default 100,000 events — at each of four seeds,
# MOUSE_FUZZ_SEEDS "1 0x243f6a8885a308d3 0x9e3779b97f4a7c15
# 0xd1b54a32d192ed03", so `--campaign` does the same. The report line's
# `hash=` is C's for the same seed and sessions (the generator is C's bit
# for bit). `--against-oracle` also runs C's own driver
# (target/oracle/sagitta/build/fuzz_mouse, which tools/oracle builds)
# with the same arguments and requires the two report lines to be equal
# byte for byte; a missing C driver is exit 2, never a silent pass. Exit
# is the driver's, read directly: 0 when every input held, 1 with the
# failing input printed as hex, 2 on a usage error.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"

native=
if [ "${1:-}" = --native ]; then
    native=--native
    shift
fi
if [ "${FUZZ_PREBUILT:-0}" != 1 ]; then
    tools/build-fuzz-mouse $native
fi
driver=target/tools/fuzz-mouse
if [ "${1:-}" = --campaign ]; then
    shift
    oracle=0
    seeds="1 0x243f6a8885a308d3 0x9e3779b97f4a7c15 0xd1b54a32d192ed03"
    events=100000
    for a in "$@"; do
        case "$a" in
        --against-oracle) oracle=1 ;;
        --seeds=*) seeds=${a#--seeds=} ;;
        --events=*) events=${a#--events=} ;;
        *)
            echo "run-fuzz-mouse: unknown argument $a" >&2
            exit 2
            ;;
        esac
    done
    sessions=$(((events + 24999) / 25000))
    c=target/oracle/sagitta/build/fuzz_mouse
    if [ "$oracle" = 1 ] && [ ! -x "$c" ]; then
        echo "run-fuzz-mouse: $c is not built (tools/oracle's targets must list build/fuzz_mouse)" >&2
        exit 2
    fi
    for s in $seeds; do
        port_line=$("$driver" --iters="$sessions" --seed="$s") || {
            echo "port: $port_line"
            exit 1
        }
        echo "port: $port_line"
        if [ "$oracle" = 1 ]; then
            c_line=$(cd target/oracle/sagitta && build/fuzz_mouse --iters="$sessions" --seed="$s") || {
                echo "C:    $c_line"
                exit 1
            }
            echo "C:    $c_line"
            if [ "$port_line" != "$c_line" ]; then
                echo "run-fuzz-mouse: the port's report differs from C's at seed $s" >&2
                exit 1
            fi
        fi
    done
    exit 0
fi
exec "$driver" "$@"
