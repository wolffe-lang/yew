#!/usr/bin/env python3
"""R-yw07-12: median of exactly five unchanged C-harness cold-open rows."""
from pathlib import Path
import re
import sys

def sample(text):
    rows = re.findall(r"^cold_open_to_first_paint ([0-9]+) limit=", text, re.M)
    if len(rows) != 1 or int(rows[0]) <= 0:
        raise ValueError("expected exactly one positive cold-open row")
    return int(rows[0])

def median(values):
    if len(values) != 5 or any(not isinstance(v, int) or v <= 0 for v in values):
        raise ValueError("cold-open gate requires five positive integer observations")
    return sorted(values)[2]

def selftest():
    assert median([5, 1, 4, 2, 3]) == 3
    assert median([1, 2, 3, 4, 999999]) == 3
    assert sample("cold_open_to_first_paint 123 limit=20000000 ok\n") == 123
    for values in ([1, 2, 3, 4], [1, 2, 3, 4, 0]):
        try:
            median(values)
        except ValueError:
            pass
        else:
            raise AssertionError("invalid sample set accepted")
    for text in ("", "cold_open_to_first_paint -1 limit=2\n",
                 "cold_open_to_first_paint 1 limit=2\ncold_open_to_first_paint 2 limit=2\n"):
        try:
            sample(text)
        except ValueError:
            pass
        else:
            raise AssertionError("invalid harness output accepted")
    print("perf-cold-median: 8 controls PASS")

if __name__ == "__main__":
    try:
        if sys.argv[1:] == ["--selftest"]:
            selftest()
        else:
            print(median([sample(Path(p).read_text()) for p in sys.argv[1:]]))
    except (ValueError, OSError) as error:
        print("perf-cold-median: " + str(error), file=sys.stderr)
        sys.exit(2)
