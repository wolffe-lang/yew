//! fuzz-fuzzy — sagitta's `fuzz_fuzzy` (`tests/fuzz/fuzz_fuzzy.c`, 248
//! lines at 9ace98c2) as a bounded, seeded driver: the fuzzy scorer and
//! ranker (`ws.fuzzy`) under arbitrary bytes, asserting exactly the
//! properties `fuzz_fuzzy.c:22-218` checks — a deterministic score and
//! positions (score, repeat and position-free agree), the empty-pattern
//! row (1), a longer pattern never matching, every recorded position in
//! range, ascending, at most `FZ_MAX_POS`, and folding equal to the
//! pattern byte it stands for, nothing left behind on a no-match; and
//! for the ranker in both modes: no more rows than candidates, every
//! index in range and unique, no non-match kept, scores non-ascending.
//!
//! The input shape is C's (`check_fuzzy`, `fuzz_fuzzy.c:166-243`): byte 0
//! picks a pattern length (mod 41) out of the front, the remainder splits
//! on LF into at most 32 candidates (a NUL ends a C candidate early, so
//! the port's ends there too), and the remainder WITH those LFs turned to
//! NUL is one more candidate. The campaign is `tools/fuzz-unicode`'s port
//! of `fuzzlib.c`'s shape — the xorshift64* PRNG, its nine mutators, the
//! FNV-1a mutation hash — over C's built-in seed corpus
//! (`add_builtin_corpus`, `fuzzlib.c:1590-1606`; fuzz_fuzzy has no
//! guided corpus and no dictionary at the pin).
//!
//!   fuzz-fuzzy --iters N --seed S
//!
//! Built and run by `tools/run-fuzz-fuzzy`, which copies `src/ws` and
//! `src/unicode` beside it (D32). On a failing input the bytes are
//! printed in hex with the seed and the iteration, and the exit is 1.

use unicode
use ws

/// xorshift64* (`fuzzlib.c`), as a FUNCTIONAL state: the per-turn
/// region refuses any `mut` parameter inside it (E1010, whatever it
/// holds), so every step answers the next state as a scalar.
fn rng_seed(seed: int) -> wrapping[u64] {
    if seed == 0 {
        return 11400714819323198485
    }
    seed as wrapping[u64]
}

/// `(value, next_state)`.
fn rng_next(s: wrapping[u64]) -> (wrapping[u64], wrapping[u64]) {
    var x = s
    x = x ^ x >> 12
    x = x ^ x << 25
    x = x ^ x >> 27
    (x * 2685821657736338717, x)
}

/// A value in `0..n` (n > 0) and the next state.
fn pick(s: wrapping[u64], n: int) -> (int, wrapping[u64]) {
    let (v, next) = rng_next(s)
    ((v >> 33) as int % n, next)
}

/// FNV-1a over the length then the bytes (`fuzzlib.c:915-926`): the
/// mutation-sequence hash, a scalar handed back so the per-turn region
/// keeps nothing alive (E1010 on a `mut` struct touched inside it).
fn hash_bytes(h: wrapping[u64], buf: List[byte]) -> wrapping[u64] {
    var v = h
    var i = 0
    while i < 8 {
        v = v ^ (buf.len >> i * 8 & 255) as wrapping[u64]
        v = v * 1099511628211
        i += 1
    }
    for b in buf {
        v = v ^ b as int as wrapping[u64]
        v = v * 1099511628211
    }
    v
}

fn hex_of(buf: List[byte]) -> str {
    let digits = "0123456789ABCDEF"
    var out = ""
    for b in buf {
        let v = b as int
        out += "{digits[v / 16..v / 16 + 1]}{digits[v % 16..v % 16 + 1]} "
    }
    out.trim()
}

fn bytes_of(xs: List[int]) -> List[byte] {
    var out = List[byte]()
    for x in xs {
        (mut out).push(x as byte)
    }
    out
}

// ---- the mutators (`fuzzlib.c:742-911`), each answering the RNG's next state

fn mutate_flip(s: wrapping[u64], mut buf: List[byte]) -> wrapping[u64] {
    if buf.len == 0 {
        let (b, s1) = pick(s, 256)
        (mut buf).push(b as byte)
        return s1
    }
    let (at, s1) = pick(s, buf.len)
    let (bit, s2) = pick(s1, 8)
    buf[at] = (buf[at] as int ^ 1 << bit) as byte
    s2
}

fn delete_range(mut buf: List[byte], at: int, len: int) {
    var out = List[byte]()
    var i = 0
    while i < buf.len {
        if i < at || i >= at + len {
            (mut out).push(buf[i])
        }
        i += 1
    }
    buf = out
}

fn mutate_delete(s: wrapping[u64], mut buf: List[byte]) -> wrapping[u64] {
    if buf.len == 0 {
        return s
    }
    let (at, s1) = pick(s, buf.len)
    let (span, s2) = pick(s1, 4)
    delete_range(mut buf, at, 1 + span)
    s2
}

fn mutate_duplicate(s: wrapping[u64], mut buf: List[byte]) -> wrapping[u64] {
    if buf.len == 0 || buf.len > 4096 {
        return s
    }
    let (at, s1) = pick(s, buf.len)
    let (span, s2) = pick(s1, 8)
    var len = 1 + span
    if at + len > buf.len {
        len = buf.len - at
    }
    var out = List[byte]()
    var i = 0
    while i < buf.len {
        (mut out).push(buf[i])
        if i == at + len - 1 {
            var k = at
            while k < at + len {
                (mut out).push(buf[k])
                k += 1
            }
        }
        i += 1
    }
    buf = out
    s2
}

fn mutate_swap(s: wrapping[u64], mut buf: List[byte]) -> wrapping[u64] {
    if buf.len < 2 {
        return s
    }
    let (a, s1) = pick(s, buf.len)
    let (b, s2) = pick(s1, buf.len)
    let t = buf[a]
    buf[a] = buf[b]
    buf[b] = t
    s2
}

fn mutate_truncate(s: wrapping[u64], mut buf: List[byte]) -> wrapping[u64] {
    if buf.len == 0 {
        return s
    }
    let (keep, s1) = pick(s, buf.len)
    var out = List[byte]()
    var i = 0
    while i < keep {
        (mut out).push(buf[i])
        i += 1
    }
    buf = out
    s1
}

fn mutate_splice(s: wrapping[u64], mut buf: List[byte], corpus: List[List[byte]]) -> wrapping[u64] {
    if buf.len > 4096 {
        return s
    }
    let (which, s1) = pick(s, corpus.len)
    let other = corpus[which]
    var at = 0
    var s2 = s1
    if buf.len > 0 {
        let (a, s3) = pick(s1, buf.len + 1)
        at = a
        s2 = s3
    }
    var out = List[byte]()
    var i = 0
    while i < at {
        (mut out).push(buf[i])
        i += 1
    }
    for b in other {
        (mut out).push(b)
    }
    while i < buf.len {
        (mut out).push(buf[i])
        i += 1
    }
    buf = out
    s2
}

/// Cut a multi-byte sequence in two (`mutate_split_utf8`).
fn mutate_split_utf8(s: wrapping[u64], mut buf: List[byte]) -> wrapping[u64] {
    if buf.len == 0 {
        return mutate_flip(s, mut buf)
    }
    let (at, s1) = pick(s, buf.len)
    let (cp, n) = unicode.utf8_decode(buf, at, buf.len)
    assert(cp >= 0, "fuzz: decode answered")
    if n > 1 {
        let (cut, s2) = pick(s1, n - 1)
        delete_range(mut buf, at + 1, cut + 1)
        return s2
    }
    mutate_flip(s1, mut buf)
}

/// Replace a byte with a lead of another class (`mutate_lead_class`).
fn mutate_lead_class(s: wrapping[u64], mut buf: List[byte]) -> wrapping[u64] {
    let leads = [128, 192, 194, 224, 225, 237, 240, 244, 245, 255]
    let (which, s1) = pick(s, leads.len)
    let b = leads[which] as byte
    if buf.len == 0 {
        (mut buf).push(b)
        return s1
    }
    let (at, s2) = pick(s1, buf.len)
    buf[at] = b
    s2
}

/// Inject a lone continuation or a surrogate encoding (`mutate_continuation`).
fn mutate_continuation(s: wrapping[u64], mut buf: List[byte]) -> wrapping[u64] {
    var at = 0
    var s1 = s
    if buf.len > 0 {
        let (a, s2) = pick(s, buf.len + 1)
        at = a
        s1 = s2
    }
    let (kind, s3) = pick(s1, 2)
    var inject = List[byte]()
    var s4 = s3
    if kind == 0 {
        let (c, s5) = pick(s3, 64)
        (mut inject).push((128 + c) as byte)
        s4 = s5
    } else {
        inject = bytes_of([237, 160, 128])
    }
    var out = List[byte]()
    var i = 0
    while i < at {
        (mut out).push(buf[i])
        i += 1
    }
    for b in inject {
        (mut out).push(b)
    }
    while i < buf.len {
        (mut out).push(buf[i])
        i += 1
    }
    buf = out
    s4
}

fn mutator_name(which: int) -> str {
    match which {
        0 => "byte-flip",
        1 => "chunk-delete",
        2 => "chunk-duplicate",
        3 => "chunk-swap",
        4 => "truncate",
        5 => "corpus-splice",
        6 => "utf8-split",
        7 => "lead-class",
        _ => "lone-continuation",
    }
}

/// One mutation, chosen as `fuzzlib.c:899-911` chooses; answers
/// `(which, next_state)`.
fn mutate(s: wrapping[u64], mut buf: List[byte], corpus: List[List[byte]]) -> (int, wrapping[u64]) {
    let (which, s1) = pick(s, 9)
    var s2 = s1
    if which == 0 {
        s2 = mutate_flip(s1, mut buf)
    } else if which == 1 {
        s2 = mutate_delete(s1, mut buf)
    } else if which == 2 {
        s2 = mutate_duplicate(s1, mut buf)
    } else if which == 3 {
        s2 = mutate_swap(s1, mut buf)
    } else if which == 4 {
        s2 = mutate_truncate(s1, mut buf)
    } else if which == 5 {
        s2 = mutate_splice(s1, mut buf, corpus)
    } else if which == 6 {
        s2 = mutate_split_utf8(s1, mut buf)
    } else if which == 7 {
        s2 = mutate_lead_class(s1, mut buf)
    } else {
        s2 = mutate_continuation(s1, mut buf)
    }
    (which, s2)
}

// ---- the checks (`fuzz_fuzzy.c:22-218`) --------------------------------

fn fold(b: int) -> int {
    if b >= 65 && b <= 90 then b + 32 else b
}

fn same_ints(a: List[int], b: List[int]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

// `check_positions` (`fuzz_fuzzy.c:28-74`).
fn check_positions(pat: List[byte], text: List[byte], m: ws.FzMatch, score: int) -> str {
    let plen = pat.len
    let tlen = text.len
    let cap = if plen > ws.FZ_MAX_POS then ws.FZ_MAX_POS else plen
    if score == ws.FZ_NO_MATCH {
        if m.pos.len != 0 {
            return "no-match left {m.pos.len} positions behind"
        }
        return ""
    }
    if m.pos.len > cap {
        return "n_pos {m.pos.len} exceeds cap {cap}"
    }
    var i = 0
    while i < m.pos.len {
        let at = m.pos[i]
        if at >= tlen {
            return "position {i} is {at}, past text length {tlen}"
        }
        if i != 0 && at <= m.pos[i - 1] {
            return "positions {m.pos[i - 1]},{at} are not ascending"
        }
        if fold(text[at] as int) != fold(pat[i] as int) {
            return "position {i} points at {text[at] as int}, pattern wants {pat[i] as int}"
        }
        i += 1
    }
    ""
}

// `check_score` (`fuzz_fuzzy.c:76-112`).
fn check_score(pat: List[byte], text: List[byte]) -> str {
    var m = ws.fzmatch_none()
    var again = ws.fzmatch_none()
    let score = ws.fz_score_m(pat, 0, pat.len, text, 0, text.len, mut m)
    let repeat = ws.fz_score_m(pat, 0, pat.len, text, 0, text.len, mut again)
    let bare = ws.fz_score(pat, 0, pat.len, text, 0, text.len)
    if repeat != score || bare != score {
        return "score is not deterministic: {score}, {repeat}, {bare}"
    }
    if !same_ints(m.pos, again.pos) {
        return "positions are not deterministic"
    }
    if pat.len == 0 && score != 1 {
        return "empty pattern scored {score}, wanted 1"
    }
    if pat.len > text.len && score != ws.FZ_NO_MATCH {
        return "pattern longer than text scored {score}"
    }
    check_positions(pat, text, m, score)
}

// `check_rank` (`fuzz_fuzzy.c:114-164`).
fn check_rank(pat: List[byte], texts: List[List[byte]], path_mode: bool) -> str {
    let out = ws.fz_rank(pat, 0, pat.len, texts, path_mode)
    let n = texts.len
    if out.len > n {
        return "rank kept {out.len} of {n} candidates"
    }
    var i = 0
    while i < out.len {
        if out[i].idx < 0 || out[i].idx >= n {
            return "rank row {i} names index {out[i].idx}"
        }
        if out[i].score == ws.FZ_NO_MATCH {
            return "rank kept a non-match at {i}"
        }
        if i != 0 && out[i - 1].score < out[i].score {
            return "rank scores ascend at {i}: {out[i - 1].score} then {out[i].score}"
        }
        var j = 0
        while j < i {
            if out[j].idx == out[i].idx {
                return "rank returned index {out[i].idx} twice"
            }
            j += 1
        }
        i += 1
    }
    ""
}

// `check_fuzzy` (`fuzz_fuzzy.c:166-243`).
fn check_fuzzy(data: List[byte]) -> str {
    if data.len >= 0 {
        return "PLANT (yw04): the fuzzy driver's check planted red"
    }
    if data.len == 0 {
        return check_score(List[byte](), List[byte]())
    }
    var plen = data[0] as int % 41
    if plen > data.len - 1 {
        plen = data.len - 1
    }
    var pattern = List[byte]()
    var k = 0
    while k < plen {
        (mut pattern).push(data[1 + k])
        k += 1
    }
    var rest = List[byte]()
    k = 1 + plen
    while k < data.len {
        (mut rest).push(data[k])
        k += 1
    }
    // The split, as C's: at each LF (and at the end) one candidate, up to
    // 32; each split LF becomes a NUL in `rest`; a candidate ends at its
    // first NUL (C's strlen).
    var texts = List[List[byte]]()
    var start = 0
    var at = 0
    while at <= rest.len && texts.len < 32 {
        if at != rest.len && rest[at] as int != 10 {
            at += 1
            continue
        }
        if at != rest.len {
            rest[at] = 0 as byte
        }
        var t = List[byte]()
        var q = start
        while q < at && rest[q] as int != 0 {
            (mut t).push(rest[q])
            q += 1
        }
        (mut texts).push(t)
        start = at + 1
        at += 1
    }
    for t in texts {
        let why = check_score(pattern, t)
        if why.len != 0 {
            return why
        }
    }
    let whole = check_score(pattern, rest)
    if whole.len != 0 {
        return whole
    }
    let r0 = check_rank(pattern, texts, false)
    if r0.len != 0 {
        return r0
    }
    check_rank(pattern, texts, true)
}

fn main() -> int {
    let args = env_args()
    var iters = 200000
    var seed = 1
    var i = 0
    while i < args.len {
        if args[i] == "--iters" && i + 1 < args.len {
            iters = args[i + 1].to_int() else 200000
            i += 2
        } else if args[i] == "--seed" && i + 1 < args.len {
            seed = args[i + 1].to_int() else 1
            i += 2
        } else {
            eprint("usage: fuzz-fuzzy [--iters N] [--seed S]")
            return 2
        }
    }
    // `add_builtin_corpus` (`fuzzlib.c:1590-1606`).
    var corpus = List[List[byte]]()
    (mut corpus).push(List[byte]())
    (mut corpus).push(bytes_of([121, 101, 119, 10]))
    (mut corpus).push(bytes_of([226, 130, 172, 240, 159, 145, 141]))
    (mut corpus).push(bytes_of([128, 192, 128, 237, 160, 128, 255]))
    (mut corpus).push(bytes_of([101, 204, 129, 240, 159, 135, 166, 240, 159, 135, 186]))
    var rs = rng_seed(seed)
    var h: wrapping[u64] = 14695981039346656037
    for entry in corpus {
        let why = check_fuzzy(entry)
        if why.len > 0 {
            print("fuzz-fuzzy: FAIL corpus entry {hex_of(entry)}: {why}")
            return 1
        }
    }
    var iter = 0
    while iter < iters {
        region turn {
            let (entry, s1) = pick(rs, corpus.len)
            let (extra, s2) = pick(s1, 4)
            rs = s2
            var buf = copy corpus[entry]
            let rounds = 1 + extra
            var k = 0
            while k < rounds {
                let (_, s3) = mutate(rs, mut buf, corpus)
                rs = s3
                k += 1
            }
            h = hash_bytes(h, buf)
            let why = check_fuzzy(buf)
            if why.len > 0 {
                print("fuzz-fuzzy: FAIL seed={seed} iter={iter} input {hex_of(buf)}: {why}")
                return 1
            }
        }
        iter += 1
    }
    print("fuzz-fuzzy: ok seed={seed} iters={iters} corpus={corpus.len} hash={h}")
    0
}
