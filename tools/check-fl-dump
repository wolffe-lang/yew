#!/bin/bash
# check-fl-dump — the front end's and the compiler's differentials through
# `yew fl` (deliverables 3 and 4; R-yw07-7): `--dump-ast` and
# `--dump-bytecode` of every `.fl` under the oracle's tests/fletch/ (56)
# and the three fuzz corpora (fl_parse 23, fl_std 3, fl_vm 7), the port's
# against C yew's at the pin, exit status, stdout and stderr byte for byte.
#     tools/check-fl-dump BIN [ORACLE_BIN]
set -u
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
. "$YEW_ROOT/tools/lib-test-env.sh"
test_env_begin || exit 2
export YEW_RUNTIME_DIR="${YEW_RUNTIME_DIR:-$YEW_ROOT/runtime}"
bin=${1:?usage: tools/check-fl-dump BIN [ORACLE_BIN]}
tree=$YEW_ROOT/target/oracle/sagitta
oracle=${2:-$tree/build/yew}
case "$bin" in /*) ;; *) bin=$YEW_ROOT/$bin ;; esac
[ -x "$bin" ] && [ -x "$oracle" ] || { echo "check-fl-dump: need $bin and $oracle" >&2; exit 2; }
work=$(mktemp -d "${TMPDIR:-/tmp}/yew-fl-dump-XXXXXX")
trap 'rm -rf "$work" "$YEW_TEST_ENV"' EXIT
cd "$tree" || exit 2
files=$( { find tests/fletch -name '*.fl'; for c in fl_parse fl_std fl_vm; do find "tests/fuzz/corpus/$c" -type f; done; } | LC_ALL=C sort)
total=0; fail=0
for mode in --dump-ast --dump-bytecode; do
    for f in $files; do
        total=$((total + 1))
        "$oracle" fl "$mode" "$f" >"$work/c.out" 2>"$work/c.err"; c=$?
        "$bin" fl "$mode" "$f" >"$work/p.out" 2>"$work/p.err"; p=$?
        if [ $c != $p ] || ! cmp -s "$work/c.out" "$work/p.out" || ! cmp -s "$work/c.err" "$work/p.err"; then
            fail=$((fail + 1))
            echo "check-fl-dump: FAIL $mode $f (exit C=$c port=$p)"
            diff "$work/c.out" "$work/p.out" | head -5 | sed 's/^/check-fl-dump:   /'
            diff "$work/c.err" "$work/p.err" | head -5 | sed 's/^/check-fl-dump:   /'
        fi
    done
done
echo "check-fl-dump: total=$total pass=$((total - fail)) fail=$fail"
[ $fail = 0 ]
