#!/usr/bin/env python3
"""Strict wolf-test adapter: malformed or native results never pass checked."""
import json
from pathlib import Path
import runpy
from types import SimpleNamespace
from unittest.mock import patch

scope = runpy.run_path(str(Path(__file__).with_name("check-test-cases")))
run = scope["run_self_exec"]
path = "src/edit_ctxmenu_test.lu"
reason = scope["REASONS"]["self-exec"]
base_test = dict(event="test", file=path, name="main", status="unsupported", detail=reason)
base_summary = dict(event="summary", native=0, passed=0, failed=0, rejected=0, filtered_out=0, unsupported=1)

def probe(test=None, summary=None, code=1, duplicate=False, raw=None):
    rows = [test or base_test, summary or base_summary]
    if duplicate:
        rows.append(base_test)
    stdout = raw if raw is not None else "\n".join(json.dumps(r) for r in rows)
    with patch("subprocess.run", return_value=SimpleNamespace(stdout=stdout, stderr="", returncode=code)) as call:
        got = run("wolf", {}, path, "YEW_CTX_CASE", "12")
    args, kwargs = call.call_args
    assert "--no-native-fallback" in args[0] and args[0][1] == "test"
    assert kwargs["env"]["YEW_CTX_CASE"] == "12"
    return got

assert probe()[:2] == ("unsupported", reason)
assert probe(summary=dict(base_summary, native=1))[0] == "unreadable"
assert probe(duplicate=True)[0] == "unreadable"
assert probe(raw="not json")[0] == "unreadable"
assert probe(code=0)[0] == "unreadable"
assert probe(test=dict(base_test, file="wrong"))[0] == "unreadable"
assert probe(test=dict(base_test, detail="different refusal"))[1] != reason
assert probe(test=dict(base_test, status="passed"), summary=dict(base_summary, passed=1, unsupported=0), code=0)[0] == "exit(0)"
# --shard I/N: the shards partition the run list exactly, every case and every
# one-past-the-end run in exactly one shard, and a bad spelling is refused.
plan, pick, shard_of = scope["plan"], scope["pick"], scope["shard_of"]
files = [("src/a_test.lu", "YEW_A_CASE", "5"), ("src/b_test.lu", "YEW_B_CASE", "2")]
items = plan(files)
assert len(items) == 5 + 1 + 2 + 1 and [it[5] for it in items].count(True) == 2
for n in (1, 2, 3, 4, 9):
    parts = [pick(items, i, n) for i in range(1, n + 1)]
    assert sorted(x for p in parts for x in p) == sorted(items), n
    assert sum(len(p) for p in parts) == len(items), n
assert shard_of(["--shard", "2/3", "src/a_test.lu"]) == (["src/a_test.lu"], 2, 3)
assert shard_of(["src/a_test.lu"]) == (["src/a_test.lu"], 1, 1)
for bad in (["--shard"], ["--shard", "0/3"], ["--shard", "4/3"], ["--shard", "x"]):
    try:
        shard_of(bad)
    except SystemExit:
        pass
    else:
        raise AssertionError(bad)
print("check-test-cases-selftest: 8 adapter controls and the shard partition PASS")
