#!/bin/sh
# build-fuzz-search — Sprint 21's interleaving fuzz driver,
# tools/fuzz-search/main.lu (the port of sagitta's
# tests/fuzz/fuzz_search.c over fuzzlib.c's generator), built on the
# release tier into target/tools/fuzz-search.
#
#   tools/build-fuzz-search [--native]
#
# `use edit` resolves beside the ENTRY file (D32), so the port's modules
# are staged beside a copy under target/fuzz-search/, as
# tools/build-demo stages the demo. Nothing there is committed.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

tier=release
case "${1:-}" in
"") ;;
--native) tier=native ;;
*)
    echo "build-fuzz-search: unknown option $1" >&2
    exit 2
    ;;
esac

stage=$YEW_ROOT/target/fuzz-search
rm -rf "$stage"
mkdir -p "$stage" target/tools
cp tools/fuzz-search/main.lu "$stage/main.lu"
for m in util unicode term text search edit; do
    cp -R "src/$m" "$stage/$m"
    rm -f "$stage/$m"/*_test.lu
done
if [ "$tier" = release ]; then
    "$WOLF" build --release --deny-warnings "$stage/main.lu" -o target/tools/fuzz-search
else
    "$WOLF" build --deny-warnings "$stage/main.lu" -o target/tools/fuzz-search
fi
echo "build-fuzz-search: target/tools/fuzz-search ($tier)"
