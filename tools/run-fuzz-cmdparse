#!/usr/bin/env bash
# run-fuzz-cmdparse — Sprint 18's parser fuzz (s18 DoD 10): every input
# parsed twice (as typed, and behind `file.write `), zero traps, and the
# failure token inside the line on every refusal.
#
#   tools/run-fuzz-cmdparse [--iters=N] [--seed=N]
#   tools/run-fuzz-cmdparse --campaign [--against-oracle]
#
# Builds tools/fuzz-cmdparse/main.lu on the release tier
# (tools/build-fuzz-cmdparse) and runs it from the repository root with
# the arguments given (FUZZ_PREBUILT=1: the driver already built); the
# defaults are sagitta's generator's (200,000
# iterations, seed 1). `--campaign` is sagitta's `make fuzz-cmdparse`:
# 1,000,000 iterations at seed 1 (CMDPARSE_FUZZ_ITERS, FUZZ_SEED,
# Makefile:147, 2354-2356). The report line's `hash=` is C's for the same
# seed and iterations (the generator is C's bit for bit). Exit is the
# driver's, read directly: 0 when every input held, 1 with the failing
# input printed as hex, 2 on a usage error. `--against-oracle` also runs
# C's own driver (target/oracle/sagitta/build/fuzz_cmdparse, which
# tools/oracle builds when its target list carries build/fuzz_cmdparse)
# with the same arguments and requires the two report lines to be equal
# byte for byte: the same inputs, both parsers green; a missing C driver
# is exit 2, never a silent pass.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"

# FUZZ_PREBUILT=1 runs the driver already built (a container with no
# clang runs what the host built).
if [ "${FUZZ_PREBUILT:-0}" != 1 ]; then
    tools/build-fuzz-cmdparse
fi
driver=target/tools/fuzz-cmdparse
if [ "${1:-}" = --campaign ]; then
    if [ "${2:-}" = --against-oracle ]; then
        c=target/oracle/sagitta/build/fuzz_cmdparse
        if [ ! -x "$c" ]; then
            echo "run-fuzz-cmdparse: $c is not built (tools/oracle's targets must list build/fuzz_cmdparse)" >&2
            exit 2
        fi
        port_line=$("$driver" --iters=1000000 --seed=1) || {
            echo "port: $port_line"
            exit 1
        }
        c_line=$(cd target/oracle/sagitta && build/fuzz_cmdparse --iters=1000000 --seed=1) || {
            echo "C:    $c_line"
            exit 1
        }
        echo "port: $port_line"
        echo "C:    $c_line"
        if [ "$port_line" != "$c_line" ]; then
            echo "run-fuzz-cmdparse: the port's report differs from C's" >&2
            exit 1
        fi
        exit 0
    fi
    exec "$driver" --iters=1000000 --seed=1
fi
exec "$driver" "$@"
