#!/usr/bin/env bash
# run-fuzz-textbuf — campaign 02's differential fuzz: the piece tree,
# the undo tree, the marks, the cursor set, snapshots and the save
# against a naive oracle under sagitta's seeded generator.
#
#   tools/run-fuzz-textbuf [--iters=N] [--seed=S] [--mix=M] [...]
#   tools/run-fuzz-textbuf --campaign
#
# Builds tools/fuzz-textbuf/main.lu on the release tier
# (tools/build-fuzz-textbuf), replays the smoke trace
# (tests/fixtures/fuzz/replay-smoke.trace, sagitta's
# tests/fuzz/replay-smoke.trace byte for byte) as sagitta's `make
# fuzz-textbuf` does first, then runs the driver from the repository
# root with the arguments given; the defaults are sagitta's (200,000
# iterations, seed 1, mix typing). `--campaign` is sagitta's whole
# `make fuzz-textbuf`: the four TEXTBUF_FUZZ_SEEDS by the three
# TEXTBUF_FUZZ_MIXES at 200,000 iterations each (Makefile:154-156,
# 2463-2471). Exit is the driver's, read directly: 0 when every op held
# every tier, 1 with the divergence's seed, op and check printed and its
# shrunk trace under target/fuzz-textbuf-crashes/, 2 on a usage error.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"

tools/build-fuzz-textbuf
driver=target/tools/fuzz-textbuf
"$driver" --replay tests/fixtures/fuzz/replay-smoke.trace
if [ "${1:-}" = --campaign ]; then
    for seed in 1 0x243f6a8885a308d3 0x9e3779b97f4a7c15 0xd1b54a32d192ed03; do
        for mix in typing paste undo; do
            "$driver" --iters=200000 --seed="$seed" --mix="$mix"
        done
    done
    exit 0
fi
exec "$driver" "$@"
