#!/bin/sh
# check-re-golden — tests/fixtures/search/re_golden.txt is sagitta's
# tests/unit/re_golden.h at the pin, row for row (s20 §Testing: the
# golden table is shared so yw07's `re` module replays the SAME rows).
#
#   tools/check-re-golden          build tools/re-golden-dump.c against
#                                  the oracle tree (tools/oracle) and diff
#   tools/check-re-golden --write  regenerate the fixture
#
# Needs the oracle tree (target/oracle/sagitta) and a C compiler.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$YEW_ROOT"
tree=target/oracle/sagitta
[ -f "$tree/tests/unit/re_golden.h" ] || {
    echo "check-re-golden: no oracle tree at $tree (run tools/oracle)" >&2
    exit 2
}
mkdir -p target/tools
${CC:-cc} -std=c11 -I "$tree/tests/unit" -I "$tree/src" tools/re-golden-dump.c -o target/tools/re-golden-dump
target/tools/re-golden-dump >target/tools/re_golden.txt
case "${1:-}" in
--write)
    cp target/tools/re_golden.txt tests/fixtures/search/re_golden.txt
    echo "check-re-golden: wrote tests/fixtures/search/re_golden.txt ($(grep -vc '^#' tests/fixtures/search/re_golden.txt) rows)"
    ;;
"")
    if cmp -s target/tools/re_golden.txt tests/fixtures/search/re_golden.txt; then
        echo "check-re-golden: tests/fixtures/search/re_golden.txt is sagitta's re_golden.h ($(grep -vc '^#' tests/fixtures/search/re_golden.txt) rows)"
    else
        echo "check-re-golden: tests/fixtures/search/re_golden.txt DIFFERS from sagitta's re_golden.h" >&2
        diff target/tools/re_golden.txt tests/fixtures/search/re_golden.txt | head -5 >&2 || true
        exit 1
    fi
    ;;
*)
    echo "usage: tools/check-re-golden [--write]" >&2
    exit 2
    ;;
esac
