#!/bin/sh
# check-shell-fixtures — the shell-completion corpora are sagitta's.
#
#   tools/check-shell-fixtures [SAGITTA]   regenerate tests/fixtures/shell/
#                                          from SAGITTA's C tables into
#                                          target/tools/ and compare; compare
#                                          tests/fuzz/corpus/fuzz_shctx/ with
#                                          SAGITTA's; exit 1 on any drift
#
# SAGITTA defaults to the oracle tree (target/oracle/sagitta). The data is
# never edited here (track rule 2): a drift is a regeneration, or a STOP.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$YEW_ROOT"
tree=${1:-target/oracle/sagitta}
if [ ! -d "$tree/tests/unit" ]; then
    echo "check-shell-fixtures: no sagitta tree at $tree (run tools/oracle first)" >&2
    exit 2
fi
status=0
out=target/tools/shell-fixtures
rm -rf "$out"
mkdir -p "$out"
python3 -I tools/gen-shell-fixtures/gen.py "$tree" "$out"
for f in "$out"/*.txt; do
    name=$(basename "$f")
    if cmp -s "$f" "tests/fixtures/shell/$name"; then
        echo "check-shell-fixtures: tests/fixtures/shell/$name is the generator's"
    else
        echo "check-shell-fixtures: tests/fixtures/shell/$name DIFFERS from the generator's output" >&2
        status=1
    fi
done
for d in fuzz_shctx; do
    if diff -r "$tree/tests/fuzz/corpus/$d" "tests/fuzz/corpus/$d" > /dev/null; then
        echo "check-shell-fixtures: tests/fuzz/corpus/$d is sagitta's"
    else
        echo "check-shell-fixtures: tests/fuzz/corpus/$d DIFFERS from $tree's" >&2
        status=1
    fi
done
exit $status
