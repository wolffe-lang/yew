#!/usr/bin/env bash
# run-fuzz-gitignore — Sprint 26 §4's matcher fuzz (s26 Testing Strategy:
# "random pattern bytes never crash the compiler or matcher"): the input
# as a pattern, the 35 adversarial shapes, 64 random patterns and a
# 32-rule set, every answer bounded in time, one session per generated
# input.
#
#   tools/run-fuzz-gitignore [--native] [--iters=N] [--seed=N] [--answers]
#   tools/run-fuzz-gitignore --campaign [--against-oracle] [--seeds="S..."] [--iters=N]
#
# Builds tools/fuzz-gitignore/main.lu (tools/build-fuzz-gitignore;
# FUZZ_PREBUILT=1 runs the driver already built) and runs it from the
# repository root. The defaults are sagitta's generator's (200,000
# iterations, seed 1). C's campaign is `make fuzz`'s fuzz-iter line,
# `fuzz_gitignore --iters=$(FUZZ_ITERS) --seed=$(FUZZ_SEED)` (Makefile:
# 101-102, :2265): 200,000 iterations at seed 1, so `--campaign` does the
# same. The report line's `hash=` is C's for the same seed and
# iterations (the generator is C's bit for bit). `--against-oracle` also
# runs C's own driver (target/oracle/sagitta/build/fuzz_gitignore) with
# the same arguments and requires the two report lines to be equal byte
# for byte, and prints each side's wall time from the same run (a
# finding, not a gate); a missing C driver is exit 2, never a silent pass. Exit is
# the driver's, read directly: 0 when every input held, 1 with the
# failing input printed as hex, 2 on a usage error.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"

native=
if [ "${1:-}" = --native ]; then
    native=--native
    shift
fi
if [ "${FUZZ_PREBUILT:-0}" != 1 ]; then
    tools/build-fuzz-gitignore $native
fi
driver=target/tools/fuzz-gitignore
if [ "${1:-}" = --campaign ]; then
    shift
    oracle=0
    seeds="1"
    iters=200000
    for a in "$@"; do
        case "$a" in
        --against-oracle) oracle=1 ;;
        --seeds=*) seeds=${a#--seeds=} ;;
        --iters=*) iters=${a#--iters=} ;;
        *)
            echo "run-fuzz-gitignore: unknown argument $a" >&2
            exit 2
            ;;
        esac
    done
    c=target/oracle/sagitta/build/fuzz_gitignore
    if [ "$oracle" = 1 ] && [ ! -x "$c" ]; then
        echo "run-fuzz-gitignore: $c is not built (tools/oracle's targets must list build/fuzz_gitignore)" >&2
        exit 2
    fi
    for s in $seeds; do
        t0=$(date +%s%N)
        port_line=$("$driver" --iters="$iters" --seed="$s") || {
            echo "port: $port_line"
            exit 1
        }
        t1=$(date +%s%N)
        echo "port: $port_line"
        if [ "$oracle" = 1 ]; then
            c_line=$(cd target/oracle/sagitta && build/fuzz_gitignore --iters="$iters" --seed="$s") || {
                echo "C:    $c_line"
                exit 1
            }
            t2=$(date +%s%N)
            echo "C:    $c_line"
            # Wall time, the same run, for the note: not a gate.
            echo "time: seed $s port $(((t1 - t0) / 1000000)) ms, C $(((t2 - t1) / 1000000)) ms"
            if [ "$port_line" != "$c_line" ]; then
                echo "run-fuzz-gitignore: the port's report differs from C's at seed $s" >&2
                exit 1
            fi
        fi
    done
    exit 0
fi
exec "$driver" "$@"
