#!/usr/bin/env bash
# run-fuzz-gitignore — Sprint 26 §4's matcher fuzz (s26 Testing Strategy:
# "random pattern bytes never crash the compiler or matcher"): the input
# as a pattern, the 35 adversarial shapes, 64 random patterns and a
# 32-rule set, every answer bounded in time, one session per generated
# input.
#
#   tools/run-fuzz-gitignore [--native] [--iters=N] [--seed=N] [--answers]
#   tools/run-fuzz-gitignore --campaign [--against-oracle] [--seeds="S..."] [--iters=N]
#   tools/run-fuzz-gitignore [--native] --scale
#
# `--scale` (yew#100) is the port's own scaling row: every adversarial
# shape against paths of N, 10N and 100N bytes, red when one grows
# superlinearly (tools/fuzz-gitignore/main.lu `scale`); C has no such mode.
#
# Builds tools/fuzz-gitignore/main.lu (tools/build-fuzz-gitignore;
# FUZZ_PREBUILT=1 runs the driver already built) and runs it from the
# repository root. The defaults are sagitta's generator's (200,000
# iterations, seed 1). C's campaign is `make fuzz`'s fuzz-iter line,
# `fuzz_gitignore --iters=$(FUZZ_ITERS) --seed=$(FUZZ_SEED)` (Makefile:
# 101-102, :2265): 200,000 iterations at seed 1, so `--campaign` does the
# same. The report line's `hash=` is C's for the same seed and
# iterations (the generator is C's bit for bit). `--against-oracle` also
# runs C's own driver (target/oracle/sagitta/build/fuzz_gitignore) with
# the same arguments and requires the two report lines to be equal byte
# for byte, and prints each side's wall time from the same run (a
# finding, not a gate); a missing C driver is exit 2, never a silent pass.
# C's campaign runs once more only when it failed on its own timing bound
# (yew#171); any other C failure fails at once. Exit is
# the driver's, read directly: 0 when every input held, 1 with the
# failing input printed as hex, 2 on a usage error.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"

native=
if [ "${1:-}" = --native ]; then
    native=--native
    shift
fi
if [ "${FUZZ_PREBUILT:-0}" != 1 ]; then
    tools/build-fuzz-gitignore $native
fi
driver=target/tools/fuzz-gitignore
if [ "${1:-}" = --scale ]; then
    exec "$driver" --scale
fi
if [ "${1:-}" = --campaign ]; then
    shift
    oracle=0
    seeds="1"
    iters=200000
    for a in "$@"; do
        case "$a" in
        --against-oracle) oracle=1 ;;
        --seeds=*) seeds=${a#--seeds=} ;;
        --iters=*) iters=${a#--iters=} ;;
        *)
            echo "run-fuzz-gitignore: unknown argument $a" >&2
            exit 2
            ;;
        esac
    done
    c=target/oracle/sagitta/build/fuzz_gitignore
    if [ "$oracle" = 1 ] && [ ! -x "$c" ]; then
        echo "run-fuzz-gitignore: $c is not built (tools/oracle's targets must list build/fuzz_gitignore)" >&2
        exit 2
    fi
    # C's driver, its stderr kept to read and then echoed. C is the pinned
    # oracle and keeps its single 250 ms (1,000 ms) reading, so a hosted
    # runner's stall can fail it as it did the port (yew#171). Its campaign
    # runs once more when, and only when, it failed on its own timing bound:
    # exit 1 (fuzzlib.c's failing iteration) and exactly one FAIL line, whose
    # reason is one of fuzz_gitignore.c's two timing messages (:167-168,
    # :257-258). Any other failure, a second failure or a report mismatch
    # fails at once.
    c_err="$YEW_ROOT/target/fuzz-gitignore-c.stderr"
    c_run() {
        (cd target/oracle/sagitta && build/fuzz_gitignore --iters="$iters" --seed="$s") 2>"$c_err"
    }
    c_timing_only() {
        [ "$(LC_ALL=C grep -c ': FAIL ' "$c_err" || true)" = 1 ] &&
            LC_ALL=C grep -E -q "^fuzz_gitignore: FAIL seed=[0-9]+ iter=[0-9]+ corpus=[^ ]+ op=[^ ]+: (pattern '.*' took [0-9]+ ms against a [0-9]+-byte path|a 32-rule set took [0-9]+ ms over 32 paths)\$" "$c_err"
    }
    for s in $seeds; do
        t0=$(date +%s%N)
        port_line=$("$driver" --iters="$iters" --seed="$s") || {
            echo "port: $port_line"
            exit 1
        }
        t1=$(date +%s%N)
        echo "port: $port_line"
        if [ "$oracle" = 1 ]; then
            c_rc=0
            c_line=$(c_run) || c_rc=$?
            cat "$c_err" >&2
            if [ "$c_rc" != 0 ]; then
                echo "run-fuzz-gitignore: C's driver failed only on its own timing bound at seed $s; running its campaign once more" >&2
                c_rc=0
                c_line=$(c_run) || c_rc=$?
                cat "$c_err" >&2
            fi
            if [ "$c_rc" != 0 ]; then
                echo "C:    $c_line"
                exit 1
            fi
            t2=$(date +%s%N)
            echo "C:    $c_line"
            # Wall time, the same run, for the note: not a gate.
            echo "time: seed $s port $(((t1 - t0) / 1000000)) ms, C $(((t2 - t1) / 1000000)) ms"
            if [ "$port_line" != "$c_line" ]; then
                echo "run-fuzz-gitignore: the port's report differs from C's at seed $s" >&2
                exit 1
            fi
        fi
    done
    exit 0
fi
exec "$driver" "$@"
