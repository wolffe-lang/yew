#!/bin/sh
# sagitta Makefile:3136-3167: separate BUILD for FL_VM_TRACE=1, switch dispatch.
set -eu
YEW_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh
oracle=${1:-$YEW_ROOT/target/oracle/sagitta}
[ "$#" -le 1 ] || { echo 'usage: check-fl-trace [ORACLE_TREE]' >&2; exit 2; }
want=$(sed -n 's/^SAGITTA_REV=//p' sagitta.pin)
[ "$(git -C "$oracle" rev-parse HEAD)" = "$want" ] || { echo 'check-fl-trace: oracle pin mismatch' >&2; exit 2; }
python3 -I tools/fl-core/check-opcodes.py "$oracle"
. tools/lib-test-env.sh
test_env_begin
export YEW_RUNTIME_DIR="$YEW_ROOT/runtime"
build="$YEW_ROOT/target/fl-trace-oracle"
make --no-print-directory -s -j"${YEW_JOBS:-4}" -C "$oracle" \
  BUILD="$build" FL_CGOTO=0 CFLAGS_FL_TRACE=1 "$build/fl_smoke"
port=$(tools/build-fl-core --release)
python3 -I tools/fl-core/check-trace.py --selftest
python3 -I tools/fl-core/check-trace.py "$build/fl_smoke" "$port" target/fl-trace
