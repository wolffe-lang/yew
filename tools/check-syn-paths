#!/bin/sh
# check-syn-paths — src/edit/syn_paths.lu is tools/gen-syn-paths' output
# over the oracle's src/syn/langs_gen.c at the pin (tools/oracle fetches
# it): regenerate and compare, byte for byte. Exit 0 when they agree.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$YEW_ROOT"
gen=target/oracle/sagitta/src/syn/langs_gen.c
[ -f "$gen" ] || { echo "check-syn-paths: no $gen; run tools/oracle first" >&2; exit 2; }
mkdir -p target
python3 -I tools/gen-syn-paths "$gen" > target/syn_paths.lu.new
if cmp -s target/syn_paths.lu.new src/edit/syn_paths.lu; then
    echo "check-syn-paths: src/edit/syn_paths.lu is the pin's table"
else
    echo "check-syn-paths: src/edit/syn_paths.lu differs from tools/gen-syn-paths' output" >&2
    diff target/syn_paths.lu.new src/edit/syn_paths.lu | head -20 >&2 || true
    exit 1
fi
