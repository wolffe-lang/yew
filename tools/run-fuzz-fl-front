#!/bin/bash
# Drive the exact C generator stream; parser data-reader checks belong to D6.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
mode=${1:-lex}; shift || true
oracle=0; front=0; args=()
for arg in "$@"; do
    case "$arg" in
        --against-oracle) oracle=1;;
        --frontend-only) front=1;;
        --iters=*|--seed=*) args+=("$arg");;
        *) echo "unknown argument: $arg" >&2; exit 2;;
    esac
done
case "$mode" in
    lex) subcommand=lex-fuzz; target=fuzz_fl_lex;;
    parse)
        if [ "$front" != 1 ]; then echo 'PENDING deliverable6 fl_data_read: pass --frontend-only to test only lex/parse invariants' >&2; exit 2; fi
        subcommand=parse-fuzz-front; target=fuzz_fl_parse;;
    *) echo 'usage: run-fuzz-fl-front lex|parse [--frontend-only] [--against-oracle] [--iters=N] [--seed=N]' >&2; exit 2;;
esac
if [ "${FUZZ_PREBUILT:-0}" != 1 ]; then tools/build-fl-front; fi
port=$(target/tools/fl-front "$subcommand" "${args[@]}")
printf '%s\n' "$port"
if [ "$oracle" = 1 ]; then
    tree=${SAGITTA_TREE:-target/oracle/sagitta}
    c=$(cd "$tree"; "build/$target" "${args[@]}")
    printf '%s\n' "$c"
    # Prefix normalization compares INPUT STREAMS only. For parse, the port
    # plainly says frontend and the pending data checks remain a hard default.
    canonical=${port/fuzz_fl_parse_frontend:/fuzz_fl_parse:}
    if [ "$canonical" != "$c" ]; then echo 'FAIL: oracle/port fuzz stream report differs' >&2; exit 1; fi
    echo 'PASS: oracle/port generated input stream reports identical'
fi
