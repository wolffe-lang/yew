#!/usr/bin/env python3
"""Classify a measured ratio against the committed, host-scoped MISS ledger."""
from pathlib import Path
import math
import platform
import re
import sys

METRICS = {"startup.first_paint.default", "startup.first_paint.clean", "startup.first_paint.dumb",
           "startup.first_paint.workspace50", "cold_open_to_first_paint", "keypress_to_paint_p99",
           "cursor_arrow_to_paint_p99", "cursor_arrow_to_paint_p99_paced",
           "wolf_kitty_first_backspace_to_paint", "wolf_kitty_backspace_to_paint_max",
           "panes.tabswitch.p99"}
HOSTS = {"linux-x86_64", "linux-aarch64", "darwin-arm64"}

def ledger(text):
    rows = {}
    for number, line in enumerate(text.splitlines(), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        fields = line.split()
        if len(fields) != 4:
            raise ValueError(f"MISS ledger line {number}: expected four fields")
        metric, host, owner, issue = fields
        if metric not in METRICS or host not in HOSTS or not re.fullmatch(r"(?:yw|s)[0-9]+", owner):
            raise ValueError(f"MISS ledger line {number}: unknown metric, host or owner")
        if not issue.startswith("yew#") or not issue[4:].isdigit() or (metric, host) in rows:
            raise ValueError(f"MISS ledger line {number}: missing issue or duplicate row")
        rows[metric, host] = owner, issue
    return rows

def verdict(rows, metric, ratio, host):
    if metric not in METRICS or not math.isfinite(ratio) or ratio < 0:
        raise ValueError("unknown metric or invalid ratio")
    if ratio <= 2.0 or host == "darwin-arm64":
        return "PASS"
    if (metric, host) in rows:
        owner, issue = rows[metric, host]
        detail = ""
        if issue == "yew#55":
            detail = " upstream=wolf-lang#918 reason=0.2.35-pin-regression remeasure=next-pin"
        return f"MISS owner={owner} issue={issue} host={host}{detail}"
    return "FAIL"

def selftest():
    line = "wolf_kitty_first_backspace_to_paint linux-x86_64 yw15 yew#53"
    rows = ledger(line)
    key = "wolf_kitty_first_backspace_to_paint"
    assert verdict(rows, key, 2.53, "linux-x86_64").startswith("MISS owner=yw15 issue=yew#53")
    assert verdict(rows, key, 1.9, "linux-x86_64") == "PASS"
    assert verdict(rows, key, 2.53, "darwin-arm64") == "FAIL"
    assert verdict(rows, "cold_open_to_first_paint", 2.01, "linux-x86_64") == "FAIL"
    assert verdict({}, key, 2.53, "linux-x86_64") == "FAIL"
    for bad in (line + "\n" + line, line.replace(key, "unknown"), line.replace("yew#53", "none")):
        try:
            ledger(bad)
        except ValueError:
            pass
        else:
            raise AssertionError("malformed ledger accepted")
    try:
        verdict(rows, key, float("nan"), "linux-x86_64")
    except ValueError:
        pass
    else:
        raise AssertionError("NaN accepted")
    pin = ledger("\n".join(f"{metric} linux-x86_64 s265 yew#55" for metric in
                           ("startup.first_paint.clean", "cold_open_to_first_paint", "panes.tabswitch.p99")))
    for metric in ("startup.first_paint.clean", "cold_open_to_first_paint", "panes.tabswitch.p99"):
        assert verdict(pin, metric, 2.10, "linux-x86_64").startswith("MISS owner=s265 issue=yew#55")
        assert "upstream=wolf-lang#918" in verdict(pin, metric, 2.10, "linux-x86_64")
        assert verdict(pin, metric, 2.0, "linux-x86_64") == "PASS"
        assert verdict(pin, metric, 2.10, "darwin-arm64") == "FAIL"
        assert verdict({}, metric, 2.10, "linux-x86_64") == "FAIL"
    assert verdict(pin, "keypress_to_paint_p99", 2.10, "linux-x86_64") == "FAIL"
    print("perf-editor-verdict: original nine and pin-MISS boundary/host/metric controls PASS")

def main():
    if sys.argv[1:] == ["--selftest"]:
        selftest()
        return 0
    if len(sys.argv) != 3:
        raise ValueError("usage: perf-editor-verdict METRIC RATIO | --selftest")
    rows = ledger(Path(__file__).with_name("perf-editor-misses.txt").read_text())
    host = platform.system().lower() + "-" + platform.machine().lower()
    print(verdict(rows, sys.argv[1], float(sys.argv[2]), host))
    return 0

if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, OSError) as error:
        print("perf-editor-verdict: " + str(error), file=sys.stderr)
        sys.exit(2)
