#!/usr/bin/env bash
# run-fuzz-fl-std — Sprint 31's stdlib fuzz (s31 DoD 3 and 8): random
# arguments through every `str` and `fmt` native and the input as a fmt.f
# template; every outcome a value or one of the 13 kinds of
# tests/fuzz/fl_kinds.h.
#
#   tools/run-fuzz-fl-std [--native] [--against-oracle] [--iters=N] [--seed=N]
#
# Builds tools/fuzz-fl-std/main.lu (tools/build-fuzz-fl-std; FUZZ_PREBUILT=1
# runs the driver already built) and runs it from the repository root. The
# defaults are sagitta's (200,000 iterations, seed 1: `make fuzz-iter`,
# Makefile:2268). `--against-oracle` also runs C's own driver
# ($SAGITTA_TREE/build/fuzz_fl_std, default target/oracle/sagitta, which
# tools/oracle builds) with the same arguments and requires the two report
# lines to be equal byte for byte; a missing C driver is exit 2, never a
# silent pass. Exit is the driver's: 0 when every input held, 1 with the
# failing input printed as hex, 2 on a usage error.
set -euo pipefail
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
native=; oracle=0; args=()
for a in "$@"; do
    case "$a" in
    --native) native=--native ;;
    --against-oracle) oracle=1 ;;
    --iters=*|--seed=*) args+=("$a") ;;
    *) echo "run-fuzz-fl-std: unknown argument $a" >&2; exit 2 ;;
    esac
done
tree=${SAGITTA_TREE:-target/oracle/sagitta}
if [ "$oracle" = 1 ] && [ ! -x "$tree/build/fuzz_fl_std" ]; then
    echo "run-fuzz-fl-std: $tree/build/fuzz_fl_std is not built (tools/oracle builds it)" >&2
    exit 2
fi
if [ "${FUZZ_PREBUILT:-0}" != 1 ]; then tools/build-fuzz-fl-std $native; fi
port=$(target/tools/fuzz-fl-std "${args[@]}") || { echo "port: $port"; exit 1; }
echo "port: $port"
if [ "$oracle" = 1 ]; then
    c=$(cd "$tree" && build/fuzz_fl_std "${args[@]}") || { echo "C:    $c"; exit 1; }
    echo "C:    $c"
    if [ "$port" != "$c" ]; then
        echo "run-fuzz-fl-std: the port's report differs from C's" >&2
        exit 1
    fi
    echo "PASS: oracle/port report lines identical"
fi
