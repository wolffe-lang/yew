#!/usr/bin/env bash
# run-fuzz-shctx — sagitta's fuzz_shctx at the pin, ported: the shell
# context lexer under arbitrary bytes: every caret of every input lexed
# three ways, with and without an environment, every stem quoted in
# every state, and the :! point parser's rebasing.
#
#   tools/run-fuzz-shctx [--iters=N] [--seed=N]
#   tools/run-fuzz-shctx --campaign [--against-oracle]
#
# Builds tools/fuzz-shctx/main.lu on the release tier
# (tools/build-fuzz-shell shctx) and runs it from the repository root with
# the arguments given (FUZZ_PREBUILT=1: the driver already built); the
# defaults are sagitta's generator's (200,000 iterations, seed 1).
# `--campaign` is sagitta's `make fuzz-shctx`: 1000000 iterations at seed 1
# (SHCTX_FUZZ_ITERS, Makefile:148). The report line's `hash=` is C's for the same seed and
# iterations (tools/fuzzgen is fuzzlib.c's generator bit for bit, the
# guided corpus tests/fuzz/corpus/fuzz_shctx/ verbatim). Exit is the
# driver's, read directly: 0 when every input held, 1 with the failing
# input printed as hex, 2 on a usage error. `--against-oracle` also runs
# C's own driver (target/oracle/sagitta/build/fuzz_shctx, which tools/oracle
# builds) with the same arguments and requires the two report lines to be
# equal byte for byte: the same inputs, both green; a missing C driver is
# exit 2, never a silent pass. Both run from the repository root and from
# the oracle tree respectively, each reading its own verbatim corpus.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"

if [ "${FUZZ_PREBUILT:-0}" != 1 ]; then
    tools/build-fuzz-shell shctx
fi
driver=target/tools/fuzz-shctx
if [ "${1:-}" = --campaign ]; then
    if [ "${2:-}" = --against-oracle ]; then
        c=target/oracle/sagitta/build/fuzz_shctx
        if [ ! -x "$c" ]; then
            echo "run-fuzz-shctx: $c is not built (tools/oracle's targets must list build/fuzz_shctx)" >&2
            exit 2
        fi
        port_line=$("$driver" --iters=1000000 --seed=1) || {
            echo "port: $port_line"
            exit 1
        }
        c_line=$(cd target/oracle/sagitta && build/fuzz_shctx --iters=1000000 --seed=1) || {
            echo "C:    $c_line"
            exit 1
        }
        echo "port: $port_line"
        echo "C:    $c_line"
        if [ "$port_line" != "$c_line" ]; then
            echo "run-fuzz-shctx: the port's report differs from C's" >&2
            exit 1
        fi
        exit 0
    fi
    exec "$driver" --iters=1000000 --seed=1
fi
exec "$driver" "$@"
