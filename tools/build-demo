#!/bin/sh
# build-demo — the first-paint fixture, tools/demo-paint/main.lu, built on
# the release tier into target/tools/demo_paint.
#
#   tools/build-demo [--native]
#
# `use term` resolves beside the ENTRY file (D32), so the port's modules
# are staged beside a copy of the fixture under target/demo/ — the shape
# tools/run-perf-unicode uses. Nothing there is committed. The fixture is
# what `tools/goldens --demo target/tools/demo_paint` runs sagitta's
# campaign-01 PTY cases against (M-YW1), and the twelve `s15_*` scenes
# (yw03), which draw through the staged `edit` module.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

tier=release
case "${1:-}" in
"") ;;
--native) tier=native ;;
*)
    echo "build-demo: unknown option $1" >&2
    exit 2
    ;;
esac

stage=$YEW_ROOT/target/demo
rm -rf "$stage"
mkdir -p "$stage" target/tools
cp tools/demo-paint/main.lu "$stage/main.lu"
for m in util unicode term text ws edit; do
    cp -R "src/$m" "$stage/$m"
    rm -f "$stage/$m"/*_test.lu
done
if [ "$tier" = release ]; then
    "$WOLF" build --release --deny-warnings "$stage/main.lu" -o target/tools/demo_paint
else
    "$WOLF" build --deny-warnings "$stage/main.lu" -o target/tools/demo_paint
fi
echo "build-demo: target/tools/demo_paint ($tier)"
