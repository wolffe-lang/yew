case("move-redo", "aa\nbb\ncc", DOWN + ADOWN + UNDO + REDO, "aa\ncc\nbb")
case("move-top-noop", "aa\nbb", AUP + b"X", "Xaa\nbb")
case("move-bottom-noop", "aa\nbb", DOWN + ADOWN + b"X", "aa\nXbb")
case("retain-H-I-alt", "aa\nbb\ncc\ndd", SDOWN * 2 + ADOWN, "aa\nbb\ncc\ndd")
case("retain-H-I-alt-twice", "aa\nbb\ncc\ndd", SDOWN * 2 + ADOWN * 2, "aa\nbb\ncc\ndd")
case("move-unicode-column", "ab\n漢é\ncd", DOWN + RIGHT + ADOWN + b"X", "ab\ncd\n漢Xé")
for mode, enter in [("L", b""), ("W", b"w"), ("B", b"b")]:
    for direction, arrow in [("up", AUP), ("down", ADOWN)]:
        actions = [DOWN, ESC] + ([enter] if enter else []) + [arrow, b"i", b"X"]
        case("retain-" + mode + "-alt-" + direction, "aa\nbb\ncc", actions, "aa\nXbb\ncc")
for mode, enter in [("L", []), ("W", [b"w"]), ("B", [b"b"])]:
    for direction, arrow in [("up", AUP), ("down", ADOWN)]:
        actions = [DOWN, ESC] + enter + [b"h", arrow]
        case("retain-H-" + mode + "-alt-" + direction, "aa\nbb\ncc", actions, "aa\nbb\ncc")
# One tab-strip row; reports use 1-based cells.
def click(row):
    return f"\x1b[<0;40;{row + 1}M\x1b[<0;40;{row + 1}m".encode()
for tag, initial, row, expected in [
    ("last-closer", "aa\n}", 2, "aa\n}X"),
    ("last-letter", "aa\nx", 2, "aa\nxX"),
    ("last-long", "aa\nlong}", 2, "aa\nlong}X"),
    ("nonlast-single", "}\naa", 1, "}X\naa"),
    ("nonlast-letter", "x\naa", 1, "xX\naa"),
    ("last-with-eol", "aa\n}\n", 2, "aa\n}X\n"),
    ("last-unicode", "aa\n漢é", 2, "aa\n漢éX"),
    ("last-combining", "aa\né", 2, "aa\néX"),
    ("empty-final", "aa\n", 2, "aa\nX"),
]:
    case("click-" + tag, initial, click(row) + b"X", expected)
case("click-last-closer-L", "aa\n}", [ESC, click(2), b"iX"], "aa\n}X")

# yew#128: a plain click on another tab or pane moves focus without
# leaving Insert; the run's edit group must stay on its own buffer, or Esc
# ends a group the clicked buffer never opened ("undo: unbalanced end").
# The run starts in other.txt, opened as tab 2; the click lands on cell 5
# of the strip, inside tab 1's label (" 1 fixture.txt" starts the strip).
# A vertical split leaves column 10 of text row 1 in the left pane. Each
# click is one press and one release.
def press_release(col, row):
    return [f"\x1b[<0;{col};{row}M".encode(), f"\x1b[<0;{col};{row}m".encode()]
OTHER = {"other.txt": "two\n"}
for enc, esc in [("legacy", ESC), ("kitty", KITTY_ESC)]:
    tab = [ESC, ":tabedit other.txt", b"i", b"abc"] + press_release(5, 1) + [b"def", esc]
    case("insert-tab-click-" + enc, "one\n", tab, "defone\n", extra=OTHER)
    case("insert-tab-click-undo-" + enc, "one\n", tab + [b"u"], "one\n", extra=OTHER)
    pane = [ESC, b"\x17", b"v", ":e other.txt", b"i", b"abc"] + press_release(10, 2) + [b"def", esc]
    case("insert-pane-click-" + enc, "one\n", pane, "onedef\n", extra=OTHER)
    case("insert-pane-click-undo-" + enc, "one\n", pane + [b"u"], "one\n", extra=OTHER)

# Collapsed-caret additions in document modes; H selections stay held.
CAUP, CADOWN = b"\x1b[1;7A", b"\x1b[1;7B"
ALT_CLICK = b"\x1b[<8;1;3M\x1b[<8;1;3m"
for mode, enter in [("L", [ESC]), ("W", [ESC, b"w"]),
                    ("B", [ESC, b"b"]), ("I", [])]:
    insert = [b"i"] if mode != "I" else []
    case("cursor-down-" + mode, "aa\nbb\ncc", enter + [CADOWN] + insert + [b"X"], "Xaa\nXbb\ncc")
    case("cursor-up-" + mode, "aa\nbb\ncc", [DOWN] + enter + [CAUP] + insert + [b"X"], "Xaa\nXbb\ncc")
    case("cursor-repeat-" + mode, "aa\nbb\ncc", enter + [CADOWN, CADOWN] + insert + [b"X"], "Xaa\nXbb\nXcc")
    case("cursor-alt-click-" + mode, "aa\nbb\ncc", enter + [ALT_CLICK] + insert + [b"X"], "Xaa\nXbb\ncc")
case("cursor-reverse", "aa\nbb\ncc", [CADOWN, CADOWN, CAUP, b"X"], "Xaa\nXbb\nXcc")
case("cursor-alt-click-dedup", "aa\nbb\ncc", [CADOWN, ALT_CLICK, b"X"], "Xaa\nXbb\ncc")
case("cursor-alt-double-word", "aa\nbb\ncc", [ALT_CLICK, ALT_CLICK, b"d"], "aa\n\ncc")
case("cursor-short-goal", "abcd\nx\nabcd", [RIGHT * 3, CADOWN, CADOWN, b"X"], "abcXd\nxX\nabcXd")
case("cursor-key-primary-only", "aa\nbb\ncc", [ESC, CADOWN, ":cursor-only", b"iX"], "aa\nXbb\ncc")
case("cursor-aliases", "aa\nbb\ncc", [":cursor-below", ":cursor-below", ":cursor-drop", ":cursor-only", b"iX"], "Xaa\nbb\ncc")

class SessionError(Exception):
    """A startup, terminal-I/O or editor-exit failure, named by its row."""


class Session:
    def __init__(self, yew, cwd, env, log):
        self.raw = bytearray()
        self.log = log
        self.status = None
        pid, fd = pty.fork()
        if pid == 0:
            os.chdir(cwd)
            os.execve(yew, [yew, "fixture." + env.pop("ROW_SUFFIX")], env)
        self.pid, self.fd = pid, fd
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 24, 80, 0, 0))

    def pump(self, seconds):
        end = time.monotonic() + seconds
        while time.monotonic() < end:
            if not select.select([self.fd], [], [], max(0, end - time.monotonic()))[0]:
                break
            try:
                data = os.read(self.fd, 65536)
            except OSError:
                break
            if not data:
                break
            self.raw += data
            self.log.write(data)

    def send(self, data):
        if not self.alive():
            raise SessionError(f"editor exited before input (wait status {self.status})")
        try:
            os.write(self.fd, data)
        except OSError as error:
            raise SessionError(f"terminal write failed: {error}") from error
        self.pump(0.12)

    def alive(self):
        if self.status is None:
            pid, status = os.waitpid(self.pid, os.WNOHANG)
            if pid:
                self.status = status
        return self.status is None

    def ex(self, command):
        for _ in range(3):
            if not self.alive():
                return False
            self.send(ESC)
            mark = len(self.raw)
            self.send(b":")
            end = time.monotonic() + 3
            while not CMDLINE.search(self.raw, mark) and self.alive() and time.monotonic() < end:
                self.pump(0.05)
            if CMDLINE.search(self.raw, mark):
                self.send(command.encode() + b"\r")
                self.pump(0.25)
                return True
        return False

    def quit(self):
        try:
            for _ in range(3):
                if not self.alive():
                    break
                self.ex("q!")
                end = time.monotonic() + 2
                while self.alive() and time.monotonic() < end:
                    self.pump(0.05)
        except SessionError:
            pass
        gone = not self.alive()
        os.close(self.fd)  # hang up only this row's own terminal
        if not gone:
            # A failed terminal must not hang the complete suite. SIGHUP
            # follows closing our PTY; record any unreaped child by pid.
            end = time.monotonic() + 2
            while self.alive() and time.monotonic() < end:
                time.sleep(0.02)
            if self.alive():
                print(f"  unreaped editor pid={self.pid}", flush=True)
        return gone


def run(args, row):
    name, original, keys, expected, suffix = row[:5]
    extra = row[5] if len(row) > 5 else {}
    keep = Path(args.keep).resolve()
    keep.mkdir(parents=True, exist_ok=True)
    root = Path(tempfile.mkdtemp(prefix=name + "-", dir=keep))
    fixture = root / ("fixture." + suffix)
    fixture.write_bytes(original)
    for other, data in extra.items():
        (root / other).write_bytes(data)
    for d in ["home", "state", "config", "cache", "tmp"]:
        (root / d).mkdir(exist_ok=True)
    env = os.environ.copy()
    env.update(HOME=str(root / "home"), XDG_STATE_HOME=str(root / "state"),
               XDG_CONFIG_HOME=str(root / "config"), XDG_CACHE_HOME=str(root / "cache"),
               TMPDIR=str(root / "tmp"), SHELL="/bin/sh", TERM=args.term,
               YEW_LOG=str(root / "yew.log"), ROW_SUFFIX=suffix)
    ok = True
    error = ""
    with (root / "pty.raw").open("wb") as log:
        s = None
        try:
            s = Session(str(Path(args.yew).resolve()), str(root), env, log)
            s.pump(0.8)
            # No startup config from HOME; disable carried indentation.
            ok = s.ex("set autoindent false") and ok
            s.send(b"i")
            # Keep ESC chords in one write, but distinct user actions in
            # separate turns (especially multiple Alt keys and Ctrl+Z).
            parts = keys if isinstance(keys, list) else re.findall(rb"\x1b(?:\[[0-9;]*[A-Za-z~]|\[<\d+;\d+;\d+[Mm]|.)|[^\x1b]", keys)
            for part in parts:
                if isinstance(part, str):
                    ok = s.ex(part[1:]) and ok
                else:
                    s.send(part)
            ok = s.ex("w") and ok
        except (SessionError, OSError) as failure:
            ok = False
            error = str(failure)
        finally:
            if s is not None:
                try:
                    ok = s.quit() and ok
                except OSError as failure:
                    ok = False
                    error = str(failure)
    actual = fixture.read_bytes()
    if actual != expected or not ok:
        print(f"FAIL {name} expected={expected!r} actual={actual!r} session_ok={ok} error={error!r} artifacts={root}", flush=True)
        return False
    print(f"PASS {name}", flush=True)
    return True


def selftest(args):
    root = Path(args.keep).resolve() / "harness-selftest"
    root.mkdir(parents=True, exist_ok=True)
    bad = root / "exit-seven"
    bad.write_text("#!/bin/sh\nexit 7\n")
    bad.chmod(0o700)
    probe = copy.copy(args)
    probe.yew = str(bad)
    captured = io.StringIO()
    original = globals()["Session"]

    class MockSession:
        def __init__(self, *unused):
            pass
        def pump(self, seconds):
            pass
        def ex(self, command):
            return True
        def send(self, data):
            raise OSError("planted terminal write failure")
        def quit(self):
            return True

    class GoodSession(MockSession):
        def send(self, data):
            pass

    with contextlib.redirect_stdout(captured):
        results = [run(probe, ("harness-startup-failure", b"", b"X", b"", "txt"))]
        try:
            globals()["Session"] = MockSession
            results.append(run(probe, ("harness-write-failure", b"", b"X", b"", "txt")))
            globals()["Session"] = GoodSession
            results.append(run(probe, ("harness-after-crash", b"", b"X", b"", "txt")))
        finally:
            globals()["Session"] = original
    output = captured.getvalue()
    assert results == [False, False, True], (results, output)
    assert "FAIL harness-startup-failure" in output and "FAIL harness-write-failure" in output, output
    assert "PASS harness-after-crash" in output, output
    print("PASS harness-selftest: startup and write failures are named; later rows still run")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("yew")
    ap.add_argument("--keep", default="target/editing-row")
    ap.add_argument("--case", action="append", default=[])
    ap.add_argument("--term", default="xterm-256color")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    args = ap.parse_args()
    if args.selftest:
        return selftest(args)
    if args.list:
        print("\n".join(r[0] for r in CASES))
        return 0
    unknown = set(args.case) - {r[0] for r in CASES}
    if unknown:
        ap.error("unknown cases: " + ", ".join(sorted(unknown)))
    red = 0
    for row in CASES:
        if not args.case or row[0] in args.case:
            red += not run(args, row)
    print(f"editing-row: {'RED' if red else 'GREEN'} ({red} failed)", flush=True)
    return int(bool(red))

if __name__ == "__main__":
    sys.exit(main())
