#!/usr/bin/env python3
"""Compare pinned C CLI AST bytes, diagnostics and exit status, twice."""
import argparse
from pathlib import Path
import subprocess
p=argparse.ArgumentParser()
p.add_argument('--oracle-tree',required=True,type=Path)
p.add_argument('--oracle-driver',required=True,type=Path)
p.add_argument('--driver',type=Path,default=Path('target/tools/fl-front'))
p.add_argument('--output',type=Path,default=Path('target/front/differential'))
a=p.parse_args(); a.output.mkdir(parents=True,exist_ok=True)
files=sorted(a.oracle_tree.glob('tests/fletch/**/*.fl'))
for corpus in ('fl_parse','fl_std','fl_vm'):
    files+=sorted(f for f in (a.oracle_tree/'tests/fuzz/corpus'/corpus).rglob('*') if f.is_file())
assert len(files)==89, f'expected 56 + 23 + 3 + 7 files, got {len(files)}'
rows=[]; failed=False
for index,path in enumerate(files):
    oracle=subprocess.run([str(a.oracle_driver.resolve()),'ast',str(path)],stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=30)
    first=subprocess.run([str(a.driver.resolve()),'ast',str(path)],stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=30)
    second=subprocess.run([str(a.driver.resolve()),'ast',str(path)],stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=30)
    expected=(oracle.returncode,oracle.stdout,oracle.stderr)
    ok=expected==(first.returncode,first.stdout,first.stderr)==(second.returncode,second.stdout,second.stderr)
    relative=str(path.relative_to(a.oracle_tree))
    rows.append(f'{"PASS" if ok else "FAIL"}\t{relative}\t{oracle.returncode}\t{first.returncode}\t{len(oracle.stdout)}\n')
    print(rows[-1],end='',flush=True)
    if not ok:
        failed=True
        for who,result in (('C',oracle),('port',first),('again',second)):
            for stream in ('stdout','stderr'):
                (a.output/f'{index:02}-{who}.{stream}').write_bytes(getattr(result,stream))
(a.output/'rows.tsv').write_text('verdict\tinput\tC_exit\tport_exit\tAST_bytes\n'+''.join(rows))
print(f'frontend differential: {len(files)} files; {sum(r.startswith("PASS") for r in rows)} pass; two port processes each')
raise SystemExit(failed)
