#!/usr/bin/env bash
# run-fuzz-fuzzy — sagitta's fuzz_fuzzy over the port's ws.fuzzy: the
# fuzzy scorer and ranker under a bounded, seeded random driver.
#
#   tools/run-fuzz-fuzzy [--iters N] [--seed S]
#
# Builds tools/fuzz-fuzzy/main.lu on the release tier beside a copy of
# every module directory under src/ (D32: `use` resolves under the
# entry's directory; since yw06 `ws` imports `util` and `text`, and
# `text` imports `term`, so a copy of `ws` and `unicode` alone no longer
# builds) and runs it. The defaults are sagitta's `make fuzz
# FUZZ_ITERS=200000 FUZZ_SEED=1`. Exit is the driver's: 0 when every
# input held fuzz_fuzzy's properties, 1 with the failing input in hex.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

stage=$YEW_ROOT/target/fuzz-fuzzy
rm -rf "$stage"
mkdir -p "$stage"
cp tools/fuzz-fuzzy/main.lu "$stage/main.lu"
for d in src/*/; do cp -R "$d" "$stage/$(basename "$d")"; done
find "$stage" -name '*_test.lu' -delete
"$WOLF" build --release --deny-warnings "$stage/main.lu" -o "$stage/fuzz-fuzzy"
exec "$stage/fuzz-fuzzy" "$@"
