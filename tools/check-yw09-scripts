#!/usr/bin/env python3
"""Hold yw09's script gate to the pinned tests/script/ (R-yw09-5 A).

tools/scripts-yw09.txt (69: 00-47 and the 21 macroux_*) and
tools/scripts-deferred.txt (25, each with its later owner) must partition
the pin's 94 tests/script/*.fl files exactly, the gate in the runner's
bytewise discovery order. No script is modified.
"""
from collections import Counter
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parent.parent
OWNED = re.compile(r"^([0-4][0-9]_|macroux_)")


def names(path):
    out = []
    for line in path.read_text().splitlines():
        if not line or line.startswith("#"):
            continue
        out.append(line.split("\t")[0])
    return out


def differences(gate, deferred, pinned):
    errors = []
    want_gate = [n for n in pinned if OWNED.match(n)]
    if len(gate) != 69:
        errors.append("gate count=%d, expected 69" % len(gate))
    if len(deferred) != 25:
        errors.append("deferred count=%d, expected 25" % len(deferred))
    both = gate + deferred
    duplicate = sorted(k for k, count in Counter(both).items() if count > 1)
    if duplicate:
        errors.append("duplicates=" + ",".join(duplicate))
    missing = sorted(set(pinned) - set(both))
    extra = sorted(set(both) - set(pinned))
    if missing:
        errors.append("missing=" + ",".join(missing))
    if extra:
        errors.append("extra=" + ",".join(extra))
    stray = sorted(n for n in deferred if OWNED.match(n))
    if stray:
        errors.append("owned names deferred=" + ",".join(stray))
    if not missing and not extra and not duplicate and gate != want_gate:
        errors.append("gate order differs from the runner's bytewise order")
    return errors


if sys.argv[1:] not in ([], ["--selftest"]):
    sys.exit("usage: check-yw09-scripts [--selftest]")
tree = ROOT / "target/oracle/sagitta/tests/script"
if not tree.is_dir():
    sys.exit("check-yw09-scripts: no pinned oracle tree; run tools/oracle first")
pinned = sorted((p.name[:-3] for p in tree.glob("*.fl")), key=lambda s: s.encode())
if len(pinned) != 94:
    sys.exit("check-yw09-scripts: the pin no longer has 94 scripts (%d)" % len(pinned))
gate = names(ROOT / "tools/scripts-yw09.txt")
deferred = names(ROOT / "tools/scripts-deferred.txt")
errors = differences(gate, deferred, pinned)
if errors:
    sys.exit("check-yw09-scripts: " + "; ".join(errors))
if sys.argv[1:]:
    plants = {
        "missing": (gate[:-1], deferred),
        "duplicate": (gate, deferred[:-1] + [gate[0]]),
        "foreign": (gate[:-1] + ["99_invented"], deferred),
        "owned-deferred": (gate[1:], deferred + [gate[0]]),
        "reordered": ([gate[1], gate[0]] + gate[2:], deferred),
    }
    for name, (g, d) in plants.items():
        found = differences(g, d, pinned)
        if not found:
            sys.exit("check-yw09-scripts: selftest missed " + name)
        print("check-yw09-scripts: plant " + name + " caught: " + "; ".join(found))
print("check-yw09-scripts: 69 gated + 25 deferred = the pin's 94, in order")
