#!/usr/bin/env bash
# run-fuzz-tabs — Sprint 23's tab oracle (s23 DoD 2): random open, close,
# switch and reorder sequences against a naive oracle of ids in visible
# order, the whole id list and the ACTIVE id compared after EVERY
# operation.
#
#   tools/run-fuzz-tabs [--native] [--iters=N] [--seed=N]
#   tools/run-fuzz-tabs --campaign [--against-oracle] [--seeds="S..."]
#
# Builds tools/fuzz-tabs/main.lu (tools/build-fuzz-tabs; FUZZ_PREBUILT=1
# runs the driver already built) and runs it from the repository root.
# The defaults are sagitta's generator's (200,000 iterations, seed 1;
# `make fuzz-iter` runs fuzz_tabs at FUZZ_ITERS, FUZZ_SEED, Makefile:2261).
# s23 DoD 2 asks for 10,000 operations with the seed pinned and one random
# lane: one session is 80 to 159 operations, so a campaign of 10,000
# sessions is ~1,200,000. `--campaign` runs 10,000 sessions at each seed
# of `--seeds` (default "1 random": the pinned seed, then a seed drawn
# from /dev/urandom and printed first, so a red random lane is
# reproducible with --seed); the report line's `hash=` is C's for the same
# seed and iterations (the generator is C's bit for bit). `--against-
# oracle` also runs C's own driver (target/oracle/sagitta/build/fuzz_tabs,
# which tools/oracle builds) with the same arguments and requires the two
# report lines to be equal byte for byte; a missing C driver is exit 2,
# never a silent pass. Exit is the driver's, read directly: 0 when every
# input held, 1 with the failing input printed as hex, 2 on a usage error.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"

native=
if [ "${1:-}" = --native ]; then
    native=--native
    shift
fi
if [ "${FUZZ_PREBUILT:-0}" != 1 ]; then
    tools/build-fuzz-tabs $native
fi
driver=target/tools/fuzz-tabs
if [ "${1:-}" = --campaign ]; then
    shift
    oracle=0
    seeds="1 random"
    for a in "$@"; do
        case "$a" in
        --against-oracle) oracle=1 ;;
        --seeds=*) seeds=${a#--seeds=} ;;
        *)
            echo "run-fuzz-tabs: unknown argument $a" >&2
            exit 2
            ;;
        esac
    done
    c=target/oracle/sagitta/build/fuzz_tabs
    if [ "$oracle" = 1 ] && [ ! -x "$c" ]; then
        echo "run-fuzz-tabs: $c is not built (tools/oracle's targets must list build/fuzz_tabs)" >&2
        exit 2
    fi
    for s in $seeds; do
        if [ "$s" = random ]; then
            s=$(od -An -N4 -tu4 /dev/urandom | tr -d ' ')
            echo "run-fuzz-tabs: the random lane is seed $s"
        fi
        port_line=$("$driver" --iters=10000 --seed="$s") || {
            echo "port: $port_line"
            exit 1
        }
        echo "port: $port_line"
        if [ "$oracle" = 1 ]; then
            c_line=$(cd target/oracle/sagitta && build/fuzz_tabs --iters=10000 --seed="$s") || {
                echo "C:    $c_line"
                exit 1
            }
            echo "C:    $c_line"
            if [ "$port_line" != "$c_line" ]; then
                echo "run-fuzz-tabs: the port's report differs from C's at seed $s" >&2
                exit 1
            fi
        fi
    done
    exit 0
fi
exec "$driver" "$@"
