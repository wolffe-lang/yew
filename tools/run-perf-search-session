#!/usr/bin/env bash
# run-perf-search-session — the editor's search latency over both binaries
# (yw04 contract deliverable 5, s56's `latency.search.huge.p99`): sagitta's
# own `perf_latency_s56` driving `tests/perf/sessions/search.keys` (10,000
# keys of incremental search over the 100 MB `100m-code` fixture) against
# C yew, the port, then C again (the rig's drift), each row's port/C ratio
# printed; the gate is the p99's (the 2× rule, ruling #89 R3), the p50 and
# the max are recorded beside it.
#
#   tools/run-perf-search-session [--yew BIN] [--c-yew BIN] [--cpus 0-3]
#
# The harness SIGKILLs a child that does not quit (`live_pty.c:489-501`):
# run this inside the container (sprints/RULES.md §5). It needs the oracle
# tree's `perf_latency_s56` and `gen-bigfile` (tools/oracle builds them).
# Exit 0 when the p99 ratio is within 2.0, 1 above, 2 on a harness fault.
set -u
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$YEW_ROOT"
yew=$YEW_ROOT/target/release/yew
tree=$YEW_ROOT/target/oracle/sagitta
c_yew=$tree/build/yew
cpus=
while [ $# -gt 0 ]; do
  case $1 in
    --yew) yew=$2; shift 2 ;;
    --c-yew) c_yew=$2; shift 2 ;;
    --cpus) cpus=$2; shift 2 ;;
    *) echo "run-perf-search-session: unknown argument $1" >&2; exit 2 ;;
  esac
done
case $yew in /*) ;; *) yew=$YEW_ROOT/$yew ;; esac
h=$tree/build/perf_latency_s56
for f in "$h" "$tree/build/gen-bigfile" "$yew" "$c_yew"; do
  [ -x "$f" ] || { echo "run-perf-search-session: missing $f" >&2; exit 2; }
done
out=$YEW_ROOT/target/perf-search-session
mkdir -p "$out/fixtures"
fix=$out/fixtures/100m-code.bin
[ -s "$fix" ] || "$tree/build/gen-bigfile" --profile 100m-code --size 104857600 \
  --seed 0x9e3779b97f4a7c15 --output "$fix" || exit 2
pin=
[ -n "$cpus" ] && pin="taskset -c $cpus"
run() {
  local tag=$1 bin=$2 state=$out/state-$1
  rm -rf "$state"; mkdir -p "$state"
  (cd "$tree" && YEW_RUNTIME_DIR="$tree/runtime" YEW_PERF_ADVISORY=1 $pin "$h" --yew "$bin" \
    --session tests/perf/sessions/search.keys --fixture huge --path "$fix" --state "$state") \
    >"$out/$tag.txt" 2>&1
  echo "== $tag ($bin, $(sha256sum "$bin" | cut -c1-12))"
  grep '^latency\.search\.huge\.' "$out/$tag.txt" || { cat "$out/$tag.txt"; return 1; }
}
run c1 "$c_yew" || exit 2
run port "$yew" || exit 2
run c2 "$c_yew" || exit 2
val() { awk -v k="latency.search.huge.$2" '$1 == k { print $2; exit }' "$out/$1.txt"; }
status=0
for m in p99 p50 max; do
  c1=$(val c1 $m); w=$(val port $m); c2=$(val c2 $m)
  r=$(awk -v w="$w" -v a="$c1" -v b="$c2" 'BEGIN { c = (a + b) / 2; printf "%.2f", w / c }')
  d=$(awk -v a="$c1" -v b="$c2" 'BEGIN { m = (a < b) ? a : b; printf "%.2f", (a > b ? a : b) / m }')
  echo "search-session: $m C=$c1,$c2 port=$w ratio=$r drift=$d"
  if [ "$m" = p99 ] && awk -v r="$r" 'BEGIN { exit !(r > 2.0) }'; then status=1; fi
done
exit $status
