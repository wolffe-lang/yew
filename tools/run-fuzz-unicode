#!/usr/bin/env bash
# run-fuzz-unicode — campaign 00's fuzz harness: the decoder and the
# segmenter under a bounded, seeded random driver.
#
#   tools/run-fuzz-unicode [--iters N] [--seed S] [--three-byte]
#
# Builds tools/fuzz-unicode/main.lu on the release tier beside a copy
# of src/unicode (D32: `use` resolves under the entry's directory) and
# runs it from the repository root, where the golden corpus is. The
# defaults are sagitta's `make fuzz FUZZ_ITERS=200000 FUZZ_SEED=1`
# (`s02` DoD 8); `--three-byte` adds the exhaustive three-byte space
# (sagitta's fuzz lane, 16,777,216 inputs). Exit is the driver's: 0
# when every input held the nine invariants, 1 with the failing input
# printed in hex.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

stage=$YEW_ROOT/target/fuzz
rm -rf "$stage"
mkdir -p "$stage"
cp tools/fuzz-unicode/main.lu "$stage/main.lu"
cp -R src/unicode "$stage/unicode"
rm -f "$stage"/unicode/*_test.lu
"$WOLF" build --release --deny-warnings "$stage/main.lu" -o "$stage/fuzz-unicode"
exec "$stage/fuzz-unicode" "$@"
