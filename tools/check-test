#!/bin/sh
# check-test — the unit tests (`*_test.lu` under src/), two lanes.
#
#   tools/check-test            `wolf test --deny-warnings --nocapture src`: every
#                               file's `main` runs its ported C tests in
#                               sagitta's registry order on the CHECKED
#                               machine (wolf test's own: every allocation
#                               modelled, every UB row detected — the
#                               port's stand-in for sagitta's ASan/UBSan
#                               and valgrind lanes, docs/MAP.md §checked)
#   tools/check-test --native   each test file built on the native tier
#                               and run as a program from the repository
#                               root, its exit read directly: the tier
#                               that ships, which `wolf test` only falls
#                               back to when the checked machine refuses
#   ... --no-native-fallback    checked-only: a refusal fails, never a SKIP
#   ... --shard I/N             either lane over every Nth test file of
#                               the sorted list, from the Ith (CI's `unit`
#                               job runs N shards side by side, yw06: the
#                               two lanes took 92 and 120 minutes in one
#                               job); the N shards together are every file
#   tools/check-test --fakeclip-ran
#                               after the lanes: C's fake clipboard tool is
#                               built and neither lane's log
#                               (target/check-test-{checked,native}.log)
#                               holds a clipboard row SKIPped for want of
#                               it (yew#42; tools/build-fakeclip builds it)
#   tools/check-test --fakelsp-ran
#                               the same for C's fake language server: it
#                               is built and neither lane's log holds an
#                               LSP row SKIPped for want of it (yw11b;
#                               tools/build-fakelsp builds it)
#
# A test function is named as sagitta's registry names it (`T(arena_align)`
# is `fn arena_align()`), never `test_*`: wolf 0.2.32's `wolf test`
# discovers `test_*` in a package's alphabetically first file only
# (wolf-lang issue, docs/MAP.md), and a discovered test runs under a
# per-function step budget; `main` keeps every file on one path. The
# tests read fixtures by paths relative to the repository root
# (`tests/fixtures/unicode/…`), so both lanes run from the root.
#
# Two shapes of test file (yw01): `src/<dir>/<unit>_test.lu` inside a
# module that imports only std (util, unicode), and `src/<module>_<unit>_
# test.lu` — a `//! member: false` entry beside src/yew.lu — for a module
# that imports its siblings (term uses unicode and util): `use` resolves
# to the directories beside the ENTRY file (D32), so such a module can
# only be tested from the root.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

# The tests' state and log never reach the host's own: a test that does
# not name its log writes nowhere, and one that reaches for the state
# directory gets a scratch one (yw02 found three test files appending
# undo warnings to kasumi's ~/.local/state/yew/log). A test that sets
# its own (the journal and clipboard tests) overrides these.
export YEW_LOG="${YEW_LOG:-/dev/null}"
mkdir -p "$YEW_ROOT/target/test-state"
export XDG_STATE_HOME="$YEW_ROOT/target/test-state"

lane=checked
strict=
shard=
while [ $# -gt 0 ]; do
    case $1 in
    --native) lane=native ;;
    --fakeclip-ran) lane=fakeclip ;;
    --fakelsp-ran) lane=fakelsp ;;
    --no-native-fallback) strict=--no-native-fallback ;;
    --shard) shard=${2:-}; shift ;;
    *)
        echo "usage: tools/check-test [--native | --no-native-fallback] [--shard I/N] | --fakeclip-ran | --fakelsp-ran" >&2
        exit 2
        ;;
    esac
    shift
done
if [ "$lane" = native ] && [ -n "$strict" ]; then
    echo "check-test: --native and --no-native-fallback are exclusive" >&2
    exit 2
fi
# The test files, in the native loop's order; with --shard I/N, the Ith of
# every N (1-based), so the N shards partition the list.
test_files() {
    for f in src/*/*_test.lu src/*_test.lu; do
        [ -f "$f" ] && echo "$f"
    done | if [ -n "$shard" ]; then
        awk -v i="${shard%/*}" -v n="${shard#*/}" '(NR - 1) % n == i - 1'
    else
        cat
    fi
}
if [ -n "$shard" ]; then
    case $shard in
    [1-9]/[1-9] | [1-9]/[1-9][0-9] | [1-9][0-9]/[1-9][0-9]) ;;
    *)
        echo "check-test: --shard wants I/N, 1 <= I <= N" >&2
        exit 2
        ;;
    esac
    [ "${shard%/*}" -le "${shard#*/}" ] || { echo "check-test: --shard wants I/N, 1 <= I <= N" >&2; exit 2; }
    echo "check-test: shard $shard: $(test_files | wc -l | tr -d ' ') of $(shard= test_files | wc -l | tr -d ' ') test files"
fi

case $lane in
checked)
    export YEW_FL_VM_CHECKS=1
    # yew#78: `wolf test` prints `FAILED (trap(assert))` and no message, so
    # each file whose checked verdict is a trap is run once more, whole,
    # under `conform-run --checked --json`, and that record's verdict and
    # trap message are printed. The exit is still wolf test's own.
    log=$YEW_ROOT/target/check-test-checked.log
    set +e
    if [ -n "$shard" ]; then
        # shellcheck disable=SC2046
        { "$WOLF" test --deny-warnings --nocapture $strict $(test_files); echo $? >"$log.rc"; } 2>&1 | tee "$log"
    else
        { "$WOLF" test --deny-warnings --nocapture $strict src; echo $? >"$log.rc"; } 2>&1 | tee "$log"
    fi
    set -e
    rc=$(cat "$log.rc")
    for f in $(sed -n 's/^test \(src\/[^ :]*\.lu\)::[^ ]* \.\.\. FAILED (trap.*/\1/p' "$log" | sort -u); do
        echo "check-test: $f trapped on the checked machine; its conform-run record (yew#78):"
        "$WOLF" conform-run --deny-warnings --checked --json "$f" >"$log.trap.json" 2>"$log.trap.err" || true
        python3 -I -c 'import json,sys
try:
    d = json.load(open(sys.argv[1]))
except Exception as e:
    print("check-test:   no JSON record (%s)" % e); raise SystemExit(0)
print("check-test:   verdict=%s trap_message=%s" % (d.get("verdict"), d.get("trap_message") or d.get("x-unsupported-construct") or "(none)"))' "$log.trap.json"
        tail -5 "$log.trap.err" | sed 's/^/check-test:   stderr: /'
    done
    exit "$rc"
    ;;
native)
    mkdir -p target/tests
    # Each file's output is also kept in the lane's log, as the checked
    # lane's is, for `--fakeclip-ran` (yew#42).
    log=$YEW_ROOT/target/check-test-native.log
    : >"$log"
    status=0
    for f in $(test_files); do
        if [ "$(dirname "$f")" = src ]; then
            name=$(basename "$f" .lu)
        else
            name=$(basename "$(dirname "$f")")-$(basename "$f" .lu)
        fi
        "$WOLF" build --deny-warnings "$f" -o "target/tests/$name"
        if "target/tests/$name" >"$log.one" 2>&1; then
            rc=0
        else
            rc=$?
        fi
        cat "$log.one"
        cat "$log.one" >>"$log"
        if [ "$rc" = 0 ]; then
            echo "check-test: $f [native] ok" | tee -a "$log"
        else
            echo "check-test: $f [native] FAILED exit $rc" | tee -a "$log"
            status=1
        fi
    done
    rm -f "$log.one"
    exit $status
    ;;
fakeclip)
    # yew#42: a lane that ran without C's fake tool SKIPs the clipboard
    # rows by name ("... fakeclip is missing ..."); after both lanes, the
    # tool must exist and no such line be in either lane's log.
    status=0
    tool=target/oracle/sagitta/build/fakeclip
    if [ -x "$tool" ]; then
        echo "check-test: $tool is built"
    else
        echo "check-test: $tool is missing (tools/build-fakeclip)"
        status=1
    fi
    for l in target/check-test-checked.log target/check-test-native.log; do
        if [ ! -f "$l" ]; then
            echo "check-test: $l is missing (run both lanes first)"
            status=1
            continue
        fi
        n=$(grep -c 'fakeclip is missing' "$l" || true)
        echo "check-test: $l: $n clipboard row(s) SKIPped for want of the fake tool"
        if [ "$n" != 0 ]; then
            grep 'fakeclip is missing' "$l" | sed 's/^/check-test:   /'
            status=1
        fi
    done
    exit $status
    ;;
fakelsp)
    # yw11b: a lane that ran without C's fake server SKIPs the LSP rows
    # that spawn it by name ("... fakelsp is missing ..."); after both
    # lanes, the helper must exist and no such line be in either lane's
    # log.
    status=0
    tool=target/oracle/sagitta/build/tests/helpers/fakelsp
    if [ -x "$tool" ]; then
        echo "check-test: $tool is built"
    else
        echo "check-test: $tool is missing (tools/build-fakelsp)"
        status=1
    fi
    for l in target/check-test-checked.log target/check-test-native.log; do
        if [ ! -f "$l" ]; then
            echo "check-test: $l is missing (run both lanes first)"
            status=1
            continue
        fi
        n=$(grep -c 'fakelsp is missing' "$l" || true)
        echo "check-test: $l: $n LSP row(s) SKIPped for want of the fake server"
        if [ "$n" != 0 ]; then
            grep 'fakelsp is missing' "$l" | sed 's/^/check-test:   /'
            status=1
        fi
    done
    exit $status
    ;;
esac
