//! Headless rows of pinned sagitta perf_fletch.c; no editor rows run.
//! One discarded warmup plus eleven samples, median/min and all raw values.

use fl
use util

fn source_for(row: str) -> str {
    match row {
        "motion_dispatch" =>
            "let i = 0\nwhile i < 1000000 {{\n  try {{ let x = @[ > ] }} catch e {{ }}\n  i = i + 1\n}}\nreturn i\n",
        "fib27" =>
            "fn fib(n) {{\n  if n < 2 {{ return n }}\n  return fib(n - 1) + fib(n - 2)\n}}\nreturn fib(27)\n",
        "map_heavy" =>
            "import map\nimport fmt\nlet m = {{}}\nlet i = 0\nwhile i < 100000 {{\n  map.set(m, fmt.int(i), i)\n  i = i + 1\n}}\nlet t = 0\ni = 0\nwhile i < 100000 {{\n  t = t + map.get(m, fmt.int(i))\n  i = i + 1\n}}\nreturn t\n",
        "gc_pause" =>
            "import map\nimport fmt\nlet m = {{}}\nlet i = 0\nwhile i < 100000 {{\n  map.set(m, fmt.int(i), i)\n  i = i + 1\n}}\nlet t = 0\ni = 0\nwhile i < 100000 {{\n  t = t + map.get(m, fmt.int(i))\n  i = i + 1\n}}\nreturn t\n",
        "strbuild_join" =>
            "import str\nimport list\nlet parts = []\nlet i = 0\nwhile i < 20000 {{\n  list.push(parts, \"frag\")\n  i = i + 1\n}}\nreturn str.len(str.join(parts, \"\"))\n",
        "strbuild_concat" =>
            "import str\nlet s = \"\"\nlet i = 0\nwhile i < 5000 {{\n  s = s + \"frag\"\n  i = i + 1\n}}\nreturn str.len(s)\n",
        "join5k" =>
            "import str\nimport list\nlet parts = []\nlet i = 0\nwhile i < 5000 {{\n  list.push(parts, \"frag\")\n  i = i + 1\n}}\nreturn str.len(str.join(parts, \"\"))\n",
        "list_sort" =>
            "import list\nimport math\nmath.seed(1)\nlet l = []\nlet i = 0\nwhile i < 100000 {{\n  list.push(l, math.random(0, 1000000))\n  i = i + 1\n}}\nlist.sort(l)\nreturn list.len(l)\n",
        _ => "",
    }
}

fn expected(row: str) -> int {
    match row {
        "fib27" => 196418,
        "motion_dispatch" => 1000000,
        "map_heavy" | "gc_pause" => 4999950000,
        "strbuild_join" => 80000,
        "strbuild_concat" | "join5k" => 20000,
        "list_sort" => 100000,
        _ => 0,
    }
}

fn sample(row: str, source: List[byte]) -> (int, int) {
    region trial {
        let startup_begin = os_clock_ns()
        var strings = fl.fl_strings()
        var vm = fl.fl_vm_new(take strings)
        fl.fl_std_register(mut vm)
        if row == "startup" { return (os_clock_ns() - startup_begin, 0) }
        let begin = os_clock_ns()
        let name = if row == "parse_only" then "runtime/init.fl" else row
        let id = fl.fl_diag_add_file(mut vm.dc, name, source)
        let p = fl.fl_parse(source, id, mut vm.dc, mut vm.strings)
        let parsed = os_clock_ns() - begin
        if p.had_error { eprint("perf_fletch: {name} did not parse"); os_exit(1) }
        if row == "parse_only" { return (parsed, 0) }
        let f = fl.fl_compile(mut vm, p, id, fl.fl_origin_new(4, 0)) else {
            eprint("perf_fletch: {name} did not compile")
            os_exit(1)
            fl.fl_nil()
        }
        let out = fl.fl_vm_run(mut vm, f)
        let elapsed = os_clock_ns() - begin
        if vm.raised {
            eprint("perf_fletch: {name} raised")
            let key = fl.fl_str_text(mut vm, "msg")
            let msg = fl.fl_map_get(vm, vm.err, key) else fl.fl_nil()
            if msg.t == 4 {
                eprint(
                    str_from_utf8(
                        vm.gc.slots[fl.fl_obj_index(vm, msg)].bytes,
                    ) else "non-UTF-8 diagnostic",
                )
            }
            os_exit(1)
        }
        assert(out.t == 2 && out.i == expected(row))
        let pause = vm.gc.pause_max_ns
        (if row == "gc_pause" then pause else elapsed, vm.gc.collections)
    }
}

fn less(a: int, b: int) -> bool { a < b }

fn main() -> int {
    let args = env_args()
    if args.len < 1 || args.len > 2 { return 2 }
    let row = args[0]
    if (env_get("YEW_FL_GC_STRESS") else "absent") != "absent" ||
        (env_get("FL_GC_STRESS") else "absent") != "absent" {
        eprint("perf_fletch: GC stress is set; timing is refused")
        return 2
    }
    var source = List[byte]()
    if row == "parse_only" {
        if args.len != 2 { return 2 }
        source = fs_read_bytes(args[1]) else { return 3 }
    } else if row != "startup" {
        let text = source_for(row)
        if text.len == 0 { return 2 }
        for b in text.bytes() { (mut source).push(b) }
    }
    var raw = List[int]()
    var measured = List[int]()
    (mut raw).reserve(12)
    (mut measured).reserve(11)
    var collections: int = 0
    for i in 0..12 {
        let (elapsed, count) = sample(row, source)
        collections = count
        (mut raw).push(elapsed)
        if i != 0 { (mut measured).push(elapsed) }
    }
    util.sort_stable(mut measured, less)
    let budget: int = if row == "startup" {
        2000000
    } else if row == "motion_dispatch" {
        1000000000
    } else {
        0
    }
    print_raw(
        "{row} median_ns={measured[5]} min_ns={measured[0]} budget_ns={budget} gc={collections} raw=",
    )
    for i in 0..raw.len {
        if i != 0 { print_raw(",") }
        print_raw("{raw[i]}")
    }
    print("")
    0
}
