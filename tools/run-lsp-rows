#!/bin/bash
# run-lsp-rows — yw11a's oracle rows: tools/lsp-rows/lsprows.c built
# against the oracle's PTY harness objects (the pty_runner's own link line
# with registry.o swapped for lsprows.o and runner.o dropped: lsprows.c
# has its own main, which holds no case to a golden), its cases run twice
# over C yew and twice over the port, then tools/lsp-rows/compare.py
# holds each binary's two runs to each other and C's screens to the
# port's, cell for cell (syntax colouring aside: yw10's).
#
#   tools/run-lsp-rows PORT_BIN              build the runner, then run
#   tools/run-lsp-rows --build-only          build the runner
#   tools/run-lsp-rows --prebuilt PORT_BIN   run the built runner
#   ... --filter F                           only the cases naming F
#   ... --keep DIR                           keep the screens in DIR
#                                            (default target/lsp-rows)
#
# The rows' real server is `wolf lsp` from yew's pinned toolchain
# (.wolf-bin/wolf, tools/fetch-toolchain); the error paths run
# tools/lsp-rows/fakeserver.py under python3. The oracle tree
# (tools/oracle) must exist; its `build` link names the compiler's tree.
# One line per case and binary (`lsp-row: <case>: ok` or `FAIL <case>`),
# one per screen (`lsp-rows: <case>.<screen>: same` or `DIFFERS`, the
# differing cells after it), then `lsp-rows: GREEN` or `RED`.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
tree=$root/target/oracle/sagitta
build=1
run=1
filter=
keep=$root/target/lsp-rows
case "${1:-}" in
--build-only) run=0; shift ;;
--prebuilt) build=0; shift ;;
esac
port=
while [ $# -gt 0 ]; do
    case "$1" in
    --filter) filter=$2; shift 2 ;;
    --keep) keep=$2; shift 2 ;;
    *) port=$1; shift ;;
    esac
done
[ "$run" = 0 ] || [ -n "$port" ] || { echo "usage: tools/run-lsp-rows [--build-only | [--prebuilt] PORT_BIN] [--filter F]" >&2; exit 2; }
[ -d "$tree" ] || { echo "run-lsp-rows: no oracle tree at $tree; run tools/oracle first" >&2; exit 2; }
cd "$tree"
bdir=$(readlink build || true)
[ -n "$bdir" ] || { echo "run-lsp-rows: $tree/build is not tools/oracle's link" >&2; exit 2; }
cc=${bdir#build-}
if [ "$build" = 1 ]; then
    make -C "$tree" -j4 CC="$cc" BUILD="$bdir" "$bdir/pty_runner" "$bdir/yew" "$bdir/demo_paint" >/dev/null
    cc_line=$(make -n -B CC="$cc" BUILD="$bdir" "$bdir/tests/pty/registry.o" | grep -E "(^| )-o $bdir/tests/pty/registry.o" | tail -1)
    ld_line=$(make -n -B CC="$cc" BUILD="$bdir" "$bdir/pty_runner" | grep -E -- "-o $bdir/pty_runner" | tail -1)
    [ -n "$cc_line" ] && [ -n "$ld_line" ] || { echo "run-lsp-rows: cannot read the oracle's build lines" >&2; exit 2; }
    cp "$root/tools/lsp-rows/lsprows.c" "$bdir/lsprows.c"
    eval "$(echo "$cc_line" | sed "s#-o $bdir/tests/pty/registry.o#-o $bdir/lsprows.o#; s#tests/pty/registry.c#$bdir/lsprows.c#; s# -MMD -MP##")" -Itests/pty
    eval "$(echo "$ld_line" | sed "s#$bdir/tests/pty/registry.o#$bdir/lsprows.o#; s# $bdir/tests/pty/runner.o##; s#-o $bdir/pty_runner#-o $bdir/lsprows_runner#")"
    echo "run-lsp-rows: built $tree/$bdir/lsprows_runner"
fi
[ "$run" = 1 ] || exit 0
[ -x "$bdir/lsprows_runner" ] || { echo "run-lsp-rows: no $bdir/lsprows_runner; run tools/run-lsp-rows --build-only" >&2; exit 2; }
case "$port" in /*) ;; *) port=$root/$port ;; esac
wolf=$root/.wolf-bin/wolf
[ -x "$wolf" ] || { echo "run-lsp-rows: no pinned wolf at $wolf; run tools/fetch-toolchain" >&2; exit 2; }
python=$(command -v python3)
c_yew=$tree/$bdir/yew
rm -rf "$keep"
mkdir -p "$keep/c/run1" "$keep/c/run2" "$keep/port/run1" "$keep/port/run2"
export YEW_LSPROW_PATH="$root/.wolf-bin:/usr/bin:/bin"
export YEW_LSPROW_PYTHON=$python
export YEW_LSPROW_FAKE=$root/tools/lsp-rows/fakeserver.py
if [ -n "$filter" ]; then export YEW_PTY_FILTER=$filter; fi
echo "run-lsp-rows: $("$wolf" --version | head -1)"
status=0
for tag in c port; do
    bin=$c_yew
    [ "$tag" = port ] && bin=$port
    echo "== lsp rows over $bin ($tag)"
    set +e
    YEW_LSPROW_OUT=$keep/$tag YEW_PTY_CASE_BUDGET_MS=60000 \
        "$bdir/lsprows_runner" --demo "$bdir/demo_paint" --yew "$bin"
    rc=$?
    set -e
    echo "lsp-rows: $tag runner exit=$rc"
    [ "$rc" = 0 ] || status=1
done
python3 -I "$root/tools/lsp-rows/compare.py" "$keep" || status=1
if [ "$status" = 0 ]; then echo "lsp-rows: GREEN"; else echo "lsp-rows: RED"; fi
exit $status
