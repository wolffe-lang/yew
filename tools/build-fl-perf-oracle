#!/bin/sh
# Headless adapter uses the unchanged pinned perf_fletch.c samplers and inputs.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
oracle=${1:-$root/target/oracle/sagitta}
[ "$#" -le 1 ] || exit 2
want=$(sed -n 's/^SAGITTA_REV=//p' "$root/sagitta.pin")
[ "$(git -C "$oracle" rev-parse HEAD)" = "$want" ] || { echo 'perf oracle pin mismatch' >&2; exit 2; }
make --no-print-directory -s -j"${YEW_JOBS:-4}" -C "$oracle" build/fl_smoke build/perf_fletch
objects=$(make --no-print-directory -s -C "$oracle" --eval 'fl-core-objects:;@echo $(PERF_CORE_OBJ)' fl-core-objects)
mkdir -p "$root/target/tools"
cd "$oracle"
${CC:-cc} -std=c11 -O2 -Wall -Wextra -Werror -I src \
  -DPERF_SOURCE='"'"$oracle/tests/perf/perf_fletch.c"'"' \
  "$root/tools/fl-headless/oracle.c" $objects -lm -o "$root/target/tools/fl-headless-oracle"
printf '%s\n' "$root/target/tools/fl-headless-oracle"
