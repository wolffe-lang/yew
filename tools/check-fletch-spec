#!/bin/sh
# Verify the frozen spec bytes against the actual git object at sagitta.pin.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
repo=${1:-$root/target/oracle/sagitta}
pin=$(sed -n 's/^SAGITTA_REV=//p' "$root/sagitta.pin")
# Read only the pinned SHA, never execute the pin file.
case "$pin" in *[!0-9a-f]*|'') echo 'check-fletch-spec: invalid pin' >&2; exit 2;; esac
mkdir -p "$root/target/tools"
git -C "$repo" show "$pin:.docs/fletch-spec.md" > "$root/target/tools/fletch-spec.pinned"
cmp "$root/docs/fletch-spec.md" "$root/target/tools/fletch-spec.pinned"
echo 'check-fletch-spec: frozen spec matches sagitta.pin'
