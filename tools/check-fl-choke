#!/bin/sh
#
# check-fl-choke — the mutation choke point (sagitta Sprint 34 DoD 5), the
# port's form of sagitta 9ace98c2 scripts/check-fl-choke.sh (85 lines).
#
# THE LAW, as C states it: a Fletch call becomes an editor effect in ONE
# place, the command invoke (src/edit/flruntime.lu's fl_invoke_command,
# C's fl_dispatch -> yew_cmd_invoke). Nothing that ports sagitta's
# src/fl/ may reach into the text buffer, the edit context, a cursor set,
# the undo log or the registers directly: a direct mutation skips the undo
# record (undo atomicity) and the recorder tap (the round-trip law).
#
# WHICH FILES. C's law covers its src/fl/ directory. The port keeps the
# VM in src/fl/ and the editor-attached half beside the Ed it needs, in
# src/edit/: every src/edit/*.lu whose module header ports a sagitta
# src/fl/ file (flapi, flapi_queries, flhandle, flruntime, fltxn,
# motion_tab, record) is held to the same law. src/edit/flapi_cmds.lu
# ports C's src/edit/flapi_cmds.c, the registered commands themselves,
# and is not.
#
# WHICH SYMBOLS. C bans yew_edit_insert, yew_edit_delete, yew_textbuf_*,
# yew_undo_record, yew_reg_set, yew_reg_yank, yew_reg_delete and
# yew_cset_*. C's flapi.c reads text through yew_buf_len and the text
# iterator; the port's one text module names its reads textbuf_len,
# textbuf_copy_range and so on, so the textbuf family here is its
# mutators (insert, delete, append, snap, free); the register family adds
# the port's append, paste and ring push.
#
# THE repl ALLOWANCE (C's src/fl/repl.c), kept per FILE and narrow: the
# REPL edits its own prompt line, not a user document. src/fl/repl.lu.
#
# Comments are exempt (`//`, `///`, `//!` lines): prose that names a banned
# symbol is documentation, not a call.
#
#   tools/check-fl-choke             check the tree
#   tools/check-fl-choke --selftest  a seeded direct insert must be refused

set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)

BANNED='text\.(edit_insert|edit_delete|textbuf_(insert|delete|append_range|snap|free)|undo_record|reg_set|reg_yank|reg_delete|reg_append|reg_paste|reg_ring_push|cset_)'
ALLOWED_FILE='src/fl/repl.lu'

# The files the law covers, relative to $1.
choke_files()
{
    root=$1
    (cd "$root" && {
        for f in src/fl/*.lu; do
            [ -f "$f" ] && [ "$f" != "$ALLOWED_FILE" ] && echo "$f"
        done
        for f in src/edit/*.lu; do
            [ -f "$f" ] && head -8 "$f" | grep -q 'src/fl/' && echo "$f"
        done
    }) || :
}

choke_hits()
{
    root=$1
    files=$(choke_files "$root")
    [ -n "$files" ] || return 0
    (cd "$root" && grep -HnE "$BANNED" $files 2>/dev/null) |
        awk '{
            line = $0
            sub(/^[^:]*:[0-9]*:/, "", line)
            sub(/^[ \t]+/, "", line)
            if (line ~ /^\/\//) next
            print $0
        }'
}

if [ "${1:-}" = "--selftest" ]; then
    seed_dir=$(mktemp -d "$YEW_ROOT/target/check-fl-choke.XXXXXX" 2>/dev/null ||
        { mkdir -p "$YEW_ROOT/target" && mktemp -d "$YEW_ROOT/target/check-fl-choke.XXXXXX"; })
    trap 'rm -rf "$seed_dir"' EXIT INT TERM
    mkdir -p "$seed_dir/src/fl" "$seed_dir/src/edit"
    cat >"$seed_dir/src/edit/flapi.lu" <<'SEED'
//! edit.flapi — sagitta src/fl/flapi.c (a seed).
// A comment naming text.edit_insert must NOT trip the gate.
fn seeded(mut ed: Ed) {
    let _ = text.edit_insert(mut ed.bufs[0].ec, 0, bytes)
}
SEED
    cat >"$seed_dir/src/fl/repl.lu" <<'SEED'
fn allowed(mut tb: TextBuf) { text.textbuf_insert(mut tb, 0, bytes) }
SEED
    hits=$(choke_hits "$seed_dir" || true)
    if ! printf '%s\n' "$hits" | grep -q 'src/edit/flapi.lu:4:'; then
        echo "check-fl-choke: selftest: the seeded direct text.edit_insert was accepted" >&2
        exit 1
    fi
    if printf '%s\n' "$hits" | grep -q 'flapi.lu:2:\|repl.lu'; then
        echo "check-fl-choke: selftest: a comment or the repl allowance was refused" >&2
        exit 1
    fi
    echo "check-fl-choke: selftest: the seeded insert refused, the comment and repl.lu let be"
    exit 0
fi

hits=$(choke_hits "$YEW_ROOT" || true)
if [ -n "$hits" ]; then
    echo "check-fl-choke: a Fletch source mutates the editor directly." >&2
    echo "check-fl-choke: route it through a registered command and the" >&2
    echo "check-fl-choke: invoke (fl_invoke_command) -- s34 deliverable 3." >&2
    printf '%s\n' "$hits" >&2
    exit 1
fi
n=$(choke_files "$YEW_ROOT" | wc -l | tr -d ' ')
echo "check-fl-choke: ok ($n files)"
