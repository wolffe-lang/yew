#!/usr/bin/env bash
# run-perf-jobstream — the 2× gate on the job stream (Sprint 19 DoD 13,
# the job half yw05 landed): sagitta's own `perf_jobstream`
# (`tests/perf/jobstream.c`: 2,000 keys typed while a job floods the editor
# with a 50 MiB stream, keypress → the next painted frame) run over C yew,
# the port, then C again (the rig's drift), the port/C ratio of the p99
# printed, red above 2.0. The harness's absolute limit prints beside it
# but is advisory here (`YEW_PERF_ADVISORY=1`): the gate is the ratio.
#
#   tools/run-perf-jobstream [--yew BIN] [--c-yew BIN] [--cpus 0-3]
#
# Inside the container (sprints/RULES.md §5); needs the oracle tree's
# `build/perf_jobstream` (tools/oracle builds it).
# Exit 0 within 2.0, 1 above, 2 on a fault.
set -u
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$YEW_ROOT"
yew=$YEW_ROOT/target/release/yew
tree=$YEW_ROOT/target/oracle/sagitta
c_yew=$tree/build/yew
cpus=
while [ $# -gt 0 ]; do
  case $1 in
    --yew) yew=$2; shift 2 ;;
    --c-yew) c_yew=$2; shift 2 ;;
    --cpus) cpus=$2; shift 2 ;;
    *) echo "run-perf-jobstream: unknown argument $1" >&2; exit 2 ;;
  esac
done
case $yew in /*) ;; *) yew=$YEW_ROOT/$yew ;; esac
h=$tree/build/perf_jobstream
for f in "$h" "$yew" "$c_yew"; do
  [ -e "$f" ] || { echo "run-perf-jobstream: missing $f (tools/oracle)" >&2; exit 2; }
done
out=$YEW_ROOT/target/perf-jobstream
rm -rf "$out"; mkdir -p "$out/home/config"
export HOME=$out/home XDG_CONFIG_HOME=$out/home/config
pin=
[ -n "$cpus" ] && pin="taskset -c $cpus"
run() {
  (cd "$tree" && YEW_RUNTIME_DIR="$tree/runtime" YEW_PERF_ADVISORY=1 $pin "$h" --yew "$2" \
    --baseline tests/perf/baselines/latency-x86_64-linux-gnu.txt) >"$out/$1.txt" 2>&1
  echo "== $1 ($(sha256sum "$2" | cut -c1-12))"
  grep '^jobstream ' "$out/$1.txt" || { cat "$out/$1.txt"; return 1; }
}
run c1 "$c_yew" || exit 2
run port "$yew" || exit 2
run c2 "$c_yew" || exit 2
val() { awk '$1 == "jobstream" { print $3; exit }' "$out/$1.txt"; }
c1=$(val c1); w=$(val port); c2=$(val c2)
[ -n "$c1" ] && [ -n "$w" ] && [ -n "$c2" ] || { echo "run-perf-jobstream: a run printed no value" >&2; exit 2; }
r=$(awk -v w="$w" -v a="$c1" -v b="$c2" 'BEGIN { printf "%.2f", w / ((a + b) / 2) }')
d=$(awk -v a="$c1" -v b="$c2" 'BEGIN { m = (a < b) ? a : b; printf "%.2f", (a > b ? a : b) / m }')
echo "jobstream: p99 C=$c1,$c2 port=$w ratio=$r drift=$d GATED"
awk -v r="$r" 'BEGIN { exit (r > 2.0) }'
