#!/bin/sh
# check-runtime — runtime/ is sagitta's at the pin, byte for byte (the
# completion specs since yw04), and
# src/edit/runtime_blob.lu is what tools/gen-runtime embeds from it (the
# copy is never edited: Fletch stays Fletch, docs/MAP.md §2).
#
#   tools/check-runtime [SAGITTA]   compare each file against SAGITTA's
#                                   runtime/, regenerate the blob into
#                                   target/tools/ and compare; exit 1 on
#                                   either drift
#
# SAGITTA defaults to the oracle tree (target/oracle/sagitta).
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$YEW_ROOT"
tree=${1:-target/oracle/sagitta}
if [ ! -d "$tree/runtime" ]; then
    echo "check-runtime: no sagitta tree at $tree (run tools/oracle first)" >&2
    exit 2
fi
status=0
for f in init.fl themes/quiver-dark.fl themes/quiver-light.fl $(cd "$tree/runtime" && ls completions/*.fl completions/README.md); do
    if cmp -s "runtime/$f" "$tree/runtime/$f"; then
        echo "check-runtime: runtime/$f is sagitta's"
    else
        echo "check-runtime: runtime/$f DIFFERS from $tree/runtime/$f" >&2
        status=1
    fi
done
mkdir -p target/tools
python3 -I tools/gen-runtime/gen.py . target/tools/runtime_blob.lu
if cmp -s target/tools/runtime_blob.lu src/edit/runtime_blob.lu; then
    echo "check-runtime: src/edit/runtime_blob.lu is the generator's"
else
    echo "check-runtime: src/edit/runtime_blob.lu DIFFERS from the generator's output" >&2
    status=1
fi
exit $status
