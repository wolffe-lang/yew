#!/bin/sh
# Nonshipping core trace/smoke, headless perf or editor perf driver (yw09's
# tools/fl-editor-perf), pinned toolchain only.
set -eu
YEW_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh
name=fl-core
tier=release
flag=--release
for arg in "$@"; do
  case "$arg" in
    --headless) name=fl-headless ;;
    --editor) name=fl-editor-perf ;;
    --native) tier=native; flag= ;;
    --release) tier=release; flag=--release ;;
    *) echo 'usage: build-fl-core [--headless|--editor] [--native|--release]' >&2; exit 2 ;;
  esac
done
stage="$YEW_ROOT/target/$name-$tier"
# This path is derived only from the two fixed driver names and tier choices.
# Rebuild its owned snapshot so removed source files cannot survive a merge.
case "$stage" in
  "$YEW_ROOT/target/fl-core-native"|"$YEW_ROOT/target/fl-core-release"|"$YEW_ROOT/target/fl-headless-native"|"$YEW_ROOT/target/fl-headless-release"|"$YEW_ROOT/target/fl-editor-perf-native"|"$YEW_ROOT/target/fl-editor-perf-release") ;;
  *) echo 'build-fl-core: invalid stage' >&2; exit 2 ;;
esac
rm -rf -- "$stage"
mkdir -p "$stage" target/tools
cp -R "$YEW_ROOT/src/." "$stage/"
# Only copies in this driver-owned staging directory are removed.
find "$stage" -maxdepth 1 -type f -name '*.lu' -delete
find "$stage" -type f -name '*_test.lu' -delete
cp "tools/$name/main.lu" "$stage/main.lu"
"$WOLF" build $flag --deny-warnings "$stage/main.lu" -o "target/tools/$name-$tier"
printf '%s\n' "$YEW_ROOT/target/tools/$name-$tier"
