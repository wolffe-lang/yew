#!/usr/bin/env python3
"""R12 extended: first five C-stable triples per metric, never filter by port speed."""
from pathlib import Path
import re
import sys

LIMIT = 1.25

def sample(text, metric):
    suffix = r" value_ns=([0-9]+)(?:\s|$)" if metric.startswith("startup.") else r"\s+([0-9]+)(?:\s|$)"
    rows = re.findall(r"^" + re.escape(metric) + suffix, text, re.M)
    if len(rows) != 1 or int(rows[0]) <= 0:
        raise ValueError(f"expected one positive {metric} row")
    return int(rows[0])

def drift(c, c2):
    if min(c, c2) <= 0:
        raise ValueError("nonpositive C sample")
    return max(c, c2) / min(c, c2)

def selected(triples):
    return triples[:5]

def median(values):
    if len(values) != 5:
        raise ValueError("five valid trials required")
    return sorted(values)[2]

def selftest():
    assert drift(100, 125) == 1.25 and drift(125, 100) == 1.25
    assert drift(100, 126) > 1.25 and drift(126, 100) > 1.25
    rows = [(n, 100, n * 10, 100) for n in range(1, 8)]
    assert [r[0] for r in selected(rows)] == [1, 2, 3, 4, 5]
    assert selected([(0, 100, 1, 200)] + rows) == rows[:5]
    assert selected([(0, 100, 9999999, 100)] + rows)[0][2] == 9999999
    assert median([5, 1, 4, 2, 3]) == 3
    assert sample("cold_open_to_first_paint 123 limit=2 ok\n", "cold_open_to_first_paint") == 123
    assert sample("startup.first_paint.clean value_ns=17 budget_ns=2\n", "startup.first_paint.clean") == 17
    assert sample("latency.navigate.many_buffers.p99 45 budget_ns=50\n", "latency.navigate.many_buffers.p99") == 45
    for bad in ("", "cold_open_to_first_paint 0 limit=2\n",
                "cold_open_to_first_paint 1 limit=2\ncold_open_to_first_paint 2 limit=2\n"):
        try:
            sample(bad, "cold_open_to_first_paint")
        except ValueError:
            pass
        else:
            raise AssertionError("invalid row accepted")
    try:
        median([1, 2, 3, 4])
    except ValueError:
        pass
    else:
        raise AssertionError("short set accepted")
    print("perf-editor-samples: stable-C selection, five-sample median and malformed-row controls PASS")


def pane(out, row, through):
    if row not in {"panes-one", "panes-two", "many", "tabswitch"} or not 1 <= through <= 20:
        raise ValueError("bad pane row or trial")
    prefix = "latency.typing.small" if row.startswith("panes-") else "latency.navigate.many_buffers"
    all_rows = {q: [] for q in ("p99", "p50", "max")}
    for n in range(1, through + 1):
        texts = [(out / f"{label}-{row}-{n}.txt").read_text() for label in ("c1", "port", "c2")]
        for q in all_rows:
            all_rows[q].append((n, *(sample(t, prefix + "." + q) for t in texts)))
    kept = selected(all_rows["p99"])
    ids = [r[0] for r in kept]
    n, c, w, c2 = all_rows["p99"][-1]
    status = "DISCARD_C_DRIFT" if drift(c, c2) > LIMIT else "ACCEPT" if n in ids else "EXTRA"
    print(f"pane-sample.{row} trial={n} c={c} wolf={w} c_again={c2} drift={drift(c,c2):.3f} "
          f"verdict={status} accepted={len(kept)}/5", flush=True)
    if len(kept) != 5:
        return 3
    for q, rows in all_rows.items():
        chosen = [r for r in rows if r[0] in ids]
        for column, label in ((1, "c1"), (2, "port"), (3, "c2")):
            (out / f"median-{row}-{q}-{label}.txt").write_text(str(median([r[column] for r in chosen])) + "\n")
    (out / f"accepted-{row}.txt").write_text(",".join(map(str, ids)) + "\n")
    return 0


def main(args):
    if args == ["--selftest"]:
        selftest()
        return 0
    if len(args) == 4 and args[0] == "--pane":
        return pane(Path(args[1]), args[2], int(args[3]))
    if len(args) < 3:
        raise ValueError("usage: perf-editor-samples DIR TRIAL METRIC...")
    out, through, metrics = Path(args[0]), int(args[1]), args[2:]
    if through < 1 or through > 20 or len(set(metrics)) != len(metrics):
        raise ValueError("bad trial count or duplicate metric")
    complete = True
    for metric in metrics:
        if not re.fullmatch(r"[a-z][a-z0-9_.]*", metric):
            raise ValueError("invalid metric name")
        prefix = "startup" if metric.startswith("startup.") else "latency"
        rows = []
        for n in range(1, through + 1):
            values = [sample((out / f"{prefix}-{label}-{n}.txt").read_text(), metric)
                      for label in ("c", "wolf", "c2")]
            rows.append((n, *values))
        kept = selected(rows)
        n, c, w, c2 = rows[-1]
        accepted_ids = [r[0] for r in kept]
        status = "DISCARD_C_DRIFT" if drift(c, c2) > LIMIT else "ACCEPT" if n in accepted_ids else "EXTRA"
        print(f"sample.{metric} trial={n} c={c} wolf={w} c_again={c2} drift={drift(c,c2):.3f} "
              f"verdict={status} accepted={len(kept)}/5", flush=True)
        if len(kept) != 5:
            complete = False
            continue
        for column, label in ((1, "c"), (2, "wolf"), (3, "c2")):
            (out / f"median-{metric}-{label}.txt").write_text(str(median([r[column] for r in kept])) + "\n")
        (out / f"accepted-{metric}.txt").write_text(",".join(map(str, accepted_ids)) + "\n")
    return 0 if complete else 3

if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (ValueError, OSError) as error:
        print("perf-editor-samples: " + str(error), file=sys.stderr)
        sys.exit(2)
