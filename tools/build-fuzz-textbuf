#!/bin/sh
# build-fuzz-textbuf — campaign 02's differential fuzz driver,
# tools/fuzz-textbuf/main.lu (the port of sagitta's
# tests/fuzz/fuzz_textbuf.c), built on the release tier into
# target/tools/fuzz-textbuf.
#
#   tools/build-fuzz-textbuf [--native]
#
# `use text` resolves beside the ENTRY file (D32), so the port's modules
# are staged beside a copy under target/fuzz-textbuf/, as
# tools/build-torture stages the torture child. Nothing there is
# committed.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

tier=release
case "${1:-}" in
"") ;;
--native) tier=native ;;
*)
    echo "build-fuzz-textbuf: unknown option $1" >&2
    exit 2
    ;;
esac

stage=$YEW_ROOT/target/fuzz-textbuf
rm -rf "$stage"
mkdir -p "$stage" target/tools
cp tools/fuzz-textbuf/main.lu "$stage/main.lu"
for m in util unicode term text; do
    cp -R "src/$m" "$stage/$m"
    rm -f "$stage/$m"/*_test.lu
done
if [ "$tier" = release ]; then
    "$WOLF" build --release --deny-warnings "$stage/main.lu" -o target/tools/fuzz-textbuf
else
    "$WOLF" build --deny-warnings "$stage/main.lu" -o target/tools/fuzz-textbuf
fi
echo "build-fuzz-textbuf: target/tools/fuzz-textbuf ($tier)"
