#!/usr/bin/env bash
# run-fuzz-panes — Sprint 22's pane fuzz (s22 DoD 10): random split,
# close, resize, focus and screen-size sequences, the tree's invariants,
# live focus, layout idempotence and leaf_at after EVERY operation.
#
#   tools/run-fuzz-panes [--native] [--iters=N] [--seed=N]
#   tools/run-fuzz-panes --campaign [--against-oracle] [--seeds="S..."]
#
# Builds tools/fuzz-panes/main.lu (tools/build-fuzz-panes; FUZZ_PREBUILT=1
# runs the driver already built) and runs it from the repository root.
# The defaults are sagitta's generator's (200,000 iterations, seed 1;
# `make fuzz-iter` runs fuzz_panes at FUZZ_ITERS, FUZZ_SEED, Makefile:2260).
# s22 DoD 10 asks for 10,000 operations: one session is 60 to 119, so a
# campaign of 10,000 sessions is ~900,000. `--campaign` runs 10,000
# sessions at each seed of `--seeds` (default "1 2 3 4"); the report
# line's `hash=` is C's for the same seed and iterations (the generator is
# C's bit for bit). `--against-oracle` also runs C's own driver
# (target/oracle/sagitta/build/fuzz_panes, which tools/oracle builds) with
# the same arguments and requires the two report lines to be equal byte
# for byte; a missing C driver is exit 2, never a silent pass. Exit is the
# driver's, read directly: 0 when every input held, 1 with the failing
# input printed as hex, 2 on a usage error.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"

native=
if [ "${1:-}" = --native ]; then
    native=--native
    shift
fi
if [ "${FUZZ_PREBUILT:-0}" != 1 ]; then
    tools/build-fuzz-panes $native
fi
driver=target/tools/fuzz-panes
if [ "${1:-}" = --campaign ]; then
    shift
    oracle=0
    seeds="1 2 3 4"
    for a in "$@"; do
        case "$a" in
        --against-oracle) oracle=1 ;;
        --seeds=*) seeds=${a#--seeds=} ;;
        *)
            echo "run-fuzz-panes: unknown argument $a" >&2
            exit 2
            ;;
        esac
    done
    c=target/oracle/sagitta/build/fuzz_panes
    if [ "$oracle" = 1 ] && [ ! -x "$c" ]; then
        echo "run-fuzz-panes: $c is not built (tools/oracle's targets must list build/fuzz_panes)" >&2
        exit 2
    fi
    for s in $seeds; do
        port_line=$("$driver" --iters=10000 --seed="$s") || {
            echo "port: $port_line"
            exit 1
        }
        echo "port: $port_line"
        if [ "$oracle" = 1 ]; then
            c_line=$(cd target/oracle/sagitta && build/fuzz_panes --iters=10000 --seed="$s") || {
                echo "C:    $c_line"
                exit 1
            }
            echo "C:    $c_line"
            if [ "$port_line" != "$c_line" ]; then
                echo "run-fuzz-panes: the port's report differs from C's at seed $s" >&2
                exit 1
            fi
        fi
    done
    exit 0
fi
exec "$driver" "$@"
