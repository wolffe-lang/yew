#!/bin/sh
# build-fuzz-groups — Sprint 24's group fuzz driver, tools/fuzz-groups/main.lu
# (the port of sagitta's tests/fuzz/fuzz_groups.c over fuzzlib.c's
# generator, tools/fuzzgen), built on the release tier into
# target/tools/fuzz-groups.
#
#   tools/build-fuzz-groups [--native]
#
# `use edit` resolves beside the ENTRY file (D32), so every module under
# src/ and the generator are staged beside a copy of the driver under
# target/fuzz-groups/, as tools/build-fuzz-shell stages its drivers.
# Nothing there is committed.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

tier=release
case "${1:-}" in
"") ;;
--native) tier=native ;;
*)
    echo "build-fuzz-groups: unknown option $1" >&2
    exit 2
    ;;
esac

stage="${YEW_ROOT:?}/target/fuzz-groups"
rm -rf "${stage:?}"
mkdir -p "$stage/fuzzgen" target/tools
cp tools/fuzz-groups/main.lu "$stage/main.lu"
cp tools/fuzzgen/*.lu "$stage/fuzzgen/"
for d in src/*/; do
    m=$(basename "$d")
    cp -R "src/$m" "$stage/$m"
    find "$stage/$m" -maxdepth 1 -name '*_test.lu' -exec rm -f {} +
done
if [ "$tier" = release ]; then
    "$WOLF" build --release --deny-warnings "$stage/main.lu" -o target/tools/fuzz-groups
else
    "$WOLF" build --deny-warnings "$stage/main.lu" -o target/tools/fuzz-groups
fi
echo "build-fuzz-groups: target/tools/fuzz-groups ($tier)"
