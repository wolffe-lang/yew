#!/bin/sh
# build-fuzz-flapi — Sprint 34's editor-API fuzz driver, tools/fuzz-flapi/
# main.lu (the port of sagitta's tests/fuzz/fuzz_flapi.c over fuzzlib.c's
# generator, tools/fuzzgen), built on the release tier into
# target/tools/fuzz-flapi.
#
#   tools/build-fuzz-flapi [--native]
#
# `use edit` resolves beside the ENTRY file (D32), so every module under
# src/ and the generator are staged beside a copy of the driver under
# target/fuzz-flapi/, as tools/build-fuzz-fl-vm stages its driver. Nothing
# there is committed.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

tier=release
case "${1:-}" in
"") ;;
--native) tier=native ;;
*)
    echo "build-fuzz-flapi: unknown option $1" >&2
    exit 2
    ;;
esac

stage="${YEW_ROOT:?}/target/fuzz-flapi"
rm -rf "${stage:?}"
mkdir -p "$stage/fuzzgen" target/tools
cp tools/fuzz-flapi/main.lu "$stage/main.lu"
cp tools/fuzzgen/*.lu "$stage/fuzzgen/"
for d in src/*/; do
    name=$(basename "$d")
    mkdir -p "$stage/$name"
    cp src/"$name"/*.lu "$stage/$name/"
    find "$stage/$name" -maxdepth 1 -name '*_test.lu' -exec rm -f {} +
done
if [ "$tier" = release ]; then
    "$WOLF" build --release --deny-warnings "$stage/main.lu" -o target/tools/fuzz-flapi
else
    "$WOLF" build --deny-warnings "$stage/main.lu" -o target/tools/fuzz-flapi
fi
echo "build-fuzz-flapi: target/tools/fuzz-flapi ($tier)"
