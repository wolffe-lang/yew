#!/usr/bin/env python3
"""gen-syn-paths — the path half of sagitta's builtin language detection.

Reads the oracle's generated table (target/oracle/sagitta/src/syn/langs_gen.c,
or the path given) and prints src/edit/syn_paths.lu: each builtin language's
id, name and priority, and the detect index's exact filenames, extensions and
globs (with each glob's split), in the oracle's order. yw11 ports only this
half of `yew_syn_lang_for` (syn/defs.c:3440-3510): no shebang, no first line,
no Fortran scoring, no user definitions (yw10's). tools/check-syn-paths
regenerates and diffs.
"""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
src = Path(sys.argv[1]) if len(sys.argv) > 1 else ROOT / "target/oracle/sagitta/src/syn/langs_gen.c"
text = src.read_text()

def wolf(s):
    return s.replace("\\", "\\\\").replace('"', '\\"').replace("{", "{{").replace("}", "}}")

langs = re.findall(r'\{\s*(\d+)U,\s*"([^"]+)",\s*"[^"]*",(?:[^{}]|\{[^{}]*\})*?,\s*(-?\d+),\s*\{', text)
def entries(name):
    body = re.search(r'static const SynDetectEntry ' + name + r'\[\] = \{(.*?)\n\};', text, re.S).group(1)
    return re.findall(r'\{"((?:[^"\\]|\\.)*)", (\d+)U, (\d+)U, (\d+)U\}', body)

out = []
out.append("//! edit.syn_paths — GENERATED by tools/gen-syn-paths from sagitta")
out.append("//! `src/syn/langs_gen.c` at the pin; do not edit (tools/check-syn-paths).")
out.append("//! One row a line, space-separated: languages `id name priority`;")
out.append("//! exact filenames and extensions `key lang`; globs `key split lang`.")
out.append("")
def emit(const, rows, doc):
    out.append(f"/// {doc}")
    out.append(f"pub const {const}: str = \"" + "\\n".join(wolf(r) for r in rows) + "\\n\"")
    out.append("")
emit("SYN_LANGS", [f"{i} {n} {p}" for i, n, p in langs], "The builtin languages (`yew_syn_builtin_langs`).")
emit("SYN_EXACT", [f"{k} {l}" for k, l, _, _ in entries("builtin_exact")], "Exact filenames (`builtin_exact`).")
emit("SYN_EXT", [f"{k} {l}" for k, l, _, _ in entries("builtin_extensions")], "Extensions (`builtin_extensions`).")
emit("SYN_GLOBS", [f"{k} {sp} {l}" for k, l, _, sp in entries("builtin_globs")], "Globs with their split (`builtin_globs`).")
sys.stdout.write("\n".join(out).rstrip("\n") + "\n")
