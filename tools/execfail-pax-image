#!/usr/bin/env python3
"""execfail-pax-image: a PAX live image with another yew (yw18, yew#127).

    python3 -I tools/execfail-pax-image ISO YEW WORK

ISO a PAX image as tools/mkdistribution makes it (its initramfs at
/boot/initramfs.cpio, a newc archive), YEW the yew to put in it (a
static build, `tools/build --static`), WORK a new directory. Writes
WORK/initramfs.cpio, the image's archive with the member `bin/yew`'s
bytes replaced by YEW's (every other member, every header field but the
size, and the order kept), and WORK/image.iso, ISO with that archive in
place of its own (`xorriso -boot_image any replay`: the boot records as
they were). Prints both files' sha256 and the members' before and after.
The UEFI entry boots it; the BIOS stage would need Limine's
`bios-install` again, which this does not run.
"""
import hashlib
import subprocess
import sys
from pathlib import Path

MEMBER = 'bin/yew'


def swap(src, dst, data):
    blob = src.read_bytes()
    out = bytearray()
    off = 0
    hit = 0
    while True:
        h = blob[off:off + 110]
        if h[:6] != b'070701':
            raise SystemExit(f'execfail-pax-image: not a newc header at {off}')
        f = [int(h[i:i + 8], 16) for i in range(6, 110, 8)]
        nsz, fsz = f[11], f[6]
        name = blob[off + 110:off + 110 + nsz - 1].decode()
        start = (off + 110 + nsz + 3) & ~3
        end = start + fsz
        nxt = (end + 3) & ~3
        if name.lstrip('./') == MEMBER:
            hit += 1
            old = blob[start:end]
            print(f'execfail-pax-image: {MEMBER} was {len(old)} bytes sha256 {hashlib.sha256(old).hexdigest()}')
            hdr = bytearray(h)
            hdr[6 + 6 * 8:6 + 7 * 8] = b'%08X' % len(data)
            out += hdr + blob[off + 110:start]
            out += data + b'\0' * (((len(data) + 3) & ~3) - len(data))
        else:
            out += blob[off:nxt]
        off = nxt
        if name == 'TRAILER!!!':
            out += blob[off:]
            break
    if hit != 1:
        raise SystemExit(f'execfail-pax-image: {MEMBER} found {hit} times')
    dst.write_bytes(out)
    print(f'execfail-pax-image: {MEMBER} now {len(data)} bytes sha256 {hashlib.sha256(data).hexdigest()}')


def main():
    iso, yew, work = Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3])
    work.mkdir(parents=True, exist_ok=False)
    orig = work / 'orig.cpio'
    subprocess.run(['xorriso', '-osirrox', 'on', '-indev', str(iso), '-extract', '/boot/initramfs.cpio', str(orig)],
                   check=True, capture_output=True)
    cpio = work / 'initramfs.cpio'
    swap(orig, cpio, yew.read_bytes())
    orig.unlink()
    out = work / 'image.iso'
    r = subprocess.run(['xorriso', '-indev', str(iso), '-outdev', str(out), '-boot_image', 'any', 'replay',
                        '-map', str(cpio), '/boot/initramfs.cpio', '-end'], capture_output=True, text=True)
    (work / 'xorriso.log').write_text(r.stdout + r.stderr)
    if r.returncode != 0:
        raise SystemExit(f'execfail-pax-image: xorriso exit {r.returncode}: {r.stderr[-600:]}')
    for p in (cpio, out):
        print(f'execfail-pax-image: {p.name} {p.stat().st_size} bytes sha256 {hashlib.sha256(p.read_bytes()).hexdigest()}')


if __name__ == '__main__':
    main()
