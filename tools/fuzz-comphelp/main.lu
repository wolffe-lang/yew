//! fuzz-comphelp — Sprint 57.25's `--help` parser under arbitrary bytes:
//! the port of sagitta `tests/fuzz/fuzz_comphelp.c` (159 lines) over C's
//! generator (`tools/fuzzgen`, `fuzzlib.c`'s bit for bit) at 9ace98c2.
//!
//! Help text is whatever a program on $PATH chose to print, so the parser
//! is an input boundary like any other. Seeded from the captured layout
//! fixtures (`tests/fuzz/corpus/fuzz_comphelp/`, verbatim, read line by
//! line as C's harness reads them); the first byte also picks how much of
//! a subcommand path (`tool sub deeper`) the usage rows are read against.
//! Asserted, as C asserts (`check_tree`, `check_round_trip`): BOUNDED
//! output — at most 512 subcommands and 512 flags, descriptions within 60
//! bytes, names in their grammar, aliases in it, no duplicate names, a
//! flag with a spelling and a one-byte short form, an optional value only
//! with a value — and the tree's data form reading back through the spec
//! reader to the same counts. A trap anywhere is the crash C reports.
//!
//!   fuzz-comphelp [--iters=N] [--seed=N]
//!
//! Defaults are C's (`--iters=200000 --seed=1`, also sagitta's
//! `COMPHELP_FUZZ_ITERS`, `Makefile:152`). The report line is C's.

use edit
use fuzzgen

const EPOCH: int = 4096

// `name_ok` (`fuzz_comphelp.c:33-48`).
fn name_ok(s: str) -> bool {
    let b = s.bytes()
    if b.len == 0 || b.len > 64 || !(b[0] as int >= 97 && b[0] as int <= 122) {
        return false
    }
    var i = 1
    while i < b.len {
        let c = b[i] as int
        if !(c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 95 || c == 45) {
            return false
        }
        i += 1
    }
    true
}

// `check_tree` (`fuzz_comphelp.c:50-96`).
fn check_tree(spec: edit.CompSpec) -> str {
    let root = copy spec.nodes[0]
    if root.subs.len > 512 || root.flags.len > 512 {
        return "unbounded: {root.subs.len} subs, {root.flags.len} flags"
    }
    var i = 0
    while i < root.subs.len {
        let s = copy spec.nodes[root.subs[i]]
        if !s.has_name || !name_ok(s.name) || s.parent != 0 || s.has_desc && s.desc.len > 60 {
            return "bad subcommand {i}"
        }
        for a in s.aliases {
            if !name_ok(a) {
                return "bad alias of {s.name}"
            }
        }
        var j = 0
        while j < i {
            if spec.nodes[root.subs[j]].name == s.name {
                return "duplicate {s.name}"
            }
            j += 1
        }
        i += 1
    }
    i = 0
    while i < root.flags.len {
        let f = copy root.flags[i]
        if !f.has_lng && !f.has_shrt ||
            f.has_shrt && f.shrt.len != 1 ||
            f.has_desc && f.desc.len > 60 ||
            f.arg_optional && f.arg < 0 {
            return "bad flag {i}"
        }
        i += 1
    }
    ""
}

// `check_round_trip` (`fuzz_comphelp.c:98-137`).
fn check_round_trip(spec: edit.CompSpec) -> str {
    var out = List[byte]()
    edit.compspec_write_node(spec, 0, 0, false, mut out)
    let doc = edit.fl_read_literal(out)
    if doc.error.len != 0 || doc.top.len == 0 {
        return "data form does not read back"
    }
    var reg = edit.compspecs_new()
    let (ok, back, _) = edit.compspec_read_node(mut reg, "fuzz", doc, doc.top[0])
    if !ok {
        return "data form does not read back"
    }
    if back.nodes[0].subs.len != spec.nodes[0].subs.len ||
        back.nodes[0].flags.len != spec.nodes[0].flags.len {
        return "data form changed the tree"
    }
    ""
}

// `check_comphelp` (`fuzz_comphelp.c:139-154`).
fn check(data: List[byte]) -> str {
    let all = ["tool", "sub", "deeper"]
    let n_words = if data.len == 0 then 1 else data[0] as int % 4
    var words = List[str]()
    var i = 0
    while i < n_words {
        (mut words).push(all[i])
        i += 1
    }
    let (ok, spec) = edit.comphelp_parse("help:fuzz", words, data)
    if !ok {
        return ""
    }
    let why = check_tree(spec)
    if why.len != 0 {
        return why
    }
    check_round_trip(spec)
}

fn main() -> int {
    let (ok, seed, iters) = fuzzgen.parse_args(env_args())
    if !ok {
        eprint("usage: fuzz-comphelp [--seed=N] [--iters=N]")
        return 2
    }
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let (cok, corpus) = fuzzgen.corpus_for("fuzz_comphelp")
    if !cok {
        return 2
    }
    let start = fuzzgen.run_new(seed)
    var state = start.state
    var hash = start.hash
    var done = 0
    var failed = false
    while done < iters && !failed {
        let n = if iters - done > EPOCH then EPOCH else iters - done
        region epoch {
            var r = fuzzgen.Run { state: state, hash: hash }
            var k = 0
            while k < n {
                let which = fuzzgen.choose(mut r, corpus.len)
                var input = copy corpus[which].bytes
                let mutations = 1 + fuzzgen.choose(mut r, 4)
                var op = 0
                var m = 0
                while m < mutations {
                    let (next, o) = fuzzgen.mutate(mut r, input, corpus)
                    input = next
                    op = o
                    m += 1
                }
                fuzzgen.hash_bytes(mut r, input)
                let why = check(input)
                if why.len != 0 {
                    eprint(
                        "fuzz_comphelp: FAIL seed={seed} iter={done + k} corpus={corpus[which].name} op={fuzzgen.op_name(op)}: {why}",
                    )
                    eprint("fuzz_comphelp: input={fuzzgen.hex_of(input)}")
                    failed = true
                    break
                }
                k += 1
            }
            state = r.state
            hash = r.hash
        }
        done += n
    }
    if failed {
        return 1
    }
    print(
        "fuzz_comphelp: seed={seed} iters={iters} corpus={corpus.len} hash={fuzzgen.hex16(hash)} ok",
    )
    0
}
