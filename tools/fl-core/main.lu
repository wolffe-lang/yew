//! Nonshipping core differential driver, pinned fl_smoke.c:60-109.

use fl
use util
use std.fs

fn fixture(i: int) -> (str, str) {
    match i {
        0 => ("arith", "return 1 + 2 * 3 - 4 / 2 % 3\n"),
        1 => ("compare", "return 1 < 2\n"),
        2 => ("floats", "return 1 + 2.5\n"),
        3 => ("strings", "let a = \"ab\" + \"cd\"\nreturn a == \"abcd\"\n"),
        4 => ("truthy", "if 0 {{ return 1 }}\nreturn 2\n"),
        5 => ("shortcut", "let a = nil or 3\nlet b = a and 4\nreturn b\n"),
        6 => ("ifelse", "if false {{ return 1 }} else {{ return 2 }}\n"),
        7 => ("whileloop", "let n = 0\nwhile n < 5 {{ n = n + 1 }}\nreturn n\n"),
        8 => ("forlist", "let t = 0\nfor x in [1,2,3] {{ t = t + x }}\nreturn t\n"),
        9 => ("formap", "let t = 0\nfor k, v in {{a:1, b:2}} {{ t = t + v }}\nreturn t\n"),
        10 =>
            (
                "breakcont",
                "let t = 0\nfor x in [1,2,3,4] {{ if x == 2 {{ continue }}\nif x == 4 {{ break }}\nt = t + x }}\nreturn t\n",
            ),
        11 => ("globals", "let g = 1\ng = g + 1\nreturn g\n"),
        12 => ("locals", "fn f() {{ let a = 1\nlet b\na = a + 2\nreturn a }}\nreturn f()\n"),
        13 =>
            (
                "closure",
                "fn c(s) {{ let n = s\nreturn fn() {{ n = n + 1\nreturn n }} }}\nlet nx = c(8)\nlet a = nx()\nreturn nx()\n",
            ),
        14 =>
            (
                "recursion",
                "fn fib(n) {{ if n < 2 {{ return n }}\nreturn fib(n - 1) + fib(n - 2) }}\nreturn fib(10)\n",
            ),
        15 => ("listconcat", "let l = []\nfor x in [1,2,3] {{ l = l + [x] }}\nreturn l[2]\n"),
        16 =>
            ("indexing", "let l = [1,2]\nl[0] = 9\nlet m = {{a: 1}}\nm.a = 2\nreturn l[0] + m.a\n"),
        17 => ("trycatch", "try {{ return 1 / 0 }} catch e {{ return 7 }}\n"),
        18 => ("trynoraise", "try {{ return 5 }} catch e {{ return 9 }}\n"),
        19 =>
            (
                "motion",
                "try {{ edit {{ @[ 2v i\"!\" del ] }} }}\ncatch e {{ return 1 }}\nreturn 0\n",
            ),
        20 =>
            (
                "spec14",
                "fn clamp(x, lo, hi) {{\n    if x < lo {{ return lo }}\n    else if x > hi {{ return hi }}\n    return x\n}}\nfn counter(start) {{\n    let n = start\n    return fn() {{ n = n + 1; return n }}\n}}\nlet next = counter(clamp(9, 0, 8))\nwhile next() < 10 {{ }}\nlet nums = [1, 2.5, 0x10]\nlet total = 0\nfor x in nums {{\n    if x == 2.5 {{ continue }}\n    total = total + x\n}}\nreturn total\n",
            ),
        _ => ("", ""),
    }
}

fn compile(mut vm: fl.FlVm, src: List[byte], path: str) -> fl.FlValue {
    let id = fl.fl_diag_add_file(mut vm.dc, path, src)
    let p = fl.fl_parse(src, id, mut vm.dc, mut vm.strings)
    if p.incomplete && !p.had_error {
        eprint("{path}: error: unexpected end of input; a bracket or block is still open")
        return fl.fl_nil()
    }
    var f = fl.fl_nil()
    if !p.had_error { f = fl.fl_compile(mut vm, p, id, fl.fl_origin_new(4, 0)) else fl.fl_nil() }
    var fd = fs.stderr()
    for d in vm.dc.entries {
        var out = List[byte]()
        fl.fl_diag_render(mut out, vm.dc, d.level, d.sp, d.msg)
        fs.write_chunk(mut fd, out) else |_| { os_exit(3) }
    }
    f
}

fn dump_fn(vm: fl.FlVm, f: fl.FlValue, depth: int, mut out: List[byte]) {
    if depth > 32 { return }
    let at = fl.fl_obj_index(vm, f)
    let id = vm.gc.slots[at].name_id
    let name = if id == 0 then "<fn>" else (str_from_utf8(vm.strings.items[id]) else "?")
    util.buf_append_str(mut out, "-- {name}/{vm.gc.slots[at].arity}\n")
    fl.fl_disasm_chunk(vm, f, mut out)
    (mut out).push(10 as byte)
    for v in vm.gc.slots[at].vals { if v.t == 7 { dump_fn(vm, v, depth + 1, mut out) } }
}

fn value_text(vm: fl.FlVm, v: fl.FlValue) -> str {
    match v.t {
        0 => "nil",
        1 => if v.i != 0 then "true" else "false",
        2 => "{v.i}",
        3 => fl.float_general(v.f, 17),
        4 => "\"{str_from_utf8(vm.gc.slots[fl.fl_obj_index(vm, v)].bytes) else "?"}\"",
        _ => "<{fl.fl_type_name(v.t)}>",
    }
}

fn trace() -> int {
    print("# fletch executed-opcode traces")
    print("# dispatch: wolf-switch")
    print("#")
    print("# DoD 5: this file must be BYTE-IDENTICAL between the")
    print("# two dispatch modes, the header line above excepted --")
    print("# it is the one line that is allowed to differ, and the")
    print("# make target strips it before comparing.")
    for i in 0..21 {
        region run {
            let (name, text) = fixture(i)
            var strings = fl.fl_strings()
            var vm = fl.fl_vm_new(take strings)
            var src = List[byte]()
            for b in text.bytes() { (mut src).push(b) }
            let f = compile(mut vm, src, name)
            if f.t != 7 { return 1 }
            vm.tracing = true
            let result = fl.fl_vm_run(mut vm, f)
            print("\n== {name} ({vm.trace.len} ops) -> {value_text(vm, result)}")
            for k in 0..vm.trace.len {
                print_raw(fl.fl_op_name(vm.trace[k] as int))
                print_raw(if (k + 1) % 6 == 0 then "\n" else " ")
            }
            if vm.trace.len % 6 != 0 { print("") }
        }
    }
    0
}

fn main() -> int {
    let args = env_args()
    if args.len == 1 && args[0] == "--train" { return train() }
    if args.len >= 1 && args.len <= 2 && args[0] == "--perf" {
        let requested = if args.len == 2 then (args[1].to_int() else 1) else 3
        return perf(if requested < 1 then 1 else requested)
    }
    if args.len == 1 && args[0] == "--trace" { return trace() }
    if args.len != 2 || args[0] != "--dump-bytecode" { return 2 }
    let src = fs_read_bytes(args[1]) else { return 3 }
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let f = compile(mut vm, src, args[1])
    if f.t != 7 { return 1 }
    var out = List[byte]()
    dump_fn(vm, f, 0, mut out)
    var fd = fs.stdout()
    fs.write_chunk(mut fd, out) else |_| { return 3 }
    0
}

fn perf(reps: int) -> int {
    for row in 0..3 {
        let name = if row == 0 then "fib24" else if row == 1 then "map10k" else "motion100k"
        let text = if row == 0 {
            "fn fib(n) {{ if n < 2 {{ return n }}\nreturn fib(n - 1) + fib(n - 2) }}\nreturn fib(24)\n"
        } else if row == 1 {
            "let m = {{}}\nlet i = 0\nwhile i < 10000 {{ m[i] = i\ni = i + 1 }}\nreturn i\n"
        } else {
            "let i = 0\nwhile i < 100000 {{\n  try {{ edit {{ @[ 2v ] }} }} catch e {{ }}\n  i = i + 1\n}}\nreturn i\n"
        }
        var best: int = -1
        var collections: int = 0
        var result: int = 0
        for _ in 0..reps {
            region rep {
                var strings = fl.fl_strings()
                var vm = fl.fl_vm_new(take strings)
                var src = List[byte]()
                for b in text.bytes() { (mut src).push(b) }
                let begin = os_clock_ns()
                let f = compile(mut vm, src, name)
                if f.t != 7 { return 1 }
                let out = fl.fl_vm_run(mut vm, f)
                let elapsed = os_clock_ns() - begin
                if vm.raised || out.t != 2 { return 1 }
                result = out.i
                collections = vm.gc.collections
                if best < 0 || elapsed < best { best = elapsed }
            }
        }
        print("{name} elapsed_ns={best} gc={collections} result={result}")
    }
    0
}

// Diagnostic PGO workload only; never changes the ordinary build policy.
fn train() -> int {
    let rc = perf(1)
    if rc != 0 { return rc }
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let text = "fn fib(n) {{\n  if n < 2 {{ return n }}\n  return fib(n - 1) + fib(n - 2)\n}}\nreturn fib(27)\n"
    var src = List[byte]()
    for b in text.bytes() { (mut src).push(b) }
    let f = compile(mut vm, src, "fib27")
    if f.t != 7 { return 1 }
    let out = fl.fl_vm_run(mut vm, f)
    if vm.raised || out.t != 2 || out.i != 196418 { return 1 }
    print("PGO training fib27 result=196418")
    0
}
