#!/usr/bin/env bash
# run-perf-unicode — campaign 00's performance gate: the port beside C.
#
#   tools/run-perf-unicode [--taskset "0-3"] [--rounds N]
#
# Runs sagitta's own `build/perf_unicode` (from the oracle tree
# tools/oracle built) and the port's twin (tools/perf-unicode/main.lu,
# built on the release tier) on this host, each N times (default 3),
# pinned to the CPUs given (default none; the track's rule is
# `taskset -c 0-3` on kasumi), and prints the best `best_us` of each
# case for both with the wolf/C ratio:
#
#   perf-unicode: <case> C=<us> wolf=<us> ratio=<x.xx>
#
# Exit 0 always: the numbers are a FINDING for the lane's note
# (ruling #89 R3: the 2x gate is a CI gate from yw01, the first paint;
# yw00 records). wolf's clock is milliseconds (`clock_ms`,
# `time_now_ms`; no finer builtin at 0.2.32 — docs/MAP.md), so the
# port's harness times batches of 32 scans and divides: its `best_us`
# carries a resolution of about 32 us.
#
# The port's harness imports `src/unicode`; `use` resolves under the
# entry's directory (D32), so a copy of the module sits beside a copy
# of the harness under target/perf/ for the build. Nothing is committed
# from there.
set -eu
YEW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export YEW_ROOT
cd "$YEW_ROOT"
. tools/lib-toolchain.sh

pin=
rounds=3
while [ $# -gt 0 ]; do
    case "$1" in
    --taskset) pin=$2; shift 2 ;;
    --rounds) rounds=$2; shift 2 ;;
    *) echo "run-perf-unicode: unknown option $1" >&2; exit 2 ;;
    esac
done
run() { if [ -n "$pin" ]; then taskset -c "$pin" "$@"; else "$@"; fi; }

tree=$YEW_ROOT/target/oracle/sagitta
cbin=$tree/build/perf_unicode
[ -x "$cbin" ] || { echo "run-perf-unicode: no $cbin; run tools/oracle first" >&2; exit 2; }

stage=$YEW_ROOT/target/perf
rm -rf "$stage"
mkdir -p "$stage"
cp tools/perf-unicode/main.lu "$stage/main.lu"
cp -R src/unicode "$stage/unicode"
rm -f "$stage"/unicode/*_test.lu
"$WOLF" build --release --deny-warnings "$stage/main.lu" -o "$stage/perf-unicode"

best() { # file case -> min best_us for the case across rounds
    grep -E "^unicode-perf: $2 " "$1" | sed -nE 's/.*best_us=([0-9]+).*/\1/p' | sort -n | head -1
}
: >"$stage/c.txt"; : >"$stage/w.txt"
i=0
while [ $i -lt "$rounds" ]; do
    ( cd "$tree" && YEW_PERF_ADVISORY=1 run "$cbin" ) >>"$stage/c.txt" 2>&1 || true
    run "$stage/perf-unicode" >>"$stage/w.txt" 2>&1
    i=$((i + 1))
done
echo "perf-unicode: host $(uname -sm) $(hostname), pin ${pin:-none}, rounds $rounds; C and wolf best_us are each the best of $rounds x 7"
for case in ascii cjk emoji; do
    c=$(best "$stage/c.txt" "$case"); w=$(best "$stage/w.txt" "$case")
    if [ -n "$c" ] && [ -n "$w" ] && [ "$c" -gt 0 ]; then
        ratio=$(awk -v c="$c" -v w="$w" 'BEGIN { printf "%.2f", w / c }')
        echo "perf-unicode: $case C=${c}us wolf=${w}us ratio=$ratio"
    else
        echo "perf-unicode: $case C=${c:-?}us wolf=${w:-?}us ratio=?"
    fi
done
grep -E '^unicode-perf: (ascii|cjk|emoji) ' "$stage/c.txt" | sed 's/^/perf-unicode: C:    /'
grep -E '^unicode-perf: (ascii|cjk|emoji) ' "$stage/w.txt" | sed 's/^/perf-unicode: wolf: /'
