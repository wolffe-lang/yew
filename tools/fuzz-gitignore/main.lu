//! fuzz-gitignore — Sprint 26 §4's matcher fuzz: the port of sagitta
//! `tests/fuzz/fuzz_gitignore.c` (272 lines) over the generator of
//! `tests/fuzz/fuzzlib.c` (`yew_fuzz_main`) at 9ace98c2, which
//! `tools/fuzzgen` ports C's bit for bit, so a seed's `hash=` is C's for
//! the same seed and iterations — the witness that the port ran the same
//! inputs.
//!
//! The check is C's `run_session` (`fuzz_gitignore.c:176-267`): the
//! input's own LCG seeded from its bytes; the input itself as a pattern
//! (NUL and newline made `a`) against a random path; the 35 adversarial
//! shapes (`:101-137`) against the long path and a random one; 64 random
//! patterns from the weighted alphabet; a 32-rule set over 32 random
//! paths. Each `check_one` (`:140-174`) compiles the pattern as a one-line
//! file and asks `gi_match` both ways, `gi_prunable` and `gi_negated`,
//! bounded at 250 ms (the 32-rule set at 1,000 ms): an exponential
//! backtracker or a trap is the failure. Paths are ASCII by C's
//! alphabet; a pattern carries the input's raw bytes.
//!
//!   fuzz-gitignore [--iters=N] [--seed=N] [--answers]
//!
//! Defaults are C's (`--iters=200000 --seed=1`, `Makefile:101-102`,
//! `:2265`). `--answers` also folds every answer the sessions asked into
//! one FNV-1a hash and prints it on a second line: C's driver prints no
//! answers, so `notes/yw06-evidence/pick/gitignore/gi_answers.c` is C's
//! session with the same fold over C's own matcher, and the two lines
//! agreeing is the claim that the port's matcher answers C's on every
//! (pattern, path) pair the campaign draws. One region an epoch, the
//! sessions' sets dying with it.

use fuzzgen
use ws

const EPOCH: int = 64

struct Rng {
    s: wrapping[u64],
}

// `rng_next` (`fuzz_gitignore.c:43-47`).
fn rng_next(mut r: Rng) -> int {
    r.s = r.s * 6364136223846793005 + 1442695040888963407
    (r.s >> 33) as int
}

// `rng_below` (`fuzz_gitignore.c:49-52`).
fn rng_below(mut r: Rng, n: int) -> int {
    if n == 0 {
        return 0
    }
    rng_next(mut r) % n
}

// `gi_alphabet` (`fuzz_gitignore.c:69`): 21 bytes.
fn gi_alphabet() -> str {
    "*?[]!^-/\\.abcXYZ09 \t#"
}

// `random_pattern` (`fuzz_gitignore.c:71-79`) with C's `cap` of 128.
fn random_pattern(mut r: Rng) -> List[byte] {
    let len = rng_below(mut r, 127)
    var out = List[byte]()
    var i = 0
    while i < len {
        (mut out).push(gi_alphabet().bytes()[rng_below(mut r, 21)])
        i += 1
    }
    out
}

// `random_path` (`fuzz_gitignore.c:81-91`) with C's `cap` of 512.
fn random_path(mut r: Rng) -> str {
    let path_alphabet = "abcXYZ09/._-"
    let len = 1 + rng_below(mut r, 510)
    var out = List[byte]()
    var i = 0
    while i < len {
        (mut out).push(path_alphabet.bytes()[rng_below(mut r, 12)])
        i += 1
    }
    str_from_utf8(out) else ""
}

// `gi_adversarial` (`fuzz_gitignore.c:101-137`).
fn adversarial() -> List[str] {
    var a = List[str]()
    (mut a).push("a**b**c**d**e")
    (mut a).push("*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*")
    (mut a).push("**/**/**/**/**")
    (mut a).push("[")
    (mut a).push("[]")
    (mut a).push("[!")
    (mut a).push("[a-")
    (mut a).push("[[[[[[[[")
    (mut a).push("]]]]]]]]")
    (mut a).push("\\")
    (mut a).push("a\\")
    (mut a).push("*\\")
    (mut a).push("[\\")
    (mut a).push("**")
    (mut a).push("/")
    (mut a).push("//")
    (mut a).push("///")
    (mut a).push("!")
    (mut a).push("!!")
    (mut a).push("!/")
    (mut a).push("*/")
    (mut a).push("/*")
    (mut a).push("a/**/b/**/c")
    (mut a).push("?????????????????????????")
    (mut a).push("*?*?*?*?*?*?*?*?*?*?")
    (mut a).push("[a-z][a-z][a-z][a-z][a-z][a-z][a-z][a-z]")
    (mut a).push("\\**\\**\\**")
    (mut a).push("#notacomment")
    (mut a).push("\\#escaped")
    (mut a).push("trailing   ")
    (mut a).push("trailing\\ ")
    (mut a).push("a[b-")
    (mut a).push("[^]")
    (mut a).push("[]]")
    (mut a).push("**a**")
    a
}

// `long_path` (`fuzz_gitignore.c:212-215`).
fn long_path() -> str {
    "aaaaaaaaaa/bbbbbbbbbb/cccccccccc/dddddddddd/eeeeeeeeee/ffffffffff/gggggggggg/hhhhhhhhhh/iiiiiiiiii/jjjjjjjjjj/kkkkkkkkkk/llllllllll/mmmmmmmmmm/nnnnnnnnnn/oooooooooo.c"
}

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for x in s.bytes() {
        (mut v).push(x)
    }
    v
}

fn now_ms() -> int {
    os_clock_ns() / 1000000
}

// The answer fold (`--answers`): FNV-1a over one byte per answer.
struct Fold {
    on: bool,
    h: wrapping[u64],
}

fn fold(mut f: Fold, v: int) {
    if !f.on {
        return
    }
    f.h = (f.h ^ v as wrapping[u64]) * 1099511628211
}

// `check_one` (`fuzz_gitignore.c:140-174`): "" when the pattern answered
// in bounded time, else why. A pattern compiling to nothing (a blank
// line, a comment, a lone `!`) is a legitimate answer.
fn check_one(mut g: ws.Gi, mut f: Fold, pattern: List[byte], path: str) -> str {
    var text = copy pattern
    (mut text).push(10 as byte)
    let s = ws.gi_compile(mut g, "", text, ws.GI_NONE)
    if s == ws.GI_NONE {
        fold(mut f, 7)
        return ""
    }
    let start = now_ms()
    let a = ws.gi_match(g, s, path, false)
    let b = ws.gi_match(g, s, path, true)
    let c = ws.gi_prunable(g, s, path)
    let d = ws.gi_negated(g, s, path)
    let elapsed = now_ms() - start
    fold(
        mut f,
        (if a then 1 else 0) + (if b then 2 else 0) + (if c then 4 else 0) + (if d then 8 else 0),
    )
    if elapsed > 250 {
        let shown = str_from_utf8(pattern) else "(not UTF-8)"
        return "pattern '{shown}' took {elapsed} ms against a {path.len}-byte path"
    }
    ""
}

// `run_session` (`fuzz_gitignore.c:176-267`): "" when every check held.
fn run_session(data: List[byte], mut f: Fold) -> str {
    var rng = Rng { s: 11400714819323198485 }
    for x in data {
        rng.s = rng.s * 31 + x as int as wrapping[u64]
    }
    var g = ws.gi_new()
    // The case bytes themselves, as both pattern and path.
    let n = if data.len < 127 then data.len else 127
    var pattern = List[byte]()
    var k = 0
    while k < n {
        let x = data[k] as int
        (mut pattern).push(if x == 0 || x == 10 then 97 as byte else data[k])
        k += 1
    }
    var path = random_path(mut rng)
    var why = check_one(mut g, mut f, pattern, path)
    // The adversarial shapes, each against a long path.
    let shapes = adversarial()
    var i = 0
    while why.len == 0 && i < shapes.len {
        why = check_one(mut g, mut f, bytes_of(shapes[i]), long_path())
        if why.len == 0 {
            path = random_path(mut rng)
            why = check_one(mut g, mut f, bytes_of(shapes[i]), path)
        }
        i += 1
    }
    // A round of purely random patterns from the weighted alphabet.
    i = 0
    while why.len == 0 && i < 64 {
        let p = random_pattern(mut rng)
        path = random_path(mut rng)
        why = check_one(mut g, mut f, p, path)
        i += 1
    }
    // A multi-rule file: precedence and the negation scan walk every
    // rule, so a set of terminating rules could still be pathological.
    if why.len == 0 {
        var text = List[byte]()
        i = 0
        while i < 32 && text.len + 130 < 4096 {
            let p = random_pattern(mut rng)
            for x in p {
                (mut text).push(x)
            }
            (mut text).push(10 as byte)
            i += 1
        }
        let s = ws.gi_compile(mut g, "", text, ws.GI_NONE)
        if s != ws.GI_NONE {
            let start = now_ms()
            i = 0
            while i < 32 {
                path = random_path(mut rng)
                let a = ws.gi_match(g, s, path, i & 1 != 0)
                let c = ws.gi_prunable(g, s, path)
                fold(mut f, (if a then 1 else 0) + (if c then 4 else 0))
                i += 1
            }
            if now_ms() - start > 1000 {
                why = "a 32-rule set took {now_ms() - start} ms over 32 paths"
            }
        } else {
            fold(mut f, 7)
        }
    }
    why
}

fn main() -> int {
    var answers = false
    var rest = List[str]()
    for a in env_args() {
        if a == "--answers" {
            answers = true
        } else {
            (mut rest).push(a)
        }
    }
    let (ok, seed, iters) = fuzzgen.parse_args(rest)
    if !ok {
        eprint("usage: fuzz-gitignore [--seed=N] [--iters=N] [--answers]")
        return 2
    }
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let (cok, corpus) = fuzzgen.corpus_for("fuzz_gitignore")
    if !cok {
        return 2
    }
    let start = fuzzgen.run_new(seed)
    var state = start.state
    var hash = start.hash
    var fh: wrapping[u64] = 14695981039346656037
    var done = 0
    var failed = false
    while done < iters && !failed {
        let n = if iters - done > EPOCH then EPOCH else iters - done
        region epoch {
            var r = fuzzgen.Run { state: state, hash: hash }
            var f = Fold { on: answers, h: fh }
            var k = 0
            while k < n {
                let which = fuzzgen.choose(mut r, corpus.len)
                var input = copy corpus[which].bytes
                // PLANT: one mutation more than C's (fuzz_gitignore)
                let mutations = 2 + fuzzgen.choose(mut r, 4)
                var op = 0
                var m = 0
                while m < mutations {
                    let (next, o) = fuzzgen.mutate(mut r, input, corpus)
                    input = next
                    op = o
                    m += 1
                }
                fuzzgen.hash_bytes(mut r, input)
                let why = run_session(input, mut f)
                if why.len != 0 {
                    eprint(
                        "fuzz_gitignore: FAIL seed={seed} iter={done + k} corpus={corpus[which].name} op={fuzzgen.op_name(op)}: {why}",
                    )
                    eprint("fuzz_gitignore: input={fuzzgen.hex_of(input)}")
                    failed = true
                    break
                }
                k += 1
            }
            state = r.state
            hash = r.hash
            fh = f.h
        }
        done += n
    }
    if failed {
        return 1
    }
    print(
        "fuzz_gitignore: seed={seed} iters={iters} corpus={corpus.len} hash={fuzzgen.hex16(hash)} ok",
    )
    if answers {
        print("fuzz_gitignore: answers={fuzzgen.hex16(fh)}")
    }
    0
}
