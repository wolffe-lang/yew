#!/usr/bin/env python3
"""Pure control tests: a named refusal must never become a passed case."""
import importlib.machinery,importlib.util,pathlib,unittest
path=pathlib.Path(__file__).with_name('check-test-cases')
loader=importlib.machinery.SourceFileLoader('checked_cases',str(path))
spec=importlib.util.spec_from_loader(loader.name,loader)
m=importlib.util.module_from_spec(spec);loader.exec_module(m)
class Allowances(unittest.TestCase):
    def test_existing_reasons_are_unconditional(self):
        for reason in ('budget','call-depth','self-exec',None):
            self.assertEqual(m.active_reason(reason,{}),reason)
    def test_stress_reason_is_inactive_normally(self):
        self.assertIsNone(m.active_reason('stress-budget',{}))
    def test_presence_not_truthiness_selects_stress(self):
        for name in ('YEW_FL_GC_STRESS','FL_GC_STRESS'):
            for value in ('','0','1'):
                self.assertEqual(m.active_reason('stress-budget',{name:value}),'stress-budget')
    def test_exact_refusal_is_required(self):
        self.assertTrue(m.allowance_matches('budget','unsupported','step budget exhausted'))
        self.assertTrue(m.allowance_matches('call-depth','unsupported','call depth budget exhausted'))
        self.assertFalse(m.allowance_matches('budget','unsupported','call depth budget exhausted'))
        self.assertFalse(m.allowance_matches('stress-budget','unsupported','another construct'))
    def test_now_green_allowance_is_stale(self):
        for reason in m.REASONS:
            self.assertFalse(m.allowance_matches(reason,'exit(0)',m.REASONS[reason]))
if __name__=='__main__':unittest.main()
