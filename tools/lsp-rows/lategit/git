#!/bin/sh
# lategit: the git that lspw_open_diag_lategit (tools/lsp-rows/lsprows.c)
# puts first on the editors' PATH, so that the row decides when C yew's
# repository discovery answers.
#
# At its first idle turn C yew runs `git --version`, then `git rev-parse
# ...`, as jobs (sagitta's src/mod/git/git.c:1481-1483 and :1572-1576), and
# a job's start and exit redraw its footer (src/edit/loop.c:615-621). Each
# call here waits until the row opens its gate, $XDG_STATE_HOME/git.gate
# (the case's state directory: the harness gives it to the editor, and the
# editor's jobs inherit it), then runs the next git on PATH and appends
# "<arguments> exit=<status>" to $XDG_STATE_HOME/git.receipt. A wait gives
# up after 30 s; C kills a read call at 5 s anyway (src/mod/git/git.h:19).
state=${XDG_STATE_HOME:?lategit: no XDG_STATE_HOME}
self=$(cd "$(dirname "$0")" && pwd -P)
rest=
old_ifs=$IFS
IFS=:
for d in $PATH; do
    if [ "$(cd "$d" 2>/dev/null && pwd -P)" != "$self" ]; then
        rest=${rest:+$rest:}$d
    fi
done
IFS=$old_ifs
PATH=$rest
export PATH
i=0
while [ ! -e "$state/git.gate" ]; do
    i=$((i + 1))
    if [ "$i" -gt 600 ]; then
        echo "lategit: the gate never opened" >&2
        exit 125
    fi
    sleep 0.05
done
git "$@"
rc=$?
printf '%s exit=%s\n' "$*" "$rc" >> "$state/git.receipt"
exit "$rc"
