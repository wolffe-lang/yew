#!/usr/bin/env python3
"""Hold the decided 81-case gate to the pinned C registry (R-yw06-7).
C: tests/pty/registry.c:12597-13410. No golden or registry is modified.
"""
from collections import Counter
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parent.parent
PREFIXES = ("s25_", "s26_", "s27_", "chrome_", "s57_11_", "s57_12_",
            "s57_13_", "s57_14_", "s57_15_", "s57_22_")
EXCLUDED = {"s57_13_fuss_file_menu", "s57_13_fuss_dir_menu"}
EXTRA = {"startup_explicit_workspace", "startup_multiple_files"}


def differences(got, want):
    errors = []
    if len(got) != 81:
        errors.append("count=%d, expected81" % len(got))
    duplicate = sorted(k for k, count in Counter(got).items() if count > 1)
    if duplicate:
        errors.append("duplicates=" + ",".join(duplicate))
    missing = sorted(set(want) - set(got))
    extra = sorted(set(got) - set(want))
    if missing:
        errors.append("missing=" + ",".join(missing))
    if extra:
        errors.append("extra=" + ",".join(extra))
    if not missing and not extra and got != want:
        errors.append("order differs from C registry")
    return errors


if sys.argv[1:] not in ([], ["--selftest"]):
    sys.exit("usage: check-yw06-cases [--selftest]")
registry = ROOT / "target/oracle/sagitta/tests/pty/registry.c"
if not registry.is_file():
    sys.exit("check-yw06-cases: no pinned oracle registry; run tools/oracle first")
registered = re.findall(r"^\s*C\((\w+),", registry.read_text(), re.M)
expected = [name for name in registered
            if (name.startswith(PREFIXES) or name in EXTRA) and name not in EXCLUDED]
if len(expected) != 81 or len(set(expected)) != 81:
    sys.exit("check-yw06-cases: pinned registry no longer yields81 unique owned cases")
actual = (ROOT / "tools/goldens-yw06-cases.txt").read_text().splitlines()
errors = differences(actual, expected)
if errors:
    sys.exit("check-yw06-cases: " + "; ".join(errors))
if sys.argv[1:]:
    plants = {
        "missing": expected[:-1],
        "duplicate": expected[:-1] + [expected[0]],
        "foreign": expected[:-1] + ["s57_13_fuss_file_menu"],
        "reordered": [expected[1], expected[0]] + expected[2:],
    }
    for name, planted in plants.items():
        found = differences(planted, expected)
        if not found:
            sys.exit("check-yw06-cases: selftest missed " + name)
        print("check-yw06-cases: plant " + name + " caught: " + "; ".join(found))
print("check-yw06-cases: 81 names match pinned C in both directions and registry order")
