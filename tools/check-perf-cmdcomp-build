#!/usr/bin/env python3
"""Exercise build-only through the real shell driver, with a fixture compiler.
The measured C work remains tests/perf/perf_cmdcomp.c:247-304. yew#44:
compile failure/refusal must survive, even with PERF_PREBUILT=1; no program
may run at this stage. The real pinned compiler is exercised by the CI step
immediately following this test, not substituted by this fixture.
"""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
(ROOT / "target").mkdir(exist_ok=True)
with tempfile.TemporaryDirectory(prefix="perf-build-selftest-", dir=ROOT / "target") as tmp:
    root = Path(tmp)
    (root / "tools").mkdir()
    shutil.copyfile(ROOT / "tools/run-perf-cmdcomp", root / "tools/run-perf-cmdcomp")
    (root / "tools/lib-toolchain.sh").write_text('WOLF="$YEW_ROOT/fake-wolf"\n')
    (root / "tools/perf-cmdcomp").mkdir()
    (root / "tools/perf-cmdcomp/main.lu").write_text("// fixture only\n")
    for module in ("util", "unicode", "term", "text", "search", "ws", "edit"):
        (root / "src" / module).mkdir(parents=True)
    oracle = root / "target/oracle/sagitta"
    (oracle / "build-fixture").mkdir(parents=True)
    (oracle / "build").symlink_to("build-fixture")
    marker = root / "measurement-ran"
    program = "#!/bin/sh\ntouch '" + str(marker) + "'\nexit 0\n"
    c = oracle / "build-fixture/perf_cmdcomp"
    c.write_text(program)
    c.chmod(0o755)
    compiler = root / "fake-wolf"
    compiler.write_text('''#!{python}
import json, os, sys
from pathlib import Path
with open(os.environ['BUILD_CALLS'], 'a') as f:
    f.write(json.dumps(sys.argv[1:]) + '\\n')
rc = int(os.environ['COMPILE_EXIT'])
if rc: sys.exit(rc)
out = Path(sys.argv[sys.argv.index('-o') + 1])
out.write_text({program!r})
out.chmod(0o755)
'''.format(python=sys.executable, program=program))
    compiler.chmod(0o755)
    env = os.environ.copy()
    env["PERF_PREBUILT"] = "1"
    for want in (2, 4, 0):
        # Stale executable must never turn build-only into a no-build pass.
        stage = root / "target/perf-cmdcomp"
        stage.mkdir(parents=True, exist_ok=True)
        stale = stage / "perf-cmdcomp"
        stale.write_text(program)
        stale.chmod(0o755)
        calls = root / ("calls-%d.jsonl" % want)
        env["BUILD_CALLS"] = str(calls)
        env["COMPILE_EXIT"] = str(want)
        result = subprocess.run(["bash", "tools/run-perf-cmdcomp", "--build-only"],
                                cwd=root, env=env, capture_output=True, text=True)
        assert result.returncode == want, (want, result.returncode, result.stdout, result.stderr)
        rows = [json.loads(line) for line in calls.read_text().splitlines()]
        assert len(rows) == 1, rows
        assert rows[0][:3] == ["build", "--release", "--deny-warnings"], rows
        assert not marker.exists(), "build-only ran a measurement program"
        print("perf-build: compiler exit=%d preserved; one compile; no measurement" % want)
print("perf-build: GREEN; compile error/refusal are not advisory success; 0 SKIP")
