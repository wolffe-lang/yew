//! member: false
//! The two tests/unit/test_trust_prompt.c cases at sagitta 9ace98c2, in
//! registry order (Sprint 36: the trust prompt has no PTY golden at the
//! pin; these are its gate). C's `tp_done` recorder is the prompt's
//! TRUST_DONE_RECORD kind, its fixture database the one the prompt owns.

use edit
use std.fs
use term
use text

struct TrustPromptFix { state_home: str, config: str, saved: str, had: bool }

var fix_counter: int = 0

fn env_copy(name: str) -> (str, bool) {
    let v = env_get(name) else |_| { return ("", false) }
    (v, true)
}

fn tp_key(code: int) -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    k.code = code
    if code < 128 { (mut k.text).push(code as byte) }
    k
}

// tp_make (test_trust_prompt.c:53-87).
fn tp_make() -> (TrustPromptFix, edit.TrustProbe, edit.Ed) {
    var n = 0
    // # Safety: the test is one thread; the counter names fresh trees.
    unsafe {
        fix_counter += 1
        n = fix_counter
    }
    let (saved, had) = env_copy("XDG_STATE_HOME")
    let home = "/tmp/yew-trust-prompt-{os_pid()}-{n}"
    fs.remove_dir_all(home) else |_| {}
    fs.create_dir_all(home) else |_| { assert(false, "mkdir {home}") }
    env_set("XDG_STATE_HOME", home) else |_| { assert(false, "env") }
    let f = TrustPromptFix { state_home: home, config: "{home}/.yew.fl", saved: saved, had: had }
    fs.write_text(f.config, "set({{wrap: true}})\n") else |_| { assert(false, "write config") }
    var probe = edit.trust_probe_new()
    probe.has_config = true
    probe.workspace = home
    probe.config_path = f.config
    for b in "set({{wrap: true}})\n".bytes() { (mut probe.bytes).push(b) }
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    (f, probe, ed)
}

// tp_remove (test_trust_prompt.c:89-107).
fn tp_remove(f: TrustPromptFix) {
    if f.had {
        env_set("XDG_STATE_HOME", f.saved) else |_| {}
    } else {
        env_unset("XDG_STATE_HOME") else |_| {}
    }
    assert(f.state_home.starts_with("/tmp/yew-trust-prompt-"), "only a /tmp/yew-trust-prompt-* tree is removed")
    fs.remove_dir_all(f.state_home) else |_| {}
}

fn trust_prompt_routes_all_terminal_answers_through_event_loop() {
    let keys = ['t' as int, 'o' as int, 'n' as int, 's' as int, term.KEY_ESCAPE]
    let answers = [edit.TRUST_ALWAYS, edit.TRUST_ONCE, edit.TRUST_NEVER, edit.TRUST_SKIP, edit.TRUST_SKIP]
    var (f, probe, ed) = tp_make()
    for i in 0..keys.len {
        (mut ed.trust_prompt.answers).reset()
        var db = edit.trust_db_new()
        assert(edit.trust_prompt_begin_recorded(mut ed, take db, probe, edit.TRUST_PROMPT_NEW))
        assert(ed.prompt == edit.PROMPT_WORKSPACE_TRUST)
        assert(ed.msg.prompt)
        assert(ed.msg.text.contains("[t]rust always [o]nce [n]ever [v]iew [s]kip"))
        edit.ed_handle_key(mut ed, tp_key(keys[i]), 10)
        assert(ed.trust_prompt.answers.len == 1, "one answer for key {i}")
        assert(ed.trust_prompt.answers[0] == answers[i])
        assert(!ed.trust_prompt.active)
        assert(ed.prompt == edit.PROMPT_NONE)
    }
    tp_remove(f)
}

fn trust_prompt_view_is_readonly_and_reprompts_after_close() {
    var (f, probe, ed) = tp_make()
    (mut ed.trust_prompt.answers).reset()
    var db = edit.trust_db_new()
    assert(edit.trust_prompt_begin_recorded(mut ed, take db, probe, edit.TRUST_PROMPT_CHANGED))
    edit.ed_handle_key(mut ed, tp_key('v' as int), 10)
    assert(ed.trust_prompt.active)
    assert(ed.trust_prompt.viewing)
    assert(ed.prompt == edit.PROMPT_NONE)
    assert(ed.win >= 0)
    let b = ed.wins[ed.win].buf
    assert(b >= 0)
    let view_id = ed.bufs[b].id
    assert(view_id == ed.trust_prompt.view_buffer_id)
    assert(edit.buf_readonly(ed.bufs[b]))
    assert(text.textbuf_len(ed.bufs[b].ec.tb) == probe.bytes.len)
    let close = edit.cmdctx_new(ed.win, edit.SRC_KEY)
    assert(edit.fc_buf_close(mut ed, close) == edit.CMD_OK)
    assert(ed.trust_prompt.active)
    assert(!ed.trust_prompt.viewing)
    assert(ed.prompt == edit.PROMPT_WORKSPACE_TRUST)
    assert(ed.trust_prompt.answers.len == 0)
    edit.ed_handle_key(mut ed, tp_key('o' as int), 20)
    assert(ed.trust_prompt.answers.len == 1)
    assert(ed.trust_prompt.answers[0] == edit.TRUST_ONCE)
    tp_remove(f)
}

fn main() {
    trust_prompt_routes_all_terminal_answers_through_event_loop()
    trust_prompt_view_is_readonly_and_reprompts_after_close()
    print("edit_trust_prompt: 2 cases pass")
}
