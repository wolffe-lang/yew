//! member: false
//! Ports sagitta tests/unit/test_syn_attr.c at 9ace98c2: the closed semantic
//! hierarchy's parents, by name, and invalid ids answering `text`.

use syn

fn id(name: str) -> int {
    syn.syn_attr_id(name) else -1
}

// test_syn_attr_parent_covers_closed_hierarchy_and_invalid_ids
fn parent_covers_closed_hierarchy_and_invalid_ids() {
    // C's want[] table in id order: each attr's parent, by name.
    let parents = "text text keyword keyword keyword text type text constant constant constant string text string string string text comment comment text function function function text variable variable variable text text text text text text punct punct text tag text text text text text text text text text text text text keyword operator number function text"
    var attr = 0
    for parent in parents.words() {
        assert(syn.syn_attr_parent(attr) == id(parent), "parent of attr {attr} is {parent}")
        attr += 1
    }
    assert(attr == syn.SYN_ATTR_COUNT, "the table covers every attr")
    assert(syn.syn_attr_parent(syn.SYN_ATTR_COUNT) == syn.SYN_ATTR_TEXT, "past the end is text")
    assert(syn.syn_attr_parent(255) == syn.SYN_ATTR_TEXT, "255 is text")
    assert(syn.syn_attr_parent(id("comment.doc")) == id("comment"), "comment.doc")
    assert(syn.syn_attr_parent(id("comment.todo")) == id("comment"), "comment.todo")
    assert(syn.syn_attr_parent(id("string.escape")) == id("string"), "string.escape")
    assert(syn.syn_attr_parent(id("string.interp")) == id("string"), "string.interp")
    assert(syn.syn_attr_parent(id("string.special")) == id("string"), "string.special")
    assert(syn.syn_attr_parent(id("character")) == id("string"), "character")
}

fn main() {
    let selected = (env_get("YEW_SYN_ATTR_CASE") else "-1").to_int() else -1
    for i in 0..1 {
        if selected == -1 || selected == i {
            parent_covers_closed_hierarchy_and_invalid_ids()
            print("syn_attr_case_{i}: PASS")
        }
    }
}
