//! member: false
//!
//! The port of sagitta `tests/unit/test_cmdrange.c` (211 lines), one test
//! per C test in registry order (`tests/unit/registry.c:1147-1149`).
//!
//! C's fixture is "aa\nbb\ncc\ndd" with the cursor at byte 4 (line 1) and
//! five test commands covering the five range policies
//! (`test_cmdrange.c:30-48`); the port registers them as probes on a
//! fresh editor's registry.
//!
//! The pattern addresses (`/dd/`, `?aa?`, `/re/`, `?re?`) search through
//! Sprint 20's engine with Sprint 21's options (`cmdparse.c:412-487`);
//! until yw04's regex and search halves are wired into
//! `cp_pattern_line`, each of those rows asserts the parser's refusal by
//! name ("not yet ported: pattern addresses") and is counted as a SKIP,
//! loudly. The mark rows, the policies and the spans run in full.

use edit
use text

fn bytes_of(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() {
        (mut out).push(b)
    }
    out
}

fn is_text(got: List[byte], want: str) -> bool {
    let w = bytes_of(want)
    if got.len != w.len {
        return false
    }
    var i = 0
    while i < w.len {
        if got[i] != w[i] {
            return false
        }
        i += 1
    }
    true
}

fn show(b: List[byte]) -> str {
    edit.cmderr_text(edit.CmdErr { tok_lo: 0, tok_hi: 0, msg: copy b, set: true })
}

fn register(mut ed: edit.Ed, name: str, abbrev: str, policy: int) {
    let _ = edit.
        cmd_register_entry(
            mut ed.reg,
            edit.CmdDesc {
                name: name,
                handler: edit.HANDLER_PROBE,
                impl_id: 0,
                arity: edit.ARITY_NONE,
                flags: 0,
                help: "Range test command",
                word: "",
                has_word: false,
            },
            "range_nop",
            "",
            "",
            true,
            policy,
            abbrev,
            true,
        )
}

// `range_fixture_init` (`test_cmdrange.c:30-48`).
fn fixture(t: str) -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    let b = ed.wins[ed.win].buf
    let bytes = bytes_of(t)
    ed.bufs[b].ec.tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    var cur = text.cursor_at(4 as text.ByteOff)
    cur.goal_col = 1
    ed.wins[ed.win].cs = text.cset_init(cur)
    register(mut ed, "ed.ui.delete", "td", edit.RP_LINE)
    register(mut ed, "ed.ui.open", "to", edit.RP_OPT)
    register(mut ed, "ed.ui.close", "tq", edit.RP_FORBID)
    register(mut ed, "ed.ui.grow", "tb", edit.RP_BUFFER)
    register(mut ed, "ed.ui.shrink", "tsort", edit.RP_REQUIRED)
    ed
}

fn range_ok(mut ed: edit.Ed, line: str) -> edit.CmdRange {
    let r = edit.cmd_parse(mut ed, bytes_of(line))
    assert(edit.cmd_parse_ok(r), "{line}: parses ({show(r.err.msg)})")
    copy r.range
}

fn range_error(mut ed: edit.Ed, line: str, message: str) {
    let r = edit.cmd_parse(mut ed, bytes_of(line))
    assert(!edit.cmd_parse_ok(r), "{line}: refused")
    assert(is_text(r.err.msg, message), "{line}: [{show(r.err.msg)}] is [{message}]")
    assert(r.err.tok_lo < r.err.tok_hi, "{line}: a token")
    assert(r.err.tok_hi <= line.len, "{line}: inside the line")
}

const PATTERN_REFUSAL: str = "not yet ported: pattern addresses: sagitta Sprint 21 (search) (yw04)"

fn skip(case: str, why: str) {
    print("SKIP: {case}: {why}")
    eprint("SKIP: {case}: {why}")
}

// Sprint 21 §7: `'a` and `/pat/` as addresses.
fn t_cmdrange_mark_and_pattern_addresses_resolve() -> int {
    var ed = fixture("aa\nbb\ncc\ndd")
    let b = ed.wins[ed.win].buf
    ed.bufs[b].ec.marks = text.marks_new()
    ed.bufs[b].ec.has_marks = true
    assert(edit.ed_mark_set(mut ed, b, 97, 6), "set 'a at byte 6")
    let r1 = range_ok(mut ed, ":'atd")
    assert(r1.lo == 2 && r1.hi == 2 && r1.given, "'a is line 2")

    // The pattern rows: refused by name until the engine is wired.
    range_error(mut ed, ":/dd/td", PATTERN_REFUSAL)
    range_error(mut ed, ":?aa?td", PATTERN_REFUSAL)
    range_error(mut ed, ":'a,/dd/td", PATTERN_REFUSAL)

    let alive = edit.ed_mark_get(ed, b, 97) else -1
    assert(alive >= 0, "'a is set")
    text.marks_adjust(mut ed.bufs[b].ec.marks, text.JOURNAL_INS, 0 as text.ByteOff, 3)
    let moved = edit.ed_mark_get(ed, b, 97) else -1
    assert(moved == 9, "a mark follows an edit above it (at {moved})")
    skip(
        "cmdrange_mark_and_pattern_addresses_resolve (the three pattern rows)",
        "pattern addresses need the regex engine and the search options (sagitta Sprints 20-21, yw04's regex and search halves); asserted refused by name, the mark rows ran",
    )
    1
}

fn t_cmdrange_addresses_policies_and_deferred_forms() -> int {
    var ed = fixture("aa\nbb\ncc\ndd")
    let rows = [
        (":td", 1, 1, edit.RANGE_LINES, false),
        (":1td", 0, 0, edit.RANGE_LINES, true),
        (":.td", 1, 1, edit.RANGE_LINES, true),
        (":$td", 3, 3, edit.RANGE_LINES, true),
        (":+td", 2, 2, edit.RANGE_LINES, true),
        (":-td", 0, 0, edit.RANGE_LINES, true),
        (":.+2td", 3, 3, edit.RANGE_LINES, true),
        (":$-2td", 1, 1, edit.RANGE_LINES, true),
        (":1,3td", 0, 2, edit.RANGE_LINES, true),
        (":%td", 0, 3, edit.RANGE_BUFFER, true),
        (":to", 0, 0, edit.RANGE_NONE, false),
        (":tb", 0, 3, edit.RANGE_BUFFER, false),
        (":1,2tsort", 0, 1, edit.RANGE_LINES, true),
    ]
    for row in rows {
        let (line, lo, hi, kind, given) = row
        let r = range_ok(mut ed, line)
        assert(r.lo == lo && r.hi == hi, "{line}: lines {r.lo},{r.hi} are {lo},{hi}")
        assert(r.kind == kind, "{line}: kind {r.kind} is {kind}")
        assert(r.given == given, "{line}: given")
    }
    range_error(mut ed, ":1tq", ":ui.close takes no range")
    range_error(mut ed, ":tsort", ":ui.shrink requires a range")
    range_error(mut ed, ":3,2td", "backwards range (3,2)")
    range_error(mut ed, ":900td", "line 900 past end of buffer (4 lines)")
    range_error(mut ed, ":0td", "line 0 past end of buffer (4 lines)")
    // Sprint 21 closed both deferrals: an unset mark names itself; the
    // unmatched patterns wait for the engine (refused by name).
    range_error(mut ed, ":'atd", "mark not set")
    range_error(mut ed, ":/re/td", PATTERN_REFUSAL)
    range_error(mut ed, ":?re?td", PATTERN_REFUSAL)
    skip(
        "cmdrange_addresses_policies_and_deferred_forms (the two pattern rows)",
        "\"pattern not found\" needs the regex engine (sagitta Sprint 20, yw04's regex half); asserted refused by name, every other row ran",
    )
    1
}

fn span_of(ed: edit.Ed, r: edit.CmdRange) -> text.Span {
    let b = ed.wins[ed.win].buf
    edit.range_span(ed.bufs[b].ec.tb, r)
}

fn t_cmdrange_selection_and_eol_spans() {
    var ed = fixture("aa\nbb\ncc\ndd")
    let r1 = range_ok(mut ed, ":1,2td")
    let s1 = span_of(ed, r1)
    assert(s1.lo == 0 && s1.hi == 6, ":1,2 includes the trailing EOL")
    let r2 = range_ok(mut ed, ":3,4td")
    let s2 = span_of(ed, r2)
    assert(s2.lo == 6 && s2.hi == 11, ":3,4 to the end")
    let w = ed.win
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].anchor = 0
    ed.wins[w].cs.curs[p].pos = 7
    let r3 = range_ok(mut ed, ":'<,'>td")
    assert(r3.kind == edit.RANGE_SELECTION, "a selection range")
    assert(r3.lo == 0 && r3.hi == 2, "its lines")
    let s3 = span_of(ed, r3)
    assert(s3.lo == 0 && s3.hi == 9, "its bytes")

    var empty = fixture("")
    let r4 = range_ok(mut empty, ":%td")
    let s4 = span_of(empty, r4)
    assert(s4.lo == 0 && s4.hi == 0, "an empty buffer's span")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    var skips = 0
    skips += t_cmdrange_addresses_policies_and_deferred_forms()
    skips += t_cmdrange_mark_and_pattern_addresses_resolve()
    t_cmdrange_selection_and_eol_spans()
    print("cmdrange_test: 3 cases run, {skips} SKIP (pattern rows only)")
}
