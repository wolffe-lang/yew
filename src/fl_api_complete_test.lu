//! member: false
//! The ten tests/unit/test_fl_api_complete.c cases at sagitta 9ace98c2, in
//! registry order. C's `run_cmd` (test_fl_api_complete.c:15-36) invokes a
//! registry row directly (`yew_cmd_invoke`, not the editor dispatch); its
//! ApiFix (:138-171) is flfix's VM attached to an editor with a NULL host,
//! the port's host kind 0 with each native's arguments on the VM stack.
//!
//! One block is named, not run: test_fl_api_complete.c:299-328, under
//! YEW_WITH_FUSS, opens the F drawer over a planted git snapshot; the
//! drawer is yw13's (FUSS). The rows before it run whole.

use edit
use fl
use text

fn editor() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed
}

// run_cmd (test_fl_api_complete.c:15-36).
fn run_cmd(
    mut ed: edit.Ed,
    wi: int,
    name: str,
    sarg: List[byte],
    has_sarg: bool,
    count: int,
    lo: int,
    hi: int,
    cursors: List[edit.CmdCursorArg],
) -> int {
    let id = edit.cmd_lookup(ed.reg, name)
    assert(id != 0, "no command {name}")
    var cx = edit.cmdctx_new(wi, edit.SRC_TEST)
    cx.count = count
    cx.count_given = count != 1
    cx.has_sarg = has_sarg
    cx.has_sbytes = has_sarg
    cx.sbytes = copy sarg
    cx.sarg = str_from_utf8(sarg) else ""
    cx.range.given = lo != hi
    cx.range.tok_lo = lo
    cx.range.tok_hi = hi
    cx.cursor_args = copy cursors
    edit.cmd_invoke(mut ed, id, mut cx)
}

fn no_cursors() -> List[edit.CmdCursorArg] { List[edit.CmdCursorArg]() }

fn arg(pos: int) -> edit.CmdCursorArg { edit.CmdCursorArg { pos: pos, anchor: pos, goal_col: pos } }

fn insert(mut ed: edit.Ed, s: str) -> int {
    let w = ed.win
    run_cmd(mut ed, w, "ed.edit.insert.at", s.bytes(), true, 1, 0, 0, no_cursors())
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

fn fl_api_win_split_and_focus_are_registry_commands() {
    var ed = editor()
    let root = ed.pane_root
    edit.layout_compute(mut ed, root, edit.rect(0, 0, 80, 24))
    let old = ed.win
    assert(run_cmd(mut ed, old, "ed.win.split", "h".bytes(), true, 1, 0, 0, no_cursors()) == edit.CMD_OK)
    let created = ed.win
    assert(created != old)
    assert(edit.pane_leaf_count(ed, ed.pane_root) == 2)
    assert(run_cmd(mut ed, old, "ed.win.focus", List[byte](), false, 1, 0, 0, no_cursors()) == edit.CMD_OK)
    assert(ed.win == old)
    assert(
        run_cmd(mut ed, old, "ed.win.split", "diagonal".bytes(), true, 1, 0, 0, no_cursors()) ==
            edit.CMD_ERR_ARG,
    )
}

fn fl_api_set_cursors_replaces_and_normalizes_once() {
    var ed = editor()
    assert(insert(mut ed, "abcd") == edit.CMD_OK)
    let w = ed.win
    assert(
        run_cmd(mut ed, w, "ed.cursor.set_many", List[byte](), false, 1, 0, 0, [arg(3), arg(0), arg(3)]) ==
            edit.CMD_OK,
    )
    assert(ed.wins[w].cs.curs.len == 2)
    assert(ed.wins[w].cs.curs[0].pos as int == 0)
    assert(ed.wins[w].cs.curs[1].pos as int == 3)
}

fn fl_api_cursor_move_targets_one_cursor_and_honors_count() {
    var ed = editor()
    assert(insert(mut ed, "abcd") == edit.CMD_OK)
    let w = ed.win
    assert(
        run_cmd(mut ed, w, "ed.cursor.set_many", List[byte](), false, 1, 0, 0, [arg(0), arg(3)]) ==
            edit.CMD_OK,
    )
    let id = edit.cmd_lookup(ed.reg, "ed.cursor.move")
    assert(id != 0)
    var cx = edit.cmdctx_new(w, edit.SRC_TEST)
    cx.cursor_given = true
    cx.cursor_index = 0
    cx.count = 2
    cx.count_given = true
    cx.has_sarg = true
    cx.has_sbytes = true
    cx.sbytes = "char:next".bytes()
    cx.sarg = "char:next"
    assert(edit.cmd_invoke(mut ed, id, mut cx) == edit.CMD_OK)
    assert(ed.wins[w].cs.curs[0].pos as int == 2)
    assert(ed.wins[w].cs.curs[1].pos as int == 3)
}

fn fl_api_span_yank_uses_requested_register() {
    var ed = editor()
    assert(insert(mut ed, "alpha") == edit.CMD_OK)
    let w = ed.win
    assert(run_cmd(mut ed, w, "ed.edit.yank", "a".bytes(), true, 1, 1, 4, no_cursors()) == edit.CMD_OK)
    let named = text.reg_get(mut ed.regs, 97) else { assert(false); return }
    assert(same(named.bytes, "lph".bytes()))
    assert(run_cmd(mut ed, w, "ed.edit.yank", "0".bytes(), true, 1, 1, 4, no_cursors()) == edit.CMD_ERR_ARG)
}

struct ApiFix { vm: fl.FlVm, ed: edit.Ed }

// api_open (test_fl_api_complete.c:143-150).
fn api_open() -> ApiFix {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    fl.fl_std_register(mut vm)
    ApiFix { vm: vm, ed: editor() }
}

// api_invoke (test_fl_api_complete.c:164-171): the row's native, its
// arguments on the VM stack from slot 1; vm.raised is C's false.
fn api_invoke(mut f: ApiFix, name: str, args: List[fl.FlValue]) -> fl.FlValue {
    let d = fl.fl_api_find(name.bytes()) else { assert(false, "no row {name}"); return fl.fl_nil() }
    f.vm.raised = false
    f.vm.err = fl.fl_nil()
    f.vm.cur_native = fl.fl_intern(mut f.vm.strings, name.bytes(), 0, name.len)
    for i in 0..args.len { f.vm.stack[1 + i] = copy args[i] }
    f.vm.sp = 1 + args.len
    let out = edit.fl_attached_api(mut f.vm, mut f.ed, d.kind, 1, args.len)
    f.vm.sp = 0
    assert(!f.vm.raised, "{name} raised")
    out
}

fn api_string(mut vm: fl.FlVm, s: str) -> fl.FlValue { fl.fl_str_text(mut vm, s) }

// api_map_value (test_fl_api_complete.c:196-219).
fn api_map_value(mut vm: fl.FlVm, value: fl.FlValue, name: str) -> fl.FlValue ! {none} {
    if value.t != fl.FL_MAP { return none }
    let key = fl.fl_str_text(mut vm, name)
    let got = fl.fl_map_get(vm, value, key) else { return none }
    got
}

// api_map_bool (test_fl_api_complete.c:173-194).
fn api_map_bool(mut vm: fl.FlVm, value: fl.FlValue, name: str, want: bool) -> bool {
    let got = api_map_value(mut vm, value, name) else { return false }
    got.t == fl.FL_BOOL && (got.i != 0) == want
}

fn str_of(vm: fl.FlVm, v: fl.FlValue) -> List[byte] {
    assert(v.t == fl.FL_STR)
    copy vm.gc.slots[fl.fl_obj_index(vm, v)].bytes
}

fn fl_api_missing_rows_have_typed_argmaps() {
    let ed = edit.ed_new()
    let split = fl.fl_api_find("win.split".bytes()) else { assert(false); return }
    assert(split.arg0 == fl.FL_ARG_STR)
    let set = fl.fl_api_find("win.set_cursors".bytes()) else { assert(false); return }
    assert(set.arg0 == fl.FL_ARG_LIST)
    let mv = fl.fl_api_find("cur.move".bytes()) else { assert(false); return }
    assert(mv.arg0 == fl.FL_ARG_STR && mv.arg1 == fl.FL_ARG_STR && mv.arg2 == fl.FL_ARG_COUNT)
    let rl = fl.fl_api_find("span.replace_lines".bytes()) else { assert(false); return }
    assert(rl.arg0 == fl.FL_ARG_LIST)
    let yank = fl.fl_api_find("span.yank".bytes()) else { assert(false); return }
    assert(yank.arg0 == fl.FL_ARG_STR)
    for kind in fl.fl_api_kinds() {
        let d = fl.fl_api_desc(kind) else { assert(false); continue }
        if d.cmd.len == 0 { continue }
        let base = if d.recv == fl.FL_H_NONE then 0 else 1
        assert(edit.cmd_lookup(ed.reg, d.cmd) != 0, "{d.fl_name} resolves")
        assert(d.nmax >= base)
        assert(d.nmax - base <= 3)
        for a in 0..d.nmax - base {
            let slot = if a == 0 then d.arg0 else if a == 1 then d.arg1 else d.arg2
            assert(slot != fl.FL_ARG_NONE, "{d.fl_name} argument {a}")
        }
    }
}

fn fl_api_buf_metadata_queries_are_truthful() {
    var f = api_open()
    let bi = edit.ed_doc(f.ed)
    let h = edit.fl_h_buf_make(mut f.ed, bi)
    let lang = api_invoke(mut f, "buf.lang", [copy h])
    assert(lang.t == fl.FL_NIL)
    f.ed.bufs[bi].ec.meta.exists = true
    f.ed.bufs[bi].ec.meta.mode = 256 // S_IRUSR
    let ro = api_invoke(mut f, "buf.readonly", [copy h])
    assert(ro.t == fl.FL_BOOL && ro.i != 0)
    f.ed.bufs[bi].ec.meta.mode = f.ed.bufs[bi].ec.meta.mode | 128 // S_IWUSR
    let rw = api_invoke(mut f, "buf.readonly", [h])
    assert(rw.t == fl.FL_BOOL && rw.i == 0)
}

fn fl_api_tutor_state_queries_report_mode_and_undo_depth() {
    var f = api_open()
    let source = "@[ i\"x\" ]"
    let bi = edit.ed_doc(f.ed)
    let h = edit.fl_h_buf_make(mut f.ed, bi)
    let d0 = api_invoke(mut f, "buf.undo_depth", [copy h])
    assert(d0.t == fl.FL_INT && d0.i == 0)
    assert(insert(mut f.ed, "x") == edit.CMD_OK)
    let d1 = api_invoke(mut f, "buf.undo_depth", [h])
    assert(d1.i == 1)
    let mode = api_invoke(mut f, "ed.mode", List[fl.FlValue]())
    assert(same(str_of(f.vm, mode), "L".bytes()))
    f.ed.mode = edit.MODE_I
    let mode_i = api_invoke(mut f, "ed.mode", List[fl.FlValue]())
    assert(same(str_of(f.vm, mode_i), "I".bytes()))
    let idle = api_invoke(mut f, "ed.recording", List[fl.FlValue]())
    assert(idle.t == fl.FL_NIL)
    f.ed.rec.active = true
    f.ed.rec.reg = 97
    let rec = api_invoke(mut f, "ed.recording", List[fl.FlValue]())
    assert(same(str_of(f.vm, rec), "a".bytes()))
    let a = api_string(mut f.vm, "a")
    let empty = api_invoke(mut f, "ed.register", [copy a])
    assert(empty.t == fl.FL_NIL)
    for b in source.bytes() { (mut f.ed.regs.named[0].bytes).push(b) }
    let held = api_invoke(mut f, "ed.register", [a])
    assert(same(str_of(f.vm, held), source.bytes()))
    let fuss = api_invoke(mut f, "ed.fuss", List[fl.FlValue]())
    assert(fuss.t == fl.FL_MAP)
    let root = fl.fl_temp_push(mut f.vm, fuss)
    assert(api_map_bool(mut f.vm, fl.fl_temp_get(f.vm, root), "active", false))
    assert(api_map_bool(mut f.vm, fl.fl_temp_get(f.vm, root), "known", false))
    assert(api_map_bool(mut f.vm, fl.fl_temp_get(f.vm, root), "clean", false))
    let staged = api_map_value(mut f.vm, fl.fl_temp_get(f.vm, root), "staged_paths") else {
        assert(false)
        return
    }
    assert(staged.t == fl.FL_LIST && fl.fl_list_len(f.vm, staged) == 0)
    fl.fl_temp_pop(mut f.vm, 1)
    // test_fl_api_complete.c:299-328 (YEW_WITH_FUSS): the F drawer, yw13's.
}

fn fl_api_workspace_query_reports_real_tabs_groups_and_panes() {
    var f = api_open()
    let root = f.ed.pane_root
    edit.layout_compute(mut f.ed, root, edit.rect(0, 0, 80, 24))
    let w0 = api_invoke(mut f, "ed.workspace", List[fl.FlValue]())
    let r0 = fl.fl_temp_push(mut f.vm, w0)
    let tabs0 = api_map_value(mut f.vm, fl.fl_temp_get(f.vm, r0), "tabs") else { assert(false); return }
    assert(fl.fl_list_len(f.vm, tabs0) == 1)
    let groups0 = api_map_value(mut f.vm, fl.fl_temp_get(f.vm, r0), "groups") else {
        assert(false)
        return
    }
    assert(fl.fl_list_len(f.vm, groups0) == 0)
    fl.fl_temp_pop(mut f.vm, 1)

    let gid = edit.group_create(mut f.ed, "/tmp", "notes")
    assert(gid != 0)
    let active = f.ed.tab_active
    edit.group_add_member(mut f.ed, gid, active)
    let w1 = api_invoke(mut f, "ed.workspace", List[fl.FlValue]())
    let r1 = fl.fl_temp_push(mut f.vm, w1)
    let groups = api_map_value(mut f.vm, fl.fl_temp_get(f.vm, r1), "groups") else { assert(false); return }
    assert(fl.fl_list_len(f.vm, groups) == 1)
    let item = fl.fl_list_get(f.vm, groups, 0) else { assert(false); return }
    let name = api_map_value(mut f.vm, item, "name") else { assert(false); return }
    assert(same(str_of(f.vm, name), "notes".bytes()))
    let members = api_map_value(mut f.vm, item, "members") else { assert(false); return }
    assert(members.i == 1)

    let tabs = api_map_value(mut f.vm, fl.fl_temp_get(f.vm, r1), "tabs") else { assert(false); return }
    let tab = fl.fl_list_get(f.vm, tabs, 0) else { assert(false); return }
    let panes = api_map_value(mut f.vm, tab, "panes") else { assert(false); return }
    assert(fl.fl_list_len(f.vm, panes) == 1)
    let pane = fl.fl_list_get(f.vm, panes, 0) else { assert(false); return }
    let w = api_map_value(mut f.vm, pane, "w") else { assert(false); return }
    assert(w.i == 80)
    let hh = api_map_value(mut f.vm, pane, "h") else { assert(false); return }
    assert(hh.i == 24)
    fl.fl_temp_pop(mut f.vm, 1)
}

fn fl_api_rows_replace_lines_yank_and_move() {
    var f = api_open()
    let bi = edit.ed_doc(f.ed)
    let buf = edit.fl_h_buf_make(mut f.ed, bi)
    let old = api_string(mut f.vm, "old")
    let _ = api_invoke(mut f, "buf.insert", [copy buf, fl.fl_int(0), old])
    let span = edit.fl_h_span_make(mut f.ed, bi, 0, 3)
    let lines = fl.fl_list_new(mut f.vm)
    let root = fl.fl_temp_push(mut f.vm, lines)
    let one = api_string(mut f.vm, "one")
    fl.fl_list_push(mut f.vm, fl.fl_temp_get(f.vm, root), one)
    let two = api_string(mut f.vm, "two")
    fl.fl_list_push(mut f.vm, fl.fl_temp_get(f.vm, root), two)
    let _ = api_invoke(mut f, "span.replace_lines", [span, fl.fl_temp_get(f.vm, root)])
    let got = api_invoke(mut f, "buf.text", [buf])
    assert(same(str_of(f.vm, got), "one\ntwo".bytes()))
    let span2 = edit.fl_h_span_make(mut f.ed, bi, 0, 3)
    let a = api_string(mut f.vm, "a")
    let _ = api_invoke(mut f, "span.yank", [span2, a])
    let named = text.reg_get(mut f.ed.regs, 97) else { assert(false); return }
    assert(same(named.bytes, "one".bytes()))
    let wi = f.ed.win
    let primary = f.ed.wins[wi].cs.primary
    let cursor = edit.fl_h_cur_make(mut f.ed, wi, primary)
    let _ = api_invoke(mut f, "cur.goto", [copy cursor, fl.fl_int(0)])
    let unit = api_string(mut f.vm, "char")
    let dir = api_string(mut f.vm, "next")
    let _ = api_invoke(mut f, "cur.move", [copy cursor, unit, dir, fl.fl_int(2)])
    let pos = api_invoke(mut f, "cur.pos", [cursor])
    assert(pos.i == 2)
    fl.fl_temp_pop(mut f.vm, 1)
}

fn fl_api_rows_split_focus_and_set_cursors() {
    var f = api_open()
    let root = f.ed.pane_root
    edit.layout_compute(mut f.ed, root, edit.rect(0, 0, 80, 24))
    let wi = f.ed.win
    let old_win = edit.fl_h_win_make(mut f.ed, wi)
    let primary = f.ed.wins[wi].cs.primary
    let cursor = edit.fl_h_cur_make(mut f.ed, wi, primary)
    let h = api_string(mut f.vm, "h")
    let new_win = api_invoke(mut f, "win.split", [copy old_win, h])
    let created = edit.fl_h_win(mut f.vm, f.ed, copy new_win) else { assert(false); return }
    assert(created == f.ed.win)
    let _ = api_invoke(mut f, "win.focus", [old_win])
    assert(f.ed.win != created)
    let cursors = fl.fl_list_new(mut f.vm)
    let lroot = fl.fl_temp_push(mut f.vm, cursors)
    fl.fl_list_push(mut f.vm, fl.fl_temp_get(f.vm, lroot), cursor)
    let _ = api_invoke(mut f, "win.set_cursors", [new_win, fl.fl_temp_get(f.vm, lroot)])
    assert(f.ed.wins[created].cs.curs.len == 1)
    fl.fl_temp_pop(mut f.vm, 1)
}

fn main() {
    fl_api_win_split_and_focus_are_registry_commands()
    print("fl_api_win_split_and_focus_are_registry_commands: PASS")
    fl_api_set_cursors_replaces_and_normalizes_once()
    print("fl_api_set_cursors_replaces_and_normalizes_once: PASS")
    fl_api_cursor_move_targets_one_cursor_and_honors_count()
    print("fl_api_cursor_move_targets_one_cursor_and_honors_count: PASS")
    fl_api_span_yank_uses_requested_register()
    print("fl_api_span_yank_uses_requested_register: PASS")
    fl_api_missing_rows_have_typed_argmaps()
    print("fl_api_missing_rows_have_typed_argmaps: PASS")
    fl_api_buf_metadata_queries_are_truthful()
    print("fl_api_buf_metadata_queries_are_truthful: PASS")
    fl_api_tutor_state_queries_report_mode_and_undo_depth()
    print("fl_api_tutor_state_queries_report_mode_and_undo_depth: PASS")
    fl_api_workspace_query_reports_real_tabs_groups_and_panes()
    print("fl_api_workspace_query_reports_real_tabs_groups_and_panes: PASS")
    fl_api_rows_replace_lines_yank_and_move()
    print("fl_api_rows_replace_lines_yank_and_move: PASS")
    fl_api_rows_split_focus_and_set_cursors()
    print("fl_api_rows_split_focus_and_set_cursors: PASS")
    print("fl_api_complete: 10 pinned cases PASS; the YEW_WITH_FUSS block is yw13's")
}
