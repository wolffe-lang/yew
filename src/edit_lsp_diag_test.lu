//! member: false
//!
//! The port of sagitta `tests/unit/test_lsp_diag.c` (445 lines) at
//! 9ace98c2, one test per C test in registry order
//! (`tests/unit/registry.c:1571-1576`): the diagnostic store on marks,
//! its server identity and stale versions, the visual contract (glyphs,
//! roles, underline attributes), the gutter sign, the cursor hint under a
//! real message, the picker's identity across a Tab to the workspace, the
//! statusline's E:/W: badges in their roles, the 16,384 bound and fifty
//! ranges through a thousand mixed edits against an oracle.
//!
//! C's fixture is `yew_ed_init` + `yew_ed_open_memory` over
//! "zero\nalpha beta\nomega\n" named `diag.c` (`test_lsp_diag.c:21-30`);
//! the port's is `edit.ed_new` + `edit.ed_open_memory`. C's JSON values
//! live in an arena; the port's are a `lsp.Json` document and the array's
//! node. C's `yew_ed_edit_ctx` + `yew_edit_insert` + `yew_ed_finish_edit`
//! is the window seam (`edit.ed_edit_insert`, `edit.ed_finish_edit`). C
//! captures the log through its test sink; the port reads `YEW_LOG` back
//! (`util.log_capture_has`). C builds the 16,385-entry array from shared
//! static nodes; the port parses the same array's text.
//!
//! The per-case selector `YEW_LSP_DIAG_CASE=N` (the registry index within
//! this file, 0-based; 6 cases) runs one case and prints its `NAME: PASS`
//! line, for the checked machine's step budget (G29,
//! tools/check-test-cases.txt).

use edit
use lsp
use std.fs
use term
use text
use unicode
use util

const LOG_PATH: str = "target/tests/edit-lsp-diag-test.log"

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn has(hay: str, needle: str) -> bool {
    hay.contains(needle)
}

// `diag_fix_init` (`test_lsp_diag.c:21-30`).
fn fixture() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_memory(mut ed, bytes_of("zero\nalpha beta\nomega\n"), "diag.c")
    ed
}

// `diag_array` (`test_lsp_diag.c:39-47`).
fn parse(text: str) -> lsp.Json {
    var err = lsp.json_err_new()
    let j = lsp.json_parse(text.bytes(), 0, text.len, mut err) else {
        assert(false, "diagnostic JSON: {err.msg}")
        return lsp.json_new()
    }
    j
}

fn replace(mut ed: edit.Ed, bi: int, server: int, text: str, version: int) {
    let j = parse(text)
    edit.diag_replace(mut ed, bi, server, j, j.root, version)
}

fn store(ed: edit.Ed, bi: int) -> int {
    let s = edit.diag_store_of(ed, bi)
    assert(s >= 0, "buffer {bi} has a diagnostic store")
    s
}

fn lsp_diag_replace_tracks_marks_and_server_identity() {
    let first = "[{{\"range\":{{\"start\":{{\"line\":1,\"character\":0}},\"end\":{{\"line\":1,\"character\":5}}}},\"severity\":2,\"source\":\"clang\",\"code\":\"W1\",\"message\":\"alpha warning\"}}]"
    let second = "[{{\"range\":{{\"start\":{{\"line\":2,\"character\":0}},\"end\":{{\"line\":2,\"character\":5}}}},\"severity\":1,\"message\":\"omega error\"}}]"
    var ed = fixture()
    let b = edit.ed_doc(ed)
    replace(mut ed, b, 7, first, 1)
    replace(mut ed, b, 9, second, 1)
    let s = store(ed, b)
    assert(ed.diags[s].d.len == 2, "two diagnostics: {ed.diags[s].d.len}")
    assert(ed.diags[s].n[edit.DIAG_ERROR] == 1, "one error")
    assert(ed.diags[s].n[edit.DIAG_WARN] == 1, "one warning")
    let d = edit.diag_at_point(mut ed, b, 5)
    assert(d >= 0, "a diagnostic at 5")
    assert(ed.diags[s].d[d].server == 7, "the warning is server 7's")
    let before = edit.diag_span(mut ed, b, s, d)

    let w = ed.win
    assert(edit.ed_edit_insert(mut ed, w, 7, bytes_of("XX"), 0, 2), "insert XX")
    edit.ed_finish_edit(mut ed, w)
    let d2 = edit.diag_at_point(mut ed, b, 7)
    assert(d2 >= 0, "a diagnostic at 7")
    assert(
        edit.diag_span(mut ed, b, s, d2).hi == before.hi + 2,
        "the range grew with the insert",
    )

    replace(mut ed, b, 7, "[]", 2)
    assert(ed.diags[s].d.len == 1, "server 7's dropped")
    assert(ed.diags[s].d[0].server == 9, "server 9's kept")
    assert(ed.diags[s].n[edit.DIAG_ERROR] == 1, "its error counted")
    edit.diag_store_free(mut ed, b)
}

fn lsp_diag_stale_boundaries_and_visual_contract() {
    let one = "[{{\"range\":{{\"start\":{{\"line\":1,\"character\":5}},\"end\":{{\"line\":1,\"character\":5}}}},\"severity\":4,\"tags\":[1,2],\"message\":\"insert here\"}}]"
    let older = "[{{\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":1}}}},\"severity\":1,\"message\":\"old\"}}]"
    var ed = fixture()
    let b = edit.ed_doc(ed)
    replace(mut ed, b, 1, one, 3)
    let s = store(ed, b)
    let visible = edit.diag_span(mut ed, b, s, 0)
    assert(visible.hi > visible.lo, "an empty range shows one grapheme")
    assert(edit.diag_at_point(mut ed, b, visible.lo - 1) < 0, "none before")
    assert(edit.diag_at_point(mut ed, b, visible.lo) >= 0, "one at the start")
    assert(edit.diag_at_point(mut ed, b, visible.hi) < 0, "none at the end")
    let glyph = edit.diag_glyph(edit.DIAG_ERROR)
    assert(glyph == "\u{2717}", "the error glyph")
    assert(glyph.len == 3, "three bytes")
    assert(edit.diag_role(edit.DIAG_WARN) == "diag.warn", "the warning role")
    assert(
        edit.diag_attrs(edit.DIAG_WARN, edit.DIAGT_UNNECESSARY, true) & term.ATTR_UNDERCURL != 0,
        "a truecolour warning undercurls",
    )
    assert(
        edit.diag_attrs(edit.DIAG_INFO, edit.DIAGT_DEPRECATED, false) & term.ATTR_STRIKE != 0,
        "deprecated strikes through",
    )
    assert(edit.diag_attrs(edit.DIAG_HINT, 0, true) == 0, "a hint draws nothing")

    replace(mut ed, b, 1, older, 2)
    assert(ed.diags[s].d.len == 1, "the older version refused")
    assert(
        (str_from_utf8(ed.diags[s].d[0].message) else "") == "insert here",
        "the newer message kept",
    )
    replace(mut ed, b, 1, one, -1)
    assert(ed.diags[s].stale, "an unversioned publish is stale")
    edit.diag_store_free(mut ed, b)
}

fn lsp_diag_gutter_hint_and_picker_identity() {
    let many = "[{{\"range\":{{\"start\":{{\"line\":1,\"character\":0}},\"end\":{{\"line\":1,\"character\":5}}}},\"severity\":3,\"message\":\"info\"}},{{\"range\":{{\"start\":{{\"line\":1,\"character\":0}},\"end\":{{\"line\":1,\"character\":5}}}},\"severity\":1,\"source\":\"clang\",\"code\":17,\"message\":\"error\"}}]"
    var ed = fixture()
    let b = edit.ed_doc(ed)
    replace(mut ed, b, 3, many, 1)
    let w = ed.win
    edit.diag_refresh_view(mut ed, w)
    assert(ed.wins[w].signs.v.len == 1, "one signed line")
    assert(
        ed.wins[w].signs.v[0].mask & (1 << edit.SIGN_DIAG) != 0,
        "the diagnostic kind",
    )
    let glyph = str_from_utf8(ed.wins[w].signs.v[0].sign[edit.SIGN_DIAG].glyph) else ""
    assert(glyph == "\u{2717}", "the most severe glyph: {glyph}")

    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].pos = 5
    edit.diag_cursor_hint(mut ed, w)
    assert(ed.msg_hint.active, "a hint")
    assert(has(ed.msg_hint.text, "E \u{2717} [clang] error (17)"), "the hint: {ed.msg_hint.text}")
    assert(has(ed.msg_hint.text, "(+1 more)"), "the count: {ed.msg_hint.text}")
    edit.ed_msg_at(mut ed, edit.MSG_INFO, 1000, "saved")
    assert(ed.msg.text == "saved", "the message")
    assert(ed.msg_hint.active, "the hint under it")
    edit.ed_timers_fire(mut ed, 5000)
    assert(!ed.msg.active, "the message expired")
    assert(ed.msg_hint.active, "the hint stays")

    let items = edit.diag_list(mut ed)
    assert(items.len == 2, "two rows: {items.len}")
    let identity = items[0].payload
    assert(identity != items[1].payload, "two identities")
    assert(has(items[0].label, "diag.c:2:1"), "the label: {items[0].label}")

    let other = edit.ws_scratch_new(mut ed, "other.c", 0)
    assert(other >= 0, "a second buffer")
    replace(mut ed, other, 4, many, 1)
    edit.ed_show_buffer(mut ed, other)
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    edit.diag_picker_open(mut ed)
    assert(edit.picker_active(ed), "the picker opened")
    assert(edit.picker_total(ed) == 2, "the buffer's two: {edit.picker_total(ed)}")
    let selected = edit.picker_selected(ed)
    var tab = term.key_new()
    tab.code = term.KEY_TAB
    assert(edit.picker_key(mut ed, tab), "Tab taken")
    assert(edit.picker_total(ed) == 4, "the workspace's four: {edit.picker_total(ed)}")
    assert(edit.picker_selected(ed) == selected, "the selection kept")
    edit.picker_close(mut ed, false)
    edit.diag_store_free(mut ed, b)
    edit.diag_store_free(mut ed, other)
}

fn lsp_diag_statusline_roles_and_ambiguous_glyphs() {
    let rows = "[{{\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":1}}}},\"severity\":1,\"message\":\"error\"}},{{\"range\":{{\"start\":{{\"line\":1,\"character\":0}},\"end\":{{\"line\":1,\"character\":1}}}},\"severity\":2,\"message\":\"warning\"}}]"
    var ed = fixture()
    let b = edit.ed_doc(ed)
    replace(mut ed, b, 1, rows, 1)
    edit.ed_theme_set(mut ed, "quiver-dark")
    assert(ed.theme.name == "quiver-dark", "the theme applied")
    ed.grid = term.grid_new(2, 120)
    ed.grid_ready = true
    ed.footer_rect = edit.rect(0, 1, 120, 1)
    let w = ed.win
    let t = edit.statusline_build(mut ed, w, 120)
    let err_text = str_from_utf8(t.body[t.diag_error_at..t.diag_error_at + t.diag_error_len]) else ""
    assert(err_text == "E:1", "the error badge: {err_text}")
    let warn_text = str_from_utf8(t.body[t.diag_warn_at..t.diag_warn_at + t.diag_warn_len]) else ""
    assert(warn_text == "W:1", "the warning badge: {warn_text}")
    let r = edit.theme_rendition_of(ed.render)
    let (has_err, error_role) = edit.theme_ui(ed.theme, "diag.error", r)
    let (has_warn, warn_role) = edit.theme_ui(ed.theme, "diag.warn", r)
    assert(has_err && has_warn, "both roles in the theme")
    edit.statusline_draw(mut ed, w)
    var prefix = unicode.str_width(t.body, 0, t.diag_error_at, 4)
    assert(prefix >= 0, "the prefix measures")
    var col = t.chip_cells + prefix
    var i = 0
    while i < t.diag_error_len {
        let cell = term.grid_back(ed.grid, 1, col + i)
        assert(term.color_equal(cell.fg, error_role.fg), "E:1 in diag.error at {col + i}")
        i += 1
    }
    prefix = unicode.str_width(t.body, 0, t.diag_warn_at, 4)
    assert(prefix >= 0, "the prefix measures")
    col = t.chip_cells + prefix
    i = 0
    while i < t.diag_warn_len {
        let cell = term.grid_back(ed.grid, 1, col + i)
        assert(term.color_equal(cell.fg, warn_role.fg), "W:1 in diag.warn at {col + i}")
        i += 1
    }

    unicode.width_set_ambiguous_wide(true)
    var sev = edit.DIAG_ERROR
    while sev <= edit.DIAG_HINT {
        let sign = edit.gutter_sign(edit.diag_glyph(sev), edit.diag_role(sev), 0)
        edit.gutter_sign_set(mut ed.wins[w], sev - 1, edit.SIGN_DIAG, sign)
        let stored = copy ed.wins[w].signs.v[sev - 1].sign[edit.SIGN_DIAG].glyph
        assert(unicode.cluster_width(stored, 0, stored.len) == 1, "glyph {sev} is one cell")
        sev += 1
    }
    unicode.width_set_ambiguous_wide(false)
    edit.diag_store_free(mut ed, b)
}

fn lsp_diag_store_is_bounded() {
    var text = List[byte]()
    (mut text).push(91 as byte)
    let item = "{{\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":0}}}},\"message\":\"bounded\"}}"
    var i = 0
    while i <= edit.DIAG_STORE_MAX {
        if i != 0 {
            (mut text).push(44 as byte)
        }
        for c in item.bytes() {
            (mut text).push(c)
        }
        i += 1
    }
    (mut text).push(93 as byte)
    var err = lsp.json_err_new()
    let j = lsp.json_parse(text, 0, text.len, mut err) else {
        assert(false, "the bounded array parses: {err.msg}")
        return
    }
    var ed = fixture()
    let b = edit.ed_doc(ed)
    let w = ed.win
    ed.win = -1
    edit.diag_replace(mut ed, b, 1, j, j.root, 1)
    ed.win = w
    let s = store(ed, b)
    assert(ed.diags[s].d.len == edit.DIAG_STORE_MAX, "kept {ed.diags[s].d.len}")
    assert(ed.diags[s].n[edit.DIAG_ERROR] == edit.DIAG_STORE_MAX, "all errors")
    assert(
        util.log_capture_has(util.LOG_WARN, bytes_of("keeping at most 16384")),
        "the bound is logged",
    )
    edit.diag_store_free(mut ed, b)
}

// `oracle_insert` (`test_lsp_diag.c:333-343`).
fn oracle_insert(mut lo: List[int], mut hi: List[int], at: int, len: int) {
    var i = 0
    while i < lo.len {
        if lo[i] > at {
            lo[i] += len
        }
        if hi[i] >= at {
            hi[i] += len
        }
        i += 1
    }
}

// `oracle_delete_pos` (`test_lsp_diag.c:345-352`).
fn oracle_delete_pos(pos: int, at: int, len: int) -> int {
    if pos < at {
        return pos
    }
    if pos < at + len then at else pos - len
}

// `oracle_delete` (`test_lsp_diag.c:354-362`).
fn oracle_delete(mut lo: List[int], mut hi: List[int], at: int, len: int) {
    var i = 0
    while i < lo.len {
        lo[i] = oracle_delete_pos(lo[i], at, len)
        hi[i] = oracle_delete_pos(hi[i], at, len)
        i += 1
    }
}

fn lsp_diag_marks_survive_1000_mixed_edits() {
    let ndiag = 50
    let nedit = 1000
    var source = List[byte]()
    var i = 0
    while i < 2000 {
        (mut source).push((97 + i % 26) as byte)
        i += 1
    }
    var ed = edit.ed_new()
    edit.ed_open_memory(mut ed, source, "diag-oracle.c")
    var lo = List[int]()
    var hi = List[int]()
    var json = "["
    i = 0
    while i < ndiag {
        let l = i * 30 + 3
        (mut lo).push(l)
        (mut hi).push(l + 9)
        if i != 0 {
            json = json + ","
        }
        json = json + "{{\"range\":{{\"start\":{{\"line\":0,\"character\":{l}}},\"end\":{{\"line\":0,\"character\":{l + 9}}}}},\"severity\":2,\"message\":\"range {i}\"}}"
        i += 1
    }
    json = json + "]"
    let b = edit.ed_doc(ed)
    replace(mut ed, b, 11, json, 1)
    let s = store(ed, b)
    assert(ed.diags[s].d.len == ndiag, "fifty ranges")
    let w = ed.win
    i = 0
    while i < nedit {
        let text_len = text.textbuf_len(ed.bufs[b].ec.tb)
        if i % 3 == 0 {
            let at = (i * 37 + 11) % (text_len + 1)
            assert(edit.ed_edit_insert(mut ed, w, at, bytes_of("x"), 0, 1), "insert {i}")
            oracle_insert(mut lo, mut hi, at, 1)
        } else {
            let at = (i * 53 + 7) % text_len
            var len = 1 + i % 3
            if len > text_len - at {
                len = text_len - at
            }
            assert(edit.ed_edit_delete(mut ed, w, at, at + len), "delete {i}")
            oracle_delete(mut lo, mut hi, at, len)
        }
        edit.ed_finish_edit(mut ed, w)
        if (i + 1) % 20 == 0 {
            var d = 0
            while d < ndiag {
                let got_lo = text.mark_pos(ed.bufs[b].ec.marks, ed.diags[s].d[d].lo) as int
                let got_hi = text.mark_pos(ed.bufs[b].ec.marks, ed.diags[s].d[d].hi) as int
                assert(got_lo == lo[d], "edit {i}: range {d} starts at {got_lo}, oracle {lo[d]}")
                assert(got_hi == hi[d], "edit {i}: range {d} ends at {got_hi}, oracle {hi[d]}")
                d += 1
            }
        }
        i += 1
    }
    edit.diag_store_free(mut ed, b)
}

fn want(chosen: int, n: int) -> bool {
    chosen < 0 || chosen == n
}

fn main() {
    fs.create_dir_all("target/tests") else |_| {}
    fs.remove(LOG_PATH) else |_| {}
    env_set("YEW_LOG", LOG_PATH) else |_| {}
    let chosen = (env_get("YEW_LSP_DIAG_CASE") else "-1").to_int() else -1
    if want(chosen, 0) {
        lsp_diag_replace_tracks_marks_and_server_identity()
        print("lsp_diag_replace_tracks_marks_and_server_identity: PASS")
    }
    if want(chosen, 1) {
        lsp_diag_stale_boundaries_and_visual_contract()
        print("lsp_diag_stale_boundaries_and_visual_contract: PASS")
    }
    if want(chosen, 2) {
        lsp_diag_gutter_hint_and_picker_identity()
        print("lsp_diag_gutter_hint_and_picker_identity: PASS")
    }
    if want(chosen, 3) {
        lsp_diag_statusline_roles_and_ambiguous_glyphs()
        print("lsp_diag_statusline_roles_and_ambiguous_glyphs: PASS")
    }
    if want(chosen, 4) {
        lsp_diag_store_is_bounded()
        print("lsp_diag_store_is_bounded: PASS")
    }
    if want(chosen, 5) {
        lsp_diag_marks_survive_1000_mixed_edits()
        print("lsp_diag_marks_survive_1000_mixed_edits: PASS")
    }
    if chosen < 0 {
        print("lsp_diag_test: 6 cases pass")
    }
}
