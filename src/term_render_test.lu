//! member: false
//!
//! The port of sagitta `tests/unit/test_color.c` (115 lines) and
//! `test_render.c` (613), one test per C test in registry order
//! (`tests/unit/registry.c:667-687`): the colour formulas and their
//! vectors, the golden byte strings per renderer decision, the envelope,
//! the 16 bold/dim and 16 underline/undercurl transitions, determinism.
//! C's `test_render_invalid_cells_are_bugs` forks six children that must
//! exit 4; wolf has no fork, so this entry spawns ITSELF with
//! `--invalid-cell N` (`std.process`) and reads each exit code.

use std.fs
use std.process
use term

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn truecolor_env(k: str) -> (str, bool) {
    if k == "YEW_COLORS" {
        return ("truecolor", true)
    }
    ("", false)
}

struct Fixture {
    grid: term.Grid,
    render: term.Render,
    out: List[byte],
}

fn fixture(rows: int, cols: int, sync: bool) -> Fixture {
    var caps = term.caps_new()
    caps.truecolor = true
    caps.sync_output = sync
    Fixture {
        grid: term.grid_new(rows, cols),
        render: term.render_new(caps, fn(k: str) truecolor_env(k)),
        out: List[byte](),
    }
}

fn put(mut f: Fixture, row: int, col: int, s: str, fg: term.Color, bg: term.Color, attrs: int) {
    let b = bytes_of(s)
    let _ = term.grid_put(mut f.grid, row, col, b, 0, b.len, fg, bg, attrs)
}

fn puts(mut f: Fixture, row: int, col: int, s: str, fg: term.Color, bg: term.Color, attrs: int) {
    let b = bytes_of(s)
    let _ = term.grid_puts(mut f.grid, row, col, b, 0, b.len, fg, bg, attrs)
}

fn frame(mut f: Fixture) -> int {
    term.render_frame(mut f.render, f.grid, mut f.out)
}

fn contains(out: List[byte], needle: str) -> bool {
    let n = needle.bytes()
    if n.len > out.len {
        return false
    }
    var i = 0
    while i + n.len <= out.len {
        var j = 0
        while j < n.len && out[i + j] == n[j] {
            j += 1
        }
        if j == n.len {
            return true
        }
        i += 1
    }
    false
}

fn equals(out: List[byte], want: str) -> bool {
    let w = want.bytes()
    if out.len != w.len {
        return false
    }
    var i = 0
    while i < w.len {
        if out[i] != w[i] {
            return false
        }
        i += 1
    }
    true
}

fn same_bytes(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn t_color_rgb_to_256_vectors() {
    let rs = [0, 255, 47, 48, 114, 115, 255, 0, 0, 128, 0, 0, 12, 50, 94, 95, 96, 200, 20, 123]
    let gs = [0, 255, 47, 48, 114, 115, 0, 255, 0, 0, 128, 0, 34, 100, 134, 135, 136, 100, 100, 45]
    let bs = [0, 255, 47, 48, 114, 115, 0, 0, 255, 0, 0, 128, 56, 150, 174, 175, 176, 20, 200, 67]
    let wants = [16, 231, 236, 236, 243, 243, 196, 46, 21, 88, 28, 18, 235, 60, 67, 67, 67, 166, 26, 239]
    var i = 0
    while i < wants.len {
        assert(term.rgb_to_256(rs[i], gs[i], bs[i]) == wants[i], "rgb_to_256 vector {i}")
        i += 1
    }
}

fn t_color_grayscale_ramp_roundtrips() {
    var i = 0
    while i < 24 {
        let v = 8 + 10 * i
        assert(term.rgb_to_256(v, v, v) == 232 + i, "ramp {i}")
        i += 1
    }
}

fn t_color_cube_wins_equal_distance() {
    assert(term.rgb_to_256(0, 0, 0) == 16, "black is cube entry 16")
}

fn t_color_rgb_to_16_canonical_and_tie() {
    let rs = [0, 128, 0, 128, 0, 128, 0, 192, 128, 255, 0, 255, 0, 255, 0, 255]
    let gs = [0, 0, 128, 128, 0, 0, 128, 192, 128, 0, 255, 255, 0, 0, 255, 255]
    let bs = [0, 0, 0, 0, 128, 128, 128, 192, 128, 0, 0, 0, 255, 255, 255, 255]
    var i = 0
    while i < 16 {
        assert(term.rgb_to_16(rs[i], gs[i], bs[i]) == i, "ansi {i} round-trips")
        i += 1
    }
    assert(term.rgb_to_16(0, 0, 64) == 0, "ties to the lower index")
}

fn tier_of(forced: str, has_forced: bool, termv: str, has_term: bool, truecolor: bool) -> int {
    var caps = term.caps_new()
    caps.truecolor = truecolor
    term.render_tier(caps, fn(k: str) (if k == "YEW_COLORS" then (forced, has_forced) else (if k == "TERM" then (termv, has_term) else ("", false))))
}

fn t_color_render_tier_environment() {
    assert(tier_of("truecolor", true, "dumb", true, false) == 2, "forced truecolor")
    assert(tier_of("256", true, "dumb", true, true) == 1, "forced 256")
    assert(tier_of("16", true, "xterm-direct", true, true) == 0, "forced 16")
    assert(tier_of("", false, "dumb", true, true) == 2, "cap truecolor")
    assert(tier_of("", false, "xterm-256color", true, false) == 1, "TERM 256color")
    assert(tier_of("", false, "screen-256color", true, false) == 1, "screen-256color")
    assert(tier_of("", false, "xterm-direct", true, false) == 1, "TERM direct without the cap")
    assert(tier_of("", false, "vt100", true, false) == 0, "vt100")
    assert(tier_of("", false, "", false, false) == 0, "nothing")
    assert(tier_of("bogus", true, "xterm-256color", true, false) == 1, "bogus forcing ignored")
    assert(tier_of("", true, "vt100", true, true) == 2, "empty forcing ignored, cap wins")
}

fn t_render_empty_frame_emits_zero_bytes() {
    var f = fixture(2, 4, true)
    term.grid_flip(mut f.grid)
    assert(frame(mut f) == 0, "zero bytes")
    assert(f.out.len == 0, "nothing appended")
}

fn t_render_oob_flushes_after_frame() {
    var f = fixture(1, 1, true)
    let d = term.color_default()
    term.grid_flip(mut f.grid)
    put(mut f, 0, 0, "x", d, d, 0)
    term.render_oob_queue(mut f.render, bytes_of("\x1b]52"))
    term.render_oob_queue(mut f.render, bytes_of(";c"))
    assert(term.render_oob_pending(f.render) == 6, "six queued")
    let _ = frame(mut f)
    assert(term.render_oob_pending(f.render) == 0, "flushed")
    let esu = "\x1b[?2026l"
    assert(f.out.len >= esu.len + 6, "long enough")
    let tail = f.out[f.out.len - 6..f.out.len]
    assert(same_bytes(tail, bytes_of("\x1b]52;c")), "the queue is the tail")
    let before = f.out[f.out.len - 6 - esu.len..f.out.len - 6]
    assert(same_bytes(before, bytes_of(esu)), "after the end marker")
    let first_len = f.out.len
    term.grid_flip(mut f.grid)
    term.render_oob_queue(mut f.render, bytes_of("z"))
    assert(frame(mut f) == 1, "one byte: the queued z")
    assert(f.out.len == first_len + 1 && f.out[f.out.len - 1] as int == 122, "z appended")
    assert(term.render_oob_pending(f.render) == 0, "empty again")
}

fn t_render_frame_envelope_goldens() {
    let bare = "\x1b[?25l\x1b[2 q\x1b[H\x1b[0mx\x1b[H\x1b[?25h"
    let synced = "\x1b[?2026h\x1b[?25l\x1b[2 q\x1b[H\x1b[0mx\x1b[H\x1b[?25h\x1b[?2026l"
    let d = term.color_default()
    var f = fixture(1, 1, false)
    term.grid_flip(mut f.grid)
    put(mut f, 0, 0, "x", d, d, 0)
    term.grid_cursor(mut f.grid, 0, 0, true)
    assert(frame(mut f) == bare.len, "bare length")
    assert(equals(f.out, bare), "bare bytes")
    assert(f.out.len <= 32, "a single-cell change is at most 32 bytes")
    var s = fixture(1, 1, true)
    term.grid_flip(mut s.grid)
    put(mut s, 0, 0, "x", d, d, 0)
    term.grid_cursor(mut s.grid, 0, 0, true)
    assert(frame(mut s) == synced.len, "synced length")
    assert(equals(s.out, synced), "synced bytes")
}

fn t_render_gap_motion_goldens() {
    let middles = ["XbY", "XbcY", "XbcdY", "X\x1b[4CY", "X\x1b[5CY", "X\x1b[6CY"]
    let d = term.color_default()
    var gap = 1
    while gap <= 6 {
        var f = fixture(1, 8, false)
        puts(mut f, 0, 0, "abcdefgh", d, d, 0)
        term.grid_flip(mut f.grid)
        put(mut f, 0, 0, "X", d, d, 0)
        put(mut f, 0, gap + 1, "Y", d, d, 0)
        let _ = frame(mut f)
        assert(contains(f.out, middles[gap - 1]), "gap {gap}")
        gap += 1
    }
    var g2 = fixture(2, 8, false)
    term.grid_flip(mut g2.grid)
    put(mut g2, 0, 0, "X", d, d, 0)
    put(mut g2, 1, 3, "Y", d, d, 0)
    let _ = frame(mut g2)
    assert(contains(g2.out, "X\x1b[2;4HY"), "a row change is a CUP")
    var g3 = fixture(1, 3, false)
    put(mut g3, 0, 0, "a", d, d, 0)
    var combining = bytes_of("e")
    (mut combining).push(204 as byte)
    (mut combining).push(129 as byte)
    (mut combining).push(204 as byte)
    (mut combining).push(130 as byte)
    let _ = term.grid_put(mut g3.grid, 0, 1, combining, 0, combining.len, d, d, 0)
    put(mut g3, 0, 2, "c", d, d, 0)
    term.grid_flip(mut g3.grid)
    put(mut g3, 0, 0, "X", d, d, 0)
    put(mut g3, 0, 2, "Y", d, d, 0)
    let _ = frame(mut g3)
    assert(contains(g3.out, "X\x1b[1CY"), "a combining cell costs more than CUF")
}

fn t_render_ascii_run_preserves_gap_and_style_boundaries() {
    let d = term.color_default()
    var f = fixture(1, 8, false)
    puts(mut f, 0, 0, "abcdefgh", d, d, 0)
    term.grid_flip(mut f.grid)
    puts(mut f, 0, 0, "AB", d, d, 0)
    puts(mut f, 0, 3, "DE", d, d, term.ATTR_BOLD)
    let _ = frame(mut f)
    assert(contains(f.out, "ABc\x1b[1mDE"), "re-emit c then bold DE")
}

fn t_render_erase_to_eol_heuristic() {
    let d = term.color_default()
    var f = fixture(1, 8, false)
    puts(mut f, 0, 0, "abcdefgh", d, d, 0)
    term.grid_flip(mut f.grid)
    term.grid_clear(mut f.grid)
    let _ = frame(mut f)
    assert(contains(f.out, "\x1b[0m\x1b[K"), "EL on a default-background blank tail")
    var s = fixture(1, 8, false)
    puts(mut s, 0, 0, "abcdefgh", d, d, 0)
    term.grid_flip(mut s.grid)
    var styled = term.cell_blank()
    styled.bg = term.color_indexed(1)
    term.grid_fill(mut s.grid, 0, 0, 8, styled)
    let _ = frame(mut s)
    assert(!contains(s.out, "\x1b[K"), "no EL on a coloured background")
    assert(contains(s.out, "\x1b[0;41m        "), "spaces instead")
}

fn t_render_bold_dim_shared_reset_transitions() {
    let states = [0, term.ATTR_BOLD, term.ATTR_DIM, term.ATTR_BOLD | term.ATTR_DIM]
    let deltas = [
        "",
        "\x1b[1m",
        "\x1b[2m",
        "\x1b[1;2m",
        "\x1b[22m",
        "",
        "\x1b[22;2m",
        "\x1b[2m",
        "\x1b[22m",
        "\x1b[22;1m",
        "",
        "\x1b[1m",
        "\x1b[22m",
        "\x1b[22;1m",
        "\x1b[22;2m",
        "",
    ]
    let d = term.color_default()
    var from = 0
    while from < 4 {
        var to = 0
        while to < 4 {
            var f = fixture(1, 2, false)
            term.grid_flip(mut f.grid)
            put(mut f, 0, 0, "a", d, d, states[from])
            put(mut f, 0, 1, "b", d, d, states[to])
            let _ = frame(mut f)
            let delta = deltas[from * 4 + to]
            assert(contains(f.out, "a{delta}b"), "bold/dim {from} -> {to}")
            to += 1
        }
        from += 1
    }
}

fn t_render_three_resets_use_full_reset() {
    let d = term.color_default()
    var f = fixture(1, 2, false)
    term.grid_flip(mut f.grid)
    put(mut f, 0, 0, "a", d, d, term.ATTR_ITALIC | term.ATTR_BLINK | term.ATTR_REVERSE)
    put(mut f, 0, 1, "b", d, d, 0)
    let _ = frame(mut f)
    assert(contains(f.out, "a\x1b[0mb"), "three resets become 0")
}

fn t_render_same_state_is_byte_identical() {
    let color = term.color_rgb(12, 34, 56)
    let d = term.color_default()
    var a = fixture(2, 5, true)
    var b = fixture(2, 5, true)
    puts(mut a, 1, 1, "xyz", color, d, term.ATTR_BOLD)
    puts(mut b, 1, 1, "xyz", color, d, term.ATTR_BOLD)
    let _ = frame(mut a)
    let _ = frame(mut b)
    assert(same_bytes(a.out, b.out), "same state, same bytes")
}

fn t_render_put_order_is_byte_identical() {
    let d = term.color_default()
    var a = fixture(1, 5, false)
    var b = fixture(1, 5, false)
    put(mut a, 0, 4, "z", d, d, 0)
    put(mut a, 0, 0, "a", d, d, 0)
    put(mut b, 0, 0, "a", d, d, 0)
    put(mut b, 0, 4, "z", d, d, 0)
    let _ = frame(mut a)
    let _ = frame(mut b)
    assert(same_bytes(a.out, b.out), "put order does not matter")
}

fn t_render_resize_repaint_is_deterministic() {
    let d = term.color_default()
    var f = fixture(24, 80, false)
    puts(mut f, 0, 0, "yew", d, d, 0)
    let _ = frame(mut f)
    var first = List[term.Cell]()
    var i = 0
    while i < 24 * 80 {
        (mut first).push(term.grid_back(f.grid, i / 80, i % 80))
        i += 1
    }
    assert(term.grid_resize(mut f.grid, 12, 40), "shrink")
    puts(mut f, 0, 0, "yew", d, d, 0)
    f.out = List[byte]()
    assert(frame(mut f) != 0, "a repaint after the shrink")
    assert(term.grid_resize(mut f.grid, 24, 80), "grow back")
    puts(mut f, 0, 0, "yew", d, d, 0)
    f.out = List[byte]()
    let _ = frame(mut f)
    i = 0
    while i < 24 * 80 {
        assert(term.cell_eq(term.grid_back(f.grid, i / 80, i % 80), first[i]), "cell {i} as before")
        i += 1
    }
}

fn t_render_cursor_only_frames_track_position_and_visibility() {
    let d = term.color_default()
    var f = fixture(1, 4, false)
    put(mut f, 0, 0, "x", d, d, 0)
    let _ = frame(mut f)
    term.grid_flip(mut f.grid)
    f.out = List[byte]()
    term.grid_cursor(mut f.grid, 0, 2, true)
    let move_show = "\x1b[1;3H\x1b[?25h"
    assert(frame(mut f) == move_show.len && equals(f.out, move_show), "move and show")
    f.out = List[byte]()
    assert(frame(mut f) == 0 && f.out.len == 0, "then nothing")
    term.grid_cursor(mut f.grid, 0, 2, false)
    let hide = "\x1b[1;3H\x1b[?25l"
    assert(frame(mut f) == hide.len && equals(f.out, hide), "hide")
    f.out = List[byte]()
    term.grid_cursor_shape(mut f.grid, term.CURSOR_BAR)
    let bar = "\x1b[6 q\x1b[1;3H"
    assert(frame(mut f) == bar.len && equals(f.out, bar), "bar shape")
}

fn t_render_tier16_downconverts_high_index() {
    var f = fixture(1, 1, false)
    f.render.tier = term.TIER_16
    term.grid_flip(mut f.grid)
    put(mut f, 0, 0, "x", term.color_indexed(196), term.color_default(), 0)
    let _ = frame(mut f)
    assert(contains(f.out, "\x1b[0;91mx"), "196 is bright red at tier 16")
    assert(!contains(f.out, "38;5"), "no 256 sequence")
}

fn t_render_invalid_byte_style_is_reverse() {
    let d = term.color_default()
    var f = fixture(1, 1, false)
    term.grid_flip(mut f.grid)
    put(mut f, 0, 0, "x", d, d, term.ATTR_INVALID_BYTE)
    let _ = frame(mut f)
    assert(contains(f.out, "\x1b[0;7mx"), "invalid is reverse")
}

fn t_render_underline_undercurl_shared_reset() {
    let states = [0, term.ATTR_UNDERLINE, term.ATTR_UNDERCURL, term.ATTR_UNDERLINE | term.ATTR_UNDERCURL]
    let deltas = [
        "",
        "\x1b[4m",
        "\x1b[4:3m",
        "\x1b[4:3m",
        "\x1b[24m",
        "",
        "\x1b[24;4:3m",
        "\x1b[24;4:3m",
        "\x1b[24m",
        "\x1b[24;4m",
        "",
        "",
        "\x1b[24m",
        "\x1b[24;4m",
        "",
        "",
    ]
    let d = term.color_default()
    var from = 0
    while from < 4 {
        var to = 0
        while to < 4 {
            var f = fixture(1, 2, false)
            put(mut f, 0, 0, "a", d, d, states[from])
            put(mut f, 0, 1, "b", d, d, states[to])
            let _ = frame(mut f)
            let delta = deltas[from * 4 + to]
            assert(contains(f.out, "a{delta}b"), "underline {from} -> {to}")
            to += 1
        }
        from += 1
    }
    var e = fixture(1, 2, false)
    term.render_set_underline_colors(mut e.render, term.color_rgb(255, 95, 95), term.color_rgb(229, 192, 123), term.color_rgb(97, 175, 239))
    put(mut e, 0, 0, "a", d, d, term.ATTR_UNDERLINE | term.CELL_UL_ERROR)
    put(mut e, 0, 1, "b", d, d, term.ATTR_UNDERLINE)
    let _ = frame(mut e)
    assert(contains(e.out, "58;2;255;95;95"), "the error colour")
    assert(contains(e.out, "a\x1b[59mb"), "then the default underline colour")
    assert((term.CELL_UL_MASK & term.ATTR_INVALID_BYTE) == 0, "the masks do not overlap")
    var w = fixture(1, 1, false)
    term.render_set_underline_colors(mut w.render, term.color_rgb(255, 95, 95), term.color_rgb(229, 192, 123), term.color_rgb(97, 175, 239))
    put(mut w, 0, 0, "w", d, d, term.ATTR_UNDERCURL | term.CELL_UL_WARN)
    let _ = frame(mut w)
    assert(contains(w.out, "58;2;229;192;123"), "the warning colour")
    assert(contains(w.out, "\x1b[59m"), "reset at the frame end")
    assert((w.render.attrs & term.CELL_UL_MASK) == 0, "the pen forgets the selector")
    var p = fixture(1, 1, false)
    p.render.tier = term.TIER_256
    p.render.undercurl = false
    term.render_set_underline_colors(mut p.render, term.color_rgb(255, 95, 95), term.color_rgb(229, 192, 123), term.color_rgb(97, 175, 239))
    put(mut p, 0, 0, "x", d, d, term.ATTR_UNDERCURL | term.CELL_UL_WARN)
    let _ = frame(mut p)
    assert(!contains(p.out, "58;") && !contains(p.out, "59m"), "no underline colour at 256")
    assert(contains(p.out, "\x1b[0;4m"), "plain underline instead")
}

// The six invalid-cell scenarios of `test_render.c:560-603`, run in this
// process when spawned with `--invalid-cell N`: each must end in the
// internal-error report (exit 4). stderr goes to /dev/null, the log too.
fn invalid_cell_scenario(scenario: int) {
    var f = fixture(1, 1, false)
    var bad = term.cell_blank()
    if scenario < 2 {
        bad.flags = term.CELL_INTERNED
        bad.lo = 4294967295
    } else if scenario == 2 {
        bad.lo = 27
    } else if scenario < 5 {
        bad.lo = 97 + 98 * 256
    } else {
        bad.lo = 255
    }
    if scenario == 0 || scenario == 3 {
        term.grid_fill(mut f.grid, 0, 0, 1, bad)
    } else {
        term.grid_set_back(mut f.grid, 0, 0, bad)
        term.grid_mark_all(mut f.grid)
        let _ = frame(mut f)
    }
    os_exit(0)
}

fn invalid_cell_child_exit(scenario: int) -> int {
    let exe = os_exe() else {
        return -1
    }
    var c = process.command(exe)
    process.push_arg(mut c, "--invalid-cell")
    process.push_arg(mut c, "{scenario}")
    let sink = fs.open_append("/dev/null") else |_| {
        return -1
    }
    process.set_stderr(mut c, sink)
    let child = process.start(c) else |_| {
        return -1
    }
    let status = process.wait_status(take child) else -1
    fs.close(take sink) else |_| {}
    status
}

fn t_render_invalid_cells_are_bugs() {
    var i = 0
    while i < 6 {
        assert(invalid_cell_child_exit(i) == 4, "invalid cell scenario {i} exits 4")
        i += 1
    }
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let args = env_args()
    if args.len == 2 && args[0] == "--invalid-cell" {
        let n = args[1].to_int() else 0
        invalid_cell_scenario(n)
        return
    }
    t_color_rgb_to_256_vectors()
    t_color_grayscale_ramp_roundtrips()
    t_color_cube_wins_equal_distance()
    t_color_rgb_to_16_canonical_and_tie()
    t_color_render_tier_environment()
    t_render_empty_frame_emits_zero_bytes()
    t_render_oob_flushes_after_frame()
    t_render_frame_envelope_goldens()
    t_render_gap_motion_goldens()
    t_render_ascii_run_preserves_gap_and_style_boundaries()
    t_render_erase_to_eol_heuristic()
    t_render_bold_dim_shared_reset_transitions()
    t_render_three_resets_use_full_reset()
    t_render_same_state_is_byte_identical()
    t_render_put_order_is_byte_identical()
    t_render_resize_repaint_is_deterministic()
    t_render_cursor_only_frames_track_position_and_visibility()
    t_render_tier16_downconverts_high_index()
    t_render_invalid_byte_style_is_reverse()
    t_render_underline_undercurl_shared_reset()
    t_render_invalid_cells_are_bugs()
    print("render_test: 21 cases pass")
}
