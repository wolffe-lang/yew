//! member: false
//! Byte-preserving message regressions for sagitta 9ace98c2
//! src/ui/message.c:154-207,249-300,365-475; ui/cmdline.c:3290-3330,
//! 3523-3529,3629-3761; term/grid.c:272-288; util/log.c:124-176,204-229. These supplement,
//! rather than edit, the six pinned test_message.c cases.

use edit
use std.fs
use term
use util

fn bytes(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() { (mut out).push(b) }
    out
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

fn raw_message() -> List[byte] { [97 as byte, 128 as byte, 98 as byte] }

fn fixture() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(6, 24)
    ed.footer_rect = edit.rect(0, 5, 24, 1)
    ed.wins[ed.win].rect = edit.rect(0, 0, 24, 5)
    ed.wins[ed.win].vp.rows = 5
    ed.wins[ed.win].vp.cols = 24
    ed.full_damage = false
    ed.footer_dirty = false
    ed
}

fn cell(ed: edit.Ed, row: int, col: int) -> int {
    term.cell_byte(term.grid_back(ed.grid, row, col), 0)
}

fn t_raw_lifecycle_and_priority() {
    var ed = fixture()
    let raw = raw_message()
    edit.ed_msg_bytes_at(mut ed, edit.MSG_WARN, 100, raw)
    assert(ed.msg.active && ed.msg.has_raw && same(edit.msg_bytes(ed.msg), raw))
    assert(edit.msg_byte_len(ed.msg) == 3 && !edit.msg_equals_text(ed.msg, ""))
    assert(edit.timers_deadline(ed.timers, 100) == 8000)
    edit.ed_timers_fire(mut ed, 8100)
    assert(!ed.msg.active && !ed.msg.has_raw && ed.msg.raw.len == 0)
    edit.ed_msg_bytes_at(mut ed, edit.MSG_ERROR, 200, raw)
    edit.ed_msg_bytes_at(mut ed, edit.MSG_INFO, 300, "ignored".bytes())
    assert(ed.msg.sev == edit.MSG_ERROR && same(edit.msg_bytes(ed.msg), raw))
    assert(ed.msg.expiry == edit.TIMER_NONE)
    ed.prompt = edit.PROMPT_QUIT_DIRTY
    edit.ed_msg_bytes_at(mut ed, edit.MSG_WARN, 400, raw)
    assert(ed.msg.prompt && ed.msg.expiry == edit.TIMER_NONE)
    ed.prompt = edit.PROMPT_NONE
    edit.ed_msg_bytes_at(mut ed, edit.MSG_ERROR, 500, "ignored too".bytes())
    assert(ed.msg.prompt && same(edit.msg_bytes(ed.msg), raw))
    edit.ed_msg_clear(mut ed)
    assert(!ed.msg.active && !ed.msg.has_raw && ed.msg.raw.len == 0)
}

fn t_nul_utf8_and_long_messages() {
    var ed = fixture()
    let nul = [97 as byte, 128 as byte, 0 as byte, 122 as byte]
    edit.ed_msg_bytes_at(mut ed, edit.MSG_WARN, 0, nul)
    assert(same(edit.msg_bytes(ed.msg), [97 as byte, 128 as byte]))
    let utf8 = "héllo 漢"
    edit.ed_msg_bytes_at(mut ed, edit.MSG_WARN, 0, utf8.bytes())
    assert(!ed.msg.has_raw && ed.msg.text == utf8 && edit.msg_equals_text(ed.msg, utf8))
    edit.ed_msg_at(mut ed, edit.MSG_WARN, 0, "before\0after")
    assert(ed.msg.text == "before")
    var long = raw_message()
    for _ in 0..700 { (mut long).push(120 as byte) }
    edit.ed_msg_bytes_at(mut ed, edit.MSG_WARN, 0, long)
    assert(ed.msg.has_raw && edit.msg_byte_len(ed.msg) == 703)
    assert(same(edit.msg_bytes(ed.msg), long))
    edit.ed_msg_bytes_at(mut ed, edit.MSG_INFO, 9223372036854775806, raw_message())
    assert(edit.timers_deadline(ed.timers, 9223372036854775806) == 1)
}

fn t_clipping_and_rendering() {
    var ed = fixture()
    let raw = raw_message()
    let (whole, cut) = edit.message_clip(raw, 6)
    assert(!cut && same(whole, raw))
    let (clipped, short) = edit.message_clip(raw, 5)
    assert(short && same(clipped, "a…".bytes()))
    edit.ed_msg_bytes_at(mut ed, edit.MSG_WARN, 0, raw)
    let w = ed.win
    edit.message_draw(mut ed, w)
    assert(same(ed.dbuf.msg, raw))
    assert(cell(ed, 5, 3) == 97)
    assert(cell(ed, 5, 4) == 60 && cell(ed, 5, 5) == 56)
    assert(cell(ed, 5, 6) == 48 && cell(ed, 5, 7) == 62 && cell(ed, 5, 8) == 98)
    assert(term.grid_back(ed.grid, 5, 4).attrs & term.ATTR_INVALID_BYTE != 0)
}

fn t_prompt_error_promotion_and_reset() {
    var ed = fixture()
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "bad")
    let raw = raw_message()
    edit.ed_msg_bytes_at(mut ed, edit.MSG_ERROR, 0, raw)
    let generation = ed.cmdline.generation
    edit.cmdline_failed(mut ed, edit.CMD_ERR_STATE, 0, 0, 3, edit.PROMPT_CMD, generation)
    assert(ed.cmdline.err_has_raw && same(ed.cmdline.err_raw, raw))
    assert(
        same(
            edit.msg_bytes(ed.msg),
            [69 as byte, 58 as byte, 32 as byte, 97 as byte, 128 as byte, 98 as byte],
        ),
    )
    let footer = copy ed.footer_rect
    edit.cmdline_draw(mut ed, footer)
    assert(
        same(
            ed.dbuf.msg,
            [69 as byte, 58 as byte, 32 as byte, 97 as byte, 128 as byte, 98 as byte],
        ),
    )
    assert(cell(ed, 4, 0) == 69 && cell(ed, 4, 3) == 97 && cell(ed, 4, 4) == 60)
    edit.cmdline_close(mut ed, false)
    assert(!ed.cmdline.err_has_raw && ed.cmdline.err_raw.len == 0)
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "bad")
    assert(ed.cmdline.err_msg.len == 0 && !ed.cmdline.err_has_raw)
    // C's 127-byte cap may split a valid scalar. It must not silently
    // shorten the message to the prior Unicode boundary.
    var capped = bytes("x".repeat(126))
    for b in "é".bytes() { (mut capped).push(b) }
    edit.cmdline_set_error_bytes(mut ed, 0, 3, capped)
    assert(ed.cmdline.err_has_raw && ed.cmdline.err_raw.len == 127)
    assert(ed.cmdline.err_raw[126] == 195 as byte)
}

fn t_input_disclosure_keeps_raw_newline() {
    var ed = fixture()
    edit.cmdline_open_input(mut ed, "", edit.INPUT_DONE_NONE, 0)
    let raw = [97 as byte, 128 as byte, 10 as byte, 98 as byte]
    ed.full_damage = false
    edit.ed_msg_bytes_at(mut ed, edit.MSG_WARN, 0, raw)
    assert(ed.full_damage)
    let footer = copy ed.footer_rect
    edit.cmdline_draw(mut ed, footer)
    assert(cell(ed, 3, 0) == 97 && cell(ed, 3, 1) == 60)
    assert(cell(ed, 4, 0) == 98)
    edit.ed_msg_clear(mut ed)
    ed.full_damage = false
    edit.ed_msg_bytes_at(mut ed, edit.MSG_WARN, 0, "z".repeat(513).bytes())
    assert(ed.full_damage, "C allocates a full message past its inline array")
}

fn restore_env(name: str, present: bool, value: str) {
    if present {
        env_set(name, value) else |_| { assert(false) }
    } else {
        env_unset(name) else |_| { assert(false) }
    }
}

fn t_byte_log_is_verbatim_and_thresholded() {
    var had_path = true
    let old_path = env_get("YEW_LOG") else { had_path = false; "" }
    var had_level = true
    let old_level = env_get("YEW_LOG_LEVEL") else { had_level = false; "" }
    defer restore_env("YEW_LOG", had_path, old_path)
    defer restore_env("YEW_LOG_LEVEL", had_level, old_level)
    let dir = env_get("XDG_CACHE_HOME") else (env_get("TMPDIR") else ".")
    fs.create_dir_all(dir) else |_| { assert(false) }
    var suffix = ""
    for b in os_random(8) { suffix += "{b}" }
    let path = "{dir}/yw09-message-bytes-{suffix}.log"
    defer fs.remove(path) else |_| {}
    env_set("YEW_LOG", path) else |_| { assert(false) }
    env_set("YEW_LOG_LEVEL", "debug") else |_| { assert(false) }
    util.log_at_bytes(util.LOG_WARN, [97 as byte, 128 as byte, 98 as byte, 0 as byte, 122 as byte])
    let first = fs.read_bytes(path) else { assert(false); return }
    assert(first.len == 31 && first[20] == 32 as byte)
    assert(same(first[21..27], "warn: ".bytes()))
    assert(same(first[27..31], [97 as byte, 128 as byte, 98 as byte, 10 as byte]))
    env_set("YEW_LOG_LEVEL", "error") else |_| { assert(false) }
    util.log_at_bytes(util.LOG_INFO, "suppressed".bytes())
    let second = fs.read_bytes(path) else { assert(false); return }
    assert(same(first, second))
    var long = [128 as byte]
    for _ in 0..1200 { (mut long).push(120 as byte) }
    util.log_at_bytes(util.LOG_ERROR, long)
    let third = fs.read_bytes(path) else { assert(false); return }
    assert(third.len == 31 + 28 + 1201 + 1)
    assert(same(third[52..59], "error: ".bytes()))
    assert(third[59] == 128 as byte && third[third.len - 1] == 10 as byte)
}

fn main() {
    t_raw_lifecycle_and_priority()
    t_nul_utf8_and_long_messages()
    t_clipping_and_rendering()
    t_prompt_error_promotion_and_reset()
    t_input_disclosure_keeps_raw_newline()
    t_byte_log_is_verbatim_and_thresholded()
    print("message bytes: 6 cases PASS")
}
