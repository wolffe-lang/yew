//! member: false
//! Collapsed cursor additions are yew's own document-mode gestures.
//! These rows inject terminal bytes through the real decoder and dispatcher.

use edit
use term
use text

fn fixture(seed: str, mode: int, at: int) -> edit.Ed {
    let runtime = fs_read_bytes("runtime/init.fl") else List[byte]()
    assert(runtime.len != 0, "runtime readable")
    fixture_runtime(seed, mode, at, runtime)
}

fn fixture_runtime(seed: str, mode: int, at: int, runtime: List[byte]) -> edit.Ed {
    var ed = edit.ed_new_test(runtime, "")
    let w = ed.win
    let b = ed.wins[w].buf
    let bytes = seed.bytes()
    ed.bufs[b].ec.tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    ed.bufs[b].ec.undo = text.undo_new(ed.bufs[b].ec.tb)
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    edit.ed_layout(mut ed)
    assert(edit.mode_enter(mut ed, mode) == edit.CMD_OK, "mode enters")
    ed.wins[w].cs = text.cset_init(text.cursor_at(at as text.ByteOff))
    ed.wins[w].cs.curs[0].goal_col = text.CCOL_HERE
    edit.pane_tables_reset(mut ed)
    let leaf = edit.pane_table_add_leaf(mut ed, ed.pane_root)
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.wins[w].rect, leaf)
    ed
}

// Keep runtime/bootstrap work outside the behavioral loops. Each subcase
// still begins with a fresh cursor identity space, mode and mouse state.
fn reset(mut ed: edit.Ed, mode: int, at: int) {
    edit.ed_insert_barrier(mut ed)
    edit.menu_close(mut ed)
    edit.mouse_cancel(mut ed)
    assert(edit.mode_enter(mut ed, mode) == edit.CMD_OK, "reset mode enters")
    let w = ed.win
    ed.wins[w].cs = text.cset_init(text.cursor_at(at as text.ByteOff))
    ed.wins[w].cs.curs[0].goal_col = text.CCOL_HERE
    ed.wins[w].vp.top = 0
    ed.wins[w].vp.top_sub = 0
    ed.wins[w].vp.left = 0
    edit.vp_invalidate(mut ed.wins[w])
    edit.ed_msg_clear(mut ed)
    edit.ed_layout(mut ed)
    edit.pane_tables_reset(mut ed)
    let leaf = edit.pane_table_add_leaf(mut ed, ed.pane_root)
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.wins[w].rect, leaf)
}

fn reseed(mut ed: edit.Ed, seed: str, mode: int, at: int) {
    edit.ed_insert_barrier(mut ed)
    let w = ed.win
    let b = ed.wins[w].buf
    ed.wins[w].cs = text.cset_init(text.cursor_at(0 as text.ByteOff))
    let len = text.textbuf_len(ed.bufs[b].ec.tb)
    if len != 0 { text.textbuf_delete(mut ed.bufs[b].ec.tb, text.span(0, len)) }
    let bytes = seed.bytes()
    text.textbuf_insert(mut ed.bufs[b].ec.tb, 0 as text.ByteOff, bytes)
    ed.bufs[b].ec.undo = text.undo_new(ed.bufs[b].ec.tb)
    reset(mut ed, mode, at)
}

fn feed(mut ed: edit.Ed, wire: str) {
    let bytes = wire.bytes()
    term.input_feed(mut ed.input, bytes, 0, bytes.len)
    var key = term.key_new()
    while term.input_next(mut ed.input, 1000, mut key) {
        if key.kind == term.EV_MOUSE {
            edit.mouse_event(mut ed, key)
        } else {
            edit.ed_handle_key(mut ed, key, 1000)
        }
    }
}

fn click(mut ed: edit.Ed, cb: int, row: int, col: int) {
    let r = copy ed.wins[ed.win].rect
    let x = r.x + col + 1
    let y = r.y + row + 1
    feed(mut ed, "\x1b[<{cb};{x};{y}M\x1b[<{cb};{x};{y}m")
}

fn expect(ok: bool, detail: str) -> bool {
    if !ok { print("  {detail}") }
    ok
}

fn same_ints(a: List[int], b: List[int]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

fn same_cursors(a: List[text.Cursor], b: List[text.Cursor]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len {
        if a[i].pos != b[i].pos || a[i].anchor != b[i].anchor || a[i].goal_col != b[i].goal_col {
            return false
        }
    }
    true
}

fn primary(ed: edit.Ed) -> int {
    ed.wins[ed.win].cs.curs[ed.wins[ed.win].cs.primary].pos
}

fn seed_lines() -> str {
    var s = ""
    for _ in 0..30 { s = s + "abcd\n" }
    s
}

fn column(ed: edit.Ed, first: int, count: int) -> bool {
    let cs = ed.wins[ed.win].cs
    if cs.curs.len != count { return false }
    for i in 0..count {
        if cs.curs[i].pos != (first + i) * 5 + 2 || cs.curs[i].anchor != cs.curs[i].pos {
            return false
        }
    }
    true
}

fn all_modes() -> bool {
    var ok = true
    var ed = fixture(seed_lines(), edit.MODE_L, 72)
    for m in [edit.MODE_L, edit.MODE_W, edit.MODE_B, edit.MODE_I] {
        for down in [false, true] {
            reset(mut ed, m, 72)
            feed(mut ed, if down then "\x1b[1;7B" else "\x1b[1;7A")
            ok = expect(
                column(ed, if down then 14 else 13, 2) &&
                    primary(ed) == (if down then 77 else 67) &&
                    ed.mode == m,
                "mode {m}: first vertical add must keep both carets and promote destination",
            ) &&
                ok
        }
    }
    ok
}

fn repeat_grows_mode(mut ed: edit.Ed, m: int) -> bool {
    var ok = true
    for n in [1, 3, 12] {
        for down in [false, true] {
            reset(mut ed, m, 72)
            for _ in 0..n { feed(mut ed, if down then "\x1b[1;7B" else "\x1b[1;7A") }
            let first = if down then 14 else 14 - n
            let last = if down then 14 + n else 14 - n
            ok = expect(
                column(ed, first, n + 1) && primary(ed) == last * 5 + 2 && ed.mode == m,
                "mode {m}, {n} additions: consecutive logical rows, same column, newest primary",
            ) &&
                ok
        }
    }
    ok
}

fn repeat_grows() -> bool {
    var ok = true
    var ed = fixture(seed_lines(), edit.MODE_L, 72)
    for m in [edit.MODE_L, edit.MODE_W, edit.MODE_B, edit.MODE_I] {
        ok = repeat_grows_mode(mut ed, m) && ok
    }
    ok
}

fn reverse() -> bool {
    var ok = true
    var ed = fixture(seed_lines(), edit.MODE_L, 2)
    for m in [edit.MODE_L, edit.MODE_W, edit.MODE_B, edit.MODE_I] {
        reset(mut ed, m, 2)
        feed(mut ed, "\x1b[1;7B")
        feed(mut ed, "\x1b[1;7B")
        let stamps = copy ed.wins[ed.win].cs.stamps
        let next = ed.wins[ed.win].cs.next_stamp
        feed(mut ed, "\x1b[1;7A")
        // Up targets the existing middle caret: promote it, never skip it.
        ok = expect(
            column(ed, 0, 3) &&
                primary(ed) == 7 &&
                ed.wins[ed.win].cs.next_stamp == next &&
                same_ints(ed.wins[ed.win].cs.stamps, stamps),
            "mode {m}: down down up keeps three carets, promotes middle, keeps identities",
        ) &&
            ok
    }
    ok
}

fn append() -> bool {
    var ed = fixture("abcd\nabcd\n", edit.MODE_L, 2)
    append_modes(mut ed)
}

fn append_modes(mut ed: edit.Ed) -> bool {
    var ok = true
    for m in [edit.MODE_L, edit.MODE_W, edit.MODE_B, edit.MODE_I] {
        reset(mut ed, m, 2)
        let stamp = ed.wins[ed.win].cs.stamps[0]
        ok = expect(edit.record_start(mut ed, 97), "record resolved Alt click") && ok
        click(mut ed, 8, 1, 2)
        ok = expect(
            column(ed, 0, 2) &&
                primary(ed) == 7 &&
                ed.mode == m &&
                ed.wins[ed.win].cs.stamps[0] == stamp &&
                ed.mouse.phase == edit.MP_IDLE,
            "mode {m}: Alt click appends, preserves old primary, does not arm drag",
        ) &&
            ok
        ok = expect(edit.record_stop(mut ed) == edit.CMD_OK, "stop click recording") && ok
        let value = text.reg_get(mut ed.regs, 97) else text.regval_new()
        let source = str_from_utf8(value.bytes) else ""
        ok = expect(
            source.contains("ed.cursor.add.at") && source.contains("iarg: 7"),
            "click macro records the resolved offset, not coordinates",
        ) &&
            ok
        let w = ed.win
        ed.wins[w].cs = text.cset_init(text.cursor_at(2 as text.ByteOff))
        ed.wins[w].cs.curs[0].goal_col = text.CCOL_HERE
        ed.wins[w].vp.left = 3
        ok = expect(
            edit.macro_replay(mut ed, 97, 1) == edit.CMD_OK &&
                column(ed, 0, 2) &&
                primary(ed) == 7 &&
                ed.mode == m,
            "recorded click replays at its document offset after scrolling",
        ) &&
            ok
        // Zero takes the recorder's motion-word path instead of iarg emission.
        ed.wins[w].cs = text.cset_init(text.cursor_at(7 as text.ByteOff))
        ed.wins[w].vp.left = 0
        ok = expect(edit.record_start(mut ed, 98), "record a zero-offset click") && ok
        click(mut ed, 8, 0, 0)
        ok = expect(edit.record_stop(mut ed) == edit.CMD_OK, "stop zero-offset recording") && ok
        let zero_value = text.reg_get(mut ed.regs, 98) else text.regval_new()
        let zero_source = str_from_utf8(zero_value.bytes) else ""
        ok = expect(
            zero_source.contains("cursor_add_at") || zero_source.contains("ed.cursor.add.at"),
            "zero-offset click has a recorded command",
        ) &&
            ok
        ed.wins[w].cs = text.cset_init(text.cursor_at(7 as text.ByteOff))
        ed.wins[w].vp.left = 3
        ok = expect(
            edit.macro_replay(mut ed, 98, 1) == edit.CMD_OK &&
                ed.wins[w].cs.curs.len == 2 &&
                ed.wins[w].cs.curs[0].pos == 0 &&
                ed.wins[w].cs.curs[1].pos == 7 &&
                primary(ed) == 0 &&
                ed.mode == m,
            "zero-offset click replays without losing its default argument",
        ) &&
            ok
    }
    ok
}

fn dedup() -> bool {
    var ok = true
    var ed = fixture("abcd\nabcd\n", edit.MODE_L, 2)
    for m in [edit.MODE_L, edit.MODE_W, edit.MODE_B, edit.MODE_I] {
        reset(mut ed, m, 2)
        assert(
            text.cset_add(mut ed.wins[ed.win].cs, text.cursor_at(7 as text.ByteOff)),
            "seed second",
        )
        let stamps = copy ed.wins[ed.win].cs.stamps
        let next = ed.wins[ed.win].cs.next_stamp
        click(mut ed, 8, 1, 2)
        ed.now_ms += edit.CLICK_MULTI_MS
        click(mut ed, 8, 1, 2)
        ok = expect(
            column(ed, 0, 2) &&
                primary(ed) == 7 &&
                ed.mode == m &&
                ed.wins[ed.win].cs.next_stamp == next &&
                same_ints(ed.wins[ed.win].cs.stamps, stamps),
            "mode {m}: repeated Alt click promotes existing identity without moving old caret",
        ) &&
            ok
    }
    ok
}

fn routing() -> bool {
    var ed = fixture("abcd\nabcd\n", edit.MODE_I, 2)
    var ok = append_modes(mut ed)
    for cb in [12, 24, 28] {
        reset(mut ed, edit.MODE_I, 2)
        click(mut ed, cb, 1, 2)
        ok = expect(ed.wins[ed.win].cs.curs.len == 1, "mixed modifier {cb} must not add") && ok
    }
    for cb in [16, 20, 2] {
        reset(mut ed, edit.MODE_I, 2)
        click(mut ed, cb, 1, 2)
        ok = expect(
            edit.ctx_active(ed.ctx) && ed.wins[ed.win].cs.curs.len == 1,
            "context gesture {cb} stays a menu",
        ) &&
            ok
    }
    reset(mut ed, edit.MODE_I, 2)
    feed(mut ed, "\x1b[1;2C")
    let before = copy ed.wins[ed.win].cs
    click(mut ed, 8, 1, 2)
    ok = expect(
        ed.mode == edit.MODE_H &&
            same_cursors(ed.wins[ed.win].cs.curs, before.curs) &&
            same_ints(ed.wins[ed.win].cs.stamps, before.stamps),
        "H Alt click must preserve held selection",
    ) &&
        ok
    ok
}

fn aliases() -> bool {
    var ok = true
    var ed = fixture(seed_lines(), edit.MODE_L, 7)
    for m in [edit.MODE_L, edit.MODE_W, edit.MODE_B, edit.MODE_I] {
        reset(mut ed, m, 7)
        for (alias, dotted) in [
            ("cursor-above", "ed.cursor.add.above"),
            ("cursor-below", "ed.cursor.add.below"),
            ("cursor-drop", "ed.cursor.drop"),
            ("cursor-only", "ed.cursor.collapse"),
        ] {
            let source = alias.bytes()
            let parsed = edit.cmd_parse(mut ed, source)
            ok = expect(
                parsed.command == edit.cmd_lookup(ed.reg, dotted) && parsed.command != 0,
                "{alias}: exact command alias",
            ) &&
                ok
        }
    }
    ok
}

fn aliases_run_mode(mut ed: edit.Ed, m: int) -> bool {
    reset(mut ed, m, 7)
    var ok = true
    for (name, count, pos) in [
        ("cursor-below", 2, 12),
        ("cursor-below", 3, 17),
        ("cursor-above", 3, 12),
        ("cursor-drop", 2, 12),
        ("cursor-only", 1, 12),
    ] {
        edit.cmdline_open(mut ed, edit.PROMPT_CMD, name)
        assert(ed.mode == edit.MODE_E && ed.cmdline.return_mode == m, "prompt mode fixture")
        if name == "cursor-below" && count == 2 {
            let before = copy ed.wins[ed.win].cs
            click(mut ed, 8, 8, 2)
            ok = expect(
                ed.cmdline.active &&
                    ed.mode == edit.MODE_E &&
                    same_cursors(ed.wins[ed.win].cs.curs, before.curs) &&
                    same_ints(ed.wins[ed.win].cs.stamps, before.stamps) &&
                    ed.wins[ed.win].cs.primary == before.primary &&
                    ed.wins[ed.win].cs.next_stamp == before.next_stamp,
                "a document-origin prompt must not enable Alt mouse additions in E",
            ) &&
                ok
        }
        feed(mut ed, "\r")
        ok = expect(
            !ed.cmdline.active &&
                ed.mode == m &&
                ed.wins[ed.win].cs.curs.len == count &&
                primary(ed) == pos,
            "{name} from {m}: returned {ed.mode}, count {ed.wins[ed.win].cs.curs.len}/{count}, primary {primary(ed)}/{pos}",
        ) &&
            ok
    }
    ok
}

fn aliases_run() -> bool {
    var ed = fixture(seed_lines(), edit.MODE_L, 7)
    var ok = true
    for m in [edit.MODE_L, edit.MODE_W, edit.MODE_B, edit.MODE_I] {
        ok = aliases_run_mode(mut ed, m) && ok
    }
    ok
}

fn aliases_held() -> bool {
    var ed = fixture(seed_lines(), edit.MODE_W, 7)
    assert(edit.mode_enter(mut ed, edit.MODE_H) == edit.CMD_OK, "H fixture")
    ed.wins[ed.win].cs.curs[0].anchor = 6
    let original = ed.wins[ed.win].cs.stamps[0]
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "cursor-below")
    assert(ed.cmdline.return_mode == edit.MODE_H, "the origin is H, not its W unit")
    feed(mut ed, "\r")
    expect(
        !ed.cmdline.active &&
            ed.mode == edit.MODE_H &&
            ed.wins[ed.win].cs.curs.len == 2 &&
            primary(ed) == 7 &&
            ed.wins[ed.win].cs.curs[0].anchor == 6 &&
            ed.wins[ed.win].cs.curs[1].pos == 12 &&
            ed.wins[ed.win].cs.stamps[ed.wins[ed.win].cs.primary] == original,
        "an H-origin prompt keeps the legacy non-promoting vertical body",
    )
}

fn defaults_count() -> bool {
    let ed = fixture(seed_lines(), edit.MODE_L, 7)
    let count = edit.bind_active_count(ed)
    print("cursor runtime active rows: {count}")
    expect(count == 402, "394 existing defaults plus eight distinct cursor bindings")
}

fn short_edges() -> bool {
    var ok = true
    var ed = fixture("abcd\nx\nabcd\n", edit.MODE_L, 3)
    for m in [edit.MODE_L, edit.MODE_W, edit.MODE_B, edit.MODE_I] {
        reseed(mut ed, "abcd\nx\nabcd\n", m, 3)
        feed(mut ed, "\x1b[1;7A")
        ok = expect(
            ed.wins[ed.win].cs.curs.len == 1 && primary(ed) == 3,
            "first-line edge is unchanged",
        ) &&
            ok
        feed(mut ed, "\x1b[1;7B")
        ok = expect(primary(ed) == 6, "short line clamps at insertion boundary") && ok
        feed(mut ed, "\x1b[1;7B")
        ok = expect(
            primary(ed) == 10 && ed.wins[ed.win].cs.curs.len == 3,
            "long line recovers display-column goal",
        ) &&
            ok
        // Final empty logical line is valid; the next add is an edge no-op.
        feed(mut ed, "\x1b[1;7B")
        let next = ed.wins[ed.win].cs.next_stamp
        feed(mut ed, "\x1b[1;7B")
        ok = expect(
            primary(ed) == 12 &&
                ed.wins[ed.win].cs.curs.len == 4 &&
                ed.wins[ed.win].cs.next_stamp == next,
            "last-line edge is unchanged",
        ) &&
            ok
        reseed(mut ed, "a\t漢z\nx\na\t漢z\n", m, 5)
        feed(mut ed, "\x1b[1;7B")
        feed(mut ed, "\x1b[1;7B")
        ok = expect(
            ed.wins[ed.win].cs.curs.len == 3 &&
                primary(ed) == 14 &&
                ed.wins[ed.win].cs.curs[1].pos == 8 &&
                ed.wins[ed.win].cs.curs[ed.wins[ed.win].cs.primary].goal_col == 6,
            "tab and wide-grapheme goal survives a short logical line",
        ) &&
            ok
    }
    ok
}

fn cap_atomic() -> bool {
    var bytes = List[byte]()
    for _ in 0..10001 { (mut bytes).push(97 as byte); (mut bytes).push(10 as byte) }
    let config = "bind(\"I\", \"C-A-<down>\", \"ed.cursor.add.below\")\n".bytes()
    var ed = fixture_runtime(str_from_utf8(bytes) else "", edit.MODE_I, 0, config)
    var rest = List[text.Cursor]()
    for i in 1..10000 { (mut rest).push(text.cursor_at((i * 2) as text.ByteOff)) }
    assert(text.cset_add_many(mut ed.wins[ed.win].cs, rest), "seed cap in one normalization")
    let next = ed.wins[ed.win].cs.next_stamp
    let stamps = copy ed.wins[ed.win].cs.stamps
    click(mut ed, 8, 1, 0)
    var ok = expect(
        ed.wins[ed.win].cs.curs.len == 10000 &&
            primary(ed) == 2 &&
            ed.wins[ed.win].cs.curs[0].pos == 0 &&
            ed.wins[ed.win].cs.next_stamp == next &&
            same_ints(ed.wins[ed.win].cs.stamps, stamps),
        "at cap an existing caret is promoted without mutation",
    )
    ed.wins[ed.win].cs.primary = 9999
    let before = copy ed.wins[ed.win].cs.curs
    feed(mut ed, "\x1b[1;7B")
    ok = expect(
        same_cursors(ed.wins[ed.win].cs.curs, before) &&
            same_ints(ed.wins[ed.win].cs.stamps, stamps) &&
            ed.wins[ed.win].cs.primary == 9999 &&
            ed.wins[ed.win].cs.next_stamp == next &&
            ed.msg.active &&
            ed.msg.text.contains("10000"),
        "new location at cap refuses atomically",
    ) &&
        ok
    ok
}

fn plain_click_set_valid() -> bool {
    var ok = true
    var ed = fixture("abcd\nabcd\nabcd\n", edit.MODE_L, 2)
    for m in [edit.MODE_L, edit.MODE_W, edit.MODE_B, edit.MODE_I] {
        for coincident in [false, true] {
            reset(mut ed, m, 2)
            let w = ed.win
            let stamp = ed.wins[w].cs.stamps[0]
            assert(
                text.cset_add(mut ed.wins[w].cs, text.cursor_at(7 as text.ByteOff)),
                "seed middle",
            )
            if coincident {
                assert(
                    text.cset_add(mut ed.wins[w].cs, text.cursor_at(12 as text.ByteOff)),
                    "seed destination",
                )
            }
            click(mut ed, 0, 2, 2)
            let valid = ed.wins[w].cs.curs.len == 2 &&
                ed.wins[w].cs.curs[0].pos == 7 &&
                ed.wins[w].cs.curs[1].pos == 12 &&
                primary(ed) == 12 &&
                ed.wins[w].cs.stamps[ed.wins[w].cs.primary] == stamp
            ok = expect(
                valid,
                "mode {m}: plain click leaves sorted/deduplicated collapsed carets",
            ) &&
                ok
            if valid { text.cset_check_text(ed.bufs[ed.wins[w].buf].ec.tb, ed.wins[w].cs) }
        }
    }
    ok
}

fn alt_pending_gesture() -> bool {
    var ok = true
    var ed = fixture("abcd\nabcd\n", edit.MODE_L, 2)
    for m in [edit.MODE_L, edit.MODE_W, edit.MODE_B, edit.MODE_I] {
        reset(mut ed, m, 2)
        let r = copy ed.wins[ed.win].rect
        let x = r.x + 3
        let y = r.y + 1
        feed(mut ed, "\x1b[<0;{x};{y}M")
        assert(ed.mouse.phase == edit.MP_ARMED, "plain press arms the initial gesture")
        let y2 = y + 1
        feed(mut ed, "\x1b[<8;{x};{y2}M")
        ok = expect(
            ed.mouse.phase == edit.MP_IDLE &&
                ed.mouse.held == 0 &&
                column(ed, 0, 2) &&
                primary(ed) == 7,
            "mode {m}: new Alt press must not inherit an old drag/release target",
        ) &&
            ok
        feed(mut ed, "\x1b[<8;{x};{y2}m")
    }
    ok
}

fn alias_delimiters() -> bool {
    var ed = fixture("a\nb\n", edit.MODE_L, 0)
    var ok = true
    for (source, command) in [("s-a-b-", "ed.search.replace"), ("g-a-d", "ed.search.global")] {
        let bytes = source.bytes()
        let parsed = edit.cmd_parse(mut ed, bytes)
        ok = expect(
            parsed.command == edit.cmd_lookup(ed.reg, command) && !parsed.err.set,
            "{source}: cursor aliases must not steal an existing hyphen delimiter",
        ) &&
            ok
    }
    ok
}

fn recording_view() -> bool {
    var ed = fixture("abcd\nabcd\n", edit.MODE_I, 2)
    let root = ed.pane_root
    let right = edit.pane_split(mut ed, root, edit.SPLIT_V)
    assert(right >= 0, "split fixture")
    edit.ed_layout(mut ed)
    let left = ed.panes[ed.pane_root].a
    let lw = ed.panes[left].win
    let rw = ed.panes[right].win
    edit.pane_tables_reset(mut ed)
    let li = edit.pane_table_add_leaf(mut ed, left)
    let ri = edit.pane_table_add_leaf(mut ed, right)
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.panes[left].rect, li)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.panes[right].rect, ri)
    ed.focus = left
    ed.win = lw
    let tab = ed.tab_active
    ed.tabs[tab].focus = left
    let r = copy ed.wins[rw].rect
    let x = r.x + 3
    let y = r.y + 2
    let hit = edit.region_hit(mut ed.regions, x - 1, y - 1)
    assert(hit.kind == edit.REGION_PANE && hit.payload == ri, "fixture targets the other pane")
    let (hit_ok, hit_pos) = edit.win_click_offset(mut ed, rw, x - 1, y - 1)
    assert(
        hit_ok && hit_pos != ed.wins[rw].cs.curs[ed.wins[rw].cs.primary].pos,
        "fixture targets a new caret in the other view",
    )
    assert(edit.record_start(mut ed, 97), "start one-view recording")
    feed(mut ed, "\x1b[<8;{x};{y}M\x1b[<8;{x};{y}m")
    let stayed = ed.win == lw && ed.wins[lw].cs.curs.len == 1 && ed.wins[rw].cs.curs.len == 1
    let emitted = edit.record_emit(ed.reg, ed.rec)
    let source = str_from_utf8(emitted) else ""
    var ok = expect(
        stayed && !source.contains("cursor_add_at") && !source.contains("ed.cursor.add.at"),
        "recording must validate the original view before focus changes (focus {ed.win}/{lw}, counts {ed.wins[lw].cs.curs.len}/{ed.wins[rw].cs.curs.len})",
    )
    assert(edit.record_stop(mut ed) == edit.CMD_OK, "stop one-view recording")
    // Without a recording, the hit view owns its own set; no cross-view fanout.
    feed(mut ed, "\x1b[<8;{x};{y}M\x1b[<8;{x};{y}m")
    ok = expect(
        ed.win == rw && ed.wins[lw].cs.curs.len == 1 && ed.wins[rw].cs.curs.len == 2,
        "unrecorded Alt click owns the hit set (focus {ed.win}/{rw}, counts {ed.wins[lw].cs.curs.len}/{ed.wins[rw].cs.curs.len})",
    ) &&
        ok
    ok
}

fn stamped_at(ed: edit.Ed, stamp: int, pos: int) -> bool {
    let cs = ed.wins[ed.win].cs
    for i in 0..cs.curs.len {
        if cs.stamps[i] == stamp { return cs.curs[i].pos == pos }
    }
    false
}

fn alt_multi_case(kind: int) -> bool {
    var ed = fixture(seed_lines(), edit.MODE_L, 2)
    var ok = true
    for m in [edit.MODE_L, edit.MODE_W, edit.MODE_B, edit.MODE_I] {
        reset(mut ed, m, 2)
        ed.now_ms = 1000
        let original = ed.wins[ed.win].cs.stamps[0]
        if kind == 0 {
            assert(
                text.cset_add(mut ed.wins[ed.win].cs, text.cursor_at(7 as text.ByteOff)),
                "earlier second",
            )
            assert(
                text.cset_add(mut ed.wins[ed.win].cs, text.cursor_at(17 as text.ByteOff)),
                "earlier third",
            )
            let second = ed.wins[ed.win].cs.stamps[1]
            let third = ed.wins[ed.win].cs.stamps[2]
            click(mut ed, 8, 2, 2)
            let next = ed.wins[ed.win].cs.next_stamp
            ed.now_ms += 399
            click(mut ed, 8, 2, 2)
            let cs = copy ed.wins[ed.win].cs
            ok = expect(
                ed.mode == edit.MODE_H &&
                    cs.curs.len == 3 &&
                    cs.stamps[cs.primary] == original &&
                    cs.curs[cs.primary].anchor == 10 &&
                    primary(ed) == 14 &&
                    stamped_at(ed, second, 7) &&
                    stamped_at(ed, third, 17) &&
                    cs.next_stamp == next,
                "mode {m}: double removes only the speculative caret, keeps earlier identities and never rewinds stamps",
            ) &&
                ok
        } else if kind == 3 {
            click(mut ed, 0, 1, 2)
            ed.now_ms += 399
            click(mut ed, 8, 1, 2)
            let cs = copy ed.wins[ed.win].cs
            ok = expect(
                ed.mode == edit.MODE_H &&
                    cs.curs.len == 1 &&
                    cs.stamps[cs.primary] == original &&
                    cs.curs[cs.primary].anchor == 5 &&
                    primary(ed) == 9,
                "mode {m}: plain first then Alt second still selects the whitespace word",
            ) &&
                ok
        } else {
            click(mut ed, 8, 1, 2)
            let stamps = copy ed.wins[ed.win].cs.stamps
            let next = ed.wins[ed.win].cs.next_stamp
            if kind == 1 {
                ed.now_ms += edit.CLICK_MULTI_MS
                click(mut ed, 8, 1, 2)
                ok = expect(
                    ed.mode == m &&
                        column(ed, 0, 2) &&
                        primary(ed) == 7 &&
                        same_ints(ed.wins[ed.win].cs.stamps, stamps) &&
                        ed.wins[ed.win].cs.next_stamp == next,
                    "mode {m}: a second press at 400ms independently promotes the same caret",
                ) &&
                    ok
            } else if kind == 2 {
                ed.now_ms += 399
                click(mut ed, 8, 2, 2)
                ok = expect(
                    ed.mode == m && column(ed, 0, 3) && primary(ed) == 12,
                    "mode {m}: a different cell starts another addition, not rollback",
                ) &&
                    ok
            } else {
                feed(mut ed, "\x1b[1;7B")
                let after = ed.wins[ed.win].cs.next_stamp
                ed.now_ms += 100
                click(mut ed, 8, 1, 2)
                ok = expect(
                    ed.mode == m &&
                        column(ed, 0, 3) &&
                        primary(ed) == 7 &&
                        ed.wins[ed.win].cs.next_stamp == after,
                    "mode {m}: an intervening command cannot roll back unrelated topology",
                ) &&
                    ok
            }
        }
    }
    ok
}

fn recorder_cursor_prefix(mut ed: edit.Ed) {
    let id = edit.cmd_lookup(ed.reg, "ed.cursor.add.at")
    var cx = edit.cmdctx_new(ed.win, edit.SRC_KEY)
    cx.iarg = 17
    assert(edit.ed_cmd_invoke(mut ed, id, mut cx) == edit.CMD_OK, "resolved prefix control")
}

fn alt_double_recording() -> bool {
    var ed = fixture(seed_lines(), edit.MODE_I, 2)
    ed.now_ms = 1000
    assert(edit.record_start(mut ed, 97), "record prefix-only control")
    recorder_cursor_prefix(mut ed)
    let control_bytes = edit.record_emit(ed.reg, ed.rec)
    let control_source = str_from_utf8(control_bytes) else ""
    assert(edit.record_stop(mut ed) == edit.CMD_OK, "stop prefix-only control")
    reset(mut ed, edit.MODE_I, 2)
    let control_status = edit.macro_replay(mut ed, 97, 1)
    let control_pos = primary(ed)
    let control_count = ed.wins[ed.win].cs.curs.len
    let control_mode = ed.mode
    print("prefix-only replay: status {control_status}, count {control_count}, pos {control_pos}, mode {control_mode}")
    reset(mut ed, edit.MODE_I, 2)
    ed.now_ms = 1000
    assert(edit.record_start(mut ed, 97), "record double fixture")
    recorder_cursor_prefix(mut ed)
    let prefix = ed.rec.ev.len
    assert(prefix != 0, "recorded prefix control")
    let first = ed.rec.ev[0].cmd
    click(mut ed, 8, 1, 2)
    var ok = expect(
        control_status == edit.CMD_OK && control_count == 2 &&
            control_pos == 17 && control_mode == edit.MODE_I,
        "the standalone resolved prefix replays before any mouse gesture",
    )
    ok = expect(ed.rec.ev.len == prefix + 1, "single Alt addition is recorded immediately") && ok
    let next = ed.wins[ed.win].cs.next_stamp
    ed.now_ms += 399
    click(mut ed, 8, 1, 2)
    let emitted = edit.record_emit(ed.reg, ed.rec)
    let source = str_from_utf8(emitted) else ""
    ok = expect(
        ed.mode == edit.MODE_H &&
            ed.rec.ev.len == prefix &&
            ed.rec.ev[0].cmd == first &&
            ed.rec.ev[0].iarg == 17 &&
            ed.wins[ed.win].cs.curs.len == 2 &&
            ed.wins[ed.win].cs.next_stamp == next &&
            source == control_source,
        "double removes only its speculative record entry, retaining the earlier command",
    ) &&
        ok
    assert(edit.record_stop(mut ed) == edit.CMD_OK, "stop double fixture")
    reset(mut ed, edit.MODE_I, 2)
    let status = edit.macro_replay(mut ed, 97, 1)
    ok = expect(
        status == edit.CMD_OK && ed.wins[ed.win].cs.curs.len == 2 &&
            primary(ed) == 17 && ed.mode == edit.MODE_I,
        "legacy mouse selection is not newly recorded; replay keeps the prefix without a phantom caret (status {status}, count {ed.wins[ed.win].cs.curs.len}, pos {primary(ed)}, mode {ed.mode}; control {control_status}/{control_count}/{control_pos}; same source {source == control_source})",
    ) &&
        ok
    if !ok { print("prefix source:\n{control_source}\ndouble source:\n{source}") }
    ok
}

fn command_word() -> bool {
    // Inspect the descriptor before constructing Ed: a missing word must
    // produce this named failure, not hide every row behind an init trap.
    for line in edit.CMDTAB_YEW.lines() {
        let fields = line.split("\x1f")
        if fields.len == 8 && fields[0] == "ed.cursor.add.at" {
            let flags = fields[3].to_int() else 0
            return expect(
                flags & edit.CMD_RECORDABLE != 0 && fields[5] == "cursor_add_at",
                "resolved click additions need a valid recorder command word",
            )
        }
    }
    expect(false, "resolved click command descriptor is missing")
}

fn row(name: str, ok: bool) -> int {
    if ok {
        print("{name}: PASS")
    } else {
        print("FAIL {name}")
    }
    if ok then 0 else 1
}

fn main() {
    let pick = env_get("YEW_CURSOR_ADD_CASE") else ""
    let number = pick.to_int() else -1
    var bad = 0
    if pick.len == 0 || pick == "recordable-cursor-command-word" || number == 9 {
        bad += row("recordable-cursor-command-word", command_word())
        if bad != 0 { os_exit(1) }
    }
    if pick.len == 0 || pick == "ctrl-alt-up-down-all-modes" || number == 0 {
        bad += row("ctrl-alt-up-down-all-modes", all_modes())
    }
    if pick.len == 0 || pick == "ctrl-alt-repeat-grows" {
        bad += row("ctrl-alt-repeat-grows", repeat_grows())
    } else if number == 1 || number >= 14 && number <= 16 {
        // Checked cases partition this row by mode, without dropping any N
        // or direction: 1=L, 14=W, 15=B, 16=I. The native row runs all four.
        let modes = [edit.MODE_L, edit.MODE_W, edit.MODE_B, edit.MODE_I]
        let m = modes[if number == 1 then 0 else number - 13]
        var ed = fixture(seed_lines(), m, 72)
        bad += row("ctrl-alt-repeat-grows", repeat_grows_mode(mut ed, m))
    }
    if pick.len == 0 || pick == "ctrl-alt-reverse" || number == 2 {
        bad += row("ctrl-alt-reverse", reverse())
    }
    if pick.len == 0 || pick == "alt-click-append" || number == 3 {
        bad += row("alt-click-append", append())
    }
    if pick.len == 0 || pick == "alt-click-dedup" || number == 4 {
        bad += row("alt-click-dedup", dedup())
    }
    if pick.len == 0 || pick == "modified-click-routing" || number == 5 {
        bad += row("modified-click-routing", routing())
    }
    if pick.len == 0 || pick == "cursor-command-fallbacks" || number == 6 {
        bad += row("cursor-command-fallbacks", aliases())
    }
    if pick.len == 0 || pick == "cursor-short-lines-and-edges" || number == 7 {
        bad += row("cursor-short-lines-and-edges", short_edges())
    }
    if pick.len == 0 || pick == "cursor-cap-atomic" || number == 8 {
        bad += row("cursor-cap-atomic", cap_atomic())
    }
    if pick.len == 0 || pick == "plain-click-cursor-set-valid" || number == 10 {
        bad += row("plain-click-cursor-set-valid", plain_click_set_valid())
    }
    if pick.len == 0 || pick == "alt-click-cancels-pending" || number == 11 {
        bad += row("alt-click-cancels-pending", alt_pending_gesture())
    }
    if pick.len == 0 || pick == "cursor-aliases-preserve-delimiters" || number == 12 {
        bad += row("cursor-aliases-preserve-delimiters", alias_delimiters())
    }
    if pick.len == 0 || pick == "alt-click-recording-keeps-view" || number == 13 {
        bad += row("alt-click-recording-keeps-view", recording_view())
    }
    if pick.len == 0 || pick == "cursor-aliases-execute-from-prompt" {
        bad += row("cursor-aliases-execute-from-prompt", aliases_run())
    } else if number >= 17 && number <= 20 {
        let modes = [edit.MODE_L, edit.MODE_W, edit.MODE_B, edit.MODE_I]
        let m = modes[number - 17]
        var ed = fixture(seed_lines(), m, 7)
        bad += row("cursor-aliases-execute-from-prompt", aliases_run_mode(mut ed, m))
    }
    if pick.len == 0 || pick == "cursor-defaults-active-count" || number == 21 {
        bad += row("cursor-defaults-active-count", defaults_count())
    }
    if pick.len == 0 || pick == "cursor-prompt-keeps-H-legacy" || number == 22 {
        bad += row("cursor-prompt-keeps-H-legacy", aliases_held())
    }
    for (index, name) in [
        (23, "cursor-alt-double-rollback"),
        (24, "cursor-alt-slow-promotes"),
        (25, "cursor-alt-second-other-cell"),
        (26, "cursor-alt-plain-first-double"),
        (27, "cursor-alt-intervening-command"),
    ] {
        if pick.len == 0 || pick == name || number == index {
            bad += row(name, alt_multi_case(index - 23))
        }
    }
    if pick.len == 0 || pick == "cursor-alt-double-recorder" || number == 28 {
        bad += row("cursor-alt-double-recorder", alt_double_recording())
    }
    if bad != 0 { os_exit(1) }
}
