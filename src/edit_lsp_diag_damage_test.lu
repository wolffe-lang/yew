//! member: false
//!
//! yw25's own cases: a publication of diagnostics repaints the rows its old
//! and new diagnostics touch and the footer, not the screen (sagitta's
//! `yew_diag_replace` sets a full repaint; the port keeps that where the row
//! arithmetic cannot bound the damage: a wrapped view, a split, another
//! buffer in the window). The rows read the editor's damage after each
//! `diag_replace`: `full_damage`, and the focused window's damaged row
//! range `doc_damage_lo..doc_damage_hi`.

use edit
use lsp
use term
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn doc_text() -> str {
    var s = ""
    var i = 0
    while i < 80 {
        s = "{s}let value_{i} = {i}\n"
        i += 1
    }
    s
}

// The driver's frame without the terminal (as edit_drawbufs_test's).
fn fixture() -> edit.Ed {
    var ed = edit.ed_new_test(fs_read_bytes("runtime/init.fl") else List[byte](), "")
    let name = ed.opts.theme
    edit.ed_theme_set(mut ed, name)
    ed.clean = true
    ed.regs.clipboard_sync = text.CLIP_SYNC_OFF
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    var caps = term.caps_new()
    caps.truecolor = true
    ed.render = term.render_new(caps, term.env_process())
    ed.render_ready = true
    edit.ed_open_memory(mut ed, bytes_of(doc_text()), "m.txt")
    edit.ed_layout(mut ed)
    edit.ed_render(mut ed)
    ed
}

fn one(line: int, sev: int) -> str {
    "[{{\"range\":{{\"start\":{{\"line\":{line},\"character\":0}},\"end\":{{\"line\":{line},\"character\":3}}}},\"severity\":{sev},\"message\":\"m{line}\"}}]"
}

fn replace(mut ed: edit.Ed, text: str, version: int) {
    var err = lsp.json_err_new()
    let j = lsp.json_parse(text.bytes(), 0, text.len, mut err) else {
        assert(false, "diagnostic JSON: {err.msg}")
        return
    }
    let b = edit.ed_doc(ed)
    edit.diag_replace(mut ed, b, 7, j, j.root, version)
}

fn rows(ed: edit.Ed) -> (int, int) {
    (ed.doc_damage_lo, ed.doc_damage_hi)
}

fn a_publication_damages_its_rows_and_the_footer() {
    var ed = fixture()
    replace(mut ed, one(10, 1), 1)
    assert(!ed.full_damage, "no full repaint for one diagnostic")
    let (lo, hi) = rows(ed)
    assert(lo == 10 && hi == 11, "row 10 alone is damaged: {lo}..{hi}")
    assert(ed.footer_dirty, "the footer's badge is repainted")
    edit.ed_render(mut ed)
    // The diagnostic moves from line 10 to line 14: both rows, and what lies
    // between them.
    replace(mut ed, one(14, 1), 2)
    assert(!ed.full_damage, "no full repaint for a moved diagnostic")
    let (lo2, hi2) = rows(ed)
    assert(lo2 == 10 && hi2 == 15, "rows 10..15 are damaged: {lo2}..{hi2}")
    edit.ed_render(mut ed)
    // The same diagnostic again: its row, once.
    replace(mut ed, one(14, 1), 3)
    let (lo3, hi3) = rows(ed)
    assert(!ed.full_damage && lo3 == 14 && hi3 == 15, "row 14 alone: {lo3}..{hi3}")
    edit.ed_render(mut ed)
    // An empty publication takes the last one off its row.
    replace(mut ed, "[]", 4)
    let (lo4, hi4) = rows(ed)
    assert(!ed.full_damage && lo4 == 14 && hi4 == 15, "row 14 is cleared: {lo4}..{hi4}")
}

fn a_diagnostic_off_the_screen_damages_no_row() {
    var ed = fixture()
    replace(mut ed, one(70, 2), 1)
    assert(!ed.full_damage, "no full repaint")
    let (lo, hi) = rows(ed)
    assert(lo >= hi, "no row is damaged: {lo}..{hi}")
    assert(ed.footer_dirty, "the badge still changes")
}

fn a_wrapped_view_keeps_the_full_repaint() {
    var ed = fixture()
    ed.wins[ed.win].vp.wrap = true
    replace(mut ed, one(10, 1), 1)
    assert(ed.full_damage, "a wrapped view repaints everything")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    a_publication_damages_its_rows_and_the_footer()
    a_diagnostic_off_the_screen_damages_no_row()
    a_wrapped_view_keeps_the_full_repaint()
    print("edit_lsp_diag_damage_test: 3 cases pass")
}
