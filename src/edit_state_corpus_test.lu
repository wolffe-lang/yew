//! member: false
//! Ports test_state_corpus.c:1100-1132 at sagitta9ace98c2: invalid
//! documents through actual Ed, not merely the pure literal parser.

use edit

fn main() {
    let dir = "tests/unit/fixtures/wsstate/v1/invalid"
    let entries = fs_read_dir(dir) else { assert(false); return }
    let chosen = env_get("YEW_STATE_FIXTURE") else ""
    var tested = 0
    for name in entries {
        if !name.ends_with(".fl") || (chosen.len != 0 && chosen != name) { continue }
        region case {
            let bytes = fs_read_bytes("{dir}/{name}") else { assert(false); return }
            var ed = edit.ed_new()
            edit.ed_open_scratch(mut ed)
            edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
            let result = edit.state_apply(mut ed, bytes)
            assert(result >= edit.WS_FRESH && result <= edit.WS_RECOVERED)
            assert(ed.tabs.len >= 1 && !ed.quit && ed.win >= 0 && edit.pane_live(ed, ed.pane_root))
            edit.state_dispose(mut ed)
        }
        tested += 1
        print("state_corpus_invalid_editor_survival {name}: PASS")
    }
    assert(tested == if chosen.len == 0 then 20 else 1)
    print("state_corpus_invalid_documents_reach_a_result: PASS ({tested}fixtures)")
}
