//! member: false
//!
//! The port's twin of `notes/yw06-evidence/finder-inputs/walk_oracle.c`
//! (the C-only input witness of R-yw06-10): the same two modes over the
//! port's `ws.walk` and `ws.gitignore`, so `witness.py` can run it on the
//! same fixture trees and its JSON can be compared with C's
//! (`notes/yw06-evidence/pick/finder-inputs/`).
//!
//!   ws_walk_lister ROOT            the finder's walk (`use_gitignore`),
//!                                  one relative path a line
//!   ws_walk_lister ROOT --scope    the disk set of ROOT/sub against the
//!                                  in-memory set based at `sub`
//!
//! Exit 2 on a usage error or a refused walk, as C's.

use ws

fn main() -> int {
    let args = env_args()
    if args.len != 1 && args.len != 2 {
        return 2
    }
    if args.len == 2 {
        if args[1] != "--scope" {
            return 2
        }
        var g = ws.gi_new()
        let disk = ws.gi_load(mut g, "{args[0]}/sub", ws.GI_NONE)
        var text = List[byte]()
        for x in "/build/\n".bytes() {
            (mut text).push(x)
        }
        let memory = ws.gi_compile(mut g, "sub", text, ws.GI_NONE)
        let a = if ws.gi_match(g, disk, "sub/build", true) then 1 else 0
        let b = if ws.gi_match(g, disk, "build", true) then 1 else 0
        let c = if ws.gi_match(g, memory, "sub/build", true) then 1 else 0
        print("disk(sub/build)={a} disk(build)={b} memory-base-sub(sub/build)={c}")
        return 0
    }
    var o = ws.walk_opts()
    o.use_gitignore = true
    let (ok, fl) = ws.walk_all(args[0], o)
    if !ok {
        eprint("walk begin failed")
        return 2
    }
    for p in fl.paths {
        print(p)
    }
    0
}
