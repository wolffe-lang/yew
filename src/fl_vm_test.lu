fn run_case(case: int) {
    match case {
        0 => fl_vm_instruction_boundary_work_happens(),
        1 => fl_vm_try_restores_the_stack_pointer_exactly(),
        2 => fl_vm_handlers_nest(),
        3 => fl_vm_deep_recursion_raises_rather_than_overflowing(),
        4 => fl_vm_deferred_surfaces_name_their_sprint(),
        5 => fl_vm_reserved_handle_tags_are_named_not_constructible(),
        6 => fl_vm_arithmetic_and_precedence(),
        7 => fl_vm_truthiness_is_nil_and_false_only(),
        8 => fl_vm_equality_crosses_the_numeric_tower(),
        9 => fl_vm_short_circuit_yields_the_deciding_value(),
        10 => fl_vm_error_kinds(),
        11 => fl_vm_limit_is_catchable(),
        12 => fl_vm_try_catch_binds_the_error_map(),
        13 => fl_vm_upvalues_capture_by_reference(),
        14 => fl_vm_upvalues_capture_through_an_intermediate_function(),
        15 => fl_vm_error_is_the_prelude_raise(),
        16 => fl_vm_loop_variable_is_fresh_each_iteration(),
        17 => fl_vm_lists_and_maps(),
        18 => fl_vm_string_literal_keeps_an_embedded_nul(),
        19 => fl_vm_map_iteration_is_insertion_ordered(),
        20 => fl_vm_control_flow(),
        21 => fl_vm_gc_collects_only_unreachable_objects(),
        22 => fl_vm_gc_root_globals_keeps_values_alive(),
        23 => fl_vm_gc_stress_runs_a_whole_program(),
        24 => fl_vm_spec_14_program_runs_and_shouts(),
        25 => fl_vm_spec_14_total_is_17(),
        26 => fl_vm_spec_14_counter_yields_9_then_10(),
        27 => fl_vm_spec_14_motion_raises_against_the_null_host(),
        28 => fl_vm_disassembly_is_deterministic(),
        29 => fl_vm_opcode_table_is_complete(),
        _ => assert(false),
    }
}

fn main() {
    let args = env_args()
    if args.len != 0 { run_case(args[0].to_int() else -1) } else { for i in 0..30 { run_case(i) } }
}

fn spec_prefix() -> str {
    "fn clamp(x, lo, hi) {{\n    if x < lo {{ return lo }}\n    else if x > hi {{ return hi }}\n    return x\n}}\nfn counter(start) {{\n    let n = start\n    return fn() {{ n = n + 1; return n }}\n}}\n"
}

fn spec_program() -> str {
    "import str\nlet greet = \"hi\\tthere\\n\"\nlet nums  = [1, 2.5, 0x10]\nlet cfg   = {{ tabwidth: 4, wrap: false, name: nil }}\nfn clamp(x, lo, hi) {{\n    if x < lo {{ return lo }}\n    else if x > hi {{ return hi }}\n    return x\n}}\nfn counter(start) {{\n    let n = start\n    return fn() {{ n = n + 1; return n }}\n}}\nlet next = counter(clamp(9, 0, 8))\nwhile next() < 10 {{ }}\nlet total = 0\nfor x in nums {{\n    if x == 2.5 {{ continue }}\n    total = total + x\n}}\nmacro dup = @[ l< H(lv) yank v paste esc ]\nfn shout(s) {{\n    try {{ edit {{ @[ 2v i\"!\" del ] }} }}\n    catch e {{ return str.upper(e.kind) or \"?\" }}\n}}\nreturn total\n"
}

fn vm_case_9() {
    assert_kind("error(\"boom\")\n", "user")
    assert_kind("error({{kind: 7, msg: \"m\"}})\n", "type")
    assert_kind("error({{msg: \"m\"}})\n", "type")
    assert_kind("error(7)\n", "type")
}

fn vm_case_12() {
    var vm = fresh()
    let out = run(mut vm, "return \"a\\0b\"\n")
    assert(!vm.raised && out.t == 4)
    let at = fl.fl_obj_index(vm, out)
    assert(vm.gc.slots[at].bytes.len == 3)
    assert(
        vm.gc.slots[at].bytes[0] == 97 as byte &&
            vm.gc.slots[at].bytes[1] == 0 as byte &&
            vm.gc.slots[at].bytes[2] == 98 as byte,
    )
}

fn vm_case_13() {
    var vm = fresh()
    let m = fl.fl_map_new(mut vm)
    fl.fl_gc_protect(mut vm, m)
    assert(fl.fl_map_set(mut vm, m, fl.fl_int(1), fl.fl_int(10)))
    assert(fl.fl_map_set(mut vm, m, fl.fl_int(2), fl.fl_int(20)))
    assert(fl.fl_map_set(mut vm, m, fl.fl_int(3), fl.fl_int(30)))
    assert(fl.fl_map_del(mut vm, m, fl.fl_int(1)))
    assert(fl.fl_map_set(mut vm, m, fl.fl_int(1), fl.fl_int(11)))
    for pass in 0..2 {
        if pass == 1 { fl.fl_map_compact(mut vm, m) }
        var cur: int = 0
        var seen = List[int]()
        loop {
            let (next, k, _) = fl.fl_map_iter(vm, m, cur) else { break }
            (mut seen).push(k.i)
            cur = next
        }
        assert(seen.len == 3 && seen[0] == 2 && seen[1] == 3 && seen[2] == 1)
    }
    fl.fl_gc_release(mut vm, 1)
}

fn vm_case_14() {
    assert_kind(
        "import list\nlet l = [1, 2, 3]\nfor i, v in l {{ list.push(l, 9) }}\nreturn 0\n",
        "index",
    )
}

fn vm_case_15() {
    var vm = fresh()
    let kept = fl.fl_str_text(mut vm, "kept-alive-by-a-temp-root")
    fl.fl_gc_protect(mut vm, kept)
    let _ = fl.fl_str_text(mut vm, "no root points at this one")
    let before = vm.gc.used
    fl.fl_gc_collect(mut vm)
    assert(vm.gc.used < before)
    let live = fl.fl_temp_get(vm, 0)
    assert(text_eq(vm, live, "kept-alive-by-a-temp-root"))
    fl.fl_gc_release(mut vm, 1)
    let remaining = vm.gc.used
    fl.fl_gc_collect(mut vm)
    assert(vm.gc.used < remaining)
}

fn vm_case_16() {
    var vm = fresh()
    let key = fl.fl_str_text(mut vm, "g")
    fl.fl_gc_protect(mut vm, key)
    let value = fl.fl_str_text(mut vm, "a value")
    let globals = copy vm.globals
    assert(fl.fl_map_set(mut vm, globals, key, value))
    fl.fl_gc_release(mut vm, 1)
    fl.fl_gc_collect(mut vm)
    let current_key = fl.fl_str_text(mut vm, "g")
    let got = fl.fl_map_get(vm, vm.globals, current_key) else fl.fl_nil()
    assert(text_eq(vm, got, "a value"))
}

fn vm_case_17() {
    var vm = fresh()
    vm.gc.stress = true
    let out = run(
        mut vm,
        "let acc = []\nfor x in [1, 2, 3, 4, 5] {{\n  let m = {{n: x, s: \"item\"}}\n  acc = acc + [m]\n}}\nlet t = 0\nfor m in acc {{ t = t + m.n }}\nreturn t\n",
    )
    assert(!vm.raised && out.t == 2 && out.i == 15)
}

fn vm_case_18() {
    region limited {
        var vm = fresh()
        vm.step_limit = 200
        let _ = run(mut vm, "let n = 0\nwhile n < 100000 {{ n = n + 1 }}\nreturn n\n")
        assert(vm.raised && vm.steps > 200)
    }
    region collections {
        var vm = fresh()
        let out = run(
            mut vm,
            "let n = 0\nwhile n < 20000 {{ let s = [n, n, n]\nn = n + 1 }}\nreturn n\n",
        )
        assert(!vm.raised && out.t == 2 && out.i == 20000)
        assert(vm.gc.collections != 0 && vm.gc.bytes < 512 * 1024)
    }
}

fn vm_case_19() {
    var vm = fresh()
    let out = run(
        mut vm,
        "let n = 0\nwhile n < 200 {{\n  try {{ let x = 1 + (2 * (3 + (4 / 0))) }}\n  catch e {{ }}\n  n = n + 1\n}}\nreturn n\n",
    )
    assert(!vm.raised && out.t == 2 && out.i == 200 && vm.sp <= 1)
}

fn vm_case_20() {
    var vm = fresh()
    var source = List[byte]()
    for _ in 0..64 { util.buf_append_str(mut source, "try {{\n") }
    util.buf_append_str(mut source, "  return 7\n")
    for i in 0..64 { util.buf_append_str(mut source, "}} catch e{i} {{ return {100 + i} }}\n") }
    let text = str_from_utf8(source) else ""
    assert(text.len < 8192)
    let out = run(mut vm, text)
    assert(!vm.raised && out.t == 2 && out.i == 7)
}

fn vm_case_22() {
    region imported {
        var vm = fresh()
        let out = run(mut vm, "import io\nreturn 0\n")
        assert(!vm.raised && out.t == 2 && out.i == 0)
    }
    region binding {
        var vm = fresh()
        let out = run(mut vm, "bind(\"<C-p>\", 1)\n")
        assert(vm.raised)
        let msg = field(mut vm, out, "msg")
        assert(msg.t == 4)
        let text = str_from_utf8(vm.gc.slots[fl.fl_obj_index(vm, msg)].bytes) else ""
        assert(text.contains("expects"))
    }
    assert(fl.fl_deferred_msg("set") == "undefined name 'set'")
    assert(fl.fl_deferred_msg("nope") == "undefined name 'nope'")
}

fn vm_case_23() {
    assert(fl.fl_type_name(12) == "buf" && fl.fl_type_name(13) == "cursor")
    assert(fl.fl_type_name(14) == "span" && fl.fl_type_name(15) == "win")
    assert(fl.fl_type_name(16) == "regex" && fl.fl_type_name(17) == "?")
    assert(fl.FL_TYPE_COUNT <= 32)
}

fn vm_case_25() {
    run_int(spec_prefix() + "let next = counter(clamp(9, 0, 8))\nreturn next()\n", 9)
    run_int(
        spec_prefix() + "let next = counter(clamp(9, 0, 8))\nlet a = next()\nreturn next()\n",
        10,
    )
}

fn vm_case_26() {
    region total {
        var vm = fresh()
        let out = run(mut vm, spec_program())
        assert(!vm.raised && out.t == 2 && out.i == 17 && vm.dc.entries.len == 0)
    }
    region shouting {
        var vm = fresh()
        let text = spec_program()
        let end = text.find("return total") else 0
        let out = run(mut vm, text[0..end] + "return shout(\"x\")\n")
        assert(!vm.raised && text_eq(vm, out, "MOTION"))
    }
}

fn vm_case_28() {
    var a = fresh()
    var b = fresh()
    let source = "fn f(x) {{ return x + 1 }}\nlet m = {{a: 1, b: \"two\"}}\nlet l = [1, 2.5, nil]\nfor k, v in m {{ }}\n"
    let fa = compile(mut a, source)
    let fb = compile(mut b, source)
    var da = List[byte]()
    var db = List[byte]()
    fl.fl_disasm_chunk(a, fa, mut da)
    fl.fl_disasm_chunk(b, fb, mut db)
    assert(da.len != 0 && da.len == db.len)
    for i in 0..da.len { assert(da[i] == db[i]) }
}

fn vm_case_29() {
    for k in 0..60 {
        assert(fl.fl_op_name(k) != "BAD_OP")
        for b in fl.fl_op_operands(k).bytes() {
            assert(b == 98 as byte || b == 115 as byte || b == 119 as byte)
        }
    }
    assert(fl.FL_OP_COUNT == 60)
}
