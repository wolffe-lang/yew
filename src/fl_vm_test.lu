//! member: false
//! sagitta 9ace98c2 tests/unit/test_fl_vm.c:149-1011, thirty pinned cases.
//! Moving references are re-read through roots after each explicit collection.

use fl
use util

fn fresh() -> fl.FlVm {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    fl.fl_std_register(mut vm)
    vm
}

fn compile(mut vm: fl.FlVm, text: str) -> fl.FlValue {
    var src = List[byte]()
    for b in text.bytes() { (mut src).push(b) }
    let id = fl.fl_diag_add_file(mut vm.dc, "t.fl", src)
    let p = fl.fl_parse(src, id, mut vm.dc, mut vm.strings)
    assert(!p.had_error)
    let f = fl.fl_compile(mut vm, p, id, fl.fl_origin_new(4, 0)) else fl.fl_nil()
    if f.t != 7 { for d in vm.dc.entries { eprint(d.msg) } }
    assert(f.t == 7)
    f
}

fn run(mut vm: fl.FlVm, text: str) -> fl.FlValue {
    let f = compile(mut vm, text)
    fl.fl_vm_run(mut vm, f)
}

fn run_int(text: str, expected: int) {
    region trial {
        var vm = fresh()
        let value = run(mut vm, text)
        if vm.raised { eprint("unexpected raise: {text}") }
        assert(!vm.raised && value.t == 2 && value.i == expected)
    }
}

fn field(mut vm: fl.FlVm, value: fl.FlValue, name: str) -> fl.FlValue {
    let key = fl.fl_str_text(mut vm, name)
    fl.fl_map_get(vm, value, key) else fl.fl_nil()
}

fn text_eq(vm: fl.FlVm, value: fl.FlValue, text: str) -> bool {
    if value.t != 4 { return false }
    let at = fl.fl_obj_index(vm, value)
    if vm.gc.slots[at].bytes.len != text.len { return false }
    for i in 0..text.len { if vm.gc.slots[at].bytes[i] != text.bytes()[i] { return false } }
    true
}

fn assert_kind(text: str, expected: str) {
    region trial {
        var vm = fresh()
        let value = run(mut vm, text)
        assert(vm.raised && value.t == 6)
        let kind = field(mut vm, value, "kind")
        assert(text_eq(vm, kind, expected))
    }
}

fn fl_vm_arithmetic_and_precedence() {
    run_int("return 1 + 2 * 3\n", 7)
    run_int("return (1 + 2) * 3\n", 9)
    run_int("return 1 - 2 - 3\n", -4)
    run_int("return 7 / 2\n", 3)
    run_int("return -7 / 2\n", -3)
    run_int("return -7 % 2\n", -1)
    run_int("return 7 % -2\n", 1)
    run_int("import math\nreturn math.int_max + 1\n", -9223372036854775807 - 1)
    run_int("import math\nreturn math.int_min - 1\n", 9223372036854775807)
    run_int("import math\nreturn math.int_max * 2\n", -2)
    run_int("import math\nreturn math.int_min * -1\n", -9223372036854775807 - 1)
    run_int("import math\nreturn -math.int_min\n", -9223372036854775807 - 1)
    run_int("import math\nreturn math.int_min / -1\n", -9223372036854775807 - 1)
    run_int("import math\nreturn math.int_min % -1\n", 0)
    print("PASS fl_vm arithmetic_and_precedence")
}

fn fl_vm_truthiness_is_nil_and_false_only() {
    run_int("if 0 {{ return 1 }}\nreturn 2\n", 1)
    run_int("if \"\" {{ return 1 }}\nreturn 2\n", 1)
    run_int("if nil {{ return 1 }}\nreturn 2\n", 2)
    run_int("if false {{ return 1 }}\nreturn 2\n", 2)
    run_int("if not nil {{ return 1 }}\nreturn 2\n", 1)
    print("PASS fl_vm truthiness_is_nil_and_false_only")
}

fn fl_vm_equality_crosses_the_numeric_tower() {
    run_int("if 1 == 1.0 {{ return 1 }}\nreturn 0\n", 1)
    run_int("if 1 == \"1\" {{ return 1 }}\nreturn 0\n", 0)
    run_int("if \"a\" == \"a\" {{ return 1 }}\nreturn 0\n", 1)
    run_int(
        "let a = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\nlet b = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\nif a == b {{ return 1 }}\nreturn 0\n",
        1,
    )
    print("PASS fl_vm equality_crosses_the_numeric_tower")
}

fn fl_vm_short_circuit_yields_the_deciding_value() {
    run_int("return 0 or 9\n", 0)
    run_int("return nil or 9\n", 9)
    run_int("return 3 and 9\n", 9)
    run_int("if (nil and 9) == nil {{ return 1 }}\nreturn 0\n", 1)
    run_int("let x = nil and (1 / 0)\nreturn 1\n", 1)
    run_int("let x = 3 or (1 / 0)\nreturn 1\n", 1)
    print("PASS fl_vm short_circuit_yields_the_deciding_value")
}

fn fl_vm_error_kinds() {
    assert_kind("return 1 / 0\n", "div")
    assert_kind("return 1 % 0\n", "div")
    assert_kind("return 1 + \"a\"\n", "type")
    assert_kind("return nope\n", "name")
    assert_kind("return [1][5]\n", "index")
    assert_kind("let m = {{a: 1}}\nreturn m[\"zz\"]\n", "key")
    assert_kind("return @[2v]\n", "motion")
    assert_kind("import x\n", "import")
    assert_kind("fn f(a){{ return a }}\nreturn f()\n", "arity")
    assert_kind("return 1()\n", "type")
    print("PASS fl_vm error_kinds")
}

fn fl_vm_limit_is_catchable() {
    run_int("fn f(){{ return f() }}\ntry {{ return f() }} catch e {{ return 42 }}\n", 42)
    assert_kind("fn f(){{ return f() }}\nreturn f()\n", "limit")
    print("PASS fl_vm limit_is_catchable")
}

fn fl_vm_try_catch_binds_the_error_map() {
    run_int("try {{ return 1 / 0 }} catch e {{ return 7 }}\n", 7)
    run_int(
        "try {{ return 1 / 0 }}\ncatch e {{ if e.kind == \"div\" {{ return 1 }} return 0 }}\n",
        1,
    )
    run_int("try {{ return 5 }} catch e {{ return 9 }}\n", 5)
    print("PASS fl_vm try_catch_binds_the_error_map")
}

fn fl_vm_upvalues_capture_by_reference() {
    run_int(
        "fn counter(start) {{\n  let n = start\n  return fn() {{ n = n + 1; return n }}\n}}\nlet next = counter(8)\nlet a = next()\nlet b = next()\nreturn b\n",
        10,
    )
    run_int(
        "fn pair() {{\n  let n = 0\n  return [fn() {{ n = n + 1; return n }},\n          fn() {{ return n }}]\n}}\nlet p = pair()\nlet bump = p[0]\nlet peek = p[1]\nlet x = bump()\nlet y = bump()\nreturn peek()\n",
        2,
    )
    print("PASS fl_vm upvalues_capture_by_reference")
}

fn fl_vm_upvalues_capture_through_an_intermediate_function() {
    run_int(
        "fn o() {{\n  let n = 1\n  return fn() {{ return fn() {{ return n }} }}\n}}\nreturn o()()()\n",
        1,
    )
    run_int(
        "fn o() {{\n  let n = 1\n  return fn() {{ return fn() {{ n = n + 10\n return n }} }}\n}}\nlet d = o()()\nd()\nreturn d()\n",
        21,
    )
    run_int(
        "fn o() {{\n  let a = 1\n  return fn() {{\n    let b = 20\n    return fn() {{ return fn() {{ return a + b }} }}\n  }}\n}}\nreturn o()()()()\n",
        21,
    )
    print("PASS fl_vm upvalues_capture_through_an_intermediate_function")
}

fn fl_vm_error_is_the_prelude_raise() {
    run_int("import str\ntry {{ error(\"boom\") }}\ncatch e {{ return str.len(e.msg) }}\n", 4)
    run_int("try {{ error({{kind: \"user\", msg: \"m\", n: 7}}) }}\ncatch e {{ return e.n }}\n", 7)
    run_int("fn error(v) {{ return 5 }}\nreturn error(\"x\")\n", 5)
    vm_case_9()
    print("PASS fl_vm error_is_the_prelude_raise")
}

