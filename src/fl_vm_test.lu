fn fl_vm_control_flow() {
    run_int("let t = 0\nfor x in [1,2,3] {{ t = t + x }}\nreturn t\n", 6)
    run_int("let n = 0\nwhile n < 3 {{ n = n + 1 }}\nreturn n\n", 3)
    run_int("let t = 0\nfor x in [1,2,3,4] {{ if x == 3 {{ break }} t = t + x }}\nreturn t\n", 3)
    run_int("let t = 0\nfor x in [1,2,3] {{ if x == 2 {{ continue }} t = t + x }}\nreturn t\n", 4)
    run_int(
        "import list\nlet g = []\nfor c in \"a\\u{{1F44D}}\\u{{1F3FD}}b\" {{ list.push(g, c) }}\nreturn list.len(g)\n",
        3,
    )
    run_int(
        "import str\nlet n = 0\nfor c in \"a\\u{{1F44D}}\\u{{1F3FD}}b\" {{ n = n + str.len_bytes(c) }}\nreturn n\n",
        10,
    )
    run_int("let n = 0\nfor c in \"\" {{ n = n + 1 }}\nreturn n\n", 0)
    run_int("let m = {{a: 1, b: 2, c: 3}}\nlet t = 0\nfor k, v in m {{ t = t + v }}\nreturn t\n", 6)
    run_int("let t = 0\nfor i, v in [10, 20, 30] {{ t = t + i }}\nreturn t\n", 3)
    run_int("let t = 0\nfor i, v in [10, 20, 30] {{ t = t + v }}\nreturn t\n", 60)
    run_int("let t = 7\nfor i, v in [] {{ t = 0 }}\nreturn t\n", 7)
    vm_case_14()
    print("PASS fl_vm control_flow")
}

