//! member: false
//! Port-only callback regression for sagitta src/text/undo.c:389-397.
//! Exercise captured code, not just the identity clocks the C fixtures use.

use text

fn append(mut ec: text.EditCtx) {
    text.undo_begin(mut ec, text.TXN_PASTE)
    assert(text.edit_insert_str(mut ec, text.byteoff(text.textbuf_len(ec.tb)), "x"))
    text.undo_end(mut ec)
}

fn main() {
    let tb = text.textbuf_new()
    let undo = text.undo_new(tb)
    var ec = text.editctx_new(take tb)
    ec.undo = undo
    ec.has_undo = true
    // Isolate callback values from the independently tested monotone clamp.
    ec.undo.nodes[ec.undo.root - 1].t_wall = 0
    let offset = 17
    text.undo_set_clock(mut ec.undo, fn(
        c: text.UndoClock,
    ) c.mono + offset, fn(c: text.UndoClock) c.wall * 2, text.UndoClock { mono: 100, wall: 50 })
    append(mut ec)
    var id = text.undo_current(ec.undo)
    assert(ec.undo.nodes[id - 1].t_last_ms == 117, "captured monotonic callback")
    assert(ec.undo.nodes[id - 1].t_wall == 100, "independent wall callback")
    ec.undo.clock.mono = 200
    ec.undo.clock.wall = 60
    append(mut ec)
    id = text.undo_current(ec.undo)
    assert(ec.undo.nodes[id - 1].t_last_ms == 217, "updated owned context")
    assert(ec.undo.nodes[id - 1].t_wall == 120, "updated wall context")
    print("undo_clock: captured callbacks and mutable owned context: PASS")
}
