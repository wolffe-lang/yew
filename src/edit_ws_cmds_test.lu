//! member: false
//! Ports sagitta tests/unit/test_ws_cmds.c:131-498 at9ace98c2, sixteen
//! registry-order cases; commands use the real registry and invocation path.

use edit
use term
use text
use util
use ws

struct Fix { root: str, work: str, saved: str, had: bool }

fn fixture() -> Fix {
    let saved = env_get("XDG_STATE_HOME") else ""
    let had = saved.len != 0
    assert(util.mkdirs("target/ws-cmd-fixtures", 448))
    var root = ""
    loop {
        var suffix = ""
        for r in os_random(8) { suffix = "{suffix}{r % 10}" }
        root = "target/ws-cmd-fixtures/{suffix}"
        fs_create_dir_mode(root, 448) else |e| match e {
            exists => { continue },
            _ => { assert(false, "mkdir fixture: {e}") },
        }
        break
    }
    root = fs_realpath(root) else {
        assert(false)
        return Fix { root: "", work: "", saved: "", had: false }
    }
    let work = "{root}/work"
    assert(util.mkdirs(work, 448))
    env_set("XDG_STATE_HOME", "{root}/state") else { assert(false) }
    Fix { root: root, work: work, saved: saved, had: had }
}

fn remove_tree(path: str) {
    let entries = fs_read_dir(path) else { return }
    for name in entries {
        let p = "{path}/{name}"
        fs_remove(p) else |_| {
            remove_tree(p)
            fs_remove_dir(p) else { assert(false, "remove dir {p}") }
        }
    }
}

fn finish(f: Fix) {
    if f.had {
        env_set("XDG_STATE_HOME", f.saved) else { assert(false) }
    } else {
        env_unset("XDG_STATE_HOME") else { assert(false) }
    }
    remove_tree(f.root)
    fs_remove_dir(f.root) else { assert(false) }
}

fn fresh(f: Fix) -> edit.Ed {
    var ed = edit.ed_new()
    ed.ws_dir = f.work
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(24, 80)
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    ed
}

fn file(f: Fix, name: str, body: str) -> str {
    let path = "{f.work}/{name}"
    assert(text.file_write_atomic(path, body.bytes(), 384) == text.SAVE_OK)
    path
}

fn exists(path: str) -> bool { let _ = fs_stat(path) else { return false }; true }

fn run(mut ed: edit.Ed, name: str) -> int {
    let id = edit.cmd_lookup(ed.reg, name)
    assert(id != 0)
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    edit.cmd_invoke(mut ed, id, mut cx)
}

fn t_are_registered() {
    var ed = edit.ed_new()
    for n in "save_state restore_state info forget migrate".words() {
        assert(edit.cmd_lookup(ed.reg, "ed.ws.{n}") != 0)
    }
}

fn t_migrate_reports_no_newer_schema() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    assert(
        run(mut ed, "ed.ws.migrate") == edit.CMD_ERR_STATE &&
            ed.msg.text.contains("schema v1 is current"),
    )
}

fn t_save_state_writes_immediately() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    defer edit.state_dispose(mut ed)
    assert(ed.state.writer && !exists(ws.ws_state_path(ed.state.key)))
    assert(
        run(mut ed, "ed.ws.save_state") == edit.CMD_OK &&
            ed.state.writes == 1 &&
            exists(ws.ws_state_path(ed.state.key)),
    )
}

fn t_save_state_refuses_when_stateless() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    assert(run(mut ed, "ed.ws.save_state") == edit.CMD_ERR_STATE && ed.msg.active)
}

fn t_save_state_refuses_for_a_reader() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    defer edit.state_dispose(mut ed)
    ed.state.writer = false
    ed.state.owner_pid = 1
    assert(
        run(mut ed, "ed.ws.save_state") == edit.CMD_ERR_STATE &&
            !exists(ws.ws_state_path(ed.state.key)),
    )
}

fn t_restore_state_is_additive() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    let a = file(f, "a.txt", "alpha\n"), b = file(f, "b.txt", "bravo\n")
    edit.state_open(mut ed)
    defer edit.state_dispose(mut ed)
    assert(edit.tab_open(mut ed, a) >= 0 && run(mut ed, "ed.ws.save_state") == edit.CMD_OK)
    assert(edit.tab_open(mut ed, b) >= 0 && ed.tabs.len == 3)
    assert(
        run(mut ed, "ed.ws.restore_state") == edit.CMD_OK &&
            ed.tabs.len == 3 &&
            edit.tab_find_by_path(ed, a) >= 0 &&
            edit.tab_find_by_path(ed, b) >= 0,
    )
}

fn t_restore_state_with_no_document_is_ok() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    defer edit.state_dispose(mut ed)
    assert(run(mut ed, "ed.ws.restore_state") == edit.CMD_OK && ed.tabs.len == 1)
}

fn t_info_reports_the_key_and_the_owner() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    defer edit.state_dispose(mut ed)
    assert(run(mut ed, "ed.ws.info") == edit.CMD_OK)
    assert(
        ed.msg.text.contains(text.hex16(ed.state.key.hash)) &&
            ed.msg.text.contains(f.work) &&
            ed.msg.text.contains("this session"),
    )
}

fn t_info_names_a_foreign_owner() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    defer edit.state_dispose(mut ed)
    ed.state.writer = false
    ed.state.owner_pid = 4242
    assert(run(mut ed, "ed.ws.info") == edit.CMD_OK && ed.msg.text.contains("pid 4242"))
}

fn t_info_says_stateless() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    assert(run(mut ed, "ed.ws.info") == edit.CMD_OK && ed.msg.text.contains("stateless"))
}

fn t_forget_asks_before_deleting() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    defer edit.state_dispose(mut ed)
    assert(edit.state_save(mut ed))
    let dir = ed.state.key.dir
    assert(
        run(mut ed, "ed.ws.forget") == edit.CMD_OK &&
            ed.ws_prompt_active &&
            ed.prompt == edit.PROMPT_WS_FORGET &&
            exists(dir) &&
            ed.msg.text.contains(dir),
    )
}

fn t_forget_removes_the_tree_on_yes() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    assert(edit.state_save(mut ed))
    let dir = ed.state.key.dir
    assert(util.mkdirs("{dir}history", 448))
    assert(text.file_write_atomic("{dir}history/cmd", "w something\n".bytes(), 384) == text.SAVE_OK)
    assert(run(mut ed, "ed.ws.forget") == edit.CMD_OK && edit.ws_prompt_key(mut ed, 121))
    assert(!exists(dir) && !ed.ws_prompt_active && ed.prompt == edit.PROMPT_NONE && !ed.state.ready)
}

fn t_forget_cancels_on_anything_but_y() {
    for answer in [27, 110, 89, 100, 0] {
        let f = fixture()
        defer finish(f)
        var ed = fresh(f)
        edit.state_open(mut ed)
        defer edit.state_dispose(mut ed)
        assert(edit.state_save(mut ed))
        let dir = ed.state.key.dir
        assert(run(mut ed, "ed.ws.forget") == edit.CMD_OK && edit.ws_prompt_key(mut ed, answer))
        assert(exists(dir) && !ed.ws_prompt_active && ed.state.ready)
    }
}

fn t_forget_key_is_not_swallowed_when_idle() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    assert(!edit.ws_prompt_key(mut ed, 121))
}

fn t_forget_dir_refuses_a_path_outside_workspaces() {
    let f = fixture()
    defer finish(f)
    let precious = file(f, "precious", "do not delete\n")
    assert(!edit.ws_forget_dir(f.work) && exists(precious))
    assert(!edit.ws_forget_dir("workspaces/relative") && !edit.ws_forget_dir(""))
}

fn t_forget_does_not_follow_symlinks() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    assert(edit.state_save(mut ed))
    let dir = ed.state.key.dir
    let precious = file(f, "precious", "do not delete\n")
    fs_symlink(f.work, "{dir}trap") else { assert(false) }
    assert(run(mut ed, "ed.ws.forget") == edit.CMD_OK && edit.ws_prompt_key(mut ed, 121))
    assert(!exists(dir) && exists(precious))
}

fn main() {
    let chosen = (env_get("YEW_STATE_CASE") else "-1").to_int() else -1
    if chosen < 0 || chosen == 0 { t_are_registered(); print("ws_cmds_are_registered: PASS") }
    if chosen < 0 || chosen == 1 {
        t_migrate_reports_no_newer_schema()
        print("ws_cmds_migrate_reports_no_newer_schema: PASS")
    }
    if chosen < 0 || chosen == 2 {
        t_save_state_writes_immediately()
        print("ws_cmds_save_state_writes_immediately: PASS")
    }
    if chosen < 0 || chosen == 3 {
        t_save_state_refuses_when_stateless()
        print("ws_cmds_save_state_refuses_when_stateless: PASS")
    }
    if chosen < 0 || chosen == 4 {
        t_save_state_refuses_for_a_reader()
        print("ws_cmds_save_state_refuses_for_a_reader: PASS")
    }
    if chosen < 0 || chosen == 5 {
        t_restore_state_is_additive()
        print("ws_cmds_restore_state_is_additive: PASS")
    }
    if chosen < 0 || chosen == 6 {
        t_restore_state_with_no_document_is_ok()
        print("ws_cmds_restore_state_with_no_document_is_ok: PASS")
    }
    if chosen < 0 || chosen == 7 {
        t_info_reports_the_key_and_the_owner()
        print("ws_cmds_info_reports_the_key_and_the_owner: PASS")
    }
    if chosen < 0 || chosen == 8 {
        t_info_names_a_foreign_owner()
        print("ws_cmds_info_names_a_foreign_owner: PASS")
    }
    if chosen < 0 || chosen == 9 {
        t_info_says_stateless()
        print("ws_cmds_info_says_stateless: PASS")
    }
    if chosen < 0 || chosen == 10 {
        t_forget_asks_before_deleting()
        print("ws_cmds_forget_asks_before_deleting: PASS")
    }
    if chosen < 0 || chosen == 11 {
        t_forget_removes_the_tree_on_yes()
        print("ws_cmds_forget_removes_the_tree_on_yes: PASS")
    }
    if chosen < 0 || chosen == 12 {
        t_forget_cancels_on_anything_but_y()
        print("ws_cmds_forget_cancels_on_anything_but_y: PASS")
    }
    if chosen < 0 || chosen == 13 {
        t_forget_key_is_not_swallowed_when_idle()
        print("ws_cmds_forget_key_is_not_swallowed_when_idle: PASS")
    }
    if chosen < 0 || chosen == 14 {
        t_forget_dir_refuses_a_path_outside_workspaces()
        print("ws_cmds_forget_dir_refuses_a_path_outside_workspaces: PASS")
    }
    if chosen < 0 || chosen == 15 {
        t_forget_does_not_follow_symlinks()
        print("ws_cmds_forget_does_not_follow_symlinks: PASS")
    }
}
