//! member: false
//!
//! The port of sagitta `tests/unit/test_re_match.c` (679 lines), one test
//! per C test in registry order (`tests/unit/registry.c:1580-1591`): the
//! golden match table over flat bytes and over a piece tree, the pinned
//! leftmost-first rule, the empty-width loop, anchoring, the long literal
//! past the program cap with its REP2 packing, the decoder-boundary rule
//! for whole literals, REP2's metadata validation, the reused workspace,
//! search from offsets and backwards, group counts and minimum lengths.
//!
//! The golden table is DATA (`tests/fixtures/search/re_golden.txt`,
//! sagitta's `re_golden.h` row for row, `tools/check-re-golden`), so
//! yw07's `re` module replays the same rows (s20 §Testing, s31 DoD 9).

use search
use std.fs
use text

struct Tally {
    n: int,
}

fn ok(mut t: Tally, cond: bool, what: str) {
    t.n += 1
    assert(cond, what)
}

fn pb(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn hexv(c: int) -> int {
    if c >= 48 && c <= 57 then c - 48 else (if c >= 97 && c <= 102 then c - 87 else c - 55)
}

fn unhex(h: str) -> List[byte] {
    var v = List[byte]()
    if h == "-" {
        return v
    }
    let b = h.bytes()
    var i = 0
    while i + 1 < b.len {
        (mut v).push((hexv(b[i] as int) * 16 + hexv(b[i + 1] as int)) as byte)
        i += 2
    }
    v
}

fn compile(pat: List[byte], flags: int) -> search.Re {
    var err = search.re_err_new()
    let re = search.re_compile(pat, flags, mut err) else {
        assert(false, "compile failed: {err.msg}")
        return search.re_empty()
    }
    re
}

fn compile_s(pat: str, flags: int) -> search.Re {
    compile(pb(pat), flags)
}

fn at(n: int) -> text.ByteOff {
    n as text.ByteOff
}

// A buffer built by reverse prepends of `take`-byte chunks: append
// coalescing cannot merge them, so the piece seams are real (YEW-F-087).
fn tb_prepended(bytes: List[byte], step: int) -> text.TextBuf {
    var tb = text.textbuf_new()
    var a = bytes.len
    while a != 0 {
        let n = if a < step then a else step
        a -= n
        text.textbuf_insert_part(mut tb, at(0), bytes, a, a + n)
    }
    tb
}

// `check_row` (`test_re_match.c:41-103`).
fn check_row(mut t: Tally, fields: List[str], use_textbuf: bool) {
    let pat = unhex(fields[0])
    let input = unhex(fields[1])
    let flags = fields[2].to_int() else 0
    let want = (fields[3].to_int() else 0) == 1
    let lo = fields[4].to_int() else 0
    let hi = fields[5].to_int() else 0
    let g1lo = fields[6].to_int() else -1
    let g1hi = fields[7].to_int() else -1
    let g2lo = fields[8].to_int() else -1
    let g2hi = fields[9].to_int() else -1
    let re = compile(pat, flags)
    var m = search.re_match_new()
    var got = false
    let empty = List[byte]()
    if use_textbuf {
        let tb = text.textbuf_from_bytes(input, 0, input.len)
        got = search.re_search(re, tb, empty, search.re_input_textbuf(tb), at(0), mut m)
    } else {
        let tb0 = text.textbuf_new()
        got = search.re_search(re, tb0, input, search.re_input_bytes(input.len), at(0), mut m)
    }
    let tag = if use_textbuf then " [textbuf]" else ""
    ok(mut t, got == want, "/{fields[0]}/ on {fields[1]}{tag}: expected {want}, got {got}")
    if !want {
        return
    }
    ok(
        mut t,
        m.lo[0] == lo && m.hi[0] == hi,
        "/{fields[0]}/ on {fields[1]}{tag}: span {m.lo[0]}..{m.hi[0]}, want {lo}..{hi}",
    )
    if g1lo != -1 {
        ok(
            mut t,
            m.lo[1] == g1lo && m.hi[1] == g1hi,
            "/{fields[0]}/: g1 {m.lo[1]}..{m.hi[1]}, want {g1lo}..{g1hi}",
        )
    }
    if g2lo != -1 {
        ok(
            mut t,
            m.lo[2] == g2lo && m.hi[2] == g2hi,
            "/{fields[0]}/: g2 {m.lo[2]}..{m.hi[2]}, want {g2lo}..{g2hi}",
        )
    }
}

fn golden_rows() -> List[List[str]] {
    let text_ = fs.read_text("tests/fixtures/search/re_golden.txt") else ""
    assert(text_.len > 0, "re_golden.txt is readable from the repository root")
    var rows = List[List[str]]()
    for line in text_.lines() {
        if line.starts_with("#") || line.trim().len == 0 {
            continue
        }
        let f = line.words()
        assert(f.len == 10, "a golden row has ten fields")
        (mut rows).push(f)
    }
    rows
}

fn t_re_golden_table_bytes(mut t: Tally) {
    let rows = golden_rows()
    // YEW-F-094: Sprint 20's 150-row floor.
    ok(mut t, rows.len >= 150, "the golden table has {rows.len} rows")
    for r in rows {
        check_row(mut t, r, false)
    }
}

fn t_re_golden_table_textbuf(mut t: Tally) {
    // The same rows through the piece tree.
    for r in golden_rows() {
        check_row(mut t, r, true)
    }
}

fn t_re_leftmost_first_is_pinned(mut t: Tally) {
    let tb0 = text.textbuf_new()
    let input = pb("ab")
    let inp = search.re_input_bytes(2)
    var m = search.re_match_new()
    // Leftmost-FIRST: the earlier branch wins ties (POSIX would say 0..2).
    let re = compile_s("a|ab", 0)
    ok(mut t, search.re_search(re, tb0, input, inp, at(0), mut m), "a|ab matches")
    ok(mut t, m.hi[0] == 1, "a|ab ends at 1 ({m.hi[0]})")
    let re2 = compile_s("ab|a", 0)
    ok(mut t, search.re_search(re2, tb0, input, inp, at(0), mut m), "ab|a matches")
    ok(mut t, m.hi[0] == 2, "ab|a ends at 2 ({m.hi[0]})")
}

fn t_re_empty_width_loop_terminates(mut t: Tally) {
    // DoD 9: `(a*)*` chains SPLIT/JMP without consuming input; this
    // completes only because addthread's membership check lives INSIDE
    // its loop (moving it out makes this hang).
    let tb0 = text.textbuf_new()
    let input = pb("aaaa")
    let inp = search.re_input_bytes(4)
    var m = search.re_match_new()
    let re = compile_s("(a*)*", 0)
    ok(mut t, search.re_search(re, tb0, input, inp, at(0), mut m), "(a*)* matches")
    ok(mut t, m.lo[0] == 0 && m.hi[0] == 4, "(a*)* spans 0..4 ({m.lo[0]}..{m.hi[0]})")
    let re2 = compile_s("(|a)*", 0)
    ok(mut t, search.re_search(re2, tb0, input, inp, at(0), mut m), "(|a)* matches")
    let re3 = compile_s("(a?)*b", 0)
    ok(mut t, !search.re_search(re3, tb0, input, inp, at(0), mut m), "(a?)*b does not")
}

fn t_re_empty_width_deep_subject(mut t: Tally) {
    // Sprint 58 F06 Q2: the empty-width closure through TextIter over a
    // 100,000-byte subject.
    var subject = List[byte]()
    var i = 0
    while i < 100000 {
        (mut subject).push(97 as byte)
        i += 1
    }
    let tb = text.textbuf_from_bytes(subject, 0, subject.len)
    let re = compile_s("(a*)*", 0)
    var m = search.re_match_new()
    let empty = List[byte]()
    ok(
        mut t,
        search.re_search(re, tb, empty, search.re_input_textbuf(tb), at(0), mut m),
        "(a*)* over 100,000 a's",
    )
    ok(
        mut t,
        m.lo[0] == 0 && m.hi[0] == 100000,
        "the deep span is 0..100000 ({m.lo[0]}..{m.hi[0]})",
    )
}

fn t_re_match_at_is_anchored(mut t: Tally) {
    let tb0 = text.textbuf_new()
    let input = pb("xxabc")
    let inp = search.re_input_bytes(5)
    var m = search.re_match_new()
    let re = compile_s("abc", 0)
    // search finds it; match_at only succeeds at the exact offset.
    ok(mut t, search.re_search(re, tb0, input, inp, at(0), mut m), "abc found")
    ok(mut t, m.lo[0] == 2, "abc at 2")
    ok(mut t, !search.re_match_at(re, tb0, input, inp, at(0), mut m), "not anchored at 0")
    ok(mut t, !search.re_match_at(re, tb0, input, inp, at(1), mut m), "not anchored at 1")
    ok(mut t, search.re_match_at(re, tb0, input, inp, at(2), mut m), "anchored at 2")
    ok(mut t, m.hi[0] == 5, "ends at 5")
}

fn put32(mut b: List[byte], a: int, v: int) {
    b[a] = (v & 255) as byte
    b[a + 1] = (v >> 8 & 255) as byte
    b[a + 2] = (v >> 16 & 255) as byte
    b[a + 3] = (v >> 24 & 255) as byte
}

fn unpacks(packed: List[byte], n: int) -> bool {
    let _r = search.re_unpack(packed, 0, n) else {
        return false
    }
    true
}

fn t_re_long_literal_bypasses_vm_limit(mut t: Tally) {
    let lit_len = 4240
    var literal = List[byte]()
    var i = 0
    while i < lit_len {
        (mut literal).push((97 + i * 17 % 26) as byte)
        i += 1
    }
    literal[0] = 81 as byte
    literal[17] = 42 as byte
    literal[100] = 10 as byte
    literal[101] = 0 as byte
    literal[102] = 128 as byte
    literal[103] = 255 as byte
    literal[104] = 92 as byte
    literal[105] = 95 as byte
    var subject = pb("xx ")
    for b in literal {
        (mut subject).push(b)
    }
    for b in " yy".bytes() {
        (mut subject).push(b)
    }
    var pattern = List[byte]()
    search.re_quote(mut pattern, literal, 0, literal.len)
    let re = compile(pattern, 0)
    ok(mut t, search.re_whole_literal_bytes(re) == lit_len, "the whole literal is {lit_len} bytes")
    ok(mut t, search.re_min_len(re) == lit_len, "min_len is the literal's")
    ok(mut t, search.re_has_upper_literal(re), "the Q is an uppercase literal")
    let tb0 = text.textbuf_new()
    let inp = search.re_input_bytes(subject.len)
    var m = search.re_match_new()
    ok(mut t, search.re_search(re, tb0, subject, inp, at(0), mut m), "found in bytes")
    ok(mut t, m.lo[0] == 3 && m.hi[0] == 3 + lit_len, "the span is 3..{3 + lit_len}")
    ok(mut t, search.re_pike_run(re, tb0, subject, inp, 3, mut m), "the anchored VM")
    ok(mut t, m.hi[0] == 3 + lit_len, "the anchored VM's end")
    ok(mut t, search.re_pike_run_ex(re, tb0, subject, inp, 0, false, mut m), "the unanchored VM")
    ok(mut t, m.lo[0] == 3, "the unanchored VM's start")
    ok(mut t, search.re_dfa_test(re, tb0, subject, inp, 0) == search.DFA_YES, "the DFA says yes")
    let (v, end) = search.re_dfa_find_end(re, tb0, subject, inp, 0)
    ok(mut t, v == search.DFA_YES && end == 3 + lit_len, "the DFA's end ({v}, {end})")
    ok(mut t, search.re_match_at(re, tb0, subject, inp, at(3), mut m), "anchored at 3")
    ok(mut t, !search.re_match_at(re, tb0, subject, inp, at(2), mut m), "not anchored at 2")
    var ws = search.re_workspace_new()
    ok(
        mut t,
        search.re_match_at_ws(mut ws, re, tb0, subject, inp, at(3), mut m),
        "anchored on a workspace",
    )
    search.re_workspace_free(mut ws)
    ok(
        mut t,
        search.re_search_back(re, tb0, subject, inp, at(subject.len), mut m),
        "found backwards",
    )
    ok(mut t, m.lo[0] == 3, "backwards at 3")
    ok(mut t, !search.re_search(re, tb0, subject, inp, at(4), mut m), "none after its start")

    // Across hundreds of piece seams: the long path streams KMP state.
    let tb = tb_prepended(subject, 13)
    ok(mut t, text.textbuf_piece_count(tb) >= 100, "{text.textbuf_piece_count(tb)} pieces")
    let empty = List[byte]()
    let tinp = search.re_input_textbuf(tb)
    ok(mut t, search.re_search(re, tb, empty, tinp, at(0), mut m), "found in the piece tree")
    ok(mut t, m.lo[0] == 3, "at 3 in the piece tree")
    ok(mut t, search.re_match_at(re, tb, empty, tinp, at(3), mut m), "anchored in the piece tree")
    ok(
        mut t,
        search.re_search_back(re, tb, empty, tinp, at(subject.len), mut m),
        "backwards in the piece tree",
    )
    ok(mut t, m.lo[0] == 3, "backwards at 3 in the piece tree")

    // Long whole literals are cacheable: REP2.
    var packed = List[byte]()
    ok(mut t, search.re_pack(re, mut packed), "packs")
    ok(mut t, packed.len > lit_len, "the packed form holds the literal")
    let magic = "YEWREP2"
    var same = true
    i = 0
    while i < 7 {
        if packed[i] != magic.bytes()[i] {
            same = false
        }
        i += 1
    }
    ok(mut t, same, "REP2")
    ok(mut t, !unpacks(packed, packed.len - 1), "a truncated REP2 is refused")
    let (restored, used) = search.re_unpack(packed, 0, packed.len) else {
        ok(mut t, false, "REP2 unpacks")
        return
    }
    ok(mut t, used == packed.len, "the whole REP2 is used ({used})")
    ok(
        mut t,
        search.re_search(restored, tb0, subject, inp, at(0), mut m),
        "the restored pattern finds it",
    )
    ok(mut t, m.lo[0] == 3, "the restored span")

    let literal_re = compile(literal, search.RE_LITERAL)
    ok(
        mut t,
        search.re_search(literal_re, tb0, subject, inp, at(0), mut m),
        "the RE_LITERAL form finds it",
    )
    ok(mut t, m.lo[0] == 3, "the RE_LITERAL span")

    var bent = copy subject
    let mid = 3 + lit_len / 2
    bent[mid] = (bent[mid] as int ^ 1) as byte
    ok(
        mut t,
        !search.re_search(re, tb0, bent, search.re_input_bytes(bent.len), at(0), mut m),
        "one bent byte misses",
    )

    // Quoting expands controls fourfold: the 64 KiB literal limit still
    // round-trips though its spelling is 256 KiB.
    var limit_literal = List[byte]()
    i = 0
    while i < search.RE_MAX_PATTERN {
        (mut limit_literal).push(10 as byte)
        i += 1
    }
    var qpat = List[byte]()
    search.re_quote(mut qpat, limit_literal, 0, limit_literal.len)
    ok(mut t, qpat.len == search.RE_MAX_PATTERN * 4, "the quoted limit is 256 KiB")
    let limit_re = compile(qpat, 0)
    ok(
        mut t,
        search.re_whole_literal_bytes(limit_re) == search.RE_MAX_PATTERN,
        "the limit literal is 64 KiB",
    )
    ok(
        mut t,
        search.re_search(
            limit_re,
            tb0,
            limit_literal,
            search.re_input_bytes(limit_literal.len),
            at(0),
            mut m,
        ),
        "the limit literal matches itself",
    )
    ok(mut t, m.hi[0] == search.RE_MAX_PATTERN, "to its end")
}

fn t_re_whole_literals_follow_utf8_decoder_boundaries(mut t: Tally) {
    let tb0 = text.textbuf_new()
    var m = search.re_match_new()
    var pattern = List[byte]()
    let valid_cent = unhex("c2a2")
    let malformed = unhex("e08078")
    let raw_c2 = unhex("c2")
    let raw_cont = unhex("80")
    search.re_quote(mut pattern, raw_c2, 0, 1)
    let short_lead = compile(pattern, 0)
    let vin = search.re_input_bytes(2)
    ok(
        mut t,
        !search.re_search(short_lead, tb0, valid_cent, vin, at(0), mut m),
        "C2 is not inside C2 A2",
    )
    ok(mut t, !search.re_match_at(short_lead, tb0, valid_cent, vin, at(0), mut m), "nor anchored")
    ok(mut t, !search.re_pike_run(short_lead, tb0, valid_cent, vin, 0, mut m), "nor in the VM")
    ok(
        mut t,
        search.re_dfa_test(short_lead, tb0, valid_cent, vin, 0) == search.DFA_NO,
        "nor in the DFA",
    )
    ok(
        mut t,
        search.re_search(short_lead, tb0, raw_c2, search.re_input_bytes(1), at(0), mut m),
        "a lone C2 is itself",
    )
    ok(mut t, m.hi[0] == 1, "ending at 1")

    var p2 = List[byte]()
    search.re_quote(mut p2, raw_cont, 0, 1)
    let short_cont = compile(p2, 0)
    let minp = search.re_input_bytes(3)
    ok(
        mut t,
        search.re_search(short_cont, tb0, malformed, minp, at(0), mut m),
        "80 after E0 is its own escape",
    )
    ok(mut t, m.lo[0] == 1 && m.hi[0] == 2, "at 1..2 ({m.lo[0]}..{m.hi[0]})")
    ok(mut t, search.re_match_at(short_cont, tb0, malformed, minp, at(1), mut m), "anchored at 1")

    var long_literal = List[byte]()
    var i = 0
    while i < 4094 {
        (mut long_literal).push(97 as byte)
        i += 1
    }
    (mut long_literal).push(194 as byte)
    var long_subject = copy long_literal
    (mut long_subject).push(162 as byte)
    var p3 = List[byte]()
    search.re_quote(mut p3, long_literal, 0, long_literal.len)
    let long_lead = compile(p3, 0)
    let lsin = search.re_input_bytes(long_subject.len)
    ok(
        mut t,
        !search.re_search(long_lead, tb0, long_subject, lsin, at(0), mut m),
        "the long literal's C2 is inside C2 A2",
    )
    ok(mut t, !search.re_match_at(long_lead, tb0, long_subject, lsin, at(0), mut m), "nor anchored")
    let tb = tb_prepended(long_subject, 13)
    let empty = List[byte]()
    ok(
        mut t,
        !search.re_search(long_lead, tb, empty, search.re_input_textbuf(tb), at(0), mut m),
        "nor across piece seams",
    )
    ok(
        mut t,
        search.re_search(
            long_lead,
            tb0,
            long_literal,
            search.re_input_bytes(long_literal.len),
            at(0),
            mut m,
        ),
        "the long literal matches itself",
    )
    ok(mut t, m.hi[0] == long_literal.len, "to its end")
}

fn t_re_rep2_rejects_impossible_direct_metadata(mut t: Tally) {
    let lit_len = search.RE_MAX_PROG - 2
    var literal = List[byte]()
    var i = 0
    while i < lit_len {
        (mut literal).push(97 as byte)
        i += 1
    }
    let re = compile(literal, search.RE_LITERAL)
    var packed = List[byte]()
    ok(mut t, search.re_pack(re, mut packed), "packs")
    ok(mut t, packed[6] as int == 50, "REP2")
    ok(mut t, unpacks(packed, packed.len), "the control unpacks")
    put32(mut packed, 24, search.RE_LITERAL | search.RE_ICASE)
    ok(mut t, !unpacks(packed, packed.len), "ICASE refused")
    put32(mut packed, 24, search.RE_LITERAL)
    put32(mut packed, 20, 2)
    ok(mut t, !unpacks(packed, packed.len), "two groups refused")
    put32(mut packed, 20, 1)
    put32(mut packed, 16, 1)
    ok(mut t, !unpacks(packed, packed.len), "a class refused")
    put32(mut packed, 16, 0)
    put32(mut packed, 36, 2)
    ok(mut t, !unpacks(packed, packed.len), "a forced icase refused")
    put32(mut packed, 36, 0)
    put32(mut packed, 48, 1)
    ok(mut t, !unpacks(packed, packed.len), "an anchored literal refused")
    put32(mut packed, 48, 0)
    put32(mut packed, 28, lit_len - 1)
    put32(mut packed, 32, lit_len - 1)
    ok(mut t, !unpacks(packed, packed.len), "a wrong cardinality refused")
    put32(mut packed, 28, lit_len)
    put32(mut packed, 32, lit_len)
    packed[96 + 16 + 12] = search.RE_MATCH as byte
    ok(mut t, !unpacks(packed, packed.len), "a live forward program refused")
    packed[96 + 16 + 12] = search.RE_SAVE as byte
    packed[96 + 3 * 16 + 12] = search.RE_MATCH as byte
    ok(mut t, !unpacks(packed, packed.len), "a live reverse program refused")
}

fn t_re_workspace_reuses_mixed_programs_and_captures(mut t: Tally) {
    let tb0 = text.textbuf_new()
    let input = pb("abacadabra")
    let inp = search.re_input_bytes(10)
    let binput = pb("ab outside")
    let binp = search.re_input_bytes(10)
    var ws = search.re_workspace_new()
    let short_re = compile_s("a|ab", 0)
    let wide_re = compile_s("(a)(b)?(a)(c)?(a)(d)?(a)(b)(r)(a)", 0)
    let boundary_re = compile_s("\\b(a|ab)\\b", 0)
    var m = search.re_match_new()
    var standard = search.re_match_new()
    // Alternate smaller and larger programs: capacity growth, capture
    // slot growth and stale stamps all exercised; leftmost-first pinned
    // under reuse.
    var i = 0
    while i < 1000 {
        ok(
            mut t,
            search.re_match_at_ws(mut ws, short_re, tb0, input, inp, at(0), mut m),
            "a|ab on the workspace",
        )
        ok(mut t, m.lo[0] == 0 && m.hi[0] == 1, "a|ab spans 0..1")
        ok(
            mut t,
            search.re_match_at_ws(mut ws, wide_re, tb0, input, inp, at(0), mut m),
            "the wide pattern",
        )
        ok(mut t, m.ngroups == 11, "eleven groups")
        ok(mut t, m.hi[0] == 10, "to 10")
        ok(mut t, m.lo[2] == 1 && m.hi[2] == 2, "g2 is 1..2")
        ok(mut t, m.lo[4] == 3 && m.hi[4] == 4, "g4 is 3..4")
        ok(
            mut t,
            !search.re_match_at_ws(mut ws, wide_re, tb0, input, inp, at(1), mut m),
            "not at 1",
        )
        ok(
            mut t,
            search.re_match_at(boundary_re, tb0, binput, binp, at(0), mut standard),
            "the standard run",
        )
        ok(
            mut t,
            search.re_match_at_ws(mut ws, boundary_re, tb0, binput, binp, at(0), mut m),
            "the workspace run",
        )
        ok(mut t, m.ngroups == standard.ngroups, "group counts agree")
        ok(mut t, m.lo[0] == standard.lo[0] && m.hi[0] == standard.hi[0], "g0 agrees")
        ok(mut t, m.lo[1] == standard.lo[1] && m.hi[1] == standard.hi[1], "g1 agrees")
        i += 1
    }
    search.re_workspace_free(mut ws)
    ok(mut t, !search.re_workspace_live(ws), "the freed workspace holds nothing")
    // Empty and repeated teardown are valid lifecycle edges.
    search.re_workspace_free(mut ws)
}

fn t_re_search_from_offset_and_back(mut t: Tally) {
    let tb0 = text.textbuf_new()
    var m = search.re_match_new()
    let input = pb("a b a b a")
    let inp = search.re_input_bytes(9)
    let re = compile_s("a", 0)
    ok(mut t, search.re_search(re, tb0, input, inp, at(0), mut m) && m.lo[0] == 0, "a from 0 is 0")
    ok(mut t, search.re_search(re, tb0, input, inp, at(1), mut m) && m.lo[0] == 4, "a from 1 is 4")
    ok(mut t, search.re_search(re, tb0, input, inp, at(5), mut m) && m.lo[0] == 8, "a from 5 is 8")
    ok(mut t, !search.re_search(re, tb0, input, inp, at(9), mut m), "none from 9")
    // Backward search: the last match strictly before the point.
    ok(
        mut t,
        search.re_search_back(re, tb0, input, inp, at(9), mut m) && m.lo[0] == 8,
        "back from 9 is 8",
    )
    ok(
        mut t,
        search.re_search_back(re, tb0, input, inp, at(8), mut m) && m.lo[0] == 4,
        "back from 8 is 4",
    )
    ok(
        mut t,
        search.re_search_back(re, tb0, input, inp, at(1), mut m) && m.lo[0] == 0,
        "back from 1 is 0",
    )
    ok(mut t, !search.re_search_back(re, tb0, input, inp, at(0), mut m), "none back from 0")

    let overlap_re = compile_s("aba", 0)
    let capture_re = compile_s("(a.)a", 0)
    let zero_re = compile_s("a*", 0)
    let osub = pb("ababa")
    let oinp = search.re_input_bytes(5)
    ok(mut t, search.re_search_back(overlap_re, tb0, osub, oinp, at(5), mut m), "aba backwards")
    ok(mut t, m.lo[0] == 2 && m.hi[0] == 5, "the overlapping aba is 2..5 ({m.lo[0]}..{m.hi[0]})")
    ok(mut t, search.re_search_back(capture_re, tb0, osub, oinp, at(5), mut m), "(a.)a backwards")
    ok(mut t, m.lo[0] == 2 && m.hi[0] == 5, "(a.)a is 2..5")
    ok(mut t, m.lo[1] == 2 && m.hi[1] == 4, "its group is 2..4")
    ok(mut t, search.re_search_back(zero_re, tb0, osub, oinp, at(3), mut m), "a* backwards")
    ok(mut t, m.lo[0] == 2 && m.hi[0] == 3, "a* back from 3 is 2..3 ({m.lo[0]}..{m.hi[0]})")

    // Fragment every byte so overlap enumeration crosses piece seams.
    let tb = tb_prepended(osub, 1)
    let empty = List[byte]()
    ok(
        mut t,
        search.re_search_back(capture_re, tb, empty, search.re_input_textbuf(tb), at(5), mut m),
        "(a.)a back in pieces",
    )
    ok(mut t, m.lo[0] == 2 && m.hi[0] == 5, "in pieces 2..5")

    // Advancing from a prior match start follows decoded codepoints.
    let cents = unhex("c2a2c2a2c2a2")
    var pattern = List[byte]()
    search.re_quote(mut pattern, cents, 0, 4)
    let unicode_re = compile(pattern, 0)
    ok(
        mut t,
        search.re_search_back(unicode_re, tb0, cents, search.re_input_bytes(6), at(6), mut m),
        "the cents backwards",
    )
    ok(mut t, m.lo[0] == 2 && m.hi[0] == 6, "the overlapping cents are 2..6 ({m.lo[0]}..{m.hi[0]})")
}

fn t_re_group_count_and_min_len(mut t: Tally) {
    let re = compile_s("a(b)(c)", 0)
    ok(mut t, search.re_group_count(re) == 3, "three groups, group 0 included")
    ok(mut t, search.re_min_len(re) == 3, "min_len 3")
    ok(mut t, search.re_min_len(compile_s("a*", 0)) == 0, "a* min_len 0")
    ok(mut t, search.re_min_len(compile_s("ab|c", 0)) == 1, "ab|c min_len 1")
    ok(mut t, search.re_min_len(compile_s("a{{3,5}}", 0)) == 3, "a{{3,5}} min_len 3")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    var t = Tally { n: 0 }
    t_re_golden_table_bytes(mut t)
    t_re_golden_table_textbuf(mut t)
    t_re_leftmost_first_is_pinned(mut t)
    t_re_empty_width_loop_terminates(mut t)
    t_re_empty_width_deep_subject(mut t)
    t_re_match_at_is_anchored(mut t)
    t_re_long_literal_bypasses_vm_limit(mut t)
    t_re_whole_literals_follow_utf8_decoder_boundaries(mut t)
    t_re_rep2_rejects_impossible_direct_metadata(mut t)
    t_re_workspace_reuses_mixed_programs_and_captures(mut t)
    t_re_search_from_offset_and_back(mut t)
    t_re_group_count_and_min_len(mut t)
    print("re_match_test: 12 cases pass, {t.n} assertions")
}
