//! member: false
//! Live-state oracle counterpart: state_parse.c:979-1112/state_emit.c:730-820.

use edit
use text

fn main() -> int {
    let args = env_args()
    if args.len != 2 && args.len != 3 { return 2 }
    let bytes = fs_read_bytes(args[0]) else { return 2 }
    var ed = edit.ed_new()
    assert(edit.ed_set_workspace_root(mut ed, "."))
    edit.ed_open_scratch(mut ed)
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    let result = edit.state_apply(mut ed, bytes)
    eprint("state_apply={result} tabs={ed.tabs.len}")
    if args.len == 3 {
        edit.tab_switch(mut ed, 2)
        let wi = ed.win
        ed.wins[wi].cs.curs[0].pos = 3
        ed.wins[wi].cs.curs[0].anchor = 4
        ed.wins[wi].vp.top = 5
        ed.wins[wi].vp.top_sub = 6
        ed.wins[wi].vp.left = 7
        if ed.wins[wi].jumps.len > 0 {
            ed.wins[wi].jumps.e[0].line_hint = 8
            ed.wins[wi].jumps.e[0].stamp_ms = 9
        }
        assert(edit.ed_mark_set(mut ed, ed.wins[wi].buf, 97, 10))
    }
    let out = edit.state_emit_at(ed, 0)
    if text.file_write_atomic(args[1], out, 384) != text.SAVE_OK { return 2 }
    edit.state_dispose(mut ed)
    0
}
