//! The cross-check of the generated `tables.lu` against sagitta's
//! generated `tables.c` (`tests/fixtures/unicode/tables-c.txt`, the C
//! arrays in decimal as `tools/gen-unicode-tables --dump` prints its
//! own): every entry of stage1, stage2, the palette and the high ranges
//! equal, then the sprint's semantic spot checks (sagitta
//! `scripts/gen-unicode-tables.c:605-628`) through `u_rec`. sagitta has
//! no such test: its generator and tables are one program's output;
//! here the generator is another program in another language, and this
//! is what "byte-identical tables" means.

use std.fs

fn parse_ints(field: str) -> List[int] {
    var out = List[int]()
    for word in field.words() {
        let n = word.to_int() else -1
        assert(n >= 0, "tables-c: an int")
        (mut out).push(n)
    }
    out
}

fn t_tables_match_sagitta() {
    let text = fs.read_text("tests/fixtures/unicode/tables-c.txt") else ""
    assert(text.len > 0, "tables-c: the fixture is readable from the repository root")
    var seen = 0
    for line in text.lines() {
        if line.starts_with("#") || line.trim().len == 0 {
            continue
        }
        let space = line.find(" ") else -1
        assert(space > 0, "tables-c: a named line")
        let name = line[0..space]
        let rest = line[space + 1..]
        if name == "stage1" {
            let want = parse_ints(rest)
            assert(want.len == 1536, "tables-c: stage1 has 1536 entries")
            var i = 0
            while i < want.len {
                assert(u_stage1(i) == want[i], "stage1[{i}] is {u_stage1(i)}, sagitta's {want[i]}")
                i += 1
            }
            seen += 1
        } else if name == "stage2" {
            let want = parse_ints(rest)
            assert(
                want.len == U_STAGE2_BLOCKS * 128,
                "tables-c: stage2 has {want.len} entries, the port {U_STAGE2_BLOCKS * 128}",
            )
            var i = 0
            while i < want.len {
                assert(u_stage2(i) == want[i], "stage2[{i}] is {u_stage2(i)}, sagitta's {want[i]}")
                i += 1
            }
            seen += 1
        } else if name == "pal" {
            let want = parse_ints(rest)
            assert(
                want.len == U_PAL_LEN,
                "tables-c: {want.len} palette records, the port {U_PAL_LEN}",
            )
            var i = 0
            while i < want.len {
                assert(u_pal(i) == want[i], "pal[{i}] is {u_pal(i)}, sagitta's {want[i]}")
                i += 1
            }
            seen += 1
        } else if name == "hi" {
            let ranges = rest.words()
            assert(
                ranges.len == U_HI_LEN,
                "tables-c: {ranges.len} high ranges, the port {U_HI_LEN}",
            )
            var i = 0
            while i < ranges.len {
                let parts = ranges[i].split(",")
                assert(parts.len == 3, "tables-c: a range is lo,hi,rec")
                let lo = parts[0].to_int() else -1
                let hi = parts[1].to_int() else -1
                let rec = parts[2].to_int() else -1
                assert(
                    u_hi_lo(i) == lo && u_hi_hi(i) == hi && u_hi_rec(i) == rec,
                    "hi[{i}] is ({u_hi_lo(i)}, {u_hi_hi(i)}, {u_hi_rec(i)}), sagitta's ({lo}, {hi}, {rec})",
                )
                i += 1
            }
            seen += 1
        } else {
            assert(false, "tables-c: an unknown line '{name}'")
        }
    }
    assert(seen == 4, "tables-c: four arrays compared")
}

fn t_tables_spot_checks() {
    // scripts/gen-unicode-tables.c:614-627, through the lookup.
    assert(u_rec(65) & U_EAW_MASK == 1 << U_EAW_SHIFT, "spot: U+0041 is EAW Na")
    assert(
        u_rec(769) & (U_GCB_MASK | U_INCB_MASK | U_ZERO_WIDTH) == 4 | 3 << 4 | U_ZERO_WIDTH,
        "spot: U+0301 is Extend, InCB Extend, zero width",
    )
    assert(u_rec(2381) & U_INCB_MASK == 1 << 4, "spot: U+094D is InCB Linker")
    assert(u_rec(4448) & U_ZERO_WIDTH != 0, "spot: U+1160 is zero width")
    assert(u_rec(4607) & U_ZERO_WIDTH != 0, "spot: U+11FF is zero width")
    assert(u_rec(8205) & U_GCB_MASK == 5, "spot: U+200D is ZWJ")
    assert(u_rec(19968) & U_EAW_MASK == 3 << U_EAW_SHIFT, "spot: U+4E00 is EAW W")
    assert(u_rec(44032) & U_GCB_MASK == 12, "spot: U+AC00 is LV")
    assert(u_rec(44033) & U_GCB_MASK == 13, "spot: U+AC01 is LVT")
    assert(
        u_rec(128512) & (U_EXT_PICT | U_EAW_MASK | U_EMOJI | U_EMOJI_PRESENTATION) ==
            U_EXT_PICT | 3 << U_EAW_SHIFT | U_EMOJI | U_EMOJI_PRESENTATION,
        "spot: U+1F600 is an emoji",
    )
    // Above the trie: a plane-2 ideograph is W; the last private-use
    // codepoint is W (EastAsianWidth's @missing default); U+E0001 is Cf.
    assert(u_rec(131072) & U_EAW_MASK == 3 << U_EAW_SHIFT, "spot: U+20000 is EAW W")
    assert(u_rec(1114109) & U_EAW_MASK == 2 << U_EAW_SHIFT, "spot: U+10FFFD is EAW A")
    assert(u_rec(917505) & U_ZERO_WIDTH != 0, "spot: U+E0001 is zero width")
    assert(u_rec(1114111) == 0, "spot: U+10FFFF has no record")
}

fn main() {
    t_tables_match_sagitta()
    t_tables_spot_checks()
}
