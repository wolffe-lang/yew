//! The cross-check of the generated `tables_wb.lu` against sagitta's
//! generated `tables_wb.c` (`tests/fixtures/unicode/tables_wb-c.txt`, the
//! C arrays in decimal as `tools/gen-unicode-tables --dump --word-break`
//! prints its own): every entry of stage1, stage2 and the high ranges
//! equal, then the generator's spot checks (sagitta
//! `scripts/gen-unicode-tables.c:677-694`) through `wb_record`. sagitta
//! has no such test (its generator and tables are one program's output);
//! this is the port's, as `tables_test.lu` is for the grapheme trie.

use std.fs

fn parse_ints(field: str) -> List[int] {
    var out = List[int]()
    for word in field.words() {
        let n = word.to_int() else -1
        assert(n >= 0, "tables_wb-c: an int")
        (mut out).push(n)
    }
    out
}

fn t_tables_wb_match_sagitta() {
    let text = fs.read_text("tests/fixtures/unicode/tables_wb-c.txt") else ""
    assert(text.len > 0, "tables_wb-c: the fixture is readable from the repository root")
    var seen = 0
    for line in text.lines() {
        if line.starts_with("#") || line.trim().len == 0 {
            continue
        }
        let space = line.find(" ") else -1
        assert(space > 0, "tables_wb-c: a named line")
        let name = line[0..space]
        let rest = line[space + 1..]
        if name == "stage1" {
            let want = parse_ints(rest)
            assert(want.len == 1536, "tables_wb-c: stage1 has 1536 entries")
            var i = 0
            while i < want.len {
                assert(
                    wb_stage1(i) == want[i],
                    "wb stage1[{i}] is {wb_stage1(i)}, sagitta's {want[i]}",
                )
                i += 1
            }
            seen += 1
        } else if name == "stage2" {
            let want = parse_ints(rest)
            assert(
                want.len == WB_STAGE2_BLOCKS * 128,
                "tables_wb-c: stage2 has {want.len} entries, the port {WB_STAGE2_BLOCKS * 128}",
            )
            var i = 0
            while i < want.len {
                assert(
                    wb_stage2(i) == want[i],
                    "wb stage2[{i}] is {wb_stage2(i)}, sagitta's {want[i]}",
                )
                i += 1
            }
            seen += 1
        } else if name == "hi" {
            let ranges = rest.words()
            assert(
                ranges.len == WB_HI_LEN,
                "tables_wb-c: {ranges.len} high ranges, the port {WB_HI_LEN}",
            )
            var i = 0
            while i < ranges.len {
                let parts = ranges[i].split(",")
                assert(parts.len == 3, "tables_wb-c: a range is lo,hi,rec")
                let lo = parts[0].to_int() else -1
                let hi = parts[1].to_int() else -1
                let rec = parts[2].to_int() else -1
                assert(
                    wb_hi_lo(i) == lo && wb_hi_hi(i) == hi && wb_hi_rec(i) == rec,
                    "wb hi[{i}] is ({wb_hi_lo(i)}, {wb_hi_hi(i)}, {wb_hi_rec(i)}), sagitta's ({lo}, {hi}, {rec})",
                )
                i += 1
            }
            seen += 1
        } else {
            assert(false, "tables_wb-c: an unknown line '{name}'")
        }
    }
    assert(seen == 3, "tables_wb-c: three arrays compared")
}

fn t_tables_wb_spot_checks() {
    // scripts/gen-unicode-tables.c:686-693, through the lookup.
    assert(wb_record(10) == WB_LF | WB_RECORD_WHITE_SPACE, "spot: U+000A is LF and White_Space")
    assert(
        wb_record(32) == WB_WSEGSPACE | WB_RECORD_WHITE_SPACE,
        "spot: U+0020 is WSegSpace and White_Space",
    )
    assert(wb_record(65) == WB_ALETTER, "spot: U+0041 is ALetter")
    assert(wb_record(769) == WB_EXTEND, "spot: U+0301 is Extend")
    assert(wb_record(1488) == WB_HEBREW_LETTER, "spot: U+05D0 is Hebrew_Letter")
    assert(wb_record(12450) == WB_KATAKANA, "spot: U+30A2 is Katakana")
    assert(wb_record(127462) == WB_REGIONAL_INDICATOR, "spot: U+1F1E6 is Regional_Indicator")
    // Above the trie: U+E0001 is Format, U+E0020 Extend, U+10FFFF nothing.
    assert(wb_prop(917505) == WB_FORMAT, "spot: U+E0001 is Format")
    assert(wb_prop(917536) == WB_EXTEND, "spot: U+E0020 is Extend")
    assert(wb_record(1114111) == 0, "spot: U+10FFFF has no record")
    assert(unicode_is_white_space(12288), "spot: U+3000 is White_Space")
    assert(!unicode_is_white_space(8203), "spot: U+200B is not White_Space")
    assert(unicode_is_extended_pictographic(128512), "spot: U+1F600 is Extended_Pictographic")
    assert(!unicode_is_extended_pictographic(65), "spot: U+0041 is not Extended_Pictographic")
    assert(
        wb_is_ignored(WB_ZWJ) && !wb_is_ignored(WB_ALETTER),
        "spot: WB4 ignores ZWJ, not ALetter",
    )
}

fn main() {
    t_tables_wb_match_sagitta()
    t_tables_wb_spot_checks()
    print("tables_wb_test: 2 cases pass")
}
