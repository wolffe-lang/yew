//! The port of sagitta `tests/unit/test_grapheme.c` (283 lines), one
//! test per C test, in registry order (`registry.c:582-596`): the same
//! byte strings and cluster lengths; `t_grapheme_corpus` drives the same
//! `tests/fixtures/unicode/corpus.txt`, copied verbatim from sagitta.
//! `t_grapheme_state_size` ports as the state's zeroed start: the two
//! bytes are C's layout, which wolf's two `int` fields stand for.

use std.fs

fn bytes_of(xs: List[int]) -> List[byte] {
    var out = List[byte]()
    for x in xs {
        (mut out).push(x as byte)
    }
    out
}

fn assert_clusters(s: List[byte], lengths: List[int], why: str) {
    let len = s.len
    assert(
        gb_count_bytes(s, len) == lengths.len,
        "{why}: {gb_count_bytes(s, len)} clusters, want {lengths.len}",
    )
    var pos = 0
    var i = 0
    while i < lengths.len {
        let start = pos
        let next = gb_next_bytes(s, len, pos)
        assert(
            next - pos == lengths[i],
            "{why}: cluster {i} is {next - pos} bytes, want {lengths[i]}",
        )
        pos = next
        assert(gb_prev_bytes(s, len, pos) == start, "{why}: prev of cluster {i}")
        i += 1
    }
    assert(pos == len, "{why}: the clusters cover the string")
}

fn t_grapheme_state_size() {
    let st = gb_init()
    assert(st.prev_gcb == GCB_OTHER, "state_size: prev_gcb is Other")
    assert(st.flags == 0, "state_size: flags are zero")
}

fn t_grapheme_ascii() {
    assert_clusters(bytes_of([97, 114, 114, 111, 119]), [1, 1, 1, 1, 1], "ascii")
}

fn t_grapheme_crlf_control() {
    assert_clusters(bytes_of([97, 13, 10, 0, 98]), [1, 2, 1, 1], "crlf_control")
}

fn t_grapheme_extend_spacing_prepend() {
    assert_clusters(
        bytes_of([101, 204, 129, 32, 216, 128, 97, 32, 224, 164, 149, 224, 164, 190]),
        [3, 1, 3, 1, 6],
        "extend_spacing_prepend",
    )
}

fn t_grapheme_hangul() {
    assert_clusters(
        bytes_of([225, 132, 128, 225, 133, 161, 225, 134, 168, 32, 234, 176, 128, 225, 134, 168]),
        [9, 1, 6],
        "hangul",
    )
}

fn t_grapheme_ri_pairs() {
    assert_clusters(
        bytes_of([240, 159, 135, 166, 240, 159, 135, 186, 240, 159, 135, 184, 240, 159, 135, 166]),
        [8, 8],
        "ri_pairs",
    )
}

fn t_grapheme_ri_run_resets_after_ascii() {
    assert_clusters(
        bytes_of(
            [
                240,
                159,
                135,
                166,
                240,
                159,
                135,
                167,
                120,
                240,
                159,
                135,
                168,
                240,
                159,
                135,
                169,
                240,
                159,
                135,
                170,
            ],
        ),
        [8, 1, 8, 4],
        "ri_run_resets_after_ascii",
    )
}

fn t_grapheme_emoji_zwj() {
    assert_clusters(
        bytes_of(
            [
                240,
                159,
                145,
                168,
                226,
                128,
                141,
                240,
                159,
                145,
                169,
                226,
                128,
                141,
                240,
                159,
                145,
                167,
                226,
                128,
                141,
                240,
                159,
                145,
                166,
            ],
        ),
        [25],
        "emoji_zwj",
    )
}

fn t_grapheme_emoji_zwj_requires_pictograph() {
    assert_clusters(
        bytes_of([240, 159, 145, 168, 226, 128, 141, 65]),
        [7, 1],
        "emoji_zwj_requires_pictograph",
    )
}

fn t_grapheme_indic_conjunct() {
    assert_clusters(bytes_of([224, 164, 149, 224, 165, 141, 224, 164, 183]), [9], "indic_conjunct")
}

fn t_grapheme_incb_requires_linker() {
    assert_clusters(
        bytes_of([224, 164, 149, 204, 129, 224, 164, 183]),
        [5, 3],
        "incb_requires_linker",
    )
}

fn t_grapheme_prepend_does_not_cross_control() {
    assert_clusters(bytes_of([216, 128, 10, 97]), [2, 1, 1], "prepend_does_not_cross_control")
}

fn t_grapheme_invalid_bytes() {
    assert_clusters(bytes_of([255, 65, 237, 160, 128]), [1, 1, 1, 1, 1], "invalid_bytes")
}

fn t_grapheme_backward_bound() {
    var text = List[byte]()
    var i = 0
    while i < 65 {
        let n = utf8_encode_into(mut text, 127462 + i % 26)
        assert(n == 4, "backward_bound: an RI is four bytes")
        i += 1
    }
    assert(text.len == 65 * 4, "backward_bound: 65 RIs")
    // The bounded restart deliberately sees an even 64-codepoint suffix,
    // so this odd RI run takes the documented parity approximation.
    assert(
        gb_prev_bytes(text, text.len, text.len) == text.len - 8,
        "backward_bound: prev lands 8 bytes back",
    )
    assert(
        gb_next_bytes(text, text.len, gb_prev_bytes(text, text.len, text.len)) == text.len,
        "backward_bound: next of prev is the end",
    )
}

fn hex_digit(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    -1
}

/// `61 CC 81 FF` as bytes.
fn parse_hex_bytes(field: str) -> List[byte] {
    var out = List[byte]()
    for word in field.words() {
        var value = 0
        for b in word.bytes() {
            let d = hex_digit(b as int)
            assert(d >= 0, "corpus: a hex byte")
            value = value * 16 + d
        }
        assert(value <= 255, "corpus: a byte")
        (mut out).push(value as byte)
    }
    out
}

/// `3,1,3` as ints.
fn parse_sizes(field: str) -> List[int] {
    var out = List[int]()
    for piece in field.trim().split(",") {
        let n = piece.trim().to_int() else -1
        assert(n >= 0, "corpus: a size")
        (mut out).push(n)
    }
    out
}

fn t_grapheme_corpus() {
    let text = fs.read_text("tests/fixtures/unicode/corpus.txt") else ""
    assert(
        text.len > 0,
        "corpus: tests/fixtures/unicode/corpus.txt is readable from the repository root",
    )
    var cases = 0
    for line in text.lines() {
        let trimmed = line.trim()
        if trimmed.len == 0 || trimmed.starts_with("#") {
            continue
        }
        let fields = trimmed.split("|")
        assert(fields.len == 4, "corpus: four fields in '{trimmed}'")
        let name = fields[0]
        let bytes = parse_hex_bytes(fields[1])
        let lengths = parse_sizes(fields[2])
        let widths = parse_sizes(fields[3])
        assert(lengths.len == widths.len, "corpus {name}: lengths and widths agree")
        assert(gb_count_bytes(bytes, bytes.len) == lengths.len, "corpus {name}: cluster count")
        var pos = 0
        var i = 0
        while i < lengths.len {
            let start = pos
            let cluster = cluster_next(bytes, bytes.len, pos) else {
                assert(false, "corpus {name}: cluster {i} exists")
                return
            }
            assert(cluster.off == start, "corpus {name}: cluster {i} offset")
            assert(
                cluster.len == lengths[i],
                "corpus {name}: cluster {i} is {cluster.len} bytes, want {lengths[i]}",
            )
            assert(
                cluster.cells == widths[i],
                "corpus {name}: cluster {i} is {cluster.cells} cells, want {widths[i]}",
            )
            pos = cluster.off + cluster.len
            assert(
                gb_prev_bytes(bytes, bytes.len, pos) == start,
                "corpus {name}: prev of cluster {i}",
            )
            i += 1
        }
        assert(pos == bytes.len, "corpus {name}: covered")
        cases += 1
    }
    assert(cases >= 40, "corpus: at least 40 cases ({cases})")
}

fn main() {
    t_grapheme_state_size()
    t_grapheme_ascii()
    t_grapheme_crlf_control()
    t_grapheme_extend_spacing_prepend()
    t_grapheme_hangul()
    t_grapheme_ri_pairs()
    t_grapheme_ri_run_resets_after_ascii()
    t_grapheme_emoji_zwj()
    t_grapheme_emoji_zwj_requires_pictograph()
    t_grapheme_indic_conjunct()
    t_grapheme_incb_requires_linker()
    t_grapheme_prepend_does_not_cross_control()
    t_grapheme_invalid_bytes()
    t_grapheme_backward_bound()
    t_grapheme_corpus()
}
