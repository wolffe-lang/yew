//! unicode.case — the locale-neutral full default case mappings, for
//! H mode's `ed.sel.case_upper`, `_lower` and `_toggle`.
//!
//! Ports the lookups of sagitta's generated `src/unicode/tables_case.c`
//! (`case_record`, `yew_case_map`, `yew_case_map_utf8`, lines 3396-3480)
//! and `case.h` (26) at 9ace98c2, under `s17-mode-H-multicursor.md` §4.
//! The data — `CASE_DATA`, `CASE_RECS` and the counts — is
//! `tables_case.lu`, GENERATED by `tools/gen-unicode-tables --case` as
//! `str` constants of 7-bit digits; this file is hand-written and never
//! regenerated (C's generator emits the lookup code too; the port's emits
//! data only, as for the other tables). A codepoint with no record, an
//! invalid-byte escape among them, maps to itself.

/// The most codepoints one mapping yields (`YEW_CASE_MAX_CODEPOINTS`).
pub const CASE_MAX_CODEPOINTS: int = 3

/// The most UTF-8 bytes one mapping yields (`YEW_CASE_MAX_UTF8`).
pub const CASE_MAX_UTF8: int = 12

/// Lowercase (`YEW_CASE_LOWER`).
pub const CASE_LOWER: int = 0

/// Uppercase (`YEW_CASE_UPPER`).
pub const CASE_UPPER: int = 1

/// The uppercase mapping if there is one, else the lowercase
/// (`YEW_CASE_TOGGLE`).
pub const CASE_TOGGLE: int = 2

fn case_digit(s: str, i: int) -> int {
    s.bytes()[i] as int
}

/// Mapped codepoint `i` of the data (`yew_case_data[i]`).
pub fn case_data_at(i: int) -> int {
    (case_digit(CASE_DATA, 3 * i) * 128 + case_digit(CASE_DATA, 3 * i + 1)) * 128 +
        case_digit(CASE_DATA, 3 * i + 2)
}

fn rec_field(i: int, at: int, n: int) -> int {
    var v = 0
    var k = 0
    while k < n {
        v = v * 128 + case_digit(CASE_RECS, 9 * i + at + k)
        k += 1
    }
    v
}

/// Record `i`'s codepoint (`yew_case_recs[i].cp`).
pub fn case_rec_cp(i: int) -> int {
    rec_field(i, 0, 3)
}

/// Record `i`'s lowercase offset into the data.
pub fn case_rec_lower_at(i: int) -> int {
    rec_field(i, 3, 2)
}

/// Record `i`'s uppercase offset into the data.
pub fn case_rec_upper_at(i: int) -> int {
    rec_field(i, 5, 2)
}

/// Record `i`'s lowercase length (0: identity).
pub fn case_rec_lower_len(i: int) -> int {
    rec_field(i, 7, 1)
}

/// Record `i`'s uppercase length (0: identity).
pub fn case_rec_upper_len(i: int) -> int {
    rec_field(i, 8, 1)
}

// `case_record` (`tables_case.c:3396-3412`): binary search, -1 for none.
fn case_record(cp: int) -> int {
    var lo = 0
    var hi = CASE_REC_LEN
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        let at = case_rec_cp(mid)
        if cp < at {
            hi = mid
        } else if cp > at {
            lo = mid + 1
        } else {
            return mid
        }
    }
    -1
}

/// The mapping of `cp` (`yew_case_map`, `tables_case.c:3414-3458`):
/// answers (data offset, length); length 0 is the identity, `cp` itself.
pub fn case_map_span(cp: int, kind: int) -> (int, int) {
    if kind < CASE_LOWER || kind > CASE_TOGGLE {
        assert(false, "yew_case_map: invalid case kind {kind}")
    }
    let rec = case_record(cp)
    if rec < 0 {
        return (0, 0)
    }
    if kind == CASE_LOWER {
        return (case_rec_lower_at(rec), case_rec_lower_len(rec))
    }
    if kind == CASE_UPPER {
        return (case_rec_upper_at(rec), case_rec_upper_len(rec))
    }
    if case_rec_upper_len(rec) != 0 {
        return (case_rec_upper_at(rec), case_rec_upper_len(rec))
    }
    (case_rec_lower_at(rec), case_rec_lower_len(rec))
}

/// The mapping of `cp` pushed onto `out` as codepoints (`yew_case_map`);
/// answers how many (at least one).
pub fn case_map_into(cp: int, kind: int, mut out: List[int]) -> int {
    let (at, len) = case_map_span(cp, kind)
    if len == 0 {
        (mut out).push(cp)
        return 1
    }
    var i = 0
    while i < len {
        (mut out).push(case_data_at(at + i))
        i += 1
    }
    len
}

/// The mapping of `cp` pushed onto `out` as UTF-8 (`yew_case_map_utf8`,
/// `tables_case.c:3460-3477`); answers how many bytes, 0 (and nothing
/// pushed) when a mapped value does not encode.
pub fn case_map_utf8(cp: int, kind: int, mut out: List[byte]) -> int {
    let (at, len) = case_map_span(cp, kind)
    let start = out.len
    if len == 0 {
        let n = utf8_encode_into(mut out, cp)
        return n
    }
    var i = 0
    while i < len {
        if utf8_encode_into(mut out, case_data_at(at + i)) == 0 {
            while out.len > start {
                let _ = (mut out).pop() else 0 as byte
            }
            return 0
        }
        i += 1
    }
    out.len - start
}
