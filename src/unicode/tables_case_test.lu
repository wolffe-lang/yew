//! The cross-check of the generated `tables_case.lu` against sagitta's
//! generated `tables_case.c` (`tests/fixtures/unicode/tables_case-c.txt`,
//! the C arrays in decimal as `tools/gen-unicode-tables --dump --case`
//! prints its own): every data codepoint and every record equal, then the
//! mappings through `case_map_into`/`case_map_utf8` (the generator's
//! spot checks, `scripts/gen-unicode-tables.c:890-905`, and the
//! toggle's rule). sagitta has no such test (its generator and tables
//! are one program's output); this is the port's, as `tables_wb_test.lu`
//! is for the word-break trie.

use std.fs

fn t_tables_case_match_sagitta() {
    let text = fs.read_text("tests/fixtures/unicode/tables_case-c.txt") else ""
    assert(text.len > 0, "tables_case-c: the fixture is readable from the repository root")
    var seen = 0
    for line in text.lines() {
        if line.starts_with("#") || line.trim().len == 0 {
            continue
        }
        let space = line.find(" ") else -1
        assert(space > 0, "tables_case-c: a named line")
        let name = line[0..space]
        let rest = line[space + 1..]
        if name == "data" {
            var i = 0
            for word in rest.words() {
                let want = word.to_int() else -1
                assert(
                    case_data_at(i) == want,
                    "case data[{i}] is {case_data_at(i)}, sagitta's {want}",
                )
                i += 1
            }
            assert(i == CASE_DATA_LEN, "tables_case-c: {i} data entries, the port {CASE_DATA_LEN}")
            seen += 1
        } else if name == "recs" {
            var i = 0
            for word in rest.words() {
                let f = word.split(",")
                assert(f.len == 5, "tables_case-c: a five-field record")
                let cp = f[0].to_int() else -1
                let lower_at = f[1].to_int() else -1
                let upper_at = f[2].to_int() else -1
                let lower_len = f[3].to_int() else -1
                let upper_len = f[4].to_int() else -1
                assert(case_rec_cp(i) == cp, "case rec[{i}].cp is {case_rec_cp(i)}, sagitta's {cp}")
                assert(case_rec_lower_at(i) == lower_at, "case rec[{i}].lower_at")
                assert(case_rec_upper_at(i) == upper_at, "case rec[{i}].upper_at")
                assert(case_rec_lower_len(i) == lower_len, "case rec[{i}].lower_len")
                assert(case_rec_upper_len(i) == upper_len, "case rec[{i}].upper_len")
                i += 1
            }
            assert(i == CASE_REC_LEN, "tables_case-c: {i} records, the port {CASE_REC_LEN}")
            seen += 1
        }
    }
    assert(seen == 2, "tables_case-c: data and recs both present")
}

fn mapped(cp: int, kind: int) -> List[int] {
    var out = List[int]()
    let _ = case_map_into(cp, kind, mut out)
    out
}

fn t_case_spot_checks() {
    let ss = mapped(223, CASE_UPPER)
    assert(ss.len == 2 && ss[0] == 83 && ss[1] == 83, "ß uppercases to SS")
    let i_dot = mapped(304, CASE_LOWER)
    assert(i_dot.len == 2 && i_dot[0] == 105 && i_dot[1] == 775, "İ lowercases to i + U+0307")
    assert(mapped(65, CASE_LOWER)[0] == 97, "A lowercases to a")
    assert(mapped(97, CASE_UPPER)[0] == 65, "a uppercases to A")
    assert(mapped(65, CASE_TOGGLE)[0] == 97, "A toggles to a (no uppercase mapping)")
    assert(mapped(97, CASE_TOGGLE)[0] == 65, "a toggles to A")
    assert(mapped(49, CASE_UPPER)[0] == 49, "1 is its own mapping")
    let esc = mapped(56320 + 255, CASE_UPPER)
    assert(esc.len == 1 && esc[0] == 56320 + 255, "an invalid-byte escape maps to itself")
    var out = List[byte]()
    assert(
        case_map_utf8(223, CASE_UPPER, mut out) == 2 && out[0] as int == 83 && out[1] as int == 83,
        "ß as UTF-8",
    )
    var raw = List[byte]()
    assert(
        case_map_utf8(56320 + 255, CASE_LOWER, mut raw) == 1 && raw[0] as int == 255,
        "an escape is its byte",
    )
}
