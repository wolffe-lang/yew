//! unicode.trie — the lookups over the generated property tables.
//!
//! Ports sagitta `src/unicode/tables.h` (46 lines: `yew_u_rec`, the
//! inline two-level lookup) and the `yew_u_hi_lookup` its generator
//! emits at the end of `tables.c` (`scripts/gen-unicode-tables.c:767-780`)
//! at 9ace98c2. The data — `U_STAGE1`, `U_STAGE2`, `U_PAL`, `U_HI` and
//! the counts — is `tables.lu`, GENERATED by `tools/gen-unicode-tables`
//! as `str` constants of 7-bit digits (its header says the encoding);
//! this file is hand-written and never regenerated, so the generator
//! emits data and no code.

fn digit(s: str, i: int) -> int {
    s.bytes()[i] as int
}

/// Stage-1 entry `i`: the stage-2 block serving codepoints
/// `i * 128 .. i * 128 + 127` (`yew_u_stage1[i]`).
pub fn u_stage1(i: int) -> int {
    digit(U_STAGE1, 2 * i) * 128 + digit(U_STAGE1, 2 * i + 1)
}

/// Stage-2 entry `i`: a palette index (`yew_u_stage2[i]`).
pub fn u_stage2(i: int) -> int {
    digit(U_STAGE2, i)
}

/// Palette record `i` (`yew_u_pal[i]`).
pub fn u_pal(i: int) -> int {
    digit(U_PAL, 2 * i) * 128 + digit(U_PAL, 2 * i + 1)
}

fn hi_word(k: int) -> int {
    (digit(U_HI, 3 * k) * 128 + digit(U_HI, 3 * k + 1)) * 128 + digit(U_HI, 3 * k + 2)
}

/// High range `i`: its first codepoint (`yew_u_hi[i].lo`).
pub fn u_hi_lo(i: int) -> int {
    hi_word(3 * i)
}

/// High range `i`: its last codepoint (`yew_u_hi[i].hi`).
pub fn u_hi_hi(i: int) -> int {
    hi_word(3 * i + 1)
}

/// High range `i`: its record (`yew_u_hi[i].rec`).
pub fn u_hi_rec(i: int) -> int {
    hi_word(3 * i + 2)
}

/// The record of a codepoint at or above `TRIE_HI`, by binary search
/// over the range table (`yew_u_hi_lookup`); 0 outside every range.
pub fn u_hi_lookup(cp: int) -> int {
    var lo = 0
    var hi = U_HI_LEN
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if cp < u_hi_lo(mid) {
            hi = mid
        } else if cp > u_hi_hi(mid) {
            lo = mid + 1
        } else {
            return u_hi_rec(mid)
        }
    }
    0
}

/// The packed record of `cp` (`yew_u_rec`, `tables.h:38-46`): one
/// lookup serves the segmenter and the width tables.
pub fn u_rec(cp: int) -> int {
    if cp < TRIE_HI {
        let block = u_stage1(cp >> TRIE_SHIFT)
        let slot = cp & TRIE_BLOCK - 1
        return u_pal(u_stage2((block << TRIE_SHIFT) + slot))
    }
    u_hi_lookup(cp)
}
