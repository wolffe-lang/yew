//! unicode.wordbreak — the Word_Break property and White_Space, for the
//! UAX #29 word-boundary oracle (`edit.word_boundary`) and the W unit.
//!
//! Ports sagitta `src/unicode/wordbreak.c` (50 lines) and `wordbreak.h`
//! (53) at 9ace98c2, under `s16-modes-W-B.md` §2. The data — `WB_STAGE1`,
//! `WB_STAGE2`, `WB_HI` and the counts — is `tables_wb.lu`, GENERATED by
//! `tools/gen-unicode-tables --word-break` as `str` constants of 7-bit
//! digits; this file is hand-written and never regenerated, so the
//! generator emits data and no code (as `trie.lu` is to `tables.lu`).
//! `unicode_is_extended_pictographic` reads the grapheme trie's record,
//! as C's reads `yew_u_rec` (`wordbreak.c:47-50`).

/// The first codepoint the word-break range table serves
/// (`YEW_WB_TRIE_HI`, `wordbreak.h:6`).
pub const WB_TRIE_HI: int = 196608

/// log2 of the word-break stage-2 block size (`YEW_WB_TRIE_SHIFT`).
pub const WB_TRIE_SHIFT: int = 7

/// The word-break stage-2 block size (`YEW_WB_TRIE_BLOCK`).
pub const WB_TRIE_BLOCK: int = 128

/// Word_Break=Other (`YewWb`, `wordbreak.h:10-30`).
pub const WB_OTHER: int = 0

/// Word_Break=CR.
pub const WB_CR: int = 1

/// Word_Break=LF.
pub const WB_LF: int = 2

/// Word_Break=Newline.
pub const WB_NEWLINE: int = 3

/// Word_Break=Extend.
pub const WB_EXTEND: int = 4

/// Word_Break=Format.
pub const WB_FORMAT: int = 5

/// Word_Break=ZWJ.
pub const WB_ZWJ: int = 6

/// Word_Break=WSegSpace.
pub const WB_WSEGSPACE: int = 7

/// Word_Break=ALetter.
pub const WB_ALETTER: int = 8

/// Word_Break=Hebrew_Letter.
pub const WB_HEBREW_LETTER: int = 9

/// Word_Break=Numeric.
pub const WB_NUMERIC: int = 10

/// Word_Break=Katakana.
pub const WB_KATAKANA: int = 11

/// Word_Break=ExtendNumLet.
pub const WB_EXTENDNUMLET: int = 12

/// Word_Break=Regional_Indicator.
pub const WB_REGIONAL_INDICATOR: int = 13

/// Word_Break=MidLetter.
pub const WB_MIDLETTER: int = 14

/// Word_Break=MidNum.
pub const WB_MIDNUM: int = 15

/// Word_Break=MidNumLet.
pub const WB_MIDNUMLET: int = 16

/// Word_Break=Single_Quote.
pub const WB_SINGLE_QUOTE: int = 17

/// Word_Break=Double_Quote.
pub const WB_DOUBLE_QUOTE: int = 18

/// Record bits 0-4: the Word_Break value (`YEW_WB_RECORD_MASK`,
/// `wordbreak.h:32-35`).
pub const WB_RECORD_MASK: int = 31

/// Record bit 5: White_Space (`YEW_WB_RECORD_WHITE_SPACE`).
pub const WB_RECORD_WHITE_SPACE: int = 32

fn wb_digit(s: str, i: int) -> int {
    s.bytes()[i] as int
}

/// Word-break stage-1 entry `i` (`yew_wb_stage1[i]`).
pub fn wb_stage1(i: int) -> int {
    wb_digit(WB_STAGE1, 2 * i) * 128 + wb_digit(WB_STAGE1, 2 * i + 1)
}

/// Word-break stage-2 entry `i`: a record (`yew_wb_stage2[i]`).
pub fn wb_stage2(i: int) -> int {
    wb_digit(WB_STAGE2, i)
}

fn wb_hi_word(k: int) -> int {
    (wb_digit(WB_HI, 3 * k) * 128 + wb_digit(WB_HI, 3 * k + 1)) * 128 + wb_digit(WB_HI, 3 * k + 2)
}

/// Word-break high range `i`: its first codepoint (`yew_wb_hi[i].lo`).
pub fn wb_hi_lo(i: int) -> int {
    wb_hi_word(3 * i)
}

/// Word-break high range `i`: its last codepoint (`yew_wb_hi[i].hi`).
pub fn wb_hi_hi(i: int) -> int {
    wb_hi_word(3 * i + 1)
}

/// Word-break high range `i`: its record (`yew_wb_hi[i].rec`).
pub fn wb_hi_rec(i: int) -> int {
    wb_hi_word(3 * i + 2)
}

// `wb_high_record` (`wordbreak.c:5-19`): binary search, 0 outside.
fn wb_high_record(cp: int) -> int {
    var lo = 0
    var hi = WB_HI_LEN
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if cp < wb_hi_lo(mid) {
            hi = mid
        } else if cp > wb_hi_hi(mid) {
            lo = mid + 1
        } else {
            return wb_hi_rec(mid)
        }
    }
    0
}

/// The packed word-break record of `cp` (`wb_record`,
/// `wordbreak.c:21-29`).
pub fn wb_record(cp: int) -> int {
    if cp < WB_TRIE_HI {
        let block = wb_stage1(cp >> WB_TRIE_SHIFT)
        let slot = cp & WB_TRIE_BLOCK - 1
        return wb_stage2((block << WB_TRIE_SHIFT) + slot)
    }
    wb_high_record(cp)
}

/// The Word_Break value of `cp`, a `WB_*` (`yew_wb_prop`,
/// `wordbreak.c:31-34`).
pub fn wb_prop(cp: int) -> int {
    wb_record(cp) & WB_RECORD_MASK
}

/// Whether WB4 ignores `prop`: Extend, Format, ZWJ (`yew_wb_is_ignored`,
/// `wordbreak.c:36-40`).
pub fn wb_is_ignored(prop: int) -> bool {
    prop == WB_EXTEND || prop == WB_FORMAT || prop == WB_ZWJ
}

/// White_Space (`yew_unicode_is_white_space`, `wordbreak.c:42-45`).
pub fn unicode_is_white_space(cp: int) -> bool {
    wb_record(cp) & WB_RECORD_WHITE_SPACE != 0
}

/// Extended_Pictographic, from the grapheme trie's record
/// (`yew_unicode_is_extended_pictographic`, `wordbreak.c:47-50`).
pub fn unicode_is_extended_pictographic(cp: int) -> bool {
    u_rec(cp) & U_EXT_PICT != 0
}
