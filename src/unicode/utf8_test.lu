//! The port of sagitta `tests/unit/test_utf8.c` (442 lines), one test
//! per C test, in registry order (`tests/unit/registry.c:554-576`): the
//! same inputs, the same expected codepoints, lengths and offsets.
//! `t_utf8_validate_simple_checks_each_word_lane` keeps its shape although
//! the port scans a byte at a time: a lane is a lane.

fn bytes_of(xs: List[int]) -> List[byte] {
    var out = List[byte]()
    for x in xs {
        (mut out).push(x as byte)
    }
    out
}

/// Element-wise equality: `==` on a `List` is refused this edition.
fn same_bytes(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn assert_round_trip(input: List[byte], why: str) {
    var pos = 0
    while pos < input.len {
        let (cp, consumed) = utf8_decode(input, pos, input.len)
        var encoded = List[byte]()
        let produced = utf8_encode_into(mut encoded, cp)
        assert(consumed > 0 && consumed <= input.len - pos, "{why}: consumed {consumed} at {pos}")
        assert(produced == consumed, "{why}: produced {produced} != consumed {consumed} at {pos}")
        assert(same_bytes(encoded, input[pos..pos + consumed]), "{why}: bytes differ at {pos}")
        pos += consumed
    }
    assert(pos == input.len, "{why}: the scan ends at len")
}

fn assert_decodes(input: List[byte], expected: int, consumed: int, why: str) {
    let (cp, n) = utf8_decode(input, 0, input.len)
    assert(n == consumed, "{why}: consumed {n}, want {consumed}")
    assert(cp == expected, "{why}: cp {cp}, want {expected}")
}

fn t_utf8_valid_decode() {
    let cases = [
        ([0], 0),
        ([127], 127),
        ([194, 128], 128),
        ([223, 191], 2047),
        ([224, 160, 128], 2048),
        ([237, 159, 191], 55295),
        ([238, 128, 128], 57344),
        ([239, 191, 191], 65535),
        ([240, 144, 128, 128], 65536),
        ([244, 143, 191, 191], 1114111),
    ]
    for (raw, cp) in cases {
        let input = bytes_of(raw)
        assert_decodes(input, cp, input.len, "valid_decode {cp}")
        assert_round_trip(input, "valid_decode {cp}")
    }
}

fn t_utf8_reject_classes() {
    let cases = [
        [192, 128],
        [224, 128, 128],
        [237, 160, 128],
        [237, 191, 191],
        [240, 128, 128, 128],
        [244, 144, 128, 128],
        [245, 128, 128, 128],
        [128],
        [255],
    ]
    for raw in cases {
        let input = bytes_of(raw)
        let (cp, n) = utf8_decode(input, 0, input.len)
        assert(n == 1, "reject_classes: one byte consumed")
        assert(cp == utf8_escape_of(raw[0]), "reject_classes: the first byte escapes")
        assert_round_trip(input, "reject_classes")
    }
}

fn t_utf8_illegal_leads_are_single_byte_escapes() {
    for b in [192, 193, 245, 255] {
        assert_decodes(bytes_of([b]), utf8_escape_of(b), 1, "illegal_leads {b}")
    }
}

fn t_utf8_overlong_boundary_forms_are_lossless() {
    assert_round_trip(bytes_of([192, 128]), "overlong two")
    assert_round_trip(bytes_of([224, 159, 191]), "overlong three")
    assert_round_trip(bytes_of([240, 143, 191, 191]), "overlong four")
}

fn t_utf8_surrogate_boundary_forms_are_lossless() {
    assert_round_trip(bytes_of([237, 160, 128]), "surrogate first")
    assert_round_trip(bytes_of([237, 191, 191]), "surrogate last")
}

fn t_utf8_above_max_boundary_forms_are_lossless() {
    assert_round_trip(bytes_of([244, 144, 128, 128]), "above max first")
    assert_round_trip(bytes_of([245, 128, 128, 128]), "above max obsolete")
}

fn t_utf8_non_escape_surrogate_edges_are_unencodable() {
    for cp in [55296, 56447, 56576, 57343] {
        var out = List[byte]()
        assert(utf8_encode_into(mut out, cp) == 0, "surrogate {cp} encodes to nothing")
        assert(utf8_len(cp) == 0, "surrogate {cp} has length 0")
    }
    for cp in [CP_ESC_LO, CP_ESC_HI] {
        var out = List[byte]()
        assert(utf8_encode_into(mut out, cp) == 1, "escape {cp} encodes to one byte")
        assert(out[0] as int == cp - 56320, "escape {cp} encodes to its byte")
    }
}

fn t_utf8_validate_reports_earliest_error() {
    let bad_first = bytes_of([255, 97, 192])
    let bad_second = bytes_of([97, 128, 255])
    let bad_after_scalar = bytes_of([97, 194, 162, 225, 98, 255])
    assert(utf8_validate(bad_first, 0, bad_first.len) == 0, "earliest: bad first")
    assert(utf8_validate(bad_second, 0, bad_second.len) == 1, "earliest: bad second")
    assert(
        utf8_validate(bad_after_scalar, 0, bad_after_scalar.len) == 3,
        "earliest: bad after scalar",
    )
}

fn t_utf8_truncated_decode() {
    assert_round_trip(bytes_of([194]), "truncated two")
    assert_round_trip(bytes_of([225]), "truncated three 1")
    assert_round_trip(bytes_of([225, 128]), "truncated three 2")
    assert_round_trip(bytes_of([241]), "truncated four 1")
    assert_round_trip(bytes_of([241, 128]), "truncated four 2")
    assert_round_trip(bytes_of([241, 128, 128]), "truncated four 3")
}

fn t_utf8_incremental_valid() {
    let input = [36, 194, 162, 226, 130, 172, 240, 144, 141, 136]
    let expected = [36, 162, 8364, 66376]
    var dec = utf8_dec_new()
    var out_pos = 0
    for b in input {
        let n = utf8_push(mut dec, b)
        assert(n <= 1, "incremental_valid: at most one result a byte")
        if n != 0 {
            assert(utf8_dec_out(dec, 0) == expected[out_pos], "incremental_valid: result {out_pos}")
            out_pos += 1
        }
    }
    assert(utf8_finish(mut dec) == 0, "incremental_valid: nothing pending at the end")
    assert(out_pos == expected.len, "incremental_valid: four results")
}

fn t_utf8_incremental_recovery() {
    var dec = utf8_dec_new()
    assert(utf8_push(mut dec, 225) == 0, "recovery: E1 pends")
    assert(utf8_push(mut dec, 65) == 2, "recovery: E1 41 flushes two")
    assert(utf8_dec_out(dec, 0) == utf8_escape_of(225), "recovery: escape(E1)")
    assert(utf8_dec_out(dec, 1) == 65, "recovery: then A")

    dec = utf8_dec_new()
    assert(utf8_push(mut dec, 240) == 0, "recovery: F0 pends")
    assert(utf8_push(mut dec, 144) == 0, "recovery: F0 90 pends")
    assert(utf8_push(mut dec, 128) == 0, "recovery: F0 90 80 pends")
    assert(utf8_push(mut dec, 65) == 4, "recovery: F0 90 80 41 flushes four")
    assert(utf8_dec_out(dec, 0) == utf8_escape_of(240), "recovery: escape(F0)")
    assert(utf8_dec_out(dec, 1) == utf8_escape_of(144), "recovery: escape(90)")
    assert(utf8_dec_out(dec, 2) == utf8_escape_of(128), "recovery: escape(80)")
    assert(utf8_dec_out(dec, 3) == 65, "recovery: then A")
}

fn t_utf8_incremental_finish() {
    let input = [241, 128, 128]
    var dec = utf8_dec_new()
    for b in input {
        assert(utf8_push(mut dec, b) == 0, "finish: pending")
    }
    assert(utf8_finish(mut dec) == 3, "finish: three escapes")
    var i = 0
    while i < 3 {
        assert(utf8_dec_out(dec, i) == utf8_escape_of(input[i]), "finish: escape {i}")
        i += 1
    }
    assert(utf8_finish(mut dec) == 0, "finish: idempotent")
}

fn t_utf8_decode_prev() {
    let input = bytes_of([0, 65, 194, 162, 226, 130, 172, 240, 144, 141, 136, 255])
    let ends = [2, 4, 7, 11, 12]
    let lens = [1, 2, 3, 4, 1]
    let cps = [65, 162, 8364, 66376, 56575]
    var i = 0
    while i < ends.len {
        let (cp, n) = utf8_decode_prev(input, 1, ends[i])
        assert(n == lens[i], "decode_prev: len at {ends[i]}")
        assert(cp == cps[i], "decode_prev: cp at {ends[i]}")
        i += 1
    }
    let (cp, n) = utf8_decode_prev(input, 1, 1)
    assert(n == 0 && cp == 0, "decode_prev: start >= pos answers (0, 0)")
}

fn t_utf8_encode_edges() {
    for cp in [0, 127, 128, 2047, 2048, 55295, 57344, 65535, 65536, 1114111] {
        var out = List[byte]()
        let n = utf8_encode_into(mut out, cp)
        assert(n != 0, "encode_edges: {cp} encodes")
        assert(utf8_len(cp) == n, "encode_edges: len agrees for {cp}")
        let (decoded, m) = utf8_decode(out, 0, out.len)
        assert(m == n, "encode_edges: decode consumes {n} for {cp}")
        assert(decoded == cp, "encode_edges: round trip {cp}")
    }
    var out = List[byte]()
    assert(utf8_encode_into(mut out, 1114112) == 0, "encode_edges: 0x110000 is unencodable")
    assert(utf8_len(4294967295) == 0, "encode_edges: 0xFFFFFFFF has length 0")
}

fn t_utf8_escape_helpers() {
    assert(!utf8_is_escape(CP_ESC_LO - 1), "escape_helpers: below the range")
    assert(!utf8_is_escape(CP_ESC_HI + 1), "escape_helpers: above the range")
    var b = 128
    while b <= 255 {
        let cp = utf8_escape_of(b)
        assert(utf8_is_escape(cp), "escape_helpers: {b} escapes")
        assert(utf8_escape_byte(cp) == b, "escape_helpers: {b} round-trips")
        b += 1
    }
}

fn t_utf8_validate() {
    let valid = bytes_of([65, 194, 162, 244, 143, 191, 191])
    let invalid = bytes_of([65, 225, 65])
    let truncated = bytes_of([65, 225, 128])
    assert(utf8_validate(List[byte](), 0, 0) == 0, "validate: empty")
    assert(utf8_validate(valid, 0, valid.len) == valid.len, "validate: valid")
    assert(utf8_validate(invalid, 0, invalid.len) == 1, "validate: invalid at 1")
    assert(utf8_validate(truncated, 0, truncated.len) == 1, "validate: truncated at 1")
}

fn t_utf8_validate_simple_classifies_controls() {
    let simple = bytes_of([97, 108, 112, 104, 97, 10, 98, 101, 116, 97])
    let tab = bytes_of([97, 108, 112, 104, 97, 9, 98, 101, 116, 97])
    let del = bytes_of([97, 127, 98])
    let unicode = bytes_of([97, 195, 169])
    let invalid = bytes_of([97, 255, 98])
    let (a, sa) = utf8_validate_simple(simple, 0, simple.len)
    assert(a == simple.len && sa, "validate_simple: letters and LF are simple")
    let (b, sb) = utf8_validate_simple(tab, 0, tab.len)
    assert(b == tab.len && !sb, "validate_simple: a tab is not simple")
    let (c, sc) = utf8_validate_simple(del, 0, del.len)
    assert(c == del.len && !sc, "validate_simple: DEL is not simple")
    let (d, sd) = utf8_validate_simple(unicode, 0, unicode.len)
    assert(d == unicode.len && !sd, "validate_simple: non-ASCII is valid, not simple")
    let (e, se) = utf8_validate_simple(invalid, 0, invalid.len)
    assert(e == 1 && !se, "validate_simple: an invalid byte is reported")
}

fn t_utf8_validate_simple_checks_each_word_lane() {
    let len = 8 * 3 + 3
    var at = 0
    while at < len {
        var buf = List[byte]()
        var i = 0
        while i < len {
            (mut buf).push(97 as byte)
            i += 1
        }
        buf[at] = 10 as byte
        let (a, sa) = utf8_validate_simple(buf, 0, len)
        assert(a == len && sa, "word_lane: LF at {at} is simple")
        buf[at] = 9 as byte
        let (b, sb) = utf8_validate_simple(buf, 0, len)
        assert(b == len && !sb, "word_lane: TAB at {at} is not simple")
        buf[at] = 127 as byte
        let (c, sc) = utf8_validate_simple(buf, 0, len)
        assert(c == len && !sc, "word_lane: DEL at {at} is not simple")
        at += 1
    }
}

fn t_utf8_boundaries() {
    let input = bytes_of([65, 226, 130, 172, 128, 66])
    let expected = [true, true, false, false, true, true, true]
    var i = 0
    while i < expected.len {
        assert(utf8_is_boundary(input, 0, input.len, i) == expected[i], "boundaries: at {i}")
        i += 1
    }
    assert(!utf8_is_boundary(input, 0, input.len, input.len + 1), "boundaries: past the end")
}

fn t_utf8_exhaustive_scalars() {
    var cp = 0
    var out = List[byte]()
    while cp <= 1114111 {
        if cp >= 55296 && cp <= 57343 {
            cp += 1
            continue
        }
        (mut out).clear()
        let n = utf8_encode_into(mut out, cp)
        assert(n != 0, "exhaustive_scalars: {cp} encodes")
        assert(utf8_len(cp) == n, "exhaustive_scalars: len of {cp}")
        let (decoded, m) = utf8_decode(out, 0, out.len)
        assert(m == n && decoded == cp, "exhaustive_scalars: {cp} round-trips")
        cp += 1
    }
}

fn t_utf8_exhaustive_surrogates() {
    var cp = 55296
    var out = List[byte]()
    while cp <= 57343 {
        (mut out).clear()
        let n = utf8_encode_into(mut out, cp)
        if utf8_is_escape(cp) {
            assert(n == 1 && out[0] as int == cp - 56320, "exhaustive_surrogates: escape {cp}")
        } else {
            assert(n == 0, "exhaustive_surrogates: {cp} is unencodable")
        }
        cp += 1
    }
}

fn t_utf8_exhaustive_short_strings() {
    var a = 0
    while a <= 255 {
        assert_round_trip(bytes_of([a]), "short strings: one byte {a}")
        a += 1
    }
    a = 0
    while a <= 255 {
        var b = 0
        while b <= 255 {
            assert_round_trip(bytes_of([a, b]), "short strings: {a} {b}")
            b += 1
        }
        a += 1
    }
}

fn main() {
    t_utf8_valid_decode()
    t_utf8_reject_classes()
    t_utf8_illegal_leads_are_single_byte_escapes()
    t_utf8_overlong_boundary_forms_are_lossless()
    t_utf8_surrogate_boundary_forms_are_lossless()
    t_utf8_above_max_boundary_forms_are_lossless()
    t_utf8_non_escape_surrogate_edges_are_unencodable()
    t_utf8_validate_reports_earliest_error()
    t_utf8_truncated_decode()
    t_utf8_incremental_valid()
    t_utf8_incremental_recovery()
    t_utf8_incremental_finish()
    t_utf8_decode_prev()
    t_utf8_encode_edges()
    t_utf8_escape_helpers()
    t_utf8_validate()
    t_utf8_validate_simple_classifies_controls()
    t_utf8_validate_simple_checks_each_word_lane()
    t_utf8_boundaries()
    t_utf8_exhaustive_scalars()
    t_utf8_exhaustive_surrogates()
    t_utf8_exhaustive_short_strings()
}
