//! unicode.category — general-category and core-property bits, for the
//! regex engine's `\w`, `\d` and POSIX bracket classes (`search`).
//!
//! Ports sagitta `src/unicode/category.h` (61 lines: the `YEW_CAT_*` bits
//! and the inline two-level `yew_cat_rec`) and `category.c` (21:
//! `yew_cat_hi_lookup`) at 9ace98c2, under `s20-regex-engine.md` §3. The
//! data — `CAT_STAGE1`, `CAT_STAGE2`, `CAT_PAL`, `CAT_HI` and the counts —
//! is `tables_cat.lu`, GENERATED by `tools/gen-unicode-tables --category`
//! as `str` constants of 7-bit digits; this file is hand-written and
//! never regenerated (as `trie.lu` is to `tables.lu`).
//!
//! Why a table of its own (`category.h:7-14`): `\w` is Alphabetic ∪ Nd ∪
//! Pc and the POSIX classes are defined over general categories; answered
//! from the word-break data alone, Han (word-break Other) would fall out
//! of `\w` — right for W-mode motion, wrong for "match a letter".

/// The first codepoint the category range table serves
/// (`YEW_CAT_TRIE_HI`, `category.h:19`).
pub const CAT_TRIE_HI: int = 196608

/// log2 of the category stage-2 block size (`YEW_CAT_TRIE_SHIFT`).
pub const CAT_TRIE_SHIFT: int = 7

/// The category stage-2 block size (`YEW_CAT_TRIE_BLOCK`).
pub const CAT_TRIE_BLOCK: int = 128

/// Alphabetic, the derived core property (`YEW_CAT_ALPHA`,
/// `category.h:23-33`).
pub const CAT_ALPHA: int = 1

/// General category Nd.
pub const CAT_ND: int = 2

/// Uppercase.
pub const CAT_UPPER: int = 4

/// Lowercase.
pub const CAT_LOWER: int = 8

/// General category P* or S*.
pub const CAT_PUNCT: int = 16

/// General category Cc.
pub const CAT_CNTRL: int = 32

/// General category Zs.
pub const CAT_ZS: int = 64

/// General category Pc — connector punctuation (`_`).
pub const CAT_PC: int = 128

/// Assigned (any general category but Cn).
pub const CAT_ASSIGNED: int = 256

fn cat_digit(s: str, i: int) -> int {
    s.bytes()[i] as int
}

/// Category stage-1 entry `i` (`yew_cat_stage1[i]`).
pub fn cat_stage1(i: int) -> int {
    cat_digit(CAT_STAGE1, 2 * i) * 128 + cat_digit(CAT_STAGE1, 2 * i + 1)
}

/// Category stage-2 entry `i`: a palette index (`yew_cat_stage2[i]`).
pub fn cat_stage2(i: int) -> int {
    cat_digit(CAT_STAGE2, i)
}

/// Category palette record `i` (`yew_cat_pal[i]`).
pub fn cat_pal(i: int) -> int {
    cat_digit(CAT_PAL, 2 * i) * 128 + cat_digit(CAT_PAL, 2 * i + 1)
}

fn cat_hi_word(k: int) -> int {
    (cat_digit(CAT_HI, 3 * k) * 128 + cat_digit(CAT_HI, 3 * k + 1)) * 128 +
        cat_digit(CAT_HI, 3 * k + 2)
}

/// Category high range `i`: its first codepoint (`yew_cat_hi[i].lo`).
pub fn cat_hi_lo(i: int) -> int {
    cat_hi_word(3 * i)
}

/// Category high range `i`: its last codepoint (`yew_cat_hi[i].hi`).
pub fn cat_hi_hi(i: int) -> int {
    cat_hi_word(3 * i + 1)
}

/// Category high range `i`: its record (`yew_cat_hi[i].rec`).
pub fn cat_hi_rec(i: int) -> int {
    cat_hi_word(3 * i + 2)
}

/// The record of a codepoint at or above `CAT_TRIE_HI`, by binary search
/// over the range table (`yew_cat_hi_lookup`, `category.c:5-21`); 0
/// outside every range.
pub fn cat_hi_lookup(cp: int) -> int {
    var lo = 0
    var hi = CAT_HI_LEN
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if cp < cat_hi_lo(mid) {
            hi = mid
        } else if cp > cat_hi_hi(mid) {
            lo = mid + 1
        } else {
            return cat_hi_rec(mid)
        }
    }
    0
}

/// The category record of `cp`, the `CAT_*` bits (`yew_cat_rec`,
/// `category.h:49-59`).
pub fn cat_rec(cp: int) -> int {
    if cp < CAT_TRIE_HI {
        let block = cat_stage1(cp >> CAT_TRIE_SHIFT)
        let slot = cp & CAT_TRIE_BLOCK - 1
        return cat_pal(cat_stage2((block << CAT_TRIE_SHIFT) + slot))
    }
    cat_hi_lookup(cp)
}
