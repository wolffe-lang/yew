//! unicode.width — UAX #11 East-Asian width and emoji width, per
//! codepoint and per cluster, with clipping.
//!
//! Ports sagitta `src/unicode/width.c` (245 lines) and `width.h` (50)
//! at 9ace98c2, under `s02-unicode-foundation.md` §6: the ten-row
//! codepoint table (escape 4, TAB −1, C0 2, C1 4, SOFT HYPHEN 1,
//! zero-width 0, W/F 2, Emoji_Presentation 2, A by option, else 1) and
//! the six-row cluster table (starts with an escape 4, a flag pair 2,
//! VS16 on an Emoji base 2, VS15 the base ignoring Emoji_Presentation,
//! ZWJ with any ExtPict 2, else the base's width). The one knob is
//! `ambiguous_wide` (`YewWidthOpts`), a startup-only process option,
//! never the locale: `wcwidth` is banned (`s02` §10).
//!
//! The option is module state in C (`width.c:11`, `width_opts`). In
//! wolf a module `var` is raw-tier (`[mem.static.2]`): every read and
//! write sits in an `unsafe` block stating what keeps it race-free,
//! which here is invariant 8 — the core is single-threaded and no task
//! but the main one reads it. This is the port's one piece of module
//! state in campaign 00 (docs/MAP.md's `unsafe` census).

/// East_Asian_Width N (`YewEaw`, `width.h:6-13`).
pub const EAW_N: int = 0

/// East_Asian_Width Na.
pub const EAW_NA: int = 1

/// East_Asian_Width A (ambiguous).
pub const EAW_A: int = 2

/// East_Asian_Width W.
pub const EAW_W: int = 3

/// East_Asian_Width F.
pub const EAW_F: int = 4

/// East_Asian_Width H.
pub const EAW_H: int = 5

// The cluster-width state flags (`width.c:12-20`).
const CWF_SEEN: int = 1

const CWF_STARTS_ESCAPE: int = 2

const CWF_HAVE_BASE: int = 4

const CWF_VS15: int = 8

const CWF_VS16: int = 16

const CWF_ZWJ: int = 32

const CWF_EXT_PICT: int = 64

var ambiguous_wide: bool = false

/// Sets the ambiguous-width option (`yew_width_set_opts`,
/// `width.c:25-28`): a startup-only process option; `false` is the
/// deterministic default.
pub fn width_set_ambiguous_wide(wide: bool) {
    // # Safety: invariant 8 — the core is single-threaded, and this is
    // written at startup by the main task and read by it alone.
    unsafe {
        ambiguous_wide = wide
    }
}

/// Whether ambiguous-width codepoints take two cells
/// (`yew_width_ambiguous_wide`, `width.c:30-33`).
pub fn width_ambiguous_wide() -> bool {
    // # Safety: invariant 8 — one task reads module state it alone
    // wrote at startup.
    unsafe {
        ambiguous_wide
    }
}

/// The codepoint table, first match wins (`cp_width_record`,
/// `width.c:35-62`); `ignore_emoji_presentation` is the VS15 reading.
fn cp_width_record(cp: int, ignore_emoji_presentation: bool) -> int {
    if utf8_is_escape(cp) {
        return 4
    }
    if cp == 9 {
        return -1
    }
    if cp <= 31 || cp == 127 {
        return 2
    }
    if cp >= 128 && cp <= 159 {
        return 4
    }
    if cp == 173 {
        return 1
    }
    let rec = u_rec(cp)
    if rec & U_ZERO_WIDTH != 0 {
        return 0
    }
    let eaw = (rec & U_EAW_MASK) >> U_EAW_SHIFT
    if eaw == EAW_W || eaw == EAW_F {
        return 2
    }
    if !ignore_emoji_presentation && rec & U_EMOJI_PRESENTATION != 0 {
        return 2
    }
    if eaw == EAW_A {
        return if width_ambiguous_wide() then 2 else 1
    }
    1
}

/// The cells one codepoint takes (`yew_cp_width`, `width.c:64-67`):
/// −1 for TAB (the caller resolves the tab stop), else 0..4.
pub fn cp_width(cp: int) -> int {
    cp_width_record(cp, false)
}

/// The incremental cluster-width state (`YewClusterWidthState`,
/// `width.h:19-24`).
pub struct ClusterWidthState {
    base_cp: int,
    base_rec: int,
    flags: int,
    ri_count: int,
}

/// A fresh state (`yew_cluster_width_init`, `width.c:69-77`).
pub fn cluster_width_init() -> ClusterWidthState {
    ClusterWidthState { base_cp: 0, base_rec: 0, flags: 0, ri_count: 0 }
}

/// Absorbs one codepoint of the cluster (`yew_cluster_width_push`,
/// `width.c:79-110`).
pub fn cluster_width_push(mut state: ClusterWidthState, cp: int) {
    let rec = if utf8_is_escape(cp) then 0 else u_rec(cp)
    let gcb = rec & U_GCB_MASK
    if state.flags & CWF_SEEN == 0 {
        state.flags = state.flags | CWF_SEEN
        if utf8_is_escape(cp) {
            state.flags = state.flags | CWF_STARTS_ESCAPE
        }
    }
    if gcb == GCB_RI {
        if state.ri_count < 3 {
            state.ri_count += 1
        }
    }
    if cp == 65038 {
        state.flags = state.flags | CWF_VS15
    } else if cp == 65039 {
        state.flags = state.flags | CWF_VS16
    } else if cp == 8205 {
        state.flags = state.flags | CWF_ZWJ
    }
    if rec & U_EXT_PICT != 0 {
        state.flags = state.flags | CWF_EXT_PICT
    }
    if state.flags & CWF_HAVE_BASE == 0 && gcb != GCB_PREPEND {
        state.base_cp = cp
        state.base_rec = rec
        state.flags = state.flags | CWF_HAVE_BASE
    }
}

/// The cluster table, first match wins (`yew_cluster_width_finish`,
/// `width.c:112-134`).
pub fn cluster_width_finish(state: ClusterWidthState) -> int {
    if state.flags & CWF_SEEN == 0 {
        return 0
    }
    if state.flags & CWF_STARTS_ESCAPE != 0 {
        return 4
    }
    if state.ri_count == 2 {
        return 2
    }
    if state.flags & CWF_HAVE_BASE == 0 {
        return 0
    }
    if state.base_cp == 9 {
        return 0
    }
    if state.flags & CWF_VS16 != 0 && state.base_rec & U_EMOJI != 0 {
        return 2
    }
    if state.flags & CWF_VS15 != 0 {
        return cp_width_record(state.base_cp, true)
    }
    if state.flags & (CWF_ZWJ | CWF_EXT_PICT) == CWF_ZWJ | CWF_EXT_PICT {
        return 2
    }
    cp_width(state.base_cp)
}

/// The cells one already-segmented cluster `s[at..end)` takes
/// (`yew_cluster_width`, `width.c:136-152`): 0 for an empty range.
pub fn cluster_width(s: List[byte], at: int, end: int) -> int {
    if at >= end {
        return 0
    }
    var state = cluster_width_init()
    var pos = at
    while pos < end {
        let (cp, used) = utf8_decode(s, pos, end)
        cluster_width_push(mut state, cp)
        pos += used
    }
    cluster_width_finish(state)
}

fn cluster_end(s: List[byte], end: int, pos: int) -> int {
    let next = gb_next_bytes(s, end, pos)
    assert(next > pos && next <= end, "grapheme iterator returned an invalid boundary")
    next
}

/// The cells `s[at..end)` takes with tab stops every `tabw` cells
/// (`yew_str_width`, `width.c:163-209`); a `tabw` of 0 reads as 1. The
/// printable-ASCII prefix is bulk-counted up to its last byte, which
/// may own a following Unicode suffix (YEW-F-003).
pub fn str_width(s: List[byte], at: int, end: int, tabw: int) -> int {
    var tab = tabw
    if tab == 0 {
        tab = 1
    }
    var pos = at
    var cells = 0
    while pos < end {
        var ascii = pos
        while ascii < end && s[ascii] as int >= 32 && s[ascii] as int <= 126 {
            ascii += 1
        }
        if ascii != pos {
            if ascii != end {
                ascii -= 1
            }
        }
        if ascii != pos {
            cells += ascii - pos
            pos = ascii
            continue
        }
        let next = cluster_end(s, end, pos)
        var width = if next - pos == 1 && s[pos] as int == 9 {
            -1
        } else {
            cluster_width(s, pos, next)
        }
        if width < 0 {
            width = tab - cells % tab
        }
        cells += width
        pos = next
    }
    cells
}

/// Clips `s[at..end)` to at most `max_cells` without splitting a
/// cluster (`yew_str_clip`, `width.c:211-245`): answers `(bytes_kept,
/// cells)`. Labels have no tab-stop context, so a tab keeps one cell.
pub fn str_clip(s: List[byte], at: int, end: int, max_cells: int) -> (int, int) {
    if max_cells <= 0 {
        return (0, 0)
    }
    var pos = at
    var cells = 0
    while pos < end {
        let next = cluster_end(s, end, pos)
        let width = if next - pos == 1 && s[pos] as int == 9 then 1 else cluster_width(s, pos, next)
        if width > max_cells - cells {
            break
        }
        cells += width
        pos = next
    }
    (pos - at, cells)
}
