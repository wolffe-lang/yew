//! The port of sagitta `tests/unit/test_width.c` (222 lines), one test
//! per C test, in registry order (`registry.c:598-604`): the same
//! codepoints and strings; `t_width_golden` drives the same
//! `tests/fixtures/unicode/width_golden.txt`, copied verbatim.

use std.fs

fn bytes_of(xs: List[int]) -> List[byte] {
    var out = List[byte]()
    for x in xs {
        (mut out).push(x as byte)
    }
    out
}

fn hex_digit(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    -1
}

fn parse_hex_bytes(field: str) -> List[byte] {
    var out = List[byte]()
    for word in field.words() {
        var value = 0
        for b in word.bytes() {
            let d = hex_digit(b as int)
            assert(d >= 0, "golden: a hex byte")
            value = value * 16 + d
        }
        assert(value <= 255, "golden: a byte")
        (mut out).push(value as byte)
    }
    out
}

fn t_width_codepoints() {
    width_set_ambiguous_wide(false)
    assert(cp_width(65) == 1, "codepoints: A")
    assert(cp_width(9) == -1, "codepoints: TAB is -1")
    assert(cluster_width(bytes_of([9]), 0, 1) == 0, "codepoints: a TAB cluster is 0")
    assert(cp_width(0) == 2, "codepoints: NUL is ^@")
    assert(cp_width(127) == 2, "codepoints: DEL is ^?")
    assert(cp_width(133) == 4, "codepoints: a C1 control is <XX>")
    assert(cp_width(173) == 1, "codepoints: SOFT HYPHEN shows")
    assert(cp_width(769) == 0, "codepoints: a combining mark is 0")
    assert(cp_width(8205) == 0, "codepoints: ZWJ is 0")
    assert(cp_width(28450) == 2, "codepoints: Han is 2")
    assert(cp_width(128512) == 2, "codepoints: an emoji is 2")
    assert(cp_width(161) == 1, "codepoints: ambiguous is 1 by default")
    assert(cp_width(utf8_escape_of(255)) == 4, "codepoints: an escape is 4")

    width_set_ambiguous_wide(true)
    assert(cp_width(161) == 2, "codepoints: ambiguous is 2 when wide")
    assert(cp_width(65) == 1, "codepoints: A stays 1")
    width_set_ambiguous_wide(false)
}

fn t_width_invalid_byte_cluster_is_four_cells() {
    width_set_ambiguous_wide(false)
    let one = bytes_of([255])
    let two = bytes_of([255, 128])
    assert(cluster_width(one, 0, 1) == 4, "invalid_byte: one escape is 4")
    assert(str_width(two, 0, 2, 4) == 8, "invalid_byte: two escapes are 8")
}

fn t_width_ambiguous_option_is_reversible() {
    width_set_ambiguous_wide(false)
    assert(cp_width(161) == 1, "reversible: narrow")
    width_set_ambiguous_wide(true)
    assert(cp_width(161) == 2, "reversible: wide")
    width_set_ambiguous_wide(false)
    assert(cp_width(161) == 1, "reversible: narrow again")
}

fn t_width_golden() {
    let text = fs.read_text("tests/fixtures/unicode/width_golden.txt") else ""
    assert(
        text.len > 0,
        "golden: tests/fixtures/unicode/width_golden.txt is readable from the repository root",
    )
    var rows = 0
    for line in text.lines() {
        if line.len == 0 || line.starts_with("#") {
            continue
        }
        let cols = line.split("|")
        assert(cols.len == 4, "golden: four columns in '{line}'")
        let name = cols[0]
        let bytes = parse_hex_bytes(cols[1])
        let narrow = cols[2].trim().to_int() else -99
        let wide = cols[3].trim().to_int() else -99
        width_set_ambiguous_wide(false)
        assert(
            cluster_width(bytes, 0, bytes.len) == narrow,
            "golden {name}: narrow {cluster_width(bytes, 0, bytes.len)}, want {narrow}",
        )
        width_set_ambiguous_wide(true)
        assert(
            cluster_width(bytes, 0, bytes.len) == wide,
            "golden {name}: wide {cluster_width(bytes, 0, bytes.len)}, want {wide}",
        )
        rows += 1
    }
    assert(rows >= 60, "golden: at least 60 rows ({rows})")
    width_set_ambiguous_wide(false)
}

fn t_width_strings() {
    width_set_ambiguous_wide(false)
    let mixed = bytes_of([65, 9, 230, 188, 162])
    let keycap = bytes_of([49, 239, 184, 143, 226, 131, 163])
    let around_keycap = bytes_of([65, 49, 239, 184, 143, 226, 131, 163, 66])
    let clusters = bytes_of([101, 204, 129, 240, 159, 135, 186, 240, 159, 135, 184, 255])
    assert(str_width(List[byte](), 0, 0, 4) == 0, "strings: empty")
    assert(str_width(mixed, 0, mixed.len, 4) == 6, "strings: A TAB Han at tabw 4")
    assert(str_width(mixed, 0, mixed.len, 8) == 10, "strings: A TAB Han at tabw 8")
    assert(str_width(mixed, 0, mixed.len, 0) == 4, "strings: tabw 0 reads as 1")
    assert(str_width(clusters, 0, clusters.len, 4) == 7, "strings: e-acute, a flag, an escape")
    assert(str_width(keycap, 0, keycap.len, 4) == 2, "strings: a keycap")
    assert(str_width(around_keycap, 0, around_keycap.len, 4) == 4, "strings: A keycap B")
}

fn t_width_clip() {
    width_set_ambiguous_wide(false)
    let text = bytes_of([65, 230, 188, 162, 66, 240, 159, 145, 141, 240, 159, 143, 189, 67])
    let kept = [0, 1, 1, 4, 5, 5, 13, 14]
    let cells = [0, 1, 1, 3, 4, 4, 6, 7]
    var max_cells = 0
    while max_cells <= 7 {
        let (bytes, out_cells) = str_clip(text, 0, text.len, max_cells)
        assert(
            bytes == kept[max_cells],
            "clip: {max_cells} keeps {bytes} bytes, want {kept[max_cells]}",
        )
        assert(
            out_cells == cells[max_cells],
            "clip: {max_cells} fills {out_cells} cells, want {cells[max_cells]}",
        )
        assert(out_cells <= max_cells, "clip: never past max")
        max_cells += 1
    }
    let (tab_bytes, tab_cells) = str_clip(bytes_of([9, 65]), 0, 2, 1)
    assert(tab_bytes == 1 && tab_cells == 1, "clip: a tab keeps one cell")
    let (none_bytes, none_cells) = str_clip(text, 0, text.len, -1)
    assert(none_bytes == 0 && none_cells == 0, "clip: a negative budget keeps nothing")
}

fn t_width_clip_keeps_invalid_byte_atomic() {
    width_set_ambiguous_wide(false)
    let text = bytes_of([65, 255, 66])
    let (a, ca) = str_clip(text, 0, 3, 4)
    assert(a == 1 && ca == 1, "clip_atomic: 4 cells keep A alone")
    let (b, cb) = str_clip(text, 0, 3, 5)
    assert(b == 2 && cb == 5, "clip_atomic: 5 cells keep A and the escape")
}

fn main() {
    t_width_codepoints()
    t_width_invalid_byte_cluster_is_four_cells()
    t_width_ambiguous_option_is_reversible()
    t_width_golden()
    t_width_strings()
    t_width_clip()
    t_width_clip_keeps_invalid_byte_atomic()
}
