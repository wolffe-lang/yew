//! The port of sagitta `tests/unit/test_gbtest.c` (84 lines): the UAX
//! #29 conformance run over `tests/fixtures/unicode/GraphemeBreakTest.txt`
//! (UCD 16.0.0, verbatim; `÷` U+00F7 and `×` U+00D7 as UTF-8 bytes), the
//! segmenter's verdict asserted at every position of every case, and
//! the case count pinned at 1093 (`registry.c:597`).

use std.fs

fn is_blank(b: int) -> bool {
    b == 32 || b == 9
}

/// Reads a `÷` (true) or `×` (false) marker at `at` after blanks;
/// answers `(found, boundary, next)`.
fn take_marker(line: List[byte], at: int) -> (bool, bool, int) {
    var p = at
    while p < line.len && is_blank(line[p] as int) {
        p += 1
    }
    if p + 1 < line.len && line[p] as int == 195 {
        if line[p + 1] as int == 183 {
            return (true, true, p + 2)
        }
        if line[p + 1] as int == 151 {
            return (true, false, p + 2)
        }
    }
    (false, false, p)
}

fn hex_value(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    -1
}

fn t_graphemebreaktest_conformance() {
    let text = fs.read_bytes("tests/fixtures/unicode/GraphemeBreakTest.txt") else List[byte]()
    assert(text.len > 0, "gbtest: the fixture is readable from the repository root")
    var cases = 0
    var passed = 0
    var line_start = 0
    while line_start < text.len {
        var line_end = line_start
        while line_end < text.len && text[line_end] as int != 10 {
            line_end += 1
        }
        let line = text[line_start..line_end]
        line_start = line_end + 1

        var p = 0
        while p < line.len && is_blank(line[p] as int) {
            p += 1
        }
        if p >= line.len || line[p] as int == 35 || line[p] as int == 13 {
            continue
        }

        var state = gb_init()
        let (found, first_expected, after) = take_marker(line, p)
        assert(found, "gbtest: a case starts with a marker")
        var expected = first_expected
        p = after
        var case_ok = true
        var cps = 0
        loop {
            while p < line.len && is_blank(line[p] as int) {
                p += 1
            }
            if p >= line.len || line[p] as int == 35 || line[p] as int == 13 {
                break
            }
            var value = 0
            var digits = 0
            while p < line.len && hex_value(line[p] as int) >= 0 {
                value = value * 16 + hex_value(line[p] as int)
                digits += 1
                p += 1
            }
            assert(digits > 0 && value <= 1114111, "gbtest: a codepoint")
            let actual = gb_boundary(mut state, value)
            if actual != expected {
                case_ok = false
            }
            cps += 1
            let (again, next_expected, next) = take_marker(line, p)
            assert(again, "gbtest: a marker follows every codepoint")
            expected = next_expected
            p = next
        }
        assert(cps != 0, "gbtest: a case has codepoints")
        assert(expected, "gbtest: every row ends with eot division")
        cases += 1
        if case_ok {
            passed += 1
        }
    }
    assert(cases == 1093, "gbtest: 1093 cases ({cases})")
    assert(passed == cases, "gbtest: {passed}/{cases} cases pass")
    print("graphemebreaktest: {passed}/{cases} cases pass")
}

fn main() {
    t_graphemebreaktest_conformance()
}
