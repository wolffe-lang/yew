//! The cross-check of the generated `tables_cat.lu` against sagitta's
//! generated `tables_cat.c` (`tests/fixtures/unicode/tables_cat-c.txt`,
//! the C arrays in decimal as `tools/gen-unicode-tables --dump
//! --category` prints its own): every entry of stage1, stage2, the
//! palette and the high ranges equal, then the generator's spot checks
//! (sagitta `scripts/gen-unicode-tables.c:1269-1298`) through `cat_rec`.
//! sagitta has no such test (its generator and tables are one program's
//! output); this is the port's, as `tables_wb_test.lu` is for the
//! word-break trie.

use std.fs

fn cat_ints(field: str) -> List[int] {
    var out = List[int]()
    for word in field.words() {
        let n = word.to_int() else -1
        assert(n >= 0, "tables_cat-c: an int")
        (mut out).push(n)
    }
    out
}

fn t_tables_cat_match_sagitta() {
    let text = fs.read_text("tests/fixtures/unicode/tables_cat-c.txt") else ""
    assert(text.len > 0, "tables_cat-c: the fixture is readable from the repository root")
    var seen = 0
    for line in text.lines() {
        if line.starts_with("#") || line.trim().len == 0 {
            continue
        }
        let space = line.find(" ") else -1
        assert(space > 0, "tables_cat-c: a named line")
        let name = line[0..space]
        let rest = line[space + 1..]
        if name == "stage1" {
            let want = cat_ints(rest)
            assert(want.len == 1536, "tables_cat-c: stage1 has 1536 entries")
            var i = 0
            while i < want.len {
                assert(
                    cat_stage1(i) == want[i],
                    "cat stage1[{i}] is {cat_stage1(i)}, sagitta's {want[i]}",
                )
                i += 1
            }
            seen += 1
        } else if name == "stage2" {
            let want = cat_ints(rest)
            assert(
                want.len == CAT_STAGE2_BLOCKS * 128,
                "tables_cat-c: stage2 has {want.len} entries, the port {CAT_STAGE2_BLOCKS * 128}",
            )
            var i = 0
            while i < want.len {
                assert(
                    cat_stage2(i) == want[i],
                    "cat stage2[{i}] is {cat_stage2(i)}, sagitta's {want[i]}",
                )
                i += 1
            }
            seen += 1
        } else if name == "pal" {
            let want = cat_ints(rest)
            assert(
                want.len == CAT_PAL_LEN,
                "tables_cat-c: {want.len} palette entries, the port {CAT_PAL_LEN}",
            )
            var i = 0
            while i < want.len {
                assert(cat_pal(i) == want[i], "cat pal[{i}] is {cat_pal(i)}, sagitta's {want[i]}")
                i += 1
            }
            seen += 1
        } else if name == "hi" {
            let ranges = rest.words()
            assert(
                ranges.len == CAT_HI_LEN,
                "tables_cat-c: {ranges.len} high ranges, the port {CAT_HI_LEN}",
            )
            var i = 0
            while i < ranges.len {
                let parts = ranges[i].split(",")
                assert(parts.len == 3, "tables_cat-c: a range is lo,hi,rec")
                let lo = parts[0].to_int() else -1
                let hi = parts[1].to_int() else -1
                let rec = parts[2].to_int() else -1
                assert(
                    cat_hi_lo(i) == lo && cat_hi_hi(i) == hi && cat_hi_rec(i) == rec,
                    "cat hi[{i}] is ({cat_hi_lo(i)}, {cat_hi_hi(i)}, {cat_hi_rec(i)}), sagitta's ({lo}, {hi}, {rec})",
                )
                i += 1
            }
            seen += 1
        } else {
            assert(false, "tables_cat-c: an unknown line '{name}'")
        }
    }
    assert(seen == 4, "tables_cat-c: four arrays compared")
}

fn t_tables_cat_spot_checks() {
    // scripts/gen-unicode-tables.c:1273-1297, through the lookup.
    assert(
        cat_rec(65) & (CAT_ALPHA | CAT_UPPER) == CAT_ALPHA | CAT_UPPER,
        "spot: U+0041 Alphabetic+Upper",
    )
    assert(
        cat_rec(97) & (CAT_ALPHA | CAT_LOWER) == CAT_ALPHA | CAT_LOWER,
        "spot: U+0061 Alphabetic+Lower",
    )
    assert(cat_rec(48) & CAT_ND != 0, "spot: U+0030 is Nd")
    assert(cat_rec(95) & CAT_PC != 0, "spot: U+005F is Pc")
    assert(cat_rec(28450) & CAT_ALPHA != 0, "spot: U+6F22 (Han) is Alphabetic")
    assert(cat_rec(9) & CAT_CNTRL != 0, "spot: U+0009 is Cc")
    assert(cat_rec(32) & CAT_ZS != 0, "spot: U+0020 is Zs")
    assert(cat_rec(33) & CAT_PUNCT != 0, "spot: U+0021 is punctuation")
    assert(cat_rec(128512) & CAT_ASSIGNED != 0, "spot: U+1F600 is assigned")
    // Above the trie: the CJK extension G block, the tags, the private use
    // planes; nothing at all past them.
    assert(cat_rec(196608) & CAT_ALPHA != 0, "spot: U+30000 is Alphabetic")
    assert(cat_rec(917505) == CAT_ASSIGNED, "spot: U+E0001 is assigned only")
    assert(cat_rec(1114111) == 0, "spot: U+10FFFF has no record")
    assert(cat_rec(1114109) == CAT_ASSIGNED, "spot: U+10FFFD is assigned (Co)")
}

fn main() {
    t_tables_cat_match_sagitta()
    t_tables_cat_spot_checks()
    print("tables_cat_test: 2 cases pass")
}
