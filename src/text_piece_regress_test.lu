//! member: false
//!
//! The port of sagitta `tests/unit/test_piece_regress.c` (190 lines), one
//! test per C test in registry order (`tests/unit/registry.c:300-304`).
//! The two undo regressions build C's `EditCtx` literal (buffer, marks, a
//! one-cursor set, the tree) as the port's owning `EditCtx`. The snapshot
//! regression frees the live buffer first, as C does; the port's snapshot
//! then reads through the released buffer value, which keeps the stores
//! and the snapshot's nodes until the snapshot's own release (the
//! `text.piece` module doc).

use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

// `regress_materialize`, `test_piece_regress.c:8-24`.
fn materialize(tb: text.TextBuf) -> List[byte] {
    var out = List[byte]()
    var it = text.textiter_new()
    if text.textiter_begin(mut it, tb, text.byteoff(0)) {
        loop {
            let c = text.textiter_chunk(it, tb)
            assert(c.ok, "chunk")
            var i = 0
            while i < c.len {
                (mut out).push(text.store_byte(tb, c.src, c.at + i))
                i += 1
            }
            if !text.textiter_advance(mut it, tb) {
                break
            }
        }
    }
    out
}

// `regress_snap_materialize`, `test_piece_regress.c:26-43`.
fn snap_materialize(tb: text.TextBuf, snap: text.TextSnap) -> List[byte] {
    var out = List[byte]()
    var it = text.textiter_new()
    if text.textsnap_iter(mut it, tb, snap, text.byteoff(0)) {
        loop {
            let c = text.textiter_chunk(it, tb)
            assert(c.ok, "snapshot chunk")
            var i = 0
            while i < c.len {
                (mut out).push(text.store_byte(tb, c.src, c.at + i))
                i += 1
            }
            if !text.textiter_advance(mut it, tb) {
                break
            }
        }
    }
    out
}

// `regress_assert_text`, `test_piece_regress.c:45-53`.
fn assert_text(tb: text.TextBuf, want: str) {
    let got = materialize(tb)
    assert(got.len == want.len, "length of {want}")
    assert(same(got, bytes_of(want)), "text is {want}")
}

fn ctx(take tb: text.TextBuf, marks: text.MarkSet, win: int) -> text.EditCtx {
    let undo = text.undo_new(tb)
    var ec = text.editctx_new(take tb)
    ec.marks = copy marks
    ec.has_marks = true
    ec.cset = text.cset_init(text.Cursor { pos: 0, goal_col: 0, anchor: 0 })
    ec.has_cset = true
    ec.undo = undo
    ec.has_undo = true
    ec.win_id = win
    ec
}

fn t_piece_regress_exact_seam_roundtrip() {
    var tb = text.textbuf_from_str("abcdef")
    text.textbuf_insert_str(mut tb, text.byteoff(3), "X")
    text.textbuf_insert_str(mut tb, text.byteoff(3), "L")
    text.textbuf_insert_str(mut tb, text.byteoff(5), "R")
    assert_text(tb, "abcLXRdef")
    text.textbuf_delete(mut tb, text.span(2, 6))
    assert_text(tb, "abdef")
    text.textbuf_insert_str(mut tb, text.byteoff(2), "c")
    assert_text(tb, "abcdef")
    text.textbuf_check(tb)
}

fn t_piece_regress_delete_across_tree_branches() {
    var tb = text.textbuf_from_str("0123456789")
    text.textbuf_insert_str(mut tb, text.byteoff(2), "aa")
    text.textbuf_insert_str(mut tb, text.byteoff(8), "bb")
    text.textbuf_insert_str(mut tb, text.byteoff(5), "cc")
    assert_text(tb, "01aa2cc345bb6789")
    text.textbuf_delete(mut tb, text.span(3, 13))
    assert_text(tb, "01a789")
    text.textbuf_check(tb)
}

fn t_piece_regress_undo_branch_survives() {
    var f = ctx(take text.textbuf_from_str("root"), text.marks_new(), 3)
    text.undo_boundary(mut f.undo)
    let _ = text.edit_insert_str(mut f, text.byteoff(4), "A")
    let branch_a = text.undo_current(f.undo)
    assert_text(f.tb, "rootA")
    assert(text.undo(mut f), "undo")
    assert_text(f.tb, "root")
    text.undo_boundary(mut f.undo)
    let _ = text.edit_insert_str(mut f, text.byteoff(4), "B")
    assert_text(f.tb, "rootB")
    assert(text.undo_to(mut f, branch_a), "to branch a")
    assert_text(f.tb, "rootA")
}

fn t_piece_regress_snapshot_seam_release_orders() {
    var live = text.textbuf_from_str("left|right")
    var snap = text.textbuf_snap(mut live)
    text.textbuf_insert_str(mut live, text.byteoff(5), "A")
    text.textbuf_insert_str(mut live, text.byteoff(6), "B")
    text.textbuf_delete(mut live, text.span(4, 7))
    assert_text(live, "leftright")
    let got = snap_materialize(live, snap)
    assert(got.len == 10, "snapshot length")
    assert(same(got, bytes_of("left|right")), "snapshot text")
    text.textbuf_free(mut live)
    let after = snap_materialize(live, snap)
    assert(same(after, bytes_of("left|right")), "snapshot outlives the owner")
    text.textsnap_release(mut live, mut snap)
    assert(snap.root == -1, "root released")
}

fn t_piece_regress_undo_compact_zero_repair_run() {
    let tb = text.textbuf_from_str("abcdefgh")
    var marks = text.marks_new()
    let inside = text.mark_add(mut marks, text.byteoff(3), text.BIAS_RIGHT)
    var f = ctx(take tb, marks, 1)
    text.undo_begin(mut f, text.TXN_CUT)
    let _ = text.edit_delete(mut f, text.span(1, 5))
    text.undo_end(mut f)
    assert(text.mark_pos(f.marks, inside) as int == 1, "collapsed")
    assert(f.undo.repairs.len == 1, "one repair")
    text.undo_begin(mut f, text.TXN_PASTE)
    let at = text.textbuf_len(f.tb)
    let _ = text.edit_insert_str(mut f, text.byteoff(at), "X")
    text.undo_end(mut f)
    let node = copy f.undo.nodes[f.undo.cur - 1]
    let run = copy f.undo.repair_runs[node.ops_at]
    assert(node.rep_at == 1, "repairs at the arena end")
    assert(run.at == node.rep_at, "run at the node's offset")
    assert(run.len == 0, "empty run")
    assert(text.undo(mut f), "undo")
    assert(text.redo(mut f), "redo")
    assert_text(f.tb, "afghX")
    text.textbuf_check(f.tb)
}

fn main() {
    t_piece_regress_exact_seam_roundtrip()
    t_piece_regress_delete_across_tree_branches()
    t_piece_regress_undo_branch_survives()
    t_piece_regress_snapshot_seam_release_orders()
    t_piece_regress_undo_compact_zero_repair_run()
    print("piece_regress_test: 5 cases pass")
}
