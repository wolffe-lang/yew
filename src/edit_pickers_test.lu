//! member: false
//!
//! The port of sagitta `tests/unit/test_pickers.c` (510 lines), one test
//! per C test in registry order (`tests/unit/registry.c:2514-2523`): each
//! instance driven THROUGH the picker — open, filter, accept — the file
//! finder (a tab opened, the ignore file honoured), the preview creating
//! NOTHING (DoD 11: twenty reads, no buffer, no load), the binary preview,
//! the buffer switcher by TAB ID and its deferred tab hydrated on accept,
//! the undo branch picker over an INJECTED clock and its travel, the
//! registration of the four rows with the palette's two halves (a
//! registered probe run by name, a phrase found only in a help text
//! reopening `:`), and the symbol alias's registration.
//!
//! The port's shapes. C's fixture (`ps_make`, `:98-110`) is a `mkdtemp`
//! workspace `/tmp/yew-pickers-XXXXXX` holding the editor's root; here
//! `/tmp/yew-pickers-NNNNNN` and `ed.ws_dir`. C's palette probe is a
//! `HANDLER_PROBE` row (its calls the registry's `probe_calls`), C's
//! `yew_file_load_count_reset` the count read before. The symbol alias
//! (`:490-510`) asserts REGISTRATION only — both rows live, prompting,
//! needing a window, one handler — which yw11 does not change: the
//! handler itself is yw11's (the symbol index, Sprint 47) and refuses by
//! name until then.
//!
//! `YEW_PICK_CASE=N` runs case N alone (the checked machine's per-case
//! run, G29).

use edit
use term
use text

fn b(s: str) -> List[byte] {
    var v = List[byte]()
    for x in s.bytes() {
        (mut v).push(x)
    }
    v
}

fn fresh_dir(prefix: str) -> str {
    var tries = 0
    while tries < 100 {
        var suffix = ""
        for r in os_random(6) {
            suffix = suffix + "{r % 10}"
        }
        let dir = "/tmp/{prefix}-{suffix}"
        fs_create_dir_mode(dir, 448) else |e| match e {
            exists => {
                tries += 1
                continue
            },
            denied => { assert(false, "mkdtemp denied") },
            invalid => { assert(false, "mkdtemp invalid") },
            not_found => { assert(false, "mkdtemp not found") },
            unsupported => { assert(false, "mkdtemp unsupported") },
            io => { assert(false, "mkdtemp io") },
        }
        return dir
    }
    assert(false, "mkdtemp exhausted")
    ""
}

struct Fix {
    root: str,
    ed: edit.Ed,
}

// `ps_make` (`test_pickers.c:98-110`).
fn ps_make() -> Fix {
    let root = fresh_dir("yew-pickers")
    var ed = edit.ed_new()
    ed.ws_dir = root
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    Fix { root: root, ed: ed }
}

// `ps_remove` (`test_pickers.c:112-117`).
fn ps_remove(mut f: Fix) {
    edit.picker_close(mut f.ed, false)
    fs_remove_dir_all(f.root) else |_| {}
}

// `ps_file` (`test_pickers.c:78-88`).
fn ps_file(f: Fix, rel: str, body: str) {
    fs_write_bytes("{f.root}/{rel}", b(body)) else |_| {
        assert(false, "write {rel}")
    }
}

// `ps_dir` (`test_pickers.c:90-96`).
fn ps_dir(f: Fix, rel: str) {
    fs_create_dir_mode("{f.root}/{rel}", 448) else |_| {
        assert(false, "mkdir {rel}")
    }
}

const RUN_FILE: int = 0

const RUN_BUFFER: int = 1

const RUN_COMMAND: int = 2

const RUN_UNDO: int = 3

// `ps_run` (`test_pickers.c:119-126`): one of the four commands with a
// test context.
fn ps_run(mut f: Fix, which: int) -> int {
    let c = edit.cmdctx_new(f.ed.win, edit.SRC_TEST)
    if which == RUN_FILE {
        return edit.find_cmd_file(mut f.ed, c)
    }
    if which == RUN_BUFFER {
        return edit.find_cmd_buffer(mut f.ed, c)
    }
    if which == RUN_COMMAND {
        return edit.find_cmd_command(mut f.ed, c)
    }
    edit.undo_cmd_branches(mut f.ed, c)
}

// `ps_type` (`test_pickers.c:128-141`).
fn ps_type(mut f: Fix, s: str) {
    for c in s.bytes() {
        var k = term.key_new()
        k.code = c as int
        (mut k.text).push(c)
        assert(edit.picker_key(mut f.ed, k), "typed {c} consumed")
    }
}

// `ps_press` (`test_pickers.c:143-150`).
fn ps_press(mut f: Fix, code: int) {
    var k = term.key_new()
    k.code = code
    assert(edit.picker_key(mut f.ed, k), "key {code} consumed")
}

// `ps_finish_scan` (`test_pickers.c:152-156`).
fn ps_finish_scan(mut f: Fix) {
    while edit.picker_tick(mut f.ed) {}
}

// Three edits through the editor's edit context (`test_pickers.c:363-
// 374`, `:399-403`).
fn edit_insert(mut ed: edit.Ed, bytes: str) {
    let w = ed.win
    edit.ed_undo_begin(mut ed, w, text.TXN_TYPE)
    let x = b(bytes)
    assert(edit.ed_edit_insert(mut ed, w, 0, x, 0, x.len), "insert")
    edit.ed_undo_end(mut ed, w)
    edit.ed_finish_edit(mut ed, w)
}

// `test_pickers_file_finder_opens_a_tab` (`:172-201`).
fn pickers_file_finder_opens_a_tab() {
    var f = ps_make()
    ps_file(f, "alpha.c", "int a;\n")
    ps_dir(f, "src")
    ps_file(f, "src/tabs.c", "int t;\n")
    ps_file(f, "src/other.c", "int o;\n")
    let before = edit.tab_count(f.ed)
    assert(ps_run(mut f, RUN_FILE) == edit.CMD_OK, "the command")
    assert(edit.picker_active(f.ed), "up")
    assert(edit.picker_total(f.ed) == 3, "three files: {edit.picker_total(f.ed)}")
    ps_type(mut f, "tabs")
    assert(edit.picker_shown(f.ed) >= 1, "narrowed")
    ps_press(mut f, term.KEY_ENTER)
    assert(!edit.picker_active(f.ed), "down")
    assert(edit.tab_count(f.ed) == before + 1, "a new tab")
    assert(edit.tab_find_by_path(f.ed, "{f.root}/src/tabs.c") >= 0, "src/tabs.c is open")
    ps_remove(mut f)
}

// `test_pickers_file_finder_respects_gitignore` (`:204-217`).
fn pickers_file_finder_respects_gitignore() {
    var f = ps_make()
    ps_file(f, ".gitignore", "*.o\n")
    ps_file(f, "keep.c", "int k;\n")
    ps_file(f, "drop.o", "junk\n")
    assert(ps_run(mut f, RUN_FILE) == edit.CMD_OK, "the command")
    assert(edit.picker_total(f.ed) == 1, "keep.c only: {edit.picker_total(f.ed)}")
    ps_remove(mut f)
}

// `test_pickers_preview_allocates_no_buffer` (`:227-256`).
fn pickers_preview_allocates_no_buffer() {
    var f = ps_make()
    var i = 0
    while i < 20 {
        ps_file(f, if i < 10 then "f0{i}.c" else "f{i}.c", "line one\nline two\n")
        i += 1
    }
    assert(ps_run(mut f, RUN_FILE) == edit.CMD_OK, "the command")
    assert(edit.picker_total(f.ed) == 20, "twenty: {edit.picker_total(f.ed)}")
    let bufs_before = f.ed.bufs.len
    edit.pickers_preview_reset(mut f.ed)
    text.file_load_count_reset()
    i = 0
    while i < 20 {
        edit.pickers_preview_file(mut f.ed, i, edit.rect(0, 0, 40, 10))
        i += 1
    }
    assert(
        edit.pickers_preview_reads(f.ed) == 20,
        "twenty reads: {edit.pickers_preview_reads(f.ed)}",
    )
    assert(f.ed.bufs.len == bufs_before, "no buffer")
    assert(text.file_load_count() == 0, "not one went through the loader")
    ps_remove(mut f)
}

// `test_pickers_preview_reports_a_binary_file` (`:260-279`).
fn pickers_preview_reports_a_binary_file() {
    var f = ps_make()
    var blob = List[byte]()
    for x in "ab".bytes() {
        (mut blob).push(x)
    }
    (mut blob).push(0 as byte)
    for x in "cd".bytes() {
        (mut blob).push(x)
    }
    fs_write_bytes("{f.root}/blob.bin", blob) else |_| {
        assert(false, "write blob.bin")
    }
    assert(ps_run(mut f, RUN_FILE) == edit.CMD_OK, "the command")
    edit.pickers_preview_reset(mut f.ed)
    edit.pickers_preview_file(mut f.ed, 0, edit.rect(0, 0, 40, 10))
    assert(edit.pickers_preview_reads(f.ed) == 1, "one read")
    ps_remove(mut f)
}

// `test_pickers_buffer_switcher_uses_tab_ids` (`:289-318`).
fn pickers_buffer_switcher_uses_tab_ids() {
    var f = ps_make()
    ps_file(f, "a.c", "int a;\n")
    ps_file(f, "b.c", "int b;\n")
    let t_a = edit.tab_open(mut f.ed, "{f.root}/a.c")
    let t_b = edit.tab_open(mut f.ed, "{f.root}/b.c")
    assert(t_a >= 0 && t_b >= 0, "two tabs")
    let id_b = f.ed.tabs[t_b].tab_id
    assert(ps_run(mut f, RUN_BUFFER) == edit.CMD_OK, "the command")
    assert(edit.picker_total(f.ed) == 3, "the scratch tab and two files: {edit.picker_total(f.ed)}")
    ps_type(mut f, "b.c")
    assert(edit.picker_selected(f.ed) == id_b, "the tab's ID: {edit.picker_selected(f.ed)}")
    ps_press(mut f, term.KEY_ENTER)
    assert(f.ed.tabs[f.ed.tab_active].tab_id == id_b, "switched to it")
    ps_remove(mut f)
}

// `test_pickers_buffer_switcher_marks_deferred_tabs` (`:324-345`).
fn pickers_buffer_switcher_marks_deferred_tabs() {
    var f = ps_make()
    ps_file(f, "a.c", "int a;\n")
    let t = edit.tab_open(mut f.ed, "{f.root}/a.c")
    assert(t >= 0, "a tab")
    assert(!edit.tab_is_resident(f.ed, t), "not resident yet")
    assert(ps_run(mut f, RUN_BUFFER) == edit.CMD_OK, "the command")
    ps_type(mut f, "a.c")
    ps_press(mut f, term.KEY_ENTER)
    assert(edit.tab_is_resident(f.ed, t), "accepting hydrated it")
    ps_remove(mut f)
}

// `test_pickers_undo_branches_lists_the_tree` (`:355-389`).
fn pickers_undo_branches_lists_the_tree() {
    var f = ps_make()
    var i = 0
    while i < 3 {
        edit_insert(mut f.ed, "x")
        i += 1
    }
    edit.pickers_set_now(mut f.ed, 1700000000)
    assert(ps_run(mut f, RUN_UNDO) == edit.CMD_OK, "the command")
    assert(edit.picker_active(f.ed), "up")
    let total_a = edit.picker_total(f.ed)
    assert(total_a >= 2, "a tree: {total_a}")
    edit.picker_close(mut f.ed, false)
    assert(ps_run(mut f, RUN_UNDO) == edit.CMD_OK, "again")
    assert(edit.picker_total(f.ed) == total_a, "the same list")
    edit.pickers_set_now(mut f.ed, 0)
    ps_remove(mut f)
}

// `test_pickers_undo_branches_travels_to_a_state` (`:392-416`).
fn pickers_undo_branches_travels_to_a_state() {
    var f = ps_make()
    edit_insert(mut f.ed, "hello")
    let d = edit.ed_doc(f.ed)
    assert(text.textbuf_len(f.ed.bufs[d].ec.tb) == 5, "five bytes")
    edit.pickers_set_now(mut f.ed, 1700000000)
    assert(ps_run(mut f, RUN_UNDO) == edit.CMD_OK, "the command")
    ps_press(mut f, term.KEY_HOME)
    ps_press(mut f, term.KEY_ENTER)
    assert(!edit.picker_active(f.ed), "down")
    assert(
        text.textbuf_len(f.ed.bufs[d].ec.tb) == 0,
        "back to the root: {text.textbuf_len(f.ed.bufs[d].ec.tb)}",
    )
    edit.pickers_set_now(mut f.ed, 0)
    ps_remove(mut f)
}

// `test_pickers_commands_are_registered` (`:422-488`).
fn pickers_commands_are_registered() {
    var f = ps_make()
    for name in "ed.find.file|ed.find.buffer|ed.find.command|ed.undo.branches".split("|") {
        let id = edit.cmd_lookup(f.ed.reg, name)
        assert(id != 0, "{name} registered")
        assert(edit.cmd_active(f.ed.reg, id), "{name} live")
        assert(f.ed.reg.entries[id - 1].flags & edit.CMD_DEFERRED == 0, "{name} not deferred")
    }
    ps_remove(mut f)
    // The palette runs a registered command by name.
    var g = ps_make()
    let probe = edit.CmdDesc {
        name: "ed.ui.toggle",
        handler: edit.HANDLER_PROBE,
        impl_id: 0,
        arity: edit.ARITY_NONE,
        flags: 0,
        help: "Palette execution probe",
        word: "",
        has_word: false,
    }
    let _ = edit.cmd_register(mut g.ed.reg, probe)
    g.ed.reg.probe_calls = 0
    assert(ps_run(mut g, RUN_COMMAND) == edit.CMD_OK, "the palette")
    ps_type(mut g, "Palette execution probe")
    ps_finish_scan(mut g)
    assert(edit.picker_shown(g.ed) == 1, "one row: {edit.picker_shown(g.ed)}")
    ps_press(mut g, term.KEY_ENTER)
    assert(g.ed.reg.probe_calls == 1, "it ran: {g.ed.reg.probe_calls}")
    assert(!edit.picker_active(g.ed), "down")
    ps_remove(mut g)
    // A phrase found only in a help text: the palette searches the help.
    var h = ps_make()
    assert(ps_run(mut h, RUN_COMMAND) == edit.CMD_OK, "the palette")
    ps_type(mut h, "syntax language")
    ps_finish_scan(mut h)
    assert(edit.picker_shown(h.ed) == 1, "one row: {edit.picker_shown(h.ed)}")
    assert(edit.picker_selected(h.ed) == edit.cmd_lookup(h.ed.reg, "ed.syn.set"), "ed.syn.set")
    ps_press(mut h, term.KEY_ENTER)
    assert(!edit.picker_active(h.ed), "down")
    assert(h.ed.cmdline.active, "the prompt reopened")
    assert(h.ed.cmdline.kind == edit.PROMPT_CMD, "a command prompt")
    let t = edit.cmdline_text(h.ed)
    let want = "syn.set "
    assert(t.len == want.len, "seeded: {t.len} bytes")
    var k = 0
    while k < t.len {
        assert(t[k] as int == want.bytes()[k] as int, "seed byte {k}")
        k += 1
    }
    ps_remove(mut h)
}

// `test_pickers_symbol_alias_is_live` (`:490-510`).
fn pickers_symbol_alias_is_live() {
    let ed = edit.ed_new()
    let id = edit.cmd_lookup(ed.reg, "ed.find.symbol")
    let lsp_id = edit.cmd_lookup(ed.reg, "ed.lsp.symbols")
    assert(id != 0, "ed.find.symbol registered")
    assert(lsp_id != 0, "ed.lsp.symbols registered")
    assert(edit.cmd_active(ed.reg, id), "live")
    let e = edit.cmd_entry(ed.reg, id)
    assert(e.flags & edit.CMD_DEFERRED == 0, "not deferred")
    assert(e.flags & edit.CMD_PROMPTS != 0, "prompts")
    assert(e.flags & edit.CMD_NEEDS_WIN != 0, "needs a window")
    let l = edit.cmd_entry(ed.reg, lsp_id)
    assert(
        e.c_handler == l.c_handler && e.impl_id == l.impl_id,
        "one handler: {e.c_handler} / {l.c_handler}",
    )
}

fn main() {
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    var n = 0
    if chosen < 0 || chosen == 0 {
        pickers_file_finder_opens_a_tab()
        print("pickers_file_finder_opens_a_tab: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 1 {
        pickers_file_finder_respects_gitignore()
        print("pickers_file_finder_respects_gitignore: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 2 {
        pickers_preview_allocates_no_buffer()
        print("pickers_preview_allocates_no_buffer: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 3 {
        pickers_preview_reports_a_binary_file()
        print("pickers_preview_reports_a_binary_file: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 4 {
        pickers_buffer_switcher_uses_tab_ids()
        print("pickers_buffer_switcher_uses_tab_ids: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 5 {
        pickers_buffer_switcher_marks_deferred_tabs()
        print("pickers_buffer_switcher_marks_deferred_tabs: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 6 {
        pickers_undo_branches_lists_the_tree()
        print("pickers_undo_branches_lists_the_tree: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 7 {
        pickers_undo_branches_travels_to_a_state()
        print("pickers_undo_branches_travels_to_a_state: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 8 {
        pickers_commands_are_registered()
        print("pickers_commands_are_registered: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 9 {
        pickers_symbol_alias_is_live()
        print("pickers_symbol_alias_is_live: PASS")
        n += 1
    }
    print("pickers_test: {n} cases pass")
}
