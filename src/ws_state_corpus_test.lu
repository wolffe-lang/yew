//! member: false
//! sagitta 9ace98c2 tests/unit/test_state_corpus.c:679-1167.
//! Pure corpus gates; invalid-editor survival and live regeneration belong to edit.

use ws

const CANONICAL: str = "01-minimal.fl|02-one-tab.fl|03-all-defaults.fl|04-all-present.fl|05-group-ids-7-9-12.fl|06-orphan-path.fl|07-invalid-utf8-path.fl|08-control-bytes-path.fl|09-two-panes.fl|10-sixteen-leaves.fl|11-full-jumplist.fl|12-three-groups.fl|13-empty-group.fl|14-file-record-without-tab.fl|15-ratio-minimum.fl|16-ratio-maximum.fl|17-many-cursors.fl|18-maximal-512-tabs.fl|19-with-scratch-tab.fl|20-goal-eol.fl|21-cjk-path.fl|22-deep-pane-tree.fl"

const NONCANONICAL: str = "noncanonical/comments.fl|noncanonical/minimal-fields.fl|noncanonical/unknown-keys.fl|noncanonical/whitespace.fl"

const INVALID: str = "invalid/binary-junk.fl|invalid/depth-33.fl|invalid/empty-element.fl|invalid/empty.fl|invalid/integer-overflow.fl|invalid/lone-close.fl|invalid/missing-comma.fl|invalid/missing-key.fl|invalid/missing-value.fl|invalid/rejected-escape.fl|invalid/root-is-a-list.fl|invalid/root-is-nil.fl|invalid/trailing-bytes.fl|invalid/truncated-mid-record.fl|invalid/truncated-open-map.fl|invalid/two-documents.fl|invalid/unterminated-string.fl|invalid/version-99.fl|invalid/version-absent.fl|invalid/version-is-a-string.fl"

fn bytes_equal(a: List[byte], b: List[byte]) -> bool {
    ws.fl_span_equal(a, ws.FlSpan { at: 0, len: a.len }, b, ws.FlSpan { at: 0, len: b.len })
}

fn contains(bytes: List[byte], needle: str) -> bool {
    var i = 0
    while i + needle.len <= bytes.len {
        if ws.fl_span_equal(bytes, ws.FlSpan { at: i, len: needle.len }, needle.bytes(), ws.FlSpan { at: 0, len: needle.len }) { return true }
        i += 1
    }
    false
}

fn load(name: str) -> List[byte] {
    fs_read_bytes("tests/unit/fixtures/wsstate/v1/{name}") else {
        assert(false, "read fixture {name}")
        List[byte]()
    }
}

fn selected(name: str) -> bool {
    let only = env_get("YEW_CODEC_FIXTURE") else ""
    only.len == 0 || name == only
}

fn t_canonical() {
    var count = 0
    for name in CANONICAL.split("|") {
        count += 1
        if !selected(name) { continue }
        region fixture {
            let raw = load(name)
            let r = ws.fl_parse(raw, 0, raw.len)
            assert(r.ok, "{name}: {r.err.line}:{r.err.col}: {r.err.msg}")
            assert(ws.state_validate_v1(r.doc), "{name}: v1")
            assert((ws.fl_get(r.doc, r.doc.root, "tabs".bytes()) else -1) >= 0)
            assert((ws.fl_get(r.doc, r.doc.root, "files".bytes()) else -1) >= 0)
            let once = ws.fl_reemit(r.doc)
            assert(bytes_equal(raw, once), "{name}: frozen canonical bytes")
            let second = ws.fl_parse(once, 0, once.len)
            assert(second.ok)
            let twice = ws.fl_reemit(second.doc)
            assert(bytes_equal(once, twice), "{name}: idempotent")
            assert(!contains(raw, "yewu-v"), "undo payload must be separate")
            // No literal kind can hold a float. This checks the parsed data,
            // rather than mistaking a dot in a byte string for float text.
            for node in r.doc.nodes { assert(node.kind >= 0 && node.kind <= 5) }
        }
    }
    assert(count == 22)
}

fn t_noncanonical() {
    var count = 0
    for name in NONCANONICAL.split("|") {
        count += 1
        if !selected(name) { continue }
        region fixture {
            let raw = load(name)
            let r = ws.fl_parse(raw, 0, raw.len)
            assert(r.ok && ws.state_validate_v1(r.doc), name)
            let once = ws.fl_reemit(r.doc)
            let second = ws.fl_parse(once, 0, once.len)
            assert(second.ok)
            let twice = ws.fl_reemit(second.doc)
            assert(bytes_equal(once, twice), name)
            if name == "noncanonical/comments.fl" {
                assert(!contains(once, "#") && !contains(once, "note to self"))
                assert(contains(once, "/w/a.txt") && contains(once, "deferred: true,"))
            }
            if name == "noncanonical/unknown-keys.fl" {
                for key in "from.the.future|editor.theme|midnight|a_whole_section_from_v2|a_field_this_build_never_heard_of|unknown_tab_field".
                    split("|") {
                    assert(contains(once, key), key)
                }
            }
        }
    }
    assert(count == 4)
}

fn t_invalid() {
    var count = 0
    var syntax = 0
    for name in INVALID.split("|") {
        count += 1
        if !selected(name) { continue }
        region fixture {
            let raw = load(name)
            let r = ws.fl_parse(raw, 0, raw.len)
            assert(!r.ok || !ws.state_validate_v1(r.doc), name)
            if !r.ok {
                assert(r.err.line >= 1 && r.err.col >= 1, name)
                syntax += 1
            }
        }
    }
    assert(count == 20)
    if (env_get("YEW_CODEC_FIXTURE") else "") == "" { assert(syntax == 15) }
}

fn t_source_has_no_float_conversions() {
    for name in "fllit|fl_parse|fl_emit|state_lit".split("|") {
        let src = fs_read_bytes("src/ws/{name}.lu") else {
            assert(false, "read source")
            List[byte]()
        }
        for bad in "%f|%g|%e|strtod|strtof|atof".split("|") {
            assert(!contains(src, bad), "{name}: forbidden conversion")
        }
    }
}

fn main() {
    assert((env_get("YEW_WSSTATE_UPDATE") else "") == "", "frozen corpus must not regenerate")
    t_canonical()
    t_noncanonical()
    t_invalid()
    t_source_has_no_float_conversions()
    let only = env_get("YEW_CODEC_FIXTURE") else ""
    if only.len == 0 {
        print(
            "ws_state_corpus: 22 canonical / 4 noncanonical / 20 invalid (15 syntax, 5 schema) ok",
        )
    } else {
        print("ws_state_corpus: {only} ok")
    }
}
