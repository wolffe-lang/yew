//! member: false
//!
//! The port of sagitta `tests/unit/test_comphelp.c` (1,459 lines), one
//! test per C test in registry order. The parser runs against the help
//! text sagitta captured once from real tools (`tests/fixtures/help/`,
//! sagitta's `tests/unit/fixtures/help/` verbatim, each `.txt` beside the
//! `.expect` tree it must parse to); no test runs those tools.
//!
//! The cases that RUN `--help` drive the help job through the job layer
//! (its pipes read while the loop runs, wolf 0.2.34's
//! `os_signal_wait_fds`). Their tool is C's `tests/helpers/help_fixture.c`
//! — a NATIVE executable whose `--help` a test controls through files
//! beside it — and the port's is this binary itself: `tool_install`
//! copies `os_exe()` onto the fixture PATH and `YEW_HELPFIX=1` in the
//! environment the jobs inherit makes a copy behave as C's fixture
//! (`help_fixture_main`). Under `wolf test` `os_exe()` is `wolf` (G23),
//! so those thirteen SKIP by name there and the native run covers them.
//! Four port-only cases prove a cache file in C's own form is read: a hit,
//! a negative, a torn file, and the forget.

use edit
use std.fs
use std.signal
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

const FIX: str = "tests/fixtures/help/"

/// `dump_node` (`test_comphelp.c:64-98`): the root's tree as text.
fn dump_spec(ok: bool, spec: edit.CompSpec) -> str {
    if !ok {
        return "negative\n"
    }
    var b = ""
    let root = copy spec.nodes[0]
    for si in root.subs {
        let s = copy spec.nodes[si]
        b += "sub {s.name}"
        var k = 0
        while k < s.aliases.len {
            b += if k == 0 then " alias=" else ","
            b += s.aliases[k]
            k += 1
        }
        b += " | {if s.has_desc then s.desc else ""}\n"
    }
    for f in root.flags {
        b += "flag"
        if f.has_shrt {
            b += " -{f.shrt}"
        }
        if f.has_lng {
            b += " --{f.lng}"
        }
        if f.arg >= 0 {
            b += " arg={edit.spec_arg_kind_name(spec.args[f.arg].kind)}"
            var k = 0
            while k < spec.args[f.arg].values.len {
                b += if k == 0 then ":" else ","
                b += spec.args[f.arg].values[k].value
                k += 1
            }
        }
        if f.arg_optional {
            b += " optional"
        }
        if f.global {
            b += " global"
        }
        b += " | {if f.has_desc then f.desc else ""}\n"
    }
    b
}

fn words_of(ws: List[str]) -> List[str] {
    copy ws
}

fn one(a: str) -> List[str] {
    var v = List[str]()
    (mut v).push(a)
    v
}

fn two(a: str, b: str) -> List[str] {
    var v = one(a)
    (mut v).push(b)
    v
}

fn parse_file(file: str, words: List[str]) -> (bool, edit.CompSpec) {
    let b = fs.read_bytes("{FIX}{file}") else |_| {
        assert(false, "fixture {file}")
        return (false, edit.compspec_new(""))
    }
    edit.comphelp_parse("help:test", words, b)
}

// §3: every layout against its captured text (`test_comphelp.c:157-225`).
fn t_comphelp_parses_every_layout_fixture() {
    var files = List[str]()
    var ws = List[List[str]]()
    for row in [
        "shithub.txt shithub",
        "shithub-auth.txt shithub auth",
        "lupin.txt lupin",
        "fac.txt fac",
        "fackr.txt fackr",
        "clap-starship.txt starship",
        "clap-uv.txt uv",
        "cobra-colima.txt colima",
        "cobra-colima-start.txt colima start",
        "cobra-kubectl.txt kubectl",
        "argparse-wheel.txt wheel3",
        "argparse-rapid-mlx.txt rapid-mlx",
        "click-app.txt clickapp",
        "commander-vsce.txt vsce",
        "gnu-ls.txt gls",
        "goflag-gofmt.txt gofmt",
        "custom-wolf.txt wolf",
        "yargs-opencode.txt opencode",
        "bsd-cp.txt cp",
        "hostile-ansi.txt clickapp",
        "hostile-overstrike.txt tool",
        "hostile-crlf.txt clickapp",
        "hostile-utf8.txt tool",
    ] {
        let parts = row.words()
        (mut files).push(parts[0])
        var w = List[str]()
        var i = 1
        while i < parts.len {
            (mut w).push(parts[i])
            i += 1
        }
        (mut ws).push(w)
    }
    var i = 0
    var bad = 0
    while i < files.len {
        let (ok, spec) = parse_file(files[i], ws[i])
        let got = dump_spec(ok, spec)
        let want = fs.read_text("{FIX}{files[i]}.expect") else ""
        if got != want {
            eprint("comphelp: {files[i]} parsed to\n{got}")
            bad += 1
        }
        i += 1
    }
    assert(bad == 0, "{bad} layouts differ from their .expect")
}

fn count_subs(ok: bool, spec: edit.CompSpec) -> int {
    if ok then spec.nodes[0].subs.len else 0
}

fn flag_long(spec: edit.CompSpec, l: str) -> int {
    var i = 0
    while i < spec.nodes[0].flags.len {
        if spec.nodes[0].flags[i].has_lng && spec.nodes[0].flags[i].lng == l {
            return i
        }
        i += 1
    }
    -1
}

fn sub_named(spec: edit.CompSpec, s: str) -> int {
    for si in spec.nodes[0].subs {
        if spec.nodes[si].name == s {
            return si
        }
    }
    -1
}

// DoD 1 (`test_comphelp.c:255-287`).
fn t_comphelp_user_tools_behave_as_stated() {
    let (so, s) = parse_file("shithub.txt", one("shithub"))
    let (lo, l) = parse_file("lupin.txt", one("lupin"))
    let (fo, f) = parse_file("fac.txt", one("fac"))
    let (ko, _) = parse_file("fackr.txt", one("fackr"))
    assert(so, "shithub parses")
    assert(count_subs(so, s) >= 20 && count_subs(so, s) == 28, "28 subcommands")
    assert(sub_named(s, "attestation") >= 0 && sub_named(s, "ssh-key") >= 0, "attestation, ssh-key")
    assert(lo && count_subs(lo, l) == 13 && sub_named(l, "conform-run") >= 0, "lupin")
    assert(fo && count_subs(fo, f) == 0 && flag_long(f, "version") >= 0, "fac: flags only")
    assert(!ko, "fackr is negative")
}

// The classifications §3 names (`test_comphelp.c:290-390`).
fn t_comphelp_classifies_terms() {
    let (u_ok, uv) = parse_file("clap-uv.txt", one("uv"))
    assert(u_ok, "uv")
    var fl = flag_long(uv, "color")
    assert(fl >= 0 && uv.nodes[0].flags[fl].arg >= 0, "--color takes a value")
    let ca = uv.nodes[0].flags[fl].arg
    assert(
        uv.args[ca].kind == edit.SPEC_ARG_VALUES &&
            uv.args[ca].values.len == 3 &&
            uv.args[ca].values[1].value == "always",
        "color's values",
    )
    fl = flag_long(uv, "directory")
    assert(
        fl >= 0 &&
            uv.nodes[0].flags[fl].arg >= 0 &&
            uv.args[uv.nodes[0].flags[fl].arg].kind == edit.SPEC_ARG_DIR,
        "--directory is a dir",
    )
    fl = flag_long(uv, "config-file")
    assert(
        fl >= 0 &&
            uv.nodes[0].flags[fl].arg >= 0 &&
            uv.args[uv.nodes[0].flags[fl].arg].kind == edit.SPEC_ARG_PATH,
        "--config-file is a path",
    )
    fl = flag_long(uv, "quiet")
    assert(
        fl >= 0 &&
            uv.nodes[0].flags[fl].arg < 0 &&
            uv.nodes[0].flags[fl].has_shrt &&
            uv.nodes[0].flags[fl].shrt == "q" &&
            uv.nodes[0].flags[fl].global,
        "-q, --quiet...",
    )

    let (g_ok, gofmt) = parse_file("goflag-gofmt.txt", one("gofmt"))
    assert(g_ok, "gofmt")
    fl = flag_long(gofmt, "cpuprofile")
    assert(
        fl >= 0 &&
            gofmt.nodes[0].flags[fl].arg >= 0 &&
            gofmt.args[gofmt.nodes[0].flags[fl].arg].kind == edit.SPEC_ARG_NONE &&
            gofmt.nodes[0].flags[fl].has_desc,
        "Go's -name type",
    )

    let (l_ok, gls) = parse_file("gnu-ls.txt", one("gls"))
    assert(l_ok, "gls")
    fl = flag_long(gls, "color")
    assert(
        fl >= 0 && gls.nodes[0].flags[fl].arg >= 0 && gls.nodes[0].flags[fl].arg_optional,
        "--color[=WHEN]",
    )
    fl = flag_long(gls, "block-size")
    assert(
        fl >= 0 && gls.nodes[0].flags[fl].arg >= 0 && !gls.nodes[0].flags[fl].arg_optional,
        "--block-size=SIZE",
    )
    assert(count_subs(l_ok, gls) == 0, "gls has no subcommands")

    let (_, vsce) = parse_file("commander-vsce.txt", one("vsce"))
    let ps = sub_named(vsce, "package")
    assert(
        ps >= 0 && vsce.nodes[ps].aliases.len == 1 && vsce.nodes[ps].aliases[0] == "pack",
        "package|pack",
    )

    let (r_ok, rapid) = parse_file("argparse-rapid-mlx.txt", one("rapid-mlx"))
    let cs = sub_named(rapid, "chat")
    assert(
        cs >= 0 && rapid.nodes[cs].aliases.len == 1 && rapid.nodes[cs].aliases[0] == "run",
        "chat (run)",
    )
    assert(count_subs(r_ok, rapid) == 17, "17 subcommands")

    let text = "positional arguments:\n  {{run,chat,serve}}\n    chat (run)   Interactive chat\n    serve        Start a server\n"
    let (o_ok, order) = edit.comphelp_parse("help:order", one("tool"), bytes_of(text))
    assert(count_subs(o_ok, order) == 2, "two subcommands")
    let oc = sub_named(order, "chat")
    assert(
        oc >= 0 &&
            order.nodes[oc].aliases.len == 1 &&
            order.nodes[oc].aliases[0] == "run" &&
            order.nodes[oc].has_desc &&
            order.nodes[oc].desc == "Interactive chat",
        "the folded alias keeps its row",
    )
    assert(order.nodes[sub_named(order, "serve")].desc == "Start a server", "serve")

    let (c_ok, colima) = parse_file("cobra-colima-start.txt", two("colima", "start"))
    assert(c_ok && count_subs(c_ok, colima) == 0, "colima start")
    fl = flag_long(colima, "verbose")
    assert(fl >= 0 && colima.nodes[0].flags[fl].global, "Global Flags are global")
    fl = flag_long(colima, "arch")
    assert(
        fl >= 0 && !colima.nodes[0].flags[fl].global && colima.nodes[0].flags[fl].arg >= 0,
        "--arch",
    )
}

// Hostile inputs (`test_comphelp.c:393-434`).
fn t_comphelp_survives_huge_and_blank_inputs() {
    var b = bytes_of("Commands:\n")
    var i = 0
    while b.len < 300 * 1024 {
        let n = "{i}"
        var pad = ""
        var k = n.len
        while k < 5 {
            pad += "0"
            k += 1
        }
        for x in "  cmd{pad}{n}    row number {i} of many\n".bytes() {
            (mut b).push(x)
        }
        i += 1
    }
    for x in "  beyond      past the cap\n".bytes() {
        (mut b).push(x)
    }
    let (ok, big) = edit.comphelp_parse("help:big", one("tool"), b)
    assert(ok, "big parses")
    assert(count_subs(ok, big) <= 512, "at most 512 subcommands")
    assert(sub_named(big, "beyond") < 0, "past the cap is never read")
    var s = bytes_of("Commands:\n  build")
    i = 0
    while i < 10000 {
        (mut s).push(32 as byte)
        i += 1
    }
    for x in "compile it\n".bytes() {
        (mut s).push(x)
    }
    i = 0
    while i < 10000 {
        (mut s).push(32 as byte)
        i += 1
    }
    for x in "\n  run   run it\n".bytes() {
        (mut s).push(x)
    }
    let (s_ok, spaces) = edit.comphelp_parse("help:spaces", one("tool"), s)
    assert(s_ok && count_subs(s_ok, spaces) == 2, "two rows")
    assert(spaces.nodes[sub_named(spaces, "build")].desc == "compile it", "build's description")
    let (e_ok, _) = edit.comphelp_parse("help:empty", one("tool"), List[byte]())
    assert(!e_ok, "nothing is negative")
    var nul = List[byte]()
    for x in [0, 0, 0, 10, 0] {
        (mut nul).push(x as byte)
    }
    let (n_ok, _) = edit.comphelp_parse("help:nul", one("tool"), nul)
    assert(!n_ok, "NUL bytes are negative")
}

// The node's data form round-trips through the SAME reader
// (`test_comphelp.c:437-487`).
fn t_comphelp_node_data_form_round_trips() {
    let (ok, spec) = parse_file("clap-uv.txt", one("uv"))
    assert(ok, "uv")
    var out = List[byte]()
    edit.compspec_write_node(spec, 0, 0, false, mut out)
    let doc = edit.fl_read_literal(out)
    assert(doc.error.len == 0, "the data form reads back: {doc.error}")
    var reg = edit.compspecs_new()
    let (bok, back, err) = edit.compspec_read_node(mut reg, "help:rt", doc, doc.top[0])
    assert(bok, "read_node: {err}")
    assert(dump_spec(true, back) == dump_spec(true, spec), "the same tree")
    let bad = edit.fl_read_literal(bytes_of("{{ completion: 1, flags: [] }}"))
    let (b2, _, e2) = edit.compspec_read_node(mut reg, "help:bad", bad, bad.top[0])
    assert(!b2 && e2.contains("completion"), "a top-level key is refused: {e2}")
}

// ------------------------------------------------------------------
// A PATH with tools on it
// ------------------------------------------------------------------

struct HelpFix {
    root: str,
    bin: str,
    cache: str,
    saved: List[str],
    had: List[bool],
    names: List[str],
}

fn env_copy(name: str) -> (str, bool) {
    let v = env_get(name) else |_| { return ("", false) }
    (v, true)
}

var fix_n: int = 0

/// `help_fix_init` (`test_comphelp.c:504-524`) over `compspec_fix.h`'s
/// environment.
fn help_fix_init() -> (HelpFix, edit.Ed) {
    var n = 0
    // # Safety: one thread; the counter names fresh trees.
    unsafe {
        fix_n += 1
        n = fix_n
    }
    let root = "/tmp/yew-comphelp-{os_pid()}-{n}"
    fs.remove_dir_all(root) else |_| {}
    var h = HelpFix {
        root: root,
        bin: "{root}/bin",
        cache: "{root}/cache",
        saved: List[str](),
        had: List[bool](),
        names: List[str](),
    }
    for d in ["bin", "state", "config/yew/completions", "home"] {
        fs.create_dir_all("{root}/{d}") else |_| { assert(false, "mkdir {d}") }
    }
    let cwd = os_cwd() else ""
    for name in [
        "YEW_RUNTIME_DIR",
        "XDG_CONFIG_HOME",
        "HOME",
        "XDG_CACHE_HOME",
        "XDG_STATE_HOME",
        "PATH",
    ] {
        let (v, had) = env_copy(name)
        (mut h.names).push(name)
        (mut h.saved).push(v)
        (mut h.had).push(had)
    }
    env_set("YEW_RUNTIME_DIR", "{cwd}/runtime") else |_| {}
    env_set("XDG_CONFIG_HOME", "{root}/config") else |_| {}
    env_set("HOME", "{root}/home") else |_| {}
    env_set("XDG_CACHE_HOME", h.cache) else |_| {}
    env_set("XDG_STATE_HOME", "{root}/state") else |_| {}
    env_set("PATH", h.bin) else |_| {}
    // `yew_test_load_runtime` (`test_comphelp.c:521`): the runtime's
    // bindings for the prompt cases.
    let rt = fs_read_bytes("runtime/init.fl") else List[byte]()
    assert(rt.len != 0, "runtime/init.fl is readable from the repository root")
    var ed = edit.ed_new_test(rt, "")
    edit.comphelp_set_timeout_ms(mut ed.help, 0)
    ed.ws_dir = root
    (h, ed)
}

// `help_fix_drop`'s editor half (`test_comphelp.c:526-540`): the prompt
// closed, the jobs torn down.
fn help_fix_end(h: HelpFix, mut ed: edit.Ed) {
    if ed.cmdline.active {
        edit.cmdline_close(mut ed, false)
    }
    edit.jobs_free(mut ed)
    help_fix_drop(h)
}

fn help_fix_drop(h: HelpFix) {
    var i = 0
    while i < h.names.len {
        if h.had[i] {
            env_set(h.names[i], h.saved[i]) else |_| {}
        } else {
            env_unset(h.names[i]) else |_| {}
        }
        i += 1
    }
    assert(h.root.starts_with("/tmp/yew-"), "only /tmp/yew-*")
    fs.remove_dir_all(h.root) else |_| { assert(false, "remove {h.root}") }
}

/// `tool_install`: a native executable on the fixture PATH as `name`.
fn tool_install(h: HelpFix, name: str) {
    let exe = os_exe() else ""
    let b = fs.read_bytes(exe) else |_| {
        assert(false, "read {exe}")
        return
    }
    let path = "{h.bin}/{name}"
    fs.write_bytes(path, b) else |_| { assert(false, "write {path}") }
    fs.set_mode(path, 493) else |_| { assert(false, "chmod {path}") }
}

// `tool_install` with its `help` (`test_comphelp.c:542-557`): what
// `name --help` prints.
fn tool_with_help(h: HelpFix, name: str, help: str) {
    tool_install(h, name)
    tool_help_file(h, "{name}.help", help)
}

// `tool_help_file` (`test_comphelp.c:559-566`).
fn tool_help_file(h: HelpFix, file: str, text: str) {
    fs.write_text("{h.bin}/{file}", text) else |_| { assert(false, "write {file}") }
}

// `script_install` (`test_comphelp.c:568-579`).
fn script_install(h: HelpFix, name: str) {
    write_mode(
        "{h.bin}/{name}",
        bytes_of(
            "#!/bin/sh\necho \"$0 $*\" >> \"$0.log\"\nprintf 'Commands:\\n  build   compile it\\n'\n",
        ),
        493,
    )
}

// `tool_log` (`test_comphelp.c:581-589`): every invocation, or "".
fn tool_log(h: HelpFix, name: str) -> str {
    fs.read_text("{h.bin}/{name}.log") else ""
}

// The tool's own spelling of its path in its log (`argv[0]` in C; the
// port's fixture names itself by `os_exe()`, the physical path).
fn real_bin(h: HelpFix) -> str {
    fs_realpath(h.bin) else h.bin
}

// `pump` (`test_comphelp.c:591-607`).
fn pump(mut ed: edit.Ed, ms: int) {
    let fds = edit.job_wait_fds(ed)
    if fds.len != 0 {
        let _ = os_signal_wait_fds(fds, signal.child(), ms) else |_| { (-1, 0) }
    } else if ms > 0 {
        time_sleep_ms(ms)
    }
    edit.job_pump(mut ed)
    edit.job_reap(mut ed)
    edit.job_tick(mut ed, time_now_ms())
    let _ = edit.job_settle(mut ed)
}

// `settle` (`test_comphelp.c:609-619`): the idle path, then the jobs,
// until every help request is answered.
fn settle(mut ed: edit.Ed) {
    let start = time_now_ms()
    while (edit.comphelp_inflight(ed.help) != 0 || edit.comphelp_idle_ready(ed.help, 0)) &&
        time_now_ms() - start < 10000 {
        let _ = edit.comphelp_idle(mut ed, 0)
        pump(mut ed, 10)
    }
    assert(edit.comphelp_inflight(ed.help) == 0, "every help request answered")
}

// `ask_and_run` (`test_comphelp.c:702-712`).
fn ask_and_run(mut ed: edit.Ed, name: str) -> bool {
    let (got, _) = edit.comphelp_lookup(mut ed, name)
    if got {
        return true
    }
    settle(mut ed)
    let (got2, _) = edit.comphelp_lookup(mut ed, name)
    got2
}

fn write_mode(path: str, data: List[byte], mode: int) {
    fs.write_bytes(path, data) else |_| { assert(false, "write {path}") }
    fs.set_mode(path, mode) else |_| { assert(false, "chmod {path}") }
}

// §1: the magic bytes (`test_comphelp.c:659-699`).
fn t_comphelp_magic_bytes_decide_native() {
    let (h, ed) = help_fix_init()
    tool_install(h, "native")
    write_mode("{h.bin}/script", bytes_of("#!/bin/sh\necho hi\n"), 493)
    write_mode("{h.bin}/data", bytes_of("hello world"), 420)
    var blob = List[byte]()
    for x in [1, 2, 3, 4] {
        (mut blob).push(x as byte)
    }
    for x in "rest".bytes() {
        (mut blob).push(x)
    }
    write_mode("{h.bin}/blob", blob, 493)
    assert(edit.comphelp_exe_kind("{h.bin}/native") == edit.HELP_EXE_NATIVE, "native")
    assert(edit.comphelp_exe_kind("{h.bin}/script") == edit.HELP_EXE_SCRIPT, "script")
    assert(edit.comphelp_exe_kind("{h.bin}/data") == edit.HELP_EXE_NONE, "data")
    assert(edit.comphelp_exe_kind("{h.bin}/blob") == edit.HELP_EXE_OTHER, "blob")
    assert(edit.comphelp_exe_kind(h.bin) == edit.HELP_EXE_NONE, "a directory")
    assert(
        edit.comphelp_kind_allowed(edit.HELP_POLICY_NATIVE, edit.HELP_EXE_NATIVE),
        "native/native",
    )
    assert(
        !edit.comphelp_kind_allowed(edit.HELP_POLICY_NATIVE, edit.HELP_EXE_SCRIPT),
        "native/script",
    )
    assert(
        !edit.comphelp_kind_allowed(edit.HELP_POLICY_NATIVE, edit.HELP_EXE_OTHER),
        "native/other",
    )
    assert(edit.comphelp_kind_allowed(edit.HELP_POLICY_ALL, edit.HELP_EXE_SCRIPT), "all/script")
    assert(edit.comphelp_kind_allowed(edit.HELP_POLICY_ALL, edit.HELP_EXE_OTHER), "all/other")
    assert(!edit.comphelp_kind_allowed(edit.HELP_POLICY_ALL, edit.HELP_EXE_NONE), "all/none")
    assert(!edit.comphelp_kind_allowed(edit.HELP_POLICY_OFF, edit.HELP_EXE_NATIVE), "off/native")
    assert(edit.comphelp_policy(ed) == edit.HELP_POLICY_NATIVE, "the default is native")
    // C's `yew_comphelp_policy(NULL)` (off) has no port: the policy
    // reads an editor, never an absent one.
    help_fix_drop(h)
}

fn set_policy(mut ed: edit.Ed, value: str) {
    ed.opts.store["shell.complete_help"] = value
}

// §1 under each mode (`test_comphelp.c:717-754`): a native tool runs
// under `native` and `all`; a `#!` script only under `all`; nothing under
// `off`. What ran is read from the tools' own logs.
fn t_comphelp_policy_native_all_off() {
    var (h, ed) = help_fix_init()
    tool_with_help(h, "tool", clap_help())
    script_install(h, "script")
    assert(ask_and_run(mut ed, "tool"), "native runs")
    assert(!ask_and_run(mut ed, "script"), "a script does not")
    assert(tool_log(h, "script") == "", "the script never ran")
    assert(edit.comphelp_spawns(ed.help) == 1, "one spawn")
    edit.comphelp_reset(mut ed.help)
    set_policy(mut ed, "all")
    assert(ask_and_run(mut ed, "script"), "all: the script runs")
    assert(tool_log(h, "script").contains("--help"), "with --help")
    edit.comphelp_reset(mut ed.help)
    set_policy(mut ed, "off")
    let (g1, hl1) = edit.comphelp_lookup(mut ed, "tool")
    assert(!g1 && !hl1.pending, "off: nothing asked, no cached answer")
    let (g2, _) = edit.comphelp_lookup(mut ed, "script")
    assert(!g2, "off: the script neither")
    assert(edit.comphelp_queued(ed.help) == 0, "nothing queued")
    assert(edit.comphelp_spawns(ed.help) == 0, "nothing spawned")
    help_fix_end(h, mut ed)
}

// §1's denylist (`test_comphelp.c:756-806`): by typed name, `mkfs.*`, and
// the REAL name behind a symlink, in every mode. Nothing is queued, so
// the idle path C's `settle` drives has nothing to run.
fn t_comphelp_denylist_never_runs() {
    var (h, ed) = help_fix_init()
    tool_install(h, "rm")
    tool_install(h, "mkfs.fake")
    tool_install(h, "shutdown")
    fs.symlink("{h.bin}/rm", "{h.bin}/tidy") else |_| { assert(false, "symlink") }
    assert(
        edit.comphelp_denied("rm") &&
            edit.comphelp_denied("mkfs.ext4") &&
            edit.comphelp_denied("sudo"),
        "denied",
    )
    assert(!edit.comphelp_denied("fac"), "fac is not")
    for mode in ["native", "all"] {
        edit.comphelp_reset(mut ed.help)
        set_policy(mut ed, mode)
        for name in ["rm", "mkfs.fake", "shutdown", "tidy"] {
            let (got, hl) = edit.comphelp_lookup(mut ed, name)
            assert(!got && !hl.pending, "{name} under {mode}")
        }
        assert(edit.comphelp_queued(ed.help) == 0, "nothing queued under {mode}")
        assert(edit.comphelp_idle(mut ed, 0) == 0, "nothing to run")
    }
    assert(edit.comphelp_spawns(ed.help) == 0, "nothing ran")
    help_fix_drop(h)
}

// A command with a spec never runs (`test_comphelp.c:808-838`).
fn t_comphelp_spec_wins_over_help() {
    var (h, ed) = help_fix_init()
    tool_install(h, "tool")
    fs.write_text(
        "{h.root}/config/yew/completions/tool.fl",
        "# test 1\n{{ completion: 1, command: \"tool\" }}\n",
    ) else |_| {}
    let (got, hl) = edit.comphelp_lookup(mut ed, "tool")
    assert(!got && !hl.pending, "the spec wins")
    fs.symlink("{h.bin}/tool", "{h.bin}/alias") else |_| { assert(false, "symlink") }
    let (got2, _) = edit.comphelp_lookup(mut ed, "alias")
    assert(!got2, "under another name too")
    assert(edit.comphelp_queued(ed.help) == 0, "nothing queued")
    assert(edit.comphelp_idle(mut ed, 0) == 0 && edit.comphelp_spawns(ed.help) == 0, "nothing ran")
    help_fix_drop(h)
}

// §2 (`test_comphelp.c:842-868`): argv[0] is the RESOLVED path, the
// request carries only --help, stdin is at EOF at once, and nothing
// spawns before the idle path.
fn t_comphelp_runs_the_resolved_path_without_stdin() {
    var (h, ed) = help_fix_init()
    tool_with_help(h, "tool", clap_help())
    let (got, hl) = edit.comphelp_lookup(mut ed, "tool")
    assert(!got && hl.pending, "queued")
    assert(hl.key.len == 16, "a 16-digit key")
    assert(edit.comphelp_spawns(ed.help) == 0, "nothing on the lookup")
    assert(ed.jobs.v.len == 0, "no job")
    settle(mut ed)
    assert(
        edit.comphelp_last_argv(ed.help) == "{h.bin}/tool --help",
        "the resolved argv: {edit.comphelp_last_argv(ed.help)}",
    )
    let want = "{real_bin(h)}/tool --help stdin=eof\n"
    assert(tool_log(h, "tool") == want, "the tool's log: `{tool_log(h, "tool")}`")
    help_fix_end(h, mut ed)
}

// `lookup_node` (`test_comphelp.c:870-886`): `(spec, node)` of `name`'s
// root subcommand `sub`, `(-1, -1)` for none.
fn lookup_node(mut ed: edit.Ed, name: str, sub: str) -> (int, int) {
    let (got, hl) = edit.comphelp_lookup(mut ed, name)
    if !got {
        return (-1, -1)
    }
    for k in ed.specs.pool[hl.spec].nodes[0].subs {
        if ed.specs.pool[hl.spec].nodes[k].name == sub {
            return (hl.spec, k)
        }
    }
    (-1, -1)
}

fn auth_help() -> str {
    "Usage: tool auth <COMMAND>\n\nCommands:\n  login   Sign in\n  logout  Sign out\n\nOptions:\n  --token <TOKEN>  Use this token\n"
}

fn tab(mut ed: edit.Ed) {
    let cx = edit.cmdctx_new(ed.win, 0)
    let _ = edit.cmdline_complete_next_cmd(mut ed, cx)
}

fn prompt_text(ed: edit.Ed) -> str {
    str_from_utf8(edit.cmdline_text(ed)) else "?"
}

// §4 (`test_comphelp.c:892-944`): `tool auth ` asks `tool auth --help`
// because the root's help listed `auth`; `tool unlisted ` asks nothing.
fn t_comphelp_descends_only_into_listed_subcommands() {
    var (h, ed) = help_fix_init()
    tool_with_help(h, "tool", clap_help())
    tool_help_file(h, "tool.auth.help", auth_help())
    assert(ask_and_run(mut ed, "tool"), "the root")
    let (sp, auth) = lookup_node(mut ed, "tool", "auth")
    assert(auth >= 0 && ed.specs.pool[sp].nodes[auth].subs.len == 0, "auth, not yet descended")
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    edit.cmdline_paste(mut ed, bytes_of("!tool unlisted "))
    tab(mut ed)
    let _ = edit.cmdline_comp_idle(mut ed)
    settle(mut ed)
    let rb = real_bin(h)
    assert(
        tool_log(h, "tool") == "{rb}/tool --help stdin=eof\n",
        "unlisted asks nothing: `{tool_log(h, "tool")}`",
    )
    edit.cmdline_close(mut ed, false)
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    edit.cmdline_paste(mut ed, bytes_of("!tool auth "))
    tab(mut ed)
    assert(ed.cmdline.filter.gen_pending, "pending")
    let _ = edit.cmdline_comp_idle(mut ed)
    settle(mut ed)
    assert(
        tool_log(h, "tool") == "{rb}/tool --help stdin=eof\n{rb}/tool auth --help stdin=eof\n",
        "auth asked: `{tool_log(h, "tool")}`",
    )
    assert(!ed.cmdline.filter.gen_pending, "answered")
    assert(ed.cmdline.menu.n_items == 2, "login and logout: {ed.cmdline.menu.n_items}")
    let (sp2, auth2) = lookup_node(mut ed, "tool", "auth")
    assert(auth2 >= 0, "auth")
    let node = copy ed.specs.pool[sp2].nodes[auth2]
    assert(
        node.subs.len == 2 && node.flags.len == 1,
        "grafted: {node.subs.len} subs, {node.flags.len} flags",
    )
    assert(ed.specs.pool[sp2].nodes[node.subs[0]].parent == auth2, "the parent link")
    edit.cmdline_close(mut ed, false)
    help_fix_end(h, mut ed)
}

// `cache_file_for` (`test_comphelp.c:946-965`).
fn cache_file_for(h: HelpFix, name: str, subs: List[str]) -> str {
    let real = text.file_realpath("{h.bin}/{name}") else ""
    let info = fs.stat(real) else |_| {
        assert(false, "stat {real}")
        return ""
    }
    let key = edit.comphelp_key(real, info.mtime_s, info.size, subs)
    "{h.cache}/yew/completions/help/{key}.fl"
}

// `touch_mtime` (`test_comphelp.c:967-977`).
fn touch_mtime(path: str, at_s: int) {
    let t = fs.time(at_s, 0)
    fs.set_times(path, t, t) else |_| { assert(false, "touch {path}") }
}

// §5 (`test_comphelp.c:983-1033`): a hit after the first parse (memory
// dropped, the disk answers, nothing runs); an upgrade misses and
// re-learns; the file holds what §5 says.
fn t_comphelp_cache_hits_and_upgrades_miss() {
    var (h, ed) = help_fix_init()
    tool_with_help(h, "tool", clap_help())
    assert(!fs.exists(h.cache), "created on first write only")
    assert(ask_and_run(mut ed, "tool"), "learned")
    let path = cache_file_for(h, "tool", List[str]())
    let t = fs.read_text(path) else ""
    let real = text.file_realpath("{h.bin}/tool") else ""
    assert(t.contains("help_cache: 1"), "the version")
    assert(t.contains("exe: \"{real}\""), "the executable")
    assert(t.contains("empty: false"), "not empty")
    assert(t.contains("name: \"build\""), "the tree")
    edit.comphelp_reset(mut ed.help)
    let (got, _) = edit.comphelp_lookup(mut ed, "tool")
    assert(got, "restart: the disk answers")
    assert(edit.comphelp_queued(ed.help) == 0 && edit.comphelp_spawns(ed.help) == 0, "nothing runs")
    edit.comphelp_reset(mut ed.help)
    touch_mtime("{h.bin}/tool", 1000000000)
    let (got2, hl2) = edit.comphelp_lookup(mut ed, "tool")
    assert(!got2 && hl2.pending, "an upgrade misses")
    settle(mut ed)
    assert(edit.comphelp_spawns(ed.help) == 1, "re-learned once")
    let (got3, _) = edit.comphelp_lookup(mut ed, "tool")
    assert(got3, "known again")
    help_fix_end(h, mut ed)
}

// `test_comphelp.c:1035-1063`: `empty: true` suppresses a rerun.
fn t_comphelp_negative_result_is_cached() {
    var (h, ed) = help_fix_init()
    tool_install(h, "fackr")
    tool_help_file(h, "fackr.help2", "Error: Device not configured\n")
    assert(!ask_and_run(mut ed, "fackr"), "negative")
    assert(edit.comphelp_spawns(ed.help) == 1, "asked once")
    let t = fs.read_text(cache_file_for(h, "fackr", List[str]())) else ""
    assert(t.contains("empty: true") && !t.contains("node:"), "a negative entry")
    let (g1, hl1) = edit.comphelp_lookup(mut ed, "fackr")
    assert(!g1 && !hl1.pending, "not asked again")
    edit.comphelp_reset(mut ed.help)
    let (g2, hl2) = edit.comphelp_lookup(mut ed, "fackr")
    assert(!g2 && !hl2.pending, "not after a restart either")
    settle(mut ed)
    assert(edit.comphelp_spawns(ed.help) == 0, "nothing ran")
    help_fix_end(h, mut ed)
}

// `test_comphelp.c:1065-1105`: a torn or tampered file is a miss, and
// the answer that replaces it is written whole.
fn t_comphelp_truncated_cache_is_a_miss() {
    var (h, ed) = help_fix_init()
    tool_with_help(h, "tool", clap_help())
    assert(ask_and_run(mut ed, "tool"), "learned")
    let path = cache_file_for(h, "tool", List[str]())
    let whole = fs.read_bytes(path) else List[byte]()
    var cut = 1
    while cut < whole.len {
        var part = List[byte]()
        var i = 0
        while i < cut {
            (mut part).push(whole[i])
            i += 1
        }
        fs.write_bytes(path, part) else |_| {}
        edit.comphelp_reset(mut ed.help)
        let (got, hl) = edit.comphelp_lookup(mut ed, "tool")
        assert(!got && hl.pending, "torn at {cut}: a miss")
        cut += whole.len / 7 + 1
    }
    let full = str_from_utf8(whole) else ""
    let at = full.find("exe: \"/") else -1
    assert(at >= 0, "the exe row")
    fs.write_text(path, full[0..at + 7] + "X" + full[at + 8..]) else |_| {}
    edit.comphelp_reset(mut ed.help)
    let (got, hl) = edit.comphelp_lookup(mut ed, "tool")
    assert(!got && hl.pending, "tampered: a miss")
    settle(mut ed)
    let again = fs.read_text(path) else ""
    assert(again.contains("name: \"build\""), "rewritten whole")
    help_fix_end(h, mut ed)
}

fn hex16(v: int) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var k = 15
    while k >= 0 {
        let d = v >> k * 4 & 15
        out += digits[d..d + 1]
        k -= 1
    }
    out
}

// §5 (`test_comphelp.c:1107-1157`): past 2000 files a write prunes the
// oldest down to 1800; a file not ours is never counted or removed.
fn t_comphelp_cache_prunes_at_2000() {
    var (h, ed) = help_fix_init()
    tool_with_help(h, "tool", clap_help())
    let dir = "{h.cache}/yew/completions/help"
    fs.create_dir_all(dir) else |_| { assert(false, "mkdir") }
    var i = 0
    while i < 2000 {
        let file = "{dir}/{hex16(i + 1)}.fl"
        fs.write_text(file, "{{}}") else |_| { assert(false, "write") }
        touch_mtime(file, 1000000000 + i)
        i += 1
    }
    let readme = "{dir}/README"
    fs.write_text(readme, "x") else |_| {}
    assert(ask_and_run(mut ed, "tool"), "learned")
    var left = 0
    let names = fs_read_dir_entries(dir) else List[List[byte]]()
    for n in names {
        // The entry's kind byte, then a 19-byte name (C's `strlen == 19`).
        if n.len == 20 {
            left += 1
        }
    }
    assert(left == edit.COMPHELP_CACHE_KEEP, "pruned to 1800: {left}")
    assert(fs.exists(readme), "not ours: kept")
    assert(!fs.exists("{dir}/{hex16(1)}.fl"), "the oldest went")
    assert(fs.exists("{dir}/{hex16(2000)}.fl"), "the newest stayed")
    assert(fs.exists(cache_file_for(h, "tool", List[str]())), "ours stayed")
    help_fix_end(h, mut ed)
}

// `run_line` (`test_comphelp.c:1159-1177`).
fn run_line(mut ed: edit.Ed, l: str) -> int {
    let parsed = edit.cmd_parse(mut ed, bytes_of(l))
    if !edit.cmd_parse_ok(parsed) {
        return edit.CMD_ERR_ARG
    }
    let inv = edit.CmdInvoke {
        range: copy parsed.range,
        argv: copy parsed.argv,
        count: 0,
        bang: parsed.bang,
        win: ed.win,
    }
    edit.ed_invoke_parsed(mut ed, parsed.command, inv)
}

// `test_comphelp.c:1183-1244`: `ed.shell.complete_forget fac` deletes
// only fac's entries (disk and memory); with no argument, every entry;
// reachable by its E-mode spelling, not recordable.
fn t_comphelp_forget_deletes_only_that_command() {
    var (h, ed) = help_fix_init()
    tool_with_help(h, "fac", clap_help())
    tool_with_help(h, "other", clap_help())
    tool_help_file(h, "fac.auth.help", auth_help())
    assert(ask_and_run(mut ed, "fac"), "fac")
    assert(ask_and_run(mut ed, "other"), "other")
    let (sp, node) = lookup_node(mut ed, "fac", "auth")
    assert(node >= 0, "fac auth")
    let (answer, _) = edit.comphelp_descend(mut ed, sp, node)
    assert(answer == edit.HELP_DESCEND_PENDING, "the descent is asked")
    settle(mut ed)
    let fac = cache_file_for(h, "fac", List[str]())
    let sub = cache_file_for(h, "fac", one("auth"))
    let other = cache_file_for(h, "other", List[str]())
    assert(fs.exists(fac) && fs.exists(sub), "fac's two files")
    let id = edit.cmd_lookup(ed.reg, "ed.shell.complete_forget")
    assert(id != 0, "registered")
    let entry = edit.cmd_entry(ed.reg, id)
    assert(entry.flags & edit.CMD_RECORDABLE == 0, "not recordable")
    assert(!entry.has_word, "no CMDWORD")
    assert(run_line(mut ed, ":compforget fac") == edit.CMD_OK, ":compforget fac")
    assert(ed.msg.text.contains("fac (2 cache files)"), "the line: {ed.msg.text}")
    assert(!fs.exists(fac) && !fs.exists(sub), "fac's gone")
    assert(fs.exists(other), "other's kept")
    let (g1, hl1) = edit.comphelp_lookup(mut ed, "fac")
    assert(!g1 && hl1.pending, "fac re-learns")
    let (g2, _) = edit.comphelp_lookup(mut ed, "other")
    assert(g2, "other does not")
    assert(run_line(mut ed, ":shell.complete_forget") == edit.CMD_OK, "forget all")
    assert(!fs.exists(other), "all gone")
    assert(ed.msg.text.contains("forgot all"), "the line: {ed.msg.text}")
    help_fix_end(h, mut ed)
}

// DoD 4 (`test_comphelp.c:1250-1288`): `tool ` spawns NOTHING on the
// keystroke path and exactly one job on the idle tick; one help job at
// a time.
fn t_comphelp_prewarm_only_on_the_idle_tick() {
    var (h, ed) = help_fix_init()
    tool_with_help(h, "tool", clap_help())
    tool_with_help(h, "second", clap_help())
    tool_help_file(h, "tool.hold", "")
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    edit.cmdline_paste(mut ed, bytes_of("!tool "))
    assert(ed.jobs.v.len == 0 && edit.comphelp_inflight(ed.help) == 0, "nothing on a keystroke")
    tab(mut ed)
    assert(ed.jobs.v.len == 0 && edit.comphelp_spawns(ed.help) == 0, "nothing on a Tab")
    assert(edit.cmdline_comp_idle_pending(ed), "idle work pending")
    assert(edit.cmdline_comp_idle(mut ed) == 1, "one job on the idle tick")
    assert(edit.comphelp_inflight(ed.help) == 1 && ed.jobs.v.len == 1, "one in flight")
    edit.cmdline_paste(mut ed, bytes_of("; second "))
    assert(edit.cmdline_comp_idle(mut ed) == 0, "the second waits")
    assert(edit.comphelp_inflight(ed.help) == 1, "still one")
    assert(edit.comphelp_queued(ed.help) == 1, "one queued")
    assert(!edit.cmdline_comp_idle_pending(ed), "nothing the idle path can do")
    fs.remove("{h.bin}/tool.hold") else |_| { assert(false, "release the hold") }
    settle(mut ed)
    assert(edit.comphelp_spawns(ed.help) == 2, "both ran: {edit.comphelp_spawns(ed.help)}")
    edit.cmdline_close(mut ed, false)
    help_fix_end(h, mut ed)
}

// DoD 3 (`test_comphelp.c:1311-1357`): the first `!tool bu<Tab>` pends
// and edits nothing; the answer refills the menu (never the line); the
// second Tab completes; after a restart the first Tab completes at once.
fn t_comphelp_first_tab_pends_second_completes() {
    var (h, ed) = help_fix_init()
    tool_with_help(h, "tool", clap_help())
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    edit.cmdline_paste(mut ed, bytes_of("!tool bu"))
    tab(mut ed)
    assert(ed.cmdline.filter.gen_pending, "pending")
    assert(prompt_text(ed) == "!tool bu", "nothing inserted")
    let _ = edit.cmdline_comp_idle(mut ed)
    settle(mut ed)
    assert(prompt_text(ed) == "!tool bu", "the answer never edits")
    assert(!ed.cmdline.filter.gen_pending, "answered")
    tab(mut ed)
    assert(prompt_text(ed) == "!tool build ", "the second Tab: `{prompt_text(ed)}`")
    edit.cmdline_close(mut ed, false)
    edit.comphelp_reset(mut ed.help)
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    edit.cmdline_paste(mut ed, bytes_of("!tool --verb"))
    tab(mut ed)
    assert(prompt_text(ed) == "!tool --verbose ", "flags from the disk: `{prompt_text(ed)}`")
    edit.cmdline_paste(mut ed, bytes_of("bu"))
    tab(mut ed)
    assert(prompt_text(ed) == "!tool --verbose build ", "then the subcommand: `{prompt_text(ed)}`")
    assert(edit.comphelp_spawns(ed.help) == 0, "nothing ran")
    edit.cmdline_close(mut ed, false)
    help_fix_end(h, mut ed)
}

// `test_comphelp.c:1359-1384`: a usage-only tool is NEGATIVE: the paths
// answer, no marker.
fn t_comphelp_negative_falls_back_to_paths() {
    var (h, ed) = help_fix_init()
    tool_with_help(h, "usage", "usage: usage [-abc] file ...\n")
    fs.write_text("{h.root}/readme-only.txt", "x") else |_| {}
    assert(!ask_and_run(mut ed, "usage"), "negative")
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    edit.cmdline_paste(mut ed, bytes_of("!usage read"))
    tab(mut ed)
    assert(!ed.cmdline.filter.gen_pending, "no marker")
    assert(prompt_text(ed) == "!usage readme-only.txt ", "the path: `{prompt_text(ed)}`")
    edit.cmdline_close(mut ed, false)
    help_fix_end(h, mut ed)
}

// `test_comphelp.c:1386-1405`: the loop and the idle path agree on "work
// pending".
fn t_comphelp_loop_deadline_shares_the_idle_condition() {
    var (h, ed) = help_fix_init()
    tool_with_help(h, "tool", clap_help())
    assert(!edit.cmdline_comp_idle_pending(ed), "no prompt, nothing")
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    edit.cmdline_paste(mut ed, bytes_of("!tool "))
    assert(edit.cmdline_comp_idle_pending(ed), "pending")
    assert(edit.loop_deadline(ed, time_now_ms()) == 0, "the loop does not sleep on it")
    settle(mut ed)
    let _ = edit.cmdline_comp_idle(mut ed)
    settle(mut ed)
    assert(!edit.cmdline_comp_idle_pending(ed), "done")
    edit.cmdline_close(mut ed, false)
    assert(!edit.cmdline_comp_idle_pending(ed), "closed")
    help_fix_end(h, mut ed)
}

fn shell_ctx(mut ed: edit.Ed, l: str) -> edit.ShCtx {
    let lb = bytes_of(l)
    let (ok, q) = edit.comp_query(mut ed, lb, lb.len)
    assert(ok && q.has_shell, "{l}: a shell query")
    let (cok, ctx) = edit.comp_shell_ctx_of(mut ed, q.shell_line, q.shell_cursor)
    assert(cok, "{l}: a context")
    ctx
}

// 57.32 §3 (`test_comphelp.c:1411-1459`): help runs from `/`, but
// `./tool` is the tool in the directory the command will run in — after
// the line's `cd` — and nothing when that directory is unknown.
fn t_comphelp_relative_word_follows_the_effective_directory() {
    var (h, ed) = help_fix_init()
    fs.create_dir("{h.root}/sub") else |_| { assert(false, "mkdir sub") }
    let exe = os_exe() else ""
    let b = fs.read_bytes(exe) else List[byte]()
    write_mode("{h.root}/sub/tool", b, 493)
    fs.write_text("{h.root}/sub/tool.help", clap_help()) else |_| {}
    let (g1, hl1) = edit.comphelp_lookup_in(mut ed, "./tool", h.root, true)
    assert(!g1 && !hl1.pending, "the prompt's directory has no ./tool")
    let (g2, hl2) = edit.comphelp_lookup_in(mut ed, "./tool", "", false)
    assert(!g2 && !hl2.pending && hl2.key.len == 0, "unknown: nothing asked")
    let unknown = shell_ctx(mut ed, ":!cd $X && ./tool ")
    edit.comp_shell_prewarm(mut ed, unknown)
    assert(!edit.comphelp_idle_ready(ed.help, 0), "unknown: nothing to run")
    let ctx = shell_ctx(mut ed, ":!cd sub && ./tool ")
    edit.comp_shell_prewarm(mut ed, ctx)
    assert(edit.comphelp_idle_ready(ed.help, 0), "sub/tool asked")
    settle(mut ed)
    let d = edit.comp_shell_describe(mut ed, ctx)
    assert(d == "sub", "the plan: `{d}`")
    let (g3, _) = edit.comphelp_lookup(mut ed, "{h.root}/sub/tool")
    assert(g3, "learned")
    help_fix_end(h, mut ed)
}

// ------------------------------------------------------------------
// Port-only: a cache file in C's own form
// ------------------------------------------------------------------

/// The cache file C yew writes for `tool` (`cache_write`,
/// `comphelp.c:1923-1992`), built with the port's writer in C's form.
fn write_cache(h: HelpFix, name: str, subs: List[str], help: str, empty: bool) -> str {
    let real = text.file_realpath("{h.bin}/{name}") else ""
    let info = fs.stat(real) else |_| {
        assert(false, "stat {real}")
        return ""
    }
    let key = edit.comphelp_key(real, info.mtime_s, info.size, subs)
    let dir = "{h.cache}/yew/completions/help"
    fs.create_dir_all(dir) else |_| {}
    var out = bytes_of(
        "# yew: learned from `{name} --help`; ed.shell.complete_forget drops it\n{{\n  help_cache: 1,\n  exe: ",
    )
    edit.fdw_string(mut out, real)
    edit.fdw_str(mut out, ",\n  mtime: {info.mtime_s},\n  size: {info.size},\n  argv: [\n")
    for s in subs {
        edit.fdw_str(mut out, "    ")
        edit.fdw_string(mut out, s)
        edit.fdw_str(mut out, ",\n")
    }
    edit.fdw_str(mut out, "  ],\n")
    if empty {
        edit.fdw_str(mut out, "  empty: true,\n")
    } else {
        edit.fdw_str(mut out, "  empty: false,\n  node: ")
        var w = List[str]()
        (mut w).push(name)
        for s in subs {
            (mut w).push(s)
        }
        let (ok, spec) = edit.comphelp_parse("help:{real}", w, bytes_of(help))
        assert(ok, "the help parses")
        edit.compspec_write_node(spec, 0, 1, true, mut out)
    }
    edit.fdw_str(mut out, "}}\n\n")
    let path = "{dir}/{key}.fl"
    fs.write_bytes(path, out) else |_| { assert(false, "write the cache") }
    path
}

fn clap_help() -> str {
    "A fixture tool.\n\nUsage: tool [OPTIONS] <COMMAND>\n\nCommands:\n  build  Compile the project\n  bench  Run the benchmarks\n  auth   Manage credentials\n  help   Print this message or the help of the given subcommand(s)\n\nOptions:\n  -o, --output <FILE>   Write here\n  -v, --verbose         More output\n  -h, --help            Print help\n"
}

// A cache file in C's form is a hit: the tree, nothing queued, nothing
// spawned (C's `cache_hits_and_upgrades_miss` after its first run); an
// upgrade (a new mtime) misses and queues.
fn t_port_comphelp_cache_written_by_c_is_a_hit() {
    var (h, ed) = help_fix_init()
    tool_install(h, "tool")
    let _ = write_cache(h, "tool", List[str](), clap_help(), false)
    let (got, hl) = edit.comphelp_lookup(mut ed, "tool")
    assert(got && hl.spec >= 0, "a hit")
    let sp = hl.spec
    assert(ed.specs.pool[sp].nodes[0].subs.len == 4, "the tree: four subcommands")
    assert(
        edit.comphelp_queued(ed.help) == 0 && edit.comphelp_spawns(ed.help) == 0,
        "nothing asked",
    )
    edit.comphelp_reset(mut ed.help)
    let later = fs.time(1000000000, 0)
    fs.set_times("{h.bin}/tool", later, later) else |_| { assert(false, "touch") }
    let (got2, hl2) = edit.comphelp_lookup(mut ed, "tool")
    assert(!got2 && hl2.pending && hl2.key.len == 16, "an upgrade misses and queues")
    help_fix_drop(h)
}

// `empty: true` suppresses the ask (C's `negative_result_is_cached`).
fn t_port_comphelp_negative_cache_entry_suppresses_the_ask() {
    var (h, ed) = help_fix_init()
    tool_install(h, "fackr")
    let path = write_cache(h, "fackr", List[str](), "", true)
    let text = fs.read_text(path) else ""
    assert(text.contains("empty: true") && !text.contains("node:"), "a negative entry")
    let (got, hl) = edit.comphelp_lookup(mut ed, "fackr")
    assert(!got && !hl.pending, "negative, not asked")
    assert(edit.comphelp_queued(ed.help) == 0, "nothing queued")
    help_fix_drop(h)
}

// A torn or tampered cache file is a miss (C's `truncated_cache_is_a_miss`
// without the rewrite a run would make).
fn t_port_comphelp_truncated_cache_is_a_miss() {
    var (h, ed) = help_fix_init()
    tool_install(h, "tool")
    let path = write_cache(h, "tool", List[str](), clap_help(), false)
    let text = fs.read_bytes(path) else List[byte]()
    let step = text.len / 7 + 1
    var cut = 1
    while cut < text.len {
        var part = List[byte]()
        var i = 0
        while i < cut {
            (mut part).push(text[i])
            i += 1
        }
        fs.write_bytes(path, part) else |_| {}
        edit.comphelp_reset(mut ed.help)
        let (got, hl) = edit.comphelp_lookup(mut ed, "tool")
        assert(!got && hl.pending, "torn at {cut}: a miss")
        cut += step
    }
    let full = str_from_utf8(text) else ""
    let at = full.find("exe: \"/") else -1
    assert(at >= 0, "the exe row")
    let bad = full[0..at + 6] + "X" + full[at + 7..]
    fs.write_text(path, bad) else |_| {}
    edit.comphelp_reset(mut ed.help)
    let (got, hl) = edit.comphelp_lookup(mut ed, "tool")
    assert(!got && hl.pending, "tampered: a miss")
    help_fix_drop(h)
}

// `ed.shell.complete_forget fac` deletes only fac's entries, disk and
// memory; with no argument, every entry (C's `forget_deletes_only_that_
// command`, the cache hand-written where C's runs wrote it).
fn t_port_comphelp_forget_deletes_only_that_command() {
    var (h, ed) = help_fix_init()
    tool_install(h, "fac")
    tool_install(h, "other")
    let fac = write_cache(h, "fac", List[str](), clap_help(), false)
    let sub = write_cache(
        h,
        "fac",
        one("auth"),
        "Usage: fac auth <COMMAND>\n\nCommands:\n  login   Sign in\n",
        false,
    )
    let other = write_cache(h, "other", List[str](), clap_help(), false)
    let (g1, _) = edit.comphelp_lookup(mut ed, "fac")
    let (g2, _) = edit.comphelp_lookup(mut ed, "other")
    assert(g1 && g2, "both learned")
    assert(edit.comphelp_run_forget(mut ed, "fac") == edit.CMD_OK, "forget fac")
    assert(ed.msg.text.contains("fac (2 cache files)"), "two files: {ed.msg.text}")
    assert(!fs.exists(fac) && !fs.exists(sub), "fac's gone")
    assert(fs.exists(other), "other's kept")
    let (g3, hl3) = edit.comphelp_lookup(mut ed, "fac")
    assert(!g3 && hl3.pending, "fac re-learns")
    let (g4, _) = edit.comphelp_lookup(mut ed, "other")
    assert(g4, "other still known")
    assert(edit.comphelp_run_forget(mut ed, "") == edit.CMD_OK, "forget all")
    assert(!fs.exists(other) && ed.msg.text.contains("forgot all"), "all gone")
    help_fix_drop(h)
}

fn skip(name: str, why: str) -> int {
    print("comphelp_test: SKIP {name}: {why}")
    eprint("comphelp_test: SKIP {name}: {why}")
    1
}

// C's `tests/helpers/help_fixture.c` in full, run when a copy of this
// binary is a fixture tool (`YEW_HELPFIX=1`): every invocation logged to
// `<me>.log` with how stdin answered; `<me>.hold` waited on (60 s at
// most); `<me>[.a.b].help` to stdout and `.help2` to stderr for
// `me a b --help`, exit 2; `<me>.ran` without a trailing `--help`.
fn help_fixture_main() -> int {
    let me = os_exe() else "help_fixture"
    let args = env_args()
    let help = args.len >= 1 && args[args.len - 1] == "--help"
    var stdin_is = "data"
    let _ = fs_read_chunk(0, 16) else |e| match e {
        eof => {
            stdin_is = "eof"
            List[byte]()
        },
        io => {
            stdin_is = "err"
            List[byte]()
        },
    }
    var line = me
    for a in args {
        line += " {a}"
    }
    let prior = fs.read_text("{me}.log") else ""
    fs.write_text("{me}.log", "{prior}{line} stdin={stdin_is}\n") else |_| {}
    var waited = 0
    while fs.exists("{me}.hold") && waited < 3000 {
        time_sleep_ms(20)
        waited += 1
    }
    if !help {
        fs.write_text("{me}.ran", "") else |_| {}
        return 0
    }
    var path = me
    var i = 0
    while i < args.len - 1 {
        path += ".{args[i]}"
        i += 1
    }
    emit("{path}.help", 1)
    emit("{path}.help2", 2)
    2
}

fn emit(path: str, fd: int) {
    let data = fs.read_bytes(path) else |_| { return }
    // `fs_write_chunk` writes the whole slice or fails.
    fs_write_chunk(fd, data) else |_| {}
}

fn main() {
    // The session's `--yew-env0` runs this binary (`unit_main.c:14-19`).
    if edit.shsession_env0_requested() {
        os_exit(edit.shsession_env0_main())
    }
    // A copy on a fixture PATH is C's help fixture.
    if (env_get("YEW_HELPFIX") else "") == "1" {
        os_exit(help_fixture_main())
    }
    fs.create_dir_all("target/tests") else |_| {}
    let log = "target/tests/edit-comphelp-test.log"
    fs.remove(log) else |_| {}
    env_set("YEW_LOG", log) else |_| {}
    env_set("YEW_HELPFIX", "1") else |_| {}
    signal.listen(signal.child()) else |_| {}
    let exe = os_exe() else ""
    let under_wolf = exe.ends_with("/wolf") || exe == "wolf"
    let job = "the help fixture is a copy of os_exe(), which is `wolf` under wolf test (G23): the native run covers it"
    var skips = 0
    t_comphelp_parses_every_layout_fixture()
    t_comphelp_user_tools_behave_as_stated()
    t_comphelp_classifies_terms()
    t_comphelp_survives_huge_and_blank_inputs()
    t_comphelp_node_data_form_round_trips()
    t_comphelp_magic_bytes_decide_native()
    if under_wolf {
        skips += skip("comphelp_policy_native_all_off", job)
    } else {
        t_comphelp_policy_native_all_off()
    }
    t_comphelp_denylist_never_runs()
    t_comphelp_spec_wins_over_help()
    if under_wolf {
        for name in [
            "comphelp_runs_the_resolved_path_without_stdin",
            "comphelp_descends_only_into_listed_subcommands",
            "comphelp_cache_hits_and_upgrades_miss",
            "comphelp_negative_result_is_cached",
            "comphelp_truncated_cache_is_a_miss",
            "comphelp_cache_prunes_at_2000",
            "comphelp_forget_deletes_only_that_command",
            "comphelp_prewarm_only_on_the_idle_tick",
            "comphelp_first_tab_pends_second_completes",
            "comphelp_negative_falls_back_to_paths",
            "comphelp_loop_deadline_shares_the_idle_condition",
            "comphelp_relative_word_follows_the_effective_directory",
        ] {
            skips += skip(name, job)
        }
    } else {
        t_comphelp_runs_the_resolved_path_without_stdin()
        t_comphelp_descends_only_into_listed_subcommands()
        t_comphelp_cache_hits_and_upgrades_miss()
        t_comphelp_negative_result_is_cached()
        t_comphelp_truncated_cache_is_a_miss()
        t_comphelp_cache_prunes_at_2000()
        t_comphelp_forget_deletes_only_that_command()
        t_comphelp_prewarm_only_on_the_idle_tick()
        t_comphelp_first_tab_pends_second_completes()
        t_comphelp_negative_falls_back_to_paths()
        t_comphelp_loop_deadline_shares_the_idle_condition()
        t_comphelp_relative_word_follows_the_effective_directory()
    }
    t_port_comphelp_cache_written_by_c_is_a_hit()
    t_port_comphelp_negative_cache_entry_suppresses_the_ask()
    t_port_comphelp_truncated_cache_is_a_miss()
    t_port_comphelp_forget_deletes_only_that_command()
    print("comphelp_test: {21 - skips} C cases pass, {skips} SKIP; 4 port cases pass")
}
