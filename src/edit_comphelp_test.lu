//! member: false
//!
//! The port of sagitta `tests/unit/test_comphelp.c` (1,459 lines), one
//! test per C test in registry order. The parser runs against the help
//! text sagitta captured once from real tools (`tests/fixtures/help/`,
//! sagitta's `tests/unit/fixtures/help/` verbatim, each `.txt` beside the
//! `.expect` tree it must parse to); no test runs those tools.
//!
//! What waits: every case that RUNS `--help` (the policy runs, the
//! resolved argv, the descent, the cache a run writes, the prune a write
//! triggers, the forget of what a run cached, the prewarm, the prompt's
//! pending marker) drives the help job whose pipes are read while the loop
//! runs — SKIP loudly by name, ruling R-yw04-1 (G2, wolf-lang#795). The
//! cases that run nothing run: the parser's four, the data form, the
//! magic bytes, the denylist and spec-wins lookups. Beside them, port-only
//! cases prove the paths 0.2.33 does reach: a cache file in C's own form
//! is a hit that spawns nothing, a negative entry suppresses the ask, a
//! torn file is a miss, `ed.shell.complete_forget` deletes by basename,
//! and the idle path refuses by name the way C's spawn failure is handled.
//!
//! C's `tool_install` copies `build/help_fixture` (a native executable)
//! onto the fixture PATH; the cases that run nothing only need ANY native
//! executable there, so the port copies its own (`os_exe()`, ELF on
//! Linux, Mach-O on macOS).

use edit
use std.fs
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

const FIX: str = "tests/fixtures/help/"

/// `dump_node` (`test_comphelp.c:64-98`): the root's tree as text.
fn dump_spec(ok: bool, spec: edit.CompSpec) -> str {
    if !ok {
        return "negative\n"
    }
    var b = ""
    let root = copy spec.nodes[0]
    for si in root.subs {
        let s = copy spec.nodes[si]
        b += "sub {s.name}"
        var k = 0
        while k < s.aliases.len {
            b += if k == 0 then " alias=" else ","
            b += s.aliases[k]
            k += 1
        }
        b += " | {if s.has_desc then s.desc else ""}\n"
    }
    for f in root.flags {
        b += "flag"
        if f.has_shrt {
            b += " -{f.shrt}"
        }
        if f.has_lng {
            b += " --{f.lng}"
        }
        if f.arg >= 0 {
            b += " arg={edit.spec_arg_kind_name(spec.args[f.arg].kind)}"
            var k = 0
            while k < spec.args[f.arg].values.len {
                b += if k == 0 then ":" else ","
                b += spec.args[f.arg].values[k].value
                k += 1
            }
        }
        if f.arg_optional {
            b += " optional"
        }
        if f.global {
            b += " global"
        }
        b += " | {if f.has_desc then f.desc else ""}\n"
    }
    b
}

fn words_of(ws: List[str]) -> List[str] {
    copy ws
}

fn one(a: str) -> List[str] {
    var v = List[str]()
    (mut v).push(a)
    v
}

fn two(a: str, b: str) -> List[str] {
    var v = one(a)
    (mut v).push(b)
    v
}

fn parse_file(file: str, words: List[str]) -> (bool, edit.CompSpec) {
    let b = fs.read_bytes("{FIX}{file}") else |_| {
        assert(false, "fixture {file}")
        return (false, edit.compspec_new(""))
    }
    edit.comphelp_parse("help:test", words, b)
}

// §3: every layout against its captured text (`test_comphelp.c:157-225`).
fn t_comphelp_parses_every_layout_fixture() {
    var files = List[str]()
    var ws = List[List[str]]()
    for row in [
        "shithub.txt shithub",
        "shithub-auth.txt shithub auth",
        "lupin.txt lupin",
        "fac.txt fac",
        "fackr.txt fackr",
        "clap-starship.txt starship",
        "clap-uv.txt uv",
        "cobra-colima.txt colima",
        "cobra-colima-start.txt colima start",
        "cobra-kubectl.txt kubectl",
        "argparse-wheel.txt wheel3",
        "argparse-rapid-mlx.txt rapid-mlx",
        "click-app.txt clickapp",
        "commander-vsce.txt vsce",
        "gnu-ls.txt gls",
        "goflag-gofmt.txt gofmt",
        "custom-wolf.txt wolf",
        "yargs-opencode.txt opencode",
        "bsd-cp.txt cp",
        "hostile-ansi.txt clickapp",
        "hostile-overstrike.txt tool",
        "hostile-crlf.txt clickapp",
        "hostile-utf8.txt tool",
    ] {
        let parts = row.words()
        (mut files).push(parts[0])
        var w = List[str]()
        var i = 1
        while i < parts.len {
            (mut w).push(parts[i])
            i += 1
        }
        (mut ws).push(w)
    }
    var i = 0
    var bad = 0
    while i < files.len {
        let (ok, spec) = parse_file(files[i], ws[i])
        let got = dump_spec(ok, spec)
        let want = fs.read_text("{FIX}{files[i]}.expect") else ""
        if got != want {
            eprint("comphelp: {files[i]} parsed to\n{got}")
            bad += 1
        }
        i += 1
    }
    assert(bad == 0, "{bad} layouts differ from their .expect")
}

fn count_subs(ok: bool, spec: edit.CompSpec) -> int {
    if ok then spec.nodes[0].subs.len else 0
}

fn flag_long(spec: edit.CompSpec, l: str) -> int {
    var i = 0
    while i < spec.nodes[0].flags.len {
        if spec.nodes[0].flags[i].has_lng && spec.nodes[0].flags[i].lng == l {
            return i
        }
        i += 1
    }
    -1
}

fn sub_named(spec: edit.CompSpec, s: str) -> int {
    for si in spec.nodes[0].subs {
        if spec.nodes[si].name == s {
            return si
        }
    }
    -1
}

// DoD 1 (`test_comphelp.c:255-287`).
fn t_comphelp_user_tools_behave_as_stated() {
    let (so, s) = parse_file("shithub.txt", one("shithub"))
    let (lo, l) = parse_file("lupin.txt", one("lupin"))
    let (fo, f) = parse_file("fac.txt", one("fac"))
    let (ko, _) = parse_file("fackr.txt", one("fackr"))
    assert(so, "shithub parses")
    assert(count_subs(so, s) >= 20 && count_subs(so, s) == 28, "28 subcommands")
    assert(sub_named(s, "attestation") >= 0 && sub_named(s, "ssh-key") >= 0, "attestation, ssh-key")
    assert(lo && count_subs(lo, l) == 13 && sub_named(l, "conform-run") >= 0, "lupin")
    assert(fo && count_subs(fo, f) == 0 && flag_long(f, "version") >= 0, "fac: flags only")
    assert(!ko, "fackr is negative")
}

// The classifications §3 names (`test_comphelp.c:290-390`).
fn t_comphelp_classifies_terms() {
    let (u_ok, uv) = parse_file("clap-uv.txt", one("uv"))
    assert(u_ok, "uv")
    var fl = flag_long(uv, "color")
    assert(fl >= 0 && uv.nodes[0].flags[fl].arg >= 0, "--color takes a value")
    let ca = uv.nodes[0].flags[fl].arg
    assert(
        uv.args[ca].kind == edit.SPEC_ARG_VALUES &&
            uv.args[ca].values.len == 3 &&
            uv.args[ca].values[1].value == "always",
        "color's values",
    )
    fl = flag_long(uv, "directory")
    assert(
        fl >= 0 &&
            uv.nodes[0].flags[fl].arg >= 0 &&
            uv.args[uv.nodes[0].flags[fl].arg].kind == edit.SPEC_ARG_DIR,
        "--directory is a dir",
    )
    fl = flag_long(uv, "config-file")
    assert(
        fl >= 0 &&
            uv.nodes[0].flags[fl].arg >= 0 &&
            uv.args[uv.nodes[0].flags[fl].arg].kind == edit.SPEC_ARG_PATH,
        "--config-file is a path",
    )
    fl = flag_long(uv, "quiet")
    assert(
        fl >= 0 &&
            uv.nodes[0].flags[fl].arg < 0 &&
            uv.nodes[0].flags[fl].has_shrt &&
            uv.nodes[0].flags[fl].shrt == "q" &&
            uv.nodes[0].flags[fl].global,
        "-q, --quiet...",
    )

    let (g_ok, gofmt) = parse_file("goflag-gofmt.txt", one("gofmt"))
    assert(g_ok, "gofmt")
    fl = flag_long(gofmt, "cpuprofile")
    assert(
        fl >= 0 &&
            gofmt.nodes[0].flags[fl].arg >= 0 &&
            gofmt.args[gofmt.nodes[0].flags[fl].arg].kind == edit.SPEC_ARG_NONE &&
            gofmt.nodes[0].flags[fl].has_desc,
        "Go's -name type",
    )

    let (l_ok, gls) = parse_file("gnu-ls.txt", one("gls"))
    assert(l_ok, "gls")
    fl = flag_long(gls, "color")
    assert(
        fl >= 0 && gls.nodes[0].flags[fl].arg >= 0 && gls.nodes[0].flags[fl].arg_optional,
        "--color[=WHEN]",
    )
    fl = flag_long(gls, "block-size")
    assert(
        fl >= 0 && gls.nodes[0].flags[fl].arg >= 0 && !gls.nodes[0].flags[fl].arg_optional,
        "--block-size=SIZE",
    )
    assert(count_subs(l_ok, gls) == 0, "gls has no subcommands")

    let (_, vsce) = parse_file("commander-vsce.txt", one("vsce"))
    let ps = sub_named(vsce, "package")
    assert(
        ps >= 0 && vsce.nodes[ps].aliases.len == 1 && vsce.nodes[ps].aliases[0] == "pack",
        "package|pack",
    )

    let (r_ok, rapid) = parse_file("argparse-rapid-mlx.txt", one("rapid-mlx"))
    let cs = sub_named(rapid, "chat")
    assert(
        cs >= 0 && rapid.nodes[cs].aliases.len == 1 && rapid.nodes[cs].aliases[0] == "run",
        "chat (run)",
    )
    assert(count_subs(r_ok, rapid) == 17, "17 subcommands")

    let text = "positional arguments:\n  {{run,chat,serve}}\n    chat (run)   Interactive chat\n    serve        Start a server\n"
    let (o_ok, order) = edit.comphelp_parse("help:order", one("tool"), bytes_of(text))
    assert(count_subs(o_ok, order) == 2, "two subcommands")
    let oc = sub_named(order, "chat")
    assert(
        oc >= 0 &&
            order.nodes[oc].aliases.len == 1 &&
            order.nodes[oc].aliases[0] == "run" &&
            order.nodes[oc].has_desc &&
            order.nodes[oc].desc == "Interactive chat",
        "the folded alias keeps its row",
    )
    assert(order.nodes[sub_named(order, "serve")].desc == "Start a server", "serve")

    let (c_ok, colima) = parse_file("cobra-colima-start.txt", two("colima", "start"))
    assert(c_ok && count_subs(c_ok, colima) == 0, "colima start")
    fl = flag_long(colima, "verbose")
    assert(fl >= 0 && colima.nodes[0].flags[fl].global, "Global Flags are global")
    fl = flag_long(colima, "arch")
    assert(
        fl >= 0 && !colima.nodes[0].flags[fl].global && colima.nodes[0].flags[fl].arg >= 0,
        "--arch",
    )
}

// Hostile inputs (`test_comphelp.c:393-434`).
fn t_comphelp_survives_huge_and_blank_inputs() {
    var b = bytes_of("Commands:\n")
    var i = 0
    while b.len < 300 * 1024 {
        let n = "{i}"
        var pad = ""
        var k = n.len
        while k < 5 {
            pad += "0"
            k += 1
        }
        for x in "  cmd{pad}{n}    row number {i} of many\n".bytes() {
            (mut b).push(x)
        }
        i += 1
    }
    for x in "  beyond      past the cap\n".bytes() {
        (mut b).push(x)
    }
    let (ok, big) = edit.comphelp_parse("help:big", one("tool"), b)
    assert(ok, "big parses")
    assert(count_subs(ok, big) <= 512, "at most 512 subcommands")
    assert(sub_named(big, "beyond") < 0, "past the cap is never read")
    var s = bytes_of("Commands:\n  build")
    i = 0
    while i < 10000 {
        (mut s).push(32 as byte)
        i += 1
    }
    for x in "compile it\n".bytes() {
        (mut s).push(x)
    }
    i = 0
    while i < 10000 {
        (mut s).push(32 as byte)
        i += 1
    }
    for x in "\n  run   run it\n".bytes() {
        (mut s).push(x)
    }
    let (s_ok, spaces) = edit.comphelp_parse("help:spaces", one("tool"), s)
    assert(s_ok && count_subs(s_ok, spaces) == 2, "two rows")
    assert(spaces.nodes[sub_named(spaces, "build")].desc == "compile it", "build's description")
    let (e_ok, _) = edit.comphelp_parse("help:empty", one("tool"), List[byte]())
    assert(!e_ok, "nothing is negative")
    var nul = List[byte]()
    for x in [0, 0, 0, 10, 0] {
        (mut nul).push(x as byte)
    }
    let (n_ok, _) = edit.comphelp_parse("help:nul", one("tool"), nul)
    assert(!n_ok, "NUL bytes are negative")
}

// The node's data form round-trips through the SAME reader
// (`test_comphelp.c:437-487`).
fn t_comphelp_node_data_form_round_trips() {
    let (ok, spec) = parse_file("clap-uv.txt", one("uv"))
    assert(ok, "uv")
    var out = List[byte]()
    edit.compspec_write_node(spec, 0, 0, false, mut out)
    let doc = edit.fl_read_literal(out)
    assert(doc.error.len == 0, "the data form reads back: {doc.error}")
    var reg = edit.compspecs_new()
    let (bok, back, err) = edit.compspec_read_node(mut reg, "help:rt", doc, doc.top[0])
    assert(bok, "read_node: {err}")
    assert(dump_spec(true, back) == dump_spec(true, spec), "the same tree")
    let bad = edit.fl_read_literal(bytes_of("{{ completion: 1, flags: [] }}"))
    let (b2, _, e2) = edit.compspec_read_node(mut reg, "help:bad", bad, bad.top[0])
    assert(!b2 && e2.contains("completion"), "a top-level key is refused: {e2}")
}

// ------------------------------------------------------------------
// A PATH with tools on it
// ------------------------------------------------------------------

struct HelpFix {
    root: str,
    bin: str,
    cache: str,
    saved: List[str],
    had: List[bool],
    names: List[str],
}

fn env_copy(name: str) -> (str, bool) {
    let v = env_get(name) else |_| { return ("", false) }
    (v, true)
}

var fix_n: int = 0

/// `help_fix_init` (`test_comphelp.c:504-524`) over `compspec_fix.h`'s
/// environment.
fn help_fix_init() -> (HelpFix, edit.Ed) {
    var n = 0
    // # Safety: one thread; the counter names fresh trees.
    unsafe {
        fix_n += 1
        n = fix_n
    }
    let root = "/tmp/yew-comphelp-{os_pid()}-{n}"
    fs.remove_dir_all(root) else |_| {}
    var h = HelpFix {
        root: root,
        bin: "{root}/bin",
        cache: "{root}/cache",
        saved: List[str](),
        had: List[bool](),
        names: List[str](),
    }
    for d in ["bin", "state", "config/yew/completions", "home"] {
        fs.create_dir_all("{root}/{d}") else |_| { assert(false, "mkdir {d}") }
    }
    let cwd = os_cwd() else ""
    for name in [
        "YEW_RUNTIME_DIR",
        "XDG_CONFIG_HOME",
        "HOME",
        "XDG_CACHE_HOME",
        "XDG_STATE_HOME",
        "PATH",
    ] {
        let (v, had) = env_copy(name)
        (mut h.names).push(name)
        (mut h.saved).push(v)
        (mut h.had).push(had)
    }
    env_set("YEW_RUNTIME_DIR", "{cwd}/runtime") else |_| {}
    env_set("XDG_CONFIG_HOME", "{root}/config") else |_| {}
    env_set("HOME", "{root}/home") else |_| {}
    env_set("XDG_CACHE_HOME", h.cache) else |_| {}
    env_set("XDG_STATE_HOME", "{root}/state") else |_| {}
    env_set("PATH", h.bin) else |_| {}
    var ed = edit.ed_new()
    ed.ws_dir = root
    (h, ed)
}

fn help_fix_drop(h: HelpFix) {
    var i = 0
    while i < h.names.len {
        if h.had[i] {
            env_set(h.names[i], h.saved[i]) else |_| {}
        } else {
            env_unset(h.names[i]) else |_| {}
        }
        i += 1
    }
    assert(h.root.starts_with("/tmp/yew-"), "only /tmp/yew-*")
    fs.remove_dir_all(h.root) else |_| { assert(false, "remove {h.root}") }
}

/// `tool_install`: a native executable on the fixture PATH as `name`.
fn tool_install(h: HelpFix, name: str) {
    let exe = os_exe() else ""
    let b = fs.read_bytes(exe) else |_| {
        assert(false, "read {exe}")
        return
    }
    let path = "{h.bin}/{name}"
    fs.write_bytes(path, b) else |_| { assert(false, "write {path}") }
    fs.set_mode(path, 493) else |_| { assert(false, "chmod {path}") }
}

fn write_mode(path: str, data: List[byte], mode: int) {
    fs.write_bytes(path, data) else |_| { assert(false, "write {path}") }
    fs.set_mode(path, mode) else |_| { assert(false, "chmod {path}") }
}

// §1: the magic bytes (`test_comphelp.c:659-699`).
fn t_comphelp_magic_bytes_decide_native() {
    let (h, ed) = help_fix_init()
    tool_install(h, "native")
    write_mode("{h.bin}/script", bytes_of("#!/bin/sh\necho hi\n"), 493)
    write_mode("{h.bin}/data", bytes_of("hello world"), 420)
    var blob = List[byte]()
    for x in [1, 2, 3, 4] {
        (mut blob).push(x as byte)
    }
    for x in "rest".bytes() {
        (mut blob).push(x)
    }
    write_mode("{h.bin}/blob", blob, 493)
    assert(edit.comphelp_exe_kind("{h.bin}/native") == edit.HELP_EXE_NATIVE, "native")
    assert(edit.comphelp_exe_kind("{h.bin}/script") == edit.HELP_EXE_SCRIPT, "script")
    assert(edit.comphelp_exe_kind("{h.bin}/data") == edit.HELP_EXE_NONE, "data")
    assert(edit.comphelp_exe_kind("{h.bin}/blob") == edit.HELP_EXE_OTHER, "blob")
    assert(edit.comphelp_exe_kind(h.bin) == edit.HELP_EXE_NONE, "a directory")
    assert(
        edit.comphelp_kind_allowed(edit.HELP_POLICY_NATIVE, edit.HELP_EXE_NATIVE),
        "native/native",
    )
    assert(
        !edit.comphelp_kind_allowed(edit.HELP_POLICY_NATIVE, edit.HELP_EXE_SCRIPT),
        "native/script",
    )
    assert(
        !edit.comphelp_kind_allowed(edit.HELP_POLICY_NATIVE, edit.HELP_EXE_OTHER),
        "native/other",
    )
    assert(edit.comphelp_kind_allowed(edit.HELP_POLICY_ALL, edit.HELP_EXE_SCRIPT), "all/script")
    assert(edit.comphelp_kind_allowed(edit.HELP_POLICY_ALL, edit.HELP_EXE_OTHER), "all/other")
    assert(!edit.comphelp_kind_allowed(edit.HELP_POLICY_ALL, edit.HELP_EXE_NONE), "all/none")
    assert(!edit.comphelp_kind_allowed(edit.HELP_POLICY_OFF, edit.HELP_EXE_NATIVE), "off/native")
    assert(edit.comphelp_policy(ed) == edit.HELP_POLICY_NATIVE, "the default is native")
    // C's `yew_comphelp_policy(NULL)` (off) has no port: the policy
    // reads an editor, never an absent one.
    help_fix_drop(h)
}

fn set_policy(mut ed: edit.Ed, value: str) {
    ed.opts.store["shell.complete_help"] = value
}

// §1's denylist (`test_comphelp.c:756-806`): by typed name, `mkfs.*`, and
// the REAL name behind a symlink, in every mode. Nothing is queued, so
// the idle path C's `settle` drives has nothing to run.
fn t_comphelp_denylist_never_runs() {
    var (h, ed) = help_fix_init()
    tool_install(h, "rm")
    tool_install(h, "mkfs.fake")
    tool_install(h, "shutdown")
    fs.symlink("{h.bin}/rm", "{h.bin}/tidy") else |_| { assert(false, "symlink") }
    assert(
        edit.comphelp_denied("rm") &&
            edit.comphelp_denied("mkfs.ext4") &&
            edit.comphelp_denied("sudo"),
        "denied",
    )
    assert(!edit.comphelp_denied("fac"), "fac is not")
    for mode in ["native", "all"] {
        edit.comphelp_reset(mut ed.help)
        set_policy(mut ed, mode)
        for name in ["rm", "mkfs.fake", "shutdown", "tidy"] {
            let (got, hl) = edit.comphelp_lookup(mut ed, name)
            assert(!got && !hl.pending, "{name} under {mode}")
        }
        assert(edit.comphelp_queued(ed.help) == 0, "nothing queued under {mode}")
        assert(edit.comphelp_idle(mut ed, 0) == 0, "nothing to run")
    }
    assert(edit.comphelp_spawns(ed.help) == 0, "nothing ran")
    help_fix_drop(h)
}

// A command with a spec never runs (`test_comphelp.c:808-838`).
fn t_comphelp_spec_wins_over_help() {
    var (h, ed) = help_fix_init()
    tool_install(h, "tool")
    fs.write_text(
        "{h.root}/config/yew/completions/tool.fl",
        "# test 1\n{{ completion: 1, command: \"tool\" }}\n",
    ) else |_| {}
    let (got, hl) = edit.comphelp_lookup(mut ed, "tool")
    assert(!got && !hl.pending, "the spec wins")
    fs.symlink("{h.bin}/tool", "{h.bin}/alias") else |_| { assert(false, "symlink") }
    let (got2, _) = edit.comphelp_lookup(mut ed, "alias")
    assert(!got2, "under another name too")
    assert(edit.comphelp_queued(ed.help) == 0, "nothing queued")
    assert(edit.comphelp_idle(mut ed, 0) == 0 && edit.comphelp_spawns(ed.help) == 0, "nothing ran")
    help_fix_drop(h)
}

// ------------------------------------------------------------------
// Port-only: the paths 0.2.33 reaches
// ------------------------------------------------------------------

/// The cache file C yew writes for `tool` (`cache_write`,
/// `comphelp.c:1923-1992`), built with the port's writer in C's form.
fn write_cache(h: HelpFix, name: str, subs: List[str], help: str, empty: bool) -> str {
    let real = text.file_realpath("{h.bin}/{name}") else ""
    let info = fs.stat(real) else |_| {
        assert(false, "stat {real}")
        return ""
    }
    let key = edit.comphelp_key(real, info.mtime_s, info.size, subs)
    let dir = "{h.cache}/yew/completions/help"
    fs.create_dir_all(dir) else |_| {}
    var out = bytes_of(
        "# yew: learned from `{name} --help`; ed.shell.complete_forget drops it\n{{\n  help_cache: 1,\n  exe: ",
    )
    edit.fdw_string(mut out, real)
    edit.fdw_str(mut out, ",\n  mtime: {info.mtime_s},\n  size: {info.size},\n  argv: [\n")
    for s in subs {
        edit.fdw_str(mut out, "    ")
        edit.fdw_string(mut out, s)
        edit.fdw_str(mut out, ",\n")
    }
    edit.fdw_str(mut out, "  ],\n")
    if empty {
        edit.fdw_str(mut out, "  empty: true,\n")
    } else {
        edit.fdw_str(mut out, "  empty: false,\n  node: ")
        var w = List[str]()
        (mut w).push(name)
        for s in subs {
            (mut w).push(s)
        }
        let (ok, spec) = edit.comphelp_parse("help:{real}", w, bytes_of(help))
        assert(ok, "the help parses")
        edit.compspec_write_node(spec, 0, 1, true, mut out)
    }
    edit.fdw_str(mut out, "}}\n\n")
    let path = "{dir}/{key}.fl"
    fs.write_bytes(path, out) else |_| { assert(false, "write the cache") }
    path
}

fn clap_help() -> str {
    "A fixture tool.\n\nUsage: tool [OPTIONS] <COMMAND>\n\nCommands:\n  build  Compile the project\n  bench  Run the benchmarks\n  auth   Manage credentials\n  help   Print this message or the help of the given subcommand(s)\n\nOptions:\n  -o, --output <FILE>   Write here\n  -v, --verbose         More output\n  -h, --help            Print help\n"
}

// A cache file in C's form is a hit: the tree, nothing queued, nothing
// spawned (C's `cache_hits_and_upgrades_miss` after its first run); an
// upgrade (a new mtime) misses and queues.
fn t_port_comphelp_cache_written_by_c_is_a_hit() {
    var (h, ed) = help_fix_init()
    tool_install(h, "tool")
    let _ = write_cache(h, "tool", List[str](), clap_help(), false)
    let (got, hl) = edit.comphelp_lookup(mut ed, "tool")
    assert(got && hl.spec >= 0, "a hit")
    let sp = hl.spec
    assert(ed.specs.pool[sp].nodes[0].subs.len == 4, "the tree: four subcommands")
    assert(
        edit.comphelp_queued(ed.help) == 0 && edit.comphelp_spawns(ed.help) == 0,
        "nothing asked",
    )
    edit.comphelp_reset(mut ed.help)
    let later = fs.time(1000000000, 0)
    fs.set_times("{h.bin}/tool", later, later) else |_| { assert(false, "touch") }
    let (got2, hl2) = edit.comphelp_lookup(mut ed, "tool")
    assert(!got2 && hl2.pending && hl2.key.len == 16, "an upgrade misses and queues")
    help_fix_drop(h)
}

// `empty: true` suppresses the ask (C's `negative_result_is_cached`).
fn t_port_comphelp_negative_cache_entry_suppresses_the_ask() {
    var (h, ed) = help_fix_init()
    tool_install(h, "fackr")
    let path = write_cache(h, "fackr", List[str](), "", true)
    let text = fs.read_text(path) else ""
    assert(text.contains("empty: true") && !text.contains("node:"), "a negative entry")
    let (got, hl) = edit.comphelp_lookup(mut ed, "fackr")
    assert(!got && !hl.pending, "negative, not asked")
    assert(edit.comphelp_queued(ed.help) == 0, "nothing queued")
    help_fix_drop(h)
}

// A torn or tampered cache file is a miss (C's `truncated_cache_is_a_miss`
// without the rewrite a run would make).
fn t_port_comphelp_truncated_cache_is_a_miss() {
    var (h, ed) = help_fix_init()
    tool_install(h, "tool")
    let path = write_cache(h, "tool", List[str](), clap_help(), false)
    let text = fs.read_bytes(path) else List[byte]()
    let step = text.len / 7 + 1
    var cut = 1
    while cut < text.len {
        var part = List[byte]()
        var i = 0
        while i < cut {
            (mut part).push(text[i])
            i += 1
        }
        fs.write_bytes(path, part) else |_| {}
        edit.comphelp_reset(mut ed.help)
        let (got, hl) = edit.comphelp_lookup(mut ed, "tool")
        assert(!got && hl.pending, "torn at {cut}: a miss")
        cut += step
    }
    let full = str_from_utf8(text) else ""
    let at = full.find("exe: \"/") else -1
    assert(at >= 0, "the exe row")
    let bad = full[0..at + 6] + "X" + full[at + 7..]
    fs.write_text(path, bad) else |_| {}
    edit.comphelp_reset(mut ed.help)
    let (got, hl) = edit.comphelp_lookup(mut ed, "tool")
    assert(!got && hl.pending, "tampered: a miss")
    help_fix_drop(h)
}

// `ed.shell.complete_forget fac` deletes only fac's entries, disk and
// memory; with no argument, every entry (C's `forget_deletes_only_that_
// command`, the cache hand-written where C's runs wrote it).
fn t_port_comphelp_forget_deletes_only_that_command() {
    var (h, ed) = help_fix_init()
    tool_install(h, "fac")
    tool_install(h, "other")
    let fac = write_cache(h, "fac", List[str](), clap_help(), false)
    let sub = write_cache(
        h,
        "fac",
        one("auth"),
        "Usage: fac auth <COMMAND>\n\nCommands:\n  login   Sign in\n",
        false,
    )
    let other = write_cache(h, "other", List[str](), clap_help(), false)
    let (g1, _) = edit.comphelp_lookup(mut ed, "fac")
    let (g2, _) = edit.comphelp_lookup(mut ed, "other")
    assert(g1 && g2, "both learned")
    assert(edit.comphelp_run_forget(mut ed, "fac") == edit.CMD_OK, "forget fac")
    assert(ed.msg.text.contains("fac (2 cache files)"), "two files: {ed.msg.text}")
    assert(!fs.exists(fac) && !fs.exists(sub), "fac's gone")
    assert(fs.exists(other), "other's kept")
    let (g3, hl3) = edit.comphelp_lookup(mut ed, "fac")
    assert(!g3 && hl3.pending, "fac re-learns")
    let (g4, _) = edit.comphelp_lookup(mut ed, "other")
    assert(g4, "other still known")
    assert(edit.comphelp_run_forget(mut ed, "") == edit.CMD_OK, "forget all")
    assert(!fs.exists(other) && ed.msg.text.contains("forgot all"), "all gone")
    help_fix_drop(h)
}

// The idle path refuses by name (R-yw04-1) the way C handles a spawn
// failure (`comphelp.c:2627-2635`): the negative remembered for the
// session, the request dropped, nothing on disk.
fn t_port_comphelp_idle_refuses_by_name() {
    var (h, ed) = help_fix_init()
    tool_install(h, "tool")
    let (got, hl) = edit.comphelp_lookup(mut ed, "tool")
    assert(!got && hl.pending && hl.key.len == 16, "queued, with a 16-digit key")
    assert(edit.comphelp_spawns(ed.help) == 0, "nothing on the keystroke path")
    assert(edit.comphelp_idle_ready(ed.help, 0), "ready on the idle path")
    assert(edit.comphelp_idle(mut ed, 0) == 0, "no job started")
    assert(edit.comphelp_spawns(ed.help) == 1, "one attempt")
    assert(
        edit.comphelp_last_argv(ed.help) == "{h.bin}/tool --help",
        "the resolved argv: {edit.comphelp_last_argv(ed.help)}",
    )
    assert(edit.comphelp_queued(ed.help) == 0, "the request dropped")
    let (got2, hl2) = edit.comphelp_lookup(mut ed, "tool")
    assert(!got2 && !hl2.pending, "remembered negative for the session")
    assert(!fs.exists("{h.cache}/yew/completions/help"), "nothing written")
    let log = fs.read_text(env_get("YEW_LOG") else "") else ""
    assert(
        log.contains(
            "completion help tool: not yet ported: the --help job: needs os_signal_wait_fds (G2, wolf-lang#795)",
        ),
        "the refusal is logged: {log}",
    )
    help_fix_drop(h)
}

fn skip(name: str, why: str) -> int {
    print("comphelp_test: SKIP {name}: {why}")
    eprint("comphelp_test: SKIP {name}: {why}")
    1
}

fn main() {
    fs.create_dir_all("target/tests") else |_| {}
    let log = "target/tests/edit-comphelp-test.log"
    fs.remove(log) else |_| {}
    env_set("YEW_LOG", log) else |_| {}
    let job = "runs `--help` as a job whose pipes are read while the loop runs: needs os_signal_wait_fds (G2, wolf-lang#795), R-yw04-1"
    var skips = 0
    t_comphelp_parses_every_layout_fixture()
    t_comphelp_user_tools_behave_as_stated()
    t_comphelp_classifies_terms()
    t_comphelp_survives_huge_and_blank_inputs()
    t_comphelp_node_data_form_round_trips()
    t_comphelp_magic_bytes_decide_native()
    skips += skip("comphelp_policy_native_all_off", job)
    t_comphelp_denylist_never_runs()
    t_comphelp_spec_wins_over_help()
    skips += skip("comphelp_runs_the_resolved_path_without_stdin", job)
    skips += skip("comphelp_descends_only_into_listed_subcommands", job)
    skips += skip("comphelp_cache_hits_and_upgrades_miss", job)
    skips += skip("comphelp_negative_result_is_cached", job)
    skips += skip("comphelp_truncated_cache_is_a_miss", job)
    skips += skip("comphelp_cache_prunes_at_2000", job)
    skips += skip("comphelp_forget_deletes_only_that_command", job)
    skips += skip("comphelp_prewarm_only_on_the_idle_tick", job)
    skips += skip("comphelp_first_tab_pends_second_completes", job)
    skips += skip("comphelp_negative_falls_back_to_paths", job)
    skips += skip("comphelp_loop_deadline_shares_the_idle_condition", job)
    skips += skip("comphelp_relative_word_follows_the_effective_directory", job)
    t_port_comphelp_cache_written_by_c_is_a_hit()
    t_port_comphelp_negative_cache_entry_suppresses_the_ask()
    t_port_comphelp_truncated_cache_is_a_miss()
    t_port_comphelp_forget_deletes_only_that_command()
    t_port_comphelp_idle_refuses_by_name()
    print("comphelp_test: {21 - skips} C cases pass, {skips} SKIP; 5 port cases pass")
}
