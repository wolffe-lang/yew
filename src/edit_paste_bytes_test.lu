//! member: false
//!
//! yew#18's row, port-only: a bracketed paste of bytes that are not UTF-8
//! lands in the buffer verbatim in I mode (`ed_handle_paste`, `ed.c:2435-
//! 2476`: one `ed.edit.insert.text` whose argument is the paste's bytes).
//! The buffer is bytes (invariant 2) and C inserts them; the port carries
//! them as `CmdCtx.sbytes` beside the `str` argument since `a7be446`. A
//! typed key never carries invalid UTF-8: the decoder drops such a byte
//! before it is a key (`term_input_test`, "invalid byte is dropped").

use edit
use text

fn doc(ed: edit.Ed) -> List[byte] {
    text.textbuf_bytes(ed.bufs[ed.wins[ed.win].buf].ec.tb)
}

fn shown(v: List[byte]) -> str {
    var s = ""
    for b in v {
        s += " {b as int}"
    }
    s
}

fn paste_invalid_utf8_lands_verbatim() {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    assert(edit.mode_enter(mut ed, edit.MODE_I) == edit.CMD_OK, "I mode")
    var bytes = List[byte]()
    for b in [97, 255, 98, 192, 10, 99] {
        (mut bytes).push(b as byte)
    }
    edit.ed_handle_paste(mut ed, List[byte](), true, false)
    edit.ed_handle_paste(mut ed, bytes, false, false)
    edit.ed_handle_paste(mut ed, List[byte](), false, true)
    let got = doc(ed)
    assert(got.len == bytes.len, "the buffer holds{shown(got)}, the paste was{shown(bytes)}")
    for i in 0..bytes.len {
        assert(got[i] == bytes[i], "byte {i}: the buffer holds{shown(got)}")
    }
    assert(ed.mode == edit.MODE_I, "still I")
}

fn main() {
    paste_invalid_utf8_lands_verbatim()
    print("paste_invalid_utf8_lands_verbatim: PASS")
    print("paste_bytes_test: 1 case pass")
}
