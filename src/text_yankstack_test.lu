//! member: false
//!
//! The port of sagitta `tests/unit/test_yankstack.c` (156 lines), one test
//! per C test in registry order (`tests/unit/registry.c:112-117`). C's
//! owners are the addresses of two statics; here they are window ids 1
//! and 2. C's `yew_yank_at(NULL, 0)` has no wolf spelling (no NULL stack).

use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn kill(mut y: text.YankStack, s: str, d: int, seq: int, owner: int) {
    text.yank_kill(mut y, bytes_of(s), d, seq, owner)
}

fn expect(y: text.YankStack, k: int, want: str) {
    let entry = text.yank_at(y, k) else {
        assert(false, "entry {k} exists")
        return
    }
    assert(same(entry, bytes_of(want)), "entry {k} is {want}")
}

fn absent(y: text.YankStack, k: int) -> bool {
    let _ = text.yank_at(y, k) else {
        return true
    }
    false
}

fn yankstack_consecutive_kills_join_by_direction() {
    var y = text.yank_new()
    kill(mut y, "one", text.KILL_FORWARD, 10, 1)
    kill(mut y, " two", text.KILL_FORWARD, 11, 1)
    assert(y.len == 1, "one entry")
    expect(y, 0, "one two")
    kill(mut y, "gamma", text.KILL_BACKWARD, 20, 1)
    kill(mut y, "beta ", text.KILL_BACKWARD, 21, 1)
    kill(mut y, "alpha ", text.KILL_BACKWARD, 22, 1)
    assert(y.len == 2, "two entries")
    expect(y, 0, "alpha beta gamma")
    expect(y, 1, "one two")
    assert(y.bytes == 23, "23 bytes, got {y.bytes}")
    text.yank_free(mut y)
}

fn yankstack_a_gap_or_another_win_starts_a_new_entry() {
    var y = text.yank_new()
    kill(mut y, "a", text.KILL_FORWARD, 1, 1)
    kill(mut y, "b", text.KILL_FORWARD, 3, 1)
    kill(mut y, "c", text.KILL_FORWARD, 4, 2)
    assert(y.len == 3, "three entries")
    expect(y, 0, "c")
    expect(y, 1, "b")
    expect(y, 2, "a")
    text.yank_free(mut y)
}

fn yankstack_multicursor_kill_never_extends() {
    var y = text.yank_new()
    kill(mut y, "x", text.KILL_FORWARD, 1, 1)
    kill(mut y, "yz", text.KILL_ALONE, 2, 1)
    kill(mut y, "w", text.KILL_FORWARD, 3, 1)
    assert(y.len == 3, "three entries")
    expect(y, 0, "w")
    expect(y, 1, "yz")
    expect(y, 2, "x")
    text.yank_free(mut y)
}

fn yankstack_evicts_by_count() {
    var y = text.yank_new()
    var i = 0
    while i < text.YANK_MAX + 5 {
        kill(mut y, "k{i}", text.KILL_FORWARD, 2 * i, 1)
        i += 1
    }
    assert(y.len == text.YANK_MAX, "capped at {text.YANK_MAX}")
    expect(y, 0, "k36")
    expect(y, text.YANK_MAX - 1, "k5")
    assert(absent(y, text.YANK_MAX), "nothing past the cap")
    text.yank_free(mut y)
}

fn yankstack_evicts_by_bytes_and_keeps_the_newest() {
    var y = text.yank_new()
    y.bytes_max = 8
    kill(mut y, "abcd", text.KILL_FORWARD, 1, 1)
    kill(mut y, "efgh", text.KILL_FORWARD, 3, 1)
    assert(y.len == 2, "two at the cap")
    kill(mut y, "ij", text.KILL_FORWARD, 5, 1)
    assert(y.len == 2, "the oldest went")
    expect(y, 0, "ij")
    expect(y, 1, "efgh")
    assert(y.bytes == 6, "6 bytes")
    kill(mut y, "0123456789", text.KILL_FORWARD, 7, 1)
    assert(y.len == 1, "the newest alone over the cap")
    expect(y, 0, "0123456789")
    assert(y.bytes == 10, "10 bytes")
    kill(mut y, "x", text.KILL_FORWARD, 9, 1)
    assert(y.len == 1, "one")
    kill(mut y, "ab", text.KILL_FORWARD, 20, 1)
    assert(y.len == 2, "two")
    kill(mut y, "cdefgh", text.KILL_FORWARD, 21, 1)
    assert(y.len == 1, "a join over the cap drops the older")
    expect(y, 0, "abcdefgh")
    assert(y.bytes == 8, "8 bytes")
    text.yank_free(mut y)
}

fn yankstack_at_bounds() {
    var y = text.yank_new()
    assert(absent(y, 0), "empty")
    text.yank_kill(mut y, List[byte](), text.KILL_FORWARD, 1, 1)
    assert(y.len == 0, "an empty kill records nothing")
    kill(mut y, "only", text.KILL_FORWARD, 2, 1)
    expect(y, 0, "only")
    assert(absent(y, 1), "one entry only")
    text.yank_free(mut y)
    assert(y.len == 0, "freed")
    assert(y.bytes == 0, "no bytes")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    yankstack_consecutive_kills_join_by_direction()
    yankstack_a_gap_or_another_win_starts_a_new_entry()
    yankstack_multicursor_kill_never_extends()
    yankstack_evicts_by_count()
    yankstack_evicts_by_bytes_and_keeps_the_newest()
    yankstack_at_bounds()
    print("yankstack_test: 6 cases pass")
}
