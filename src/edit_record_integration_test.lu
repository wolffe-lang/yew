//! member: false
//! The seventeen tests/unit/test_record_integration.c cases at sagitta
//! 9ace98c2, in registry order (Sprint 35: the recorder in the editor).
//! C's `yew_ed_invoke` is `edit.ed_cmd_invoke`, its `yew_cmd_invoke`
//! `edit.cmd_invoke`; `yew_ed_edit_ctx` + `yew_undo` is the window's
//! context taken, `text.undo`, and given back; C's `ed->buffer` is the
//! primary buffer, slot 0.
//!
//! test_record_shadow_escape_records_only_the_mode_change's first half
//! (test_record_integration.c:239-246) sets a live shadow and needs
//! Sprint 43's dismissal of it (yw11); before that lane no shadow can be
//! live, so the case runs from its second half: dismissal with none live
//! is the mode escape, recorded once.

use edit
use term
use text

fn open() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed
}

fn ctx(ed: edit.Ed, sarg: List[byte], count: int, source: int) -> edit.CmdCtx {
    var cx = edit.cmdctx_new(ed.win, source)
    cx.count = count
    cx.count_given = count != 1
    if sarg.len != 0 {
        cx.has_sarg = true
        cx.has_sbytes = true
        cx.sbytes = copy sarg
        cx.sarg = str_from_utf8(sarg) else ""
    }
    cx
}

fn id_of(ed: edit.Ed, name: str) -> int {
    let id = edit.cmd_lookup(ed.reg, name)
    assert(id != 0, "no command {name}")
    id
}

// rf_run (test_record_integration.c:28-43).
fn run(mut ed: edit.Ed, name: str, sarg: str, count: int, source: int) -> int {
    let id = id_of(ed, name)
    var cx = ctx(ed, sarg.bytes(), count, source)
    edit.ed_cmd_invoke(mut ed, id, mut cx)
}

fn buffer(ed: edit.Ed) -> List[byte] { text.textbuf_bytes(ed.bufs[0].ec.tb) }

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

// assert_buffer (test_record_integration.c:45-66).
fn is_buffer(ed: edit.Ed, want: str) -> bool { same(buffer(ed), want.bytes()) }

fn set_macro(mut ed: edit.Ed, r: int, source: str) {
    assert(edit.flapi_reg_write(mut ed, r, source.bytes(), false) == edit.CMD_OK)
}

fn contains(hay: List[byte], needle: str) -> bool {
    let n = needle.bytes()
    if n.len == 0 { return true }
    if n.len > hay.len { return false }
    for i in 0..hay.len - n.len + 1 {
        var ok = true
        for j in 0..n.len { if hay[i + j] != n[j] { ok = false; break } }
        if ok { return true }
    }
    false
}

fn undo(mut ed: edit.Ed) -> bool {
    let w = ed.win
    let b = ed.wins[w].buf
    edit.edit_take(mut ed, w)
    let done = text.undo(mut ed.bufs[b].ec)
    edit.edit_give(mut ed, w)
    done
}

fn reg_bytes(mut ed: edit.Ed, r: int) -> List[byte] {
    let v = text.reg_get(mut ed.regs, r) else { return List[byte]() }
    copy v.bytes
}

fn record_state_machine_reports_start_stop_and_last_register() {
    var ed = open()
    assert(!edit.record_active(ed))
    assert(!edit.record_start(mut ed, '1' as int))
    assert(edit.record_start(mut ed, 'a' as int))
    assert(edit.record_active(ed))
    assert(!edit.record_start(mut ed, 'b' as int))
    let s = edit.record_status(ed)
    assert(s.active && s.reg == 'a' as int && s.nevents == 0)
    assert(edit.record_stop(mut ed) == edit.CMD_OK)
    assert(!edit.record_active(ed))
    let t = edit.record_status(ed)
    assert(!t.active && t.last_reg == 'a' as int)
    assert(edit.record_stop(mut ed) == edit.CMD_ERR_STATE)
}

fn record_tap_deep_copies_binary_arguments_and_resolved_context() {
    var payload = ['a' as int as byte, 0 as byte, 128 as byte, 'z' as int as byte]
    var ed = open()
    assert(edit.record_start(mut ed, 'c' as int))
    var cx = ctx(ed, payload, 7, edit.SRC_MOUSE)
    cx.count_given = true
    cx.iarg = -42
    cx.bang = true
    cx.range.given = true
    cx.range.tok_lo = 3
    cx.range.tok_hi = 9
    ed.mode = edit.MODE_H
    edit.record_tap(mut ed, id_of(ed, "ed.file.save"), cx)
    assert(ed.rec.ev.len == 1)
    let e = copy ed.rec.ev[0]
    assert(e.count == 7 && e.count_given && e.iarg == -42 && e.bang)
    assert(e.range_kind == edit.REC_RANGE_SPAN && e.range_given)
    assert(e.range_lo == 3 && e.range_hi == 9)
    assert(e.mode == edit.MODE_H && e.src == edit.SRC_MOUSE)
    assert(e.sarg_len == 4)
    payload[0] = 'X' as int as byte
    payload[1] = 'Y' as int as byte
    assert(same(ed.rec.blob[e.sarg_at..e.sarg_at + 4], ['a' as int as byte, 0 as byte, 128 as byte, 'z' as int as byte]))
}

fn record_tap_drops_replay_source() {
    var ed = open()
    let next = id_of(ed, "ed.move.unit.next")
    let enter = id_of(ed, "ed.mode.enter")
    assert(edit.record_start(mut ed, 'd' as int))
    var cx = ctx(ed, List[byte](), 1, edit.SRC_REPLAY)
    edit.record_tap(mut ed, next, cx)
    assert(ed.rec.ev.len == 0)
    cx.source = edit.SRC_FLETCH
    edit.record_tap(mut ed, next, cx)
    assert(ed.rec.ev.len == 1)
    assert(edit.record_stop(mut ed) == edit.CMD_OK)

    assert(edit.record_start(mut ed, 'e' as int))
    var e = ctx(ed, "E".bytes(), 1, edit.SRC_KEY)
    edit.record_tap(mut ed, enter, e)
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    var ignored = ctx(ed, "ignored".bytes(), 1, edit.SRC_KEY)
    edit.record_tap(mut ed, id_of(ed, "ed.edit.insert.text"), ignored)
    assert(ed.rec.ev.len == 0)
    var line = ctx(ed, List[byte](), 1, edit.SRC_CMDLINE)
    edit.record_tap(mut ed, next, line)
    assert(ed.rec.ev.len == 1 && ed.rec.ev[0].src == edit.SRC_CMDLINE)
    edit.cmdline_close(mut ed, false)
    assert(edit.record_stop(mut ed) == edit.CMD_OK)

    assert(edit.record_start(mut ed, 'f' as int))
    edit.record_tap(mut ed, enter, e)
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    edit.cmdline_close(mut ed, false)
    // Cancelling contributes no committed CMDLINE command.
    assert(ed.rec.ev.len == 0)
    assert(edit.record_stop(mut ed) == edit.CMD_OK)

    assert(edit.record_start(mut ed, 'g' as int))
    var shell = ctx(ed, List[byte](), 1, edit.SRC_KEY)
    edit.record_tap(mut ed, id_of(ed, "ed.shell.open"), shell)
    assert(ed.rec.in_prompt && ed.rec.ev.len == 0)
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "!")
    shell.source = edit.SRC_CMDLINE
    edit.record_tap(mut ed, next, shell)
    assert(ed.rec.ev.len == 1 && ed.rec.ev[0].src == edit.SRC_CMDLINE)
    edit.cmdline_close(mut ed, false)
    assert(edit.record_stop(mut ed) == edit.CMD_OK)
}

fn record_dispatch_ignores_nonrecordable_commands() {
    var ed = open()
    assert(edit.record_start(mut ed, 'e' as int))
    assert(run(mut ed, "ed.macro.list", "", 1, edit.SRC_TEST) == edit.CMD_OK)
    assert(ed.rec.ev.len == 0)
}

fn record_shadow_escape_records_only_the_mode_change() {
    var ed = open()
    ed.mode = edit.MODE_I
    ed.prev_unit = edit.MODE_I
    assert(edit.record_start(mut ed, 'e' as int))
    // test_record_integration.c:242-246 (a live shadow dismissed, the mode
    // kept, nothing recorded) is Sprint 43's (yw11).
    assert(run(mut ed, "ed.shadow.dismiss", "", 1, edit.SRC_KEY) == edit.CMD_OK)
    let escape = id_of(ed, "ed.mode.escape")
    assert(ed.mode == edit.MODE_L)
    assert(ed.rec.ev.len == 1 && ed.rec.ev[0].cmd == escape)
    assert(edit.record_stop(mut ed) == edit.CMD_OK)
}

fn record_multicursor_dispatch_captures_one_event() {
    var ed = open()
    let w = ed.win
    assert(!text.cset_add(mut ed.wins[w].cs, text.cursor_at(0 as text.ByteOff)))
    assert(run(mut ed, "ed.edit.insert.text", "ab", 1, edit.SRC_TEST) == edit.CMD_OK)
    assert(text.cset_add(mut ed.wins[w].cs, text.cursor_at(1 as text.ByteOff)))
    assert(edit.record_start(mut ed, 'f' as int))
    assert(run(mut ed, "ed.edit.insert.text", "X", 1, edit.SRC_TEST) == edit.CMD_OK)
    assert(ed.rec.ev.len == 1 && ed.wins[w].cs.curs.len == 2)
}

fn record_rejects_nonportable_targets_before_execution() {
    var ed = open()
    let insert = id_of(ed, "ed.edit.insert.text")
    assert(edit.record_start(mut ed, 'g' as int))
    var cx = ctx(ed, "x".bytes(), 1, edit.SRC_FLETCH)
    cx.cursor_given = true
    assert(edit.cmd_invoke(mut ed, insert, mut cx) == edit.CMD_ERR_STATE)
    assert(ed.rec.ev.len == 0 && is_buffer(ed, ""))
    cx.cursor_given = false
    // C's `Win other = {0}`: a window that is not the editor's current
    // one; the preflight refuses before anything resolves it.
    cx.win = ed.wins.len
    assert(edit.cmd_invoke(mut ed, insert, mut cx) == edit.CMD_ERR_STATE)
    assert(ed.rec.ev.len == 0 && is_buffer(ed, ""))
}

fn record_cmdline_accepts_prompt_edits_and_keeps_status_messages() {
    var ed = open()
    let accept = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    let pasted = copy "ed.macro.record a".bytes()
    edit.cmdline_paste(mut ed, pasted)
    assert(edit.cmdline_accept_cmd(mut ed, accept) == edit.CMD_OK)
    assert(edit.record_active(ed))
    assert(ed.msg.active && ed.msg.text == "recording @a")

    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    edit.record_key(mut ed)
    assert(ed.rec.in_prompt)
    let stop = copy "ed.macro.stop".bytes()
    edit.cmdline_paste(mut ed, stop)
    assert(edit.cmdline_accept_cmd(mut ed, accept) == edit.CMD_OK)
    assert(!edit.record_active(ed))
    assert(ed.msg.active && ed.msg.text.starts_with("recorded @a (0 events, "))

    assert(run(mut ed, "ed.macro.record", "", 1, edit.SRC_TEST) == edit.CMD_OK)
    assert(ed.capture_cmd != 0)
    var key = term.key_new()
    key.kind = term.EV_KEY
    key.ev = term.KEY_PRESS
    key.code = 'b' as int
    (mut key.text).push('b' as int as byte)
    edit.dispatch_key(mut ed, key, 0)
    assert(edit.record_active(ed) && ed.rec.reg == 'b' as int)
    assert(run(mut ed, "ed.macro.record", "", 1, edit.SRC_TEST) == edit.CMD_OK)
    assert(!edit.record_active(ed))
}

fn record_prompt_close_keeps_the_next_nonkey_dispatch() {
    var ed = open()
    assert(edit.record_start(mut ed, 'b' as int))
    edit.cmdline_open(mut ed, edit.PROMPT_SEARCH_F, "")
    edit.record_key(mut ed)
    assert(ed.rec.in_prompt)
    edit.cmdline_close(mut ed, false)
    assert(!ed.cmdline.active)
    assert(run(mut ed, "ed.move.unit.next", "", 1, edit.SRC_MOUSE) == edit.CMD_OK)
    assert(run(mut ed, "ed.move.unit.prev", "", 1, edit.SRC_FLETCH) == edit.CMD_OK)
    assert(ed.rec.ev.len == 2)
    assert(ed.rec.ev[0].src == edit.SRC_MOUSE && ed.rec.ev[1].src == edit.SRC_FLETCH)
}

fn record_range_envelope_replays_the_same_span_edit() {
    var ed = open()
    assert(run(mut ed, "ed.edit.insert.text", "abcdef", 1, edit.SRC_TEST) == edit.CMD_OK)
    assert(edit.record_start(mut ed, 'h' as int))
    var cx = ctx(ed, List[byte](), 1, edit.SRC_FLETCH)
    cx.range.given = true
    cx.range.tok_lo = 1
    cx.range.tok_hi = 3
    assert(edit.ed_cmd_invoke(mut ed, id_of(ed, "ed.edit.delete.span"), mut cx) == edit.CMD_OK)
    assert(is_buffer(ed, "adef"))
    assert(edit.record_stop(mut ed) == edit.CMD_OK)
    assert(ed.rec.ev.len == 1 && ed.rec.ev[0].range_kind == edit.REC_RANGE_SPAN)
    assert(undo(mut ed))
    assert(is_buffer(ed, "abcdef"))
    assert(edit.macro_replay(mut ed, 'h' as int, 1) == edit.CMD_OK)
    assert(is_buffer(ed, "adef"))
}

fn record_stop_stores_parseable_source_and_uppercase_appends() {
    var ed = open()
    assert(edit.record_start(mut ed, 'a' as int))
    assert(run(mut ed, "ed.edit.insert.text", "one", 1, edit.SRC_TEST) == edit.CMD_OK)
    assert(edit.record_stop(mut ed) == edit.CMD_OK)
    let v = text.reg_get(mut ed.regs, 'a' as int) else {
        assert(false)
        return
    }
    assert(v.kind == text.REG_CHARWISE && v.bytes.len > 32)
    assert(contains(v.bytes, "i\"one\""))
    let first = v.bytes.len

    assert(edit.record_start(mut ed, 'A' as int))
    assert(run(mut ed, "ed.edit.insert.text", "two", 1, edit.SRC_TEST) == edit.CMD_OK)
    assert(edit.record_stop(mut ed) == edit.CMD_OK)
    let both = reg_bytes(mut ed, 'a' as int)
    assert(both.len > first && contains(both, "i\"one\"") && contains(both, "i\"two\""))
    assert(undo(mut ed))
    assert(undo(mut ed))
    assert(is_buffer(ed, ""))
    assert(edit.macro_replay(mut ed, 'a' as int, 1) == edit.CMD_OK)
    assert(is_buffer(ed, "onetwo"))
}

fn macro_replay_uses_one_undo_node_per_run() {
    var ed = open()
    set_macro(mut ed, 'a' as int, "@[ i\"x\" ]\n")
    assert(edit.macro_replay(mut ed, 'a' as int, 5) == edit.CMD_OK)
    assert(is_buffer(ed, "xxxxx"))
    var i = 5
    while i != 0 {
        assert(undo(mut ed))
        assert(text.textbuf_len(ed.bufs[0].ec.tb) == i - 1)
        i -= 1
    }
    assert(!undo(mut ed))
}

fn macro_replay_rolls_back_on_runtime_error() {
    var ed = open()
    set_macro(mut ed, 'b' as int, "@[ i\"changed\" ]\nmissing_function()\n")
    assert(edit.macro_replay(mut ed, 'b' as int, 1) == edit.CMD_ERR_STATE)
    assert(is_buffer(ed, ""))
}

fn macro_replay_cache_invalidates_after_register_write() {
    var ed = open()
    set_macro(mut ed, 'c' as int, "@[ i\"a\" ]\n")
    assert(edit.macro_replay(mut ed, 'c' as int, 1) == edit.CMD_OK)
    assert(is_buffer(ed, "a"))
    set_macro(mut ed, 'c' as int, "@[ i\"b\" ]\n")
    assert(edit.macro_replay(mut ed, 'c' as int, 1) == edit.CMD_OK)
    assert(is_buffer(ed, "ab"))
}

fn recording_during_macro_replay_captures_no_inner_commands() {
    var ed = open()
    set_macro(mut ed, 'a' as int, "@[ i\"x\" > del ]\n")
    assert(edit.record_start(mut ed, 'b' as int))
    assert(edit.macro_replay(mut ed, 'a' as int, 1) == edit.CMD_OK)
    assert(ed.rec.ev.len == 0)
    assert(edit.record_stop(mut ed) == edit.CMD_OK)
}

fn macro_list_reports_only_nonempty_named_registers() {
    let mac = "@[ > ]\n"
    var ed = open()
    set_macro(mut ed, 'a' as int, mac)
    set_macro(mut ed, 'z' as int, mac)
    let info = edit.macro_list(mut ed)
    assert(info.len == 2)
    assert(info[0].kind == text.REG_CHARWISE && info[0].bytes == mac.len)
    assert(info[1].kind == text.REG_CHARWISE && info[1].bytes == mac.len)
}

fn fletch_record_and_replay_prelude_route_through_macro_commands() {
    var ed = open()
    assert(edit.fl_runtime_eval(mut ed, "edit {{ record(\"c\") }}".bytes()) == edit.CMD_ERR_STATE)
    assert(!edit.record_active(ed))
    assert(edit.fl_runtime_eval(mut ed, "record(\"a\")".bytes()) == edit.CMD_OK)
    assert(edit.record_active(ed))
    assert(
        edit.fl_runtime_eval(mut ed, "import ed\nedit {{ ed.run(\"ed.macro.stop\") }}".bytes()) ==
            edit.CMD_ERR_STATE,
    )
    assert(edit.record_active(ed))
    assert(edit.fl_runtime_eval(mut ed, "record(\"b\")".bytes()) == edit.CMD_ERR_STATE)
    assert(ed.rec.reg == 'a' as int)
    assert(run(mut ed, "ed.edit.insert.text", "q", 1, edit.SRC_TEST) == edit.CMD_OK)
    assert(edit.record_stop(mut ed) == edit.CMD_OK)
    assert(undo(mut ed))
    assert(is_buffer(ed, ""))
    assert(edit.fl_runtime_eval(mut ed, "replay(\"a\", 2)".bytes()) == edit.CMD_OK)
    assert(is_buffer(ed, "qq"))
    assert(undo(mut ed))
    assert(is_buffer(ed, "q"))
    assert(undo(mut ed))
    assert(is_buffer(ed, ""))
}

fn main() {
    record_state_machine_reports_start_stop_and_last_register()
    record_tap_deep_copies_binary_arguments_and_resolved_context()
    record_tap_drops_replay_source()
    record_dispatch_ignores_nonrecordable_commands()
    record_shadow_escape_records_only_the_mode_change()
    record_multicursor_dispatch_captures_one_event()
    record_rejects_nonportable_targets_before_execution()
    record_cmdline_accepts_prompt_edits_and_keeps_status_messages()
    record_prompt_close_keeps_the_next_nonkey_dispatch()
    record_range_envelope_replays_the_same_span_edit()
    record_stop_stores_parseable_source_and_uppercase_appends()
    macro_replay_uses_one_undo_node_per_run()
    macro_replay_rolls_back_on_runtime_error()
    macro_replay_cache_invalidates_after_register_write()
    recording_during_macro_replay_captures_no_inner_commands()
    macro_list_reports_only_nonempty_named_registers()
    fletch_record_and_replay_prelude_route_through_macro_commands()
    print("record_integration: 17 cases pass; the live-shadow half is yw11's")
}
