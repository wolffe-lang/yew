//! member: false
//! Ports sagitta tests/unit/test_syn_registry.c at 9ace98c2, one case per
//! C test in its order. The C allocation-overflow case has no wolf
//! counterpart (a registry is lists, with no byte-size arithmetic to
//! overflow) and is reported SKIP by name. tests/fixtures/syn/builtin-ids.txt
//! is the pin's tests/syn/builtin-ids.txt, byte for byte.

use search
use syn
use text

fn synthetic_rows(len: int, first_lines: bool) -> (str, str) {
    var rows = ""
    var lines = ""
    for i in 1..len + 1 {
        rows = rows + "{i} synthetic-{i} 0 runtime/syntax/synthetic-{i}.fl\n"
        if first_lines then lines = lines + "^needle-{i}$\t{i}\n"
    }
    (rows, lines)
}

fn bytes_eq(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len then return false
    for i in 0..a.len {
        if a[i] != b[i] then return false
    }
    true
}

fn same(bytes: List[byte], s: str) -> bool {
    if bytes.len != s.len then return false
    var i = 0
    for b in s.bytes() {
        if bytes[i] != b then return false
        i += 1
    }
    true
}

// test_syn_registry_exact_sizes_and_stable_descriptors
fn exact_sizes_and_stable_descriptors() {
    for len in [0, 1, 19, 32, 33, 48, 257] {
        let (rows, lines) = synthetic_rows(len, false)
        let reg = syn.syn_registry_build(rows, lines)
        assert(syn.syn_registry_count(reg) == len, "registry length")
        for i in 0..len {
            let id = i + 1
            assert(syn.syn_registry_ordinal(reg, id) == i, "stable ordinal")
            assert(reg.ids[i] == id, "descriptor id")
            assert(same(syn.syn_registry_name(reg, id), "synthetic-{id}"), "descriptor name")
            assert(syn.syn_registry_source(reg, id) == "runtime/syntax/synthetic-{id}.fl", "descriptor source")
        }
        assert(syn.syn_registry_ordinal(reg, len + 1) == -1, "past the end has no descriptor")
    }
}

// test_syn_registry_more_than_32_first_lines_reach_the_last_slot
fn more_than_32_first_lines_reach_the_last_slot() {
    let (rows, lines) = synthetic_rows(33, true)
    var reg = syn.syn_registry_build(rows, lines)
    for i in 0..33 {
        assert(syn.syn_registry_first_line(mut reg, i) >= 0, "every first line compiles")
    }
    let first = syn.syn_registry_first_line(mut reg, 32)
    let second = syn.syn_registry_first_line(mut reg, 32)
    assert(first == second, "the last slot's pattern is kept")
    assert(reg.first_compiled.len == 33, "each pattern compiled once")
    var input = List[byte]()
    for b in "needle-33".bytes() { (mut input).push(b) }
    var m = search.re_match_new()
    let matched = search.re_match_at(
        reg.first_compiled[first],
        text.textbuf_new(),
        input,
        search.re_input_bytes(input.len),
        0 as text.ByteOff,
        mut m,
    )
    assert(matched, "the 33rd first line matches its needle")
}

// test_syn_registry_loads_requested_definition_once
fn loads_requested_definition_once() {
    var reg = syn.syn_registry_build("7001 registry-lazy 0 registry-lazy.fl\n", "")
    var pool = syn.syn_pool_new()
    let source = "{{syntax:1,language:{{name:\"registry-lazy\"}},contexts:{{main:{{rules:[]}}}}}}"
    var bytes = List[byte]()
    for b in source.bytes() { (mut bytes).push(b) }
    let first = syn.syn_registry_load(mut reg, mut pool, 7001, "registry-lazy.fl", bytes)
    let second = syn.syn_registry_load(mut reg, mut pool, 7001, "registry-lazy.fl", bytes)
    assert(first >= 0, "the definition loads")
    assert(first == second, "the loaded definition is kept")
    assert(reg.compiles == 1, "loaded once")
    assert(syn.syn_registry_load(mut reg, mut pool, 7002, "registry-lazy.fl", bytes) == -1, "an unknown id loads nothing")
    assert(reg.compiles == 1, "an unknown id compiles nothing")
}

// test_syn_registry_builtin_id_ledger_matches_generated_table
fn builtin_id_ledger_matches_generated_table() {
    let reg = syn.syn_registry_new()
    let ledger = fs_read_bytes("tests/fixtures/syn/builtin-ids.txt") else {
        assert(false, "ledger readable")
        return
    }
    var row = 0
    var at = 0
    while at < ledger.len {
        var end = at
        while end < ledger.len && ledger[end] as int != 10 { end += 1 }
        if ledger[at] as int != 35 {
            var bars = List[int]()
            for i in at..end {
                if ledger[i] as int == 124 then (mut bars).push(i)
            }
            assert(bars.len == 2, "ledger row shape")
            var id = 0
            for i in at..bars[0] { id = id * 10 + (ledger[i] as int - 48) }
            let name = ledger[bars[0] + 1..bars[1]]
            let stem = ledger[bars[1] + 1..end]
            assert(row < syn.syn_registry_count(reg), "ledger within the table")
            assert(reg.ids[row] == id, "ledger id")
            assert(bytes_eq(reg.names[row], name), "ledger name")
            let stem_text = str_from_utf8(stem) else ""
            assert(reg.sources[row] == "runtime/syntax/{stem_text}.fl", "ledger source")
            assert(syn.syn_registry_lang_named(reg, name) == id, "named lookup")
            assert(syn.syn_registry_lang_by_name(reg, name, 0, name.len) == id, "byte lookup")
            assert(bytes_eq(syn.syn_registry_name(reg, id), name), "descriptor name")
            row += 1
        }
        at = end + 1
    }
    assert(row == syn.syn_registry_count(reg), "every table row in the ledger")
    assert(syn.syn_registry_count(reg) == 48, "48 builtins")
}

fn main() {
    let selected = (env_get("YEW_SYN_REGISTRY_CASE") else "-1").to_int() else -1
    for i in 0..5 {
        if selected == -1 || selected == i {
            match i {
                0 => exact_sizes_and_stable_descriptors(),
                1 => more_than_32_first_lines_reach_the_last_slot(),
                2 => loads_requested_definition_once(),
                3 => print("syn_registry_case_3: SKIP allocation_overflow_is_a_bug: a wolf registry has no byte-size arithmetic"),
                _ => builtin_id_ledger_matches_generated_table(),
            }
            if i != 3 then print("syn_registry_case_{i}: PASS")
        }
    }
}
