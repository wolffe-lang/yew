//! member: false
//!
//! The port of sagitta `tests/unit/test_re_unicode.c` (333 lines), one
//! test per C test in registry order (`tests/unit/registry.c:1601-1613`):
//! simple case folding (ASCII, the Kelvin sign, final sigma, no full
//! folding), no normalization, invalid bytes as escapes (they match `.`
//! and the negated classes, never `\w`/`\d`/`\s`, and are word
//! boundaries), a search over binary, and the chunk-carry cases only a
//! piece tree built by editing reproduces.

use search
use text

struct Tally {
    n: int,
}

fn ok(mut t: Tally, cond: bool, what: str) {
    t.n += 1
    assert(cond, what)
}

fn pb(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn hexv(c: int) -> int {
    if c >= 48 && c <= 57 then c - 48 else (if c >= 97 && c <= 102 then c - 87 else c - 55)
}

fn unhex(h: str) -> List[byte] {
    var v = List[byte]()
    let b = h.bytes()
    var i = 0
    while i + 1 < b.len {
        (mut v).push((hexv(b[i] as int) * 16 + hexv(b[i + 1] as int)) as byte)
        i += 2
    }
    v
}

fn at(n: int) -> text.ByteOff {
    n as text.ByteOff
}

// `find` (`test_re_unicode.c:20-37`): false when the pattern does not
// compile.
fn find(pat: List[byte], flags: int, input: List[byte], mut m: search.ReMatch) -> bool {
    var err = search.re_err_new()
    let re = search.re_compile(pat, flags, mut err) else {
        return false
    }
    let tb0 = text.textbuf_new()
    search.re_search(re, tb0, input, search.re_input_bytes(input.len), at(0), mut m)
}

fn matches(pat: str, flags: int, input: str) -> bool {
    var m = search.re_match_new()
    find(pb(pat), flags, pb(input), mut m)
}

fn matches_b(pat: List[byte], flags: int, input: List[byte]) -> bool {
    var m = search.re_match_new()
    find(pat, flags, input, mut m)
}

fn t_re_icase_ascii(mut t: Tally) {
    ok(mut t, matches("abc", search.RE_ICASE, "ABC"), "abc ~ ABC")
    ok(mut t, matches("ABC", search.RE_ICASE, "abc"), "ABC ~ abc")
    ok(mut t, matches("AbC", search.RE_ICASE, "aBc"), "AbC ~ aBc")
    ok(mut t, matches("[a-z]+", search.RE_ICASE, "HELLO"), "[a-z]+ ~ HELLO")
    ok(mut t, matches("[A-Z]+", search.RE_ICASE, "hello"), "[A-Z]+ ~ hello")
    // Non-letters are unaffected by folding.
    ok(mut t, matches("1+", search.RE_ICASE, "111"), "1+ ~ 111")
    ok(mut t, !matches("abc", search.RE_ICASE, "abd"), "abc !~ abd")
    // Without the flag, case is significant.
    ok(mut t, !matches("abc", 0, "ABC"), "abc !~ ABC without ICASE")
}

fn t_re_icase_kelvin_sign(mut t: Tally) {
    // U+212A KELVIN SIGN folds to ASCII 'k'.
    let kelvin = unhex("e284aa")
    ok(mut t, matches_b(pb("k"), search.RE_ICASE, kelvin), "k ~ U+212A")
    ok(mut t, matches_b(pb("K"), search.RE_ICASE, kelvin), "K ~ U+212A")
    ok(mut t, matches_b(kelvin, search.RE_ICASE, pb("k")), "U+212A ~ k")
    ok(mut t, !matches_b(pb("k"), 0, kelvin), "k !~ U+212A without ICASE")
}

fn t_re_icase_greek_sigma(mut t: Tally) {
    // σ (U+03C3) and ς (U+03C2) both fold to Σ (U+03A3).
    let medial = unhex("cf83")
    let final_ = unhex("cf82")
    let capital = unhex("cea3")
    ok(mut t, matches_b(medial, search.RE_ICASE, capital), "σ ~ Σ")
    ok(mut t, matches_b(capital, search.RE_ICASE, medial), "Σ ~ σ")
    ok(mut t, matches_b(final_, search.RE_ICASE, capital), "ς ~ Σ")
    ok(mut t, matches_b(capital, search.RE_ICASE, final_), "Σ ~ ς")
}

fn t_re_icase_is_simple_folding_only(mut t: Tally) {
    // §3: ß does NOT match "ss" — a length-changing fold would break the
    // one-codepoint-per-step invariant.
    let sharp = unhex("c39f")
    ok(mut t, !matches_b(sharp, search.RE_ICASE, pb("ss")), "ß !~ ss")
    ok(mut t, !matches_b(pb("ss"), search.RE_ICASE, sharp), "ss !~ ß")
    ok(mut t, matches_b(sharp, search.RE_ICASE, sharp), "ß ~ ß")
}

fn t_re_no_normalization(mut t: Tally) {
    // NFC é (U+00E9) does not match NFD é (e + U+0301).
    let nfc = unhex("c3a9")
    let nfd = unhex("65cc81")
    ok(mut t, !matches_b(nfc, 0, nfd), "NFC !~ NFD")
    ok(mut t, !matches_b(nfd, 0, nfc), "NFD !~ NFC")
    ok(mut t, matches_b(pb("^.$"), 0, nfc), "NFC is one codepoint")
    ok(mut t, matches_b(pb("^..$"), 0, nfd), "NFD is two")
}

fn t_re_invalid_bytes_match_dot_never_word(mut t: Tally) {
    let raw = unhex("61ff62")
    var m = search.re_match_new()
    // One invalid byte is one synthetic codepoint: `.` sees one thing.
    ok(mut t, find(pb("a.b"), 0, raw, mut m), "a.b over a\\xffb")
    ok(mut t, m.lo[0] == 0 && m.hi[0] == 3, "spans 0..3")
    // An escape is never a word, digit or space character.
    ok(mut t, !find(pb("a\\wb"), 0, raw, mut m), "\\w misses it")
    ok(mut t, !find(pb("a\\db"), 0, raw, mut m), "\\d misses it")
    ok(mut t, !find(pb("a\\sb"), 0, raw, mut m), "\\s misses it")
    // The negated forms do match it.
    ok(mut t, find(pb("a\\Wb"), 0, raw, mut m), "\\W takes it")
    ok(mut t, find(pb("a\\Db"), 0, raw, mut m), "\\D takes it")
    ok(mut t, find(pb("a\\Sb"), 0, raw, mut m), "\\S takes it")
    // And so does a negated class.
    ok(mut t, find(pb("a[^x]b"), 0, raw, mut m), "[^x] takes it")
}

fn t_re_invalid_bytes_are_word_boundaries(mut t: Tally) {
    let raw = unhex("ff666f6ffe")
    var m = search.re_match_new()
    ok(mut t, find(pb("\\bfoo\\b"), 0, raw, mut m), "\\bfoo\\b between escapes")
    ok(mut t, m.lo[0] == 1 && m.hi[0] == 4, "spans 1..4")
}

fn t_re_search_over_binary_survives(mut t: Tally) {
    var noise = List[byte]()
    var i = 0
    while i < 512 {
        (mut noise).push((i & 255) as byte)
        i += 1
    }
    let needle = pb("needle")
    i = 0
    while i < 6 {
        noise[200 + i] = needle[i]
        i += 1
    }
    var m = search.re_match_new()
    ok(mut t, find(pb("needle"), 0, noise, mut m), "needle in noise")
    ok(mut t, m.lo[0] == 200 && m.hi[0] == 206, "at 200..206")
    // NUL is an ordinary byte, not a terminator.
    ok(mut t, find(pb("\\x00"), 0, noise, mut m), "\\x00 found")
    ok(mut t, m.lo[0] == 0, "at 0")
}

// One byte at a time at the end: what typing produces (appends coalesce
// into one piece, s07, so this exercises the decoder).
fn tb_by_inserts(s: List[byte]) -> text.TextBuf {
    var tb = text.textbuf_new()
    var i = 0
    while i < s.len {
        text.textbuf_insert_part(mut tb, at(i), s, i, i + 1)
        i += 1
    }
    tb
}

// Every even byte, then every odd byte spliced between them: the pieces
// out of order in the add store.
fn tb_by_interleaved_inserts(s: List[byte]) -> text.TextBuf {
    var tb = text.textbuf_new()
    var i = 0
    while i < s.len {
        text.textbuf_insert_part(mut tb, at(i / 2), s, i, i + 1)
        i += 2
    }
    i = 1
    while i < s.len {
        text.textbuf_insert_part(mut tb, at(i), s, i, i + 1)
        i += 2
    }
    tb
}

fn find_in_tb(pat: List[byte], tb: text.TextBuf, mut m: search.ReMatch) -> bool {
    var err = search.re_err_new()
    let re = search.re_compile(pat, 0, mut err) else {
        return false
    }
    let empty = List[byte]()
    search.re_search(re, tb, empty, search.re_input_textbuf(tb), at(0), mut m)
}

fn t_re_match_spans_multiple_pieces(mut t: Tally) {
    // DoD 10: the literal spans many inserts; the prefilter must carry
    // across chunk boundaries.
    let tb = tb_by_inserts(pb("xxxxNEEDLExxxx"))
    var m = search.re_match_new()
    ok(mut t, find_in_tb(pb("NEEDLE"), tb, mut m), "NEEDLE across inserts")
    ok(mut t, m.lo[0] == 4 && m.hi[0] == 10, "at 4..10")
}

fn t_re_match_spans_interleaved_pieces(mut t: Tally) {
    let tb = tb_by_interleaved_inserts(pb("aaaaTARGETaaaa"))
    var m = search.re_match_new()
    ok(mut t, text.textbuf_piece_count(tb) >= 3, "{text.textbuf_piece_count(tb)} pieces")
    ok(mut t, find_in_tb(pb("TARGET"), tb, mut m), "TARGET across interleaved pieces")
    ok(mut t, m.lo[0] == 4 && m.hi[0] == 10, "at 4..10")
}

fn t_re_multibyte_spans_pieces(mut t: Tally) {
    // A three-codepoint CJK run inserted byte by byte.
    var text_ = pb("..")
    for b in unhex("e6bca2e5ad97e8aa9e") {
        (mut text_).push(b)
    }
    for b in "..".bytes() {
        (mut text_).push(b)
    }
    let tb = tb_by_inserts(text_)
    var m = search.re_match_new()
    ok(mut t, find_in_tb(unhex("e6bca2e5ad97e8aa9e"), tb, mut m), "漢字語 across inserts")
    ok(mut t, m.lo[0] == 2 && m.hi[0] == 11, "at 2..11")
    // \w+ sees the CJK run as three word characters.
    ok(mut t, find_in_tb(pb("\\w+"), tb, mut m), "\\w+ over the CJK run")
    ok(mut t, m.lo[0] == 2 && m.hi[0] == 11, "\\w+ at 2..11")
}

fn t_re_prefilter_rejects_mid_sequence_candidates(mut t: Tally) {
    // 0x9F is a continuation byte of the emoji AND the literal searched
    // for; the codepoint-boundary check rejects the phantom inside it.
    let hay = unhex("f09f9880789f79")
    var m = search.re_match_new()
    ok(mut t, find(unhex("9f"), 0, hay, mut m), "\\x9f found")
    ok(mut t, m.lo[0] == 5, "at 5, not inside the emoji ({m.lo[0]})")
}

fn t_re_textbuf_and_bytes_agree(mut t: Tally) {
    let text_ = pb("xxxxNEEDLE")
    for pat in "NEEDLE N.*E \\w+ [A-Z]+ x+ ^xx E$".words() {
        let tb = tb_by_inserts(text_)
        var a = search.re_match_new()
        var b = search.re_match_new()
        let ga = find(pb(pat), 0, text_, mut a)
        let gb = find_in_tb(pb(pat), tb, mut b)
        ok(mut t, ga == gb, "/{pat}/: bytes {ga}, textbuf {gb}")
        if ga && gb {
            ok(mut t, a.lo[0] == b.lo[0] && a.hi[0] == b.hi[0], "/{pat}/: the spans agree")
        }
    }
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    var t = Tally { n: 0 }
    t_re_icase_ascii(mut t)
    t_re_icase_kelvin_sign(mut t)
    t_re_icase_greek_sigma(mut t)
    t_re_icase_is_simple_folding_only(mut t)
    t_re_no_normalization(mut t)
    t_re_invalid_bytes_match_dot_never_word(mut t)
    t_re_invalid_bytes_are_word_boundaries(mut t)
    t_re_search_over_binary_survives(mut t)
    t_re_match_spans_multiple_pieces(mut t)
    t_re_match_spans_interleaved_pieces(mut t)
    t_re_multibyte_spans_pieces(mut t)
    t_re_prefilter_rejects_mid_sequence_candidates(mut t)
    t_re_textbuf_and_bytes_agree(mut t)
    print("re_unicode_test: 13 cases pass, {t.n} assertions")
}
