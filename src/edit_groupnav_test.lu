//! member: false
//!
//! The port of sagitta `tests/unit/test_groupnav.c` (961 lines), one test
//! per C test in registry order (`tests/unit/registry.c:1765-1799`): the
//! two-row bar and the continuous line (Sprint 24 §5/§6), the group close,
//! the 500 ms digit window (§7) and Sprint 57.10's positional numbering.
//! The fixture is the contract's [t1, G{a,b,c}, t2] behind the scratch
//! tab: tabs [scratch, t1, a, b, c, t2], row 1 [scratch, t1, G, t2]
//! (`nav_fixture`, `test_groupnav.c:30-59`). C's `yew_ed_invoke` with
//! `YEW_SRC_TEST` is `edit.ed_cmd_invoke` with `edit.SRC_TEST`; a key is a
//! `term.Key`; the grid C initialises 4x80 is `term.grid_new(4, 80)`.

use edit
use term

// `nav_fixture` (`test_groupnav.c:30-59`): answers the group id.
fn nav_fixture(mut ed: edit.Ed) -> int {
    ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    var i = 0
    while i < 5 {
        assert(edit.tab_open(mut ed, "/tmp/yew-nav-{i}.txt") >= 0, "open {i}")
        i += 1
    }
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 2)
    edit.group_add_member(mut ed, g, 3)
    edit.group_add_member(mut ed, g, 4)
    edit.tab_switch(mut ed, 1)
    g
}

fn bare() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    ed
}

// `nav_invoke` (`test_groupnav.c:61-73`).
fn nav_invoke(mut ed: edit.Ed, name: str) -> int {
    let id = edit.cmd_lookup(ed.reg, name)
    assert(id != 0, "{name} is registered")
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    edit.ed_cmd_invoke(mut ed, id, mut cx)
}

// `nav_goto_status` (`test_groupnav.c:733-746`): `name` with `iarg` n.
fn nav_goto_status(mut ed: edit.Ed, name: str, n: int) -> int {
    let id = edit.cmd_lookup(ed.reg, name)
    assert(id != 0, "{name} is registered")
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    cx.iarg = n
    edit.ed_cmd_invoke(mut ed, id, mut cx)
}

// `nav_goto` (`test_groupnav.c:467-480`): `ed.tab.goto n`, which succeeds.
fn nav_goto(mut ed: edit.Ed, n: int) {
    assert(nav_goto_status(mut ed, "ed.tab.goto", n) == edit.CMD_OK, "ed.tab.goto {n}")
}

// `nav_digit` (`test_groupnav.c:453-465`).
fn nav_digit(c: int, mods: int) -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    k.code = c
    k.mods = mods
    (mut k.text).push(c as byte)
    k
}

// `nav_many_tabs` (`test_groupnav.c:482-498`): the scratch tab and
// `n - 1` more.
fn nav_many_tabs(n: int) -> edit.Ed {
    var ed = bare()
    var i = 1
    while i < n {
        assert(edit.tab_open(mut ed, "/tmp/yew-jmp-{i}.txt") >= 0, "open {i}")
        i += 1
    }
    ed
}

fn label_str(e: edit.StripEntry) -> str {
    str_from_utf8(e.label) else "<bytes>"
}

// A dirty edit through the active window (C's `yew_ed_edit_ctx` +
// `yew_edit_insert` + `yew_ed_finish_edit`).
fn dirty_active(mut ed: edit.Ed) {
    var x = List[byte]()
    (mut x).push(120 as byte)
    let w = ed.win
    assert(edit.ed_edit_insert(mut ed, w, 0, x, 0, 1), "insert x")
    edit.ed_finish_edit(mut ed, w)
}

// ---- row 1: the entry list ----------------------------------------------

// `test_groupnav_row1_shows_a_group_once_at_its_first_member` (`:79-103`).
fn groupnav_row1_shows_a_group_once_at_its_first_member() {
    var ed = edit.ed_new()
    let g = nav_fixture(mut ed)
    let entries = edit.tab_row1_entries(ed)
    assert(entries.len == 4, "scratch, t1, G, t2")
    assert(entries[0].payload == 0, "scratch")
    assert(entries[1].payload == 1, "t1")
    assert(entries[2].payload == -g, "where the FIRST member sits, as -gid")
    assert(entries[3].payload == 5, "t2 keeps its own index")
    let l = label_str(entries[2])
    assert(l.contains("src/ (3)"), "the live count: {l}")
    assert(entries[2].label[0] as int == 32, "padded left")
    assert(entries[2].label[entries[2].label.len - 1] as int == 32, "padded right")
}

// `test_groupnav_row1_active_tracks_the_group_not_the_member` (`:105-122`).
fn groupnav_row1_active_tracks_the_group_not_the_member() {
    var ed = edit.ed_new()
    let _ = nav_fixture(mut ed)
    let entries = edit.tab_row1_entries(ed)
    assert(edit.tab_row1_active(ed, entries) == 1, "t1 itself")
    edit.tab_switch(mut ed, 3)
    assert(edit.tab_row1_active(ed, entries) == 2, "the GROUP's entry")
    edit.tab_switch(mut ed, 4)
    assert(edit.tab_row1_active(ed, entries) == 2, "every member reports it")
}

// `test_groupnav_strip_reserves_two_rows_inside_a_group` (`:124-137`).
fn groupnav_strip_reserves_two_rows_inside_a_group() {
    var ed = edit.ed_new()
    let _ = nav_fixture(mut ed)
    assert(edit.tab_strip_rows(ed) == 1, "outside")
    edit.tab_switch(mut ed, 3)
    assert(edit.tab_strip_rows(ed) == 2, "inside")
    edit.tab_switch(mut ed, 1)
    assert(edit.tab_strip_rows(ed) == 1, "outside again")
}

// ---- the continuous line ------------------------------------------------------

// `test_groupnav_walk_visits_every_file_in_order` (`:143-160`): DoD 5.
fn groupnav_walk_visits_every_file_in_order() {
    var ed = edit.ed_new()
    let _ = nav_fixture(mut ed)
    assert(ed.tab_active == 1, "on t1")
    let want = [2, 3, 4, 5, 0, 1]
    var i = 0
    while i < 6 {
        edit.file_step(mut ed, 1)
        assert(ed.tab_active == want[i], "step {i} lands on {want[i]}, not {ed.tab_active}")
        i += 1
    }
}

// `test_groupnav_walk_is_reversible` (`:162-196`): DoD 5, N rights then N
// lefts retrace the same sequence reversed.
fn groupnav_walk_is_reversible() {
    var ed = edit.ed_new()
    let _ = nav_fixture(mut ed)
    var forward = List[int]()
    var back = List[int]()
    var i = 0
    while i < 6 {
        edit.file_step(mut ed, 1)
        (mut forward).push(ed.tab_active)
        i += 1
    }
    assert(ed.tab_active == 1, "a full lap")
    i = 0
    while i < 6 {
        edit.file_step(mut ed, -1)
        (mut back).push(ed.tab_active)
        i += 1
    }
    assert(ed.tab_active == 1, "back where it started")
    i = 0
    while i < 5 {
        assert(back[i] == forward[4 - i], "left {i} retraces right {4 - i}")
        i += 1
    }
}

// `test_groupnav_enter_at_edge_depends_on_direction` (`:198-225`): DoD 6,
// counted — the mid-walk path never consults the resume point.
fn groupnav_enter_at_edge_depends_on_direction() {
    var ed = edit.ed_new()
    let _ = nav_fixture(mut ed)
    edit.tab_switch(mut ed, 5)
    var reads = edit.group_resume_reads(ed)
    edit.file_step(mut ed, -1)
    assert(ed.tab_active == 4, "from the right: the LAST member")
    assert(edit.group_resume_reads(ed) == reads, "no resume consulted")
    edit.tab_switch(mut ed, 1)
    reads = edit.group_resume_reads(ed)
    edit.file_step(mut ed, 1)
    assert(ed.tab_active == 2, "from the left: the first member")
    assert(edit.group_resume_reads(ed) == reads, "no resume consulted")
}

// `test_groupnav_explicit_enter_resumes_the_last_member` (`:227-242`).
fn groupnav_explicit_enter_resumes_the_last_member() {
    var ed = edit.ed_new()
    let g = nav_fixture(mut ed)
    edit.tab_switch(mut ed, 3)
    assert(edit.group_leave(mut ed), "leave records the spot")
    assert(edit.active_group_id(ed) == 0, "outside")
    edit.group_enter(mut ed, g)
    assert(ed.tab_active == 3, "resumed on the middle member")
}

// `test_groupnav_enter_falls_back_when_the_path_dangles` (`:244-266`).
fn groupnav_enter_falls_back_when_the_path_dangles() {
    var ed = edit.ed_new()
    let g = nav_fixture(mut ed)
    edit.tab_switch(mut ed, 3)
    assert(edit.group_leave(mut ed), "leave")
    assert(edit.tab_close(mut ed, 3), "close the member the group points at")
    assert(edit.group_member_count(ed, g) == 2, "the group survives")
    edit.tab_switch(mut ed, 0)
    edit.group_enter(mut ed, g)
    assert(edit.active_group_id(ed) == g, "entered, not refused")
    assert(ed.tabs[ed.tab_active].group_ordinal == 1, "the first member")
}

// `test_groupnav_leave_from_the_middle_lands_after_the_group` (`:268-280`).
fn groupnav_leave_from_the_middle_lands_after_the_group() {
    var ed = edit.ed_new()
    let _ = nav_fixture(mut ed)
    edit.tab_switch(mut ed, 3)
    assert(edit.group_leave(mut ed), "leave")
    assert(ed.tab_active == 5, "the tab after the group")
    assert(edit.active_group_id(ed) == 0, "outside")
}

// `test_groupnav_leave_refuses_when_everything_is_grouped` (`:282-305`).
fn groupnav_leave_refuses_when_everything_is_grouped() {
    var ed = bare()
    assert(edit.tab_open(mut ed, "/tmp/yew-nav-all.txt") >= 0, "open")
    let g = edit.group_create(mut ed, "/src", "")
    var i = 0
    while i < ed.tabs.len {
        edit.group_add_member(mut ed, g, i)
        i += 1
    }
    edit.tab_switch(mut ed, 0)
    assert(!edit.group_leave(mut ed), "nowhere to go")
    assert(edit.active_group_id(ed) == g, "still inside")
    assert(ed.tab_active == 0, "on the same tab")
}

// `test_groupnav_walk_steps_through_a_single_member_group` (`:307-328`).
fn groupnav_walk_steps_through_a_single_member_group() {
    var ed = edit.ed_new()
    let _ = nav_fixture(mut ed)
    edit.group_remove_member(mut ed, 3)
    edit.group_remove_member(mut ed, 4)
    edit.tab_switch(mut ed, 1)
    edit.file_step(mut ed, 1)
    assert(ed.tab_active == 2, "into the group")
    edit.file_step(mut ed, 1)
    assert(ed.tab_active == 3, "straight out the far side")
}

// `test_groupnav_walking_into_a_member_hydrates_it` (`:330-342`).
fn groupnav_walking_into_a_member_hydrates_it() {
    var ed = edit.ed_new()
    let _ = nav_fixture(mut ed)
    assert(!edit.tab_is_resident(ed, 2), "deferred")
    edit.file_step(mut ed, 1)
    assert(ed.tab_active == 2, "walked in")
    assert(edit.tab_is_resident(ed, 2), "hydrated by the walk's switch")
}

// `test_groupnav_close_closes_every_clean_member_by_id` (`:344-361`).
fn groupnav_close_closes_every_clean_member_by_id() {
    var ed = edit.ed_new()
    let gid = nav_fixture(mut ed)
    let doomed = [ed.tabs[2].tab_id, ed.tabs[3].tab_id, ed.tabs[4].tab_id]
    edit.tab_switch(mut ed, 3)
    assert(nav_invoke(mut ed, "ed.group.close") == edit.CMD_OK, "closed")
    assert(ed.tabs.len == 3, "three members gone")
    assert(edit.group_find(ed, gid) == -1, "the group with them")
    for id in doomed {
        assert(edit.tab_index_of_id(ed, id) == -1, "member {id} closed")
    }
    assert(edit.active_group_id(ed) == 0, "outside")
}

// `test_groupnav_close_refuses_dirty_group_without_partial_close`
// (`:363-386`).
fn groupnav_close_refuses_dirty_group_without_partial_close() {
    var ed = edit.ed_new()
    let gid = nav_fixture(mut ed)
    let members = [ed.tabs[2].tab_id, ed.tabs[3].tab_id, ed.tabs[4].tab_id]
    edit.tab_switch(mut ed, 3)
    dirty_active(mut ed)
    assert(edit.tab_modified(ed, 3), "dirty")
    assert(nav_invoke(mut ed, "ed.group.close") == edit.CMD_ERR_STATE, "refused")
    assert(ed.tabs.len == 6, "nothing closed")
    assert(edit.group_member_count(ed, gid) == 3, "the group whole")
    for id in members {
        assert(edit.tab_index_of_id(ed, id) >= 0, "member {id} kept")
    }
    assert(!ed.tab_prompt_active, "no prompt")
}

// `test_groupnav_close_ungrouped_delegates_to_tab_close` (`:388-402`).
fn groupnav_close_ungrouped_delegates_to_tab_close() {
    var ed = edit.ed_new()
    let gid = nav_fixture(mut ed)
    let tab_id = ed.tabs[1].tab_id
    assert(edit.active_group_id(ed) == 0, "ungrouped")
    assert(nav_invoke(mut ed, "ed.group.close") == edit.CMD_OK, "the tab's close")
    assert(edit.tab_index_of_id(ed, tab_id) == -1, "t1 closed")
    assert(ed.tabs.len == 5, "one fewer")
    assert(edit.group_member_count(ed, gid) == 3, "the group untouched")
}

// `test_groupnav_close_ungrouped_retains_dirty_tab_prompt` (`:404-422`).
fn groupnav_close_ungrouped_retains_dirty_tab_prompt() {
    var ed = edit.ed_new()
    let _ = nav_fixture(mut ed)
    let tab_id = ed.tabs[1].tab_id
    dirty_active(mut ed)
    assert(nav_invoke(mut ed, "ed.group.close") == edit.CMD_OK, "asks")
    assert(ed.tab_prompt_active, "the dirty-close prompt")
    assert(ed.tab_prompt_id == tab_id, "holding t1's id")
    assert(ed.tabs.len == 6, "nothing closed yet")
    assert(edit.tab_prompt_key(mut ed, 27), "esc answers")
    assert(edit.tab_index_of_id(ed, tab_id) >= 0, "the tab survives a cancel")
}

// `test_groupnav_close_refuses_when_group_contains_every_tab` (`:424-440`).
fn groupnav_close_refuses_when_group_contains_every_tab() {
    var ed = edit.ed_new()
    let gid = nav_fixture(mut ed)
    edit.group_add_member(mut ed, gid, 0)
    edit.group_add_member(mut ed, gid, 1)
    edit.group_add_member(mut ed, gid, 5)
    edit.tab_switch(mut ed, 0)
    assert(edit.group_member_count(ed, gid) == 6, "every tab")
    assert(nav_invoke(mut ed, "ed.group.close") == edit.CMD_ERR_STATE, "refused")
    assert(ed.tabs.len == 6, "nothing closed")
    assert(edit.group_member_count(ed, gid) == 6, "the group whole")
}

// ---- Sprint 24 §7: the 500 ms digit window --------------------------------

// `test_groupnav_digit_jump_extends_to_two_digits` (`:500-522`): DoD 7.
fn groupnav_digit_jump_extends_to_two_digits() {
    var ed = nav_many_tabs(20)
    ed.now_ms = 1000
    nav_goto(mut ed, 1)
    assert(ed.tab_active == 0, "already there: nothing waited")
    assert(edit.tab_jump_armed(ed), "then armed")
    ed.now_ms = 1100
    assert(edit.tab_jump_key(mut ed, nav_digit(53, 0)), "5 consumed")
    assert(ed.tab_active == 14, "tab 15")
    assert(edit.tab_jump_armed(ed), "re-armed for a third digit")
}

// `test_groupnav_digit_jump_accepts_held_modifiers` (`:524-543`).
fn groupnav_digit_jump_accepts_held_modifiers() {
    var ed = nav_many_tabs(20)
    ed.now_ms = 1000
    nav_goto(mut ed, 1)
    ed.now_ms = 1100
    assert(edit.tab_jump_key(mut ed, nav_digit(53, term.MOD_ALT)), "alt+5 extends")
    assert(ed.tab_active == 14, "tab 15")
    nav_goto(mut ed, 1)
    ed.now_ms = 1200
    assert(edit.tab_jump_key(mut ed, nav_digit(53, term.MOD_CTRL)), "ctrl+5 extends")
    assert(ed.tab_active == 14, "tab 15")
}

// `test_groupnav_digit_jump_expires_on_the_clock` (`:545-563`).
fn groupnav_digit_jump_expires_on_the_clock() {
    var ed = nav_many_tabs(20)
    ed.now_ms = 1000
    nav_goto(mut ed, 1)
    assert(edit.tab_jump_armed(ed), "armed")
    ed.now_ms = 1000 + edit.JUMP_WINDOW_MS
    assert(!edit.tab_jump_key(mut ed, nav_digit(53, 0)), "not consumed")
    assert(!edit.tab_jump_armed(ed), "cleared first")
    assert(ed.tab_active == 0, "the tab did not move")
}

// `test_groupnav_digit_jump_releases_a_non_digit` (`:565-578`).
fn groupnav_digit_jump_releases_a_non_digit() {
    var ed = nav_many_tabs(20)
    ed.now_ms = 1000
    nav_goto(mut ed, 1)
    assert(!edit.tab_jump_key(mut ed, nav_digit(106, 0)), "j dispatches")
    assert(!edit.tab_jump_armed(ed), "cleared")
}

// `test_groupnav_digit_jump_swallows_an_out_of_range_digit` (`:580-599`).
fn groupnav_digit_jump_swallows_an_out_of_range_digit() {
    var ed = nav_many_tabs(12)
    ed.now_ms = 1000
    nav_goto(mut ed, 1)
    ed.now_ms = 1100
    assert(edit.tab_jump_key(mut ed, nav_digit(57, 0)), "CONSUMED: no 9 typed")
    assert(!edit.tab_jump_armed(ed), "cleared")
    assert(ed.tab_active == 0, "the first jump stands")
}

// `test_groupnav_digit_jump_picks_a_group_member` (`:601-634`).
fn groupnav_digit_jump_picks_a_group_member() {
    var ed = edit.ed_new()
    let _ = nav_fixture(mut ed)
    ed.now_ms = 1000
    nav_goto(mut ed, 3)
    assert(ed.tab_active == 2, "entered G at its first member")
    assert(edit.tab_jump_armed(ed), "a row-1 window")
    ed.now_ms = 1100
    assert(!edit.tab_jump_key(mut ed, nav_digit(50, term.MOD_ALT)), "alt now means members")
    assert(!edit.tab_jump_armed(ed), "cleared")
    assert(ed.tab_active == 2, "not moved")
    nav_goto(mut ed, 2)
    assert(ed.tab_active == 3, "the SECOND member")
}

// `test_groupnav_digit_jump_group_member_out_of_range` (`:636-653`).
fn groupnav_digit_jump_group_member_out_of_range() {
    var ed = edit.ed_new()
    let _ = nav_fixture(mut ed)
    edit.tab_switch(mut ed, 2)
    ed.now_ms = 1000
    nav_goto(mut ed, 1)
    assert(ed.tab_active == 2, "member 1")
    ed.now_ms = 1100
    assert(edit.tab_jump_key(mut ed, nav_digit(57, 0)), "consumed")
    assert(ed.tab_active == 2, "the first jump stands")
    assert(!edit.tab_jump_armed(ed), "cleared")
}

// `test_groupnav_digit_jump_deadline_is_a_timer` (`:655-669`).
fn groupnav_digit_jump_deadline_is_a_timer() {
    var ed = nav_many_tabs(12)
    ed.now_ms = 1000
    nav_goto(mut ed, 1)
    assert(edit.tab_jump_armed(ed), "armed")
    edit.ed_timers_fire(mut ed, 1000 + edit.JUMP_WINDOW_MS)
    assert(!edit.tab_jump_armed(ed), "the clock alone cleared it")
}

// ---- Sprint 57.10: positional numbering and row-aware jumps ----------------

// `test_groupnav_row1_numbers_entries_by_position` (`:675-694`).
fn groupnav_row1_numbers_entries_by_position() {
    var ed = edit.ed_new()
    let _ = nav_fixture(mut ed)
    let e = edit.tab_row1_entries(ed)
    assert(e.len == 4, "four entries")
    assert(label_str(e[0]) == " 1 untitled ", "scratch: {label_str(e[0])}")
    assert(label_str(e[1]) == " 2 yew-nav-0.txt ", "t1: {label_str(e[1])}")
    assert(label_str(e[2]) == " 3 src/ (3) ", "G: {label_str(e[2])}")
    assert(label_str(e[3]) == " 4 yew-nav-4.txt ", "t2: {label_str(e[3])}")
}

// `nav_row_text` (`:696-711`): single-byte cells of grid row `y`,
// right-trimmed.
fn nav_row_text(ed: edit.Ed, y: int) -> str {
    var out = List[byte]()
    var x = 0
    while x < ed.grid.cols {
        let c = term.cell_byte(term.grid_back(ed.grid, y, x), 0)
        (mut out).push(if c >= 32 && c < 127 then c as byte else 32 as byte)
        x += 1
    }
    while out.len > 0 && out[out.len - 1] as int == 32 {
        let _ = (mut out).pop()
    }
    str_from_utf8(out) else ""
}

// `test_groupnav_row2_numbers_members_by_ordinal` (`:713-731`).
fn groupnav_row2_numbers_members_by_ordinal() {
    var ed = edit.ed_new()
    let g = nav_fixture(mut ed)
    ed.grid = term.grid_new(4, 80)
    ed.grid_ready = true
    edit.tab_switch(mut ed, 3)
    edit.region_frame_begin(mut ed.regions)
    edit.tab_member_strip_draw(mut ed, edit.rect(0, 0, 80, 1), g)
    let row = nav_row_text(ed, 0)
    assert(row == " 1 yew-nav-1.txt  2 yew-nav-2.txt  3 yew-nav-3.txt", "row 2: [{row}]")
}

// `test_groupnav_goto_inside_a_group_picks_the_member` (`:748-771`).
fn groupnav_goto_inside_a_group_picks_the_member() {
    var ed = edit.ed_new()
    let _ = nav_fixture(mut ed)
    edit.tab_switch(mut ed, 2)
    assert(nav_goto_status(mut ed, "ed.tab.goto", 2) == edit.CMD_OK, "member 2")
    assert(ed.tab_active == 3, "b")
    assert(nav_goto_status(mut ed, "ed.tab.goto", 3) == edit.CMD_OK, "member 3")
    assert(ed.tab_active == 4, "c")
    assert(nav_goto_status(mut ed, "ed.tab.goto", 1) == edit.CMD_OK, "member 1")
    assert(ed.tab_active == 2, "a")
    assert(nav_goto_status(mut ed, "ed.tab.goto", 4) == edit.CMD_ERR_ARG, "no member 4")
    assert(ed.tab_active == 2, "stays in the group")
    assert(nav_goto_status(mut ed, "ed.tab.goto", 0) == edit.CMD_ERR_ARG, "no tenth")
    assert(ed.tab_active == 2, "stays")
}

// `test_groupnav_goto_outside_a_group_counts_row1` (`:773-793`).
fn groupnav_goto_outside_a_group_counts_row1() {
    var ed = edit.ed_new()
    let _ = nav_fixture(mut ed)
    assert(ed.tab_active == 1, "on t1")
    assert(nav_goto_status(mut ed, "ed.tab.goto", 4) == edit.CMD_OK, "entry 4")
    assert(ed.tab_active == 5, "t2")
    assert(nav_goto_status(mut ed, "ed.tab.goto", 5) == edit.CMD_ERR_ARG, "no entry 5")
    assert(ed.tab_active == 5, "stays")
    assert(nav_goto_status(mut ed, "ed.tab.goto", 3) == edit.CMD_OK, "entry 3")
    assert(ed.tab_active == 2, "entered at the first member")
    assert(edit.active_group_id(ed) != 0, "inside")
}

// `test_groupnav_goto_bar_counts_row1_from_inside_a_group` (`:795-822`).
fn groupnav_goto_bar_counts_row1_from_inside_a_group() {
    var ed = edit.ed_new()
    let _ = nav_fixture(mut ed)
    edit.tab_switch(mut ed, 3)
    assert(nav_goto_status(mut ed, "ed.tab.goto_bar", 1) == edit.CMD_OK, "bar 1")
    assert(ed.tab_active == 0, "scratch, not member 1")
    assert(nav_goto_status(mut ed, "ed.tab.goto_bar", 3) == edit.CMD_OK, "bar 3")
    assert(ed.tab_active == 3, "back on b, not a")
    assert(nav_goto_status(mut ed, "ed.tab.goto_bar", 3) == edit.CMD_OK, "bar 3 again")
    assert(ed.tab_active == 3, "stays put")
    assert(nav_goto_status(mut ed, "ed.tab.goto_bar", 4) == edit.CMD_OK, "bar 4")
    assert(ed.tab_active == 5, "t2")
    assert(nav_goto_status(mut ed, "ed.tab.goto_bar", 5) == edit.CMD_ERR_ARG, "no bar 5")
    assert(ed.tab_active == 5, "stays")
}

// `test_groupnav_goto_resumes_the_member_left_by_number` (`:824-838`).
fn groupnav_goto_resumes_the_member_left_by_number() {
    var ed = edit.ed_new()
    let _ = nav_fixture(mut ed)
    edit.tab_switch(mut ed, 4)
    assert(nav_goto_status(mut ed, "ed.tab.goto_bar", 2) == edit.CMD_OK, "bar 2")
    assert(ed.tab_active == 1, "t1")
    assert(nav_goto_status(mut ed, "ed.tab.goto", 3) == edit.CMD_OK, "entry 3")
    assert(ed.tab_active == 4, "resumed on c")
}

// `test_groupnav_goto_bar_maps_zero_to_ten` (`:840-850`).
fn groupnav_goto_bar_maps_zero_to_ten() {
    var ed = nav_many_tabs(12)
    assert(nav_goto_status(mut ed, "ed.tab.goto_bar", 0) == edit.CMD_OK, "bar 0")
    assert(ed.tab_active == 9, "the tenth")
}

// `nav_big_group` (`:852-864`): twelve members.
fn nav_big_group(mut ed: edit.Ed) -> int {
    ed = nav_many_tabs(16)
    let g = edit.group_create(mut ed, "/big", "")
    var i = 1
    while i <= 12 {
        edit.group_add_member(mut ed, g, i)
        i += 1
    }
    edit.tab_switch(mut ed, 1)
    g
}

// `test_groupnav_digit_jump_extends_member_numbers` (`:866-888`).
fn groupnav_digit_jump_extends_member_numbers() {
    var ed = edit.ed_new()
    let _ = nav_big_group(mut ed)
    ed.now_ms = 1000
    nav_goto(mut ed, 1)
    assert(ed.tab_active == 1, "member 1")
    assert(edit.tab_jump_armed(ed), "armed")
    assert(ed.msg.text.contains("member 1"), "the hint: {ed.msg.text}")
    ed.now_ms = 1100
    assert(edit.tab_jump_key(mut ed, nav_digit(50, term.MOD_ALT)), "alt+2 extends")
    assert(ed.tab_active == 12, "member 12")
    assert(edit.tab_jump_armed(ed), "re-armed")
    ed.now_ms = 1200
    assert(edit.tab_jump_key(mut ed, nav_digit(48, 0)), "0 consumed")
    assert(ed.tab_active == 12, "no member 120: the jump stands")
    assert(!edit.tab_jump_armed(ed), "cleared")
}

// `test_groupnav_digit_jump_extends_row1_numbers_across_a_group`
// (`:890-922`).
fn groupnav_digit_jump_extends_row1_numbers_across_a_group() {
    var ed = nav_many_tabs(16)
    let g = edit.group_create(mut ed, "/big", "")
    var i = 1
    while i <= 3 {
        edit.group_add_member(mut ed, g, i)
        i += 1
    }
    edit.tab_switch(mut ed, 0)
    ed.now_ms = 1000
    assert(nav_goto_status(mut ed, "ed.tab.goto_bar", 2) == edit.CMD_OK, "bar 2")
    assert(ed.tab_active == 1, "entered G")
    ed.now_ms = 1100
    assert(edit.tab_jump_key(mut ed, nav_digit(49, term.MOD_CTRL)), "consumed")
    assert(ed.tab_active == 1, "no entry 21: the jump stands")
    assert(!edit.tab_jump_armed(ed), "cleared")
    ed.now_ms = 2000
    assert(nav_goto_status(mut ed, "ed.tab.goto_bar", 1) == edit.CMD_OK, "bar 1")
    ed.now_ms = 2100
    assert(edit.tab_jump_key(mut ed, nav_digit(50, 0)), "2 extends")
    assert(ed.tab_active == 13, "entry 12 is t13")
}

// `test_groupnav_digit_jump_modifier_discipline` (`:924-961`).
fn groupnav_digit_jump_modifier_discipline() {
    var ed = edit.ed_new()
    let _ = nav_big_group(mut ed)
    ed.now_ms = 1000
    nav_goto(mut ed, 1)
    ed.now_ms = 1100
    assert(!edit.tab_jump_key(mut ed, nav_digit(52, term.MOD_CTRL)), "ctrl is row 1's")
    assert(!edit.tab_jump_armed(ed), "cleared")
    assert(ed.tab_active == 1, "not moved")
    ed = nav_many_tabs(20)
    let g = edit.group_create(mut ed, "/two", "")
    edit.group_add_member(mut ed, g, 1)
    edit.group_add_member(mut ed, g, 2)
    edit.tab_switch(mut ed, 0)
    ed.now_ms = 2000
    nav_goto(mut ed, 1)
    assert(ed.tab_active == 0, "entry 1")
    ed.now_ms = 2100
    assert(
        edit.tab_jump_key(mut ed, nav_digit(50, term.MOD_ALT)),
        "alt continues a row-1 window from outside",
    )
    assert(ed.tab_active == 12, "entry 12")
    assert(edit.tab_jump_armed(ed), "re-armed")
}

