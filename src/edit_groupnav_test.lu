    groupnav_close_refuses_dirty_group_without_partial_close()
    groupnav_close_ungrouped_delegates_to_tab_close()
    groupnav_close_ungrouped_retains_dirty_tab_prompt()
    groupnav_close_refuses_when_group_contains_every_tab()
    groupnav_digit_jump_extends_to_two_digits()
