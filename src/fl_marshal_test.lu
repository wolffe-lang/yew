//! member: false
//! The ten tests/unit/test_fl_marshal.c cases at sagitta 9ace98c2, in
//! registry order (Sprint 34 §4: descriptor dispatch and the generic
//! CmdCtx marshalling). C's fixture (test_fl_marshal.c:17-36) is flfix's
//! VM attached to an editor with its scratch buffer and a NULL host (no
//! transaction enlists); the port's VM keeps host kind 0 and every native
//! reaches edit.fl_attached_api with its arguments on the VM stack, as
//! fl_api_invoke receives them.

use edit
use fl
use text

struct MarshalFix { vm: fl.FlVm, ed: edit.Ed }

fn mf_open() -> MarshalFix {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    fl.fl_std_register(mut vm)
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    MarshalFix { vm: vm, ed: ed }
}

fn strv(mut vm: fl.FlVm, bytes: List[byte]) -> fl.FlValue { fl.fl_str_new(mut vm, bytes) }

// mapv (test_fl_marshal.c:43-46): the map is rooted at `root`.
fn mapv(mut vm: fl.FlVm, root: int, key: str, value: fl.FlValue) {
    let v = fl.fl_temp_push(mut vm, value)
    let k = fl.fl_str_text(mut vm, key)
    let m = fl.fl_temp_get(vm, root)
    assert(fl.fl_map_set(mut vm, m, k, fl.fl_temp_get(vm, v)))
    fl.fl_temp_pop(mut vm, 1)
}

// error_is (test_fl_marshal.c:48-61).
fn error_is(mut vm: fl.FlVm, want: str) -> bool {
    if vm.err.t != fl.FL_MAP { return false }
    let key = fl.fl_str_text(mut vm, "kind")
    let got = fl.fl_map_get(vm, vm.err, key) else { return false }
    if got.t != fl.FL_STR { return false }
    let b = copy vm.gc.slots[fl.fl_obj_index(vm, got)].bytes
    if b.len != want.len { return false }
    for i in 0..b.len { if b[i] != want.bytes()[i] { return false } }
    true
}

fn clear(mut vm: fl.FlVm) { vm.raised = false; vm.err = fl.fl_nil() }

// One native call, its arguments on the VM stack from slot 1 (slot 0 is
// the callee's, as a CALL leaves it). Answers the result; vm.raised
// carries C's false.
fn call(mut f: MarshalFix, kind: int, name: str, args: List[fl.FlValue]) -> fl.FlValue {
    clear(mut f.vm)
    f.vm.cur_native = fl.fl_intern(mut f.vm.strings, name.bytes(), 0, name.len)
    for i in 0..args.len { f.vm.stack[1 + i] = copy args[i] }
    f.vm.sp = 1 + args.len
    let out = edit.fl_attached_api(mut f.vm, mut f.ed, kind, 1, args.len)
    f.vm.sp = 0
    out
}

// invoke (test_fl_marshal.c:63-69): fl_api_find, then fl_api_invoke.
fn invoke(mut f: MarshalFix, name: str, args: List[fl.FlValue]) -> fl.FlValue {
    let d = fl.fl_api_find(name.bytes()) else { assert(false, "no row {name}"); return fl.fl_nil() }
    call(mut f, d.kind, name, args)
}

// fl_api_ed_run (flapi.c:1946-2060): `ed.run(name, map)`.
fn ed_run(mut f: MarshalFix, name: str, root: int) -> bool {
    let n = strv(mut f.vm, name.bytes())
    let m = fl.fl_temp_get(f.vm, root)
    let _ = call(mut f, 13000, "ed.run", [n, m])
    !f.vm.raised
}

fn text_of(f: MarshalFix, v: fl.FlValue) -> List[byte] {
    assert(v.t == fl.FL_STR)
    copy f.vm.gc.slots[fl.fl_obj_index(f.vm, v)].bytes
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

fn fl_marshal_all_command_rows_resolve_once() {
    let ed = edit.ed_new()
    for kind in fl.fl_api_kinds() {
        let d = fl.fl_api_desc(kind) else { assert(false); continue }
        if d.cmd.len != 0 {
            assert(edit.cmd_lookup(ed.reg, d.cmd) != 0, "{d.fl_name} names {d.cmd}")
        } else {
            assert(d.query != fl.FL_Q_NONE, "{d.fl_name} has a query")
        }
    }
}

fn has_receiver(recv: fl.FlValue, member: str) -> bool {
    let _ = fl.fl_api_find_receiver(recv, member.bytes()) else { return false }
    true
}

fn fl_marshal_receiver_lookup_is_kind_scoped() {
    var f = mf_open()
    let bi = edit.ed_doc(f.ed)
    let b = edit.fl_h_buf_make(mut f.ed, bi)
    let d = fl.fl_api_find_receiver(b, "len".bytes()) else { assert(false); return }
    assert(d.fl_name == "buf.len")
    assert(!has_receiver(b, "pos"))
    assert(!has_receiver(fl.fl_int(1), "len"))
}

fn fl_marshal_insert_and_text_preserve_embedded_nul() {
    var f = mf_open()
    let bytes = [97 as byte, 0 as byte, 98 as byte]
    let bi = edit.ed_doc(f.ed)
    let h = edit.fl_h_buf_make(mut f.ed, bi)
    let s = strv(mut f.vm, bytes)
    let out = invoke(mut f, "buf.insert", [copy h, fl.fl_int(0), s])
    assert(!f.vm.raised && out.t == fl.FL_NIL)
    let got = invoke(mut f, "buf.text", [h])
    assert(!f.vm.raised && got.t == fl.FL_STR)
    assert(same(text_of(f, got), bytes))
}

fn fl_marshal_ed_run_accepts_every_key_and_preserves_sarg_len() {
    var f = mf_open()
    let bytes = [120 as byte, 0 as byte, 121 as byte]
    let map = fl.fl_map_new(mut f.vm)
    let root = fl.fl_temp_push(mut f.vm, map)
    mapv(mut f.vm, root, "count", fl.fl_int(1))
    mapv(mut f.vm, root, "iarg", fl.fl_int(0))
    let s = strv(mut f.vm, bytes)
    mapv(mut f.vm, root, "sarg", s)
    mapv(mut f.vm, root, "bang", fl.fl_bool(true))
    let wi = f.ed.win
    let hw = edit.fl_h_win_make(mut f.ed, wi)
    mapv(mut f.vm, root, "win", hw)
    assert(ed_run(mut f, "ed.edit.insert.at", root))
    let bi = edit.ed_doc(f.ed)
    let hb = edit.fl_h_buf_make(mut f.ed, bi)
    let got = invoke(mut f, "buf.text", [copy hb])
    assert(same(text_of(f, got), bytes))

    fl.fl_map_clear(mut f.vm, fl.fl_temp_get(f.vm, root))
    let span = strv(mut f.vm, "span".bytes())
    mapv(mut f.vm, root, "range_kind", span)
    mapv(mut f.vm, root, "range_given", fl.fl_bool(true))
    mapv(mut f.vm, root, "range_lo", fl.fl_int(1))
    mapv(mut f.vm, root, "range_hi", fl.fl_int(2))
    assert(ed_run(mut f, "ed.edit.delete.span", root))
    let after = invoke(mut f, "buf.text", [hb])
    assert(same(text_of(f, after), "xy".bytes()))
    fl.fl_temp_pop(mut f.vm, 1)
}

fn fl_marshal_ed_run_rejects_unknown_key_and_bad_count() {
    var f = mf_open()
    let map = fl.fl_map_new(mut f.vm)
    let root = fl.fl_temp_push(mut f.vm, map)
    mapv(mut f.vm, root, "mystery", fl.fl_int(1))
    assert(!ed_run(mut f, "ed.nop", root))
    assert(error_is(mut f.vm, "key"))
    clear(mut f.vm)
    fl.fl_map_clear(mut f.vm, fl.fl_temp_get(f.vm, root))
    mapv(mut f.vm, root, "count", fl.fl_int(0))
    assert(!ed_run(mut f, "ed.nop", root))
    assert(error_is(mut f.vm, "type"))
    clear(mut f.vm)
    fl.fl_map_clear(mut f.vm, fl.fl_temp_get(f.vm, root))
    let span = strv(mut f.vm, "span".bytes())
    mapv(mut f.vm, root, "range_kind", span)
    mapv(mut f.vm, root, "range_lo", fl.fl_int(0))
    mapv(mut f.vm, root, "range_hi", fl.fl_int(1))
    assert(!ed_run(mut f, "ed.nop", root))
    assert(error_is(mut f.vm, "type"))
    fl.fl_temp_pop(mut f.vm, 1)
}

fn fl_marshal_ed_run_status_mapping() {
    var f = mf_open()
    let map = fl.fl_map_new(mut f.vm)
    let root = fl.fl_temp_push(mut f.vm, map)
    assert(!ed_run(mut f, "ed.definitely.missing", root))
    assert(error_is(mut f.vm, "name"))
    clear(mut f.vm)
    assert(!ed_run(mut f, "ed.repeat", root))
    assert(error_is(mut f.vm, "user"))
    clear(mut f.vm)
    assert(!ed_run(mut f, "ed.edit.insert.text", root))
    assert(error_is(mut f.vm, "type"))
    fl.fl_temp_pop(mut f.vm, 1)
}

fn fl_marshal_ed_commands_is_deterministic_registry_order() {
    var f = mf_open()
    let first = call(mut f, 13001, "ed.commands", List[fl.FlValue]())
    assert(!f.vm.raised && first.t == fl.FL_LIST)
    let root = fl.fl_temp_push(mut f.vm, first)
    var a = List[byte]()
    assert(fl.fl_fmt_repr(mut f.vm, mut a, fl.fl_temp_get(f.vm, root)))
    let second = call(mut f, 13001, "ed.commands", List[fl.FlValue]())
    var b = List[byte]()
    assert(fl.fl_fmt_repr(mut f.vm, mut b, second))
    assert(same(a, b))
    assert(fl.fl_list_len(f.vm, fl.fl_temp_get(f.vm, root)) == edit.cmd_count(f.ed.reg))
    fl.fl_temp_pop(mut f.vm, 1)
}

fn fl_marshal_ed_run_enforces_caps_and_rejects_nul_paths() {
    var f = mf_open()
    let map = fl.fl_map_new(mut f.vm)
    let root = fl.fl_temp_push(mut f.vm, map)
    let x = strv(mut f.vm, "x".bytes())
    mapv(mut f.vm, root, "sarg", x)
    f.vm.root_origin.caps = 0
    assert(!ed_run(mut f, "ed.buf.open", root))
    assert(error_is(mut f.vm, "capability"))
    clear(mut f.vm)
    f.vm.root_origin.caps = fl.FL_CAP_FS_READ
    fl.fl_map_clear(mut f.vm, fl.fl_temp_get(f.vm, root))
    let bad = strv(mut f.vm, [120 as byte, 0 as byte, 121 as byte])
    mapv(mut f.vm, root, "sarg", bad)
    assert(!ed_run(mut f, "ed.buf.open", root))
    assert(error_is(mut f.vm, "type"))
    fl.fl_temp_pop(mut f.vm, 1)
}

fn fl_marshal_cursor_mutation_targets_the_receiver() {
    var f = mf_open()
    let bi = edit.ed_doc(f.ed)
    let hb = edit.fl_h_buf_make(mut f.ed, bi)
    let abcd = strv(mut f.vm, "abcd".bytes())
    let _ = invoke(mut f, "buf.insert", [copy hb, fl.fl_int(0), abcd])
    assert(!f.vm.raised)
    let wi = f.ed.win
    assert(text.cset_add(mut f.ed.wins[wi].cs, text.cursor_at(2 as text.ByteOff)))
    let target = if f.ed.wins[wi].cs.primary == 0 then 1 else 0
    let other = if target == 0 then 1 else 0
    let other_before = f.ed.wins[wi].cs.curs[other].pos as int
    let hc = edit.fl_h_cur_make(mut f.ed, wi, target)
    let _ = invoke(mut f, "cur.goto", [hc, fl.fl_int(3)])
    assert(!f.vm.raised)
    assert(f.ed.wins[wi].cs.curs[other].pos as int == other_before)
    assert(f.ed.wins[wi].cs.curs[target].pos as int == 3)
}

fn fl_marshal_teardown_blocks_mutation_but_not_queries() {
    var f = mf_open()
    let bi = edit.ed_doc(f.ed)
    let hb = edit.fl_h_buf_make(mut f.ed, bi)
    let x = strv(mut f.vm, "x".bytes())
    f.ed.fl_model_teardown = true
    let _ = invoke(mut f, "buf.insert", [copy hb, fl.fl_int(0), x])
    assert(f.vm.raised)
    assert(error_is(mut f.vm, "user"))
    clear(mut f.vm)
    let n = invoke(mut f, "buf.len", [hb])
    assert(!f.vm.raised && n.t == fl.FL_INT && n.i == 0)
    f.ed.fl_model_teardown = false
}

// YEW_FL_MARSHAL_CASE: one case alone, in registry order (the whole file is
// past the checked step budget; tools/check-test-cases.txt).
fn main() {
    let chosen = (env_get("YEW_FL_MARSHAL_CASE") else "-1").to_int() else -1
    if chosen < 0 || chosen == 0 {
        fl_marshal_all_command_rows_resolve_once()
        print("fl_marshal_all_command_rows_resolve_once: PASS")
    }
    if chosen < 0 || chosen == 1 {
        fl_marshal_receiver_lookup_is_kind_scoped()
        print("fl_marshal_receiver_lookup_is_kind_scoped: PASS")
    }
    if chosen < 0 || chosen == 2 {
        fl_marshal_insert_and_text_preserve_embedded_nul()
        print("fl_marshal_insert_and_text_preserve_embedded_nul: PASS")
    }
    if chosen < 0 || chosen == 3 {
        fl_marshal_ed_run_accepts_every_key_and_preserves_sarg_len()
        print("fl_marshal_ed_run_accepts_every_key_and_preserves_sarg_len: PASS")
    }
    if chosen < 0 || chosen == 4 {
        fl_marshal_ed_run_rejects_unknown_key_and_bad_count()
        print("fl_marshal_ed_run_rejects_unknown_key_and_bad_count: PASS")
    }
    if chosen < 0 || chosen == 5 {
        fl_marshal_ed_run_status_mapping()
        print("fl_marshal_ed_run_status_mapping: PASS")
    }
    if chosen < 0 || chosen == 6 {
        fl_marshal_ed_commands_is_deterministic_registry_order()
        print("fl_marshal_ed_commands_is_deterministic_registry_order: PASS")
    }
    if chosen < 0 || chosen == 7 {
        fl_marshal_ed_run_enforces_caps_and_rejects_nul_paths()
        print("fl_marshal_ed_run_enforces_caps_and_rejects_nul_paths: PASS")
    }
    if chosen < 0 || chosen == 8 {
        fl_marshal_cursor_mutation_targets_the_receiver()
        print("fl_marshal_cursor_mutation_targets_the_receiver: PASS")
    }
    if chosen < 0 || chosen == 9 {
        fl_marshal_teardown_blocks_mutation_but_not_queries()
        print("fl_marshal_teardown_blocks_mutation_but_not_queries: PASS")
    }
    if chosen < 0 { print("fl_marshal: 10 pinned cases PASS") }
}
