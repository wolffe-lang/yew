//! member: false
//! The seven tests/unit/test_option.c cases at sagitta 9ace98c2, in
//! registry order (Sprint 36: the one option table). C's hook ledger is
//! the editor's; the port's lives in the runtime's VM (R-yw09-2), so the
//! ledger reads go through `ed.flrt.vms[0]` and a commit takes the VM out
//! as a running native holds it.

use edit
use fl
use text
use util

fn open() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed
}

fn opt_of(ed: edit.Ed, name: str) -> edit.OptVal {
    let v = edit.opt_get(ed, edit.ed_doc(ed), ed.win, name) else {
        assert(false, "option {name}")
        edit.optv_int(0)
    }
    v
}

const I64_MIN: int = -9223372036854775807 - 1

const I64_MAX: int = 9223372036854775807

fn ledger_n(ed: edit.Ed) -> int { ed.flrt.vms[0].hooks.ledger.rows.len }

// opt_register (test_option.c:31-47).
fn register(mut ed: edit.Ed, origin: int, name: str, value: edit.OptVal) -> int {
    let _ = edit.fl_runtime_init(mut ed)
    let (cp, err) = edit.opt_checkpoint(mut ed, name)
    assert(cp != 0)
    assert(err.len == 0)
    assert(edit.opt_set(mut ed, edit.OPT_SCOPE_DECLARED, name, value).len == 0)
    var vm = (mut ed.flrt.vms).pop() else {
        assert(false, "the runtime's VM")
        fl.fl_vm_new(take fl.fl_strings())
    }
    let (id, created) = edit.opt_commit(mut ed, mut vm.hooks.ledger, 0, origin, cp)
    (mut ed.flrt.vms).push(vm)
    assert(id != 0)
    assert(created)
    id
}

const NAMES: str = "tabwidth expandtab autoindent autopair wrap scrolloff number statusline.column errorbells ambiguous_wide subword fortran_form chord_timeout_ms undo.break_on_newline undo.bytes_max undo.min_nodes undo.persist_bytes_max registers.ring_depth registers.ring_bytes_max registers.clip_read_max clipboard.sync search.ignorecase search.smartcase hooks.error_limit save.strategy save.check_disk save.check_disk_max save.backup_keep save.backup_dir plug.error_limit plug.verify_on_load theme theme_auto macro.dir shell.complete_help shell.complete_fish shell.suggest_history shell.session shadow.enable shadow.providers shadow.max_lines shadow.midline shadow.lsp_debounce_ms shadow.ai_debounce_ms compl.auto_trigger compl.trigger_chars lsp.open_in git.ascii_glyphs ai.enable ai.backend ai.default_workspace ai.context_bytes ai.context_prefix_pct ai.max_tokens ai.max_lines ai.temperature ai.frame_ms ai.fim ai.on_redact ai.deny_replace ai.exclude_replace ai.exclude_paths ai.badge ai.badge_host_max ai.debug_bodies ai.allow_plain_remote ai.key_cache ai.connect_timeout_ms ai.first_byte_timeout_ms ai.stream_idle_timeout_ms ai.total_timeout_ms ai.keepalive_ms ai.backoff_max_ms"

fn option_table_has_frozen_order_types_scopes_and_defaults() {
    let names = NAMES.words()
    var ed = open()
    assert(ed.opt.descs.len == names.len)
    let listed = edit.opt_list(ed.opt)
    assert(listed.len == names.len)
    for i in 0..ed.opt.descs.len {
        let got = opt_of(ed, names[i])
        let d = copy ed.opt.descs[i]
        assert(d.name == names[i])
        assert(listed[i] == names[i])
        assert(got.t == d.dflt.t)
        if got.t == edit.OPT_BOOL {
            assert(got.b == d.dflt.b)
        } else if got.t == edit.OPT_INT {
            assert(got.i == d.dflt.i)
        } else if got.t == edit.OPT_STRLIST {
            assert(got.list.len == d.dflt.list.len)
            assert(got.list.len == 0)
        } else if names[i] == "macro.dir" {
            let config = util.xdg_config_dir() else ""
            if config.len != 0 {
                assert(got.s == "{config}/macros")
            } else {
                assert(got.s == d.dflt.s)
            }
        } else {
            assert(got.s == d.dflt.s)
        }
    }
    let b = edit.ed_doc(ed)
    assert(ed.bufs[b].tabwidth == 4)
    assert(ed.wins[ed.win].vp.scrolloff == 3)
    assert(ed.wins[ed.win].number_style == edit.NUM_HYBRID)
    assert(ed.chord_timeout_ms == 500)
    assert(ed.regs.ring_depth == text.KILL_RING_DEPTH_DEFAULT)
    assert(ed.regs.ring_bytes_max == text.KILL_RING_BYTES_DEFAULT)
    assert(ed.bufs[b].ec.undo.bytes_max == text.UNDO_BYTES_MAX)
    assert(ed.bufs[b].ec.undo.min_nodes == text.UNDO_MIN_NODES)
}

// expected_option_module (test_option.c:137-148).
fn expected_module(name: str) -> int {
    if name.starts_with("ai.") { return edit.OPT_MODULE_AI }
    if name.starts_with("plug.") { return edit.OPT_MODULE_PLUGINS }
    if name == "lsp.open_in" { return edit.OPT_MODULE_LSP }
    if name == "git.ascii_glyphs" { return edit.OPT_MODULE_FUSS }
    edit.OPT_MODULE_CORE
}

fn option_module_ownership_gates_every_config_write() {
    var ed = open()
    for i in 0..ed.opt.descs.len {
        let d = copy ed.opt.descs[i]
        let expected = expected_module(d.name)
        assert(d.module == expected)
        if expected == edit.OPT_MODULE_CORE { continue }
        let module = expected - 1
        let err = edit.opt_set(mut ed, d.oscope, d.name, copy d.dflt)
        if edit.mod_enabled(module) {
            assert(err.len == 0)
        } else {
            assert(err.len != 0)
            let canonical = edit.mod_require(module)
            assert(canonical.len != 0)
            assert(err == canonical)
        }
    }
}

fn option_validators_reject_wrong_types_ranges_and_enums() {
    var ed = open()
    let boolean = edit.optv_bool(true)
    let integer = edit.optv_int(1)
    let string = edit.optv_str("bogus")
    for i in 0..ed.opt.descs.len {
        let d = copy ed.opt.descs[i]
        let wrong = if d.t == edit.OPT_BOOL {
            copy integer
        } else if d.t == edit.OPT_INT {
            copy boolean
        } else {
            copy integer
        }
        assert(edit.opt_set(mut ed, edit.OPT_SCOPE_DECLARED, d.name, wrong).len != 0)
        if d.t == edit.OPT_INT {
            if d.imin != I64_MIN {
                let low = edit.optv_int(d.imin - 1)
                assert(edit.opt_set(mut ed, edit.OPT_SCOPE_DECLARED, d.name, low).len != 0)
            }
            if d.imax != I64_MAX {
                let high = edit.optv_int(d.imax + 1)
                assert(edit.opt_set(mut ed, edit.OPT_SCOPE_DECLARED, d.name, high).len != 0)
            }
        } else if d.t == edit.OPT_ENUM {
            assert(edit.opt_set(mut ed, edit.OPT_SCOPE_DECLARED, d.name, copy string).len != 0)
        }
    }
    if edit.mod_enabled(edit.MOD_LSP) {
        for v in ["here", "split", "tab"] {
            assert(edit.opt_set(mut ed, edit.OPT_SCOPE_DECLARED, "lsp.open_in", edit.optv_str(v)).len == 0)
            assert(opt_of(ed, "lsp.open_in").s == v)
        }
    }
}

fn option_scope_and_side_effects_share_one_setter() {
    var ed = open()
    let eight = edit.optv_int(8)
    let yes = edit.optv_bool(true)
    let both = edit.optv_str("both")
    assert(edit.opt_set(mut ed, edit.OPT_GLOBAL, "tabwidth", copy eight).len != 0)
    assert(edit.opt_set(mut ed, edit.OPT_BUFFER, "errorbells", copy yes).len != 0)
    assert(edit.opt_set(mut ed, edit.OPT_SCOPE_DECLARED, "tabwidth", copy eight).len == 0)
    let b = edit.ed_doc(ed)
    assert(ed.bufs[b].tabwidth == 8)
    assert(opt_of(ed, "tabwidth").i == 8)
    assert(edit.opt_set(mut ed, edit.OPT_SCOPE_DECLARED, "wrap", copy yes).len == 0)
    assert(ed.wins[ed.win].vp.wrap)
    assert(edit.opt_set(mut ed, edit.OPT_SCOPE_DECLARED, "number", both).len == 0)
    assert(ed.wins[ed.win].number_style == edit.NUM_HYBRID)
    assert(edit.opt_set(mut ed, edit.OPT_SCOPE_DECLARED, "errorbells", copy yes).len == 0)
    assert(ed.errorbells)
    edit.opt_reset(mut ed)
    assert(opt_of(ed, "tabwidth").i == 4)
    assert(ed.bufs[b].tabwidth == 4)
    assert(!ed.wins[ed.win].vp.wrap)
    assert(ed.wins[ed.win].number_style == edit.NUM_HYBRID)
    assert(!ed.errorbells)
}

fn option_fletch_set_map_is_atomic_and_cmdline_is_identical() {
    var ed = open()
    assert(edit.fl_runtime_init(mut ed))
    let before = ledger_n(ed)
    assert(edit.fl_runtime_eval(mut ed, "set({{tabwidth: 8, tabwith: 2}})".bytes()) != edit.CMD_OK)
    assert(opt_of(ed, "tabwidth").i == 4)
    assert(ledger_n(ed) == before)
    assert(edit.fl_runtime_eval(mut ed, "set({{tabwidth: 8, wrap: true}})".bytes()) == edit.CMD_OK)
    assert(opt_of(ed, "tabwidth").i == 8)
    assert(opt_of(ed, "wrap").b)
    assert(ledger_n(ed) == before + 2)
    assert(ed.flrt.vms[0].hooks.ledger.rows[before].kind == fl.REG_OPTION)
    assert(ed.flrt.vms[0].hooks.ledger.rows[before].origin_id == fl.FL_ORIGIN_ID_CONFIG)
    assert(edit.fl_runtime_eval(mut ed, "set({{tabwidth: 10}})".bytes()) == edit.CMD_OK)
    assert(opt_of(ed, "tabwidth").i == 10)
    assert(ledger_n(ed) == before + 3)
    assert(edit.opt_remove_ed(mut ed, before + 2))
    assert(!opt_of(ed, "wrap").b)
    assert(edit.opt_remove_ed(mut ed, before + 3))
    assert(opt_of(ed, "tabwidth").i == 8)
    assert(edit.opt_remove_ed(mut ed, before + 1))
    assert(opt_of(ed, "tabwidth").i == 4)
    assert(!edit.opt_remove_ed(mut ed, before + 1))
    var cx = edit.cmdctx_new(ed.win, edit.SRC_KEY)
    cx.argv = ["ed.opt.set_many", "tabwidth", "6"]
    assert(edit.opt_cmdline_set_cmd(mut ed, cx) == edit.CMD_OK)
    assert(opt_of(ed, "tabwidth").i == 6)
    assert(ed.bufs[edit.ed_doc(ed)].tabwidth == 6)
}

fn option_registration_layers_survive_other_origin_teardown() {
    var ed = open()
    var a_first = register(mut ed, 101, "tabwidth", edit.optv_int(6))
    var b = register(mut ed, 202, "tabwidth", edit.optv_int(7))
    let a_last = register(mut ed, 101, "tabwidth", edit.optv_int(9))
    assert(opt_of(ed, "tabwidth").i == 9)
    assert(edit.opt_remove_ed(mut ed, a_last))
    assert(opt_of(ed, "tabwidth").i == 7)
    assert(edit.opt_remove_ed(mut ed, a_first))
    assert(opt_of(ed, "tabwidth").i == 7)
    assert(edit.opt_remove_ed(mut ed, b))
    assert(opt_of(ed, "tabwidth").i == 4)
    b = register(mut ed, 303, "wrap", edit.optv_bool(true))
    a_first = register(mut ed, 101, "tabwidth", edit.optv_int(6))
    assert(edit.opt_remove_ed(mut ed, b))
    b = register(mut ed, 202, "tabwidth", edit.optv_int(7))
    assert(b < a_first)
    assert(edit.opt_remove_ed(mut ed, a_first))
    assert(opt_of(ed, "tabwidth").i == 7)
    assert(edit.opt_remove_ed(mut ed, b))
    assert(opt_of(ed, "tabwidth").i == 4)
}

fn option_completion_uses_declaration_order_inventory() {
    var ed = edit.ed_new()
    var items = List[edit.CompItem]()
    var total = edit.comp_enumerate(mut ed, edit.COMP_OPTION, "tab".bytes(), mut items)
    assert(total >= 1)
    assert(items.len >= 1)
    let first = str_from_utf8(items[0].text) else ""
    assert(first == "tabwidth")
    (mut items).reset()
    total = edit.comp_enumerate(mut ed, edit.COMP_VALUE, "gcol".bytes(), mut items)
    assert(total == 2)
    assert(items.len >= 2)
}

fn main() {
    option_table_has_frozen_order_types_scopes_and_defaults()
    option_module_ownership_gates_every_config_write()
    option_validators_reject_wrong_types_ranges_and_enums()
    option_scope_and_side_effects_share_one_setter()
    option_fletch_set_map_is_atomic_and_cmdline_is_identical()
    option_registration_layers_survive_other_origin_teardown()
    option_completion_uses_declaration_order_inventory()
    print("edit_option: 7 cases pass")
}
