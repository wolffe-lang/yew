//! member: false
//! The eight tests/unit/test_fl_hook.c cases at sagitta 9ace98c2, in
//! registry order. C's HookFix (test_fl_hook.c:12-88) is a table with its
//! three ops over a context; the port's table is the VM's (`vm.hooks`) and
//! the ops are the host's methods (R-yw09-4), so HookFix is a host: its
//! `hook_call` records the callback's id (C's fake native's name_id) and,
//! as C's does, may fire the same table again. C passes a NULL VM to every
//! fire; the port's natives are VM objects, so the fixture has a VM and
//! registers the hook provider (C's root-11 provider) so no collection can
//! strand a row.

use fl

struct HookFix {
    calls: List[int],
    fail_id: int,
    same_event: bool,
    chain: bool,
    masked_origin: int,
    notices: List[int],
}

impl fl.FlHost for HookFix {
    #[allow(w1002)]
    fn api(mut self, mut vm: fl.FlVm, kind: int, base: int, argc: int) -> fl.FlValue {
        let _ = self.fail_id
        let _ = base
        let _ = argc
        fl.fl_raise(mut vm, "name", "unexpected hook-fixture native {kind}")
    }
    #[allow(w1002)]
    fn motion(mut self, mut vm: fl.FlVm, program: fl.FlValue) -> bool {
        let _ = self.fail_id
        let _ = program
        let _ = fl.fl_raise(mut vm, "motion", "no editor host")
        false
    }
    #[allow(w1002)]
    fn edit_begin(mut self, mut vm: fl.FlVm) -> bool { let _ = self.fail_id; let _ = vm.sp; true }
    #[allow(w1002)]
    fn edit_end(mut self, mut vm: fl.FlVm, commit: bool) -> bool {
        let _ = self.fail_id
        let _ = vm.sp
        let _ = commit
        true
    }
    #[allow(w1002)]
    fn run_begin(mut self, mut vm: fl.FlVm) -> bool { let _ = self.fail_id; let _ = vm.sp; true }
    #[allow(w1002)]
    fn run_end(mut self, mut vm: fl.FlVm, commit: bool) -> bool {
        let _ = self.fail_id
        let _ = vm.sp
        let _ = commit
        true
    }
    fn run_active(self) -> bool { let _ = self.fail_id; false }
    // hook_call (test_fl_hook.c:30-50).
    fn hook_call(mut self, mut vm: fl.FlVm, f: fl.FlValue, args: List[fl.FlValue]) -> (
        bool,
        fl.FlValue,
    ) {
        let _ = args.len
        let id = vm.gc.slots[fl.fl_obj_index(vm, f)].name_id
        (mut self.calls).push(id)
        if self.same_event { fl.fl_hook_fire(mut vm, mut self, fl.FL_EV_BUF_CHANGE, List[fl.FlValue]()) }
        if self.chain && id < 9 { fl.fl_hook_fire(mut vm, mut self, id + 1, List[fl.FlValue]()) }
        if id == self.fail_id { return (false, fl.fl_int(id)) }
        (true, fl.fl_nil())
    }
    // hook_masked (test_fl_hook.c:52-57).
    fn hook_masked(self, origin: int) -> bool { origin == self.masked_origin }
    // hook_notice (test_fl_hook.c:59-69).
    #[allow(w1002)]
    fn hook_notice(
        mut self,
        mut vm: fl.FlVm,
        what: int,
        event: int,
        ledger_id: int,
        errs: int,
        err: fl.FlValue,
    ) {
        let _ = vm.sp
        let _ = event
        let _ = ledger_id
        let _ = errs
        let _ = err
        self.notices[what] += 1
    }
}

// hf_open (test_fl_hook.c:71-83).
fn hf_open() -> HookFix {
    HookFix {
        calls: List[int](),
        fail_id: 4294967295,
        same_event: false,
        chain: false,
        masked_origin: 4294967295,
        notices: [0, 0, 0, 0],
    }
}

fn hf_vm() -> fl.FlVm {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    fl.fl_gc_root_provider(mut vm, fl.FL_GC_PROVIDER_HOOKS, 0)
    vm
}

// fake_fn (test_fl_hook.c:24-28): a native whose name_id is the id.
fn fake_fn(mut vm: fl.FlVm, id: int) -> fl.FlValue { fl.fl_native_new(mut vm, id, 0, 0, 0, 0) }

fn fire(mut vm: fl.FlVm, mut f: HookFix, event: int) {
    fl.fl_hook_fire(mut vm, mut f, event, List[fl.FlValue]())
}

fn add(mut vm: fl.FlVm, origin: int, event: int, id: int) -> int {
    let f = fake_fn(mut vm, id)
    fl.fl_hook_add(mut vm.hooks, origin, event, f)
}

fn fl_hook_event_inventory() {
    let names = [
        "buf.open",
        "buf.change",
        "buf.save",
        "buf.saved",
        "buf.close",
        "mode.enter",
        "mode.leave",
        "win.focus",
        "cursor.move",
        "ws.open",
        "ws.close",
        "plug.enable",
        "plug.disable",
        "ed.idle",
    ]
    assert(fl.FL_EV_N == 14)
    for i in 0..names.len {
        assert((fl.fl_event_name(i) else "") == names[i])
        assert((fl.fl_event_parse(names[i].bytes()) else 99) == i)
    }
    let past = fl.fl_event_name(fl.FL_EV_N) else "none"
    assert(past == "none")
    let quit = fl.fl_event_parse("ws.quit".bytes()) else -1
    assert(quit == -1)
}

fn fl_hook_order_mask_and_remove() {
    var vm = hf_vm()
    var f = hf_open()
    let _ = add(mut vm, 2, fl.FL_EV_BUF_OPEN, 1)
    let _ = add(mut vm, 0, fl.FL_EV_BUF_OPEN, 2)
    let removed = add(mut vm, 1, fl.FL_EV_BUF_OPEN, 3)
    let _ = add(mut vm, 0, fl.FL_EV_BUF_OPEN, 4)
    assert(fl.fl_hook_origin(vm.hooks, removed) == 1)
    assert(fl.fl_hook_origin(vm.hooks, 0) == fl.FL_ORIGIN_ID_NONE)

    fire(mut vm, mut f, fl.FL_EV_BUF_OPEN)
    assert(f.calls.len == 4)
    assert(f.calls[0] == 2 && f.calls[1] == 4 && f.calls[2] == 1 && f.calls[3] == 3)

    (mut f.calls).reset()
    f.masked_origin = 2
    assert(fl.fl_hook_remove(mut vm.hooks, removed))
    assert(fl.fl_hook_origin(vm.hooks, removed) == fl.FL_ORIGIN_ID_NONE)
    assert(!fl.fl_hook_remove(mut vm.hooks, removed))
    fire(mut vm, mut f, fl.FL_EV_BUF_OPEN)
    assert(f.calls.len == 2)
    assert(f.calls[0] == 2 && f.calls[1] == 4)
}

fn fl_hook_compacts_only_inactive_suffixes() {
    var vm = hf_vm()
    let first = add(mut vm, 1, fl.FL_EV_BUF_OPEN, 1)
    let middle = add(mut vm, 2, fl.FL_EV_BUF_OPEN, 2)
    let last = add(mut vm, 3, fl.FL_EV_BUF_OPEN, 3)
    assert(vm.hooks.rows.len == 3)
    assert(vm.hooks.ledger.rows.len == 3)

    // YEW-F-021: an interior removal cannot renumber the later live id.
    assert(fl.fl_hook_remove(mut vm.hooks, middle))
    assert(vm.hooks.rows.len == 3)
    assert(vm.hooks.ledger.rows.len == 3)
    assert(fl.fl_hook_origin(vm.hooks, last) == 3)
    let replacement = add(mut vm, 4, fl.FL_EV_BUF_OPEN, 4)
    assert(replacement == middle)
    assert(fl.fl_hook_origin(vm.hooks, last) == 3)

    assert(fl.fl_hook_remove(mut vm.hooks, replacement))
    assert(fl.fl_hook_remove(mut vm.hooks, last))
    assert(vm.hooks.rows.len == 1)
    assert(vm.hooks.ledger.rows.len == 1)
    assert(fl.fl_hook_origin(vm.hooks, first) == 1)
    assert(fl.fl_hook_remove(mut vm.hooks, first))
    assert(vm.hooks.rows.len == 0)
    assert(vm.hooks.ledger.rows.len == 0)
}

fn fl_hook_contains_and_disables_failures() {
    for event in 0..fl.FL_EV_N {
        var vm = hf_vm()
        var f = hf_open()
        f.fail_id = 1
        let bad = add(mut vm, 0, event, 1)
        let _ = add(mut vm, 0, event, 2)
        for _ in 0..6 { fire(mut vm, mut f, event) }

        // bad five times; good six
        assert(f.calls.len == 11, "event {event}: {f.calls.len} calls")
        assert(f.notices[fl.FL_HOOK_NOTICE_ERROR] == 5)
        assert(f.notices[fl.FL_HOOK_NOTICE_DISABLED] == 1)
        let i = vm.hooks.ledger.rows[bad - 1].handle_id - 1
        assert(vm.hooks.rows[i].disabled)
    }
}

fn fl_hook_drops_self_reentrancy_once() {
    var vm = hf_vm()
    var f = hf_open()
    f.same_event = true
    let _ = add(mut vm, 0, fl.FL_EV_BUF_CHANGE, 1)
    fire(mut vm, mut f, fl.FL_EV_BUF_CHANGE)
    fire(mut vm, mut f, fl.FL_EV_BUF_CHANGE)
    assert(f.calls.len == 2)
    assert(f.notices[fl.FL_HOOK_NOTICE_REENTRANT] == 1)
}

fn fl_hook_listens_only_to_dispatchable_rows() {
    var vm = hf_vm()
    var f = hf_open()
    assert(!fl.fl_hook_listens(vm.hooks, f, fl.FL_EV_BUF_CHANGE))
    assert(!fl.fl_hook_listens(vm.hooks, f, fl.FL_EV_N))
    let live = add(mut vm, 2, fl.FL_EV_BUF_CHANGE, 1)
    let disabled = add(mut vm, 3, fl.FL_EV_BUF_CHANGE, 2)
    assert(fl.fl_hook_listens(vm.hooks, f, fl.FL_EV_BUF_CHANGE))
    assert(!fl.fl_hook_listens(vm.hooks, f, fl.FL_EV_BUF_OPEN))
    f.masked_origin = 2
    assert(fl.fl_hook_listens(vm.hooks, f, fl.FL_EV_BUF_CHANGE))
    let i = vm.hooks.ledger.rows[disabled - 1].handle_id - 1
    vm.hooks.rows[i].disabled = true
    assert(!fl.fl_hook_listens(vm.hooks, f, fl.FL_EV_BUF_CHANGE))
    f.masked_origin = 0
    assert(fl.fl_hook_listens(vm.hooks, f, fl.FL_EV_BUF_CHANGE))
    assert(fl.fl_hook_remove(mut vm.hooks, live))
    assert(!fl.fl_hook_listens(vm.hooks, f, fl.FL_EV_BUF_CHANGE))
}

fn fl_hook_bounds_cross_event_depth() {
    var vm = hf_vm()
    var f = hf_open()
    f.chain = true
    for i in 0..9 { let _ = add(mut vm, 0, i, i) }
    fire(mut vm, mut f, 0)
    assert(f.calls.len == fl.FL_HOOK_DEPTH_MAX)
    assert(f.notices[fl.FL_HOOK_NOTICE_DEPTH] == 1)
    assert(vm.hooks.rows[7].errs == 1)
    assert(vm.hooks.depth == 0)
}

// C's object_live (test_fl_hook.c:284-293) over the port's live slots: a
// native is found by a marker name id (C's fn has name_id 0).
fn native_live(vm: fl.FlVm, marker: int) -> bool {
    for i in 0..vm.gc.used {
        let at = i * 2 + vm.gc.half
        if vm.gc.slots[at].t == fl.FL_NATIVE && vm.gc.slots[at].name_id == marker { return true }
    }
    false
}

fn fl_hook_gc_mark_provider() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let marker = 424242
    let f = fl.fl_native_new(mut vm, marker, 0, 0, 0, 0)
    let id = fl.fl_hook_add(mut vm.hooks, 0, fl.FL_EV_ED_IDLE, f)
    fl.fl_gc_root_provider(mut vm, fl.FL_GC_PROVIDER_HOOKS, 0)
    fl.fl_gc_collect(mut vm)
    assert(native_live(vm, marker))

    assert(fl.fl_hook_remove(mut vm.hooks, id))
    fl.fl_gc_collect(mut vm)
    assert(!native_live(vm, marker))
}

fn main() {
    fl_hook_event_inventory()
    print("fl_hook_event_inventory: PASS")
    fl_hook_order_mask_and_remove()
    print("fl_hook_order_mask_and_remove: PASS")
    fl_hook_compacts_only_inactive_suffixes()
    print("fl_hook_compacts_only_inactive_suffixes: PASS")
    fl_hook_contains_and_disables_failures()
    print("fl_hook_contains_and_disables_failures: PASS")
    fl_hook_drops_self_reentrancy_once()
    print("fl_hook_drops_self_reentrancy_once: PASS")
    fl_hook_listens_only_to_dispatchable_rows()
    print("fl_hook_listens_only_to_dispatchable_rows: PASS")
    fl_hook_bounds_cross_event_depth()
    print("fl_hook_bounds_cross_event_depth: PASS")
    fl_hook_gc_mark_provider()
    print("fl_hook_gc_mark_provider: PASS")
    print("fl_hook: 8 pinned cases PASS")
}
