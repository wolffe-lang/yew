//! member: false
//!
//! The port of sagitta `tests/unit/test_keymap.c` (181 lines), one test
//! per C test in registry order (`tests/unit/registry.c:502-504`). C's
//! global registry (`yew_cmd_init`) is the port's `edit.cmdreg_builtin()`
//! value; C's `yew_keymap_visit` callback is `edit.keymap_list`'s rows.
//!
//! C's lookup budget is one million lookups under 150 ms, skipped under
//! its sanitizers (`YEW_TEST_INSTRUMENTED`, `test_keymap.c:119-120`); the
//! port runs the same million lookups and checks the same checksum on
//! both lanes, holds the budget on the native lane, and skips only the
//! budget under `wolf test`'s machine (`os_exe()` is `wolf`, G23), loudly.

use edit
use unicode

fn say_skip(what: str) -> int {
    print("keymap_test: SKIP {what}")
    eprint("keymap_test: SKIP {what}")
    1
}

fn under_wolf_test() -> bool {
    let instrumented = env_get("YEW_TEST_INSTRUMENTED") else ""
    if instrumented != "" {
        return true
    }
    let exe = os_exe() else {
        return true
    }
    exe.ends_with("/wolf")
}

// `assert_build_fails` (`test_keymap.c:15-24`).
fn assert_build_fails(reg: edit.CmdReg, rows: List[edit.BindRow], what: str) {
    let (ok, km) = edit.keymap_build(reg, "invalid", rows)
    assert(!ok, "{what}: the build fails")
    assert(km.nodes.len == 0, "{what}: no nodes")
    assert(km.edges.len == 0, "{what}: no edges")
    assert(km.binds.len == 0, "{what}: no bindings")
}

fn one(row: edit.BindRow) -> List[edit.BindRow] {
    var rows = List[edit.BindRow]()
    (mut rows).push(row)
    rows
}

fn keymap_build_validations() {
    let reg = edit.cmdreg_builtin()
    assert_build_fails(reg, one(edit.bindrow("<nope>", "ed.nop")), "bad sequence")
    assert_build_fails(reg, one(edit.bindrow("a", "ed.ui.definitely_missing")), "unknown command")
    var duplicate = List[edit.BindRow]()
    (mut duplicate).push(edit.bindrow("a", "ed.nop"))
    (mut duplicate).push(edit.bindrow("a", "ed.nop"))
    assert_build_fails(reg, duplicate, "duplicate")
    assert_build_fails(reg, one(edit.bindrow("a", "ed.mode.enter")), "arity")
    assert_build_fails(reg, one(edit.bindrow("<esc> a", "ed.nop")), "esc prefix")
    assert_build_fails(reg, one(edit.bindrow("a b c d e f g h i", "ed.nop")), "too long")
}

fn keymap_binary_lookup_matches_oracle_and_budget() -> int {
    let oracle_rows = 300
    let reg = edit.cmdreg_builtin()
    var rows = List[edit.BindRow]()
    var ids = List[int]()
    var i = 0
    while i < oracle_rows {
        var encoded = List[byte]()
        let n = unicode.utf8_encode_into(mut encoded, 4096 + i)
        assert(n > 0 && n < 5, "row {i} encodes")
        let seq_text = str_from_utf8(encoded) else ""
        (mut rows).push(edit.bindrow_i(seq_text, "ed.tab.goto", i + 1))
        let parsed = edit.key_parse_seq(seq_text, 1)
        assert(parsed.len == 1, "row {i} parses to one key")
        (mut ids).push(parsed[0])
        i += 1
    }
    let (ok, km) = edit.keymap_build(reg, "oracle", rows)
    assert(ok, "the oracle keymap builds")
    assert(edit.keymap_binding_count(km) == oracle_rows, "300 bindings")
    var one_key = List[int]()
    (mut one_key).push(0)
    i = 0
    while i < oracle_rows {
        one_key[0] = ids[i]
        let (m, _, b) = edit.keymap_lookup(km, one_key, 1)
        assert(m == edit.MATCH_FULL, "row {i} matches in full")
        assert(b != 0, "row {i} has a binding")
        assert(km.binds[b].iarg == i + 1, "row {i} binds its iarg")
        i += 1
    }
    let start = time_now_ms()
    var checksum = 0
    i = 0
    while i < 1000000 {
        one_key[0] = ids[i % oracle_rows]
        let (m, _, b) = edit.keymap_lookup(km, one_key, 1)
        assert(m == edit.MATCH_FULL, "lookup budget miss")
        checksum += km.binds[b].iarg
        i += 1
    }
    let elapsed = time_now_ms() - start
    assert(checksum != 0, "the checksum is live")
    if under_wolf_test() {
        return say_skip(
            "keymap_binary_lookup_matches_oracle_and_budget's 150 ms budget: wolf test's machine (os_exe is wolf), as C skips it instrumented",
        )
    }
    print("keymap_test: one million lookups in {elapsed} ms (budget 150)")
    assert(elapsed < 150, "one million lookups under 150 ms: {elapsed} ms")
    0
}

// `append_listing` (`test_keymap.c:126-139`): sequence, tab, command name,
// newline, per binding in visit order.
fn listing(reg: edit.CmdReg, km: edit.Keymap) -> List[byte] {
    var out = List[byte]()
    let (ok, entries) = edit.keymap_list(km)
    assert(ok, "the keymap visits")
    for e in entries {
        edit.key_format_seq(e.seq, e.seq.len, mut out)
        (mut out).push(9 as byte)
        for b in reg.entries[e.bind.cmd - 1].name.bytes() {
            (mut out).push(b)
        }
        (mut out).push(10 as byte)
    }
    out
}

fn keymap_layer_ownership_and_listing_determinism() {
    let reg = edit.cmdreg_builtin()
    let (ok_mode, mode) = edit.keymap_build(reg, "mode:L", one(edit.bindrow("g g", "ed.nop")))
    assert(ok_mode, "mode keymap builds")
    let (ok_user, user) = edit.keymap_build(reg, "user", List[edit.BindRow]())
    assert(ok_user, "empty user keymap builds")
    var plugin_rows = List[edit.BindRow]()
    (mut plugin_rows).push(edit.bindrow("g", "ed.nop"))
    (mut plugin_rows).push(edit.bindrow("g x", "ed.nop"))
    let (ok_plugin, plugin) = edit.keymap_build(reg, "plug:vimish", plugin_rows)
    assert(ok_plugin, "plugin keymap builds")
    var maps = List[edit.Keymap]()
    (mut maps).push(mode)
    (mut maps).push(user)
    (mut maps).push(plugin)
    var stack = List[int]()
    (mut stack).push(0)
    (mut stack).push(1)
    (mut stack).push(2)
    let g = edit.key_parse_seq("g", 1)
    assert(g.len == 1, "g parses")
    let (m, layer, _, b) = edit.keystack_lookup(maps, stack, g, 1)
    assert(m == edit.MATCH_FULL_PREFIX, "g is full and a prefix")
    assert(layer == 2, "the plugin layer answers")
    assert(maps[stack[layer]].name == "plug:vimish", "the plugin owns it")
    assert(b != 0, "with a binding")
    let first = listing(reg, maps[2])
    let second = listing(reg, maps[2])
    assert(first.len == second.len, "listings are the same length")
    var i = 0
    while i < first.len {
        assert(first[i] == second[i], "listing byte {i}")
        i += 1
    }
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    var skips = 0
    keymap_build_validations()
    skips += keymap_binary_lookup_matches_oracle_and_budget()
    keymap_layer_ownership_and_listing_determinism()
    print("keymap_test: 3 cases run, {skips} SKIP by name (the budget under wolf test)")
}
