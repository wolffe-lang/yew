//! member: false
//!
//! The port of sagitta `tests/unit/test_cmdreg.c` (503 lines), one test
//! per C test in registry order (`tests/unit/registry.c:497-501`).
//!
//! C's registry is process-global (`yew_cmd_init`/`yew_cmd_shutdown`);
//! the port's is a `CmdReg` value — `edit.cmdreg_builtin()` is a fresh
//! `yew_cmd_init`. C's probe handlers are static functions counting into
//! statics (`test_cmdreg.c:17-43`); the port's probe is the handler kind
//! `HANDLER_PROBE`, whose tallies live in the registry
//! (`probe_calls`/`probe_count`/`probe_invoked_id`), and C's tap
//! function is `TAP_PROBE` (`tap_calls`/`tap_id`/`tap_count`). C's
//! "same function pointer" for an alias pair is the same C handler name
//! and the same implementation id.
//!
//! C forks a child per invalid descriptor and reads its `YEW_EXIT_BUG`
//! (`descriptor_child_exit`, `test_cmdreg.c:323-348`); a fork is a
//! signal-and-process test RULES.md §5 keeps off a host, and the port's
//! registration refuses through one function, `cmd_register_problem`,
//! which `cmd_register_entry` calls and `bug()`s on, so the test asserts
//! that function names a problem for each case — the same descriptors,
//! the same verdicts, no child. `yew --selftest-bug` (yw01) already pins
//! that `bug()` exits `EXIT_BUG`.
//!
//! The deferred loop reads the log as C's `yew_test_capture_log` does:
//! `YEW_LOG` pointed at a scratch file under `target/test-state`.

use edit

fn probe_desc(
    name: str,
    arity: int,
    flags: int,
    help: str,
    word: str,
    has_word: bool,
) -> edit.CmdDesc {
    edit.CmdDesc {
        name: name,
        handler: edit.HANDLER_PROBE,
        impl_id: 0,
        arity: arity,
        flags: flags,
        help: help,
        word: word,
        has_word: has_word,
    }
}

// `append_registry` (`test_cmdreg.c:45-60`): every name and help, NUL
// separated, in id order.
fn registry_bytes(reg: edit.CmdReg) -> List[byte] {
    var out = List[byte]()
    var i = 0
    while i < edit.cmd_count(reg) {
        let e = edit.cmd_entry(reg, i + 1)
        assert(e.name.len != 0, "entry {i} has a name")
        assert(e.help.len != 0, "entry {i} has help")
        for b in e.name.bytes() {
            (mut out).push(b)
        }
        (mut out).push(0 as byte)
        for b in e.help.bytes() {
            (mut out).push(b)
        }
        (mut out).push(0 as byte)
        i += 1
    }
    out
}

fn same_bytes(a: List[byte], b: List[byte], what: str) {
    assert(a.len == b.len, "{what}: lengths {a.len} == {b.len}")
    var i = 0
    while i < a.len {
        assert(a[i] == b[i], "{what}: byte {i}")
        i += 1
    }
}

fn cmd_registry_builtins_are_deterministic() {
    let first_reg = edit.cmdreg_builtin()
    let count = edit.cmd_count(first_reg)
    assert(count >= 40, "at least 40 builtins: {count}")
    let first = registry_bytes(first_reg)
    let second_reg = edit.cmdreg_builtin()
    assert(edit.cmd_count(second_reg) == count, "the same count twice")
    let second = registry_bytes(second_reg)
    same_bytes(first, second, "the registry")
    assert(edit.cmd_lookup(second_reg, "ed.git.open_split_h") != 0, "ed.git.open_split_h")
    assert(edit.cmd_lookup(second_reg, "ed.git.open_split_v") != 0, "ed.git.open_split_v")
}

fn log_file() -> str {
    let root = env_get("XDG_STATE_HOME") else "target/test-state"
    "{root}/cmdreg_test.log"
}

fn file_text(path: str) -> str {
    let bytes = fs_read_bytes(path) else |_| List[byte]()
    str_from_utf8(bytes) else ""
}

fn cmd_registry_invocation_and_deferred() {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    let active_before = edit.cmd_active_count(ed.reg)
    let repeat_desc = probe_desc(
        "ed.ui.toggle",
        edit.ARITY_NONE,
        edit.CMD_REPEATABLE | edit.CMD_RECORDABLE,
        "Toggle the test probe",
        "toggle_probe",
        true,
    )
    let count_desc = probe_desc(
        "ed.ui.goto",
        edit.ARITY_INT,
        edit.CMD_TAKES_COUNT,
        "Send a count to the test probe",
        "",
        false,
    )
    let repeat = edit.cmd_register(mut ed.reg, repeat_desc)
    let takes = edit.cmd_register(mut ed.reg, count_desc)
    var cx = edit.cmdctx_new(-1, edit.SRC_TEST)
    cx.count = 4
    cx.count_given = true
    ed.reg.probe_calls = 0
    ed.reg.probe_count = 0
    ed.reg.probe_invoked_id = 0
    ed.reg.tap_calls = 0
    edit.cmd_set_record_tap(mut ed.reg, edit.TAP_PROBE)
    assert(edit.cmd_invoke(mut ed, repeat, mut cx) == edit.CMD_OK, "the repeatable probe runs")
    assert(ed.reg.probe_calls == 4, "four calls: {ed.reg.probe_calls}")
    assert(ed.reg.probe_count == 4, "count 4")
    assert(ed.reg.tap_calls == 1, "one tap")
    assert(ed.reg.tap_id == repeat, "the tap saw the probe")
    assert(ed.reg.probe_invoked_id == repeat, "the invoked id")

    assert(edit.cmd_active_count(ed.reg) == active_before + 2, "two more active")
    assert(edit.cmd_unregister(mut ed.reg, repeat), "unregister")
    assert(!edit.cmd_unregister(mut ed.reg, repeat), "unregister twice refuses")
    assert(edit.cmd_active_count(ed.reg) == active_before + 1, "one more active")
    assert(edit.cmd_lookup(ed.reg, repeat_desc.name) == 0, "the name is gone")
    assert(!edit.cmd_active(ed.reg, repeat), "no descriptor, no entry")
    let reactivated = edit.cmd_register(mut ed.reg, repeat_desc)
    assert(reactivated == repeat, "the old id comes back")
    assert(edit.cmd_active_count(ed.reg) == active_before + 2, "two more active again")
    assert(edit.cmd_lookup(ed.reg, repeat_desc.name) == repeat, "the name is back")

    cx.iarg = 7
    ed.reg.probe_calls = 0
    assert(edit.cmd_invoke(mut ed, takes, mut cx) == edit.CMD_OK, "the count probe runs")
    assert(ed.reg.probe_calls == 1, "TAKES_COUNT runs once")
    assert(ed.reg.probe_count == 4, "and reads the count")
    assert(ed.reg.tap_calls == 1, "not recordable: no tap")
    edit.cmd_set_record_tap(mut ed.reg, edit.TAP_NONE)

    assert(edit.cmd_unregister(mut ed.reg, repeat), "unregister repeat")
    assert(edit.cmd_unregister(mut ed.reg, takes), "unregister takes")
    assert(edit.cmd_active_count(ed.reg) == active_before, "back to the builtins")

    let too_long = "abcdefghijklmnopqrstuvwxyzabcdefg"
    let word_too_long = "abcdefghijklmnopq"
    let (ok_bad, id_bad, err_bad) = edit.cmd_register_plugin_flags(
        mut ed.reg,
        "Bad",
        "toggle",
        edit.HANDLER_PROBE,
        "Plugin probe",
        0,
    )
    assert(!ok_bad && id_bad == 0 && err_bad.len != 0, "a bad plugin name refuses")
    let (ok_long, id_long, _) = edit.cmd_register_plugin_flags(
        mut ed.reg,
        "sample",
        too_long,
        edit.HANDLER_PROBE,
        "Plugin probe",
        0,
    )
    assert(!ok_long && id_long == 0, "a too-long name refuses")
    let (ok_word, _, err_word) = edit.cmd_register_plugin_flags(
        mut ed.reg,
        "sample",
        word_too_long,
        edit.HANDLER_PROBE,
        "Plugin probe",
        0,
    )
    assert(!ok_word && err_word.contains("valid CMDWORD"), "a too-long word: {err_word}")
    let (ok_p, plugin, _) = edit.cmd_register_plugin_flags(
        mut ed.reg,
        "sample",
        "toggle",
        edit.HANDLER_PROBE,
        "Plugin probe",
        0,
    )
    assert(ok_p && plugin != 0, "the plugin registers")
    let pe = edit.cmd_entry(ed.reg, plugin)
    assert(pe.name == "ed.plug.sample.toggle", "its name")
    assert(pe.has_word && pe.word == "toggle", "its word")
    assert(pe.flags & edit.CMD_RECORDABLE != 0, "recordable")
    assert(edit.cmd_by_word(ed.reg, "toggle") == plugin, "by word")
    assert(edit.cmd_active_count(ed.reg) == active_before + 1, "one more active")
    let (ok_dup, id_dup, err_dup) = edit.cmd_register_plugin_flags(
        mut ed.reg,
        "sample",
        "toggle",
        edit.HANDLER_PROBE,
        "Plugin probe",
        0,
    )
    assert(
        !ok_dup && id_dup == 0 && err_dup.contains("already registered"),
        "a live duplicate refuses: {err_dup}",
    )
    assert(edit.cmd_unregister(mut ed.reg, plugin), "unregister the plugin")
    assert(edit.cmd_active_count(ed.reg) == active_before, "back to the builtins")
    let (ok_re, again, _) = edit.cmd_register_plugin_flags(
        mut ed.reg,
        "sample",
        "toggle",
        edit.HANDLER_PROBE,
        "Plugin probe",
        0,
    )
    assert(ok_re && again == plugin, "it re-registers under its old id")
    assert(edit.cmd_active_count(ed.reg) == active_before + 1, "one more active")
    assert(edit.cmd_unregister(mut ed.reg, again), "unregister again")
    assert(edit.cmd_active_count(ed.reg) == active_before, "back to the builtins")

    let log = log_file()
    fs_write_bytes(log, List[byte]()) else |_| {}
    env_set("YEW_LOG", log) else |_| {}
    var deferred_n = 0
    var i = 0
    while i < edit.cmd_count(ed.reg) {
        let e = edit.cmd_entry(ed.reg, i + 1)
        if e.flags & edit.CMD_DEFERRED != 0 {
            var d = edit.cmdctx_new(0, edit.SRC_TEST)
            if e.arity == edit.ARITY_INT || e.arity == edit.ARITY_OPT_INT {
                d.iarg = 1
            }
            if e.arity == edit.ARITY_STR || e.arity == edit.ARITY_OPT_STR {
                d.sarg = "x"
                d.has_sarg = true
            }
            assert(
                edit.cmd_invoke(mut ed, i + 1, mut d) == edit.CMD_ERR_DEFERRED,
                "{e.name} defers",
            )
            let text = file_text(log)
            assert(
                text.contains(" error: ") && text.contains(e.name),
                "{e.name} logs its name at ERROR",
            )
            assert(text.contains("Sprint"), "{e.name} logs its sprint")
            fs_write_bytes(log, List[byte]()) else |_| {}
            deferred_n += 1
        }
        i += 1
    }
    // The port's own deferral (invariant 3): every built-in whose C
    // handler is not ported yet refuses with C's deferred status, logs
    // and shows its name and the sagitta sprint and port lane that own
    // it — never "?" — and runs nothing.
    var unported_n = 0
    i = 0
    while i < edit.cmd_count(ed.reg) {
        let e = edit.cmd_entry(ed.reg, i + 1)
        if e.handler == edit.HANDLER_BUILTIN && e.impl_id == edit.IMPL_UNPORTED {
            let (sprint, lane) = edit.cmd_owner(e.c_file)
            assert(sprint != "?" && lane != "?", "{e.name} ({e.c_file}) has an owner")
            var d = edit.cmdctx_new(ed.win, edit.SRC_TEST)
            if e.arity == edit.ARITY_INT || e.arity == edit.ARITY_OPT_INT {
                d.iarg = 1
            }
            if e.arity == edit.ARITY_STR || e.arity == edit.ARITY_OPT_STR {
                d.sarg = "x"
                d.has_sarg = true
            }
            let status = edit.cmd_invoke(mut ed, i + 1, mut d)
            if status != edit.CMD_ERR_DEFERRED {
                print("cmdreg_test: {e.name}: status {status}")
            }
            assert(status == edit.CMD_ERR_DEFERRED, "{e.name} refuses as deferred")
            let text = file_text(log)
            let want = "not yet ported: {e.name}: sagitta Sprint {sprint} ({lane})"
            if !text.contains(want) {
                print("cmdreg_test: {e.name}: log '{text}' message '{ed.msg.text}'")
            }
            assert(text.contains(" error: ") && text.contains(want), "{e.name} logs its owner")
            assert(
                ed.msg.text == "not yet ported: {e.name}: sagitta Sprint {sprint} ({lane})",
                "{e.name} says it",
            )
            fs_write_bytes(log, List[byte]()) else |_| {}
            unported_n += 1
        }
        i += 1
    }
    env_set("YEW_LOG", "/dev/null") else |_| {}
    print(
        "cmdreg_test: {deferred_n} commands carry C's DEFERRED flag at the pin; {unported_n} unported built-ins refuse naming sprint and lane",
    )

    let palette = edit.cmd_lookup(ed.reg, "ed.find.command")
    assert(palette != 0, "the palette is registered")
    let pal = edit.cmd_entry(ed.reg, palette)
    assert(pal.flags & edit.CMD_DEFERRED == 0, "not deferred")
    assert(pal.flags & edit.CMD_PROMPTS != 0, "it prompts")
    assert(pal.help == "Open the command palette", "its help")
    let theme = edit.cmd_lookup(ed.reg, "ed.theme.set")
    assert(theme != 0, "ed.theme.set")
    let th = edit.cmd_entry(ed.reg, theme)
    assert(th.flags & edit.CMD_DEFERRED == 0, "not deferred")
    assert(th.arity == edit.ARITY_STR, "string arity")
    assert(edit.cmd_lookup(ed.reg, "ed.theme.toggle") != 0, "ed.theme.toggle")

    var compat = List[str]()
    var canonical = List[str]()
    (mut compat).push("ed.file.open")
    (mut canonical).push("ed.buf.open")
    (mut compat).push("ed.file.close")
    (mut canonical).push("ed.buf.close")
    (mut compat).push("ed.buf.next")
    (mut canonical).push("ed.tab.next")
    (mut compat).push("ed.buf.prev")
    (mut canonical).push("ed.tab.prev")
    (mut compat).push("ed.group.next")
    (mut canonical).push("ed.file.next")
    (mut compat).push("ed.group.prev")
    (mut canonical).push("ed.file.prev")
    (mut compat).push("ed.find.symbol")
    (mut canonical).push("ed.lsp.symbols")
    (mut compat).push("ed.win.next")
    (mut canonical).push("ed.pane.focus_next")
    (mut compat).push("ed.win.prev")
    (mut canonical).push("ed.pane.focus_prev")
    var a = 0
    while a < compat.len {
        let c_id = edit.cmd_lookup(ed.reg, compat[a])
        let k_id = edit.cmd_lookup(ed.reg, canonical[a])
        assert(c_id != 0 && k_id != 0, "{compat[a]} and {canonical[a]} are registered")
        let ce = edit.cmd_entry(ed.reg, c_id)
        let ke = edit.cmd_entry(ed.reg, k_id)
        assert(ce.flags & edit.CMD_DEFERRED == 0, "{compat[a]} is not deferred")
        assert(
            ce.c_handler == ke.c_handler && ce.impl_id == ke.impl_id,
            "{compat[a]} shares {canonical[a]}'s handler",
        )
        a += 1
    }

    let enter = edit.cmd_lookup(ed.reg, "ed.mode.enter")
    var rows = List[str]()
    (mut rows).push("L")
    (mut rows).push("I")
    (mut rows).push("W")
    (mut rows).push("B")
    (mut rows).push("H")
    var modes = List[int]()
    (mut modes).push(edit.MODE_L)
    (mut modes).push(edit.MODE_I)
    (mut modes).push(edit.MODE_W)
    (mut modes).push(edit.MODE_B)
    (mut modes).push(edit.MODE_H)
    var r = 0
    while r < rows.len {
        var m = edit.cmdctx_new(ed.win, edit.SRC_TEST)
        m.sarg = rows[r]
        m.has_sarg = true
        assert(edit.cmd_invoke(mut ed, enter, mut m) == edit.CMD_OK, "enter {rows[r]}")
        assert(ed.mode == modes[r], "mode {rows[r]}")
        r += 1
    }

    let stage_id = edit.cmd_lookup(ed.reg, "ed.git.stage")
    let hunk_id = edit.cmd_lookup(ed.reg, "ed.git.hunk.stage")
    assert(stage_id != 0, "ed.git.stage")
    let stage = edit.cmd_entry(ed.reg, stage_id)
    assert(stage.flags & edit.CMD_DEFERRED == 0, "stage is not deferred")
    assert(stage.flags & edit.CMD_RECORDABLE != 0, "stage records")
    assert(stage.has_word, "stage has a word")
    assert(stage.help.len != 0, "stage has help")
    assert(hunk_id != 0, "ed.git.hunk.stage")
    let hunk = edit.cmd_entry(ed.reg, hunk_id)
    assert(hunk.flags & edit.CMD_DEFERRED == 0, "hunk is not deferred")
    assert(hunk.flags & edit.CMD_MULTI_AGGREGATE != 0, "hunk aggregates")
    assert(hunk.help.len != 0, "hunk has help")
}

fn refuses(reg: edit.CmdReg, d: edit.CmdDesc, what: str) {
    let problem = edit.cmd_register_problem(reg, d)
    assert(problem.len != 0, "{what}: YEW_BUG")
}

fn cmd_registry_rejects_invalid_descriptors() {
    var reg = edit.cmdreg_builtin()
    var bad = List[str]()
    (mut bad).push("ed")
    (mut bad).push("ed.")
    (mut bad).push("ed.Move.x")
    (mut bad).push("ed.move.a.b.c.d")
    (mut bad).push("ed.move.abcdefghijklmnopq")
    (mut bad).push("ed.rogue.open")
    (mut bad).push("ed.ui.unknown")
    for name in bad {
        refuses(reg, probe_desc(name, edit.ARITY_NONE, 0, "test command", "", false), "name {name}")
    }
    refuses(
        reg,
        probe_desc(
            "ed.ui.toggle",
            edit.ARITY_NONE,
            edit.CMD_REPEATABLE | edit.CMD_TAKES_COUNT,
            "test command",
            "",
            false,
        ),
        "REPEATABLE and TAKES_COUNT",
    )
    refuses(reg, probe_desc("ed.ui.toggle", edit.ARITY_NONE, 0, "", "", false), "empty help")
    var no_fn = probe_desc("ed.ui.toggle", edit.ARITY_NONE, 0, "test command", "", false)
    no_fn.handler = edit.HANDLER_BUILTIN
    refuses(reg, no_fn, "no function")
    let good = probe_desc("ed.ui.toggle", edit.ARITY_NONE, 0, "test command", "", false)
    assert(edit.cmd_register_problem(reg, good).len == 0, "the good descriptor is sound")
    let _ = edit.cmd_register(mut reg, good)
    refuses(reg, good, "registered twice")
}

fn cmd_registry_enforces_cmdwords() {
    var reg = edit.cmdreg_builtin()
    refuses(
        reg,
        probe_desc("ed.ui.toggle", edit.ARITY_NONE, edit.CMD_RECORDABLE, "test command", "", false),
        "recordable without a word",
    )
    refuses(
        reg,
        probe_desc("ed.ui.toggle", edit.ARITY_NONE, 0, "test command", "toggle_it", true),
        "a word on an unrecordable command",
    )
    var words = List[str]()
    (mut words).push("Toggle")
    (mut words).push("9lives")
    (mut words).push("has.dot")
    (mut words).push("")
    (mut words).push("abcdefghijklmnopq")
    (mut words).push("del")
    (mut words).push("yank")
    for w in words {
        refuses(
            reg,
            probe_desc(
                "ed.ui.toggle",
                edit.ARITY_NONE,
                edit.CMD_RECORDABLE,
                "test command",
                w,
                true,
            ),
            "word '{w}'",
        )
    }
    let good = probe_desc(
        "ed.ui.toggle",
        edit.ARITY_NONE,
        edit.CMD_RECORDABLE,
        "test command",
        "toggle_it",
        true,
    )
    let id = edit.cmd_register(mut reg, good)
    assert(id != 0, "a good word registers")
    assert(edit.cmd_by_word(reg, "toggle_it") == id, "and round-trips")
}

fn cmd_registry_word_roundtrip() {
    var reg = edit.cmdreg_builtin()
    let (ok_a, plugin_a, _) = edit.cmd_register_plugin_flags(
        mut reg,
        "audit_a",
        "probe",
        edit.HANDLER_PROBE,
        "First audit plugin command",
        0,
    )
    assert(ok_a, "audit_a registers")
    let (ok_b0, b0, err_b0) = edit.cmd_register_plugin_flags(
        mut reg,
        "audit_b",
        "probe",
        edit.HANDLER_PROBE,
        "Colliding plugin command",
        0,
    )
    assert(
        !ok_b0 && b0 == 0 && err_b0.contains("CMDWORD already registered"),
        "a colliding word refuses: {err_b0}",
    )
    let (ok_b, plugin_b, _) = edit.cmd_register_plugin_flags(
        mut reg,
        "audit_b",
        "pulse",
        edit.HANDLER_PROBE,
        "Second audit plugin command",
        0,
    )
    assert(ok_b && plugin_a != 0 && plugin_b != 0, "both register")
    let (ok_c, refused, err_c) = edit.cmd_register_plugin_flags(
        mut reg,
        "audit_c",
        "record",
        edit.HANDLER_PROBE,
        "Recordable plugin probe",
        edit.CMD_RECORDABLE,
    )
    assert(
        !ok_c && refused == 0 && err_c.contains("invalid plugin command flags"),
        "RECORDABLE is not a plugin flag: {err_c}",
    )
    let n = edit.cmd_count(reg)
    assert(n > 100, "more than 100 commands: {n}")
    var recordable = 0
    var worded = 0
    var i = 0
    while i < n {
        let d = edit.cmd_entry(reg, i + 1)
        if d.flags & edit.CMD_RECORDABLE != 0 {
            recordable += 1
            assert(d.has_word, "{d.name} records and has a word")
        }
        if d.has_word {
            worded += 1
            var j = i + 1
            while j < n {
                let other = edit.cmd_entry(reg, j + 1)
                if other.has_word {
                    assert(d.word != other.word, "{d.name} and {other.name} share '{d.word}'")
                }
                j += 1
            }
            let back = edit.cmd_by_word(reg, d.word)
            assert(back == i + 1, "{d.word} maps back to {d.name}, not an alias")
        }
        i += 1
    }
    assert(worded == recordable, "worded {worded} == recordable {recordable}")
    assert(edit.cmd_by_word(reg, "no_such_word") == 0, "no such word")
    assert(edit.cmd_by_word(reg, "") == 0, "no word")
    assert(edit.cmd_entry(reg, plugin_a).word == "probe", "audit_a's word")
    assert(edit.cmd_entry(reg, plugin_b).word == "pulse", "audit_b's word")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    cmd_registry_builtins_are_deterministic()
    cmd_registry_invocation_and_deferred()
    cmd_registry_rejects_invalid_descriptors()
    cmd_registry_enforces_cmdwords()
    cmd_registry_word_roundtrip()
    print("cmdreg_test: 5 cases run, 0 SKIP")
}
