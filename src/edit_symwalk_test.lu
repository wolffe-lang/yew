//! member: false
//!
//! Port rows for the symbol walk's discovery notice yw13 pulled forward
//! (`edit/symwalk.lu`, R-yw13-4). sagitta's `tests/unit/test_symwalk.c`
//! tests the walk itself (yw11's); these rows pin the one decision the
//! port carries, `yew_symwalk_start`'s discovery (`symwalk.c:455-503`): a
//! repository marker with no `git` on `PATH` posts C's INFO notice, the
//! same with `git` on `PATH` posts nothing, and no marker posts nothing.
//!
//! `YEW_PICK_CASE=N` runs case N alone.

use edit
use std.fs

fn want(ok: bool, what: str) {
    if !ok {
        print("symwalk_test: RED check failed: {what}")
        eprint("symwalk_test: RED check failed: {what}")
        assert(false, what)
    }
}

const NOTICE: str = "git discovery unavailable; using workspace walk"

fn root(tag: str, marker: bool) -> str {
    let tmp = env_get("TMPDIR") else "target/tests"
    let base = if tmp.len == 0 then "target/tests" else tmp
    let dir = "{base}/yew-symwalk-{os_pid()}-{tag}"
    fs.remove_dir_all(dir) else |_| {}
    fs.create_dir_all(dir) else |_| { want(false, "mkdir {dir}") }
    if marker {
        fs.create_dir("{dir}/.git") else |_| { want(false, "mkdir .git") }
    }
    dir
}

// A fake `git` in a directory of its own, for the PATH legs.
fn bin_with_git(tag: str) -> str {
    let dir = root("{tag}-bin", false)
    fs.write_text("{dir}/git", "#!/bin/sh\nexit 0\n") else |_| { want(false, "the fake git") }
    fs.set_mode("{dir}/git", 448) else |_| { want(false, "chmod") }
    dir
}

fn started(dir: str, path: str) -> edit.Ed {
    let old = env_get("PATH") else ""
    env_set("PATH", path) else |_| {}
    var ed = edit.ed_new()
    ed.ws_dir = dir
    edit.symwalk_start(mut ed)
    env_set("PATH", old) else |_| {}
    ed
}

fn symwalk_repo_without_git_posts_the_notice() {
    let dir = root("nogit", true)
    let empty = root("nogit-bin", false)
    let ed = started(dir, empty)
    want(ed.msg.active && ed.msg.text == NOTICE, "the notice: `{ed.msg.text}`")
    want(ed.msg.sev == edit.MSG_INFO, "INFO")
    fs.remove_dir_all(dir) else |_| {}
    fs.remove_dir_all(empty) else |_| {}
}

fn symwalk_repo_with_git_posts_nothing() {
    let dir = root("git", true)
    let bin = bin_with_git("git")
    let ed = started(dir, bin)
    want(!ed.msg.active || ed.msg.text != NOTICE, "no notice: `{ed.msg.text}`")
    fs.remove_dir_all(dir) else |_| {}
    fs.remove_dir_all(bin) else |_| {}
}

fn symwalk_no_marker_posts_nothing() {
    let dir = root("plain", false)
    let empty = root("plain-bin", false)
    let ed = started(dir, empty)
    want(!ed.msg.active || ed.msg.text != NOTICE, "no notice outside a repository")
    fs.remove_dir_all(dir) else |_| {}
    fs.remove_dir_all(empty) else |_| {}
}

fn main() {
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    let names = [
        "symwalk_repo_without_git_posts_the_notice",
        "symwalk_repo_with_git_posts_nothing",
        "symwalk_no_marker_posts_nothing",
    ]
    var n = 0
    while n < names.len {
        if chosen < 0 || chosen == n {
            match n {
                0 => symwalk_repo_without_git_posts_the_notice(),
                1 => symwalk_repo_with_git_posts_nothing(),
                _ => symwalk_no_marker_posts_nothing(),
            }
            print("{names[n]}: PASS")
        }
        n += 1
    }
}
