//! member: false
//!
//! The port of the eight `edit.cmdhist` cases of sagitta
//! `tests/unit/test_histsuggest.c` (926 lines), in registry order
//! (`tests/unit/registry.c:1120-1127`): the fish, zsh and bash readers,
//! zsh's unmetafication, the refusals, the dedupe and cap, the match and
//! the shell files the environment names. The fixtures are sagitta's
//! `tests/unit/fixtures/history/` byte for byte (`tests/fixtures/history/`).
//!
//! The suite's other thirteen cases (`histsuggest_default_is_all` through
//! `histsuggest_sentinel_never_leaks`, `registry.c:1128-1140`) drive the
//! prompt's ghost, its idle-turn snapshot and Up on a bang line through
//! `yew_cmdline_*`: they are the full prompt's (yw04's prompt half), not
//! this file's, and are not counted here.
//!
//! C's `SpecFix` (`compspec_fix.h:60-153`) makes a `/tmp` root with a
//! `home` and points `HOME` at it; the port's root is under the run's own
//! state directory, and HOME, XDG_DATA_HOME and HISTFILE are restored.

use edit
use std.fs

fn bytes_of(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() {
        (mut out).push(b)
    }
    out
}

fn from_ints(xs: List[int]) -> List[byte] {
    var out = List[byte]()
    for x in xs {
        (mut out).push(x as byte)
    }
    out
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn fixture(name: str) -> List[byte] {
    let data = fs_read_bytes("tests/fixtures/history/{name}") else |_| List[byte]()
    assert(data.len != 0, "the fixture {name} is read")
    data
}

fn snap_is(s: edit.HistSuggest, i: int, want: List[byte]) -> bool {
    assert(i < edit.hist_suggest_len(s), "entry {i} exists")
    let got = edit.hist_suggest_at(s, i) else List[byte]()
    same(got, want)
}

fn snap_text(s: edit.HistSuggest, i: int, want: str) -> bool {
    snap_is(s, i, bytes_of(want))
}

fn contains(hay: List[byte], needle: List[byte]) -> bool {
    let at = edit.hist_find(hay, needle) else -1
    at >= 0
}

fn t_histsuggest_fish_reader() {
    var s = edit.hist_suggest_new()
    edit.hist_parse_fish(mut s, fixture("fish_history"))
    assert(edit.hist_suggest_len(s) == 4, "four kept")
    assert(snap_text(s, 0, "fish-only --flag"), "newest first")
    assert(snap_text(s, 1, "git status"), "1")
    assert(snap_text(s, 2, "grep -r \"a\\b\" src"), "a doubled backslash is one")
    assert(snap_text(s, 3, "git status --short"), "3")
}

fn t_histsuggest_unmetafy() {
    let raw = from_ints(
        [99, 97, 116, 32, 196, 131, 163, 196, 131, 185, 46, 116, 120, 116, 32, 131, 163],
    )
    let out = edit.hist_unmetafy(raw)
    assert(out.len == 14, "fourteen bytes")
    assert(
        same(out, from_ints([99, 97, 116, 32, 196, 131, 196, 153, 46, 116, 120, 116, 32, 131])),
        "unmetafied",
    )
}

fn t_histsuggest_zsh_reader_unmetafies_first() {
    let data = fixture("zsh_history")
    assert(!contains(data, from_ints([196, 131, 196, 153])), "the raw file is metafied")
    var s = edit.hist_suggest_new()
    edit.hist_parse_zsh(mut s, data)
    assert(edit.hist_suggest_len(s) == 4, "four kept")
    assert(snap_text(s, 0, "zsh-only run"), "0")
    assert(snap_text(s, 1, "git stash list"), "1")
    assert(
        snap_is(s, 2, from_ints([99, 97, 116, 32, 196, 131, 196, 153, 46, 116, 120, 116])),
        "2 unmetafied",
    )
    assert(snap_is(s, 3, from_ints([108, 115, 32, 99, 97, 102, 195, 169])), "3")
    var i = 0
    while i < edit.hist_suggest_len(s) {
        let e = edit.hist_suggest_at(s, i) else List[byte]()
        assert(!contains(e, bytes_of("\n")), "no newline in {i}")
        assert(!contains(e, bytes_of(": 17")), "no timestamp in {i}")
        i += 1
    }
}

fn t_histsuggest_bash_reader_skips_timestamps() {
    var s = edit.hist_suggest_new()
    edit.hist_parse_bash(mut s, fixture("bash_history"))
    assert(edit.hist_suggest_len(s) == 3, "three kept")
    assert(snap_text(s, 0, "ls -la"), "0")
    assert(snap_text(s, 1, "git status --porcelain"), "1")
    assert(snap_text(s, 2, "bash-only thing"), "2")
    var t = edit.hist_suggest_new()
    edit.hist_parse_bash(mut t, bytes_of("#12\n# note\n"))
    assert(edit.hist_suggest_len(t) == 1, "a comment line is a command")
    assert(snap_text(t, 0, "# note"), "# note")
}

fn t_histsuggest_refuses_secrets_multiline_and_controls() {
    for r in [
        "export API_TOKEN=abc",
        "AWS_SECRET_ACCESS_KEY=x deploy",
        "a=1;DB_PASSWORD=hunter2 run",
        "curl --token=abc host",
        "env GITHUB_TOKEN=x gh",
        "echo one\ntwo",
        "tab\there",
        "bell\x07",
    ] {
        let b = bytes_of(r)
        assert(edit.hist_suggest_refused(b, 0, b.len), "refused: {r}")
    }
    for k in [
        "export PATH=/usr/bin",
        "make CC=clang",
        "echo TOKEN",
        "git log --format=%H",
        "ls café",
    ] {
        let b = bytes_of(k)
        assert(!edit.hist_suggest_refused(b, 0, b.len), "kept: {k}")
    }
}

fn add(mut s: edit.HistSuggest, t: str) -> bool {
    let b = bytes_of(t)
    edit.hist_suggest_add(mut s, b, 0, b.len)
}

fn t_histsuggest_dedupes_newest_first_and_caps() {
    var s = edit.hist_suggest_new()
    assert(add(mut s, "make test"), "make test")
    assert(add(mut s, "  make"), "leading blanks dropped")
    assert(!add(mut s, "make test"), "a repeat")
    assert(!add(mut s, " make test"), "a repeat behind a blank")
    assert(!add(mut s, "   "), "blanks only")
    assert(edit.hist_suggest_len(s) == 2, "two")
    assert(snap_text(s, 1, "make"), "make")
    var i = 0
    while i < edit.HIST_SUGGEST_MAX + 100 {
        let _ = add(mut s, "cmd-{i}")
        i += 1
    }
    assert(edit.hist_suggest_len(s) == edit.HIST_SUGGEST_MAX, "the cap")
}

fn rest(s: edit.HistSuggest, body: str) -> str {
    let b = bytes_of(body)
    let (at, i) = edit.hist_suggest_match(s, b, 0, b.len) else {
        return "<none>"
    }
    str_from_utf8(edit.hist_suggest_rest(s, i, at)) else "<bytes>"
}

fn t_histsuggest_match_newest_longer_byte_exact() {
    var s = edit.hist_suggest_new()
    let _ = add(mut s, "git status")
    let _ = add(mut s, "git status --short")
    let _ = add(mut s, "Git Stash")
    assert(rest(s, "git st") == "atus", "the newest longer")
    assert(rest(s, "git status") == " --short", "equal is not longer")
    assert(rest(s, "Git S") == "tash", "case-sensitive")
    assert(rest(s, "GIT") == "<none>", "no match")
    assert(rest(s, "  git st") == "atus", "leading blanks are the shell's")
    assert(rest(s, "") == "<none>", "empty")
    assert(rest(s, "  ") == "<none>", "blanks")
}

fn write_text(path: str, t: str) {
    fs_write_bytes(path, bytes_of(t)) else |_| {
        assert(false, "write {path}")
    }
}

fn scratch_root() -> str {
    let state = env_get("XDG_STATE_HOME") else ""
    let base = if state.len != 0 then state else "target/test-state"
    fs.create_dir_all(base) else |_| {}
    var n = 0
    var root = ""
    loop {
        root = "{base}/yew-histsuggest-{time_unix_ms()}-{n}"
        fs.create_dir(root) else |e| match e {
            exists => {
                n += 1
                continue
            },
            not_found => { assert(false, "{root}: not found") },
            denied => { assert(false, "{root}: denied") },
            io => { assert(false, "{root}: io") },
        }
        break
    }
    root
}

fn env_saved(name: str) -> (bool, str) {
    let v = env_get(name) else "#unset"
    (v != "#unset", v)
}

fn env_back(name: str, had: bool, v: str) {
    if had {
        env_set(name, v) else |_| {}
    } else {
        env_unset(name) else |_| {}
    }
}

fn t_histsuggest_reads_shell_files_from_the_environment() {
    let (had_home, old_home) = env_saved("HOME")
    let (had_data, old_data) = env_saved("XDG_DATA_HOME")
    let (had_hist, old_hist) = env_saved("HISTFILE")
    let root = scratch_root()
    let home = "{root}/home"
    fs.create_dir_all("{home}/.local/share/fish") else |_| {}
    fs_write_bytes("{home}/.local/share/fish/fish_history", fixture("fish_history")) else |_| {}
    fs_write_bytes("{home}/.zsh_history", fixture("zsh_history")) else |_| {}
    fs_write_bytes("{home}/.bash_history", fixture("bash_history")) else |_| {}
    env_set("HOME", home) else |_| {}
    env_unset("XDG_DATA_HOME") else |_| {}
    env_unset("HISTFILE") else |_| {}
    var s = edit.hist_suggest_new()
    edit.hist_suggest_read_shells(mut s)
    assert(s.shell_opens == 3, "three files opened ({s.shell_opens})")
    assert(edit.hist_suggest_len(s) == 11, "fish, zsh and bash ({edit.hist_suggest_len(s)})")
    assert(snap_text(s, 0, "fish-only --flag"), "fish first")
    assert(snap_text(s, 4, "zsh-only run"), "then zsh")
    assert(snap_text(s, 8, "ls -la"), "then bash")

    fs.create_dir_all("{root}/data/fish") else |_| {}
    write_text("{root}/data/fish/fish_history", "- cmd: from-xdg-data\n")
    env_set("XDG_DATA_HOME", "{root}/data") else |_| {}
    write_text("{root}/my_zsh_hist", ": 1:0;from-histfile-zsh\n")
    env_set("HISTFILE", "{root}/my_zsh_hist") else |_| {}
    var t = edit.hist_suggest_new()
    edit.hist_suggest_read_shells(mut t)
    assert(snap_text(t, 0, "from-xdg-data"), "XDG_DATA_HOME moves fish's")
    assert(snap_text(t, 1, "from-histfile-zsh"), "a zsh-named HISTFILE replaces ~/.zsh_history")
    assert(snap_text(t, 2, "ls -la"), "bash's default")
    write_text("{root}/bashlog", "from-histfile-bash\n")
    env_set("HISTFILE", "{root}/bashlog") else |_| {}
    var u = edit.hist_suggest_new()
    edit.hist_suggest_read_shells(mut u)
    assert(
        snap_text(u, edit.hist_suggest_len(u) - 1, "from-histfile-bash"),
        "otherwise HISTFILE is bash's",
    )

    env_unset("HOME") else |_| {}
    env_unset("XDG_DATA_HOME") else |_| {}
    env_unset("HISTFILE") else |_| {}
    var v = edit.hist_suggest_new()
    edit.hist_suggest_read_shells(mut v)
    assert(edit.hist_suggest_len(v) == 0, "no environment, nothing read")
    assert(v.shell_opens == 0, "and nothing opened")
    env_back("HOME", had_home, old_home)
    env_back("XDG_DATA_HOME", had_data, old_data)
    env_back("HISTFILE", had_hist, old_hist)
    fs.remove_dir_all(root) else |_| {
        assert(false, "rm the scratch root")
    }
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_histsuggest_fish_reader()
    t_histsuggest_unmetafy()
    t_histsuggest_zsh_reader_unmetafies_first()
    t_histsuggest_bash_reader_skips_timestamps()
    t_histsuggest_refuses_secrets_multiline_and_controls()
    t_histsuggest_dedupes_newest_first_and_caps()
    t_histsuggest_match_newest_longer_byte_exact()
    t_histsuggest_reads_shell_files_from_the_environment()
    print("histsuggest_test: 8 cases run (the cmdhist half), 0 SKIP")
}
