//! member: false
//!
//! The language by path (`edit.syn_lang_for_path`, sagitta
//! `src/syn/defs.c:3440-3510`'s `path_language` over the builtin index
//! `edit.syn_paths` generates): an exact filename, else a glob, else the
//! longest extension. A port-side file: C's own rows for the index are
//! syn's (yw10), so these hold the half yw11a ports.
//!
//! C matches a glob's two halves with byte compares (`defs.c:3459-3478`),
//! so a basename that is not ASCII matches or misses byte for byte and
//! never stops the editor: sagitta's CJK tab goldens open
//! `/tmp/漢字.txt` and `/tmp/日本.txt` (`tests/pty/registry.c:5996,6000`).

use edit

fn lang(path: str) -> str {
    edit.syn_lang_for_path(path) else "none"
}

fn syn_paths_name_the_builtin_languages() {
    assert(lang("src/main.lu") == "wolf", "main.lu: {lang("src/main.lu")}")
    assert(lang("/w/x.c") == "c", "x.c: {lang("/w/x.c")}")
    assert(lang("cfg.json") == "json", "cfg.json: {lang("cfg.json")}")
    assert(lang("Makefile") == "make", "Makefile: {lang("Makefile")}")
    assert(lang("/w/page.html") == "html", "page.html: {lang("/w/page.html")}")
    assert(lang("/w/noext") == "none", "noext: {lang("/w/noext")}")
}

fn syn_paths_non_ascii_names_match_by_bytes() {
    // The CJK goldens' files: `*.html` (a 5-byte suffix) is tried against
    // 10-byte names whose byte 5 is inside a character.
    assert(lang("/tmp/漢字.txt") == lang("/tmp/ab.txt"), "漢字.txt: {lang("/tmp/漢字.txt")}")
    assert(lang("/tmp/日本.txt") == lang("/tmp/ab.txt"), "日本.txt: {lang("/tmp/日本.txt")}")
    assert(lang("/w/日本語.lu") == "wolf", "日本語.lu: {lang("/w/日本語.lu")}")
    assert(lang("/w/日本.html") == "html", "日本.html: {lang("/w/日本.html")}")
    // A prefix glob (`README.*`, 7 bytes) cut inside a character, and a
    // suffix glob cut inside one, both miss.
    assert(lang("/w/READMEé") == "none", "READMEé: {lang("/w/READMEé")}")
    assert(lang("/w/éééé") == "none", "éééé: {lang("/w/éééé")}")
    assert(lang("/w/日本語") == "none", "日本語: {lang("/w/日本語")}")
}

fn main() {
    syn_paths_name_the_builtin_languages()
    print("syn_paths_name_the_builtin_languages: PASS")
    syn_paths_non_ascii_names_match_by_bytes()
    print("syn_paths_non_ascii_names_match_by_bytes: PASS")
    print("syn_paths_test: 2 cases pass")
}
