//! member: false
//!
//! The port of sagitta `tests/unit/test_shell_term.c` (277 lines), one
//! test per C test in registry order (Sprint 57.18 §4, 57.31 §3): `:!!cmd`
//! routes one command through the terminal handover, `ed.shell.term`
//! still refuses. Like C's, this process has no controlling terminal
//! under the runner, so the handover is skipped (`ed.tty_ready` false) and
//! the child runs with the inherited stdio — exactly the path whose
//! REPORTING is under test; the restore half is a PTY case's. It spawns
//! and its child signals itself: it runs inside the container (RULES §5).
//!
//! One row is KNOWN-RED by name (R-yw02-2's shape): C's last assertion of
//! `shell_term_run_reports_every_outcome` is that ordinary `:!true` adds
//! one user-visible job; at wolf 0.2.33 the stream is the job half that
//! STOPs (R-yw04-1), so the port asserts the refusal by name instead and
//! says so on both streams.

use edit
use std.env as std_env
use std.fs

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

/// `term_fix_make` (`test_shell_term.c:28-43`): an editor whose workspace
/// root is a fresh directory.
fn fixture() -> (edit.Ed, str) {
    let base = "/tmp/yew-term-{os_pid()}"
    fs.remove_dir_all(base) else |_| {}
    fs.create_dir_all(base) else |_| { assert(false, "mkdir {base}") }
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.ws_dir = base
    (ed, base)
}

fn fixture_drop(base: str) {
    fs.remove_dir_all(base) else |_| { assert(false, "remove {base}") }
}

/// `term_run_line` (`test_shell_term.c:62-80`): one E-mode line through
/// the real parse and dispatch.
fn run_line(mut ed: edit.Ed, line: str) -> int {
    let parsed = edit.cmd_parse(mut ed, bytes_of(line))
    if !edit.cmd_parse_ok(parsed) {
        return edit.CMD_ERR_ARG
    }
    let inv = edit.CmdInvoke {
        range: copy parsed.range,
        argv: copy parsed.argv,
        count: 0,
        bang: parsed.bang,
        win: ed.win,
    }
    edit.ed_invoke_parsed(mut ed, parsed.command, inv)
}

// DoD 5 (`test_shell_term.c:88-101`).
fn t_shell_term_refuses_and_names_the_route() {
    var (ed, base) = fixture()
    assert(run_line(mut ed, ":shell.term") == edit.CMD_ERR_STATE, "refused")
    assert(ed.msg.text.contains("does not emulate"), "what is refused")
    assert(ed.msg.text.contains(":!!"), "the route")
    assert(ed.msg.sev == edit.MSG_ERROR, "an error")
    assert(edit.cmd_lookup(ed.reg, "ed.shell.term") != 0, "the refusal is a command")
    assert(edit.cmd_lookup(ed.reg, "ed.shell.term_run") != 0, "the route is another")
    fixture_drop(base)
}

// §4 (`test_shell_term.c:115-150`).
fn t_shell_term_run_reports_every_outcome() {
    var (ed, base) = fixture()
    assert(run_line(mut ed, ":!!true") == edit.CMD_OK, ":!!true")
    assert(ed.msg.text.contains("exited 0"), "exited 0: {ed.msg.text}")
    assert(ed.msg.sev == edit.MSG_INFO, "info")
    assert(run_line(mut ed, ":!!exit 23") == edit.CMD_OK, ":!!exit 23")
    assert(ed.msg.text.contains("exited 23"), "exited 23: {ed.msg.text}")
    assert(ed.msg.sev == edit.MSG_WARN, "a warning")
    assert(
        run_line(mut ed, ":!!exec /bin/sh -c 'kill -TERM $$'") == edit.CMD_OK,
        "the signal fixture",
    )
    assert(ed.msg.text.contains("killed by signal"), "killed by signal: {ed.msg.text}")
    assert(run_line(mut ed, ":!!test \"a b\" = \"a b\"") == edit.CMD_OK, "verbatim quoting")
    assert(ed.msg.text.contains("exited 0"), "exited 0")
    let st = run_line(mut ed, ":!true")
    assert(
        st == edit.CMD_ERR_DEFERRED &&
            ed.msg.text.contains("needs os_signal_wait_fds (G2, wolf-lang#795)"),
        "ordinary :! refuses by name (R-yw04-1): {ed.msg.text}",
    )
    print(
        "shell_term_test: KNOWN-RED shell_term_run_reports_every_outcome's last row: `:!true` streams into a job buffer, the job half (R-yw04-1); its refusal by name asserted",
    )
    eprint(
        "shell_term_test: KNOWN-RED shell_term_run_reports_every_outcome's last row: `:!true` streams into a job buffer, the job half (R-yw04-1); its refusal by name asserted",
    )
    fixture_drop(base)
}

// §4's two refusals (`test_shell_term.c:157-179`).
fn t_shell_term_run_refuses_a_range_and_batch() {
    var (ed, base) = fixture()
    assert(run_line(mut ed, ":%!!sort") == edit.CMD_ERR_ARG, ":%!! refused")
    assert(ed.msg.text.contains("no range"), "no range: {ed.msg.text}")
    // The grammar refuses an empty body as "ed.shell.run needs a command";
    // C reaches the command's own words through its argument path.
    let st = run_line(mut ed, ":!!")
    assert(st == edit.CMD_ERR_STATE, ":!! with nothing: {st}")
    assert(ed.msg.text.contains("needs a command"), "needs a command: {ed.msg.text}")
    ed.headless = true
    let (ok, _, err) = edit.shell_term_run(mut ed, "true")
    assert(!ok && err.contains("--batch") && err.contains("ed.shell.run"), "headless: {err}")
    assert(run_line(mut ed, ":!!true") == edit.CMD_ERR_STATE, "refused under --batch")
    assert(ed.msg.text.contains("--batch"), "says --batch")
    ed.headless = false
    fixture_drop(base)
}

// Sprint 57.31 §3 (`test_shell_term.c:199-277`).
fn t_shell_term_argv_runs_words_and_keeps_the_pager() {
    var (ed, base) = fixture()
    let out = "{base}/out"
    let saved = env_get("PAGER") else ""
    let had = std_env.has("PAGER")
    env_set("PAGER", "my-pager -R") else |_| {}
    var argv = List[str]()
    for w in [
        "/bin/sh",
        "-c",
        "printf '%s|%s|%s' \"$#\" \"$1\" \"$PAGER\" > \"$2\"",
        "sh",
        "a b;$(touch nope)",
    ] {
        (mut argv).push(w)
    }
    var full = copy argv
    (mut full).push(out)
    let (ok, wait, err) = edit.shell_term_argv(mut ed, full)
    assert(ok, "ran: {err}")
    assert(wait.state == edit.JOB_EXITED && wait.exit_code == 0, "exited 0")
    let got = fs.read_text(out) else ""
    assert(got == "2|a b;$(touch nope)|my-pager -R", "the words and the pager: {got}")
    fs.remove(out) else |_| {}
    var cat = false
    for row in edit.job_env(mut ed, false) {
        if row == "PAGER=cat" {
            cat = true
        }
        assert(row != "PAGER=my-pager -R", "a captured job's pager is cat")
    }
    assert(cat, "PAGER=cat")
    ed.headless = true
    let (ok2, _, err2) = edit.shell_term_argv(mut ed, argv)
    assert(!ok2 && err2.contains("--batch"), "headless: {err2}")
    ed.headless = false
    let (ok3, _, _) = edit.shell_term_argv(mut ed, List[str]())
    assert(!ok3, "no argv")
    if had {
        env_set("PAGER", saved) else |_| {}
    } else {
        env_unset("PAGER") else |_| {}
    }
    fixture_drop(base)
}

fn main() {
    // The session's `--yew-env0` runs this binary (`unit_main.c:14-19`).
    if edit.shsession_env0_requested() {
        os_exit(edit.shsession_env0_main())
    }
    fs.create_dir_all("target/tests") else |_| {}
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_shell_term_refuses_and_names_the_route()
    t_shell_term_run_reports_every_outcome()
    t_shell_term_run_refuses_a_range_and_batch()
    t_shell_term_argv_runs_words_and_keeps_the_pager()
    print("shell_term_test: 4 cases pass (1 row KNOWN-RED by name)")
}
