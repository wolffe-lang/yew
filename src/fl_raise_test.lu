//! member: false
//! sagitta 9ace98c2 vm.c:206-233: snprintf's 1024-byte buffer and %.*s NUL.

use fl

fn message(vm: fl.FlVm) -> fl.FlValue {
    let at = fl.fl_obj_index(vm, vm.err)
    for row in vm.gc.slots[at].ents {
        if row.k.t == 4 {
            let key = fl.fl_obj_index(vm, row.k)
            if vm.gc.slots[key].bytes.len == 3 && vm.gc.slots[key].bytes[0] == 109 as byte {
                return copy row.v
            }
        }
    }
    assert(false)
    fl.fl_nil()
}

fn main() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    var bytes = List[byte]()
    for _ in 0..1022 { (mut bytes).push(97 as byte) }
    (mut bytes).push(195 as byte)
    (mut bytes).push(169 as byte)
    let _ = fl.fl_raise_bytes(mut vm, "type", bytes)
    let msg = message(vm)
    let at = fl.fl_obj_index(vm, msg)
    assert(vm.gc.slots[at].bytes.len == 1023 && vm.gc.slots[at].bytes[1022] == 195 as byte)
    let _ = fl.fl_raise(mut vm, "type", "before\0after")
    let nul = message(vm)
    assert(fl.fl_str_len(vm, nul) == 6)
    let _ = fl.fl_raise(mut vm, "type", "\0after")
    assert(fl.fl_str_len(vm, message(vm)) == 0)
    assert(vm.raised)
    print("PASS fl_raise cap_and_NUL_are_byte_exact")
    let args = env_args()
    if args.len != 0 && args[0] == "--residency" { retained_raise_buffers() }
}

fn retained_raise_buffers() {
    region heap {
        var strings = fl.fl_strings()
        var vm = fl.fl_vm_new(take strings)
        var warm: int = 0
        for i in 0..100 {
            let _ = fl.fl_raise(mut vm, "type", "repeated diagnostic")
            fl.fl_gc_collect(mut vm)
            if i == 20 { warm = region_bytes(heap) }
        }
        let final_bytes = region_bytes(heap)
        print("raise residency after21={warm} after100={final_bytes}")
        assert(final_bytes == warm)
    }
}
