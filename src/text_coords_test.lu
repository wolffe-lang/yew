//! member: false
//!
//! The port of sagitta `tests/unit/test_coords.c` (685 lines), one test per
//! C test in registry order (`tests/unit/registry.c:305-314`). The motion
//! golden is sagitta's `tests/unit/fixtures/unicode/motion_golden.txt`,
//! copied verbatim to `tests/fixtures/unicode/`. C's `UINT64_MAX` column is
//! the port's `text.CCOL_EOL` (the largest `int`).

use std.fs
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn list_of(xs: List[int]) -> List[byte] {
    var v = List[byte]()
    for x in xs {
        (mut v).push(x as byte)
    }
    v
}

fn hex_digit(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    -1
}

fn parse_hex(field: str) -> List[byte] {
    var out = List[byte]()
    for w in field.words() {
        var v = 0
        for b in w.bytes() {
            let d = hex_digit(b as int)
            assert(d >= 0, "hex digit")
            v = v * 16 + d
        }
        assert(v <= 255, "a byte")
        (mut out).push(v as byte)
    }
    out
}

fn parse_ints(field: str) -> List[int] {
    var out = List[int]()
    for w in field.split(",") {
        (mut out).push(w.trim().to_int() else -1)
    }
    out
}

fn t_coords_motion_golden() {
    let content = fs.read_text("tests/fixtures/unicode/motion_golden.txt") else {
        assert(false, "motion golden readable")
        return
    }
    var cases = 0
    for row in content.lines() {
        let trimmed = row.trim()
        if trimmed.len == 0 || trimmed.starts_with("#") {
            continue
        }
        let fields = trimmed.split("|")
        assert(fields.len == 4, "four fields")
        let bytes = parse_hex(fields[1])
        let lengths = parse_ints(fields[2])
        let widths = parse_ints(fields[3])
        assert(lengths.len == widths.len, "lengths and widths")
        var tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
        let line = text.span(0, bytes.len)
        var cursor = text.cursor_at(text.byteoff(0))
        let crlf = fields[0] == "crlf"
        assert(text.is_grapheme_boundary(tb, text.byteoff(0)), "0 is a boundary")
        var off = 0
        var cells = 0
        var i = 0
        while i < lengths.len {
            let start = off
            off += lengths[i]
            text.cursor_right(tb, mut cursor)
            assert(cursor.pos == off, "{fields[0]}: right to {off}")
            assert(text.grapheme_next(tb, text.byteoff(start)) as int == off, "next")
            assert(text.grapheme_prev(tb, text.byteoff(off)) as int == start, "prev")
            assert(text.is_grapheme_boundary(tb, text.byteoff(off)), "boundary at end")
            if lengths[i] > 1 {
                assert(!text.is_grapheme_boundary(tb, text.byteoff(start + 1)), "inside")
            }
            if !crlf {
                assert(text.off_to_gcol(mut tb, line, text.byteoff(start)) as int == i, "gcol")
                assert(text.gcol_to_off(mut tb, line, i as text.GCol) as int == start, "gcol back")
                assert(text.off_to_ccol(tb, line, text.byteoff(start), 4) as int == cells, "ccol")
                assert(
                    text.ccol_to_off(tb, line, cells as text.CCol, 4) as int == start,
                    "ccol back",
                )
            }
            cells += widths[i]
            i += 1
        }
        assert(off == bytes.len, "covered")
        i = lengths.len
        while i > 0 {
            off -= lengths[i - 1]
            text.cursor_left(mut tb, mut cursor)
            assert(cursor.pos == off, "{fields[0]}: left to {off}")
            i -= 1
        }
        assert(off == 0, "back at 0")
        off = bytes.len
        if crlf {
            assert(text.off_to_gcol(mut tb, line, text.byteoff(2)) as int == 0, "crlf gcol")
            assert(text.off_to_ccol(tb, line, text.byteoff(2), 4) as int == 0, "crlf ccol")
        } else {
            assert(
                text.off_to_gcol(mut tb, line, text.byteoff(off)) as int == lengths.len,
                "end gcol",
            )
            assert(
                text.gcol_to_off(mut tb, line, lengths.len as text.GCol) as int == off,
                "end gcol back",
            )
            assert(text.off_to_ccol(tb, line, text.byteoff(off), 4) as int == cells, "end ccol")
            assert(text.ccol_to_off(tb, line, cells as text.CCol, 4) as int == off, "end ccol back")
        }
        text.textbuf_free(mut tb)
        cases += 1
    }
    assert(cases >= 9, "nine cases at least")
}

fn t_coords_display_ordinal_is_one_based_without_overflow() {
    assert(text.coord_display(0) == 1, "0 -> 1")
    assert(text.coord_display(1) == 2, "1 -> 2")
    assert(text.coord_display(4294967295) == 4294967296, "u32 max")
}

fn t_coords_piece_stream() {
    let family = list_of(
        [
            240,
            159,
            145,
            168,
            226,
            128,
            141,
            240,
            159,
            145,
            169,
            226,
            128,
            141,
            240,
            159,
            145,
            167,
            226,
            128,
            141,
            240,
            159,
            145,
            166,
        ],
    )
    var tb = text.textbuf_new()
    var i = 0
    while i < family.len {
        let len = text.textbuf_len(tb)
        text.textbuf_insert_part(mut tb, text.byteoff(len), family, i, i + 1)
        text.textbuf_insert_str(mut tb, text.byteoff(len + 1), "x")
        text.textbuf_delete(mut tb, text.span(len + 1, len + 2))
        i += 1
    }
    let n = family.len
    assert(text.textbuf_piece_count(tb) >= 3, "pieces")
    assert(text.textbuf_len(tb) == n, "length")
    assert(text.grapheme_next(tb, text.byteoff(0)) as int == n, "one cluster forward")
    assert(text.grapheme_prev(tb, text.byteoff(n)) as int == 0, "one cluster back")
    assert(text.off_to_gcol(mut tb, text.span(0, n), text.byteoff(n)) as int == 1, "gcol 1")
    assert(
        text.off_to_charcol(tb, text.span(0, n), text.byteoff(n)) as int == 7,
        "seven codepoints",
    )
    assert(text.off_to_ccol(tb, text.span(0, n), text.byteoff(n), 4) as int == 2, "two cells")
    text.textbuf_free(mut tb)
}

fn t_coords_tabs_wide_and_invalid() {
    let bytes = list_of([97, 9, 230, 188, 162, 255, 98])
    var tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    let line = text.span(0, bytes.len)
    let n = bytes.len
    assert(text.off_to_ccol(tb, line, text.byteoff(2), 2) as int == 2, "tab 2")
    assert(text.off_to_ccol(tb, line, text.byteoff(2), 4) as int == 4, "tab 4")
    assert(text.off_to_ccol(tb, line, text.byteoff(2), 8) as int == 8, "tab 8")
    assert(text.ccol_to_off(tb, line, 5 as text.CCol, 4) as int == 2, "cell 5")
    assert(text.ccol_to_off(tb, line, 6 as text.CCol, 4) as int == 5, "cell 6")
    assert(text.off_to_ccol(tb, line, text.byteoff(6), 4) as int == 10, "ccol 10")
    assert(text.off_to_charcol(tb, line, text.byteoff(6)) as int == 4, "charcol 4")
    assert(text.off_to_gcol(mut tb, line, text.byteoff(6)) as int == 4, "gcol 4")
    assert(text.ccol_to_off(tb, line, 11 as text.CCol, 4) as int == n, "cell 11")
    assert(text.ccol_to_off(tb, line, 12 as text.CCol, 4) as int == 6, "cell 12")
    assert(text.ccol_to_off_padded(tb, line, 12 as text.CCol, 4) as int == n, "padded 12")
    assert(text.ccol_shortfall(12 as text.CCol, 10 as text.CCol) == 2, "shortfall")
    assert(text.ccol_max(12 as text.CCol, 10 as text.CCol) as int == 12, "max a")
    assert(text.ccol_max(10 as text.CCol, 12 as text.CCol) as int == 12, "max b")
    assert(text.ccol_to_off(tb, line, text.CCOL_EOL as text.CCol, 4) as int == 6, "cell max")
    assert(text.gcol_to_off(mut tb, line, 5 as text.GCol) as int == n, "gcol 5")
    assert(text.gcol_to_off(mut tb, line, 6 as text.GCol) as int == 6, "gcol 6")
    assert(text.gcol_to_off(mut tb, line, text.CCOL_EOL as text.GCol) as int == 6, "gcol max")
    let w = [2, 4, 8]
    for tabw in w {
        let c = text.off_to_ccol(tb, line, text.byteoff(2), tabw)
        assert(text.ccol_to_off(tb, line, c, tabw) as int == 2, "round trip tab {tabw}")
    }
    text.textbuf_free(mut tb)
}

fn t_coords_crlf_and_clamping() {
    var tb = text.textbuf_from_str("ab\r\nx")
    let first = text.textbuf_line_span(tb, text.lineno(0))
    assert(first.lo == 0 && first.hi == 4, "first line")
    assert(text.gcol_to_off(mut tb, first, text.CCOL_EOL as text.GCol) as int == 2, "gcol clamp")
    assert(text.ccol_to_off(tb, first, text.CCOL_EOL as text.CCol, 4) as int == 2, "ccol clamp")
    assert(text.off_to_gcol(mut tb, first, text.byteoff(4)) as int == 2, "gcol at eol")
    assert(text.off_to_charcol(tb, first, text.byteoff(4)) as int == 2, "charcol at eol")
    assert(text.off_to_ccol(tb, first, text.byteoff(4), 4) as int == 2, "ccol at eol")
    assert(text.grapheme_next(tb, text.byteoff(2)) as int == 4, "crlf is one cluster")
    assert(text.grapheme_prev(tb, text.byteoff(4)) as int == 2, "back over crlf")
    assert(!text.is_grapheme_boundary(tb, text.byteoff(3)), "inside crlf")
    assert(text.is_grapheme_boundary(tb, text.byteoff(4)), "after crlf")
    assert(text.grapheme_next(tb, text.byteoff(text.CCOL_EOL)) as int == 5, "next clamps")
    assert(text.grapheme_prev(tb, text.byteoff(text.CCOL_EOL)) as int == 4, "prev clamps")
    text.textbuf_free(mut tb)
}

fn t_coords_inside_cluster_rounds_left() {
    let bytes = list_of([101, 204, 129, 122])
    var tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    let line = text.span(0, bytes.len)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(1)) as int == 0, "gcol rounds left")
    assert(text.off_to_charcol(tb, line, text.byteoff(2)) as int == 1, "charcol")
    assert(text.off_to_ccol(tb, line, text.byteoff(2), 4) as int == 0, "ccol rounds left")
    assert(text.grapheme_next(tb, text.byteoff(1)) as int == 3, "next")
    assert(text.grapheme_prev(tb, text.byteoff(2)) as int == 0, "prev")
    assert(!text.is_grapheme_boundary(tb, text.byteoff(1)), "1 inside")
    assert(!text.is_grapheme_boundary(tb, text.byteoff(2)), "2 inside")
    text.textbuf_free(mut tb)
}

fn t_coords_streams_large_cluster_width() {
    let extend_count = 262144
    let len = 1 + extend_count * 2
    var bytes = List[byte]()
    (mut bytes).push(101 as byte)
    var i = 0
    while i < extend_count {
        (mut bytes).push(204 as byte)
        (mut bytes).push(129 as byte)
        i += 1
    }
    var tb = text.textbuf_from_owned_bytes(take bytes)
    let line = text.span(0, len)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(len)) as int == 1, "one grapheme")
    assert(text.off_to_ccol(tb, line, text.byteoff(len), 4) as int == 1, "one cell")
    assert(text.ccol_to_off(tb, line, 1 as text.CCol, 4) as int == len, "cell 1 is the end")
    assert(text.grapheme_next(tb, text.byteoff(0)) as int == len, "next is the end")
    text.textbuf_free(mut tb)
}

fn repeated(unit: List[int], count: int) -> List[byte] {
    var out = List[byte]()
    var i = 0
    while i < count {
        for b in unit {
            (mut out).push(b as byte)
        }
        i += 1
    }
    out
}

fn t_coords_reverse_long_context_runs() {
    var tb = text.textbuf_from_owned_bytes(take repeated([240, 159, 135, 166], 65))
    assert(text.grapheme_prev_boundary(mut tb, text.byteoff(260)) as int == 256, "ri 65 boundary")
    assert(text.grapheme_prev(tb, text.byteoff(260)) as int == 256, "ri 65 prev")
    text.textbuf_free(mut tb)
    tb = text.textbuf_from_owned_bytes(take repeated([240, 159, 135, 166], 129))
    assert(text.grapheme_prev_boundary(mut tb, text.byteoff(516)) as int == 512, "ri 129 boundary")
    assert(text.grapheme_prev(tb, text.byteoff(516)) as int == 512, "ri 129 prev")
    text.textbuf_free(mut tb)
    tb = text.textbuf_from_owned_bytes(take repeated([204, 129], 65))
    assert(text.grapheme_prev_boundary(mut tb, text.byteoff(130)) as int == 0, "extend 65")
    assert(text.is_grapheme_boundary(tb, text.byteoff(0)), "0 boundary")
    text.textbuf_free(mut tb)
    tb = text.textbuf_from_owned_bytes(take repeated([204, 129], 129))
    assert(text.grapheme_prev_boundary(mut tb, text.byteoff(258)) as int == 0, "extend 129")
    assert(text.is_grapheme_boundary(tb, text.byteoff(0)), "0 boundary")
    text.textbuf_free(mut tb)
}

fn filled(b: int, n: int) -> List[byte] {
    var out = List[byte]()
    var i = 0
    while i < n {
        (mut out).push(b as byte)
        i += 1
    }
    out
}

fn line0(tb: text.TextBuf, l: int) -> text.Span {
    text.textbuf_line_span(tb, text.lineno(l))
}

fn t_coords_sparse_index_edit_invalidation() {
    let accent = list_of([204, 129])
    let prepend = list_of([216, 128])
    let split = bytes_of("\nzz")
    let x = bytes_of("x")
    let y = bytes_of("y")
    let split_cluster = list_of([97, 204, 129, 204, 129, 204, 129])
    let latin2_run = list_of([195, 169, 195, 169, 195, 169])

    let bytes = filled(97, 130)
    var tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    assert(tb.graphemes.gen == tb.gen, "index current")
    assert(tb.graphemes.data.len == 2, "two checkpoints")
    var line = line0(tb, 0)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(130)) as int == 130, "gcol 130")
    assert(text.gcol_to_off(mut tb, line, 64 as text.GCol) as int == 64, "off 64")
    text.textbuf_insert(mut tb, text.byteoff(1), accent)
    assert(tb.graphemes.gen != tb.gen, "stale after insert")
    assert(tb.graphemes.pending.len == 1, "one pending")
    line = line0(tb, 0)
    assert(text.gcol_to_off(mut tb, line, 64 as text.GCol) as int == 66, "off 66")
    assert(tb.graphemes.gen == tb.gen, "replayed")
    assert(text.off_to_gcol(mut tb, line, text.byteoff(132)) as int == 130, "gcol 130 again")
    text.textbuf_delete(mut tb, text.span(1, 3))
    assert(tb.graphemes.gen != tb.gen, "stale after delete")
    assert(tb.graphemes.pending.len == 1, "one pending")
    line = line0(tb, 0)
    assert(text.gcol_to_off(mut tb, line, 128 as text.GCol) as int == 128, "off 128")
    assert(tb.graphemes.gen == tb.gen, "replayed")
    assert(text.off_to_gcol(mut tb, line, text.byteoff(130)) as int == 130, "gcol 130 once more")
    text.textbuf_free(mut tb)

    var two_lines = filled(97, 130)
    (mut two_lines).push(10 as byte)
    for b in filled(98, 130) {
        (mut two_lines).push(b)
    }
    tb = text.textbuf_from_bytes(two_lines, 0, two_lines.len)
    assert(tb.graphemes.data.len == 4, "four checkpoints")
    line = line0(tb, 1)
    assert(text.gcol_to_off(mut tb, line, 64 as text.GCol) as int == 195, "off 195")
    assert(text.off_to_gcol(mut tb, line, text.byteoff(261)) as int == 130, "gcol 130")
    text.textbuf_free(mut tb)

    var long_lines = filled(97, 700)
    (mut long_lines).push(10 as byte)
    for b in filled(98, 700) {
        (mut long_lines).push(b)
    }
    tb = text.textbuf_from_bytes(long_lines, 0, long_lines.len)
    text.textbuf_insert(mut tb, text.byteoff(650), split)
    assert(tb.graphemes.gen != tb.gen, "stale")
    assert(tb.graphemes.pending.len == 1, "one pending")
    assert(text.textbuf_line_count(tb) == 3, "three lines")
    line = line0(tb, 0)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(650)) as int == 650, "gcol 650")
    line = line0(tb, 1)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(703)) as int == 52, "gcol 52")
    line = line0(tb, 2)
    assert(text.gcol_to_off(mut tb, line, 64 as text.GCol) as int == 768, "off 768")
    text.textbuf_delete(mut tb, text.span(650, 653))
    assert(tb.graphemes.gen != tb.gen, "stale")
    assert(tb.graphemes.pending.len == 1, "one pending")
    assert(text.textbuf_line_count(tb) == 2, "two lines")
    line = line0(tb, 1)
    assert(text.gcol_to_off(mut tb, line, 64 as text.GCol) as int == 765, "off 765")
    assert(text.off_to_gcol(mut tb, line, text.byteoff(1401)) as int == 700, "gcol 700")
    text.textbuf_free(mut tb)

    let deferred = filled(97, 700)
    tb = text.textbuf_from_bytes(deferred, 0, deferred.len)
    text.textbuf_insert(mut tb, text.byteoff(10), x)
    assert(tb.graphemes.pending.len == 1, "one pending")
    assert(
        text.grapheme_prev_boundary(mut tb, text.byteoff(701)) as int == 700,
        "prev boundary 700",
    )
    line = line0(tb, 0)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(701)) as int == 701, "gcol 701")
    text.textbuf_delete(mut tb, text.span(10, 11))
    assert(tb.graphemes.pending.len == 1, "one pending")
    assert(
        text.grapheme_prev_boundary(mut tb, text.byteoff(700)) as int == 699,
        "prev boundary 699",
    )
    line = line0(tb, 0)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(700)) as int == 700, "gcol 700")
    text.textbuf_free(mut tb)

    tb = text.textbuf_from_bytes(deferred, 0, deferred.len)
    text.textbuf_insert(mut tb, text.byteoff(10), x)
    assert(tb.graphemes.pending.len == 1, "one pending")
    text.textbuf_insert(mut tb, text.byteoff(20), y)
    assert(tb.graphemes.pending.len == 2, "two pending")
    assert(tb.graphemes.gen != tb.gen, "stale")
    line = line0(tb, 0)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(702)) as int == 702, "gcol 702")
    assert(tb.graphemes.gen == tb.gen, "replayed both")
    text.textbuf_free(mut tb)

    tb = text.textbuf_from_bytes(long_lines, 0, long_lines.len)
    text.textbuf_insert(mut tb, text.byteoff(1000), x)
    text.textbuf_insert(mut tb, text.byteoff(100), split)
    assert(tb.graphemes.pending.len == 2, "two pending")
    assert(text.textbuf_line_count(tb) == 3, "three lines")
    line = line0(tb, 0)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(100)) as int == 100, "gcol 100")
    line = line0(tb, 1)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(703)) as int == 602, "gcol 602")
    line = line0(tb, 2)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(1405)) as int == 701, "gcol 701")
    assert(text.gcol_to_off(mut tb, line, 300 as text.GCol) as int == 1004, "off 1004")
    assert(tb.graphemes.gen == tb.gen, "replayed")
    text.textbuf_free(mut tb)

    tb = text.textbuf_from_bytes(deferred, 0, deferred.len)
    var edit_at = 10
    while edit_at <= 90 {
        text.textbuf_insert(mut tb, text.byteoff(edit_at), x)
        text.textbuf_check(tb)
        edit_at += 10
    }
    assert(tb.graphemes.pending.len == 1, "one pending after nine")
    assert(tb.graphemes.gen == tb.gen - 1, "one behind")
    line = line0(tb, 0)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(709)) as int == 709, "gcol 709")
    assert(tb.graphemes.gen == tb.gen, "current")
    assert(tb.graphemes.pending.len == 0, "none pending")
    text.textbuf_free(mut tb)

    tb = text.textbuf_from_str("abc")
    text.textbuf_insert(mut tb, text.byteoff(3), x)
    assert(tb.graphemes.simple_ascii, "simple")
    assert(tb.graphemes.simple_ascii_direct, "direct")
    assert(tb.graphemes.pending.len == 0, "none pending")
    line = line0(tb, 0)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(4)) as int == 4, "gcol 4")
    text.textbuf_free(mut tb)

    tb = text.textbuf_from_owned_bytes(take filled(97, 65536))
    assert(tb.graphemes.initialized, "initialized")
    assert(tb.graphemes.simple_ascii, "simple")
    assert(tb.graphemes.simple_ascii_direct, "direct")
    assert(tb.graphemes.data.len == 0, "no checkpoints")
    text.textbuf_insert(mut tb, text.byteoff(10), x)
    assert(tb.graphemes.initialized, "initialized")
    assert(tb.graphemes.simple_ascii_direct, "direct")
    assert(tb.graphemes.pending.len == 0, "none pending")
    line = line0(tb, 0)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(65537)) as int == 65537, "gcol 65537")
    assert(tb.graphemes.initialized, "initialized")
    assert(tb.graphemes.simple_ascii, "simple")
    text.textbuf_delete(mut tb, text.span(0, 2048))
    assert(tb.graphemes.simple_ascii_direct, "direct after delete")
    text.textbuf_insert(mut tb, text.byteoff(20), x)
    assert(tb.graphemes.simple_ascii_direct, "direct after insert")
    line = line0(tb, 0)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(63490)) as int == 63490, "gcol 63490")
    text.textbuf_insert(mut tb, text.byteoff(32768), accent)
    assert(!tb.graphemes.simple_ascii, "not simple")
    assert(!tb.graphemes.initialized, "deferred")
    assert(tb.graphemes.pending.len == 0, "none pending")
    line = line0(tb, 0)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(63492)) as int == 63490, "unindexed gcol")
    assert(!tb.graphemes.initialized, "still deferred")
    text.textbuf_free(mut tb)

    tb = text.textbuf_from_owned_bytes(take filled(97, 65536))
    text.textbuf_insert(mut tb, text.byteoff(32768), prepend)
    assert(!tb.graphemes.initialized, "deferred")
    line = line0(tb, 0)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(32769)) as int == 32768, "a")
    assert(text.off_to_gcol(mut tb, line, text.byteoff(32770)) as int == 32768, "b")
    assert(text.off_to_gcol(mut tb, line, text.byteoff(32771)) as int == 32769, "c")
    assert(text.off_to_gcol(mut tb, line, text.byteoff(65538)) as int == 65536, "d")
    assert(text.gcol_to_off(mut tb, line, 32768 as text.GCol) as int == 32768, "e")
    assert(text.gcol_to_off(mut tb, line, 32769 as text.GCol) as int == 32771, "f")
    assert(text.gcol_to_off(mut tb, line, 65536 as text.GCol) as int == 65538, "g")
    assert(!tb.graphemes.initialized, "still deferred")
    text.textbuf_free(mut tb)

    var large = filled(97, 65536)
    large[100] = 10 as byte
    large[200] = 10 as byte
    tb = text.textbuf_from_owned_bytes(take large)
    assert(tb.graphemes.initialized, "initialized")
    assert(tb.graphemes.simple_ascii, "simple")
    assert(tb.graphemes.simple_ascii_direct, "direct")
    assert(tb.graphemes.data.len == 0, "no checkpoints")
    assert(text.textbuf_line_count(tb) == 3, "three lines")
    line = line0(tb, 0)
    assert(text.off_to_gcol(mut tb, line, text.byteoff(100)) as int == 100, "h")
    assert(text.off_to_gcol(mut tb, line, text.byteoff(101)) as int == 100, "i")
    assert(text.gcol_to_off(mut tb, line, 101 as text.GCol) as int == 100, "j")
    line = line0(tb, 1)
    assert(text.off_to_ccol(tb, line, text.byteoff(201), 4) as int == 99, "k")
    assert(text.ccol_to_off(tb, line, 100 as text.CCol, 4) as int == 200, "l")
    text.textbuf_insert(mut tb, text.byteoff(10), accent)
    assert(!tb.graphemes.simple_ascii, "not simple")
    assert(!tb.graphemes.initialized, "deferred")
    line = line0(tb, 2)
    assert(line.lo == 203, "line 2 at 203")
    assert(text.off_to_gcol(mut tb, line, text.byteoff(1002)) as int == 799, "m")
    assert(!tb.graphemes.initialized, "still deferred")
    text.textbuf_free(mut tb)

    tb = text.textbuf_from_bytes(split_cluster, 0, split_cluster.len)
    text.textbuf_insert(mut tb, text.byteoff(3), x)
    var cursor = text.cursor_at(text.byteoff(split_cluster.len + 1))
    cursor.goal_col = text.CCOL_EOL
    text.cursor_left(mut tb, mut cursor)
    assert(cursor.pos == 3, "left to 3")
    assert(text.cursor_goal(tb, cursor, 4) as int == 1, "goal 1")
    text.cursor_left(mut tb, mut cursor)
    assert(cursor.pos == 0, "left to 0")
    assert(text.cursor_goal(tb, cursor, 4) as int == 0, "goal 0")
    text.textbuf_free(mut tb)

    tb = text.textbuf_from_bytes(latin2_run, 0, latin2_run.len)
    text.textbuf_insert(mut tb, text.byteoff(0), x)
    text.textbuf_insert(mut tb, text.byteoff(3), y)
    assert(tb.graphemes.pending.len == 2, "two pending")
    assert(tb.graphemes.gen != tb.gen, "stale")
    cursor = text.cursor_at(text.byteoff(latin2_run.len + 2))
    cursor.goal_col = text.CCOL_EOL
    text.cursor_left(mut tb, mut cursor)
    assert(cursor.pos == 6, "left to 6")
    assert(text.cursor_goal(tb, cursor, 4) as int == 4, "goal 4")
    text.cursor_left(mut tb, mut cursor)
    assert(cursor.pos == 4, "left to 4")
    assert(text.cursor_goal(tb, cursor, 4) as int == 3, "goal 3")
    assert(tb.graphemes.gen == tb.gen, "replayed")
    text.textbuf_free(mut tb)
}

fn t_coords_deferred_index_keeps_line_local_motion_local() {
    let len = 15728640
    var bytes = filled(120, len)
    bytes[len - 101] = 10 as byte
    var tb = text.textbuf_from_owned_bytes_simple(take bytes, true)
    assert(tb.graphemes.initialized, "initialized")
    assert(tb.graphemes.simple_ascii_direct, "direct")
    text.textbuf_insert(mut tb, text.byteoff(0), list_of([204, 129]))
    assert(!tb.graphemes.initialized, "deferred")
    let line = line0(tb, 1)
    assert(line.lo == len - 98, "line 1")
    assert(text.off_to_gcol(mut tb, line, text.byteoff(line.lo + 40)) as int == 40, "gcol 40")
    assert(!tb.graphemes.initialized, "still deferred")
    assert(text.gcol_to_off(mut tb, line, 25 as text.GCol) as int == line.lo + 25, "off 25")
    assert(!tb.graphemes.initialized, "still deferred")
    text.textbuf_free(mut tb)
}

// The port's own (no C test): editing a buffer with a live grapheme index
// must not allocate a fresh copy of the index per edit. C rebuilds into a
// new array and frees the old; a wolf `List` replaced in a long-lived value
// is held until its region ends, so before `02806d4` 200 appends at the
// end of a 1 MiB buffer cost 134 MB, and an editor session would have
// grown without bound. The index now rebuilds into a spare pair.
fn t_port_coords_index_edits_reuse_storage() {
    var used = 0
    region probe {
        var bytes = List[byte]()
        var k = 0
        while k < 1048576 {
            (mut bytes).push((k * 29 + k % 251) as byte)
            k += 1
        }
        var tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
        let before = region_bytes(probe)
        var i = 0
        while i < 200 {
            text.textbuf_insert_str(mut tb, text.byteoff(text.textbuf_len(tb)), "x")
            i += 1
        }
        used = region_bytes(probe) - before
    }
    assert(used < 16 * 1048576, "200 appends to a 1 MiB buffer allocate under 16 MiB (used {used})")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_coords_motion_golden()
    t_coords_display_ordinal_is_one_based_without_overflow()
    t_coords_piece_stream()
    t_coords_tabs_wide_and_invalid()
    t_coords_crlf_and_clamping()
    t_coords_inside_cluster_rounds_left()
    t_coords_streams_large_cluster_width()
    t_coords_reverse_long_context_runs()
    t_coords_sparse_index_edit_invalidation()
    t_coords_deferred_index_keeps_line_local_motion_local()
    t_port_coords_index_edits_reuse_storage()
    print("coords_test: 10 cases pass, and the port's own 1")
}
