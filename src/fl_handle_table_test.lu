//! member: false
//! Scalar-slot witnesses for sagitta 9ace98c2 src/fl/handle.c:25-203.
//! The free/reuse and retirement cases derive from tests/unit/test_fl_handle.c:
//! 209-249 and 562-610. This is NOT the eight-case attached-editor suite:
//! object-death, mark-backed spans and regex ownership need its real host.

use fl

fn t_slot_free_and_reuse_all_kinds() {
    var table = fl.fl_h_table_new()
    var payload = fl.fl_h_payload_new()
    payload.buf = 4242
    payload.win = 4242
    for kind in 1..6 {
        let h = fl.fl_h_make(mut table, kind, payload)
        assert(fl.fl_h_is(h))
        assert(fl.fl_h_kind_of(h) == kind)
        assert(fl.fl_h_alive(table, h))
        let slot = fl.fl_h_slot(table, h) else { assert(false); return }
        assert(table.slots[slot].payload.buf == 4242)
        assert(fl.fl_h_slot_free(mut table, h))
        assert(!fl.fl_h_alive(table, h))
        assert(!fl.fl_h_slot_free(mut table, h))
        let reused = fl.fl_h_make(mut table, kind, payload)
        assert(fl.fl_h_decode(reused).slot == fl.fl_h_decode(h).slot)
        assert(fl.fl_h_alive(table, reused))
        assert(!fl.fl_h_alive(table, h))
        assert(fl.fl_h_decode(reused).gen == fl.fl_h_decode(h).gen + 1)
        assert(fl.fl_h_slot_free(mut table, reused))
    }
    assert(table.live == 0 && table.slots.len == 1)
}

fn t_generation_wraparound_retires_the_slot() {
    var table = fl.fl_h_table_new()
    let payload = fl.fl_h_payload_new()
    let initial = fl.fl_h_make(mut table, fl.FL_H_BUF, payload)
    let doomed = fl.fl_h_decode(initial).slot
    assert(fl.fl_h_slot_free(mut table, initial))
    table.slots[doomed].gen = 4294967295
    let h = fl.fl_h_make(mut table, fl.FL_H_BUF, payload)
    assert(fl.fl_h_decode(h).slot == doomed)
    assert(fl.fl_h_decode(h).gen == 4294967295)
    assert(h.i < 0)
    assert(fl.fl_h_slot_free(mut table, h))
    assert(!fl.fl_h_alive(table, h))
    assert(table.slots[doomed].gen == 0)
    assert(table.slots[doomed].next_free == 0)
    let next = fl.fl_h_make(mut table, fl.FL_H_BUF, payload)
    assert(fl.fl_h_decode(next).slot != doomed)
    assert(fl.fl_h_alive(table, next))
    assert(fl.fl_h_slot_free(mut table, next))
    assert(!fl.fl_h_alive(table, initial))
}

fn t_all_payload_bits_roundtrip() {
    for kind in 1..6 {
        for slot in [0, 1, 2147483647, 2147483648, 4294967295] {
            for gen in [1, 2147483647, 2147483648, 4294967295] {
                let h = fl.fl_h_encode(kind, slot, gen)
                let decoded = fl.fl_h_decode(h)
                assert(decoded.slot == slot)
                assert(decoded.gen == gen)
                assert(fl.fl_h_kind_of(h) == kind)
            }
        }
    }
}

fn t_wrong_tags_and_bounds_do_not_release() {
    var table = fl.fl_h_table_new()
    let h = fl.fl_h_make(mut table, fl.FL_H_BUF, fl.fl_h_payload_new())
    let decoded = fl.fl_h_decode(h)
    for kind in 2..6 {
        let wrong = fl.fl_h_encode(kind, decoded.slot, decoded.gen)
        assert(!fl.fl_h_alive(table, wrong))
        assert(!fl.fl_h_slot_free(mut table, wrong))
    }
    for slot in [1, 2147483648, 4294967295] {
        let wrong = fl.fl_h_encode(fl.FL_H_BUF, slot, decoded.gen)
        assert(!fl.fl_h_alive(table, wrong))
        assert(!fl.fl_h_slot_free(mut table, wrong))
    }
    assert(!fl.fl_h_alive(table, fl.fl_nil()))
    assert(!fl.fl_h_slot_free(mut table, fl.fl_int(h.i)))
    assert(table.live == 1 && table.free_head == 0)
    assert(fl.fl_h_alive(table, h))
}

fn t_free_list_is_lifo_and_reuses_storage() {
    var table = fl.fl_h_table_new()
    let payload = fl.fl_h_payload_new()
    let a = fl.fl_h_make(mut table, fl.FL_H_BUF, payload)
    let b = fl.fl_h_make(mut table, fl.FL_H_WIN, payload)
    let c = fl.fl_h_make(mut table, fl.FL_H_CUR, payload)
    assert(table.live == 3 && table.slots.len == 3)
    assert(fl.fl_h_slot_free(mut table, a))
    assert(fl.fl_h_slot_free(mut table, b))
    let rb = fl.fl_h_make(mut table, fl.FL_H_SPAN, payload)
    let ra = fl.fl_h_make(mut table, fl.FL_H_RE, payload)
    assert(fl.fl_h_decode(rb).slot == fl.fl_h_decode(b).slot)
    assert(fl.fl_h_decode(ra).slot == fl.fl_h_decode(a).slot)
    assert(fl.fl_h_alive(table, c))
    assert(fl.fl_h_slot_free(mut table, ra))
    for _ in 0..10000 {
        let v = fl.fl_h_make(mut table, fl.FL_H_RE, payload)
        assert(fl.fl_h_decode(v).slot == fl.fl_h_decode(a).slot)
        assert(fl.fl_h_slot_free(mut table, v))
    }
    assert(table.slots.len == 3 && table.live == 2)
}

fn main() {
    t_slot_free_and_reuse_all_kinds()
    t_generation_wraparound_retires_the_slot()
    t_all_payload_bits_roundtrip()
    t_wrong_tags_and_bounds_do_not_release()
    t_free_list_is_lifo_and_reuses_storage()
    print("Fletch handle scalar slots: 5 cases PASS (attached suite pending)")
}
