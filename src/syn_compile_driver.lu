//! member: false
//! Internal fixture driver for the definition compiler. This verifies
//! strict table compilation only, not the span-golden or editor gates.

use syn

fn main() -> int {
    let files = env_args()
    if files.len == 0 { eprint("syn-compile-driver: pass definition files"); return 1 }
    let out = fs_open_mode("/dev/stdout", 2) else { return 3 }
    defer fs_close(out) else {}
    var bad = 0
    for path in files {
        let bytes = fs_read_bytes(path) else {
            eprint("FAIL definition_read {path}")
            bad = 1
            continue
        }
        let result = syn.syn_compile(path, bytes)
        var rendered = List[byte]()
        var i = 0
        while i < result.diagnostics.entries.len {
            syn.syn_compile_diagnostic_render(mut rendered, result, i)
            i += 1
        }
        if rendered.len != 0 {
            // Diagnostics contain original source bytes; stdout is byte exact.
            fs_write_chunk(out, rendered) else { return 3 }
        }
        if !result.valid || result.diagnostics.nwarnings != 0 {
            print(
                "FAIL definition_compile {path} errors={result.diagnostics.nerrors} warnings={result.diagnostics.nwarnings}",
            )
            bad = 1
        } else {
            print(
                "PASS definition_compile {path} contexts={result.definition.contexts.len} rules={result.definition.rules.len}",
            )
        }
    }
    bad
}
