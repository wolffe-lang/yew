//! member: false
//!
//! The port of sagitta `tests/unit/test_tty.c`'s PURE cases (the raw-mode
//! flags, the restore blob, truecolor, the probe config, and the probe
//! state machine), one per C test, in registry order
//! (`tests/unit/registry.c:605-628`). The I/O cases (poison, resume
//! failure) land with the I/O surface. `now_ms` is a fake clock, as in C.
//!
//! A module that imports its siblings (`term` uses `unicode` and `util`)
//! cannot be tested from inside its own directory: `use` resolves to the
//! directories beside the ENTRY file (D32), so a `_test.lu` under
//! `src/term/` would look for `src/term/unicode/`. Its tests are therefore
//! `//! member: false` entries beside `src/yew.lu`, named
//! `src/<module>_<unit>_test.lu`, importing the module as a program does.

use term

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn feed(mut t: term.Tty, s: str) {
    let b = bytes_of(s)
    let _ = term.probe_feed(mut t, b, 0, b.len)
}

fn getv_of(m: Map[str, str]) -> term.Env {
    term.env_of(m)
}

fn t_tty_raw_flags() {
    let raw = term.rawios()
    assert(!raw.canonical, "raw: canonical off")
    assert(!raw.echo, "raw: echo off")
    assert(!raw.signals, "raw: signals off (Ctrl-C is a key, s03 §2)")
    assert(!raw.flow, "raw: flow off")
    assert(!raw.extended, "raw: extended off")
    assert(raw.min == 1, "raw: VMIN 1 (poll sleeps when idle, tty.c:535)")
    assert(raw.time == 0, "raw: VTIME 0")
}

fn t_tty_restore_blob() {
    let blob = term.restore_blob(false)
    assert(blob.starts_with("\x1b[<u\x1b[?2004l"), "restore: head")
    assert(blob.ends_with("\x1b[?1049l\x1b[?25h"), "restore: tail")
    assert(blob.contains("\x1b[0 q"), "restore: cursor-shape reset")
    assert(!blob.contains("\x1b[?1003l"), "restore: no 1003l without motion")
}

fn t_tty_mouse_motion_restore_blob() {
    let blob = term.restore_blob(true)
    assert(blob.contains("\x1b[?1003l"), "restore motion: 1003l present")
    assert(
        blob.contains("\x1b[?2004l\x1b[?1003l\x1b[?1002l"),
        "restore motion: 1003l between 2004l and 1002l",
    )
}

fn t_tty_truecolor() {
    var on = Map[str, str]()
    on["YEW_TRUECOLOR"] = "1"
    assert(term.detect_truecolor(getv_of(on)), "truecolor: forced on")

    var off = Map[str, str]()
    off["YEW_TRUECOLOR"] = "0"
    off["COLORTERM"] = "truecolor"
    assert(!term.detect_truecolor(getv_of(off)), "truecolor: forced off beats COLORTERM")

    var ct = Map[str, str]()
    ct["COLORTERM"] = "truecolor"
    assert(term.detect_truecolor(getv_of(ct)), "truecolor: COLORTERM truecolor")

    var ct2 = Map[str, str]()
    ct2["COLORTERM"] = "24bit"
    assert(term.detect_truecolor(getv_of(ct2)), "truecolor: COLORTERM 24bit")

    var direct = Map[str, str]()
    direct["TERM"] = "xterm-direct"
    assert(term.detect_truecolor(getv_of(direct)), "truecolor: TERM direct")

    var kitty = Map[str, str]()
    kitty["TERM"] = "xterm-kitty"
    assert(term.detect_truecolor(getv_of(kitty)), "truecolor: TERM prefix kitty")

    var prog = Map[str, str]()
    prog["TERM_PROGRAM"] = "iTerm.app"
    assert(term.detect_truecolor(getv_of(prog)), "truecolor: TERM_PROGRAM iTerm")

    var vte = Map[str, str]()
    vte["VTE_VERSION"] = "6003"
    assert(term.detect_truecolor(getv_of(vte)), "truecolor: VTE_VERSION >= 3600")

    var vteold = Map[str, str]()
    vteold["VTE_VERSION"] = "3400"
    assert(!term.detect_truecolor(getv_of(vteold)), "truecolor: VTE_VERSION < 3600 off")

    var kon = Map[str, str]()
    kon["KONSOLE_VERSION"] = "220400"
    assert(term.detect_truecolor(getv_of(kon)), "truecolor: KONSOLE_VERSION set")

    var none = Map[str, str]()
    none["TERM"] = "xterm-256color"
    assert(!term.detect_truecolor(getv_of(none)), "truecolor: plain 256color off")

    var empty = Map[str, str]()
    assert(!term.detect_truecolor(getv_of(empty)), "truecolor: nothing set off")
}

fn t_tty_probe_config() {
    var def = Map[str, str]()
    let c0 = term.probe_read_config(getv_of(def))
    assert(c0.enabled, "config: enabled by default")
    assert(c0.timeout_ms == 50, "config: default 50 ms")

    var disabled = Map[str, str]()
    disabled["YEW_TTY_PROBE"] = "0"
    let c1 = term.probe_read_config(getv_of(disabled))
    assert(!c1.enabled, "config: YEW_TTY_PROBE=0 disables")

    var slow = Map[str, str]()
    slow["YEW_PROBE_TIMEOUT_MS"] = "500"
    let c2 = term.probe_read_config(getv_of(slow))
    assert(c2.timeout_ms == 500, "config: override timeout")

    var bad = Map[str, str]()
    bad["YEW_PROBE_TIMEOUT_MS"] = "12x"
    let c3 = term.probe_read_config(getv_of(bad))
    assert(c3.timeout_ms == 50, "config: non-numeric timeout ignored")
}

fn enabled_config() -> term.ProbeConfig {
    term.ProbeConfig { enabled: true, timeout_ms: 50 }
}

fn t_tty_probe_modern() {
    var t = term.tty_new()
    term.probe_arm(mut t, 0, enabled_config(), true)
    feed(mut t, "\x1b[?0u")
    feed(mut t, "\x1b[?2026;2$y")
    feed(mut t, "\x1b[?62;22c")
    let caps = term.tty_caps(t)
    assert(caps.kitty_kbd, "modern: kitty negotiated")
    assert(caps.kitty_flags == 0, "modern: kitty flags 0")
    assert(caps.sync_output, "modern: sync output")
    assert(caps.da1_seen, "modern: DA1 fence seen")
    assert(caps.probed, "modern: probed")
    assert(term.probe_done(t), "modern: DONE after DA1")
    assert(term.tty_pending(t).len == 0, "modern: nothing stray in pending")
}

fn t_tty_probe_kitty_only() {
    var t = term.tty_new()
    term.probe_arm(mut t, 0, enabled_config(), false)
    feed(mut t, "\x1b[?5u")
    let caps = term.tty_caps(t)
    assert(caps.kitty_kbd && caps.kitty_flags == 5, "kitty-only: flags 5")
    assert(!caps.da1_seen, "kitty-only: no DA1 yet")
    assert(!term.probe_done(t), "kitty-only: still awaiting DA1")
}

fn t_tty_probe_sync_only() {
    var t = term.tty_new()
    term.probe_arm(mut t, 0, enabled_config(), false)
    feed(mut t, "\x1b[?2026;0$y")
    let caps = term.tty_caps(t)
    assert(!caps.sync_output, "sync-only: Ps 0 is unsupported")
    feed(mut t, "\x1b[?62;22c")
    assert(term.probe_done(t), "sync-only: DONE after DA1")
}

fn t_tty_probe_dumb_deadline() {
    var t = term.tty_new()
    term.probe_arm(mut t, 0, enabled_config(), false)
    assert(term.probe_deadline(t, 0) == 50, "dumb: 50 ms left at arm")
    term.probe_tick(mut t, 10)
    assert(!term.probe_done(t), "dumb: not done before the deadline")
    term.probe_tick(mut t, 50)
    assert(term.probe_done(t), "dumb: DONE at the deadline")
    let caps = term.tty_caps(t)
    assert(!caps.kitty_kbd && !caps.sync_output && !caps.da1_seen, "dumb: every capability off")
    assert(caps.probed, "dumb: probed via the deadline")
}

fn sync_support(reply: str) -> bool {
    var t = term.tty_new()
    term.probe_arm(mut t, 0, enabled_config(), false)
    feed(mut t, reply)
    term.tty_caps(t).sync_output
}

fn t_tty_probe_decrpm_states() {
    assert(!sync_support("\x1b[?2026;0$y"), "DECRPM 0 not recognized -> off")
    assert(sync_support("\x1b[?2026;1$y"), "DECRPM 1 set -> on")
    assert(sync_support("\x1b[?2026;2$y"), "DECRPM 2 reset -> on")
    assert(sync_support("\x1b[?2026;3$y"), "DECRPM 3 perm-set -> on")
    assert(!sync_support("\x1b[?2026;4$y"), "DECRPM 4 perm-reset -> off")
}

fn t_tty_probe_chunking() {
    let stream = "\x1b[?0u\x1b[?2026;2$y\x1b[?62;22c"
    let all = bytes_of(stream)
    var t = term.tty_new()
    term.probe_arm(mut t, 0, enabled_config(), false)
    var i = 0
    while i < all.len {
        var one = List[byte]()
        (mut one).push(all[i])
        let _ = term.probe_feed(mut t, one, 0, 1)
        i += 1
    }
    let caps = term.tty_caps(t)
    assert(
        caps.kitty_kbd && caps.sync_output && caps.da1_seen,
        "chunking: same caps one byte at a time",
    )
    assert(term.probe_done(t), "chunking: DONE")
    assert(term.tty_pending(t).len == 0, "chunking: pending empty")
}

fn t_tty_probe_pending_interleaved() {
    var t = term.tty_new()
    term.probe_arm(mut t, 0, enabled_config(), false)
    feed(mut t, "i")
    feed(mut t, "\x1b[?0u")
    feed(mut t, "hello")
    feed(mut t, "\x1b[?62;22c")
    let pending = term.tty_pending(t)
    let want = bytes_of("ihello")
    assert(pending.len == want.len, "interleaved: six bytes kept")
    var i = 0
    while i < want.len {
        assert(pending[i] == want[i], "interleaved: byte order preserved")
        i += 1
    }
    assert(term.tty_caps(t).kitty_kbd, "interleaved: kitty still negotiated")
}

fn t_tty_probe_ambiguous_prefix() {
    var t = term.tty_new()
    term.probe_arm(mut t, 0, enabled_config(), false)
    feed(mut t, "\x1b[Z")
    let pending = term.tty_pending(t)
    let want = bytes_of("\x1b[Z")
    assert(pending.len == want.len, "ambiguous: three bytes flushed")
    var i = 0
    while i < want.len {
        assert(pending[i] == want[i], "ambiguous: bytes in order")
        i += 1
    }
}

// Port-only (yw04): which wait a deadline gets at 0.2.33 (G2). None parks;
// one a tick or more away ticks (`VTIME=1`); one under a tick away — an
// ESC's 25 ms, the search count's 16 ms idle timer — waits finely, so it
// fires on time instead of at the next tick (`s21_search_word_under_cursor`
// measured ~211 ms against the harness's 60 ms settle on the tick alone).
fn t_port_tty_wait_kind() {
    assert(term.tty_wait_kind(-1) == term.WAIT_PARK, "no deadline parks")
    assert(term.tty_wait_kind(0) == term.WAIT_FINE, "a due deadline never blocks a tick")
    assert(term.tty_wait_kind(16) == term.WAIT_FINE, "16 ms waits finely")
    assert(term.tty_wait_kind(25) == term.WAIT_FINE, "the ESC deadline waits finely")
    assert(
        term.tty_wait_kind(term.TTY_TICK_MS - 1) == term.WAIT_FINE,
        "just under a tick waits finely",
    )
    assert(term.tty_wait_kind(term.TTY_TICK_MS) == term.WAIT_TICK, "a tick away ticks")
    assert(term.tty_wait_kind(3000) == term.WAIT_TICK, "a message expiry ticks")
}

fn main() {
    t_tty_raw_flags()
    t_tty_restore_blob()
    t_tty_mouse_motion_restore_blob()
    t_tty_truecolor()
    t_tty_probe_config()
    t_tty_probe_modern()
    t_tty_probe_kitty_only()
    t_tty_probe_sync_only()
    t_tty_probe_dumb_deadline()
    t_tty_probe_decrpm_states()
    t_tty_probe_chunking()
    t_tty_probe_pending_interleaved()
    t_tty_probe_ambiguous_prefix()
    t_port_tty_wait_kind()
    print("tty_test: 14 cases pass (13 C, 1 port-only)")
}
