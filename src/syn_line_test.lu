//! member: false
//! Ports sagitta tests/unit/test_syn_line.c at 9ace98c2, one case per C
//! test in its order. The toy is tests/unit/syn_toy.c's table, built as
//! data. A fast-path case pools one definition and runs it through an
//! engine with the path on and one with it off, as the C helpers do.

use fl
use search
use syn

const MAIN: int = 0

const STRING: int = 1

const COMMENT_BLOCK: int = 2

const COMMENT_LINE: int = 3

// The C helpers' comparisons, as bits for `compare_paths`.
const SAME_STOP: int = 1

const SAME_EXIT_ID: int = 2

const SAME_EXIT_STATE: int = 4

const COUNT_REFERENCE: int = 8

fn bytes(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() { (mut out).push(b) }
    out
}

fn append(mut out: List[byte], s: str) {
    for b in s.bytes() { (mut out).push(b) }
}

fn first_of(s: str) -> List[byte] {
    var first = syn.syn_first_new(false)
    for b in s.bytes() { syn.syn_first_add(mut first, b as int) }
    first
}

fn compile_re(pattern: List[byte], flags: int) -> search.Re {
    var err = search.re_err_new()
    let re = search.re_compile(pattern, flags, mut err) else {
        assert(false, "test regex: {err.msg}")
        return search.re_empty()
    }
    re
}

// syn_toy.c rule_init + add_first: the rule's and the context's masks.
fn toy_rule(mut def: syn.SynDefinition, ctx: int, pattern: str, attr: int, op: int, target: int, firsts: str) {
    var r = syn.syn_rule_new(def.regexes.len, attr)
    r.op = op
    r.target = target
    r.first = first_of(firsts)
    syn.syn_first_union(mut def.contexts[ctx].first, r.first)
    (mut def.regexes).push(compile_re(bytes(pattern), 0))
    (mut def.rules).push(r)
    (mut def.patterns).push(bytes(pattern))
}

fn toy() -> syn.SynDefinition {
    var def = syn.syn_definition_new("toy")
    var main = syn.syn_context_new(0)
    main.nrules = 7
    var string = syn.syn_context_new(12)
    string.first_rule = 7
    string.nrules = 2
    string.eol_op = syn.SYN_OP_POP
    string.eol_nop = 1
    var block = syn.syn_context_new(16)
    block.first_rule = 9
    block.nrules = 1
    var comment = syn.syn_context_new(16)
    comment.first_rule = 10
    comment.eol_op = syn.SYN_OP_POP
    comment.eol_nop = 1
    (mut def.contexts).push(main)
    (mut def.contexts).push(string)
    (mut def.contexts).push(block)
    (mut def.contexts).push(comment)
    for name in "main string comment_block comment_line".words() {
        (mut def.context_names).push(bytes(name))
    }
    toy_rule(mut def, MAIN, "//", 16, syn.SYN_OP_PUSH, COMMENT_LINE, "/")
    toy_rule(mut def, MAIN, "/\\*", 16, syn.SYN_OP_PUSH, COMMENT_BLOCK, "/")
    toy_rule(mut def, MAIN, "\"", 12, syn.SYN_OP_PUSH, STRING, "\"")
    toy_rule(mut def, MAIN, "\\b(if|else|while|return)\\b", 2, syn.SYN_OP_STAY, 0, "iewr")
    toy_rule(mut def, MAIN, "[0-9]+", 9, syn.SYN_OP_STAY, 0, "0123456789")
    toy_rule(mut def, MAIN, "\\b(true|false)\\b", 10, syn.SYN_OP_STAY, 0, "tf")
    toy_rule(mut def, MAIN, "[+*/=-]+", 31, syn.SYN_OP_STAY, 0, "+*/=-")
    toy_rule(mut def, STRING, "\\\\.", 13, syn.SYN_OP_STAY, 0, "\\")
    toy_rule(mut def, STRING, "\"", 12, syn.SYN_OP_POP, 0, "\"")
    def.rules[8].nop = 1
    toy_rule(mut def, COMMENT_BLOCK, "\\*/", 16, syn.SYN_OP_POP, 0, "*")
    def.rules[9].nop = 1
    def
}

// syn_toy_state: MAIN, or MAIN with one context above it.
fn toy_state(mut engine: syn.SynEngine, ctx: int) -> int {
    var state = syn.syn_state_root(MAIN, 0)
    if ctx != MAIN then syn.syn_state_push(mut state, ctx)
    syn.syn_state_intern(mut engine.states, state)
}

fn attr_at(out: syn.SynSpans, off: int) -> int {
    for i in 0..out.n {
        let lo = syn.syn_span_start(out, i)
        if off >= lo && off < lo + syn.syn_span_len(out, i) then return syn.syn_span_attr(out, i)
    }
    255
}

fn assert_spans_well_formed(out: syn.SynSpans, len: int) {
    var end = 0
    for i in 0..out.n {
        let lo = syn.syn_span_start(out, i)
        assert(syn.syn_span_len(out, i) > 0, "span is non-empty")
        assert(lo >= end, "spans are ordered")
        assert(lo + syn.syn_span_len(out, i) <= len, "span inside the line")
        assert(syn.syn_span_attr(out, i) < syn.SYN_ATTR_COUNT, "span attr is a semantic id")
        end = lo + syn.syn_span_len(out, i)
    }
}

fn exit_state(engine: syn.SynEngine, id: int) -> syn.SynState {
    let state = syn.syn_state_get(engine.states, id) else {
        assert(false, "exit state exists")
        return syn.syn_state_root(0, 0)
    }
    state
}

fn top_ctx(state: syn.SynState) -> int {
    syn.syn_state_ctx(state, syn.syn_state_depth(state) - 1)
}

fn repeated(b: int, len: int) -> List[byte] {
    var line = List[byte]()
    for _ in 0..len { (mut line).push(b as byte) }
    line
}

struct LineRow { entry: int, line: str, probe: int, attr: int, exit: int }

fn row(entry: int, line: str, probe: int, attr: int, exit: int) -> LineRow {
    LineRow { entry: entry, line: line, probe: probe, attr: attr, exit: exit }
}

// test_syn_line_toy_golden_table
fn toy_golden_table() {
    var rows = List[LineRow]()
    (mut rows).push(row(0, "alpha", 0, 0, 0))
    (mut rows).push(row(0, "if", 0, 2, 0))
    (mut rows).push(row(0, "else", 1, 2, 0))
    (mut rows).push(row(0, "while", 2, 2, 0))
    (mut rows).push(row(0, "return", 5, 2, 0))
    (mut rows).push(row(0, "ifx", 0, 0, 0))
    (mut rows).push(row(0, "xif", 1, 0, 0))
    (mut rows).push(row(0, "0", 0, 9, 0))
    (mut rows).push(row(0, "123456", 3, 9, 0))
    (mut rows).push(row(0, "x9", 1, 9, 0))
    (mut rows).push(row(0, "true", 0, 10, 0))
    (mut rows).push(row(0, "false", 4, 10, 0))
    (mut rows).push(row(0, "truth", 0, 0, 0))
    (mut rows).push(row(0, "+", 0, 31, 0))
    (mut rows).push(row(0, "=-", 1, 31, 0))
    (mut rows).push(row(0, "x+y", 1, 31, 0))
    (mut rows).push(row(0, "\"abc\"", 0, 12, 0))
    (mut rows).push(row(0, "\"abc\"", 3, 12, 0))
    (mut rows).push(row(0, "\"a\\nb\"", 2, 13, 0))
    (mut rows).push(row(0, "\"unterminated", 5, 12, 0))
    (mut rows).push(row(1, "body", 0, 12, 0))
    (mut rows).push(row(1, "\\t", 0, 13, 0))
    (mut rows).push(row(1, "end\"", 3, 12, 0))
    (mut rows).push(row(0, "// comment", 0, 16, 0))
    (mut rows).push(row(0, "// comment", 8, 16, 0))
    (mut rows).push(row(3, "carried line", 2, 16, 0))
    (mut rows).push(row(0, "/* open", 0, 16, 2))
    (mut rows).push(row(0, "/* open", 5, 16, 2))
    (mut rows).push(row(2, "body", 2, 16, 2))
    (mut rows).push(row(2, "close */", 6, 16, 0))
    (mut rows).push(row(2, "*/ tail", 3, 0, 0))
    (mut rows).push(row(0, "x /* c", 2, 16, 2))
    (mut rows).push(row(0, "if 42", 0, 2, 0))
    (mut rows).push(row(0, "if 42", 3, 9, 0))
    (mut rows).push(row(0, "true+1", 4, 31, 0))
    (mut rows).push(row(0, "true+1", 5, 9, 0))
    (mut rows).push(row(0, "a//b", 1, 16, 0))
    (mut rows).push(row(0, "a\"b\"c", 2, 12, 0))
    (mut rows).push(row(0, "99/*x", 0, 9, 2))
    (mut rows).push(row(0, "99/*x", 3, 16, 2))
    (mut rows).push(row(0, "return false", 7, 10, 0))
    (mut rows).push(row(0, "while=0", 5, 31, 0))
    assert(rows.len >= 40, "the golden table has at least forty rows")
    var pool = syn.syn_pool_new()
    let root = syn.syn_pool_add(mut pool, take toy(), 1)
    var engine = syn.syn_engine_new(pool, root)
    var out = syn.syn_spans_new(64)
    for i in 0..rows.len {
        let entry = if rows[i].entry == 0 then syn.SYN_STATE_ROOT else toy_state(mut engine, rows[i].entry)
        let line = bytes(rows[i].line)
        syn.syn_line(mut engine, mut pool, entry, line, line.len, mut out, false)
        let exit = exit_state(engine, out.exit_state)
        if top_ctx(exit) != rows[i].exit {
            eprint("toy row {i} ({rows[i].line}): exit ctx {top_ctx(exit)}, want {rows[i].exit}")
        }
        assert(out.stop == syn.SYN_STOP_OK, "row stops normally")
        assert(top_ctx(exit) == rows[i].exit, "row exit context")
        assert(attr_at(out, rows[i].probe) == rows[i].attr, "row probe attribute")
        assert_spans_well_formed(out, line.len)
    }
}

// test_syn_line_byte_cap_preserves_entry_state
fn byte_cap_preserves_entry_state() {
    let len = syn.SYN_LINE_BYTE_CAP + 1
    let line = repeated(120, len)
    var def = toy()
    def.rules[0].flags = def.rules[0].flags | syn.SYN_RULE_FIRST_LINE
    var pool = syn.syn_pool_new()
    let root = syn.syn_pool_add(mut pool, take def, 1)
    var engine = syn.syn_engine_new(pool, root)
    var out = syn.syn_spans_new(8)
    syn.syn_line(mut engine, mut pool, syn.SYN_STATE_ROOT, line, len, mut out, false)
    assert(out.exit_state != syn.SYN_STATE_ROOT, "the first physical line is consumed")
    let cached = out.exit_state
    syn.syn_line(mut engine, mut pool, syn.SYN_STATE_ROOT, line, len, mut out, false)
    assert(out.exit_state == cached, "the same capped line reuses its exit id")
    let entry = toy_state(mut engine, COMMENT_BLOCK)
    syn.syn_line(mut engine, mut pool, entry, line, len, mut out, false)
    assert(out.stop == syn.SYN_STOP_BYTES, "byte cap reported")
    let exit = exit_state(engine, out.exit_state)
    assert(top_ctx(exit) == COMMENT_BLOCK, "the entry context survives the cap")
    assert(syn.syn_state_flags(exit) & syn.SYN_F_PAST_FIRST != 0, "past the first line")
    assert_spans_well_formed(out, len)
}

// test_syn_line_byte_cap_reuses_unchanged_state_id
fn byte_cap_reuses_unchanged_state_id() {
    let len = syn.SYN_LINE_BYTE_CAP + 1
    let line = repeated(120, len)
    var pool = syn.syn_pool_new()
    let root = syn.syn_pool_add(mut pool, take toy(), 1)
    var engine = syn.syn_engine_new(pool, root)
    var out = syn.syn_spans_new(8)
    let entry = toy_state(mut engine, COMMENT_BLOCK)
    syn.syn_line(mut engine, mut pool, entry, line, len, mut out, false)
    assert(out.stop == syn.SYN_STOP_BYTES, "byte cap reported")
    assert(out.exit_state == entry, "an unchanged capped state keeps its id")
    assert_spans_well_formed(out, len)
}

// test_syn_line_span_cap_stops_without_overwriting_caller_storage
fn span_cap_stops_without_overwriting_caller_storage() {
    var pool = syn.syn_pool_new()
    let root = syn.syn_pool_add(mut pool, take toy(), 1)
    var engine = syn.syn_engine_new(pool, root)
    // Storage for two spans under a cap of one; the second is a sentinel.
    var out = syn.syn_spans_new(2)
    out.cap = 1
    for i in 8..16 { out.data[i] = 255 as byte }
    let line = bytes("if 1 true")
    syn.syn_line(mut engine, mut pool, syn.SYN_STATE_ROOT, line, line.len, mut out, false)
    assert(out.stop == syn.SYN_STOP_SPANS, "span cap reported")
    assert(out.n <= 1, "no span past the cap")
    for i in 8..16 { assert(out.data[i] as int == 255, "the sentinel span is untouched") }
}

// test_syn_line_zero_width_rule_forces_utf8_progress
fn zero_width_rule_forces_utf8_progress() {
    var def = toy()
    def.regexes[def.rules[0].regex] = compile_re(bytes("a*"), 0)
    def.rules[0].first = first_of("b")
    syn.syn_first_add(mut def.contexts[MAIN].first, 98)
    var pool = syn.syn_pool_new()
    let root = syn.syn_pool_add(mut pool, take def, 1)
    var engine = syn.syn_engine_new(pool, root)
    var out = syn.syn_spans_new(16)
    syn.syn_line(mut engine, mut pool, syn.SYN_STATE_ROOT, bytes("bbb"), 3, mut out, false)
    assert(out.stop == syn.SYN_STOP_OK, "no cap")
    assert(out.exit_state == syn.SYN_STATE_ROOT, "returns to ROOT")
    assert(out.n > 0, "the line is styled")
    assert_spans_well_formed(out, 3)
}

// A one-context definition of `count` rules sharing one regex, as the C
// cases share one compiled pattern.
fn many_rules(name: str, count: int, pattern: str, attr: int, rule_first: List[byte], ctx_first: List[byte]) -> syn.SynDefinition {
    var def = syn.syn_definition_new(name)
    var ctx = syn.syn_context_new(0)
    ctx.nrules = count
    ctx.first = copy ctx_first
    (mut def.contexts).push(ctx)
    (mut def.context_names).push(bytes("main"))
    (mut def.regexes).push(compile_re(bytes(pattern), 0))
    for _ in 0..count {
        var r = syn.syn_rule_new(1, attr)
        r.first = copy rule_first
        (mut def.rules).push(r)
        (mut def.patterns).push(bytes(pattern))
    }
    def
}

// test_syn_line_step_cap_degrades_instead_of_stalling
fn step_cap_degrades_instead_of_stalling() {
    var def = many_rules("steps", 4200, "^xy", 0, first_of("x"), first_of("x"))
    def.rules[0].flags = def.rules[0].flags | syn.SYN_RULE_FIRST_LINE
    var pool = syn.syn_pool_new()
    let root = syn.syn_pool_add(mut pool, take def, 1)
    var engine = syn.syn_engine_new(pool, root)
    var out = syn.syn_spans_new(8)
    syn.syn_line(mut engine, mut pool, syn.SYN_STATE_ROOT, bytes("x"), 1, mut out, false)
    assert(out.stop == syn.SYN_STOP_STEPS, "attempt cap reported")
    let exit = exit_state(engine, out.exit_state)
    assert(syn.syn_state_ctx(exit, 0) == 0, "root context kept")
    assert(syn.syn_state_flags(exit) & syn.SYN_F_PAST_FIRST != 0, "first line consumed")
}

// test_syn_line_empty_candidate_set_does_not_scan_declared_first
fn empty_candidate_set_does_not_scan_declared_first() {
    let def = many_rules("empty-candidates", 4200, "z", 0, first_of("x"), first_of("x"))
    var pool = syn.syn_pool_new()
    let root = syn.syn_pool_add(mut pool, take def, 1)
    var engine = syn.syn_engine_new(pool, root)
    var out = syn.syn_spans_new(8)
    syn.syn_line(mut engine, mut pool, syn.SYN_STATE_ROOT, bytes("x"), 1, mut out, false)
    assert(out.stop == syn.SYN_STOP_OK, "no rule is a candidate, so no attempt is spent")
    assert(out.n == 1, "one span")
    assert(syn.syn_span_attr(out, 0) == 0, "plain text")
}

// test_syn_line_large_candidate_index_falls_back_without_semantic_change
fn large_candidate_index_falls_back_without_semantic_change() {
    let def = many_rules("candidate-cap", 9000, ".", 1, syn.syn_first_new(true), syn.syn_first_new(true))
    var pool = syn.syn_pool_new()
    let root = syn.syn_pool_add(mut pool, take def, 1)
    var engine = syn.syn_engine_new(pool, root)
    var out = syn.syn_spans_new(8)
    syn.syn_line(mut engine, mut pool, syn.SYN_STATE_ROOT, bytes("x"), 1, mut out, false)
    assert(out.stop == syn.SYN_STOP_OK, "the first rule matches")
    assert(out.n == 1, "one span")
    assert(syn.syn_span_attr(out, 0) == 1, "keyword")
}

fn one_context(name: str, nrules: int, firsts: List[byte]) -> syn.SynDefinition {
    var def = syn.syn_definition_new(name)
    var ctx = syn.syn_context_new(0)
    ctx.nrules = nrules
    ctx.first = copy firsts
    (mut def.contexts).push(ctx)
    (mut def.context_names).push(bytes("main"))
    def
}

fn plain_rule(mut def: syn.SynDefinition, pattern: List[byte], flags: int, attr: int, firsts: List[byte]) -> int {
    var r = syn.syn_rule_new(def.regexes.len, attr)
    r.first = copy firsts
    (mut def.regexes).push(compile_re(pattern, flags))
    (mut def.rules).push(r)
    (mut def.patterns).push(copy pattern)
    def.rules.len - 1
}

fn level_aux(state: syn.SynState) -> int {
    syn.syn_state_aux(state, syn.syn_state_ndef(state) - 1)
}

// test_syn_line_consume_stops_emission_and_optional_aux_is_safe
fn consume_stops_emission_and_optional_aux_is_safe() {
    var def = one_context("edge", 2, first_of("ac"))
    let r0 = plain_rule(mut def, bytes("(ab)c"), 0, 0, first_of("a"))
    def.rules[r0].consume = 1
    def.rules[r0].caps[0] = 1 as byte
    let _ = plain_rule(mut def, bytes("c"), 0, 31, first_of("c"))
    var pool = syn.syn_pool_new()
    var root = syn.syn_pool_add(mut pool, take def, 1)
    var engine = syn.syn_engine_new(pool, root)
    var out = syn.syn_spans_new(8)
    syn.syn_line(mut engine, mut pool, syn.SYN_STATE_ROOT, bytes("abc"), 3, mut out, false)
    assert(attr_at(out, 0) == 1, "the consumed group keeps the whole-match attribute")
    assert(attr_at(out, 1) == 1, "the consumed group keeps the whole-match attribute")
    assert(attr_at(out, 2) == 31, "the unconsumed byte is matched again")

    def = one_context("edge", 1, first_of("b"))
    let r1 = plain_rule(mut def, bytes("(a)?b"), 0, 0, first_of("b"))
    def.rules[r1].flags = syn.SYN_RULE_SET_AUX | syn.SYN_RULE_STRIP
    def.rules[r1].aux_group = 1
    pool = syn.syn_pool_new()
    root = syn.syn_pool_add(mut pool, take def, 1)
    engine = syn.syn_engine_new(pool, root)
    var state = syn.syn_state_root(0, 0)
    syn.syn_state_set_aux(mut state, 0, fl.fl_intern(mut pool.aux[root], bytes("old"), 0, 3))
    let entry = syn.syn_state_intern(mut engine.states, state)
    syn.syn_line(mut engine, mut pool, entry, bytes("b"), 1, mut out, false)
    var exit = exit_state(engine, out.exit_state)
    assert(level_aux(exit) == level_aux(state), "a missing optional aux group keeps the old value")
    assert(syn.syn_state_flags(exit) & syn.SYN_F_STRIP == 0, "strip needs a set aux")

    def = one_context("edge", 1, first_of(" "))
    let r2 = plain_rule(mut def, bytes("( +)([1-9]?)I"), 0, 0, first_of(" "))
    def.rules[r2].flags = syn.SYN_RULE_SET_AUX | syn.SYN_RULE_AUX_INT
    def.rules[r2].aux_group = 1
    def.rules[r2].aux_add = 1
    def.rules[r2].aux_add_group = 2
    pool = syn.syn_pool_new()
    root = syn.syn_pool_add(mut pool, copy def, 1)
    engine = syn.syn_engine_new(pool, root)
    syn.syn_line(mut engine, mut pool, syn.SYN_STATE_ROOT, bytes("  I"), 3, mut out, false)
    exit = exit_state(engine, out.exit_state)
    assert(level_aux(exit) == 3, "integer aux adds the default")
    syn.syn_line(mut engine, mut pool, syn.SYN_STATE_ROOT, bytes("  7I"), 4, mut out, false)
    exit = exit_state(engine, out.exit_state)
    assert(level_aux(exit) == 9, "integer aux adds the captured digit")

    // The same rule loses its regex and becomes a line-equality closer.
    def.rules[r2].regex = 0
    def.rules[r2].flags = 0
    def.rules[r2].aux_match = syn.SYN_AUXM_LINE_EQ
    def.contexts[0].first[0] = 0 as byte
    pool = syn.syn_pool_new()
    root = syn.syn_pool_add(mut pool, take def, 1)
    engine = syn.syn_engine_new(pool, root)
    syn.syn_state_set_aux(mut state, 0, fl.fl_intern(mut pool.aux[root], List[byte](), 0, 0))
    let empty_entry = syn.syn_state_intern(mut engine.states, state)
    syn.syn_line(mut engine, mut pool, empty_entry, List[byte](), 0, mut out, false)
    assert(out.stop == syn.SYN_STOP_OK, "an empty line against an empty delimiter is safe")
}

// test_syn_line_push_list_eol_target_and_clear_aux_pop_laws
fn push_list_eol_target_and_clear_aux_pop_laws() {
    var def = one_context("transitions", 1, first_of("x"))
    (mut def.contexts).push(syn.syn_context_new(0))
    (mut def.contexts).push(syn.syn_context_new(0))
    (mut def.context_names).push(bytes("one"))
    (mut def.context_names).push(bytes("two"))
    let r = plain_rule(mut def, bytes("x"), 0, 0, first_of("x"))
    def.rules[r].op = syn.SYN_OP_PUSH
    (mut def.rules[r].pushes).push(1)
    (mut def.rules[r].pushes).push(2)
    var pool = syn.syn_pool_new()
    var root = syn.syn_pool_add(mut pool, copy def, 1)
    var engine = syn.syn_engine_new(pool, root)
    var out = syn.syn_spans_new(8)
    syn.syn_line(mut engine, mut pool, syn.SYN_STATE_ROOT, bytes("x"), 1, mut out, false)
    var exit = exit_state(engine, out.exit_state)
    assert(syn.syn_state_depth(exit) == 3, "both contexts pushed")
    assert(syn.syn_state_ctx(exit, 1) == 1, "push list order")
    assert(syn.syn_state_ctx(exit, 2) == 2, "push list order")

    def.rules[r].op = syn.SYN_OP_POP
    def.rules[r].pushes = List[int]()
    def.rules[r].nop = 1
    def.rules[r].flags = syn.SYN_RULE_CLR_AUX
    pool = syn.syn_pool_new()
    root = syn.syn_pool_add(mut pool, copy def, 1)
    engine = syn.syn_engine_new(pool, root)
    var state = syn.syn_state_root(0, 0)
    syn.syn_state_set_frame(mut state, 1, 0, 0, 0)
    syn.syn_state_set_depths(mut state, 2, 1)
    syn.syn_state_set_aux(mut state, 0, 77)
    syn.syn_state_set_flags(mut state, syn.SYN_F_STRIP)
    var entry = syn.syn_state_intern(mut engine.states, state)
    syn.syn_line(mut engine, mut pool, entry, bytes("x"), 1, mut out, false)
    exit = exit_state(engine, out.exit_state)
    assert(syn.syn_state_depth(exit) == 1, "pop")
    assert(level_aux(exit) == 0, "clear_aux clears")
    assert(syn.syn_state_flags(exit) & syn.SYN_F_STRIP == 0, "clear_aux clears strip")

    syn.syn_state_set_lost(mut state, 1)
    entry = syn.syn_state_intern(mut engine.states, state)
    syn.syn_line(mut engine, mut pool, entry, bytes("x"), 1, mut out, false)
    exit = exit_state(engine, out.exit_state)
    assert(syn.syn_state_depth(exit) == 2, "a pop first pays lost debt")
    assert(syn.syn_state_lost(exit) == 0, "debt paid")
    assert(level_aux(exit) == 77, "aux kept while paying debt")
    assert(syn.syn_state_flags(exit) & syn.SYN_F_STRIP != 0, "strip kept while paying debt")

    // memset(&rule, 0): no regex, no mask, zero capture attributes.
    var zero = syn.syn_rule_new(0, 0)
    zero.first = syn.syn_first_new(false)
    for i in 0..zero.caps.len { zero.caps[i] = 0 as byte }
    def.rules[r] = zero
    def.contexts[0].eol_op = syn.SYN_OP_SET
    def.contexts[0].eol_target = 2
    pool = syn.syn_pool_new()
    root = syn.syn_pool_add(mut pool, take def, 1)
    engine = syn.syn_engine_new(pool, root)
    syn.syn_line(mut engine, mut pool, syn.SYN_STATE_ROOT, List[byte](), 0, mut out, false)
    exit = exit_state(engine, out.exit_state)
    assert(syn.syn_state_ctx(exit, 0) == 2, "an EOL set replaces the root frame")
}

fn spans_equal(a: syn.SynSpans, b: syn.SynSpans) -> bool {
    if a.n != b.n then return false
    for i in 0..a.n * 8 {
        if a.data[i] != b.data[i] then return false
    }
    true
}

fn states_equal(a: syn.SynEngine, a_id: int, b: syn.SynEngine, b_id: int) -> bool {
    let x = exit_state(a, a_id)
    let y = exit_state(b, b_id)
    for i in 0..syn.SYN_STATE_BYTES {
        if x.tuple[i] != y.tuple[i] then return false
    }
    true
}

fn fast_rules(engine: syn.SynEngine, pool: syn.SynPool, toggle: int) -> int {
    if toggle == syn.SYN_FAST_IDENTIFIER then return syn.syn_engine_identifier_fast_rules(engine, pool)
    if toggle == syn.SYN_FAST_WORD_LITERAL then return syn.syn_engine_word_literal_fast_rules(engine, pool)
    if toggle == syn.SYN_FAST_FINITE_LITERAL then return syn.syn_engine_finite_literal_fast_rules(engine, pool)
    if toggle == syn.SYN_FAST_JSON_KEY then return syn.syn_engine_json_key_fast_rules(engine, pool)
    syn.syn_engine_yaml_block_key_fast_rules(engine, pool)
}

fn fast_off(mut engine: syn.SynEngine, toggle: int) {
    if toggle == syn.SYN_FAST_IDENTIFIER {
        syn.syn_engine_set_identifier_fast_path(mut engine, false)
    } else if toggle == syn.SYN_FAST_WORD_LITERAL {
        syn.syn_engine_set_word_literal_fast_path(mut engine, false)
    } else if toggle == syn.SYN_FAST_FINITE_LITERAL {
        syn.syn_engine_set_finite_literal_fast_path(mut engine, false)
    } else if toggle == syn.SYN_FAST_JSON_KEY {
        syn.syn_engine_set_json_key_fast_path(mut engine, false)
    } else {
        syn.syn_engine_set_yaml_block_key_fast_path(mut engine, false)
    }
}

// The C assert_*_fast_path_equal shape: pool the definition, build a fast
// and a reference engine, check the indexed-rule count, turn `toggle` off
// in the reference, run both on `line` and compare what `checks` names.
// Answers the fast engine's spans.
fn compare_paths(
    take def: syn.SynDefinition,
    toggle: int,
    indexed: int,
    capacity: int,
    line: List[byte],
    checks: int,
) -> syn.SynSpans {
    var pool = syn.syn_pool_new()
    let root = syn.syn_pool_add(mut pool, take def, 1)
    var fast = syn.syn_engine_new(pool, root)
    var reference = syn.syn_engine_new(pool, root)
    assert(fast_rules(fast, pool, toggle) == indexed, "indexed fast-path rules")
    if checks & COUNT_REFERENCE != 0 {
        assert(fast_rules(reference, pool, toggle) == indexed, "indexed fast-path rules")
    }
    fast_off(mut reference, toggle)
    var fast_out = syn.syn_spans_new(capacity)
    var reference_out = syn.syn_spans_new(capacity)
    syn.syn_line(mut fast, mut pool, syn.SYN_STATE_ROOT, line, line.len, mut fast_out, false)
    syn.syn_line(mut reference, mut pool, syn.SYN_STATE_ROOT, line, line.len, mut reference_out, false)
    if checks & SAME_STOP != 0 {
        assert(fast_out.stop == reference_out.stop, "fast path stop equals the VM's")
    }
    if checks & SAME_EXIT_ID != 0 {
        assert(fast_out.exit_state == reference_out.exit_state, "fast path exit id equals the VM's")
    }
    assert(spans_equal(fast_out, reference_out), "fast path spans equal the VM's")
    if checks & SAME_EXIT_STATE != 0 {
        assert(
            states_equal(fast, fast_out.exit_state, reference, reference_out.exit_state),
            "fast path exit state equals the VM's",
        )
    }
    fast_out
}

fn with_byte(prefix: str, b: int, suffix: str) -> List[byte] {
    var out = bytes(prefix)
    (mut out).push(b as byte)
    append(mut out, suffix)
    out
}

// A `SynRule rule = {0}` given a regex: no first-byte mask of its own.
fn bare_rule(mut def: syn.SynDefinition, pattern: List[byte], flags: int, attr: int) -> int {
    plain_rule(mut def, pattern, flags, attr, syn.syn_first_new(false))
}

fn assert_identifier_fast_path_equal(pattern: str, line: List[byte]) {
    var def = one_context("identifier-fast", 1, syn.syn_first_new(true))
    (mut def.contexts).push(syn.syn_context_new(16))
    (mut def.context_names).push(bytes("after"))
    let r = bare_rule(mut def, bytes(pattern), 0, 0)
    def.rules[r].op = syn.SYN_OP_SET
    def.rules[r].target = 1
    def.rules[r].consume = 1
    def.rules[r].caps[1] = 19 as byte
    let _ = compare_paths(take def, syn.SYN_FAST_IDENTIFIER, 1, 32, line, SAME_STOP | SAME_EXIT_STATE | COUNT_REFERENCE)
}

// test_syn_line_identifier_suffix_fast_path_matches_regex
fn identifier_suffix_fast_path_matches_regex() {
    var rows = List[List[byte]]()
    for s in ["function(", "_member42   :", "prefix\t(", "9prefix(", "plain", "prefix x(", "naïve(", "name\u{a0}("] {
        (mut rows).push(bytes(s))
    }
    (mut rows).push(with_byte("bad", 255, "("))
    for pattern in ["([A-Za-z_][A-Za-z0-9_]*)\\s*\\(", "([A-Za-z_][A-Za-z0-9_]*)\\s*:"] {
        for i in 0..rows.len { assert_identifier_fast_path_equal(pattern, rows[i]) }
    }
}

fn assert_ascii_identifier_fast_path_equal(pattern: str, line: List[byte]) {
    var def = one_context("ascii-identifier-fast", 1, syn.syn_first_new(true))
    let _ = bare_rule(mut def, bytes(pattern), 0, 23)
    let _ = compare_paths(take def, syn.SYN_FAST_IDENTIFIER, 1, 16, line, SAME_STOP | SAME_EXIT_ID | COUNT_REFERENCE)
}

fn assert_yaml_block_key_fast_path_equal(pattern: str, line: List[byte], indexed: int) {
    var def = one_context("yaml-block-key-fast", 1, syn.syn_first_new(true))
    let r = bare_rule(mut def, bytes(pattern), 0, 0)
    def.rules[r].consume = 3
    def.rules[r].caps[2] = 26 as byte
    def.rules[r].caps[3] = 34 as byte
    let _ = compare_paths(take def, syn.SYN_FAST_YAML_BLOCK_KEY, indexed, 16, line, SAME_STOP | SAME_EXIT_ID | COUNT_REFERENCE)
}

fn assert_yaml_block_key_fast_path_matrix() {
    let yaml_key = "^(\\s*)([^\\s#][^:#]*)(:)(\\s|$)"
    var rows = List[List[byte]]()
    for s in [
        "key: value",
        "           flow: [a, {{b: [c, {{d: e}}]}}]",
        "key:",
        " key:\tvalue",
        " key : value",
        "key#bad: value",
        " #comment",
        " : value",
        "key:value",
        "naïve: value",
        "\u{a0}key: value",
    ] {
        (mut rows).push(bytes(s))
    }
    (mut rows).push(with_byte("bad", 255, ": x"))
    for i in 0..rows.len { assert_yaml_block_key_fast_path_equal(yaml_key, rows[i], 1) }
    assert_yaml_block_key_fast_path_equal("^(\\s*)([^\\s#][^:#]*)(:)(\\s*)", bytes("key:value"), 0)

    var def = one_context("yaml", 2, syn.syn_first_new(true))
    let _ = bare_rule(mut def, bytes("^key: value$"), 0, 46)
    let r1 = bare_rule(mut def, bytes(yaml_key), 0, 0)
    def.rules[r1].consume = 3
    def.rules[r1].caps[2] = 26 as byte
    def.rules[r1].caps[3] = 34 as byte
    let out = compare_paths(take def, syn.SYN_FAST_YAML_BLOCK_KEY, 1, 8, bytes("key: value"), 0)
    assert(attr_at(out, 0) == 46, "an earlier rule still wins")
}

// test_syn_line_ascii_identifier_fast_path_matches_regex
fn ascii_identifier_fast_path_matches_regex() {
    let patterns = [
        "\\b[A-Z][A-Z0-9_]*\\b",
        "\\b[A-Z][A-Za-z0-9]*\\b",
        "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
        "\\b[A-Za-z_][A-Za-z0-9_]*_t\\b",
        "'[A-Za-z_][A-Za-z0-9_]*",
        "r#[A-Za-z_][A-Za-z0-9_]*",
    ]
    let rows = [
        "CONST_42!",
        "Camel42 ",
        "plain_name:",
        "'static str",
        "r#type,",
        "word_more",
        "size_t ",
        "x_t!",
        "x_tmore",
        "9bad",
        "A_b",
        "naïve",
    ]
    for p in 0..patterns.len {
        for r in 0..rows.len { assert_ascii_identifier_fast_path_equal(patterns[p], bytes(rows[r])) }
    }
    assert_yaml_block_key_fast_path_matrix()
}

fn assert_word_literal_fast_path_equal(pattern: List[byte], flags: int, indexed: int, line: List[byte]) {
    var def = one_context("word-fast", 1, syn.syn_first_new(true))
    let _ = bare_rule(mut def, pattern, flags, 1)
    let _ = compare_paths(take def, syn.SYN_FAST_WORD_LITERAL, indexed, 16, line, SAME_STOP | SAME_EXIT_STATE | COUNT_REFERENCE)
}

// test_syn_line_word_literal_fast_path_matches_regex
fn word_literal_fast_path_matches_regex() {
    var rows = List[List[byte]]()
    for s in ["alpha", "BeTa", "gamma!", "alphabet", "x beta", "béta"] { (mut rows).push(bytes(s)) }
    for i in 0..rows.len {
        assert_word_literal_fast_path_equal(bytes("\\b(alpha|beta|gamma)\\b"), search.RE_ICASE, 1, rows[i])
    }
    let long_word = repeated(97, 300)
    var long_pattern = bytes("\\b(")
    for i in 0..long_word.len { (mut long_pattern).push(long_word[i]) }
    append(mut long_pattern, ")\\b")
    assert_word_literal_fast_path_equal(long_pattern, 0, 1, long_word)
    var exponential = bytes("\\b")
    for _ in 0..13 { append(mut exponential, "(?:a|b)") }
    append(mut exponential, "\\b")
    assert_word_literal_fast_path_equal(exponential, 0, 0, bytes("aaaaaaaaaaaaa"))
}

fn assert_finite_literal_fast_path_equal(pattern: str, line: List[byte]) {
    var def = one_context("finite-fast", 1, syn.syn_first_new(true))
    let r = bare_rule(mut def, bytes(pattern), 0, 31)
    def.rules[r].caps[1] = 34 as byte
    let _ = compare_paths(take def, syn.SYN_FAST_FINITE_LITERAL, 1, 16, line, SAME_STOP | SAME_EXIT_ID | COUNT_REFERENCE)
}

fn assert_json_key_fast_path_equal(pattern: str, line: List[byte], indexed: int, matched: bool) {
    var def = one_context("json-key-fast", 1, syn.syn_first_new(true))
    let r = bare_rule(mut def, bytes(pattern), 0, 0)
    def.rules[r].consume = 1
    def.rules[r].caps[1] = 26 as byte
    def.rules[r].caps[2] = 13 as byte
    let out = compare_paths(take def, syn.SYN_FAST_JSON_KEY, indexed, 16, line, SAME_STOP | SAME_EXIT_ID | COUNT_REFERENCE)
    if matched {
        var colon = line.len
        for i in 0..line.len {
            if line[i] as int == 58 { colon = i }
        }
        assert(colon < line.len, "the key line has a colon")
        assert(attr_at(out, 0) == 26, "the key is a member")
        assert(attr_at(out, colon) == 0, "the colon is plain text")
    }
}

// test_syn_line_finite_literal_fast_path_matches_regex
fn finite_literal_fast_path_matches_regex() {
    let operators = "(=>|->|::|\\.\\.=|\\.\\.|<<=|>>=|<<|>>|&&|\\|\\||==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|[?+*/%&|^!~=<>-])"
    for s in ["=> rest", "..=", ".", "^=", "?", "word", "é"] { assert_finite_literal_fast_path_equal(operators, bytes(s)) }
    assert_finite_literal_fast_path_equal("[(){{}}\\[\\]]", bytes("]x"))
    // Left branch priority is semantic when one literal prefixes another.
    assert_finite_literal_fast_path_equal("(=|==)", bytes("=="))
    let json_key = "(\"(\\\\[\"\\\\/bfnrt]|\\\\u[0-9A-Fa-f]{{4}}|[^\"\\\\\\x00-\\x1F])*\")\\s*:"
    let json_equal = "(\"(\\\\[\"\\\\/bfnrt]|\\\\u[0-9A-Fa-f]{{4}}|[^\"\\\\\\x00-\\x1F])*\")\\s*="
    assert_json_key_fast_path_equal(json_key, bytes("\"name\": 1"), 1, true)
    assert_json_key_fast_path_equal(json_key, bytes("\"\":0"), 1, true)
    assert_json_key_fast_path_equal(json_key, bytes("\"a\\\"b\" \t: 1"), 1, true)
    assert_json_key_fast_path_equal(json_key, bytes("\"u\\u0041\":0"), 1, true)
    // Non-ASCII keys are deliberately delegated to the regex VM.
    assert_json_key_fast_path_equal(json_key, bytes("\"naïve\":1"), 1, true)
    assert_json_key_fast_path_equal(json_key, bytes("\"bad\\q\":0"), 1, false)
    assert_json_key_fast_path_equal(json_key, with_byte("\"a", 31, "\":0"), 1, false)
    assert_json_key_fast_path_equal(json_key, bytes("\"value\""), 1, false)
    assert_json_key_fast_path_equal(json_equal, bytes("\"name\"=1"), 0, false)
}

fn context_hits(engine: syn.SynEngine, slot: int) -> int {
    var hits: int = 0
    for i in 0..engine.coverage[slot].contexts.len { hits += engine.coverage[slot].contexts[i] }
    hits
}

fn rule_hits(engine: syn.SynEngine, slot: int) -> int {
    var hits: int = 0
    for i in 0..engine.coverage[slot].rules.len { hits += engine.coverage[slot].rules[i] }
    hits
}

// test_syn_line_coverage_is_optional_and_excludes_stack_probes
fn coverage_is_optional_and_excludes_stack_probes() {
    var pool = syn.syn_pool_new()
    let root = syn.syn_pool_add(mut pool, take toy(), 1)
    var engine = syn.syn_engine_new(pool, root)
    syn.syn_engine_set_coverage(mut engine, pool, syn.syn_coverage_new(pool, root))
    let slot = syn.syn_engine_coverage_at(engine, root)
    assert(slot >= 0, "coverage attached")
    var out = syn.syn_spans_new(16)
    let line = bytes("\"a\\nb\"")
    syn.syn_line(mut engine, mut pool, syn.SYN_STATE_ROOT, line, 6, mut out, false)
    assert(engine.coverage[slot].contexts[MAIN] == 2, "main entered at the line start and after the pop")
    assert(engine.coverage[slot].contexts[STRING] == 1, "string entered once")
    assert(engine.coverage[slot].rules[2] == 1, "opener matched")
    assert(engine.coverage[slot].rules[7] == 1, "escape matched")
    assert(engine.coverage[slot].rules[8] == 1, "closer matched")
    let contexts = context_hits(engine, slot)
    let rules = rule_hits(engine, slot)
    var at = syn.syn_state_root(0, 0)
    assert(syn.syn_stack_at(mut at, mut engine, mut pool, syn.SYN_STATE_ROOT, line, 6, 3), "stack probe answers")
    assert(context_hits(engine, slot) == contexts, "a stack probe counts no context")
    assert(rule_hits(engine, slot) == rules, "a stack probe counts no rule")
    syn.syn_coverage_clear(mut engine.coverage[slot])
    assert(context_hits(engine, slot) == 0, "context counters cleared")
    assert(rule_hits(engine, slot) == 0, "rule counters cleared")
    syn.syn_engine_clear_coverage(mut engine)
    assert(syn.syn_engine_coverage_at(engine, root) == -1, "coverage detached")
}

// test_syn_line_line_eq_ws_ignores_only_leading_ascii_space_and_tab
fn line_eq_ws_ignores_only_leading_ascii_space_and_tab() {
    let lines = ["END", " END", "\t \tEND", "\x0bEND", "END ", "end"]
    let matches = [true, true, true, false, false, false]
    var def = one_context("line-eq-ws", 0, syn.syn_first_new(false))
    var body = syn.syn_context_new(15)
    body.nrules = 1
    body.first = syn.syn_first_new(true)
    (mut def.contexts).push(body)
    (mut def.context_names).push(bytes("body"))
    var rule = syn.syn_rule_new(0, 12)
    rule.op = syn.SYN_OP_POP
    rule.nop = 1
    rule.aux_match = syn.SYN_AUXM_LINE_EQ_WS
    (mut def.rules).push(rule)
    (mut def.patterns).push(List[byte]())
    var pool = syn.syn_pool_new()
    let root = syn.syn_pool_add(mut pool, take def, 1)
    var engine = syn.syn_engine_new(pool, root)
    var state = syn.syn_state_root(0, 0)
    syn.syn_state_push(mut state, 1)
    syn.syn_state_set_aux(mut state, 0, fl.fl_intern(mut pool.aux[root], bytes("END"), 0, 3))
    let entry = syn.syn_state_intern(mut engine.states, state)
    for i in 0..lines.len {
        var out = syn.syn_spans_new(8)
        let line = bytes(lines[i])
        syn.syn_line(mut engine, mut pool, entry, line, line.len, mut out, false)
        assert(out.stop == syn.SYN_STOP_OK, "no cap")
        let exit = exit_state(engine, out.exit_state)
        let depth = if matches[i] then 1 else 2
        let attr = if matches[i] then 12 else 15
        assert(syn.syn_state_depth(exit) == depth, "the closer pops only on a match")
        assert(attr_at(out, 0) == attr, "closer or body attribute")
    }
}

fn main() {
    let selected = (env_get("YEW_SYN_LINE_CASE") else "-1").to_int() else -1
    for i in 0..16 {
        if selected == -1 || selected == i {
            match i {
                0 => toy_golden_table(),
                1 => byte_cap_preserves_entry_state(),
                2 => byte_cap_reuses_unchanged_state_id(),
                3 => span_cap_stops_without_overwriting_caller_storage(),
                4 => zero_width_rule_forces_utf8_progress(),
                5 => step_cap_degrades_instead_of_stalling(),
                6 => empty_candidate_set_does_not_scan_declared_first(),
                7 => large_candidate_index_falls_back_without_semantic_change(),
                8 => consume_stops_emission_and_optional_aux_is_safe(),
                9 => push_list_eol_target_and_clear_aux_pop_laws(),
                10 => identifier_suffix_fast_path_matches_regex(),
                11 => ascii_identifier_fast_path_matches_regex(),
                12 => word_literal_fast_path_matches_regex(),
                13 => finite_literal_fast_path_matches_regex(),
                14 => coverage_is_optional_and_excludes_stack_probes(),
                _ => line_eq_ws_ignores_only_leading_ascii_space_and_tab(),
            }
            print("syn_line_case_{i}: PASS")
        }
    }
}
