// ---- the fakelsp sessions (`:1171-1440`) ------------------------------------

// test_lsp_life.c:1171-1210
fn lsp_lifecycle_fakelsp_handshake_queue_and_shutdown(mut t: Tally, helper: str) {
    let transcript = "seq:initialize\nseq:initialized\nseq:didOpen\nseq:shutdown\nseq:exit\n"
    var f = fix_init(helper, "session-utf8", 1000, "handshake")
    let k = server(f)
    ok(mut t, f.ed.lsp.servers[k].life.state == lsp.LSP_INITIALIZING, "initializing")
    ok(mut t, !f.ed.lsp.servers[k].docv[doc(f)].open, "not open yet")
    ok(mut t, wait_state(mut f, lsp.LSP_READY, 2000), "ready")
    ok(mut t, f.ed.lsp.servers[k].docv[doc(f)].open, "opened")
    ok(mut t, f.ed.lsp.servers[k].life.pos_enc == lsp.POSENC_UTF8, "utf-8")
    let j = edit.job_find(f.ed, f.ed.lsp.servers[k].job)
    ok(mut t, j >= 0, "the job")
    let pgid = f.ed.jobs.v[j].pgid
    edit.lsp_client_stop(mut f.ed, k, true)
    ok(mut t, f.ed.lsp.servers[k].life.state == lsp.LSP_SHUTTING_DOWN, "shutting down")
    ok(mut t, wait_drained(mut f, 2000), "drained")
    let j2 = edit.job_find(f.ed, f.ed.lsp.servers[k].job)
    ok(mut t, j2 >= 0, "the job")
    ok(mut t, f.ed.jobs.v[j2].state == edit.JOB_EXITED, "exited")
    ok(mut t, f.ed.jobs.v[j2].exit_code == 0, "status 0")
    ok(mut t, transcript_is(f, transcript), "the transcript: {transcript_of(f)}")
    // C's `kill(-pgid, 0)` and `waitpid(pid, WNOHANG)`: the group gone,
    // the child reaped (the job layer read its status).
    ok(mut t, group_alive(pgid) <= 0, "the group is gone")
    fix_free(mut f)
}

// test_lsp_life.c:1212-1243
fn lsp_lifecycle_fakelsp_position_encoding_variants(mut t: Tally, helper: str) {
    let cases = [
        ("session-utf8", lsp.POSENC_UTF8, false),
        ("session-utf16", lsp.POSENC_UTF16, false),
        ("session-absent", lsp.POSENC_UTF16, false),
        ("session-garbage", lsp.POSENC_UTF16, true),
    ]
    for (mode, encoding, warn) in cases {
        var f = fix_init(helper, mode, 1000, mode)
        ok(mut t, wait_state(mut f, lsp.LSP_READY, 2000), "{mode}: ready")
        let k = server(f)
        ok(mut t, f.ed.lsp.servers[k].life.pos_enc == encoding, "{mode}: the encoding")
        if warn {
            ok(mut t, f.ed.msg.active && f.ed.msg.sev == edit.MSG_WARN, "{mode}: a warning")
            ok(
                mut t,
                f.ed.msg.text.contains("unknown positionEncoding; using utf-16"),
                "{mode}: {f.ed.msg.text}",
            )
        } else {
            ok(mut t, !f.ed.msg.active, "{mode}: silent")
        }
        stop_and_drain(mut t, mut f)
        fix_free(mut f)
    }
}

// test_lsp_life.c:1245-1263
fn lsp_lifecycle_fakelsp_rejects_missing_sync(mut t: Tally, helper: str) {
    var f = fix_init(helper, "session-nosync", 1000, "nosync")
    ok(mut t, wait_state(mut f, lsp.LSP_DEAD, 2000), "dead")
    ok(mut t, f.ed.msg.active && f.ed.msg.sev == edit.MSG_ERROR, "an error")
    ok(
        mut t,
        f.ed.msg.text.contains("does not support document synchronization"),
        "why: {f.ed.msg.text}",
    )
    ok(mut t, f.ed.msg.text.contains("LSP is off for this workspace"), "what: {f.ed.msg.text}")
    ok(
        mut t,
        util.log_capture_has(util.LOG_ERROR, pb("does not support document synchronization")),
        "logged",
    )
    ok(mut t, wait_drained(mut f, 2000), "drained")
    fix_free(mut f)
}

// test_lsp_life.c:1265-1284
fn lsp_lifecycle_fakelsp_initialize_timeout_kills_child(mut t: Tally, helper: str) {
    var f = fix_init(helper, "session-timeout", 30, "timeout")
    let k = server(f)
    let j = edit.job_find(f.ed, f.ed.lsp.servers[k].job)
    ok(mut t, j >= 0, "the job")
    let pgid = f.ed.jobs.v[j].pgid
    ok(mut t, wait_state(mut f, lsp.LSP_DEAD, 1000), "dead")
    ok(mut t, wait_drained(mut f, 2000), "drained")
    ok(mut t, group_alive(pgid) <= 0, "the group is gone")
    fix_free(mut f)
}

// test_lsp_life.c:1308-1325
fn lsp_lifecycle_fakelsp_repeated_sessions_do_not_leak_fds(mut t: Tally, helper: str) {
    let before = fd_count()
    var i = 0
    while i < 200 {
        var f = fix_init(helper, "session-utf8", 1000, "leak")
        ok(mut t, wait_state(mut f, lsp.LSP_READY, 2000), "session {i}: ready")
        stop_and_drain(mut t, mut f)
        fix_free(mut f)
        i += 1
    }
    ok(mut t, fd_count() == before, "no descriptor leaked: {before} then {fd_count()}")
}

// test_lsp_life.c:1327-1356
fn lsp_lifecycle_fakelsp_open_edit_save_close_sequence(mut t: Tally, helper: str) {
    let transcript = "seq:initialize\nseq:initialized\nseq:didOpen\nseq:didChange\nseq:didSave\nseq:didClose\nseq:shutdown\nseq:exit\n"
    var f = fix_init(helper, "session-sync", 1000, "sync")
    ok(mut t, wait_state(mut f, lsp.LSP_READY, 2000), "ready")
    let k = server(f)
    ok(mut t, insert_front(mut f, "x"), "inserted")
    pump(mut f)
    ok(mut t, edit.ed_file_save(mut f.ed, false) == edit.CMD_OK, "saved")
    edit.lsp_client_close_buffer(mut f.ed, f.bi)
    edit.lsp_client_stop(mut f.ed, k, true)
    // The document is closed, so the server is found by its index here.
    let start = edit.now_ms()
    var drained = false
    while edit.now_ms() - start <= 2000 {
        let j = edit.job_find(f.ed, f.ed.lsp.servers[k].job)
        if j >= 0 && f.ed.jobs.v[j].drained {
            drained = true
            break
        }
        pump(mut f)
    }
    ok(mut t, drained, "drained")
    let j = edit.job_find(f.ed, f.ed.lsp.servers[k].job)
    ok(mut t, j >= 0 && f.ed.jobs.v[j].exit_code == 0, "status 0")
    ok(
        mut t,
        j >= 0 && same(f.ed.jobs.v[j].framed_err, pb(transcript)),
        "the transcript: {text_of(f.ed.jobs.v[j].framed_err)}",
    )
    fix_free(mut f)
}

// test_lsp_life.c:1358-1393: `ed.syn.set` is yw10's; its LSP half runs.
fn lsp_lifecycle_language_change_closes_document(mut t: Tally, helper: str) -> int {
    let transcript = "seq:initialize\nseq:initialized\nseq:didOpen\nseq:didClose\nseq:shutdown\nseq:exit\n"
    var f = fix_init(helper, "session-close", 1000, "close")
    ok(mut t, wait_state(mut f, lsp.LSP_READY, 2000), "ready")
    let k = server(f)
    let id = edit.cmd_lookup(f.ed.reg, "ed.syn.set")
    ok(mut t, id != 0, "ed.syn.set is registered")
    var cx = edit.cmdctx_new(f.ed.win, edit.SRC_TEST)
    cx.count = 1
    cx.sarg = "none"
    cx.has_sarg = true
    ok(
        mut t,
        edit.ed_cmd_invoke(mut f.ed, id, mut cx) == edit.CMD_ERR_DEFERRED,
        "ed.syn.set: deferred",
    )
    ok(
        mut t,
        f.ed.msg.text.starts_with("not yet ported: ed.syn.set: ") &&
            f.ed.msg.text.ends_with("(yw10)"),
        "by name: {f.ed.msg.text}",
    )
    // `cmd_syn_set`'s LSP half (`cmd.c:103-110`).
    edit.lsp_buffer_close(mut f.ed, f.bi)
    let (gone, _) = edit.lsp_doc_of_buffer(f.ed, f.bi)
    ok(mut t, gone < 0, "the document is closed")
    edit.lsp_client_stop(mut f.ed, k, true)
    let start = edit.now_ms()
    var drained = false
    while edit.now_ms() - start <= 2000 {
        let j = edit.job_find(f.ed, f.ed.lsp.servers[k].job)
        if j >= 0 && f.ed.jobs.v[j].drained {
            drained = true
            break
        }
        pump(mut f)
    }
    ok(mut t, drained, "drained")
    let j = edit.job_find(f.ed, f.ed.lsp.servers[k].job)
    ok(
        mut t,
        j >= 0 && same(f.ed.jobs.v[j].framed_err, pb(transcript)),
        "the transcript: {text_of(f.ed.jobs.v[j].framed_err)}",
    )
    fix_free(mut f)
    print(
        "RED lsp_lifecycle_language_change_closes_document: ed.syn.set (cmd.c:91-110) is sagitta Sprint 39's (yw10); its LSP half (yew_lsp_buffer_close) and the transcript asserted",
    )
    1
}

// test_lsp_life.c:1395-1428
fn lsp_lifecycle_fakelsp_delayed_response_is_stale(mut t: Tally, helper: str) {
    var f = fix_init(helper, "session-stale", 1000, "stale")
    ok(mut t, wait_state(mut f, lsp.LSP_READY, 2000), "ready")
    let k = server(f)
    var p = lsp.rpc_pending_new()
    p.buf_id = f.ed.bufs[f.bi].id
    p.gen = f.ed.bufs[f.bi].ec.tb.gen
    p.sent_ms = f.ed.now_ms
    ok(
        mut t,
        lsp.rpc_call(mut f.ed.lsp.servers[k].rpc, "textDocument/hover", pb("{{}}"), p) != 0,
        "sent",
    )
    pump(mut f)
    ok(mut t, insert_front(mut f, "x"), "inserted")
    let start = edit.now_ms()
    while f.ed.lsp.servers[k].dropped_stale == 0 && edit.now_ms() - start <= 2000 {
        pump(mut f)
    }
    ok(
        mut t,
        f.ed.lsp.servers[k].dropped_stale == 1,
        "the late answer dropped: {f.ed.lsp.servers[k].dropped_stale}",
    )
    stop_and_drain(mut t, mut f)
    fix_free(mut f)
}

// test_lsp_life.c:1430-1455
fn lsp_lifecycle_editor_free_is_graceful(mut t: Tally, helper: str) {
    let transcript = "seq:initialize\nseq:initialized\nseq:didOpen\nseq:shutdown\nseq:exit\n"
    var f = fix_init(helper, "session-utf8", 1000, "free")
    ok(mut t, wait_state(mut f, lsp.LSP_READY, 2000), "ready")
    let job_id = f.ed.lsp.servers[server(f)].job
    edit.lsp_client_free(mut f.ed)
    ok(mut t, !f.ed.lsp.present, "the client is gone")
    let j = edit.job_find(f.ed, job_id)
    ok(mut t, j >= 0, "the job")
    ok(mut t, f.ed.jobs.v[j].drained, "drained")
    ok(mut t, f.ed.jobs.v[j].state == edit.JOB_EXITED, "exited")
    ok(mut t, f.ed.jobs.v[j].exit_code == 0, "status 0")
    ok(
        mut t,
        same(f.ed.jobs.v[j].framed_err, pb(transcript)),
        "the transcript: {text_of(f.ed.jobs.v[j].framed_err)}",
    )
    fix_free(mut f)
}

// ---- diagnostics and restarts (`:1470-1698`) ---------------------------------

// `dispatch_diag` (`:1470-1499`): a version < 0 sends none.
fn dispatch_diag(mut f: LifeFix, version: int) {
    let k = server(f)
    let uri = copy f.ed.lsp.servers[k].docv[doc(f)].uri
    let field = if version < 0 then "" else "\"version\":{version},"
    let json = "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{{\"uri\":\"{uri}\",{field}\"diagnostics\":[{{\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":1}}}},\"severity\":1,\"message\":\"boom\"}}]}}}}"
    let j = parse(json)
    edit.lsp_server_dispatch_value(mut f.ed, f.ed.lsp.servers[k].id, j)
}

fn store(f: LifeFix) -> int {
    edit.diag_store_of(f.ed, f.bi)
}

// test_lsp_life.c:1501-1547
fn lsp_lifecycle_unversioned_diagnostics_track_flush(mut t: Tally, helper: str) {
    var f = fix_init(helper, "session-unversioned", 1000, "unversioned")
    ok(mut t, wait_state(mut f, lsp.LSP_READY, 2000), "ready")
    let k = server(f)
    let d = doc(f)
    ok(mut t, f.ed.lsp.servers[k].docv[d].sent_gen == f.ed.bufs[f.bi].ec.tb.gen, "flushed")
    dispatch_diag(mut f, -1)
    ok(mut t, store(f) >= 0, "a store")
    ok(mut t, !f.ed.diags[store(f)].stale, "fresh")
    let w = f.ed.win
    let bytes = pb("x")
    ok(mut t, edit.ed_edit_insert(mut f.ed, w, 0, bytes, 0, 1), "inserted")
    edit.ed_finish_edit(mut f.ed, w)
    ok(mut t, f.ed.lsp.servers[k].docv[doc(f)].sent_gen != f.ed.bufs[f.bi].ec.tb.gen, "not flushed")
    dispatch_diag(mut f, -1)
    ok(mut t, f.ed.diags[store(f)].stale, "stale against the unflushed edit")
    pump(mut f)
    ok(
        mut t,
        f.ed.lsp.servers[k].docv[doc(f)].sent_gen == f.ed.bufs[f.bi].ec.tb.gen,
        "flushed again",
    )
    dispatch_diag(mut f, -1)
    ok(mut t, !f.ed.diags[store(f)].stale, "fresh again")
    stop_and_drain(mut t, mut f)
    fix_free(mut f)
}

fn change_zero() -> lsp.LspChange {
    lsp.LspChange { sl: 0, sc: 0, el: 0, ec: 0, text: List[byte]() }
}

// test_lsp_life.c:1549-1586
fn lsp_lifecycle_diagnostics_follow_live_document_version(mut t: Tally, helper: str) {
    var f = fix_init(helper, "session-utf8", 1000, "version")
    ok(mut t, wait_state(mut f, lsp.LSP_READY, 2000), "ready")
    let k = server(f)
    ok(mut t, f.ed.lsp.servers[k].docv[doc(f)].version == 1, "version 1")
    dispatch_diag(mut f, 0)
    ok(mut t, store(f) < 0, "version 0 is old")
    dispatch_diag(mut f, 1)
    ok(mut t, store(f) >= 0 && f.ed.diags[store(f)].d.len == 1, "version 1 lands")
    let d = doc(f)
    f.ed.lsp.servers[k].docv[d].full_sync = true
    f.ed.lsp.servers[k].docv[d].insert_waiting = true
    (mut f.ed.lsp.servers[k].docv[d].pending).push(change_zero())
    let old_job = f.ed.lsp.servers[k].job
    ok(mut t, edit.lsp_client_restart(mut f.ed, f.bi), "restarted")
    ok(mut t, store(f) < 0, "the store dropped")
    let d2 = doc(f)
    ok(mut t, f.ed.lsp.servers[k].docv[d2].version == 0, "version 0")
    ok(mut t, !f.ed.lsp.servers[k].docv[d2].open, "closed")
    ok(mut t, !f.ed.lsp.servers[k].docv[d2].full_sync, "no full sync owed")
    ok(mut t, !f.ed.lsp.servers[k].docv[d2].insert_waiting, "no insert waiting")
    ok(mut t, f.ed.lsp.servers[k].docv[d2].pending.len == 0, "no changes pending")
    ok(
        mut t,
        wait_new_ready(mut f, old_job, LIFE_RESTART_READY_TIMEOUT_MS),
        "the new session ready",
    )
    ok(mut t, f.ed.lsp.servers[k].docv[doc(f)].version == 1, "version 1 again")
    dispatch_diag(mut f, 1)
    ok(mut t, store(f) >= 0 && f.ed.diags[store(f)].d.len == 1, "version 1 lands again")
    stop_and_drain(mut t, mut f)
    fix_free(mut f)
}

fn kill_server(mut t: Tally, f: LifeFix) {
    let j = edit.job_find(f.ed, f.ed.lsp.servers[server(f)].job)
    ok(mut t, j >= 0, "the job")
    var sent = true
    os_signal_send_group(f.ed.jobs.v[j].pgid, signal.kill()) else |_| {
        sent = false
    }
    ok(mut t, sent, "SIGKILL to the group")
}

// test_lsp_life.c:1588-1620
fn lsp_lifecycle_automatic_restart_reopens_documents(mut t: Tally, helper: str) {
    var f = fix_init(helper, "session-crash-restart", 1000, "crash")
    ok(mut t, wait_state(mut f, lsp.LSP_READY, 2000), "ready")
    let k = server(f)
    dispatch_diag(mut f, 1)
    ok(mut t, store(f) >= 0, "a store")
    kill_server(mut t, f)
    let d = doc(f)
    f.ed.lsp.servers[k].docv[d].full_sync = true
    (mut f.ed.lsp.servers[k].docv[d].pending).push(change_zero())
    let old_job = f.ed.lsp.servers[k].job
    ok(mut t, wait_new_ready(mut f, old_job, LIFE_RESTART_READY_TIMEOUT_MS), "restarted")
    ok(mut t, store(f) < 0, "the store dropped")
    let d2 = doc(f)
    ok(mut t, f.ed.lsp.servers[k].docv[d2].open, "reopened")
    ok(mut t, f.ed.lsp.servers[k].docv[d2].version == 1, "version 1")
    ok(mut t, !f.ed.lsp.servers[k].docv[d2].full_sync, "no full sync owed")
    ok(mut t, !f.ed.lsp.servers[k].docv[d2].insert_waiting, "no insert waiting")
    ok(mut t, f.ed.lsp.servers[k].docv[d2].pending.len == 0, "no changes pending")
    stop_and_drain(mut t, mut f)
    fix_free(mut f)
}

// test_lsp_life.c:1645-1677
fn lsp_lifecycle_restart_message_severities(mut t: Tally, helper: str) {
    var f = fix_init(helper, "session-utf8", 1000, "severities")
    ok(mut t, wait_state(mut f, lsp.LSP_READY, 2000), "ready")
    let k = server(f)
    f.ed.lsp.servers[k].life.restarts = 1
    f.ed.lsp.servers[k].life.first_restart_ms = f.ed.now_ms
    var old_job = f.ed.lsp.servers[k].job
    kill_server(mut t, f)
    ok(mut t, wait_restart_notice(mut f, 2, 2000), "the second restart's notice")
    ok(mut t, f.ed.msg.sev == edit.MSG_INFO, "info")
    ok(mut t, f.ed.msg.text == "fakelsp restarted", "the sentence: {f.ed.msg.text}")
    f.ed.lsp.servers[k].life.next_try_ms = f.ed.now_ms
    ok(mut t, wait_new_ready(mut f, old_job, LIFE_RESTART_READY_TIMEOUT_MS), "ready again")

    edit.ed_msg_clear(mut f.ed)
    f.ed.lsp.servers[k].life.restarts = 2
    f.ed.lsp.servers[k].life.first_restart_ms = f.ed.now_ms
    old_job = f.ed.lsp.servers[k].job
    kill_server(mut t, f)
    ok(mut t, wait_restart_notice(mut f, 3, 2000), "the third restart's notice")
    ok(mut t, f.ed.msg.sev == edit.MSG_WARN, "a warning")
    ok(mut t, f.ed.msg.text == "fakelsp restarted (3)", "the sentence: {f.ed.msg.text}")
    f.ed.lsp.servers[k].life.next_try_ms = f.ed.now_ms
    ok(mut t, wait_new_ready(mut f, old_job, LIFE_RESTART_READY_TIMEOUT_MS), "ready again")
    stop_and_drain(mut t, mut f)
    fix_free(mut f)
}

// test_lsp_life.c:1679-1698
fn lsp_lifecycle_stop_escalates_to_sigkill(mut t: Tally, helper: str) {
    var f = fix_init(helper, "session-resistant", 1000, "resistant")
    ok(mut t, wait_state(mut f, lsp.LSP_READY, 2000), "ready")
    let k = server(f)
    let start = edit.now_ms()
    edit.lsp_client_stop(mut f.ed, k, true)
    ok(mut t, wait_drained(mut f, 2000), "drained")
    ok(mut t, edit.now_ms() - start >= 350, "after the grace: {edit.now_ms() - start} ms")
    let j = edit.job_find(f.ed, f.ed.lsp.servers[k].job)
    ok(mut t, j >= 0, "the job")
    let kill_no = signal.number(signal.kill()) else 9
    ok(mut t, f.ed.jobs.v[j].state == edit.JOB_SIGNALED, "signalled")
    ok(mut t, f.ed.jobs.v[j].termsig == kill_no, "by SIGKILL: {f.ed.jobs.v[j].termsig}")
    fix_free(mut f)
}

// test_lsp_life.c:1700-1733
fn lsp_server_requests_receive_protocol_results(mut t: Tally) {
    var ed = edit.ed_new()
    let sid = place_server(mut ed)
    let k = ed.lsp.servers.len - 1
    let a = parse(
        "{{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"workspace/configuration\",\"params\":{{\"items\":[{{}},{{}},{{}}]}}}}",
    )
    edit.lsp_server_dispatch_value(mut ed, sid, a)
    ok(
        mut t,
        bytes_contain(ed.lsp.servers[k].rpc.tx.pending, 0, "\"id\":7,\"result\":[null,null,null]"),
        "a null per item",
    )
    lsp.rpctx_consume(mut ed.lsp.servers[k].rpc.tx, ed.lsp.servers[k].rpc.tx.pending.len)
    let b = parse(
        "{{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"window/workDoneProgress/create\",\"params\":{{\"token\":1}}}}",
    )
    edit.lsp_server_dispatch_value(mut ed, sid, b)
    ok(
        mut t,
        bytes_contain(ed.lsp.servers[k].rpc.tx.pending, 0, "\"id\":8,\"result\":null"),
        "null",
    )
}

// ---- the document menu's LSP section (`:1735-1794`) -------------------------

fn ctx_index(ed: edit.Ed, label: str) -> int {
    var i = 0
    while i < edit.ctx_rows(ed.ctx) {
        if edit.ctx_row_label(ed.ctx, i) == label {
            return i
        }
        i += 1
    }
    -1
}

// test_lsp_life.c:1746-1794
fn ctxrows_doc_lsp_section_appears_with_a_server(mut t: Tally, helper: str) {
    var f = fix_init(helper, "session-features", 1000, "ctxrows")
    ok(mut t, wait_state(mut f, lsp.LSP_READY, 2000), "ready")
    ok(mut t, edit.lsp_attached(f.ed, f.bi), "attached")
    grid_up(mut f)
    edit.ed_layout(mut f.ed)
    edit.pane_tables_reset(mut f.ed)
    let focus = f.ed.focus
    let leaf = edit.pane_table_add_leaf(mut f.ed, focus)
    ok(mut t, leaf >= 0, "a leaf")
    let c = edit.ctxcontext_new(edit.CTX_KIND_DOC, leaf)
    edit.ctx_close(mut f.ed.ctx)
    edit.ctx_build(mut f.ed, c)
    let def = ctx_index(f.ed, "Go to Definition")
    ok(mut t, def > 0, "Go to Definition, not first")
    ok(mut t, edit.ctx_row_is_sep(f.ed.ctx, def - 1), "behind its own separator")
    ok(
        mut t,
        edit.ctx_row_label(f.ed.ctx, def + 1) == "Find References...",
        "then Find References...",
    )
    ok(mut t, edit.ctx_row_label(f.ed.ctx, def + 2) == "Rename...", "then Rename...")
    ok(mut t, edit.ctx_row_label(f.ed.ctx, def + 3) == "Hover", "then Hover")
    ok(mut t, edit.ctx_row_enabled(f.ed.ctx, def), "Go to Definition enabled")
    ok(mut t, edit.ctx_row_enabled(f.ed.ctx, def + 3), "Hover enabled")
    // Rename... is the one LSP row a read-only buffer cannot use.
    f.ed.bufs[f.bi].flags = f.ed.bufs[f.bi].flags | edit.BUF_READONLY
    edit.ctx_close(mut f.ed.ctx)
    edit.ctx_build(mut f.ed, c)
    ok(mut t, !edit.ctx_row_enabled(f.ed.ctx, def + 2), "Rename... greyed")
    ok(mut t, edit.ctx_row_enabled(f.ed.ctx, def), "Go to Definition still enabled")
    f.ed.bufs[f.bi].flags = f.ed.bufs[f.bi].flags & !edit.BUF_READONLY
    edit.ctx_close(mut f.ed.ctx)
    fix_free(mut f)
}

