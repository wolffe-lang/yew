        31 => "lsp_lifecycle_automatic_restart_reopens_documents",
        32 => "lsp_lifecycle_restart_message_severities",
        33 => "lsp_lifecycle_stop_escalates_to_sigkill",
        34 => "lsp_server_requests_receive_protocol_results",
        _ => "ctxrows_doc_lsp_section_appears_with_a_server",
    }
}

// Whether case `i` spawns the helper.
fn needs_helper(i: int) -> bool {
    !(i == 0 || i == 1 || i == 2 || i == 3 || i == 34)
}

// 0 a pass, 1 a RED by name (its line printed by the case).
fn run_case(mut t: Tally, i: int, helper: str) -> int {
    match i {
        0 => lsp_lifecycle_drops_stale_response_before_callback(mut t),
        1 => lsp_lifecycle_drops_every_stale_feature_response(mut t),
        2 => { return completion_red(mut t, case_name(i), "test_lsp_life.c:663-720") },
        3 => { return completion_red(mut t, case_name(i), "test_lsp_life.c:722-738") },
        4 => lsp_lifecycle_hover_signature_panels_and_auto_trigger(mut t, helper),
        5 => lsp_lifecycle_method_not_found_clears_panel_capabilities(mut t, helper),
        6 => lsp_lifecycle_definition_response_jumps_to_single_location(mut t, helper),
        7 => lsp_lifecycle_references_response_opens_multi_location_picker(mut t, helper),
        8 => lsp_lifecycle_empty_definition_reports_exact_info_message(mut t, helper),
        9 => lsp_lifecycle_method_not_found_clears_definition_capability(mut t, helper),
        10 => lsp_lifecycle_document_symbols_open_nested_picker(mut t, helper),
        11 => lsp_lifecycle_empty_document_symbols_report_exact_info_message(mut t, helper),
        12 => lsp_lifecycle_method_not_found_clears_document_symbol_capability(mut t, helper),
        13 => lsp_lifecycle_document_highlight_waits_for_idle(mut t, helper),
        14 => lsp_lifecycle_document_highlight_separates_read_and_write_overlays(mut t, helper),
        15 =>
            lsp_lifecycle_document_highlight_edit_clears_and_cancels_stale_response(mut t, helper),
        16 => lsp_lifecycle_document_highlight_cursor_rearm_rejects_stale_response(mut t, helper),
        17 => lsp_lifecycle_document_highlight_focus_return_rearms(mut t, helper),
        18 => lsp_lifecycle_method_not_found_clears_highlight_capability(mut t, helper),
        19 => lsp_lifecycle_unfocused_method_not_found_clears_highlight_capability(mut t, helper),
        20 => lsp_lifecycle_fakelsp_handshake_queue_and_shutdown(mut t, helper),
        21 => lsp_lifecycle_fakelsp_position_encoding_variants(mut t, helper),
        22 => lsp_lifecycle_fakelsp_rejects_missing_sync(mut t, helper),
        23 => lsp_lifecycle_fakelsp_initialize_timeout_kills_child(mut t, helper),
        24 => lsp_lifecycle_fakelsp_repeated_sessions_do_not_leak_fds(mut t, helper),
        25 => lsp_lifecycle_fakelsp_open_edit_save_close_sequence(mut t, helper),
        26 => { return lsp_lifecycle_language_change_closes_document(mut t, helper) },
        27 => lsp_lifecycle_fakelsp_delayed_response_is_stale(mut t, helper),
        28 => lsp_lifecycle_editor_free_is_graceful(mut t, helper),
        29 => lsp_lifecycle_unversioned_diagnostics_track_flush(mut t, helper),
        30 => lsp_lifecycle_diagnostics_follow_live_document_version(mut t, helper),
        31 => lsp_lifecycle_automatic_restart_reopens_documents(mut t, helper),
        32 => lsp_lifecycle_restart_message_severities(mut t, helper),
        33 => lsp_lifecycle_stop_escalates_to_sigkill(mut t, helper),
        34 => lsp_server_requests_receive_protocol_results(mut t),
        35 => ctxrows_doc_lsp_section_appears_with_a_server(mut t, helper),
        _ => {},
    }
    0
}

const LOG_PATH: str = "target/tests/edit_lsp_life_test.log"

fn main() {
    fs.create_dir_all("target/tests") else |_| {}
    fs.remove(LOG_PATH) else |_| {}
    env_set("YEW_LOG", LOG_PATH) else |_| {}
    var t = Tally { n: 0 }
    let helper = edit.fakelsp_path()
    let pick = env_get("YEW_LSP_LIFE_CASE") else ""
    var lo = 0
    var hi = CASES
    if pick.len != 0 {
        lo = pick.to_int() else -1
        hi = lo + 1
        // One past the last case runs nothing and prints nothing
        // (`tools/check-test-cases`).
        if lo < 0 || lo >= CASES {
            return
        }
    }
    var reds = 0
    var skips = 0
    var i = lo
    while i < hi {
        if helper.len == 0 && needs_helper(i) {
            print("SKIP {case_name(i)}: {edit.fakelsp_missing()}")
            skips += 1
        } else if run_case(mut t, i, helper) == 0 {
            print("{case_name(i)}: PASS")
        } else {
            reds += 1
        }
        i += 1
    }
    if pick.len == 0 {
        print(
            "edit_lsp_life_test: {CASES - reds - skips} cases pass, {reds} RED by name, {skips} SKIP by name, {t.n} assertions",
        )
    }
}
