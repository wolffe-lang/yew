const CASES: int = 36

fn case_name(i: int) -> str {
    match i {
        0 => "lsp_lifecycle_drops_stale_response_before_callback",
        1 => "lsp_lifecycle_drops_every_stale_feature_response",
        2 => "lsp_lifecycle_completion_resolve_cancel_and_shadow",
        3 => "lsp_lifecycle_method_not_found_clears_completion",
        4 => "lsp_lifecycle_hover_signature_panels_and_auto_trigger",
        5 => "lsp_lifecycle_method_not_found_clears_panel_capabilities",
        6 => "lsp_lifecycle_definition_response_jumps_to_single_location",
        7 => "lsp_lifecycle_references_response_opens_multi_location_picker",
        8 => "lsp_lifecycle_empty_definition_reports_exact_info_message",
        9 => "lsp_lifecycle_method_not_found_clears_definition_capability",
        10 => "lsp_lifecycle_document_symbols_open_nested_picker",
        11 => "lsp_lifecycle_empty_document_symbols_report_exact_info_message",
        12 => "lsp_lifecycle_method_not_found_clears_document_symbol_capability",
        13 => "lsp_lifecycle_document_highlight_waits_for_idle",
        14 => "lsp_lifecycle_document_highlight_separates_read_and_write_overlays",
        15 => "lsp_lifecycle_document_highlight_edit_clears_and_cancels_stale_response",
        16 => "lsp_lifecycle_document_highlight_cursor_rearm_rejects_stale_response",
        17 => "lsp_lifecycle_document_highlight_focus_return_rearms",
        18 => "lsp_lifecycle_method_not_found_clears_highlight_capability",
        19 => "lsp_lifecycle_unfocused_method_not_found_clears_highlight_capability",
        20 => "lsp_lifecycle_fakelsp_handshake_queue_and_shutdown",
        21 => "lsp_lifecycle_fakelsp_position_encoding_variants",
        22 => "lsp_lifecycle_fakelsp_rejects_missing_sync",
        23 => "lsp_lifecycle_fakelsp_initialize_timeout_kills_child",
        24 => "lsp_lifecycle_fakelsp_repeated_sessions_do_not_leak_fds",
        25 => "lsp_lifecycle_fakelsp_open_edit_save_close_sequence",
        26 => "lsp_lifecycle_language_change_closes_document",
        27 => "lsp_lifecycle_fakelsp_delayed_response_is_stale",
        28 => "lsp_lifecycle_editor_free_is_graceful",
        29 => "lsp_lifecycle_unversioned_diagnostics_track_flush",
