// ---- document highlight (`:977-1169`) ---------------------------------------

// `highlight_life_ready` (`:523-536`).
fn highlight_ready(mut t: Tally, helper: str, tag: str) -> LifeFix {
    var f = fix_init(helper, "session-utf8", 1000, tag)
    ok(mut t, wait_state(mut f, lsp.LSP_READY, 2000), "ready")
    ok(mut t, wait_rpc_tx_empty(mut f, 2000), "the handshake written")
    let k = server(f)
    f.ed.lsp.servers[k].life.caps.bits = f.ed.lsp.servers[k].life.caps.bits |
        lsp.LSPC_DOCUMENT_HIGHLIGHT
    ok(
        mut t,
        lsp.lsp_caps_has(f.ed.lsp.servers[k].life.caps, lsp.LSPC_DOCUMENT_HIGHLIGHT),
        "highlight on",
    )
    ok(mut t, f.ed.lsp.servers[k].rpc.npending == 0, "nothing pending")
    f
}

// `highlight_fire` (`:538-547`).
fn highlight_fire(mut t: Tally, mut f: LifeFix, elapsed_ms: int) -> int {
    let armed_at = f.ed.now_ms
    edit.lsp_highlight_cursor(mut f.ed, f.ed.win)
    ok(mut t, f.ed.wins[f.ed.win].lsp_highlight.timer != edit.TIMER_NONE, "armed")
    f.ed.now_ms = armed_at + elapsed_ms
    edit.ed_timers_fire(mut f.ed, f.ed.now_ms)
    f.ed.wins[f.ed.win].lsp_highlight.request
}

// `highlight_dispatch` (`:549-562`).
fn highlight_dispatch(mut f: LifeFix, id: int, member: str) -> bool {
    let j = parse("{{\"jsonrpc\":\"2.0\",\"id\":{id},{member}}}")
    edit.lsp_dispatch_response(mut f.ed, sid(f), j, j.root)
}

// `highlight_life_finish` (`:564-573`): the response was injected, so the
// queued request is dropped before the stop.
fn highlight_finish(mut t: Tally, mut f: LifeFix) {
    let k = server(f)
    (mut f.ed.lsp.servers[k].rpc.tx.pending).reset()
    f.ed.lsp.servers[k].rpc.tx.sent = 0
    stop_and_drain(mut t, mut f)
    fix_free(mut f)
}

fn range_member(lo: int, hi: int, kind: int) -> str {
    "{{\"range\":{{\"start\":{{\"line\":0,\"character\":{lo}}},\"end\":{{\"line\":0,\"character\":{hi}}}}},\"kind\":{kind}}}"
}

// test_lsp_life.c:977-1004
fn lsp_lifecycle_document_highlight_waits_for_idle(mut t: Tally, helper: str) {
    var f = highlight_ready(mut t, helper, "hl-idle")
    let k = server(f)
    let armed_at = f.ed.now_ms
    edit.lsp_highlight_cursor(mut f.ed, f.ed.win)
    ok(mut t, f.ed.wins[f.ed.win].lsp_highlight.timer != edit.TIMER_NONE, "armed")
    edit.ed_timers_fire(mut f.ed, armed_at + 299)
    ok(mut t, f.ed.wins[f.ed.win].lsp_highlight.request == 0, "not at 299 ms")
    ok(mut t, f.ed.lsp.servers[k].rpc.npending == 0, "nothing pending")
    f.ed.now_ms = armed_at + 300
    edit.ed_timers_fire(mut f.ed, f.ed.now_ms)
    let request = f.ed.wins[f.ed.win].lsp_highlight.request
    ok(mut t, request != 0, "sent at 300 ms")
    ok(mut t, f.ed.lsp.servers[k].rpc.npending == 1, "one pending")
    let tx = copy f.ed.lsp.servers[k].rpc.tx
    ok(mut t, tx.pending.len > tx.sent, "queued")
    ok(
        mut t,
        bytes_contain(tx.pending, tx.sent, "\"method\":\"textDocument/documentHighlight\""),
        "the method",
    )
    ok(mut t, highlight_dispatch(mut f, request, "\"result\":[]"), "answered")
    highlight_finish(mut t, mut f)
}

// test_lsp_life.c:1006-1028
fn lsp_lifecycle_document_highlight_separates_read_and_write_overlays(mut t: Tally, helper: str) {
    var f = highlight_ready(mut t, helper, "hl-rw")
    let request = highlight_fire(mut t, mut f, 300)
    ok(mut t, request != 0, "sent")
    ok(
        mut t,
        highlight_dispatch(
            mut f,
            request,
            "\"result\":[{range_member(0, 3, 2)},{range_member(4, 5, 3)}]",
        ),
        "answered",
    )
    let w = f.ed.win
    ok(mut t, f.ed.wins[w].lsp_highlight.read.len == 1, "one read")
    ok(
        mut t,
        f.ed.wins[w].lsp_highlight.read[0].lo == 0 && f.ed.wins[w].lsp_highlight.read[0].hi == 3,
        "read 0..3",
    )
    ok(mut t, f.ed.wins[w].lsp_highlight.write.len == 1, "one write")
    ok(
        mut t,
        f.ed.wins[w].lsp_highlight.write[0].lo == 4 && f.ed.wins[w].lsp_highlight.write[0].hi == 5,
        "write 4..5",
    )
    ok(mut t, f.ed.wins[w].overlay.spans.len == 0, "the search overlay untouched")
    highlight_finish(mut t, mut f)
}

// test_lsp_life.c:1030-1066
fn lsp_lifecycle_document_highlight_edit_clears_and_cancels_stale_response(
    mut t: Tally,
    helper: str,
) {
    var f = highlight_ready(mut t, helper, "hl-edit")
    let k = server(f)
    let request = highlight_fire(mut t, mut f, 300)
    ok(
        mut t,
        highlight_dispatch(mut f, request, "\"result\":[{range_member(0, 3, 2)}]"),
        "answered",
    )
    ok(mut t, f.ed.wins[f.ed.win].lsp_highlight.read.len == 1, "one read")
    set_cursor(mut f, 1)
    let stale = highlight_fire(mut t, mut f, 300)
    ok(mut t, stale != 0, "a second request")
    let live = lsp.rpc_pending(f.ed.lsp.servers[k].rpc, stale) else lsp.rpc_pending_new()
    ok(mut t, live.id == stale, "pending")
    // The edit, before its finish: C's notify hook clears and cancels.
    let w = f.ed.win
    ok(mut t, edit.ed_edit_insert(mut f.ed, w, 0, pb(" "), 0, 1), "inserted")
    ok(mut t, f.ed.wins[w].lsp_highlight.read.len == 0, "reads cleared")
    ok(mut t, f.ed.wins[w].lsp_highlight.write.len == 0, "writes cleared")
    ok(mut t, f.ed.wins[w].lsp_highlight.request == 0, "the request forgotten")
    let gone = lsp.rpc_pending(f.ed.lsp.servers[k].rpc, stale) else lsp.rpc_pending_new()
    ok(mut t, gone.id == 0, "the request cancelled")
    ok(
        mut t,
        !highlight_dispatch(mut f, stale, "\"result\":[{range_member(0, 1, 3)}]"),
        "the late answer dropped",
    )
    ok(mut t, f.ed.wins[w].lsp_highlight.write.len == 0, "still no writes")
    edit.ed_finish_edit(mut f.ed, w)
    highlight_finish(mut t, mut f)
}

// test_lsp_life.c:1068-1102
fn lsp_lifecycle_document_highlight_cursor_rearm_rejects_stale_response(mut t: Tally, helper: str) {
    var f = highlight_ready(mut t, helper, "hl-rearm")
    let stale = highlight_fire(mut t, mut f, 300)
    ok(mut t, stale != 0, "sent")
    set_cursor(mut f, 1)
    edit.lsp_highlight_cursor(mut f.ed, f.ed.win)
    ok(mut t, f.ed.wins[f.ed.win].lsp_highlight.request == 0, "the request forgotten")
    ok(mut t, f.ed.wins[f.ed.win].lsp_highlight.timer != edit.TIMER_NONE, "re-armed")
    ok(
        mut t,
        !highlight_dispatch(mut f, stale, "\"result\":[{range_member(0, 3, 2)}]"),
        "the stale answer dropped",
    )
    ok(mut t, f.ed.wins[f.ed.win].lsp_highlight.read.len == 0, "no reads")
    f.ed.now_ms += 300
    edit.ed_timers_fire(mut f.ed, f.ed.now_ms)
    let current = f.ed.wins[f.ed.win].lsp_highlight.request
    ok(mut t, current != 0 && current != stale, "a new request")
    ok(
        mut t,
        highlight_dispatch(mut f, current, "\"result\":[{range_member(4, 5, 3)}]"),
        "answered",
    )
    ok(mut t, f.ed.wins[f.ed.win].lsp_highlight.write.len == 1, "one write")
    highlight_finish(mut t, mut f)
}

// test_lsp_life.c:1104-1132
fn lsp_lifecycle_document_highlight_focus_return_rearms(mut t: Tally, helper: str) {
    var f = highlight_ready(mut t, helper, "hl-focus")
    let w = f.ed.win
    let stale = highlight_fire(mut t, mut f, 300)
    ok(mut t, stale != 0, "sent")
    f.ed.win = -1
    ok(mut t, highlight_dispatch(mut f, stale, "\"result\":[{range_member(0, 3, 2)}]"), "delivered")
    ok(mut t, f.ed.wins[w].lsp_highlight.request == 0, "forgotten")
    ok(mut t, !f.ed.wins[w].lsp_highlight.cursor_valid, "the cursor forgotten")
    ok(mut t, f.ed.wins[w].lsp_highlight.read.len == 0, "no reads while unfocused")
    f.ed.win = w
    edit.lsp_highlight_cursor(mut f.ed, w)
    ok(mut t, f.ed.wins[w].lsp_highlight.timer != edit.TIMER_NONE, "re-armed on return")
    f.ed.now_ms += 300
    edit.ed_timers_fire(mut f.ed, f.ed.now_ms)
    let current = f.ed.wins[w].lsp_highlight.request
    ok(mut t, current != 0 && current != stale, "a new request")
    ok(mut t, highlight_dispatch(mut f, current, "\"result\":[]"), "answered")
    highlight_finish(mut t, mut f)
}

