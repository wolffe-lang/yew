//! member: false
//!
//! The port of sagitta `tests/unit/test_lsp_life.c` (1,794 lines) at
//! 9ace98c2 from `:205` on, one test per C test in file order; its first
//! five (the lifecycle, root and table cases, `:47-203`) are
//! `src/lsp_client_test.lu`'s.
//!
//! **The fixture is a real server.** C's `life_fix_init` (`:356-394`)
//! writes a file, opens it, and starts C's `fakelsp` in a mode through
//! the client's own start; so does this one, through the port's
//! `LspServer` and job, against the oracle's build of the helper
//! (`edit.fakelsp_path`). `life_pump_once` (`:419-434`) is
//! `edit.ed_pump_jobs_once`. Without the helper each case that spawns it
//! SKIPs by name ("fakelsp is missing") and the file exits 0; `tools/
//! check-test --fakelsp-ran` refuses any such line. Scratch files live
//! under `$TMPDIR` (else the root's `target/tests`), never by a relative
//! path, not C's `/tmp`.
//!
//! **C's test callback.** The stale cases count calls of `stale_callback`
//! (`:195-203`); the port's callback is a kind matched in one place
//! (`lsp_pending_done`), reached only when `lsp_dispatch_response`
//! answers true, so "never called" is that answer false with the stale
//! count moved and the request gone.
//!
//! **RED by name.** The completion cases (`:663-738`) are yw11b1's
//! (R-yw11b-3): each asserts the port's refusal of `ed.lsp.complete` and
//! prints a RED line. `ed.syn.set` is Sprint 39's (yw10): the language
//! change case asserts that refusal, then the half C's handler runs for
//! the LSP (`yew_lsp_buffer_close`, `cmd.c:105-106`) and its transcript,
//! and prints a RED line.
//!
//! The per-case selector `YEW_LSP_LIFE_CASE=N` (0-based, 36 cases).

use edit
use lsp
use std.fs
use std.signal
use term
use text
use util

struct Tally {
    n: int,
}

// A failed check says what it was before the trap (a native trap prints
// only its site).
fn ok(mut t: Tally, cond: bool, what: str) {
    t.n += 1
    if !cond {
        eprint("assertion failed: {what}")
    }
    assert(cond, what)
}

fn pb(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn text_of(b: List[byte]) -> str {
    str_from_utf8(b) else "<not utf-8>"
}

fn parse(text: str) -> lsp.Json {
    var err = lsp.json_err_new()
    let j = lsp.json_parse(text.bytes(), 0, text.len, mut err) else {
        assert(false, "parse {text}: {err.msg}")
        return lsp.json_new()
    }
    j
}

// `bytes_contain` (`:1457-1468`), from byte `from`.
fn bytes_contain(bytes: List[byte], from: int, needle: str) -> bool {
    let nb = needle.bytes()
    var i = from
    while i + nb.len <= bytes.len {
        var hit = true
        var k = 0
        while k < nb.len {
            if bytes[i + k] != nb[k] {
                hit = false
                break
            }
            k += 1
        }
        if hit {
            return true
        }
        i += 1
    }
    false
}

// The scratch directory, always an absolute path. C's fixtures live
// under `/tmp` (`:358-359`), and `fakelsp` writes the marker's path into
// a `file://%s` URI (`fakelsp.c:338`, `:367`). From a relative path
// that URI has no `/` after `file://`, the client refuses it
// (`lsp.lsp_path_of_uri`), and the jump never opens the file. `$TMPDIR`
// when it is absolute, else the root's `target/tests`.
fn scratch_dir() -> str {
    let tmp = env_get("TMPDIR") else ""
    var base = tmp
    if tmp.len == 0 || !tmp.starts_with("/") {
        let cwd = os_cwd() else "."
        base = "{cwd}/target/tests"
    }
    fs.create_dir_all(base) else |_| {}
    base
}

// Whether a process of group `pgid` still exists (C's `kill(-pgid, 0)`):
// 1 yes, 0 no, -1 where the host has no /proc to ask
// (`src/edit_job_test.lu`'s, by value).
fn group_alive(pgid: int) -> int {
    let rows = fs_read_dir_entries("/proc") else |_| { return -1 }
    for row in rows {
        if row.len < 2 {
            continue
        }
        let raw_name = row[1..row.len]
        var digits = true
        for b in raw_name {
            if b as int < 48 || b as int > 57 {
                digits = false
            }
        }
        if !digits {
            continue
        }
        let name = str_from_utf8(raw_name) else |_| { continue }
        let stat = fs.read_text("/proc/{name}/stat") else |_| { continue }
        let close = stat.rfind(")") else -1
        if close < 0 {
            continue
        }
        let rest = stat[close + 2..].words()
        if rest.len >= 3 && rest[2] == "{pgid}" {
            return 1
        }
    }
    0
}

// `open_fd_count` (`:1286-1306`).
fn fd_count() -> int {
    let rows = fs_read_dir_entries("/dev/fd") else |_| { return -1 }
    rows.len
}

// ---- the bare server (C's memset LspServer) ---------------------------------

fn place_server(mut ed: edit.Ed) -> int {
    ed.lsp.present = true
    let sid = ed.lsp.next_id
    ed.lsp.next_id += 1
    let cfg = lsp.LspServerCfg {
        id: "fakelsp",
        lang: "c",
        cmd: "",
        args: List[str](),
        roots: List[str](),
        init_options: "",
        has_init_options: false,
        init_timeout_ms: 1000,
    }
    (mut ed.lsp.servers).push(edit.LspServer {
        id: sid,
        cfg: cfg,
        root: os_cwd() else ".",
        job: 0,
        rpc: lsp.rpc_conn_new(),
        rpc_live: true,
        life: lsp.lsp_life_new(),
        docv: List[lsp.LspDoc](),
        exit_sent: false,
        missing_warned: 0,
        dropped_stale: 0,
        shadow_request: 0,
        shadow_buf_id: 0,
        shadow_seq: 0,
    })
    sid
}

// test_lsp_life.c:205-251
fn lsp_lifecycle_drops_stale_response_before_callback(mut t: Tally) {
    var ed = edit.ed_new()
    edit.ed_open_memory(mut ed, pb("old"), "stale")
    let bi = ed.wins[ed.win].buf
    let sid = place_server(mut ed)
    let k = ed.lsp.servers.len - 1
    var p = lsp.rpc_pending_new()
    p.buf_id = ed.bufs[bi].id
    p.gen = ed.bufs[bi].ec.tb.gen + 1
    let id = lsp.rpc_call(mut ed.lsp.servers[k].rpc, "textDocument/hover", pb("{{}}"), p)
    let j = parse("{{\"jsonrpc\":\"2.0\",\"id\":{id},\"result\":{{}}}}")
    ok(mut t, !edit.lsp_dispatch_response(mut ed, sid, j, j.root), "dropped before the callback")
    ok(mut t, ed.lsp.servers[k].dropped_stale == 1, "one stale drop")
    let gone = lsp.rpc_pending(ed.lsp.servers[k].rpc, id) else lsp.rpc_pending_new()
    ok(mut t, gone.id == 0, "the request is gone")
}

// test_lsp_life.c:253-317
fn lsp_lifecycle_drops_every_stale_feature_response(mut t: Tally) {
    let methods = [
        "textDocument/completion",
        "completionItem/resolve",
        "textDocument/hover",
        "textDocument/signatureHelp",
        "textDocument/definition",
        "textDocument/declaration",
        "textDocument/typeDefinition",
        "textDocument/implementation",
        "textDocument/references",
        "textDocument/documentHighlight",
        "textDocument/documentSymbol",
        "textDocument/rename",
    ]
    var ed = edit.ed_new()
    edit.ed_open_memory(mut ed, pb("before"), "stale-every")
    let bi = ed.wins[ed.win].buf
    let sid = place_server(mut ed)
    let k = ed.lsp.servers.len - 1
    ed.lsp.servers[k].life.state = lsp.LSP_READY
    var p = lsp.rpc_pending_new()
    p.buf_id = ed.bufs[bi].id
    p.gen = ed.bufs[bi].ec.tb.gen
    var ids = List[int]()
    for m in methods {
        let id = lsp.rpc_call(mut ed.lsp.servers[k].rpc, m, pb("{{}}"), p)
        ok(mut t, id != 0, "{m}: an id")
        let live = lsp.rpc_pending(ed.lsp.servers[k].rpc, id) else lsp.rpc_pending_new()
        ok(mut t, live.id == id, "{m}: pending")
        (mut ids).push(id)
    }
    text.textbuf_insert(mut ed.bufs[bi].ec.tb, 0 as text.ByteOff, pb("x"))
    var i = 0
    while i < ids.len {
        let j = parse("{{\"jsonrpc\":\"2.0\",\"id\":{ids[i]},\"result\":null}}")
        ok(mut t, !edit.lsp_dispatch_response(mut ed, sid, j, j.root), "{methods[i]}: dropped")
        let gone = lsp.rpc_pending(ed.lsp.servers[k].rpc, ids[i]) else lsp.rpc_pending_new()
        ok(mut t, gone.id == 0, "{methods[i]}: gone")
        i += 1
    }
    ok(
        mut t,
        ed.lsp.servers[k].dropped_stale == methods.len,
        "every one stale: {ed.lsp.servers[k].dropped_stale}",
    )
}

// ---- the life fixture (`:319-661`) ------------------------------------------

struct LifeFix {
    ed: edit.Ed,
    path: str,
    marker: str,
    bi: int,
}

// A sanitizer worker can be descheduled while the restarted helper execs
// (`LIFE_RESTART_READY_TIMEOUT_MS`, `:333-336`).
const LIFE_RESTART_READY_TIMEOUT_MS: int = 10000

// `life_fix_init` (`:356-394`).
fn fix_init(helper: str, mode: str, timeout_ms: int, tag: str) -> LifeFix {
    let dir = scratch_dir()
    let path = "{dir}/yew-lsp-life-{os_pid()}-{tag}"
    let marker = "{dir}/yew-lsp-restart-{os_pid()}-{tag}"
    fs_write_bytes(path, pb("int x;\n")) else |_| {
        assert(false, "write {path}")
    }
    fs.remove(marker) else |_| {}
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    let idx = edit.tab_open(mut ed, path)
    assert(idx >= 0, "open {path}")
    assert(edit.tab_hydrate(mut ed, idx) == 0, "load {path}")
    edit.tab_switch(mut ed, idx)
    let bi = ed.wins[ed.win].buf
    ed.buf_languages[ed.bufs[bi].id] = "c"
    ed.now_ms = edit.now_ms()
    var args = List[str]()
    (mut args).push(mode)
    (mut args).push(marker)
    let cfg = lsp.LspServerCfg {
        id: "fakelsp",
        lang: "c",
        cmd: helper,
        args: args,
        roots: List[str](),
        init_options: "",
        has_init_options: false,
        init_timeout_ms: timeout_ms,
    }
    assert(edit.lsp_client_start_cfg(mut ed, bi, cfg), "start fakelsp {mode}")
    let (k, _) = edit.lsp_doc_of_buffer(ed, bi)
    assert(k >= 0, "the document attached")
    LifeFix { ed: ed, path: path, marker: marker, bi: bi }
}

// `life_fix_free` (`:396-406`): the editor's own LSP teardown, then the
// files.
fn fix_free(mut f: LifeFix) {
    edit.lsp_free(mut f.ed)
    fs.remove(f.path) else |_| {
        assert(false, "unlink {f.path}")
    }
    fs.remove(f.marker) else |_| {}
}

// `life_marker_write` (`:408-417`).
fn marker_write(f: LifeFix, body: str) {
    fs_write_bytes(f.marker, pb(body)) else |_| {
        assert(false, "write {f.marker}")
    }
}

fn pump(mut f: LifeFix) {
    edit.ed_pump_jobs_once(mut f.ed, 10)
}

// `life_server` (`:436-443`).
fn server(f: LifeFix) -> int {
    let (k, _) = edit.lsp_doc_of_buffer(f.ed, f.bi)
    assert(k >= 0, "LSP lifecycle fixture lost its document")
    k
}

fn doc(f: LifeFix) -> int {
    let (_, d) = edit.lsp_doc_of_buffer(f.ed, f.bi)
    assert(d >= 0, "LSP lifecycle fixture lost its document")
    d
}

fn sid(f: LifeFix) -> int {
    f.ed.lsp.servers[server(f)].id
}

// `wait_state` (`:445-456`).
fn wait_state(mut f: LifeFix, state: int, timeout_ms: int) -> bool {
    let start = edit.now_ms()
    while edit.now_ms() - start <= timeout_ms {
        if f.ed.lsp.servers[server(f)].life.state == state {
            return true
        }
        pump(mut f)
    }
    false
}

// `wait_panel_title` (`:470-484`).
fn wait_panel_title(mut f: LifeFix, title: str, timeout_ms: int) -> bool {
    let start = edit.now_ms()
    while edit.now_ms() - start <= timeout_ms {
        let w = f.ed.win
        if f.ed.wins[w].panel.open &&
            f.ed.wins[w].panel.has_title &&
            f.ed.wins[w].panel.title == title {
            return true
        }
        pump(mut f)
    }
    false
}

// `wait_message` (`:486-496`).
fn wait_message(mut f: LifeFix, message: str, timeout_ms: int) -> bool {
    let start = edit.now_ms()
    while edit.now_ms() - start <= timeout_ms {
        if f.ed.msg.active && f.ed.msg.text == message {
            return true
        }
        pump(mut f)
    }
    false
}

// `wait_capability_clear` (`:498-509`).
fn wait_capability_clear(mut f: LifeFix, cap: int, timeout_ms: int) -> bool {
    let start = edit.now_ms()
    while edit.now_ms() - start <= timeout_ms {
        if !lsp.lsp_caps_has(f.ed.lsp.servers[server(f)].life.caps, cap) {
            return true
        }
        pump(mut f)
    }
    false
}

// `wait_rpc_tx_empty` (`:511-521`).
fn wait_rpc_tx_empty(mut f: LifeFix, timeout_ms: int) -> bool {
    let start = edit.now_ms()
    while edit.now_ms() - start <= timeout_ms {
        if f.ed.lsp.servers[server(f)].rpc.tx.pending.len == 0 {
            return true
        }
        pump(mut f)
    }
    false
}

// `wait_current_path` (`:575-588`).
fn wait_current_path(mut f: LifeFix, path: str, timeout_ms: int) -> bool {
    let start = edit.now_ms()
    while edit.now_ms() - start <= timeout_ms {
        let d = edit.ed_doc(f.ed)
        if d >= 0 && f.ed.bufs[d].has_path && f.ed.bufs[d].path == path {
            return true
        }
        pump(mut f)
    }
    false
}

// `wait_picker_rows` (`:590-601`).
fn wait_picker_rows(mut f: LifeFix, rows: int, timeout_ms: int) -> bool {
    let start = edit.now_ms()
    while edit.now_ms() - start <= timeout_ms {
        if edit.picker_active(f.ed) && edit.picker_total(f.ed) == rows {
            return true
        }
        pump(mut f)
    }
    false
}

// `wait_drained` and `wait_server_drained` (`:633-661`): the server's job
// drained. The server's entry outlives its stop, so the two are one here.
fn wait_drained(mut f: LifeFix, timeout_ms: int) -> bool {
    let k = server(f)
    let start = edit.now_ms()
    while edit.now_ms() - start <= timeout_ms {
        let j = edit.job_find(f.ed, f.ed.lsp.servers[k].job)
        if j >= 0 && f.ed.jobs.v[j].drained {
            return true
        }
        pump(mut f)
    }
    false
}

// `wait_new_ready` (`:1556-1570`).
fn wait_new_ready(mut f: LifeFix, old_job: int, timeout_ms: int) -> bool {
    let start = edit.now_ms()
    while edit.now_ms() - start <= timeout_ms {
        let (k, d) = edit.lsp_doc_of_buffer(f.ed, f.bi)
        if k >= 0 &&
            d >= 0 &&
            f.ed.lsp.servers[k].job != old_job &&
            f.ed.lsp.servers[k].life.state == lsp.LSP_READY &&
            f.ed.lsp.servers[k].docv[d].open {
            return true
        }
        pump(mut f)
    }
    false
}

// `wait_restart_notice` (`:1622-1635`).
fn wait_restart_notice(mut f: LifeFix, restarts: int, timeout_ms: int) -> bool {
    let start = edit.now_ms()
    while edit.now_ms() - start <= timeout_ms {
        if f.ed.lsp.servers[server(f)].life.restarts == restarts && f.ed.msg.active {
            return true
        }
        pump(mut f)
    }
    false
}

// The server stopped and its job drained: every fakelsp case's ending.
fn stop_and_drain(mut t: Tally, mut f: LifeFix) {
    let k = server(f)
    edit.lsp_client_stop(mut f.ed, k, true)
    ok(mut t, wait_drained(mut f, 2000), "the server drained")
}

// The job's stderr: fakelsp's `seq:` transcript.
fn transcript_is(f: LifeFix, want: str) -> bool {
    let j = edit.job_find(f.ed, f.ed.lsp.servers[server(f)].job)
    j >= 0 && same(f.ed.jobs.v[j].framed_err, pb(want))
}

fn transcript_of(f: LifeFix) -> str {
    let j = edit.job_find(f.ed, f.ed.lsp.servers[server(f)].job)
    if j < 0 {
        return "<no job>"
    }
    text_of(f.ed.jobs.v[j].framed_err)
}

fn set_cursor(mut f: LifeFix, pos: int) {
    let w = f.ed.win
    let p = f.ed.wins[w].cs.primary
    f.ed.wins[w].cs.curs[p].pos = pos
    f.ed.wins[w].cs.curs[p].anchor = pos
}

fn cursor_pos(f: LifeFix) -> int {
    let w = f.ed.win
    f.ed.wins[w].cs.curs[f.ed.wins[w].cs.primary].pos
}

// C's `yew_ed_edit_ctx` + `yew_edit_insert` + `yew_ed_finish_edit`.
fn insert_front(mut f: LifeFix, s: str) -> bool {
    let w = f.ed.win
    let bytes = pb(s)
    let done = edit.ed_edit_insert(mut f.ed, w, 0, bytes, 0, bytes.len)
    edit.ed_finish_edit(mut f.ed, w)
    done
}

fn panel_size(mut f: LifeFix) {
    let w = f.ed.win
    f.ed.wins[w].rect = edit.rect(0, 0, 80, 24)
    f.ed.wins[w].vp.cols = 80
    f.ed.wins[w].vp.rows = 24
}

fn grid_up(mut f: LifeFix) {
    f.ed.grid = term.grid_new(24, 80)
    f.ed.grid_ready = true
}

fn jumps(f: LifeFix) -> int {
    text.jumplist_len(f.ed.wins[f.ed.win].jumps)
}

// ---- completion (yw11b1) ----------------------------------------------------

// The completion cases' half before yw11b1: the command refuses by name.
fn completion_red(mut t: Tally, name: str, cite: str) -> int {
    var ed = edit.ed_new()
    edit.ed_open_memory(mut ed, pb("int x;\n"), "complete.c")
    let id = edit.cmd_lookup(ed.reg, "ed.lsp.complete")
    ok(mut t, id != 0, "ed.lsp.complete is registered")
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    cx.count = 1
    ok(mut t, edit.ed_cmd_invoke(mut ed, id, mut cx) == edit.CMD_ERR_DEFERRED, "{name}: deferred")
    ok(
        mut t,
        ed.msg.text.starts_with("not yet ported: ed.lsp.complete: "),
        "{name}: by name: {ed.msg.text}",
    )
    print(
        "RED {name}: the completion menu, resolve and shadow completion ({cite}): sagitta Sprints 43-44 (yw11b1, R-yw11b-3)",
    )
    1
}

// ---- the panels (`:740-816`) ------------------------------------------------

// test_lsp_life.c:740-791
fn lsp_lifecycle_hover_signature_panels_and_auto_trigger(mut t: Tally, helper: str) {
    let hover = "**int** docs"
    let signature = "sum(int a, int b)"
    var f = fix_init(helper, "session-panels", 1000, "panels")
    panel_size(mut f)
    ok(mut t, wait_state(mut f, lsp.LSP_READY, 2000), "ready")
    let k = server(f)
    ok(mut t, lsp.lsp_caps_has(f.ed.lsp.servers[k].life.caps, lsp.LSPC_HOVER), "hover")
    ok(mut t, lsp.lsp_caps_has(f.ed.lsp.servers[k].life.caps, lsp.LSPC_SIGNATURE), "signature")
    ok(mut t, f.ed.lsp.servers[k].life.caps.sig_trigger == "(", "the trigger")

    ok(mut t, edit.lsp_hover(mut f.ed, f.ed.win), "hover sent")
    ok(mut t, wait_panel_title(mut f, "hover", 2000), "the hover panel")
    let w = f.ed.win
    ok(mut t, f.ed.wins[w].panel.place == edit.PANEL_BELOW, "below")
    ok(
        mut t,
        same(f.ed.wins[w].panel.body, pb(hover)),
        "the body: {text_of(f.ed.wins[w].panel.body)}",
    )
    ok(mut t, f.ed.wins[w].panel.mark_live, "the range marked")
    ok(mut t, f.ed.wins[w].panel.mark.lo == 0 && f.ed.wins[w].panel.mark.hi == 3, "0..3")
    ok(mut t, f.ed.wins[w].panel.mark_buf_id == f.ed.bufs[f.bi].id, "the buffer")
    ok(mut t, f.ed.wins[w].panel.mark_buf_gen == f.ed.bufs[f.bi].ec.tb.gen, "the generation")
    ok(
        mut t,
        f.ed.wins[w].panel.has_mark_role && f.ed.wins[w].panel.mark_role == "lsp.hover_range",
        "the role",
    )

    edit.lsp_signature_maybe_auto_trigger(mut f.ed, f.ed.win, pb("("))
    ok(mut t, f.ed.wins[f.ed.win].panel_source_request != 0, "signature sent")
    ok(mut t, wait_panel_title(mut f, "signature", 2000), "the signature panel")
    let w2 = f.ed.win
    ok(mut t, f.ed.wins[w2].panel.place == edit.PANEL_ABOVE, "above")
    ok(mut t, same(f.ed.wins[w2].panel.body, pb(signature)), "the label")
    ok(mut t, f.ed.wins[w2].panel.emph.len == 1, "one emphasis")
    ok(mut t, f.ed.wins[w2].panel.emph[0].lo == 4 && f.ed.wins[w2].panel.emph[0].hi == 9, "4..9")
    ok(mut t, !f.ed.wins[w2].panel.mark_live, "no range")

    ok(mut t, edit.lsp_hover(mut f.ed, f.ed.win), "hover again")
    ok(mut t, wait_message(mut f, "no hover information here", 2000), "nothing here")
    ok(mut t, !f.ed.wins[f.ed.win].panel.open, "closed")
    stop_and_drain(mut t, mut f)
    fix_free(mut f)
}

// test_lsp_life.c:793-816
fn lsp_lifecycle_method_not_found_clears_panel_capabilities(mut t: Tally, helper: str) {
    var f = fix_init(helper, "session-panel-missing", 1000, "panel-missing")
    panel_size(mut f)
    ok(mut t, wait_state(mut f, lsp.LSP_READY, 2000), "ready")
    let k = server(f)
    ok(mut t, lsp.lsp_caps_has(f.ed.lsp.servers[k].life.caps, lsp.LSPC_HOVER), "hover")
    ok(mut t, lsp.lsp_caps_has(f.ed.lsp.servers[k].life.caps, lsp.LSPC_SIGNATURE), "signature")
    ok(mut t, edit.lsp_hover(mut f.ed, f.ed.win), "hover sent")
    ok(mut t, wait_capability_clear(mut f, lsp.LSPC_HOVER, 2000), "hover cleared")
    ok(mut t, edit.lsp_signature(mut f.ed, f.ed.win), "signature sent")
    ok(mut t, wait_capability_clear(mut f, lsp.LSPC_SIGNATURE, 2000), "signature cleared")
    ok(mut t, !f.ed.wins[f.ed.win].panel.open, "no panel")
    stop_and_drain(mut t, mut f)
    fix_free(mut f)
}

