//! member: false
//!
//! The port of sagitta `tests/unit/test_statusline.c` (460 lines), one
//! test per C test in registry order (`tests/unit/registry.c:794-803`,
//! the git badge's row compiled in as the oracle's `YEW_WITH_FUSS` build
//! has it). C's fixture is a zeroed `Ed` over one buffer (two slots) and
//! one window (`status_fixture_init`, `test_statusline.c:28-52`); the
//! port's is `edit.ed_new` with that buffer and window pushed, and a
//! second buffer pushed where C raises `ws.nbufs` to 2.
//!
//! `statusline_git_badge_uses_cached_snapshot_rows` drives the git
//! cache's live snapshot (`yew_git_test_snapshot_mut` is `ed.git.snap
//! [ed.git.live]`), run whole since yw13. `statusline_recording_
//! indicator_is_pinned_and_counted` said SKIP until the recorder (yw09,
//! Sprints 35 and 38) gave `ed.rec` its state; it runs now.

use edit
use git
use term
use text
use unicode

fn str_of(b: List[byte]) -> str {
    str_from_utf8(b) else ""
}

fn buffer_of(t: str, path: str, id: int) -> edit.Buffer {
    var ec = text.editctx_new(take text.textbuf_from_str(t))
    ec.undo = text.undo_new(ec.tb)
    ec.has_undo = true
    text.undo_mark_saved(mut ec.undo, ec.tb)
    ec.meta = text.filemeta_new()
    ec.meta.eol = text.EOL_LF
    edit.Buffer {
        id: id,
        ec: ec,
        resident: true,
        path: path,
        has_path: true,
        name: "",
        has_name: false,
        flags: 0,
        tabwidth: 0,
        recovery_pending: false,
        pairs: edit.pairstate_new(),
        named: edit.named_marks_new(),
        macro_reg: 0,
    }
}

// `status_fixture_init` (`test_statusline.c:28-52`).
fn fixture(t: str, path: str) -> edit.Ed {
    var ed = edit.ed_new()
    (mut ed.bufs).push(buffer_of(t, path, 1))
    var w = edit.win_new(1, 0)
    edit.vp_init(mut w)
    w.vp.rows = 10
    w.vp.cols = 80
    (mut ed.wins).push(w)
    ed.win = 0
    ed.mode = edit.MODE_L
    ed.prev_unit = edit.MODE_L
    ed
}

fn build(mut ed: edit.Ed, cols: int) -> edit.StatusText {
    edit.statusline_build(mut ed, 0, cols)
}

fn contains(out: edit.StatusText, needle: str) -> bool {
    str_of(out.body).contains(needle)
}

fn t_gutter_number_styles_width_and_continuations() {
    assert(edit.gutter_width_for(1, edit.NUM_NONE) == 6, "NONE keeps the geometry")
    assert(edit.gutter_width_for(1, edit.NUM_ABS) == 6, "three digits at least")
    assert(edit.gutter_width_for(99, edit.NUM_HYBRID) == 6, "99 lines")
    assert(edit.gutter_width_for(100, edit.NUM_HYBRID) == 6, "100 lines")
    assert(edit.gutter_width_for(999, edit.NUM_REL) == 6, "999 lines")
    assert(edit.gutter_width_for(1000, edit.NUM_REL) == 7, "1000 lines take four digits")

    assert(edit.gutter_number(edit.NUM_ABS, 99, 99, false) == "100", "absolute")
    assert(edit.gutter_number(edit.NUM_REL, 99, 99, false) == "0", "relative on the cursor")
    assert(edit.gutter_number(edit.NUM_REL, 91, 99, false) == "8", "relative above")
    assert(edit.gutter_number(edit.NUM_HYBRID, 99, 99, false) == "100", "hybrid on the cursor")
    assert(edit.gutter_number(edit.NUM_HYBRID, 102, 99, false) == "3", "hybrid below")
    assert(edit.gutter_number(edit.NUM_ABS, 99, 99, true) == "", "a continuation row is blank")
    assert(edit.gutter_number(edit.NUM_NONE, 99, 99, false) == "", "NONE is blank")
}

fn t_statusline_metadata_position_percent_and_mode_chip() {
    let t = "\u{6f22}\u{5b57}\tx\ntwo\nthree\nfour\nfive\nsix\nseven\neight\nnine\nten\neleven\ntwelve\n"
    var ed = fixture(t, "/work/src/main.c")
    ed.bufs[0].ec.meta.exists = true
    ed.bufs[0].ec.meta.mode = 0o444
    ed.bufs[0].ec.meta.eol = text.EOL_MIXED
    ed.bufs[0].ec.meta.had_bom = true
    ed.bufs[0].ec.meta.binary = true
    ed.bufs[0].ec.meta.had_invalid_utf8 = true
    ed.wins[0].cs.curs[0].pos = 7
    ed.wins[0].cs.curs[0].anchor = 7
    ed.wins[0].vp.rows = 5
    ed.wins[0].vp.top = 2
    var out = build(mut ed, 200)
    assert(str_of(out.chip) == " L ", "the L chip")
    assert(contains(out, "main.c"), "the path")
    assert(contains(out, "[ro]"), "read-only")
    assert(contains(out, "utf-8 bin"), "binary")
    assert(contains(out, "mixed!"), "mixed line ends")
    assert(out.warn_len == 6, "the warning span is mixed!")
    assert(str_of(out.body[out.warn_at..out.warn_at + out.warn_len]) == "mixed!", "at warn_at")
    assert(contains(out, "bom"), "the BOM")
    assert(contains(out, "!utf8"), "invalid UTF-8")
    assert(contains(out, "1:4"), "line 1, grapheme column 4")
    assert(contains(out, "25%"), "25%")
    assert(out.chip_cells + out.body_cells == 200, "the row is filled")

    ed.wins[0].cs.curs[0].anchor = 0
    let p = ed.wins[0].cs.primary
    ed.wins[0].cs.selstacks[p].n = 1
    out = build(mut ed, 200)
    assert(contains(out, "1:4@1:1"), "a selection shows its anchor")
    ed.wins[0].cs.curs[0].anchor = ed.wins[0].cs.curs[0].pos
    ed.wins[0].cs.selstacks[p].n = 0

    ed.wins[0].vp.top = 0
    out = build(mut ed, 200)
    assert(contains(out, "top"), "top")
    ed.wins[0].vp.top = 8
    out = build(mut ed, 200)
    assert(contains(out, "bot"), "bot")
    ed.wins[0].vp.rows = 20
    out = build(mut ed, 200)
    assert(contains(out, "all"), "all")

    ed.mode = edit.MODE_H
    ed.prev_unit = edit.MODE_B
    ed.wins[0].h.from = edit.MODE_B
    ed.wins[0].h.unit = edit.UNIT_BLOCK
    out = build(mut ed, 200)
    assert(str_of(out.chip) == " H\u{b7}B ", "the H chip names its unit")
    assert(out.chip_cells == 5, "five cells")
    let added = text.cset_add(mut ed.wins[0].cs, text.cursor_at(11 as text.ByteOff))
    assert(added, "a second cursor")
    out = build(mut ed, 200)
    assert(contains(out, "\u{d7}2"), "the cursor count")
}

fn t_statusline_mixed_eol_uses_warning_attributes() {
    var ed = fixture("x\n", "main.c")
    ed.bufs[0].ec.meta.eol = text.EOL_MIXED
    ed.grid = term.grid_new(2, 80)
    ed.footer_rect = edit.rect(0, 1, 80, 1)
    let out = build(mut ed, 80)
    let prefix_cells = unicode.str_width(out.body, 0, out.warn_at, 4)
    assert(prefix_cells >= 0, "the prefix measures")
    let col = out.chip_cells + prefix_cells
    edit.statusline_draw(mut ed, 0)
    var i = 0
    while i < 6 {
        let cell = term.grid_back(ed.grid, 1, col + i)
        assert(cell.fg.tag == term.COLOR_INDEXED, "mixed! is indexed")
        assert(cell.fg.r == 214, "in the warning colour")
        assert(cell.attrs & term.ATTR_BOLD != 0, "bold")
        i += 1
    }
    assert(
        term.grid_back(ed.grid, 1, col - 1).attrs & term.ATTR_BOLD == 0,
        "the cell before is not bold",
    )
}

fn t_statusline_priority_drop_order_is_tiered() {
    var ed = fixture("x\n", "main.c")
    ed.bufs[0].ec.meta.exists = true
    ed.bufs[0].ec.meta.mode = 0o444
    ed.bufs[0].ec.meta.had_bom = true
    ed.bufs[0].ec.meta.had_invalid_utf8 = true
    ed.wins[0].vp.rows = 0

    var out = build(mut ed, 48)
    assert(!contains(out, "top"), "48: the percent dropped first")
    assert(contains(out, "[ro]"), "48: [ro]")
    assert(contains(out, "utf-8"), "48: utf-8")
    assert(contains(out, "bom"), "48: bom")
    assert(contains(out, "!utf8"), "48: !utf8")
    assert(contains(out, "1:1"), "48: the position")

    out = build(mut ed, 43)
    assert(!contains(out, "top"), "43: no percent")
    assert(!contains(out, "[ro]"), "43: [ro] next")
    assert(contains(out, "utf-8"), "43: utf-8")
    assert(contains(out, "bom"), "43: bom")
    assert(contains(out, "!utf8"), "43: !utf8")
    assert(contains(out, "1:1"), "43: the position")

    out = build(mut ed, 37)
    assert(!contains(out, "utf-8"), "37: the encoding tier")
    assert(!contains(out, " bom"), "37: with the BOM")
    assert(contains(out, "!utf8"), "37: !utf8 stays")
    assert(contains(out, "1:1"), "37: the position")

    out = build(mut ed, 21)
    assert(!contains(out, "!utf8"), "21: !utf8 goes")
    assert(contains(out, "1:1"), "21: the position stays")
    out = build(mut ed, 14)
    assert(!contains(out, "1:1"), "14: the position goes last")
    assert(contains(out, "main.c"), "14: the path stays")
}

// C sets `ed.rec.ev.len` (test_statusline.c:278, :286); the port's
// events are values, so `n` placeholder events stand for the count.
fn rec_events(mut ed: edit.Ed, n: int) {
    (mut ed.rec.ev).reset()
    for _ in 0..n {
        (mut ed.rec.ev).push(edit.RecEvent {
            cmd: 0,
            count: 0,
            count_given: false,
            bang: false,
            iarg: 0,
            range_lo: 0,
            range_hi: 0,
            sarg_at: 0,
            sarg_len: 0,
            mode: 0,
            src: 0,
            range_kind: 0,
            range_given: false,
        })
    }
}

fn t_statusline_recording_indicator_is_pinned_and_counted() {
    var ed = fixture("x\n", "/a/very/long/path/that/must/lose/to/recording.c")
    ed.rec.active = true
    ed.rec.reg = 'a' as int
    rec_events(mut ed, 9)
    var out = build(mut ed, 80)
    assert(str_of(out.recording) == "\u{25cf}REC a", "80: the full chip")
    assert(out.recording_cells == 6, "80: six cells")
    assert(out.chip_cells + out.recording_cells + out.body_cells == 80, "80: the row filled")

    rec_events(mut ed, 12)
    out = build(mut ed, 40)
    assert(str_of(out.recording) == "\u{25cf}REC a 12", "40: counted from 10")
    assert(str_of(out.recording).contains("a"), "40: the register")
    assert(out.chip_cells + out.recording_cells + out.body_cells <= 40, "40: within the row")

    out = build(mut ed, 5)
    assert(str_of(out.recording) == "\u{25cf}a", "5: the short form")
    assert(out.recording_cells == 2, "5: two cells")
}

fn t_statusline_unicode_path_elision_uses_cells() {
    let first = "/work/alpha/\u{6f22}\u{1f642}.c"
    let second = "/other/beta/\u{6f22}\u{1f642}.c"
    var ed = fixture("x\n", first)
    (mut ed.bufs).push(buffer_of("", second, 2))
    var out = build(mut ed, 15)
    var width = unicode.str_width(out.body, 0, out.body.len, 4)
    assert(width >= 0, "the body measures")
    assert(width == out.body_cells, "body_cells is the body's width")
    assert(out.chip_cells + out.body_cells <= 15, "within 15 cells")
    assert(contains(out, "\u{2026}"), "elided")
    assert(contains(out, "\u{6f22}"), "the wide glyph kept whole")
    assert(contains(out, "\u{1f642}"), "the emoji kept whole")

    out = build(mut ed, 10)
    width = unicode.str_width(out.body, 0, out.body.len, 4)
    assert(width >= 0, "the body measures")
    assert(out.chip_cells + width <= 10, "within 10 cells")
    assert(contains(out, "\u{2026}"), "elided")

    ed.bufs[0].path = "/a/alpha_long/edit/keymap.c"
    ed.bufs[1].path = "/b/beta_long/edit/keymap.c"
    out = build(mut ed, 22)
    assert(contains(out, "\u{2026}/edit/keymap.c"), "the shortest unambiguous suffix, elided")

    var long = List[byte]()
    var i = 0
    while i < 1500 {
        (mut long).push(112 as byte)
        i += 1
    }
    ed.bufs[0].path = str_of(long)
    let _ = (mut ed.bufs).pop()
    out = build(mut ed, 2000)
    assert(out.chip_cells + out.body_cells == 2000, "the row is filled")
    assert(out.body.len > 1024, "a long path is not capped at 1 KiB")
}

fn t_statusline_mode_roles_are_fixed_and_distinct() {
    var styles = List[edit.UiStyle]()
    var i = 0
    while i < edit.MODE_N {
        let s = edit.statusline_mode_style(i)
        assert(s.chip_bg.tag == term.COLOR_RGB, "mode {i}: an RGB chip")
        assert(s.row_bg.tag == term.COLOR_RGB, "mode {i}: an RGB row")
        assert(s.attrs & term.ATTR_BOLD != 0, "mode {i}: bold")
        assert(!term.color_equal(s.chip_bg, s.row_bg), "mode {i}: chip unlike row")
        (mut styles).push(s)
        i += 1
    }
    i = 0
    while i < edit.MODE_N {
        var j = i + 1
        while j < edit.MODE_N {
            assert(
                !term.color_equal(styles[i].chip_bg, styles[j].chip_bg),
                "modes {i} and {j}: distinct chips",
            )
            assert(
                !term.color_equal(styles[i].row_bg, styles[j].row_bg),
                "modes {i} and {j}: distinct rows",
            )
            j += 1
        }
        i += 1
    }
}

// A span of the live snapshot's pool holding `t`.
fn snap_str(mut ed: edit.Ed, t: str) -> (int, int) {
    let s = ed.git.live
    let b = t.bytes()
    let at = git.git_pool_add(mut ed.git.snap[s].pool, b, 0, b.len)
    (at, b.len)
}

// `test_statusline.c:369-450`.
fn t_statusline_git_badge_uses_cached_snapshot_rows() {
    var ed = fixture("x\n", "main.c")
    let s = ed.git.live
    ed.git.snap[s].gen = 1
    ed.git.snap[s].state = git.GIT_OK
    let (ba, bl) = snap_str(mut ed, "trunk")
    ed.git.snap[s].branch_at = ba
    ed.git.snap[s].branch_len = bl
    ed.git.snap[s].has_branch = true
    let (ua, ul) = snap_str(mut ed, "origin/trunk")
    ed.git.snap[s].upstream_at = ua
    ed.git.snap[s].upstream_len = ul
    ed.git.snap[s].has_upstream = true
    ed.git.snap[s].ahead = 2
    ed.git.snap[s].behind = 1
    var out = build(mut ed, 160)
    assert(contains(out, "\u{2387} trunk \u{2191}2 \u{2193}1"), "branch and divergence")

    ed.git.snap[s].ahead = 0
    ed.git.snap[s].behind = 0
    out = build(mut ed, 160)
    assert(contains(out, "\u{2387} trunk"), "the branch")
    assert(!contains(out, "\u{2191}"), "no ahead")
    assert(!contains(out, "\u{2193}"), "no behind")

    ed.git.snap[s].has_upstream = false
    ed.git.snap[s].state = git.GIT_MID_MERGE
    out = build(mut ed, 160)
    assert(contains(out, "\u{2387} trunk|MERGING"), "merging")

    ed.git.snap[s].state = git.GIT_MID_REBASE
    ed.git.snap[s].rebase_step = 3
    ed.git.snap[s].rebase_total = 7
    ed.git.snap[s].conflicted = true
    ed.git.snap[s].conflict_count = 2
    out = build(mut ed, 160)
    assert(contains(out, "\u{2387} trunk|REBASE 3/7 \u{2691}2"), "rebase step and conflicts")

    ed.git.snap[s].state = git.GIT_MID_CHERRY_PICK
    ed.git.snap[s].conflicted = false
    ed.git.snap[s].conflict_count = 0
    out = build(mut ed, 160)
    assert(contains(out, "\u{2387} trunk|CHERRY-PICKING"), "cherry-picking")

    ed.git.snap[s].state = git.GIT_MID_REVERT
    out = build(mut ed, 160)
    assert(contains(out, "\u{2387} trunk|REVERTING"), "reverting")

    ed.git.snap[s].state = git.GIT_MID_BISECT
    out = build(mut ed, 160)
    assert(contains(out, "\u{2387} trunk|BISECTING"), "bisecting")

    ed.git.snap[s].state = git.GIT_DETACHED
    ed.git.snap[s].detached = true
    let (ha, hl) = snap_str(mut ed, "a1b2c3d4e5f6")
    ed.git.snap[s].head_at = ha
    ed.git.snap[s].head_len = hl
    ed.git.snap[s].has_head_oid = true
    out = build(mut ed, 160)
    assert(contains(out, "\u{2387} (a1b2c3)"), "detached: six bytes of the oid")

    ed.git.snap[s].state = git.GIT_NO_HEAD
    ed.git.snap[s].detached = false
    ed.git.snap[s].unborn = true
    out = build(mut ed, 160)
    assert(contains(out, "\u{2387} (no commits)"), "unborn")

    ed.git.snap[s].state = git.GIT_NOT_REPO
    ed.git.snap[s].unborn = false
    out = build(mut ed, 160)
    assert(!contains(out, "\u{2387}"), "no badge outside a repository")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_gutter_number_styles_width_and_continuations()
    t_statusline_metadata_position_percent_and_mode_chip()
    t_statusline_mixed_eol_uses_warning_attributes()
    t_statusline_priority_drop_order_is_tiered()
    t_statusline_recording_indicator_is_pinned_and_counted()
    t_statusline_unicode_path_elision_uses_cells()
    t_statusline_mode_roles_are_fixed_and_distinct()
    t_statusline_git_badge_uses_cached_snapshot_rows()
    print("statusline_test: 8 cases run")
}
