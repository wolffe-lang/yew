//! member: false
//!
//! The port of sagitta `tests/unit/test_cursor.c` (440 lines), one test per
//! C test in registry order (`tests/unit/registry.c:315-326`). C's
//! `UINT64_MAX` goal is `text.CCOL_EOL`, `YEW_CCOL_HERE` is
//! `text.CCOL_HERE`.

use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn buf(s: str) -> text.TextBuf {
    text.textbuf_from_str(s)
}

// `cursor_at`, `test_cursor.c:5-15`: the goal measured at the caret.
fn at(tb: text.TextBuf, off: int) -> text.Cursor {
    let line = text.textbuf_line_of(tb, text.byteoff(off))
    let sp = text.textbuf_line_span(tb, line)
    var c = text.cursor_at(text.byteoff(off))
    c.goal_col = text.off_to_ccol(tb, sp, text.byteoff(off), 4) as int
    c
}

fn assert_boundary(tb: text.TextBuf, c: text.Cursor) {
    assert(c.pos <= text.textbuf_len(tb), "pos inside")
    assert(text.is_grapheme_boundary(tb, text.byteoff(c.pos)), "pos on a boundary")
    assert(c.anchor <= text.textbuf_len(tb), "anchor inside")
    assert(text.is_grapheme_boundary(tb, text.byteoff(c.anchor)), "anchor on a boundary")
}

fn goal(tb: text.TextBuf, c: text.Cursor) -> int {
    text.cursor_goal(tb, c, 4) as int
}

fn t_cursor_horizontal_graphemes() {
    var tb = buf("Ae\u{0301}\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}\r\nZ")
    let boundaries = [0, 1, 4, 29, 31, 32]
    var c = at(tb, 0)
    var i = 1
    while i < 6 {
        text.cursor_right(tb, mut c)
        assert(c.pos == boundaries[i], "right {i}")
        assert(c.anchor == c.pos, "anchor follows")
        assert_boundary(tb, c)
        i += 1
    }
    text.cursor_right(tb, mut c)
    assert(c.pos == 32, "stays at the end")
    i = 5
    while i > 0 {
        text.cursor_left(mut tb, mut c)
        assert(c.pos == boundaries[i - 1], "left {i}")
        assert_boundary(tb, c)
        i -= 1
    }
    text.cursor_left(mut tb, mut c)
    assert(c.pos == 0, "stays at 0")
    text.textbuf_free(mut tb)
}

fn t_cursor_vertical_sticky_goal() {
    var tb = buf("abcdef\nx\nabcdef")
    var c = at(tb, 5)
    assert(c.goal_col == 5, "goal 5")
    text.cursor_down(tb, mut c, 4)
    assert(c.pos == 8 && c.goal_col == 5, "down to 8")
    text.cursor_down(tb, mut c, 4)
    assert(c.pos == 14 && c.goal_col == 5, "down to 14")
    text.cursor_up(tb, mut c, 4)
    assert(c.pos == 8 && c.goal_col == 5, "up to 8")
    text.cursor_up(tb, mut c, 4)
    assert(c.pos == 5 && c.goal_col == 5, "up to 5")
    text.cursor_up(tb, mut c, 4)
    assert(c.pos == 5, "top stays")
    assert_boundary(tb, c)
    text.textbuf_free(mut tb)
}

fn t_cursor_horizontal_resolves_vertical_clamp() {
    var tb = buf("abcdef\nxy")
    var c = at(tb, 5)
    text.cursor_down(tb, mut c, 4)
    assert(c.pos == 9 && c.goal_col == 5, "after the y")
    text.cursor_right(tb, mut c)
    assert(c.pos == 9, "end stays")
    assert(goal(tb, c) == 2, "goal 2")
    text.cursor_left(mut tb, mut c)
    assert(c.pos == 8, "left to 8")
    assert(goal(tb, c) == 1, "goal 1")
    assert_boundary(tb, c)
    text.textbuf_free(mut tb)
}

fn t_cursor_horizontal_recomputes_cross_line_and_edges() {
    let s = "abcdef\nabcdefghij"
    var tb = buf(s)
    var c = at(tb, 7)
    text.cursor_left(mut tb, mut c)
    assert(c.pos == 6, "left to 6")
    assert(goal(tb, c) == 6, "goal 6")
    text.cursor_down(tb, mut c, 4)
    assert(c.pos == 13, "down to 13")
    c.pos = 0
    c.anchor = 0
    c.goal_col = 99
    text.cursor_left(mut tb, mut c)
    assert(c.pos == 0 && goal(tb, c) == 0, "left edge")
    c.pos = s.len
    c.anchor = s.len
    c.goal_col = 99
    text.cursor_right(tb, mut c)
    assert(c.pos == s.len && goal(tb, c) == 10, "right edge")
    text.textbuf_free(mut tb)
}

fn t_cursor_home_end_and_crlf() {
    let s = "abc\r\nq\r\nlast"
    var tb = buf(s)
    var c = at(tb, 1)
    text.cursor_line_end(mut tb, mut c)
    assert(c.pos == 3 && c.goal_col == text.CCOL_EOL, "end of line 0")
    text.cursor_down(tb, mut c, 4)
    assert(c.pos == 6 && c.goal_col == text.CCOL_EOL, "end of line 1")
    text.cursor_down(tb, mut c, 4)
    assert(c.pos == 12 && c.goal_col == text.CCOL_EOL, "after the t")
    text.cursor_line_home(tb, mut c)
    assert(c.pos == 8 && c.goal_col == 0, "home")
    text.cursor_buf_end(tb, mut c)
    assert(c.pos == s.len && c.goal_col == text.CCOL_EOL, "buffer end")
    text.cursor_left(mut tb, mut c)
    assert(c.pos == s.len - 1 && goal(tb, c) == 3, "left from the end")
    text.cursor_buf_home(mut c)
    assert(c.pos == 0 && c.goal_col == 0, "buffer home")
    assert_boundary(tb, c)
    text.textbuf_free(mut tb)
}

fn t_cursor_clamp_repairs_new_cluster() {
    var tb = buf("eX")
    var c = at(tb, 1)
    text.textbuf_insert_str(mut tb, text.byteoff(1), "\u{0301}")
    assert(!text.is_grapheme_boundary(tb, text.byteoff(c.pos)), "not a boundary")
    text.cursor_clamp(tb, mut c)
    assert(c.pos == 0 && c.anchor == 0, "clamped to 0")
    assert_boundary(tb, c)
    c.pos = 2
    c.anchor = 2
    text.cursor_clamp(tb, mut c)
    assert(c.pos == 0 && c.anchor == 0, "inside the mark")
    c.pos = text.CCOL_EOL
    c.anchor = text.CCOL_EOL
    text.cursor_clamp(tb, mut c)
    assert(c.pos == 4 && c.anchor == 4, "past the end")
    assert_boundary(tb, c)
    text.textbuf_free(mut tb)
}

fn t_cursor_motion_preserves_selection_anchor() {
    var tb = buf("abc\ndef")
    var c = at(tb, 2)
    c.anchor = 0
    text.cursor_right(tb, mut c)
    assert(c.pos == 3 && c.anchor == 0, "right keeps anchor")
    text.cursor_down(tb, mut c, 4)
    assert(c.anchor == 0, "down keeps anchor")
    text.cursor_line_home(tb, mut c)
    assert(c.pos == 4 && c.anchor == 0, "home keeps anchor")
    assert_boundary(tb, c)
    text.textbuf_free(mut tb)
}

fn cursor_rng(s: wrapping[u64]) -> wrapping[u64] {
    var x = s
    x = x ^ x << 13
    x = x ^ x >> 7
    x = x ^ x << 17
    x
}

fn below(x: wrapping[u64], n: int) -> int {
    (x % n as wrapping[u64]) as int
}

fn t_cursor_motion_fuzz_four_seeds() {
    let s = "alpha e\u{0301} omega\r\n\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}\n\u{6F22}\tend\nshort"
    var seeds = List[wrapping[u64]]()
    (mut seeds).push(1)
    (mut seeds).push(2611923443488327891)
    (mut seeds).push(11400714819323198485)
    (mut seeds).push(15111065706836454659)
    let payloads = [bytes_of("x"), bytes_of("\u{0301}"), bytes_of("\r\n"), bytes_of("\u{6F22}")]
    for seed in seeds {
        var tb = buf(s)
        var c = at(tb, 0)
        var state = seed
        var i = 0
        while i < 10000 {
            state = cursor_rng(state)
            let op = below(state, 10)
            if op == 0 {
                text.cursor_left(mut tb, mut c)
            } else if op == 1 {
                text.cursor_right(tb, mut c)
            } else if op == 2 {
                text.cursor_up(tb, mut c, 4)
            } else if op == 3 {
                text.cursor_down(tb, mut c, 4)
            } else if op == 4 {
                text.cursor_line_home(tb, mut c)
            } else if op == 5 {
                text.cursor_line_end(mut tb, mut c)
            } else if op == 6 {
                text.cursor_buf_home(mut c)
            } else if op == 7 {
                text.cursor_buf_end(tb, mut c)
            } else if op == 8 {
                state = cursor_rng(state)
                let which = below(state, 4)
                text.textbuf_insert(mut tb, text.byteoff(c.pos), payloads[which])
                text.cursor_clamp(tb, mut c)
            } else if c.pos < text.textbuf_len(tb) {
                let next = text.grapheme_next(tb, text.byteoff(c.pos)) as int
                assert(next > c.pos, "progress")
                text.textbuf_delete(mut tb, text.span(c.pos, next))
                text.cursor_clamp(tb, mut c)
            }
            assert_boundary(tb, c)
            i += 1
        }
        text.textbuf_free(mut tb)
    }
}

// `cursor_tab_indent`, `test_cursor.c:309-313`.
fn tab_indent() -> str {
    "    fn total\n\tvar acc = zero\n  \tmixed\n        wide"
}

fn t_cursor_vertical_goal_counts_tab_cells() {
    var tb = buf(tab_indent())
    var c = text.cursor_at(text.byteoff(13))
    text.cursor_right(tb, mut c)
    assert(c.pos == 14 && goal(tb, c) == 4, "on the v, cell 4")
    text.cursor_up(tb, mut c, 4)
    assert(c.pos == 4 && c.goal_col == 4, "up onto the f")
    assert_boundary(tb, c)
    text.cursor_down(tb, mut c, 4)
    assert(c.pos == 14, "back to the v")
    text.cursor_down(tb, mut c, 4)
    assert(c.pos == 32, "mixed indent")
    text.cursor_down(tb, mut c, 4)
    assert(c.pos == 42, "space indent")
    assert_boundary(tb, c)
    text.textbuf_free(mut tb)
}

fn t_cursor_vertical_goal_rounds_left_inside_a_tab() {
    var tb = buf(tab_indent())
    var c = text.cursor_at(text.byteoff(2))
    c.goal_col = 2
    text.cursor_down(tb, mut c, 4)
    assert(c.pos == 13, "onto the tab")
    assert_boundary(tb, c)
    text.cursor_down(tb, mut c, 4)
    assert(c.pos == 31, "the tab at 31")
    assert_boundary(tb, c)
    text.textbuf_free(mut tb)
}

fn t_cursor_vertical_goal_past_the_end_clamps_after_the_last() {
    var tb = buf(tab_indent())
    var c = text.cursor_at(text.byteoff(29))
    c.goal_col = 99
    text.cursor_down(tb, mut c, 4)
    assert(c.pos == 50, "after the last")
    assert_boundary(tb, c)
    text.textbuf_free(mut tb)
}

fn t_cursor_goal_is_lazy_until_a_vertical_motion() {
    var tb = buf("    abcdefgh\nx\n\tvar acc = zero")
    var c = text.cursor_at(text.byteoff(10))
    text.cursor_right(tb, mut c)
    assert(c.pos == 11, "right to 11")
    assert(c.goal_col == text.CCOL_HERE, "no number written")
    assert(goal(tb, c) == 11, "resolves to 11")
    text.cursor_down(tb, mut c, 4)
    assert(c.pos == 14 && c.goal_col == 11, "measured once")
    text.cursor_down(tb, mut c, 4)
    assert(c.pos == 23 && c.goal_col == 11, "kept")
    assert_boundary(tb, c)
    text.cursor_left(mut tb, mut c)
    assert(c.goal_col == text.CCOL_HERE, "dropped again")
    assert(goal(tb, c) == 10, "resolves to 10")
    text.textbuf_free(mut tb)
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_cursor_horizontal_graphemes()
    t_cursor_vertical_sticky_goal()
    t_cursor_horizontal_resolves_vertical_clamp()
    t_cursor_horizontal_recomputes_cross_line_and_edges()
    t_cursor_home_end_and_crlf()
    t_cursor_clamp_repairs_new_cluster()
    t_cursor_motion_preserves_selection_anchor()
    t_cursor_motion_fuzz_four_seeds()
    t_cursor_vertical_goal_counts_tab_cells()
    t_cursor_vertical_goal_rounds_left_inside_a_tab()
    t_cursor_vertical_goal_past_the_end_clamps_after_the_last()
    t_cursor_goal_is_lazy_until_a_vertical_motion()
    print("cursor_test: 12 cases pass")
}
