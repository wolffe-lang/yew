//! member: false
//!
//! The `:!` half of sagitta `tests/unit/test_cmdcomp.c` (`:907-1873`):
//! its eighteen cases in registry order (`tests/unit/registry.c:1163-
//! 1188`) — the $PATH executable source (Sprint 57.18 §2), the bang
//! query, and the SHELL dispatcher's routing, ranking, quoting and
//! redaction (57.23). The comp fork's `edit_cmdcomp_test` holds the
//! core thirteen. C's `ExecFixture` (`test_cmdcomp.c:911-998`) is a fresh
//! `/tmp/yew-cmdexec-*` root with `a/` and `b/`, the editor's workspace
//! root, and the caller's `$PATH` restored at the end. C's completion
//! statics are the editor's `Ed.comp` in the port, so C's global
//! `yew_comp_listing_invalidate()` is `comp_listing_invalidate(mut ed)`.
//!
//! It stats, lists and changes `$PATH`, and spawns nothing (the last case
//! proves it): it runs inside the container all the same (RULES §5).

use edit

fn b(s: str) -> List[byte] {
    edit.comp_bytes(s)
}

fn shown(t: List[byte]) -> str {
    str_from_utf8(t) else "<bytes>"
}

fn fresh_dir(prefix: str) -> str {
    var tries = 0
    while tries < 100 {
        var suffix = ""
        for r in os_random(6) {
            suffix = suffix + "{r % 10}"
        }
        let dir = "/tmp/{prefix}-{suffix}"
        fs_create_dir_mode(dir, 448) else |e| match e {
            exists => {
                tries += 1
                continue
            },
            denied => { assert(false, "mkdtemp denied") },
            invalid => { assert(false, "mkdtemp invalid") },
            not_found => { assert(false, "mkdtemp not found") },
            unsupported => { assert(false, "mkdtemp unsupported") },
            io => { assert(false, "mkdtemp io") },
        }
        return dir
    }
    assert(false, "mkdtemp exhausted")
    ""
}

/// C's `ExecFixture`.
struct Fix {
    root: str,
    a: str,
    b: str,
    saved_path: str,
    had_path: bool,
}

// `exec_fixture_init` (`test_cmdcomp.c:954-970`).
fn fix_init() -> (Fix, edit.Ed) {
    let path = env_get("PATH") else ""
    let had = env_get("PATH") else "\u{0}"
    let root = fresh_dir("yew-cmdexec")
    let f = Fix {
        root: root,
        a: "{root}/a",
        b: "{root}/b",
        saved_path: path,
        had_path: had != "\u{0}",
    }
    fs_create_dir_mode(f.a, 448) else |_| { assert(false, "mkdir a") }
    fs_create_dir_mode(f.b, 448) else |_| { assert(false, "mkdir b") }
    var ed = edit.ed_new()
    ed.ws_dir = root
    (f, ed)
}

// `exec_fixture_dispose` (`test_cmdcomp.c:972-985`).
fn fix_dispose(f: Fix, mut ed: edit.Ed) {
    edit.comp_listing_invalidate(mut ed)
    fs_remove_dir(f.a) else |_| { assert(false, "rmdir a") }
    fs_remove_dir(f.b) else |_| { assert(false, "rmdir b") }
    fs_remove_dir(f.root) else |_| { assert(false, "rmdir root") }
    if f.had_path {
        env_set("PATH", f.saved_path) else |_| {}
    } else {
        env_unset("PATH") else |_| {}
    }
    edit.comp_listing_invalidate(mut ed)
}

// `exec_mkexe` (`test_cmdcomp.c:921-934`).
fn mkexe(dir: str, name: str, mode: int) {
    let path = "{dir}/{name}"
    fs_write_bytes(path, b("#!/bin/sh\n")) else |_| { assert(false, "write {path}") }
    fs_set_mode(path, mode) else |_| { assert(false, "chmod {path}") }
}

fn rm(dir: str, name: str) {
    fs_remove("{dir}/{name}") else |_| { assert(false, "unlink {dir}/{name}") }
}

// `shell_touch` (`test_cmdcomp.c:1283-1292`).
fn touch(dir: str, name: str) {
    let path = "{dir}/{name}"
    fs_write_bytes(path, List[byte]()) else |_| { assert(false, "touch {path}") }
    fs_set_mode(path, 384) else |_| {}
}

// `exec_set_path` (`test_cmdcomp.c:944-952`).
fn set_path(mut ed: edit.Ed, value: str) {
    env_set("PATH", value) else |_| { assert(false, "setenv PATH") }
    edit.comp_listing_invalidate(mut ed)
}

fn find_item(items: List[edit.CompItem], t: str) -> int {
    var i = 0
    while i < items.len {
        if edit.comp_bytes_is(items[i].text, t) {
            return i
        }
        i += 1
    }
    -1
}

// `exec_query` (`test_cmdcomp.c:987-998`).
fn exec_query(stem: str) -> edit.CompQuery {
    let s = b(stem)
    edit.compquery_new(edit.COMP_EXEC, s, 0, s.len)
}

fn query(mut ed: edit.Ed, line: str) -> (bool, edit.CompQuery) {
    let lb = b(line)
    edit.comp_query(mut ed, lb, lb.len)
}

// The point's shell context of a query (C's `q.shell`).
fn pos_of(mut ed: edit.Ed, q: edit.CompQuery) -> int {
    let (ok, ctx) = edit.comp_shell_ctx_of(mut ed, q.shell_line, q.shell_cursor)
    assert(ok, "the query carries a shell context")
    ctx.pos
}

// `shell_rows` (`test_cmdcomp.c:1352-1368`): the SHELL rows for `line`
// (caret at its end) through a fresh live filter; -1 for no query.
fn shell_rows(mut ed: edit.Ed, line: str, mut rows: List[edit.CompItem]) -> (int, edit.CompQuery) {
    rows = List[edit.CompItem]()
    let (ok, q) = query(mut ed, line)
    if !ok {
        return (-1, q)
    }
    var filter = edit.compfilter_new()
    let total = edit.comp_filter_run(mut ed, mut filter, q, 0, mut rows)
    (total, q)
}

// `route_of` (`test_cmdcomp.c:1370-1381`).
fn route_of(body: str) -> (int, int, int) {
    let bb = b(body)
    let (ok, ctx) = edit.shctx_at(bb, bb.len)
    assert(ok, "lexes {body}")
    edit.comp_shell_route(ctx)
}

fn bit(k: int) -> int {
    edit.comp_src_bit(k)
}

// `test_cmdcomp_exec_lists_only_runnable_names` (`test_cmdcomp.c:1002-
// 1063`).
fn t_cmdcomp_exec_lists_only_runnable_names() {
    var (f, ed) = fix_init()
    mkexe(f.a, "chk-alpha", 448)
    mkexe(f.a, "chk-dup", 448)
    mkexe(f.a, "chk-plain", 384) // not executable
    mkexe(f.b, "chk-beta", 448)
    mkexe(f.b, "chk-dup", 448)
    let sub = "{f.a}/chk-dir"
    fs_create_dir_mode(sub, 448) else |_| { assert(false, "mkdir chk-dir") }
    set_path(mut ed, "{f.a}:{f.b}")
    var items = List[edit.CompItem]()
    let n = edit.comp_enumerate(mut ed, edit.COMP_EXEC, b("chk"), mut items)
    assert(n == 3, "three distinct names: {n}")
    assert(find_item(items, "chk-alpha") >= 0, "chk-alpha")
    assert(find_item(items, "chk-beta") >= 0, "chk-beta")
    assert(find_item(items, "chk-dup") >= 0, "chk-dup")
    assert(find_item(items, "chk-plain") < 0, "no exec bit: refused")
    assert(find_item(items, "chk-dir") < 0, "a searchable directory: refused")
    var seen = 0
    for it in items {
        if edit.comp_bytes_is(it.text, "chk-dup") {
            seen += 1
        }
    }
    assert(seen == 1, "deduplicated")
    let dup = find_item(items, "chk-dup")
    assert(items[dup].detail == f.a, "the first element won: {items[dup].detail}")
    assert(items[dup].kind == edit.COMP_EXEC, "an EXEC row")
    fs_remove_dir(sub) else |_| {}
    rm(f.a, "chk-alpha")
    rm(f.a, "chk-dup")
    rm(f.a, "chk-plain")
    rm(f.b, "chk-beta")
    rm(f.b, "chk-dup")
    fix_dispose(f, mut ed)
}

// `test_cmdcomp_exec_opendir_count_stays_bounded` (`test_cmdcomp.c:1066-
// 1132`): one opendir per $PATH element however many keystrokes follow,
// and a changed $PATH re-reads only its new element.
fn t_cmdcomp_exec_opendir_count_stays_bounded() {
    var (f, ed) = fix_init()
    var i = 0
    while i < 40 {
        let nm = if i < 10 then "chk0{i}" else "chk{i}"
        mkexe(f.a, nm, 448)
        i += 1
    }
    mkexe(f.b, "chkzz", 448)
    set_path(mut ed, "{f.a}:{f.b}")
    var filter = edit.compfilter_new()
    var items = List[edit.CompItem]()
    var before = edit.comp_listing_opendirs(ed)
    let _ = edit.comp_filter_run(mut ed, mut filter, exec_query("c"), 0, mut items)
    assert(items.len != 0, "c: rows")
    let _ = edit.comp_filter_run(mut ed, mut filter, exec_query("ch"), 0, mut items)
    let _ = edit.comp_filter_run(mut ed, mut filter, exec_query("chk"), 0, mut items)
    let _ = edit.comp_filter_run(mut ed, mut filter, exec_query("chk0"), 0, mut items)
    assert(items.len != 0, "chk0: rows")
    let d1 = edit.comp_listing_opendirs(ed) - before
    assert(d1 == 2, "two elements, two opendirs, four keystrokes: {d1}")
    env_set("PATH", "{f.a}:{f.b}:{f.root}") else |_| {}
    edit.comp_filter_invalidate(mut filter)
    before = edit.comp_listing_opendirs(ed)
    let _ = edit.comp_filter_run(mut ed, mut filter, exec_query("chk"), 0, mut items)
    let d2 = edit.comp_listing_opendirs(ed) - before
    assert(d2 == 1, "only the new element is read: {d2}")
    i = 0
    while i < 40 {
        rm(f.a, if i < 10 then "chk0{i}" else "chk{i}")
        i += 1
    }
    rm(f.b, "chkzz")
    fix_dispose(f, mut ed)
}

fn name3(i: int) -> str {
    if i < 10 then "chk00{i}" else if i < 100 then "chk0{i}" else "chk{i}"
}

// `test_cmdcomp_exec_slices_and_resumes` (`test_cmdcomp.c:1139-1203`). The
// port's clock is milliseconds (G8): a 1 us budget is spent at the first
// check, exactly the mechanism C's test drives.
fn t_cmdcomp_exec_slices_and_resumes() {
    var (f, ed) = fix_init()
    var i = 0
    while i < 600 {
        mkexe(if i < 300 then f.a else f.b, name3(i), 448)
        i += 1
    }
    set_path(mut ed, "{f.a}:{f.b}")
    var filter = edit.compfilter_new()
    var sliced = List[edit.CompItem]()
    let before = edit.comp_listing_opendirs(ed)
    let _ = edit.comp_filter_run(mut ed, mut filter, exec_query("chk"), 1, mut sliced)
    assert(edit.comp_listing_pending(ed), "a 1 us budget leaves the scan pending")
    assert(edit.comp_listing_opendirs(ed) - before <= 1, "the second element is not open yet")
    var slices = 0
    while edit.comp_listing_advance(mut ed, 1000) {
        slices += 1
        if slices >= 200 {
            break
        }
    }
    assert(slices < 200, "drains in under 200 slices: {slices}")
    assert(!edit.comp_listing_pending(ed), "drained")
    let d = edit.comp_listing_opendirs(ed) - before
    assert(d == 2, "one opendir per element for the whole scan: {d}")
    edit.comp_filter_invalidate(mut filter)
    let _ = edit.comp_filter_run(mut ed, mut filter, exec_query("chk"), 0, mut sliced)
    var whole = List[edit.CompItem]()
    let _ = edit.comp_enumerate(mut ed, edit.COMP_EXEC, b("chk"), mut whole)
    assert(whole.len != 0, "rows")
    assert(sliced.len == whole.len, "sliced {sliced.len} == whole {whole.len}")
    i = 0
    while i < sliced.len {
        assert(edit.comp_bytes_eq(sliced[i].text, whole[i].text), "row {i} agrees")
        i += 1
    }
    i = 0
    while i < 600 {
        rm(if i < 300 then f.a else f.b, name3(i))
        i += 1
    }
    fix_dispose(f, mut ed)
}

// `test_cmdcomp_bang_query_routes_exec_then_path` (`test_cmdcomp.c:1210-
// 1281`).
fn t_cmdcomp_bang_query_routes_exec_then_path() {
    var (f, ed) = fix_init()
    mkexe(f.a, "chk-runner", 448)
    mkexe(f.a, "chk spacey", 448)
    set_path(mut ed, f.a)
    let (ok, q) = query(mut ed, ":!chk")
    assert(ok, ":!chk queries")
    assert(q.kind == edit.COMP_SHELL, "through the SHELL dispatcher")
    assert(pos_of(mut ed, q) == edit.SH_POS_COMMAND, "COMMAND")
    assert(edit.comp_bytes_is(q.stem, "chk"), "stem chk")
    assert(q.replace.lo == 2 && q.replace.hi == 5, "replace 2..5: {q.replace.lo}..{q.replace.hi}")
    let (ok2, q2) = query(mut ed, ":!chk-runner sr")
    assert(ok2 && q2.kind == edit.COMP_SHELL, "word 1 queries")
    assert(pos_of(mut ed, q2) == edit.SH_POS_ARGUMENT, "ARGUMENT")
    assert(edit.comp_bytes_is(q2.stem, "sr"), "stem sr")
    let (ok3, q3) = query(mut ed, ":%!chk")
    assert(ok3 && q3.kind == edit.COMP_SHELL, ":%! routes")
    assert(pos_of(mut ed, q3) == edit.SH_POS_COMMAND, ":%! COMMAND")
    let (ok4, q4) = query(mut ed, ":r !chk")
    assert(ok4 && q4.kind == edit.COMP_SHELL, ":r ! routes")
    assert(pos_of(mut ed, q4) == edit.SH_POS_COMMAND, ":r ! COMMAND")
    let (ok5, q5) = query(mut ed, ":!!chk")
    assert(ok5 && q5.kind == edit.COMP_SHELL, ":!! routes")
    assert(pos_of(mut ed, q5) == edit.SH_POS_COMMAND, ":!! COMMAND")
    assert(edit.comp_bytes_is(q5.stem, "chk"), ":!! stem chk")
    assert(q5.replace.lo == 3, ":!! replace.lo 3: {q5.replace.lo}")
    let (ok6, _) = query(mut ed, ":theme dar")
    assert(!ok6, "an ordinary argument is not completed")
    var items = List[edit.CompItem]()
    let _ = edit.comp_enumerate(mut ed, edit.COMP_EXEC, b("chk s"), mut items)
    let sp = find_item(items, "\"chk spacey\"")
    assert(sp >= 0, "the spacey name comes back quoted")
    var line = b(":file.open ")
    for x in items[sp].text {
        (mut line).push(x)
    }
    let parsed = edit.cmd_parse(mut ed, line)
    assert(!parsed.err.set, "parses")
    assert(parsed.argv.len == 2, "two argv: {parsed.argv.len}")
    assert(edit.comp_bytes_is(parsed.argv[1], "chk spacey"), "retokenizes: {shown(parsed.argv[1])}")
    rm(f.a, "chk-runner")
    rm(f.a, "chk spacey")
    fix_dispose(f, mut ed)
}

// `test_cmdcomp_shell_filter_rekeys_on_context` (`test_cmdcomp.c:1308-
// 1349`): `ls gr` and `ls | gr` share head and pattern; the key differs.
fn t_cmdcomp_shell_filter_rekeys_on_context() {
    var (f, ed) = fix_init()
    mkexe(f.a, "grchk", 448)
    touch(f.root, "grfile")
    set_path(mut ed, f.a)
    var filter = edit.compfilter_new()
    var rows = List[edit.CompItem]()
    let (ok, q) = query(mut ed, ":!ls gr")
    assert(ok && q.kind == edit.COMP_SHELL, "ls gr")
    let _ = edit.comp_filter_run(mut ed, mut filter, q, 0, mut rows)
    assert(find_item(rows, "grfile") >= 0, "files")
    assert(find_item(rows, "grchk") < 0, "not executables")
    let (_, q2) = query(mut ed, ":!ls | gr")
    assert(edit.comp_bytes_is(q2.stem, "gr"), "stem gr")
    let _ = edit.comp_filter_run(mut ed, mut filter, q2, 0, mut rows)
    assert(find_item(rows, "grchk") >= 0, "executables after |")
    assert(find_item(rows, "grfile") < 0, "not files after |")
    let (_, q3) = query(mut ed, ":!ls gr")
    let _ = edit.comp_filter_run(mut ed, mut filter, q3, 0, mut rows)
    assert(find_item(rows, "grfile") >= 0, "files again")
    assert(find_item(rows, "grchk") < 0, "not executables again")
    fs_remove("{f.root}/grfile") else |_| {}
    rm(f.a, "grchk")
    fix_dispose(f, mut ed)
}

// `test_cmdcomp_shell_route_row1_none` (`test_cmdcomp.c:1386-1407`).
fn t_cmdcomp_shell_route_row1_none() {
    let (r1, s1, _) = route_of("ls # comm")
    assert(r1 == 1 && s1 == 0, "a comment: row 1, nothing")
    let (r2, _, _) = route_of("cat <<EO")
    assert(r2 == 1, "a heredoc delimiter")
    let (r3, _, _) = route_of("echo $(( 1 + ")
    assert(r3 == 1, "arithmetic")
    let (r4, s4, _) = route_of("case x in a) b")
    assert(r4 == 1 && s4 == 0, "a case body")
    var (f, ed) = fix_init()
    let (ok, _) = query(mut ed, ":!ls # comm")
    assert(!ok, "Tab stays a literal tab")
    fix_dispose(f, mut ed)
}

// `test_cmdcomp_shell_route_row2_variable` (`test_cmdcomp.c:1409-1447`).
fn t_cmdcomp_shell_route_row2_variable() {
    let (r1, s1, _) = route_of("echo $HO")
    assert(r1 == 2 && s1 == bit(edit.COMP_VAR), "$HO: VAR")
    let (r2, s2, _) = route_of("echo \"${{PA")
    assert(r2 == 2 && s2 == bit(edit.COMP_VAR), "\"${{PA: VAR")
    var (f, ed) = fix_init()
    env_set("YEW_S5723_VAR", "value") else |_| {}
    var rows = List[edit.CompItem]()
    let (_, q) = shell_rows(mut ed, ":!echo $YEW_S5723_V", mut rows)
    let it = find_item(rows, "YEW_S5723_VAR")
    assert(it >= 0, "the variable")
    assert(rows[it].kind == edit.COMP_VAR, "a VAR row")
    assert(rows[it].detail == "value", "its value: {rows[it].detail}")
    assert(rows[it].suffix.len == 0, "no suffix")
    assert(q.replace.lo == 8, "the name, after the $: {q.replace.lo}")
    let _ = shell_rows(mut ed, ":!echo \"${{YEW_S5723_V", mut rows)
    let it2 = find_item(rows, "YEW_S5723_VAR")
    assert(it2 >= 0, "the variable in ${{")
    assert(edit.comp_bytes_is(rows[it2].suffix, "}}\""), "suffix }}\": {shown(rows[it2].suffix)}")
    env_unset("YEW_S5723_VAR") else |_| {}
    fix_dispose(f, mut ed)
}

// `test_cmdcomp_shell_route_row3_user` (`test_cmdcomp.c:1450-1493`).
fn t_cmdcomp_shell_route_row3_user() {
    let (r1, s1, _) = route_of("cd ~ro")
    assert(r1 == 3 && s1 == bit(edit.COMP_USER), "cd ~ro: USER")
    let (r2, _, _) = route_of("~ro")
    assert(r2 == 3, "~ro: USER")
    let (r3, _, _) = route_of("cd \"~ro")
    assert(r3 != 3, "a quoted ~ is not")
    let (r4, _, _) = route_of("cd \\~ro")
    assert(r4 != 3, "an escaped ~ is not")
    var (f, ed) = fix_init()
    var rows = List[edit.CompItem]()
    let _ = shell_rows(mut ed, ":!cd ~roo", mut rows)
    let root = find_item(rows, "~root/")
    assert(root >= 0, "~root/")
    assert(rows[root].kind == edit.COMP_USER, "a USER row")
    assert(rows[root].is_dir, "a directory")
    assert(rows[root].detail.len != 0, "its home")
    let _ = shell_rows(mut ed, ":!cd ~", mut rows)
    assert(rows.len != 0, "accounts")
    var seen_underscore = false
    for r in rows {
        let underscore = r.ranked.len > 1 && r.ranked[1] as int == 95
        if underscore {
            seen_underscore = true
        } else {
            assert(!seen_underscore, "_daemon accounts after every other row")
        }
    }
    fix_dispose(f, mut ed)
}

// `test_cmdcomp_shell_route_row4_command_path` (`test_cmdcomp.c:1496-
// 1525`): the `./scr<Tab>` fix.
fn t_cmdcomp_shell_route_row4_command_path() {
    let (r1, s1, m1) = route_of("./scr")
    assert(r1 == 4 && s1 == bit(edit.COMP_PATH) && m1 == edit.PATH_EXEC_OR_DIR, "./scr")
    let (r2, _, _) = route_of("make && ./bu")
    assert(r2 == 4, "make && ./bu")
    let (r3, _, _) = route_of("..")
    assert(r3 == 4, "..")
    var (f, ed) = fix_init()
    mkexe(f.root, "scrrun", 448)
    touch(f.root, "scrdata")
    var rows = List[edit.CompItem]()
    let _ = shell_rows(mut ed, ":!./scr", mut rows)
    assert(find_item(rows, "./scrrun") >= 0, "the executable")
    assert(find_item(rows, "./scrdata") < 0, "not the data file")
    rm(f.root, "scrdata")
    rm(f.root, "scrrun")
    fix_dispose(f, mut ed)
}

// `test_cmdcomp_shell_route_row5_operand_path` (`test_cmdcomp.c:1528-
// 1546`).
fn t_cmdcomp_shell_route_row5_operand_path() {
    let (r1, s1, m1) = route_of("cat src/ma")
    assert(r1 == 5 && s1 == bit(edit.COMP_PATH) && m1 == edit.PATH_ANY, "cat src/ma")
    let (r2, _, _) = route_of("cat > out/lo")
    assert(r2 == 5, "a redirect")
    let (r3, _, _) = route_of("FOO=/usr/b")
    assert(r3 == 5, "an assignment")
    let (r4, _, _) = route_of("cat ~/x")
    assert(r4 == 5, "~/x")
    let (r5, _, m5) = route_of("cd src/")
    assert(r5 == 5 && m5 == edit.PATH_DIRS, "cd src/ keeps row 8's mask")
    let (r6, s6, _) = route_of("cat $HOME/x")
    assert(r6 == 0 && s6 == 0, "an active expansion offers nothing")
}

// `test_cmdcomp_shell_route_row6_flag` (`test_cmdcomp.c:1549-1577`).
fn t_cmdcomp_shell_route_row6_flag() {
    let (r1, s1, _) = route_of("rm -r")
    assert(r1 == 6 && s1 == 0, "rm -r: row 6, nothing")
    let (r2, _, _) = route_of("rm -- -r")
    assert(r2 == 9, "after --, an operand")
    var (f, ed) = fix_init()
    touch(f.root, "-rf")
    var rows = List[edit.CompItem]()
    let _ = shell_rows(mut ed, ":!rm -r", mut rows)
    assert(rows.len == 0, "never a file named -rf: {rows.len}")
    let _ = shell_rows(mut ed, ":!rm -- -r", mut rows)
    assert(find_item(rows, "-rf") >= 0, "-rf after --")
    rm(f.root, "-rf")
    fix_dispose(f, mut ed)
}

// `test_cmdcomp_shell_route_row7_command` (`test_cmdcomp.c:1580-1627`).
fn t_cmdcomp_shell_route_row7_command() {
    let (r1, s1, _) = route_of("ls | gr")
    assert(r1 == 7 && s1 == bit(edit.COMP_EXEC) | bit(edit.COMP_BUILTIN), "ls | gr")
    let (r2, _, _) = route_of("sudo -u root gi")
    assert(r2 == 7, "after sudo -u root")
    let (r3, _, _) = route_of("FOO=1 BAR=2 cm")
    assert(r3 == 7, "after assignments")
    var (f, ed) = fix_init()
    mkexe(f.a, "echo", 448)
    mkexe(f.a, "grchk", 448)
    set_path(mut ed, f.a)
    var rows = List[edit.CompItem]()
    let _ = shell_rows(mut ed, ":!ls | gr", mut rows)
    let it = find_item(rows, "grchk")
    assert(it >= 0 && rows[it].kind == edit.COMP_EXEC, "grchk, an EXEC row")
    let _ = shell_rows(mut ed, ":!ech", mut rows)
    var echoes = 0
    for r in rows {
        if edit.comp_bytes_is(r.ranked, "echo") {
            echoes += 1
            assert(r.kind == edit.COMP_BUILTIN, "the builtin shadows the binary")
            assert(r.detail == "builtin", "builtin")
        }
    }
    assert(echoes == 1, "one echo: {echoes}")
    let _ = shell_rows(mut ed, ":!ls; [", mut rows)
    let kw = find_item(rows, "[[")
    assert(kw >= 0 && rows[kw].detail == "keyword", "[[ bare, a keyword")
    rm(f.a, "echo")
    rm(f.a, "grchk")
    fix_dispose(f, mut ed)
}

// `test_cmdcomp_shell_route_row8_arg_defaults` (`test_cmdcomp.c:1630-
// 1676`).
fn t_cmdcomp_shell_route_row8_arg_defaults() {
    for line in ["cd x", "pushd x", "rmdir x", "mkdir x"] {
        let (r, s, m) = route_of(line)
        assert(r == 8 && s == bit(edit.COMP_PATH) && m == edit.PATH_DIRS, "{line}: dirs")
    }
    for line in ["which x", "type x", "whence x", "where x"] {
        let (r, s, _) = route_of(line)
        assert(r == 8 && s == bit(edit.COMP_EXEC) | bit(edit.COMP_BUILTIN), "{line}: execs")
    }
    var (f, ed) = fix_init()
    touch(f.root, "cdfile")
    let dir = "{f.root}/cddir"
    fs_create_dir_mode(dir, 448) else |_| { assert(false, "mkdir cddir") }
    var rows = List[edit.CompItem]()
    let _ = shell_rows(mut ed, ":!cd cd", mut rows)
    assert(find_item(rows, "cddir/") >= 0, "cd: the directory")
    assert(find_item(rows, "cdfile") < 0, "cd: not the file")
    let _ = shell_rows(mut ed, ":!cat cd", mut rows)
    assert(find_item(rows, "cddir/") >= 0, "cat: the directory")
    assert(find_item(rows, "cdfile") >= 0, "cat: the file")
    fs_remove_dir(dir) else |_| {}
    rm(f.root, "cdfile")
    fix_dispose(f, mut ed)
}

// `test_cmdcomp_shell_route_row9_operand` (`test_cmdcomp.c:1679-1694`).
fn t_cmdcomp_shell_route_row9_operand() {
    let (r1, s1, m1) = route_of("cat ou")
    assert(r1 == 9 && s1 == bit(edit.COMP_PATH) && m1 == edit.PATH_ANY, "cat ou")
    for line in ["cat > ou", "FOO=ba", "for f in a", "git st"] {
        let (r, _, _) = route_of(line)
        assert(r == 9, "{line}: row 9")
    }
}

// `test_cmdcomp_shell_prefix_ranking_git_st` (`test_cmdcomp.c:1697-1735`):
// shell reflexes are prefix reflexes.
fn t_cmdcomp_shell_prefix_ranking_git_st() {
    var (f, ed) = fix_init()
    for nm in ["stash", "status", "reset"] {
        mkexe(f.a, nm, 448)
        touch(f.root, nm)
    }
    set_path(mut ed, f.a)
    var rows = List[edit.CompItem]()
    let _ = shell_rows(mut ed, ":!st", mut rows)
    assert(rows.len == 2, ":!st: two rows, {rows.len}")
    assert(find_item(rows, "stash") >= 0 && find_item(rows, "status") >= 0, "stash, status")
    let _ = shell_rows(mut ed, ":!git st", mut rows)
    assert(rows.len == 2, ":!git st: two rows, {rows.len}")
    assert(find_item(rows, "reset") < 0, "never reset")
    let _ = shell_rows(mut ed, ":!git ST", mut rows)
    assert(rows.len == 2, ":!git ST: the case-insensitive prefixes, {rows.len}")
    let _ = shell_rows(mut ed, ":!git sts", mut rows)
    assert(find_item(rows, "status") >= 0, ":!git sts: the fuzzy set")
    for nm in ["stash", "status", "reset"] {
        rm(f.a, nm)
        fs_remove("{f.root}/{nm}") else |_| {}
    }
    fix_dispose(f, mut ed)
}

// `test_cmdcomp_shell_rows_are_shell_quoted` (`test_cmdcomp.c:1742-1786`).
fn t_cmdcomp_shell_rows_are_shell_quoted() {
    var (f, ed) = fix_init()
    touch(f.root, "a$b c")
    var rows = List[edit.CompItem]()
    let _ = shell_rows(mut ed, ":!cat a", mut rows)
    let i1 = find_item(rows, "a\\$b\\ c")
    assert(i1 >= 0 && rows[i1].suffix.len == 0, "unquoted: a\\$b\\ c")
    let _ = shell_rows(mut ed, ":!cat \"a", mut rows)
    let i2 = find_item(rows, "\"a\\$b c")
    assert(i2 >= 0 && edit.comp_bytes_is(rows[i2].suffix, "\""), "double: \"a\\$b c")
    let _ = shell_rows(mut ed, ":!cat 'a", mut rows)
    let i3 = find_item(rows, "'a$b c")
    assert(i3 >= 0 && edit.comp_bytes_is(rows[i3].suffix, "'"), "single: 'a$b c")
    let dir = "{f.root}/~lit"
    fs_create_dir_mode(dir, 448) else |_| { assert(false, "mkdir ~lit") }
    let _ = shell_rows(mut ed, ":!cat '~l", mut rows)
    assert(find_item(rows, "'~lit/") >= 0, "a quoted ~ is a literal directory")
    let _ = shell_rows(mut ed, ":!cat \\~l", mut rows)
    assert(find_item(rows, "\\~lit/") >= 0, "an escaped ~ is a literal directory")
    fs_remove_dir(dir) else |_| {}
    fs_remove("{f.root}/a$b c") else |_| {}
    fix_dispose(f, mut ed)
}

fn saved(name: str) -> (bool, str) {
    let none = "\u{0}"
    let v = env_get(name) else none
    (v != none, v)
}

fn restore(name: str, had: bool, v: str) {
    if had {
        env_set(name, v) else |_| {}
    } else {
        env_unset(name) else |_| {}
    }
}

// `test_cmdcomp_shell_var_redaction` (`test_cmdcomp.c:1789-1846`).
fn t_cmdcomp_shell_var_redaction() {
    let (had_editor, editor) = saved("EDITOR")
    let (had_cols, cols) = saved("COLUMNS")
    var (f, ed) = fix_init()
    env_set("YEW_S5723_GITHUB_TOKEN", "abc") else |_| {}
    env_set("EDITOR", "vi") else |_| {}
    env_set("YEW_S5723_ESC", "a\u{1b}[2Jb") else |_| {}
    env_set("COLUMNS", "80") else |_| {}
    var items = List[edit.CompItem]()
    let _ = edit.comp_enumerate(mut ed, edit.COMP_VAR, b("YEW_S5723_GITHUB_TOKEN"), mut items)
    let t = find_item(items, "YEW_S5723_GITHUB_TOKEN")
    assert(t >= 0 && items[t].detail == "\u{2022}\u{2022}\u{2022}", "a secret is redacted")
    let _ = edit.comp_enumerate(mut ed, edit.COMP_VAR, b("EDITOR"), mut items)
    let e = find_item(items, "EDITOR")
    assert(e >= 0 && items[e].detail == "vi", "a plain value previewed")
    let _ = edit.comp_enumerate(mut ed, edit.COMP_VAR, b("YEW_S5723_ESC"), mut items)
    let x = find_item(items, "YEW_S5723_ESC")
    assert(x >= 0, "the escape row")
    assert(!items[x].detail.contains("\u{1b}"), "no control byte reaches the pager")
    assert(items[x].detail == "a\u{b7}[2Jb", "drawn as a middle dot: {items[x].detail}")
    let _ = edit.comp_enumerate(mut ed, edit.COMP_VAR, b("COLUMNS"), mut items)
    assert(find_item(items, "COLUMNS") < 0, "a name the child will not see")
    let _ = edit.comp_enumerate(mut ed, edit.COMP_VAR, b("PAGER"), mut items)
    let p = find_item(items, "PAGER")
    assert(p >= 0 && items[p].detail == "cat", "the job layer's own rows")
    for it in items {
        assert(it.kind == edit.COMP_VAR, "VAR rows")
    }
    env_unset("YEW_S5723_GITHUB_TOKEN") else |_| {}
    env_unset("YEW_S5723_ESC") else |_| {}
    restore("EDITOR", had_editor, editor)
    restore("COLUMNS", had_cols, cols)
    fix_dispose(f, mut ed)
}

// `test_cmdcomp_shell_spawns_no_subprocess` (`test_cmdcomp.c:1848-1873`):
// 100 completions across every §3 row spawn nothing. C counts the job
// table; at 0.2.33 the port has no asynchronous jobs at all (R-yw04-1),
// so the port counts every spawner the completion path reaches — the
// generators, the help layer and the fish oracle.
fn t_cmdcomp_shell_spawns_no_subprocess() {
    let lines = [
        ":!ls # c",
        ":!echo $HO",
        ":!cd ~ro",
        ":!./sc",
        ":!cat src/",
        ":!rm -r",
        ":!gi",
        ":!cd x",
        ":!cat ou",
        ":!cat $HOME/x",
    ]
    var (f, ed) = fix_init()
    var rows = List[edit.CompItem]()
    var i = 0
    while i < 100 {
        let _ = shell_rows(mut ed, lines[i % lines.len], mut rows)
        i += 1
    }
    assert(edit.compgen_spawns(ed.gen) == 0, "no generator ran")
    assert(edit.comphelp_spawns(ed.help) == 0, "no --help ran")
    assert(edit.compfish_spawns(ed.fish) == 0, "no fish ran")
    fix_dispose(f, mut ed)
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_cmdcomp_exec_lists_only_runnable_names()
    t_cmdcomp_exec_opendir_count_stays_bounded()
    t_cmdcomp_exec_slices_and_resumes()
    t_cmdcomp_bang_query_routes_exec_then_path()
    t_cmdcomp_shell_filter_rekeys_on_context()
    t_cmdcomp_shell_route_row1_none()
    t_cmdcomp_shell_route_row2_variable()
    t_cmdcomp_shell_route_row3_user()
    t_cmdcomp_shell_route_row4_command_path()
    t_cmdcomp_shell_route_row5_operand_path()
    t_cmdcomp_shell_route_row6_flag()
    t_cmdcomp_shell_route_row7_command()
    t_cmdcomp_shell_route_row8_arg_defaults()
    t_cmdcomp_shell_route_row9_operand()
    t_cmdcomp_shell_prefix_ranking_git_st()
    t_cmdcomp_shell_rows_are_shell_quoted()
    t_cmdcomp_shell_var_redaction()
    t_cmdcomp_shell_spawns_no_subprocess()
    print("cmdcomp_shell_test: 18 cases pass")
}
