//! member: false
//! Real TextBuf work/budget/cache laws from sagitta test_syn_settle.c,
//! test_syn_splice.c and test_syn_diff.c at 9ace98c2. Counters below
//! include the actual compiled-rule interpreter and paint-span requests.

use syn
use text

struct Fixture {
    pool: syn.SynPool,
    engine: syn.SynEngine,
    tb: text.TextBuf,
    buffer: syn.SynBuffer,
}

fn fixture(count: int) -> Fixture {
    let source = "{{syntax:1,language:{{name:\"work\"}},contexts:{{main:{{rules:[{{match:\"/\\\\*\",attr:\"comment\",push:\"block\"}},{{match:\"[0-9]+\",attr:\"number\"}}]}},block:{{default:\"comment\",rules:[{{match:\"\\\\*/\",attr:\"comment\",pop:1}}]}}}}}}"
    var compiled = syn.syn_compile("work.fl", source.bytes())
    assert(compiled.valid && compiled.diagnostics.nwarnings == 0, "work definition compiles strict")
    var pool = syn.syn_pool_new()
    let root = syn.syn_pool_add(mut pool, take compiled.definition, 1)
    let engine = syn.syn_engine_new(pool, root)
    var contents = List[byte]()
    var i = 0
    while i < count {
        for b in "plain 17".bytes() { (mut contents).push(b) }
        if i + 1 < count { (mut contents).push(10 as byte) }
        i += 1
    }
    let tb = text.textbuf_from_bytes(contents, 0, contents.len)
    var buffer = syn.syn_buffer_new_at(tb, engine.generation, 0)
    syn.syn_buffer_fake_clock(mut buffer, 0, 1)
    Fixture { pool: pool, engine: engine, tb: tb, buffer: buffer }
}

fn settle(mut f: Fixture) {
    var calls = 0
    while f.buffer.lines.settling {
        let report = syn.syn_settle(mut f.buffer, mut f.engine, mut f.pool, f.tb, 0, 24, 0)
        assert(report.lines > 0 || report.fixpoint, "settling makes progress")
        calls += 1
        assert(calls < 10000, "settling terminates")
    }
}

fn key_10000() {
    var f = fixture(10000)
    settle(mut f)
    assert(text.textbuf_line_count(f.tb) == 10000, "exactly 10,000 real file lines")
    let positions = [0, 4999, 9999]
    var output = syn.syn_spans_new(16)
    for line in positions {
        let span = text.textbuf_line_span(f.tb, line as text.LineNo)
        text.textbuf_insert_str(mut f.tb, (span.lo + 2) as text.ByteOff, "x")
        syn.syn_buffer_edit(mut f.buffer, line, 0, 0)
        let before = f.engine.line_calls
        let report = syn.syn_settle(
            mut f.buffer,
            mut f.engine,
            mut f.pool,
            f.tb,
            line,
            line + 1,
            1000,
        )
        assert(
            report.fixpoint && report.lines <= 2,
            "syn_key_10000: local edit reaches bounded fixpoint",
        )
        syn.syn_buffer_spans(mut f.buffer, mut f.engine, mut f.pool, f.tb, line, mut output)
        assert(
            f.engine.line_calls - before <= 2,
            "syn_key_10000: interpreter plus paint stays bounded",
        )
    }
    assert(syn.syn_ids_bytes(f.buffer.lines.entry) == 40000, "four bytes per real file line")
}

fn propagation_budget() {
    var f = fixture(10000)
    settle(mut f)
    text.textbuf_insert_str(mut f.tb, 0 as text.ByteOff, "/*")
    syn.syn_buffer_edit(mut f.buffer, 0, 0, 0)
    var calls = 0
    while f.buffer.lines.settling {
        let report = syn.syn_settle(mut f.buffer, mut f.engine, mut f.pool, f.tb, 100, 124, 8)
        assert(report.us <= 8, "syn_propagation_budget: deterministic clock bound")
        calls += 1
        assert(calls < 100, "10,000-line propagation completes")
    }
    assert(calls > 1, "budget actually slices propagation")
    var output = syn.syn_spans_new(16)
    syn.syn_buffer_spans(mut f.buffer, mut f.engine, mut f.pool, f.tb, 9999, mut output)
    assert(syn.syn_span_attr(output, 0) == 16, "comment state reached final line")
}

fn repeated_pending_edits() {
    var f = fixture(10000)
    settle(mut f)
    let high = text.textbuf_line_span(f.tb, 9000 as text.LineNo)
    text.textbuf_insert_str(mut f.tb, high.lo as text.ByteOff, "/*")
    syn.syn_buffer_edit(mut f.buffer, 9000, 0, 0)
    text.textbuf_insert_str(mut f.tb, 1 as text.ByteOff, "x")
    syn.syn_buffer_edit(mut f.buffer, 0, 0, 0)
    settle(mut f)
    var output = syn.syn_spans_new(16)
    syn.syn_buffer_spans(mut f.buffer, mut f.engine, mut f.pool, f.tb, 9999, mut output)
    assert(
        syn.syn_span_attr(output, 0) == 16,
        "syn_pending_frontier: low edit cannot lose unprocessed high edit",
    )
}

fn cache_200_rows() {
    var f = fixture(300)
    settle(mut f)
    var output = syn.syn_spans_new(16)
    var line = 0
    while line < 200 {
        syn.syn_buffer_spans(mut f.buffer, mut f.engine, mut f.pool, f.tb, line, mut output)
        line += 1
    }
    let before = f.engine.line_calls
    line = 0
    while line < 200 {
        syn.syn_buffer_spans(mut f.buffer, mut f.engine, mut f.pool, f.tb, line, mut output)
        line += 1
    }
    assert(
        f.engine.line_calls == before,
        "syn_cache_200: unchanged redraw runs interpreter zero times",
    )
    syn.syn_buffer_spans(mut f.buffer, mut f.engine, mut f.pool, f.tb, 200, mut output)
    assert(
        f.engine.line_calls == before + 1,
        "syn_cache_200: one newly exposed row costs one evaluation",
    )
}

fn multiline_splice() {
    var f = fixture(100)
    settle(mut f)
    let span = text.textbuf_line_span(f.tb, 10 as text.LineNo)
    text.textbuf_insert_str(mut f.tb, span.lo as text.ByteOff, "a\nb\n")
    syn.syn_buffer_edit(mut f.buffer, 10, 0, 2)
    settle(mut f)
    assert(
        syn.syn_ids_len(f.buffer.lines.entry) == text.textbuf_line_count(f.tb),
        "insertion state shape",
    )
    assert(f.buffer.lines.splice_count == 1, "bulk insertion is one splice")
    let a = text.textbuf_line_span(f.tb, 20 as text.LineNo)
    let b = text.textbuf_line_span(f.tb, 22 as text.LineNo)
    text.textbuf_delete(mut f.tb, text.span(a.lo, b.lo))
    syn.syn_buffer_edit(mut f.buffer, 20, 2, 0)
    settle(mut f)
    assert(syn.syn_ids_len(f.buffer.lines.entry) == 100, "deletion state shape")
}

fn unnotified_generation() {
    var f = fixture(100)
    settle(mut f)
    text.textbuf_insert_str(mut f.tb, 0 as text.ByteOff, "/*")
    // Defensive generation recovery, not the ordinary per-key route.
    let report = syn.syn_settle(mut f.buffer, mut f.engine, mut f.pool, f.tb, 0, 24, 0)
    assert(
        report.fixpoint && report.lines >= 100,
        "missing edit notification forces conservative replay",
    )
}

fn oversized_line_copy_is_bounded() {
    var f = fixture(1)
    var long = List[byte]()
    var i = 0
    while i < 131072 { (mut long).push(120 as byte); i += 1 }
    text.textbuf_insert(mut f.tb, 0 as text.ByteOff, long)
    syn.syn_buffer_edit(mut f.buffer, 0, 0, 0)
    settle(mut f)
    assert(
        f.buffer.line_bytes.len <= 65537,
        "syn_line_copy_cap: never materialize an entire huge line",
    )
    assert(f.buffer.degraded, "oversized line visible as degraded")
}

fn incremental_matches_fresh() {
    var f = fixture(200)
    settle(mut f)
    let points = [50, 0, 100, 150, 1, 199]
    var i = 0
    while i < points.len {
        let span = text.textbuf_line_span(f.tb, points[i] as text.LineNo)
        text.textbuf_insert_str(
            mut f.tb,
            span.lo as text.ByteOff,
            if i % 2 == 0 then "/*" else "*/",
        )
        syn.syn_buffer_edit(mut f.buffer, points[i], 0, 0)
        settle(mut f)
        var fresh = syn.syn_buffer_new_at(f.tb, f.engine.generation, 0)
        syn.syn_buffer_fake_clock(mut fresh, 0, 1)
        while fresh.lines.settling {
            let _ = syn.syn_settle(mut fresh, mut f.engine, mut f.pool, f.tb, 0, 24, 0)
        }
        var a = syn.syn_spans_new(16)
        var b = syn.syn_spans_new(16)
        var line = 0
        while line < 200 {
            assert(
                syn.syn_ids_get(f.buffer.lines.entry, line) ==
                    syn.syn_ids_get(fresh.lines.entry, line),
                "incremental entry equals ROOT replay",
            )
            syn.syn_buffer_spans(mut f.buffer, mut f.engine, mut f.pool, f.tb, line, mut a)
            syn.syn_buffer_spans(mut fresh, mut f.engine, mut f.pool, f.tb, line, mut b)
            assert(
                a.n == b.n && a.exit_state == b.exit_state && a.stop == b.stop,
                "incremental span metadata",
            )
            var j = 0
            while j < a.n * 8 { assert(a.data[j] == b.data[j], "incremental span bytes"); j += 1 }
            line += 1
        }
        i += 1
    }
}

fn checked_small_work() {
    var f = fixture(32)
    settle(mut f)
    text.textbuf_insert_str(mut f.tb, 2 as text.ByteOff, "x")
    syn.syn_buffer_edit(mut f.buffer, 0, 0, 0)
    let before = f.engine.line_calls
    let report = syn.syn_settle(mut f.buffer, mut f.engine, mut f.pool, f.tb, 0, 24, 1000)
    var output = syn.syn_spans_new(16)
    syn.syn_buffer_spans(mut f.buffer, mut f.engine, mut f.pool, f.tb, 0, mut output)
    assert(
        report.fixpoint && f.engine.line_calls - before <= 2,
        "small checked work exercises the same actual interpreter/paint path",
    )
}

fn checked_small_differential() {
    var f = fixture(16)
    settle(mut f)
    let at = text.textbuf_line_span(f.tb, 7 as text.LineNo)
    text.textbuf_insert_str(mut f.tb, at.lo as text.ByteOff, "/*")
    syn.syn_buffer_edit(mut f.buffer, 7, 0, 0)
    settle(mut f)
    var fresh = syn.syn_buffer_new_at(f.tb, f.engine.generation, 0)
    syn.syn_buffer_fake_clock(mut fresh, 0, 1)
    while fresh.lines.settling {
        let _ = syn.syn_settle(mut fresh, mut f.engine, mut f.pool, f.tb, 0, 16, 0)
    }
    var a = syn.syn_spans_new(16)
    var b = syn.syn_spans_new(16)
    var line = 0
    while line < 16 {
        assert(
            syn.syn_ids_get(f.buffer.lines.entry, line) == syn.syn_ids_get(fresh.lines.entry, line),
            "small checked ROOT replay entry",
        )
        syn.syn_buffer_spans(mut f.buffer, mut f.engine, mut f.pool, f.tb, line, mut a)
        syn.syn_buffer_spans(mut fresh, mut f.engine, mut f.pool, f.tb, line, mut b)
        assert(a.n == b.n && a.exit_state == b.exit_state, "small checked ROOT replay spans")
        var j = 0
        while j < a.n * 8 { assert(a.data[j] == b.data[j], "small checked span bytes"); j += 1 }
        line += 1
    }
}

fn deferred_guest_replay() {
    let host = "{{syntax:1,language:{{name:\"host\"}},contexts:{{main:{{rules:[{{match:\"(<)([a-z]+)\",set_aux:1,push:\"bridge\",embed:{{lang:\"@2\",end:\"line\",defer:true,fallback:\"code\"}}}}]}},bridge:{{default:\"code\",rules:[{{aux:\"line_eq\",attr:\"punct\",pop:1,end:true}}]}}}}}}"
    let guest = "{{syntax:1,language:{{name:\"guest\"}},contexts:{{main:{{rules:[{{match:\"[0-9]+\",attr:\"number\"}}]}}}}}}"
    var h = syn.syn_compile("host.fl", host.bytes())
    assert(h.valid, "deferred host compiles")
    var pool = syn.syn_pool_new()
    syn.syn_pool_name(mut pool, 2, "guest".bytes())
    let root = syn.syn_pool_add(mut pool, take h.definition, 1)
    var engine = syn.syn_engine_new(pool, root)
    let tb = text.textbuf_from_str("<guest\n123\n<")
    var buffer = syn.syn_buffer_new_at(tb, engine.generation, 0)
    syn.syn_buffer_fake_clock(mut buffer, 0, 1)
    while buffer.lines.settling {
        let _ = syn.syn_settle(mut buffer, mut engine, mut pool, tb, 0, 3, 0)
    }
    assert(
        buffer.pending_langs.len == 1 && buffer.pending_langs[0] == 2,
        "deferred queue records actual known guest",
    )
    var output = syn.syn_spans_new(16)
    syn.syn_buffer_spans(mut buffer, mut engine, mut pool, tb, 1, mut output)
    assert(syn.syn_span_attr(output, 0) == 41, "fallback before loading")
    var g = syn.syn_compile("guest.fl", guest.bytes())
    assert(g.valid, "deferred guest compiles")
    let loaded = syn.syn_pool_add(mut pool, take g.definition, 2)
    assert(
        syn.syn_buffer_install_guest(mut buffer, mut engine, pool, loaded),
        "off-match loader installation",
    )
    assert(
        buffer.lines.wave == 0 && syn.syn_ids_get(buffer.lines.entry, 1) == 0,
        "replay opener, never keep stale fallback tail",
    )
    while buffer.lines.settling {
        let _ = syn.syn_settle(mut buffer, mut engine, mut pool, tb, 0, 3, 0)
    }
    syn.syn_buffer_spans(mut buffer, mut engine, mut pool, tb, 1, mut output)
    assert(
        syn.syn_span_attr(output, 0) == 9 && buffer.pending_langs.len == 0,
        "resident guest replaces fallback after replay",
    )
}

fn main() {
    let selected = (env_get("YEW_SYN_BUFFER_CASE") else "-1").to_int() else -1
    var i = 0
    while i < 11 {
        if selected == -1 || selected == i {
            match i {
                0 => key_10000(),
                1 => propagation_budget(),
                2 => repeated_pending_edits(),
                3 => cache_200_rows(),
                4 => multiline_splice(),
                5 => unnotified_generation(),
                6 => oversized_line_copy_is_bounded(),
                7 => incremental_matches_fresh(),
                8 => checked_small_work(),
                9 => checked_small_differential(),
                _ => deferred_guest_replay(),
            }
            print("syn_buffer_case_{i}: PASS")
        }
        i += 1
    }
}
