//! member: false
//!
//! The port of sagitta `tests/unit/test_porcelain.c` (454 lines), one test
//! per C test in registry order (`tests/unit/registry.c`'s `porcelain_*`
//! rows), then the port's own rows for the records sagitta's fixtures never
//! reach (yw13's prediction 2): 64-hex object names, path bytes that are
//! not UTF-8, and the submodule fields beyond `N...` and `S.M.`. Pure
//! bytes, no forking (s51 Testing Strategy). C's NUL-separated string
//! literals are `\x00`-escaped wolf literals; C's `sizeof(x) - 1U` is the
//! byte list's length.
//!
//! `YEW_PICK_CASE=N` runs case N alone (the checked machine's per-case run).

use git

const OID_A: str = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const OID_B: str = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const OID_C: str = "cccccccccccccccccccccccccccccccccccccccc"

fn b(s: str) -> List[byte] {
    var v = List[byte]()
    for x in s.bytes() {
        (mut v).push(x)
    }
    v
}

fn eq_bytes(got: List[byte], want: str) -> bool {
    git.git_bytes_cmp(got, b(want)) == 0
}

fn check(c: bool, what: str) {
    assert(c, what)
}

// `entry_named` (`test_porcelain.c:18-27`).
fn entry_named(snap: git.GitSnapshot, name: str) -> int {
    var i = 0
    while i < snap.entries.len {
        if git.git_snap_path_eq(snap, i, b(name)) {
            return i
        }
        i += 1
    }
    -1
}

fn path_of(snap: git.GitSnapshot, i: int) -> List[byte] {
    git.git_snap_path(snap, i)
}

fn parse(input: List[byte]) -> (bool, git.GitSnapshot, git.GitParseErr) {
    var snap = git.git_snapshot_new()
    var err = git.git_parse_err()
    let ok = git.git_parse_status(mut snap, input, input.len, mut err)
    (ok, snap, err)
}

// `test_porcelain_status_all_records_headers_and_sort` (`:29-99`).
fn porcelain_status_all_records_headers_and_sort() {
    let input = b(
        "# branch.oid {OID_A}\x00" +
            "# branch.head feature/parser branch\x00" +
            "# branch.upstream origin/trunk\x00" +
            "# branch.ab +12 -3\x00" +
            "# stash 4\x00" +
            "# future.header accepted\x00" +
            "x future record\x00" +
            "1 .M N... 100644 100644 100644 {OID_A} {OID_B} z ordinary\x00" +
            "2 R. S.M. 100644 100644 100644 {OID_A} {OID_C} R075 b renamed\x00a original\x00" +
            "u UU N... 100644 100644 100644 100644 {OID_A} {OID_B} {OID_C} conflict\x00" +
            "? dir/\x00" +
            "! ignored file\x00",
    )
    let (ok, snap, _) = parse(input)
    check(ok, "parse")
    check(snap.entries.len == 5, "five entries")
    check(snap.state == git.GIT_CONFLICTED, "conflicted state")
    check(eq_bytes(git.git_snap_branch(snap), "feature/parser branch"), "branch")
    check(eq_bytes(git.git_snap_upstream(snap), "origin/trunk"), "upstream")
    check(git.git_snap_head(snap) == OID_A, "head oid")
    check(snap.ahead == 12, "ahead")
    check(snap.behind == 3, "behind")
    check(!snap.detached, "not detached")
    check(!snap.unborn, "not unborn")
    check(snap.conflicted, "conflicted")
    check(eq_bytes(path_of(snap, 0), "b renamed"), "sorted first")
    check(eq_bytes(path_of(snap, 4), "z ordinary"), "sorted last")
    var e = entry_named(snap, "z ordinary")
    check(e >= 0, "ordinary present")
    check(snap.entries[e].kind == git.GIT_E_ORDINARY, "ordinary kind")
    check(!snap.entries[e].staged, "ordinary not staged")
    check(snap.entries[e].unstaged, "ordinary unstaged")
    check(git.git_snap_oid(snap, e) == OID_B, "index oid")
    e = entry_named(snap, "b renamed")
    check(e >= 0, "rename present")
    check(snap.entries[e].kind == git.GIT_E_RENAME, "rename kind")
    check(snap.entries[e].score == 75, "score")
    check(snap.entries[e].orig_len == 10, "orig len")
    check(eq_bytes(git.git_snap_orig(snap, e), "a original"), "orig path")
    check(snap.entries[e].staged, "rename staged")
    check(!snap.entries[e].unstaged, "rename not unstaged")
    check(snap.entries[e].submodule, "submodule")
    e = entry_named(snap, "conflict")
    check(e >= 0, "conflict present")
    check(snap.entries[e].kind == git.GIT_E_UNMERGED, "unmerged kind")
    check(snap.entries[e].conflicted, "conflicted entry")
    check(snap.entries[e].x == 85, "x U")
    check(snap.entries[e].y == 85, "y U")
    e = entry_named(snap, "dir/")
    check(e >= 0, "dir present")
    check(snap.entries[e].untracked, "dir untracked")
    check(snap.entries[e].is_dir, "dir is_dir")
    e = entry_named(snap, "ignored file")
    check(e >= 0, "ignored present")
    check(snap.entries[e].kind == git.GIT_E_IGNORED, "ignored kind")
    check(!snap.entries[e].untracked, "ignored not untracked")
}

// `test_porcelain_xy_mapping_complete` (`:101-151`).
fn porcelain_xy_mapping_complete() {
    let alphabet = ".MTADRC"
    var x = 0
    while x < alphabet.len {
        var y = 0
        while y < alphabet.len {
            let xc = alphabet[x..x + 1]
            let yc = alphabet[y..y + 1]
            let input = b("1 {xc}{yc} N... 100644 100644 100644 {OID_A} {OID_B} p\x00")
            let (ok, snap, _) = parse(input)
            check(ok, "xy parse")
            check(snap.entries.len == 1, "xy one entry")
            check(snap.entries[0].staged == (xc != "."), "xy staged")
            check(snap.entries[0].unstaged == (yc != "."), "xy unstaged")
            y += 1
        }
        x += 1
    }
    for c in ["DD", "AU", "UD", "UA", "DU", "AA", "UU"] {
        let input = b("u {c} N... 100644 100644 100644 100644 {OID_A} {OID_B} {OID_C} p\x00")
        let (ok, snap, _) = parse(input)
        check(ok, "conflict parse")
        check(snap.entries.len == 1, "conflict one entry")
        check(snap.entries[0].conflicted, "conflict flag")
        check(snap.entries[0].x == c.bytes()[0] as int, "conflict x")
        check(snap.entries[0].y == c.bytes()[1] as int, "conflict y")
    }
}

// `test_porcelain_rename_consumes_two_nuls_and_preserves_newline`
// (`:153-196`). YEW-F-019: the original path resembles a recognized
// record, so a one-NUL rename parser parses it and fails here.
fn porcelain_rename_consumes_two_nuls_and_preserves_newline() {
    let input = b(
        "2 R. N... 100644 100644 100644 {OID_A} {OID_B} R100 renamed\npath\x00" +
            "1 malformed rename source\x00" +
            "1 M. N... 100644 100644 100644 {OID_A} {OID_B} one\x00" +
            "1 .M N... 100644 100644 100644 {OID_A} {OID_B} two\x00" +
            "1 A. N... 000000 100644 100644 {OID_A} {OID_B} three\x00" +
            "1 D. N... 100644 000000 000000 {OID_A} {OID_B} four\x00" +
            "1 T. N... 100644 120000 120000 {OID_A} {OID_B} five\x00" +
            "2 C. N... 100644 100644 100644 {OID_A} {OID_C} C100 copied\x00copy source\x00",
    )
    let (ok, snap, _) = parse(input)
    check(ok, "parse")
    check(snap.entries.len == 7, "seven entries")
    for name in ["one", "two", "three", "four", "five"] {
        check(entry_named(snap, name) >= 0, name)
    }
    var r = entry_named(snap, "renamed\npath")
    check(r >= 0, "renamed present")
    check(snap.entries[r].path_len == 12, "newline path length")
    check(
        eq_bytes(git.git_snap_orig(snap, r), "1 malformed rename source"),
        "orig is the second field",
    )
    r = entry_named(snap, "copied")
    check(r >= 0, "copied present")
    check(snap.entries[r].kind == git.GIT_E_RENAME, "copy kind")
    check(snap.entries[r].x == 67, "copy x C")
    check(snap.entries[r].score == 100, "copy score")
    check(eq_bytes(git.git_snap_orig(snap, r), "copy source"), "copy source")
}

// `test_porcelain_header_state_matrices` (`:198-255`).
fn porcelain_header_state_matrices() {
    let (o1, normal, _) = parse(
        b(
            "# branch.oid {OID_A}\x00# branch.head trunk\x00# branch.upstream origin/trunk\x00# branch.ab +0 -0\x00",
        ),
    )
    check(o1, "normal")
    check(normal.state == git.GIT_OK, "normal state")
    check(normal.ahead == 0, "in sync ahead")
    check(normal.behind == 0, "in sync behind")
    let (o2, unborn, _) = parse(b("# branch.oid (initial)\x00# branch.head new\x00"))
    check(o2, "unborn")
    check(unborn.state == git.GIT_NO_HEAD, "unborn state")
    check(unborn.unborn, "unborn flag")
    check(!unborn.has_head_oid, "no head oid")
    check(unborn.ahead == -1, "unknown ahead")
    check(unborn.behind == -1, "unknown behind")
    let (o3, detached, _) = parse(
        b("# branch.oid {OID_A}\x00# branch.head (detached)\x00# branch.upstream odd/upstream\x00"),
    )
    check(o3, "detached")
    check(detached.state == git.GIT_DETACHED, "detached state")
    check(detached.detached, "detached flag")
    check(!detached.has_branch, "no branch")
    let (o4, noup, _) = parse(b("# branch.oid {OID_A}\x00# branch.head trunk\x00"))
    check(o4, "no upstream")
    check(noup.state == git.GIT_NO_UPSTREAM, "no upstream state")
}

// `test_porcelain_every_byte_truncation_and_rejections` (`:257-330`).
fn porcelain_every_byte_truncation_and_rejections() {
    let hoid = "# branch.oid {OID_A}\x00"
    let hhead = "# branch.head trunk\x00"
    let hup = "# branch.upstream origin/trunk\x00"
    let one = "1 M. N... 100644 100644 100644 {OID_A} {OID_B} one\x00"
    let rename = "2 R. N... 100644 100644 100644 {OID_A} {OID_B} R100 renamed\x00old name\x00"
    let copy_rec = "2 C. N... 100644 100644 100644 {OID_A} {OID_C} C075 copied\x00source\x00"
    let unmerged = "u UU N... 100644 100644 100644 100644 {OID_A} {OID_B} {OID_C} conflict\x00"
    let untracked = "? loose\x00"
    let ignored = "! ignored\x00"
    let mixed = b(hoid + hhead + hup + one + rename + copy_rec + unmerged + untracked + ignored)
    var boundaries = List[int]()
    var entries_at = List[int]()
    var at = 0
    (mut boundaries).push(0)
    (mut entries_at).push(0)
    var k = 0
    for rec in [hoid, hhead, hup, one, rename, copy_rec, unmerged, untracked, ignored] {
        at += rec.len
        (mut boundaries).push(at)
        (mut entries_at).push(if k < 3 then 0 else k - 2)
        k += 1
    }
    var cut = 0
    while cut <= mixed.len {
        var expected_ok = false
        var expected_entries = 0
        var i = 0
        while i < boundaries.len {
            if cut == boundaries[i] {
                expected_ok = true
                expected_entries = entries_at[i]
                break
            }
            i += 1
        }
        var snap = git.git_snapshot_new()
        var err = git.git_parse_err()
        let ok = git.git_parse_status(mut snap, mixed, cut, mut err)
        check(ok == expected_ok, "truncation verdict at {cut}")
        if ok {
            check(snap.entries.len == expected_entries, "truncation entries at {cut}")
        } else {
            check(err.off <= cut, "error offset inside the cut at {cut}")
        }
        cut += 1
    }
    let (bad, _, _) = parse(
        b("u ZZ N... 100644 100644 100644 100644 {OID_A} {OID_B} {OID_C} bad\x00"),
    )
    check(!bad, "closed conflict alphabet")
}

// `test_porcelain_z_paths_ignore_prefixes` (`:332-359`).
fn porcelain_z_paths_ignore_prefixes() {
    let input = b("z-file\x00node_modules/\x00a/b/\x00exact.bin\x00")
    var paths = git.git_paths_new()
    var err = git.git_parse_err()
    check(git.git_parse_z_paths(input, input.len, mut paths, mut err), "z paths")
    check(paths.rows.len == 4, "four paths")
    check(eq_bytes(git.git_paths_bytes(paths, 0), "a/b/"), "first sorted")
    check(paths.rows[0].is_dir, "first is dir")
    check(eq_bytes(git.git_paths_bytes(paths, 3), "z-file"), "last sorted")
    check(!paths.rows[3].is_dir, "last is file")
    var set = git.git_paths_new()
    check(git.git_parse_ignore(input, input.len, mut set, mut err), "ignore set")
    check(git.git_ignored(set, b("exact.bin"), 0, 9), "exact")
    check(git.git_ignored(set, b("node_modules/pkg/x.js"), 0, 21), "dir prefix")
    check(git.git_ignored(set, b("a/b/c/d"), 0, 7), "nested dir prefix")
    check(!git.git_ignored(set, b("a/bad"), 0, 5), "not a component prefix")
    check(!git.git_ignored(set, b("node_module"), 0, 11), "not a prefix")
}

// `test_porcelain_blame_metadata_reuse_and_incremental` (`:361-411`).
fn porcelain_blame_metadata_reuse_and_incremental() {
    let input = b(
        "{OID_A} 1 10 2\n" +
            "author Jane Doe\n" +
            "author-mail <jane@example.test>\n" +
            "author-time 1700000000\n" +
            "author-tz -0530\n" +
            "committer Nobody\n" +
            "summary First summary\n" +
            "boundary\n" +
            "filename source.c\n" +
            "\tline ten\n" +
            "{OID_A} 2 11\n" +
            "\tline eleven\n" +
            "{OID_A} 15 15 2\n" +
            "\tline fifteen\n" +
            "{OID_A} 16 16\n" +
            "\tline sixteen\n" +
            "{OID_A} 8 20 1\n" +
            "previous {OID_B} old.c\n" +
            "filename source.c\n" +
            "{OID_A} 9 30 1\n" +
            "filename source.c\n",
    )
    var lines = List[git.GitBlameLine]()
    var commits = List[git.GitCommitMeta]()
    var err = git.git_parse_err()
    check(git.git_parse_blame(input, input.len, mut lines, mut commits, mut err) == 6, "six lines")
    check(lines.len == 6, "lines len")
    check(commits.len == 1, "one commit")
    check(commits[0].sha == OID_A, "sha")
    check(eq_bytes(commits[0].author, "Jane Doe"), "author")
    check(eq_bytes(commits[0].author_mail, "<jane@example.test>"), "mail")
    check(eq_bytes(commits[0].summary, "First summary"), "summary")
    check(commits[0].author_time == 1700000000, "time")
    check(commits[0].author_tz_min == -330, "tz")
    check(commits[0].boundary, "boundary")
    let want = [10, 11, 15, 16, 20, 30]
    var i = 0
    while i < 6 {
        check(lines[i].lineno == want[i], "lineno {i}")
        i += 1
    }
    check(lines[0].commit == 0, "commit 0")
    check(lines[5].commit == 0, "commit 5")
}

// `test_porcelain_log_reflog_format_edges` (`:413-454`): `format:`'s last
// record has no trailing NUL, and a `%s` holding 0x1f is data.
fn porcelain_log_reflog_format_edges() {
    let log_input = b(
        "{OID_A}\x00aaaaaaa\x001700000000\x00Jane\x00jane@example.test\x00" +
            "{OID_B}\x00HEAD -> trunk\x00subject\x1fwith-us\x00body\x1fwith-us\x00" +
            "{OID_B}\x00bbbbbbb\x00-1\x00Bob\x00bob@example.test\x00\x00\x00" +
            "last\x00final body",
    )
    let reflog_input = b(
        "{OID_C}\x00ccccccc\x00HEAD@{{0}}\x00commit: message\x0042\x00subject\x1fwith-us",
    )
    var logs = List[git.GitLogRecord]()
    var err = git.git_parse_err()
    check(git.git_parse_log(log_input, log_input.len, mut logs, mut err), "log")
    check(logs.len == 2, "two log records")
    check(eq_bytes(logs[0].subject, "subject\x1fwith-us"), "subject with US")
    check(eq_bytes(logs[0].body, "body\x1fwith-us"), "body with US")
    check(logs[1].author_time == -1, "negative time")
    check(eq_bytes(logs[1].body, "final body"), "unterminated last record")
    var reflogs = List[git.GitReflogRecord]()
    check(git.git_parse_reflog(reflog_input, reflog_input.len, mut reflogs, mut err), "reflog")
    check(reflogs.len == 1, "one reflog record")
    check(eq_bytes(reflogs[0].selector, "HEAD@{{0}}"), "selector")
    check(eq_bytes(reflogs[0].message, "commit: message"), "message")
    check(reflogs[0].author_time == 42, "reflog time")
    check(eq_bytes(reflogs[0].subject, "subject\x1fwith-us"), "reflog subject")
}

const OID64_A: str = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const OID64_B: str = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

// Port row (prediction 2a): a SHA-256 repository's 64-hex object names on
// every record that carries one; 63 and 65 digits refuse.
fn port_porcelain_sha256_object_names() {
    let input = b(
        "# branch.oid {OID64_A}\x00# branch.head trunk\x00" +
            "1 M. N... 100644 100644 100644 {OID64_A} {OID64_B} one\x00" +
            "u AA N... 000000 100644 100644 100644 {OID64_A} {OID64_B} {OID64_A} two\x00",
    )
    let (ok, snap, _) = parse(input)
    check(ok, "sha256 parse")
    check(git.git_snap_head(snap) == OID64_A, "64-hex head")
    check(git.git_snap_oid(snap, entry_named(snap, "one")) == OID64_B, "64-hex index oid")
    check(snap.entries[entry_named(snap, "two")].conflicted, "64-hex unmerged")
    let short = OID64_A[0..63]
    let (bad63, _, _) = parse(b("1 M. N... 100644 100644 100644 {short} {OID64_B} x\x00"))
    check(!bad63, "63 hex refuse")
    let long = OID64_A + "a"
    let (bad65, _, _) = parse(b("# branch.oid {long}\x00"))
    check(!bad65, "65 hex refuse")
}

// Port row (prediction 2b): a path whose bytes are not UTF-8 survives the
// parser byte for byte (invariant 2), on `1`, on `2`'s both fields, `?`
// and the `-z` list, and sorts by bytes.
fn port_porcelain_non_utf8_paths_are_bytes() {
    var input = b("1 .M N... 100644 100644 100644 {OID_A} {OID_B} ")
    let bad = [0xff as byte, 0xfe as byte, 0x2f as byte, 0xc3 as byte]
    for x in bad {
        (mut input).push(x)
    }
    (mut input).push(0 as byte)
    for x in b("2 R. N... 100644 100644 100644 {OID_A} {OID_B} R090 new") {
        (mut input).push(x)
    }
    (mut input).push(0x80 as byte)
    (mut input).push(0 as byte)
    for x in b("old") {
        (mut input).push(x)
    }
    (mut input).push(0xc0 as byte)
    (mut input).push(0 as byte)
    for x in b("? u") {
        (mut input).push(x)
    }
    (mut input).push(0xed as byte)
    (mut input).push(0xa0 as byte)
    (mut input).push(0x80 as byte)
    (mut input).push(0 as byte)
    let (ok, snap, _) = parse(input)
    check(ok, "non-utf8 parse")
    check(snap.entries.len == 3, "three entries")
    // Byte order: "new\x80" < "u\xed\xa0\x80" < "\xff…".
    let p0 = path_of(snap, 0)
    let o0 = git.git_snap_orig(snap, 0)
    let p2 = path_of(snap, 2)
    check(p0.len == 4 && p0[3] as int == 0x80, "rename path bytes")
    check(o0.len == 4 && o0[3] as int == 0xc0, "rename source bytes")
    check(snap.entries[1].untracked && snap.entries[1].path_len == 4, "surrogate bytes kept")
    check(p2.len == 4 && p2[0] as int == 0xff && p2[3] as int == 0xc3, "ordinary path bytes")
    var z = List[byte]()
    (mut z).push(0xff as byte)
    (mut z).push(0 as byte)
    (mut z).push(0x61 as byte)
    (mut z).push(0 as byte)
    var paths = git.git_paths_new()
    var err = git.git_parse_err()
    check(git.git_parse_z_paths(z, z.len, mut paths, mut err), "z non-utf8")
    check(
        paths.rows.len == 2 && git.git_paths_bytes(paths, 1)[0] as int == 0xff,
        "z sorted by bytes",
    )
    var set = git.git_paths_new()
    var dir = List[byte]()
    (mut dir).push(0xff as byte)
    (mut dir).push(0x2f as byte)
    (mut dir).push(0 as byte)
    check(git.git_parse_ignore(dir, dir.len, mut set, mut err), "ignore non-utf8")
    var probe = List[byte]()
    (mut probe).push(0xff as byte)
    (mut probe).push(0x2f as byte)
    (mut probe).push(0x78 as byte)
    check(git.git_ignored(set, probe, 0, 3), "non-utf8 dir prefix")
}

// Port row (prediction 2c): every submodule field shape on `1`, `2` and
// `u`; a field outside `N...`/`S[C.][M.][U.]` refuses.
fn port_porcelain_submodule_fields() {
    for f in ["SC..", "S.M.", "S..U", "SCMU", "S..."] {
        let (o1, s1, _) = parse(b("1 .M {f} 160000 160000 160000 {OID_A} {OID_B} sub\x00"))
        check(o1 && s1.entries[0].submodule, "ordinary {f}")
        let (o2, s2, _) = parse(
            b("2 R. {f} 160000 160000 160000 {OID_A} {OID_B} R100 new\x00old\x00"),
        )
        check(o2 && s2.entries[0].submodule, "rename {f}")
        let (o3, s3, _) = parse(
            b("u UU {f} 160000 160000 160000 160000 {OID_A} {OID_B} {OID_C} sub\x00"),
        )
        check(o3 && s3.entries[0].submodule && s3.entries[0].conflicted, "unmerged {f}")
    }
    let (n1, s, _) = parse(b("1 .M N... 100644 100644 100644 {OID_A} {OID_B} plain\x00"))
    check(n1 && !s.entries[0].submodule, "N... is not a submodule")
    for f in ["N..U", "SX..", "S.Z.", "S..Q", "N.."] {
        let (bad, _, _) = parse(b("1 .M {f} 160000 160000 160000 {OID_A} {OID_B} sub\x00"))
        check(!bad, "refuse {f}")
    }
}

fn main() {
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    var n = 0
    if chosen < 0 || chosen == 0 {
        porcelain_status_all_records_headers_and_sort()
        print("porcelain_status_all_records_headers_and_sort: PASS")
        n += 1
