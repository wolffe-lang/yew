//! member: false
//! sagitta 9ace98c2 vm.c:339-351 buf[128], :1207-1223 base[160].

use fl

fn raised_message(text: str) -> str {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    var bytes = List[byte]()
    for b in text.bytes() { (mut bytes).push(b) }
    let p = fl.fl_parse(bytes, 0, mut vm.dc, mut vm.strings)
    let fun = fl.fl_compile(mut vm, p, 0, fl.fl_origin_new(4, 0)) else fl.fl_nil()
    assert(fun.t == 7)
    let out = fl.fl_vm_run(mut vm, fun)
    assert(vm.raised)
    let key = fl.fl_str_text(mut vm, "msg")
    let msg = fl.fl_map_get(vm, out, key) else fl.fl_nil()
    assert(msg.t == 4)
    str_from_utf8(vm.gc.slots[fl.fl_obj_index(vm, msg)].bytes) else ""
}

fn main() {
    let name = "x".repeat(200)
    let full = "undefined name '{name}'"
    assert(fl.fl_deferred_msg(name) == full[0..127])
    assert(raised_message("return {name}\n") == full[0..127])
    assert(raised_message("{name} = 1\n") == full[0..127])
    let field = "no field '{name}' on map"
    assert(raised_message("let m = {{}}\nreturn m.{name}\n") == field[0..159])
    print("PASS fl_name_bounds intermediate_caps")
}
