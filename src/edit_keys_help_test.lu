//! member: false
//! yw15: `ed.keys`, the keys help (a yew addition; sagitta has no such
//! command, its nearest is `ed.map`, `bind.c:475-522`, the current mode's
//! configured layer as one message). These rows are yew's own, never a
//! sagitta port:
//!
//! 0. every mode's rows, each what the dispatcher would do with its keys
//!    (`dispatch.c:278-291`: the first key picks the top layer that knows
//!    it, the rest of the chord is read there);
//! 1. THE STATUS ROW: every row's binding invoked as its key would invoke
//!    it, in a fresh editor; the row is labelled exactly when the
//!    invocation answers the deferred refusal, and the label names the
//!    refusal's own sprint and lane;
//! 2. the label's words for a few known rows;
//! 3. the key (`ESC ?`, and kitty's spelling) opens the picker in every
//!    mode the port can enter;
//! 4. the picker's rows drawn at 80 and 160 columns, the filter, Enter;
//! 5. an `init.fl` binding of the same key wins.
//!
//! `YEW_EDIT_KEYS_HELP_CASE=N` runs case N alone (the checked machine's
//! per-case run).

use edit
use term

fn bytes_of(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() {
        (mut out).push(b)
    }
    out
}

fn runtime_source() -> List[byte] {
    fs_read_bytes("runtime/init.fl") else {
        assert(false, "read runtime/init.fl")
        List[byte]()
    }
}

// An editor with a scratch buffer, a grid of ROWS x COLS and the
// configuration SOURCE run as the editor's start-up runs it.
fn booted_with(rows: int, cols: int, source: List[byte]) -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(rows, cols)
    ed.grid_ready = true
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, cols, rows))
    edit.bind_batch_begin(mut ed)
    assert(edit.fl_runtime_eval(mut ed, source) == edit.CMD_OK, "the configuration runs")
    edit.bind_batch_end(mut ed)
    ed
}

// The shipped runtime/init.fl loaded.
fn booted(rows: int, cols: int) -> edit.Ed {
    booted_with(rows, cols, runtime_source())
}

// No configuration: the floors and the user layer alone, which is where
// the help key lives (the checked machine's budget fits more of these).
fn booted_bare(rows: int, cols: int) -> edit.Ed {
    booted_with(rows, cols, bytes_of("set({{tabwidth: 4}})\n"))
}

fn cmd_name(ed: edit.Ed, id: int) -> str {
    if edit.cmd_active(ed.reg, id) then edit.cmd_entry(ed.reg, id).name else "<none>"
}

fn find_row(rows: List[edit.KeysRow], label: str, seq: str) -> int {
    var i = 0
    while i < rows.len {
        if rows[i].label == label && rows[i].seq == seq {
            return i
        }
        i += 1
    }
    -1
}

// The dispatcher's rule, re-derived here from the keymaps themselves: the
// stack for mode M is its floor, the user layer, its config layer
// (`keys_default.c:107-111`, `bind.c:395-415`); the first key picks the
// top layer with any match for it; the whole sequence is read in that
// layer. Answers the command it binds, 0 for none.
fn dispatched(ed: edit.Ed, floor: edit.Keymap, mode: int, seq: str) -> int {
    let keys = edit.key_parse_seq(seq, 8)
    assert(keys.len != 0, "{seq} parses")
    var stack = List[edit.Keymap]()
    (mut stack).push(copy floor)
    (mut stack).push(copy ed.keymaps[edit.MODE_N])
    (mut stack).push(edit.bind_keys(ed, mode))
    var first = List[int]()
    (mut first).push(keys[0])
    var layer = stack.len
    while layer != 0 {
        let (m, _, _) = edit.keymap_lookup(stack[layer - 1], first, 1)
        if m != edit.MATCH_NONE {
            break
        }
        layer -= 1
    }
    if layer == 0 {
        return 0
    }
    let km = copy stack[layer - 1]
    let (m, _, bi) = edit.keymap_lookup(km, keys, keys.len)
    if m != edit.MATCH_FULL && m != edit.MATCH_FULL_PREFIX {
        return 0
    }
    km.binds[bi].cmd
}

fn unit_letter(unit: int) -> str {
    edit.mode_name(unit)
}

// Case 0.
fn keys_rows_list_every_mode() {
    let ed = booted(24, 80)
    let rows = edit.keys_rows(ed)
    let keys = edit.cmd_lookup(ed.reg, "ed.keys")
    assert(keys != 0, "ed.keys is registered")
    var per = Map[str, int]()
    for r in rows {
        let had = per[r.label] else 0
        per[r.label] = had + 1
        assert(edit.cmd_active(ed.reg, r.cmd), "{r.label} {r.seq} names a live command")
        assert(r.name == cmd_name(ed, r.cmd), "{r.label} {r.seq}'s name is its command's")
        assert(r.help == edit.cmd_entry(ed.reg, r.cmd).help, "{r.label} {r.seq} carries its help")
        // What the dispatcher does with this row's keys in its mode.
        if r.unit < 0 {
            let floor = copy ed.keymaps[edit.km_mode(r.mode)]
            if r.mode != edit.MODE_H {
                let got = dispatched(ed, floor, r.mode, r.seq)
                assert(
                    got == r.cmd,
                    "{r.label} {r.seq}: the dispatcher runs {cmd_name(ed, got)}, the row says {r.name}",
                )
            } else {
                // An H row listed once is the same in every unit's table.
                for u in [edit.MODE_L, edit.MODE_W, edit.MODE_B, edit.MODE_I] {
                    let (ok, km) = edit.keymap_build(ed.reg, "H", edit.keys_highlight(u))
                    assert(ok, "H's {unit_letter(u)} table builds")
                    let got = dispatched(ed, km, edit.MODE_H, r.seq)
                    assert(
                        got == r.cmd,
                        "H {r.seq} from {unit_letter(u)}: {cmd_name(ed, got)}, the row says {r.name}",
                    )
                }
            }
        } else {
            let (ok, km) = edit.keymap_build(ed.reg, "H", edit.keys_highlight(r.unit))
            assert(ok, "H's {unit_letter(r.unit)} table builds")
            let got = dispatched(ed, km, edit.MODE_H, r.seq)
            assert(got == r.cmd, "{r.label} {r.seq}: {cmd_name(ed, got)}, the row says {r.name}")
        }
    }
    for label in ["L", "W", "B", "H", "H/L", "H/W", "H/B", "H/I", "I", "E", "F"] {
        let n = per[label] else 0
        print("keys_rows: {label}: {n} rows")
        assert(n > 0, "mode {label} has rows")
    }
    // The help key is ed.keys in every mode; L's floor `q !` sits under the
    // config layer's `q` and is not listed.
    for label in ["L", "W", "B", "H", "I", "E", "F"] {
        let a = find_row(rows, label, "A-?")
        let s = find_row(rows, label, "A-S-/")
        assert(a >= 0 && rows[a].cmd == keys, "{label} A-? is ed.keys")
        assert(s >= 0 && rows[s].cmd == keys, "{label} A-S-/ is ed.keys")
    }
    assert(find_row(rows, "L", "q !") < 0, "L's q ! is under the config layer's q")
    let q = find_row(rows, "L", "q")
    assert(q >= 0 && rows[q].name == "ed.macro.record", "L q is the config layer's")
    print("keys_rows: {rows.len} rows")
}

// The sprint and lane a label names: `(unsupported: sagitta Sprint N,
// LANE)`.
fn label_owner(label: str) -> (str, str) {
    let at = label.find("Sprint ") else -1
    let comma = label.find(", ") else -1
    assert(
        label.starts_with("(unsupported: sagitta Sprint ") &&
            at > 0 &&
            comma > at &&
            label.ends_with(")"),
        "the label's shape: '{label}'",
    )
    (label[at + 7..comma], label[comma + 2..label.len - 1])
}

// Case 1: the status row.
fn keys_status_agrees_with_invoke() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    env_set("YEW_CLIPBOARD", "none") else |_| {}
    let ed = booted(24, 80)
    let rows = edit.keys_rows(ed)
    var invoked = 0
    var labelled = 0
    var bad = 0
    // The labels seen, in first-seen order, and how many rows carry each.
    var owners = List[str]()
    var owner_rows = List[int]()
    for r in rows {
        if r.status.len != 0 {
            var k = 0
            while k < owners.len && owners[k] != r.status {
                k += 1
            }
            if k == owners.len {
                (mut owners).push(r.status)
                (mut owner_rows).push(0)
            }
            owner_rows[k] += 1
        }
        let flags = edit.cmd_entry(ed.reg, r.cmd).flags
        var cx = edit.cmdctx_new(0, edit.SRC_KEY)
        cx.count = 1
        cx.iarg = r.iarg
        cx.sarg = r.sarg
        cx.has_sarg = r.has_sarg
        // A binding that captures the next key gets that key's text, as
        // the dispatcher hands it (`dispatch.lu`'s capture).
        if flags & edit.CMD_CAPTURES_TEXT != 0 && !r.has_sarg {
            cx.sarg = "a"
            cx.has_sarg = true
        }
        if r.name == "ed.suspend" {
            // Invoking it stops the process it runs in (SIGTSTP on
            // itself); held ported by its implementation id, whose arm
            // tools/check-cmd-dispatch's second rule guarantees.
            assert(
                edit.cmd_entry(ed.reg, r.cmd).impl_id != edit.IMPL_UNPORTED,
                "ed.suspend is ported",
            )
            assert(r.status.len == 0, "ed.suspend is shown ported")
            continue
        }
        var fresh = edit.ed_new()
        edit.ed_open_scratch(mut fresh)
        cx.win = fresh.win
        let status = edit.ed_cmd_invoke(mut fresh, r.cmd, mut cx)
        invoked += 1
        let message = fresh.msg.text
        let refused = status == edit.CMD_ERR_DEFERRED
        if r.status.len != 0 {
            labelled += 1
        }
        if refused != (r.status.len != 0) {
            print(
                "FAIL keys_status_agrees_with_invoke {r.label} {r.seq} {r.name}: the modal says '{r.status}', invoking it answers {status} '{message}'",
            )
            bad += 1
            continue
        }
        if refused {
            // The label's sprint and lane are the refusal's own.
            let (sprint, lane) = label_owner(r.status)
            if !message.contains("not yet ported") ||
                !message.contains("sagitta Sprint {sprint}") ||
                !message.contains("({lane})") {
                print(
                    "FAIL keys_status_agrees_with_invoke {r.label} {r.seq} {r.name}: the label '{r.status}' is not the refusal's '{message}'",
                )
                bad += 1
            }
        }
    }
    print("keys_status: {invoked} invoked, {labelled} labelled unsupported, {bad} disagree")
    var k = 0
    while k < owners.len {
        print("keys_status: {owner_rows[k]} rows {owners[k]}")
        k += 1
    }
    assert(bad == 0, "the modal and the invocations agree")
    assert(labelled > 0, "some rows are unsupported at this pin")
}

// Case 2.
fn keys_status_names_sprint_and_lane() {
    let ed = booted(24, 80)
    let rows = edit.keys_rows(ed)
    let f = find_row(rows, "L", "f")
    assert(f >= 0 && rows[f].name == "ed.mode.enter" && rows[f].sarg == "F", "L f enters F")
    // F is entered since yw13: no status.
    assert(rows[f].status.len == 0, "L f: '{rows[f].status}'")
    let hunk = find_row(rows, "L", "A-<up>")
    assert(hunk >= 0 && rows[hunk].name == "ed.git.hunk.prev", "L A-<up> is the hunk jump")
    // The git rows still refused are s53's, git in the editor (yw13b).
    assert(
        rows[hunk].status == "(unsupported: sagitta Sprint 53, yw13b)",
        "L A-<up>: '{rows[hunk].status}'",
    )
    let compl = find_row(rows, "I", "C-<space>")
    assert(compl >= 0 && rows[compl].name == "ed.compl.complete", "I C-<space> completes")
    assert(
        rows[compl].status == "(unsupported: sagitta Sprint 44, yw11)",
        "I C-<space>: '{rows[compl].status}'",
    )
    let hover = find_row(rows, "L", "K")
    assert(
        hover >= 0 && rows[hover].name == "ed.lsp.hover" && rows[hover].status.len == 0,
        "L K is hover, ported",
    )
    let gd = find_row(rows, "L", "g d")
    assert(gd >= 0, "L g d is listed")
    assert(
        edit.keys_row_line(rows[gd]) ==
            "L  g d  ed.lsp.goto_def  Go to the definition under the cursor",
        "the line: '{edit.keys_row_line(rows[gd])}'",
    )
    let line_f = edit.keys_row_line(rows[f])
    assert(line_f == "L  f  ed.mode.enter F  Enter L/W/B/I/H/E/F mode", "the line: '{line_f}'")
}

fn feed(mut ed: edit.Ed, bytes: str, now: int) -> bool {
    let b = bytes_of(bytes)
    term.input_feed(mut ed.input, b, 0, b.len)
    var key = term.key_new()
    var t = now
    var got = false
    var spins = 0
    while spins < 4 {
        while term.input_next(mut ed.input, t, mut key) {
            edit.ed_handle_key(mut ed, key, t)
            got = true
        }
        t += term.ESC_TIMEOUT_MS
        spins += 1
    }
    got
}

fn enter_mode(mut ed: edit.Ed, letter: str) {
    if letter == "L" {
        return
    }
    let id = edit.cmd_lookup(ed.reg, "ed.mode.enter")
    var cx = edit.cmdctx_new(ed.win, edit.SRC_KEY)
    cx.count = 1
    cx.sarg = letter
    cx.has_sarg = true
    assert(edit.ed_cmd_invoke(mut ed, id, mut cx) == edit.CMD_OK, "enter {letter}")
}

// Case 3.
fn keys_help_key_opens_the_picker() {
    for spelling in ["\x1b?", "\x1b[47;4u", "\x1b[47:63;4u"] {
        for letter in ["L", "W", "B", "H", "I", "E"] {
            var ed = booted_bare(24, 80)
            enter_mode(mut ed, letter)
            assert(edit.mode_name(ed.mode) == letter, "in {letter}")
            let prompt = ed.cmdline.active
            assert(prompt == (letter == "E"), "only E has its prompt open")
            assert(feed(mut ed, spelling, 1000), "the key decodes")
            assert(edit.picker_active(ed), "{letter}: the key opens a picker")
            assert(ed.picker.kind == edit.PICK_HOST_KEYS, "{letter}: the keys picker")
            assert(edit.picker_total(ed) == edit.keys_rows(ed).len, "{letter}: every row")
            assert(
                !ed.picker.filter_open,
                "{letter}: the filter line opens on the first key, not the prompt's",
            )
        }
    }
}

fn row_text(ed: edit.Ed, y: int) -> str {
    var out = List[byte]()
    var x = 0
    while x < ed.grid.cols {
        let c = term.grid_back(ed.grid, y, x)
        let b = if term.cell_interned(c) then 32 else term.cell_byte(c, 0)
        (mut out).push(if b >= 32 && b < 127 then b as byte else 32 as byte)
        x += 1
    }
    str_from_utf8(out) else ""
}

fn type_text(mut ed: edit.Ed, s: str) {
    for c in s.bytes() {
        var k = term.key_new()
        k.code = c as int
        (mut k.text).push(c)
        assert(edit.picker_key(mut ed, k), "typed {c} consumed")
    }
    while edit.picker_tick(mut ed) {}
}

fn screen_has(ed: edit.Ed, want: str) -> bool {
    var y = 0
    while y < ed.grid.rows {
        if row_text(ed, y).contains(want) {
            return true
        }
        y += 1
    }
    false
}

// Case 4.
fn keys_picker_draws_and_filters() {
    for size in [80, 160] {
        let rows_n = if size == 80 then 24 else 50
        var ed = booted(rows_n, size)
        let c = edit.cmdctx_new(ed.win, edit.SRC_TEST)
        assert(edit.keys_cmd_open(mut ed, c) == edit.CMD_OK, "ed.keys opens")
        assert(edit.picker_active(ed) && ed.picker.kind == edit.PICK_HOST_KEYS, "the keys picker")
        type_text(mut ed, "hunk.prev")
        assert(
            edit.picker_shown(ed) == 3,
            "{size}: hunk.prev is L, W and B's A-<up>: {edit.picker_shown(ed)}",
        )
        edit.picker_draw(mut ed, edit.rect(0, 0, size, rows_n))
        let all = edit.keys_rows(ed)
        let hunk = copy all[find_row(all, "L", "A-<up>")]
        let label = edit.keys_row_label(hunk, edit.keys_seq_width(all))
        assert(
            label.starts_with("L   A-<up> "),
            "the label starts with the mode and key: '{label}'",
        )
        assert(
            label.ends_with(" ed.git.hunk.prev  (unsupported: sagitta Sprint 53, yw13b)"),
            "and ends with the command and its status: '{label}'",
        )
        // The label is never clipped before the help.
        assert(screen_has(ed, label), "{size}: the row's key, command and status are drawn whole")
        if size == 160 {
            assert(screen_has(ed, "Jump to previous changed hunk"), "160: the help is drawn")
        } else {
            assert(
                !screen_has(ed, "Jump to previous changed hunk"),
                "80: the help gives way to the label",
            )
        }
        assert(screen_has(ed, " Keys "), "{size}: the title")
        var enter = term.key_new()
        enter.code = term.KEY_ENTER
        // Enter shows the selected row: the filter's best match, whichever
        // of the three the scorer ranks first.
        let sel = edit.picker_selected(ed)
        assert(sel >= 1 && sel <= all.len, "a row is selected")
        let chosen = copy all[sel - 1]
        assert(
            chosen.name == "ed.git.hunk.prev" && chosen.seq == "A-<up>",
            "the selection is a hunk.prev row",
        )
        let want = edit.keys_row_line(chosen)
        assert(edit.picker_key(mut ed, enter), "Enter is the picker's")
        assert(!edit.picker_active(ed), "{size}: Enter closes the picker")
        if ed.msg.text != want {
            print(
                "FAIL keys_picker_draws_and_filters {size}: the message row holds '{ed.msg.text}', want '{want}'",
            )
        }
        assert(ed.msg.text == want, "{size}: the message row holds the line")
    }
    var ed = booted(24, 80)
    let c = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    assert(edit.keys_cmd_open(mut ed, c) == edit.CMD_OK, "ed.keys opens")
    type_text(mut ed, "lsp.goto")
    assert(edit.picker_shown(ed) == 4, "lsp.goto: the four gotos in L: {edit.picker_shown(ed)}")
    var esc = term.key_new()
    esc.code = term.KEY_ESCAPE
    assert(edit.picker_key(mut ed, esc), "Esc is the picker's")
    assert(!edit.picker_active(ed), "Esc closes the picker")
}

// Case 5.
fn keys_init_binding_wins() {
    let ed = booted_with(24, 80, bytes_of("bind(\"L\", \"A-?\", \"ed.nop\")\n"))
    let rows = edit.keys_rows(ed)
    let l = find_row(rows, "L", "A-?")
    assert(l >= 0 && rows[l].name == "ed.nop", "L A-? is the init.fl's")
    let w = find_row(rows, "W", "A-?")
    assert(w >= 0 && rows[w].name == "ed.keys", "W A-? is still ed.keys")
    let floor = copy ed.keymaps[edit.km_mode(edit.MODE_L)]
    assert(
        dispatched(ed, floor, edit.MODE_L, "A-?") == edit.cmd_lookup(ed.reg, "ed.nop"),
        "the dispatcher agrees",
    )
}

fn main() {
    let chosen = (env_get("YEW_EDIT_KEYS_HELP_CASE") else "-1").to_int() else -1
    if chosen < 0 || chosen == 0 {
        keys_rows_list_every_mode()
        print("keys_rows_list_every_mode: PASS")
    }
    if chosen < 0 || chosen == 1 {
        keys_status_agrees_with_invoke()
        print("keys_status_agrees_with_invoke: PASS")
    }
    if chosen < 0 || chosen == 2 {
        keys_status_names_sprint_and_lane()
        print("keys_status_names_sprint_and_lane: PASS")
    }
    if chosen < 0 || chosen == 3 {
        keys_help_key_opens_the_picker()
        print("keys_help_key_opens_the_picker: PASS")
    }
    if chosen < 0 || chosen == 4 {
        keys_picker_draws_and_filters()
        print("keys_picker_draws_and_filters: PASS")
    }
    if chosen < 0 || chosen == 5 {
        keys_init_binding_wins()
        print("keys_init_binding_wins: PASS")
    }
    if chosen < 0 {
        print("edit_keys_help: 6 cases pass")
    }
}
