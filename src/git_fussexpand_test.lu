//! member: false
//!
//! The port of sagitta `tests/unit/test_fussexpand.c` (261 lines), one test
//! per C test in registry order: Sprint 57.5's positive expansion memory
//! and open-file ancestry. C's `FussPathRef` arrays of open files are a
//! `FussOpenMemory` here (the port's `fuss_apply_expansion` takes the
//! sorted set fussmode keeps, `fussmode.c:908-935`); a duplicated ref is
//! one row of the set.
//!
//! `YEW_PICK_CASE=N` runs case N alone (the checked machine's per-case run).

use git

fn b(s: str) -> List[byte] {
    var v = List[byte]()
    for x in s.bytes() {
        (mut v).push(x)
    }
    v
}

// `fx_entry` (`test_fussexpand.c:8-18`): an unstaged ordinary file.
fn snap1(path: str, gen: int) -> git.GitSnapshot {
    var s = git.git_snapshot_new()
    s.gen = gen
    add(mut s, path)
    s
}

fn add(mut s: git.GitSnapshot, path: str) {
    var e = git.git_entry_new()
    e.path_at = git.git_pool_add(mut s.pool, b(path), 0, path.len)
    e.path_len = path.len
    e.unstaged = true
    (mut s.entries).push(e)
}

fn mem(paths: List[str]) -> git.FussOpenMemory {
    var m = git.fuss_open_memory_new()
    for p in paths {
        let _ = git.fuss_open_memory_set(mut m, b(p), 0, p.len, true)
    }
    m
}

fn none() -> git.FussOpts {
    git.FussOpts { all_files: false, show_hidden: false }
}

// `fx_node` (`:31-41`).
fn node(t: git.FussTree, path: str) -> int {
    let p = b(path)
    var i = 1
    while i < t.nodes.len {
        if git.git_bytes_cmp(git.fuss_node_path(t, i), p) == 0 {
            return i
        }
        i += 1
    }
    -1
}

// `fx_row` (`:43-53`).
fn row(t: git.FussTree, path: str) -> int {
    let p = b(path)
    var i = 0
    while i < t.items.len {
        if git.fuss_item_path_eq(t, i, p, 0, p.len) {
            return i
        }
        i += 1
    }
    -1
}

fn expanded(t: git.FussTree, path: str) -> bool {
    let n = node(t, path)
    n >= 0 && t.nodes[n].expanded
}

// `:55-79`: the memory owns its bytes (the caller's buffer is changed
// after the insert), stays sorted, and is idempotent both ways.
fn fussexpand_positive_memory_is_sorted_owned_and_idempotent() {
    var m = git.fuss_open_memory_new()
    var mutable = b("zeta")
    assert(git.fuss_open_memory_set(mut m, mutable, 0, 4, true), "zeta")
    mutable[0] = 120 as byte
    assert(git.fuss_open_memory_set(mut m, b("alpha"), 0, 5, true), "alpha")
    assert(git.fuss_open_memory_set(mut m, b("mid"), 0, 3, true), "mid")
    assert(!git.fuss_open_memory_set(mut m, b("mid"), 0, 3, true), "mid twice")
    assert(m.rows.len == 3, "three")
    assert(git.git_bytes_cmp(git.fuss_open_memory_path(m, 0), b("alpha")) == 0, "sorted 0")
    assert(git.git_bytes_cmp(git.fuss_open_memory_path(m, 1), b("mid")) == 0, "sorted 1")
    assert(git.git_bytes_cmp(git.fuss_open_memory_path(m, 2), b("zeta")) == 0, "owned copy")
    assert(git.fuss_open_memory_has(m, b("zeta"), 0, 4), "has zeta")
    assert(!git.fuss_open_memory_has(m, b("zet"), 0, 3), "no prefix hit")
    assert(git.fuss_open_memory_set(mut m, b("mid"), 0, 3, false), "remove mid")
    assert(!git.fuss_open_memory_set(mut m, b("mid"), 0, 3, false), "remove twice")
    assert(m.rows.len == 2, "two")
    assert(git.git_bytes_cmp(git.fuss_open_memory_path(m, 0), b("alpha")) == 0, "after 0")
    assert(git.git_bytes_cmp(git.fuss_open_memory_path(m, 1), b("zeta")) == 0, "after 1")
}

// `:81-113`.
fn fussexpand_new_tree_is_collapsed_until_manually_opened() {
    var s = git.git_snapshot_new()
    s.gen = 1
    add(mut s, "src/edit/a.c")
    add(mut s, "src/mod/b.c")
    add(mut s, "tests/t.c")
    var t = git.fuss_tree_new()
    git.fuss_build(mut t, s, none())
    assert(t.items.len == 2, "two top rows")
    assert(row(t, "src") == 0 && row(t, "tests") == 1, "src, tests")
    assert(!expanded(t, "src") && !expanded(t, "src/mod"), "collapsed")
    var m = mem(["src"])
    git.fuss_apply_expansion(mut t, m, git.fuss_open_memory_new())
    assert(node(t, "src/edit") >= 0 && row(t, "src/edit") >= 0, "src open")
    assert(row(t, "src/edit/a.c") == -1, "edit still closed")
    let _ = git.fuss_open_memory_set(mut m, b("src/edit"), 0, 8, true)
    git.fuss_apply_expansion(mut t, m, git.fuss_open_memory_new())
    assert(row(t, "src/edit/a.c") >= 0, "edit open")
    assert(row(t, "src/mod/b.c") == -1, "mod closed")
}

// `:115-143`: `src/modem.c` opens `src` but not `src/mod`.
fn fussexpand_open_file_ancestry_respects_path_segments() {
    var s = git.git_snapshot_new()
    s.gen = 2
    add(mut s, "src/mod/a.c")
    add(mut s, "src/modem.c")
    var t = git.fuss_tree_new()
    git.fuss_build(mut t, s, none())
    let empty = git.fuss_open_memory_new()
    git.fuss_apply_expansion(mut t, empty, mem(["src/modem.c", "src/modem.c"]))
    assert(expanded(t, "src") && !expanded(t, "src/mod"), "segment, not prefix")
    assert(row(t, "src/mod") >= 0 && row(t, "src/mod/a.c") == -1, "mod collapsed")
    git.fuss_apply_expansion(mut t, empty, mem(["src/mod/a.c"]))
    assert(expanded(t, "src") && expanded(t, "src/mod"), "nested ancestry")
    assert(row(t, "src/mod/a.c") >= 0, "leaf shown")
    assert(empty.rows.len == 0, "hand memory untouched")
}

// `:145-168`.
fn fussexpand_automatic_open_wins_over_manual_collapse() {
    let s = snap1("a/b/file.c", 3)
    var t = git.fuss_tree_new()
    git.fuss_build(mut t, s, none())
    var m = git.fuss_open_memory_new()
    assert(git.fuss_open_memory_set(mut m, b("a"), 0, 1, true), "open a")
    assert(git.fuss_open_memory_set(mut m, b("a"), 0, 1, false), "close a")
    git.fuss_apply_expansion(mut t, m, mem(["a/b/file.c"]))
    assert(expanded(t, "a") && expanded(t, "a/b"), "open file wins")
    assert(m.rows.len == 0, "memory empty")
    git.fuss_apply_expansion(mut t, m, git.fuss_open_memory_new())
    assert(!expanded(t, "a") && !expanded(t, "a/b"), "closed once the file is not open")
}

// `:170-200`.
fn fussexpand_memory_survives_absence_and_reappears() {
    var t = git.fuss_tree_new()
    let m = mem(["remembered"])
    let none_open = git.fuss_open_memory_new()
    git.fuss_build(mut t, snap1("remembered/file.c", 4), none())
    git.fuss_apply_expansion(mut t, m, none_open)
    assert(expanded(t, "remembered"), "remembered open")
    git.fuss_build(mut t, snap1("other/file.c", 5), none())
    git.fuss_apply_expansion(mut t, m, none_open)
    assert(node(t, "remembered") < 0, "absent")
    assert(git.fuss_open_memory_has(m, b("remembered"), 0, 10), "remembered while absent")
    git.fuss_build(mut t, snap1("remembered/file.c", 6), none())
    git.fuss_apply_expansion(mut t, m, none_open)
    assert(expanded(t, "remembered"), "open again")
    assert(row(t, "remembered/file.c") >= 0, "its file shown")
}

// `:202-231`.
fn fussexpand_selection_falls_to_nearest_existing_ancestor() {
    var t = git.fuss_tree_new()
    git.fuss_build(mut t, snap1("src/deep/file.c", 7), none())
    git.fuss_apply_expansion(mut t, git.fuss_open_memory_new(), mem(["src/deep/file.c"]))
    var sel = git.fuss_sel_new()
    git.fuss_sel_set(mut sel, b("src/deep/file.c"), 0, 15)
    assert(git.fuss_row_of(t, sel) >= 0, "selected")
    git.fuss_build(mut t, snap1("src/keep.c", 8), none())
    let r = git.fuss_row_of(t, sel)
    assert(r >= 0, "resolved")
    assert(git.fuss_item_path_eq(t, r, b("src"), 0, 3), "nearest existing ancestor")
    assert(!t.items[r].is_file, "a directory")
    git.fuss_sel_clear(mut sel)
}

// `:233-261`.
fn fussexpand_selection_falls_to_row_zero_without_ancestor() {
    var t = git.fuss_tree_new()
    git.fuss_build(mut t, snap1("gone/file", 9), none())
    git.fuss_apply_expansion(mut t, git.fuss_open_memory_new(), mem(["gone/file"]))
    var sel = git.fuss_sel_new()
    git.fuss_sel_from_row(mut sel, t, row(t, "gone/file"))
    assert(git.git_bytes_cmp(sel.path, b("gone/file")) == 0, "selection from row")
    git.fuss_build(mut t, snap1("kept/file", 10), none())
    let r = git.fuss_row_of(t, sel)
    assert(r == 0, "row zero")
    assert(git.fuss_item_path_eq(t, r, b("kept"), 0, 4), "kept")
    git.fuss_sel_clear(mut sel)
}

fn main() {
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    var n = 0
    if chosen < 0 || chosen == 0 {
        fussexpand_positive_memory_is_sorted_owned_and_idempotent()
        print("fussexpand_positive_memory_is_sorted_owned_and_idempotent: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 1 {
        fussexpand_new_tree_is_collapsed_until_manually_opened()
        print("fussexpand_new_tree_is_collapsed_until_manually_opened: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 2 {
        fussexpand_open_file_ancestry_respects_path_segments()
        print("fussexpand_open_file_ancestry_respects_path_segments: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 3 {
        fussexpand_automatic_open_wins_over_manual_collapse()
        print("fussexpand_automatic_open_wins_over_manual_collapse: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 4 {
        fussexpand_memory_survives_absence_and_reappears()
        print("fussexpand_memory_survives_absence_and_reappears: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 5 {
        fussexpand_selection_falls_to_nearest_existing_ancestor()
        print("fussexpand_selection_falls_to_nearest_existing_ancestor: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 6 {
        fussexpand_selection_falls_to_row_zero_without_ancestor()
        print("fussexpand_selection_falls_to_row_zero_without_ancestor: PASS")
        n += 1
    }
    print("git_fussexpand_test: {n} cases run")
}
