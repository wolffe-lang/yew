//! member: false
//!
//! The port of sagitta `tests/unit/test_edit_cmds.c` (1,135 lines), one
//! test per C test in file order. C's fixture (`edit_fixture`) is the
//! runtime-configured scratch editor (`yew_test_load_runtime`) with the
//! buffer's text, undo tree and line-ending metadata replaced and a 4x80
//! window; the port's is `edit.ed_new_test` with the same replacements.
//! C sets an option through the option store (`yew_opt_set_for`, Sprint
//! 36); the port's options are `Ed.opts` until that store lands (yw09),
//! so `edit_set_bool` writes the field the command reads.

use edit
use std.fs
use term
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn cat(a: List[byte], b: List[byte]) -> List[byte] {
    var v = copy a
    for x in b {
        (mut v).push(x)
    }
    v
}

fn raw(xs: List[int]) -> List[byte] {
    var v = List[byte]()
    for x in xs {
        (mut v).push(x as byte)
    }
    v
}

// `FAMILY` (`test_edit_cmds.c:16-19`): man ZWJ woman ZWJ girl ZWJ boy,
// one 25-byte cluster.
const FAMILY: str = "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}"

// `mixed_fixture` (`test_edit_cmds.c:21-35`), its last line holding a raw
// 0xFF.
fn mixed_fixture() -> List[byte] {
    let head = bytes_of(
        "  alpha  \r\ne\u{301} \u{6F22} {FAMILY} X\r\nline03\r\nline04\r\nline05\r\nline06\r\nline07\r\nline08\r\nline09\r\nline10\r\nline11\r\nline12\r\nline13\r\nbad:",
    )
    var ff = List[int]()
    (mut ff).push(255)
    cat(cat(head, raw(ff)), bytes_of(":byte"))
}

fn runtime() -> List[byte] {
    let bytes = fs_read_bytes("runtime/init.fl") else List[byte]()
    assert(bytes.len != 0, "runtime/init.fl is readable from the repository root")
    bytes
}

// `edit_key` (`test_edit_cmds.c:37-48`).
fn edit_key(code: int) -> term.Key {
    var key = term.key_new()
    key.code = code
    key.kind = term.EV_KEY
    key.ev = term.KEY_PRESS
    if code < 128 {
        (mut key.text).push(code as byte)
    }
    key
}

// `edit_text_key` (`test_edit_cmds.c:50-61`).
fn edit_text_key(bytes: List[byte]) -> term.Key {
    var key = term.key_new()
    key.code = if bytes.len == 1 then bytes[0] as int else 0
    key.kind = term.EV_KEY
    key.ev = term.KEY_PRESS
    key.text = copy bytes
    key
}

// `edit_fixture` (`test_edit_cmds.c:63-91`).
fn edit_fixture(bytes: List[byte], eol: int) -> edit.Ed {
    var ed = edit.ed_new_test(runtime(), "")
    let w = ed.win
    let b = ed.wins[w].buf
    ed.bufs[b].ec.tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    ed.bufs[b].ec.undo = text.undo_new(ed.bufs[b].ec.tb)
    ed.bufs[b].ec.meta.eol = eol
    ed.bufs[b].ec.meta.dominant_eol = eol
    ed.bufs[b].ec.meta.crlf_count = if eol == text.EOL_CRLF then 1 else 0
    ed.bufs[b].ec.meta.lf_count = if eol == text.EOL_LF then 1 else 0
    ed.wins[w].vp.rows = 4
    ed.wins[w].vp.cols = 80
    ed.wins[w].rect.h = 4
    ed.wins[w].rect.w = 80
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].pos = 0
    ed.wins[w].cs.curs[p].anchor = 0
    ed.wins[w].cs.curs[p].goal_col = 0
    assert(text.undo_current(ed.bufs[b].ec.undo) == ed.bufs[b].ec.undo.root, "a fresh tree")
    ed
}

fn fixture_str(s: str, eol: int) -> edit.Ed {
    edit_fixture(bytes_of(s), eol)
}

// `edit_invoke` (`test_edit_cmds.c:93-110`).
fn edit_invoke(
    mut ed: edit.Ed,
    name: str,
    count: int,
    count_given: bool,
    arg: str,
    has_arg: bool,
) -> int {
    let id = edit.cmd_lookup(ed.reg, name)
    assert(id != 0, "{name} is registered")
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    cx.count = count
    cx.count_given = count_given
    cx.sarg = arg
    cx.has_sarg = has_arg
    edit.ed_cmd_invoke(mut ed, id, mut cx)
}

fn run(mut ed: edit.Ed, name: str) -> int {
    edit_invoke(mut ed, name, 1, false, "", false)
}

fn key(mut ed: edit.Ed, code: int, now: int) {
    edit.ed_handle_key(mut ed, edit_key(code), now)
}

fn buf(ed: edit.Ed) -> int {
    ed.wins[ed.win].buf
}

fn pos(ed: edit.Ed) -> int {
    let w = ed.win
    ed.wins[w].cs.curs[ed.wins[w].cs.primary].pos
}

fn line_of_pos(ed: edit.Ed) -> int {
    text.textbuf_line_of(ed.bufs[buf(ed)].ec.tb, pos(ed) as text.ByteOff) as int
}

fn current(ed: edit.Ed) -> int {
    text.undo_current(ed.bufs[buf(ed)].ec.undo)
}

fn root(ed: edit.Ed) -> int {
    ed.bufs[buf(ed)].ec.undo.root
}

// `edit_assert_text` (`test_edit_cmds.c:128-136`).
fn assert_bytes(ed: edit.Ed, want: List[byte], what: str) {
    let got = text.textbuf_bytes(ed.bufs[buf(ed)].ec.tb)
    assert(got.len == want.len, "{what}: {got.len} bytes, want {want.len}")
    var i = 0
    while i < got.len {
        assert(got[i] == want[i], "{what}: byte {i} differs")
        i += 1
    }
}

fn assert_text(ed: edit.Ed, want: str, what: str) {
    assert_bytes(ed, bytes_of(want), what)
}

// `edit_place` (`test_edit_cmds.c:138-150`).
fn edit_place(mut ed: edit.Ed, off: int) {
    let w = ed.win
    let p = ed.wins[w].cs.primary
    let b = buf(ed)
    ed.wins[w].cs.curs[p].pos = off
    ed.wins[w].cs.curs[p].anchor = off
    let line = text.textbuf_line_span(
        ed.bufs[b].ec.tb,
        text.textbuf_line_of(ed.bufs[b].ec.tb, off as text.ByteOff),
    )
    ed.wins[w].cs.curs[p].goal_col = text.off_to_ccol(
        ed.bufs[b].ec.tb,
        line,
        off as text.ByteOff,
        edit.VP_TABWIDTH,
    ) as int
}

fn ok(status: int, what: str) {
    assert(status == edit.CMD_OK, "{what}: status {status}")
}

// `test_edit_l_motion_table_handles_unicode_crlf_and_viewport_counts`.
fn t_edit_l_motion_table_handles_unicode_crlf_and_viewport_counts() {
    var ed = edit_fixture(mixed_fixture(), text.EOL_CRLF)
    edit_place(mut ed, 5)
    ok(run(mut ed, "ed.move.line.home"), "home")
    assert(pos(ed) == 0, "home 0")
    ok(run(mut ed, "ed.move.line.end"), "end")
    assert(pos(ed) == 9, "end 9, at {pos(ed)}")
    ok(run(mut ed, "ed.move.line.first_nonblank"), "first nonblank")
    assert(pos(ed) == 2, "first nonblank 2")
    ok(run(mut ed, "ed.move.line.last_nonblank"), "last nonblank")
    assert(pos(ed) == 6, "last nonblank 6, at {pos(ed)}")
    ok(run(mut ed, "ed.move.line.down"), "down")
    assert(line_of_pos(ed) == 1, "line 1")
    ok(run(mut ed, "ed.move.line.up"), "up")
    assert(line_of_pos(ed) == 0, "line 0")
    ok(run(mut ed, "ed.move.line.half_page_down"), "half page down")
    assert(line_of_pos(ed) == 2, "line 2, at {line_of_pos(ed)}")
    ok(run(mut ed, "ed.view.page_down"), "page down")
    assert(line_of_pos(ed) == 4, "line 4, at {line_of_pos(ed)}")
    ok(run(mut ed, "ed.view.page_up"), "page up")
    assert(line_of_pos(ed) == 2, "line 2 again, at {line_of_pos(ed)}")
    ok(run(mut ed, "ed.move.line.half_page_up"), "half page up")
    assert(line_of_pos(ed) == 0, "line 0 again")
    ok(edit_invoke(mut ed, "ed.move.buf.end", 12, true, "", false), "12 buf end")
    assert(line_of_pos(ed) == 11, "line 11, at {line_of_pos(ed)}")
    let l11 = text.textbuf_line_span(ed.bufs[buf(ed)].ec.tb, 11 as text.LineNo)
    assert(pos(ed) == l11.lo, "line 11's start")
    ok(run(mut ed, "ed.move.buf.home"), "buf home")
    assert(pos(ed) == 0, "0")
}

// `test_edit_12G_dispatch_lands_on_one_based_line_twelve`.
fn t_edit_12G_dispatch_lands_on_one_based_line_twelve() {
    var ed = edit_fixture(mixed_fixture(), text.EOL_CRLF)
    key(mut ed, '1' as int, 0)
    key(mut ed, '2' as int, 0)
    assert(ed.chord.count_given && ed.chord.count == 12, "count 12")
    key(mut ed, 'G' as int, 0)
    assert(ed.last_status == edit.CMD_OK, "G ok")
    assert(line_of_pos(ed) == 11, "line 11, at {line_of_pos(ed)}")
    assert(
        pos(ed) == text.textbuf_line_start(ed.bufs[buf(ed)].ec.tb, 11 as text.LineNo) as int,
        "its start",
    )
    assert(!ed.chord.count_given, "count consumed")
    assert(ed.dispatch_count == 1, "one dispatch")
}

// `test_edit_delete_zwj_grapheme_removes_exactly_twenty_five_bytes`.
fn t_edit_delete_zwj_grapheme_removes_exactly_twenty_five_bytes() {
    var ed = fixture_str("{FAMILY}X", text.EOL_LF)
    assert(FAMILY.len == 25, "the family is 25 bytes")
    ok(run(mut ed, "ed.edit.delete.grapheme"), "delete")
    assert_text(ed, "X", "one cluster gone")
    assert(pos(ed) == 0, "at 0")
    assert(current(ed) == root(ed) + 1, "one step")
}

// `test_edit_4x_is_one_undo_step_for_four_clusters`.
fn t_edit_4x_is_one_undo_step_for_four_clusters() {
    let before = "a{FAMILY}\u{6F22}bc"
    var ed = fixture_str(before, text.EOL_LF)
    key(mut ed, '4' as int, 0)
    key(mut ed, 'x' as int, 0)
    assert(ed.last_status == edit.CMD_OK, "4x ok")
    assert(ed.dispatch_count == 1, "one dispatch")
    assert(current(ed) == root(ed) + 1, "one step")
    assert_text(ed, "c", "four clusters")
    ok(run(mut ed, "ed.edit.undo"), "undo")
    assert(current(ed) == root(ed), "at the root")
    assert_text(ed, before, "restored")
}

// `test_edit_insert_newline_uses_crlf_bytes`.
fn t_edit_insert_newline_uses_crlf_bytes() {
    var ed = fixture_str("ab\r\ncd", text.EOL_CRLF)
    edit_place(mut ed, 4)
    ok(edit.mode_enter(mut ed, edit.MODE_I), "I")
    key(mut ed, term.KEY_ENTER, 0)
    assert(ed.last_status == edit.CMD_OK, "enter ok")
    assert_text(ed, "ab\r\n\r\ncd", "CRLF")
    assert(pos(ed) == 6, "at 6")
    assert(current(ed) == root(ed) + 1, "one step")
    assert(!ed.insert_txn, "the newline closed the run")
    assert(
        ed.doc_damage_lo == 1 && ed.doc_damage_hi == 4,
        "rows 1..4, got {ed.doc_damage_lo}..{ed.doc_damage_hi}",
    )
}

// `test_edit_backspace_at_line_start_joins_crlf_lines`.
fn t_edit_backspace_at_line_start_joins_crlf_lines() {
    var ed = fixture_str("ab\r\ncd", text.EOL_CRLF)
    edit_place(mut ed, 4)
    ok(edit.mode_enter(mut ed, edit.MODE_I), "I")
    key(mut ed, term.KEY_BACKSPACE, 0)
    assert(ed.last_status == edit.CMD_OK, "backspace ok")
    assert_text(ed, "abcd", "joined")
    assert(pos(ed) == 2, "at 2")
    assert(ed.insert_txn, "the run is open")
    key(mut ed, term.KEY_ESCAPE, 0)
    assert(!ed.insert_txn, "escape closed it")
    assert(current(ed) == root(ed) + 1, "one step")
}

// `test_edit_insert_text_and_tab_share_one_insert_transaction`.
fn t_edit_insert_text_and_tab_share_one_insert_transaction() {
    var ed = edit_fixture(List[byte](), text.EOL_LF)
    ok(edit.mode_enter(mut ed, edit.MODE_I), "I")
    var acute = List[int]()
    (mut acute).push(195)
    (mut acute).push(169)
    edit.ed_handle_key(mut ed, edit_text_key(raw(acute)), 0)
    assert(ed.last_status == edit.CMD_OK, "é ok")
    assert(ed.insert_txn, "open")
    assert(
        ed.doc_damage_lo == 0 && ed.doc_damage_hi == 1,
        "row 0, got {ed.doc_damage_lo}..{ed.doc_damage_hi}",
    )
    key(mut ed, term.KEY_TAB, 0)
    assert(ed.last_status == edit.CMD_OK, "tab ok")
    assert(ed.insert_txn, "still open")
    key(mut ed, term.KEY_ESCAPE, 0)
    var want = copy acute
    (mut want).push(9)
    assert_bytes(ed, raw(want), "é then a tab")
    assert(current(ed) == root(ed) + 1, "one step")
    assert(!ed.insert_txn, "closed")
    ok(run(mut ed, "ed.edit.undo"), "undo")
    assert_bytes(ed, List[byte](), "empty")
}

// `test_edit_insert_motion_splits_typing_into_two_undo_steps`.
fn t_edit_insert_motion_splits_typing_into_two_undo_steps() {
    var ed = edit_fixture(List[byte](), text.EOL_LF)
    ok(edit.mode_enter(mut ed, edit.MODE_I), "I")
    key(mut ed, 'h' as int, 0)
    key(mut ed, 'e' as int, 0)
    key(mut ed, 'l' as int, 0)
    assert(ed.insert_txn, "open")
    key(mut ed, term.KEY_LEFT, 0)
    assert(!ed.insert_txn, "a motion closes the run")
    key(mut ed, 'l' as int, 0)
    key(mut ed, 'o' as int, 0)
    key(mut ed, term.KEY_ESCAPE, 0)
    assert_text(ed, "helol", "typed")
    assert(current(ed) == root(ed) + 2, "two steps")
    ok(run(mut ed, "ed.edit.undo"), "undo 1")
    assert_text(ed, "hel", "the second run undone")
    ok(run(mut ed, "ed.edit.undo"), "undo 2")
    assert_text(ed, "", "the first run undone")
}

// `test_edit_escape_closes_typing_as_one_undo_step`.
fn t_edit_escape_closes_typing_as_one_undo_step() {
    var ed = edit_fixture(List[byte](), text.EOL_LF)
    ok(edit.mode_enter(mut ed, edit.MODE_I), "I")
    for c in "hello".bytes() {
        key(mut ed, c as int, 0)
    }
    assert(ed.insert_txn, "open")
    assert(current(ed) == root(ed) + 1, "one node")
    assert(ed.bufs[buf(ed)].ec.undo.depth == 1, "depth 1")
    key(mut ed, term.KEY_ESCAPE, 0)
    assert(ed.mode == edit.MODE_L, "L")
    assert(!ed.insert_txn, "closed")
    assert(current(ed) == root(ed) + 1, "one step")
    assert_text(ed, "hello", "typed")
    ok(run(mut ed, "ed.edit.undo"), "undo")
    assert_text(ed, "", "undone")
}

// `test_edit_open_above_and_below_emit_native_eol_and_enter_insert`.
fn t_edit_open_above_and_below_emit_native_eol_and_enter_insert() {
    var ed = fixture_str("aa\r\nbb", text.EOL_CRLF)
    edit_place(mut ed, 4)
    ok(run(mut ed, "ed.edit.line.open_above"), "open above")
    assert(ed.mode == edit.MODE_I, "I")
    assert(pos(ed) == 4, "at 4")
    assert_text(ed, "aa\r\n\r\nbb", "above")
    ok(edit.mode_escape(mut ed), "escape")
    ok(run(mut ed, "ed.edit.line.open_below"), "open below")
    assert(ed.mode == edit.MODE_I, "I")
    assert(pos(ed) == 6, "at 6, at {pos(ed)}")
    assert_text(ed, "aa\r\n\r\n\r\nbb", "both")
}

// `test_edit_line_delete_undo_and_redo_preserve_crlf_bytes`.
fn t_edit_line_delete_undo_and_redo_preserve_crlf_bytes() {
    var ed = fixture_str("aa\r\nbb\r\ncc", text.EOL_CRLF)
    edit_place(mut ed, 4)
    key(mut ed, 'd' as int, 0)
    assert(ed.chord.n == 1, "a pending chord")
    key(mut ed, 'd' as int, 0)
    assert(ed.last_status == edit.CMD_OK, "dd ok")
    assert_text(ed, "aa\r\ncc", "deleted")
    assert(current(ed) == root(ed) + 1, "one step")
    key(mut ed, 'u' as int, 0)
    assert_text(ed, "aa\r\nbb\r\ncc", "undone")
    assert(current(ed) == root(ed), "root")
    ok(run(mut ed, "ed.edit.redo"), "redo")
    assert_text(ed, "aa\r\ncc", "redone")
}

// `test_edit_insert_after_and_i_arrows_use_grapheme_boundaries`.
fn t_edit_insert_after_and_i_arrows_use_grapheme_boundaries() {
    var ed = fixture_str("A{FAMILY}\u{6F22}\r\nZ", text.EOL_CRLF)
    ok(run(mut ed, "ed.edit.insert.after"), "insert after")
    assert(ed.mode == edit.MODE_I, "I")
    assert(pos(ed) == 1, "at 1")
    key(mut ed, term.KEY_RIGHT, 0)
    assert(pos(ed) == 26, "past the family, at {pos(ed)}")
    key(mut ed, term.KEY_RIGHT, 0)
    assert(pos(ed) == 29, "past the han, at {pos(ed)}")
    key(mut ed, term.KEY_LEFT, 0)
    assert(pos(ed) == 26, "back to 26")
    key(mut ed, term.KEY_END, 0)
    assert(pos(ed) == 29, "end 29")
    key(mut ed, term.KEY_DOWN, 0)
    assert(line_of_pos(ed) == 1, "line 1")
    key(mut ed, term.KEY_HOME, 0)
    assert(
        pos(ed) == text.textbuf_line_start(ed.bufs[buf(ed)].ec.tb, 1 as text.LineNo) as int,
        "line 1's start",
    )
    key(mut ed, term.KEY_UP, 0)
    assert(line_of_pos(ed) == 0, "line 0")
}

// `test_edit_forward_delete_removes_invalid_byte_as_one_cluster`.
fn t_edit_forward_delete_removes_invalid_byte_as_one_cluster() {
    var before = List[int]()
    (mut before).push(97)
    (mut before).push(255)
    (mut before).push(98)
    var ed = edit_fixture(raw(before), text.EOL_LF)
    edit_place(mut ed, 1)
    ok(edit.mode_enter(mut ed, edit.MODE_I), "I")
    key(mut ed, term.KEY_DELETE, 0)
    assert(ed.last_status == edit.CMD_OK, "delete ok")
    assert_text(ed, "ab", "the raw byte gone")
    assert(pos(ed) == 1, "at 1")
}

fn write_file(path: str, s: str) {
    fs.write_bytes(path, bytes_of(s)) else |_| {
        assert(false, "write {path}")
    }
}

// `test_edit_journal_open_failure_returns_io_without_mutation`.
fn t_edit_journal_open_failure_returns_io_without_mutation() {
    let saved = env_get("XDG_STATE_HOME") else ""
    let cwd = os_cwd() else "."
    let root_dir = "{cwd}/target/tests/edit-cmd-journal"
    fs_remove_dir_all(root_dir) else |_| {}
    fs_create_dir_all(root_dir) else {}
    let blocker = "{root_dir}/blocker"
    write_file(blocker, "x")
    env_set("XDG_STATE_HOME", blocker) else |_| {}

    var ed = fixture_str("abc", text.EOL_LF)
    let b = buf(ed)
    let source = "{root_dir}/no-such-source"
    ed.bufs[b].path = source
    ed.bufs[b].has_path = true
    ed.bufs[b].ec.meta.realpath = source
    ed.bufs[b].ec.meta.has_realpath = true
    ed.bufs[b].ec.has_meta = true
    assert(
        edit_invoke(mut ed, "ed.edit.insert.text", 1, false, "X", true) == edit.CMD_ERR_IO,
        "no journal: refused",
    )
    assert_text(ed, "abc", "unchanged")
    assert(current(ed) == root(ed), "root")
    assert(ed.bufs[b].ec.undo.nodes.len == 1, "no node")
    assert(ed.bufs[b].ec.undo.ops.len == 0, "no op")
    assert(!ed.bufs[b].ec.has_jrnl, "no journal")
    assert(pos(ed) == 0, "the caret did not move")
    assert(ed.durability_failed, "durability failed")
    assert(ed.msg.active && ed.msg.sev == edit.MSG_ERROR, "an error")
    assert(ed.msg.text.contains("crash journal failed"), "message '{ed.msg.text}'")
    assert(
        edit_invoke(mut ed, "ed.edit.insert.text", 1, false, "Y", true) == edit.CMD_ERR_IO,
        "still refused",
    )
    assert_text(ed, "abc", "still unchanged")
    assert(edit.ed_request_quit(mut ed, false) == edit.CMD_ERR_IO, "quit refuses")
    assert(!ed.quit, "not quitting")
    ok(edit.ed_request_quit(mut ed, true), "quit!")
    assert(ed.quit, "quitting")

    let source_path = "{root_dir}/source.txt"
    write_file(source_path, "abc")
    env_set("XDG_STATE_HOME", root_dir) else |_| {}
    var ed2 = edit.ed_new()
    edit.ed_open_scratch(mut ed2)
    let idx = edit.tab_open(mut ed2, source_path)
    assert(idx >= 0, "the tab opens")
    assert(edit.tab_hydrate(mut ed2, idx) == 0, "the file loads")
    edit.tab_switch(mut ed2, idx)
    ok(edit_invoke(mut ed2, "ed.edit.insert.text", 1, false, "X", true), "insert X")
    assert_text(ed2, "Xabc", "inserted")
    ok(edit.ed_file_save(mut ed2, false), "save")
    assert(!ed2.bufs[buf(ed2)].ec.has_jrnl, "the save discarded the journal")
    env_set("XDG_STATE_HOME", blocker) else |_| {}
    assert(
        edit_invoke(mut ed2, "ed.edit.undo", 1, false, "", false) == edit.CMD_ERR_IO,
        "undo needs a journal",
    )
    assert_text(ed2, "Xabc", "not undone")
    assert(ed2.durability_failed, "durability failed")
    assert(edit.ed_request_quit(mut ed2, false) == edit.CMD_ERR_IO, "quit refuses")
    assert(!ed2.quit, "not quitting")

    if saved.len == 0 {
        env_unset("XDG_STATE_HOME") else |_| {}
    } else {
        env_set("XDG_STATE_HOME", saved) else |_| {}
    }
    fs_remove_dir_all(root_dir) else |_| {}
}

fn stack_n(ed: edit.Ed, i: int) -> int {
    ed.wins[ed.win].cs.selstacks[i].n
}

fn anchor(ed: edit.Ed) -> int {
    let w = ed.win
    ed.wins[w].cs.curs[ed.wins[w].cs.primary].anchor
}

// `test_edit_unit_selection_replays_and_invalidates`.
fn t_edit_unit_selection_replays_and_invalidates() {
    var ed = fixture_str("one\n\n  two\n    three\n", text.EOL_LF)
    edit_place(mut ed, 16)
    assert(ed.mode == edit.MODE_L, "L")
    ed.full_damage = false
    ok(run(mut ed, "ed.sel.unit.expand"), "expand")
    assert(ed.full_damage, "a full repaint")
    assert(stack_n(ed, 0) == 1, "one level")
    let level0 = copy ed.wins[ed.win].cs.selstacks[0].s[0]
    assert(anchor(ed) == level0.lo && pos(ed) == level0.hi, "level 0 selected")
    ok(run(mut ed, "ed.sel.unit.expand"), "expand 2")
    assert(stack_n(ed, 0) == 2, "two levels")
    let level1 = copy ed.wins[ed.win].cs.selstacks[0].s[1]
    assert(level1.lo <= level0.lo && level1.hi >= level0.hi, "level 1 contains level 0")
    ok(run(mut ed, "ed.sel.unit.expand"), "expand 3")
    assert(stack_n(ed, 0) >= 3, "three or more")
    ed.full_damage = false
    ok(run(mut ed, "ed.sel.unit.contract"), "contract")
    assert(ed.full_damage, "a full repaint")
    let n = stack_n(ed, 0)
    let top = copy ed.wins[ed.win].cs.selstacks[0].s[n - 1]
    assert(anchor(ed) == top.lo && pos(ed) == top.hi, "the top level selected")
    ok(run(mut ed, "ed.sel.unit.contract"), "contract 2")
    assert(stack_n(ed, 0) == 1, "one level")
    assert(anchor(ed) == level0.lo && pos(ed) == level0.hi, "level 0 again")
    ok(run(mut ed, "ed.move.line.home"), "a motion")
    assert(stack_n(ed, 0) == 0, "the stack cleared")
    edit_place(mut ed, 16)
    ok(run(mut ed, "ed.sel.unit.expand"), "expand again")
    assert(stack_n(ed, 0) == 1, "one level")
    ok(edit_invoke(mut ed, "ed.edit.insert.text", 1, false, "X", true), "an edit")
    assert(stack_n(ed, 0) == 0, "an edit clears it")
}

// `test_edit_word_and_block_key_layers_dispatch`.
fn t_edit_word_and_block_key_layers_dispatch() {
    var ed = fixture_str("abcdef\nxy", text.EOL_LF)
    let w = ed.win
    ed.wins[w].vp.cols = 3
    ed.wins[w].vp.wrap = true
    edit_place(mut ed, 1)
    key(mut ed, term.KEY_DOWN, 0)
    assert(ed.last_cmd == edit.cmd_lookup(ed.reg, "ed.move.unit.next"), "down is unit next")
    assert(pos(ed) == 4, "down a display row: 4, at {pos(ed)}")
    var alt_down = edit_key(term.KEY_DOWN)
    alt_down.mods = term.MOD_ALT
    edit.ed_handle_key(mut ed, alt_down, 1)
    assert(ed.last_cmd == edit.cmd_lookup(ed.reg, "ed.git.hunk.next"), "M-down is the next hunk")
    assert(pos(ed) == 4, "no hunk: unmoved")
    key(mut ed, term.KEY_LEFT, 2)
    assert(ed.last_cmd == edit.cmd_lookup(ed.reg, "ed.move.unit.home"), "left is unit home")
    assert(pos(ed) == 0, "home 0")

    ed = fixture_str("foo \u{6F22}\u{5B57} tail\n", text.EOL_LF)
    key(mut ed, 'w' as int, 0)
    assert(ed.mode == edit.MODE_W, "w enters W")
    key(mut ed, term.KEY_RIGHT, 1)
    assert(pos(ed) == 4, "right is the next word, at {pos(ed)}")

    ed = fixture_str("one\n\n  two\n    three\n", text.EOL_LF)
    edit_place(mut ed, 16)
    key(mut ed, 'b' as int, 0)
    assert(ed.mode == edit.MODE_B, "b enters B")
    var k = edit_key(term.KEY_UP)
    k.mods = term.MOD_ALT | term.MOD_SHIFT
    edit.ed_handle_key(mut ed, k, 1)
    assert(stack_n(ed, 0) == 1, "M-S-up expands")
}

// `test_edit_unit_selection_multicursor_has_independent_stacks`.
fn t_edit_unit_selection_multicursor_has_independent_stacks() {
    var ed = fixture_str("alpha\n\nbeta\n", text.EOL_LF)
    edit_place(mut ed, 1)
    let w = ed.win
    assert(text.cset_add(mut ed.wins[w].cs, text.Cursor { pos: 7, goal_col: 0, anchor: 7 }), "add 7")
    assert(ed.wins[w].cs.curs.len == 2, "two")
    ok(run(mut ed, "ed.sel.unit.expand"), "expand")
    assert(ed.wins[w].cs.curs.len == 2, "still two")
    assert(ed.wins[w].cs.selstacks.len == 2, "two stacks")
    assert(stack_n(ed, 0) == 1 && stack_n(ed, 1) == 1, "one level each")
    assert(ed.wins[w].cs.curs[0].pos != ed.wins[w].cs.curs[0].anchor, "c0 selects")
    assert(ed.wins[w].cs.curs[1].pos != ed.wins[w].cs.curs[1].anchor, "c1 selects")
    ok(run(mut ed, "ed.sel.unit.contract"), "contract")
    assert(ed.wins[w].cs.curs.len == 2, "still two")
    assert(stack_n(ed, 0) == 0 && stack_n(ed, 1) == 0, "empty stacks")
    assert(ed.wins[w].cs.curs[0].pos == ed.wins[w].cs.curs[0].anchor, "c0 collapsed")
    assert(ed.wins[w].cs.curs[1].pos == ed.wins[w].cs.curs[1].anchor, "c1 collapsed")
}

// `test_edit_view_number_cycle_walks_none_abs_rel_hybrid`.
fn t_edit_view_number_cycle_walks_none_abs_rel_hybrid() {
    var ed = fixture_str("aa\nbb\n", text.EOL_LF)
    let w = ed.win
    ed.wins[w].number_style = edit.NUM_NONE
    var order = List[int]()
    (mut order).push(edit.NUM_ABS)
    (mut order).push(edit.NUM_REL)
    (mut order).push(edit.NUM_HYBRID)
    (mut order).push(edit.NUM_NONE)
    for want in order {
        ok(run(mut ed, "ed.view.number_cycle"), "cycle")
        assert(ed.wins[w].number_style == want, "style {ed.wins[w].number_style}, want {want}")
    }
    ed.wins[w].number_style = edit.NUM_REL
    ok(run(mut ed, "ed.view.number_cycle"), "cycle from rel")
    assert(ed.wins[w].number_style == edit.NUM_HYBRID, "rel cycles to hybrid")
}

// `edit_set_bool` (`test_edit_cmds.c:777-787`): `yew_opt_set` in the
// option's declared scope.
fn edit_set_bool(mut ed: edit.Ed, name: str, on: bool) {
    assert(
        edit.opt_set(mut ed, edit.OPT_SCOPE_DECLARED, name, edit.optv_bool(on)).len == 0,
        "set {name}",
    )
}

// `edit_undo_ops` (`test_edit_cmds.c:789-795`).
fn edit_undo_ops(ed: edit.Ed) -> int {
    let cur = current(ed)
    assert(cur != 0, "a current node")
    ed.bufs[buf(ed)].ec.undo.nodes[cur - 1].n_ops
}

// `edit_enter` (`test_edit_cmds.c:797-802`).
fn edit_enter(mut ed: edit.Ed) {
    ok(edit.mode_enter(mut ed, edit.MODE_I), "I")
    key(mut ed, term.KEY_ENTER, 0)
    assert(ed.last_status == edit.CMD_OK, "enter ok")
}

// `test_edit_enter_carries_indent_and_adds_a_level_after_an_opener`.
fn t_edit_enter_carries_indent_and_adds_a_level_after_an_opener() {
    var ed = fixture_str("    alpha\n", text.EOL_LF)
    edit_place(mut ed, 9)
    edit_enter(mut ed)
    assert_text(ed, "    alpha\n    \n", "carried")
    assert(pos(ed) == 14, "at 14, at {pos(ed)}")
    assert(current(ed) == root(ed) + 1, "one step")
    assert(edit_undo_ops(ed) == 1, "one op")
    ok(run(mut ed, "ed.edit.undo"), "undo")
    assert_text(ed, "    alpha\n", "undone")

    ed = fixture_str("if (x) {{\n", text.EOL_LF)
    edit_place(mut ed, 8)
    edit_enter(mut ed)
    assert_text(ed, "if (x) {{\n\t\n", "opened")
    assert(pos(ed) == 10, "at 10")
    assert(edit_undo_ops(ed) == 1, "one op")

    ed = fixture_str("if (x) {{\n", text.EOL_LF)
    edit_set_bool(mut ed, "expandtab", true)
    edit_place(mut ed, 8)
    edit_enter(mut ed)
    assert_text(ed, "if (x) {{\n    \n", "spaced")
    assert(pos(ed) == 13, "at 13")
}

// `test_edit_enter_between_a_matched_pair_opens_three_lines`.
fn t_edit_enter_between_a_matched_pair_opens_three_lines() {
    var ed = fixture_str("fn() {{}}\n", text.EOL_LF)
    edit_place(mut ed, 6)
    edit_enter(mut ed)
    assert_text(ed, "fn() {{\n\t\n}}\n", "three lines")
    assert(pos(ed) == 8, "on the middle line")
    assert(current(ed) == root(ed) + 1, "one step")
    assert(edit_undo_ops(ed) == 1, "one op")
    ok(run(mut ed, "ed.edit.undo"), "undo")
    assert_text(ed, "fn() {{}}\n", "undone")
}

// `test_edit_enter_strips_the_whitespace_it_abandons`.
fn t_edit_enter_strips_the_whitespace_it_abandons() {
    var ed = fixture_str("alpha\n    \n", text.EOL_LF)
    edit_place(mut ed, 10)
    edit_enter(mut ed)
    assert_text(ed, "alpha\n\n    \n", "stripped")
    assert(pos(ed) == 11, "at 11")
    assert(current(ed) == root(ed) + 1, "one step")
    assert(edit_undo_ops(ed) == 2, "two ops")
    ok(run(mut ed, "ed.edit.undo"), "undo")
    assert_text(ed, "alpha\n    \n", "undone")
}

// `test_edit_autoindent_off_keeps_the_literal_insert_bytes`.
fn t_edit_autoindent_off_keeps_the_literal_insert_bytes() {
    var ed = fixture_str("    alpha\n", text.EOL_LF)
    edit_set_bool(mut ed, "autoindent", false)
    edit_place(mut ed, 9)
    edit_enter(mut ed)
    assert_text(ed, "    alpha\n\n", "a literal newline")
    assert(pos(ed) == 10, "at 10")
    assert(current(ed) == root(ed) + 1, "one step")

    ed = fixture_str("    alpha\n", text.EOL_LF)
    edit_set_bool(mut ed, "autoindent", false)
    edit_place(mut ed, 2)
    ok(edit.mode_enter(mut ed, edit.MODE_I), "I")
    key(mut ed, term.KEY_TAB, 0)
    assert(ed.last_status == edit.CMD_OK, "tab ok")
    assert_text(ed, "  \t  alpha\n", "a literal tab")
    assert(pos(ed) == 3, "at 3")
    key(mut ed, term.KEY_BACKSPACE, 0)
    assert_text(ed, "    alpha\n", "one byte back")
    assert(pos(ed) == 2, "at 2")
}

// `test_edit_tab_navigates_then_indents_then_inserts`.
fn t_edit_tab_navigates_then_indents_then_inserts() {
    var ed = fixture_str("    alpha\n", text.EOL_LF)
    edit_place(mut ed, 2)
    ok(run(mut ed, "ed.edit.insert.tab"), "tab in the indent")
    assert_text(ed, "    alpha\n", "unchanged")
    assert(pos(ed) == 4, "moved to 4")
    assert(current(ed) == root(ed), "no step")
    ok(run(mut ed, "ed.edit.insert.tab"), "tab at the first non-blank")
    assert_text(ed, "\t    alpha\n", "the line indented")
    assert(pos(ed) == 5, "at 5")
    assert(current(ed) == root(ed) + 1, "one step")

    ed = fixture_str("    alpha\n", text.EOL_LF)
    edit_place(mut ed, 6)
    ok(run(mut ed, "ed.edit.insert.tab"), "tab mid-word")
    assert_text(ed, "    al\tpha\n", "inserted")
    assert(pos(ed) == 7, "at 7")

    ed = fixture_str("\n", text.EOL_LF)
    edit_place(mut ed, 0)
    ok(run(mut ed, "ed.edit.insert.tab"), "tab on a blank line")
    assert_text(ed, "\t\n", "one unit")
    assert(pos(ed) == 1, "at 1")
}

// `test_edit_tab_emits_spaces_under_expandtab`.
fn t_edit_tab_emits_spaces_under_expandtab() {
    var ed = fixture_str("alpha\n", text.EOL_LF)
    edit_set_bool(mut ed, "expandtab", true)
    edit_place(mut ed, 0)
    ok(run(mut ed, "ed.edit.insert.tab"), "tab")
    assert_text(ed, "    alpha\n", "spaces")
    assert(pos(ed) == 4, "at 4")
}

// `test_edit_backspace_in_leading_whitespace_eats_one_level`.
fn t_edit_backspace_in_leading_whitespace_eats_one_level() {
    var ed = fixture_str("        alpha\n", text.EOL_LF)
    edit_place(mut ed, 8)
    ok(edit.mode_enter(mut ed, edit.MODE_I), "I")
    key(mut ed, term.KEY_BACKSPACE, 0)
    assert_text(ed, "    alpha\n", "one level")
    assert(pos(ed) == 4, "at 4")
    key(mut ed, term.KEY_BACKSPACE, 0)
    assert_text(ed, "alpha\n", "two levels")
    assert(pos(ed) == 0, "at 0")
    key(mut ed, term.KEY_ESCAPE, 0)

    ed = fixture_str("     alpha\n", text.EOL_LF)
    edit_place(mut ed, 5)
    ok(edit.mode_enter(mut ed, edit.MODE_I), "I")
    key(mut ed, term.KEY_BACKSPACE, 0)
    assert_text(ed, "    alpha\n", "snapped to the level")
    assert(pos(ed) == 4, "at 4")
}

const TAB_INDENT: str = "    fn total\n\tvar acc = zero\n  \tmixed\n        wide"

// `test_edit_vertical_goal_agrees_with_wrap_on_and_off`.
fn t_edit_vertical_goal_agrees_with_wrap_on_and_off() {
    var landed = List[int]()
    var pass = 0
    while pass < 2 {
        var ed = fixture_str(TAB_INDENT, text.EOL_LF)
        let w = ed.win
        ed.wins[w].vp.cols = 80
        ed.wins[w].vp.wrap = pass == 1
        ed.wins[w].wrap_goal_valid = false
        edit_place(mut ed, 14)
        key(mut ed, term.KEY_UP, 0)
        (mut landed).push(pos(ed))
        key(mut ed, term.KEY_DOWN, 1)
        (mut landed).push(pos(ed))
        key(mut ed, term.KEY_DOWN, 2)
        (mut landed).push(pos(ed))
        pass += 1
    }
    assert(
        landed[0] == 4 && landed[1] == 14 && landed[2] == 32,
        "wrap off: {landed[0]} {landed[1]} {landed[2]}",
    )
    assert(
        landed[3] == landed[0] && landed[4] == landed[1] && landed[5] == landed[2],
        "wrap on agrees: {landed[3]} {landed[4]} {landed[5]}",
    )
}

// `test_edit_tab_adopts_the_established_indent`.
fn t_edit_tab_adopts_the_established_indent() {
    var ed = fixture_str("\t\t\tsome text\n\nnext\n", text.EOL_LF)
    edit_place(mut ed, 13)
    ok(run(mut ed, "ed.edit.insert.tab"), "tab")
    assert_text(ed, "\t\t\tsome text\n\t\t\t\nnext\n", "the established column")
    assert(pos(ed) == 16, "at 16")
    ok(run(mut ed, "ed.edit.insert.tab"), "tab again")
    assert_text(ed, "\t\t\tsome text\n\t\t\t\t\nnext\n", "one level deeper")

    ed = fixture_str("\t\tanchor\n\n\n", text.EOL_LF)
    edit_place(mut ed, 10)
    ok(run(mut ed, "ed.edit.insert.tab"), "tab past a blank line")
    assert_text(ed, "\t\tanchor\n\n\t\t\n", "the established column across a gap")

    ed = fixture_str("alpha\n\n", text.EOL_LF)
    edit_place(mut ed, 6)
    ok(run(mut ed, "ed.edit.insert.tab"), "tab with nothing established")
    assert_text(ed, "alpha\n\t\n", "one level")
}

// `test_edit_down_is_vertical_after_leaving_insert`.
fn t_edit_down_is_vertical_after_leaving_insert() {
    var ed = fixture_str("fn main() -> !int {{\n\n\t0\n}}", text.EOL_LF)
    edit_place(mut ed, 23)
    ed.prev_unit = edit.MODE_I
    ok(run(mut ed, "ed.move.unit.next"), "unit next")
    assert(pos(ed) == 25, "past the brace, at {pos(ed)}")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_edit_l_motion_table_handles_unicode_crlf_and_viewport_counts()
    t_edit_12G_dispatch_lands_on_one_based_line_twelve()
    t_edit_delete_zwj_grapheme_removes_exactly_twenty_five_bytes()
    t_edit_4x_is_one_undo_step_for_four_clusters()
    t_edit_insert_newline_uses_crlf_bytes()
    t_edit_backspace_at_line_start_joins_crlf_lines()
    t_edit_insert_text_and_tab_share_one_insert_transaction()
    t_edit_insert_motion_splits_typing_into_two_undo_steps()
    t_edit_escape_closes_typing_as_one_undo_step()
    t_edit_open_above_and_below_emit_native_eol_and_enter_insert()
    t_edit_line_delete_undo_and_redo_preserve_crlf_bytes()
    t_edit_insert_after_and_i_arrows_use_grapheme_boundaries()
    t_edit_forward_delete_removes_invalid_byte_as_one_cluster()
    t_edit_journal_open_failure_returns_io_without_mutation()
    t_edit_unit_selection_replays_and_invalidates()
    t_edit_word_and_block_key_layers_dispatch()
    t_edit_unit_selection_multicursor_has_independent_stacks()
    t_edit_view_number_cycle_walks_none_abs_rel_hybrid()
    t_edit_enter_carries_indent_and_adds_a_level_after_an_opener()
    t_edit_enter_between_a_matched_pair_opens_three_lines()
    t_edit_enter_strips_the_whitespace_it_abandons()
    t_edit_autoindent_off_keeps_the_literal_insert_bytes()
    t_edit_tab_navigates_then_indents_then_inserts()
    t_edit_tab_emits_spaces_under_expandtab()
    t_edit_backspace_in_leading_whitespace_eats_one_level()
    t_edit_vertical_goal_agrees_with_wrap_on_and_off()
    t_edit_tab_adopts_the_established_indent()
    t_edit_down_is_vertical_after_leaving_insert()
    print("edit_cmds_test: 28 cases pass")
}
