//! member: false
//! yw09b: config refusal semantics measured against sagitta.pin, runtime
//! identity (R-yw09b-1 A), and the built-in bind recovery contract.

use edit
use std.fs

fn put(path: str, text: str) { fs.write_text(path, text) else { assert(false, path) } }

fn setenv(name: str, value: str) { env_set(name, value) else { assert(false, name) } }

fn unset(name: str) { env_unset(name) else {} }

fn has_binding(ed: edit.Ed, key: str) -> bool {
    let seq = edit.key_parse_seq(key, edit.CHORD_MAX)
    assert(seq.len != 0)
    let km = edit.bind_keys(ed, edit.MODE_L)
    let (kind, _, _) = edit.keymap_lookup(km, seq, seq.len)
    kind == edit.MATCH_FULL || kind == edit.MATCH_FULL_PREFIX
}

fn runtime_identity(root: str) {
    unset("YEW_RUNTIME_DIR")
    let prefix = "{root}/prefix"
    fs.create_dir_all(prefix) else { assert(false) }
    let (ok, embedded) = edit.runtime_embedded("init.fl")
    assert(ok)
    put("{prefix}/init.fl", embedded)
    let (same, dir) = edit.runtime_root_at(prefix)
    assert(same == edit.RUNTIME_ROOT_PREFIX && dir == prefix, "runtime_prefix_identical")
    assert(edit.runtime_skew_warning_at(prefix) == "")
    put("{prefix}/init.fl", "!" + embedded[1..])
    let (skew, _) = edit.runtime_root_at(prefix)
    assert(skew == edit.RUNTIME_ROOT_EMBEDDED, "runtime_prefix_skew")
    assert(edit.runtime_skew_warning_at(prefix).contains(edit.RUNTIME_PIN))
    setenv("YEW_RUNTIME_DIR", "{root}/override")
    let (explicit, path) = edit.runtime_root_at(prefix)
    assert(explicit == edit.RUNTIME_ROOT_ENV && path == "{root}/override")
    assert(edit.runtime_skew_warning_at(prefix) == "")
    let (found, _, _) = edit.runtime_read("init.fl")
    assert(!found, "an absent explicit override never falls through")
}

fn config_rows(root: str, source_kind: int) {
    let runtime = "{root}/runtime"
    let user = "{root}/config/yew/init.fl"
    let work = "{root}/work"
    for d in [runtime, "{root}/config/yew", "{root}/state", work] {
        fs.create_dir_all(d) else { assert(false, d) }
    }
    setenv("YEW_RUNTIME_DIR", runtime)
    setenv("XDG_CONFIG_HOME", "{root}/config")
    setenv("XDG_STATE_HOME", "{root}/state")
    put("{runtime}/init.fl", "bind(\"L\", \"X\", \"ed.nop\")\n")
    let bad = "bind(\"L\", \"Y\", \"ed.nop\")\nbind(\"L\", \"t h\", \"ed.theme.pick\")\nbind(\"L\", \"Z\", \"ed.nop\")\nset({{errorbells: true}})\n"
    let path = if source_kind == 0 {
        "{runtime}/init.fl"
    } else if source_kind == 1 {
        user
    } else {
        "{work}/.yew.fl"
    }
    if source_kind == 0 {
        put(path, "bind(\"L\", \"X\", \"ed.nop\")\n" + bad)
    } else {
        put(path, bad)
    }
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.ws_dir = work
    var s = edit.startup_default()
    s.trust_workspace = true
    edit.config_init(mut ed, s)
    assert(edit.config_load_all(mut ed) == edit.CFG_RUN)
    assert(has_binding(ed, "X"), "runtime_keeps_builtin_keymap")
    let builtin = source_kind == 0
    assert(has_binding(ed, "Y") == builtin, "config_before_raise")
    assert(has_binding(ed, "Z") == builtin, "config_after_raise")
    let bells = edit.opt_get_current(ed, "errorbells") else { assert(false); edit.optv_bool(false) }
    assert(bells.b == builtin, "statements_after_raise")
    let shown = ed.msg.text
    assert(shown.contains("unknown command 'ed.theme.pick'"), "refusal_names_command")
    assert(shown.contains("{path}:{if builtin then 3 else 2}:5"), "refusal_names_file_line")
    assert(!shown.contains("Sprint 36"), "unknown_command_has_no_invented_owner")
    // Reload uses the same recovery/teardown policy and never accumulates rows.
    let count = edit.bind_active_count(ed)
    assert(edit.config_reload(mut ed) == edit.CFG_RUN)
    assert(edit.bind_active_count(ed) == count)
}

fn main() {
    let tmp = env_get("TMPDIR") else "target"
    let root = "{tmp}/yw09b-runtime-{os_pid()}"
    fs.create_dir_all(root) else { assert(false) }
    let selected = (env_get("YEW_RUNTIME_SKEW_CASE") else "-1").to_int() else -1
    if selected < 0 || selected == 0 { region prefix { runtime_identity(root) } }
    for kind in 0..3 {
        if selected < 0 || selected == kind + 1 {
            region config { config_rows("{root}/{kind}", kind) }
        }
    }
    fs.remove_dir_all(root) else { assert(false) }
    print(
        "runtime_skew: prefix identity, override, built-in recovery, C user/workspace policy, diagnostics, reload: ok",
    )
}
