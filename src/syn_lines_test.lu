//! member: false
//! Ports the state-array laws of sagitta test_syn_splice.c and the
//! fixpoint/frontier laws of test_syn_settle.c at 9ace98c2. The scanner
//! supplies exit ids separately: these rows isolate propagation from regex.
use syn

fn settle_plain(mut lines: syn.SynLines) -> int {
    var evaluated: int = 0
    while lines.settling {
        let _ = syn.syn_lines_accept(mut lines, 1)
        evaluated += 1
    }
    evaluated
}

fn splice_table() {
    let n = [1, 2, 5, 5, 5, 8, 8, 3]
    let lo = [0, 0, 4, 2, 2, 1, 0, 1]
    let removed = [0, 0, 0, 1, 0, 3, 7, 0]
    let inserted = [0, 1, 1, 0, 3, 1, 0, 10000]
    var i = 0
    while i < 8 {
        var lines = syn.syn_lines_new(n[i])
        let _ = settle_plain(mut lines)
        syn.syn_lines_edit(mut lines, lo[i], removed[i], inserted[i])
        assert(syn.syn_ids_len(lines.entry) == n[i] - removed[i] + inserted[i], "splice length")
        assert(syn.syn_ids_get(lines.entry, 0) == 1, "entering root retained")
        assert(lines.wave == lo[i], "wave begins at edited line")
        assert(lines.settled_to == lo[i] + 1, "entering edited line is proven")
        assert(lines.splice_count == 1, "one vector splice per notification")
        i += 1
    }
}

fn retains_tail() {
    var lines = syn.syn_lines_new(6)
    var i = 1
    while i < 6 {
        syn.syn_ids_set(mut lines.entry, i, 100 + i)
        i += 1
    }
    syn.syn_lines_edit(mut lines, 2, 1, 3)
    assert(syn.syn_ids_get(lines.entry, 1) == 101, "prefix line 1")
    assert(syn.syn_ids_get(lines.entry, 2) == 102, "entering edited line")
    i = 3
    while i < 6 {
        assert(syn.syn_ids_get(lines.entry, i) == 0, "inserted slots unknown")
        i += 1
    }
    assert(syn.syn_ids_get(lines.entry, 6) == 104, "first retained tail")
    assert(syn.syn_ids_get(lines.entry, 7) == 105, "last retained tail")
}

fn local_10000() {
    var lines = syn.syn_lines_new(10000)
    assert(settle_plain(mut lines) == 10000, "initially evaluate every unknown line")
    let points = [0, 4999, 9999]
    var i = 0
    while i < points.len {
        syn.syn_lines_edit(mut lines, points[i], 0, 0)
        let before = lines.accepted_lines
        let evaluated = settle_plain(mut lines)
        assert(evaluated <= 2, "syn_lines_local_10000: local edit is not a file walk")
        assert(lines.accepted_lines - before == evaluated, "one acceptance per evaluated line")
        assert(lines.settled_to == 10000, "known tail proves full fixpoint")
        assert(!lines.settling, "wave ended")
        i += 1
    }
    assert(syn.syn_ids_bytes(lines.entry) == 40000, "10,000 lines cost 40,000 id bytes")
}

fn pending_frontier() {
    var lines = syn.syn_lines_new(10000)
    let _ = settle_plain(mut lines)
    // The high edit has not run when a low edit arrives. Retained entry[1]
    // still matches ROOT: accepting it as a fixpoint would lose the high edit.
    syn.syn_lines_edit(mut lines, 9000, 0, 0)
    syn.syn_lines_edit(mut lines, 0, 0, 0)
    assert(lines.must_reach == 9001, "high pending edit remains in frontier")
    assert(!syn.syn_lines_accept(mut lines, 1), "equal entry before frontier cannot stop wave")
    while lines.wave < 9000 {
        assert(!syn.syn_lines_accept(mut lines, 1), "pending frontier not reached")
    }
    assert(!syn.syn_lines_accept(mut lines, 2), "high edit changes entering state")
    while lines.settling {
        let _ = syn.syn_lines_accept(mut lines, 2)
    }
    assert(syn.syn_ids_get(lines.entry, 9001) == 2, "high edit actually propagated")
    assert(syn.syn_ids_get(lines.entry, 9999) == 2, "tail reached with changed state")
}

fn frontier_splices() {
    var lines = syn.syn_lines_new(10000)
    let _ = settle_plain(mut lines)
    syn.syn_lines_edit(mut lines, 9000, 0, 0)
    syn.syn_lines_edit(mut lines, 100, 0, 3)
    assert(lines.must_reach == 9004, "insert shifts pending frontier")
    syn.syn_lines_edit(mut lines, 200, 5, 0)
    assert(lines.must_reach == 8999, "delete shifts pending frontier")
    syn.syn_lines_edit(mut lines, 10, 9000, 2)
    assert(lines.must_reach == 13, "replacement covering frontier clamps to new tail")
    assert(lines.wave == 10, "earliest changed line wins")
}

fn propagation_slices() {
    var lines = syn.syn_lines_new(10000)
    let _ = settle_plain(mut lines)
    syn.syn_lines_edit(mut lines, 0, 0, 0)
    var calls = 0
    while lines.settling {
        var accepted = 0
        while accepted < 8 && lines.settling {
            let _ = syn.syn_lines_accept(mut lines, 2)
            accepted += 1
        }
        assert(accepted <= 8, "caller can pause the propagation wave")
        calls += 1
    }
    assert(calls == 1250, "resume preserves progress across 10,000 lines")
    assert(syn.syn_ids_get(lines.entry, 0) == 1, "root entry never overwritten")
    assert(syn.syn_ids_get(lines.entry, 9999) == 2, "propagation reaches final line")
}

fn speculative_correction() {
    var lines = syn.syn_lines_new(10000)
    let _ = settle_plain(mut lines)
    syn.syn_lines_edit(mut lines, 0, 0, 0)
    let _ = syn.syn_lines_accept(mut lines, 2)
    lines.spec_valid = true
    lines.spec_from = 5000
    while lines.settling {
        let _ = syn.syn_lines_accept(mut lines, 2)
    }
    assert(lines.provisional_corrections == 1, "speculative view corrected once")
    assert(!lines.spec_valid, "no speculative view after fixpoint")
}

fn empty_and_single() {
    let empty = syn.syn_lines_new(0)
    assert(!empty.settling, "no wave for absent buffer")
    var single = syn.syn_lines_new(1)
    assert(syn.syn_lines_accept(mut single, 1), "one-line initial fixpoint")
    syn.syn_lines_edit(mut single, 0, 0, 0)
    assert(syn.syn_lines_accept(mut single, 1), "one-line edit fixpoint")
    assert(syn.syn_ids_get(single.entry, 0) == 1, "one-line root retained")
}

fn packed_u32() {
    var ids = syn.syn_ids_new()
    syn.syn_ids_push(mut ids, 4294967295)
    syn.syn_ids_push(mut ids, 2147483648)
    assert(syn.syn_ids_get(ids, 0) == 4294967295, "unsigned high byte survives")
    assert(syn.syn_ids_get(ids, 1) == 2147483648, "signed i32 boundary is not sign-extended")
    syn.syn_ids_set(mut ids, 0, 65535)
    assert(syn.syn_ids_get(ids, 0) == 65535, "replace clears previous high bits")
}

fn main() {
    let selected = (env_get("YEW_SYN_LINES_CASE") else "-1").to_int() else -1
    var i = 0
    while i < 9 {
        if selected == -1 || selected == i {
            match i {
                0 => splice_table(),
                1 => retains_tail(),
                2 => local_10000(),
                3 => pending_frontier(),
                4 => frontier_splices(),
                5 => propagation_slices(),
                6 => speculative_correction(),
                7 => empty_and_single(),
                _ => packed_u32(),
            }
            print("syn_lines_case_{i}: PASS")
        }
        i += 1
    }
}
