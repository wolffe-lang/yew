//! member: false
//!
//! The port of sagitta `tests/unit/test_loop.c` (380 lines), one test per
//! C test in registry order (`tests/unit/registry.c:715-721`). C's
//! `loop_ed_init` (`test_loop.c:64-72`) zeroes an `Ed` and configures the
//! probe off; the port's is `edit.ed_new()` with the probe armed from an
//! environment holding `YEW_TTY_PROBE=0` (`term.probe_arm`, which writes
//! nothing: the query is `tty_probe_start`'s).
//!
//! C's timer is a callback and a context (`timer_mark`, `timer_spawn`,
//! `test_loop.c:48-62`); the port's is a kind and a payload
//! (`edit.TIMER_TEST_MARK` records its payload; `edit.TIMER_TEST_SPAWN`
//! records its payload, then adds a mark due at the same instant), fired
//! one due timer at a time through `edit.timer_pop_due` exactly as
//! `yew_timers_fire` pops them (`loop.c:201-210`). C's
//! `yew_timer_cancel(NULL, ...)` has no port: a heap is a value.
//!
//! **SKIP by name.** `loop_background_work_yields_after_input` drives the
//! symbol index's and the workspace walk's idle deadlines (sagitta
//! Sprints 45-46, yw11) and Fletch's idle hook (Sprint 33, yw09);
//! `loop_deadline_and_comp_tick_share_one_condition` drives the command
//! line's sliced path completion (Sprints 18/57.25, yw04). Each asserts
//! what campaign 03 has — no such work, so an idle editor sleeps (-1),
//! with the narrow `:` open too — and says SKIP for C's assertions.

use edit
use term

fn say_skip(what: str) -> int {
    print("loop_test: SKIP {what}")
    eprint("loop_test: SKIP {what}")
    1
}

fn probe_env(enabled: bool) -> term.Env {
    var vars = Map[str, str]()
    if !enabled {
        vars["YEW_TTY_PROBE"] = "0"
    }
    term.env_of(vars)
}

fn loop_ed() -> edit.Ed {
    var ed = edit.ed_new()
    term.probe_arm(mut ed.tty, 0, term.probe_read_config(probe_env(false)), false)
    ed
}

fn bytes_of(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() {
        (mut out).push(b)
    }
    out
}

fn t_loop_deadline_matrix() {
    var ed = loop_ed()
    var key = term.key_new()
    assert(edit.loop_deadline(ed, 1000) == -1, "idle: -1")
    let x = bytes_of("x")
    term.input_feed(mut ed.input, x, 0, x.len)
    assert(edit.loop_deadline(ed, 1000) == 0, "a queued key: 0")
    assert(term.input_next(mut ed.input, 1000, mut key), "the key decodes")
    assert(key.code == 120, "it is x")
    assert(edit.loop_deadline(ed, 1000) == -1, "drained: -1")

    let esc = bytes_of("\x1b")
    term.input_feed(mut ed.input, esc, 0, esc.len)
    assert(term.input_dispatch_ready(ed.input), "an ESC is ready to parse")
    assert(!term.input_next(mut ed.input, 1000, mut key), "but waits on its clock")
    assert(!term.input_dispatch_ready(ed.input), "and is no longer ready")
    assert(edit.loop_deadline(ed, 1000) == term.ESC_TIMEOUT_MS, "the ESC deadline")
    assert(term.input_next(mut ed.input, 1000 + term.ESC_TIMEOUT_MS, mut key), "the ESC times out")
    assert(key.code == term.KEY_ESCAPE, "into Escape")
    assert(!term.input_next(mut ed.input, 1000 + term.ESC_TIMEOUT_MS, mut key), "nothing more")
    assert(edit.loop_deadline(ed, 1000 + term.ESC_TIMEOUT_MS) == -1, "idle again")

    ed.chord.n = 1
    ed.chord.deadline = 1400
    assert(edit.loop_deadline(ed, 1000) == 400, "the chord: 400")
    ed.input.deadline = 1250
    assert(edit.loop_deadline(ed, 1000) == 250, "the input: 250")
    let id = edit.timer_add(mut ed.timers, 1200, edit.TIMER_TEST_MARK, 0)
    assert(id != edit.TIMER_NONE, "a timer")
    assert(edit.loop_deadline(ed, 1000) == 200, "the timer: 200")

    term.probe_arm(mut ed.tty, 1000, term.probe_read_config(probe_env(true)), false)
    assert(!term.probe_done(ed.tty), "the probe is armed")
    assert(edit.loop_deadline(ed, 1000) == 50, "the probe: 50")
    assert(edit.loop_deadline(ed, 1049) == 1, "the probe: 1")
    assert(edit.loop_deadline(ed, 1050) == 0, "the probe: 0")
    term.probe_tick(mut ed.tty, 1050)
    assert(term.probe_done(ed.tty), "the probe times out")
    assert(edit.loop_deadline(ed, 1100) == 100, "the timer again: 100")
    assert(edit.loop_deadline(ed, 1200) == 0, "the timer: due")

    ed.input.deadline = 0
    ed.chord.n = 0
    assert(edit.timer_cancel(mut ed.timers, id), "cancel")
    assert(edit.loop_deadline(ed, 1200) == -1, "idle: -1")
}

fn t_loop_deadline_clamps_poll_range() {
    var ed = loop_ed()
    let int_max = 2147483647
    ed.chord.n = 1
    ed.chord.deadline = edit.INT64_MAX
    assert(edit.loop_deadline(ed, 0) == int_max, "clamped to INT_MAX")
    assert(edit.loop_deadline(ed, edit.INT64_MAX) == 0, "due at the end of time")
    ed.chord.n = 0
    let id = edit.timer_add(mut ed.timers, edit.INT64_MAX, edit.TIMER_TEST_MARK, 1)
    assert(edit.loop_deadline(ed, -1) == int_max, "a negative now saturates")
    assert(edit.loop_deadline(ed, edit.INT64_MAX - 7) == 7, "seven left")
    assert(edit.timer_cancel(mut ed.timers, id), "cancel")
    assert(edit.timers_deadline(ed.timers, 0) == -1, "no timers")
}

fn t_loop_background_work_yields_after_input() -> int {
    var ed = loop_ed()
    ed.model_ready = true
    assert(
        edit.loop_deadline(ed, 1000) == -1,
        "no background work in campaign 03: the editor sleeps",
    )
    say_skip(
        "loop_background_work_yields_after_input: the symbol index and workspace walk (sagitta Sprints 45-46, yw11) and Fletch's idle hook (Sprint 33, yw09)",
    )
}

fn t_loop_deadline_and_comp_tick_share_one_condition() -> int {
    var ed = edit.ed_new()
    term.probe_arm(mut ed.tty, 0, term.probe_read_config(probe_env(false)), false)
    edit.ed_open_scratch(mut ed)
    assert(!ed.cmdline.active, "no prompt")
    assert(edit.loop_deadline(ed, 1000) == -1, "an idle editor sleeps")
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "e")
    assert(ed.cmdline.active, "the narrow : is open")
    assert(edit.loop_deadline(ed, 1000) == -1, "no completion scan in campaign 03: it still sleeps")
    say_skip(
        "loop_deadline_and_comp_tick_share_one_condition: the command line's sliced path completion (sagitta Sprints 18/57.25, yw04)",
    )
}

// `yew_timers_fire` over the test kinds: a mark records its payload; a
// spawn records its payload and adds a mark (payload + 1) due at `now`.
fn fire(mut h: edit.TimerHeap, now: int, mut trace: List[int]) {
    loop {
        let (fired, kind, payload) = edit.timer_pop_due(mut h, now)
        if !fired {
            break
        }
        (mut trace).push(payload)
        if kind == edit.TIMER_TEST_SPAWN {
            let _ = edit.timer_add(mut h, now, edit.TIMER_TEST_MARK, payload + 1)
        }
    }
}

fn t_timer_heap_stable_equal_deadlines() {
    var h = edit.timers_new()
    var trace = List[int]()
    var ids = List[int]()
    var i = 0
    while i < 8 {
        let id = edit.timer_add(mut h, 500, edit.TIMER_TEST_MARK, i)
        assert(id != edit.TIMER_NONE, "timer {i}")
        if i != 0 {
            assert(id > ids[i - 1], "ids rise")
        }
        (mut ids).push(id)
        i += 1
    }
    assert(edit.timers_deadline(h, 100) == 400, "400 left")
    fire(mut h, 499, mut trace)
    assert(trace.len == 0, "none due at 499")
    fire(mut h, 500, mut trace)
    assert(trace.len == 8, "all eight at 500")
    i = 0
    while i < 8 {
        assert(trace[i] == i, "insertion order {i}")
        i += 1
    }
    assert(edit.timers_deadline(h, 500) == -1, "empty")
}

fn t_timer_cancel_never_fires() {
    var h = edit.timers_new()
    var trace = List[int]()
    var deadlines = List[int]()
    (mut deadlines).push(30)
    (mut deadlines).push(10)
    (mut deadlines).push(20)
    (mut deadlines).push(10)
    (mut deadlines).push(40)
    (mut deadlines).push(15)
    (mut deadlines).push(35)
    var ids = List[int]()
    var i = 0
    while i < deadlines.len {
        (mut ids).push(edit.timer_add(mut h, deadlines[i], edit.TIMER_TEST_MARK, i))
        i += 1
    }
    assert(edit.timer_cancel(mut h, ids[3]), "cancel 3")
    assert(edit.timer_cancel(mut h, ids[0]), "cancel 0")
    assert(!edit.timer_cancel(mut h, ids[3]), "3 is gone")
    assert(!edit.timer_cancel(mut h, edit.TIMER_NONE), "no timer")
    assert(edit.timers_deadline(h, 0) == 10, "10 first")
    fire(mut h, 100, mut trace)
    var expected = List[int]()
    (mut expected).push(1)
    (mut expected).push(5)
    (mut expected).push(2)
    (mut expected).push(6)
    (mut expected).push(4)
    assert(trace.len == expected.len, "five fired: {trace.len}")
    i = 0
    while i < expected.len {
        assert(trace[i] == expected[i], "fired {i}: {trace[i]} == {expected[i]}")
        i += 1
    }
    assert(h.len == 0, "empty")
}

fn t_timer_callback_may_add_due_timer() {
    var h = edit.timers_new()
    var trace = List[int]()
    let _ = edit.timer_add(mut h, 100, edit.TIMER_TEST_SPAWN, 1)
    let _ = edit.timer_add(mut h, 100, edit.TIMER_TEST_MARK, 3)
    fire(mut h, 100, mut trace)
    assert(trace.len == 3, "three fired")
    assert(trace[0] == 1, "the spawner")
    assert(trace[1] == 3, "the tail")
    assert(trace[2] == 2, "the spawned, in the same turn")
    assert(h.len == 0, "empty")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    var skips = 0
    t_loop_deadline_matrix()
    t_loop_deadline_clamps_poll_range()
    skips += t_loop_background_work_yields_after_input()
    skips += t_loop_deadline_and_comp_tick_share_one_condition()
    t_timer_heap_stable_equal_deadlines()
    t_timer_cancel_never_fires()
    t_timer_callback_may_add_due_timer()
    print(
        "loop_test: 7 cases run, {skips} SKIP by name (background work yw11/yw09, completion yw04)",
    )
}
