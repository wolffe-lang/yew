//! member: false
//! Port-only #40 regressions: C frees row/frame scratch; Wolf must reuse it.

use edit
use term
use text

fn ledger_charges_reuse() -> bool {
    var delta: int = 0
    region probe {
        var bytes = List[byte]()
        (mut bytes).reserve(8)
        (mut bytes).push(1 as byte)
        (mut bytes).reset()
        let before = region_bytes(probe)
        (mut bytes).push(1 as byte)
        (mut bytes).reset()
        delta = region_bytes(probe) - before
    }
    delta != 0
}

fn fill(mut menu: edit.Menu, n: int) {
    edit.menu_reserve(mut menu, n)
    region ranked {
        var rows = List[edit.CompItem]()
        for i in 0..n {
            let bytes = "item-{i}".bytes()
            var row = edit.compitem_text(bytes, edit.COMP_CMD)
            row.detail = "detail-{i % 3}"
            row.is_dir = i % 2 == 0
            row.deferred = i % 3 == 0
            row.score = 100 - i
            row.match_off = 2
            (mut row.m.pos).push(0)
            (mut row.suffix).push(32 as byte)
            (mut rows).push(row)
        }
        edit.menu_refill(mut menu, rows)
    }
}

fn menu_case() {
    var delta: int = 0
    region owner {
        var menu = edit.menu_new(edit.menuspec_default())
        fill(mut menu, 32)
        fill(mut menu, 3)
        fill(mut menu, 32)
        let before = region_bytes(owner)
        for _ in 0..100 {
            fill(mut menu, 3)
            fill(mut menu, 32)
        }
        delta = region_bytes(owner) - before
        assert(menu.n_items == 32)
        for i in 0..32 {
            assert((str_from_utf8(menu.items[i].text) else "") == "item-{i}")
            assert((str_from_utf8(menu.items[i].ranked) else "") == "item-{i}")
            assert(menu.items[i].detail == "detail-{i % 3}")
            assert(menu.items[i].kind == edit.COMP_CMD)
            assert(menu.items[i].is_dir == (i % 2 == 0))
            assert(menu.items[i].deferred == (i % 3 == 0))
            assert(menu.items[i].score == 100 - i && menu.items[i].match_off == 2)
            assert(menu.items[i].m.pos.len == 1 && menu.items[i].m.pos[0] == 0)
            assert(menu.items[i].suffix.len == 1 && menu.items[i].suffix[0] == 32 as byte)
        }
    }
    if ledger_charges_reuse() {
        print(
            "menu_reuse: SKIP zero-ledger assertion: checked ledger charges reused pushes; values verified",
        )
    } else {
        assert(delta == 0, "menu refill retained {delta} bytes")
    }
    print("menu_reuse: 200 refills, retained ledger={delta}: PASS")
}

fn strip_case() {
    var delta: int = 0
    region owner {
        // The strip draws in init.fl's theme, set alone: since campaign 07
        // init.fl runs in the Fletch VM, and its 526 lines under
        // YEW_FL_VM_CHECKS are past the checked machine's step budget for
        // this case (run 40692505908), and the strip reads none of the rest.
        var ed = edit.ed_new_test(copy "set({{ theme: \"quiver-dark\" }})\n".bytes(), "")
        edit.ed_theme_set(mut ed, ed.opts.theme)
        ed.clean = true
        ed.regs.clipboard_sync = text.CLIP_SYNC_OFF
        ed.grid = term.grid_new(24, 80)
        ed.grid_ready = true
        let bytes = "one\ntwo\n".bytes()
        edit.ed_open_memory(mut ed, bytes, "glyph-\u{1f469}\u{200d}\u{1f4bb}.txt")
        edit.ed_layout(mut ed)
        for _ in 0..2 {
            edit.region_frame_begin(mut ed.regions)
            edit.tab_strip_draw(mut ed, edit.rect(0, 0, 80, 1))
        }
        let before = region_bytes(owner)
        for _ in 0..30 {
            edit.region_frame_begin(mut ed.regions)
            edit.tab_strip_draw(mut ed, edit.rect(0, 0, 80, 1))
        }
        delta = region_bytes(owner) - before
    }
    if ledger_charges_reuse() {
        print(
            "strip_reuse: SKIP zero-ledger assertion: checked ledger charges reused pushes; draw verified",
        )
    } else {
        assert(delta == 0, "tab strip retained {delta} bytes")
    }
    print("strip_reuse: 30 frames, retained ledger={delta}: PASS")
}

fn main() {
    let which = (env_get("YEW_REUSE_CASE") else "-1").to_int() else -1
    if which < 0 || which == 0 { menu_case() }
    if which < 0 || which == 1 { strip_case() }
}
