//! text.u16 — UTF-16 code-unit columns over a piece buffer, for the
//! LSP's position encoding.
//!
//! Ports sagitta `src/unicode/u16.c` (170 lines) and `u16.h` (17) at
//! 9ace98c2. A scalar above U+FFFF is two units, every other scalar (an
//! invalid byte's escape included) one; a column inside an astral scalar,
//! or past the content, clamps backward. In the `text` module for the
//! reason `text.coords` is (it reads `TextBuf`; E0303), and over
//! `coords`' reader, whose seam handling is u16.c's `stream_decode`
//! (decode in place inside a chunk, a four-byte copy only across a seam).

use util

/// UTF-16 code units from a line's start (`U16Col`).
pub type U16Col = distinct int

fn u16_content_end(tb: TextBuf, line: Span) -> int {
    if line.lo > line.hi || line.hi > textbuf_len(tb) {
        util.bug("text.u16", "u16 conversion received an invalid line span")
    }
    var end = line.hi
    if end > line.lo && textbuf_byte_at(tb, end - 1) == 10 {
        end -= 1
        if end > line.lo && textbuf_byte_at(tb, end - 1) == 13 {
            end -= 1
        }
    }
    end
}

fn scalar_units(cp: int) -> int {
    if cp > 65535 {
        return 2
    }
    1
}

/// The UTF-16 column of `pos` (`yew_off_to_u16col`, `u16.c:120-145`);
/// a position inside a scalar counts the scalars before it.
pub fn off_to_u16col(tb: TextBuf, line: Span, pos: ByteOff) -> U16Col {
    let end = u16_content_end(tb, line)
    var target = pos as int
    if target < line.lo {
        target = line.lo
    }
    if target > end {
        target = end
    }
    var units = 0
    var r = reader_new()
    reader_init(mut r, tb, src_live(tb), line.lo, end)
    while r.off < target {
        let (cp, n) = reader_peek_cp(mut r, tb)
        if n == 0 {
            util.bug("text.u16", "u16 decode ended before its target")
        }
        if r.off + n > target {
            break
        }
        reader_skip(mut r, tb, n)
        units += scalar_units(cp)
    }
    units as U16Col
}

/// The offset of UTF-16 column `col` (`yew_u16col_to_off`,
/// `u16.c:147-170`): inside an astral scalar, its start; past the
/// content, its end.
pub fn u16col_to_off(tb: TextBuf, line: Span, col_in: U16Col) -> ByteOff {
    let col = col_in as int
    let end = u16_content_end(tb, line)
    var units = 0
    var r = reader_new()
    reader_init(mut r, tb, src_live(tb), line.lo, end)
    while r.off < end {
        if col == units {
            return r.off as ByteOff
        }
        let (cp, n) = reader_peek_cp(mut r, tb)
        if n == 0 {
            util.bug("text.u16", "u16 decode ended before the line end")
        }
        let next = units + scalar_units(cp)
        if col < next {
            return r.off as ByteOff
        }
        reader_skip(mut r, tb, n)
        units = next
    }
    end as ByteOff
}
