//! text.yankstack — readline's kill ring (Sprint 57.28 §1): the readline
//! kills push here and C-y / A-y read from here, in Insert mode and in the
//! `:` prompt alike. FULLY SEPARATE from the registers: a kill never
//! writes the unnamed register, the register ring or the clipboard.
//!
//! Ports sagitta `src/text/yankstack.c` (103 lines) and `yankstack.h` (75)
//! at 9ace98c2. Consecutive kills join, as readline's do: a kill extends
//! the newest entry when the previous command the dispatcher ran was a
//! kill in the same window (`seq` exactly one past `kill_seq`, the same
//! `owner`) — appended for FORWARD, prepended for BACKWARD; a multi-cursor
//! kill (ALONE) is always its own entry. The newest entry is never
//! evicted, even alone over `bytes_max`. Session-only. The wolf shapes:
//! C's `const void *` owners (a `Win`'s identity) are `int` window ids;
//! C's `Bytebuf entry[32]` is a list of 32 byte lists; `yank_at`'s NULL
//! is `none`.

/// `YEW_YANK_MAX`.
pub const YANK_MAX: int = 32

/// `YEW_YANK_BYTES_MAX` (1 MiB).
pub const YANK_BYTES_MAX: int = 1048576

/// `YEW_KILL_FORWARD`: extends by appending (C-k, A-d).
pub const KILL_FORWARD: int = 0

/// `YEW_KILL_BACKWARD`: extends by prepending (C-w, A-<bs>, C-u).
pub const KILL_BACKWARD: int = 1

/// `YEW_KILL_ALONE`: a kill over several cursors, never extended.
pub const KILL_ALONE: int = 2

/// The stack (`YewYankStack`, `yankstack.h:45-58`): the newest entry at
/// `head`; the last yank's `yank_*` fields are A-y's.
pub struct YankStack {
    entry: List[List[byte]],
    head: int,
    len: int,
    bytes: int,
    bytes_max: int,
    kill_seq: int,
    kill_owner: int,
    kill_open: bool,
    yank_seq: int,
    yank_owner: int,
    yank_len: int,
    yank_k: int,
}

/// An empty stack capped at `YANK_BYTES_MAX` (`yew_yank_init`,
/// `yankstack.c:5-15`).
pub fn yank_new() -> YankStack {
    var entry = List[List[byte]]()
    var i = 0
    while i < YANK_MAX {
        (mut entry).push(List[byte]())
        i += 1
    }
    YankStack {
        entry: entry,
        head: 0,
        len: 0,
        bytes: 0,
        bytes_max: YANK_BYTES_MAX,
        kill_seq: 0,
        kill_owner: 0,
        kill_open: false,
        yank_seq: 0,
        yank_owner: 0,
        yank_len: 0,
        yank_k: 0,
    }
}

/// Release every entry and start over (`yew_yank_free`, `yankstack.c:17-26`).
pub fn yank_free(mut y: YankStack) {
    y = yank_new()
}

fn yank_slot(y: YankStack, k: int) -> int {
    (y.head + YANK_MAX - k) % YANK_MAX
}

// `yank_evict_oldest`, `yankstack.c:33-41`: never the newest.
fn yank_evict_oldest(mut y: YankStack) {
    let oldest = yank_slot(y, y.len - 1)
    y.bytes -= y.entry[oldest].len
    y.entry[oldest] = List[byte]()
    y.len -= 1
}

fn yank_trim(mut y: YankStack) {
    while y.len > 1 && y.bytes > y.bytes_max {
        yank_evict_oldest(mut y)
    }
}

// `yank_extend`, `yankstack.c:49-66`.
fn yank_extend(mut y: YankStack, b: List[byte], d: int) {
    let newest = y.head
    if d == KILL_FORWARD {
        for x in b {
            (mut y.entry[newest]).push(x)
        }
    } else {
        var joined = copy b
        for x in y.entry[newest] {
            (mut joined).push(x)
        }
        y.entry[newest] = joined
    }
}

// `yank_push`, `yankstack.c:68-76`.
fn yank_push(mut y: YankStack, b: List[byte]) {
    if y.len == YANK_MAX {
        yank_evict_oldest(mut y)
    }
    y.head = if y.len == 0 then 0 else (y.head + 1) % YANK_MAX
    y.entry[y.head] = copy b
    y.len += 1
}

/// Record a kill of `b` (`yew_yank_kill`, `yankstack.c:78-96`): `seq` is
/// the dispatcher's sequence number of the command doing it and `owner`
/// the window it ran in; an empty kill records nothing.
pub fn yank_kill(mut y: YankStack, b: List[byte], d: int, seq: int, owner: int) {
    if b.len == 0 {
        return
    }
    let extend = y.len != 0 &&
        y.kill_open &&
        d != KILL_ALONE &&
        owner == y.kill_owner &&
        seq == y.kill_seq + 1
    if extend {
        yank_extend(mut y, b, d)
    } else {
        yank_push(mut y, b)
    }
    y.bytes += b.len
    y.kill_seq = seq
    y.kill_owner = owner
    y.kill_open = d != KILL_ALONE
    yank_trim(mut y)
}

/// Entry `k` back from the newest (0 = newest), a copy, or `none`
/// (`yew_yank_at`, `yankstack.c:98-103`).
pub fn yank_at(y: YankStack, k: int) -> List[byte] ! {none} {
    if k < 0 || k >= y.len {
        return none
    }
    copy y.entry[yank_slot(y, k)]
}
