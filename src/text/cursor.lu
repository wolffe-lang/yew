//! text.cursor — one caret: grapheme motion left and right, vertical
//! motion that holds a cell-column goal, line and buffer ends, clamping.
//!
//! Ports sagitta `src/text/cursor.c` (159 lines) and `cursor.h` (84) at
//! 9ace98c2, under `s09-cursors-and-coords.md`. The goal is a CELL column
//! (cursor.h's field report: a grapheme goal slid left by tabwidth-1 cells
//! per tab crossing between tab- and space-indented lines), resolved
//! lazily: horizontal motion writes `CCOL_HERE` and a vertical motion
//! measures once (`yew_cursor_goal`). `CCOL_EOL` rests at each line's
//! content end. The fields are `int`s: a `distinct int` is not `Copy` at
//! 0.2.33, so a field of one would move on every read (docs/MAP.md §5).

/// `YEW_CCOL_EOL`: past the end of any line (C's `UINT64_MAX`).
pub const CCOL_EOL: int = 9223372036854775807

/// `YEW_CCOL_HERE`: the unresolved goal, "wherever the caret is".
pub const CCOL_HERE: int = 9223372036854775806

/// A caret (`Cursor`, `cursor.h:60-64`): its offset, its cell-column goal
/// and the selection anchor (equal to `pos` when nothing is selected).
pub struct Cursor {
    pos: int,
    goal_col: int,
    anchor: int,
}

/// A caret at `pos`, nothing selected, goal column 0.
pub fn cursor_at(pos: ByteOff) -> Cursor {
    let p = pos as int
    Cursor { pos: p, goal_col: 0, anchor: p }
}

fn cursor_set_pos(mut c: Cursor, pos: int) {
    let unselected = c.anchor == c.pos
    c.pos = pos
    if unselected {
        c.anchor = pos
    }
}

/// The cell column `c` aims at, `CCOL_HERE` resolved against the line
/// `c.pos` is on (`yew_cursor_goal`, `cursor.c:30-41`).
pub fn cursor_goal(tb: TextBuf, c: Cursor, tabw: int) -> CCol {
    if c.goal_col != CCOL_HERE {
        return c.goal_col as CCol
    }
    let sp = textbuf_line_span(tb, textbuf_line_of(tb, c.pos as ByteOff))
    off_to_ccol(tb, sp, c.pos as ByteOff, tabw)
}

fn line_end_off(mut tb: TextBuf, line: int) -> int {
    let sp = textbuf_line_span(tb, line as LineNo)
    var end = sp.hi
    if line + 1 < textbuf_line_count(tb) {
        // Every non-final line ends in LF; GB3 joins a CR before it, so one
        // previous step strips CRLF too.
        end = grapheme_prev_boundary(mut tb, end as ByteOff) as int
    }
    end
}

/// One grapheme left (`yew_cursor_left`).
pub fn cursor_left(mut tb: TextBuf, mut c: Cursor) {
    cursor_set_pos(mut c, grapheme_prev_boundary(mut tb, c.pos as ByteOff) as int)
    c.goal_col = CCOL_HERE
}

/// One grapheme right (`yew_cursor_right`).
pub fn cursor_right(tb: TextBuf, mut c: Cursor) {
    cursor_set_pos(mut c, grapheme_next_boundary(tb, c.pos as ByteOff) as int)
    c.goal_col = CCOL_HERE
}

/// One line up, holding the goal; the padded lookup rests a goal past
/// the line after its last character (`yew_cursor_up`, `cursor.c:83-95`).
pub fn cursor_up(tb: TextBuf, mut c: Cursor, tabw: int) {
    let line = textbuf_line_of(tb, c.pos as ByteOff) as int
    if line == 0 {
        return
    }
    let sp = textbuf_line_span(tb, (line - 1) as LineNo)
    c.goal_col = cursor_goal(tb, c, tabw) as int
    cursor_set_pos(mut c, ccol_to_off_padded(tb, sp, c.goal_col as CCol, tabw) as int)
}

/// One line down (`yew_cursor_down`).
pub fn cursor_down(tb: TextBuf, mut c: Cursor, tabw: int) {
    let line = textbuf_line_of(tb, c.pos as ByteOff) as int
    if line + 1 >= textbuf_line_count(tb) {
        return
    }
    let sp = textbuf_line_span(tb, (line + 1) as LineNo)
    c.goal_col = cursor_goal(tb, c, tabw) as int
    cursor_set_pos(mut c, ccol_to_off_padded(tb, sp, c.goal_col as CCol, tabw) as int)
}

/// The line's start, goal 0 (`yew_cursor_line_home`).
pub fn cursor_line_home(tb: TextBuf, mut c: Cursor) {
    let line = textbuf_line_of(tb, c.pos as ByteOff)
    cursor_set_pos(mut c, textbuf_line_start(tb, line) as int)
    c.goal_col = 0
}

/// The line's content end, goal `CCOL_EOL` (`yew_cursor_line_end`).
pub fn cursor_line_end(mut tb: TextBuf, mut c: Cursor) {
    let line = textbuf_line_of(tb, c.pos as ByteOff) as int
    cursor_set_pos(mut c, line_end_off(mut tb, line))
    c.goal_col = CCOL_EOL
}

/// The buffer's start (`yew_cursor_buf_home`).
pub fn cursor_buf_home(mut c: Cursor) {
    cursor_set_pos(mut c, 0)
    c.goal_col = 0
}

/// The buffer's end (`yew_cursor_buf_end`).
pub fn cursor_buf_end(tb: TextBuf, mut c: Cursor) {
    cursor_set_pos(mut c, textbuf_len(tb))
    c.goal_col = CCOL_EOL
}

fn cursor_clamp_off(tb: TextBuf, pos_in: int) -> int {
    var pos = pos_in
    let len = textbuf_len(tb)
    if pos > len {
        pos = len
    }
    if !is_grapheme_boundary(tb, pos as ByteOff) {
        pos = grapheme_prev(tb, pos as ByteOff) as int
    }
    pos
}

/// Clamp the caret and its anchor into the buffer and onto boundaries
/// (`yew_cursor_clamp`, `cursor.c:149-159`).
pub fn cursor_clamp(tb: TextBuf, mut c: Cursor) {
    let unselected = c.anchor == c.pos
    c.pos = cursor_clamp_off(tb, c.pos)
    if unselected {
        c.anchor = c.pos
    } else {
        c.anchor = cursor_clamp_off(tb, c.anchor)
    }
}
