//! text.clipboard — the system clipboard: backend detection, the
//! one-item coalescing write queue, demotion of a failed backend, the
//! OSC 52 transport, and the subprocess backends.
//!
//! Ports sagitta `src/text/clipboard.c` (1135 lines) and `clipboard.h`
//! (51) at 9ace98c2, under `s11-registers-and-clipboard.md`. A write is
//! copied into a one-item queue (the latest wins); the editor loop calls
//! `clip_after_render` once per input burst, which starts the queued
//! write on the detected backend: OSC 52 is queued as out-of-band bytes
//! behind the frame's end marker and flushed into the frame; a payload
//! over the OSC 52 limit falls back to a local subprocess backend (never
//! over SSH). Reads are subprocess-only and never OSC 52.
//!
//! The wolf shapes:
//!  - C's process-global `YewClipboardState yew_clip` (`clipboard.c:31-
//!    58`) is a value, `Clipboard`, which the register file owns
//!    (`Registers.clip`) and threads to every call, as `JournalSet` is
//!    threaded; initialized lazily on first use, as C's. No module
//!    state, no `unsafe`.
//!  - the environment is read live (`term.env_getv`, C's `getenv`), and
//!    OSC 52's mode, target and limit are `term.osc52_*` over
//!    `term.env_process()`; C's process-global terminal OOB queue is the
//!    renderer's (`term.render_oob_*`, yw01), so `clip_after_render` and
//!    `clip_pump` take the `term.Render`.
//!  - `access(name, X_OK)` has no wolf call: `exec_ok` reads the mode
//!    bits against the real uid, gid and supplementary groups as
//!    access(2) does, root needing any execute bit (ACLs and noexec
//!    mounts unread).
//!  - `pbcopy` is gated in C at compile time (`__APPLE__ && aarch64`);
//!    since wolf 0.2.35, os_name/os_arch gate the same host (G31).
//!  - **The subprocess writer and reader fork (G30's fork half, `os_fork`,
//!    since the 0.2.34 pin; yw05).** C's writer double-forks so the tool is
//!    no child of the editor and then writes the payload into the tool's
//!    stdin from the loop NON-BLOCKINGLY (`O_NONBLOCK`, `POLLOUT`), learning
//!    the tool's pid and its exec status through two pipes
//!    (`clipboard.c:558-661`, `829-893`). wolf has no non-blocking pipe
//!    write and no write-readiness wait (G30's other half, wolf-lang#818),
//!    so the port moves the blocking write into the fork: the editor forks a
//!    MIDDLE process (`clip_writer_middle`), which starts the tool on a
//!    data pipe (`process.start_job`, SIGPIPE back to the default as C's
//!    `clip_child_sigpipe_default`), writes the whole payload into it —
//!    blocking there is the middle's, never the editor's — and exits; when
//!    it exits the tool is reparented, as C's grandchild is. One status
//!    pipe carries what C's pid and exec pipes carry, as lines: `pid N`,
//!    `exec E` (the start failed, `E` the host's errno), then `done`,
//!    `epipe` or `write E`. The editor only reads that pipe, never blocking
//!    (`os_signal_wait_fds` with a zero deadline before each read), keeps
//!    C's deadline (the tool and the middle killed when it passes), and
//!    reaps a middle only once its status pipe reads end-of-file, so the
//!    `os_wait_status` that reaps it never waits on a live process (wolf has
//!    no per-child `WNOHANG`; `os_wait_poll` would reap a job's child). The
//!    READER forks a middle too: the tool writes into the editor's data
//!    pipe directly, as C's does, and the middle waits for the tool and
//!    reports `status S`, so the editor's read keeps C's deadline and the
//!    tool's exit status without ever blocking on a child
//!    (`clipboard.c:918-1099`).
//!  - the waits name `URGENT` (SIGURG), a meaning the editor never listens
//!    for: `os_signal_wait_fds` wants a non-empty set, and a meaning the
//!    loop listens for (`term.tty_signal_set`) would be taken off its queue
//!    here. An unlistened meaning is never delivered and installs nothing.
//!  - `os_fork` answers `busy` while a task is live and `unsupported` on
//!    the checked machine (ruling #95 R4 C): there the spawn fails as C's
//!    `fork()` failing does (the writer demotes its backend, the reader
//!    warns "cannot start reader"); the tests SKIP those halves by name.

use std.env as std_env
use std.fs
use std.io as std_io
use std.process
use std.signal
use term
use util

/// `YEW_CLIPBOARD_TIMEOUT_DEFAULT_MS`.
pub const CLIPBOARD_TIMEOUT_DEFAULT_MS: int = 1000

/// `YEW_CLIPBOARD_READ_MAX_DEFAULT` (64 MiB).
pub const CLIPBOARD_READ_MAX_DEFAULT: int = 67108864

/// `YEW_CLIP_NONE`.
pub const CLIP_NONE: int = 0

/// `YEW_CLIP_WL`: `wl-copy` / `wl-paste`.
pub const CLIP_WL: int = 1

/// `YEW_CLIP_XCLIP`.
pub const CLIP_XCLIP: int = 2

/// `YEW_CLIP_XSEL`.
pub const CLIP_XSEL: int = 3

/// `YEW_CLIP_PB`: `pbcopy` / `pbpaste`.
pub const CLIP_PB: int = 4

/// `YEW_CLIP_OSC52`: the terminal, write-only.
pub const CLIP_OSC52: int = 5

/// `YEW_CLIP_CUSTOM`: `YEW_CLIPBOARD=cmd:<write>[|<read>]`.
pub const CLIP_CUSTOM: int = 6

const CLIP_REAP_MAX: int = 512

const CLIP_BACKEND_COUNT: int = 7

/// A forked middle process the clipboard owns until it is reaped (C's
/// `reap[]` pid, `clipboard.c:523-551`): its handle in the child table,
/// the read end of its status pipe and the bytes read from it so far.
pub struct ClipChild {
    slot: int,
    fd: int,
    buf: List[byte],
    eof: bool,
}

/// The clipboard's state (`YewClipboardState`, `clipboard.c:31-56`).
pub struct Clipboard {
    queued: RegVal,
    active: RegVal,
    initialized: bool,
    queued_valid: bool,
    active_valid: bool,
    write_cached: bool,
    read_cached: bool,
    write_backend: int,
    read_backend: int,
    active_backend: int,
    demoted: int,
    queued_target: int,
    active_target: int,
    write_fd: int,
    pid_fd: int,
    exec_fd: int,
    tool_pid: int,
    middle: int,
    reap: List[ClipChild],
    written: int,
    deadline_ms: int,
    timeout_ms: int,
    read_max: int,
    exec_ready: bool,
}

/// The state before first use (C's zeroed static).
pub fn clip_new() -> Clipboard {
    Clipboard {
        queued: regval_new(),
        active: regval_new(),
        initialized: false,
        queued_valid: false,
        active_valid: false,
        write_cached: false,
        read_cached: false,
        write_backend: CLIP_NONE,
        read_backend: CLIP_NONE,
        active_backend: CLIP_NONE,
        demoted: 0,
        queued_target: 0,
        active_target: 0,
        write_fd: -1,
        pid_fd: -1,
        exec_fd: -1,
        tool_pid: 0,
        middle: -1,
        reap: List[ClipChild](),
        written: 0,
        deadline_ms: 0,
        timeout_ms: 0,
        read_max: 0,
        exec_ready: false,
    }
}

fn is_space(b: int) -> bool {
    b == 32 || b >= 9 && b <= 13
}

// `strtoll(text, &end, 10)` with `*end == '\0'` required: (ok, value);
// out of range is not ok (C's ERANGE).
fn parse_ll(text: str) -> (bool, int) {
    let b = text.bytes()
    var i = 0
    while i < b.len && is_space(b[i] as int) {
        i += 1
    }
    var negative = false
    if i < b.len && (b[i] as int == 43 || b[i] as int == 45) {
        negative = b[i] as int == 45
        i += 1
    }
    let start = i
    var value = 0
    while i < b.len && b[i] as int >= 48 && b[i] as int <= 57 {
        let d = b[i] as int - 48
        if value > (9223372036854775807 - d) / 10 {
            return (false, 0)
        }
        value = value * 10 + d
        i += 1
    }
    if i == start || i != b.len {
        return (false, 0)
    }
    if negative {
        return (true, 0 - value)
    }
    (true, value)
}

// `clip_parse_positive_ms`, `clipboard.c:82-97`.
fn clip_parse_positive_ms(name: str, fallback: int) -> int {
    let (text, has) = term.env_getv(name)
    if !has || text.len == 0 {
        return fallback
    }
    let (ok, value) = parse_ll(text)
    if !ok || value <= 0 {
        util.log_warn("clipboard: ignoring invalid {name}")
        return fallback
    }
    value
}

// `clip_ignore_sigpipe`, `clipboard.c:99-109`: SIGPIPE stays ignored
// process-wide (clipboard.h).
fn clip_ignore_sigpipe() {
    signal.ignore(signal.broken_pipe()) else |_| {
        util.log_warn("clipboard: cannot ignore SIGPIPE")
    }
}

// `clip_init`, `clipboard.c:111-126`.
fn clip_init(mut c: Clipboard) {
    if c.initialized {
        return
    }
    c = clip_new()
    c.timeout_ms = clip_parse_positive_ms("YEW_CLIPBOARD_TIMEOUT_MS", CLIPBOARD_TIMEOUT_DEFAULT_MS)
    c.read_max = CLIPBOARD_READ_MAX_DEFAULT
    c.initialized = true
    clip_ignore_sigpipe()
}

fn nonempty_env(name: str) -> bool {
    let (value, has) = term.env_getv(name)
    has && value.len != 0
}

fn clip_remote() -> bool {
    nonempty_env("SSH_TTY") || nonempty_env("SSH_CONNECTION")
}

// access(2)'s X_OK over the stat record, by the real ids (see the header).
fn access_x(info: fs.Info) -> bool {
    let uid = std_env.uid() else -1
    if uid == 0 {
        return info.mode & 73 != 0
    }
    if info.uid == uid {
        return info.mode & 64 != 0
    }
    var in_group = false
    let gid = std_env.gid() else -1
    if info.gid == gid {
        in_group = true
    } else {
        let groups = std_env.groups() else List[int]()
        for g in groups {
            if g == info.gid {
                in_group = true
            }
        }
    }
    if in_group {
        return info.mode & 8 != 0
    }
    info.mode & 1 != 0
}

// `access(path, X_OK) == 0 && stat(path) == 0 && S_ISREG`.
fn exec_ok(path: str) -> bool {
    let info = fs.stat(path) else {
        return false
    }
    info.kind == 0 && access_x(info)
}

// `clip_path_exec`, `clipboard.c:141-185`: a name with a slash is itself;
// otherwise each PATH entry (an empty one is `.`, an unset PATH is
// `/usr/local/bin:/usr/bin:/bin`).
fn clip_path_exec(name: str) -> bool {
    if name.len == 0 {
        return false
    }
    if name.contains("/") {
        return exec_ok(name)
    }
    let (path_env, has) = term.env_getv("PATH")
    let path = if has then path_env else "/usr/local/bin:/usr/bin:/bin"
    let b = path.bytes()
    var at = 0
    loop {
        var end = at
        while end < b.len && b[end] as int != 58 {
            end += 1
        }
        var dir = "."
        if end > at {
            dir = util.buf_to_str(b[at..end]) else "."
        }
        if exec_ok("{dir}/{name}") {
            return true
        }
        if end >= b.len {
            return false
        }
        at = end + 1
    }
    false
}

fn clip_backend_bit(backend: int) -> int {
    if backend < 32 then 1 << backend else 0
}

fn stdout_is_terminal() -> bool {
    std_io.is_terminal(fs.stdout()) else false
}

// `clip_available`, `clipboard.c:192-218`.
fn clip_available(c: Clipboard, backend: int) -> bool {
    if c.demoted & clip_backend_bit(backend) != 0 {
        return false
    }
    if backend == CLIP_WL {
        return nonempty_env("WAYLAND_DISPLAY") && clip_path_exec("wl-copy")
    }
    if backend == CLIP_XCLIP {
        return nonempty_env("DISPLAY") && clip_path_exec("xclip")
    }
    if backend == CLIP_XSEL {
        return nonempty_env("DISPLAY") && clip_path_exec("xsel")
    }
    if backend == CLIP_PB {
        return os_name() == "macos" && os_arch() == "aarch64" && clip_path_exec("pbcopy")
    }
    if backend == CLIP_OSC52 {
        return stdout_is_terminal() && term.osc52_mode(term.env_process()) != term.OSC52_OFF
    }
    false
}

// `clip_named_backend`, `clipboard.c:220-249`: (backend, recognized).
fn clip_named_backend(value: str, read_side: bool) -> (int, bool) {
    if value == "none" {
        return (CLIP_NONE, true)
    }
    if value == "osc52" {
        if read_side || term.osc52_mode(term.env_process()) == term.OSC52_OFF {
            return (CLIP_NONE, true)
        }
        return (CLIP_OSC52, true)
    }
    if value == "wl" {
        return (CLIP_WL, true)
    }
    if value == "xclip" {
        return (CLIP_XCLIP, true)
    }
    if value == "xsel" {
        return (CLIP_XSEL, true)
    }
    if value == "pb" {
        return (CLIP_PB, true)
    }
    if value.starts_with("cmd:") {
        let b = value.bytes()
        var bar = 4
        while bar < b.len && b[bar] as int != 124 {
            bar += 1
        }
        if read_side {
            if bar < b.len && bar + 1 < b.len {
                return (CLIP_CUSTOM, true)
            }
            return (CLIP_NONE, true)
        }
        if b.len > 4 && bar != 4 {
            return (CLIP_CUSTOM, true)
        }
        return (CLIP_NONE, true)
    }
    (CLIP_NONE, false)
}

// `clip_detect_direction`, `clipboard.c:251-283`: the override, then
// OSC 52 alone over SSH (writes), then wl, xclip, xsel, pb, then OSC 52.
fn clip_detect_direction(c: Clipboard, read_side: bool) -> int {
    let (forced_name, has) = term.env_getv("YEW_CLIPBOARD")
    if has && forced_name.len != 0 && forced_name != "auto" {
        let (forced, recognized) = clip_named_backend(forced_name, read_side)
        if recognized {
            if c.demoted & clip_backend_bit(forced) != 0 {
                return CLIP_NONE
            }
            return forced
        }
        util.log_warn("clipboard: ignoring invalid YEW_CLIPBOARD override")
    }
    if !read_side && clip_remote() {
        return if clip_available(c, CLIP_OSC52) then CLIP_OSC52 else CLIP_NONE
    }
    if clip_available(c, CLIP_WL) {
        return CLIP_WL
    }
    if clip_available(c, CLIP_XCLIP) {
        return CLIP_XCLIP
    }
    if clip_available(c, CLIP_XSEL) {
        return CLIP_XSEL
    }
    if clip_available(c, CLIP_PB) {
        return CLIP_PB
    }
    if !read_side && clip_available(c, CLIP_OSC52) {
        return CLIP_OSC52
    }
    CLIP_NONE
}

fn clip_detect_subprocess_write(c: Clipboard) -> int {
    if clip_available(c, CLIP_WL) {
        return CLIP_WL
    }
    if clip_available(c, CLIP_XCLIP) {
        return CLIP_XCLIP
    }
    if clip_available(c, CLIP_XSEL) {
        return CLIP_XSEL
    }
    if clip_available(c, CLIP_PB) {
        return CLIP_PB
    }
    CLIP_NONE
}

/// The write backend, detected once and cached (`yew_clip_detect`,
/// `clipboard.c:298-306`).
pub fn clip_detect(mut c: Clipboard) -> int {
    clip_init(mut c)
    if !c.write_cached {
        c.write_backend = clip_detect_direction(c, false)
        c.write_cached = true
    }
    c.write_backend
}

/// The read backend: the same local order, never OSC 52
/// (`yew_clip_detect_read`, `clipboard.c:308-316`).
pub fn clip_detect_read(mut c: Clipboard) -> int {
    clip_init(mut c)
    if !c.read_cached {
        c.read_backend = clip_detect_direction(c, true)
        c.read_cached = true
    }
    c.read_backend
}

fn words(list: str) -> List[str] {
    var out = List[str]()
    for w in list.split(" ") {
        if w.len != 0 {
            (mut out).push(w)
        }
    }
    out
}

// `clip_cmd_parse`, `clipboard.c:352-386`: words split on spaces.
fn clip_cmd_parse(b: List[byte], lo: int, hi: int) -> List[str] {
    let text = util.buf_to_str(b[lo..hi]) else ""
    words(text)
}

// `clip_custom_cmd`, `clipboard.c:388-405`: the write half before `|`,
// the read half after it.
fn clip_custom_cmd(read_side: bool) -> List[str] {
    let (value, has) = term.env_getv("YEW_CLIPBOARD")
    if !has || !value.starts_with("cmd:") {
        return List[str]()
    }
    let b = value.bytes()
    var bar = 4
    while bar < b.len && b[bar] as int != 124 {
        bar += 1
    }
    if read_side {
        if bar >= b.len {
            return List[str]()
        }
        return clip_cmd_parse(b, bar + 1, b.len)
    }
    clip_cmd_parse(b, 4, bar)
}

// `clip_command`, `clipboard.c:407-480`: the argv for a backend and
// direction (`*` is the primary selection); empty when there is none.
fn clip_command(backend: int, read_side: bool, target: int) -> List[str] {
    let primary = target == '*' as int
    if backend == CLIP_WL {
        if read_side {
            return if primary {
                words("wl-paste --primary --no-newline")
            } else {
                words("wl-paste --no-newline")
            }
        }
        if primary {
            return words("wl-copy --type text/plain;charset=utf-8 --primary")
        }
        return words("wl-copy --type text/plain;charset=utf-8")
    }
    if backend == CLIP_XCLIP {
        let sel = if primary then "primary" else "clipboard"
        let dir = if read_side then "-out" else "-in"
        return words("xclip -selection {sel} {dir}")
    }
    if backend == CLIP_XSEL {
        let sel = if primary then "--primary" else "--clipboard"
        let dir = if read_side then "--output" else "--input"
        return words("xsel {sel} {dir}")
    }
    if backend == CLIP_PB {
        return if read_side then words("pbpaste") else words("pbcopy")
    }
    if backend == CLIP_CUSTOM {
        return clip_custom_cmd(read_side)
    }
    List[str]()
}

// The meaning the clipboard's waits name: one the editor never listens
// for, so a wait here takes nothing off the loop's queue (the header).
fn clip_wait_set() -> int {
    signal.urgent()
}

// Is `fd` readable now (a byte, the end of input or a hang-up)? C's
// `O_NONBLOCK` read answering EAGAIN, as one zero-deadline wait.
fn fd_ready(fd: int) -> bool {
    let (i, _) = os_signal_wait_fds([fd], clip_wait_set(), 0) else {
        return false
    }
    i == 0
}

fn close_fd(fd: int) {
    if fd >= 0 {
        fs_close(fd) else |_| {}
    }
}

// Read what a middle's status pipe holds now, never blocking; the end of
// input marks the child `eof` and closes the descriptor.
fn child_drain(mut ch: ClipChild) {
    while !ch.eof && ch.fd >= 0 && fd_ready(ch.fd) {
        var f = fs.File { fd: ch.fd }
        let got = fs.read_chunk(mut f, 4096) else |e| match e {
            eof => {
                ch.eof = true
                close_fd(ch.fd)
                ch.fd = -1
                return
            },
            io => {
                ch.eof = true
                close_fd(ch.fd)
                ch.fd = -1
                return
            },
        }
        for byte_value in got {
            (mut ch.buf).push(byte_value)
        }
    }
}

// The first complete line of `ch.buf` (without its newline), removed;
// ("", false) when no line is complete.
fn child_line(mut ch: ClipChild) -> (str, bool) {
    var nl = -1
    var i = 0
    while i < ch.buf.len {
        if ch.buf[i] as int == 10 {
            nl = i
            break
        }
        i += 1
    }
    if nl < 0 {
        return ("", false)
    }
    let line = str_from_utf8(ch.buf[0..nl]) else ""
    var rest = List[byte]()
    var k = nl + 1
    while k < ch.buf.len {
        (mut rest).push(ch.buf[k])
        k += 1
    }
    ch.buf = rest
    (line, true)
}

// The number after `word ` in a status line, or -1.
fn line_number(line: str, word: str) -> int {
    if !line.starts_with(word + " ") {
        return -1
    }
    line[word.len + 1..].to_int() else -1
}

// A middle whose status pipe read end-of-file has exited (or is exiting:
// its descriptors close before it can be waited for), so the wait that
// reaps it is short; one reaped elsewhere (a job's `os_wait_poll`)
// answers `io`, which is reaped too.
fn child_reap(ch: ClipChild) {
    let _ = os_wait_status(ch.slot) else -1
}

/// Reap the writers' exited middle processes (`yew_clip_reap`,
/// `clipboard.c:534-551`): each whose status pipe has reached its end is
/// waited for and forgotten; the active write's middle is the pump's.
pub fn clip_reap(mut c: Clipboard) {
    // Nothing to reap is the frame's usual case (the reap runs after every
    // frame): no list is rebuilt, as C's in-place pass over an empty array
    // writes nothing (yw05-hot, deliverable 6).
    if !c.initialized || c.reap.len == 0 {
        return
    }
    var out = List[ClipChild]()
    var i = 0
    while i < c.reap.len {
        var ch = copy c.reap[i]
        if c.active_valid && ch.slot == c.middle {
            (mut out).push(ch)
        } else {
            child_drain(mut ch)
            if ch.eof {
                child_reap(ch)
            } else {
                (mut out).push(ch)
            }
        }
        i += 1
    }
    c.reap = out
}

/// How many writer processes are still unreaped (`yew_clip_owned_children`).
pub fn clip_owned_children(c: Clipboard) -> int {
    if c.initialized then c.reap.len else 0
}

fn write_line(mut f: fs.File, line: str) {
    fs.write(mut f, line + "\n") else |_| {}
}

/// The forked writer's middle (`clipboard.c:593-641`, the `middle == 0`
/// branch, with the editor's non-blocking write moved here, the header):
/// start the tool on a data pipe, its output and errors on the null
/// device and SIGPIPE back to the default; report `pid N`, or `exec E`
/// when it does not start; write all of `bytes` into its stdin; report
/// `done`, `epipe` or `write E`; and end without running anything of the
/// editor's. Reusable for any descriptor-fed child: `cmd` is the argv,
/// `status` the write end the parent reads (the region filter's write
/// side has the same shape, R-yw04-3).
pub fn clip_writer_middle(cmd: List[str], bytes: List[byte], status: fs.File) {
    var st = copy status
    let data = process.pipe() else |_| {
        write_line(mut st, "exec {os_error()}")
        os_exit(0)
        return
    }
    let null_out = fs.open_append("/dev/null") else |_| {
        write_line(mut st, "exec {os_error()}")
        os_exit(0)
        return
    }
    var c = process.from_argv(cmd)
    process.set_stdin(mut c, data.read)
    process.set_stdout(mut c, null_out)
    process.set_stderr(mut c, null_out)
    let tool = process.start_job(c, -1, signal.broken_pipe()) else |_| {
        write_line(mut st, "exec {os_error()}")
        os_exit(0)
        return
    }
    let pid = process.pid(tool) else 0
    write_line(mut st, "pid {pid}")
    fs.close(take data.read) else |_| {}
    fs.close(take null_out) else |_| {}
    var w = copy data.write
    if bytes.len > 0 {
        fs.write_chunk(mut w, bytes) else |_| {
            let e = os_error()
            if e == 32 {
                write_line(mut st, "epipe")
            } else {
                write_line(mut st, "write {e}")
            }
            os_exit(0)
            return
        }
    }
    fs.close(take w) else |_| {}
    write_line(mut st, "done")
    os_exit(0)
}

// `clip_spawn_writer`, `clipboard.c:558-661`: fork the middle (the
// header); C's success sets the deadline `now_ms + timeout_ms`,
// saturating.
fn clip_spawn_writer(mut c: Clipboard, backend: int, target: int, now_ms: int) -> bool {
    let cmd = clip_command(backend, false, target)
    if cmd.len == 0 {
        return false
    }
    clip_reap(mut c)
    if c.reap.len >= CLIP_REAP_MAX {
        return false
    }
    let sp = process.pipe() else |_| {
        return false
    }
    let rfd = sp.read.fd
    let wfd = sp.write.fd
    let (pid, h) = os_fork() else |_| {
        close_fd(rfd)
        close_fd(wfd)
        return false
    }
    if pid == 0 {
        close_fd(rfd)
        clip_writer_middle(cmd, c.active.bytes, fs.File { fd: wfd })
        os_exit(0)
    }
    close_fd(wfd)
    (mut c.reap).push(ClipChild { slot: h, fd: rfd, buf: List[byte](), eof: false })
    c.middle = h
    c.write_fd = -1
    c.pid_fd = -1
    c.exec_fd = rfd
    c.tool_pid = 0
    c.written = 0
    c.exec_ready = false
    c.deadline_ms = if now_ms > 9223372036854775807 - c.timeout_ms {
        9223372036854775807
    } else {
        now_ms + c.timeout_ms
    }
    true
}

// `clip_close_active`, `clipboard.c:663-680`.
fn clip_close_active(mut c: Clipboard) {
    c.middle = -1
    c.write_fd = -1
    c.pid_fd = -1
    c.exec_fd = -1
    c.tool_pid = 0
    c.written = 0
    c.deadline_ms = 0
    c.exec_ready = false
    c.active_valid = false
    regval_clear(mut c.active)
}

// `clip_retry_active`, `clipboard.c:682-692`: requeue the active write
// unless a newer one is queued, and demote its backend.
fn clip_retry_active(mut c: Clipboard) {
    if !c.queued_valid {
        c.queued = copy c.active
        c.queued_target = c.active_target
        c.queued_valid = true
    }
    c.demoted = c.demoted | clip_backend_bit(c.active_backend)
    c.write_cached = false
    clip_close_active(mut c)
}

/// Queue a copy of `v` for the system clipboard (`yew_clip_write`,
/// `clipboard.c:740-751`): the latest write wins; `*` is the primary
/// selection, every other target `+`. Nothing is detected or started
/// until `clip_after_render`.
pub fn clip_write(mut c: Clipboard, v: RegVal, target: int) -> bool {
    clip_init(mut c)
    c.queued = copy v
    c.queued_target = if target != '*' as int then '+' as int else target
    c.queued_valid = true
    true
}

// `clip_start_queued`, `clipboard.c:753-807`.
fn clip_start_queued(mut c: Clipboard, mut r: term.Render, now_ms: int) {
    if !c.queued_valid || c.active_valid {
        return
    }
    let backend = clip_detect(mut c)
    if backend == CLIP_NONE {
        util.log_warn("clipboard: no writable system clipboard backend")
        c.queued_valid = false
        regval_clear(mut c.queued)
        return
    }
    c.active = copy c.queued
    c.active_target = c.queued_target
    c.active_backend = backend
    c.active_valid = true
    c.queued_valid = false
    regval_clear(mut c.queued)
    if backend == CLIP_OSC52 {
        var frame = List[byte]()
        if term.osc52_build_env(mut frame, c.active.bytes, term.env_process()) {
            term.render_oob_queue(mut r, frame)
            clip_close_active(mut c)
            return
        }
        while !clip_remote() {
            let fallback = clip_detect_subprocess_write(c)
            if fallback == CLIP_NONE {
                break
            }
            c.active_backend = fallback
            if clip_spawn_writer(mut c, fallback, c.active_target, now_ms) {
                return
            }
            util.log_warn("clipboard: cannot start fallback writer backend")
            c.demoted = c.demoted | clip_backend_bit(fallback)
            c.write_cached = false
        }
        util.log_warn("clipboard: payload exceeds OSC 52 limit; register + retains it")
        clip_close_active(mut c)
        return
    }
    if !clip_spawn_writer(mut c, backend, c.active_target, now_ms) {
        util.log_warn("clipboard: cannot start writer backend")
        clip_retry_active(mut c)
    }
}

fn clip_start_available(mut c: Clipboard, mut r: term.Render, now_ms: int) {
    var attempts = 0
    while c.queued_valid && !c.active_valid && attempts < CLIP_BACKEND_COUNT {
        attempts += 1
        clip_start_queued(mut c, mut r, now_ms)
    }
}

/// Once per input burst, after the frame is rendered
/// (`yew_clip_after_render`, `clipboard.c:818-827`): reap, pump, start
/// the queued write, pump, and flush the renderer's out-of-band bytes (an
/// OSC 52 sequence) onto `terminal_out`, behind the frame's end marker.
pub fn clip_after_render(
    mut c: Clipboard,
    mut r: term.Render,
    mut terminal_out: List[byte],
    now_ms: int,
) {
    clip_init(mut c)
    clip_reap(mut c)
    clip_pump(mut c, mut r, now_ms)
    clip_start_available(mut c, mut r, now_ms)
    clip_pump(mut c, mut r, now_ms)
    let _ = term.render_oob_flush(mut r, mut terminal_out)
}

// The active write's middle on the reap list, or -1.
fn active_child(c: Clipboard) -> int {
    var i = 0
    while i < c.reap.len {
        if c.reap[i].slot == c.middle {
            return i
        }
        i += 1
    }
    -1
}

// Kill the active write's tool (by pid, as C's `kill(tool_pid, SIGKILL)`)
// and its middle (which may be blocked writing into a tool that never
// reads); the middle is reaped once its status pipe ends.
fn kill_active(c: Clipboard) {
    if c.tool_pid > 0 {
        os_signal_send(c.tool_pid, signal.kill()) else |_| {}
    }
    if c.middle >= 0 {
        os_kill(c.middle) else |_| {}
    }
}

// One step of the active write: its status lines, then its deadline.
// Answers whether the write is still in flight.
fn clip_pump_active(mut c: Clipboard, now_ms: int) -> bool {
    let k = active_child(c)
    if k < 0 {
        util.log_warn("clipboard: writer exec status failed; demoting backend")
        clip_retry_active(mut c)
        return false
    }
    var ch = copy c.reap[k]
    child_drain(mut ch)
    var verdict = ""
    var code = 0
    loop {
        let (line, ok) = child_line(mut ch)
        if !ok {
            break
        }
        if line.starts_with("pid ") {
            c.tool_pid = line_number(line, "pid")
            c.exec_ready = true
        } else if line.starts_with("exec ") {
            verdict = "exec"
            code = line_number(line, "exec")
        } else if line.starts_with("write ") {
            verdict = "write"
            code = line_number(line, "write")
        } else if line == "epipe" || line == "done" {
            verdict = line
        }
        if verdict.len != 0 {
            break
        }
    }
    c.reap[k] = ch
    if verdict == "done" {
        c.written = c.active.bytes.len
        clip_close_active(mut c)
        return false
    }
    if verdict == "exec" {
        util.log_warn("clipboard: writer exec failed: {os_error_text(code)}; demoting backend")
        clip_retry_active(mut c)
        return false
    }
    if verdict == "epipe" {
        util.log_warn("clipboard: writer closed its pipe; demoting backend")
        clip_retry_active(mut c)
        return false
    }
    if verdict == "write" {
        util.log_warn("clipboard: write failed: {os_error_text(code)}")
        clip_retry_active(mut c)
        return false
    }
    if c.reap[k].eof {
        util.log_warn("clipboard: writer exec status failed; demoting backend")
        clip_retry_active(mut c)
        return false
    }
    if now_ms >= c.deadline_ms {
        kill_active(c)
        util.log_warn("clipboard: writer timed out")
        clip_retry_active(mut c)
        return false
    }
    true
}

/// Drive the active subprocess write (`yew_clip_pump`, `clipboard.c:829-
/// 893`): read its middle's verdict, close it on `done`, demote and retry
/// its backend on a failure or the deadline, start what is queued.
pub fn clip_pump(mut c: Clipboard, mut r: term.Render, now_ms: int) {
    var fallbacks = 0
    if !c.initialized {
        return
    }
    clip_reap(mut c)
    loop {
        if !c.active_valid {
            return
        }
        if clip_pump_active(mut c, now_ms) {
            return
        }
        fallbacks += 1
        if fallbacks >= CLIP_BACKEND_COUNT {
            return
        }
        clip_start_available(mut c, mut r, now_ms)
    }
}

/// The descriptor the loop waits on for the writer (`yew_clip_write_fd`):
/// the active write's status pipe, readable when the middle reports or
/// ends; -1 with none. The editor never holds a write end (the header).
pub fn clip_write_fd(c: Clipboard) -> int {
    if !c.initialized || !c.active_valid {
        return -1
    }
    let k = active_child(c)
    if k < 0 then -1 else c.reap[k].fd
}

/// The active write's deadline, or -1 (`yew_clip_deadline`).
pub fn clip_deadline(c: Clipboard) -> int {
    if c.initialized && c.active_valid then c.deadline_ms else -1
}

/// A write is in flight (`yew_clip_busy`).
pub fn clip_busy(c: Clipboard) -> bool {
    c.initialized && c.active_valid
}

/// A write is queued (`yew_clip_pending`).
pub fn clip_pending(c: Clipboard) -> bool {
    c.initialized && c.queued_valid
}

/// The forked reader's middle (`clip_spawn_reader`'s child,
/// `clipboard.c:931-947`, plus the `waitpid` C's parent makes): start the
/// tool with the null device for its input and errors and `data` for its
/// output, report `pid N` (or `status 127`, C's exec-failure exit, when it
/// does not start), wait for it and report `status S` (`wait_status`'s
/// answer: an exit code, or `-N` for signal N), then end.
fn clip_reader_middle(cmd: List[str], data: fs.File, status: fs.File) {
    var st = copy status
    let null_in = fs.open("/dev/null") else |_| {
        write_line(mut st, "status 126")
        os_exit(0)
        return
    }
    let null_out = fs.open_append("/dev/null") else |_| {
        write_line(mut st, "status 126")
        os_exit(0)
        return
    }
    var c = process.from_argv(cmd)
    process.set_stdin(mut c, null_in)
    process.set_stdout(mut c, data)
    process.set_stderr(mut c, null_out)
    let tool = process.start_job(c, -1, signal.broken_pipe()) else |_| {
        write_line(mut st, "status 127")
        os_exit(0)
        return
    }
    let pid = process.pid(tool) else 0
    write_line(mut st, "pid {pid}")
    close_fd(data.fd)
    fs.close(take null_in) else |_| {}
    fs.close(take null_out) else |_| {}
    let code = process.wait_status(take tool) else -999
    write_line(mut st, "status {code}")
    os_exit(0)
}

/// Read the system clipboard into `out` (`yew_clip_read`,
/// `clipboard.c:960-1099`): false, `out` untouched and a warning logged
/// when no subprocess backend reads, the tool cannot start, its output
/// passes `read_max`, the deadline passes or it does not exit 0; on a clean
/// exit `out` is the charwise bytes the tool printed.
pub fn clip_read(mut c: Clipboard, mut out: RegVal, target: int) -> bool {
    clip_init(mut c)
    let backend = clip_detect_read(mut c)
    if backend == CLIP_NONE || backend == CLIP_OSC52 {
        util.log_warn("clipboard: no readable system clipboard backend")
        return false
    }
    let cmd = clip_command(backend, true, if target == '*' as int then target else '+' as int)
    if cmd.len == 0 {
        util.log_warn("clipboard: selected backend has no read command")
        return false
    }
    let data = process.pipe() else |_| {
        util.log_warn("clipboard: cannot start reader: {os_error_text(os_error())}")
        return false
    }
    let sp = process.pipe() else |_| {
        close_fd(data.read.fd)
        close_fd(data.write.fd)
        util.log_warn("clipboard: cannot start reader: {os_error_text(os_error())}")
        return false
    }
    let dfd = data.read.fd
    let dwfd = data.write.fd
    let srfd = sp.read.fd
    let swfd = sp.write.fd
    let (pid, h) = os_fork() else |e| {
        let why = match e {
            busy => "a task is live",
            io => os_error_text(os_error()),
            unsupported => "no fork on this machine",
        }
        close_fd(dfd)
        close_fd(dwfd)
        close_fd(srfd)
        close_fd(swfd)
        util.log_warn("clipboard: cannot start reader: {why}")
        return false
    }
    if pid == 0 {
        close_fd(dfd)
        close_fd(srfd)
        clip_reader_middle(cmd, fs.File { fd: dwfd }, fs.File { fd: swfd })
        os_exit(0)
    }
    close_fd(dwfd)
    close_fd(swfd)
    var ch = ClipChild { slot: h, fd: srfd, buf: List[byte](), eof: false }
    var bytes = List[byte]()
    let start = time_now_ms()
    let deadline = if start > 9223372036854775807 - c.timeout_ms {
        9223372036854775807
    } else {
        start + c.timeout_ms
    }
    var data_fd = dfd
    var eof = false
    var failed = false
    var reaped = false
    var status = 0
    var tool_pid = 0
    while (!reaped || !eof) && !failed {
        let now = time_now_ms()
        if now >= deadline {
            util.log_warn("clipboard: reader timed out after {c.timeout_ms} ms")
            failed = true
            break
        }
        let timeout = if deadline - now > 20 then 20 else deadline - now
        var fds = List[int]()
        if !eof {
            (mut fds).push(data_fd)
        }
        if !reaped {
            (mut fds).push(ch.fd)
        }
        let _ = os_signal_wait_fds(fds, clip_wait_set(), timeout) else |_| {
            util.log_warn("clipboard: reader poll failed: {os_error_text(os_error())}")
            failed = true
            break
        }
        while !eof && fd_ready(data_fd) {
            var f = fs.File { fd: data_fd }
            let got = fs.read_chunk(mut f, 8192) else |e| match e {
                eof => {
                    eof = true
                    close_fd(data_fd)
                    data_fd = -1
                    break
                },
                io => {
                    util.log_warn("clipboard: reader pipe failed: {os_error_text(os_error())}")
                    failed = true
                    break
                },
            }
            if got.len > c.read_max - bytes.len {
                util.log_warn("clipboard: read exceeds {c.read_max}-byte limit")
                failed = true
                break
            }
            for byte_value in got {
                (mut bytes).push(byte_value)
            }
        }
        if !reaped && !failed {
            child_drain(mut ch)
            loop {
                let (line, ok) = child_line(mut ch)
                if !ok {
                    break
                }
                if line.starts_with("pid ") {
                    tool_pid = line_number(line, "pid")
                } else if line.starts_with("status ") {
                    status = line[7..].to_int() else -999
                    reaped = true
                }
            }
            if !reaped && ch.eof {
                util.log_warn("clipboard: reader wait failed: its middle ended without a status")
                failed = true
                reaped = true
            }
        }
    }
    close_fd(data_fd)
    if !reaped {
        if tool_pid > 0 {
            os_signal_send(tool_pid, signal.kill()) else |_| {}
        }
        os_kill(h) else |_| {}
    }
    close_fd(ch.fd)
    let _ = os_wait_status(h) else -1
    if !failed && status == 0 {
        regval_clear(mut out)
        for byte_value in bytes {
            (mut out.bytes).push(byte_value)
        }
        out.t_wall = time_unix_ms() / 1000
        return true
    }
    if !failed {
        if status >= 0 {
            util.log_warn("clipboard: reader exited with status {status}")
        } else if status > -999 {
            util.log_warn("clipboard: reader terminated by signal {0 - status}")
        } else {
            util.log_warn("clipboard: reader did not exit cleanly")
        }
    }
    false
}

/// The read cap (`yew_clip_set_read_max`).
pub fn clip_set_read_max(mut c: Clipboard, max_bytes: int) {
    clip_init(mut c)
    c.read_max = max_bytes
}

/// Stop: kill a running write's tool and middle, wait for every tracked
/// middle, forget everything (`yew_clip_shutdown`, `clipboard.c:1107-
/// 1129`). A middle whose write is done exits on its own; only the active
/// one can still be writing, and it is killed first, as C kills the
/// active tool.
pub fn clip_shutdown(mut c: Clipboard) {
    if !c.initialized {
        return
    }
    if c.active_valid {
        let k = active_child(c)
        if k >= 0 {
            var ch = copy c.reap[k]
            child_drain(mut ch)
            loop {
                let (line, ok) = child_line(mut ch)
                if !ok {
                    break
                }
                if line.starts_with("pid ") {
                    c.tool_pid = line_number(line, "pid")
                }
            }
            c.reap[k] = ch
        }
        kill_active(c)
    }
    for ch in c.reap {
        close_fd(ch.fd)
        child_reap(ch)
    }
    c = clip_new()
}

/// Shut down and start over: defaults restored, detection invalidated
/// (`yew_clip_reset`); SIGPIPE stays ignored.
pub fn clip_reset(mut c: Clipboard) {
    clip_shutdown(mut c)
    clip_init(mut c)
}
