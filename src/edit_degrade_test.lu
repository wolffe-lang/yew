//! member: false
//!
//! The port of sagitta `tests/unit/test_degrade.c` (598 lines) at
//! 9ace98c2, one test per C test in registry order
//! (`tests/unit/registry.c:2731-2740`): Sprint 27 §8's degradation audit —
//! nothing is usable only at the top tier. NO_COLOR, sixteen colours, no
//! mouse, no UTF-8, a 20x5 terminal: in each the chrome keeps its
//! MEANING, asserted by ATTRIBUTE (an active tab without colour is still
//! reverse video), and s57.13 §6's context menu at every tier.
//!
//! C's `dg_env` is `getenv` over a process environment the cases
//! `setenv`/`unsetenv` around themselves; the port's `term.Env` is a
//! VALUE (`env_of`), so a case that sets variables hands the renderer a
//! table holding exactly those, and a case that sets none reads the
//! process's (`env_process`). C's `yew_render_init(&r, NULL, dg_env)` is
//! `term.render_new(term.caps_new(), env)`; a frame's `Bytebuf` is a
//! `List[byte]`; the glyph table's ASCII force is the module's one
//! sanctioned switch (`edit.glyph_force_ascii`, invariant 8), reset at
//! the end of the case that sets it, as C's is.
//!
//! One port case follows C's ten: `port_s27_s7_glyph_review`, s27 §7's
//! vocabulary table row by row against the one glyph table, both
//! vocabularies measured (the sprint's other half of the feel pass, the
//! chrome golden review, is the PTY set's `chrome_*`).
//!
//! The per-case selector `YEW_DEGRADE_CASE=N` (the registry index within
//! this file, 0-based; 10 is the port case) runs one case, for the
//! checked machine's step budget (G29).

use edit
use term

// `dg_fixture` (`test_degrade.c:42-59`).
fn fixture(rows: int, cols: int, extra: int) -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(rows, cols)
    ed.grid_ready = true
    var i = 0
    while i < extra {
        assert(edit.tab_open(mut ed, "/tmp/yew-degrade-{i}.txt") >= 0, "open yew-degrade-{i}")
        i += 1
    }
    edit.ed_layout(mut ed)
    ed
}

fn env1(name: str, value: str) -> term.Env {
    var vars = Map[str, str]()
    vars[name] = value
    term.env_of(vars)
}

fn render(env: term.Env) -> term.Render {
    term.render_new(term.caps_new(), env)
}

// `dg_frame` (`:62-73`): one frame's bytes at whatever tier `r` resolved.
fn frame(mut ed: edit.Ed, mut r: term.Render) -> List[byte] {
    edit.region_frame_begin(mut ed.regions)
    edit.draw_panes(mut ed)
    if ed.tab_strip_rect.h != 0 {
        let tr = copy ed.tab_strip_rect
        edit.tab_strip_draw(mut ed, tr)
    }
    let w = ed.win
    edit.draw_footer(mut ed, w)
    var out = List[byte]()
    term.grid_mark_all(mut ed.grid)
    let _ = term.render_frame(mut r, ed.grid, mut out)
    out
}

// C's `strstr` over the frame.
fn has(out: List[byte], pat: str) -> bool {
    let p = pat.bytes()
    if p.len == 0 {
        return true
    }
    var i = 0
    while i + p.len <= out.len {
        var j = 0
        while j < p.len && out[i + j] as int == p[j] as int {
            j += 1
        }
        if j == p.len {
            return true
        }
        i += 1
    }
    false
}

// `dg_has_sgr` (`:75-93`): any CSI sequence ending in `m`.
fn has_sgr(out: List[byte]) -> bool {
    var i = 0
    while i + 2 < out.len {
        if out[i] as int == 27 && out[i + 1] as int == '[' as int {
            var end = i + 2
            var done = false
            while end < out.len && !done {
                let c = out[end] as int
                if c >= '@' as int && c <= '~' as int {
                    if c == 'm' as int {
                        return true
                    }
                    done = true
                }
                end += 1
            }
        }
        i += 1
    }
    false
}

fn no_extended_colour(out: List[byte]) -> bool {
    !has(out, "38;2") && !has(out, "48;2") && !has(out, "38;5") && !has(out, "48;5")
}

fn reverse_seen(out: List[byte]) -> bool {
    has(out, "7m") || has(out, ";7") || has(out, "[7")
}

fn all_ascii(out: List[byte]) -> bool {
    var i = 0
    while i < out.len {
        if out[i] as int >= 128 {
            return false
        }
        i += 1
    }
    true
}

// ---- NO_COLOR ---------------------------------------------------------------

// `test_degrade_no_color_emits_no_colour_and_stays_legible` (`:103-154`):
// DoD 11 — zero colour parameters, and an active tab still reads as one.
fn t_no_color_emits_no_colour_and_stays_legible() {
    var ed = fixture(24, 80, 3)
    var r = render(env1("NO_COLOR", "1"))
    assert(r.no_color, "NO_COLOR resolved")
    let out = frame(mut ed, mut r)
    // Not one truecolor, 256-colour or ANSI colour parameter.
    assert(no_extended_colour(out), "no extended colour")
    var code = 30
    while code <= 37 {
        assert(!has(out, "\u{1b}[{code}m"), "no ANSI {code}")
        assert(!has(out, "\u{1b}[{code + 60}m"), "no ANSI {code + 60}")
        code += 1
    }
    // And LEGIBLE: reverse video carries "this tab is active".
    assert(reverse_seen(out), "reverse video is still there")
}

// `test_degrade_empty_no_color_is_not_set` (`:157-188`): the NO_COLOR
// contract is presence-based — even an empty value counts — and TERM=dumb
// is plain.
fn t_empty_no_color_is_not_set() {
    var r = render(env1("NO_COLOR", ""))
    assert(r.no_color, "an empty NO_COLOR counts")
    var ed = fixture(24, 80, 1)
    let out = frame(mut ed, mut r)
    assert(!has(out, "38;"), "no foreground colour")
    assert(!has(out, "48;"), "no background colour")

    var d = render(env1("TERM", "dumb"))
    assert(!d.no_color, "no NO_COLOR")
    assert(d.plain, "TERM=dumb is plain")
    var ed2 = fixture(24, 80, 1)
    let plain = frame(mut ed2, mut d)
    assert(!has_sgr(plain), "no SGR at all")
}

// ---- the 16-colour tier -----------------------------------------------------

// `test_degrade_16_colour_tier_uses_reverse_not_colour` (`:199-227`).
fn t_16_colour_tier_uses_reverse_not_colour() {
    var ed = fixture(24, 80, 3)
    var r = render(env1("YEW_COLORS", "16"))
    assert(r.tier == term.TIER_16, "the 16-colour tier")
    let out = frame(mut ed, mut r)
    assert(no_extended_colour(out), "no 256 or truecolor parameters")
    // Reverse is still what says "active".
    assert(reverse_seen(out), "reverse video")
}

// ---- no mouse ---------------------------------------------------------------

fn press_at(x: int, y: int) -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_MOUSE
    k.button = term.MB_LEFT
    k.ev = term.KEY_PRESS
    k.col = x
    k.row = y
    k
}

fn cursor_pos(ed: edit.Ed) -> int {
    let w = ed.win
    ed.wins[w].cs.curs[ed.wins[w].cs.primary].pos
}

// `test_degrade_yew_mouse_zero_drops_events` (`:239-284`): YEW_MOUSE=0
// drops events at the router too, not only at the terminal.
fn t_yew_mouse_zero_drops_events() {
    var ed = fixture(24, 80, 0)
    edit.pane_tables_reset(mut ed)
    let root = ed.pane_root
    let leaf = edit.pane_table_add_leaf(mut ed, root)
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.panes[ed.pane_root].rect, leaf)
    let before = ed.focus
    let y = ed.panes[ed.pane_root].rect.y + 2
    edit.mouse_set_enabled(mut ed, false)
    edit.mouse_event(mut ed, press_at(10, y))
    assert(ed.mouse.phase == edit.MP_IDLE, "dropped")
    assert(ed.focus == before, "no focus change")
    assert(cursor_pos(ed) == 0, "no cursor move")
    // And back on, the same event lands.
    edit.mouse_set_enabled(mut ed, true)
    edit.mouse_event(mut ed, press_at(10, y))
    assert(ed.mouse.phase == edit.MP_ARMED, "armed")
    edit.mouse_cancel(mut ed)
}

// ---- tiny terminals ---------------------------------------------------------

// `dg_assert_rect_sane` (`:297-301`).
fn rect_sane(r: edit.Rect, rows: int, cols: int, what: str) {
    assert(r.x + r.w <= cols, "{what}: {r.x}+{r.w} within {cols} columns")
    assert(r.y + r.h <= rows, "{what}: {r.y}+{r.h} within {rows} rows")
}

// One size of `test_degrade_tiny_terminals_never_produce_a_bad_rect`.
fn tiny(cols: int, rows: int) {
    var ed = fixture(rows, cols, 3)
    // A group, so the strip WANTS two rows and has to give one back.
    let g = edit.group_create(mut ed, "/src", "grp")
    edit.group_add_member(mut ed, g, 2)
    edit.group_add_member(mut ed, g, 3)
    edit.tab_switch(mut ed, 2)
    edit.ed_layout(mut ed)
    rect_sane(ed.tab_strip_rect, rows, cols, "{cols}x{rows} strip")
    rect_sane(ed.footer_rect, rows, cols, "{cols}x{rows} footer")
    assert(ed.win >= 0, "{cols}x{rows}: a window")
    rect_sane(ed.wins[ed.win].rect, rows, cols, "{cols}x{rows} window")
    // The strip never takes more than the screen has.
    assert(ed.tab_strip_rect.h <= rows, "{cols}x{rows}: the strip fits")
    // Drawing at this size must not fault.
    var r = render(term.env_process())
    let _ = frame(mut ed, mut r)
}

// `test_degrade_tiny_terminals_never_produce_a_bad_rect` (`:303-346`):
// down to 20x5 and below, never a crash and never a bad Rect.
fn t_tiny_terminals_never_produce_a_bad_rect() {
    tiny(80, 24)
    tiny(40, 12)
    tiny(20, 5)
    tiny(20, 4)
    tiny(20, 3)
    tiny(20, 2)
    tiny(20, 1)
    tiny(10, 5)
    tiny(4, 2)
    tiny(1, 1)
}

// `test_degrade_the_member_strip_sheds_before_the_tab_strip` (`:353-380`).
fn t_the_member_strip_sheds_before_the_tab_strip() {
    var ed = fixture(24, 80, 3)
    let g = edit.group_create(mut ed, "/src", "grp")
    edit.group_add_member(mut ed, g, 2)
    edit.group_add_member(mut ed, g, 3)
    edit.tab_switch(mut ed, 2)
    edit.ed_layout(mut ed)
    assert(ed.tab_strip_rect.h == 2, "two strip rows")
    // RESIZE, not re-init.
    assert(term.grid_resize(mut ed.grid, 3, 80), "three rows")
    edit.ed_layout(mut ed)
    assert(ed.tab_strip_rect.h <= 2, "at most two")
    assert(ed.tab_strip_rect.y + ed.tab_strip_rect.h <= 3, "inside three rows")
    // Two rows: the strip has at most one left.
    assert(term.grid_resize(mut ed.grid, 2, 80), "two rows")
    edit.ed_layout(mut ed)
    assert(ed.tab_strip_rect.h <= 1, "at most one")
}

// ---- ASCII ------------------------------------------------------------------

// `test_degrade_ascii_keeps_every_element_meaningful` (`:391-418`).
fn t_ascii_keeps_every_element_meaningful() {
    edit.glyph_force_ascii(true)
    var ed = fixture(24, 80, 3)
    var r = render(term.env_process())
    let out = frame(mut ed, mut r)
    // Pure ASCII on the wire.
    assert(all_ascii(out), "ASCII on the wire")
    // Ticked and unticked still differ.
    assert(edit.glyph(edit.GLYPH_TICKED) != edit.glyph(edit.GLYPH_UNTICKED), "ticks differ")
    // A vertical border is still not a horizontal one.
    assert(edit.glyph(edit.GLYPH_BORDER_V) != edit.glyph(edit.GLYPH_BORDER_H), "borders differ")
    edit.glyph_reset()
}

// ---- Sprint 57.13 §6: the context menu, at every tier -----------------------

// `dg_menu_fixture` (`:433-448`): a THEME LOADED and the editor's own
// Render in place, since the menu's roles pick their rendition from it.
fn menu_fixture(env: term.Env) -> (edit.Ed, term.Render) {
    var ed = fixture(24, 80, 3)
    let r = render(env)
    ed.render = copy r
    ed.render_ready = true
    edit.ed_theme_set(mut ed, "quiver-dark")
    assert(ed.theme.name == "quiver-dark", "the theme applied: {ed.msg.text}")
    let tid = ed.tabs[1].tab_id
    assert(edit.mouse_open_tab_menu(mut ed, tid, 4, 1), "the tab menu opens")
    assert(edit.ctx_active(ed.ctx), "open")
    // The first enabled row takes the highlight at open.
    assert(edit.ctx_cursor(ed.ctx) == 0, "row 0 highlighted")
    (ed, r)
}

// `dg_menu_frame` (`:451-463`): one frame with the menu over it.
fn menu_frame(mut ed: edit.Ed, mut r: term.Render) -> List[byte] {
    edit.region_frame_begin(mut ed.regions)
    edit.draw_panes(mut ed)
    if ed.tab_strip_rect.h != 0 {
        let tr = copy ed.tab_strip_rect
        edit.tab_strip_draw(mut ed, tr)
    }
    let w = ed.win
    edit.draw_footer(mut ed, w)
    edit.mouse_menu_draw(mut ed)
    var out = List[byte]()
    term.grid_mark_all(mut ed.grid)
    let _ = term.render_frame(mut r, ed.grid, mut out)
    out
}

// `dg_cell` / `dg_menu_row_cell` (`:465-476`): the first label cell of
// drawn row `i`, past the border and the pad.
fn menu_row_cell(ed: edit.Ed, i: int) -> term.Cell {
    let b = edit.ctx_box(ed.ctx)
    term.grid_back(ed.grid, b.y + 1 + i, b.x + 2)
}

fn cell_text(ed: edit.Ed, row: int, col: int) -> str {
    var v = List[byte]()
    term.cell_bytes_into(mut v, ed.grid, term.grid_back(ed.grid, row, col))
    str_from_utf8(v) else ""
}

fn color_eq(a: term.Color, b: term.Color) -> bool {
    a.tag == b.tag && a.r == b.r && a.g == b.g && a.b == b.b
}

fn cell_eq(a: term.Cell, b: term.Cell) -> bool {
    a.lo == b.lo &&
        a.hi == b.hi &&
        color_eq(a.fg, b.fg) &&
        color_eq(a.bg, b.bg) &&
        a.attrs == b.attrs &&
        a.w == b.w &&
        a.flags == b.flags
}

// `test_degrade_no_color_menu_keeps_its_hover_and_frame` (`:478-518`).
fn t_no_color_menu_keeps_its_hover_and_frame() {
    var (ed, r) = menu_fixture(env1("NO_COLOR", "1"))
    assert(r.no_color, "NO_COLOR resolved")
    let out = menu_frame(mut ed, mut r)
    assert(no_extended_colour(out), "no extended colour")
    // LEGIBLE: `menu.hover`'s mono rendition is reverse video.
    let hover = menu_row_cell(ed, 0)
    assert(hover.attrs & term.ATTR_REVERSE != 0, "the hover is reversed")
    assert(hover.fg.tag == term.COLOR_DEFAULT, "default foreground")
    assert(hover.bg.tag == term.COLOR_DEFAULT, "default background")
    // And the greyed row is still greyed, by DIM.
    assert(menu_row_cell(ed, 4).attrs & term.ATTR_DIM != 0, "the greyed row is dim")
    // The frame is still a frame.
    let b = edit.ctx_box(ed.ctx)
    assert(cell_text(ed, b.y, b.x) == edit.glyph(edit.GLYPH_BORDER_TL), "the corner")
    edit.ctx_close(mut ed.ctx)
}

// `test_degrade_16_colour_menu_stays_distinguishable` (`:520-560`).
fn t_16_colour_menu_stays_distinguishable() {
    var (ed, r) = menu_fixture(env1("YEW_COLORS", "16"))
    assert(r.tier == term.TIER_16, "the 16-colour tier")
    let out = menu_frame(mut ed, mut r)
    assert(no_extended_colour(out), "no extended colour")
    // The highlighted row differs from an ordinary one by something the
    // terminal cannot flatten.
    let hover = menu_row_cell(ed, 0)
    let plain = menu_row_cell(ed, 3)
    assert(
        hover.attrs != plain.attrs ||
            !color_eq(hover.fg, plain.fg) ||
            !color_eq(hover.bg, plain.bg),
        "the hover differs",
    )
    // And the greyed row still differs from the enabled one.
    assert(!cell_eq(menu_row_cell(ed, 4), plain), "the greyed row differs")
    edit.ctx_close(mut ed.ctx)
}

// `test_degrade_ascii_menu_is_still_a_box` (`:566-598`).
fn t_ascii_menu_is_still_a_box() {
    edit.glyph_force_ascii(true)
    var (ed, r) = menu_fixture(term.env_process())
    let out = menu_frame(mut ed, mut r)
    assert(all_ascii(out), "ASCII on the wire")
    let b = edit.ctx_box(ed.ctx)
    assert(cell_text(ed, b.y, b.x) == edit.glyph(edit.GLYPH_BORDER_TL), "the top-left corner")
    assert(
        cell_text(ed, b.y + b.h - 1, b.x + b.w - 1) == edit.glyph(edit.GLYPH_BORDER_BR),
        "the bottom-right corner",
    )
    // A corner is still not an edge.
    assert(
        edit.glyph(edit.GLYPH_BORDER_TL) != edit.glyph(edit.GLYPH_BORDER_H),
        "corner and edge differ",
    )
    edit.ctx_close(mut ed.ctx)
    edit.glyph_reset()
}

// ---- port case: s27 §7's glyph review ----------------------------------------

// One row of s27 §7's vocabulary table: the UTF-8 spelling, the ASCII
// fallback, and the same cell count in both (a two-cell glyph in a
// one-cell slot is a layout bug).
fn glyph_row(g: int, name: str, utf8: str, ascii: str) {
    edit.glyph_force_ascii(false)
    let u = edit.glyph(g)
    let uc = edit.glyph_cells(g)
    edit.glyph_force_ascii(true)
    let a = edit.glyph(g)
    let ac = edit.glyph_cells(g)
    print("glyph-review: {name}: utf8 {u} ({uc} cells) ascii {a} ({ac} cells)")
    assert(u == utf8, "{name}: the UTF-8 row is s27 §7's {utf8}, not {u}")
    assert(a == ascii, "{name}: the ASCII row is s27 §7's {ascii}, not {a}")
    assert(uc == ac, "{name}: {uc} cells in UTF-8, {ac} in ASCII")
}

// `port_s27_s7_glyph_review` (s27 §7, `s27-mouse-and-feel.md:327-375`):
// every row of the sprint's vocabulary table against the one glyph table
// (`edit.glyphs`), both vocabularies, measured — `⇕` and `✓` are the
// risky widths the sprint names; the git glyphs are reserved for Sprint
// 52 and listed so the reservation is checked too. The chrome golden
// review (the table's twelve elements) is the PTY set's `chrome_*`.
fn t_port_s27_s7_glyph_review() {
    glyph_row(edit.GLYPH_EXPAND, "collapsed node", "\u{00BB}", ">")
    glyph_row(edit.GLYPH_COLLAPSE, "expanded node", "\u{00AB}", "<")
    glyph_row(edit.GLYPH_GRIP, "separator grip", "\u{21D5}", "|")
    glyph_row(edit.GLYPH_MODIFIED, "modified", "*", "*")
    glyph_row(edit.GLYPH_DIRTY_TICK, "ticked, unsaved", "\u{2022}", "+")
    glyph_row(edit.GLYPH_DISCLOSE_OPEN, "expanded disclosure", "\u{25BC}", "v")
    glyph_row(edit.GLYPH_DISCLOSE_SHUT, "collapsed disclosure", "\u{25B6}", ">")
    glyph_row(edit.GLYPH_MORE_LEFT, "overflow left", "<", "<")
    glyph_row(edit.GLYPH_MORE_RIGHT, "overflow right", ">", ">")
    glyph_row(edit.GLYPH_TICKED, "ticked", "[\u{2713}]", "[x]")
    glyph_row(edit.GLYPH_UNTICKED, "unticked", "[ ]", "[ ]")
    glyph_row(edit.GLYPH_BORDER_V, "border", "\u{2502}", "|")
    glyph_row(edit.GLYPH_BORDER_H, "border", "\u{2500}", "-")
    glyph_row(edit.GLYPH_BORDER_CROSS, "joint", "\u{253C}", "+")
    glyph_row(edit.GLYPH_BORDER_TEE_R, "joint", "\u{251C}", "+")
    glyph_row(edit.GLYPH_BORDER_TEE_L, "joint", "\u{2524}", "+")
    glyph_row(edit.GLYPH_BORDER_TEE_D, "joint", "\u{252C}", "+")
    glyph_row(edit.GLYPH_BORDER_TEE_U, "joint", "\u{2534}", "+")
    glyph_row(edit.GLYPH_GIT_AHEAD, "git ahead (reserved, s52)", "\u{2191}", "^")
    glyph_row(edit.GLYPH_GIT_CONFLICT, "git conflict (reserved, s52)", "\u{2717}", "x")
    glyph_row(edit.GLYPH_GIT_BEHIND, "git behind (reserved, s52)", "\u{2193}", "v")
    // The risky widths, by name: one cell for the grip, three for the box.
    edit.glyph_force_ascii(false)
    assert(edit.glyph_cells(edit.GLYPH_GRIP) == 1, "the grip is one cell")
    assert(edit.glyph_cells(edit.GLYPH_TICKED) == 3, "the ticked box is three cells")
    // The arrows point the way the thing will move.
    assert(
        edit.glyph(edit.GLYPH_EXPAND) != edit.glyph(edit.GLYPH_COLLAPSE),
        "expand and collapse differ",
    )
    edit.glyph_reset()
}

fn want(chosen: int, n: int) -> bool {
    chosen < 0 || chosen == n
}

fn main() {
    let chosen = (env_get("YEW_DEGRADE_CASE") else "-1").to_int() else -1
    if want(chosen, 0) {
        t_no_color_emits_no_colour_and_stays_legible()
        print("degrade_no_color_emits_no_colour_and_stays_legible: PASS")
    }
    if want(chosen, 1) {
        t_empty_no_color_is_not_set()
        print("degrade_empty_no_color_is_not_set: PASS")
    }
    if want(chosen, 2) {
        t_16_colour_tier_uses_reverse_not_colour()
        print("degrade_16_colour_tier_uses_reverse_not_colour: PASS")
    }
    if want(chosen, 3) {
        t_yew_mouse_zero_drops_events()
        print("degrade_yew_mouse_zero_drops_events: PASS")
    }
    if want(chosen, 4) {
        t_tiny_terminals_never_produce_a_bad_rect()
        print("degrade_tiny_terminals_never_produce_a_bad_rect: PASS")
    }
    if want(chosen, 5) {
        t_the_member_strip_sheds_before_the_tab_strip()
        print("degrade_the_member_strip_sheds_before_the_tab_strip: PASS")
    }
    if want(chosen, 6) {
        t_ascii_keeps_every_element_meaningful()
        print("degrade_ascii_keeps_every_element_meaningful: PASS")
    }
    if want(chosen, 7) {
        t_no_color_menu_keeps_its_hover_and_frame()
        print("degrade_no_color_menu_keeps_its_hover_and_frame: PASS")
    }
    if want(chosen, 8) {
        t_16_colour_menu_stays_distinguishable()
        print("degrade_16_colour_menu_stays_distinguishable: PASS")
    }
    if want(chosen, 9) {
        t_ascii_menu_is_still_a_box()
        print("degrade_ascii_menu_is_still_a_box: PASS")
    }
    if want(chosen, 10) {
        t_port_s27_s7_glyph_review()
        print("port_s27_s7_glyph_review: PASS")
    }
    print("degrade_test: done")
}
