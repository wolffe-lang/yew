//! member: false
//!
//! The port of sagitta `tests/unit/test_mouse_click.c` (480 lines) at
//! 9ace98c2, one test per C test in registry order
//! (`tests/unit/registry.c:2713-2722`): Sprint 27 §6's double and triple
//! click THROUGH THE UNIT ENGINES — the central row asserts that the
//! selection a double-click produces EQUALS `edit.unit_span` over Sprint
//! 16's corpus (CJK, a ZWJ family, `don't`, `foo_bar`, `1,000.50`, an
//! invalid byte): the agreement IS the test. C's `ck_fixture` (`:37-56`)
//! is the editor with `text` inserted, laid out, the cursor at 0 and one
//! PANE region over the root; C's `UnitCtx` over the window is the
//! router's own (`has_win`), and `yew_unit_word`/`_line` are the
//! `UNIT_WORD`/`UNIT_LINE` kinds. Middle paste (`:425-480`) runs whole:
//! `edit.mouse_set_middle_paste`, the `"` register, one undo step.

use edit
use term
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

// `ck_fixture` (`test_mouse_click.c:37-56`).
fn fixture_bytes(t: List[byte]) -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    if t.len != 0 {
        let w = ed.win
        assert(edit.ed_edit_insert(mut ed, w, 0, t, 0, t.len), "the text")
        edit.ed_finish_edit(mut ed, w)
    }
    edit.ed_layout(mut ed)
    let w = ed.win
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].pos = 0
    ed.wins[w].cs.curs[p].anchor = 0
    ed.now_ms = 1000
    edit.pane_tables_reset(mut ed)
    let root = ed.pane_root
    let leaf = edit.pane_table_add_leaf(mut ed, root)
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.panes[root].rect, leaf)
    ed
}

fn fixture(t: str) -> edit.Ed {
    fixture_bytes(bytes_of(t))
}

// `ck_ev` (`:58-71`): the left button.
fn ev(kind: int, x: int, y: int, mods: int) -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_MOUSE
    k.button = term.MB_LEFT
    k.ev = kind
    k.col = x
    k.row = y
    k.mods = mods
    k
}

// `ck_click` (`:73-81`): one press and release, at the current clock.
fn click(mut ed: edit.Ed, x: int, y: int, mods: int) {
    edit.mouse_event(mut ed, ev(term.KEY_PRESS, x, y, mods))
    edit.mouse_event(mut ed, ev(term.KEY_RELEASE, x, y, mods))
}

// `ck_col` (`:83-96`): the screen column that shows text column `n` —
// the window's rect is the CONTENT origin, past the gutter.
fn col(ed: edit.Ed, n: int) -> int {
    ed.wins[ed.win].rect.x + n
}

fn row0(ed: edit.Ed) -> int {
    ed.panes[ed.pane_root].rect.y
}

// `ck_selection` (`:98-103`).
fn selection(ed: edit.Ed) -> text.Span {
    let w = ed.win
    let b = ed.wins[w].buf
    edit.sel_span(ed.bufs[b].ec.tb, ed.wins[w].h.kind, copy ed.wins[w].cs.curs[ed.wins[w].cs.primary])
}

fn cursor_pos(ed: edit.Ed) -> int {
    let w = ed.win
    ed.wins[w].cs.curs[ed.wins[w].cs.primary].pos
}

// The engine's own answer at `at`, over the window (C's `UnitCtx` with
// `tb`, `buf` and `win` set).
fn engine(mut ed: edit.Ed, unit: int, at: int, alt: bool) -> text.Span {
    let b = ed.wins[ed.win].buf
    let u = edit.UnitCtx { has_buf: true, tabwidth: ed.bufs[b].tabwidth, has_lang: false, has_win: true }
    edit.unit_span(unit, mut ed.bufs[b].ec.tb, u, at, alt)
}

// `test_mouse_click_window_is_399_yes_401_no` (`:111-133`).
fn t_click_window_is_399_yes_401_no() {
    var ed = fixture("alpha beta gamma\n")
    let x = col(ed, 2)
    let y = row0(ed)
    click(mut ed, x, y, 0)
    assert(ed.mouse.click_n == 1, "one")
    ed.now_ms += 399
    click(mut ed, x, y, 0)
    assert(ed.mouse.click_n == 2, "399 ms counts")
    ed.now_ms += 401
    click(mut ed, x, y, 0)
    assert(ed.mouse.click_n == 1, "401 ms does not")
}

// `test_mouse_click_counter_resets_on_a_different_cell` (`:137-159`).
fn t_click_counter_resets_on_a_different_cell() {
    var ed = fixture("alpha beta gamma\n")
    let x2 = col(ed, 2)
    let x3 = col(ed, 3)
    let y = row0(ed)
    click(mut ed, x2, y, 0)
    assert(ed.mouse.click_n == 1, "one")
    click(mut ed, x3, y, 0)
    assert(ed.mouse.click_n == 1, "a different cell")
    click(mut ed, x3, y, 0)
    assert(ed.mouse.click_n == 2, "two")
    click(mut ed, x2, y, 0)
    assert(ed.mouse.click_n == 1, "back: a new run")
}

// `test_mouse_click_quad_wraps_to_one` (`:161-177`).
fn t_click_quad_wraps_to_one() {
    var ed = fixture("alpha beta gamma\n")
    let x = col(ed, 2)
    let y = row0(ed)
    var i = 0
    while i < 8 {
        click(mut ed, x, y, 0)
        assert(ed.mouse.click_n == i % 3 + 1, "click {i}")
        i += 1
    }
}

// `test_mouse_click_focus_out_resets_the_counter` (`:179-197`).
fn t_click_focus_out_resets_the_counter() {
    var ed = fixture("alpha beta gamma\n")
    let x = col(ed, 2)
    let y = row0(ed)
    click(mut ed, x, y, 0)
    assert(ed.mouse.click_n == 1, "one")
    assert(!edit.mouse_gesture_active(ed), "released")
    edit.mouse_cancel(mut ed)
    click(mut ed, x, y, 0)
    assert(ed.mouse.click_n == 1, "focus-out reset the run")
}

// The corpus of `test_mouse_double_click_equals_the_word_engine`
// (`:207-225`), as bytes.
fn corpus() -> List[List[byte]] {
    var c = List[List[byte]]()
    (mut c).push(bytes_of("foo.bar()"))
    (mut c).push(bytes_of("a  b"))
    (mut c).push(bytes_of("\u{6F22}\u{5B57}\u{30C6}\u{30B9}\u{30C8}"))
    (mut c).push(bytes_of("\u{6F22}\u{5B57}"))
    (mut c).push(bytes_of("\u{30C6}\u{30B9}\u{30C8}"))
    (mut c).push(bytes_of("\u{C548}\u{B155}\u{D558}\u{C138}\u{C694}"))
    (mut c).push(bytes_of("\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}x"))
    (mut c).push(bytes_of("\u{1F1E6}\u{1F1FA}\u{1F1E6}\u{1F1FA}"))
    (mut c).push(bytes_of("don't"))
    (mut c).push(bytes_of("well-known"))
    (mut c).push(bytes_of("1,000.50"))
    (mut c).push(bytes_of("foo_bar baz"))
    var invalid = List[byte]()
    (mut invalid).push(255 as byte)
    (mut invalid).push('A' as int as byte)
    (mut c).push(invalid)
    (mut c).push(bytes_of("  leading"))
    c
}

// `test_mouse_double_click_equals_the_word_engine` (`:199-253`), DoD 6.
fn t_double_click_equals_the_word_engine() {
    let texts = corpus()
    assert(texts.len >= 12, "a corpus of twelve or more")
    var i = 0
    while i < texts.len {
        var ed = fixture_bytes(texts[i])
        var x = 0
        while x < 12 {
            ed.mouse.click_n = 0
            let y = row0(ed)
            click(mut ed, x, y, 0)
            let at = cursor_pos(ed)
            click(mut ed, x, y, 0)
            assert(ed.mouse.click_n == 2, "text {i} x {x}: a double click")
            let want = engine(mut ed, edit.UNIT_WORD, at, false)
            let got = selection(ed)
            assert(got.lo == want.lo && got.hi == want.hi, "text {i} x {x}: {got.lo}..{got.hi} against the engine's {want.lo}..{want.hi}")
            assert(ed.mode == edit.MODE_H, "text {i} x {x}: H mode")
            assert(ed.wins[ed.win].h.unit == edit.UNIT_WORD, "text {i} x {x}: the word engine borrowed")
            x += 1
        }
        i += 1
    }
}

// `test_mouse_triple_click_equals_the_line_engine` (`:255-280`).
fn t_triple_click_equals_the_line_engine() {
    var ed = fixture("alpha beta\nsecond line here\nthird\n")
    let y = row0(ed) + 1
    click(mut ed, 4, y, 0)
    let at = cursor_pos(ed)
    click(mut ed, 4, y, 0)
    click(mut ed, 4, y, 0)
    assert(ed.mouse.click_n == 3, "a triple click")
    let want = engine(mut ed, edit.UNIT_LINE, at, false)
    let got = selection(ed)
    assert(got.lo == want.lo && got.hi == want.hi, "the line engine's span")
    assert(ed.mode == edit.MODE_H, "H mode")
    assert(ed.wins[ed.win].h.unit == edit.UNIT_LINE, "the line engine borrowed")
}

// `test_mouse_alt_double_click_selects_the_whitespace_word` (`:282-315`).
fn t_alt_double_click_selects_the_whitespace_word() {
    var ed = fixture("foo.bar  baz\n")
    let y = row0(ed)
    let x = col(ed, 3)
    click(mut ed, x, y, 0)
    let at = cursor_pos(ed)
    let plain = engine(mut ed, edit.UNIT_WORD, at, false)
    let alt = engine(mut ed, edit.UNIT_WORD, at, true)
    // The fixture is chosen so the two answers DIFFER.
    assert(plain.hi != alt.hi, "the alt flag matters here")
    click(mut ed, x, y, term.MOD_ALT)
    assert(ed.mouse.click_n == 2, "a double click")
    let got = selection(ed)
    assert(got.lo == alt.lo && got.hi == alt.hi, "the whitespace word")
}

// `test_mouse_drag_after_a_double_click_extends_by_words` (`:330-385`).
fn t_drag_after_a_double_click_extends_by_words() {
    var ed = fixture("alpha beta gamma delta\n")
    let y = row0(ed)
    click(mut ed, col(ed, 1), y, 0)
    edit.mouse_event(mut ed, ev(term.KEY_PRESS, col(ed, 1), y, 0))
    assert(ed.mouse.click_n == 2, "a double click held")
    let first = engine(mut ed, edit.UNIT_WORD, 1, false)
    edit.mouse_event(mut ed, ev(term.KEY_REPEAT, col(ed, 13), y, 0))
    let third = engine(mut ed, edit.UNIT_WORD, 13, false)
    var got = selection(ed)
    assert(got.lo == first.lo, "anchored at the first word")
    assert(got.hi == third.hi, "the WHOLE third word")
    edit.mouse_event(mut ed, ev(term.KEY_REPEAT, col(ed, 0), y, 0))
    got = selection(ed)
    assert(got.hi == first.hi, "the anchor word stays wholly selected")
    assert(got.lo == engine(mut ed, edit.UNIT_WORD, 0, false).lo, "the head at the left boundary")
}

// `test_mouse_single_click_drag_is_character_wise` (`:387-410`).
fn t_single_click_drag_is_character_wise() {
    var ed = fixture("alpha beta gamma\n")
    let y = row0(ed)
    edit.mouse_event(mut ed, ev(term.KEY_PRESS, col(ed, 1), y, 0))
    edit.mouse_event(mut ed, ev(term.KEY_REPEAT, col(ed, 8), y, 0))
    let got = selection(ed)
    assert(got.lo == 1, "from the press")
    assert(got.hi == 8, "exactly where the pointer is")
}

// `test_mouse_middle_click_paste_is_off_by_default` (`:425-480`).
fn t_middle_click_paste_is_off_by_default() {
    var ed = fixture("alpha\n")
    assert(!edit.mouse_middle_paste(ed), "off by default")
    var v = text.regval_new()
    v.bytes = bytes_of("XYZ")
    v.kind = text.REG_CHARWISE
    text.reg_yank(mut ed.regs, 0, v)
    let b = ed.wins[ed.win].buf
    let before = text.textbuf_len(ed.bufs[b].ec.tb)
    var press = ev(term.KEY_PRESS, 2, row0(ed), 0)
    press.button = term.MB_MIDDLE
    edit.mouse_event(mut ed, press)
    assert(text.textbuf_len(ed.bufs[b].ec.tb) == before, "off: nothing pasted")
    edit.mouse_set_middle_paste(mut ed, true)
    edit.mouse_event(mut ed, press)
    let b2 = ed.wins[ed.win].buf
    assert(text.textbuf_len(ed.bufs[b2].ec.tb) == before + 3, "on: pasted at the click")
    let id = edit.cmd_lookup(ed.reg, "ed.edit.undo")
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    cx.count = 1
    let _ = edit.ed_cmd_invoke(mut ed, id, mut cx)
    assert(text.textbuf_len(ed.bufs[b2].ec.tb) == before, "one undo step takes it back")
    edit.mouse_set_middle_paste(mut ed, false)
}

fn want(chosen: int, n: int) -> bool {
    chosen < 0 || chosen == n
}

fn main() {
    let chosen = (env_get("YEW_MOUSE_CLICK_CASE") else "-1").to_int() else -1
    if want(chosen, 0) {
        t_click_window_is_399_yes_401_no()
        print("mouse_click_window_is_399_yes_401_no: PASS")
    }
    if want(chosen, 1) {
        t_click_counter_resets_on_a_different_cell()
        print("mouse_click_counter_resets_on_a_different_cell: PASS")
    }
    if want(chosen, 2) {
        t_click_quad_wraps_to_one()
        print("mouse_click_quad_wraps_to_one: PASS")
    }
    if want(chosen, 3) {
        t_click_focus_out_resets_the_counter()
        print("mouse_click_focus_out_resets_the_counter: PASS")
    }
    if want(chosen, 4) {
        t_double_click_equals_the_word_engine()
        print("mouse_double_click_equals_the_word_engine: PASS")
    }
    if want(chosen, 5) {
        t_triple_click_equals_the_line_engine()
        print("mouse_triple_click_equals_the_line_engine: PASS")
    }
    if want(chosen, 6) {
        t_alt_double_click_selects_the_whitespace_word()
        print("mouse_alt_double_click_selects_the_whitespace_word: PASS")
    }
    if want(chosen, 7) {
        t_drag_after_a_double_click_extends_by_words()
        print("mouse_drag_after_a_double_click_extends_by_words: PASS")
    }
    if want(chosen, 8) {
        t_single_click_drag_is_character_wise()
        print("mouse_single_click_drag_is_character_wise: PASS")
    }
    if want(chosen, 9) {
        t_middle_click_paste_is_off_by_default()
        print("mouse_middle_click_paste_is_off_by_default: PASS")
    }
    print("mouse_click_test: done")
}
