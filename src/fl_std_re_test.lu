//! member: false
//! The port of sagitta 9ace98c2 tests/unit/test_fl_std_re.c (369 lines),
//! one function per C test under the registry's names and in its order
//! (tools/fl-cases.txt), over the flfix fixture. The golden replay reads
//! tests/fixtures/search/re_golden.txt, sagitta's re_golden.h row for row
//! (the table src/search_re_match_test.lu:11-13 promised this module).

use flfix
use std.fs

fn nibble(c: byte) -> int {
    let x = c as int
    if x <= 57 then x - 48 else if x <= 70 then x - 55 else x - 87
}

fn hb(h: str) -> List[byte] {
    var out = List[byte]()
    if h == "-" { return out }
    var i = 0
    while i + 1 < h.len {
        (mut out).push((nibble(h.bytes()[i]) * 16 + nibble(h.bytes()[i + 1])) as byte)
        i += 2
    }
    out
}

// test_fl_std_re.c:35-36: the imports every case's program starts with.
fn p() -> str { "import re\n" }

fn pf() -> str { "import re\nimport fmt\n" }

// test_fl_std_re.c:278-288: every byte as \xNN, so a pattern's own
// backslashes and quotes reach the engine unmangled by the Fletch lexer,
// stopping where C's 2,048-byte buffer would (no golden row comes near).
fn re_escape(b: List[byte]) -> str {
    let digits = "0123456789abcdef"
    var out = List[byte]()
    for x in b {
        if out.len + 5 >= 2048 { break }
        (mut out).push(92 as byte)
        (mut out).push(120 as byte)
        (mut out).push(digits.bytes()[x as int / 16])
        (mut out).push(digits.bytes()[x as int % 16])
    }
    str_from_utf8(out) else ""
}

// test_fl_std_re.c:354-369.
fn fl_re_terminates_on_a_large_subject() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        "import re\nimport str\nlet s = str.repeat(\"ab\", 524288)\n" +
            "return str.len_bytes(re.replace(s, \"x*\", \"\"))\n",
        "1048576",
    )
    flfix.eq(
        mut f,
        "import re\nimport str\nlet s = str.repeat(\"ab\", 524288)\n" +
            "return str.len_bytes(re.replace(s, \"b\", \"\"))\n",
        "524288",
    )
    flfix.close(mut f)
}

// test_fl_std_re.c:300-343: s20's golden table through re.find, with
// identical spans.
fn fl_re_replays_the_s20_golden_table() {
    let text = fs.read_text("tests/fixtures/search/re_golden.txt") else ""
    assert(text.len > 0, "re_golden.txt is readable from the repository root")
    var f = flfix.open()
    var replayed = 0
    for line in text.lines() {
        if line.starts_with("#") || line.trim().len == 0 { continue }
        let r = line.words()
        assert(r.len == 10, "a golden row has ten fields")
        let bits = r[2].to_int() else 0
        var flags = ""
        if bits & 1 != 0 { flags += "i" }
        if bits & 2 != 0 { flags += "s" }
        if bits & 4 != 0 { flags += "l" }
        let pat = re_escape(hb(r[0]))
        let inp = re_escape(hb(r[1]))
        let src = "import re\nimport fmt\nlet m = re.find(\"{inp}\", \"{pat}\", \"{flags}\")\n" +
            "if m == nil {{ return \"none\" }}\nreturn fmt.f(\"{{}}..{{}}\", m.lo, m.hi)\n"
        let want = if r[3] == "1" then "{r[4]}..{r[5]}" else "none"
        flfix.eq(mut f, src, want)
        replayed += 1
    }
    assert(replayed >= 130, "the golden table has {replayed} rows")
    flfix.close(mut f)
}

// test_fl_std_re.c:38-53.
fn fl_re_test_answers_yes_or_no() {
    var f = flfix.open()
    flfix.eq(mut f, p() + "return re.test(\"abc\", \"b\")\n", "true")
    flfix.eq(mut f, p() + "return re.test(\"abc\", \"z\")\n", "false")
    flfix.eq(mut f, p() + "return re.test(\"ABC\", \"b\", \"i\")\n", "true")
    flfix.eq(mut f, p() + "return re.test(\"a\\nb\", \"a.b\", \"s\")\n", "true")
    flfix.eq(mut f, p() + "return re.test(\"a\\nb\", \"a.b\")\n", "false")
    flfix.eq(mut f, p() + "return re.test(\"a.c\", \"a.c\", \"l\")\n", "true")
    flfix.eq(mut f, p() + "return re.test(\"abc\", \"a.c\", \"l\")\n", "false")
    flfix.close(mut f)
}

// test_fl_std_re.c:55-72.
fn fl_re_a_bad_pattern_or_flag_raises_type() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        p() + "return re.test(\"a\", \"(\")\n",
        "!type: regex: unterminated group at pattern offset 0",
    )
    flfix.eq(
        mut f,
        p() + "return re.test(\"a\", \"a\", \"q\")\n",
        "!type: re: unknown flag 'q'; the flags are i, s and l",
    )
    flfix.close(mut f)
}

// test_fl_std_re.c:74-91.
fn fl_re_find_returns_a_match_map() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        pf() + "return fmt.repr(re.find(\"hello\", \"l+\"))\n",
        "{{lo: 2, hi: 4, text: \"ll\", groups: [{{lo: 2, hi: 4, text: \"ll\"}}]}}",
    )
    flfix.eq(mut f, p() + "return re.find(\"hello\", \"z\")\n", "nil")
    flfix.eq(
        mut f,
        pf() + "return fmt.repr(re.find(\"hello\", \"l\", nil, 3))\n",
        "{{lo: 3, hi: 4, text: \"l\", groups: [{{lo: 3, hi: 4, text: \"l\"}}]}}",
    )
    flfix.eq(
        mut f,
        p() + "return re.find(\"ab\", \"a\", nil, 9)\n",
        "!index: re.find: byte 9 is outside a subject of 2 bytes",
    )
    flfix.close(mut f)
}

// test_fl_std_re.c:93-110.
fn fl_re_groups_are_numbered_like_the_template() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        pf() + "return fmt.repr(re.find(\"a1\", \"([a-z])([0-9])\").groups)\n",
        "[{{lo: 0, hi: 2, text: \"a1\"}}, {{lo: 0, hi: 1, text: \"a\"}}, " +
            "{{lo: 1, hi: 2, text: \"1\"}}]",
    )
    flfix.eq(mut f, pf() + "return fmt.repr(re.find(\"xb\", \"x(q)?(b)\").groups[1])\n", "nil")
    flfix.eq(
        mut f,
        pf() + "return fmt.repr(re.find(\"xb\", \"x(q)?(b)\").groups[2])\n",
        "{{lo: 1, hi: 2, text: \"b\"}}",
    )
    flfix.close(mut f)
}

// test_fl_std_re.c:112-135.
fn fl_re_find_all_scans_without_looping() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        pf() +
            "import list\nreturn fmt.repr(list.map(re.find_all(\"a1b22c\", \"[0-9]+\"), " +
            "fn(m) {{ return m.text }}))\n",
        "[\"1\", \"22\"]",
    )
    flfix.eq(mut f, p() + "import list\nreturn list.len(re.find_all(\"abc\", \"x*\"))\n", "4")
    flfix.eq(
        mut f,
        p() + "import list\nreturn list.len(re.find_all(\"\\u{{6F22}}\\u{{5B57}}\", \"x*\"))\n",
        "3",
    )
    flfix.eq(
        mut f,
        p() + "import list\nreturn list.len(re.find_all(\"aaaa\", \"a\", nil, 2))\n",
        "2",
    )
    flfix.close(mut f)
}

// test_fl_std_re.c:137-156.
fn fl_re_replace_expands_the_template() {
    var f = flfix.open()
    flfix.eq(mut f, p() + "return re.replace(\"a1b\", \"[0-9]\", \"#\")\n", "a#b")
    flfix.eq(mut f, p() + "return re.replace(\"a1b\", \"([a-z])([0-9])\", \"$2$1\")\n", "1ab")
    flfix.eq(mut f, p() + "return re.replace(\"a1b\", \"([a-z])([0-9])\", \"${{2}}x\")\n", "1xb")
    flfix.eq(mut f, p() + "return re.replace(\"ab\", \"b\", \"$$\")\n", "a$")
    flfix.eq(mut f, p() + "return re.replace(\"ab\", \"a(q)?\", \"[$1]\")\n", "[]b")
    flfix.eq(mut f, p() + "return re.replace(\"abc\", \"x*\", \"-\")\n", "-a-b-c-")
    flfix.eq(mut f, p() + "return re.replace(\"aaa\", \"a\", \"b\", nil, 2)\n", "bba")
    flfix.close(mut f)
}

// test_fl_std_re.c:158-179.
fn fl_re_replace_refuses_a_bad_template() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        p() + "return re.replace(\"ab\", \"a\", \"$\")\n",
        "!type: re: the template ends in '$' at byte 0",
    )
    flfix.eq(
        mut f,
        p() + "return re.replace(\"ab\", \"a\", \"$z\")\n",
        "!type: re: '$' is followed by 'z' at byte 0; write '$$' for a literal dollar",
    )
    flfix.eq(
        mut f,
        p() + "return re.replace(\"ab\", \"a\", \"${{x}}\")\n",
        "!type: re: expected ${{N}} at byte 0",
    )
    flfix.eq(
        mut f,
        p() + "return re.replace(\"ab\", \"a\", \"$3\")\n",
        "!index: re: the template names group 3, the pattern has 1",
    )
    flfix.close(mut f)
}

// test_fl_std_re.c:181-196.
fn fl_re_replace_fn_calls_back_into_fletch() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        p() +
            "return re.replace_fn(\"a1b\", \"[0-9]\", fn(m) {{ return \"<\" + m.text + \">\" }})\n",
        "a<1>b",
    )
    flfix.eq(
        mut f,
        p() +
            "return re.replace_fn(\"a1b\", \"[0-9]\", " +
            "fn(m) {{ if re.test(m.text, \"[0-9]\") {{ return \"N\" }} return \"?\" }})\n",
        "aNb",
    )
    flfix.eq(
        mut f,
        p() + "return re.replace_fn(\"a\", \"a\", fn(m) {{ return 1 }})\n",
        "!type: re.replace_fn: the function must return str, found int",
    )
    flfix.close(mut f)
}

// test_fl_std_re.c:198-217.
fn fl_re_split_drops_the_separators() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        pf() + "return fmt.repr(re.split(\"a,b,,c\", \",\"))\n",
        "[\"a\", \"b\", \"\", \"c\"]",
    )
    flfix.eq(
        mut f,
        pf() + "return fmt.repr(re.split(\"a1b22c\", \"[0-9]+\"))\n",
        "[\"a\", \"b\", \"c\"]",
    )
    flfix.eq(
        mut f,
        pf() + "return fmt.repr(re.split(\"abc\", \"x*\"))\n",
        "[\"a\", \"b\", \"c\", \"\"]",
    )
    flfix.eq(
        mut f,
        pf() + "return fmt.repr(re.split(\"a,b,c\", \",\", nil, 1))\n",
        "[\"a\", \"b,c\"]",
    )
    flfix.eq(mut f, pf() + "return fmt.repr(re.split(\"a1b\", \"([0-9])\"))\n", "[\"a\", \"b\"]")
    flfix.close(mut f)
}

// test_fl_std_re.c:219-230.
fn fl_re_escape_round_trips_through_test() {
    var f = flfix.open()
    flfix.eq(mut f, p() + "return re.escape(\"a.b*c\")\n", "a\\.b\\*c")
    flfix.eq(mut f, p() + "return re.test(\"a.b*c\", re.escape(\"a.b*c\"))\n", "true")
    flfix.eq(mut f, p() + "return re.test(\"axbyc\", re.escape(\"a.b*c\"))\n", "false")
    flfix.close(mut f)
}

// test_fl_std_re.c:232-247.
fn fl_re_accepts_quoted_text_to_semantic_limit() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        p() + "import str\nlet s = str.repeat(\"\\n\", 16385)\nreturn re.test(s, re.escape(s))\n",
        "true",
    )
    flfix.eq(
        mut f,
        p() + "import str\nlet s = str.repeat(\"\\n\", 65536)\nreturn re.test(s, re.escape(s))\n",
        "true",
    )
    flfix.close(mut f)
}

// test_fl_std_re.c:249-274.
fn fl_re_the_compile_cache_survives_a_full_cycle() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        p() +
            "import str\nlet ok = true\nlet i = 0\nwhile i < 200 {{\n" +
            "  let p = \"x\" + str.repeat(\"y\", i % 40) + \"z\"\n" +
            "  if re.test(p, p, \"l\") == false {{ ok = false }}\n" +
            "  if re.test(\"no\", p) == true {{ ok = false }}\n" +
            "  i = i + 1\n}}\nreturn ok\n",
        "true",
    )
    flfix.eq_bytes(mut f, p() + "return re.replace(\"a\\x80b\", \"a\", \"A\")\n", hb("418062"))
    flfix.close(mut f)
}

fn main() {
    fl_re_terminates_on_a_large_subject()
    fl_re_replays_the_s20_golden_table()
    fl_re_test_answers_yes_or_no()
    fl_re_a_bad_pattern_or_flag_raises_type()
    fl_re_find_returns_a_match_map()
    fl_re_groups_are_numbered_like_the_template()
    fl_re_find_all_scans_without_looping()
    fl_re_replace_expands_the_template()
    fl_re_replace_refuses_a_bad_template()
    fl_re_replace_fn_calls_back_into_fletch()
    fl_re_split_drops_the_separators()
    fl_re_escape_round_trips_through_test()
    fl_re_accepts_quoted_text_to_semantic_limit()
    fl_re_the_compile_cache_survives_a_full_cycle()
    print("PASS fl_std_re: 14 cases")
}
