//! member: false
//! Port-only regression for restoring util.sort_stable after G20.
//! sagitta src/ws/state_parse.c:153-249: identity order, last record wins.

use ws

fn row(kind: int, owner: int, entity: int, node: int) -> ws.StateRecord {
    ws.StateRecord { kind: kind, owner: owner, entity: entity, node: node }
}

fn main() {
    var records = List[ws.StateRecord]()
    (mut records).push(row(2, 0, 0, 50))
    (mut records).push(row(1, 2, 1, 40))
    (mut records).push(row(1, 1, 2, 20))
    (mut records).push(row(1, 1, 1, 10))
    (mut records).push(row(1, 1, 2, 30))
    ws.state_records_sort(mut records)
    assert(records.len == 5)
    for i in 0..5 {
        assert(records[i].node == (i + 1) * 10, "identity order and stable ties")
    }
    ws.state_records_sort(mut records)
    for i in 0..5 {
        assert(records[i].node == (i + 1) * 10, "sorting is idempotent")
    }
    print("ws_state_sort: kind/owner/entity order, stable ties, idempotence: PASS")
}
