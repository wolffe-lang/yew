//! member: false
//! sagitta 9ace98c2 vm.c:1187-1205: FIELD_GET receiver dispatch order.
//! Host-seeded synthetic handle only; no editor handle is created by Fletch.

use fl

fn run(mut vm: fl.FlVm, src: str) -> fl.FlValue {
    var bytes = List[byte]()
    for b in src.bytes() { (mut bytes).push(b) }
    let p = fl.fl_parse(bytes, 0, mut vm.dc, mut vm.strings)
    let f = fl.fl_compile(mut vm, p, 0, fl.fl_origin_new(4, 0)) else fl.fl_nil()
    assert(f.t == 7)
    fl.fl_vm_run(mut vm, f)
}

fn main() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    fl.fl_std_register(mut vm)
    let name = fl.fl_intern(mut vm.strings, "b".bytes(), 0, 1)
    let globals = copy vm.globals
    let recv = fl.FlValue { t: 12, i: 0, f: 0.0 }
    assert(fl.fl_map_set(mut vm, globals, fl.fl_int(name), recv))
    let bound = run(mut vm, "return b.len\n")
    assert(!vm.raised && bound.t == 9)
    let at = fl.fl_obj_index(vm, bound)
    assert(vm.gc.slots[at].has_recv == 1 && vm.gc.slots[at].recv.t == 12)
    assert(vm.gc.slots[at].min_ar == 0 && vm.gc.slots[at].max_ar == 0)
    let error = run(mut vm, "return b.len()\n")
    assert(vm.raised)
    let kind_key = fl.fl_str_text(mut vm, "kind")
    let kind = fl.fl_map_get(vm, error, kind_key) else fl.fl_nil()
    assert(kind.t == 4)
    assert((str_from_utf8(vm.gc.slots[fl.fl_obj_index(vm, kind)].bytes) else "") == "handle")
    let map = fl.fl_map_new(mut vm)
    let key = fl.fl_str_text(mut vm, "len")
    assert(fl.fl_map_set(mut vm, map, key, fl.fl_int(42)))
    let current_globals = copy vm.globals
    assert(fl.fl_map_set(mut vm, current_globals, fl.fl_int(name), map))
    let value = run(mut vm, "return b.len\n")
    assert(!vm.raised && value.t == 2 && value.i == 42)
    print("fl_receiver_field_order: PASS")
}
