//! member: false
//! The three tests/unit/test_record_nested_replay.c cases at sagitta
//! 9ace98c2, in registry order (Sprint 35: a macro replaying a macro, and
//! `ed.macro.replay_last` recorded as the register it resolves to). C's
//! `yew_ed_invoke` is `edit.ed_cmd_invoke`; `yew_undo` on the editor's
//! context is the window's context taken, `text.undo`, and given back.

use edit
use text

fn open() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed
}

fn set_macro(mut ed: edit.Ed, r: int, source: str) {
    assert(edit.flapi_reg_write(mut ed, r, source.bytes(), false) == edit.CMD_OK)
}

// nrf_run (test_record_nested_replay.c:32-46).
fn run(mut ed: edit.Ed, name: str, source: int) -> int {
    let id = edit.cmd_lookup(ed.reg, name)
    assert(id != 0)
    var cx = edit.cmdctx_new(ed.win, source)
    edit.ed_cmd_invoke(mut ed, id, mut cx)
}

fn is_buffer(ed: edit.Ed, want: str) -> bool {
    let got = text.textbuf_bytes(ed.bufs[0].ec.tb)
    let w = want.bytes()
    if got.len != w.len { return false }
    for i in 0..w.len { if got[i] != w[i] { return false } }
    true
}

fn undo(mut ed: edit.Ed) -> bool {
    let w = ed.win
    let b = ed.wins[w].buf
    edit.edit_take(mut ed, w)
    let done = text.undo(mut ed.bufs[b].ec)
    edit.edit_give(mut ed, w)
    done
}

fn contains(hay: List[byte], needle: str) -> bool {
    let n = needle.bytes()
    if n.len > hay.len { return false }
    for i in 0..hay.len - n.len + 1 {
        var ok = true
        for j in 0..n.len { if hay[i + j] != n[j] { ok = false; break } }
        if ok { return true }
    }
    false
}

fn macro_nested_replay_commits_as_outer_undo_step() {
    var ed = open()
    set_macro(mut ed, 'b' as int, "@[ i\"B\" ]\n")
    set_macro(
        mut ed,
        'a' as int,
        "import ed\n@[ i\"A\" ]\ned.run(\"ed.macro.replay\", {{ sarg: \"b\" }})\n@[ i\"C\" ]\n",
    )
    assert(edit.macro_replay(mut ed, 'a' as int, 1) == edit.CMD_OK)
    assert(is_buffer(ed, "ABC"))
    assert(undo(mut ed))
    assert(is_buffer(ed, ""))
    assert(!undo(mut ed))
}

fn macro_nested_replay_outer_error_rolls_back_every_edit() {
    var ed = open()
    set_macro(mut ed, 'b' as int, "@[ i\"B\" ]\n")
    set_macro(
        mut ed,
        'a' as int,
        "import ed\n@[ i\"A\" ]\ned.run(\"ed.macro.replay\", {{ sarg: \"b\" }})\n@[ i\"C\" ]\nmissing_function()\n",
    )
    assert(edit.macro_replay(mut ed, 'a' as int, 1) == edit.CMD_ERR_STATE)
    assert(is_buffer(ed, ""))
}

fn record_replay_last_captures_resolved_register() {
    var ed = open()
    set_macro(mut ed, 'a' as int, "@[ i\"x\" ]\n")
    assert(edit.macro_replay(mut ed, 'a' as int, 1) == edit.CMD_OK)
    assert(undo(mut ed))
    assert(is_buffer(ed, ""))
    assert(edit.record_start(mut ed, 'b' as int))
    assert(run(mut ed, "ed.macro.replay_last", edit.SRC_KEY) == edit.CMD_OK)
    assert(edit.record_stop(mut ed) == edit.CMD_OK)
    let v = text.reg_get(mut ed.regs, 'b' as int) else {
        assert(false)
        return
    }
    assert(contains(v.bytes, "ed.macro.replay"))
    assert(contains(v.bytes, "sarg: \"a\""))
    assert(!contains(v.bytes, "replay_last"))
    assert(undo(mut ed))
    assert(is_buffer(ed, ""))
    assert(ed.rec.last_reg == 'b' as int)
    assert(edit.macro_replay(mut ed, 'b' as int, 1) == edit.CMD_OK)
    assert(is_buffer(ed, "x"))
}

fn main() {
    macro_nested_replay_commits_as_outer_undo_step()
    macro_nested_replay_outer_error_rolls_back_every_edit()
    record_replay_last_captures_resolved_register()
    print("record_nested_replay: 3 cases pass")
}
