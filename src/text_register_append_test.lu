//! member: false
//!
//! The port of sagitta `tests/unit/test_register_append.c` (136 lines),
//! one test per C test in registry order (`tests/unit/registry.c:219-
//! 225`). The log capture is a `YEW_LOG` scratch file, its WARN lines
//! read back.

use std.fs
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn value(kind: int, s: str) -> text.RegVal {
    var v = text.regval_new()
    v.kind = kind
    v.bytes = bytes_of(s)
    v
}

fn block(s: str, width: int, ragged: bool) -> text.RegVal {
    var v = value(text.REG_BLOCKWISE, s)
    v.width = width
    v.ragged = ragged
    (mut v.rows).push(text.span(0, s.len))
    v
}

fn assert_value(v: text.RegVal, kind: int, want: str) {
    assert(v.kind == kind, "kind {v.kind}, want {kind}")
    assert(same(v.bytes, bytes_of(want)), "bytes are {want}")
}

fn warned(path: str, needle: str) -> bool {
    let text = fs.read_text(path) else ""
    for line in text.lines() {
        if line.contains(" warn: ") && line.contains(needle) {
            return true
        }
    }
    false
}

fn register_append_char_char() {
    var r = text.reg_new()
    text.reg_set_macro(mut r, 'a' as int, value(text.REG_CHARWISE, "left"), false)
    text.reg_append(mut r, 'A' as int, value(text.REG_CHARWISE, "right"))
    assert_value(r.named[0], text.REG_CHARWISE, "leftright")
}

fn register_append_char_line_uses_line_eol() {
    var r = text.reg_new()
    text.reg_set_macro(mut r, 'a' as int, value(text.REG_CHARWISE, "left"), false)
    text.reg_append(mut r, 'A' as int, value(text.REG_LINEWISE, "right\r\n"))
    assert_value(r.named[0], text.REG_LINEWISE, "left\r\nright\r\n")
}

fn register_append_line_char_preserves_destination_eol() {
    var r = text.reg_new()
    text.reg_set_macro(mut r, 'a' as int, value(text.REG_LINEWISE, "left\r\n"), false)
    text.reg_append(mut r, 'A' as int, value(text.REG_CHARWISE, "right"))
    assert_value(r.named[0], text.REG_LINEWISE, "left\r\nright\r\n")
}

fn register_append_line_line_is_byte_exact() {
    var r = text.reg_new()
    text.reg_set_macro(mut r, 'a' as int, value(text.REG_LINEWISE, "left\n"), false)
    text.reg_append(mut r, 'A' as int, value(text.REG_LINEWISE, "right\r\n"))
    assert_value(r.named[0], text.REG_LINEWISE, "left\nright\r\n")
}

fn register_append_refuses_mixed_block_without_mutation(log_path: str) {
    var r = text.reg_new()
    text.reg_set_macro(mut r, 'a' as int, value(text.REG_CHARWISE, "keep"), false)
    fs.remove(log_path) else |_| {}
    text.reg_append(mut r, 'A' as int, block("xx", 2, false))
    assert_value(r.named[0], text.REG_CHARWISE, "keep")
    assert(warned(log_path, "refused"), "the refusal is logged")
}

fn register_append_block_block_concatenates_and_repads() {
    var r = text.reg_new()
    text.reg_append(mut r, 'A' as int, block("a", 1, false))
    text.reg_append(mut r, 'A' as int, block("bbb", 3, false))
    assert(r.named[0].kind == text.REG_BLOCKWISE, "blockwise")
    assert(r.named[0].width == 3, "width 3")
    assert(r.named[0].rows.len == 2, "two rows")
    assert(r.named[0].rows[0].hi - r.named[0].rows[0].lo == 3, "row 0 repadded to 3")
    assert(same(r.named[0].bytes[0..6], bytes_of("a  bbb")), "a  bbb")
}

fn register_append_ragged_rows_never_pad_nonragged_rows_do() {
    var r = text.reg_new()
    text.reg_append(mut r, 'A' as int, block("a", 1, false))
    text.reg_append(mut r, 'A' as int, block("bbb", 3, true))
    assert(r.named[0].ragged, "ragged")
    assert(r.named[0].bytes.len == 6, "6 bytes")
    assert(same(r.named[0].bytes, bytes_of("a  bbb")), "a  bbb")
}

fn main() {
    let log_path = "target/tests/text-register-append-test.log"
    fs.create_dir_all("target/tests") else |_| {}
    env_set("YEW_LOG", log_path) else |_| {}
    env_set("YEW_LOG_LEVEL", "debug") else |_| {}
    register_append_char_char()
    register_append_char_line_uses_line_eol()
    register_append_line_char_preserves_destination_eol()
    register_append_line_line_is_byte_exact()
    register_append_refuses_mixed_block_without_mutation(log_path)
    register_append_block_block_concatenates_and_repads()
    register_append_ragged_rows_never_pad_nonragged_rows_do()
    fs.remove(log_path) else |_| {}
    print("register_append_test: 7 cases pass")
}
