//! member: false
//! The port of sagitta 9ace98c2 tests/unit/test_fl_std_list.c (167 lines),
//! one function per C test under the registry's names and in its order
//! (tools/fl-cases.txt), over the flfix fixture.

use flfix

// test_fl_std_list.c:30: the two imports every case's program starts with.
fn p() -> str { "import list\nimport fmt\n" }

// test_fl_std_list.c:32-55.
fn fl_list_grows_and_shrinks() {
    var f = flfix.open()
    flfix.eq(mut f, p() + "return list.len([])\n", "0")
    flfix.eq(
        mut f,
        p() + "let l = []\nlist.push(l, 1)\nlist.push(l, 2)\nreturn fmt.repr(l)\n",
        "[1, 2]",
    )
    flfix.eq(mut f, p() + "let l = [1, 2]\nreturn list.pop(l)\n", "2")
    flfix.eq(mut f, p() + "return list.pop([])\n", "!index: list.pop: the list is empty")
    flfix.eq(mut f, p() + "let l = [1, 3]\nlist.insert(l, 1, 2)\nreturn fmt.repr(l)\n", "[1, 2, 3]")
    flfix.eq(mut f, p() + "let l = [1]\nlist.insert(l, 1, 2)\nreturn fmt.repr(l)\n", "[1, 2]")
    flfix.eq(
        mut f,
        p() + "return list.insert([1], 5, 2)\n",
        "!index: index 5 out of range for length 1",
    )
    flfix.eq(mut f, p() + "let l = [1, 2, 3]\nreturn list.remove(l, 1)\n", "2")
    flfix.eq(
        mut f,
        p() + "return list.remove([1], 9)\n",
        "!index: index 9 out of range for length 1",
    )
    flfix.eq(mut f, p() + "let l = [1, 2]\nlist.clear(l)\nreturn list.len(l)\n", "0")
    flfix.close(mut f)
}

// test_fl_std_list.c:57-89.
fn fl_list_reads_without_mutating() {
    var f = flfix.open()
    flfix.eq(mut f, p() + "return list.get([1, 2], 1)\n", "2")
    flfix.eq(mut f, p() + "return list.get([1], 9, \"d\")\n", "d")
    flfix.eq(mut f, p() + "return list.get([1], 9)\n", "!index: index 9 out of range for length 1")
    flfix.eq(mut f, p() + "return list.index_of([1, 2, 1], 1)\n", "0")
    flfix.eq(mut f, p() + "return list.index_of([1], 9)\n", "-1")
    flfix.eq(mut f, p() + "return list.contains([1, 2], 2)\n", "true")
    flfix.eq(mut f, p() + "return list.contains([1, 2], 9)\n", "false")
    flfix.eq(mut f, p() + "return list.contains([1, 2], 2.0)\n", "true")
    flfix.eq(mut f, p() + "return fmt.repr(list.slice([1, 2, 3, 4], 1, 3))\n", "[2, 3]")
    flfix.eq(mut f, p() + "return fmt.repr(list.slice([1, 2, 3], 1))\n", "[2, 3]")
    flfix.eq(mut f, p() + "return fmt.repr(list.slice([1, 2], 2))\n", "[]")
    flfix.eq(
        mut f,
        p() + "return list.slice([1, 2], 0, 99)\n",
        "!index: index 99 out of range for length 2",
    )
    flfix.eq(mut f, p() + "return fmt.repr(list.concat([1], [2, 3]))\n", "[1, 2, 3]")
    flfix.eq(mut f, p() + "let l = [1, 2, 3]\nlist.reverse(l)\nreturn fmt.repr(l)\n", "[3, 2, 1]")
    flfix.eq(
        mut f,
        p() + "let a = [1]\nlet b = list.copy(a)\nlist.push(b, 2)\nreturn list.len(a)\n",
        "1",
    )
    flfix.close(mut f)
}

// test_fl_std_list.c:91-123.
fn fl_list_sorts_stably_over_a_total_order() {
    var f = flfix.open()
    flfix.eq(mut f, p() + "let l = [3, 1, 2]\nlist.sort(l)\nreturn fmt.repr(l)\n", "[1, 2, 3]")
    flfix.eq(
        mut f,
        p() + "let l = [\"b\", \"a\"]\nlist.sort(l)\nreturn fmt.repr(l)\n",
        "[\"a\", \"b\"]",
    )
    flfix.eq(
        mut f,
        p() + "let l = [\"s\", 1, nil, true]\nlist.sort(l)\nreturn fmt.repr(l)\n",
        "[nil, true, 1, \"s\"]",
    )
    flfix.eq(
        mut f,
        p() + "let l = [1, 2, 3]\nlist.sort(l, fn(a, b) {{ return b - a }})\nreturn fmt.repr(l)\n",
        "[3, 2, 1]",
    )
    flfix.eq(
        mut f,
        p() +
            "let l = [[1, \"a\"], [0, \"b\"], [1, \"c\"], [0, \"d\"]]\n" +
            "list.sort(l, fn(x, y) {{ return x[0] - y[0] }})\nreturn fmt.repr(l)\n",
        "[[0, \"b\"], [0, \"d\"], [1, \"a\"], [1, \"c\"]]",
    )
    flfix.close(mut f)
}

// test_fl_std_list.c:125-149.
fn fl_list_walks_with_a_function() {
    var f = flfix.open()
    flfix.eq(mut f, p() + "return fmt.repr(list.map([1, 2], fn(x) {{ return x * 2 }}))\n", "[2, 4]")
    flfix.eq(
        mut f,
        p() + "return fmt.repr(list.filter([1, 2, 3], fn(x) {{ return x > 1 }}))\n",
        "[2, 3]",
    )
    flfix.eq(mut f, p() + "return list.reduce([1, 2, 3], fn(a, x) {{ return a + x }}, 0)\n", "6")
    flfix.eq(mut f, p() + "return list.any([1, 2], fn(x) {{ return x > 1 }})\n", "true")
    flfix.eq(mut f, p() + "return list.any([1, 2], fn(x) {{ return x > 9 }})\n", "false")
    flfix.eq(mut f, p() + "return list.all([1, 2], fn(x) {{ return x > 0 }})\n", "true")
    flfix.eq(mut f, p() + "return list.all([1, 2], fn(x) {{ return x > 1 }})\n", "false")
    flfix.eq(mut f, p() + "return list.all([], fn(x) {{ return false }})\n", "true")
    flfix.eq(mut f, p() + "return list.any([], fn(x) {{ return true }})\n", "false")
    flfix.eq(
        mut f,
        p() + "return list.map([1], fn(x) {{ return x + \"a\" }})\n",
        "!type: cannot add int and str",
    )
    flfix.close(mut f)
}

// test_fl_std_list.c:151-167.
fn fl_list_refuses_a_reshape_mid_walk() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        p() + "let l = [1, 2, 3]\nfor x in l {{ list.push(l, x) }}\nreturn 1\n",
        "!index: list modified during iteration",
    )
    flfix.eq(mut f, p() + "let l = [1, 2, 3]\nfor x in l {{ l[0] = 9 }}\nreturn l[0]\n", "9")
    flfix.close(mut f)
}

fn main() {
    fl_list_grows_and_shrinks()
    fl_list_reads_without_mutating()
    fl_list_sorts_stably_over_a_total_order()
    fl_list_walks_with_a_function()
    fl_list_refuses_a_reshape_mid_walk()
    print("PASS fl_std_list: 5 cases")
}
