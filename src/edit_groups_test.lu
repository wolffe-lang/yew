    groups_prune_empty_removes_only_empty_groups()
    groups_active_group_id_is_derived()
    groups_set_ordinal_moves_right_by_exactly_one()
    groups_set_ordinal_moves_left_and_clamps()
    groups_reorder_block_stays_contiguous_past_other_tabs()
