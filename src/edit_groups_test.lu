//! member: false
//!
//! The port of sagitta `tests/unit/test_groups.c` (1,208 lines), one test
//! per C test in registry order (`tests/unit/registry.c:1742-1764`): the
//! group model (Sprint 24 §1/§2), the 5,000-op membership storm against an
//! INDEPENDENT oracle that keeps the member lists the model refuses to
//! keep, and §3's lazy hydration — DoD 4's one read for a 40-file group,
//! counted through `text.file_load_count` (ruling R-yw05-4 = A). C's
//! fixture is `yew_ed_init` + `yew_ed_open_scratch` + an 80x24 layout
//! (`gp_fixture`, `test_groups.c:31-38`); the port's is `edit.ed_new` +
//! `edit.ed_open_scratch` + `edit.layout_compute`. C's `mkdtemp` is a
//! fresh `/tmp/yew-grp-NNNNNN` made exclusively (`fresh_dir`).
//!
//! **SKIP by name.** `groups_audit_storm_100k_survives_restore_and_walk_
//! dissolve` runs its 100,000 operations over real files — create, join,
//! leave, close, reopen, reorder within, reorder the block, and dissolve
//! during a copied member walk, the oracle checked after every one — but
//! its every-1,000th-op RESTORE (`audit_restore_midsequence`: the session
//! written through `state.fl` and read into a fresh editor,
//! `yew_state_emit`/`yew_state_apply`) is the workspace state's, sagitta
//! Sprint 25 (yw06): that half says SKIP, once, on both streams.

use edit
use text

fn say_skip(what: str) {
    print("groups_test: SKIP {what}")
    eprint("groups_test: SKIP {what}")
}

// `gp_fixture` (`test_groups.c:31-38`).
fn fixture() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    ed
}

// `gp_open_many` (`test_groups.c:40-52`): `n` extra tabs, 1 + n in all.
fn open_many(mut ed: edit.Ed, n: int) {
    var i = 0
    while i < n {
        assert(edit.tab_open(mut ed, "/tmp/yew-grp-{i}.txt") >= 0, "open tab {i}")
        i += 1
    }
}

fn label_is(ed: edit.Ed, g: int, want: str) -> bool {
    edit.group_label(ed, g) == want
}

fn members_are(ed: edit.Ed, g: int, want: List[int]) -> bool {
    let got = edit.group_members(ed, g)
    if got.len != want.len {
        return false
    }
    var i = 0
    while i < got.len {
        if got[i] != want[i] {
            return false
        }
        i += 1
    }
    true
}

fn ints2(a: int, b: int) -> List[int] {
    var v = List[int]()
    (mut v).push(a)
    (mut v).push(b)
    v
}

fn ints3(a: int, b: int, c: int) -> List[int] {
    var v = ints2(a, b)
    (mut v).push(c)
    v
}

// ---- creation and labelling ---------------------------------------------

// `test_groups_create_labels_from_the_directory_basename` (`:58-87`).
fn groups_create_labels_from_the_directory_basename() {
    var ed = fixture()
    var g = edit.group_create(mut ed, "/home/u/proj/src", "")
    assert(g != 0, "a group")
    assert(label_is(ed, g, "src/ (0)"), "the basename, the count live even at zero")
    g = edit.group_create(mut ed, "/home/u/proj/tests/", "")
    assert(label_is(ed, g, "tests/ (0)"), "a trailing slash is not an empty name")
    g = edit.group_create(mut ed, "/", "")
    assert(label_is(ed, g, "/ (0)"), "the root has no basename")
    g = edit.group_create(mut ed, "/home/u/proj/src", "backend")
    assert(label_is(ed, g, "backend (0)"), "an explicit name wins")
}

// `test_groups_ids_are_monotonic_and_never_reused` (`:89-109`).
fn groups_ids_are_monotonic_and_never_reused() {
    var ed = fixture()
    open_many(mut ed, 3)
    let a = edit.group_create(mut ed, "/a", "")
    let b = edit.group_create(mut ed, "/b", "")
    assert(b > a, "monotonic")
    edit.group_dissolve(mut ed, a)
    assert(edit.group_find(ed, a) == -1, "dissolved")
    let c = edit.group_create(mut ed, "/c", "")
    assert(c > b, "never reused")
    assert(edit.group_find(ed, a) == -1, "still gone")
}

// `test_groups_label_count_is_computed_not_stored` (`:111-130`).
fn groups_label_count_is_computed_not_stored() {
    var ed = fixture()
    open_many(mut ed, 3)
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 1)
    edit.group_add_member(mut ed, g, 2)
    assert(label_is(ed, g, "src/ (2)"), "two members")
    assert(edit.tab_close(mut ed, 1), "close a member")
    assert(label_is(ed, g, "src/ (1)"), "the label follows with no one telling it")
}

// ---- membership -------------------------------------------------------------

// `test_groups_membership_lives_on_the_tab` (`:136-160`).
fn groups_membership_lives_on_the_tab() {
    var ed = fixture()
    open_many(mut ed, 3)
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 1)
    edit.group_add_member(mut ed, g, 3)
    assert(ed.tabs[1].group_id == g, "tab 1 is a member")
    assert(ed.tabs[1].group_ordinal == 1, "1-based, join order")
    assert(ed.tabs[3].group_ordinal == 2, "second to join")
    assert(ed.tabs[0].group_id == 0, "tab 0 ungrouped")
    assert(members_are(ed, g, ints2(1, 3)), "members by ordinal")
    assert(edit.group_member_count(ed, g) == 2, "counted")
}

// `test_groups_a_tab_joins_only_one_group` (`:162-188`).
fn groups_a_tab_joins_only_one_group() {
    var ed = fixture()
    open_many(mut ed, 4)
    let a = edit.group_create(mut ed, "/a", "")
    let b = edit.group_create(mut ed, "/b", "")
    edit.group_add_member(mut ed, a, 1)
    edit.group_add_member(mut ed, a, 2)
    edit.group_add_member(mut ed, a, 3)
    assert(ed.tabs[3].group_ordinal == 3, "third")
    edit.group_add_member(mut ed, b, 2)
    assert(ed.tabs[2].group_id == b, "defected")
    assert(ed.tabs[2].group_ordinal == 1, "first in b")
    assert(edit.group_member_count(ed, a) == 2, "a lost one")
    assert(ed.tabs[1].group_ordinal == 1, "a's first")
    assert(ed.tabs[3].group_ordinal == 2, "a closed the hole")
}

// `test_groups_readding_a_member_keeps_its_ordinal` (`:190-206`).
fn groups_readding_a_member_keeps_its_ordinal() {
    var ed = fixture()
    open_many(mut ed, 3)
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 1)
    edit.group_add_member(mut ed, g, 2)
    edit.group_add_member(mut ed, g, 1)
    assert(ed.tabs[1].group_ordinal == 1, "kept")
    assert(ed.tabs[2].group_ordinal == 2, "kept")
    assert(edit.group_member_count(ed, g) == 2, "still two")
}

// `test_groups_removing_the_last_member_auto_dissolves` (`:208-224`).
fn groups_removing_the_last_member_auto_dissolves() {
    var ed = fixture()
    open_many(mut ed, 2)
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 1)
    assert(edit.group_find(ed, g) >= 0, "live")
    edit.group_remove_member(mut ed, 1)
    assert(edit.group_find(ed, g) == -1, "auto-dissolved")
    assert(edit.active_group_id(ed) == 0, "no active group")
}

// `test_groups_closing_the_last_member_auto_dissolves` (`:226-240`).
fn groups_closing_the_last_member_auto_dissolves() {
    var ed = fixture()
    open_many(mut ed, 2)
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 2)
    assert(edit.tab_close(mut ed, 2), "close the member")
    assert(edit.group_find(ed, g) == -1, "the same door")
}

// `test_groups_close_compacts_ordinals_not_indices` (`:242-270`).
fn groups_close_compacts_ordinals_not_indices() {
    var ed = fixture()
    open_many(mut ed, 4)
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 1)
    edit.group_add_member(mut ed, g, 2)
    edit.group_add_member(mut ed, g, 3)
    assert(edit.tab_close(mut ed, 2), "close the middle member")
    assert(members_are(ed, g, ints2(1, 2)), "index 3 slid to 2")
    assert(ed.tabs[1].group_ordinal == 1, "ordinal 1")
    assert(ed.tabs[2].group_ordinal == 2, "ordinal 3 became 2")
}

// `test_groups_dissolve_ungroups_stragglers` (`:272-295`).
fn groups_dissolve_ungroups_stragglers() {
    var ed = fixture()
    open_many(mut ed, 3)
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 1)
    edit.group_add_member(mut ed, g, 2)
    edit.group_dissolve(mut ed, g)
    for t in ed.tabs {
        assert(t.group_id == 0, "no tab names the dead id")
        assert(t.group_ordinal == 0, "no ordinal left behind")
    }
}

// `test_groups_prune_empty_removes_only_empty_groups` (`:297-312`).
fn groups_prune_empty_removes_only_empty_groups() {
    var ed = fixture()
    open_many(mut ed, 2)
    let a = edit.group_create(mut ed, "/a", "")
    let b = edit.group_create(mut ed, "/b", "")
    edit.group_add_member(mut ed, b, 1)
    edit.group_prune_empty(mut ed)
    assert(edit.group_find(ed, a) == -1, "the empty one went")
    assert(edit.group_find(ed, b) >= 0, "the populated one stayed")
}

// `test_groups_active_group_id_is_derived` (`:314-332`).
fn groups_active_group_id_is_derived() {
    var ed = fixture()
    open_many(mut ed, 3)
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 2)
    edit.tab_switch(mut ed, 0)
    assert(edit.active_group_id(ed) == 0, "outside")
    edit.tab_switch(mut ed, 2)
    assert(edit.active_group_id(ed) == g, "inside")
    // Assigned RAW, as several call sites do: nothing cached it.
    ed.tab_active = 0
    assert(edit.active_group_id(ed) == 0, "derived")
}

// ---- set_ordinal: the rightward off-by-one ---------------------------------

// `test_groups_set_ordinal_moves_right_by_exactly_one` (`:338-370`).
fn groups_set_ordinal_moves_right_by_exactly_one() {
    var ed = fixture()
    open_many(mut ed, 3)
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 1)
    edit.group_add_member(mut ed, g, 2)
    edit.group_add_member(mut ed, g, 3)
    edit.group_set_ordinal(mut ed, 1, 2)
    assert(members_are(ed, g, ints3(2, 1, 3)), "[1,2,3] -> [2,1,3]")
    assert(ed.tabs[2].group_ordinal == 1, "renumbered")
    assert(ed.tabs[1].group_ordinal == 2, "renumbered")
    assert(ed.tabs[3].group_ordinal == 3, "renumbered")
}

// `test_groups_set_ordinal_moves_left_and_clamps` (`:372-400`).
fn groups_set_ordinal_moves_left_and_clamps() {
    var ed = fixture()
    open_many(mut ed, 3)
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 1)
    edit.group_add_member(mut ed, g, 2)
    edit.group_add_member(mut ed, g, 3)
    edit.group_set_ordinal(mut ed, 3, 1)
    assert(members_are(ed, g, ints3(3, 1, 2)), "last to first")
    edit.group_set_ordinal(mut ed, 3, 99)
    let m = edit.group_members(ed, g)
    assert(m.len == 3 && m[2] == 3, "clamped to the end")
    edit.group_set_ordinal(mut ed, 3, -4)
    let m2 = edit.group_members(ed, g)
    assert(m2.len == 3 && m2[0] == 3, "clamped to the start")
}

// ---- reorder_block: the interleave regression -------------------------------

// `test_groups_reorder_block_stays_contiguous_past_other_tabs` (`:406-442`).
fn groups_reorder_block_stays_contiguous_past_other_tabs() {
    var ed = fixture()
    open_many(mut ed, 4)
    var ids = List[int]()
    for t in ed.tabs {
        (mut ids).push(t.tab_id)
    }
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 0)
    edit.group_add_member(mut ed, g, 1)
    edit.group_reorder_block(mut ed, g, 3)
    assert(ed.tabs[0].tab_id == ids[2], "slid left")
    assert(ed.tabs[1].tab_id == ids[3], "slid left")
    assert(ed.tabs[2].tab_id == ids[4], "slid left")
    assert(ed.tabs[3].tab_id == ids[0], "the block, contiguous")
    assert(ed.tabs[4].tab_id == ids[1], "the block, contiguous")
    assert(ed.tabs[3].group_ordinal == 1, "in ordinal order")
    assert(ed.tabs[4].group_ordinal == 2, "in ordinal order")
}

// `test_groups_reorder_block_keeps_the_active_tab` (`:444-462`).
fn groups_reorder_block_keeps_the_active_tab() {
    var ed = fixture()
    open_many(mut ed, 4)
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 0)
    edit.group_add_member(mut ed, g, 1)
    edit.tab_switch(mut ed, 4)
    let active_id = ed.tabs[4].tab_id
    edit.group_reorder_block(mut ed, g, 3)
    assert(ed.tabs[ed.tab_active].tab_id == active_id, "active follows the TAB")
}

// `test_groups_reorder_block_clamps_the_destination` (`:464-484`).
fn groups_reorder_block_clamps_the_destination() {
    var ed = fixture()
    open_many(mut ed, 3)
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 2)
    edit.group_add_member(mut ed, g, 3)
    let first = ed.tabs[2].tab_id
    edit.group_reorder_block(mut ed, g, 999)
    assert(ed.tabs.len == 4, "nothing lost")
    assert(ed.tabs[2].tab_id == first, "at the end, not outside the array")
    edit.group_reorder_block(mut ed, g, -5)
    assert(ed.tabs[0].tab_id == first, "at the start")
}

// ---- the membership storm ----------------------------------------------------

// The oracle (`test_groups.c:490-555`): per group, the very member list
// the model refuses to keep, by TAB ID (the array compacts under both).
struct Oracle {
    gid: List[int],
    members: List[List[int]],
}

fn oracle_new() -> Oracle {
    Oracle { gid: List[int](), members: List[List[int]]() }
}

fn oracle_find(o: Oracle, gid: int) -> int {
    var i = 0
    while i < o.gid.len {
        if o.gid[i] == gid {
            return i
        }
        i += 1
    }
    -1
}

fn oracle_drop_group(mut o: Oracle, at: int) {
    var i = at
    while i + 1 < o.gid.len {
        o.gid[i] = o.gid[i + 1]
        o.members[i] = copy o.members[i + 1]
        i += 1
    }
    let _ = (mut o.gid).pop()
    let _ = (mut o.members).pop()
}

// `oracle_remove` (`:535-555`): out of whichever group holds it, an
// emptied group dissolved exactly as the model does.
fn oracle_remove(mut o: Oracle, tid: int) {
    var i = 0
    while i < o.gid.len {
        var j = 0
        while j < o.members[i].len {
            if o.members[i][j] == tid {
                var k = j
                while k + 1 < o.members[i].len {
                    o.members[i][k] = o.members[i][k + 1]
                    k += 1
                }
                let _ = (mut o.members[i]).pop()
                if o.members[i].len == 0 {
                    oracle_drop_group(mut o, i)
                }
                return
            }
            j += 1
        }
        i += 1
    }
}

fn oracle_add_group(mut o: Oracle, gid: int, tid: int) {
    (mut o.gid).push(gid)
    var m = List[int]()
    (mut m).push(tid)
    (mut o.members).push(m)
}

// `oracle` mirror of `set_ordinal`: remove, then insert at `pos - 1`.
fn oracle_move(mut o: Oracle, gi: int, tid: int, pos: int) {
    let n = o.members[gi].len
    var at = 0
    var k = 0
    while k < n {
        if o.members[gi][k] == tid {
            at = k
        }
        k += 1
    }
    k = at
    while k + 1 < n {
        o.members[gi][k] = o.members[gi][k + 1]
        k += 1
    }
    k = n - 1
    while k > pos - 1 {
        o.members[gi][k] = o.members[gi][k - 1]
        k -= 1
    }
    o.members[gi][pos - 1] = tid
}

// `storm_rand` (`:557-562`): C's u32 LCG, (state >> 16) & 0x7FFF.
struct Lcg {
    s: int,
}

fn storm_rand(mut r: Lcg) -> int {
    r.s = (r.s * 1664525 + 1013904223) % 4294967296
    r.s >> 16 & 32767
}

// `storm_check` (`:564-603`): every op, not every hundred.
fn storm_check(ed: edit.Ed, o: Oracle, op: int) {
    assert(ed.groups.len == o.gid.len, "op {op}: group count {ed.groups.len}, oracle {o.gid.len}")
    var i = 0
    while i < o.gid.len {
        assert(edit.group_find(ed, o.gid[i]) >= 0, "op {op}: group {o.gid[i]} lives")
        let m = edit.group_members(ed, o.gid[i])
        assert(
            m.len == o.members[i].len,
            "op {op}: group {o.gid[i]} has {m.len}, oracle {o.members[i].len}",
        )
        assert(edit.group_member_count(ed, o.gid[i]) == o.members[i].len, "op {op}: count agrees")
        assert(m.len > 0, "op {op}: DoD 10, a live group has members")
        var j = 0
        while j < m.len {
            assert(ed.tabs[m[j]].tab_id == o.members[i][j], "op {op}: same members, same order")
            assert(ed.tabs[m[j]].group_ordinal == j + 1, "op {op}: ordinals exactly 1..n")
            assert(ed.tabs[m[j]].group_id == o.gid[i], "op {op}: the member names the group")
            j += 1
        }
        i += 1
    }
    for t in ed.tabs {
        if t.group_id == 0 {
            assert(t.group_ordinal == 0, "op {op}: an ungrouped tab has no ordinal")
            continue
        }
        assert(edit.group_find(ed, t.group_id) >= 0, "op {op}: no orphan")
        assert(oracle_find(o, t.group_id) >= 0, "op {op}: the oracle knows the group")
    }
}

// `test_groups_membership_storm_matches_a_naive_oracle` (`:605-716`).
fn groups_membership_storm_matches_a_naive_oracle() {
    var ed = fixture()
    open_many(mut ed, 7)
    var o = oracle_new()
    var seed = Lcg { s: 1516336922 }
    var op = 0
    while op < 5000 {
        let r = storm_rand(mut seed)
        let ntabs = ed.tabs.len
        let idx = if ntabs > 0 then storm_rand(mut seed) % ntabs else 0
        let what = r % 6
        if what == 0 {
            if o.gid.len < 16 {
                let g = edit.group_create(mut ed, "/src", "")
                edit.group_add_member(mut ed, g, idx)
                let tid = ed.tabs[idx].tab_id
                oracle_remove(mut o, tid)
                oracle_add_group(mut o, g, tid)
            }
        } else if what == 1 {
            if o.gid.len > 0 && ntabs > 0 {
                let gi0 = storm_rand(mut seed) % o.gid.len
                let gid = o.gid[gi0]
                let tid = ed.tabs[idx].tab_id
                if ed.tabs[idx].group_id != gid {
                    edit.group_add_member(mut ed, gid, idx)
                    oracle_remove(mut o, tid)
                    let gi = oracle_find(o, gid)
                    if gi >= 0 {
                        (mut o.members[gi]).push(tid)
                    }
                }
            }
        } else if what == 2 {
            if ntabs > 0 {
                let tid = ed.tabs[idx].tab_id
                edit.group_remove_member(mut ed, idx)
                oracle_remove(mut o, tid)
            }
        } else if what == 3 {
            if ntabs > 1 {
                let tid = ed.tabs[idx].tab_id
                assert(edit.tab_close(mut ed, idx), "op {op}: close")
                oracle_remove(mut o, tid)
            }
        } else if what == 4 {
            if ntabs < 63 {
                assert(edit.tab_open(mut ed, "/tmp/yew-storm-{op}.txt") >= 0, "op {op}: open")
            }
        } else if ntabs > 0 && ed.tabs[idx].group_id != 0 {
            let gid = ed.tabs[idx].group_id
            let gi = oracle_find(o, gid)
            let n = if gi >= 0 then o.members[gi].len else 0
            if n > 0 {
                let pos = storm_rand(mut seed) % n + 1
                let tid = ed.tabs[idx].tab_id
                edit.group_set_ordinal(mut ed, idx, pos)
                oracle_move(mut o, gi, tid, pos)
            }
        }
        storm_check(ed, o, op)
        op += 1
    }
}

// ---- s24 §3: lazy hydration -------------------------------------------------

// `mkdtemp` (`gp_files_make`'s, `:736-757`): a fresh directory, made
// exclusively.
fn fresh_dir(prefix: str) -> str {
    var tries = 0
    while tries < 100 {
        var suffix = ""
        for r in os_random(6) {
            suffix = suffix + "{r % 10}"
        }
        let dir = "/tmp/{prefix}-{suffix}"
        fs_create_dir_mode(dir, 448) else |e| match e {
            exists => {
                tries += 1
                continue
            },
            denied => { assert(false, "mkdtemp denied") },
            invalid => { assert(false, "mkdtemp invalid") },
            not_found => { assert(false, "mkdtemp not found") },
            unsupported => { assert(false, "mkdtemp unsupported") },
            io => { assert(false, "mkdtemp io") },
        }
        return dir
    }
    assert(false, "mkdtemp exhausted")
    ""
}

fn two(i: int) -> str {
    if i < 10 then "0{i}" else "{i}"
}

// `gp_files_make` (`:736-757`): `n` files `fNN.txt`, each two lines.
fn files_make(n: int) -> (str, List[str]) {
    let dir = fresh_dir("yew-grp")
    var paths = List[str]()
    var i = 0
    while i < n {
        let p = "{dir}/f{two(i)}.txt"
        var body = List[byte]()
        for b in "file {i} line one\nline two\n".bytes() {
            (mut body).push(b)
        }
        fs_write_bytes(p, body) else |_| {
            assert(false, "write {p}")
        }
        (mut paths).push(p)
        i += 1
    }
    (dir, paths)
}

// `gp_files_remove` (`:759-766`).
fn files_remove(dir: str, paths: List[str]) {
    for p in paths {
        fs_remove(p) else |_| {}
    }
    fs_remove_dir(dir) else |_| {
        assert(false, "rmdir {dir}")
    }
}

// `audit_file_slot` (`:779-790`): the fixture slot naming `path`, -1.
fn audit_file_slot(paths: List[str], path: str) -> int {
    var i = 0
    while i < paths.len {
        if text.file_same_identity(paths[i], path) {
            return i
        }
        i += 1
    }
    -1
}

// `audit_open_count` (`:792-801`).
fn audit_open_count(opened: List[bool]) -> int {
    var n = 0
    for x in opened {
        if x {
            n += 1
        }
    }
    n
}

// `audit_pick_slot` (`:803-825`).
fn audit_pick_slot(opened: List[bool], want_open: bool, mut seed: Lcg) -> int {
    var count = 0
    for x in opened {
        if x == want_open {
            count += 1
        }
    }
    if count == 0 {
        return -1
    }
    var wanted = storm_rand(mut seed) % count
    var i = 0
    while i < opened.len {
        if opened[i] == want_open {
            if wanted == 0 {
                return i
            }
            wanted -= 1
        }
        i += 1
    }
    -1
}

// `test_groups_audit_storm_100k_survives_restore_and_walk_dissolve`
// (`:903-1064`): the storm runs; its mid-sequence restore through
// `state.fl` is Sprint 25's (yw06) and SKIPs, once, by name.
fn groups_audit_storm_100k_survives_restore_and_walk_dissolve() {
    let (dir, paths) = files_make(16)
    var ed = fixture()
    var o = oracle_new()
    var opened = List[bool]()
    var seed = Lcg { s: 4034549520 }
    for p in paths {
        assert(edit.tab_open(mut ed, p) >= 0, "open {p}")
        (mut opened).push(true)
    }
    say_skip(
        "groups_audit_storm_100k_survives_restore_and_walk_dissolve's restore half (state.fl every 1,000 ops: yew_state_emit/apply): sagitta Sprint 25 (workspace state) (yw06)",
    )
    var op = 0
    while op < 100000 {
        let r = storm_rand(mut seed)
        let what = r % 8
        if what == 0 {
            let slot = audit_pick_slot(opened, true, mut seed)
            if slot >= 0 && o.gid.len < 16 {
                let idx = edit.tab_find_by_path(ed, paths[slot])
                let gid = edit.group_create(mut ed, dir, "audit")
                assert(idx >= 0, "op {op}: create's tab")
                let tid = ed.tabs[idx].tab_id
                edit.group_add_member(mut ed, gid, idx)
                oracle_remove(mut o, tid)
                oracle_add_group(mut o, gid, tid)
            }
        } else if what == 1 {
            let slot = audit_pick_slot(opened, true, mut seed)
            if slot >= 0 && o.gid.len > 0 {
                let gi0 = storm_rand(mut seed) % o.gid.len
                let idx = edit.tab_find_by_path(ed, paths[slot])
                let gid = o.gid[gi0]
                assert(idx >= 0, "op {op}: join's tab")
                let tid = ed.tabs[idx].tab_id
                if ed.tabs[idx].group_id != gid {
                    edit.group_add_member(mut ed, gid, idx)
                    oracle_remove(mut o, tid)
                    let gi = oracle_find(o, gid)
                    assert(gi >= 0, "op {op}: the joined group lives")
                    (mut o.members[gi]).push(tid)
                }
            }
        } else if what == 2 {
            let slot = audit_pick_slot(opened, true, mut seed)
            if slot >= 0 {
                let idx = edit.tab_find_by_path(ed, paths[slot])
                assert(idx >= 0, "op {op}: leave's tab")
                let tid = ed.tabs[idx].tab_id
                edit.group_remove_member(mut ed, idx)
                oracle_remove(mut o, tid)
            }
        } else if what == 3 {
            if audit_open_count(opened) > 1 {
                let slot = audit_pick_slot(opened, true, mut seed)
                let idx = edit.tab_find_by_path(ed, paths[slot])
                assert(idx >= 0, "op {op}: close's tab")
                edit.tab_switch(mut ed, idx)
                let tid = ed.tabs[ed.tab_active].tab_id
                assert(edit.tab_close(mut ed, ed.tab_active), "op {op}: close")
                oracle_remove(mut o, tid)
                opened[slot] = false
            }
        } else if what == 4 {
            let slot = audit_pick_slot(opened, false, mut seed)
            if slot >= 0 {
                assert(edit.tab_open(mut ed, paths[slot]) >= 0, "op {op}: reopen")
                opened[slot] = true
            }
        } else if what == 5 {
            let slot = audit_pick_slot(opened, true, mut seed)
            if slot >= 0 {
                let idx = edit.tab_find_by_path(ed, paths[slot])
                let gid = ed.tabs[idx].group_id
                let gi = oracle_find(o, gid)
                if gi >= 0 && o.members[gi].len > 0 {
                    let n = o.members[gi].len
                    let pos = storm_rand(mut seed) % n + 1
                    let tid = ed.tabs[idx].tab_id
                    edit.group_set_ordinal(mut ed, idx, pos)
                    oracle_move(mut o, gi, tid, pos)
                }
            }
        } else if what == 6 {
            if o.gid.len > 0 {
                let gi = storm_rand(mut seed) % o.gid.len
                let to = storm_rand(mut seed) % (audit_open_count(opened) + 3) - 1
                edit.group_reorder_block(mut ed, o.gid[gi], to)
            }
        } else if o.gid.len > 0 {
            let gi = storm_rand(mut seed) % o.gid.len
            let gid = o.gid[gi]
            let members = edit.group_members(ed, gid)
            assert(members.len > 0, "op {op}: a live group has members")
            var j = 0
            while j < members.len {
                if j == 0 {
                    edit.group_dissolve(mut ed, gid)
                    oracle_drop_group(mut o, gi)
                }
                assert(ed.tabs[members[j]].group_id == 0, "op {op}: walked member ungrouped")
                assert(ed.tabs[members[j]].group_ordinal == 0, "op {op}: walked member's ordinal")
                j += 1
            }
        }
        storm_check(ed, o, op)
        op += 1
    }
    files_remove(dir, paths)
}

// `test_groups_opening_a_forty_file_group_reads_one_file` (`:1066-1113`):
// DoD 4, counted — "deferred" is worth something only if it avoids the
// read.
fn groups_opening_a_forty_file_group_reads_one_file() {
    let (dir, paths) = files_make(40)
    var ed = fixture()
    let g = edit.group_create(mut ed, dir, "")
    let base = text.file_load_count()
    for p in paths {
        let idx = edit.tab_open(mut ed, p)
        assert(idx >= 0, "open {p}")
        edit.group_add_member(mut ed, g, idx)
    }
    assert(edit.group_member_count(ed, g) == 40, "forty members")
    assert(text.file_load_count() == base, "not one of them read")
    var i = 0
    while i < 40 {
        assert(!edit.tab_is_resident(ed, ed.tabs.len - 40 + i), "member {i} not resident")
        i += 1
    }
    edit.tab_switch(mut ed, 1)
    assert(text.file_load_count() == base + 1, "viewing the first costs one read")
    assert(edit.tab_is_resident(ed, 1), "and it is resident")
    edit.tab_switch(mut ed, 2)
    assert(text.file_load_count() == base + 2, "the second costs the second")
    edit.tab_switch(mut ed, 1)
    assert(text.file_load_count() == base + 2, "going back reads nothing")
    files_remove(dir, paths)
}

// `test_groups_defer_and_hydrate_round_trip` (`:1115-1150`).
fn groups_defer_and_hydrate_round_trip() {
    let (dir, paths) = files_make(2)
    var ed = fixture()
    let idx = edit.tab_open(mut ed, paths[0])
    assert(idx >= 0, "open")
    assert(!edit.tab_is_resident(ed, idx), "born deferred")
    edit.tab_switch(mut ed, idx)
    assert(edit.tab_is_resident(ed, idx), "the switch hydrates")
    edit.tab_defer(mut ed, idx)
    assert(edit.tab_is_resident(ed, idx), "the ACTIVE tab is never deferred")
    edit.tab_switch(mut ed, 0)
    edit.tab_defer(mut ed, idx)
    assert(!edit.tab_is_resident(ed, idx), "deferred")
    assert(!edit.tab_modified(ed, idx), "a tab read from nowhere is not modified")
    let before = text.file_load_count()
    edit.tab_switch(mut ed, idx)
    assert(text.file_load_count() == before + 1, "it rereads on the way back")
    assert(edit.tab_is_resident(ed, idx), "resident again")
    files_remove(dir, paths)
}

// `test_groups_save_refuses_a_non_resident_tab` (`:1152-1186`): a
// DISTINCT status, not an I/O error, and the file untouched.
fn groups_save_refuses_a_non_resident_tab() {
    let (dir, paths) = files_make(1)
    var ed = fixture()
    let idx = edit.tab_open(mut ed, paths[0])
    assert(idx >= 0, "open")
    assert(!edit.tab_is_resident(ed, idx), "deferred")
    // Point the editor at the tab's window WITHOUT the hydrating switch:
    // every historical bug here is a path that skipped hydrate.
    ed.win = ed.panes[ed.tabs[idx].focus].win
    assert(edit.ed_file_save(mut ed, false) == edit.CMD_ERR_STATE, "refused distinctly")
    let back = fs_read_bytes(paths[0]) else List[byte]()
    let s = str_from_utf8(back) else ""
    assert(s.starts_with("file 0 line one\n"), "the file on disk is untouched")
    files_remove(dir, paths)
}

// `test_groups_one_buffer_per_path` (`:1188-1208`): the second open
// switches to the first tab rather than duplicating it.
fn groups_one_buffer_per_path() {
    let (dir, paths) = files_make(1)
    var ed = fixture()
    let a = edit.tab_open(mut ed, paths[0])
    let b = edit.tab_open(mut ed, paths[0])
    assert(a == b, "one tab")
    assert(ed.tabs.len == 2, "scratch and the file")
    files_remove(dir, paths)
}

