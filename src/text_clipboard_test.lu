    fs.create_dir_all("target/tests") else |_| {}
    env_set("YEW_LOG", LOG_PATH) else |_| {}
    env_set("YEW_LOG_LEVEL", "debug") else |_| {}
    clipboard_detection_matrix()
    clipboard_override_matrix()
    clipboard_write_defers_backend_detection()
    clipboard_custom_write_coalesces_binary()
    clipboard_custom_read_binary_and_cap()
    clipboard_reader_reaped_before_pipe_eof()
    clipboard_read_failures_are_reported()
    clipboard_osc52_flushes_after_esu()
    clipboard_nonexit_100_writes_are_nonblocking()
    clipboard_epipe_demotes_failed_backend()
    clipboard_exec_failure_demotes_small_write()
    clipboard_osc52_over_limit_falls_back_to_subprocess()
    clipboard_sync_default_yank_not_delete()
    clipboard_sync_modes_route_only_documented_writes()
    clipboard_unnamed_paste_reads_subprocess()
    fs.remove(LOG_PATH) else |_| {}
    print("clipboard_test: 15 cases ported, every one whole where os_fork answers")
}
