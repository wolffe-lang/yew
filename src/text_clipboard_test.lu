//! member: false
//!
//! The port of sagitta `tests/unit/test_clipboard.c` (1023 lines), one
//! test per C test in registry order (`tests/unit/registry.c:242-256`).
//! The fake tool is the oracle's own build of `tests/unit/fakeclip.c`
//! (`target/oracle/sagitta/build/fakeclip`, made by `tools/oracle`); the
//! fixture directory is under `target/tests/`. The environment is the
//! process's (`env_set`/`env_unset`, C's `setenv`/`unsetenv`), saved and
//! restored per test as C's `ClipEnv`; the log capture is a `YEW_LOG`
//! scratch file.
//!
//! The subprocess writer and reader fork (G30's fork half, since the
//! 0.2.34 pin; `src/text/clipboard.lu`'s header), so every case runs
//! whole where `os_fork` answers; on the checked machine it answers
//! `unsupported` (ruling #95 R4 C) and the halves that start a tool SKIP
//! by name on both streams, counted in the summary.
//! `clipboard_nonexit_100_writes_are_nonblocking` asserts C's properties
//! in the port's shape: the editor holds no write end of the tool's pipe
//! (`clip_write_fd` is the middle's status pipe, read only), each write
//! returns within C's budget measured on the monotonic clock (wolf has no
//! process CPU clock: a wall-clock bound is the stricter one), and no tool
//! is this process's child (its parent read with `ps`, C's
//! `waitpid(..., WNOHANG) == ECHILD`).

use std.env as std_env
use std.fs
use std.process
use std.signal
use term
use text

const NO_FORK: str = "os_fork answers unsupported here (the checked machine, ruling #95 R4 C), so no tool can start"

const NO_FAKE: str = "target/oracle/sagitta/build/fakeclip is missing: run tools/oracle first"

const LOG_PATH: str = "target/tests/text-clipboard-test.log"

struct Saved {
    name: str,
    value: str,
    had: bool,
}

struct Fixture {
    dir: str,
    fake: str,
    output: str,
    input: str,
    pidlog: str,
}

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn save(name: str) -> Saved {
    let v = env_get(name) else {
        return Saved { name: name, value: "", had: false }
    }
    Saved { name: name, value: v, had: true }
}

fn save_all(names: List[str]) -> List[Saved] {
    var out = List[Saved]()
    for n in names {
        (mut out).push(save(n))
    }
    out
}

// `clip_env_restore` over the saved list, newest first.
fn restore_all(saved: List[Saved]) {
    var i = saved.len
    while i != 0 {
        i -= 1
        let s = copy saved[i]
        if s.had {
            env_set(s.name, s.value) else |_| {}
        } else {
            env_unset(s.name) else |_| {}
        }
    }
}

fn set(name: str, value: str) {
    env_set(name, value) else |_| {
        assert(false, "setenv {name}")
    }
}

fn unset(name: str) {
    env_unset(name) else |_| {
        assert(false, "unsetenv {name}")
    }
}

// `clip_clear_environment`, `test_clipboard.c:56-64`.
fn clear_environment() {
    unset("YEW_CLIPBOARD")
    unset("YEW_OSC52")
    unset("WAYLAND_DISPLAY")
    unset("DISPLAY")
    unset("SSH_TTY")
    unset("SSH_CONNECTION")
}

fn fake_path() -> str {
    let cwd = std_env.cwd() else "."
    "{cwd}/target/oracle/sagitta/build/fakeclip"
}

// `clip_fixture_init`, `test_clipboard.c:67-103`: an empty directory and
// the fake tool's absolute path.
fn fixture() -> Fixture {
    let cwd = std_env.cwd() else "."
    let dir = "{cwd}/target/tests/yew-clip-{std_env.pid()}"
    fs.remove_dir_all(dir) else |_| {}
    fs.create_dir_all(dir) else |_| {
        assert(false, "fixture dir {dir}")
    }
    Fixture {
        dir: dir,
        fake: fake_path(),
        output: "{dir}/out.bin",
        input: "{dir}/in.bin",
        pidlog: "{dir}/pids.txt",
    }
}

fn fixture_free(f: Fixture) {
    fs.remove_dir_all(f.dir) else |_| {
        assert(false, "fixture rmdir {f.dir}")
    }
}

fn link(f: Fixture, name: str) {
    fs.symlink(f.fake, "{f.dir}/{name}") else |_| {
        assert(false, "symlink {name}")
    }
}

fn unlink(f: Fixture, name: str) {
    fs.remove("{f.dir}/{name}") else |_| {
        assert(false, "unlink {name}")
    }
}

fn value(bytes: List[byte]) -> text.RegVal {
    var v = text.regval_new()
    v.kind = text.REG_CHARWISE
    v.bytes = copy bytes
    v
}

fn renderer() -> term.Render {
    term.render_new(term.caps_new(), term.env_process())
}

fn capture_log() {
    fs.remove(LOG_PATH) else |_| {}
}

fn warned(needle: str) -> bool {
    let log = fs.read_text(LOG_PATH) else ""
    for line in log.lines() {
        if line.contains(" warn: ") && line.contains(needle) {
            return true
        }
    }
    false
}

fn skip(what: str, why: str) {
    print("clipboard_test: SKIP {what}: {why}")
    eprint("clipboard_test: SKIP {what}: {why}")
}

// `clip_set_custom`, `test_clipboard.c:232-249`.
fn set_custom(f: Fixture, write_mode: str, with_read: bool) {
    if with_read {
        set(
            "YEW_CLIPBOARD",
            "cmd:{f.fake} {f.output} {write_mode} alpha beta|{f.fake} {f.input} read",
        )
    } else {
        set("YEW_CLIPBOARD", "cmd:{f.fake} {f.output} {write_mode}")
    }
}

// Does `os_fork` make a child here? (native and release; the checked
// machine answers `unsupported`.)
fn fork_available() -> bool {
    let (pid, h) = os_fork() else {
        return false
    }
    if pid == 0 {
        os_exit(0)
    }
    let _ = os_wait_status(h) else -1
    true
}

// `clip_read_file`, `test_clipboard.c:168-190`.
fn read_file(path: str) -> (List[byte], bool) {
    let b = fs.read_bytes(path) else {
        return (List[byte](), false)
    }
    (b, true)
}

// `clip_wait_file`, `test_clipboard.c:192-203`: up to 2 s for `min_len`.
fn wait_file(path: str, min_len: int) -> (List[byte], bool) {
    var i = 0
    while i < 2000 {
        let (b, ok) = read_file(path)
        if ok && b.len >= min_len {
            return (b, true)
        }
        time_sleep_ms(1)
        i += 1
    }
    (List[byte](), false)
}

// `clip_pump_until_idle`, `test_clipboard.c:249-263`: the loop's wait on
// the writer's descriptor (a millisecond), then a pump.
fn pump_until_idle(mut c: text.Clipboard, mut r: term.Render) {
    var i = 0
    while i < 2000 && text.clip_busy(c) {
        let fd = text.clip_write_fd(c)
        if fd >= 0 {
            let _ = os_signal_wait_fds([fd], signal.urgent(), 1) else (0, 0)
        }
        text.clip_pump(mut c, mut r, time_now_ms())
        i += 1
    }
    assert(!text.clip_busy(c), "the writer goes idle")
}

fn clipboard_detection_matrix() {
    if !fs.exists(fake_path()) {
        skip("clipboard_detection_matrix", NO_FAKE)
        return
    }
    let saved = save_all(
        [
            "YEW_CLIPBOARD",
            "YEW_OSC52",
            "WAYLAND_DISPLAY",
            "DISPLAY",
            "SSH_TTY",
            "SSH_CONNECTION",
            "PATH",
        ],
    )
    let f = fixture()
    clear_environment()
    set("YEW_OSC52", "off")
    set("PATH", f.dir)
    var c = text.clip_new()
    text.clip_reset(mut c)
    assert(text.clip_detect(mut c) == text.CLIP_NONE, "nothing on PATH")
    link(f, "wl-copy")
    set("WAYLAND_DISPLAY", "wayland-1")
    text.clip_reset(mut c)
    assert(text.clip_detect(mut c) == text.CLIP_WL, "wayland")
    unset("WAYLAND_DISPLAY")
    link(f, "xclip")
    set("DISPLAY", ":1")
    text.clip_reset(mut c)
    assert(text.clip_detect(mut c) == text.CLIP_XCLIP, "xclip")
    link(f, "xsel")
    text.clip_reset(mut c)
    assert(text.clip_detect(mut c) == text.CLIP_XCLIP, "xclip before xsel")
    unlink(f, "xclip")
    text.clip_reset(mut c)
    assert(text.clip_detect(mut c) == text.CLIP_XSEL, "xsel")
    set("WAYLAND_DISPLAY", "wayland-1")
    text.clip_reset(mut c)
    assert(text.clip_detect(mut c) == text.CLIP_WL, "wayland before X")
    unlink(f, "wl-copy")
    text.clip_reset(mut c)
    assert(text.clip_detect(mut c) == text.CLIP_XSEL, "xsel without wl-copy")
    set("SSH_TTY", "/dev/pts/9")
    text.clip_reset(mut c)
    assert(text.clip_detect(mut c) == text.CLIP_NONE, "remote writes are OSC 52 only")
    assert(text.clip_detect_read(mut c) == text.CLIP_XSEL, "remote reads stay local")
    unset("SSH_TTY")
    set("SSH_CONNECTION", "1 2 3 4")
    text.clip_reset(mut c)
    assert(text.clip_detect(mut c) == text.CLIP_NONE, "SSH_CONNECTION is remote")
    assert(text.clip_detect_read(mut c) == text.CLIP_XSEL, "reads stay local")
    unset("SSH_CONNECTION")
    unset("DISPLAY")
    text.clip_reset(mut c)
    assert(text.clip_detect_read(mut c) == text.CLIP_NONE, "no display, no reader")
    set("YEW_CLIPBOARD", "auto")
    text.clip_reset(mut c)
    assert(text.clip_detect(mut c) == text.CLIP_NONE, "auto writes")
    assert(text.clip_detect_read(mut c) == text.CLIP_NONE, "auto reads")
    text.clip_shutdown(mut c)
    unlink(f, "xsel")
    fixture_free(f)
    restore_all(saved)
}

fn clipboard_override_matrix() {
    let values = [
        "none",
        "osc52",
        "wl",
        "xclip",
        "xsel",
        "pb",
        "cmd:/bin/false",
        "cmd:/bin/false|/bin/false",
    ]
    let writes = [
        text.CLIP_NONE,
        text.CLIP_OSC52,
        text.CLIP_WL,
        text.CLIP_XCLIP,
        text.CLIP_XSEL,
        text.CLIP_PB,
        text.CLIP_CUSTOM,
        text.CLIP_CUSTOM,
    ]
    let reads = [
        text.CLIP_NONE,
        text.CLIP_NONE,
        text.CLIP_WL,
        text.CLIP_XCLIP,
        text.CLIP_XSEL,
        text.CLIP_PB,
        text.CLIP_NONE,
        text.CLIP_CUSTOM,
    ]
    let saved = save_all(["YEW_CLIPBOARD"])
    var c = text.clip_new()
    var i = 0
    while i < values.len {
        set("YEW_CLIPBOARD", values[i])
        text.clip_reset(mut c)
        assert(text.clip_detect(mut c) == writes[i], "{values[i]} writes")
        assert(text.clip_detect_read(mut c) == reads[i], "{values[i]} reads")
        i += 1
    }
    text.clip_shutdown(mut c)
    restore_all(saved)
}

fn clipboard_write_defers_backend_detection() {
    let saved = save_all(["YEW_CLIPBOARD"])
    set("YEW_CLIPBOARD", "none")
    var c = text.clip_new()
    text.clip_reset(mut c)
    var r = renderer()
    var terminal = List[byte]()
    capture_log()
    assert(text.clip_write(mut c, value(bytes_of("queued")), '+' as int), "queued")
    assert(text.clip_pending(c), "pending")
    assert(!warned("no writable"), "nothing detected yet")
    text.clip_after_render(mut c, mut r, mut terminal, time_now_ms())
    assert(!text.clip_pending(c), "drained")
    assert(warned("no writable"), "detected at the render")
    text.clip_shutdown(mut c)
    restore_all(saved)
}

fn clipboard_custom_write_coalesces_binary() {
    if !fs.exists(fake_path()) {
        skip("clipboard_custom_write_coalesces_binary", NO_FAKE)
        return
    }
    if !fork_available() {
        skip("clipboard_custom_write_coalesces_binary", NO_FORK)
        return
    }
    let saved = save_all(["YEW_CLIPBOARD"])
    let f = fixture()
    set_custom(f, "write", true)
    var c = text.clip_new()
    text.clip_reset(mut c)
    var first = bytes_of("old")
    var latest = List[byte]()
    (mut latest).push(0 as byte)
    (mut latest).push(255 as byte)
    for b in "new".bytes() {
        (mut latest).push(b)
    }
    var r = renderer()
    var terminal = List[byte]()
    assert(text.clip_write(mut c, value(first), '+' as int), "queued")
    assert(text.clip_pending(c), "pending")
    assert(text.clip_write(mut c, value(latest), '*' as int), "the latest wins")
    text.clip_after_render(mut c, mut r, mut terminal, time_now_ms())
    pump_until_idle(mut c, mut r)
    assert(terminal.len == 0, "no OSC 52")
    let (got, ok) = wait_file(f.output, latest.len)
    assert(ok && got.len == latest.len && same(got, latest), "the latest bytes, binary")
    let (argv, aok) = wait_file("{f.dir}/out.bin.argv", 1)
    let argv_text = str_from_utf8(argv) else ""
    assert(aok && argv_text.contains("write\nalpha\nbeta\n"), "the argv: {argv_text}")
    assert(!text.clip_pending(c), "drained")
    text.clip_shutdown(mut c)
    fixture_free(f)
    restore_all(saved)
}

fn clipboard_custom_read_binary_and_cap() {
    if !fs.exists(fake_path()) {
        skip("clipboard_custom_read_binary_and_cap", NO_FAKE)
        return
    }
    if !fork_available() {
        skip("clipboard_custom_read_binary_and_cap", NO_FORK)
        return
    }
    let saved = save_all(["YEW_CLIPBOARD"])
    let f = fixture()
    var payload = List[byte]()
    (mut payload).push(0 as byte)
    (mut payload).push(1 as byte)
    (mut payload).push(2 as byte)
    (mut payload).push(255 as byte)
    (mut payload).push('x' as int as byte)
    fs.write_bytes(f.input, payload) else |_| {
        assert(false, "the input file")
    }
    set_custom(f, "write", true)
    var c = text.clip_new()
    text.clip_reset(mut c)
    var out = text.regval_new()
    assert(text.clip_read(mut c, mut out, '+' as int), "read")
    assert(out.kind == text.REG_CHARWISE, "charwise")
    assert(out.bytes.len == payload.len && same(out.bytes, payload), "the bytes, binary")
    text.clip_set_read_max(mut c, payload.len - 1)
    capture_log()
    assert(!text.clip_read(mut c, mut out, '*' as int), "the cap refuses")
    assert(warned("exceeds"), "said")
    assert(out.bytes.len == payload.len, "out untouched")
    text.clip_shutdown(mut c)
    fixture_free(f)
    restore_all(saved)
}

fn clipboard_reader_reaped_before_pipe_eof() {
    if !fs.exists(fake_path()) {
        skip("clipboard_reader_reaped_before_pipe_eof", NO_FAKE)
        return
    }
    if !fork_available() {
        skip("clipboard_reader_reaped_before_pipe_eof", NO_FORK)
        return
    }
    let saved = save_all(["YEW_CLIPBOARD"])
    let f = fixture()
    var payload = List[byte]()
    (mut payload).push('h' as int as byte)
    (mut payload).push(0 as byte)
    (mut payload).push('i' as int as byte)
    fs.write_bytes(f.input, payload) else |_| {
        assert(false, "the input file")
    }
    set("YEW_CLIPBOARD", "cmd:{f.fake} {f.output} write|{f.fake} {f.input} read-hold")
    var c = text.clip_new()
    text.clip_reset(mut c)
    var out = text.regval_new()
    assert(text.clip_read(mut c, mut out, '+' as int), "read past the reap")
    assert(out.bytes.len == payload.len && same(out.bytes, payload), "the held bytes")
    text.clip_shutdown(mut c)
    fixture_free(f)
    restore_all(saved)
}

fn clipboard_read_failures_are_reported() {
    let saved = save_all(["YEW_CLIPBOARD", "YEW_CLIPBOARD_TIMEOUT_MS"])
    var keep = List[byte]()
    (mut keep).push('k' as int as byte)
    (mut keep).push(0 as byte)
    (mut keep).push('p' as int as byte)
    var out = value(keep)
    set("YEW_CLIPBOARD", "none")
    var c = text.clip_new()
    text.clip_reset(mut c)
    capture_log()
    assert(!text.clip_read(mut c, mut out, '+' as int), "no reader")
    assert(warned("no readable"), "reported")
    assert(same(out.bytes, keep), "out untouched")
    if !fs.exists(fake_path()) {
        skip("clipboard_read_failures_are_reported's exit-17 and timeout halves", NO_FAKE)
    } else if !fork_available() {
        skip("clipboard_read_failures_are_reported's exit-17 and timeout halves", NO_FORK)
    } else {
        let f = fixture()
        set("YEW_CLIPBOARD", "cmd:{f.fake} {f.output} write|{f.fake} {f.input} exit")
        text.clip_reset(mut c)
        capture_log()
        assert(!text.clip_read(mut c, mut out, '+' as int), "exit 17")
        assert(warned("status 17"), "the status reported")
        assert(same(out.bytes, keep), "out untouched by the exit")
        set("YEW_CLIPBOARD", "cmd:{f.fake} {f.output} write|{f.fake} {f.input} hang")
        set("YEW_CLIPBOARD_TIMEOUT_MS", "10")
        text.clip_reset(mut c)
        capture_log()
        assert(!text.clip_read(mut c, mut out, '+' as int), "a hang")
        assert(warned("timed out"), "the timeout reported")
        assert(same(out.bytes, keep), "out untouched by the timeout")
        fixture_free(f)
    }
    text.clip_shutdown(mut c)
    restore_all(saved)
}

fn clipboard_osc52_flushes_after_esu() {
    let saved = save_all(["YEW_CLIPBOARD", "YEW_OSC52"])
    let prefix = "frame\x1b[?2026l"
    let suffix = "\x1b]52;c;Zm9v\x1b\\"
    set("YEW_CLIPBOARD", "osc52")
    set("YEW_OSC52", "plain")
    var c = text.clip_new()
    text.clip_reset(mut c)
    var r = renderer()
    term.render_oob_clear(mut r)
    var terminal = bytes_of(prefix)
    assert(text.clip_write(mut c, value(bytes_of("foo")), '+' as int), "queued")
    text.clip_after_render(mut c, mut r, mut terminal, time_now_ms())
    assert(term.render_oob_pending(r) == 0, "the queue is flushed")
    assert(terminal.len == prefix.len + suffix.len, "frame then OSC 52, {terminal.len} bytes")
    assert(same(terminal[0..prefix.len], bytes_of(prefix)), "the frame first")
    assert(same(terminal[prefix.len..terminal.len], bytes_of(suffix)), "the OSC 52 after the ESU")
    term.render_oob_clear(mut r)
    text.clip_shutdown(mut c)
    restore_all(saved)
}

// The tools' pids, one a line (`clip_parse_pids`, `test_clipboard.c:581-604`).
fn parse_pids(log: List[byte]) -> List[int] {
    var out = List[int]()
    let t = str_from_utf8(log) else ""
    for line in t.split("\n") {
        let n = line.trim().to_int() else -1
        if n > 0 {
            (mut out).push(n)
        }
    }
    out
}

// `pid`'s parent, read with `ps` (linux and macOS alike); -1 when gone.
fn parent_of(pid: int) -> int {
    let out_path = "target/tests/clip-ppid.txt"
    var c = process.command("ps")
    process.push_arg(mut c, "-o")
    process.push_arg(mut c, "ppid=")
    process.push_arg(mut c, "-p")
    process.push_arg(mut c, "{pid}")
    fs.write_text(out_path, "") else |_| {}
    let sink = fs.open_append(out_path) else |_| {
        return -1
    }
    process.set_stdout(mut c, sink)
    let ch = process.start(c) else |_| {
        return -1
    }
    let _ = process.wait_status(take ch) else -1
    fs.close(take sink) else |_| {}
    let t = fs.read_text(out_path) else ""
    t.trim().to_int() else -1
}

fn insertion_sort(mut v: List[int]) {
    var i = 1
    while i < v.len {
        let x = v[i]
        var at = i
        while at != 0 && v[at - 1] > x {
            v[at] = v[at - 1]
            at -= 1
        }
        v[at] = x
        i += 1
    }
}

fn clipboard_nonexit_100_writes_are_nonblocking() {
    if !fs.exists(fake_path()) {
        skip("clipboard_nonexit_100_writes_are_nonblocking", NO_FAKE)
        return
    }
    if !fork_available() {
        skip("clipboard_nonexit_100_writes_are_nonblocking", NO_FORK)
        return
    }
    let saved = save_all(["YEW_CLIPBOARD"])
    let f = fixture()
    set("YEW_CLIPBOARD", "cmd:{f.fake} {f.output} stay {f.pidlog}")
    var c = text.clip_new()
    text.clip_reset(mut c)
    var r = renderer()
    var terminal = List[byte]()
    let v = value(bytes_of("x"))
    // C's budgets are CPU time (2 ms p95, 20 ms max; 100/500 ms under
    // instrumentation); the port reads the monotonic clock, wall time >=
    // CPU time, so it takes the instrumented budgets.
    let p95_budget_ns = 100000000
    let max_budget_ns = 500000000
    var samples = List[int]()
    var i = 0
    while i < 100 {
        let start = os_clock_ns()
        assert(text.clip_write(mut c, v, '+' as int), "queued {i}")
        text.clip_after_render(mut c, mut r, mut terminal, time_now_ms())
        (mut samples).push(os_clock_ns() - start)
        assert(c.write_fd == -1, "the editor holds no write end of the tool's pipe")
        pump_until_idle(mut c, mut r)
        i += 1
    }
    insertion_sort(mut samples)
    assert(samples[94] < p95_budget_ns, "p95 {samples[94]} ns")
    assert(samples[99] < max_budget_ns, "max {samples[99]} ns")
    var pids = List[int]()
    i = 0
    while i < 2000 && pids.len < 100 {
        let (log, ok) = read_file(f.pidlog)
        if ok {
            pids = parse_pids(log)
        }
        if pids.len < 100 {
            time_sleep_ms(1)
        }
        i += 1
    }
    assert(pids.len == 100, "100 tools, at {pids.len}")
    let me = os_pid()
    for pid in pids {
        assert(parent_of(pid) != me, "tool {pid} is no child of the editor")
        os_signal_send(pid, signal.terminate()) else |_| {
            assert(false, "SIGTERM {pid}")
        }
    }
    var gone = false
    var attempt = 0
    while attempt < 2000 && !gone {
        gone = true
        for pid in pids {
            var live = true
            os_signal_send(pid, 0) else |e| match e {
                not_found => { live = false },
                denied => {},
                invalid => {},
                io => {},
                unsupported => {},
            }
            if live {
                gone = false
            }
        }
        if !gone {
            time_sleep_ms(1)
        }
        attempt += 1
    }
    assert(gone, "every tool gone")
    i = 0
    while i < 200 && text.clip_owned_children(c) != 0 {
        text.clip_reap(mut c)
        time_sleep_ms(1)
        i += 1
    }
    assert(text.clip_owned_children(c) == 0, "every middle reaped")
    text.clip_shutdown(mut c)
    fixture_free(f)
    restore_all(saved)
}

fn clipboard_epipe_demotes_failed_backend() {
    if !fs.exists(fake_path()) {
        skip("clipboard_epipe_demotes_failed_backend", NO_FAKE)
        return
    }
    if !fork_available() {
        skip("clipboard_epipe_demotes_failed_backend", NO_FORK)
        return
    }
    let saved = save_all(["YEW_CLIPBOARD"])
    let f = fixture()
    set_custom(f, "exit", false)
    var c = text.clip_new()
    text.clip_reset(mut c)
    capture_log()
    var big = List[byte]()
    var i = 0
    while i < 1048576 {
        (mut big).push('x' as int as byte)
        i += 1
    }
    var r = renderer()
    var terminal = List[byte]()
    assert(text.clip_write(mut c, value(big), '+' as int), "queued")
    text.clip_after_render(mut c, mut r, mut terminal, time_now_ms())
    i = 0
    while i < 2000 && text.clip_busy(c) {
        let fd = text.clip_write_fd(c)
        if fd >= 0 {
            let _ = os_signal_wait_fds([fd], signal.urgent(), 1) else (0, 0)
        }
        text.clip_pump(mut c, mut r, time_now_ms())
        i += 1
    }
    assert(!text.clip_busy(c), "idle")
    assert(!text.clip_pending(c), "nothing queued")
    assert(text.clip_detect(mut c) == text.CLIP_NONE, "the backend demoted")
    assert(warned("demoting backend"), "said")
    text.clip_shutdown(mut c)
    fixture_free(f)
    restore_all(saved)
}

fn clipboard_exec_failure_demotes_small_write() {
    if !fork_available() {
        skip("clipboard_exec_failure_demotes_small_write", NO_FORK)
        return
    }
    let saved = save_all(["YEW_CLIPBOARD"])
    set("YEW_CLIPBOARD", "cmd:/definitely/not/a/yew-clipboard-tool")
    var c = text.clip_new()
    text.clip_reset(mut c)
    var r = renderer()
    var terminal = List[byte]()
    capture_log()
    assert(text.clip_write(mut c, value(bytes_of("x")), '+' as int), "queued")
    text.clip_after_render(mut c, mut r, mut terminal, time_now_ms())
    pump_until_idle(mut c, mut r)
    assert(text.clip_detect(mut c) == text.CLIP_NONE, "demoted")
    assert(warned("exec failed"), "said")
    assert(!text.clip_pending(c), "nothing queued")
    text.clip_shutdown(mut c)
    restore_all(saved)
}

fn clipboard_osc52_over_limit_falls_back_to_subprocess() {
    if !fs.exists(fake_path()) {
        skip("clipboard_osc52_over_limit_falls_back_to_subprocess", NO_FAKE)
        return
    }
    let saved = save_all(
        [
            "YEW_CLIPBOARD",
            "YEW_OSC52",
            "YEW_OSC52_MAX",
            "YEW_FAKECLIP_OUTPUT",
            "WAYLAND_DISPLAY",
            "SSH_TTY",
            "SSH_CONNECTION",
            "PATH",
        ],
    )
    let f = fixture()
    link(f, "wl-copy")
    unset("SSH_TTY")
    unset("SSH_CONNECTION")
    set("YEW_CLIPBOARD", "osc52")
    set("YEW_OSC52", "plain")
    set("YEW_OSC52_MAX", "1")
    set("YEW_FAKECLIP_OUTPUT", f.output)
    set("WAYLAND_DISPLAY", "wayland-1")
    set("PATH", f.dir)
    var r = renderer()
    var terminal = List[byte]()
    if !fork_available() {
        skip("clipboard_osc52_over_limit_falls_back_to_subprocess's local fallback half", NO_FORK)
    } else {
        var c0 = text.clip_new()
        text.clip_reset(mut c0)
        assert(text.clip_write(mut c0, value(bytes_of("fallback")), '+' as int), "queued")
        text.clip_after_render(mut c0, mut r, mut terminal, time_now_ms())
        pump_until_idle(mut c0, mut r)
        assert(terminal.len == 0, "no OSC 52 past the limit")
        let (got, ok) = wait_file(f.output, 8)
        assert(ok && same(got[0..8], bytes_of("fallback")), "the local fallback wrote it")
        text.clip_shutdown(mut c0)
        unlink(f, "out.bin")
    }
    set("SSH_TTY", "/dev/pts/9")
    var c = text.clip_new()
    text.clip_reset(mut c)
    assert(text.clip_write(mut c, value(bytes_of("fallback")), '+' as int), "queued")
    text.clip_after_render(mut c, mut r, mut terminal, time_now_ms())
    assert(!text.clip_busy(c), "no writer over SSH")
    assert(!fs.exists(f.output), "nothing written")
    text.clip_shutdown(mut c)
    unlink(f, "wl-copy")
    fixture_free(f)
    restore_all(saved)
}

fn clipboard_sync_default_yank_not_delete() {
    if !fs.exists(fake_path()) {
        skip("clipboard_sync_default_yank_not_delete", NO_FAKE)
        return
    }
    let saved = save_all(["YEW_CLIPBOARD"])
    let f = fixture()
    set_custom(f, "write", false)
    var regs = text.reg_new()
    text.clip_reset(mut regs.clip)
    let v = value(bytes_of("sync"))
    assert(regs.clipboard_sync == text.CLIP_SYNC_YANK, "sync yank")
    text.reg_delete(mut regs, 0, v)
    assert(!text.clip_pending(regs.clip), "a delete is not synced")
    assert(regs.system.bytes.len == 0, "+ untouched")
    text.reg_yank(mut regs, 0, v)
    assert(text.clip_pending(regs.clip), "a yank is")
    assert(regs.system.bytes.len == 4, "+ holds it")
    if !fork_available() {
        skip("clipboard_sync_default_yank_not_delete's delivery half", NO_FORK)
    } else {
        var r = renderer()
        var terminal = List[byte]()
        text.clip_after_render(mut regs.clip, mut r, mut terminal, time_now_ms())
        pump_until_idle(mut regs.clip, mut r)
        let (got, ok) = wait_file(f.output, 4)
        assert(ok && same(got[0..4], bytes_of("sync")), "the yank delivered")
    }
    text.clip_shutdown(mut regs.clip)
    fixture_free(f)
    restore_all(saved)
}

fn clipboard_sync_modes_route_only_documented_writes() {
    if !fs.exists(fake_path()) {
        skip("clipboard_sync_modes_route_only_documented_writes", NO_FAKE)
        return
    }
    let saved = save_all(["YEW_CLIPBOARD"])
    let f = fixture()
    set_custom(f, "write", false)
    var regs = text.reg_new()
    text.clip_reset(mut regs.clip)
    let v = value(bytes_of("modes"))
    regs.clipboard_sync = text.CLIP_SYNC_OFF
    text.reg_yank(mut regs, 0, v)
    assert(!text.clip_pending(regs.clip), "off: a yank stays")
    text.reg_yank(mut regs, '+' as int, v)
    assert(text.clip_pending(regs.clip), "off: + still reaches it")
    text.clip_reset(mut regs.clip)
    regs.clipboard_sync = text.CLIP_SYNC_YANK
    text.reg_delete(mut regs, 0, v)
    assert(!text.clip_pending(regs.clip), "yank: a delete stays")
    text.reg_yank(mut regs, 0, v)
    assert(text.clip_pending(regs.clip), "yank: a yank goes")
    text.clip_reset(mut regs.clip)
    regs.clipboard_sync = text.CLIP_SYNC_ALL
    text.reg_delete(mut regs, 0, v)
    assert(text.clip_pending(regs.clip), "all: a delete goes")
    text.clip_reset(mut regs.clip)
    regs.clipboard_sync = text.CLIP_SYNC_UNNAMED
    text.reg_delete(mut regs, 0, v)
    assert(text.clip_pending(regs.clip), "unnamed: a delete goes")
    assert(same(regs.system.bytes, bytes_of("modes")), "+ holds it")
    text.clip_shutdown(mut regs.clip)
    fixture_free(f)
    restore_all(saved)
}

// `clip_captured_read_failure`, `test_clipboard.c:936-959`.
fn captured_read_failure() -> str {
    if warned("no readable") {
        return "clipboard read failed: no readable backend"
    }
    if warned("no read command") {
        return "clipboard read failed: backend has no read command"
    }
    if warned("cannot start reader") {
        return "clipboard read failed: cannot start reader"
    }
    if warned("timed out") {
        return "clipboard read failed: reader timed out"
    }
    if warned("poll failed") {
        return "clipboard read failed: poll failed"
    }
    if warned("read exceeds") {
        return "clipboard read failed: byte limit exceeded"
    }
    if warned("pipe failed") {
        return "clipboard read failed: pipe read failed"
    }
    if warned("wait failed") {
        return "clipboard read failed: waitpid failed"
    }
    if warned("exited with status") {
        return "clipboard read failed: reader exited nonzero"
    }
    if warned("terminated by signal") {
        return "clipboard read failed: reader was signaled"
    }
    "clipboard read failed without a diagnostic"
}

fn clipboard_unnamed_paste_reads_subprocess() {
    if !fs.exists(fake_path()) {
        skip("clipboard_unnamed_paste_reads_subprocess", NO_FAKE)
        return
    }
    if !fork_available() {
        skip("clipboard_unnamed_paste_reads_subprocess", NO_FORK)
        return
    }
    let saved = save_all(["YEW_CLIPBOARD"])
    let f = fixture()
    var payload = List[byte]()
    (mut payload).push(0 as byte)
    (mut payload).push('Q' as int as byte)
    fs.write_bytes(f.input, payload) else |_| {
        assert(false, "the input file")
    }
    set_custom(f, "write", true)
    var regs = text.reg_new()
    text.clip_reset(mut regs.clip)
    regs.clipboard_sync = text.CLIP_SYNC_UNNAMED
    let tb = text.textbuf_from_str("a")
    let undo = text.undo_new(tb)
    var ec = text.editctx_new(take tb)
    ec.cset = text.cset_init(text.cursor_at(text.byteoff(0)))
    ec.has_cset = true
    ec.undo = undo
    ec.has_undo = true
    ec.win_id = 7
    capture_log()
    let pasted = text.reg_paste(mut regs, mut ec, '"' as int, true, 8)
    assert(pasted, captured_read_failure())
    assert(text.textbuf_len(ec.tb) == 3, "three bytes")
    var want = List[byte]()
    (mut want).push(0 as byte)
    (mut want).push('Q' as int as byte)
    (mut want).push('a' as int as byte)
    assert(same(text.textbuf_bytes(ec.tb), want), "NUL Q a")
    assert(same(regs.system.bytes, payload), "+ holds the payload")
    assert(same(regs.unnamed.bytes, payload), "the unnamed register too")
    assert(regs.ring_len == 1, "one ring entry")
    assert(ec.undo.nodes.len == 2, "one undo node")
    text.clip_shutdown(mut regs.clip)
    fixture_free(f)
    restore_all(saved)
}

