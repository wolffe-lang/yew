//! member: false
//! Focused native smoke; pinned six script cases await shared flfix/VM.

use fl
use std.math.float as mf

fn main() {
    var vm = fl.fl_vm_new(take fl.fl_strings())
    vm.sp = 3
    vm.stack[0] = fl.fl_int(-9223372036854775807 - 1)
    assert(fl.fl_std_math_dispatch(mut vm, 0, 0, 1).i == -9223372036854775807 - 1)
    vm.stack[0] = fl.fl_float(-2.5)
    assert(fl.fl_std_math_dispatch(mut vm, 7, 0, 1).f == -3.0)
    vm.stack[0] = fl.fl_float(4.0)
    assert(fl.fl_std_math_dispatch(mut vm, 11, 0, 1).f == 2.0)
    vm.stack[0] = fl.fl_float(-1.0)
    assert(mf.is_nan(fl.fl_std_math_dispatch(mut vm, 11, 0, 1).f))
    vm.stack[0] = fl.fl_int(1)
    let _ = fl.fl_std_math_dispatch(mut vm, 27, 0, 1)
    let first = fl.fl_std_math_dispatch(mut vm, 28, 0, 0).f
    assert(first >= 0.0 && first < 1.0)
    let _ = fl.fl_std_math_dispatch(mut vm, 27, 0, 1)
    assert(fl.fl_std_math_dispatch(mut vm, 28, 0, 0).f == first)
    vm.stack[0] = fl.fl_int(-9223372036854775807 - 1)
    vm.stack[1] = fl.fl_int(9223372036854775807)
    let _ = fl.fl_std_math_dispatch(mut vm, 28, 0, 2)
    assert(!vm.raised)
    vm.stack[0] = fl.fl_int(10)
    vm.stack[1] = fl.fl_int(3)
    assert(fl.fl_std_math_dispatch(mut vm, 1, 0, 2).i == 3)
    assert(fl.fl_std_math_dispatch(mut vm, 2, 0, 2).i == 10)
    assert(fl.fl_math_defs().len == 29)
    print("math native smoke: PASS (six C script cases pending VM/flfix)")
}
