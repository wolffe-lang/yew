//! member: false
//! Component rows for canonical qualified states, bounds and deterministic
//! ids (sagitta src/syn/engine.c at 9ace98c2), beside the one-for-one ports
//! in syn_state_test.lu and syn_state2_test.lu. The packed four-byte id
//! vector additionally guards the per-line budget.

use syn

fn root_reserved() {
    var tab = syn.syn_state_tab_new(7)
    assert(syn.syn_state_count(tab) == 2, "UNKNOWN and ROOT reserved")
    assert(syn.syn_state_has(tab, 1), "root exists")
    let root = syn.syn_state_get(tab, 1) else syn.syn_state_root(0, 0)
    assert(syn.syn_state_ctx(root, 0) == 7, "root context")
    assert(syn.syn_state_depth(root) == 1, "root depth")
    assert(syn.syn_state_ndef(root) == 1, "root definition depth")
    assert(syn.syn_state_intern(mut tab, root) == 1, "root canonical id")
    assert(!syn.syn_state_has(tab, 0), "UNKNOWN not a state")
    assert(!syn.syn_state_has(tab, 2), "past end not a state")
}

fn equal_identity() {
    var tab = syn.syn_state_tab_new(0)
    var state = syn.syn_state_root(0, 0)
    syn.syn_state_set_aux(mut state, 0, 91)
    syn.syn_state_set_flags(mut state, syn.SYN_F_VALUE)
    let first = syn.syn_state_intern(mut tab, state)
    assert(first > 1, "new state allocated")
    var i = 0
    while i < 40 {
        assert(syn.syn_state_intern(mut tab, state) == first, "equal tuples share identity")
        i += 1
    }
    assert(syn.syn_state_count(tab) == 3, "one new tuple")
}

fn distinct_identity() {
    var tab = syn.syn_state_tab_new(0)
    var state = syn.syn_state_root(0, 0)
    var i = 0
    while i < 40 {
        syn.syn_state_set_aux(mut state, 0, i + 1)
        assert(syn.syn_state_intern(mut tab, state) == i + 2, "distinct ids in insertion order")
        i += 1
    }
    assert(syn.syn_state_count(tab) == 42, "40 new tuples")
}

fn depth_balance() {
    var state = syn.syn_state_root(0, 2)
    let entry = copy state
    var i = 0
    while i < 40 {
        syn.syn_state_push(mut state, i + 1)
        i += 1
    }
    assert(syn.syn_state_depth(state) == 16, "depth cap")
    assert(syn.syn_state_lost(state) == 25, "refused pushes retained")
    i = 0
    while i < 16 {
        assert(syn.syn_state_def(state, i) == 2, "qualified pushes inherit definition")
        i += 1
    }
    i = 0
    while i < 40 {
        syn.syn_state_pop(mut state, 1)
        i += 1
    }
    assert(syn.syn_state_equal(state, entry), "40 pushes and pops balance exactly")
}

fn lost_saturates() {
    var state = syn.syn_state_root(0, 0)
    var i = 1
    while i < 316 {
        syn.syn_state_push(mut state, i)
        i += 1
    }
    assert(syn.syn_state_lost(state) == 255, "lost saturates")
    assert(syn.syn_state_flags(state) & syn.SYN_F_DEGRADED != 0, "degraded after saturation")
    syn.syn_state_pop(mut state, 4)
    assert(syn.syn_state_lost(state) == 251, "debt paid first")
    assert(syn.syn_state_depth(state) == 16, "debt protects active stack")
}

fn root_protected() {
    var state = syn.syn_state_root(17, 3)
    syn.syn_state_set_aux(mut state, 0, 12)
    syn.syn_state_set_flags(mut state, syn.SYN_F_VALUE)
    let entry = copy state
    syn.syn_state_pop(mut state, 1)
    syn.syn_state_pop(mut state, 4)
    assert(syn.syn_state_equal(state, entry), "root pop leaves full tuple unchanged")
}

fn set_top() {
    var state = syn.syn_state_root(3, 2)
    syn.syn_state_push(mut state, 4)
    syn.syn_state_push(mut state, 5)
    syn.syn_state_set_frame_flags(mut state, 2, syn.SYN_FR_BRIDGE)
    syn.syn_state_set(mut state, 77)
    assert(syn.syn_state_depth(state) == 3, "set keeps depth")
    assert(syn.syn_state_ctx(state, 0) == 3, "root unchanged")
    assert(syn.syn_state_ctx(state, 1) == 4, "parent unchanged")
    assert(syn.syn_state_ctx(state, 2) == 77, "top replaced")
    assert(syn.syn_state_def(state, 2) == 2, "definition preserved")
    assert(syn.syn_state_frame_flags(state, 2) == syn.SYN_FR_BRIDGE, "bridge flags preserved")
    syn.syn_state_pop(mut state, 1)
    assert(syn.syn_state_ctx(state, 2) == 0, "vacated context zero")
    assert(syn.syn_state_def(state, 2) == 0, "vacated definition zero")
    assert(syn.syn_state_frame_flags(state, 2) == 0, "vacated flags zero")
}

fn canonical_tails() {
    var tab = syn.syn_state_tab_new(0)
    var clean = syn.syn_state_root(9, 2)
    syn.syn_state_set_aux(mut clean, 0, 42)
    syn.syn_state_set_flags(mut clean, syn.SYN_F_EMBED_PEND)
    var dirty = copy clean
    var i = 1
    while i < 16 {
        syn.syn_state_set_frame(mut dirty, i, 100 + i, i % 4, 255)
        i += 1
    }
    i = 1
    let poison: int = 2779054080
    while i < 4 {
        syn.syn_state_set_aux(mut dirty, i, poison + i)
        i += 1
    }
    let clean_id = syn.syn_state_intern(mut tab, clean)
    assert(syn.syn_state_intern(mut tab, dirty) == clean_id, "unused tails canonicalized")
    assert(syn.syn_state_ctx(dirty, 1) == 101, "intern does not mutate caller")
    assert(syn.syn_state_has(tab, clean_id), "stored state exists")
    let stored = syn.syn_state_get(tab, clean_id) else syn.syn_state_root(0, 0)
    assert(syn.syn_state_ctx(stored, 1) == 0, "stored frame tail zero")
    assert(syn.syn_state_aux(stored, 1) == 0, "stored aux tail zero")
    assert(syn.syn_state_bytes(stored) == 84, "qualified state byte budget")
}

fn cross_definition() {
    var tab = syn.syn_state_tab_new(5)
    let a = syn.syn_state_root(5, 1)
    let b = syn.syn_state_root(5, 2)
    let aid = syn.syn_state_intern(mut tab, a)
    let bid = syn.syn_state_intern(mut tab, b)
    assert(aid != bid, "same context in different definitions differs")
    assert(syn.syn_state_intern(mut tab, a) == aid, "first qualified tuple retained")
    assert(syn.syn_state_intern(mut tab, b) == bid, "second qualified tuple retained")
}

fn embedded_debt() {
    var state = syn.syn_state_root(3, 0)
    syn.syn_state_push(mut state, 4)
    syn.syn_state_set_flags(mut state, syn.SYN_F_EMBED_LOST)
    syn.syn_state_set_lost(mut state, 4)
    syn.syn_state_pop(mut state, 2)
    assert(syn.syn_state_lost(state) == 2, "normal debt paid")
    assert(syn.syn_state_depth(state) == 2, "embedded debt protected")
    syn.syn_state_pop(mut state, 1)
    assert(syn.syn_state_depth(state) == 1, "protected embed debt allows local pop")
    assert(syn.syn_state_lost(state) == 2, "embed debt kept for boundary")
}

fn packed_ids() {
    var ids = syn.syn_ids_new()
    var i = 0
    while i < 10000 {
        syn.syn_ids_push(mut ids, i * 17)
        i += 1
    }
    assert(syn.syn_ids_len(ids) == 10000, "10,000 entries")
    assert(syn.syn_ids_bytes(ids) == 40000, "four bytes per line")
    syn.syn_ids_splice(mut ids, 5000, 2, 4)
    assert(syn.syn_ids_len(ids) == 10002, "single splice length")
    assert(syn.syn_ids_get(ids, 4999) == 4999 * 17, "prefix retained")
    assert(syn.syn_ids_get(ids, 5000) == 0, "inserted entry unknown")
    assert(syn.syn_ids_get(ids, 5003) == 0, "all inserted entries unknown")
    assert(syn.syn_ids_get(ids, 5004) == 5002 * 17, "tail retained")
    syn.syn_ids_splice(mut ids, 0, 10002, 0)
    assert(syn.syn_ids_len(ids) == 0, "whole delete")
}

// `n - 1` distinct tuples keep insertion ids through every rehash, and a
// replay finds each again.
fn interner_growth_n(n: int) {
    var tab = syn.syn_state_tab_new(0)
    var state = syn.syn_state_root(0, 0)
    var i = 1
    while i < n {
        syn.syn_state_set_aux(mut state, 0, i)
        assert(syn.syn_state_intern(mut tab, state) == i + 1, "rehash keeps insertion ids")
        i += 1
    }
    i = 1
    while i < n {
        syn.syn_state_set_aux(mut state, 0, i)
        assert(syn.syn_state_intern(mut tab, state) == i + 1, "lookup after rehash")
        i += 1
    }
}

fn interner_growth() {
    interner_growth_n(2048)
}

// Checked twin of interner_growth and exhaustion (and of the exhaustion
// case in syn_state_test.lu): the same rehash and lookup path at half the
// largest size the checked machine was measured to fit.
fn interner_growth_checked() {
    interner_growth_n(512)
}

fn exhaustion() {
    var tab = syn.syn_state_tab_new(0)
    var state = syn.syn_state_root(0, 0)
    var last = 0
    var i = 1
    while i < 65544 {
        syn.syn_state_set_aux(mut state, 0, i)
        last = syn.syn_state_intern(mut tab, state)
        i += 1
    }
    assert(tab.exhausted, "exhaustion reported")
    assert(syn.syn_state_count(tab) == 65536, "state bound enforced")
    assert(last == 1, "exhaustion degrades to root")
    syn.syn_state_set_aux(mut state, 0, 1)
    assert(syn.syn_state_intern(mut tab, state) == 2, "existing state still found after exhaustion")
}

fn main() {
    let selected = (env_get("YEW_SYN_STATE_CASE") else "-1").to_int() else -1
    var i = 0
    while i < 14 {
        if selected == -1 || selected == i {
            match i {
                0 => root_reserved(),
                1 => equal_identity(),
                2 => distinct_identity(),
                3 => depth_balance(),
                4 => lost_saturates(),
                5 => root_protected(),
                6 => set_top(),
                7 => canonical_tails(),
                8 => cross_definition(),
                9 => embedded_debt(),
                10 => packed_ids(),
                11 => interner_growth(),
                12 => exhaustion(),
                _ => interner_growth_checked(),
            }
            print("syn_state_case_{i}: PASS")
        }
        i += 1
    }
}
