//! member: false
//!
//! The port of sagitta `tests/unit/test_ctxmenu.c` (848 lines), one test
//! per C test in registry order (`tests/unit/registry.c:2667-2690`, 24
//! cases): the widget's geometry, navigation, target capture, the
//! payload-reading handler made fatal, the bordered box, the hover by
//! geometry, shedding and the width clamp. C's widget is a file static;
//! the port's is a `CtxMenu` value — a case that never needs an editor
//! holds its own (`edit.ctxmenu_new()`), and a case that does uses the
//! editor's (`ed.ctx`), as C's router does.
//!
//! **The router's cases.** `ctxmenu_acts_on_the_target_captured_at_open`,
//! `ctxmenu_group_menu_captures_the_gid` and `ctxmenu_right_click_in_a_
//! pane_opens_the_document_menu` open their menus with a RIGHT PRESS
//! through `yew_mouse_event`; the right press is the router's
//! (`press_menu`, `mouse.c:1324-1347`), the yw06-mouse fork's. Until that
//! fork's press routing merges they say SKIP by name, counted (R-yw06-2 =
//! A: the router's cases are gated as a set at the end).
//!
//! **The child role.** `ctxmenu_a_row_handler_reading_a_payload_is_a_bug`
//! re-runs this test as a child that freezes the region table and asks
//! it a question (the deliberately wrong handler, `test_ctxmenu.c:464-
//! 484`); the child must die by C's `YEW_BUG` (exit 4) with "captured at
//! open time" on stderr. On the checked machine `os_exe()` is `wolf`
//! (G23): the case says SKIP there, loudly, and runs on the native lane.
//!
//! `YEW_CTX_CASE=N` runs case N alone (0-based, registry order), for the
//! checked machine's per-case runs (G29).

use edit
use std.fs
use std.process
use term

const CX_A: int = 11

const CX_B: int = 22

const CX_C: int = 33

const CX_D: int = 44

const CX_E: int = 55

const CHILD_ERR: str = "target/tests/ctxmenu-child.err"

fn say_skip(what: str) -> int {
    print("ctxmenu_test: SKIP {what}")
    eprint("ctxmenu_test: SKIP {what}")
    1
}

fn screen() -> edit.Rect {
    edit.rect(0, 0, 80, 23)
}

// `cx_three_rows` (`test_ctxmenu.c:42-49`).
fn cx_three_rows(mut c: edit.CtxMenu) {
    edit.ctx_begin(mut c, edit.CTX_KIND_TAB)
    edit.ctx_item(mut c, "Close Tab", "C-w", CX_A, true, 0)
    edit.ctx_item(mut c, "Close Other Tabs", "", CX_B, false, 0)
    edit.ctx_sep(mut c)
    edit.ctx_item(mut c, "Copy Path", "", CX_C, true, 0)
}

// `cx_priority_rows` (`:56-67`): one row per priority, each section closed
// by a separator.
fn cx_priority_rows(mut c: edit.CtxMenu) {
    edit.ctx_begin(mut c, edit.CTX_KIND_TAB)
    edit.ctx_item(mut c, "Keep A", "", CX_A, true, 0)
    edit.ctx_item(mut c, "Keep B", "", CX_B, true, 0)
    edit.ctx_sep(mut c)
    edit.ctx_item(mut c, "Maybe C", "", CX_C, true, 1)
    edit.ctx_sep(mut c)
    edit.ctx_item(mut c, "Maybe D", "", CX_D, true, 2)
    edit.ctx_sep(mut c)
    edit.ctx_item(mut c, "Shed E", "", CX_E, true, 3)
}

// `cx_wide_rows` (`:69-77`): 30 label cells and a 7-cell accelerator.
fn cx_wide_rows(mut c: edit.CtxMenu) {
    edit.ctx_begin(mut c, edit.CTX_KIND_TAB)
    edit.ctx_item(mut c, "Absolutely Enormous Label Here", "C-x C-c", CX_A, true, 0)
    edit.ctx_item(mut c, "Small", "C-w", CX_B, true, 0)
}

// `cx_key` (`:161-170`).
fn cx_key(code: int) -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    k.code = code
    k
}

// A right press at a cell (`test_ctxmenu.c:314-322`).
fn right_press(x: int, y: int) -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_MOUSE
    k.button = term.MB_RIGHT
    k.ev = term.KEY_PRESS
    k.col = x
    k.row = y
    k
}

// `cx_fixture` (`:275-293`): a scratch editor on a 24x80 grid with `extra`
// more tabs, laid out.
fn cx_fixture(extra: int) -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    var i = 0
    while i < extra {
        assert(edit.tab_open(mut ed, "/tmp/yew-ctx-{i}.txt") >= 0, "open tab {i}")
        i += 1
    }
    edit.ed_layout(mut ed)
    ed.now_ms = 1000
    ed
}

// ---- geometry ---------------------------------------------------------------

fn ctxmenu_placement_clamps_at_all_four_edges() {
    let allowed = edit.rect(0, 0, 80, 23)
    var c = edit.ctxmenu_new()
    // Bottom-right: the box slides back inside, it does not flip.
    cx_three_rows(mut c)
    assert(edit.ctx_show(mut c, 79, 22, allowed), "shows at the corner")
    var box = edit.ctx_box(c)
    assert(box.x + box.w == allowed.x + allowed.w, "right edge clamped")
    assert(box.y + box.h == allowed.y + allowed.h, "bottom edge clamped")
    // NEVER FLIPS: a flip would have put box.y + box.h at the anchor.
    assert(box.y <= 22, "not flipped above the anchor")
    assert(box.h == edit.ctx_rows(c) + 2, "a bordered box")
    // Top-left: the corner one cell below-right of the anchor.
    cx_three_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, allowed), "shows at the origin")
    box = edit.ctx_box(c)
    assert(box.x == 1, "x below-right")
    assert(box.y == 1, "y below-right")
    // An allowed rectangle off the origin clamps to ITS edges.
    cx_three_rows(mut c)
    let inner = edit.rect(10, 5, 30, 10)
    assert(edit.ctx_show(mut c, 39, 14, inner), "shows inside")
    box = edit.ctx_box(c)
    assert(box.x >= inner.x, "inside on the left")
    assert(box.y >= inner.y, "inside at the top")
    assert(box.x + box.w == inner.x + inner.w, "clamped to its right")
    assert(box.y + box.h == inner.y + inner.h, "clamped to its bottom")
    edit.ctx_close(mut c)
}

fn ctxmenu_refuses_a_space_it_cannot_fit() {
    var c = edit.ctxmenu_new()
    cx_three_rows(mut c)
    assert(!edit.ctx_show(mut c, 0, 0, edit.rect(0, 0, 4, 20)), "too narrow")
    assert(!edit.ctx_active(c), "nothing open")
    cx_three_rows(mut c)
    assert(!edit.ctx_show(mut c, 0, 0, edit.rect(0, 0, 40, 2)), "too short")
    assert(!edit.ctx_active(c), "nothing open")
    // A menu with no rows is not a menu.
    edit.ctx_begin(mut c, edit.CTX_KIND_TAB)
    assert(!edit.ctx_show(mut c, 0, 0, screen()), "no rows")
    assert(!edit.ctx_active(c), "nothing open")
    edit.ctx_close(mut c)
}

fn ctxmenu_is_at_least_the_minimum_width() {
    var c = edit.ctxmenu_new()
    edit.ctx_begin(mut c, edit.CTX_KIND_TAB)
    edit.ctx_item(mut c, "x", "", CX_A, true, 0)
    edit.ctx_item(mut c, "y", "", CX_B, true, 0)
    assert(edit.ctx_show(mut c, 0, 0, screen()), "shows")
    assert(edit.ctx_box(c).w >= edit.CTX_MIN_WIDTH, "at least the minimum width")
    edit.ctx_close(mut c)
}

// ---- navigation -------------------------------------------------------------

fn ctxmenu_arrows_skip_separators_and_disabled_rows() {
    var c = edit.ctxmenu_new()
    cx_three_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, screen()), "shows")
    assert(edit.ctx_cursor(c) == 0, "the cursor starts on row 0")
    assert(!edit.ctx_row_enabled(c, 1), "row 1 disabled")
    assert(!edit.ctx_row_enabled(c, 2), "row 2 a separator")
    assert(edit.ctx_key(mut c, cx_key(term.KEY_DOWN)), "Down taken")
    // Row 1 is greyed and row 2 a separator: drawn, not reachable.
    assert(edit.ctx_cursor(c) == 3, "Down skips to row 3")
    assert(edit.ctx_key(mut c, cx_key(term.KEY_DOWN)), "Down taken")
    assert(edit.ctx_cursor(c) == 0, "wraps")
    assert(edit.ctx_key(mut c, cx_key(term.KEY_UP)), "Up taken")
    assert(edit.ctx_cursor(c) == 3, "Up wraps back")
    edit.ctx_close(mut c)
}

fn ctxmenu_enter_invokes_and_escape_closes() {
    var c = edit.ctxmenu_new()
    cx_three_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, screen()), "shows")
    assert(edit.ctx_key(mut c, cx_key(term.KEY_ENTER)), "Enter taken")
    assert(!edit.ctx_active(c), "Enter closes")
    assert(edit.ctx_take(mut c) == CX_A, "Enter chose row 0")
    // Taken once and only once.
    assert(edit.ctx_take(mut c) == 0, "taken once")
    cx_three_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, screen()), "shows")
    assert(edit.ctx_key(mut c, cx_key(term.KEY_ESCAPE)), "Esc taken")
    assert(!edit.ctx_active(c), "Esc closes")
    assert(edit.ctx_take(mut c) == 0, "Esc chose nothing")
    edit.ctx_close(mut c)
}

// An open menu SWALLOWS what it does not use.
fn ctxmenu_swallows_unhandled_keys() {
    var c = edit.ctxmenu_new()
    var d = cx_key(100)
    (mut d.text).push(100 as byte)
    cx_three_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, screen()), "shows")
    assert(edit.ctx_key(mut c, d), "d swallowed")
    assert(edit.ctx_active(c), "still open")
    assert(edit.ctx_take(mut c) == 0, "nothing chosen")
    edit.ctx_close(mut c)
    // Closed, it claims nothing.
    assert(!edit.ctx_key(mut c, d), "closed claims nothing")
}

fn ctxmenu_a_disabled_row_is_unreachable_by_pointer() {
    var c = edit.ctxmenu_new()
    cx_three_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, screen()), "shows")
    edit.ctx_hover(mut c, 1)
    assert(edit.ctx_cursor(c) == 0, "the greyed row takes no highlight")
    edit.ctx_hover(mut c, 2)
    assert(edit.ctx_cursor(c) == 0, "the separator takes no highlight")
    edit.ctx_invoke(mut c, 1)
    assert(edit.ctx_active(c), "the greyed row invokes nothing")
    assert(edit.ctx_take(mut c) == 0, "nothing chosen")
    edit.ctx_invoke(mut c, 3)
    assert(!edit.ctx_active(c), "row 3 invokes")
    assert(edit.ctx_take(mut c) == CX_C, "row 3 chosen")
    edit.ctx_close(mut c)
}

// Two menus can never both be open.
fn ctxmenu_two_menus_are_never_both_open() {
    var c = edit.ctxmenu_new()
    cx_three_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, screen()), "shows")
    assert(edit.ctx_kind(c) == edit.CTX_KIND_TAB, "a tab menu")
    edit.ctx_begin(mut c, edit.CTX_KIND_GROUP)
    assert(!edit.ctx_active(c), "beginning discards the first")
    edit.ctx_item(mut c, "Dissolve Group", "", CX_B, true, 0)
    assert(edit.ctx_show(mut c, 0, 0, screen()), "the second shows")
    assert(edit.ctx_kind(c) == edit.CTX_KIND_GROUP, "a group menu")
    assert(edit.ctx_rows(c) == 1, "its one row")
    edit.ctx_close(mut c)
}

// ---- target capture (DoD 4) -------------------------------------------------

// THE test (`:295-345`): a menu opened for tab 3, the strip scrolled so a
// different tab occupies those cells, the row invoked by keyboard — the
// ORIGINAL tab is what is acted on. Opens by right press (the router's).
fn ctxmenu_acts_on_the_target_captured_at_open() {
    var ed = cx_fixture(4)
    let target_id = ed.tabs[3].tab_id
    let other_id = ed.tabs[1].tab_id
    edit.tab_switch(mut ed, 0)
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_TAB, edit.rect(20, 0, 10, 1), 3)
    edit.mouse_event(mut ed, right_press(22, 0))
    assert(edit.ctx_active(ed.ctx), "the right press opens the menu")
    assert(edit.ctx_target_id(ed.ctx) == target_id, "the tab id captured")
    let captured = edit.ctx_target_path(ed.ctx) else ""
    assert(captured.len != 0, "the path captured")
    // The strip scrolls: those cells now name a different tab.
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_TAB, edit.rect(20, 0, 10, 1), 1)
    edit.mouse_menu_draw(mut ed)
    // Row 0 is Close Tab, invoked by keyboard.
    assert(edit.mouse_menu_key(mut ed, cx_key(term.KEY_ENTER)), "Enter taken")
    assert(edit.tab_index_of_id(ed, target_id) == -1, "the captured tab closed")
    assert(edit.tab_index_of_id(ed, other_id) >= 0, "the tab under the cells did not")
    edit.ctx_close(mut ed.ctx)
}

// With the target CLOSED under the open menu the row does nothing at all
// (`:347-372`).
fn ctxmenu_target_closed_under_it_is_inert() {
    var ed = cx_fixture(4)
    let target_id = ed.tabs[3].tab_id
    edit.tab_switch(mut ed, 0)
    assert(edit.mouse_open_tab_menu(mut ed, target_id, 0, 1), "the tab menu opens")
    assert(edit.tab_close(mut ed, edit.tab_index_of_id(ed, target_id)), "closed under it")
    let count_before = edit.tab_count(ed)
    assert(edit.mouse_menu_key(mut ed, cx_key(term.KEY_ENTER)), "Enter taken")
    assert(edit.tab_count(ed) == count_before, "the row did nothing")
    edit.ctx_close(mut ed.ctx)
}

fn ctxmenu_group_menu_captures_the_gid() {
    var ed = cx_fixture(4)
    let g = edit.group_create(mut ed, "/src", "grp")
    edit.group_add_member(mut ed, g, 3)
    edit.group_add_member(mut ed, g, 4)
    edit.tab_switch(mut ed, 0)
    edit.ed_layout(mut ed)
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_TAB, edit.rect(20, 0, 10, 1), 0 - g)
    edit.mouse_event(mut ed, right_press(22, 0))
    assert(edit.ctx_active(ed.ctx), "the right press opens the menu")
    assert(edit.ctx_kind(ed.ctx) == edit.CTX_KIND_GROUP, "a group menu")
    assert(edit.ctx_target_id(ed.ctx) == g, "the gid captured")
    // A group menu has no path to capture.
    let path = edit.ctx_target_path(ed.ctx) else "<none>"
    assert(path == "<none>", "no path")
    edit.ctx_close(mut ed.ctx)
}

// Sprint 57.13 supersedes Sprint 27 §9 (`:408-451`).
fn ctxmenu_right_click_in_a_pane_opens_the_document_menu() {
    var ed = cx_fixture(1)
    edit.pane_tables_reset(mut ed)
    assert(edit.pane_table_add_leaf(mut ed, ed.pane_root) == 0, "leaf 0")
    edit.region_frame_begin(mut ed.regions)
    let pr = copy ed.panes[ed.pane_root].rect
    edit.region_add(mut ed.regions, edit.REGION_PANE, pr, 0)
    edit.mouse_event(mut ed, right_press(10, 5))
    assert(edit.ctx_active(ed.ctx), "the right press opens the menu")
    assert(edit.ctx_kind(ed.ctx) == edit.CTX_KIND_DOC, "the document menu")
    assert(edit.ctx_target_id(ed.ctx) == 0, "the leaf index")
    let cell = edit.ctx_target_rect_get(ed.ctx)
    assert(cell.x == 10, "the clicked column")
    assert(cell.y == 5, "the clicked row")
    assert(edit.ctx_rows(ed.ctx) > 0, "rows")
    edit.ctx_close(mut ed.ctx)
}

// ---- the payload law, made fatal --------------------------------------------

// The deliberately wrong handler (`:457-484`), in the child: a hit-test
// while the table is frozen.
fn child_payload_bug() -> int {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    var rs = edit.regions_new()
    edit.region_frame_begin(mut rs)
    edit.region_add(mut rs, edit.REGION_TAB, edit.rect(0, 0, 8, 1), 3)
    edit.region_freeze(mut rs, true)
    let _ = edit.region_hit(mut rs, 1, 0)
    99
}

fn self_reexecutes(exe: str) -> bool {
    var c = process.command(exe)
    process.push_arg(mut c, "--self-check")
    let sink = fs.open_append("/dev/null") else |_| {
        return false
    }
    process.set_stderr(mut c, sink)
    process.set_stdout(mut c, sink)
    let child = process.start(c) else |_| {
        return false
    }
    let status = process.wait_status(take child) else -1
    fs.close(take sink) else |_| {}
    status == 7
}

fn contains_bytes(hay: List[byte], needle: str) -> bool {
    let n = needle.len
    var i = 0
    while i + n <= hay.len {
        var j = 0
        while j < n && hay[i + j] == needle.bytes()[j] {
            j += 1
        }
        if j == n {
            return true
        }
        i += 1
    }
    false
}

fn ctxmenu_a_row_handler_reading_a_payload_is_a_bug() -> int {
    let exe = os_exe() else {
        return say_skip("ctxmenu_a_row_handler_reading_a_payload_is_a_bug: no os_exe()")
    }
    if !self_reexecutes(exe) {
        return say_skip(
            "ctxmenu_a_row_handler_reading_a_payload_is_a_bug: os_exe() does not re-run this test here (the checked machine, G23); the native lane runs it",
        )
    }
    fs.remove(CHILD_ERR) else |_| {}
    var c = process.command(exe)
    process.push_arg(mut c, "--payload-bug")
    let sink = fs.create_with_mode(CHILD_ERR, 0o600) else |_| {
        assert(false, "open the stderr capture")
        return 0
    }
    process.set_stderr(mut c, sink)
    let child = process.start(c) else |_| {
        assert(false, "spawn the child")
        return 0
    }
    let status = process.wait_status(take child) else -1
    fs.close(take sink) else |_| {}
    assert(status == 4, "the child dies by YEW_BUG (exit 4), got {status}")
    let err = fs.read_bytes(CHILD_ERR) else List[byte]()
    assert(contains_bytes(err, "captured at open time"), "the bug names the law")
    // And an unfrozen table answers normally: the guard is not always on.
    var rs = edit.regions_new()
    edit.region_add(mut rs, edit.REGION_TAB, edit.rect(0, 0, 8, 1), 3)
    assert(!edit.region_frozen(rs), "unfrozen")
    assert(edit.region_hit(mut rs, 1, 0).payload == 3, "and answers")
    0
}

// ---- Sprint 57.13 §2: the bordered box --------------------------------------

fn ctxmenu_box_is_bordered_below_right_of_the_anchor() {
    var c = edit.ctxmenu_new()
    cx_three_rows(mut c)
    assert(edit.ctx_show(mut c, 10, 4, screen()), "shows")
    let box = edit.ctx_box(c)
    assert(box.x == 11, "x below-right")
    assert(box.y == 5, "y below-right")
    // h = rows + 2; w = widest + 2·pad + 2 (`Close Other Tabs`, 16 cells).
    assert(box.h == edit.ctx_rows(c) + 2, "h")
    assert(box.w == 20, "w is 20, got {box.w}")
    assert(!edit.ctx_hover_at(mut c, 10, 4), "the anchor is no row")
    assert(!edit.ctx_hover_at(mut c, box.x, box.y), "the corner is no row")
    edit.ctx_close(mut c)
}

fn ctxmenu_pointer_origin_is_the_click_cell() {
    var c = edit.ctxmenu_new()
    cx_three_rows(mut c)
    assert(edit.ctx_show_at(mut c, 10, 4, screen()), "shows")
    let box = edit.ctx_box(c)
    assert(box.x == 10, "x on the click")
    assert(box.y == 4, "y on the click")
    assert(!edit.ctx_hover_at(mut c, 10, 4), "the click cell is the corner border")
    edit.ctx_close(mut c)
}

fn ctxmenu_hover_at_maps_cells_by_the_box_geometry() {
    var c = edit.ctxmenu_new()
    cx_three_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, screen()), "shows")
    let box = edit.ctx_box(c)
    assert(edit.ctx_cursor(c) == 0, "starts on row 0")
    // Row 3 is `Copy Path`: the highlight moves, so a repaint, once.
    assert(edit.ctx_hover_at(mut c, box.x + 1, box.y + 4), "moves to row 3")
    assert(edit.ctx_cursor(c) == 3, "row 3")
    assert(!edit.ctx_hover_at(mut c, box.x + 1, box.y + 4), "the same cell moves nothing")
    // Border cells on all four sides map to nothing.
    assert(!edit.ctx_hover_at(mut c, box.x + 1, box.y), "top border")
    assert(!edit.ctx_hover_at(mut c, box.x + 1, box.y + box.h - 1), "bottom border")
    assert(!edit.ctx_hover_at(mut c, box.x, box.y + 1), "left border")
    assert(!edit.ctx_hover_at(mut c, box.x + box.w - 1, box.y + 1), "right border")
    // So do the greyed row and the separator.
    assert(!edit.ctx_hover_at(mut c, box.x + 1, box.y + 2), "the greyed row")
    assert(!edit.ctx_hover_at(mut c, box.x + 1, box.y + 3), "the separator")
    // And cells outside the box.
    assert(!edit.ctx_hover_at(mut c, box.x + box.w, box.y + 1), "right of the box")
    assert(!edit.ctx_hover_at(mut c, box.x + 1, box.y + box.h), "below the box")
    assert(edit.ctx_cursor(c) == 3, "none of which moved the highlight")
    assert(edit.ctx_hover_at(mut c, box.x + 1, box.y + 1), "back to row 0")
    assert(edit.ctx_cursor(c) == 0, "row 0")
    edit.ctx_close(mut c)
    // Closed, it hovers nothing rather than reading a stale box.
    assert(!edit.ctx_hover_at(mut c, 1, 1), "closed hovers nothing")
}

fn ctxmenu_home_and_end_reach_the_first_and_last_rows() {
    var c = edit.ctxmenu_new()
    cx_three_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, screen()), "shows")
    assert(edit.ctx_cursor(c) == 0, "starts on row 0")
    assert(edit.ctx_key(mut c, cx_key(term.KEY_END)), "End")
    assert(edit.ctx_cursor(c) == 3, "End reaches row 3")
    // Absolute, not relative.
    assert(edit.ctx_key(mut c, cx_key(term.KEY_END)), "End")
    assert(edit.ctx_cursor(c) == 3, "End stays")
    assert(edit.ctx_key(mut c, cx_key(term.KEY_HOME)), "Home")
    assert(edit.ctx_cursor(c) == 0, "Home reaches row 0")
    assert(edit.ctx_key(mut c, cx_key(term.KEY_HOME)), "Home")
    assert(edit.ctx_cursor(c) == 0, "Home stays")
    // End then Up skips the separator and the greyed row above it.
    assert(edit.ctx_key(mut c, cx_key(term.KEY_END)), "End")
    assert(edit.ctx_key(mut c, cx_key(term.KEY_UP)), "Up")
    assert(edit.ctx_cursor(c) == 0, "Up skips to row 0")
    edit.ctx_close(mut c)
}

// ---- Sprint 57.13 §2: shedding ----------------------------------------------

fn ctxmenu_sheds_the_lowest_priorities_first() {
    var c = edit.ctxmenu_new()
    // Room for everything: nothing sheds; separators carry the priority
    // above them.
    cx_priority_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, edit.rect(0, 0, 40, 20)), "shows")
    assert(edit.ctx_rows(c) == 8, "eight rows")
    assert(edit.ctx_shed_count(c) == 0, "none shed")
    assert(edit.ctx_priority(c, 2) == 0, "sep 2 inherits 0")
    assert(edit.ctx_priority(c, 4) == 1, "sep 4 inherits 1")
    assert(edit.ctx_priority(c, 6) == 2, "sep 6 inherits 2")
    // Seven rows of room: priority 3 goes with the separator it orphaned.
    cx_priority_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, edit.rect(0, 0, 40, 9)), "shows")
    assert(edit.ctx_rows(c) == 6, "six rows")
    assert(edit.ctx_shed_count(c) == 2, "two shed")
    assert(edit.ctx_priority(c, 5) == 2, "row 5 is priority 2")
    // Four rows of room: priority 2 goes as well.
    cx_priority_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, edit.rect(0, 0, 40, 6)), "shows")
    assert(edit.ctx_rows(c) == 4, "four rows")
    assert(edit.ctx_priority(c, 3) == 1, "row 3 is priority 1")
    // Three and two rows of room give the SAME menu: a whole level a time.
    cx_priority_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, edit.rect(0, 0, 40, 5)), "shows")
    assert(edit.ctx_rows(c) == 2, "two rows")
    cx_priority_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, edit.rect(0, 0, 40, 4)), "shows")
    assert(edit.ctx_rows(c) == 2, "two rows")
    assert(edit.ctx_priority(c, 0) == 0, "row 0 is priority 0")
    assert(edit.ctx_priority(c, 1) == 0, "row 1 is priority 0")
    edit.ctx_close(mut c)
}

// Refusing is the LAST resort (`:644-666`).
fn ctxmenu_refuses_only_when_priority_zero_rows_do_not_fit() {
    var c = edit.ctxmenu_new()
    cx_priority_rows(mut c)
    assert(!edit.ctx_show(mut c, 0, 0, edit.rect(0, 0, 40, 3)), "refuses")
    assert(!edit.ctx_active(c), "nothing open")
    cx_priority_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, edit.rect(0, 0, 40, 4)), "opens shorn")
    assert(edit.ctx_active(c), "open")
    assert(edit.ctx_rows(c) == 2, "two rows")
    assert(edit.ctx_shed_count(c) == 6, "six shed")
    assert(edit.ctx_cursor(c) == 0, "the cursor lands on a survivor")
    edit.ctx_close(mut c)
}

// Invariant 5 (`:668-702`).
fn ctxmenu_shedding_is_deterministic() {
    var c = edit.ctxmenu_new()
    var pri = List[int]()
    var rows = 0
    var shed = 0
    var box = edit.rect(0, 0, 0, 0)
    var pass = 0
    while pass < 2 {
        cx_priority_rows(mut c)
        assert(edit.ctx_show(mut c, 3, 2, edit.rect(0, 0, 40, 6)), "shows")
        if pass == 0 {
            rows = edit.ctx_rows(c)
            shed = edit.ctx_shed_count(c)
            box = edit.ctx_box(c)
            var i = 0
            while i < rows {
                (mut pri).push(edit.ctx_priority(c, i))
                i += 1
            }
        } else {
            assert(edit.ctx_rows(c) == rows, "same rows")
            assert(edit.ctx_shed_count(c) == shed, "same shed")
            let b = edit.ctx_box(c)
            assert(b.x == box.x && b.y == box.y && b.w == box.w && b.h == box.h, "same box")
            var i = 0
            while i < rows {
                assert(edit.ctx_priority(c, i) == pri[i], "same priority {i}")
                i += 1
            }
        }
        pass += 1
    }
    edit.ctx_close(mut c)
}

// A separator is punctuation, not a row (`:704-731`).
fn ctxmenu_separators_never_lead_trail_or_double() {
    var c = edit.ctxmenu_new()
    edit.ctx_begin(mut c, edit.CTX_KIND_TAB)
    edit.ctx_sep(mut c)
    edit.ctx_sep(mut c)
    edit.ctx_item(mut c, "One", "", CX_A, true, 0)
    edit.ctx_sep(mut c)
    edit.ctx_sep(mut c)
    edit.ctx_item(mut c, "Two", "", CX_B, true, 0)
    edit.ctx_sep(mut c)
    edit.ctx_sep(mut c)
    assert(edit.ctx_show(mut c, 0, 0, edit.rect(0, 0, 40, 20)), "shows")
    assert(edit.ctx_rows(c) == 3, "One, a rule, Two")
    assert(edit.ctx_row_enabled(c, 0), "One")
    assert(!edit.ctx_row_enabled(c, 1), "the rule")
    assert(edit.ctx_row_enabled(c, 2), "Two")
    var i = 0
    while i < edit.ctx_rows(c) {
        assert(edit.ctx_priority(c, i) == 0, "priority 0")
        i += 1
    }
    edit.ctx_close(mut c)
}

// ---- Sprint 57.13 §2: the width clamp ---------------------------------------

fn ctxmenu_width_clamp_drops_accels_before_clipping_labels() {
    var c = edit.ctxmenu_new()
    // Room for label, gap and accelerator: the column stays.
    cx_wide_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, edit.rect(0, 0, 60, 20)), "shows")
    assert(!edit.ctx_accels_hidden(c), "accelerators kept")
    assert(edit.ctx_box(c).w == 43, "43 wide, got {edit.ctx_box(c).w}")
    // Four cells short: the ACCELERATORS go, as a column.
    cx_wide_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, edit.rect(0, 0, 40, 20)), "shows")
    assert(edit.ctx_accels_hidden(c), "accelerators dropped")
    assert(edit.ctx_box(c).w == 34, "34 wide")
    // Narrower still: only now are the labels clipped.
    cx_wide_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, edit.rect(0, 0, 24, 20)), "shows")
    assert(edit.ctx_accels_hidden(c), "accelerators dropped")
    assert(edit.ctx_box(c).w == 24, "24 wide")
    // No accelerators at all, squeezed the same way: nothing hidden.
    edit.ctx_begin(mut c, edit.CTX_KIND_TAB)
    edit.ctx_item(mut c, "Absolutely Enormous Label Here", "", CX_A, true, 0)
    assert(edit.ctx_show(mut c, 0, 0, edit.rect(0, 0, 24, 20)), "shows")
    assert(!edit.ctx_accels_hidden(c), "nothing hidden")
    assert(edit.ctx_box(c).w == 24, "24 wide")
    edit.ctx_close(mut c)
}

// `cx_assert_glyph` (`:772-779`).
fn cx_assert_glyph(g: term.Grid, row: int, col: int, want: int, what: str) {
    let cell = term.grid_back(g, row, col)
    assert(cell.flags & term.CELL_INTERNED == 0, "{what}: inline")
    let s = edit.glyph(want)
    var i = 0
    while i < s.len {
        assert(term.cell_byte(cell, i) == s.bytes()[i] as int, "{what}: byte {i}")
        i += 1
    }
}

// The frame is drawn from the glyph table, and the label is CLIPPED to
// the room the row has (`:781-821`).
fn ctxmenu_draw_frames_the_box_and_clips_inside_it() {
    var ed = cx_fixture(0)
    var c = edit.ctxmenu_new()
    cx_wide_rows(mut c)
    assert(edit.ctx_show(mut c, 0, 0, edit.rect(0, 0, 24, 20)), "shows")
    let box = edit.ctx_box(c)
    assert(box.w == 24, "24 wide")
    edit.region_frame_begin(mut ed.regions)
    edit.ctx_draw(c, mut ed.grid, mut ed.regions, edit.ctx_style_plain())
    let r = box.x + box.w - 1
    let b = box.y + box.h - 1
    cx_assert_glyph(ed.grid, box.y, box.x, edit.GLYPH_BORDER_TL, "top-left")
    cx_assert_glyph(ed.grid, box.y, r, edit.GLYPH_BORDER_TR, "top-right")
    cx_assert_glyph(ed.grid, b, box.x, edit.GLYPH_BORDER_BL, "bottom-left")
    cx_assert_glyph(ed.grid, b, r, edit.GLYPH_BORDER_BR, "bottom-right")
    cx_assert_glyph(ed.grid, box.y, box.x + 1, edit.GLYPH_BORDER_H, "top rule")
    var y = box.y + 1
    while y < b {
        cx_assert_glyph(ed.grid, y, box.x, edit.GLYPH_BORDER_V, "left side")
        cx_assert_glyph(ed.grid, y, r, edit.GLYPH_BORDER_V, "right side")
        y += 1
    }
    // The label starts one pad cell in, and stops before the frame.
    let first = term.grid_back(ed.grid, box.y + 1, box.x + 2)
    assert(term.cell_byte(first, 0) == 65, "the label's A one pad in")
    edit.ctx_close(mut c)
}

// The document menu's target is a RECT, captured at open and cleared by
// the next begin (`:823-848`).
fn ctxmenu_captures_a_target_rect() {
    var c = edit.ctxmenu_new()
    edit.ctx_begin(mut c, edit.CTX_KIND_TAB)
    edit.ctx_target(mut c, 7, "/tmp/yew-ctx-rect.txt", true)
    edit.ctx_target_rect(mut c, edit.rect(3, 9, 1, 1))
    var got = edit.ctx_target_rect_get(c)
    assert(got.x == 3, "x")
    assert(got.y == 9, "y")
    assert(edit.ctx_target_id(c) == 7, "id")
    edit.ctx_begin(mut c, edit.CTX_KIND_GROUP)
    got = edit.ctx_target_rect_get(c)
    assert(got.x == 0 && got.y == 0 && got.w == 0 && got.h == 0, "cleared")
    let path = edit.ctx_target_path(c) else "<none>"
    assert(path == "<none>", "the path cleared")
    edit.ctx_close(mut c)
}

// The router's right press is the yw06-mouse fork's (this file's header):
// `YEW_CTX_ROUTER=1` runs its three cases, for the merge that brings it.
fn router_ready() -> bool {
    (env_get("YEW_CTX_ROUTER") else "") == "1"
}

fn router_skip(name: str) -> int {
    say_skip("{name}: the right press is the router's (press_menu, mouse.c:1324-1347), the yw06-mouse fork's (R-yw06-2)")
}

fn main() {
    fs.create_dir_all("target/tests") else |_| {}
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let args = env_args()
    if args.len == 1 && args[0] == "--self-check" {
        os_exit(7)
    }
    if args.len == 1 && args[0] == "--payload-bug" {
        os_exit(child_payload_bug())
    }
    let chosen = (env_get("YEW_CTX_CASE") else "-1").to_int() else -1
    var skips = 0
    var ran = 0
    var n = 0
    while n < 24 {
        if chosen >= 0 && chosen != n {
            n += 1
            continue
        }
        var name = ""
        var skipped = 0
        if n == 0 {
            name = "ctxmenu_placement_clamps_at_all_four_edges"
            ctxmenu_placement_clamps_at_all_four_edges()
        } else if n == 1 {
            name = "ctxmenu_refuses_a_space_it_cannot_fit"
            ctxmenu_refuses_a_space_it_cannot_fit()
        } else if n == 2 {
            name = "ctxmenu_is_at_least_the_minimum_width"
            ctxmenu_is_at_least_the_minimum_width()
        } else if n == 3 {
            name = "ctxmenu_arrows_skip_separators_and_disabled_rows"
            ctxmenu_arrows_skip_separators_and_disabled_rows()
        } else if n == 4 {
            name = "ctxmenu_enter_invokes_and_escape_closes"
            ctxmenu_enter_invokes_and_escape_closes()
        } else if n == 5 {
            name = "ctxmenu_swallows_unhandled_keys"
            ctxmenu_swallows_unhandled_keys()
        } else if n == 6 {
            name = "ctxmenu_a_disabled_row_is_unreachable_by_pointer"
            ctxmenu_a_disabled_row_is_unreachable_by_pointer()
        } else if n == 7 {
            name = "ctxmenu_two_menus_are_never_both_open"
            ctxmenu_two_menus_are_never_both_open()
        } else if n == 8 {
            name = "ctxmenu_acts_on_the_target_captured_at_open"
            if router_ready() {
                ctxmenu_acts_on_the_target_captured_at_open()
            } else {
                skipped = router_skip(name)
            }
        } else if n == 9 {
            name = "ctxmenu_target_closed_under_it_is_inert"
            ctxmenu_target_closed_under_it_is_inert()
        } else if n == 10 {
            name = "ctxmenu_group_menu_captures_the_gid"
            if router_ready() {
                ctxmenu_group_menu_captures_the_gid()
            } else {
                skipped = router_skip(name)
            }
        } else if n == 11 {
            name = "ctxmenu_right_click_in_a_pane_opens_the_document_menu"
            if router_ready() {
                ctxmenu_right_click_in_a_pane_opens_the_document_menu()
            } else {
                skipped = router_skip(name)
            }
        } else if n == 12 {
            name = "ctxmenu_a_row_handler_reading_a_payload_is_a_bug"
            skipped = ctxmenu_a_row_handler_reading_a_payload_is_a_bug()
        } else if n == 13 {
            name = "ctxmenu_box_is_bordered_below_right_of_the_anchor"
            ctxmenu_box_is_bordered_below_right_of_the_anchor()
        } else if n == 14 {
            name = "ctxmenu_pointer_origin_is_the_click_cell"
            ctxmenu_pointer_origin_is_the_click_cell()
        } else if n == 15 {
            name = "ctxmenu_hover_at_maps_cells_by_the_box_geometry"
            ctxmenu_hover_at_maps_cells_by_the_box_geometry()
        } else if n == 16 {
            name = "ctxmenu_home_and_end_reach_the_first_and_last_rows"
            ctxmenu_home_and_end_reach_the_first_and_last_rows()
        } else if n == 17 {
            name = "ctxmenu_sheds_the_lowest_priorities_first"
            ctxmenu_sheds_the_lowest_priorities_first()
        } else if n == 18 {
            name = "ctxmenu_refuses_only_when_priority_zero_rows_do_not_fit"
            ctxmenu_refuses_only_when_priority_zero_rows_do_not_fit()
        } else if n == 19 {
            name = "ctxmenu_shedding_is_deterministic"
            ctxmenu_shedding_is_deterministic()
        } else if n == 20 {
            name = "ctxmenu_separators_never_lead_trail_or_double"
            ctxmenu_separators_never_lead_trail_or_double()
        } else if n == 21 {
            name = "ctxmenu_width_clamp_drops_accels_before_clipping_labels"
            ctxmenu_width_clamp_drops_accels_before_clipping_labels()
        } else if n == 22 {
            name = "ctxmenu_draw_frames_the_box_and_clips_inside_it"
            ctxmenu_draw_frames_the_box_and_clips_inside_it()
        } else {
            name = "ctxmenu_captures_a_target_rect"
            ctxmenu_captures_a_target_rect()
        }
        if skipped == 0 {
            print("{name}: PASS")
            ran += 1
        }
        skips += skipped
        n += 1
    }
    print("ctxmenu_test: {ran} cases pass, {skips} SKIP by name")
}
