//! git.fusscommit — the commit message's comment character and cleanup.
//!
//! Ports sagitta `src/mod/git/fusscommit.c` (123 lines) and `fusscommit.h`
//! (36) at 9ace98c2, under `s52-fuss-mode.md` §9: `core.commentChar`'s
//! `auto` rule (the first of `#;@!$%^&|:` that begins no line, blank
//! meaning space or tab) and yew's own COMMIT_EDITMSG cleanup — comment
//! lines dropped, trailing ASCII whitespace stripped, blank runs collapsed
//! to one, outer blanks trimmed — after which `--cleanup=verbatim` keeps
//! git from processing it again. Pure bytes; an embedded NUL is data.
//!
//! The port's shapes: C's `u8 *comment_char` out-parameter is the answer
//! beside "resolved"; C's caller-owned `Bytebuf *clean` is a `mut` list
//! whose previous contents are replaced. C's NULL-pointer refusal (a NULL
//! message with a nonzero length, `test_fusscommit.c:188-201`) is a
//! length past the list's: refused the same way, never read.

// `fuss_commit_blank_byte` (`fusscommit.c:5-8`): space or tab.
fn blank_byte(b: int) -> bool {
    b == 32 || b == 9
}

// `fuss_commit_trailing_space` (`fusscommit.c:10-14`).
fn trailing_space(b: int) -> bool {
    blank_byte(b) || b == 13 || b == 11 || b == 12
}

// `fuss_commit_line_starts_with` (`fusscommit.c:16-35`): some line's first
// nonblank byte is `candidate`.
fn line_starts_with(message: List[byte], len: int, candidate: int) -> bool {
    var pos = 0
    while pos < len {
        var end = pos
        while end < len && message[end] as int != 10 {
            end += 1
        }
        var first = pos
        while first < end && blank_byte(message[first] as int) {
            first += 1
        }
        if first < end && message[first] as int == candidate {
            return true
        }
        pos = if end < len then end + 1 else end
    }
    false
}

/// `yew_fuss_commit_select_comment` (`fusscommit.c:37-71`): an absent
/// setting (empty) is `#`; one byte is that byte unless it is NUL, LF or
/// trailing space; `auto` takes git's order. Answers (resolved, byte);
/// an invalid setting or an exhausted `auto` answers false.
pub fn fuss_commit_select_comment(message: List[byte], message_len: int, setting: List[byte]) -> (
    bool,
    int,
) {
    if message_len < 0 || message_len > message.len {
        return (false, 0)
    }
    if setting.len == 0 {
        return (true, 35)
    }
    if setting.len == 1 {
        let c = setting[0] as int
        if c == 0 || c == 10 || trailing_space(c) {
            return (false, 0)
        }
        return (true, c)
    }
    if setting.len != 4 ||
        setting[0] as int != 97 ||
        setting[1] as int != 117 ||
        setting[2] as int != 116 ||
        setting[3] as int != 111 {
        return (false, 0)
    }
    for c in "#;@!$%^&|:".bytes() {
        if !line_starts_with(message, message_len, c as int) {
            return (true, c as int)
        }
    }
    (false, 0)
}

/// `yew_fuss_commit_cleanup` (`fusscommit.c:73-117`): `message[0..len)`
/// cleaned into `clean` (replaced); retained lines joined with LF, no
/// outer newline. False exactly when the result has zero bytes.
pub fn fuss_commit_cleanup(
    mut clean: List[byte],
    message: List[byte],
    message_len: int,
    comment_char: int,
) -> bool {
    (mut clean).reset()
    if message_len < 0 || message_len > message.len {
        return false
    }
    var pos = 0
    var have_content = false
    var pending_blank = false
    while pos < message_len {
        var end = pos
        while end < message_len && message[end] as int != 10 {
            end += 1
        }
        var first = pos
        while first < end && blank_byte(message[first] as int) {
            first += 1
        }
        if first < end && message[first] as int == comment_char {
            pos = if end < message_len then end + 1 else end
            continue
        }
        var trimmed = end
        while trimmed > pos && trailing_space(message[trimmed - 1] as int) {
            trimmed -= 1
        }
        if trimmed == pos {
            if have_content {
                pending_blank = true
            }
        } else {
            if have_content {
                (mut clean).push(10 as byte)
                if pending_blank {
                    (mut clean).push(10 as byte)
                }
            }
            var i = pos
            while i < trimmed {
                (mut clean).push(message[i])
                i += 1
            }
            have_content = true
            pending_blank = false
        }
        pos = if end < message_len then end + 1 else end
    }
    !fuss_commit_empty(clean, clean.len)
}

/// `yew_fuss_commit_empty` (`fusscommit.c:119-123`): byte-exact —
/// whitespace and NUL bytes are not "empty".
pub fn fuss_commit_empty(_message: List[byte], message_len: int) -> bool {
    message_len == 0
}
