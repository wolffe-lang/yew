//! member: false
//!
//! The port of sagitta `tests/unit/test_file.c` (370 lines), one test per
//! C test in registry order (`tests/unit/registry.c`, the `file_` block).
//! C's `mkdtemp` is a fresh `/tmp/yew-file-<random>` directory; C's
//! `open(O_CREAT | O_EXCL, 0600)` is open mode 4 with mode 0o600.

use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn list_of(xs: List[int]) -> List[byte] {
    var v = List[byte]()
    for x in xs {
        (mut v).push(x as byte)
    }
    v
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn fresh_dir(prefix: str) -> str {
    var tries = 0
    while tries < 100 {
        var suffix = ""
        for r in os_random(6) {
            suffix = suffix + "{r % 10}"
        }
        let dir = "/tmp/{prefix}-{suffix}"
        fs_create_dir_mode(dir, 448) else |e| match e {
            exists => {
                tries += 1
                continue
            },
            denied => { assert(false, "mkdtemp denied") },
            invalid => { assert(false, "mkdtemp invalid") },
            not_found => { assert(false, "mkdtemp not found") },
            unsupported => { assert(false, "mkdtemp unsupported") },
            io => { assert(false, "mkdtemp io") },
        }
        return dir
    }
    assert(false, "mkdtemp exhausted")
    ""
}

fn write_fixture(path: str, bytes: List[byte]) {
    let fd = fs_open_perm(path, 4, 384) else {
        assert(false, "fixture create {path}")
        return
    }
    if bytes.len != 0 {
        fs_write_chunk(fd, bytes) else {
            assert(false, "fixture write")
        }
    }
    fs_close(fd) else {
        assert(false, "fixture close")
    }
}

fn read_fixture(path: str) -> List[byte] {
    let b = fs_read_bytes(path) else {
        assert(false, "fixture read {path}")
        return List[byte]()
    }
    b
}

fn remove_fixture(dir: str, path: str) {
    fs_remove(path) else |_| {}
    fs_remove_dir(dir) else {
        assert(false, "rmdir {dir}")
    }
}

fn assert_roundtrip(
    disk: List[byte],
    buffer: List[byte],
    eol: int,
    dominant: int,
    bom: bool,
    binary: bool,
    invalid_utf8: bool,
    missing_final_nl: bool,
    crlf_count: int,
    lf_count: int,
) {
    let dir = fresh_dir("yew-file")
    let path = "{dir}/fixture.txt"
    write_fixture(path, disk)
    var (rc, tb, meta) = text.file_load(path)
    assert(rc == text.LOAD_OK, "load ok")
    assert(meta.exists, "exists")
    assert(meta.size_on_disk == disk.len, "size on disk")
    assert(meta.eol == eol, "eol {meta.eol} want {eol}")
    assert(meta.dominant_eol == dominant, "dominant eol")
    assert(meta.had_bom == bom, "bom")
    assert(meta.binary == binary, "binary")
    assert(meta.had_invalid_utf8 == invalid_utf8, "invalid utf8")
    assert(meta.missing_final_nl == missing_final_nl, "missing final newline")
    assert(meta.crlf_count == crlf_count, "crlf count {meta.crlf_count}")
    assert(meta.lf_count == lf_count, "lf count {meta.lf_count}")
    let eol_bytes = text.filemeta_eol_bytes(meta)
    if dominant == text.EOL_CRLF {
        assert(same(eol_bytes, bytes_of("\r\n")), "CRLF bytes")
    } else {
        assert(same(eol_bytes, bytes_of("\n")), "LF bytes")
    }
    assert(same(text.textbuf_bytes(tb), buffer), "buffer bytes")
    assert(text.file_save(mut tb, mut meta, path) == text.SAVE_OK, "save ok")
    assert(same(read_fixture(path), disk), "saved bytes")
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    remove_fixture(dir, path)
}

fn assert_edit_preserves(before: List[byte], insert_at: int, inserted: int, after: List[byte]) {
    let dir = fresh_dir("yew-file")
    let path = "{dir}/edited.bin"
    write_fixture(path, before)
    var (rc, tb, meta) = text.file_load(path)
    assert(rc == text.LOAD_OK, "load ok")
    text.textbuf_insert(mut tb, text.byteoff(insert_at), list_of([inserted]))
    assert(text.file_save(mut tb, mut meta, path) == text.SAVE_OK, "save ok")
    assert(same(read_fixture(path), after), "edited bytes")
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    remove_fixture(dir, path)
}

fn t_file_load_empty_roundtrips() {
    assert_roundtrip(
        List[byte](),
        List[byte](),
        text.EOL_LF,
        text.EOL_LF,
        false,
        false,
        false,
        false,
        0,
        0,
    )
}

fn t_file_load_lf_roundtrips() {
    let b = bytes_of("alpha\nbeta\n")
    assert_roundtrip(b, b, text.EOL_LF, text.EOL_LF, false, false, false, false, 0, 2)
}

fn t_file_load_missing_final_newline_roundtrips() {
    let b = bytes_of("alpha\nbeta")
    assert_roundtrip(b, b, text.EOL_LF, text.EOL_LF, false, false, false, true, 0, 1)
}

fn t_file_load_crlf_roundtrips() {
    let b = bytes_of("alpha\r\nbeta\r\n")
    assert_roundtrip(b, b, text.EOL_CRLF, text.EOL_CRLF, false, false, false, false, 2, 0)
}

fn t_file_load_mixed_lf_dominant_roundtrips() {
    let b = bytes_of("a\nb\r\nc\n")
    assert_roundtrip(b, b, text.EOL_MIXED, text.EOL_LF, false, false, false, false, 1, 2)
}

fn t_file_load_mixed_crlf_dominant_roundtrips() {
    let b = bytes_of("a\r\nb\nc\r\n")
    assert_roundtrip(b, b, text.EOL_MIXED, text.EOL_CRLF, false, false, false, false, 2, 1)
}

fn t_file_load_bom_strips_and_reemits() {
    assert_roundtrip(
        list_of([239, 187, 191, 97, 10]),
        list_of([97, 10]),
        text.EOL_LF,
        text.EOL_LF,
        true,
        false,
        false,
        false,
        0,
        1,
    )
}

fn t_file_load_bom_crlf_strips_and_reemits() {
    assert_roundtrip(
        list_of([239, 187, 191, 97, 13, 10]),
        list_of([97, 13, 10]),
        text.EOL_CRLF,
        text.EOL_CRLF,
        true,
        false,
        false,
        false,
        1,
        0,
    )
}

fn t_file_load_binary_nul_at_zero_roundtrips() {
    let b = list_of([0, 239, 187, 191, 13, 10])
    assert_roundtrip(b, b, text.EOL_LF, text.EOL_LF, false, true, false, false, 0, 0)
}

fn filled(b: int, n: int) -> List[byte] {
    var out = List[byte]()
    var i = 0
    while i < n {
        (mut out).push(b as byte)
        i += 1
    }
    out
}

fn t_file_load_binary_nul_at_8191_roundtrips() {
    var b = filled(120, 8193)
    b[8191] = 0 as byte
    b[8192] = 10 as byte
    assert_roundtrip(b, b, text.EOL_LF, text.EOL_LF, false, true, false, false, 0, 0)
}

fn t_file_load_nul_after_binary_window_is_text() {
    var b = filled(120, 8194)
    b[8192] = 0 as byte
    b[8193] = 10 as byte
    assert_roundtrip(b, b, text.EOL_LF, text.EOL_LF, false, false, false, false, 0, 1)
}

fn t_file_load_invalid_utf8_preserves_bytes() {
    let b = list_of([97, 192, 175, 122])
    assert_roundtrip(b, b, text.EOL_LF, text.EOL_LF, false, false, true, true, 0, 0)
}

fn t_file_load_three_byte_file_roundtrips() {
    let b = bytes_of("abc")
    assert_roundtrip(b, b, text.EOL_LF, text.EOL_LF, false, false, false, true, 0, 0)
}

fn t_file_edit_save_preserves_untouched_edge_bytes() {
    assert_edit_preserves(List[byte](), 0, 120, list_of([120]))
    assert_edit_preserves(
        list_of([226, 128, 141, 226, 128, 141, 226, 128, 141]),
        3,
        120,
        list_of([226, 128, 141, 120, 226, 128, 141, 226, 128, 141]),
    )
    assert_edit_preserves(list_of([97, 0, 98]), 2, 120, list_of([97, 0, 120, 98]))
    assert_edit_preserves(bytes_of("tail"), 4, 120, bytes_of("tailx"))
}

fn t_file_load_enoent_returns_empty_new_buffer() {
    let dir = fresh_dir("yew-file")
    let path = "{dir}/new.txt"
    var (rc, tb, meta) = text.file_load(path)
    assert(rc == text.LOAD_ENOENT, "ENOENT")
    assert(!meta.exists, "does not exist")
    assert(text.textbuf_len(tb) == 0, "empty")
    assert(meta.has_realpath, "a realpath")
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    remove_fixture(dir, path)
}

fn t_file_load_refuses_over_two_gib() {
    let dir = fresh_dir("yew-file")
    let path = "{dir}/huge.dat"
    let fd = fs_open_perm(path, 4, 384) else {
        assert(false, "create huge")
        return
    }
    fs_truncate(fd, 2147483649) else {
        assert(false, "truncate huge")
    }
    fs_close(fd) else {
        assert(false, "close huge")
    }
    var (rc, tb, meta) = text.file_load(path)
    assert(rc == text.LOAD_TOO_LARGE, "too large")
    assert(text.textbuf_len(tb) == 0, "no buffer content")
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    remove_fixture(dir, path)
}

fn t_file_save_rejects_changed_disk() {
    let dir = fresh_dir("yew-file")
    let path = "{dir}/conflict.txt"
    write_fixture(path, bytes_of("old\n"))
    var (rc, tb, meta) = text.file_load(path)
    assert(rc == text.LOAD_OK, "load ok")
    fs_remove(path) else {
        assert(false, "unlink")
    }
    write_fixture(path, bytes_of("external change\n"))
    text.textbuf_insert_str(mut tb, text.byteoff(text.textbuf_len(tb)), "edit")
    assert(text.file_save(mut tb, mut meta, path) == text.SAVE_CHANGED_ON_DISK, "changed on disk")
    assert(same(read_fixture(path), bytes_of("external change\n")), "the external bytes kept")
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    remove_fixture(dir, path)
}

// Port: `realpath(3)`'s `..` after a symlink (G4). `<d>/a/b` is a
// directory, `<d>/l` links to it; `<d>/l/..` is `<d>/a`, never `<d>`.
fn t_port_realpath_dotdot_follows_the_link() {
    let d = fresh_dir("yew-realpath")
    let base = text.file_realpath(d) else d
    fs_create_dir_all("{d}/a/b") else {
        assert(false, "the fixture tree")
    }
    fs_symlink("{d}/a/b", "{d}/l") else |_| {
        assert(false, "the link")
    }
    let up = text.file_realpath("{d}/l/..") else ""
    assert(up == "{base}/a", "l/.. is the target's parent: {up}")
    let missing = text.file_realpath("{d}/l/nope") else "none"
    assert(missing == "none", "a missing name resolves to none: {missing}")
    fs_remove("{d}/l") else |_| {}
    fs_remove_dir_all(d) else |_| {}
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_file_load_empty_roundtrips()
    t_file_load_lf_roundtrips()
    t_file_load_missing_final_newline_roundtrips()
    t_file_load_crlf_roundtrips()
    t_file_load_mixed_lf_dominant_roundtrips()
    t_file_load_mixed_crlf_dominant_roundtrips()
    t_file_load_bom_strips_and_reemits()
    t_file_load_bom_crlf_strips_and_reemits()
    t_file_load_binary_nul_at_zero_roundtrips()
    t_file_load_binary_nul_at_8191_roundtrips()
    t_file_load_nul_after_binary_window_is_text()
    t_file_load_invalid_utf8_preserves_bytes()
    t_file_load_three_byte_file_roundtrips()
    t_file_edit_save_preserves_untouched_edge_bytes()
    t_file_load_enoent_returns_empty_new_buffer()
    t_file_load_refuses_over_two_gib()
    t_file_save_rejects_changed_disk()
    t_port_realpath_dotdot_follows_the_link()
    print("file_test: 17 cases pass (+1 port)")
}
