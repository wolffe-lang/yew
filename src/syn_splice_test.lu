//! member: false
//! Ports sagitta tests/unit/test_syn_splice.c at 9ace98c2, one case per C
//! test in its order. The toy definition is syn_toy.c's, as table data.
//! The C vector's capacity is not observable in wolf; the bulk case holds
//! the packed storage to exactly four bytes per line instead.

use search
use syn
use text

fn bytes(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() { (mut out).push(b) }
    out
}

fn rule(mut def: syn.SynDefinition, ctx: int, pattern: str, attr: int, op: int, target: int) {
    var err = search.re_err_new()
    let re = search.re_compile_str(pattern, 0, mut err) else {
        assert(false, "toy regex: {err.msg}")
        return
    }
    var r = syn.syn_rule_new(def.regexes.len, attr)
    r.op = op
    r.target = target
    if op == syn.SYN_OP_POP { r.nop = 1 }
    let first = search.re_first_bytes(re)
    r.first = syn.syn_first_new(false)
    for i in 0..256 {
        if first[i] { syn.syn_first_add(mut r.first, i) }
    }
    syn.syn_first_union(mut def.contexts[ctx].first, r.first)
    (mut def.regexes).push(re)
    (mut def.rules).push(r)
    (mut def.patterns).push(bytes(pattern))
}

// syn_toy.c's four contexts and ten rules.
fn toy() -> syn.SynDefinition {
    var def = syn.syn_definition_new("toy")
    var main = syn.syn_context_new(0)
    main.nrules = 7
    var string = syn.syn_context_new(12)
    string.first_rule = 7
    string.nrules = 2
    string.eol_op = syn.SYN_OP_POP
    string.eol_nop = 1
    var block = syn.syn_context_new(16)
    block.first_rule = 9
    block.nrules = 1
    var comment = syn.syn_context_new(16)
    comment.first_rule = 10
    comment.eol_op = syn.SYN_OP_POP
    comment.eol_nop = 1
    (mut def.contexts).push(main)
    (mut def.contexts).push(string)
    (mut def.contexts).push(block)
    (mut def.contexts).push(comment)
    for name in "main string comment_block comment_line".words() {
        (mut def.context_names).push(bytes(name))
    }
    rule(mut def, 0, "//", 16, syn.SYN_OP_PUSH, 3)
    rule(mut def, 0, "/\\*", 16, syn.SYN_OP_PUSH, 2)
    rule(mut def, 0, "\"", 12, syn.SYN_OP_PUSH, 1)
    rule(mut def, 0, "\\b(if|else|while|return)\\b", 2, syn.SYN_OP_STAY, 0)
    rule(mut def, 0, "[0-9]+", 9, syn.SYN_OP_STAY, 0)
    rule(mut def, 0, "\\b(true|false)\\b", 10, syn.SYN_OP_STAY, 0)
    rule(mut def, 0, "[+*/=-]+", 31, syn.SYN_OP_STAY, 0)
    rule(mut def, 1, "\\\\.", 13, syn.SYN_OP_STAY, 0)
    rule(mut def, 1, "\"", 12, syn.SYN_OP_POP, 0)
    rule(mut def, 2, "\\*/", 16, syn.SYN_OP_POP, 0)
    def
}

fn toy_engine() -> syn.SynEngine {
    var pool = syn.syn_pool_new()
    let root = syn.syn_pool_add(mut pool, take toy(), 1)
    syn.syn_engine_new(pool, root)
}

// A buffer of `lines` empty lines (lines_buf).
fn lines_buf(lines: int) -> text.TextBuf {
    assert(lines > 0, "at least one line")
    if lines == 1 then return text.textbuf_new()
    var newlines = List[byte]()
    for _ in 0..lines - 1 { (mut newlines).push(10 as byte) }
    text.textbuf_from_bytes(newlines, 0, newlines.len)
}

fn assert_syn_shape(buffer: syn.SynBuffer, lines: int) {
    assert(syn.syn_ids_len(buffer.lines.entry) == lines, "one entry per line")
    assert(syn.syn_ids_len(buffer.lines.entry) > 0, "never empty")
    assert(syn.syn_ids_get(buffer.lines.entry, 0) == syn.SYN_STATE_ROOT, "ROOT enters line zero")
}

// test_syn_splice_table_preserves_root_and_length
fn table_preserves_root_and_length() {
    let engine = toy_engine()
    // lines, lo, removed, inserted
    let rows = [
        [1, 0, 0, 0],
        [2, 0, 0, 1],
        [5, 4, 0, 1],
        [5, 2, 1, 0],
        [5, 2, 0, 3],
        [8, 1, 3, 1],
        [8, 0, 7, 0],
        [3, 1, 0, 10000],
    ]
    assert(rows.len == 8, "eight splice shapes")
    for row in rows {
        let lines = row[0]
        let lo = row[1]
        let tb = lines_buf(lines)
        var buffer = syn.syn_buffer_new_at(tb, engine.generation, 0)
        buffer.lines.settled_to = lines
        buffer.lines.wave = lines
        assert_syn_shape(buffer, lines)
        syn.syn_buffer_edit(mut buffer, lo, row[2], row[3])
        assert_syn_shape(buffer, lines - row[2] + row[3])
        assert(buffer.lines.splice_count == 1, "one splice per edit")
        let settled = if lo + 1 < lines then lo + 1 else lines
        assert(buffer.lines.settled_to == settled, "settled frontier clamped to the edit")
        assert(buffer.lines.wave == lo, "wave pulled to the edited line")
    }
}

// test_syn_splice_inserts_unknown_slots_and_retains_tail
fn inserts_unknown_slots_and_retains_tail() {
    let engine = toy_engine()
    var buffer = syn.syn_buffer_new_at(lines_buf(6), engine.generation, 0)
    for i in 1..6 { syn.syn_ids_set(mut buffer.lines.entry, i, 100 + i) }
    syn.syn_buffer_edit(mut buffer, 2, 1, 3)
    assert_syn_shape(buffer, 8)
    let want = [1, 101, 102, 0, 0, 0, 104, 105]
    for i in 0..8 {
        assert(
            syn.syn_ids_get(buffer.lines.entry, i) == want[i],
            "UNKNOWN slots inside a retained tail",
        )
    }
}

// test_syn_splice_clamps_settled_and_wave_to_damage
fn clamps_settled_and_wave_to_damage() {
    let engine = toy_engine()
    var buffer = syn.syn_buffer_new_at(lines_buf(20), engine.generation, 0)
    buffer.lines.settled_to = 18
    buffer.lines.wave = 16
    syn.syn_buffer_edit(mut buffer, 4, 5, 2)
    assert(buffer.lines.settled_to == 5, "settled clamps to the damaged line")
    assert(buffer.lines.wave == 4, "wave clamps to the damaged line")
    assert(buffer.lines.settling, "an edit resumes settling")
    assert_syn_shape(buffer, 17)
}

// test_syn_splice_bulk_insert_uses_one_vector_splice
fn bulk_insert_uses_one_vector_splice() {
    let engine = toy_engine()
    var buffer = syn.syn_buffer_new_at(lines_buf(3), engine.generation, 0)
    syn.syn_buffer_edit(mut buffer, 1, 0, 10000)
    assert_syn_shape(buffer, 10003)
    assert(buffer.lines.splice_count == 1, "one vector splice for a bulk paste")
    assert(syn.syn_ids_bytes(buffer.lines.entry) == 4 * 10003, "four packed bytes per line")
    assert(
        syn.syn_ids_get(buffer.lines.entry, 1) == syn.SYN_STATE_UNKNOWN,
        "first pasted slot UNKNOWN",
    )
    assert(
        syn.syn_ids_get(buffer.lines.entry, 10001) == syn.SYN_STATE_UNKNOWN,
        "last pasted slot UNKNOWN",
    )
}

fn main() {
    let selected = (env_get("YEW_SYN_SPLICE_CASE") else "-1").to_int() else -1
    for i in 0..4 {
        if selected == -1 || selected == i {
            match i {
                0 => table_preserves_root_and_length(),
                1 => inserts_unknown_slots_and_retains_tail(),
                2 => clamps_settled_and_wave_to_damage(),
                _ => bulk_insert_uses_one_vector_splice(),
            }
            print("syn_splice_case_{i}: PASS")
        }
    }
}
