//! member: false
//! Core value/map witnesses from sagitta value.c and test_fl_vm.c.

use fl

fn main() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    assert(!fl.fl_truthy(fl.fl_nil()))
    assert(!fl.fl_truthy(fl.fl_bool(false)))
    assert(fl.fl_truthy(fl.fl_int(0)))
    assert(fl.fl_equal(vm, fl.fl_int(5), fl.fl_float(5.0)))
    assert(fl.fl_type_name(12) == "buf" && fl.fl_type_name(16) == "regex")
    let s = fl.fl_str_text(mut vm, "abc")
    let t = fl.fl_str_text(mut vm, "abc")
    assert(s.i == t.i)
    assert(fl.fl_hash_value(vm, s) == 440920331)
    let m = fl.fl_map_new(mut vm)
    for i in 0..30 { assert(fl.fl_map_set(mut vm, m, fl.fl_int(i), fl.fl_int(i * 2))) }
    assert(fl.fl_map_count(vm, m) == 30)
    for i in 0..15 { assert(fl.fl_map_del(mut vm, m, fl.fl_int(i))) }
    assert(fl.fl_map_set(mut vm, m, fl.fl_int(0), fl.fl_int(77)))
    let (c, k, v) = fl.fl_map_iter(vm, m, 0) else (0, fl.fl_nil(), fl.fl_nil())
    assert(c == 16 && k.i == 15 && v.i == 30)
    assert((fl.fl_map_get(vm, m, fl.fl_int(0)) else fl.fl_nil()).i == 77)
    assert(fl.fl_map_del(mut vm, m, fl.fl_int(15)))
    assert(fl.fl_map_del(mut vm, m, fl.fl_int(16)))
    let (_, first, _) = fl.fl_map_iter(vm, m, 0) else (0, fl.fl_nil(), fl.fl_nil())
    assert(first.i == 17)
    fl.fl_map_clear(mut vm, m)
    assert(fl.fl_map_count(vm, m) == 0)
    assert(!fl.fl_map_set(mut vm, m, fl.fl_float(1.0), fl.fl_nil()))
    print("PASS fl_value scalar/hash/intern/map")
}
