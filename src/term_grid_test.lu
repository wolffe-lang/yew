//! member: false
//!
//! The port of sagitta `tests/unit/test_grid.c` (317 lines) and
//! `test_grid_wide.c` (215), one test per C test in registry order
//! (`tests/unit/registry.c:647-666`). A root-level entry (`term` imports
//! its siblings).

use term
use util

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn put(
    mut g: term.Grid,
    row: int,
    col: int,
    s: List[byte],
    fg: term.Color,
    bg: term.Color,
    attrs: int,
) -> int {
    term.grid_put(mut g, row, col, s, 0, s.len, fg, bg, attrs)
}

fn puts(
    mut g: term.Grid,
    row: int,
    col: int,
    s: List[byte],
    fg: term.Color,
    bg: term.Color,
    attrs: int,
) -> int {
    term.grid_puts(mut g, row, col, s, 0, s.len, fg, bg, attrs)
}

fn cjk() -> List[byte] {
    bytes_of("漢")
}

fn acute() -> List[byte] {
    var v = List[byte]()
    (mut v).push(204 as byte)
    (mut v).push(129 as byte)
    v
}

fn family() -> List[byte] {
    bytes_of("👨‍👩‍👧‍👦")
}

fn cells_equal_rows(a: term.Grid, b: term.Grid, cells: int) -> bool {
    var i = 0
    while i < cells {
        if !term.cell_eq(
            term.grid_back(a, i / a.cols, i % a.cols),
            term.grid_back(b, i / b.cols, i % b.cols),
        ) {
            return false
        }
        i += 1
    }
    true
}

fn t_grid_cell_layout() {
    // C: sizeof(YewColor) == 4, sizeof(Cell) == 20. The port's Cell is
    // thirteen ints (two packed glyph words, two four-int colours, attrs,
    // w, flags), recorded in the note beside C's 20 bytes.
    assert(term.CELL_INTS == 13, "the port's Cell is thirteen ints")
    let blank = term.cell_blank()
    assert(blank.w == 1 && blank.lo == 0 && blank.hi == 0 && blank.flags == 0, "blank cell")
}

fn t_grid_put_zeroes_inline_tail() {
    var g = term.grid_new(1, 3)
    let d = term.color_default()
    var long_cluster = bytes_of("e")
    for b in acute() {
        (mut long_cluster).push(b)
    }
    (mut long_cluster).push(204 as byte)
    (mut long_cluster).push(130 as byte)
    assert(put(mut g, 0, 0, long_cluster, d, d, 0) == 1, "long cluster writes one cell")
    assert(put(mut g, 0, 0, bytes_of("x"), d, d, 0) == 1, "short cluster writes one cell")
    let c = term.grid_back(g, 0, 0)
    assert(term.cell_byte(c, 0) == 120, "x")
    var i = 1
    while i < 8 {
        assert(term.cell_byte(c, i) == 0, "inline tail zeroed")
        i += 1
    }
}

fn t_grid_interns_long_cluster() {
    var g = term.grid_new(1, 3)
    let d = term.color_default()
    let fam = family()
    assert(fam.len == 25, "the family is 25 bytes")
    assert(put(mut g, 0, 0, fam, d, d, 0) == 2, "the family is wide")
    let c = term.grid_back(g, 0, 0)
    assert(term.cell_interned(c), "interned")
    var stored = List[byte]()
    term.cell_bytes_into(mut stored, g, c)
    assert(stored.len == 25, "stored whole")
    var i = 0
    while i < 25 {
        assert(stored[i] == fam[i], "stored byte")
        i += 1
    }
}

fn t_grid_damage_unions_writes() {
    var g = term.grid_new(2, 8)
    let d = term.color_default()
    term.grid_flip(mut g)
    let _ = put(mut g, 1, 5, bytes_of("x"), d, d, 0)
    let _ = put(mut g, 1, 2, bytes_of("y"), d, d, 0)
    let dm = term.grid_damage(g, 1)
    assert(dm.lo == 2, "damage lo 2")
    assert(dm.hi == 7, "damage hi 7")
    assert(g.dmg_lo == 1 && g.dmg_hi == 2, "dirty rows [1, 2)")
}

fn t_grid_resize_discards_cells_and_marks_all() {
    var g = term.grid_new(2, 3)
    let d = term.color_default()
    let _ = put(mut g, 0, 0, bytes_of("x"), d, d, 0)
    term.grid_flip(mut g)
    assert(term.grid_resize(mut g, 3, 2), "resize ok")
    assert(g.rows == 3 && g.cols == 2, "3x2")
    assert(g.dmg_lo == 0 && g.dmg_hi == 3, "all rows dirty")
    var i = 0
    while i < 6 {
        assert(term.cell_eq(term.grid_back(g, i / 2, i % 2), g.blank), "back is blank")
        assert(term.grid_front(g, i / 2, i % 2).w == 255, "front unknown")
        i += 1
    }
    i = 0
    while i < 3 {
        let dm = term.grid_damage(g, i)
        assert(dm.lo == 0 && dm.hi == 2, "row span whole")
        i += 1
    }
}

fn t_grid_invalidate_forces_physical_repaint() {
    var g = term.grid_new(2, 3)
    let d = term.color_default()
    let _ = put(mut g, 0, 0, bytes_of("x"), d, d, 0)
    term.grid_flip(mut g)
    assert(term.cell_eq(term.grid_front(g, 0, 0), term.grid_back(g, 0, 0)), "flipped")
    term.grid_invalidate(mut g)
    assert(term.cell_byte(term.grid_back(g, 0, 0), 0) == 120, "back keeps x")
    assert(g.dmg_lo == 0 && g.dmg_hi == 2, "all rows dirty")
    var i = 0
    while i < 6 {
        assert(term.grid_front(g, i / 3, i % 3).w == 255, "front forgotten")
        i += 1
    }
    i = 0
    while i < 2 {
        let dm = term.grid_damage(g, i)
        assert(dm.lo == 0 && dm.hi == 3, "row span whole")
        i += 1
    }
}

fn t_grid_cursor_snaps_left_from_continuation() {
    var g = term.grid_new(1, 4)
    let d = term.color_default()
    let _ = put(mut g, 0, 1, cjk(), d, d, 0)
    term.grid_cursor(mut g, 0, 2, true)
    assert(g.cur_row == 0 && g.cur_col == 1 && g.cur_vis, "snapped to the head")
}

fn t_grid_controls_are_lowered_to_printable_cells() {
    var g = term.grid_new(1, 5)
    let d = term.color_default()
    var controls = List[byte]()
    (mut controls).push(1 as byte)
    (mut controls).push(127 as byte)
    assert(puts(mut g, 0, 0, controls, d, d, 0) == 4, "two controls, four cells")
    assert(term.cell_byte(term.grid_back(g, 0, 0), 0) == 94, "^")
    assert(term.cell_byte(term.grid_back(g, 0, 1), 0) == 65, "A")
    assert(term.cell_byte(term.grid_back(g, 0, 2), 0) == 94, "^")
    assert(term.cell_byte(term.grid_back(g, 0, 3), 0) == 63, "?")
}

fn t_grid_printable_ascii_runs_match_scalar_writes() {
    var run = term.grid_new(2, 8)
    var scalar = term.grid_new(2, 8)
    let fg = term.Color { tag: term.COLOR_INDEXED, r: 42, g: 91, b: 37 }
    let bg = term.Color { tag: 9, r: 8, g: 7, b: 6 }
    let _ = put(mut run, 0, 0, cjk(), fg, bg, 0)
    let _ = put(mut run, 0, 6, cjk(), fg, bg, 0)
    let _ = put(mut scalar, 0, 0, cjk(), fg, bg, 0)
    let _ = put(mut scalar, 0, 6, cjk(), fg, bg, 0)
    term.grid_flip(mut run)
    term.grid_flip(mut scalar)
    let ascii = bytes_of("abcdef")
    assert(puts(mut run, 0, 1, ascii, fg, bg, 65535) == 7, "run writes six")
    var i = 0
    while i < 6 {
        let _ = term.grid_put(mut scalar, 0, i + 1, ascii, i, i + 1, fg, bg, 65535)
        i += 1
    }
    var combined = bytes_of("e")
    for b in acute() {
        (mut combined).push(b)
    }
    assert(puts(mut run, 1, 0, combined, fg, bg, 65535) == 1, "combined via puts")
    assert(put(mut scalar, 1, 0, combined, fg, bg, 65535) == 1, "combined via put")
    assert(cells_equal_rows(run, scalar, 16), "the run equals scalar writes")
    i = 0
    while i < 2 {
        let a = term.grid_damage(run, i)
        let b = term.grid_damage(scalar, i)
        assert(a.lo == b.lo && a.hi == b.hi, "same damage")
        i += 1
    }
    assert(run.dmg_lo == scalar.dmg_lo && run.dmg_hi == scalar.dmg_hi, "same dirty rows")
}

fn t_grid_puts_keeps_ascii_base_with_unicode_suffix() {
    let keycap = bytes_of("1️⃣")
    var text = bytes_of("A")
    for b in keycap {
        (mut text).push(b)
    }
    (mut text).push(66 as byte)
    let suffix = bytes_of("️⃣")
    var g = term.grid_new(1, 8)
    let d = term.color_default()
    assert(puts(mut g, 0, 0, text, d, d, 0) == 4, "A, keycap (wide), B")
    assert(term.grid_back(g, 0, 0).w == 1 && term.cell_byte(term.grid_back(g, 0, 0), 0) == 65, "A")
    let kc = term.grid_back(g, 0, 1)
    assert(kc.w == 2, "keycap is wide")
    var i = 0
    while i < keycap.len {
        assert(term.cell_byte(kc, i) == keycap[i] as int, "keycap bytes")
        i += 1
    }
    assert(term.grid_back(g, 0, 2).w == 0, "continuation")
    assert(term.grid_back(g, 0, 3).w == 1 && term.cell_byte(term.grid_back(g, 0, 3), 0) == 66, "B")

    term.grid_clear(mut g)
    assert(put(mut g, 0, 0, bytes_of("1"), d, d, 0) == 1, "1")
    assert(put(mut g, 0, 1, suffix, d, d, 0) == 2, "suffix joins and widens")
    assert(term.grid_back(g, 0, 0).w == 2, "now wide")
    assert(term.grid_back(g, 0, 1).w == 0, "with a tail")

    term.grid_clear(mut g)
    let _ = put(mut g, 0, 0, bytes_of("1"), d, d, 0)
    let _ = put(mut g, 0, 1, cjk(), d, d, 0)
    term.grid_cursor(mut g, 0, 1, true)
    assert(put(mut g, 0, 1, suffix, d, d, 0) == 2, "suffix over a CJK head")
    assert(term.grid_back(g, 0, 0).w == 2 && term.grid_back(g, 0, 1).w == 0, "keycap pair")
    assert(term.cell_eq(term.grid_back(g, 0, 2), g.blank), "the CJK tail died")
    assert(g.cur_col == 0, "cursor snapped to the head")

    term.grid_clear(mut g)
    let _ = put(mut g, 0, 7, bytes_of("1"), d, d, 0)
    assert(put(mut g, 0, 8, suffix, d, d, 0) == 8, "no room to widen at the last column")
    assert(
        term.grid_back(g, 0, 7).w == 1 && term.cell_byte(term.grid_back(g, 0, 7), 0) == 32,
        "a space",
    )
}

fn t_grid_invalid_and_c1_bytes_are_lowered() {
    var g = term.grid_new(1, 9)
    let d = term.color_default()
    var invalid = List[byte]()
    (mut invalid).push(255 as byte)
    assert(put(mut g, 0, 0, invalid, d, d, 0) == 4, "<FF> is four cells")
    assert(term.cell_byte(term.grid_back(g, 0, 0), 0) == 60, "<")
    assert(term.cell_byte(term.grid_back(g, 0, 1), 0) == 70, "F")
    assert(term.cell_byte(term.grid_back(g, 0, 2), 0) == 70, "F")
    assert(term.cell_byte(term.grid_back(g, 0, 3), 0) == 62, ">")
    var i = 0
    while i < 4 {
        assert(term.grid_back(g, 0, i).attrs & term.ATTR_INVALID_BYTE != 0, "invalid flagged")
        i += 1
    }
    var c1 = List[byte]()
    (mut c1).push(194 as byte)
    (mut c1).push(133 as byte)
    assert(put(mut g, 0, 4, c1, d, d, 0) == 8, "<85> is four cells")
    assert(term.cell_byte(term.grid_back(g, 0, 4), 0) == 60, "<")
    assert(term.cell_byte(term.grid_back(g, 0, 5), 0) == 56, "8")
    assert(term.cell_byte(term.grid_back(g, 0, 6), 0) == 53, "5")
    assert(term.cell_byte(term.grid_back(g, 0, 7), 0) == 62, ">")
    i = 4
    while i < 8 {
        assert(term.grid_back(g, 0, i).attrs & term.ATTR_INVALID_BYTE == 0, "C1 is not invalid")
        i += 1
    }
}

fn t_grid_wide_tail_copies_style() {
    var g = term.grid_new(1, 4)
    let fg = term.color_rgb(10, 20, 30)
    let bg = term.color_indexed(4)
    let _ = put(mut g, 0, 1, cjk(), fg, bg, term.ATTR_INVALID_BYTE)
    let head = term.grid_back(g, 0, 1)
    let tail = term.grid_back(g, 0, 2)
    assert(head.w == 2 && tail.w == 0, "head and tail")
    assert(
        term.color_equal(head.fg, tail.fg) && term.color_equal(head.bg, tail.bg),
        "tail copies colours",
    )
    assert(head.attrs == tail.attrs, "tail copies attrs")
    term.grid_flip(mut g)
    var overlay = term.cell_blank()
    overlay.bg = term.color_rgb(90, 80, 70)
    overlay.attrs = term.ATTR_REVERSE
    term.grid_overlay(mut g, 0, 2, 3, overlay, term.OVERLAY_BG | term.OVERLAY_ATTRS)
    let head2 = term.grid_back(g, 0, 1)
    let tail2 = term.grid_back(g, 0, 2)
    assert(head2.w == 2 && tail2.w == 0, "pair intact")
    var bytes = List[byte]()
    term.cell_bytes_into(mut bytes, g, head2)
    assert(bytes.len == 3, "the glyph survives the overlay")
    assert(
        term.color_equal(head2.bg, overlay.bg) && term.color_equal(tail2.bg, overlay.bg),
        "both halves restyled",
    )
    assert(head2.attrs == term.ATTR_INVALID_BYTE | term.ATTR_REVERSE, "head attrs")
    assert(tail2.attrs == term.ATTR_INVALID_BYTE | term.ATTR_REVERSE, "tail attrs")
    let dm = term.grid_damage(g, 0)
    assert(dm.lo == 1 && dm.hi == 3, "the pair is damaged")
}

fn t_grid_overwrite_wide_head_blanks_tail() {
    var g = term.grid_new(1, 5)
    let d = term.color_default()
    let _ = put(mut g, 0, 1, cjk(), d, d, 0)
    term.grid_flip(mut g)
    let _ = put(mut g, 0, 1, bytes_of("x"), d, d, 0)
    assert(term.cell_eq(term.grid_back(g, 0, 2), g.blank), "tail blanked")
    let dm = term.grid_damage(g, 0)
    assert(dm.lo == 1 && dm.hi >= 3, "damage covers the tail")
}

fn t_grid_overwrite_wide_tail_blanks_head() {
    var g = term.grid_new(1, 5)
    let d = term.color_default()
    let _ = put(mut g, 0, 1, cjk(), d, d, 0)
    term.grid_flip(mut g)
    let _ = put(mut g, 0, 2, bytes_of("x"), d, d, 0)
    assert(term.cell_eq(term.grid_back(g, 0, 1), g.blank), "head blanked")
    let dm = term.grid_damage(g, 0)
    assert(dm.lo == 1 && dm.hi >= 3, "damage covers the head")
}

fn t_grid_wide_at_last_column_becomes_space() {
    var g = term.grid_new(1, 3)
    let fg = term.color_indexed(2)
    let bg = term.color_default()
    assert(put(mut g, 0, 2, cjk(), fg, bg, 1) == 3, "answers cols")
    let c = term.grid_back(g, 0, 2)
    assert(c.w == 1 && term.cell_byte(c, 0) == 32, "a space")
    assert(term.color_equal(c.fg, fg), "styled")
}

fn t_grid_zero_width_appends_to_previous_cell() {
    var g = term.grid_new(1, 3)
    let d = term.color_default()
    let _ = put(mut g, 0, 0, bytes_of("e"), d, d, 0)
    assert(put(mut g, 0, 1, acute(), d, d, 0) == 1, "joins, column stays")
    let c = term.grid_back(g, 0, 0)
    assert(
        term.cell_byte(c, 0) == 101 && term.cell_byte(c, 1) == 204 && term.cell_byte(c, 2) == 129,
        "e + acute",
    )
    assert(term.cell_byte(c, 3) == 0, "then zero")
}

fn t_grid_zero_width_at_column_zero_is_dropped() {
    var g = term.grid_new(1, 3)
    let d = term.color_default()
    term.grid_flip(mut g)
    assert(put(mut g, 0, 0, acute(), d, d, 0) == 0, "dropped")
    assert(term.cell_eq(term.grid_back(g, 0, 0), g.blank), "nothing written")
    let dm = term.grid_damage(g, 0)
    assert(dm.lo >= dm.hi, "no damage")
}

fn t_grid_wide_write_snaps_existing_cursor_left() {
    var g = term.grid_new(1, 6)
    let d = term.color_default()
    term.grid_cursor(mut g, 0, 3, true)
    let _ = put(mut g, 0, 2, cjk(), d, d, 0)
    assert(term.grid_back(g, 0, 3).w == 0, "tail at 3")
    assert(g.cur_col == 2, "cursor snapped to the head")
}

fn t_grid_zero_width_after_blank_is_dropped() {
    var g = term.grid_new(1, 3)
    let d = term.color_default()
    term.grid_flip(mut g)
    assert(put(mut g, 0, 1, acute(), d, d, 0) == 1, "dropped, column stays")
    assert(term.cell_eq(term.grid_back(g, 0, 0), g.blank), "nothing written")
    let dm = term.grid_damage(g, 0)
    assert(dm.lo >= dm.hi, "no damage")
}

fn t_grid_combining_overflow_preserves_wide_interned_base() {
    var g = term.grid_new(1, 4)
    let d = term.color_default()
    let fam = family()
    let _ = put(mut g, 0, 0, fam, d, d, 0)
    assert(put(mut g, 0, 2, acute(), d, d, 0) == 2, "joins the family")
    let c = term.grid_back(g, 0, 0)
    assert(term.cell_interned(c), "still interned")
    assert(c.w == 2 && term.grid_back(g, 0, 1).w == 0, "still wide")
    var stored = List[byte]()
    term.cell_bytes_into(mut stored, g, c)
    assert(stored.len == 27, "family + acute")
    var i = 0
    while i < 25 {
        assert(stored[i] == fam[i], "family bytes")
        i += 1
    }
    assert(stored[25] as int == 204 && stored[26] as int == 129, "then the acute")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_grid_cell_layout()
    t_grid_put_zeroes_inline_tail()
    t_grid_interns_long_cluster()
    t_grid_damage_unions_writes()
    t_grid_resize_discards_cells_and_marks_all()
    t_grid_invalidate_forces_physical_repaint()
    t_grid_cursor_snaps_left_from_continuation()
    t_grid_controls_are_lowered_to_printable_cells()
    t_grid_printable_ascii_runs_match_scalar_writes()
    t_grid_puts_keeps_ascii_base_with_unicode_suffix()
    t_grid_invalid_and_c1_bytes_are_lowered()
    t_grid_wide_tail_copies_style()
    t_grid_overwrite_wide_head_blanks_tail()
    t_grid_overwrite_wide_tail_blanks_head()
    t_grid_wide_at_last_column_becomes_space()
    t_grid_zero_width_appends_to_previous_cell()
    t_grid_zero_width_at_column_zero_is_dropped()
    t_grid_wide_write_snaps_existing_cursor_left()
    t_grid_zero_width_after_blank_is_dropped()
    t_grid_combining_overflow_preserves_wide_interned_base()
    let _ = util.EXIT_OK
    print("grid_test: 20 cases pass")
}
