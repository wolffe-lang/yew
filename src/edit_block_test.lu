//! member: false
//!
//! The port of sagitta `tests/unit/test_block.c` (715 lines), one test per
//! C test in registry order (`tests/unit/registry.c:896-909`). C's fixture
//! is a `Buffer` with a `TextBuf` and tab width 4 behind a `UnitCtx`
//! (`test_block.c:15-35`); the port's is the `TextBuf` and
//! `edit.unitctx_buf(4, has_lang)`. C's `yew_unit_block.next(...)` is
//! `edit.unit_next(edit.UNIT_BLOCK, ...)`.
//!
//! **SKIP by name.** The cases that build a syntax fixture
//! (`block_fixture_lang`, `test_block.c:37-64`: a syntax engine bound and
//! settled over the buffer) need the syntax engine, campaign 08's (yw10):
//! `block_wolf_structural_landmarks_are_mirrored`,
//! `block_c_formatting_keeps_structural_landmarks`,
//! `block_horizontal_uses_enclosing_scope_and_trailing_eof`, and the
//! engine half of `block_days_structures_cross_language_and_eof_style`
//! (its last pass, a language NAME with no engine, runs). Each says SKIP
//! on both streams. `block_syntax_install_accepts_disabled_provider`
//! runs in the port's shape: C toggles the syntax provider's function
//! pointer (`syn/synblock.c:339-345`), the port's provider is a kind
//! whose answer is the engine's, so the test holds that the syntax kind
//! answers nothing for the fixture and the level is the same span.
//!
//! C's scan budget is one call timed in nanoseconds (`test_block.c:93-
//! 106`); at 0.2.33 the port has a millisecond clock (G8), so it times 32
//! calls and holds their mean under the same 1 ms, and, as C skips the
//! budget under its sanitizers (`YEW_TEST_INSTRUMENTED`), skips it under
//! `wolf test`'s machine (where `os_exe()` is `wolf`, G23), loudly.

use edit
use text

fn say_skip(what: str) -> int {
    print("block_test: SKIP {what}")
    eprint("block_test: SKIP {what}")
    1
}

fn fixture(t: str) -> text.TextBuf {
    text.textbuf_from_str(t)
}

fn plain() -> edit.UnitCtx {
    edit.unitctx_buf(4, false)
}

fn with_lang() -> edit.UnitCtx {
    edit.unitctx_buf(4, true)
}

fn text_off(t: str, needle: str) -> int {
    let at = t.find(needle) else -1
    assert(at >= 0, "needle {needle} present")
    at
}

fn text_char_after(t: str, needle: str, wanted: str) -> int {
    let start = text_off(t, needle)
    let rest = t[start..t.len]
    let at = rest.find(wanted) else -1
    assert(at >= 0, "{wanted} after {needle}")
    start + at
}

fn level(tb: text.TextBuf, u: edit.UnitCtx, at: int, lvl: int) -> text.Span {
    edit.block_level(tb, u, at, lvl)
}

fn assert_span(actual: text.Span, lo: int, hi: int, what: str) {
    assert(actual.lo == lo, "{what}: lo {actual.lo} == {lo}")
    assert(actual.hi == hi, "{what}: hi {actual.hi} == {hi}")
}

fn bnext(mut tb: text.TextBuf, u: edit.UnitCtx, at: int, alt: bool) -> int {
    edit.unit_next(edit.UNIT_BLOCK, mut tb, u, edit.win_detached(), at, alt)
}

fn bprev(mut tb: text.TextBuf, u: edit.UnitCtx, at: int, alt: bool) -> int {
    edit.unit_prev(edit.UNIT_BLOCK, mut tb, u, edit.win_detached(), at, alt)
}

// `assert_block_navigation_offsets` (`test_block.c:383-403`).
fn assert_navigation(mut tb: text.TextBuf, u: edit.UnitCtx, len: int, stops: List[int]) {
    var alt_i = 0
    while alt_i < 2 {
        let alt = alt_i != 0
        var at = 0
        var i = 0
        while i < stops.len {
            at = bnext(mut tb, u, at, alt)
            assert(at == stops[i], "next stop {i}: {at} == {stops[i]}")
            i += 1
        }
        at = bnext(mut tb, u, at, alt)
        assert(at == len, "next past the last stop: {at} == {len}")
        i = stops.len
        while i > 0 {
            i -= 1
            at = bprev(mut tb, u, at, alt)
            assert(at == stops[i], "prev stop {i}: {at} == {stops[i]}")
        }
        assert(bprev(mut tb, u, at, alt) == 0, "prev past the first stop")
        alt_i += 1
    }
}

fn t_block_paragraph_text_and_blank_runs_are_units() {
    let t = "first\nsecond\n\n \t\nthird\n"
    let tb = fixture(t)
    let u = plain()
    let first = level(tb, u, text_off(t, "second"), 0)
    let gap = level(tb, u, text_off(t, " \t"), 0)
    let third = level(tb, u, text_off(t, "third"), 0)
    assert_span(first, 0, text_off(t, "\n\n") + 1, "first paragraph")
    assert_span(gap, text_off(t, "\n\n") + 1, text_off(t, "third"), "blank run")
    assert_span(third, text_off(t, "third"), t.len, "third paragraph")
}

fn t_block_indent_absorbs_interior_not_trailing_blank_lines() {
    let t = "def f():\n\n    one = 1\n\n    two = 2\n\nnext = 3\n"
    let tb = fixture(t)
    let u = plain()
    let one = text_off(t, "    one")
    let trailing_blank = text_off(t, "\n\nnext") + 1
    let statement = level(tb, u, text_off(t, "one"), 0)
    let suite = level(tb, u, text_off(t, "one"), 1)
    assert(statement.lo >= one, "statement starts at its line")
    assert(suite.lo <= one, "suite covers the first statement")
    assert(suite.hi > text_off(t, "two = 2"), "suite covers the second")
    assert(suite.hi == trailing_blank, "suite stops before the trailing blank: {suite.hi}")
    assert(t.bytes()[suite.hi - 1] as int != 32, "suite does not end in a space")
    assert(suite.hi <= text_off(t, "next = 3"), "suite stops before next")
}

fn t_block_scope_quote_and_comment_suppression() {
    let t = "don't [live]\nx = 'a[hidden'\nx = 'odd[live]\nx = 1; // [hidden]\n# [hidden]\n-- [hidden]\n; [hidden]\n/* [hidden] */ [live2]\n"
    let tb = fixture(t)
    let u = plain()
    let live = text_off(t, "live]")
    let quoted = text_off(t, "hidden'")
    let odd = text_off(t, "live]\n")
    let comment = text_off(t, "hidden]\n#")
    let live2 = text_off(t, "live2")
    var sp = level(tb, u, live, 0)
    assert_span(sp, live - 1, live + 5, "live scope")
    sp = level(tb, u, quoted, 0)
    assert(sp.lo < text_off(t, "x = 'a"), "quoted: no scope inside the quote")
    assert(sp.hi > quoted, "quoted: span covers it")
    let (qm, _) = edit.block_match(tb, u, quoted, false)
    assert(!qm, "no match inside a quote")
    sp = level(tb, u, odd, 0)
    assert_span(sp, odd - 1, odd + 5, "odd-quote line scope")
    let (om, at) = edit.block_match(tb, u, odd, false)
    assert(om && at == odd - 1, "odd-quote line matches its opener")
    sp = level(tb, u, comment, 0)
    assert(sp.lo < comment - 1, "comment: no scope inside")
    let (cm, _) = edit.block_match(tb, u, comment, false)
    assert(!cm, "no match inside a comment")
    sp = level(tb, u, live2, 0)
    assert_span(sp, live2 - 1, live2 + 6, "after a block comment")
}

fn t_block_c_fixture_has_four_hand_computed_levels() {
    let t = "intro\n\nvoid f() {{\n{{\nvalue;\n}}\n}}\n\noutro\n"
    let tb = fixture(t)
    let u = plain()
    let inner_lo = text_off(t, "{{\nvalue")
    let inner_hi = text_off(t, "}}\n}}\n") + 1
    let outer_lo = text_off(t, "void f() {{") + 9
    let outer_hi = text_off(t, "}}\n\n") + 1
    let function_lo = text_off(t, "void f()")
    let function_hi = text_off(t, "\n\noutro") + 1
    var levels = List[text.Span]()
    var i = 0
    while i < 4 {
        (mut levels).push(level(tb, u, inner_lo, i))
        i += 1
    }
    assert_span(levels[0], inner_lo, inner_hi, "level 0")
    assert_span(levels[1], outer_lo, outer_hi, "level 1")
    assert_span(levels[2], function_lo, function_hi, "level 2")
    assert_span(levels[3], 0, t.len, "level 3")
    i = 1
    while i < 4 {
        assert(levels[i].lo <= levels[i - 1].lo, "contains lo")
        assert(levels[i].hi >= levels[i - 1].hi, "contains hi")
        assert(levels[i].lo < levels[i - 1].lo || levels[i].hi > levels[i - 1].hi, "strictly")
        i += 1
    }
}

fn t_block_plain_text_has_three_distinct_containment_levels() {
    let t = "heading\n\n  item\n    detail\n  tail\n\n\nending\n"
    let tb = fixture(t)
    let u = plain()
    let at = text_off(t, "detail")
    var levels = List[text.Span]()
    var i = 0
    while i < 3 {
        (mut levels).push(level(tb, u, at, i))
        i += 1
    }
    i = 1
    while i < 3 {
        assert(levels[i].lo <= levels[i - 1].lo, "contains lo")
        assert(levels[i].hi >= levels[i - 1].hi, "contains hi")
        assert(levels[i].lo < levels[i - 1].lo || levels[i].hi > levels[i - 1].hi, "strictly")
        i += 1
    }
    assert(levels[0].lo > 0, "level 0 is inside")
    assert(levels[2].hi <= t.len, "level 2 within the buffer")
}

fn under_wolf_test() -> bool {
    let instrumented = env_get("YEW_TEST_INSTRUMENTED") else ""
    if instrumented != "" {
        return true
    }
    let exe = os_exe() else {
        return true
    }
    exe.ends_with("/wolf")
}

fn t_block_scan_budget_falls_through_before_distant_pair() -> int {
    let lines = 100000
    let center = 50000
    let distance = 3000
    var bytes = List[byte]()
    var target_lo = 0
    var target_hi = 0
    var line = 0
    while line < lines {
        if line == center - distance {
            (mut bytes).push(123 as byte)
        } else if line == center {
            target_lo = bytes.len
            for b in "target".bytes() {
                (mut bytes).push(b)
            }
            target_hi = bytes.len + 1
        } else if line == center + distance {
            (mut bytes).push(125 as byte)
        }
        (mut bytes).push(10 as byte)
        line += 1
    }
    let tb = text.textbuf_from_owned_bytes(take bytes)
    let u = plain()
    let sp = level(tb, u, target_lo + 1, 0)
    assert_span(sp, target_lo, target_hi, "falls through to the paragraph")
    if under_wolf_test() {
        return say_skip(
            "block_scan_budget_falls_through_before_distant_pair's 1 ms budget: wolf test's machine (os_exe is wolf), as C skips it instrumented",
        )
    }
    let rounds = 32
    let start = time_now_ms()
    var r = 0
    while r < rounds {
        let again = level(tb, u, target_lo + 1, 0)
        assert(again.lo == sp.lo, "stable")
        r += 1
    }
    let elapsed = time_now_ms() - start
    assert(elapsed < rounds, "block scan mean {elapsed} ms / {rounds} calls, budget 1 ms a call")
    0
}

fn t_block_matching_delimiters_ignores_nested_and_suppressed_pairs() {
    let t = "{{ outer [inner] tail }}\nx = '[hidden]' // [comment]\n"
    let tb = fixture(t)
    let u = plain()
    let inner = text_off(t, "inner")
    let hidden = text_off(t, "hidden")
    let (a, open) = edit.block_match(tb, u, inner, false)
    assert(a && open == inner - 1, "opener")
    let (b, close) = edit.block_match(tb, u, inner, true)
    assert(b && close == inner + 5, "closer")
    let (c, _) = edit.block_match(tb, u, hidden, false)
    assert(!c, "no match in a quote")
}

fn t_block_selection_chain_saturates_at_buffer_for_stack_replay() {
    let t = "one\n\n  two\n    three\n"
    let tb = fixture(t)
    let u = plain()
    let at = text_off(t, "three")
    var stack = List[text.Span]()
    var lvl = 0
    while lvl < edit.SEL_DEPTH {
        let next = level(tb, u, at, lvl)
        if stack.len != 0 &&
            next.lo == stack[stack.len - 1].lo &&
            next.hi == stack[stack.len - 1].hi {
            break
        }
        (mut stack).push(next)
        lvl += 1
    }
    assert(stack.len >= 3, "at least three levels: {stack.len}")
    assert(stack.len <= edit.SEL_DEPTH, "within the selection depth")
    assert(stack[stack.len - 1].lo == 0, "saturates at the buffer start")
    assert(stack[stack.len - 1].hi == t.len, "and its end")
    let past = level(tb, u, at, stack.len)
    assert_span(past, stack[stack.len - 1].lo, stack[stack.len - 1].hi, "past the top")
    while stack.len != 0 {
        let replay = (mut stack).pop() else text.span(0, 0)
        assert(replay.lo <= at && replay.hi >= at, "each level contains the point")
    }
}

fn t_block_wolf_structural_landmarks_are_mirrored() -> int {
    say_skip(
        "block_wolf_structural_landmarks_are_mirrored: needs a settled wolf syntax engine (block_fixture_lang, test_block.c:37-58), campaign 08's (yw10)",
    )
}

fn t_block_days_structures_cross_language_and_eof_style() -> int {
    var skipped = 0
    let wolf = "//! check: run(exit=0)\n//! phase: run\n\nfn main() -> !int {{\n    print(\"{{day_of_year(2, 1, false)}}\")\n    \n    0\n}}\n\nfn day_of_year(month: int, day: int, leap: bool) -> int {{\n    var total = 0\n    total += sum_months(month, leap)\n    total += day\n    \n    total\n}}\n\nfn sum_months(month: int, leap: bool) -> int {{\n    var total = 0\n    for i in 0..month {{ total += days_in(i, leap) }}\n    total\n}}\n\nfn days_in(month: int, leap: bool) -> int {{\n    match month {{\n        0  => 31,\n        1  => if leap {{ 29 }} else {{ 28 }},\n        2  => 31,\n        3  => 30,\n        4  => 31,\n        5  => 30,\n        6  => 31,\n        7  => 31,\n        8  => 30,\n        9  => 31,\n        10  => 30,\n        11  => 31,\n        _ => 0,\n    }}\n}}\n"
    let c = "// check\n// phase\n\nint main(void) {{\n    print_day(day_of_year(2, 1, false));\n\n    return 0;\n}}\n\nint day_of_year(int month, int day, bool leap) {{\n    int total = 0;\n    total += sum_months(month, leap);\n    total += day;\n\n    return total;\n}}\n\nint sum_months(int month, bool leap) {{\n    int total = 0;\n    for (int i = 0; i < month; i++) {{ total += days_in(i, leap); }}\n    return total;\n}}\n\nint days_in(int month, bool leap) {{\n    switch (month) {{\n        case 0: return 31;\n        case 1: return leap ? 29 : 28;\n        case 2: return 31;\n        case 3: return 30;\n        case 4: return 31;\n        case 5: return 30;\n        case 6: return 31;\n        case 7: return 31;\n        case 8: return 30;\n        case 9: return 31;\n        case 10: return 30;\n        case 11: return 31;\n        default: return 0;\n    }}\n}}\n"
    var source = 0
    while source < 2 {
        let t = if source == 0 then wolf else c
        var stops = List[int]()
        (mut stops).push(text_char_after(t, if source == 0 then "fn main" else "int main", "{{"))
        (mut stops).push(text_char_after(t, "day_of_year", "{{"))
        (mut stops).push(text_char_after(t, "sum_months", "{{"))
        (mut stops).push(text_char_after(t, if source == 0 then "for i" else "for (int", "{{"))
        (mut stops).push(text_char_after(t, "days_in", "{{"))
        (mut stops).push(
            text_char_after(t, if source == 0 then "match month" else "switch (month)", "{{"),
        )
        let lang = if source == 0 then "wolf" else "c"
        skipped += say_skip(
            "block_days_structures_cross_language_and_eof_style's engine passes ({lang}, with and without the final newline): a settled syntax engine, yw10",
        )
        // The last pass of each source (`test_block.c:578-583`): the
        // language name with no engine — the heuristic landmarks.
        var tb = fixture(t)
        assert_navigation(mut tb, with_lang(), t.len, stops)
        source += 1
    }
    skipped
}

fn t_block_c_formatting_keeps_structural_landmarks() -> int {
    say_skip(
        "block_c_formatting_keeps_structural_landmarks: needs a settled c syntax engine (block_fixture_lang), campaign 08's (yw10)",
    )
}

fn t_block_indent_language_headers_not_statements() {
    let t = "def outer():\n    total = 0\n    if ready:\n        total += 1\n    total += 2\nresult = outer()\n"
    var tb = fixture(t)
    let u = with_lang()
    var stops = List[int]()
    (mut stops).push(text_off(t, "if ready:"))
    assert_navigation(mut tb, u, t.len, stops)
    assert(
        bprev(mut tb, u, text_off(t, "    total += 2"), false) == stops[0],
        "prev lands on the header",
    )
    assert(
        bnext(mut tb, u, text_off(t, "    total = 0"), false) == stops[0],
        "next lands on the header",
    )
}

fn t_block_horizontal_uses_enclosing_scope_and_trailing_eof() -> int {
    say_skip(
        "block_horizontal_uses_enclosing_scope_and_trailing_eof: needs a settled wolf syntax engine (block_fixture_lang), campaign 08's (yw10)",
    )
}

fn t_block_syntax_install_accepts_disabled_provider() {
    let t = "one\n\n  two\n    three\n"
    let tb = fixture(t)
    let u = plain()
    let at = text_off(t, "three")
    let before = level(tb, u, at, 0)
    let (answers, _) = edit.block_provider_enclosing(
        edit.BLOCK_PROVIDER_SYNTAX,
        tb,
        u,
        at,
        text.span(at, at),
    )
    assert(!answers, "the syntax provider answers nothing without an engine")
    let after = level(tb, u, at, 0)
    assert(after.lo == before.lo && after.hi == before.hi, "the level is unchanged")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    var skips = 0
    t_block_paragraph_text_and_blank_runs_are_units()
    t_block_indent_absorbs_interior_not_trailing_blank_lines()
    t_block_scope_quote_and_comment_suppression()
    t_block_c_fixture_has_four_hand_computed_levels()
    t_block_plain_text_has_three_distinct_containment_levels()
    skips += t_block_scan_budget_falls_through_before_distant_pair()
    t_block_matching_delimiters_ignores_nested_and_suppressed_pairs()
    t_block_selection_chain_saturates_at_buffer_for_stack_replay()
    skips += t_block_wolf_structural_landmarks_are_mirrored()
    skips += t_block_days_structures_cross_language_and_eof_style()
    skips += t_block_c_formatting_keeps_structural_landmarks()
    t_block_indent_language_headers_not_statements()
    skips += t_block_horizontal_uses_enclosing_scope_and_trailing_eof()
    t_block_syntax_install_accepts_disabled_provider()
    print(
        "block_test: 14 cases run, {skips} SKIP by name (the syntax engine, yw10; the budget under wolf test)",
    )
}
