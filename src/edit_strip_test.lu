//! member: false
//!
//! The port of sagitta `tests/unit/test_strip.c` (481 lines) at 9ace98c2,
//! one test per C test in registry order (`tests/unit/registry.c:2546-
//! 2553`, then `:2567-2572`): the strip layout engine (Sprint 23 §3) —
//! labels measured in CELLS, never bytes, and scrolled by exactly enough —
//! and Sprint 57.15 §1's offset ownership, at the engine and through a
//! render. C's `yew_strip_layout(e, n, width, active, &scroll, spans,
//! &n_spans, &more_l, &more_r)` is `edit.strip_layout(entries, width,
//! active, scroll)` answering a `StripLayout` (the first `n` entries
//! passed as the list); a C `StripEntry.label` (`char[64]`) is its bytes.
//! C's render fixture (`st_fixture`, `:345-366`) is the editor with a
//! grid and seven extra tabs, laid out; `ed.tabs.scroll`,
//! `.scroll_user`, `.member_scroll` are `ed.tab_scroll`,
//! `ed.tab_scroll_user`, `ed.tab_member_scroll`.
//!
//! `strip_rows_own_their_offsets_independently` puts four tabs in a group
//! (`edit.group_create`, `edit.group_add_member`: Sprint 24's values, the
//! groups fork's) and runs whole.

use edit
use term

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn entry(label: str, payload: int) -> edit.StripEntry {
    edit.StripEntry {
        label: edit.strip_label_cap(bytes_of(label)),
        payload: payload,
        dim: false,
        modified: false,
    }
}

// `st_fill` (`test_strip.c:21-30`): `n` entries labelled by `fmt` with
// their index (the `%d` is `{i}` here), payload = index. `pre` and
// `post` are the format around the `%d`.
fn fill(n: int, pre: str, post: str) -> List[edit.StripEntry] {
    var e = List[edit.StripEntry]()
    var i = 0
    while i < n {
        (mut e).push(entry("{pre}{i}{post}", i))
        i += 1
    }
    e
}

// The first `n` of `e` (C passes the array and a count).
fn first_n(e: List[edit.StripEntry], n: int) -> List[edit.StripEntry] {
    var out = List[edit.StripEntry]()
    var i = 0
    while i < n {
        (mut out).push(copy e[i])
        i += 1
    }
    out
}

fn skip(why: str) {
    print(why)
    eprint(why)
}

// `test_strip_lays_entries_left_to_right_without_gaps` (`:32-59`).
fn t_strip_lays_entries_left_to_right_without_gaps() {
    let e = fill(4, "[", ": a]")
    let lay = edit.strip_layout(e, 80, 0, 0)
    assert(lay.spans.len == 4, "four spans")
    assert(!lay.more_left, "nothing left")
    assert(!lay.more_right, "nothing right")
    assert(lay.spans[0].col0 == 0, "from cell 0")
    var i = 0
    while i < lay.spans.len {
        assert(lay.spans[i].idx == i, "span {i} is entry {i}")
        assert(lay.spans[i].col1 > lay.spans[i].col0, "span {i} has cells")
        // Contiguous: no gap and no overlap.
        if i > 0 {
            assert(lay.spans[i].col0 == lay.spans[i - 1].col1, "span {i} abuts")
        }
        i += 1
    }
}

// `test_strip_measures_cjk_labels_in_cells` (`:61-87`): a CJK label is
// two cells per glyph; a strlen-based engine places the next span early.
fn t_strip_measures_cjk_labels_in_cells() {
    let e = [entry("ab", 0), entry("\u{6F22}\u{5B57}", 0)]
    let ascii_w = edit.strip_label_cells(e[0].label)
    let cjk_w = edit.strip_label_cells(e[1].label)
    assert(ascii_w == 2, "ab is 2 cells")
    assert(cjk_w == 4, "two ideographs are 4 cells: {cjk_w}")
    assert(e[1].label.len == 6, "and 6 bytes")
    let lay = edit.strip_layout(e, 80, 0, 0)
    assert(lay.spans.len == 2, "two spans")
    assert(lay.spans[1].col0 == 2, "the second at 2")
    // Four cells wide, not six bytes wide.
    assert(lay.spans[1].col1 == 6, "ends at 6: {lay.spans[1].col1}")
}

// `test_strip_clips_long_labels` (`:89-102`): labels clip at 24 cells.
fn t_strip_clips_long_labels() {
    let e = entry("[1: a-very-long-file-name-that-keeps-going]", 0)
    assert(edit.strip_label_cells(e.label) == edit.STRIP_LABEL_CELLS, "clipped at 24")
}

// `test_strip_reports_overflow_on_both_sides` (`:104-133`).
fn t_strip_reports_overflow_on_both_sides() {
    let e = fill(10, "[", ": name]")
    // Each label is 10 cells; 40 columns holds four.
    var lay = edit.strip_layout(e, 40, 0, 0)
    assert(lay.spans.len == 4, "four fit")
    assert(!lay.more_left, "nothing left")
    assert(lay.more_right, "more right")
    // Scrolled into the middle: both sides have more.
    lay = edit.strip_layout(e, 40, 3, 3)
    assert(lay.more_left, "more left")
    assert(lay.more_right, "more right")
    assert(lay.spans[0].idx == 3, "from entry 3")
}

// `test_strip_scrolls_by_exactly_enough` (`:135-168`).
fn t_strip_scrolls_by_exactly_enough() {
    let e = fill(10, "[", ": name]")
    var scroll = 0
    // 40 cells holds four 10-cell entries: 0..3 visible.
    var lay = edit.strip_layout(e, 40, 0, scroll)
    scroll = lay.scroll
    assert(scroll == 0, "0")
    // Entry 4 is one past the edge: scrolling by one shows it.
    lay = edit.strip_layout(e, 40, 4, scroll)
    scroll = lay.scroll
    assert(scroll == 1, "by one: {scroll}")
    assert(lay.spans[lay.spans.len - 1].idx == 4, "4 the last shown")
    // Jumping to entry 9 scrolls to show it and no further.
    lay = edit.strip_layout(e, 40, 9, scroll)
    scroll = lay.scroll
    assert(scroll == 6, "to 6: {scroll}")
    assert(lay.spans[lay.spans.len - 1].idx == 9, "9 the last shown")
    assert(!lay.more_right, "nothing right")
    // And back to entry 0 scrolls left to exactly 0.
    lay = edit.strip_layout(e, 40, 0, scroll)
    assert(lay.scroll == 0, "back to 0")
}

// `test_strip_does_not_scroll_when_active_is_visible` (`:170-183`).
fn t_strip_does_not_scroll_when_active_is_visible() {
    let e = fill(10, "[", ": name]")
    let lay = edit.strip_layout(e, 40, 3, 2)
    assert(lay.scroll == 2, "unmoved: {lay.scroll}")
    assert(lay.spans[0].idx == 2, "from entry 2")
}

// `test_strip_places_an_oversized_entry_clipped` (`:185-201`).
fn t_strip_places_an_oversized_entry_clipped() {
    let e = [entry("[0: aaaaaaaaaaaa]", 0), entry("[1: b]", 0)]
    let lay = edit.strip_layout(e, 6, 0, 0)
    assert(lay.spans.len == 1, "one span")
    assert(lay.spans[0].col0 == 0, "from 0")
    assert(lay.spans[0].col1 == 6, "clipped to the strip")
}

// `test_strip_handles_empty_and_zero_width` (`:203-229`).
fn t_strip_handles_empty_and_zero_width() {
    let e = fill(2, "[", "]")
    var lay = edit.strip_layout(first_n(e, 0), 80, 0, 0)
    assert(lay.spans.len == 0, "no entries, no spans")
    assert(!lay.more_left, "nothing left")
    assert(!lay.more_right, "nothing right")
    lay = edit.strip_layout(e, 0, 0, 0)
    assert(lay.spans.len == 0, "no width, no spans")
}

// `test_strip_label_bytes_match_the_clipped_cells` (`:231-271`): a
// clipped label reports the BYTES that fit, not just the cells.
fn t_strip_label_bytes_match_the_clipped_cells() {
    let long_label = bytes_of("[1: a-name-long-enough-to-be-clipped.txt]")
    let fit = edit.strip_label_bytes(long_label)
    assert(edit.strip_label_cells(long_label) == edit.STRIP_LABEL_CELLS, "clipped cells")
    assert(fit < long_label.len, "fewer bytes than the label")
    assert(fit == edit.STRIP_LABEL_CELLS, "the clipped cells' worth: {fit}")
    // A short label is not clipped at all.
    assert(edit.strip_label_bytes(bytes_of("[1: a]")) == 6, "short: whole")
    // CJK: four cells is six BYTES.
    let cjk = bytes_of("\u{6F22}\u{5B57}")
    assert(edit.strip_label_cells(cjk) == 4, "4 cells")
    assert(edit.strip_label_bytes(cjk) == 6, "6 bytes")
}

// `test_strip_user_owned_offset_survives_an_offscreen_active`
// (`:273-317`): `active < 0` says the offset is the user's.
fn t_strip_user_owned_offset_survives_an_offscreen_active() {
    let e = fill(10, "[", ": name]")
    // Entry 0 is active and visible; the user scrolls one right.
    var lay = edit.strip_layout(e, 40, -1, 1)
    assert(lay.scroll == 1, "kept: {lay.scroll}")
    assert(lay.spans[0].idx == 1, "from entry 1")
    assert(lay.more_left, "more left")
    assert(lay.more_right, "more right")
    // Rendering again changes nothing.
    lay = edit.strip_layout(e, 40, -1, lay.scroll)
    assert(lay.scroll == 1, "kept again")
    // All the way to the far end, with entry 0 long gone.
    lay = edit.strip_layout(e, 40, -1, 6)
    assert(lay.scroll == 6, "kept at 6")
    assert(lay.spans[0].idx == 6, "from entry 6")
    assert(!lay.more_right, "nothing right")
    // Following again reveals it, by exactly the minimal walk.
    lay = edit.strip_layout(e, 40, 0, lay.scroll)
    assert(lay.scroll == 0, "back to 0")
    assert(lay.spans[0].idx == 0, "from entry 0")
}

// `test_strip_user_owned_offset_is_still_clamped_into_range` (`:319-
// 343`): not following is not the same as not clamping.
fn t_strip_user_owned_offset_is_still_clamped_into_range() {
    let e = fill(10, "[", ": name]")
    // The list shrinks to three entries with the offset out past them.
    var lay = edit.strip_layout(first_n(e, 3), 40, -1, 9)
    assert(lay.scroll == 2, "clamped to 2: {lay.scroll}")
    assert(lay.spans.len == 1, "one span")
    assert(lay.spans[0].idx == 2, "entry 2")
    lay = edit.strip_layout(first_n(e, 3), 40, -1, -4)
    assert(lay.scroll == 0, "clamped to 0")
    assert(lay.spans[0].idx == 0, "entry 0")
}

// `st_fixture` (`test_strip.c:345-366`): a `cols`-wide grid, `extra`
// tabs, laid out, the clock at 1 s.
fn st_fixture(extra: int, cols: int) -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(24, cols)
    ed.grid_ready = true
    var i = 0
    while i < extra {
        assert(edit.tab_open(mut ed, "/tmp/yew-stripscroll-{i}.txt") >= 0, "open {i}")
        i += 1
    }
    edit.ed_layout(mut ed)
    ed.now_ms = 1000
    ed
}

// `st_paint` (`test_strip.c:368-374`).
fn st_paint(mut ed: edit.Ed) {
    if ed.layout_dirty {
        edit.ed_layout(mut ed)
    }
    edit.region_frame_begin(mut ed.regions)
    let r = copy ed.tab_strip_rect
    edit.tab_strip_draw(mut ed, r)
}

// `test_strip_explicit_row1_offset_survives_the_render` (`:379-413`).
fn t_strip_explicit_row1_offset_survives_the_render() {
    var ed = st_fixture(7, 40)
    edit.tab_switch(mut ed, 0)
    st_paint(mut ed)
    // Following: entry 0 is active, so the strip sits at the left.
    assert(ed.tab_scroll == 0, "at the left")
    assert(!ed.tab_scroll_user, "following")
    // The user scrolls. Without the flag this lasted one frame.
    ed.tab_scroll = 3
    edit.tabs_scroll_owned(mut ed, false)
    st_paint(mut ed)
    assert(ed.tab_scroll == 3, "survives a render: {ed.tab_scroll}")
    // And a second frame, because the clamp ran once per render.
    st_paint(mut ed)
    assert(ed.tab_scroll == 3, "survives a second")
    // The active entry is genuinely off-screen and that is allowed.
    assert(ed.tab_active == 0, "entry 0 still active")
    // Changing the active entry hands the strip back to the follow.
    edit.tab_switch(mut ed, 0)
    assert(!ed.tab_scroll_user, "following again")
    st_paint(mut ed)
    assert(ed.tab_scroll == 0, "back at the left")
}

// `test_strip_rows_own_their_offsets_independently` (`:415-454`): row 1
// and row 2 each own their offset — one row the user's, the other still
// following.
fn t_strip_rows_own_their_offsets_independently() {
    var ed = st_fixture(7, 40)
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 2)
    edit.group_add_member(mut ed, g, 3)
    edit.group_add_member(mut ed, g, 4)
    edit.group_add_member(mut ed, g, 5)
    edit.tab_switch(mut ed, 2)
    st_paint(mut ed)
    assert(edit.active_group_id(ed) == g, "inside the group")
    edit.tabs_scroll_owned(mut ed, true)
    ed.tab_member_scroll = 2
    st_paint(mut ed)
    assert(ed.tab_member_scroll == 2, "row 2's offset survives: {ed.tab_member_scroll}")
    assert(!ed.tab_scroll_user, "row 1 still follows")
    assert(ed.tab_member_scroll_user, "row 2 is the user's")
    edit.tabs_follow_active(mut ed)
    ed.tab_member_scroll = 0
    edit.tabs_scroll_owned(mut ed, false)
    ed.tab_scroll = 2
    st_paint(mut ed)
    assert(ed.tab_scroll == 2, "row 1's offset survives: {ed.tab_scroll}")
    assert(!ed.tab_member_scroll_user, "row 2 follows")
    assert(ed.tab_member_scroll == 0, "row 2 untouched")
}

// `test_strip_close_and_open_resume_following` (`:456-481`): a close
// renumbers, an open grows the list; both resume the follow.
fn t_strip_close_and_open_resume_following() {
    var ed = st_fixture(7, 40)
    edit.tab_switch(mut ed, 0)
    edit.tabs_scroll_owned(mut ed, false)
    ed.tab_scroll = 4
    st_paint(mut ed)
    assert(ed.tab_scroll == 4, "the user's 4")
    assert(edit.tab_close(mut ed, 7), "close 7")
    assert(!ed.tab_scroll_user, "a close resumes following")
    st_paint(mut ed)
    assert(ed.tab_scroll == 0, "followed back to 0")
    edit.tabs_scroll_owned(mut ed, false)
    ed.tab_scroll = 3
    st_paint(mut ed)
    assert(ed.tab_scroll == 3, "the user's 3")
    assert(edit.tab_open(mut ed, "/tmp/yew-stripscroll-new.txt") >= 0, "open")
    assert(!ed.tab_scroll_user, "an open resumes following")
    st_paint(mut ed)
    assert(ed.tab_scroll == 0, "followed back to 0 again")
}

fn main() {
    t_strip_lays_entries_left_to_right_without_gaps()
    t_strip_measures_cjk_labels_in_cells()
    t_strip_clips_long_labels()
    t_strip_reports_overflow_on_both_sides()
    t_strip_scrolls_by_exactly_enough()
    t_strip_does_not_scroll_when_active_is_visible()
    t_strip_places_an_oversized_entry_clipped()
    t_strip_handles_empty_and_zero_width()
    t_strip_label_bytes_match_the_clipped_cells()
    t_strip_user_owned_offset_survives_an_offscreen_active()
    t_strip_user_owned_offset_is_still_clamped_into_range()
    t_strip_explicit_row1_offset_survives_the_render()
    t_strip_rows_own_their_offsets_independently()
    t_strip_close_and_open_resume_following()
    print("strip_test: 14 cases pass, 0 SKIP")
}
