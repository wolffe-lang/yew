//! member: false
//!
//! The port of sagitta `tests/unit/test_re_parse.c` (445 lines), one test
//! per C test in registry order (`tests/unit/registry.c:1592-1600`): the
//! §8 error table with its offsets, the permanent non-goals' wording, the
//! emitted program shapes, the reverse program's anchors, the limits
//! firing during emission, the class cap, the instruction budget, the
//! offset-in-range contract, and the empty-repeat walk bound. C reads the
//! walk from a static (`yew_re_last_compile_walk`); the port reads the
//! compile's own (`search.re_compile_walk`, or `err.walked` on failure).

use search

/// The assertion tally (C's harness counts every `YEW_ASSERT`).
struct Tally {
    n: int,
}

fn ok(mut t: Tally, cond: bool, what: str) {
    t.n += 1
    assert(cond, what)
}

fn pb(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn hexv(c: int) -> int {
    if c >= 48 && c <= 57 then c - 48 else (if c >= 97 && c <= 102 then c - 87 else c - 55)
}

// Raw bytes from hex pairs, for patterns a `str` cannot hold.
fn raw(hex: str) -> List[byte] {
    var v = List[byte]()
    let b = hex.bytes()
    var i = 0
    while i + 1 < b.len {
        (mut v).push((hexv(b[i] as int) * 16 + hexv(b[i + 1] as int)) as byte)
        i += 2
    }
    v
}

fn cat(a: List[byte], b: List[byte]) -> List[byte] {
    var v = copy a
    for x in b {
        (mut v).push(x)
    }
    v
}

fn compiles(pat: List[byte], flags: int, mut err: search.ReErr) -> bool {
    let _re = search.re_compile(pat, flags, mut err) else {
        return false
    }
    true
}

const WHY: str = "(yew's regex engine is linear-time by design; see man yew-regex)"

// `check_error` (`test_re_parse.c:75-104`): -1 for `off` checks only the
// message.
fn check_error(mut t: Tally, pat: str, flags: int, msg: str, off: int) {
    var err = search.re_err_new()
    err.off = 4294967295
    let p = pb(pat)
    let refused = !compiles(p, flags, mut err)
    ok(mut t, refused, "/{pat}/ compiled but should have failed")
    ok(mut t, err.msg.len > 0, "/{pat}/ has a message")
    ok(mut t, err.msg == msg, "/{pat}/ said \"{err.msg}\", want \"{msg}\"")
    ok(mut t, err.off <= p.len, "/{pat}/ off {err.off} inside the pattern")
    if off >= 0 {
        ok(mut t, err.off == off, "/{pat}/ off={err.off}, want {off}")
    }
}

fn t_re_error_table(mut t: Tally) {
    // --- §8 table, row for row
    check_error(mut t, "[abc", 0, "unterminated character class", 0)
    check_error(mut t, "x[a-", 0, "unterminated character class", 1)
    check_error(mut t, "(abc", 0, "unterminated group", 0)
    check_error(mut t, "a(b(c)", 0, "unterminated group", 1)
    check_error(mut t, "abc)", 0, "unmatched )", 3)
    check_error(mut t, ")", 0, "unmatched )", 0)
    check_error(mut t, "*a", 0, "nothing to repeat", 0)
    check_error(mut t, "+", 0, "nothing to repeat", 0)
    check_error(mut t, "?x", 0, "nothing to repeat", 0)
    check_error(mut t, "a{{2,1}}", 0, "invalid repeat: min 2 > max 1", 1)
    check_error(mut t, "a{{0,2000}}", 0, "repeat count 2000 exceeds 1000", 1)
    check_error(mut t, "a{{2000}}", 0, "repeat count 2000 exceeds 1000", 1)
    check_error(mut t, "abc\\", 0, "trailing backslash", 3)
    check_error(mut t, "\\", 0, "trailing backslash", 0)
    check_error(mut t, "a\\q", 0, "unknown escape '\\q'", 1)
    check_error(mut t, "\\x{{}}", 0, "invalid codepoint escape", 0)
    check_error(mut t, "\\x{{110000}}", 0, "invalid codepoint escape", 0)
    check_error(mut t, "\\x{{ZZ}}", 0, "invalid codepoint escape", 0)
    check_error(mut t, "\\xZZ", 0, "invalid codepoint escape", 0)
    // The classic POSIX mistake: one layer of brackets, not two.
    check_error(mut t, "[:alpha:]", 0, "[:alpha:] is only valid inside [...]", 0)
    check_error(mut t, "x[:digit:]", 0, "[:digit:] is only valid inside [...]", 1)
    // Offset 1: the caret points at the inner `[:`.
    check_error(mut t, "[[:foo:]]", 0, "unknown POSIX class '[:foo:]'", 1)
    // --- permanent non-goals, NOT sprint deferrals
    check_error(mut t, "(?=a)", 0, "lookaround is not supported {WHY}", 0)
    check_error(mut t, "(?!a)", 0, "lookaround is not supported {WHY}", 0)
    check_error(mut t, "(?<=a)", 0, "lookaround is not supported {WHY}", 0)
    check_error(mut t, "(?<!a)", 0, "lookaround is not supported {WHY}", 0)
    check_error(mut t, "(?>a)", 0, "atomic groups are not supported {WHY}", 0)
    check_error(mut t, "a*+", 0, "possessive quantifiers are not supported {WHY}", 2)
    check_error(mut t, "(a)\\1", 0, "backreferences are not supported {WHY}", 3)
    check_error(mut t, "\\9", 0, "backreferences are not supported {WHY}", 0)
    check_error(mut t, "(?P<n>a)", 0, "named groups are not supported in 1.0", 0)
    // --- misc parse errors
    check_error(mut t, "[z-a]", 0, "invalid range in character class", 0)
    check_error(mut t, "(?q)", 0, "unknown group flags", -1)
}

fn t_re_non_goals_are_not_sprint_deferrals(mut t: Tally) {
    // DoD 8's other half: these are never coming, so no message may name
    // a sprint.
    for pat in "(?=a) (?!a) (?<=a) (?<!a) (?>a) a*+ \\1".words() {
        var err = search.re_err_new()
        let refused = !compiles(pb(pat), 0, mut err)
        ok(mut t, refused, "/{pat}/ refused")
        ok(mut t, err.msg.len > 0, "/{pat}/ has a message")
        ok(mut t, !err.msg.contains("Sprint"), "/{pat}/ names no sprint")
        ok(mut t, err.msg.contains("linear-time by design"), "/{pat}/ says why")
    }
}

// `op_name` (`test_re_parse.c:146-165`).
fn op_name(op: int) -> str {
    match op {
        0 => "CHAR",
        1 => "CLASS",
        2 => "ANY",
        3 => "SPLIT",
        4 => "JMP",
        5 => "SAVE",
        6 => "BOL",
        7 => "EOL",
        8 => "BOT",
        9 => "EOT",
        10 => "WORDB",
        11 => "NWORDB",
        12 => "MATCH",
        _ => "?",
    }
}

fn shape_of(re: search.Re) -> str {
    var s = ""
    var i = 0
    while i < search.re_prog_len(re) {
        let ins = search.re_prog_at(re, i)
        s = if i == 0 then op_name(ins.op) else "{s} {op_name(ins.op)}"
        i += 1
    }
    s
}

fn check_shape(mut t: Tally, pat: str, flags: int, want: str) {
    var err = search.re_err_new()
    let re = search.re_compile_str(pat, flags, mut err) else {
        ok(mut t, false, "/{pat}/ compiles: {err.msg}")
        return
    }
    let got = shape_of(re)
    ok(mut t, got == want, "/{pat}/ shape\n  got  {got}\n  want {want}")
}

fn t_re_program_shapes(mut t: Tally) {
    // Every program is wrapped in SAVE 0 ... SAVE 1, MATCH.
    check_shape(mut t, "a", 0, "SAVE CHAR SAVE MATCH")
    check_shape(mut t, "abc", 0, "SAVE CHAR CHAR CHAR SAVE MATCH")
    check_shape(mut t, ".", 0, "SAVE ANY SAVE MATCH")
    check_shape(mut t, "[a-z]", 0, "SAVE CLASS SAVE MATCH")
    check_shape(mut t, "\\d", 0, "SAVE CLASS SAVE MATCH")
    // Alternation: SPLIT, branch, JMP over the second branch.
    check_shape(mut t, "a|b", 0, "SAVE SPLIT CHAR JMP CHAR SAVE MATCH")
    // Star: SPLIT at the top, JMP back to it.
    check_shape(mut t, "a*", 0, "SAVE SPLIT CHAR JMP SAVE MATCH")
    // Lazy star: the same shape, only the SPLIT targets swap.
    check_shape(mut t, "a*?", 0, "SAVE SPLIT CHAR JMP SAVE MATCH")
    // Plus: body first, then the SPLIT that loops back.
    check_shape(mut t, "a+", 0, "SAVE CHAR SPLIT SAVE MATCH")
    check_shape(mut t, "a?", 0, "SAVE SPLIT CHAR SAVE MATCH")
    // Groups bracket their body with SAVE pairs.
    check_shape(mut t, "(a)", 0, "SAVE SAVE CHAR SAVE SAVE MATCH")
    // Non-capturing groups consume no slots and emit no SAVEs.
    check_shape(mut t, "(?:a)", 0, "SAVE CHAR SAVE MATCH")
    // {m,n} expands by copying: 2 mandatory, 1 optional.
    check_shape(mut t, "a{{2,3}}", 0, "SAVE CHAR CHAR SPLIT CHAR SAVE MATCH")
    check_shape(mut t, "a{{3}}", 0, "SAVE CHAR CHAR CHAR SAVE MATCH")
    // {m,} is m copies then a star.
    check_shape(mut t, "a{{2,}}", 0, "SAVE CHAR CHAR SPLIT CHAR JMP SAVE MATCH")
    // Anchors and boundaries are their own opcodes.
    check_shape(mut t, "^a$", 0, "SAVE BOL CHAR EOL SAVE MATCH")
    check_shape(mut t, "\\Aa\\z", 0, "SAVE BOT CHAR EOT SAVE MATCH")
    check_shape(mut t, "\\ba\\B", 0, "SAVE WORDB CHAR NWORDB SAVE MATCH")
    // ICASE turns a literal into a class at COMPILE time.
    check_shape(mut t, "k", search.RE_ICASE, "SAVE CLASS SAVE MATCH")
    // A literal-flag pattern is all CHARs, metacharacters included.
    check_shape(mut t, "a*b", search.RE_LITERAL, "SAVE CHAR CHAR CHAR SAVE MATCH")
    // The empty pattern still saves and matches.
    check_shape(mut t, "", 0, "SAVE SAVE MATCH")
}

fn t_re_reverse_program_swaps_anchors(mut t: Tally) {
    // §6c: the reverse program is the same AST with concatenation flipped
    // and the directional anchors swapped; \b is symmetric.
    var err = search.re_err_new()
    let re = search.re_compile_str("^ab$", 0, mut err) else {
        ok(mut t, false, "/^ab$/ compiles")
        return
    }
    ok(mut t, search.re_prog_len(re) == search.re_rprog_len(re), "the two programs are one length")
    ok(mut t, search.re_prog_at(re, 1).op == search.RE_BOL, "forward 1 is BOL")
    ok(mut t, search.re_prog_at(re, 2).arg == 97, "forward 2 is a")
    ok(mut t, search.re_prog_at(re, 3).arg == 98, "forward 3 is b")
    ok(mut t, search.re_prog_at(re, 4).op == search.RE_EOL, "forward 4 is EOL")
    // Reverse: `$` leads as a BOL, the characters in the other order, `^`
    // trails as an EOL.
    ok(mut t, search.re_rprog_at(re, 1).op == search.RE_BOL, "reverse 1 is BOL")
    ok(mut t, search.re_rprog_at(re, 2).arg == 98, "reverse 2 is b")
    ok(mut t, search.re_rprog_at(re, 3).arg == 97, "reverse 3 is a")
    ok(mut t, search.re_rprog_at(re, 4).op == search.RE_EOL, "reverse 4 is EOL")
    let re2 = search.re_compile_str("\\Aa\\z", 0, mut err) else {
        ok(mut t, false, "/\\Aa\\z/ compiles")
        return
    }
    ok(mut t, search.re_rprog_at(re2, 1).op == search.RE_BOT, "reverse 1 is BOT")
    ok(mut t, search.re_rprog_at(re2, 3).op == search.RE_EOT, "reverse 3 is EOT")
    let re3 = search.re_compile_str("\\ba", 0, mut err) else {
        ok(mut t, false, "/\\ba/ compiles")
        return
    }
    ok(mut t, search.re_rprog_at(re3, 2).op == search.RE_WORDB, "\\b stays put")
}

fn refused_with(pat: List[byte], flags: int, mut err: search.ReErr) -> bool {
    !compiles(pat, flags, mut err)
}

fn t_re_limits_fire_during_emission(mut t: Tally) {
    // DoD 11: 33 groups is one past the limit.
    var big = ""
    var i = 0
    while i < 33 {
        big = "{big}(a)"
        i += 1
    }
    var err = search.re_err_new()
    ok(mut t, refused_with(pb(big), 0, mut err), "33 groups refused")
    ok(mut t, err.msg == "too many capture groups (max 32)", "33 groups: {err.msg}")
    // The program limit, checked DURING emission.
    err = search.re_err_new()
    ok(mut t, refused_with(pb("(a{{1000}}){{1000}}"), 0, mut err), "a million instructions refused")
    ok(mut t, err.msg == "pattern too complex (program limit 4096)", "program limit: {err.msg}")
    // Pattern length.
    var huge = List[byte]()
    i = 0
    while i < search.RE_MAX_PATTERN + 8 {
        (mut huge).push(97 as byte)
        i += 1
    }
    err = search.re_err_new()
    ok(mut t, refused_with(huge, 0, mut err), "64 KiB + 8 refused")
    ok(mut t, err.msg == "pattern too long (max 64 KiB)", "pattern length: {err.msg}")
}

fn t_re_character_class_limit(mut t: Tally) {
    var pat = List[byte]()
    var i = 0
    while i < search.RE_MAX_CLASSES + 1 {
        for b in "[a]".bytes() {
            (mut pat).push(b)
        }
        i += 1
    }
    var fits = List[byte]()
    i = 0
    while i < search.RE_MAX_CLASSES * 3 {
        (mut fits).push(pat[i])
        i += 1
    }
    var err = search.re_err_new()
    ok(mut t, !refused_with(fits, 0, mut err), "256 classes compile")
    // YEW-F-089: the exact class-cap boundary and its diagnostic.
    err = search.re_err_new()
    ok(mut t, refused_with(pat, 0, mut err), "257 classes refused")
    ok(mut t, err.msg == "too many character classes (max 256)", "class cap: {err.msg}")
    ok(mut t, err.off == pat.len, "class cap off {err.off}, want {pat.len}")
}

fn t_re_inst_size_budget(mut t: Tally) {
    // DoD 11. C asserts sizeof(ReInst) <= 16; the port's instruction is
    // four ints in memory and its packed form is C's 16-byte record.
    var err = search.re_err_new()
    let re = search.re_compile_str("a", 0, mut err) else {
        ok(mut t, false, "/a/ compiles")
        return
    }
    var packed = List[byte]()
    ok(mut t, search.re_pack(re, mut packed), "/a/ packs")
    // 96-byte header, then 4 forward and 4 reverse instructions.
    ok(mut t, packed.len == 96 + 8 * 16, "a packed instruction is 16 bytes ({packed.len})")
}

fn t_re_error_offsets_are_always_in_range(mut t: Tally) {
    // A caret rendered past the end of the prompt is worse than none.
    for pat in "[ ( ) * a{{ a{{2,1}} \\ \\x \\x{{ [[: (? (?i a** [a- \\q ((( []".words() {
        var err = search.re_err_new()
        err.off = 4294967295
        if refused_with(pb(pat), 0, mut err) {
            ok(mut t, err.msg.len > 0, "/{pat}/ has a message")
            ok(mut t, err.off <= pat.len, "/{pat}/ off {err.off} in range")
        }
    }
}

// fuzz_re_compile watchdog (seeds 20260929, 20261002): stacked counted
// repeats over a body that emits NOTHING. The walk must be bounded by the
// pattern, not by the counts.
fn t_re_empty_repeat_bodies_are_not_walked_per_copy(mut t: Tally) {
    var rows = List[List[byte]]()
    (mut rows).push(cat(raw("a0"), pb("{{0}}{{110}}{{1000}}{{1,1000}}???")))
    (mut rows).push(cat(raw("81"), pb(",}}{{1,}}{{01,}}{{0}}{{110}}{{100}}{{110}}{{1000}}")))
    (mut rows).push(pb("a{{0}}{{1000}}{{100}}{{100}}"))
    (mut rows).push(pb("(?:(?:){{1000}}){{1000}}x*"))
    var lens = List[int]()
    (mut lens).push(26)
    (mut lens).push(36)
    (mut lens).push(20)
    (mut lens).push(22)
    var flag_sets = List[int]()
    (mut flag_sets).push(0)
    (mut flag_sets).push(search.RE_ICASE)
    (mut flag_sets).push(search.RE_DOTALL)
    (mut flag_sets).push(search.RE_ICASE | search.RE_DOTALL)
    var r = 0
    while r < rows.len {
        ok(mut t, rows[r].len == lens[r], "row {r} is {lens[r]} bytes ({rows[r].len})")
        for f in flag_sets {
            var err = search.re_err_new()
            let re = search.re_compile(rows[r], f, mut err) else {
                ok(mut t, false, "row {r} flags {f} compiles: {err.msg}")
                continue
            }
            ok(
                mut t,
                search.re_compile_walk(re) <= 256,
                "row {r} flags {f} walked {search.re_compile_walk(re)}",
            )
        }
        r += 1
    }
    // What survives is exactly what was not repeated away.
    check_shape(mut t, "a{{0}}{{1000}}{{100}}{{100}}", 0, "SAVE SAVE MATCH")
    check_shape(mut t, "x(?:a{{0}}){{1000}}", 0, "SAVE CHAR SAVE MATCH")
    // A NON-empty body still hits the cap at emission.
    var err = search.re_err_new()
    ok(
        mut t,
        refused_with(pb("(?:a{{0}}b){{1000}}{{1000}}"), 0, mut err),
        "a non-empty body hits the cap",
    )
    ok(mut t, err.msg == "pattern too complex (program limit 4096)", "the cap's message: {err.msg}")
    ok(mut t, err.walked <= 8 * search.RE_MAX_PROG, "the capped walk {err.walked} is bounded")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    var t = Tally { n: 0 }
    t_re_error_table(mut t)
    t_re_non_goals_are_not_sprint_deferrals(mut t)
    t_re_program_shapes(mut t)
    t_re_reverse_program_swaps_anchors(mut t)
    t_re_limits_fire_during_emission(mut t)
    t_re_character_class_limit(mut t)
    t_re_inst_size_budget(mut t)
    t_re_error_offsets_are_always_in_range(mut t)
    t_re_empty_repeat_bodies_are_not_walked_per_copy(mut t)
    print("re_parse_test: 9 cases pass, {t.n} assertions")
}
