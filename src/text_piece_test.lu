//! member: false
//!
//! The port of sagitta `tests/unit/test_piece.c` (670 lines), one test per
//! C test in registry order (`tests/unit/registry.c:257-283`). The three
//! tests whose C forks a child to see `YEW_BUG` (exit 4) re-execute this
//! binary with `--bug N` (yw01's pattern, `src/term_render_test.lu`), and
//! skip loudly on the checked machine, where `os_exe()` is `wolf`.

use std.fs
use std.process
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

// `textbuf_materialize`, `test_piece.c:14-31`: through the chunk iterator,
// every chunk non-empty.
fn materialize(tb: text.TextBuf) -> List[byte] {
    var out = List[byte]()
    var it = text.textiter_new()
    if text.textiter_begin(mut it, tb, text.byteoff(0)) {
        loop {
            let c = text.textiter_chunk(it, tb)
            assert(c.ok, "chunk")
            assert(c.len > 0, "chunk non-empty")
            var i = 0
            while i < c.len {
                (mut out).push(text.store_byte(tb, c.src, c.at + i))
                i += 1
            }
            if !text.textiter_advance(mut it, tb) {
                break
            }
        }
    }
    out
}

fn snap_materialize(tb: text.TextBuf, snap: text.TextSnap) -> List[byte] {
    var out = List[byte]()
    var it = text.textiter_new()
    if text.textsnap_iter(mut it, tb, snap, text.byteoff(0)) {
        loop {
            let c = text.textiter_chunk(it, tb)
            assert(c.ok, "snapshot chunk")
            assert(c.len > 0, "snapshot chunk non-empty")
            var i = 0
            while i < c.len {
                (mut out).push(text.store_byte(tb, c.src, c.at + i))
                i += 1
            }
            if !text.textiter_advance(mut it, tb) {
                break
            }
        }
    }
    out
}

fn assert_content(tb: text.TextBuf, expected: str) {
    let actual = materialize(tb)
    assert(text.textbuf_len(tb) == expected.len, "length {expected.len}")
    assert(same(actual, bytes_of(expected)), "content {expected}")
}

fn assert_content_bytes(tb: text.TextBuf, expected: List[byte]) {
    let actual = materialize(tb)
    assert(text.textbuf_len(tb) == expected.len, "length")
    assert(same(actual, expected), "content")
}

fn assert_snap_content(tb: text.TextBuf, snap: text.TextSnap, expected: List[byte]) {
    let actual = snap_materialize(tb, snap)
    assert(snap.len == expected.len, "snapshot length")
    assert(same(actual, expected), "snapshot content")
}

fn t_piece_construct_empty() {
    var tb = text.textbuf_new()
    assert(text.textbuf_len(tb) == 0, "empty length")
    assert(text.textbuf_line_count(tb) == 1, "one line")
    assert(text.textbuf_piece_count(tb) == 0, "no piece")
    text.textbuf_check(tb)
    assert_content(tb, "")
    text.textbuf_free(mut tb)
}

fn t_piece_construct_bytes() {
    var source = bytes_of("alpha\nbeta")
    var tb = text.textbuf_from_bytes(source, 0, source.len)
    source[0] = 88 as byte
    text.textbuf_check(tb)
    assert(text.textbuf_line_count(tb) == 2, "two lines")
    assert(text.textbuf_piece_count(tb) == 1, "one piece")
    assert_content(tb, "alpha\nbeta")
    text.textbuf_free(mut tb)
}

fn t_piece_construct_owned_bytes() {
    // C asserts the store IS the handed buffer (`tb->orig.bytes ==
    // bytes`); a taken list moves into the store, so the port asserts the
    // store holds those bytes and their length, no copy made.
    var bytes = List[byte]()
    (mut bytes).push(97 as byte)
    (mut bytes).push(10 as byte)
    (mut bytes).push(98 as byte)
    (mut bytes).push(0 as byte)
    var tb = text.textbuf_from_owned_bytes(take bytes)
    assert(tb.orig.bytes.len == 4, "the store is the handed list")
    assert(text.textbuf_len(tb) == 4, "length 4")
    assert(text.textbuf_line_count(tb) == 2, "two lines")
    var want = bytes_of("a\nb")
    (mut want).push(0 as byte)
    assert_content_bytes(tb, want)
    text.textbuf_check(tb)
    text.textbuf_free(mut tb)
}

fn t_piece_insert_positions() {
    var front = text.textbuf_from_str("bc")
    var middle = text.textbuf_from_str("ac")
    var end = text.textbuf_from_str("ab")
    text.textbuf_insert_str(mut front, text.byteoff(0), "a")
    text.textbuf_check(front)
    assert_content(front, "abc")
    text.textbuf_insert_str(mut middle, text.byteoff(1), "b")
    text.textbuf_check(middle)
    assert_content(middle, "abc")
    text.textbuf_insert_str(mut end, text.byteoff(2), "c")
    text.textbuf_check(end)
    assert_content(end, "abc")
    text.textbuf_free(mut front)
    text.textbuf_free(mut middle)
    text.textbuf_free(mut end)
}

fn assert_insert_span_reuses_store(src: int) {
    var tb = text.textbuf_from_str("orig\n")
    text.textbuf_insert_str(mut tb, text.byteoff(5), "add\n")
    let sp = if src == text.STORE_ORIG then text.span(0, 5) else text.span(0, 4)
    let add_len = tb.add.bytes.len
    let gen = tb.gen
    text.textbuf_insert_span(mut tb, text.byteoff(0), src, sp)
    text.textbuf_check(tb)
    assert(tb.add.bytes.len == add_len, "no append")
    assert(tb.gen == gen + 1, "one generation")
    assert(text.textbuf_line_count(tb) == 4, "four lines")
    if src == text.STORE_ORIG {
        assert_content(tb, "orig\norig\nadd\n")
    } else {
        assert_content(tb, "add\norig\nadd\n")
    }
    text.textbuf_free(mut tb)
}

fn t_piece_insert_every_seam() {
    var left_seam = text.textbuf_from_str("abcdef")
    var right_seam = text.textbuf_from_str("abcdef")
    text.textbuf_insert_str(mut left_seam, text.byteoff(3), "X")
    text.textbuf_check(left_seam)
    assert(text.textbuf_piece_count(left_seam) == 3, "three pieces")
    text.textbuf_insert_str(mut left_seam, text.byteoff(3), "L")
    text.textbuf_check(left_seam)
    assert_content(left_seam, "abcLXdef")
    text.textbuf_insert_str(mut right_seam, text.byteoff(3), "X")
    text.textbuf_check(right_seam)
    assert(text.textbuf_piece_count(right_seam) == 3, "three pieces")
    text.textbuf_insert_str(mut right_seam, text.byteoff(4), "R")
    text.textbuf_check(right_seam)
    assert_content(right_seam, "abcXRdef")
    text.textbuf_free(mut left_seam)
    text.textbuf_free(mut right_seam)
    assert_insert_span_reuses_store(text.STORE_ORIG)
    assert_insert_span_reuses_store(text.STORE_ADD)
}

fn t_piece_insert_span_recoalesces_boundaries() {
    var tb = text.textbuf_from_str("abcdef")
    text.textbuf_delete(mut tb, text.span(2, 4))
    text.textbuf_check(tb)
    assert(text.textbuf_piece_count(tb) == 2, "two pieces")
    text.textbuf_insert_span(mut tb, text.byteoff(2), text.STORE_ORIG, text.span(2, 4))
    text.textbuf_check(tb)
    assert(text.textbuf_piece_count(tb) == 1, "recoalesced")
    assert_content(tb, "abcdef")
    text.textbuf_free(mut tb)
}

fn t_piece_insert_accepts_exposed_chunk_alias() {
    // C inserts a chunk pointer that aliases the add store, at the moment
    // the store is full; the port's chunk is `(src, at, len)`, so the
    // caller reads it into a list — the same bytes at the same moment.
    var tb = text.textbuf_new()
    text.textbuf_insert_str(mut tb, text.byteoff(0), "a")
    text.textbuf_check(tb)
    let fill_len = tb.add.cap - tb.add.bytes.len
    var fill = List[byte]()
    var i = 0
    while i < fill_len {
        (mut fill).push(98 as byte)
        i += 1
    }
    text.textbuf_insert(mut tb, text.byteoff(text.textbuf_len(tb)), fill)
    text.textbuf_check(tb)
    assert(tb.add.bytes.len == tb.add.cap, "store full")
    let before = materialize(tb)
    var it = text.textiter_new()
    assert(text.textiter_begin(mut it, tb, text.byteoff(0)), "begin")
    let c = text.textiter_chunk(it, tb)
    assert(c.ok, "chunk")
    assert(c.len == before.len, "one chunk")
    var aliased = List[byte]()
    i = 0
    while i < c.len {
        (mut aliased).push(text.store_byte(tb, c.src, c.at + i))
        i += 1
    }
    text.textbuf_insert(mut tb, text.byteoff(text.textbuf_len(tb)), aliased)
    text.textbuf_check(tb)
    let after = materialize(tb)
    assert(after.len == before.len * 2, "doubled")
    var twice = copy before
    for b in before {
        (mut twice).push(b)
    }
    assert(same(after, twice), "both halves")
    text.textbuf_free(mut tb)
}

fn t_piece_insert_recoalesces_after_delete() {
    var tb = text.textbuf_new()
    text.textbuf_insert_str(mut tb, text.byteoff(0), "ab")
    text.textbuf_check(tb)
    text.textbuf_delete(mut tb, text.span(0, 1))
    text.textbuf_check(tb)
    text.textbuf_insert_str(mut tb, text.byteoff(1), "c")
    text.textbuf_check(tb)
    assert(text.textbuf_piece_count(tb) == 1, "one piece")
    assert_content(tb, "bc")
    text.textbuf_free(mut tb)
}

fn t_piece_delete_single_byte() {
    var tb = text.textbuf_from_str("abc")
    text.textbuf_delete(mut tb, text.span(1, 2))
    text.textbuf_check(tb)
    assert_content(tb, "ac")
    text.textbuf_free(mut tb)
}

fn t_piece_delete_cross_piece() {
    var tb = text.textbuf_from_str("abcdef")
    text.textbuf_insert_str(mut tb, text.byteoff(3), "XYZ")
    text.textbuf_check(tb)
    text.textbuf_delete(mut tb, text.span(2, 7))
    text.textbuf_check(tb)
    assert_content(tb, "abef")
    text.textbuf_free(mut tb)
}

fn t_piece_delete_whole_buffer() {
    var tb = text.textbuf_from_str("abc\ndef")
    text.textbuf_delete(mut tb, text.span(0, 7))
    text.textbuf_check(tb)
    assert(text.textbuf_line_count(tb) == 1, "one line")
    assert(text.textbuf_piece_count(tb) == 0, "no piece")
    assert_content(tb, "")
    text.textbuf_free(mut tb)
}

fn t_piece_delete_empty_range() {
    var tb = text.textbuf_from_str("abc")
    let gen = tb.gen
    text.textbuf_delete(mut tb, text.span(1, 1))
    text.textbuf_check(tb)
    assert(tb.gen == gen, "no generation")
    assert_content(tb, "abc")
    text.textbuf_free(mut tb)
}

fn t_piece_delete_recoalesces_adjacent_spans() {
    var tb = text.textbuf_from_str("abcdef")
    text.textbuf_insert_str(mut tb, text.byteoff(3), "X")
    text.textbuf_check(tb)
    assert(text.textbuf_piece_count(tb) == 3, "three pieces")
    text.textbuf_delete(mut tb, text.span(3, 4))
    text.textbuf_check(tb)
    assert(text.textbuf_piece_count(tb) == 1, "one piece")
    assert_content(tb, "abcdef")
    text.textbuf_free(mut tb)
}

fn t_piece_iterator_chunks_are_maximal_after_delete() {
    var tb = text.textbuf_from_str("abcdef")
    text.textbuf_insert_str(mut tb, text.byteoff(3), "X")
    text.textbuf_check(tb)
    text.textbuf_delete(mut tb, text.span(3, 4))
    text.textbuf_check(tb)
    var it = text.textiter_new()
    assert(text.textiter_begin(mut it, tb, text.byteoff(0)), "begin")
    let c = text.textiter_chunk(it, tb)
    assert(c.ok && c.len == 6, "one chunk of six")
    var got = List[byte]()
    var i = 0
    while i < c.len {
        (mut got).push(text.store_byte(tb, c.src, c.at + i))
        i += 1
    }
    assert(same(got, bytes_of("abcdef")), "abcdef")
    assert(!text.textiter_advance(mut it, tb), "no second chunk")
    text.textbuf_free(mut tb)
}

fn t_piece_line_mapping_edges() {
    let starts = [0, 1, 2, 4, 9]
    let span_lo = [0, 1, 2, 4, 9]
    let span_hi = [1, 2, 4, 9, 9]
    var tb = text.textbuf_from_str("\n\nx\nlast\n")
    var no_eof = text.textbuf_from_str("a\nlast")
    text.textbuf_check(tb)
    assert(text.textbuf_line_count(tb) == 5, "five lines")
    var i = 0
    while i < 5 {
        let start = text.textbuf_line_start(tb, text.lineno(i)) as int
        let sp = text.textbuf_line_span(tb, text.lineno(i))
        assert(start == starts[i], "start {i}")
        assert(text.textbuf_line_of(tb, text.byteoff(start)) as int == i, "line_of {i}")
        assert(sp.lo == span_lo[i] && sp.hi == span_hi[i], "span {i}")
        i += 1
    }
    assert(text.textbuf_line_span(no_eof, text.lineno(1)).lo == 2, "no-eof lo")
    assert(text.textbuf_line_span(no_eof, text.lineno(1)).hi == 6, "no-eof hi")
    assert(text.textbuf_line_of(no_eof, text.byteoff(6)) as int == 1, "end is the last line")
    text.textbuf_free(mut tb)
    text.textbuf_free(mut no_eof)
}

fn t_piece_line_mapping_mixed_fixture() {
    let fixture_len = 65536
    var fixture = List[byte]()
    var off = 0
    while off < fixture_len {
        if off % 97 == 0 {
            (mut fixture).push(10 as byte)
        } else if off % 211 == 0 {
            (mut fixture).push(13 as byte)
        } else {
            (mut fixture).push((97 + off % 26) as byte)
        }
        off += 1
    }
    var tb = text.textbuf_from_bytes(fixture, 0, fixture.len)
    text.textbuf_check(tb)
    off = 0
    while off <= fixture_len {
        let line = text.textbuf_line_of(tb, text.byteoff(off)) as int
        let start = text.textbuf_line_start(tb, text.lineno(line)) as int
        assert(start <= off, "start before offset")
        assert(text.textbuf_line_of(tb, text.byteoff(start)) as int == line, "start round-trips")
        off += 1
    }
    text.textbuf_free(mut tb)
}

fn t_piece_line_iterator_yields_spans() {
    var tb = text.textbuf_from_str("a\n\nb")
    let (it0, ok) = text.lineiter_begin(tb, text.lineno(1))
    assert(ok, "begin at line 1")
    var it = it0
    let lo = [2, 3]
    let hi = [3, 4]
    var i = 0
    loop {
        let (more, sp) = text.lineiter_next(mut it, tb)
        if !more {
            break
        }
        assert(i < 2, "at most two")
        assert(sp.lo == lo[i] && sp.hi == hi[i], "span {i}")
        i += 1
    }
    assert(i == 2, "two spans")
    text.textbuf_free(mut tb)
}

fn t_piece_sequential_insert_coalesces() {
    var tb = text.textbuf_new()
    var i = 0
    while i < 10000 {
        text.textbuf_insert_str(mut tb, text.byteoff(i), "q")
        text.textbuf_check(tb)
        i += 1
    }
    assert(text.textbuf_piece_count(tb) <= 3, "coalesced")
    let actual = materialize(tb)
    assert(actual.len == 10000, "10000 bytes")
    for b in actual {
        assert(b as int == 113, "q")
    }
    text.textbuf_free(mut tb)
}

fn t_piece_repeated_fanout_insert_coalesces() {
    let inserts = 1000
    var tb = text.textbuf_from_str("a\nb\n")
    var i = 0
    while i < inserts {
        let first = text.textbuf_line_span(tb, text.lineno(0))
        text.textbuf_insert_str(mut tb, text.byteoff(first.hi - 1), "q")
        let second = text.textbuf_line_span(tb, text.lineno(1))
        text.textbuf_insert_str(mut tb, text.byteoff(second.hi - 1), "q")
        text.textbuf_check(tb)
        i += 1
    }
    assert(tb.add.bytes.len == inserts, "one payload a fan-out")
    assert(text.textbuf_piece_count(tb) <= 5, "five pieces at most")
    let actual = materialize(tb)
    assert(actual.len == 4 + 2 * inserts, "length")
    assert(actual[0] as int == 97, "a")
    assert(actual[inserts + 1] as int == 10, "LF")
    assert(actual[inserts + 2] as int == 98, "b")
    assert(actual[actual.len - 1] as int == 10, "final LF")
    i = 1
    while i <= inserts {
        assert(actual[i] as int == 113, "q first")
        assert(actual[inserts + 2 + i] as int == 113, "q second")
        i += 1
    }
    text.textbuf_free(mut tb)
}

fn t_piece_interleaved_insert_stays_distinct() {
    var tb = text.textbuf_new()
    var i = 0
    while i < 100 {
        var b = List[byte]()
        (mut b).push((97 + i % 26) as byte)
        text.textbuf_insert(mut tb, text.byteoff(0), b)
        text.textbuf_check(tb)
        i += 1
    }
    assert(text.textbuf_piece_count(tb) > 3, "distinct pieces")
    assert(text.textbuf_len(tb) == 100, "100 bytes")
    text.textbuf_free(mut tb)
}

fn t_piece_snapshot_preserves_content() {
    var tb = text.textbuf_from_str("snapshot\ncontent")
    var snap = text.textbuf_snap(mut tb)
    var i = 0
    while i < 100 {
        var b = List[byte]()
        (mut b).push((65 + i % 26) as byte)
        text.textbuf_insert(mut tb, text.byteoff(text.textbuf_len(tb)), b)
        text.textbuf_check(tb)
        i += 1
    }
    assert_snap_content(tb, snap, bytes_of("snapshot\ncontent"))
    text.textsnap_release(mut tb, mut snap)
    text.textbuf_free(mut tb)
}

// `piece_test_random`, `test_piece.c:492-502`: xorshift64.
fn piece_random(s: wrapping[u64]) -> wrapping[u64] {
    var x = s
    x = x ^ x << 13
    x = x ^ x >> 7
    x = x ^ x << 17
    x
}

fn below(x: wrapping[u64], n: int) -> int {
    (x % n as wrapping[u64]) as int
}

fn t_piece_snapshot_survives_middle_edits() {
    let initial_len = 2048
    let prep_edits = 128
    let post_edits = 500
    var initial = List[byte]()
    var i = 0
    while i < initial_len {
        (mut initial).push((97 + i % 26) as byte)
        i += 1
    }
    var tb = text.textbuf_from_bytes(initial, 0, initial.len)
    var rng: wrapping[u64] = 15485907386658061715
    i = 0
    while i < prep_edits {
        var b = List[byte]()
        (mut b).push((65 + i % 26) as byte)
        rng = piece_random(rng)
        let at = 1 + below(rng, text.textbuf_len(tb) - 1)
        text.textbuf_insert(mut tb, text.byteoff(at), b)
        text.textbuf_check(tb)
        i += 1
    }
    let expected = materialize(tb)
    var snap = text.textbuf_snap(mut tb)
    i = 0
    while i < post_edits {
        let len = text.textbuf_len(tb)
        rng = piece_random(rng)
        let at = 1 + below(rng, len - 1)
        rng = piece_random(rng)
        if (rng & 1) as int == 0 {
            rng = piece_random(rng)
            var b = List[byte]()
            (mut b).push((rng & 255) as int as byte)
            text.textbuf_insert(mut tb, text.byteoff(at), b)
        } else {
            text.textbuf_delete(mut tb, text.span(at, at + 1))
        }
        text.textbuf_check(tb)
        if (i + 1) % 50 == 0 {
            assert_snap_content(tb, snap, expected)
        }
        i += 1
    }
    assert_snap_content(tb, snap, expected)
    text.textsnap_release(mut tb, mut snap)
    text.textbuf_free(mut tb)
}

fn t_piece_snapshot_release_before_buffer() {
    var tb = text.textbuf_from_str("pinned")
    var snap = text.textbuf_snap(mut tb)
    text.textsnap_release(mut tb, mut snap)
    assert(snap.root == -1 && !snap.active, "released")
    text.textbuf_check(tb)
    assert_content(tb, "pinned")
    text.textbuf_free(mut tb)
}

fn t_piece_buffer_release_before_snapshot() {
    // C frees the buffer and reads the snapshot with no buffer at all;
    // the port's snapshot reads through the released buffer value, which
    // still holds the stores and the snapshot's nodes (module doc).
    var tb = text.textbuf_from_str("old root")
    var snap = text.textbuf_snap(mut tb)
    text.textbuf_free(mut tb)
    assert_snap_content(tb, snap, bytes_of("old root"))
    text.textsnap_release(mut tb, mut snap)
    assert(snap.root == -1 && !snap.active, "released")
    assert(tb.orig.bytes.len == 0, "the stores go with the last reference")
}

// The bug scenarios, run in a child (`bug_action_exit`, `test_piece.c:572-593`).
fn bug_scenario(n: int) {
    if n == 0 {
        var tb = text.textbuf_from_str("broken")
        tb.nodes[tb.root].sub_bytes += 1
        text.textbuf_check(tb)
    } else if n == 1 {
        var tb = text.textbuf_from_str("abc")
        var it = text.textiter_new()
        let _ = text.textiter_begin(mut it, tb, text.byteoff(0))
        text.textbuf_insert_str(mut tb, text.byteoff(1), "X")
        text.textbuf_check(tb)
        let _ = text.textiter_chunk(it, tb)
    } else {
        var first = text.textbuf_from_str("a\n")
        var second = text.textbuf_from_str("b\n")
        let (it0, _) = text.lineiter_begin(first, text.lineno(0))
        var it = it0
        let _ = text.lineiter_next(mut it, second)
        text.textbuf_free(mut first)
        text.textbuf_free(mut second)
    }
    os_exit(0)
}

fn bug_child_exit(n: int) -> int {
    let exe = os_exe() else {
        return -1
    }
    var c = process.command(exe)
    process.push_arg(mut c, "--bug")
    process.push_arg(mut c, "{n}")
    let sink = fs.open_append("/dev/null") else |_| {
        return -1
    }
    process.set_stderr(mut c, sink)
    let child = process.start(c) else |_| {
        return -1
    }
    let status = process.wait_status(take child) else -1
    fs.close(take sink) else |_| {}
    status
}

fn bug_case(n: int, what: str) {
    assert(bug_child_exit(n) == 4, "{what} exits 4")
}

fn t_piece_checker_rejects_corruption() {
    var tb = text.textbuf_from_str("broken")
    let valid = tb.nodes[tb.root].sub_bytes
    bug_case(0, "checker_rejects_corruption")
    tb.nodes[tb.root].sub_bytes = valid
    text.textbuf_check(tb)
    text.textbuf_free(mut tb)
}

fn t_piece_live_iterator_rejects_edit() {
    bug_case(1, "live_iterator_rejects_edit")
}

fn t_piece_line_iterator_rejects_other_buffer() {
    var first = text.textbuf_from_str("a\n")
    var second = text.textbuf_from_str("b\n")
    let (_, ok) = text.lineiter_begin(first, text.lineno(0))
    assert(ok, "begin")
    bug_case(2, "line_iterator_rejects_other_buffer")
    text.textbuf_check(first)
    text.textbuf_check(second)
    text.textbuf_free(mut first)
    text.textbuf_free(mut second)
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let args = env_args()
    if args.len == 2 && args[0] == "--bug" {
        bug_scenario(args[1].to_int() else 0)
        return
    }
    t_piece_construct_empty()
    t_piece_construct_bytes()
    t_piece_construct_owned_bytes()
    t_piece_insert_positions()
    t_piece_insert_every_seam()
    t_piece_insert_span_recoalesces_boundaries()
    t_piece_insert_accepts_exposed_chunk_alias()
    t_piece_insert_recoalesces_after_delete()
    t_piece_delete_single_byte()
    t_piece_delete_cross_piece()
    t_piece_delete_whole_buffer()
    t_piece_delete_empty_range()
    t_piece_delete_recoalesces_adjacent_spans()
    t_piece_iterator_chunks_are_maximal_after_delete()
    t_piece_line_mapping_edges()
    t_piece_line_mapping_mixed_fixture()
    t_piece_line_iterator_yields_spans()
    t_piece_line_iterator_rejects_other_buffer()
    t_piece_sequential_insert_coalesces()
    t_piece_repeated_fanout_insert_coalesces()
    t_piece_interleaved_insert_stays_distinct()
    t_piece_snapshot_preserves_content()
    t_piece_snapshot_survives_middle_edits()
    t_piece_snapshot_release_before_buffer()
    t_piece_buffer_release_before_snapshot()
    t_piece_checker_rejects_corruption()
    t_piece_live_iterator_rejects_edit()
    print("piece_test: 27 cases pass")
}
