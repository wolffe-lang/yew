//! member: false
//! The nine tests/unit/test_record.c cases at sagitta 9ace98c2, in registry
//! order (Sprint 35: the recorder's emission). A fixture's recording is
//! built event by event, as C's add_event (test_record.c:43-61) builds it,
//! and emitted with edit.record_emit; every emission must parse whole.

use edit
use fl

struct Fix { ed: edit.Ed, rec: edit.Rec }

fn open(start: int) -> Fix {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    var rec = edit.rec_new()
    rec.reg = 'a' as int
    rec.mode_at_start = start
    Fix { ed: ed, rec: rec }
}

fn cmd(f: Fix, name: str) -> int {
    let id = edit.cmd_lookup(f.ed.reg, name)
    assert(id != 0, "no command {name}")
    id
}

fn add(
    mut f: Fix,
    name: str,
    count: int,
    given: bool,
    iarg: int,
    sarg: List[byte],
    mode: int,
    source: int,
) {
    let id = cmd(f, name)
    let at = f.rec.blob.len
    for b in sarg { (mut f.rec.blob).push(b) }
    (mut f.rec.ev).push(edit.RecEvent {
        cmd: id,
        count: count,
        count_given: given,
        bang: false,
        iarg: iarg,
        range_lo: 0,
        range_hi: 0,
        sarg_at: at,
        sarg_len: sarg.len,
        mode: mode,
        src: source,
        range_kind: edit.REC_RANGE_NONE,
        range_given: false,
    })
}

fn no_bytes() -> List[byte] { List[byte]() }

fn text_of(b: List[byte]) -> str {
    // The emission is ASCII but for an argument's own bytes; a 0x80 byte
    // is checked in the bytes, so the lossy view only serves the finds.
    var out = List[byte]()
    for x in b { (mut out).push(if x as int >= 128 then '?' as int as byte else x) }
    str_from_utf8(out) else ""
}

fn emit(f: Fix) -> str { text_of(edit.record_emit(f.ed.reg, f.rec)) }

fn has(hay: str, needle: str) -> bool { (hay.find(needle) else -1) >= 0 }

fn at(hay: str, needle: str) -> int { hay.find(needle) else -1 }

// assert_parses (test_record.c:70-90): no error, not incomplete.
fn parses(src: List[byte]) {
    var vm = fl.fl_vm_new(take fl.fl_strings())
    let file = fl.fl_diag_add_file(mut vm.dc, "record.fl", src)
    let p = fl.fl_parse(src, file, mut vm.dc, mut vm.strings)
    assert(!p.had_error && !p.incomplete, "the emission does not parse")
}

fn parses_fix(f: Fix) { parses(edit.record_emit(f.ed.reg, f.rec)) }

struct Row { name: str, sarg: str, want: str }

fn record_emit_maps_the_frozen_motion_vocabulary() {
    let rows = [
        Row { name: "ed.mode.enter", sarg: "L", want: " l " },
        Row { name: "ed.mode.enter", sarg: "W", want: " w " },
        Row { name: "ed.mode.enter", sarg: "B", want: " b " },
        Row { name: "ed.mode.enter", sarg: "C", want: " c " },
        Row { name: "ed.move.unit.next", sarg: "", want: " > " },
        Row { name: "ed.move.unit.prev", sarg: "", want: " < " },
        Row { name: "ed.move.unit.up", sarg: "", want: " ^ " },
        Row { name: "ed.move.unit.down", sarg: "", want: " v " },
        Row { name: "ed.move.unit.next_alt", sarg: "", want: " a> " },
        Row { name: "ed.move.unit.prev_alt", sarg: "", want: " a< " },
        Row { name: "ed.move.unit.up_alt", sarg: "", want: " a^ " },
        Row { name: "ed.move.unit.down_alt", sarg: "", want: " av " },
        Row { name: "ed.edit.delete.unit", sarg: "", want: " del " },
        Row { name: "ed.mode.escape", sarg: "", want: " esc " },
    ]
    for r in rows {
        var f = open(edit.MODE_E)
        add(mut f, r.name, 1, false, 0, r.sarg.bytes(), edit.MODE_E, edit.SRC_KEY)
        let got = emit(f)
        assert(has(got, r.want), "{r.name} {r.sarg}: {r.want}")
        assert(at(got, "# yew-macro: 1\n") == 0)
        assert(has(got, "# recorded-with: yew "))
        assert(has(got, "# keymap: default\n"))
        assert(has(got, "rec_a"))
        parses_fix(f)
    }
    var h = open(edit.MODE_L)
    add(mut h, "ed.mode.enter", 1, false, 0, "H".bytes(), edit.MODE_L, edit.SRC_KEY)
    add(mut h, "ed.move.unit.next", 1, false, 0, no_bytes(), edit.MODE_H, edit.SRC_KEY)
    add(mut h, "ed.mode.escape", 1, false, 0, no_bytes(), edit.MODE_H, edit.SRC_KEY)
    assert(has(emit(h), "H( > )"))
    parses_fix(h)
    var e = open(edit.MODE_H)
    add(mut e, "ed.mode.escape", 1, false, 0, no_bytes(), edit.MODE_H, edit.SRC_KEY)
    assert(has(emit(e), " esc "))
    parses_fix(e)
}

fn record_emit_folds_only_uncounted_repeatable_runs() {
    var f = open(edit.MODE_L)
    for _ in 0..4 {
        add(mut f, "ed.move.unit.next", 1, false, 0, no_bytes(), edit.MODE_L, edit.SRC_KEY)
    }
    add(mut f, "ed.edit.delete.unit", 1, false, 0, no_bytes(), edit.MODE_L, edit.SRC_KEY)
    add(mut f, "ed.edit.delete.unit", 1, false, 0, no_bytes(), edit.MODE_L, edit.SRC_KEY)
    add(mut f, "ed.move.buf.end", 1, false, 0, no_bytes(), edit.MODE_L, edit.SRC_KEY)
    add(mut f, "ed.move.buf.end", 1, false, 0, no_bytes(), edit.MODE_L, edit.SRC_KEY)
    let got = emit(f)
    assert(has(got, "4>") && has(got, "2del"))
    assert(!has(got, "2buf_end") && has(got, "buf_end buf_end"))
    parses_fix(f)
}

fn record_emit_preserves_explicit_counts_without_arithmetic() {
    var f = open(edit.MODE_L)
    add(mut f, "ed.move.unit.next", 4, true, 0, no_bytes(), edit.MODE_L, edit.SRC_KEY)
    add(mut f, "ed.move.unit.next", 3, true, 0, no_bytes(), edit.MODE_L, edit.SRC_KEY)
    let got = emit(f)
    assert(has(got, "4> 3>") && !has(got, "7>"))
    parses_fix(f)
}

fn record_emit_concatenates_only_adjacent_insert_events() {
    var f = open(edit.MODE_I)
    add(
        mut f,
        "ed.edit.insert.text",
        1,
        false,
        0,
        ['a' as int as byte, 0 as byte],
        edit.MODE_I,
        edit.SRC_KEY,
    )
    add(mut f, "ed.edit.insert.text", 1, false, 0, "b".bytes(), edit.MODE_I, edit.SRC_KEY)
    add(mut f, "ed.move.unit.next", 1, false, 0, no_bytes(), edit.MODE_I, edit.SRC_KEY)
    add(mut f, "ed.edit.insert.text", 1, false, 0, "c".bytes(), edit.MODE_I, edit.SRC_KEY)
    let got = emit(f)
    assert(has(got, "i\"a\\0b\"") && has(got, "i\"c\"") && !has(got, "a\\0bi"))
    parses_fix(f)
}

fn record_emit_escapes_binary_string_arguments() {
    let payload = [
        '"' as int as byte,
        '\\' as int as byte,
        10 as byte,
        9 as byte,
        13 as byte,
        0 as byte,
        128 as byte,
    ]
    var f = open(edit.MODE_I)
    add(mut f, "ed.edit.insert.text", 1, false, 0, payload, edit.MODE_I, edit.SRC_KEY)
    let out = edit.record_emit(f.ed.reg, f.rec)
    let got = text_of(out)
    assert(has(got, "\\\"") && has(got, "\\\\") && has(got, "\\n"))
    assert(has(got, "\\t") && has(got, "\\r") && has(got, "\\0"))
    var high = false
    for b in out { if b as int == 128 { high = true } }
    assert(high)
    parses(out)
}

fn record_emit_splits_argument_commands_in_event_order() {
    var f = open(edit.MODE_L)
    add(mut f, "ed.move.unit.next", 1, false, 0, no_bytes(), edit.MODE_L, edit.SRC_KEY)
    add(mut f, "ed.file.save", 1, false, 0, "a\"b.fl".bytes(), edit.MODE_L, edit.SRC_KEY)
    add(mut f, "ed.move.unit.prev", 1, false, 0, no_bytes(), edit.MODE_L, edit.SRC_KEY)
    let got = emit(f)
    let before = at(got, " > ")
    let arg = at(got, "ed.run(\"ed.file.save\"")
    assert(before >= 0 && arg >= 0 && before < arg)
    let tail = got[arg..got.len]
    let after = at(tail, " < ")
    assert(after >= 0)
    assert(has(tail, "a\\\"b.fl"))
    parses_fix(f)
}

struct Unit { mode: int, word: str }

fn record_emit_annotates_unit_relative_sessions() {
    for r in [
        Unit { mode: edit.MODE_L, word: " l " },
        Unit { mode: edit.MODE_W, word: " w " },
        Unit { mode: edit.MODE_B, word: " b " },
    ] {
        var f = open(r.mode)
        add(mut f, "ed.move.unit.next", 1, false, 0, no_bytes(), r.mode, edit.SRC_KEY)
        let got = emit(f)
        let annotation = at(got, r.word)
        let motion = at(got, " > ")
        assert(annotation >= 0 && motion >= 0 && annotation < motion)
    }
    var y = open(edit.MODE_W)
    add(mut y, "ed.edit.yank", 1, false, 0, no_bytes(), edit.MODE_W, edit.SRC_KEY)
    assert(!has(emit(y), " w yank"))
}

fn record_emit_is_byte_deterministic() {
    var f = open(edit.MODE_W)
    add(mut f, "ed.move.unit.next", 1, false, 0, no_bytes(), edit.MODE_W, edit.SRC_MOUSE)
    add(mut f, "ed.edit.insert.text", 1, false, 0, "same".bytes(), edit.MODE_I, edit.SRC_FLETCH)
    let one = edit.record_emit(f.ed.reg, f.rec)
    let two = edit.record_emit(f.ed.reg, f.rec)
    assert(one.len == two.len)
    for i in 0..one.len { assert(one[i] == two[i]) }
}

fn record_words_are_a_registry_bijection() {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    var checked = 0
    for i in 0..edit.cmd_count(ed.reg) {
        let e = edit.cmd_entry(ed.reg, i + 1)
        if e.flags & edit.CMD_RECORDABLE == 0 { continue }
        assert(e.has_word && e.word.len != 0, "{e.name} has no word")
        assert(edit.cmd_by_word(ed.reg, e.word) == i + 1, "{e.word} is not {e.name}'s")
        checked += 1
    }
    assert(checked >= 80)
}

// YEW_EDIT_RECORD_CASE: one case alone, in registry order, for the checked machine
// (the whole file is past its step budget; tools/check-test-cases.txt).
fn main() {
    let chosen = (env_get("YEW_EDIT_RECORD_CASE") else "-1").to_int() else -1
    if chosen < 0 || chosen == 0 {
        record_emit_maps_the_frozen_motion_vocabulary()
        print("record_emit_maps_the_frozen_motion_vocabulary: PASS")
    }
    if chosen < 0 || chosen == 1 {
        record_emit_folds_only_uncounted_repeatable_runs()
        print("record_emit_folds_only_uncounted_repeatable_runs: PASS")
    }
    if chosen < 0 || chosen == 2 {
        record_emit_preserves_explicit_counts_without_arithmetic()
        print("record_emit_preserves_explicit_counts_without_arithmetic: PASS")
    }
    if chosen < 0 || chosen == 3 {
        record_emit_concatenates_only_adjacent_insert_events()
        print("record_emit_concatenates_only_adjacent_insert_events: PASS")
    }
    if chosen < 0 || chosen == 4 {
        record_emit_escapes_binary_string_arguments()
        print("record_emit_escapes_binary_string_arguments: PASS")
    }
    if chosen < 0 || chosen == 5 {
        record_emit_splits_argument_commands_in_event_order()
        print("record_emit_splits_argument_commands_in_event_order: PASS")
    }
    if chosen < 0 || chosen == 6 {
        record_emit_annotates_unit_relative_sessions()
        print("record_emit_annotates_unit_relative_sessions: PASS")
    }
    if chosen < 0 || chosen == 7 {
        record_emit_is_byte_deterministic()
        print("record_emit_is_byte_deterministic: PASS")
    }
    if chosen < 0 || chosen == 8 {
        record_words_are_a_registry_bijection()
        print("record_words_are_a_registry_bijection: PASS")
    }
    if chosen < 0 {
        print("record_test: 9 cases pass")
    }
}
