//! member: false
//! Ports all 21 pinned sagitta 9ace98c2 tests/unit/test_fl_parse.c cases.
//! Production coverage follows the C table at :7-48: declaration/assignment,
//! every precedence tier, postfix, literals, functions, control flow, motion,
//! recovery, incomplete input and the structurally separate pure grammar.

use fl

struct Fix { dc: fl.DiagCtx, strings: fl.FlStrings, prog: fl.FlProgram, dump: str }

fn parse_fixture(src: str, pure: bool) -> Fix {
    var dc = fl.fl_diag_init()
    var strings = fl.fl_strings()
    let id = fl.fl_diag_add_file(mut dc, "t.fl", src.bytes())
    let prog = if pure {
        fl.fl_parse_literal(src.bytes(), id, mut dc, mut strings)
    } else {
        fl.fl_parse(src.bytes(), id, mut dc, mut strings)
    }
    var out = List[byte]()
    if pure {
        fl.fl_ast_dump_node(mut out, prog, prog.root, strings)
    } else {
        fl.fl_ast_dump(mut out, prog, strings)
    }
    let text = str_from_utf8(out) else "INVALID UTF8 DUMP"
    Fix { dc: dc, strings: strings, prog: prog, dump: text }
}

fn ok_dump(src: str, want: str) {
    let f = parse_fixture(src, false)
    if f.dump != want { eprint("source: {src}\nwant: {want}got: {f.dump}") }
    assert(f.dump == want)
    assert(f.dc.nerrors == 0 && !f.prog.had_error)
}

fn pl_ok(src: str, want: str) {
    let f = parse_fixture(src, true)
    if f.dump != want { eprint("literal: {src}\nwant: {want}got: {f.dump}") }
    assert(f.prog.root >= 0 && f.prog.stmts.len == 0 && f.dc.nerrors == 0)
    assert(f.dump == want)
}

fn diag_is(src: str, want: str, count: int) {
    let f = parse_fixture(src, false)
    if f.dc.entries.len != count { eprint("source: {src} diagnostics: {f.dc.entries}") }
    assert(f.dc.entries.len == count && f.prog.had_error)
    assert(f.dc.entries[0].msg.contains(want))
}

fn pl_rejects(src: str) {
    let f = parse_fixture(src, true)
    assert(f.prog.root == -1 && f.dc.entries.len > 0)
    assert(f.dc.entries[0].msg.contains("pure-literal mode"))
}

let SPEC_14: str = "# fletch-spec 14 -- one of everything\nimport str\n\nlet greet = \"hi\\tthere\\n\"\nlet nums  = [1, 2.5, 0x10]\nlet cfg   = {{ tabwidth: 4, wrap: false, name: nil }}\n\nfn clamp(x, lo, hi) {{\n    if x < lo {{ return lo }}\n    else if x > hi {{ return hi }}\n    return x\n}}\n\nfn counter(start) {{\n    let n = start\n    return fn() {{ n = n + 1; return n }}\n}}\n\nlet next = counter(clamp(9, 0, 8))\nwhile next() < 10 {{ }}\n\nlet total = 0\nfor x in nums {{\n    if x == 2.5 {{ continue }}\n    total = total + x\n}}\n\nmacro dup = @[ l< H(lv) yank v paste esc ]\n\nfn shout(s) {{\n    try {{ edit {{ @[ 2v i\"!\" del ] }} }}\n    catch e {{ return str.upper(e.kind) or \"?\" }}\n}}\n"

// tests/unit/test_fl_parse.c:141
fn fl_parse_let_and_assign() {
    ok_dump("let total = 0\n", "(let \"total\" (lit int 0))\n")
    ok_dump("let bare\n", "(let \"bare\" nil)\n")
    ok_dump("x = 1\n", "(assign (id \"x\") (lit int 1))\n")
    ok_dump("x[0] = 1\n", "(assign (index (id \"x\") (lit int 0)) (lit int 1))\n")
    ok_dump("x.f = 1\n", "(assign (field (id \"x\") \"f\") (lit int 1))\n")
    ok_dump("f()\n", "(call (id \"f\"))\n")
}

// tests/unit/test_fl_parse.c:153
fn fl_parse_literals_and_primary() {
    ok_dump("nil\n", "(lit nil)\n")
    ok_dump("true\n", "(lit bool true)\n")
    ok_dump("false\n", "(lit bool false)\n")
    ok_dump("42\n", "(lit int 42)\n")
    ok_dump("2.5\n", "(lit float 2.5)\n")
    ok_dump("\"s\"\n", "(lit str \"s\")\n")
    ok_dump("(1)\n", "(lit int 1)\n")
    ok_dump("[1, 2]\n", "(list (lit int 1) (lit int 2))\n")
    ok_dump("[1,]\n", "(list (lit int 1))\n")
    ok_dump("let m = {{a: 1}}\n", "(let \"m\" (map ((lit str \"a\") (lit int 1))))\n")
    ok_dump(
        "let m = {{clipboard.sync: 1, search.smartcase: false}}\n",
        "(let \"m\" (map ((lit str \"clipboard.sync\") (lit int 1)) ((lit str \"search.smartcase\") (lit bool false))))\n",
    )
    ok_dump(
        "let m = {{\"k\": 1, 2: nil,}}\n",
        "(let \"m\" (map ((lit str \"k\") (lit int 1)) ((lit int 2) (lit nil))))\n",
    )
}

// tests/unit/test_fl_parse.c:180
fn fl_parse_precedence_ladder() {
    ok_dump("a or b and c\n", "(or (id \"a\") (and (id \"b\") (id \"c\")))\n")
    ok_dump("a == b < c\n", "(== (id \"a\") (< (id \"b\") (id \"c\")))\n")
    ok_dump("1 + 2 * 3\n", "(+ (lit int 1) (* (lit int 2) (lit int 3)))\n")
    ok_dump("1 - 2 - 3\n", "(- (- (lit int 1) (lit int 2)) (lit int 3))\n")
    ok_dump("1 / 2 % 3\n", "(% (/ (lit int 1) (lit int 2)) (lit int 3))\n")
    ok_dump("a <= b\n", "(<= (id \"a\") (id \"b\"))\n")
    ok_dump("a >= b\n", "(>= (id \"a\") (id \"b\"))\n")
    ok_dump("a != b\n", "(!= (id \"a\") (id \"b\"))\n")
    ok_dump("a > b\n", "(> (id \"a\") (id \"b\"))\n")
    ok_dump("not a\n", "(unot (id \"a\"))\n")
    ok_dump("- a * b\n", "(* (u- (id \"a\")) (id \"b\"))\n")
    ok_dump("not not a\n", "(unot (unot (id \"a\")))\n")
}

// tests/unit/test_fl_parse.c:203
fn fl_parse_postfix_chain() {
    ok_dump("f(1, 2)\n", "(call (id \"f\") (lit int 1) (lit int 2))\n")
    ok_dump("f()\n", "(call (id \"f\"))\n")
    ok_dump("a[0]\n", "(index (id \"a\") (lit int 0))\n")
    ok_dump("a.b\n", "(field (id \"a\") \"b\")\n")
    ok_dump("a.b[0].c()\n", "(call (field (index (field (id \"a\") \"b\") (lit int 0)) \"c\"))\n")
}

// tests/unit/test_fl_parse.c:215
fn fl_parse_functions() {
    ok_dump("fn f() {{ }}\n", "(fn \"f\" (params) (block))\n")
    ok_dump("fn f(a) {{ return a }}\n", "(fn \"f\" (params \"a\") (block (return (id \"a\"))))\n")
    ok_dump(
        "fn f(a, b, c) {{ return }}\n",
        "(fn \"f\" (params \"a\" \"b\" \"c\") (block (return nil)))\n",
    )
    ok_dump("let g = fn() {{ 1 }}\n", "(let \"g\" (fn-expr (params) (block (lit int 1))))\n")
    ok_dump("let g = fn(x) x\n", "(let \"g\" (fn-expr (params \"x\") (id \"x\")))\n")
}

// tests/unit/test_fl_parse.c:229
fn fl_parse_control_flow() {
    ok_dump("if a {{ }}\n", "(if (id \"a\") (block) nil)\n")
    ok_dump("if a {{ }} else {{ }}\n", "(if (id \"a\") (block) (block))\n")
    ok_dump(
        "if a {{ }} else if b {{ }} else {{ }}\n",
        "(if (id \"a\") (block) (if (id \"b\") (block) (block)))\n",
    )
    ok_dump("while a {{ break }}\n", "(while (id \"a\") (block (break)))\n")
    ok_dump("for x in xs {{ continue }}\n", "(for \"x\" (id \"xs\") (block (continue)))\n")
    ok_dump("for k, v in m {{ }}\n", "(for \"k\" \"v\" (id \"m\") (block))\n")
}

// tests/unit/test_fl_parse.c:244
fn fl_parse_imports() {
    ok_dump("import str\n", "(import \"str\")\n")
    ok_dump("import \"a/b.fl\" as b\n", "(import \"a/b.fl\" as \"b\")\n")
}

// tests/unit/test_fl_parse.c:250
fn fl_parse_edit_and_try() {
    ok_dump("edit {{ }}\n", "(edit (block))\n")
    ok_dump("try {{ }} catch e {{ }}\n", "(try (block) catch \"e\" (block))\n")
    ok_dump("try {{ }}\ncatch e {{ }}\n", "(try (block) catch \"e\" (block))\n")
    ok_dump("if a {{ }}\nelse {{ }}\n", "(if (id \"a\") (block) (block))\n")
}

// tests/unit/test_fl_parse.c:262
fn fl_parse_motion_blocks() {
    ok_dump("@[l]\n", "(motion-block (motion 1 unit l))\n")
    ok_dump("@[2v]\n", "(motion-block (motion 2 arrow v))\n")
    ok_dump("@[av]\n", "(motion-block (motion 1 arrow v alt))\n")
    ok_dump("@[H(2>)]\n", "(motion-block (motion 1 highlight (motion 2 arrow >)))\n")
    ok_dump("@[i\"!\"]\n", "(motion-block (motion 1 ins \"!\"))\n")
    ok_dump("@[del esc]\n", "(motion-block (motion 1 del) (motion 1 esc))\n")
    ok_dump("@[yank]\n", "(motion-block (motion 1 word \"yank\"))\n")
    ok_dump("macro m = @[esc]\n", "(macro \"m\" (motion-block (motion 1 esc)))\n")
}

// tests/unit/test_fl_parse.c:277
fn fl_parse_terminators() {
    ok_dump("1\n2\n", "(lit int 1)\n(lit int 2)\n")
    ok_dump("1; 2\n", "(lit int 1)\n(lit int 2)\n")
    ok_dump("1", "(lit int 1)\n")
    ok_dump("let a = 1 +\n2\n", "(let \"a\" (+ (lit int 1) (lit int 2)))\n")
    ok_dump("let a = [1,\n2]\n", "(let \"a\" (list (lit int 1) (lit int 2)))\n")
    ok_dump("let a =\n1\n", "(let \"a\" (lit int 1))\n")
    ok_dump(
        "fn f() {{\nlet a = 1\nreturn a\n}}\n",
        "(fn \"f\" (params) (block (let \"a\" (lit int 1)) (return (id \"a\"))))\n",
    )
    ok_dump("let m = {{\na: 1\n}}\n", "(let \"m\" (map ((lit str \"a\") (lit int 1))))\n")
}

// tests/unit/test_fl_parse.c:326
fn fl_parse_special_cased_messages() {
    diag_is("{{a: 1}}\n", "map literal cannot start a statement", 1)
    diag_is("let x = @y\n", "@[", 1)
    diag_is("if x = 1 {{ }}\n", "did you mean '=='?", 1)
    diag_is("let = @[2>]\n", "expected a name after 'let'", 1)
}

// tests/unit/test_fl_parse.c:342
fn fl_parse_expected_found_wording() {
    let f = parse_fixture("f(1\nlet b = 2\n", false)
    assert(f.dc.entries[0].msg == "expected ')', found 'let'")
    let g = parse_fixture("let 1 = 2\n", false)
    assert(g.dc.entries[0].msg.contains("found 'integer'"))
}

// tests/unit/test_fl_parse.c:363
fn fl_parse_recovery_one_typo_one_error() {
    let inputs = [
        "let a = (1\nlet b = 2\nlet c = 3\n",
        "let a = [1\nlet b = 2\n",
        "f(1, 2\nlet b = 2\n",
        "let = 1\nlet b = 2\n",
        "fn () {{ }}\nlet b = 2\n",
        "if a {{ }}\nelse\nlet b = 2\n",
        "for in xs {{ }}\nlet b = 2\n",
        "import\nlet b = 2\n",
    ]
    var i = 0
    for src in inputs {
        let f = parse_fixture(src, false)
        if f.dc.entries.len != 1 { eprint("recovery {i}: {f.dc.entries}\n{f.dump}") }
        assert(f.dc.entries.len == 1)
        assert(
            f.dump.contains(
                if i == 0 then "(let \"c\" (lit int 3))" else "(let \"b\" (lit int 2))",
            ),
        )
        i += 1
    }
}

// tests/unit/test_fl_parse.c:397
fn fl_parse_error_cap() {
    var src = ""
    for i in 0..60 { src += "let = {i}\n" }
    let f = parse_fixture(src, false)
    assert(f.dc.entries.len <= fl.FL_PARSE_MAX_ERRORS + 1 && f.prog.had_error)
}

// tests/unit/test_fl_parse.c:418
fn fl_parse_incomplete_flag() {
    let cases = ["fn f(", "fn f((", "fn f()}}", "let a = 1 +", "let a = 1 + 1"]
    var i = 0
    for src in cases {
        let f = parse_fixture(src, false)
        assert(f.prog.incomplete == (i == 0 || i == 1 || i == 3))
        assert(f.prog.had_error == (i == 2))
        assert(!(f.prog.had_error && f.prog.incomplete))
        i += 1
    }
}

// tests/unit/test_fl_parse.c:457
fn fl_parse_depth_cap() {
    var src = ""
    for _ in 0..2046 { src += "(" }
    src += "1"
    let f = parse_fixture(src, false)
    assert(f.prog.had_error || f.prog.incomplete)
}

// tests/unit/test_fl_parse.c:514
fn fl_parse_spec_14_example() {
    let f = parse_fixture(SPEC_14, false)
    assert(f.dc.entries.len == 0 && !f.prog.had_error && !f.prog.incomplete)
    assert(f.prog.stmts.len == 12)
    assert(f.dump.contains("(let \"n\" (id \"start\"))"))
    assert(f.dump.contains("catch \"e\""))
    assert(f.dump.contains("(let \"nums\" (list (lit int 1) (lit float 2.5) (lit int 16)))"))
}

// tests/unit/test_fl_parse.c:539
fn fl_parse_dump_is_deterministic() {
    let a = parse_fixture(SPEC_14, false)
    let b = parse_fixture(SPEC_14, false)
    assert(a.dump.len == b.dump.len && a.dump == b.dump)
}

// tests/unit/test_fl_parse.c:605
fn fl_parse_literal_accepts_the_value_grammar() {
    pl_ok("nil", "(lit nil)")
    pl_ok("true", "(lit bool true)")
    pl_ok("42", "(lit int 42)")
    pl_ok("-42", "(lit int -42)")
    pl_ok("-2.5", "(lit float -2.5)")
    pl_ok("\"s\"", "(lit str \"s\")")
    pl_ok("[1, 2,]", "(list (lit int 1) (lit int 2))")
    pl_ok("{{a: 1}}", "(map ((lit str \"a\") (lit int 1)))")
    pl_ok("{{clipboard.sync: 1}}", "(map ((lit str \"clipboard.sync\") (lit int 1)))")
    pl_ok("# a note\n[1]", "(list (lit int 1))")
}

// tests/unit/test_fl_parse.c:624
fn fl_parse_literal_rejects_the_negative_list() {
    for src in [
        "f(1)",
        "name",
        "import x",
        "fn() {{ }}",
        "@[2>]",
        "1 + 1",
        "x = 1",
        "[f(1)]",
        "{{a: name}}",
    ] { pl_rejects(src) }
}

// tests/unit/test_fl_parse.c:640
fn fl_parse_literal_accepts_a_workspace_state_document() {
    let f = parse_fixture(
        "{{\n  version: 1,\n  root: \"/home/u/proj\",\n  tabs: [\n    {{ id: 1, path: \"src/main.c\", line: 42, col: 7 }},\n    {{ id: 2, path: \"src/fl/lex.c\", line: 1, col: 1 }},\n  ],\n  groups: [ {{ name: \"core\", members: [1, 2] }} ],\n  options: {{ tabwidth: 4, wrap: false, theme: nil }},\n  ratio: -0.5,\n}}\n",
        true,
    )
    assert(f.prog.root >= 0 && f.dc.entries.len == 0)
    assert(f.prog.nodes[f.prog.root].kind == fl.FL_A_MAP && f.prog.nodes[f.prog.root].c == 6)
}

fn main() {
    // G29: YEW_FL_PARSE_CASE selects one case alone for the checked machine
    // (tools/check-test-cases.txt); unset, every case runs in registry order.
    let only = (env_get("YEW_FL_PARSE_CASE") else "-1").to_int() else -1
    var ran = 0
    for n in 0..21 {
        if only >= 0 && n != only { continue }
        match n {
            0 => { fl_parse_let_and_assign() },
            1 => { fl_parse_literals_and_primary() },
            2 => { fl_parse_precedence_ladder() },
            3 => { fl_parse_postfix_chain() },
            4 => { fl_parse_functions() },
            5 => { fl_parse_control_flow() },
            6 => { fl_parse_imports() },
            7 => { fl_parse_edit_and_try() },
            8 => { fl_parse_motion_blocks() },
            9 => { fl_parse_terminators() },
            10 => { fl_parse_special_cased_messages() },
            11 => { fl_parse_expected_found_wording() },
            12 => { fl_parse_recovery_one_typo_one_error() },
            13 => { fl_parse_error_cap() },
            14 => { fl_parse_incomplete_flag() },
            15 => { fl_parse_depth_cap() },
            16 => { fl_parse_spec_14_example() },
            17 => { fl_parse_dump_is_deterministic() },
            18 => { fl_parse_literal_accepts_the_value_grammar() },
            19 => { fl_parse_literal_rejects_the_negative_list() },
            20 => { fl_parse_literal_accepts_a_workspace_state_document() },
            _ => { assert(false, "unregistered fl_parse case") },
        }
        print("fl_parse case {n}: PASS")
        ran += 1
    }
    print("fl_parse: {ran} of 21 cases run")
}
