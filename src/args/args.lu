//! args — the command line, parsed as a pure function over the argument
//! vector with its error channel.
//!
//! Ports sagitta `src/args.c` (229 lines) and `args.h` (41) at 9ace98c2
//! (`s00-repo-and-foundations.md` §6, the driver shell; the batch
//! options of Sprint 37 and the grants of Sprint 55 are parsed here and
//! consumed by yw09/yw14). `args_parse` answers `(rc, args, err)`: `rc`
//! is -1 when the driver should proceed, else the exit code, with `err`
//! holding the diagnostic C would have written (`yew: error: …\n`). The
//! argument vector is `env_args()`'s — without `argv[0]`, which C skips.
//!
//! C marks an unset `--workspace` and `--batch` by NULL; the port keeps a
//! `*_set` flag beside the value, and `files`/`batch_args` as lists with
//! `batch_args_seen` for the case C's test distinguishes (an explicit
//! empty tail after `--` against no `--` at all).

use util

/// A `--grant NAME:CAP` (`YewGrantArg`): the text and the name's length.
pub struct Grant {
    text: str,
    name_len: int,
}

/// The parsed command line (`YewArgs`, `args.h:14-35`).
pub struct Args {
    version: bool,
    help: bool,
    help_cmds: bool,
    clean: bool,
    config_path: str,
    theme: str,
    no_workspace_config: bool,
    trust_workspace: bool,
    workspace_dir: str,
    workspace_set: bool,
    batch_script: str,
    batch_set: bool,
    files: List[str],
    batch_args: List[str],
    batch_args_seen: bool,
    replay_reg: int,
    test: bool,
    quiet: bool,
    grants: List[Grant],
    selftest_bug: bool,
}

/// Nothing parsed.
pub fn args_new() -> Args {
    Args {
        version: false,
        help: false,
        help_cmds: false,
        clean: false,
        config_path: "",
        theme: "",
        no_workspace_config: false,
        trust_workspace: false,
        workspace_dir: "",
        workspace_set: false,
        batch_script: "",
        batch_set: false,
        files: List[str](),
        batch_args: List[str](),
        batch_args_seen: false,
        replay_reg: 0,
        test: false,
        quiet: false,
        grants: List[Grant](),
        selftest_bug: false,
    }
}

fn is_name_byte(c: int) -> bool {
    c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 45
}

// `grant_valid` (`args.c:28-52`): `name:cap`, the name 1-32 of
// `[a-z0-9-]`, the cap one of four.
fn grant_name_len(text: str) -> int ! {none} {
    let colon = text.find(":") else {
        return none
    }
    if colon == 0 || colon + 1 >= text.len {
        return none
    }
    let cap = text[colon + 1..text.len]
    if cap.contains(":") {
        return none
    }
    if colon > 32 {
        return none
    }
    var i = 0
    while i < colon {
        if !is_name_byte(text.bytes()[i] as int) {
            return none
        }
        i += 1
    }
    if cap != "fs" && cap != "shell" && cap != "net" && cap != "clipboard" {
        return none
    }
    colon
}

fn replay_reg_valid(value: str) -> bool {
    if value.len != 1 {
        return false
    }
    let c = value.bytes()[0] as int
    c >= 97 && c <= 122 || c >= 65 && c <= 90
}

fn failure(message: str) -> (int, Args, str) {
    (util.EXIT_ERR, args_new(), "yew: error: {message}\n")
}

/// Parse `argv` (`yew_args_parse`, `args.c:88-229`). Answers `(-1, args,
/// "")` to proceed, `(EXIT_OK, args, "")` for `--version`/`--help`/
/// `--help-cmds`, or `(EXIT_ERR, empty, message)`.
pub fn args_parse(argv: List[str]) -> (int, Args, str) {
    var out = args_new()
    var batch_requested = false
    let argc = argv.len
    var i = 0
    while i < argc {
        let arg = argv[i]
        if arg == "--" {
            i += 1
            if batch_requested {
                if !out.batch_set {
                    return failure("option '--batch' requires an argument")
                }
                var tail = List[str]()
                var j = i
                while j < argc {
                    (mut tail).push(argv[j])
                    j += 1
                }
                out.batch_args = tail
                out.batch_args_seen = true
                i = argc
            }
            break
        }
        if !arg.starts_with("-") || arg.len == 1 {
            if batch_requested && !out.batch_set {
                out.batch_script = arg
                out.batch_set = true
                i += 1
                continue
            }
            break
        }
        if arg == "--version" {
            out.version = true
        } else if arg == "--help" {
            out.help = true
        } else if arg == "--help-cmds" {
            out.help_cmds = true
        } else if arg == "--clean" {
            out.clean = true
        } else if arg == "--config" {
            if i + 1 >= argc {
                return failure("option '--config' requires an argument")
            }
            i += 1
            out.config_path = argv[i]
        } else if arg == "--theme" {
            if i + 1 >= argc {
                return failure("option '--theme' requires an argument")
            }
            i += 1
            out.theme = argv[i]
        } else if arg == "--no-workspace-config" {
            out.no_workspace_config = true
        } else if arg == "--trust-workspace" {
            out.trust_workspace = true
        } else if arg == "--workspace" {
            if i + 1 >= argc {
                return failure("option '--workspace' requires an argument")
            }
            i += 1
            if out.workspace_set {
                return failure("option '--workspace' specified twice")
            }
            out.workspace_dir = argv[i]
            out.workspace_set = true
        } else if arg == "--batch" {
            if batch_requested {
                return failure("option '--batch' specified twice")
            }
            batch_requested = true
        } else if arg == "--test" {
            out.test = true
        } else if arg == "--quiet" {
            out.quiet = true
        } else if arg == "--grant" {
            if i + 1 >= argc {
                return failure("option '--grant' requires an argument")
            }
            i += 1
            let text = argv[i]
            let name_len = grant_name_len(text) else {
                return failure("invalid --grant value '{text}' (expected NAME:CAP)")
            }
            (mut out.grants).push(Grant { text: text, name_len: name_len })
        } else if arg == "--selftest-bug" {
            out.selftest_bug = true
        } else if arg == "--replay" {
            if out.replay_reg != 0 {
                return failure("option '--replay' specified twice")
            }
            if i + 1 >= argc {
                return failure("option '--replay' requires an argument")
            }
            i += 1
            let value = argv[i]
            if !replay_reg_valid(value) {
                return failure("invalid --replay register '{value}' (expected one letter a-z/A-Z)")
            }
            out.replay_reg = value.bytes()[0] as int
        } else if arg == "--batch-strict" {
            return failure("option '--batch-strict' is not available in yew 1.0")
        } else {
            return failure("unknown option '{arg}'")
        }
        i += 1
    }
    if i < argc && batch_requested {
        var end = i
        while end < argc && argv[end] != "--" {
            end += 1
        }
        var files = List[str]()
        var j = i
        while j < end {
            (mut files).push(argv[j])
            j += 1
        }
        out.files = files
        if end < argc {
            var tail = List[str]()
            j = end + 1
            while j < argc {
                (mut tail).push(argv[j])
                j += 1
            }
            out.batch_args = tail
            out.batch_args_seen = true
        }
    } else if i < argc {
        var files = List[str]()
        var j = i
        while j < argc {
            (mut files).push(argv[j])
            j += 1
        }
        out.files = files
    }
    if out.version || out.help || out.help_cmds {
        return (util.EXIT_OK, out, "")
    }
    if batch_requested && !out.batch_set {
        return failure("option '--batch' requires an argument")
    }
    if out.test && !batch_requested {
        return failure("option '--test' requires --batch")
    }
    if out.quiet && !batch_requested {
        return failure("option '--quiet' requires --batch")
    }
    if out.grants.len != 0 && !batch_requested {
        return failure("option '--grant' requires --batch")
    }
    if out.replay_reg != 0 && !batch_requested {
        return failure("option '--replay' requires --batch")
    }
    if out.workspace_set && batch_requested {
        return failure("option '--workspace' cannot be used with --batch")
    }
    (-1, out, "")
}
