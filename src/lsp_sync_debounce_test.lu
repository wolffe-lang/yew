//! member: false
//!
//! yw25's own cases: a document of a server that takes only the whole
//! text is sent it when the typing pauses or has run a second, not on
//! every key (`lsp.lsp_doc_change_due`, driven here with a simulated
//! clock, one call a turn as the client's pump makes it).
//!
//! The rows: the first edit after a pause goes at once; a run of keys 200
//! ms apart goes out once a second (the cap) and once more when it stops;
//! a pause of 250 ms after the last key sends what waits; nothing waiting
//! is never due; the deadline the loop sleeps to is the earlier of the
//! quiet and the cap.

use lsp
use text

fn open_doc() -> lsp.LspDoc {
    var doc = lsp.lsp_doc_new(7, "file:///tmp/a.lu")
    lsp.lsp_doc_opened(mut doc, 1)
    doc
}

// An edit seen by the pump: a whole-text server queues nothing but the
// full flag.
fn edit(mut doc: lsp.LspDoc) {
    let s = "abc".bytes()
    let tb = text.textbuf_from_bytes(s, 0, s.len)
    lsp.lsp_doc_note_edit(mut doc, lsp.POSENC_UTF16, 1, tb, text.JOURNAL_INS, 0, 1)
}

fn sent(mut doc: lsp.LspDoc) {
    // What `lsp_doc_flush` leaves of the clocks.
    var rpc = lsp.rpc_conn_new()
    let s = "abc".bytes()
    let tb = text.textbuf_from_bytes(s, 0, s.len)
    assert(lsp.lsp_doc_flush(mut rpc, mut doc, 1, tb), "flushed")
}

fn a_first_edit_after_a_pause_goes_at_once() {
    var doc = open_doc()
    edit(mut doc)
    assert(lsp.lsp_doc_change_due(mut doc, 2, 10000), "the first edit is due at once")
    sent(mut doc)
    assert(!lsp.lsp_doc_change_due(mut doc, 2, 10001), "nothing waits, nothing is due")
    assert(lsp.lsp_doc_change_deadline(doc) < 0, "no deadline when nothing waits")
}

fn keys_run_once_a_second_and_once_more_at_the_stop() {
    var doc = open_doc()
    var gen = 1
    var now = 10000
    var flushes = 0
    var k = 0
    // 20 keys, 200 ms apart: 4 s of typing.
    while k < 20 {
        gen += 1
        edit(mut doc)
        if lsp.lsp_doc_change_due(mut doc, gen, now) {
            sent(mut doc)
            flushes += 1
        }
        now += 200
        k += 1
    }
    // The pause: the pump runs at the loop's deadline, the quiet after the
    // last key.
    let due_at = lsp.lsp_doc_change_deadline(doc)
    assert(due_at >= 0, "edits wait")
    var held = true
    while held && now < 10000 + 4000 + 2000 {
        if lsp.lsp_doc_change_due(mut doc, gen, now) {
            sent(mut doc)
            flushes += 1
            held = false
        }
        now += 50
    }
    assert(!held, "the stop sent what waited")
    assert(flushes >= 4 && flushes <= 6, "20 keys over 4 s went out in {flushes} didChanges")
}

fn the_deadline_is_the_earlier_of_the_quiet_and_the_cap() {
    var doc = open_doc()
    edit(mut doc)
    assert(lsp.lsp_doc_change_due(mut doc, 2, 50000), "the first goes")
    sent(mut doc)
    // A second edit 100 ms later waits: quiet 250 ms after it, cap 1000 ms.
    edit(mut doc)
    assert(!lsp.lsp_doc_change_due(mut doc, 3, 50100), "a quick second edit waits")
    assert(
        lsp.lsp_doc_change_deadline(doc) == 50100 + lsp.LSP_CHANGE_QUIET_MS,
        "the quiet is first",
    )
    // Keys keep coming: the cap is counted from the first held edit.
    var now = 50100
    var gen = 3
    while now < 50100 + 800 {
        now += 100
        gen += 1
        assert(!lsp.lsp_doc_change_due(mut doc, gen, now), "held while typing at {now}")
    }
    assert(
        lsp.lsp_doc_change_deadline(doc) == 50100 + lsp.LSP_CHANGE_MAX_WAIT_MS,
        "the cap is first",
    )
    now = 50100 + lsp.LSP_CHANGE_MAX_WAIT_MS
    assert(lsp.lsp_doc_change_due(mut doc, gen + 1, now), "the cap sends it")
}

// yw25 (R-yw25-2): at the owner's typing rate, 2.5 keys a second (400 ms
// apart), every key used to follow a pause of more than the 250 ms quiet,
// so each was sent at once. Ten edits over 4 s must now go out as the cap
// allows: the first at once (a pause before it), then at most one a second
// (1000 ms), then the stop. N = 1 + ceil(4000 / 1000) = 5.
fn slow_typing_is_held_to_the_cap() {
    var doc = open_doc()
    var gen = 1
    var now = 10000
    var flushes = 0
    var k = 0
    while k < 10 {
        gen += 1
        edit(mut doc)
        var step = 0
        // The pump runs at each edit and at the loop's deadline: 50 ms steps
        // stand for the wait that ends by `lsp_doc_change_deadline`.
        while step < 8 {
            if lsp.lsp_doc_change_due(mut doc, gen, now) {
                sent(mut doc)
                flushes += 1
                // an edit that was sent ends the held run; the next edit is new
            }
            now += 50
            step += 1
        }
        k += 1
    }
    // the stop: the quiet after the last key
    var held = 0
    while held < 30 {
        if lsp.lsp_doc_change_due(mut doc, gen, now) {
            sent(mut doc)
            flushes += 1
        }
        now += 50
        held += 1
    }
    assert(flushes <= 5, "10 edits 400 ms apart went out in {flushes} didChanges (at most 5)")
    assert(flushes >= 3, "the cap still sends: {flushes}")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    a_first_edit_after_a_pause_goes_at_once()
    keys_run_once_a_second_and_once_more_at_the_stop()
    the_deadline_is_the_earlier_of_the_quiet_and_the_cap()
    slow_typing_is_held_to_the_cap()
    print("lsp_sync_debounce_test: 4 cases pass")
}
