        argv_has_sequence(
            c,
            words(
                ["log", "HEAD~1..HEAD", "--date-order", "--pretty=format:%h%x1f%at%x1f%an%x1f%s"],
            ),
        ),
        "the log argv",
    )
}

// `test_local_remote_network_verbs_use_plain_argv` (`:1133-1171`).
fn local_remote_network_verbs_use_plain_argv(parent: str) {
    let repo = child_repo(parent, "network-verbs")
    let remote = "{parent}/network-remote.git"
    fs.create_dir(remote) else |_| { want(false, "mkdir remote") }
    want(git_ok(remote, words(["init", "-q", "--bare"])), "bare")
    want(git_ok(repo, words(["remote", "add", "origin", remote])), "origin")
    want(git_ok(repo, words(["push", "-q", "-u", "origin", "trunk"])), "first push")
    let commands = ["ed.git.fetch", "ed.git.pull", "ed.git.push"]
    let verbs = ["fetch", "pull", "push"]
    var i = 0
    while i < commands.len {
        let (s, c) = invoke_active_real(repo, commands[i], "", false)
        want(s == edit.CMD_OK && c.calls == 1 && c.exit_code == 0, "{commands[i]}")
        want(argv_has_sequence(c, words([verbs[i]])), "{verbs[i]}")
        i += 1
    }
}

// `test_file_verbs_reject_directories_and_unsafe_paths` (`:1173-1220`).
fn file_verbs_reject_directories_and_unsafe_paths(parent: str) {
    let repo = child_repo(parent, "verb-guards")
    fs.create_dir("{repo}/dir") else |_| { want(false, "mkdir dir") }
    var ed = fuss_editor(repo)
    edit.git_test_spawn_set(mut ed, true)
    let commands = [
        "ed.git.diff",
        "ed.git.blame",
        "ed.git.view",
        "ed.git.open",
        "ed.git.file.delete",
        "ed.git.discard",
    ]
    let messages = [
        "select a file to diff",
        "select a file to blame",
        "select a file to view",
        "select a file to open",
        "select a file to delete",
        "select a file to discard",
    ]
    var i = 0
    while i < commands.len {
        want(invoke(mut ed, commands[i], "dir", true) == edit.CMD_ERR_STATE, "{commands[i]} dir")
        want(ed.msg.text == messages[i], "{commands[i]}: `{ed.msg.text}`")
        i += 1
    }
    want(invoke(mut ed, "ed.git.diff", "../base.txt", true) == edit.CMD_ERR_ARG, "../")
    want(ed.msg.text == "select a valid workspace path", "`{ed.msg.text}`")
    let cx = cx_for(ed, "--exec", true)
    want(edit.fuss_cmd_rebase_interactive(mut ed, cx) == edit.CMD_ERR_ARG, "--exec")
    want(ed.msg.text == "invalid rebase base", "`{ed.msg.text}`")
    want(ed.git.tlog.calls == 0, "no git")
    ed_free(mut ed)
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    // `make test-fuss-commands` runs the binary under `LC_ALL=C`.
    env_set("LC_ALL", "C") else |_| {}
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    let names = [
        "fuss_commands_stage_preserves_hostile_paths",
        "fuss_commands_unstage_preserves_hostile_paths",
        "fuss_commands_f13_filename_matrix_roundtrips_every_git_surface",
        "fuss_commands_stage_all_stages_every_change",
        "fuss_commands_unstage_all_clears_the_index",
        "fuss_commands_branch_create_uses_the_exact_argument",
        "fuss_commands_tag_uses_the_exact_argument",
        "fuss_commands_stash_push_preserves_message_argv",
        "fuss_commands_empty_commit_message_does_not_spawn_git",
        "fuss_commands_commit_template_uses_auto_comment_char",
        "fuss_commands_commit_template_uses_custom_comment_char",
        "fuss_commands_commit_refuses_conflicted_snapshot",
        "fuss_commands_amend_prefills_previous_message",
        "fuss_commands_cleared_amend_message_does_not_spawn_git",
        "fuss_commands_commit_and_amend_save_change_head",
        "fuss_commands_stash_pop_restores_worktree",
        "fuss_commands_confirmed_discard_delete_and_rename",
        "fuss_commands_view_then_open_leaves_f_mode",
        "fuss_commands_read_views_use_expected_git_argv",
        "fuss_commands_branch_switch_delete_and_merge_change_repo",
        "fuss_commands_reset_cherry_pick_and_revert_use_exact_refs",
        "fuss_commands_rebase_prepare_only_loads_exact_log_range",
        "fuss_commands_local_remote_network_verbs_use_plain_argv",
        "fuss_commands_file_verbs_reject_directories_and_unsafe_paths",
    ]
    let probe = run_process(".", words(["git", "--version"]), List[byte](), false)
    if !probe.ok || probe.code != 0 {
        var s = 0
        while s < names.len {
            if chosen < 0 || chosen == s {
                say("SKIP {names[s]}: git not found (C's HARNESS_SKIP fuss_commands)")
            }
            s += 1
        }
        return
    }
    if chosen >= names.len {
        print("fusscommands_test: 0 cases run")
        return
    }
    isolate_git_environment()
    let tmp = env_get("TMPDIR") else "target/tests"
    let base = if tmp.len == 0 then "target/tests" else tmp
    let made = "{base}/yew-fusscmds-{os_pid()}"
    let _ = run_process(".", words(["rm", "-rf", made]), List[byte](), false)
    fs.create_dir_all(made) else |_| { want(false, "mkdir {made}") }
    let parent = fs.realpath(made) else made
    want(setup_repo(parent), "the parent repository")
    let alone = chosen >= 0
    var ran = 0
    var n = 0
    while n < names.len {
        if chosen >= 0 && chosen != n {
            n += 1
            continue
        }
        match n {
            0 => stage_preserves_hostile_paths(parent),
            1 => unstage_preserves_hostile_paths(parent, alone),
            2 => f13_filename_matrix(parent),
            3 => stage_all_stages_every_change(parent),
            4 => unstage_all_clears_the_index(parent, alone),
            5 => branch_create_uses_the_exact_argument(parent),
            6 => tag_uses_the_exact_argument(parent),
            7 => stash_push_preserves_message_argv(parent),
            8 => empty_commit_message_does_not_spawn_git(parent),
            9 => commit_template_uses_auto_comment_char(parent),
            10 => commit_template_uses_custom_comment_char(parent),
            11 => commit_refuses_conflicted_snapshot(parent),
            12 => amend_prefills_previous_message(parent),
            13 => cleared_amend_message_does_not_spawn_git(parent),
            14 => commit_and_amend_save_change_head(parent),
            15 => stash_pop_restores_worktree(parent),
            16 => confirmed_discard_delete_and_rename(parent),
            17 => view_then_open_leaves_f_mode(parent),
            18 => read_views_use_expected_git_argv(parent),
            19 => branch_switch_delete_and_merge_change_repo(parent),
            20 => reset_cherry_pick_and_revert_use_exact_refs(parent),
            21 => rebase_prepare_only_loads_exact_log_range(parent),
            22 => local_remote_network_verbs_use_plain_argv(parent),
            _ => file_verbs_reject_directories_and_unsafe_paths(parent),
        }
        print("{names[n]}: PASS")
        ran += 1
        n += 1
    }
    let gone = run_process(".", words(["rm", "-rf", parent]), List[byte](), false)
    want(gone.ok && gone.code == 0, "the fixtures are removed")
    print("fusscommands_test: {ran} cases run")
}
