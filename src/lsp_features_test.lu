//! member: false
//!
//! The port of sagitta's pure feature parsers' tests at 9ace98c2:
//! `tests/unit/test_lsp_nav.c:29-147` (the five location cases),
//! `test_lsp_symbols.c:72-320` (the seven parser cases),
//! `test_lsp_highlight.c` (six) and `test_lsp_completion.c:218-342` (the
//! four hover and signature cases), each file's cases in its registry
//! order (`tests/unit/registry.c`). C's JSON values live in an arena;
//! the port's are a `lsp.Json` document and a node. C reads a buffer's
//! `TextBuf` through `yew_ed_open_memory`; the parsers take a
//! `text.TextBuf`, so the port builds one from the same bytes. C's
//! pointer-identity assertions (`symbols.data[0].path != doc_path`, a
//! freed vector's NULL data) have no twin: a wolf string is a value and a
//! list is dropped whole, so those cases hold the values only.
//!
//! The per-case selector `YEW_LSP_FEATURES_CASE=N` (0-based, 22 cases)
//! runs one case, for the checked machine's step budget (G29).

use lsp
use text

struct Tally {
    n: int,
}

// A failed check says what it was before the trap (a native trap prints
// only its site).
fn ok(mut t: Tally, cond: bool, what: str) {
    t.n += 1
    if !cond {
        eprint("assertion failed: {what}")
    }
    assert(cond, what)
}

fn pb(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn parse(text: str) -> lsp.Json {
    var err = lsp.json_err_new()
    let j = lsp.json_parse(text.bytes(), 0, text.len, mut err) else {
        assert(false, "parse {text}: {err.msg}")
        return lsp.json_new()
    }
    j
}

fn parse_bytes(b: List[byte]) -> lsp.Json {
    var err = lsp.json_err_new()
    let j = lsp.json_parse(b, 0, b.len, mut err) else {
        assert(false, "parse: {err.msg}")
        return lsp.json_new()
    }
    j
}

fn tb_of(s: str) -> text.TextBuf {
    let b = pb(s)
    text.textbuf_from_bytes(b, 0, b.len)
}

fn same_bytes(a: List[byte], s: str) -> bool {
    let b = s.bytes()
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

// `nav_parse` (`test_lsp_nav.c:29-37`).
fn nav(text: str) -> List[lsp.LspLoc] {
    let j = parse(text)
    lsp.lsp_locations_parse(j, j.root)
}

// test_lsp_nav.c:39-48
fn lsp_locations_null_and_empty_array_return_no_rows(mut t: Tally) {
    let none = lsp.lsp_locations_parse(lsp.json_new(), -1)
    ok(mut t, none.len == 0, "no result, no rows")
    ok(mut t, nav("null").len == 0, "null, no rows")
    ok(mut t, nav("[]").len == 0, "[], no rows")
}

// test_lsp_nav.c:50-68
fn lsp_locations_single_location_is_owned(mut t: Tally) {
    let locs = nav(
        "{{\"uri\":\"file:///tmp/owned%20location.c\",\"range\":{{\"start\":{{\"line\":4,\"character\":7}},\"end\":{{\"line\":4,\"character\":11}}}}}}",
    )
    ok(mut t, locs.len == 1, "one location")
    ok(mut t, locs[0].path == "/tmp/owned location.c", "the decoded path: {locs[0].path}")
    ok(mut t, locs[0].line == 4, "line")
    ok(mut t, locs[0].chr == 7, "character")
    ok(mut t, locs[0].end_line == 4, "end line")
    ok(mut t, locs[0].end_chr == 11, "end character")
}

// test_lsp_nav.c:70-108
fn lsp_locations_many_sort_stably_by_path_line_and_column(mut t: Tally) {
    let locs = nav(
        "[{{\"uri\":\"file:///z.c\",\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":1}}}}}},{{\"uri\":\"file:///a.c\",\"range\":{{\"start\":{{\"line\":3,\"character\":8}},\"end\":{{\"line\":3,\"character\":12}}}}}},{{\"uri\":\"file:///a.c\",\"range\":{{\"start\":{{\"line\":1,\"character\":9}},\"end\":{{\"line\":1,\"character\":10}}}}}},{{\"uri\":\"file:///a.c\",\"range\":{{\"start\":{{\"line\":3,\"character\":2}},\"end\":{{\"line\":3,\"character\":9}}}}}},{{\"uri\":\"file:///a.c\",\"range\":{{\"start\":{{\"line\":3,\"character\":2}},\"end\":{{\"line\":3,\"character\":5}}}}}}]",
    )
    ok(mut t, locs.len == 5, "five locations")
    ok(mut t, locs[0].path == "/a.c", "a.c first")
    ok(mut t, locs[0].line == 1 && locs[0].chr == 9, "line 1 first")
    ok(
        mut t,
        locs[1].line == 3 && locs[1].chr == 2 && locs[1].end_chr == 9,
        "the first 3:2 kept first",
    )
    ok(
        mut t,
        locs[2].line == 3 && locs[2].chr == 2 && locs[2].end_chr == 5,
        "the second 3:2 after it",
    )
    ok(mut t, locs[3].chr == 8, "3:8 next")
    ok(mut t, locs[4].path == "/z.c", "z.c last")
}

// test_lsp_nav.c:110-127
fn lsp_locations_location_link_prefers_target_selection_range(mut t: Tally) {
    let locs = nav(
        "[{{\"targetUri\":\"file:///link.c\",\"targetRange\":{{\"start\":{{\"line\":1,\"character\":2}},\"end\":{{\"line\":8,\"character\":9}}}},\"targetSelectionRange\":{{\"start\":{{\"line\":5,\"character\":6}},\"end\":{{\"line\":5,\"character\":10}}}}}}]",
    )
    ok(mut t, locs.len == 1, "one link")
    ok(mut t, locs[0].path == "/link.c", "its path")
    ok(mut t, locs[0].line == 5 && locs[0].chr == 6, "the selection's start")
    ok(mut t, locs[0].end_line == 5 && locs[0].end_chr == 10, "the selection's end")
}

// test_lsp_nav.c:129-155
fn lsp_locations_ignore_malformed_and_non_file_rows(mut t: Tally) {
    let locs = nav(
        "[null,{{\"uri\":\"https://example.test/x.c\",\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":1}}}}}},{{\"uri\":\"file:///missing-range.c\"}},{{\"uri\":\"file:///negative.c\",\"range\":{{\"start\":{{\"line\":-1,\"character\":0}},\"end\":{{\"line\":0,\"character\":1}}}}}},{{\"uri\":\"file:///backwards.c\",\"range\":{{\"start\":{{\"line\":2,\"character\":4}},\"end\":{{\"line\":2,\"character\":3}}}}}},{{\"uri\":\"file:///valid.c\",\"range\":{{\"start\":{{\"line\":7,\"character\":1}},\"end\":{{\"line\":7,\"character\":2}}}}}}]",
    )
    ok(mut t, locs.len == 1, "only the valid row: {locs.len}")
    ok(mut t, locs[0].path == "/valid.c", "valid.c")
}

// `symbols_parse` (`test_lsp_symbols.c:28-37`).
fn syms(text: str, doc_path: str) -> List[lsp.LspSymbol] {
    let j = parse(text)
    lsp.lsp_symbols_parse(j, j.root, doc_path)
}

// test_lsp_symbols.c:72-109
fn lsp_symbols_nested_tree_preserves_preorder_breadcrumbs_and_selection(mut t: Tally) {
    let s = syms(
        "[{{\"name\":\"Grid\",\"kind\":5,\"range\":{{\"start\":{{\"line\":1,\"character\":2}},\"end\":{{\"line\":20,\"character\":0}}}},\"selectionRange\":{{\"start\":{{\"line\":3,\"character\":4}},\"end\":{{\"line\":3,\"character\":8}}}},\"children\":[{{\"name\":\"rows\",\"kind\":8,\"range\":{{\"start\":{{\"line\":5,\"character\":1}},\"end\":{{\"line\":8,\"character\":0}}}},\"selectionRange\":{{\"start\":{{\"line\":6,\"character\":7}},\"end\":{{\"line\":6,\"character\":11}}}},\"children\":[{{\"name\":\"cells\",\"kind\":7,\"range\":{{\"start\":{{\"line\":7,\"character\":2}},\"end\":{{\"line\":7,\"character\":9}}}},\"selectionRange\":{{\"start\":{{\"line\":7,\"character\":3}},\"end\":{{\"line\":7,\"character\":8}}}}}}]}}]}}]",
        "/work/src/term/grid.h",
    )
    ok(mut t, s.len == 3, "three symbols")
    ok(mut t, s[0].name == "Grid" && s[0].breadcrumb == "Grid", "Grid")
    ok(mut t, s[0].line == 3 && s[0].chr == 4, "Grid's selection")
    ok(
        mut t,
        s[1].name == "rows" && s[1].breadcrumb == "Grid \u{203A} rows",
        "rows: {s[1].breadcrumb}",
    )
    ok(mut t, s[1].line == 6 && s[1].chr == 7, "rows' selection")
    ok(
        mut t,
        s[2].name == "cells" && s[2].breadcrumb == "Grid \u{203A} rows \u{203A} cells",
        "cells",
    )
    ok(mut t, s[2].line == 7 && s[2].chr == 3, "cells' selection")
    ok(mut t, s[2].path == "/work/src/term/grid.h", "the document's path")
}

// test_lsp_symbols.c:111-129
fn lsp_symbols_flat_rows_use_container_and_file_uri(mut t: Tally) {
    let s = syms(
        "[{{\"name\":\"put\",\"kind\":12,\"containerName\":\"Grid\",\"location\":{{\"uri\":\"file:///work/src/grid%20draw.c\",\"range\":{{\"start\":{{\"line\":9,\"character\":5}},\"end\":{{\"line\":9,\"character\":8}}}}}}}}]",
        "/ignored/current.c",
    )
    ok(mut t, s.len == 1, "one symbol")
    ok(mut t, s[0].name == "put" && s[0].breadcrumb == "Grid \u{203A} put", "put under Grid")
    ok(mut t, s[0].path == "/work/src/grid draw.c", "the location's path")
    ok(mut t, s[0].line == 9 && s[0].chr == 5, "its position")
    ok(mut t, s[0].kind == lsp.COMPLK_FUNC, "a function")
}

// test_lsp_symbols.c:131-161
fn lsp_symbols_ignore_mixed_malformed_and_non_file_rows(mut t: Tally) {
    let s = syms(
        "[null,{{\"name\":\"valid\",\"kind\":13,\"location\":{{\"uri\":\"file:///valid.c\",\"range\":{{\"start\":{{\"line\":4,\"character\":2}},\"end\":{{\"line\":4,\"character\":7}}}}}}}},{{\"name\":\"tree-shape\",\"kind\":12,\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":1}}}},\"selectionRange\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":1}}}}}},{{\"name\":\"remote\",\"kind\":12,\"location\":{{\"uri\":\"https://example.test/x.c\",\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":1}}}}}}}},{{\"name\":\"no-range\",\"kind\":12,\"location\":{{\"uri\":\"file:///missing.c\"}}}},{{\"name\":\"backwards\",\"kind\":12,\"location\":{{\"uri\":\"file:///bad.c\",\"range\":{{\"start\":{{\"line\":2,\"character\":4}},\"end\":{{\"line\":2,\"character\":3}}}}}}}}]",
        "/current.c",
    )
    ok(mut t, s.len == 1, "only the valid row: {s.len}")
    ok(mut t, s[0].name == "valid" && s[0].path == "/valid.c", "valid.c's")
}

// test_lsp_symbols.c:163-204
fn lsp_symbols_map_all_symbol_kinds_to_completion_vocabulary(mut t: Tally) {
    let want = [
        lsp.COMPLK_MODULE,
        lsp.COMPLK_MODULE,
        lsp.COMPLK_MODULE,
        lsp.COMPLK_MODULE,
        lsp.COMPLK_TYPE,
        lsp.COMPLK_FUNC,
        lsp.COMPLK_FIELD,
        lsp.COMPLK_FIELD,
        lsp.COMPLK_FUNC,
        lsp.COMPLK_ENUM,
        lsp.COMPLK_TYPE,
        lsp.COMPLK_FUNC,
        lsp.COMPLK_VARIABLE,
        lsp.COMPLK_CONSTANT,
        lsp.COMPLK_WORD,
        lsp.COMPLK_WORD,
        lsp.COMPLK_WORD,
        lsp.COMPLK_WORD,
        lsp.COMPLK_WORD,
        lsp.COMPLK_FIELD,
        lsp.COMPLK_WORD,
        lsp.COMPLK_CONSTANT,
        lsp.COMPLK_TYPE,
        lsp.COMPLK_FUNC,
        lsp.COMPLK_FUNC,
        lsp.COMPLK_TYPE,
    ]
    var json = "["
    var i = 1
    while i <= 26 {
        let sep = if i == 1 then "" else ","
        json = json +
            "{sep}{{\"name\":\"k{i}\",\"kind\":{i},\"range\":{{\"start\":{{\"line\":{i},\"character\":0}},\"end\":{{\"line\":{i},\"character\":1}}}},\"selectionRange\":{{\"start\":{{\"line\":{i},\"character\":0}},\"end\":{{\"line\":{i},\"character\":1}}}}}}"
        i += 1
    }
    json = json + "]"
    let s = syms(json, "/kinds.c")
    ok(mut t, s.len == 26, "26 kinds")
    var k = 0
    while k < 26 {
        ok(mut t, s[k].kind == want[k], "kind {k + 1}: {s[k].kind} for {want[k]}")
        k += 1
    }
}

// test_lsp_symbols.c:206-227
fn lsp_symbols_own_strings_and_free_resets_vector(mut t: Tally) {
    var s = syms(
        "[{{\"name\":\"owned\",\"kind\":12,\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":5}}}},\"selectionRange\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":5}}}}}}]",
        "/owned.c",
    )
    ok(mut t, s.len == 1, "one symbol")
    ok(mut t, s[0].name == "owned" && s[0].breadcrumb == "owned", "its name and breadcrumb")
    ok(mut t, s[0].path == "/owned.c", "its own path")
    s = List[lsp.LspSymbol]()
    ok(mut t, s.len == 0, "dropped")
}

// test_lsp_symbols.c:229-255
fn lsp_symbols_cap_response_count(mut t: Tally) {
    let row = "{{\"name\":\"bounded\",\"kind\":12,\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":1}}}},\"selectionRange\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":1}}}}}}"
    var json = List[byte]()
    (mut json).push(91 as byte)
    var i = 0
    while i < 20001 {
        if i != 0 {
            (mut json).push(44 as byte)
        }
        for b in row.bytes() {
            (mut json).push(b)
        }
        i += 1
    }
    (mut json).push(93 as byte)
    let j = parse_bytes(json)
    let s = lsp.lsp_symbols_parse(j, j.root, "/bounded.c")
    ok(mut t, s.len == 20000, "capped at 20000: {s.len}")
}

// test_lsp_symbols.c:257-319
fn lsp_symbols_sort_identically_across_server_permutations(mut t: Tally) {
    let first = "[{{\"name\":\"zeta\",\"kind\":12,\"location\":{{\"uri\":\"file:///z.c\",\"range\":{{\"start\":{{\"line\":8,\"character\":1}},\"end\":{{\"line\":8,\"character\":2}}}}}}}},{{\"name\":\"beta\",\"kind\":13,\"containerName\":\"A\",\"location\":{{\"uri\":\"file:///a.c\",\"range\":{{\"start\":{{\"line\":4,\"character\":2}},\"end\":{{\"line\":4,\"character\":3}}}}}}}},{{\"name\":\"alpha\",\"kind\":12,\"location\":{{\"uri\":\"file:///a.c\",\"range\":{{\"start\":{{\"line\":1,\"character\":7}},\"end\":{{\"line\":1,\"character\":8}}}}}}}},{{\"name\":\"same\",\"kind\":12,\"location\":{{\"uri\":\"file:///same.c\",\"range\":{{\"start\":{{\"line\":2,\"character\":3}},\"end\":{{\"line\":2,\"character\":4}}}}}}}},{{\"name\":\"same\",\"kind\":13,\"location\":{{\"uri\":\"file:///same.c\",\"range\":{{\"start\":{{\"line\":2,\"character\":3}},\"end\":{{\"line\":2,\"character\":4}}}}}}}}]"
    let second = "[{{\"name\":\"alpha\",\"kind\":12,\"location\":{{\"uri\":\"file:///a.c\",\"range\":{{\"start\":{{\"line\":1,\"character\":7}},\"end\":{{\"line\":1,\"character\":8}}}}}}}},{{\"name\":\"zeta\",\"kind\":12,\"location\":{{\"uri\":\"file:///z.c\",\"range\":{{\"start\":{{\"line\":8,\"character\":1}},\"end\":{{\"line\":8,\"character\":2}}}}}}}},{{\"name\":\"beta\",\"kind\":13,\"containerName\":\"A\",\"location\":{{\"uri\":\"file:///a.c\",\"range\":{{\"start\":{{\"line\":4,\"character\":2}},\"end\":{{\"line\":4,\"character\":3}}}}}}}},{{\"name\":\"same\",\"kind\":13,\"location\":{{\"uri\":\"file:///same.c\",\"range\":{{\"start\":{{\"line\":2,\"character\":3}},\"end\":{{\"line\":2,\"character\":4}}}}}}}},{{\"name\":\"same\",\"kind\":12,\"location\":{{\"uri\":\"file:///same.c\",\"range\":{{\"start\":{{\"line\":2,\"character\":3}},\"end\":{{\"line\":2,\"character\":4}}}}}}}}]"
    let left = syms(first, "/ignored.c")
    let right = syms(second, "/ignored.c")
    ok(mut t, left.len == 5 && right.len == 5, "five each")
    var i = 0
    while i < left.len {
        ok(mut t, left[i].path == right[i].path, "path {i}")
        ok(mut t, left[i].breadcrumb == right[i].breadcrumb, "breadcrumb {i}")
        ok(mut t, left[i].line == right[i].line && left[i].chr == right[i].chr, "position {i}")
        ok(mut t, left[i].name == right[i].name, "name {i}")
        ok(mut t, left[i].kind == right[i].kind, "kind {i}")
        i += 1
    }
}

// `highlight_parse` (`test_lsp_highlight.c:20-29`).
fn hl(text: str, tb: text.TextBuf, pos_enc: int) -> List[lsp.LspHighlight] {
    let j = parse(text)
    lsp.lsp_highlights_parse(j, j.root, tb, pos_enc)
}

// test_lsp_highlight.c:31-59
fn lsp_highlights_parse_text_read_and_write_ranges(mut t: Tally) {
    let rows = hl(
        "[{{\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":3}}}},\"kind\":1}},{{\"range\":{{\"start\":{{\"line\":1,\"character\":1}},\"end\":{{\"line\":1,\"character\":4}}}},\"kind\":2}},{{\"range\":{{\"start\":{{\"line\":2,\"character\":0}},\"end\":{{\"line\":2,\"character\":5}}}},\"kind\":3}}]",
        tb_of("one\n bread\nwrite\n"),
        lsp.POSENC_UTF8,
    )
    ok(mut t, rows.len == 3, "three highlights")
    ok(mut t, rows[0].lo == 0 && rows[0].hi == 3 && rows[0].kind == 1, "text 0..3")
    ok(mut t, rows[1].lo == 5 && rows[1].hi == 8 && rows[1].kind == 2, "read 5..8")
    ok(mut t, rows[2].lo == 11 && rows[2].hi == 16 && rows[2].kind == 3, "write 11..16")
}

// test_lsp_highlight.c:61-76
fn lsp_highlights_missing_kind_defaults_to_text(mut t: Tally) {
    let rows = hl(
        "[{{\"range\":{{\"start\":{{\"line\":0,\"character\":1}},\"end\":{{\"line\":0,\"character\":2}}}}}}]",
        tb_of("abc\n"),
        lsp.POSENC_UTF8,
    )
    ok(mut t, rows.len == 1 && rows[0].kind == 1, "text by default")
}

// test_lsp_highlight.c:78-100
fn lsp_highlights_ignore_malformed_and_invalid_ranges(mut t: Tally) {
    let rows = hl(
        "[null,{{}},{{\"range\":{{\"start\":{{\"line\":0,\"character\":2}},\"end\":{{\"line\":0,\"character\":1}}}}}},{{\"range\":{{\"start\":{{\"line\":-1,\"character\":0}},\"end\":{{\"line\":0,\"character\":1}}}}}},{{\"range\":{{\"start\":{{\"line\":8,\"character\":0}},\"end\":{{\"line\":8,\"character\":1}}}}}},{{\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":1}}}},\"kind\":99}}]",
        tb_of("abc\n"),
        lsp.POSENC_UTF8,
    )
    ok(mut t, rows.len == 0, "none: {rows.len}")
}

// test_lsp_highlight.c:102-121
fn lsp_highlights_convert_exact_utf16_positions(mut t: Tally) {
    let rows = hl(
        "[{{\"range\":{{\"start\":{{\"line\":0,\"character\":1}},\"end\":{{\"line\":0,\"character\":3}}}},\"kind\":2}},{{\"range\":{{\"start\":{{\"line\":0,\"character\":2}},\"end\":{{\"line\":0,\"character\":3}}}},\"kind\":2}}]",
        tb_of("A\u{1F332}B\n"),
        lsp.POSENC_UTF16,
    )
    ok(mut t, rows.len == 1, "the exact one only: {rows.len}")
    ok(mut t, rows[0].lo == 1 && rows[0].hi == 5, "the tree's bytes")
}

// test_lsp_highlight.c:123-140
fn lsp_highlights_null_and_non_array_responses_are_empty(mut t: Tally) {
    let tb = tb_of("abc\n")
    ok(
        mut t,
        lsp.lsp_highlights_parse(lsp.json_new(), -1, tb, lsp.POSENC_UTF8).len == 0,
        "no result",
    )
    ok(mut t, hl("null", tb, lsp.POSENC_UTF8).len == 0, "null")
    ok(mut t, hl("{{}}", tb, lsp.POSENC_UTF8).len == 0, "an object")
}

// test_lsp_highlight.c:142-174
fn lsp_highlights_cap_response_count(mut t: Tally) {
    let row = "{{\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":1}}}},\"kind\":1}}"
    var json = List[byte]()
    (mut json).push(91 as byte)
    var i = 0
    while i < 20001 {
        if i != 0 {
            (mut json).push(44 as byte)
        }
        for b in row.bytes() {
            (mut json).push(b)
        }
        i += 1
    }
    (mut json).push(93 as byte)
    let j = parse_bytes(json)
    let rows = lsp.lsp_highlights_parse(j, j.root, tb_of("x\n"), lsp.POSENC_UTF8)
    ok(mut t, rows.len == 20000, "capped at 20000: {rows.len}")
}

// test_lsp_completion.c:218-247
fn lsp_hover_flattens_all_contents_shapes_and_exact_range(mut t: Tally) {
    let j = parse(
        "{{\"contents\":[\"plain\",{{\"language\":\"c\",\"value\":\"int x\"}},{{\"kind\":\"markdown\",\"value\":\"docs\"}},\"\"],\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":3}}}}}}",
    )
    let h = lsp.lsp_hover_parse(j, j.root, tb_of("int x;\n"), lsp.POSENC_UTF8)
    ok(mut t, h.ok, "parsed")
    ok(mut t, same_bytes(h.body, "plain\nint x\ndocs"), "the pieces joined by LF")
    ok(mut t, h.has_range, "a range")
    ok(mut t, h.range.lo == 0 && h.range.hi == 3, "0..3")
}

// test_lsp_completion.c:249-282
fn lsp_hover_empty_and_inexact_range_are_nonfatal(mut t: Tally) {
    let tb = tb_of("\u{1F600}\n")
    let j = parse(
        "{{\"contents\":{{\"kind\":\"plaintext\",\"value\":\"ok\"}},\"range\":{{\"start\":{{\"line\":0,\"character\":1}},\"end\":{{\"line\":0,\"character\":2}}}}}}",
    )
    let h = lsp.lsp_hover_parse(j, j.root, tb, lsp.POSENC_UTF16)
    ok(mut t, h.ok, "parsed")
    ok(mut t, same_bytes(h.body, "ok"), "ok")
    ok(mut t, !h.has_range, "an inexact range is dropped")
    let e = parse("{{\"contents\":[]}}")
    ok(mut t, !lsp.lsp_hover_parse(e, e.root, tb, lsp.POSENC_UTF8).ok, "empty contents: nothing")
}

// test_lsp_completion.c:284-307
fn lsp_signature_prefers_local_parameter_and_decodes_utf16_span(mut t: Tally) {
    let j = parse(
        "{{\"signatures\":[{{\"label\":\"f(a, \u{1F600}b)\",\"parameters\":[{{\"label\":\"a\"}},{{\"label\":[5,8]}}],\"activeParameter\":1}}],\"activeParameter\":0}}",
    )
    let s = lsp.lsp_signature_parse(j, j.root)
    ok(mut t, s.ok, "parsed")
    ok(mut t, same_bytes(s.body, "f(a, \u{1F600}b)"), "the label")
    ok(mut t, s.has_emph, "an emphasis")
    ok(
        mut t,
        s.emph.lo == 5 && s.emph.hi == 10,
        "the UTF-16 span in bytes: {s.emph.lo}..{s.emph.hi}",
    )
}

// test_lsp_completion.c:309-342
fn lsp_signature_global_string_and_oob_parameter_are_safe(mut t: Tally) {
    let good = parse(
        "{{\"signatures\":[{{\"label\":\"f(alpha, beta)\",\"parameters\":[{{\"label\":\"alpha\"}},{{\"label\":\"beta\"}}]}}],\"activeParameter\":1}}",
    )
    let s = lsp.lsp_signature_parse(good, good.root)
    ok(mut t, s.ok && s.has_emph, "the global parameter")
    ok(mut t, s.emph.lo == 9 && s.emph.hi == 13, "beta at 9..13")
    let oob = parse(
        "{{\"signatures\":[{{\"label\":\"f(alpha)\",\"parameters\":[{{\"label\":\"alpha\"}}]}}],\"activeParameter\":9}}",
    )
    let o = lsp.lsp_signature_parse(oob, oob.root)
    ok(mut t, o.ok && !o.has_emph, "out of range: no emphasis")
}

fn run_case(mut t: Tally, i: int) {
    match i {
        0 => lsp_locations_null_and_empty_array_return_no_rows(mut t),
        1 => lsp_locations_single_location_is_owned(mut t),
        2 => lsp_locations_many_sort_stably_by_path_line_and_column(mut t),
        3 => lsp_locations_location_link_prefers_target_selection_range(mut t),
        4 => lsp_locations_ignore_malformed_and_non_file_rows(mut t),
        5 => lsp_symbols_nested_tree_preserves_preorder_breadcrumbs_and_selection(mut t),
        6 => lsp_symbols_flat_rows_use_container_and_file_uri(mut t),
        7 => lsp_symbols_ignore_mixed_malformed_and_non_file_rows(mut t),
        8 => lsp_symbols_map_all_symbol_kinds_to_completion_vocabulary(mut t),
        9 => lsp_symbols_own_strings_and_free_resets_vector(mut t),
        10 => lsp_symbols_cap_response_count(mut t),
        11 => lsp_symbols_sort_identically_across_server_permutations(mut t),
        12 => lsp_highlights_parse_text_read_and_write_ranges(mut t),
        13 => lsp_highlights_missing_kind_defaults_to_text(mut t),
        14 => lsp_highlights_ignore_malformed_and_invalid_ranges(mut t),
        15 => lsp_highlights_convert_exact_utf16_positions(mut t),
        16 => lsp_highlights_null_and_non_array_responses_are_empty(mut t),
        17 => lsp_highlights_cap_response_count(mut t),
        18 => lsp_hover_flattens_all_contents_shapes_and_exact_range(mut t),
        19 => lsp_hover_empty_and_inexact_range_are_nonfatal(mut t),
        20 => lsp_signature_prefers_local_parameter_and_decodes_utf16_span(mut t),
        21 => lsp_signature_global_string_and_oob_parameter_are_safe(mut t),
        _ => {},
    }
}

const CASES: int = 22

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    var t = Tally { n: 0 }
    let pick = env_get("YEW_LSP_FEATURES_CASE") else ""
    if pick.len != 0 {
        let i = pick.to_int() else -1
        // One past the last case runs nothing and prints nothing
        // (`tools/check-test-cases`).
        if i >= 0 && i < CASES {
            run_case(mut t, i)
            print("lsp_features_test: case {i}: PASS, {t.n} assertions")
        }
        return
    }
    var i = 0
    while i < CASES {
        run_case(mut t, i)
        i += 1
    }
    print("lsp_features_test: {CASES} cases pass, {t.n} assertions")
}
