//! member: false
//! Shared argument-error choke point, pinned std.c:329-390.

use fl

fn main() {
    var vm = fl.fl_vm_new(take fl.fl_strings())
    vm.cur_native = fl.fl_intern(mut vm.strings, "str.slice".bytes(), 0, 9)
    vm.stack[0] = fl.fl_int(3)
    vm.sp = 1
    assert((fl.fl_arg_int(mut vm, 0, 0) else -1) == 3)
    assert((fl.fl_arg_num(mut vm, 0, 0) else -1.0) == 3.0)
    let _ = fl.fl_arg_str(mut vm, 0, 0) else fl.fl_nil()
    assert(vm.raised)
    let msg = fl.fl_str_text(mut vm, "msg")
    let text = fl.fl_map_get(vm, vm.err, msg) else fl.fl_nil()
    let at = fl.fl_obj_index(vm, text)
    assert(
        (str_from_utf8(vm.gc.slots[at].bytes) else "") ==
            "str.slice: argument 1 must be str, found int",
    )
    vm.raised = false
    vm.stack[0] = fl.fl_float(1.5)
    let _ = fl.fl_arg_int(mut vm, 0, 0) else 0
    assert(vm.raised)
    let got = fl.fl_map_get(vm, vm.err, msg) else fl.fl_nil()
    let g = fl.fl_obj_index(vm, got)
    assert(
        (str_from_utf8(vm.gc.slots[g].bytes) else "") ==
            "str.slice: argument 1 must be int, found float",
    )
    print("shared native argument wording: PASS")
}
