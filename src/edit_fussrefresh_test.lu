//! member: false
//!
//! Port rows for s52's "refresh keeps the collapsed state and the
//! selection" (`s52-fuss-mode.md`; `fussmode.c`'s rebuild re-applies the
//! open memories, `fuss_build` → `fuss_apply_effective`, and restores the
//! selection by path): F mode over REAL git, a directory toggled or a row
//! selected, the repository changed under it, a forced refresh run to
//! idle, and the rebuilt tree read back. sagitta checks the same through
//! its goldens (`fuss_memory_reentry`, `fuss_tree_toggle`); these rows put
//! it on the unit lane, where `yw13-plant-collapse` is red by name.
//!
//! No git on the host SKIPs by name. `YEW_PICK_CASE=N` runs case N alone.

use edit
use git
use std.fs
use std.process
use std.signal

fn want(ok: bool, what: str) {
    if !ok {
        say("RED check failed: {what}")
        assert(false, what)
    }
}

fn say(what: str) {
    print("fussrefresh_test: {what}")
    eprint("fussrefresh_test: {what}")
}

fn b(s: str) -> List[byte] {
    var v = List[byte]()
    for x in s.bytes() {
        (mut v).push(x)
    }
    v
}

// `git -C REPO TAIL...`, its output dropped; exit 0 or false.
fn git_ok(repo: str, tail: List[str]) -> bool {
    var argv = List[str]()
    for w in ["git", "-C", repo] {
        (mut argv).push(w)
    }
    for t in tail {
        (mut argv).push(t)
    }
    var null = fs.open_append("/dev/null") else |_| { return false }
    var c = process.from_argv(argv)
    process.set_stdout(mut c, null)
    process.set_stderr(mut c, null)
    let child = process.start(c) else |_| { return false }
    fs.close(take null) else |_| {}
    let status = process.wait_status(take child) else |_| { return false }
    let st = process.status_from(status)
    process.is_exited(st) && (process.exit_code(st) else 1) == 0
}

fn words(xs: List[str]) -> List[str] {
    var v = List[str]()
    for x in xs {
        (mut v).push(x)
    }
    v
}

// A repository with `docs/a.txt` and `z.txt` committed, then both
// modified: F mode shows `docs/` and two changed files.
fn repo(tag: str) -> str {
    let tmp = env_get("TMPDIR") else "target/tests"
    let base = if tmp.len == 0 then "target/tests" else tmp
    let dir = "{base}/yew-fussrefresh-{os_pid()}-{tag}"
    fs.remove_dir_all(dir) else |_| {}
    fs.create_dir_all("{dir}/docs") else |_| { want(false, "mkdir {dir}") }
    let real = fs.realpath(dir) else dir
    fs.write_text("{real}/docs/a.txt", "a\n") else |_| { want(false, "a.txt") }
    fs.write_text("{real}/z.txt", "z\n") else |_| { want(false, "z.txt") }
    want(git_ok(real, words(["init", "-q", "-b", "trunk"])), "init")
    want(git_ok(real, words(["config", "user.name", "Yew Test"])), "user.name")
    want(git_ok(real, words(["config", "user.email", "yew@example.invalid"])), "user.email")
    want(git_ok(real, words(["add", "--", "."])), "add")
    want(git_ok(real, words(["commit", "-q", "-m", "base"])), "commit")
    fs.write_text("{real}/docs/a.txt", "a changed\n") else |_| { want(false, "change a.txt") }
    fs.write_text("{real}/z.txt", "z changed\n") else |_| { want(false, "change z.txt") }
    real
}

fn run_jobs_idle(mut ed: edit.Ed) -> bool {
    let start = time_now_ms()
    while ed.jobs.v.len != 0 {
        let fds = edit.job_wait_fds(ed)
        if fds.len != 0 {
            let _ = os_signal_wait_fds(fds, signal.child(), 20) else |_| { (-1, 0) }
        } else {
            time_sleep_ms(5)
        }
        edit.job_pump(mut ed)
        edit.job_reap(mut ed)
        edit.job_tick(mut ed, time_now_ms())
        let _ = edit.job_settle(mut ed)
        if time_now_ms() - start > 10000 {
            return false
        }
    }
    true
}

fn enter(dir: str) -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    want(edit.ed_set_workspace_root(mut ed, dir), "the workspace root")
    want(edit.mode_enter(mut ed, edit.MODE_F) == edit.CMD_OK, "F mode")
    want(run_jobs_idle(mut ed), "idle")
    edit.fuss_tick(mut ed, time_now_ms())
    ed
}

// The forced refresh a mutation schedules, run to idle and ticked.
fn refresh(mut ed: edit.Ed) -> int {
    let before = ed.git.snap[ed.git.live].gen
    want(edit.git_refresh(mut ed, true), "the refresh spawns")
    want(run_jobs_idle(mut ed), "the refresh settles")
    edit.fuss_tick(mut ed, time_now_ms())
    want(
        ed.git.snap[ed.git.live].gen > before,
        "a new snapshot ({before} -> {ed.git.snap[ed.git.live].gen})",
    )
    ed.fuss.tree.snap_gen
}

fn node_of(ed: edit.Ed, path: str) -> int {
    let p = b(path)
    var i = 0
    while i < ed.fuss.tree.nodes.len {
        if git.git_bytes_cmp(git.fuss_node_path(ed.fuss.tree, i), p) == 0 {
            return i
        }
        i += 1
    }
    -1
}

fn select_path(mut ed: edit.Ed, path: str) {
    let p = b(path)
    git.fuss_sel_set(mut ed.fuss.sel, p, 0, p.len)
    want(git.fuss_row_of(ed.fuss.tree, ed.fuss.sel) >= 0, "{path} has a row")
}

fn selected(ed: edit.Ed) -> str {
    let row = git.fuss_row_of(ed.fuss.tree, ed.fuss.sel)
    if row < 0 {
        return ""
    }
    str_from_utf8(git.fuss_item_path(ed.fuss.tree, row)) else ""
}

fn toggle(mut ed: edit.Ed) {
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    cx.count = 1
    want(edit.fuss_cmd_nav_toggle(mut ed, cx) == edit.CMD_OK, "toggle")
}

// A directory toggled from its default stays toggled across a refresh.
fn fussrefresh_keeps_a_toggled_directory() {
    let dir = repo("toggle")
    var ed = enter(dir)
    let d = node_of(ed, "docs")
    want(d >= 0, "docs/ is a node")
    let initial = ed.fuss.tree.nodes[d].expanded
    select_path(mut ed, "docs")
    toggle(mut ed)
    let d1 = node_of(ed, "docs")
    want(ed.fuss.tree.nodes[d1].expanded == !initial, "the toggle flips docs/")
    fs.write_text("{dir}/docs/new.txt", "new\n") else |_| { want(false, "new.txt") }
    let _ = refresh(mut ed)
    let d2 = node_of(ed, "docs")
    want(d2 >= 0, "docs/ after the refresh")
    want(ed.fuss.tree.nodes[d2].expanded == !initial, "the refresh keeps docs/ toggled")
    want(selected(ed) == "docs", "the selection stays on docs/: `{selected(ed)}`")
    edit.jobs_free(mut ed)
    fs.remove_dir_all(dir) else |_| {}
}

// The selection follows its path when the rows above it change.
fn fussrefresh_keeps_the_selection_by_path() {
    let dir = repo("select")
    var ed = enter(dir)
    select_path(mut ed, "z.txt")
    let row = git.fuss_row_of(ed.fuss.tree, ed.fuss.sel)
    fs.write_text("{dir}/m.txt", "m\n") else |_| { want(false, "m.txt") }
    let _ = refresh(mut ed)
    want(node_of(ed, "m.txt") >= 0, "m.txt arrived")
    want(selected(ed) == "z.txt", "the selection stays on z.txt: `{selected(ed)}`")
    want(git.fuss_row_of(ed.fuss.tree, ed.fuss.sel) == row + 1, "one row lower")
    edit.jobs_free(mut ed)
    fs.remove_dir_all(dir) else |_| {}
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    env_set("LC_ALL", "C") else |_| {}
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    let names = ["fussrefresh_keeps_a_toggled_directory", "fussrefresh_keeps_the_selection_by_path"]
    if !git_ok(".", words(["--version"])) {
        var s = 0
        while s < names.len {
            if chosen < 0 || chosen == s {
                say("SKIP {names[s]}: git not found")
            }
            s += 1
        }
        return
    }
    var n = 0
    while n < names.len {
        if chosen < 0 || chosen == n {
            match n {
                0 => fussrefresh_keeps_a_toggled_directory(),
                _ => fussrefresh_keeps_the_selection_by_path(),
            }
            print("{names[n]}: PASS")
        }
        n += 1
    }
}
