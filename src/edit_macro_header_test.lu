//! member: false
//! The five tests/unit/test_macro_header.c cases at sagitta 9ace98c2, in
//! registry order (Sprint 38: sharing headers are metadata, never an
//! execution policy).

use edit
use fl
use flfix
use term
use text

fn same(a: List[byte], b: str) -> bool {
    let bb = b.bytes()
    if a.len != bb.len { return false }
    for i in 0..a.len { if a[i] != bb[i] { return false } }
    true
}

fn assert_text(got: edit.MacroText, want: str) {
    assert(got.present)
    assert(same(got.s, want), "header field {want}")
}

fn assert_missing(got: edit.MacroText) {
    assert(!got.present)
    assert(got.s.len == 0)
}

fn text_key(c: int) -> term.Key {
    var k = term.key_new()
    k.code = c
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    (mut k.text).push(c as byte)
    k
}

fn parse(src: str) -> (int, edit.MacroHeader) {
    let b = copy src.bytes()
    edit.macro_header_parse(b)
}

fn macro_header_parses_all_five_fields() {
    let (st, h) = parse(
        "# yew-macro: 1\n# recorded-with:   yew 1.2.3  \n# keymap: custom-nav\n# recorded: 2026-07-31T14:22:07Z\n# describe: wrap selection in parens and reindent\nfn wrap() {{ return 7 }}\n",
    )
    assert(st == edit.MACRO_HEADER_OK)
    assert(h.has_schema)
    assert(h.schema == 1)
    assert_text(h.recorded_with, "yew 1.2.3")
    assert_text(h.keymap, "custom-nav")
    assert_text(h.recorded, "2026-07-31T14:22:07Z")
    assert_text(h.describe, "wrap selection in parens and reindent")
}

fn macro_header_accepts_missing_optional_fields() {
    let (st, h) = parse(
        "# yew-macro: 1\n# describe: only one optional field\nfn sparse() {{ return 1 }}\n",
    )
    assert(st == edit.MACRO_HEADER_OK)
    assert(h.has_schema)
    assert(h.schema == 1)
    assert_missing(h.recorded_with)
    assert_missing(h.keymap)
    assert_missing(h.recorded)
    assert_text(h.describe, "only one optional field")
}

fn macro_header_unknown_schema_is_skipped() {
    for n in ["0", "2", "9", "10", "42", "100"] {
        let (st, h) = parse("# yew-macro: {n}\nfn x() {{}}\n")
        assert(st == edit.MACRO_HEADER_UNSUPPORTED, "schema {n}")
        assert(h.has_schema)
        assert(h.schema != 1)
        assert_missing(h.recorded_with)
        assert_missing(h.keymap)
        assert_missing(h.recorded)
        assert_missing(h.describe)
    }
}

fn macro_header_absent_header_still_loads() {
    let source = "fn plain() {{ return 17 }}\nreturn plain()\n"
    let (st, h) = parse(source)
    assert(st == edit.MACRO_HEADER_OK)
    assert(!h.has_schema)
    assert(h.schema == 0)
    assert_missing(h.recorded_with)
    assert_missing(h.keymap)
    assert_missing(h.recorded)
    assert_missing(h.describe)
    var f = flfix.open()
    flfix.eq(mut f, source, "17")
    flfix.close(mut f)
}

fn buffer_bytes(ed: edit.Ed) -> List[byte] {
    let b = edit.ed_doc(ed)
    text.textbuf_bytes(ed.bufs[b].ec.tb)
}

fn macro_header_keymap_is_provenance_not_execution_policy() {
    let (s1, default_header) = parse(
        "# yew-macro: 1\n# keymap: default\nfn result() {{ return 23 }}\nreturn result()\n",
    )
    let (s2, custom_header) = parse(
        "# yew-macro: 1\n# keymap: radically-rebound\nfn result() {{ return 23 }}\nreturn result()\n",
    )
    assert(s1 == edit.MACRO_HEADER_OK && s2 == edit.MACRO_HEADER_OK)
    assert_text(default_header.keymap, "default")
    assert_text(custom_header.keymap, "radically-rebound")
    var origin = edit.ed_new()
    edit.ed_open_scratch(mut origin)
    let insert = edit.cmd_lookup(origin.reg, "ed.edit.insert.text")
    assert(insert != 0)
    let l1 = copy "keymap:first".bytes()
    let l2 = copy "keymap:rebound".bytes()
    let first_origin = fl.fl_origin_register(mut origin.origins, fl.FL_ORIGIN_PLUGIN, l1, 0)
    let rebound_origin = fl.fl_origin_register(mut origin.origins, fl.FL_ORIGIN_WORKSPACE, l2, 0)
    assert(
        edit.bind_add(
            mut origin,
            first_origin,
            edit.MODE_L,
            "Z",
            insert,
            0,
            "wrong-binding",
            true,
            fl.fl_nil(),
        ) !=
            0,
    )
    assert(
        edit.bind_add(
            mut origin,
            rebound_origin,
            edit.MODE_L,
            "Z",
            insert,
            0,
            "resolved-effect",
            true,
            fl.fl_nil(),
        ) !=
            0,
    )
    assert(edit.record_start(mut origin, 'a' as int))
    edit.dispatch_key(mut origin, text_key('Z' as int), 0)
    assert(origin.last_status == edit.CMD_OK)
    assert(origin.rec.ev.len == 1)
    assert(edit.record_stop(mut origin) == edit.CMD_OK)
    let recorded = text.reg_get(mut origin.regs, 'a' as int) else {
        assert(false, "register a")
        return
    }
    assert(recorded.bytes.len != 0)
    let source = copy recorded.bytes
    let expected = buffer_bytes(origin)
    assert(same(expected, "resolved-effect"))
    let (s3, recorded_header) = edit.macro_header_parse(source)
    assert(s3 == edit.MACRO_HEADER_OK)
    assert_text(recorded_header.keymap, "default")
    var fresh = edit.ed_new()
    edit.ed_open_scratch(mut fresh)
    assert(edit.bind_active_count(fresh) == 0)
    assert(edit.flapi_reg_write(mut fresh, 'a' as int, source, false) == edit.CMD_OK)
    assert(edit.macro_replay(mut fresh, 'a' as int, 1) == edit.CMD_OK)
    let actual = buffer_bytes(fresh)
    assert(actual.len == expected.len)
    for i in 0..actual.len { assert(actual[i] == expected[i]) }
}

fn main() {
    macro_header_parses_all_five_fields()
    macro_header_accepts_missing_optional_fields()
    macro_header_unknown_schema_is_skipped()
    macro_header_absent_header_still_loads()
    macro_header_keymap_is_provenance_not_execution_policy()
    print("edit_macro_header: 5 cases pass")
}
