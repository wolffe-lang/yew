//! member: false
//! The six tests/unit/test_macrobrowse.c cases at sagitta 9ace98c2, in
//! registry order (Sprint 38: edit-a-macro uses the ordinary buffer and
//! save machinery). `edit_is_an_ordinary_multicursor_undo_buffer`'s
//! three syntax lines (`scratch->syn.entry.len`, `syn.engine`,
//! `yew_syn_spans`, test_macrobrowse.c:236-239) are the syntax engine's,
//! which yw10 ports: the port has no `Buffer.syn` to assert them on, and
//! they are named here rather than run.

use edit
use text

fn bytes_eq(a: List[byte], b: str) -> bool {
    let bb = b.bytes()
    if a.len != bb.len { return false }
    for i in 0..a.len { if a[i] != bb[i] { return false } }
    true
}

// macro_set (test_macrobrowse.c:17-22).
fn macro_set(mut ed: edit.Ed, reg: int, source: str) {
    let b = copy source.bytes()
    assert(edit.flapi_reg_write(mut ed, reg, b, false) == edit.CMD_OK)
}

fn reg_bytes(mut ed: edit.Ed, reg: int) -> List[byte] {
    let v = text.reg_get(mut ed.regs, reg) else {
        assert(false, "register {reg}")
        return List[byte]()
    }
    copy v.bytes
}

// macro_replace_all (test_macrobrowse.c:50-66): one typing transaction
// through the focused window replacing the scratch's whole text.
fn macro_replace_all(mut ed: edit.Ed, bi: int, source: str) {
    let w = ed.win
    assert(ed.wins[w].buf == bi)
    let old_len = text.textbuf_len(ed.bufs[bi].ec.tb)
    let b = copy source.bytes()
    edit.ed_undo_begin(mut ed, w, text.TXN_TYPE)
    if old_len != 0 { assert(edit.ed_edit_delete(mut ed, w, 0, old_len)) }
    if b.len != 0 { assert(edit.ed_edit_insert(mut ed, w, 0, b, 0, b.len)) }
    edit.ed_undo_end(mut ed, w)
    edit.ed_finish_edit(mut ed, w)
}

fn primary_pos(ed: edit.Ed) -> int {
    let w = ed.win
    ed.wins[w].cs.curs[ed.wins[w].cs.primary].pos
}

fn open_macro(mut ed: edit.Ed, reg: int, original: str) -> int {
    edit.ed_open_scratch(mut ed)
    macro_set(mut ed, reg, original)
    assert(edit.macro_edit(mut ed, reg) == edit.CMD_OK)
    edit.ed_doc(ed)
}

fn macrobrowse_unknown_motion_store_is_atomic_and_points_at_word() {
    let original = "fn original() {{ return 1 }}\n"
    let invalid = "fn edited() {{\n  return 1\n  @[ yankk ]\n}}\n"
    var ed = edit.ed_new()
    let bi = open_macro(mut ed, 'a' as int, original)
    macro_replace_all(mut ed, bi, invalid)
    assert(edit.macro_store(mut ed, bi) == edit.CMD_ERR_ARG)
    assert(bytes_eq(reg_bytes(mut ed, 'a' as int), original))
    let message = ed.msg.text
    assert(message.contains("no command has word 'yankk'"), message)
    assert(message.contains("did you mean 'yank'?"), message)
    assert(message.contains("*macro a*:3:6: error:"), message)
    assert(message.contains("  @[ yankk ]\n     ^~~~~"), message)
    assert(primary_pos(ed) == "fn edited() {{\n  return 1\n  @[ ".len)
    assert(!text.undo_at_save_point(ed.bufs[bi].ec.undo))
}

fn macrobrowse_unresolved_global_store_is_atomic_and_points_at_name() {
    let original = "fn original() {{ return 1 }}\n"
    let invalid = "@[ i\"changed\" ]\nmissing_function()\n"
    var ed = edit.ed_new()
    let bi = open_macro(mut ed, 'd' as int, original)
    macro_replace_all(mut ed, bi, invalid)
    assert(edit.macro_store(mut ed, bi) == edit.CMD_ERR_ARG)
    assert(bytes_eq(reg_bytes(mut ed, 'd' as int), original))
    let message = ed.msg.text
    assert(message.contains("undefined name 'missing_function'"), message)
    assert(message.contains("*macro d*:2:1: error:"), message)
    assert(primary_pos(ed) == "@[ i\"changed\" ]\n".len)
    assert(!text.undo_at_save_point(ed.bufs[bi].ec.undo))
}

fn macrobrowse_store_accepts_forward_global_function_reference() {
    let original = "fn original() {{ return 1 }}\n"
    let edited = "fn first() {{ return second() }}\nfn second() {{ return 1 }}\nfirst()\n"
    var ed = edit.ed_new()
    let bi = open_macro(mut ed, 'e' as int, original)
    macro_replace_all(mut ed, bi, edited)
    assert(edit.macro_store(mut ed, bi) == edit.CMD_OK)
    assert(edit.macro_replay(mut ed, 'e' as int, 1) == edit.CMD_OK)
}

fn macrobrowse_store_accepts_persistent_runtime_global() {
    let helper = copy "fn helper() {{ return 1 }}\n".bytes()
    let original = "fn original() {{ return 1 }}\n"
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    assert(edit.fl_runtime_eval(mut ed, helper) == edit.CMD_OK)
    macro_set(mut ed, 'f' as int, original)
    assert(edit.macro_edit(mut ed, 'f' as int) == edit.CMD_OK)
    let bi = edit.ed_doc(ed)
    macro_replace_all(mut ed, bi, "helper()\n")
    assert(edit.macro_store(mut ed, bi) == edit.CMD_OK)
    assert(edit.macro_replay(mut ed, 'f' as int, 1) == edit.CMD_OK)
}

fn macrobrowse_valid_store_marks_clean_and_sets_undo_boundary() {
    let original = "fn original() {{ return 1 }}\n"
    let edited = "fn edited() {{ return 2 }}\n"
    var ed = edit.ed_new()
    let bi = open_macro(mut ed, 'b' as int, original)
    macro_replace_all(mut ed, bi, edited)
    assert(!text.undo_at_save_point(ed.bufs[bi].ec.undo))
    let current = text.undo_current(ed.bufs[bi].ec.undo)
    let nodes = ed.bufs[bi].ec.undo.nodes.len
    assert(edit.macro_store(mut ed, bi) == edit.CMD_OK)
    assert(text.undo_at_save_point(ed.bufs[bi].ec.undo))
    assert(ed.bufs[bi].ec.undo.boundary)
    assert(text.undo_current(ed.bufs[bi].ec.undo) == current)
    assert(ed.bufs[bi].ec.undo.nodes.len == nodes)
    assert(ed.bufs[bi].ec.undo.saved == current)
    assert(bytes_eq(reg_bytes(mut ed, 'b' as int), edited))
    assert(ed.msg.text == "stored macro @b (1 lines)", ed.msg.text)
}

fn macrobrowse_edit_is_an_ordinary_multicursor_undo_buffer() {
    let source = "# yew-macro: 1\n@[ i\"plain\" ]\n"
    let inserted = "X# yew-macro: 1\n@[ i\"plain\" ]\nX"
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    let primary = edit.ed_doc(ed)
    macro_set(mut ed, 'c' as int, source)
    assert(edit.macro_edit(mut ed, 'c' as int) == edit.CMD_OK)
    let bi = edit.ed_doc(ed)
    assert(bi != primary)
    assert(ed.bufs[bi].has_name && ed.bufs[bi].name == "*macro c*")
    assert(!ed.bufs[bi].has_path)
    assert((ed.buf_languages[ed.bufs[bi].id] else "") == "fletch")
    assert(ed.bufs[bi].macro_reg == 'c' as int)
    assert(edit.tab_count(ed) == 2)
    assert(ed.tab_active == 1)
    assert(ed.tabs[1].buffer_id == ed.bufs[bi].id)
    assert(ed.bufs[bi].flags & edit.BUF_SCRATCH != 0)
    assert(ed.bufs[bi].flags & edit.BUF_NOUNDO == 0)
    assert(text.undo_at_save_point(ed.bufs[bi].ec.undo))
    // test_macrobrowse.c:236-239 (the syntax lines): yw10's, named above.
    let w = ed.win
    let end = source.len
    assert(text.cset_add(mut ed.wins[w].cs, text.Cursor { pos: end, goal_col: 0, anchor: end }))
    let insert = edit.cmd_lookup(ed.reg, "ed.edit.insert.text")
    assert(insert != 0)
    var cx = edit.cmdctx_new(w, edit.SRC_TEST)
    cx.count = 1
    cx.sarg = "X"
    cx.has_sarg = true
    assert(edit.ed_cmd_invoke(mut ed, insert, mut cx) == edit.CMD_OK)
    assert(ed.wins[w].cs.curs.len == 2)
    assert(ed.bufs[bi].ec.undo.nodes.len == 2)
    assert(ed.bufs[bi].ec.undo.nodes[1].reason == text.TXN_MULTI)
    assert(ed.bufs[bi].ec.undo.nodes[1].n_ops == 2)
    assert(bytes_eq(text.textbuf_bytes(ed.bufs[bi].ec.tb), inserted))
    edit.edit_take(mut ed, w)
    let undone = text.undo(mut ed.bufs[bi].ec)
    edit.edit_give(mut ed, w)
    assert(undone)
    edit.ed_finish_edit(mut ed, w)
    assert(bytes_eq(text.textbuf_bytes(ed.bufs[bi].ec.tb), source))
    assert(ed.wins[w].cs.curs.len == 2)
    assert(text.undo_at_save_point(ed.bufs[bi].ec.undo))
}

fn main() {
    macrobrowse_unknown_motion_store_is_atomic_and_points_at_word()
    macrobrowse_unresolved_global_store_is_atomic_and_points_at_name()
    macrobrowse_store_accepts_forward_global_function_reference()
    macrobrowse_store_accepts_persistent_runtime_global()
    macrobrowse_valid_store_marks_clean_and_sets_undo_boundary()
    macrobrowse_edit_is_an_ordinary_multicursor_undo_buffer()
    print("edit_macrobrowse: 6 cases pass (3 syntax lines yw10's)")
}
