//! member: false
//!
//! yew — a modal terminal editor ("tmux and vim had a baby"), ported to
//! wolf from its C source at tenseleyFlow/sagitta, byte-identical (the
//! planning repo's `sprints/yew/index.md`, ruling #89). C yew built from
//! `sagitta.pin` is the oracle; `tools/goldens` runs its suites against
//! this binary.
//!
//! This is the port's first row (yw00): `--version` prints what C yew
//! prints (sagitta `src/args.c`, `s00-repo-and-foundations.md` §6), and
//! every other path is NOT YET PORTED and says so, naming its sagitta
//! sprint and the port lane that lands it (invariant 3: no silent
//! stubs). The driver proper — `src/main.c`, `src/args.c` — is yw01's
//! with the terminal, since a driver that cannot open a terminal has
//! nothing to drive.

use util

fn not_yet(what: str, sprint: str, lane: str) -> int {
    eprint("yew: error: not yet ported: {what}: sagitta Sprint {sprint} ({lane})")
    util.EXIT_ERR
}

fn main() -> int {
    let args = env_args()
    if args.len == 1 && args[0] == "--version" {
        print("yew {util.VERSION}")
        print(util.MODULES_LINE)
        return util.EXIT_OK
    }
    if args.len == 0 {
        return not_yet("the editor", "14 (modes L and I)", "yw03")
    }
    let first = args[0]
    if first == "--help" {
        return not_yet("--help", "0 (the driver shell)", "yw01")
    }
    if first == "--batch" {
        return not_yet("--batch", "37 (headless batch)", "yw09")
    }
    if first == "--clean" {
        return not_yet("--clean", "36 (the config system)", "yw09")
    }
    if first == "fl" {
        return not_yet("yew fl", "32 (the Fletch REPL)", "yw08")
    }
    if first == "syn" {
        return not_yet("yew syn", "42.5 (the native language pack)", "yw10")
    }
    if first == "pkg" {
        return not_yet("yew pkg", "55 (packages)", "yw14")
    }
    if first == "tutor" {
        return not_yet("yew tutor", "59 (the tutor)", "yw16")
    }
    if first.starts_with("-") {
        return not_yet("option {first}", "0 (the driver shell)", "yw01")
    }
    not_yet("opening a file", "14 (modes L and I)", "yw03")
}
