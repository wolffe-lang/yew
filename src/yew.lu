//! member: false
//!
//! yew — a modal terminal editor ("tmux and vim had a baby"), ported to
//! wolf from its C source at tenseleyFlow/sagitta, byte-identical (the
//! planning repo's `sprints/yew/index.md`, ruling #89). C yew built from
//! `sagitta.pin` is the oracle; `tools/goldens` runs its suites against
//! this binary.
//!
//! The driver (yw01): ports sagitta `src/main.c` (235 lines) at 9ace98c2.
//! The subcommands are dispatched before the option parser, as C does
//! (`main.c:195-213`); `--guard` is the terminal guard sibling's own
//! entry (`term.tty`, ruling #93 R1 interim B); `yew_args_parse` is
//! `args.args_parse` with its error channel; `--version` and `--help`
//! print C yew's bytes (`run_driver`, `main.c:119-182`). Every surface a
//! later lane lands hard-errors naming its sagitta sprint and the lane
//! (invariant 3: no silent stubs); the editor itself (`yew_ed_driver_
//! files_opts`) is campaign 03's, but a stdin that is not a terminal
//! gets the `--batch` diagnostic first, as s03 DoD 8 pins it.

use args
use term
use util

/// sagitta's `--help` text, byte for byte (`main.c:25-86`); a
/// `tools/goldens` row compares it against C yew's.
const HELP_TEXT: str = "Usage:
  yew [options] [file ...]

Options:
  --help           Show this help.
  --help-cmds      List named editor commands.
  --version        Show version and compiled modules.
  --clean          Load only the panic keymap; keep no state/history.
  --config PATH    Use PATH instead of the user init.fl.
  --theme NAME     Override the configured theme for this run.
  --no-workspace-config  Do not load .yew.fl.
  --trust-workspace      Pre-grant this workspace configuration.
  --workspace DIR  Use DIR as the workspace instead of the startup cwd.
  --batch SCRIPT   Run SCRIPT headlessly; no tty or grid.
  --replay REG     Replay REG once after the batch script completes.
  --test           Add the t.* script-test assertions (batch only).
  --quiet          Suppress batch warnings; errors still print.
  --grant NAME:CAP Pre-grant fs, shell, net, or clipboard (repeatable).
  --               Pass every remaining argument to the batch script.

Subcommands:
  yew fl FILE      Run a Fletch script headlessly.
  yew syn COMMAND   Inspect and compile syntax definitions.
  yew plug COMMAND  List, enable, disable, or reload plugins.
  yew pkg COMMAND   Install, update, remove, list, or verify plugins.
  yew tutor [CHAPTER] [--list|--reset|--check]
                   Open or inspect the interactive tutorial.

Command line:
  Lines beginning with a space are not saved in command history.

Search and replace:
  /pat  ?pat        Incremental search, forward and backward.
  n  N              Repeat in the search's own direction, and the
                    reverse of it -- after ?pat, n goes backward.
  *  #              Search for the word under the cursor.
  :[range]s/pat/rep/flags   Substitute; flags g c n i I p e.
                    In the replacement, & is a LITERAL ampersand;
                    use \\0 for the whole match.  This differs from
                    vi and sed on purpose.
  Multi-file search is :!rg <pattern> (or any tool you prefer),
  whose output lands in a job buffer you can navigate.  An
  in-editor indexed project search is deliberately not a 1.0
  feature.

Environment:
  YEW_LOG          Override the log file path.
  YEW_LOG_LEVEL    Set debug, info, warn, or error logging.
  YEW_NO_SYN_CACHE Set to 1 to bypass the syntax table cache.
  YEW_THEME        Override the configured theme (loses to --theme).
  YEW_TTY_PROBE    Set 0 to disable terminal capability probes.
  YEW_PROBE_TIMEOUT_MS  Override the 50 ms probe deadline.
  YEW_TRUECOLOR    Set 0 or 1 to override truecolor detection.
  YEW_CHORD_TIMEOUT_MS  Set key chord timeout (default 500).
  YEW_CLIPBOARD    Set auto, osc52, wl, xclip, xsel, pb, none,
                   or cmd:<write-argv>[|<read-argv>].
  YEW_CLIPBOARD_TARGET  Set OSC 52 target c, p, or cp.
  YEW_CLIPBOARD_TIMEOUT_MS  Set subprocess timeout (default 1000).
  YEW_OSC52        Set off, plain, tmux, or screen; plain bypasses
                   multiplexer detection.
  YEW_OSC52_MAX    Set maximum encoded OSC 52 bytes (default 100000).
"

fn not_yet(what: str, sprint: str, lane: str) -> int {
    eprint("yew: error: not yet ported: {what}: sagitta Sprint {sprint} ({lane})")
    util.EXIT_ERR
}

// `run_driver` (`main.c:119-182`) for the surfaces yw01 lands.
fn run_driver(a: args.Args) -> int {
    if a.selftest_bug {
        util.bug("selftest", "selftest")
    }
    if a.version {
        print("yew {util.VERSION}")
        print(util.MODULES_LINE)
        return util.EXIT_OK
    }
    if a.help {
        print_raw(HELP_TEXT)
        return util.EXIT_OK
    }
    if a.help_cmds {
        return not_yet("--help-cmds", "13 (the command registry)", "yw03")
    }
    if a.batch_set {
        return not_yet("--batch", "37 (headless batch)", "yw09")
    }
    if !term.tty_require_terminal() {
        return util.EXIT_ERR
    }
    not_yet("the editor", "14 (modes L and I)", "yw03")
}

fn main() -> int {
    let argv = env_args()
    if argv.len == 2 && argv[0] == "--guard" {
        return term.guard_main(argv[1])
    }
    if argv.len == 1 && argv[0] == "--yew-env0" {
        return not_yet("--yew-env0", "57.27 (the shell session)", "yw04")
    }
    if argv.len >= 1 {
        let first = argv[0]
        if first == "fl" {
            return not_yet("yew fl", "32 (the Fletch REPL)", "yw08")
        }
        if first == "syn" {
            return not_yet("yew syn", "42.5 (the native language pack)", "yw10")
        }
        if first == "plug" {
            return not_yet("yew plug", "54 (plugins)", "yw14")
        }
        if first == "pkg" {
            return not_yet("yew pkg", "55 (packages)", "yw14")
        }
        if first == "tutor" {
            return not_yet("yew tutor", "59 (the tutor)", "yw16")
        }
    }
    if argv.len >= 2 && argv[0] == "--clean" && argv[1] == "syn" {
        return not_yet("yew --clean syn", "42.5 (the native language pack)", "yw10")
    }
    let (rc, parsed, err) = args.args_parse(argv)
    if rc >= 0 {
        if rc != util.EXIT_OK && err.len != 0 {
            eprint_raw(err)
        }
        if rc != util.EXIT_OK {
            return rc
        }
    }
    run_driver(parsed)
}
