//! member: false
//!
//! The port of sagitta `tests/unit/test_textbuf_props.c` (760 lines), the
//! twelve properties in registry order (`tests/unit/registry.c:288-299`),
//! each over C's four seeds (`test_textbuf_props.c:15-18`) and C's case
//! count (`YEW_PROP_N`, default 500, `test_textbuf_props.c:30-43`), with
//! C's generator bit for bit (`prop_rng`, `prop_fill`, `prop_random_edit`).
//! The two tree walks (`prop_visit_seams`, `prop_check_tree`) walk the
//! port's node pool by index where C follows pointers. P10's second
//! release order frees the buffer first, as C does; the port's snapshot
//! then reads through the released buffer value (the `text.piece` module
//! doc). C's `mkstemp` + `unlink` is a fresh random path.

use text

fn seeds() -> List[wrapping[u64]] {
    var s = List[wrapping[u64]]()
    (mut s).push(1)
    (mut s).push(2611923443488327891)
    (mut s).push(11400714819323198485)
    (mut s).push(15111065706836454659)
    s
}

// `prop_rng`, `test_textbuf_props.c:20-28`: xorshift64*, the state and
// the output separate.
fn prop_rng(s: wrapping[u64]) -> (wrapping[u64], wrapping[u64]) {
    var x = s
    x = x ^ x >> 12
    x = x ^ x << 25
    x = x ^ x >> 27
    (x, x * 2685821657736338717)
}

fn below(x: wrapping[u64], n: int) -> int {
    (x % n as wrapping[u64]) as int
}

fn low_byte(x: wrapping[u64]) -> byte {
    (x & 255) as int as byte
}

// `prop_cases`, `test_textbuf_props.c:30-43`.
fn prop_cases() -> int {
    let v = env_get("YEW_PROP_N") else {
        return 500
    }
    if v.len == 0 {
        return 500
    }
    var n = 0
    for b in v.bytes() {
        let d = b as int - 48
        assert(d >= 0 && d <= 9, "YEW_PROP_N is a count")
        n = n * 10 + d
    }
    assert(n > 0, "YEW_PROP_N is positive")
    n
}

fn special() -> List[byte] {
    var s = List[byte]()
    for v in [10, 13, 0, 128, 255, 204, 129, 230, 188, 162, 9] {
        (mut s).push(v as byte)
    }
    s
}

struct Rng {
    state: wrapping[u64],
}

fn next(mut r: Rng) -> wrapping[u64] {
    let (s, v) = prop_rng(r.state)
    r.state = s
    v
}

// `prop_fill`, `test_textbuf_props.c:45-63`.
fn prop_fill(mut r: Rng, max_len: int, sp: List[byte]) -> List[byte] {
    let len = below(next(mut r), max_len + 1)
    var out = List[byte]()
    var i = 0
    while i < len {
        let value = next(mut r)
        if (value & 3) as int == 0 {
            (mut out).push(sp[below(value, sp.len)])
        } else {
            (mut out).push(low_byte(value))
        }
        i += 1
    }
    out
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

// `prop_materialize`, `test_textbuf_props.c:65-82`.
fn materialize(tb: text.TextBuf) -> List[byte] {
    var out = List[byte]()
    var it = text.textiter_new()
    if text.textiter_begin(mut it, tb, text.byteoff(0)) {
        loop {
            let c = text.textiter_chunk(it, tb)
            assert(c.ok, "chunk")
            assert(c.len > 0, "chunk non-empty")
            var i = 0
            while i < c.len {
                (mut out).push(text.store_byte(tb, c.src, c.at + i))
                i += 1
            }
            if !text.textiter_advance(mut it, tb) {
                break
            }
        }
    }
    out
}

// `prop_snap_materialize`, `test_textbuf_props.c:84-100`.
fn snap_materialize(tb: text.TextBuf, snap: text.TextSnap) -> List[byte] {
    var out = List[byte]()
    var it = text.textiter_new()
    if text.textsnap_iter(mut it, tb, snap, text.byteoff(0)) {
        loop {
            let c = text.textiter_chunk(it, tb)
            assert(c.ok, "snapshot chunk")
            var i = 0
            while i < c.len {
                (mut out).push(text.store_byte(tb, c.src, c.at + i))
                i += 1
            }
            if !text.textiter_advance(mut it, tb) {
                break
            }
        }
    }
    out
}

fn assert_bytes(tb: text.TextBuf, want: List[byte]) {
    assert(same(materialize(tb), want), "the buffer holds the oracle's bytes")
}

fn count_lfs(b: List[byte]) -> int {
    var n = 0
    for x in b {
        if x == 10 as byte {
            n += 1
        }
    }
    n
}

fn oracle_insert(bytes: List[byte], at: int, payload: List[byte]) -> List[byte] {
    var out = List[byte]()
    var i = 0
    while i < at {
        (mut out).push(bytes[i])
        i += 1
    }
    for b in payload {
        (mut out).push(b)
    }
    while i < bytes.len {
        (mut out).push(bytes[i])
        i += 1
    }
    out
}

// `prop_edit_init`, `test_textbuf_props.c:150-158`: window 1, the cursor
// at 0 with goal 17.
fn edit_init(initial: List[byte]) -> text.EditCtx {
    let tb = text.textbuf_from_bytes(initial, 0, initial.len)
    let undo = text.undo_new(tb)
    var ec = text.editctx_new(take tb)
    ec.marks = text.marks_new()
    ec.has_marks = true
    ec.cset = text.cset_init(text.Cursor { pos: 0, goal_col: 17, anchor: 0 })
    ec.has_cset = true
    ec.undo = undo
    ec.has_undo = true
    ec.win_id = 1
    ec
}

// `prop_random_edit`, `test_textbuf_props.c:168-196`.
fn random_edit(mut f: text.EditCtx, mut r: Rng) {
    let len = text.textbuf_len(f.tb)
    text.undo_boundary(mut f.undo)
    var inserting = len == 0
    if !inserting {
        inserting = (next(mut r) & 1) as int == 0
    }
    if inserting {
        let n = 1 + below(next(mut r), 4)
        let at = below(next(mut r), len + 1)
        var bytes = List[byte]()
        var i = 0
        while i < n {
            (mut bytes).push(low_byte(next(mut r)))
            i += 1
        }
        text.undo_begin(mut f, text.TXN_TYPE)
        let _ = text.edit_insert(mut f, text.byteoff(at), bytes)
        text.cset_normalize(f.tb, mut f.cset)
        text.undo_end(mut f)
    } else {
        let lo = below(next(mut r), len)
        let hi = lo + 1 + below(next(mut r), len - lo)
        text.undo_begin(mut f, text.TXN_ERASE)
        let _ = text.edit_delete(mut f, text.span(lo, hi))
        text.cset_normalize(f.tb, mut f.cset)
        text.undo_end(mut f)
    }
}

fn t_textbuf_prop_p1_splice_inverse() {
    let n = prop_cases()
    let sp = special()
    for seed in seeds() {
        var r = Rng { state: seed }
        var case_i = 0
        while case_i < n {
            let base = prop_fill(mut r, 64, sp)
            var payload = prop_fill(mut r, 16, sp)
            if payload.len == 0 {
                (mut payload).push(120 as byte)
            }
            var tb = text.textbuf_from_bytes(base, 0, base.len)
            let at = below(next(mut r), base.len + 1)
            let pieces = text.textbuf_piece_count(tb)
            let lines = text.textbuf_line_count(tb)
            text.textbuf_insert(mut tb, text.byteoff(at), payload)
            text.textbuf_delete(mut tb, text.span(at, at + payload.len))
            text.textbuf_check(tb)
            assert_bytes(tb, base)
            assert(text.textbuf_line_count(tb) == lines, "line count kept")
            assert(text.textbuf_piece_count(tb) <= pieces + 2, "pieces bounded")
            case_i += 1
        }
    }
}

fn t_textbuf_prop_p2_delete_inverse() {
    let n = prop_cases()
    let sp = special()
    for seed in seeds() {
        var r = Rng { state: seed }
        var case_i = 0
        while case_i < n {
            var base = prop_fill(mut r, 96, sp)
            if base.len == 0 {
                (mut base).push(120 as byte)
            }
            var tb = text.textbuf_from_bytes(base, 0, base.len)
            let lo = below(next(mut r), base.len)
            let hi = lo + below(next(mut r), base.len - lo + 1)
            let all = materialize(tb)
            var removed = List[byte]()
            var i = lo
            while i < hi {
                (mut removed).push(all[i])
                i += 1
            }
            text.textbuf_delete(mut tb, text.span(lo, hi))
            text.textbuf_insert(mut tb, text.byteoff(lo), removed)
            text.textbuf_check(tb)
            assert_bytes(tb, base)
            case_i += 1
        }
    }
}

// `prop_assert_iter_suffix`, `test_textbuf_props.c:270-291`.
fn assert_iter_suffix(tb: text.TextBuf, all: List[byte], at: int) {
    var suffix = List[byte]()
    var it = text.textiter_new()
    if text.textiter_begin(mut it, tb, text.byteoff(at)) {
        loop {
            let c = text.textiter_chunk(it, tb)
            assert(c.ok, "suffix chunk")
            var i = 0
            while i < c.len {
                (mut suffix).push(text.store_byte(tb, c.src, c.at + i))
                i += 1
            }
            if !text.textiter_advance(mut it, tb) {
                break
            }
        }
    }
    assert(suffix.len == all.len - at, "suffix length at {at}")
    var i = 0
    while i < suffix.len {
        assert(suffix[i] == all[at + i], "suffix byte at {at}")
        i += 1
    }
}

// `prop_visit_seams`, `test_textbuf_props.c:293-307`, over the pool.
fn visit_seams(tb: text.TextBuf, node: int, base: int, all: List[byte]) {
    if node < 0 {
        return
    }
    let nd = copy tb.nodes[node]
    let left = if nd.left < 0 then 0 else tb.nodes[nd.left].sub_bytes
    visit_seams(tb, nd.left, base, all)
    let end = base + left + nd.hi - nd.lo
    assert_iter_suffix(tb, all, base + left)
    assert_iter_suffix(tb, all, end)
    visit_seams(tb, nd.right, end, all)
}

fn t_textbuf_prop_p3_iterator_materialize() {
    let n = prop_cases()
    let sp = special()
    for seed in seeds() {
        var r = Rng { state: seed }
        var case_i = 0
        while case_i < n {
            var base = prop_fill(mut r, 64, sp)
            var tb = text.textbuf_from_bytes(base, 0, base.len)
            var i = 0
            while i < 6 {
                var one = List[byte]()
                (mut one).push(low_byte(next(mut r)))
                let at = below(next(mut r), text.textbuf_len(tb) + 1)
                text.textbuf_insert(mut tb, text.byteoff(at), one)
                base = oracle_insert(base, at, one)
                i += 1
            }
            let all = materialize(tb)
            assert(same(all, base), "materialized")
            assert_iter_suffix(tb, all, 0)
            assert_iter_suffix(tb, all, below(next(mut r), all.len + 1))
            visit_seams(tb, tb.root, 0, all)
            case_i += 1
        }
    }
}

fn t_textbuf_prop_p4_line_index_recount() {
    let n = prop_cases()
    let sp = special()
    for seed in seeds() {
        var r = Rng { state: seed }
        var case_i = 0
        while case_i < n {
            let base = prop_fill(mut r, 128, sp)
            let tb = text.textbuf_from_bytes(base, 0, base.len)
            assert(text.textbuf_line_count(tb) == count_lfs(base) + 1, "line count")
            assert(text.textbuf_line_start(tb, text.lineno(0)) as int == 0, "line 0")
            var line = 0
            var i = 0
            while i < base.len {
                if base[i] == 10 as byte {
                    line += 1
                    assert(
                        text.textbuf_line_start(tb, text.lineno(line)) as int == i + 1,
                        "line start",
                    )
                }
                i += 1
            }
            case_i += 1
        }
    }
}

fn t_textbuf_prop_p5_line_roundtrip() {
    let n = prop_cases()
    let sp = special()
    for seed in seeds() {
        var r = Rng { state: seed }
        var case_i = 0
        while case_i < n {
            let base = prop_fill(mut r, 96, sp)
            let tb = text.textbuf_from_bytes(base, 0, base.len)
            let lines = text.textbuf_line_count(tb)
            var line = 0
            while line < lines {
                let start = text.textbuf_line_start(tb, text.lineno(line))
                assert(text.textbuf_line_of(tb, start) as int == line, "line of start")
                line += 1
            }
            var off = 0
            while off <= base.len {
                let l = text.textbuf_line_of(tb, text.byteoff(off)) as int
                assert(text.textbuf_line_start(tb, text.lineno(l)) as int <= off, "start before")
                if l + 1 < lines {
                    assert(
                        off < text.textbuf_line_start(tb, text.lineno(l + 1)) as int,
                        "next after",
                    )
                } else {
                    assert(off < base.len + 1, "inside")
                }
                off += 1
            }
            case_i += 1
        }
    }
}

fn t_textbuf_prop_p6_undo_redo_identity() {
    let n = prop_cases()
    for seed in seeds() {
        var r = Rng { state: seed }
        var case_i = 0
        while case_i < n {
            let edits = 1 + below(next(mut r), 12)
            var f = edit_init(bytes_of("root\n"))
            var done = 0
            while done < edits {
                random_edit(mut f, mut r)
                done += 1
            }
            let final = materialize(f.tb)
            let saved = copy f.cset.curs[f.cset.primary]
            let node = text.undo_current(f.undo)
            done = 0
            while text.undo(mut f) {
                done += 1
            }
            while done != 0 {
                assert(text.redo(mut f), "redo")
                done -= 1
            }
            assert_bytes(f.tb, final)
            assert(text.textbuf_line_count(f.tb) == count_lfs(final) + 1, "lines")
            let now = copy f.cset.curs[f.cset.primary]
            assert(now.pos == saved.pos, "cursor pos")
            assert(now.anchor == saved.anchor, "cursor anchor")
            assert(now.goal_col == saved.goal_col, "cursor goal")
            assert(text.undo_current(f.undo) == node, "same node")
            case_i += 1
        }
    }
}

fn t_textbuf_prop_p7_undo_to_root() {
    let n = prop_cases()
    let sp = special()
    for seed in seeds() {
        var r = Rng { state: seed }
        var case_i = 0
        while case_i < n {
            let initial = prop_fill(mut r, 48, sp)
            var f = edit_init(initial)
            var i = 0
            while i < 8 {
                random_edit(mut f, mut r)
                i += 1
            }
            while text.undo(mut f) {}
            assert_bytes(f.tb, initial)
            case_i += 1
        }
    }
}

fn t_textbuf_prop_p8_branch_preservation() {
    let n = prop_cases()
    for seed in seeds() {
        var r = Rng { state: seed }
        var case_i = 0
        while case_i < n {
            var f = edit_init(List[byte]())
            var parent = text.undo_current(f.undo)
            var depth = 0
            while depth < 8 {
                var branch = List[int]()
                var branch_text = List[List[byte]]()
                var width = 0
                while width < 3 {
                    var one = List[byte]()
                    (mut one).push((65 + depth * 3 + width) as byte)
                    assert(text.undo_to(mut f, parent), "to parent")
                    text.undo_boundary(mut f.undo)
                    let at = text.textbuf_len(f.tb)
                    let _ = text.edit_insert(mut f, text.byteoff(at), one)
                    (mut branch).push(text.undo_current(f.undo))
                    (mut branch_text).push(materialize(f.tb))
                    width += 1
                }
                width = 0
                while width < 3 {
                    assert(text.undo_to(mut f, branch[width]), "to branch")
                    assert_bytes(f.tb, copy branch_text[width])
                    width += 1
                }
                parent = branch[below(next(mut r), 3)]
                assert(text.undo_to(mut f, parent), "to the chosen branch")
                depth += 1
            }
            case_i += 1
        }
    }
}

struct PropTree {
    bytes: int,
    lfs: int,
    count: int,
}

// `prop_check_tree`, `test_textbuf_props.c:575-595`, over the pool.
fn check_tree(tb: text.TextBuf, node: int) -> PropTree {
    if node < 0 {
        return PropTree { bytes: 0, lfs: 0, count: 0 }
    }
    let nd = copy tb.nodes[node]
    let left = check_tree(tb, nd.left)
    let right = check_tree(tb, nd.right)
    let own = nd.hi - nd.lo
    assert(own > 0, "a non-empty piece")
    let out = PropTree {
        bytes: left.bytes + own + right.bytes,
        lfs: left.lfs + nd.lf_count + right.lfs,
        count: left.count + 1 + right.count,
    }
    assert(nd.sub_bytes == out.bytes, "sub bytes")
    assert(nd.sub_lfs == out.lfs, "sub lfs")
    assert(nd.sub_count == out.count, "sub count")
    out
}

fn t_textbuf_prop_p9_coalescing_invariants() {
    let n = prop_cases()
    for seed in seeds() {
        var r = Rng { state: seed }
        var case_i = 0
        while case_i < n {
            var seq = text.textbuf_new()
            var base = List[byte]()
            var i = 0
            while i < 64 {
                (mut base).push(98 as byte)
                i += 1
            }
            let k = 8 + below(next(mut r), 16)
            i = 0
            while i < k {
                text.textbuf_insert_str(mut seq, text.byteoff(i), "x")
                i += 1
            }
            assert(text.textbuf_piece_count(seq) <= 2, "sequential inserts coalesce")
            let _ = check_tree(seq, seq.root)
            var scattered = text.textbuf_from_bytes(base, 0, base.len)
            let start = text.textbuf_piece_count(scattered)
            i = 0
            while i < k {
                text.textbuf_insert_str(mut scattered, text.byteoff(i * 3), "x")
                i += 1
            }
            assert(text.textbuf_piece_count(scattered) <= 2 * k + 1, "the 2*ops+1 bound")
            assert(text.textbuf_piece_count(scattered) - start >= k - 1, "scattered pieces")
            let _ = check_tree(scattered, scattered.root)
            text.textbuf_check(seq)
            text.textbuf_check(scattered)
            case_i += 1
        }
    }
}

fn t_textbuf_prop_p10_snapshot_immutability() {
    let n = prop_cases()
    let sp = special()
    for seed in seeds() {
        var r = Rng { state: seed }
        var case_i = 0
        while case_i < n {
            let initial = prop_fill(mut r, 80, sp)
            var tb = text.textbuf_from_bytes(initial, 0, initial.len)
            var snap = text.textbuf_snap(mut tb)
            var i = 0
            while i < 16 {
                var one = List[byte]()
                (mut one).push(low_byte(next(mut r)))
                let at = below(next(mut r), text.textbuf_len(tb) + 1)
                text.textbuf_insert(mut tb, text.byteoff(at), one)
                i += 1
            }
            assert(same(snap_materialize(tb, snap), initial), "the snapshot is unchanged")
            if case_i & 1 == 0 {
                text.textsnap_release(mut tb, mut snap)
                text.textbuf_free(mut tb)
            } else {
                text.textbuf_free(mut tb)
                text.textsnap_release(mut tb, mut snap)
            }
            case_i += 1
        }
    }
}

fn temp_path() -> str {
    var tries = 0
    while tries < 100 {
        var suffix = ""
        for v in os_random(6) {
            suffix = suffix + "{v % 10}"
        }
        let path = "/tmp/yew-prop-{suffix}"
        let fd = fs_open_perm(path, 4, 384) else {
            tries += 1
            continue
        }
        fs_close(fd) else {
            assert(false, "close the temp")
        }
        fs_remove(path) else {
            assert(false, "unlink the temp")
        }
        return path
    }
    assert(false, "mkstemp exhausted")
    ""
}

fn t_textbuf_prop_p11_save_load_roundtrip() {
    let n = prop_cases()
    let sp = special()
    for seed in seeds() {
        var r = Rng { state: seed }
        var case_i = 0
        while case_i < n {
            var initial = prop_fill(mut r, 96, sp)
            let kind = case_i % 4
            if kind == 0 {
                (mut initial).push(13 as byte)
                (mut initial).push(10 as byte)
            } else if kind == 1 {
                for v in [0, 255, 192, 128] {
                    (mut initial).push(v as byte)
                }
            } else if kind == 2 {
                if initial.len == 0 {
                    (mut initial).push(110 as byte)
                } else if initial[initial.len - 1] == 10 as byte {
                    initial[initial.len - 1] = 110 as byte
                }
            } else {
                for v in [230, 188, 162, 240, 159, 145, 141, 240, 159, 143, 189] {
                    (mut initial).push(v as byte)
                }
            }
            if initial.len >= 3 &&
                initial[0] == 239 as byte &&
                initial[1] == 187 as byte &&
                initial[2] == 191 as byte {
                initial[0] = 66 as byte
            }
            let path = temp_path()
            var tb = text.textbuf_from_bytes(initial, 0, initial.len)
            var save_meta = text.filemeta_new()
            assert(text.file_save(mut tb, mut save_meta, path) == text.SAVE_OK, "save")
            var (rc, loaded, load_meta) = text.file_load(path)
            assert(rc == text.LOAD_OK, "load")
            assert_bytes(loaded, initial)
            text.filemeta_dispose(mut load_meta, mut loaded)
            text.textbuf_free(mut loaded)
            text.filemeta_dispose(mut save_meta, mut tb)
            text.textbuf_free(mut tb)
            fs_remove(path) else {
                assert(false, "unlink {path}")
            }
            case_i += 1
        }
    }
}

fn t_textbuf_prop_p12_cursor_mark_invariants() {
    let n = prop_cases()
    var start = List[byte]()
    for v in [101, 204, 129, 10, 116, 101, 120, 116] {
        (mut start).push(v as byte)
    }
    for seed in seeds() {
        var r = Rng { state: seed }
        var case_i = 0
        while case_i < n {
            var f = edit_init(start)
            var marks = List[text.MarkId]()
            var mark_i = 0
            while mark_i < 8 {
                let at = below(next(mut r), text.textbuf_len(f.tb) + 1)
                let bias = if mark_i & 1 == 0 then text.BIAS_LEFT else text.BIAS_RIGHT
                (mut marks).push(text.mark_add(mut f.marks, text.byteoff(at), bias))
                mark_i += 1
            }
            var op = 0
            while op < 24 {
                random_edit(mut f, mut r)
                text.cset_normalize(f.tb, mut f.cset)
                let p = f.cset.curs[f.cset.primary].pos
                assert(text.is_grapheme_boundary(f.tb, text.byteoff(p)), "the cursor on a boundary")
                for m in marks {
                    assert(
                        text.mark_pos(f.marks, m) as int <= text.textbuf_len(f.tb),
                        "the mark inside",
                    )
                }
                text.textbuf_check(f.tb)
                op += 1
            }
            case_i += 1
        }
    }
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_textbuf_prop_p1_splice_inverse()
    t_textbuf_prop_p2_delete_inverse()
    t_textbuf_prop_p3_iterator_materialize()
    t_textbuf_prop_p4_line_index_recount()
    t_textbuf_prop_p5_line_roundtrip()
    t_textbuf_prop_p6_undo_redo_identity()
    t_textbuf_prop_p7_undo_to_root()
    t_textbuf_prop_p8_branch_preservation()
    t_textbuf_prop_p9_coalescing_invariants()
    t_textbuf_prop_p10_snapshot_immutability()
    t_textbuf_prop_p11_save_load_roundtrip()
    t_textbuf_prop_p12_cursor_mark_invariants()
    print("textbuf_props_test: 12 properties pass, {prop_cases()} cases x 4 seeds each")
}
