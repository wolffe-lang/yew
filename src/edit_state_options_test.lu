//! member: false
//! Ports sagitta tests/unit/test_state_options.c:14-102 at9ace98c2.
//! The pure option helper is insufficient: these exercise Ed dirty/timer.

use edit
use ws

fn fixture() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed
}

fn t_bool_overlay_preserves_unknown_literals() {
    var ed = fixture()
    let doc = "{{version:1,options:{{\"from.the.future\":42,\"git.tree.all_files\":\"legacy\",}},groups:[],tabs:[],active_tab:0,files:[],}}"
    assert(edit.state_apply(mut ed, doc.bytes()) == edit.WS_FRESH)
    ed.state.ready = true
    ed.state.writer = true
    assert(edit.state_option_bool_set(mut ed, "git.tree.all_files", true))
    assert(edit.state_option_bool_set(mut ed, "git.tree.show_hidden", false))
    assert(ed.state.dirty && ed.state.timer != edit.TIMER_NONE)
    assert(edit.state_option_bool(ed, "git.tree.all_files", false))
    assert(!edit.state_option_bool(ed, "git.tree.show_hidden", true))
    let bytes = edit.state_emit_at(ed, 0)
    let parsed = ws.fl_parse(bytes, 0, bytes.len)
    assert(parsed.ok)
    let opts = ws.fl_get(parsed.doc, parsed.doc.root, "options".bytes()) else -1
    let future = ws.fl_get(parsed.doc, opts, "from.the.future".bytes()) else -1
    assert(ws.fl_int_or(parsed.doc, future, 0) == 42)
    let all = ws.fl_get(parsed.doc, opts, "git.tree.all_files".bytes()) else -1
    let hidden = ws.fl_get(parsed.doc, opts, "git.tree.show_hidden".bytes()) else -1
    assert(ws.fl_bool_or(parsed.doc, all, false) && !ws.fl_bool_or(parsed.doc, hidden, true))
    edit.state_dispose(mut ed)
}

fn t_bool_overlay_is_sorted_and_idempotent() {
    var ed = fixture()
    ed.state.ready = true
    ed.state.writer = true
    assert(edit.state_option_bool_set(mut ed, "git.tree.show_hidden", true))
    let timer = ed.state.timer
    assert(edit.state_option_bool_set(mut ed, "git.tree.all_files", false))
    assert(!edit.state_option_bool_set(mut ed, "git.tree.all_files", false))
    assert(ed.state.timer == timer)
    let bytes = edit.state_emit_at(ed, 0)
    let doc = str_from_utf8(bytes) else ""
    assert((doc.find("git.tree.all_files") else 99999) < (doc.find("git.tree.show_hidden") else -1))
    edit.state_dispose(mut ed)
}

fn main() {
    t_bool_overlay_preserves_unknown_literals()
    print("state_options_bool_overlay_preserves_unknown_literals: PASS")
    t_bool_overlay_is_sorted_and_idempotent()
    print("state_options_bool_overlay_is_sorted_and_idempotent: PASS")
}
