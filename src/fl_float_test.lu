//! member: false
//! R4 direct seam tests; C11 strtod prefix rules and IEEE ties-to-even.

use fl
use std.math.float as floats

fn main() {
    assert(fl.float_general(1.1, 17) == "1.1000000000000001")
    assert(fl.float_general(1.0e20, 17) == "1e+20")
    assert(fl.float_general(0.00001, 17) == "1.0000000000000001e-05")
    assert(fl.float_shortest(3.0) == "3.0")
    assert(fl.float_shortest(-0.0) == "-0.0")
    assert(fl.float_fixed(2.5, 0) == "2")
    assert(fl.float_fixed(3.5, 0) == "4")
    assert((fl.float_parse("1_2.3") else -1.0) == 1.0)
    assert((fl.float_parse("1.2_3") else -1.0) == 1.2)
    let (v, end) = fl.float_scan("  -0x1.8p+2suffix")
    assert(v == -6.0 && end == 11)
    assert((fl.float_parse("0x1p-1074") else -1.0) == floats.from_bits(1))
    assert((fl.float_parse("0x1p-1075") else -1.0) == 0.0)
    assert((fl.float_parse("0x1.0000000000001p-1075") else -1.0) == floats.from_bits(1))
    assert(floats.to_bits(fl.float_parse("-1e-9999") else 1.0) == -9223372036854775807 - 1)
    assert(floats.is_inf(fl.float_parse("1e9999") else 0.0))
    assert(floats.is_nan(fl.float_parse("nan(payload)") else 0.0))
    let (bad, none) = fl.float_scan("  xyz")
    assert(bad == 0.0 && none == 0)
    let (_, unicode_end) = fl.float_scan("𝄞")
    assert(unicode_end == 0)
    print("float seam prefix/hex/rounding: PASS")
}
