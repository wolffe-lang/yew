//! member: false
//! Ports sagitta tests/unit/test_shell_self.c:1-367 at 9ace98c2 (s57.11,
//! `:!yew FILE` into the current editor): the four `registry.c:1254-1257`
//! cases in order. C's `ed.ws.nbufs` is the port's count of LIVE buffer
//! slots (`Ed.bufs` is never compacted, R-yw04-5: a dropped slot keeps no
//! path, name or text); the tab-cap case opens its 512 never-read paths
//! under the fixture instead of `/tmp`.

use std.fs
use edit
use util

struct SelfFix { ed: edit.Ed, base: str, workspace: str, shared: str }

fn self_mkdir(path: str) {
    fs_create_dir_mode(path, 448) else |e| { assert(false, "mkdir {path}: {e}") }
}

fn self_write(path: str, text: str) {
    fs_write_bytes(path, text.bytes()) else |e| { assert(false, "write {path}: {e}") }
}

// `self_fix_make` (`test_shell_self.c:52-74`).
fn self_fix_make() -> SelfFix {
    assert(util.mkdirs("target/shell-self-fixtures", 448))
    var base = ""
    loop {
        var suffix = ""
        for r in os_random(6) { suffix = "{suffix}{r % 10}" }
        base = "target/shell-self-fixtures/yew-self-{suffix}"
        fs_create_dir_mode(base, 448) else |e| match e {
            exists => { continue },
            _ => { assert(false, "mkdir fixture: {e}") },
        }
        break
    }
    base = fs_realpath(base) else ""
    assert(base.len != 0)
    let workspace = "{base}/work"
    let shared = "{base}/shared"
    self_mkdir(workspace)
    self_mkdir(shared)
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    assert(edit.ed_set_workspace_root(mut ed, workspace))
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    SelfFix { ed: ed, base: base, workspace: workspace, shared: shared }
}

fn self_try(mut ed: edit.Ed, command: str) -> int {
    let (r, _) = edit.shell_try_self_open(mut ed, command)
    r
}

fn live_bufs(ed: edit.Ed) -> int {
    var n = 0
    for b in ed.bufs {
        if b.has_path || b.has_name || b.resident { n += 1 }
    }
    n
}

fn active_path(ed: edit.Ed) -> str { ed.tabs[ed.tab_active].path }

fn remove(path: str) { fs_remove(path) else |e| { assert(false, "unlink {path}: {e}") } }

fn rmdir(path: str) { fs_remove_dir(path) else |e| { assert(false, "rmdir {path}: {e}") } }

// `test_shell_self_recognizes_only_exact_safe_argv` (`:82-152`).
fn t_recognizes_only_exact_safe_argv() {
    var f = self_fix_make()
    let note = "{f.workspace}/note.txt"
    let spaced = "{f.workspace}/notes one.md"
    let draft = "{f.workspace}/-draft"
    let directory = "{f.workspace}/adir"
    self_write(note, "note\n")
    self_write(spaced, "space\n")
    self_write(draft, "draft\n")
    self_mkdir(directory)
    var cx = edit.cmdctx_new(f.ed.win, edit.SRC_KEY)
    cx.sarg = " yew note.txt \t"
    cx.has_sarg = true
    assert(edit.shc_run(mut f.ed, cx) == edit.CMD_OK)
    assert(active_path(f.ed) == note)
    assert(self_try(mut f.ed, "yew 'note.txt'") == edit.SHELL_SELF_OPENED)
    assert(self_try(mut f.ed, "yew \"notes one.md\"") == edit.SHELL_SELF_OPENED)
    assert(self_try(mut f.ed, "yew notes\\ one.md") == edit.SHELL_SELF_OPENED)
    assert(self_try(mut f.ed, "yew -- '-draft'") == edit.SHELL_SELF_OPENED)
    assert(self_try(mut f.ed, "yew") == edit.SHELL_SELF_ERROR)
    assert(self_try(mut f.ed, "yew ''") == edit.SHELL_SELF_ERROR)
    assert(self_try(mut f.ed, "yew --") == edit.SHELL_SELF_ERROR)
    assert(self_try(mut f.ed, "yew adir") == edit.SHELL_SELF_NOT_HANDLED)
    let fallback = [
        "yew a.c b.c",
        "yew --version",
        "./build/yew note.txt",
        "command yew note.txt",
        "yew \"$FILE\"",
        "yew *.c",
        "yew note.txt | sed -n 1p",
        "yew note.txt; echo done",
        "yew note.txt >out",
        "yew note.txt\n",
        "yew 'unterminated",
    ]
    for line in fallback {
        assert(self_try(mut f.ed, line) == edit.SHELL_SELF_NOT_HANDLED, line)
    }
    for _ in 0..10000 {
        assert(self_try(mut f.ed, "yew note.txt | false") == edit.SHELL_SELF_NOT_HANDLED)
    }
    for _ in 0..1000 {
        assert(self_try(mut f.ed, "yew note.txt") == edit.SHELL_SELF_OPENED)
    }
    assert(f.ed.jobs.v.len == 0)
    assert(edit.tab_count(f.ed) == 4)
    remove(note)
    remove(spaced)
    remove(draft)
    rmdir(directory)
    rmdir(f.workspace)
    rmdir(f.shared)
    rmdir(f.base)
}

// `test_shell_self_resolves_workspace_and_outside_tabs` (`:154-195`).
fn t_resolves_workspace_and_outside_tabs() {
    var f = self_fix_make()
    let inside = "{f.workspace}/inside.txt"
    let outside = "{f.shared}/outside.txt"
    self_write(inside, "inside\n")
    self_write(outside, "outside\n")
    // Even an unusual broad group must not absorb an outside-workspace tab.
    let broad = edit.group_create(mut f.ed, f.base, "broad")
    edit.group_add_member(mut f.ed, broad, 0)
    assert(self_try(mut f.ed, "yew inside.txt") == edit.SHELL_SELF_OPENED)
    var idx = f.ed.tab_active
    assert(f.ed.tabs[idx].path == inside)
    assert(f.ed.tabs[idx].group_id == broad)
    assert(self_try(mut f.ed, "yew ../shared/outside.txt") == edit.SHELL_SELF_OPENED)
    idx = f.ed.tab_active
    assert(f.ed.tabs[idx].path == outside)
    assert(f.ed.tabs[idx].group_id == 0)
    assert(idx == edit.tab_count(f.ed) - 1)
    let before = edit.tab_count(f.ed)
    assert(self_try(mut f.ed, "yew {outside}") == edit.SHELL_SELF_OPENED)
    assert(edit.tab_count(f.ed) == before)
    assert(active_path(f.ed) == outside)
    assert(f.ed.jobs.v.len == 0)
    remove(inside)
    remove(outside)
    rmdir(f.workspace)
    rmdir(f.shared)
    rmdir(f.base)
}

// `test_shell_self_places_groups_by_root_and_stable_membership` (`:197-301`).
fn t_places_groups_by_root_and_stable_membership() {
    var f = self_fix_make()
    let src = "{f.workspace}/src"
    let deep = "{src}/deep"
    let src2 = "{f.workspace}/src2"
    let alias = "{f.workspace}/alias"
    self_mkdir(src)
    self_mkdir(deep)
    self_mkdir(src2)
    fs.symlink(deep, alias) else |_| { assert(false, "symlink") }

    self_write("{src}/outer.txt", "outer\n")
    assert(self_try(mut f.ed, "yew src/outer.txt") == edit.SHELL_SELF_OPENED)
    let outer_seed = f.ed.tab_active
    let outer = edit.group_create(mut f.ed, src, "outer")
    edit.group_add_member(mut f.ed, outer, outer_seed)

    self_write("{deep}/nested.txt", "nested\n")
    assert(self_try(mut f.ed, "yew src/deep/nested.txt") == edit.SHELL_SELF_OPENED)
    let nested_seed = f.ed.tab_active
    let nested = edit.group_create(mut f.ed, deep, "nested")
    edit.group_add_member(mut f.ed, nested, nested_seed)

    self_write("{src}/existing.txt", "existing\n")
    assert(self_try(mut f.ed, "yew src/existing.txt") == edit.SHELL_SELF_OPENED)
    let existing = f.ed.tab_active
    edit.group_add_member(mut f.ed, outer, existing)
    let existing_ordinal = f.ed.tabs[existing].group_ordinal

    edit.tab_switch(mut f.ed, outer_seed)
    assert(self_try(mut f.ed, "yew src/deep/new.txt") == edit.SHELL_SELF_OPENED)
    assert(f.ed.tabs[f.ed.tab_active].group_id == nested)
    assert(f.ed.tabs[f.ed.tab_active].group_ordinal == 2)

    let equal = edit.group_create(mut f.ed, deep, "equal")
    assert(self_try(mut f.ed, "yew src/deep/equal-seed.txt") == edit.SHELL_SELF_OPENED)
    let equal_seed = f.ed.tab_active
    edit.group_add_member(mut f.ed, equal, equal_seed)
    edit.tab_switch(mut f.ed, equal_seed)
    assert(self_try(mut f.ed, "yew src/deep/equal-new.txt") == edit.SHELL_SELF_OPENED)
    assert(f.ed.tabs[f.ed.tab_active].group_id == equal)
    assert(f.ed.tabs[f.ed.tab_active].group_ordinal == 2)

    assert(self_try(mut f.ed, "yew src2/collision.txt") == edit.SHELL_SELF_OPENED)
    assert(f.ed.tabs[f.ed.tab_active].group_id == 0)

    // Canonicalize a new file through a symlinked parent before grouping.
    edit.tab_switch(mut f.ed, nested_seed)
    assert(self_try(mut f.ed, "yew alias/symlink-new.txt") == edit.SHELL_SELF_OPENED)
    assert(f.ed.tabs[f.ed.tab_active].group_id == nested)
    assert(active_path(f.ed) == "{deep}/symlink-new.txt")

    edit.tab_switch(mut f.ed, equal_seed)
    assert(self_try(mut f.ed, "yew src/existing.txt") == edit.SHELL_SELF_OPENED)
    assert(f.ed.tab_active == existing)
    assert(f.ed.tabs[existing].group_id == outer)
    assert(f.ed.tabs[existing].group_ordinal == existing_ordinal)

    remove("{src}/outer.txt")
    remove("{deep}/nested.txt")
    remove("{src}/existing.txt")
    remove(alias)
    rmdir(deep)
    rmdir(src)
    rmdir(src2)
    rmdir(f.workspace)
    rmdir(f.shared)
    rmdir(f.base)
}

// `test_shell_self_errors_roll_back_tabs_buffers_and_focus` (`:303-367`).
fn t_errors_roll_back_tabs_buffers_and_focus() {
    var f = self_fix_make()
    var tab_count = edit.tab_count(f.ed)
    var buffer_count = live_bufs(f.ed)
    var group_count = f.ed.groups.len
    var active_id = f.ed.tabs[f.ed.tab_active].tab_id

    assert(self_try(mut f.ed, "yew /dev/null/child") == edit.SHELL_SELF_ERROR)
    assert(edit.tab_count(f.ed) == tab_count)
    assert(live_bufs(f.ed) == buffer_count)
    assert(f.ed.groups.len == group_count)
    assert(f.ed.tabs[f.ed.tab_active].tab_id == active_id)
    assert(f.ed.jobs.v.len == 0)

    // C's `too_long[PATH_MAX + 32]`: "yew /" then 4,122 'a's.
    let too_long = "yew /" + "a".repeat(4096 + 32 - 6)
    assert(self_try(mut f.ed, too_long) == edit.SHELL_SELF_ERROR)
    assert(edit.tab_count(f.ed) == tab_count)
    assert(live_bufs(f.ed) == buffer_count)
    assert(f.ed.tabs[f.ed.tab_active].tab_id == active_id)

    while edit.tab_count(f.ed) < edit.TAB_MAX {
        let idx = edit.tab_open(mut f.ed, "{f.base}/yew-self-cap-{edit.tab_count(f.ed)}.txt")
        if idx < 0 { break }
    }
    tab_count = edit.tab_count(f.ed)
    buffer_count = live_bufs(f.ed)
    group_count = f.ed.groups.len
    active_id = f.ed.tabs[f.ed.tab_active].tab_id
    assert(self_try(mut f.ed, "yew cap-over.txt") == edit.SHELL_SELF_ERROR)
    assert(edit.tab_count(f.ed) == tab_count)
    assert(live_bufs(f.ed) == buffer_count)
    assert(f.ed.groups.len == group_count)
    assert(f.ed.tabs[f.ed.tab_active].tab_id == active_id)
    assert(f.ed.jobs.v.len == 0)
    rmdir(f.workspace)
    rmdir(f.shared)
    rmdir(f.base)
}

fn main() {
    let chosen = (env_get("YEW_SELF_CASE") else "-1").to_int() else -1
    if chosen < 0 || chosen == 0 {
        t_recognizes_only_exact_safe_argv()
        print("shell_self_recognizes_only_exact_safe_argv: PASS")
    }
    if chosen < 0 || chosen == 1 {
        t_resolves_workspace_and_outside_tabs()
        print("shell_self_resolves_workspace_and_outside_tabs: PASS")
    }
    if chosen < 0 || chosen == 2 {
        t_places_groups_by_root_and_stable_membership()
        print("shell_self_places_groups_by_root_and_stable_membership: PASS")
    }
    if chosen < 0 || chosen == 3 {
        t_errors_roll_back_tabs_buffers_and_focus()
        print("shell_self_errors_roll_back_tabs_buffers_and_focus: PASS")
    }
}
