//! member: false
//!
//! The port of sagitta `tests/unit/test_save_paths.c` (503 lines), one test
//! per C test in registry order (`tests/unit/registry.c:407-416`). The last,
//! `save_fault_shim_contract`, runs sagitta's own `kill9` driver and fault
//! shim (the oracle's build, `tools/oracle`) against the PORT's torture
//! child (`target/tools/yew-torture`) with no external kills, as C runs it
//! against its own sibling binaries; it skips loudly when either is not
//! built. C's `realpath` in the backup-name test is the port's
//! `text.file_realpath` (G4).

use std.process
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn fresh_dir(prefix: str) -> str {
    var tries = 0
    while tries < 100 {
        var suffix = ""
        for r in os_random(6) {
            suffix = suffix + "{r % 10}"
        }
        let dir = "/tmp/{prefix}-{suffix}"
        fs_create_dir_mode(dir, 448) else |e| match e {
            exists => {
                tries += 1
                continue
            },
            denied => { assert(false, "mkdtemp denied") },
            invalid => { assert(false, "mkdtemp invalid") },
            not_found => { assert(false, "mkdtemp not found") },
            unsupported => { assert(false, "mkdtemp unsupported") },
            io => { assert(false, "mkdtemp io") },
        }
        return dir
    }
    assert(false, "mkdtemp exhausted")
    ""
}

// `save_fixture_make`, `test_save_paths.c:26-39`: a root and its state dir.
fn fixture() -> str {
    let root = fresh_dir("yew-save")
    fs_create_dir_mode("{root}/state", 448) else {
        assert(false, "mkdir state")
    }
    env_set("XDG_STATE_HOME", "{root}/state") else {
        assert(false, "setenv XDG_STATE_HOME")
    }
    root
}

fn remove_tree(path: str) {
    let w = fs_lstat(path) else {
        return
    }
    if w[0] == 1 {
        fs_set_mode(path, 448) else |_| {}
        let entries = fs_read_dir(path) else {
            assert(false, "opendir {path}")
            return
        }
        for e in entries {
            remove_tree("{path}/{e}")
        }
        fs_remove_dir(path) else {
            assert(false, "rmdir {path}")
        }
    } else {
        fs_remove(path) else {
            assert(false, "unlink {path}")
        }
    }
}

fn save_write(path: str, bytes: List[byte], mode: int) {
    let fd = fs_open_perm(path, 4, mode) else {
        assert(false, "create {path}")
        return
    }
    if bytes.len != 0 {
        fs_write_chunk(fd, bytes) else {
            assert(false, "write {path}")
        }
    }
    fs_close(fd) else {
        assert(false, "close {path}")
    }
}

fn assert_saved_bytes(path: str, expected: str) {
    let b = fs_read_bytes(path) else {
        assert(false, "read {path}")
        return
    }
    assert(same(b, bytes_of(expected)), "{path} holds {expected}")
}

fn stat_words(path: str) -> List[int] {
    let w = fs_stat(path) else {
        assert(false, "stat {path}")
        return List[int]()
    }
    w
}

fn lstat_kind(path: str) -> int {
    let w = fs_lstat(path) else {
        assert(false, "lstat {path}")
        return -1
    }
    w[0]
}

fn t_save_symlink_preserves_link_and_updates_target() {
    let root = fixture()
    let target = "{root}/target.txt"
    let link_path = "{root}/link.txt"
    save_write(target, bytes_of("old"), 384)
    fs_symlink("target.txt", link_path) else {
        assert(false, "symlink")
    }
    var (rc, tb, meta) = text.file_load(link_path)
    assert(rc == text.LOAD_OK, "load")
    assert(meta.via_symlink, "via symlink")
    text.textbuf_insert_str(mut tb, text.byteoff(text.textbuf_len(tb)), "-new")
    assert(text.file_save(mut tb, mut meta, link_path) == text.SAVE_OK, "save 1")
    assert(lstat_kind(link_path) == 3, "still a link")
    text.textbuf_insert_str(mut tb, text.byteoff(text.textbuf_len(tb)), "!")
    assert(text.file_save(mut tb, mut meta, link_path) == text.SAVE_OK, "save 2")
    assert(lstat_kind(link_path) == 3, "still a link")
    assert_saved_bytes(target, "old-new!")
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    remove_tree(root)
}

fn t_save_symlink_into_read_only_directory_stays_in_place() {
    let root = fixture()
    let work = "{root}/readonly"
    fs_create_dir_mode(work, 448) else {
        assert(false, "mkdir readonly")
    }
    let target = "{work}/target.txt"
    let link_path = "{root}/link.txt"
    save_write(target, bytes_of("old"), 384)
    fs_symlink("readonly/target.txt", link_path) else {
        assert(false, "symlink")
    }
    var (rc, tb, meta) = text.file_load(link_path)
    assert(rc == text.LOAD_OK, "load")
    let before = stat_words(target)
    text.textbuf_insert_str(mut tb, text.byteoff(text.textbuf_len(tb)), "-new")
    fs_set_mode(work, 320) else {
        assert(false, "chmod 0500")
    }
    assert(text.file_save(mut tb, mut meta, link_path) == text.SAVE_OK, "save")
    let after = stat_words(target)
    assert(before[10] == after[10], "same inode")
    assert(lstat_kind(link_path) == 3, "still a link")
    assert_saved_bytes(target, "old-new")
    fs_set_mode(work, 448) else {
        assert(false, "chmod 0700")
    }
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    remove_tree(root)
}

fn t_save_dangling_symlink_preserves_link_and_creates_target() {
    let root = fixture()
    let target = "{root}/future.txt"
    let link_path = "{root}/link.txt"
    fs_symlink("future.txt", link_path) else {
        assert(false, "symlink")
    }
    var (rc, tb, meta) = text.file_load(link_path)
    assert(rc == text.LOAD_ENOENT, "ENOENT")
    assert(meta.via_symlink, "via symlink")
    text.textbuf_insert_str(mut tb, text.byteoff(0), "created through link\n")
    assert(text.file_save(mut tb, mut meta, link_path) == text.SAVE_OK, "save")
    assert(lstat_kind(link_path) == 3, "still a link")
    assert_saved_bytes(target, "created through link\n")
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    remove_tree(root)
}

fn t_save_hardlink_preserves_shared_inode() {
    let root = fixture()
    let first = "{root}/first.txt"
    let second = "{root}/second.txt"
    let third = "{root}/third.txt"
    save_write(first, bytes_of("old"), 384)
    fs_link(first, second) else {
        assert(false, "link second")
    }
    fs_link(first, third) else {
        assert(false, "link third")
    }
    var (rc, tb, meta) = text.file_load(first)
    assert(rc == text.LOAD_OK, "load")
    assert(meta.nlink == 3, "three links")
    text.textbuf_insert_str(mut tb, text.byteoff(text.textbuf_len(tb)), "-new")
    assert(text.file_save(mut tb, mut meta, first) == text.SAVE_OK, "save 1")
    var a = stat_words(first)
    var b = stat_words(second)
    var c = stat_words(third)
    assert(a[10] == b[10] && a[10] == c[10], "one inode")
    text.textbuf_insert_str(mut tb, text.byteoff(text.textbuf_len(tb)), "!")
    assert(text.file_save(mut tb, mut meta, first) == text.SAVE_OK, "save 2")
    a = stat_words(first)
    b = stat_words(second)
    c = stat_words(third)
    assert(a[10] == b[10] && a[10] == c[10], "still one inode")
    assert_saved_bytes(first, "old-new!")
    assert_saved_bytes(second, "old-new!")
    assert_saved_bytes(third, "old-new!")
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    remove_tree(root)
}

fn t_save_backup_path_symlink_cannot_overwrite_victim() {
    let root = fixture()
    let first = "{root}/first.txt"
    let second = "{root}/second.txt"
    let victim = "{root}/victim.txt"
    let yew_dir = "{root}/state/yew"
    let backup_dir = "{yew_dir}/backup"
    save_write(first, bytes_of("original"), 384)
    fs_link(first, second) else {
        assert(false, "link")
    }
    save_write(victim, bytes_of("do not overwrite"), 384)
    let resolved = text.file_realpath(first) else {
        assert(false, "realpath")
        return
    }
    fs_create_dir_mode(yew_dir, 448) else {
        assert(false, "mkdir yew")
    }
    fs_create_dir_mode(backup_dir, 448) else {
        assert(false, "mkdir backup")
    }
    let backup = "{backup_dir}/{text.hex16(text.path_fnv64(resolved))}.bak"
    fs_symlink(victim, backup) else {
        assert(false, "plant the symlink")
    }
    var (rc, tb, meta) = text.file_load(first)
    assert(rc == text.LOAD_OK, "load")
    text.textbuf_delete(mut tb, text.span(0, text.textbuf_len(tb)))
    text.textbuf_insert_str(mut tb, text.byteoff(0), "replacement")
    assert(text.file_save(mut tb, mut meta, first) == text.SAVE_OK, "save")
    assert(lstat_kind(backup) == 0, "the backup is a regular file now")
    assert_saved_bytes(backup, "original")
    assert_saved_bytes(victim, "do not overwrite")
    assert_saved_bytes(first, "replacement")
    assert_saved_bytes(second, "replacement")
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    remove_tree(root)
}

fn t_save_read_only_directory_uses_in_place_path() {
    let root = fixture()
    let work = "{root}/readonly"
    fs_create_dir_mode(work, 448) else {
        assert(false, "mkdir readonly")
    }
    let path = "{work}/file.txt"
    save_write(path, bytes_of("old"), 384)
    var (rc, tb, meta) = text.file_load(path)
    assert(rc == text.LOAD_OK, "load")
    let before = stat_words(path)
    text.textbuf_delete(mut tb, text.span(0, text.textbuf_len(tb)))
    text.textbuf_insert_str(mut tb, text.byteoff(0), "new")
    fs_set_mode(work, 320) else {
        assert(false, "chmod 0500")
    }
    assert(text.file_save(mut tb, mut meta, path) == text.SAVE_OK, "save")
    let after = stat_words(path)
    assert(before[10] == after[10], "same inode")
    assert_saved_bytes(path, "new")
    fs_set_mode(work, 448) else {
        assert(false, "chmod 0700")
    }
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    remove_tree(root)
}

fn t_save_existing_file_preserves_mode_owner_and_group() {
    let root = fixture()
    let path = "{root}/mode.txt"
    save_write(path, bytes_of("old"), 416)
    let before = stat_words(path)
    var (rc, tb, meta) = text.file_load(path)
    assert(rc == text.LOAD_OK, "load")
    text.textbuf_insert_str(mut tb, text.byteoff(text.textbuf_len(tb)), "!")
    assert(text.file_save(mut tb, mut meta, path) == text.SAVE_OK, "save 1")
    var after = stat_words(path)
    assert(after[4] == before[4], "mode kept")
    assert(after[6] == before[6], "owner kept")
    assert(after[7] == before[7], "group kept")
    assert(meta.exists, "exists")
    assert(meta.dev == after[9] && meta.ino == after[10], "identity refreshed")
    assert(meta.nlink == after[5], "nlink refreshed")
    assert(meta.size_on_disk == after[1], "size refreshed")
    assert(meta.has_realpath, "a realpath")
    text.textbuf_insert_str(mut tb, text.byteoff(text.textbuf_len(tb)), "?")
    assert(text.file_save(mut tb, mut meta, path) == text.SAVE_OK, "save 2")
    after = stat_words(path)
    assert(meta.dev == after[9] && meta.ino == after[10], "identity refreshed again")
    assert(meta.size_on_disk == after[1], "size refreshed again")
    assert_saved_bytes(path, "old!?")
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    remove_tree(root)
}

fn t_save_new_file_creates_requested_content() {
    let root = fixture()
    let path = "{root}/new.txt"
    var (rc, tb, meta) = text.file_load(path)
    assert(rc == text.LOAD_ENOENT, "ENOENT")
    assert(!meta.exists, "does not exist")
    text.textbuf_insert_str(mut tb, text.byteoff(0), "brand new\n")
    assert(text.file_save(mut tb, mut meta, path) == text.SAVE_OK, "save")
    let st = stat_words(path)
    assert(st[0] == 0, "a regular file")
    assert(meta.exists, "exists now")
    assert(meta.dev == st[9] && meta.ino == st[10], "identity")
    assert(meta.size_on_disk == st[1], "size")
    assert_saved_bytes(path, "brand new\n")
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    remove_tree(root)
}

fn t_save_atomic_bytes_replaces_file_and_cleans_temp() {
    let root = fixture()
    let path = "{root}/tree.yewu"
    save_write(path, bytes_of("old"), 384)
    let before = stat_words(path)
    var replacement = List[byte]()
    for x in [0, 1, 2, 255, 10] {
        (mut replacement).push(x as byte)
    }
    assert(text.file_write_atomic(path, replacement, 384) == text.SAVE_OK, "atomic write")
    let after = stat_words(path)
    assert(before[10] != after[10], "a new inode")
    assert(after[4] & 4095 == 384, "mode 0600")
    let got = fs_read_bytes(path) else {
        assert(false, "read back")
        return
    }
    assert(same(got, replacement), "the bytes")
    let names = fs_read_dir(root) else {
        assert(false, "readdir")
        return
    }
    for n in names {
        assert(!n.starts_with(".yew-tree.yewu-"), "no temporary left")
    }
    remove_tree(root)
}

// `save_fault_shim_contract`, `test_save_paths.c:137-163`: sagitta's
// driver over the port's child, `YEW_TORTURE_SIGKILL_ITERS=0`.
fn t_save_fault_shim_contract() {
    let driver = "target/oracle/sagitta/build/kill9"
    let shim = "target/oracle/sagitta/build/tests/torture/faultshim.so"
    let child = "target/tools/yew-torture"
    if !fs_is_file(driver) || !fs_is_file(shim) || !fs_is_file(child) {
        print(
            "save_paths_test: SKIP save_fault_shim_contract: run tools/oracle and tools/build-torture first",
        )
        eprint(
            "save_paths_test: SKIP save_fault_shim_contract: run tools/oracle and tools/build-torture first",
        )
        return
    }
    let cwd = os_cwd() else ""
    env_set("YEW_TORTURE_SIGKILL_ITERS", "0") else {}
    var c = process.command("{cwd}/{driver}")
    process.push_arg(mut c, "{cwd}/{child}")
    process.push_arg(mut c, "{cwd}/{shim}")
    let ch = process.start(c) else {
        assert(false, "start the driver")
        return
    }
    let status = process.wait_status(take ch) else -1
    env_unset("YEW_TORTURE_SIGKILL_ITERS") else {}
    assert(status == 0, "sagitta's driver over the port's child exits 0 (status {status})")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_save_symlink_preserves_link_and_updates_target()
    t_save_symlink_into_read_only_directory_stays_in_place()
    t_save_dangling_symlink_preserves_link_and_creates_target()
    t_save_hardlink_preserves_shared_inode()
    t_save_backup_path_symlink_cannot_overwrite_victim()
    t_save_read_only_directory_uses_in_place_path()
    t_save_existing_file_preserves_mode_owner_and_group()
    t_save_new_file_creates_requested_content()
    t_save_atomic_bytes_replaces_file_and_cleans_temp()
    t_save_fault_shim_contract()
    print("save_paths_test: 10 cases pass")
}
