//! member: false
//! Ports all 27 sagitta 9ace98c2 tests/unit/test_fl_lex.c:81-774 cases.
//! Registry order retained; token payloads, spans and bare diagnostics are
//! asserted structurally. Additional prefix-float cases pin lex.c:335-349.

use fl

struct Fix { src: List[byte], lx: fl.FlLexer, dc: fl.DiagCtx, strings: fl.FlStrings }

fn fixture(src: List[byte]) -> Fix {
    var dc = fl.fl_diag_init()
    let id = fl.fl_diag_add_file(mut dc, "t.fl", src)
    var owned = List[byte]()
    for b in src { (mut owned).push(b) }
    Fix { src: owned, lx: fl.fl_lex_init(id), dc: dc, strings: fl.fl_strings() }
}

fn nx(mut f: Fix) -> fl.FlTok { fl.fl_lex_next(mut f.lx, f.src, mut f.dc, mut f.strings) }

fn expect_kind(mut f: Fix, kind: int) -> fl.FlTok {
    let tok = nx(mut f)
    if tok.kind != kind { eprint("want {kind} got {tok.kind} at {tok.sp}") }
    assert(tok.kind == kind)
    tok
}

fn sequence(src: str, kinds: List[int]) {
    var f = fixture(src.bytes())
    for k in kinds { let _ = expect_kind(mut f, k) }
    assert(f.dc.nerrors == 0)
}

fn string_is(f: Fix, id: int, want: str) {
    assert((str_from_utf8(f.strings.items[id]) else "INVALID") == want)
}

fn error_is(src: str, want: str) {
    var f = fixture(src.bytes())
    let _ = expect_kind(mut f, fl.FL_T_ERROR)
    assert(f.dc.entries.len > 0 && f.dc.entries[0].msg.contains(want))
}

// C:81
fn t_comment_keeps_its_newline() {
    sequence("let # trailing\nlet", [fl.FL_T_LET, fl.FL_T_NEWLINE, fl.FL_T_LET, fl.FL_T_EOF])
}

// C:98
fn t_crlf_is_one_newline_and_bare_cr_is_an_error() {
    sequence("a\r\nb", [fl.FL_T_IDENT, fl.FL_T_NEWLINE, fl.FL_T_IDENT, fl.FL_T_EOF])
    var f = fixture("a\rb".bytes())
    let _ = expect_kind(mut f, fl.FL_T_IDENT)
    let _ = expect_kind(mut f, fl.FL_T_ERROR)
    assert(f.dc.entries[0].msg.contains("carriage return"))
}

// C:123
fn t_keywords_need_a_terminator() {
    let words = [
        "and",
        "as",
        "break",
        "catch",
        "continue",
        "edit",
        "else",
        "false",
        "fn",
        "for",
        "if",
        "import",
        "in",
        "let",
        "macro",
        "nil",
        "not",
        "or",
        "return",
        "true",
        "try",
        "while",
    ]
    assert(words.len == fl.FL_KEYWORD_COUNT)
    var i = 0
    for word in words {
        sequence(word, [fl.FL_T_KW_FIRST + i, fl.FL_T_EOF])
        assert(fl.fl_kw_reserved(word.bytes()))
        i += 1
    }
    sequence(
        "letx let_ notx _let",
        [fl.FL_T_IDENT, fl.FL_T_IDENT, fl.FL_T_IDENT, fl.FL_T_IDENT, fl.FL_T_EOF],
    )
}

// C:172
fn t_integers_decimal_hex_and_separators() {
    var f = fixture("0 42 1_000_000 0xFF 0xFF_FF 0X10".bytes())
    for n in [0, 42, 1000000, 255, 65535, 16] { assert(expect_kind(mut f, fl.FL_T_INT).i == n) }
    let _ = expect_kind(mut f, fl.FL_T_EOF)
    assert(f.dc.nerrors == 0)
}

// C:192
fn t_underscore_must_separate_digits() {
    for s in ["1_", "0x_", "1__0"] { error_is(s, "separate digits") }
    sequence("_1", [fl.FL_T_IDENT])
}

// C:215
fn t_int_overflow_is_an_error_not_a_wrap() {
    error_is("9223372036854775808", "i64")
    var f = fixture("9223372036854775807".bytes())
    assert(expect_kind(mut f, fl.FL_T_INT).i == 9223372036854775807 && f.dc.nerrors == 0)
}

// C:235
fn t_hex_needs_a_digit() { error_is("0x", "hexadecimal") }

// C:245
fn t_floats_and_the_dot_rule() {
    var f = fixture("1.5 2.0e3 7.5E-2 1.0e+1".bytes())
    let a = expect_kind(mut f, fl.FL_T_FLOAT).f
    let b = expect_kind(mut f, fl.FL_T_FLOAT).f
    let c = expect_kind(mut f, fl.FL_T_FLOAT).f
    let d = expect_kind(mut f, fl.FL_T_FLOAT).f
    assert(a > 1.49 && a < 1.51 && b > 1999.0 && b < 2001.0)
    assert(c > 0.074 && c < 0.076 && d > 9.9 && d < 10.1)
    let _ = expect_kind(mut f, fl.FL_T_EOF)
    assert(f.dc.nerrors == 0)
    var dot = fixture("1.foo".bytes())
    assert(expect_kind(mut dot, fl.FL_T_INT).i == 1)
    let _ = expect_kind(mut dot, fl.FL_T_DOT)
    let _ = expect_kind(mut dot, fl.FL_T_IDENT)
    assert(dot.dc.nerrors == 0)
    sequence("1.", [fl.FL_T_INT, fl.FL_T_DOT])
    sequence(".5", [fl.FL_T_DOT, fl.FL_T_INT])
    // Raw-token strtod prefixes, not underscore-stripped values.
    var prefix = fixture("1_2.3 1.2_3".bytes())
    assert(expect_kind(mut prefix, fl.FL_T_FLOAT).f == 1.0)
    assert(expect_kind(mut prefix, fl.FL_T_FLOAT).f == 1.2)
}

// C:287
fn t_string_escapes() {
    var f = fixture("\"a\\nb\\tc\\rd\\\\e\\\"f\"".bytes())
    let id = expect_kind(mut f, fl.FL_T_STRING).i
    string_is(f, id, "a\nb\tc\rd\\e\"f")
    assert(f.dc.nerrors == 0)
    var x = fixture("\"\\x41\\x7A\"".bytes())
    let xid = expect_kind(mut x, fl.FL_T_STRING).i
    string_is(x, xid, "Az")
    var u = fixture("\"\\u{{48}}\\u{{1F600}}\"".bytes())
    let uid = expect_kind(mut u, fl.FL_T_STRING).i
    string_is(u, uid, "H😀")
    assert(u.dc.nerrors == 0)
    var binary = fixture("\"\\xFF\\0z\"".bytes())
    let bid = expect_kind(mut binary, fl.FL_T_STRING).i
    assert(binary.strings.items[bid].len == 3)
    assert(binary.strings.items[bid][0] == 255 as byte && binary.strings.items[bid][1] == 0 as byte)
}

// C:308
fn t_unknown_escape_points_at_the_escape() {
    var f = fixture("\"aaaa\\dbbbb\"".bytes())
    let t = expect_kind(mut f, fl.FL_T_ERROR)
    assert(f.dc.entries[0].msg.contains("unknown escape"))
    assert(t.sp.line == 1 && t.sp.col == 6)
}

// C:319
fn t_string_error_cases() {
    error_is("\"no end", "unterminated")
    error_is("\"a\nb\"", "newline in string")
    error_is("\"\\x4\"", "two hexadecimal")
    error_is("\"\\u{{}}\"", "hexadecimal digits")
    error_is("\"\\u{{110000}}\"", "scalar value")
    error_is("\"\\u{{D800}}\"", "scalar value")
}

// C:364
fn t_operators_and_delimiters() {
    let ops = [
        "+",
        "-",
        "*",
        "/",
        "%",
        "=",
        "==",
        "!=",
        "<",
        "<=",
        ">",
        ">=",
        "(",
        ")",
        "[",
        "]",
        "{{",
        "}}",
        ",",
        ":",
        ";",
        ".",
    ]
    let kinds = [
        fl.FL_T_PLUS,
        fl.FL_T_MINUS,
        fl.FL_T_STAR,
        fl.FL_T_SLASH,
        fl.FL_T_PERCENT,
        fl.FL_T_EQ,
        fl.FL_T_EQEQ,
        fl.FL_T_BANGEQ,
        fl.FL_T_LT,
        fl.FL_T_LE,
        fl.FL_T_GT,
        fl.FL_T_GE,
        fl.FL_T_LPAREN,
        fl.FL_T_RPAREN,
        fl.FL_T_LBRACKET,
        fl.FL_T_RBRACKET,
        fl.FL_T_LBRACE,
        fl.FL_T_RBRACE,
        fl.FL_T_COMMA,
        fl.FL_T_COLON,
        fl.FL_T_SEMI,
        fl.FL_T_DOT,
    ]
    var i = 0
    while i < ops.len { sequence(ops[i], [kinds[i], fl.FL_T_EOF]); i += 1 }
}

// C:393
fn t_at_without_bracket_names_the_pair() { error_is("@x", "@["); error_is("!x", "not") }

// C:413
fn t_motion_units_arrows_and_counts() {
    var f = fixture("@[l w b c]".bytes())
    let _ = expect_kind(mut f, fl.FL_T_ATBRACKET)
    for ch in [108, 119, 98, 99] { assert(expect_kind(mut f, fl.FL_M_UNIT).i == ch) }
    let _ = expect_kind(mut f, fl.FL_M_END)
    let _ = expect_kind(mut f, fl.FL_T_EOF)
    assert(f.dc.nerrors == 0)
    var arrows = fixture("@[< > ^ v]".bytes())
    let _ = expect_kind(mut arrows, fl.FL_T_ATBRACKET)
    for ch in [60, 62, 94, 118] {
        let t = expect_kind(mut arrows, fl.FL_M_ARROW)
        assert(t.i == ch && !t.alt)
    }
    let _ = expect_kind(mut arrows, fl.FL_M_END)
    var counts = fixture("@[4> 12 <]".bytes())
    let _ = expect_kind(mut counts, fl.FL_T_ATBRACKET)
    assert(expect_kind(mut counts, fl.FL_M_COUNT).i == 4)
    let _ = expect_kind(mut counts, fl.FL_M_ARROW)
    assert(expect_kind(mut counts, fl.FL_M_COUNT).i == 12)
    let _ = expect_kind(mut counts, fl.FL_M_ARROW)
    let _ = expect_kind(mut counts, fl.FL_M_END)
    assert(counts.dc.nerrors == 0)
}

// C:455
fn t_motion_alt_prefix_is_longest_match() {
    var f = fixture("@[av a> a< a^]".bytes())
    let _ = expect_kind(mut f, fl.FL_T_ATBRACKET)
    for ch in [118, 62, 60, 94] {
        let t = expect_kind(mut f, fl.FL_M_ARROW)
        assert(t.i == ch && t.alt)
    }
    let _ = expect_kind(mut f, fl.FL_M_END)
    assert(f.dc.nerrors == 0)
    var g = fixture("@[avx list yank]".bytes())
    let _ = expect_kind(mut g, fl.FL_T_ATBRACKET)
    for text in ["avx", "list", "yank"] {
        let t = expect_kind(mut g, fl.FL_M_WORD)
        string_is(g, t.i, text)
    }
    let _ = expect_kind(mut g, fl.FL_M_END)
    assert(g.dc.nerrors == 0)
}

// C:490
fn t_motion_unicode_arrow_aliases() {
    var f = fixture("@[→ ← ↑ ↓]".bytes())
    let _ = expect_kind(mut f, fl.FL_T_ATBRACKET)
    for ch in [62, 60, 94, 118] { assert(expect_kind(mut f, fl.FL_M_ARROW).i == ch) }
    let _ = expect_kind(mut f, fl.FL_M_END)
    assert(f.dc.nerrors == 0)
    var alt = fixture("@[a↓]".bytes())
    let _ = expect_kind(mut alt, fl.FL_T_ATBRACKET)
    let t = expect_kind(mut alt, fl.FL_M_ARROW)
    assert(t.i == 118 && t.alt)
    let _ = expect_kind(mut alt, fl.FL_M_END)
}

// C:515
fn t_motion_h_nests_without_leaving_the_mode() {
    var f = fixture("@[H(2>) del]".bytes())
    for k in [fl.FL_T_ATBRACKET, fl.FL_M_H, fl.FL_M_LPAREN] { let _ = expect_kind(mut f, k) }
    assert(expect_kind(mut f, fl.FL_M_COUNT).i == 2)
    for k in [fl.FL_M_ARROW, fl.FL_M_RPAREN, fl.FL_M_DEL, fl.FL_M_END, fl.FL_T_EOF] {
        let _ = expect_kind(mut f, k)
    }
    assert(f.dc.nerrors == 0)
}

// C:542
fn t_motion_insert_del_esc() {
    var f = fixture("@[i\"hi\\n\" del esc]".bytes())
    let _ = expect_kind(mut f, fl.FL_T_ATBRACKET)
    let t = expect_kind(mut f, fl.FL_M_INSERT)
    string_is(f, t.i, "hi\n")
    for k in [fl.FL_M_DEL, fl.FL_M_ESC, fl.FL_M_END] { let _ = expect_kind(mut f, k) }
    assert(f.dc.nerrors == 0)
}

// C:557
fn t_motion_words_are_ordinary_identifiers_outside() {
    sequence("del v l", [fl.FL_T_IDENT, fl.FL_T_IDENT, fl.FL_T_IDENT, fl.FL_T_EOF])
}

// C:574
fn t_motion_count_bounds() {
    var f = fixture("@[65535>]".bytes())
    let _ = expect_kind(mut f, fl.FL_T_ATBRACKET)
    assert(expect_kind(mut f, fl.FL_M_COUNT).i == 65535)
    for text in ["@[65536>]", "@[0>]"] {
        var g = fixture(text.bytes())
        let _ = expect_kind(mut g, fl.FL_T_ATBRACKET)
        let _ = expect_kind(mut g, fl.FL_T_ERROR)
        assert(g.dc.entries[0].msg.contains(if text == "@[0>]" then "zero" else "65535"))
    }
}

// C:599
fn t_motion_block_may_span_lines() {
    sequence(
        "@[2>\n  del\n]",
        [fl.FL_T_ATBRACKET, fl.FL_M_COUNT, fl.FL_M_ARROW, fl.FL_M_DEL, fl.FL_M_END, fl.FL_T_EOF],
    )
}

// C:617
fn t_unterminated_motion_block_is_eof_not_an_error() {
    sequence("@[2>", [fl.FL_T_ATBRACKET, fl.FL_M_COUNT, fl.FL_M_ARROW, fl.FL_T_EOF, fl.FL_T_EOF])
    sequence("@[", [fl.FL_T_ATBRACKET, fl.FL_T_EOF])
}

// C:651
fn t_invalid_utf8_reports_once() {
    var bytes = List[byte]()
    for n in [255, 254, 253, 252, 32, 97] { (mut bytes).push(n as byte) }
    var f = fixture(bytes)
    let _ = expect_kind(mut f, fl.FL_T_ERROR)
    assert(f.dc.entries[0].msg.contains("invalid UTF-8"))
    while nx(mut f).kind != fl.FL_T_EOF {}
    assert(f.dc.nerrors == 1)
}

// C:672
fn t_caret_block_renders_the_source_line() {
    var f = fixture("let a = 1\nlet b = @x\n".bytes())
    var t = nx(mut f)
    while t.kind != fl.FL_T_ERROR { assert(t.kind != fl.FL_T_EOF); t = nx(mut f) }
    var out = List[byte]()
    fl.fl_diag_render(mut out, f.dc, fl.FL_DIAG_ERROR, t.sp, "boom")
    let text = str_from_utf8(out) else ""
    assert(
        text.contains("t.fl:2:9: error: boom\n") &&
            text.contains("let b = @x\n") &&
            text.contains("\n        ^"),
    )
}

// C:679 (registered path ownership)
fn t_diag_registered_paths_are_arena_owned() {
    var dc = fl.fl_diag_init()
    var path = "temporary.fl"
    let id = fl.fl_diag_add_file(mut dc, path, "bad".bytes())
    path = "Xemporary.fl"
    assert(dc.files[id].path == "temporary.fl" && path != dc.files[id].path)
}

// C:693
fn t_keep_comments_is_opt_in() {
    var f = fixture("# SPEC: 1\nlet s = \"# CHECK: nope\"\n".bytes())
    f.lx.keep_comments = true
    let t = expect_kind(mut f, fl.FL_T_COMMENT)
    assert(t.sp.len == "# SPEC: 1".len && t.sp.line == 1 && t.sp.col == 1)
    for k in [
        fl.FL_T_NEWLINE,
        fl.FL_T_LET,
        fl.FL_T_IDENT,
        fl.FL_T_EQ,
        fl.FL_T_STRING,
        fl.FL_T_NEWLINE,
        fl.FL_T_EOF,
    ] { let _ = expect_kind(mut f, k) }
    assert(f.dc.nerrors == 0)
    sequence("# SPEC: 1\nlet s = 1\n", [fl.FL_T_NEWLINE, fl.FL_T_LET])
    var g = fixture("macro m = @[ # OUT: x\n 2> ]\n".bytes())
    g.lx.keep_comments = true
    for k in [
        fl.FL_T_MACRO,
        fl.FL_T_IDENT,
        fl.FL_T_EQ,
        fl.FL_T_ATBRACKET,
        fl.FL_T_COMMENT,
        fl.FL_M_COUNT,
    ] { let _ = expect_kind(mut g, k) }
}

// C:751
fn t_spellings_cover_every_kind() {
    for k in 0..fl.FL_T_KIND__N {
        if k != fl.FL_T_ERROR { assert(fl.fl_tok_spelling(k) != "invalid token") }
    }
}

fn main() {
    let args = env_args()
    let chosen = if args.len > 0 then (args[0].to_int() else -1) else -1
    if chosen < 0 || chosen == 0 {
        t_comment_keeps_its_newline()
        print("PASS comment_keeps_its_newline")
    }
    if chosen < 0 || chosen == 1 {
        t_crlf_is_one_newline_and_bare_cr_is_an_error()
        print("PASS crlf_is_one_newline_and_bare_cr_is_an_error")
    }
    if chosen < 0 || chosen == 2 {
        t_keywords_need_a_terminator()
        print("PASS keywords_need_a_terminator")
    }
    if chosen < 0 || chosen == 3 {
        t_integers_decimal_hex_and_separators()
        print("PASS integers_decimal_hex_and_separators")
    }
    if chosen < 0 || chosen == 4 {
        t_underscore_must_separate_digits()
        print("PASS underscore_must_separate_digits")
    }
    if chosen < 0 || chosen == 5 {
        t_int_overflow_is_an_error_not_a_wrap()
        print("PASS int_overflow_is_an_error_not_a_wrap")
    }
    if chosen < 0 || chosen == 6 { t_hex_needs_a_digit(); print("PASS hex_needs_a_digit") }
    if chosen < 0 || chosen == 7 {
        t_floats_and_the_dot_rule()
        print("PASS floats_and_the_dot_rule")
    }
    if chosen < 0 || chosen == 8 { t_string_escapes(); print("PASS string_escapes") }
    if chosen < 0 || chosen == 9 {
        t_unknown_escape_points_at_the_escape()
        print("PASS unknown_escape_points_at_the_escape")
    }
    if chosen < 0 || chosen == 10 { t_string_error_cases(); print("PASS string_error_cases") }
    if chosen < 0 || chosen == 11 {
        t_operators_and_delimiters()
        print("PASS operators_and_delimiters")
    }
    if chosen < 0 || chosen == 12 {
        t_at_without_bracket_names_the_pair()
        print("PASS at_without_bracket_names_the_pair")
    }
    if chosen < 0 || chosen == 13 {
        t_motion_units_arrows_and_counts()
        print("PASS motion_units_arrows_and_counts")
    }
    if chosen < 0 || chosen == 14 {
        t_motion_alt_prefix_is_longest_match()
        print("PASS motion_alt_prefix_is_longest_match")
    }
    if chosen < 0 || chosen == 15 {
        t_motion_unicode_arrow_aliases()
        print("PASS motion_unicode_arrow_aliases")
    }
    if chosen < 0 || chosen == 16 {
        t_motion_h_nests_without_leaving_the_mode()
        print("PASS motion_h_nests_without_leaving_the_mode")
    }
    if chosen < 0 || chosen == 17 { t_motion_insert_del_esc(); print("PASS motion_insert_del_esc") }
    if chosen < 0 || chosen == 18 {
        t_motion_words_are_ordinary_identifiers_outside()
        print("PASS motion_words_are_ordinary_identifiers_outside")
    }
    if chosen < 0 || chosen == 19 { t_motion_count_bounds(); print("PASS motion_count_bounds") }
    if chosen < 0 || chosen == 20 {
        t_motion_block_may_span_lines()
        print("PASS motion_block_may_span_lines")
    }
    if chosen < 0 || chosen == 21 {
        t_unterminated_motion_block_is_eof_not_an_error()
        print("PASS unterminated_motion_block_is_eof_not_an_error")
    }
    if chosen < 0 || chosen == 22 {
        t_invalid_utf8_reports_once()
        print("PASS invalid_utf8_reports_once")
    }
    if chosen < 0 || chosen == 23 {
        t_caret_block_renders_the_source_line()
        print("PASS caret_block_renders_the_source_line")
    }
    if chosen < 0 || chosen == 24 {
        t_diag_registered_paths_are_arena_owned()
        print("PASS diag_registered_paths_are_arena_owned")
    }
    if chosen < 0 || chosen == 25 {
        t_keep_comments_is_opt_in()
        print("PASS keep_comments_is_opt_in")
    }
    if chosen < 0 || chosen == 26 {
        t_spellings_cover_every_kind()
        print("PASS spellings_cover_every_kind")
    }
    print("fl_lex: 27 cases ok")
}
