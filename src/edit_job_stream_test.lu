//! member: false
//!
//! The port of sagitta `tests/unit/test_job_stream.c` (220 lines), one test
//! per C test in registry order: `edit.job_safe_prefix` (§3) must be
//! chunking-independent — a stream split at EVERY byte offset appends
//! exactly the bytes it appends whole. Pure: nothing runs.

use edit
use unicode

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn raw(xs: List[int]) -> List[byte] {
    var v = List[byte]()
    for x in xs {
        (mut v).push(x as byte)
    }
    v
}

fn cat(a: List[byte], b: List[byte]) -> List[byte] {
    var v = copy a
    for x in b {
        (mut v).push(x)
    }
    v
}

fn fixtures() -> List[List[byte]] {
    var f = List[List[byte]]()
    for s in ["", "a", "hello world\n", "line one\nline two\n", "\n\n\n"] {
        (mut f).push(bytes_of(s))
    }
    (mut f).push(cat(bytes_of("caf"), raw([195, 169])))
    (mut f).push(raw([230, 151, 165, 230, 156, 172, 232, 170, 158]))
    (mut f).push(raw([240, 159, 152, 128]))
    (mut f).push(
        raw(
            [
                240,
                159,
                145,
                168,
                226,
                128,
                141,
                240,
                159,
                145,
                169,
                226,
                128,
                141,
                240,
                159,
                145,
                167,
                226,
                128,
                141,
                240,
                159,
                145,
                166,
            ],
        ),
    )
    (mut f).push(raw([240, 159, 135, 186, 240, 159, 135, 184]))
    (mut f).push(raw([101, 204, 129]))
    (mut f).push(raw([97, 204, 128, 204, 129, 204, 130, 204, 131]))
    (mut f).push(raw([234, 176, 129]))
    (mut f).push(raw([225, 132, 128, 225, 133, 161, 225, 134, 168]))
    (mut f).push(bytes_of("crlf\r\n"))
    (mut f).push(bytes_of("tab\there\n"))
    (mut f).push(raw([255]))
    (mut f).push(cat(cat(bytes_of("ok"), raw([255])), bytes_of("bad\n")))
    (mut f).push(raw([195]))
    (mut f).push(raw([230, 151]))
    (mut f).push(raw([240, 159, 152]))
    (mut f).push(
        cat(
            cat(
                cat(
                    cat(cat(bytes_of("mix "), raw([240, 159, 152, 128])), bytes_of(" ")),
                    raw([230, 151, 165]),
                ),
                bytes_of(" e"),
            ),
            cat(raw([204, 129]), bytes_of(" done\n")),
        ),
    )
    (mut f).push(raw([240, 159, 145, 141, 240, 159, 143, 189]))
    (mut f).push(bytes_of("trailing space \n"))
    f
}

fn slice(b: List[byte], at: int, end: int) -> List[byte] {
    var v = List[byte]()
    var i = at
    while i < end {
        (mut v).push(b[i])
        i += 1
    }
    v
}

/// `feed_chunked` (`test_job_stream.c:45-91`): job_drain's hold-buffer
/// discipline.
fn feed_chunked(src: List[byte], chunk: int) -> List[byte] {
    var out = List[byte]()
    var hold = List[byte]()
    var at = 0
    while at < src.len {
        let n_take = if src.len - at < chunk then src.len - at else chunk
        var view = List[byte]()
        if hold.len != 0 {
            view = copy hold
            for x in slice(src, at, at + n_take) {
                (mut view).push(x)
            }
        } else {
            view = slice(src, at, at + n_take)
        }
        at += n_take
        let safe = edit.job_safe_prefix(view, view.len, false)
        assert(safe <= view.len, "safe within the view")
        for x in slice(view, 0, safe) {
            (mut out).push(x)
        }
        if safe < view.len {
            assert(view.len - safe <= edit.JOB_HOLD_MAX + 32, "a bounded hold")
            hold = slice(view, safe, view.len)
        } else {
            hold = List[byte]()
        }
    }
    if hold.len != 0 {
        assert(edit.job_safe_prefix(hold, hold.len, true) == hold.len, "EOF flushes everything")
        for x in hold {
            (mut out).push(x)
        }
    }
    out
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn t_job_stream_split_at_every_offset() {
    let fx = fixtures()
    var f = 0
    while f < fx.len {
        var chunk = 1
        while chunk <= fx[f].len + 1 {
            assert(same(feed_chunked(fx[f], chunk), fx[f]), "fixture {f} chunk {chunk}")
            chunk += 1
        }
        f += 1
    }
}

fn t_job_stream_holds_incomplete_utf8() {
    assert(edit.job_safe_prefix(raw([240, 159, 152]), 3, false) == 0, "a partial emoji is held")
    assert(edit.job_safe_prefix(raw([97, 195]), 2, false) == 0, "a + lead: both held")
    assert(edit.job_safe_prefix(raw([120, 230, 151]), 3, false) == 0, "x + partial: both held")
    assert(
        edit.job_safe_prefix(raw([97, 98, 99, 240]), 4, false) == 2,
        "before the last cluster flows",
    )
}

fn fill_ri_run(count: int) -> List[byte] {
    var out = List[byte]()
    var i = 0
    while i < count {
        let e = unicode.utf8_encode(127462 + i % 26)
        assert(e.len == 4, "four bytes")
        for x in e {
            (mut out).push(x)
        }
        i += 1
    }
    out
}

fn t_job_stream_long_ri_run_holds_only_open_cluster() {
    let odd = fill_ri_run(65)
    let even = fill_ri_run(66)
    assert(edit.job_safe_prefix(odd, odd.len, false) == 64 * 4, "an odd run leaves one open RI")
    assert(
        edit.job_safe_prefix(even, even.len, false) == 64 * 4,
        "an even run keeps its final pair",
    )
}

fn t_job_stream_newline_holds_nothing() {
    let line = bytes_of("some output\n")
    assert(edit.job_safe_prefix(line, line.len, false) == line.len, "a newline holds nothing")
}

fn t_job_stream_eof_flushes_invalid_tail() {
    let bad = raw([111, 107, 255, 195])
    assert(edit.job_safe_prefix(bad, 4, false) < 4, "the dangling lead is held")
    assert(edit.job_safe_prefix(bad, 4, true) == 4, "EOF: everything")
}

fn t_job_stream_hold_cap_flushes() {
    var marks = List[byte]()
    var i = 0
    while i + 1 < edit.JOB_HOLD_MAX * 2 {
        (mut marks).push(204 as byte)
        (mut marks).push(128 as byte)
        i += 2
    }
    assert(edit.job_safe_prefix(marks, marks.len, false) == marks.len, "past the cap: flushed")
}

// C's NULL pointer row has no port (a `List` is never NULL); the empty
// rows run.
fn t_job_stream_empty_and_null() {
    let any = bytes_of("a")
    assert(edit.job_safe_prefix(any, 0, false) == 0, "empty")
    assert(edit.job_safe_prefix(any, 0, true) == 0, "empty at EOF")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_job_stream_split_at_every_offset()
    t_job_stream_holds_incomplete_utf8()
    t_job_stream_long_ri_run_holds_only_open_cluster()
    t_job_stream_newline_holds_nothing()
    t_job_stream_eof_flushes_invalid_tail()
    t_job_stream_hold_cap_flushes()
    t_job_stream_empty_and_null()
    print("job_stream_test: 7 cases pass")
}
