//! member: false
//! Ports sagitta tests/unit/test_syn_detect.c at 9ace98c2, one case per C
//! test in its order. C's fixtures compile definitions that register
//! themselves in a process-wide table; here each case owns a registry and
//! a pool and registers what it compiles (`syn_registry_register`), so no
//! case can see another's definitions and no dispose step is needed.

use syn

struct Fix {
    reg: syn.SynRegistry,
    pool: syn.SynPool,
}

fn bytes(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() { (mut out).push(b) }
    out
}

fn fix() -> Fix {
    let reg = syn.syn_registry_new()
    var pool = syn.syn_pool_new()
    syn.syn_registry_seed(reg, mut pool)
    Fix { reg: reg, pool: pool }
}

// `detect_id`: the language a name resolves to, or 0.
fn detect_id(f: Fix, name: str) -> int {
    syn.syn_registry_lang_named(f.reg, bytes(name))
}

// `detect_add`: compile a detector-only definition and register it.
fn add(
    mut f: Fix,
    name: str,
    extensions: str,
    filenames: str,
    shebangs: str,
    first_line: str,
    priority: int,
) -> int {
    let first = if first_line.len == 0 then "" else "first_line: {first_line},"
    let src = "{{ syntax: 1, language: {{ name: \"{name}\", extensions: {extensions}, filenames: {filenames}, shebangs: {shebangs}, {first} priority: {priority} }}, contexts: {{ main: {{ rules: [] }} }} }}"
    var c = syn.syn_compile(name, bytes(src))
    assert(c.valid, "detector definition compiles")
    assert(c.diagnostics.nerrors == 0 && c.diagnostics.nwarnings == 0, "detector definition is clean")
    let id = syn.syn_registry_register(mut f.reg, mut f.pool, take c.definition, name)
    assert(id != 0 && detect_id(f, name) == id, "a registered definition resolves by name")
    id
}

fn lang_for(mut f: Fix, path: str) -> int {
    syn.syn_registry_lang_for(mut f.reg, path, List[byte](), false)
}

fn lang_for_line(mut f: Fix, path: str, line: str) -> int {
    syn.syn_registry_lang_for(mut f.reg, path, bytes(line), true)
}

fn csv(items: List[List[byte]]) -> str {
    var out = List[byte]()
    for i in 0..items.len {
        if i != 0 { (mut out).push(44 as byte) }
        for b in items[i] { (mut out).push(b) }
    }
    str_from_utf8(out) else ""
}

// test_syn_detect_builtin_ini_exact_glob_extension_and_path_basename
fn builtin_ini_exact_glob_extension_and_path_basename() {
    var f = fix()
    let ini = detect_id(f, "ini")
    assert(ini != 0, "ini is builtin")
    assert(lang_for(mut f, ".editorconfig") == ini, "exact filename")
    assert(lang_for(mut f, "/tmp/project/.editorconfig") == ini, "exact filename by basename")
    assert(lang_for(mut f, "x.desktop") == ini, "glob")
    assert(lang_for(mut f, "/usr/share/x.service") == ini, "glob by basename")
    assert(lang_for(mut f, "settings.INI") == ini, "extension folds case")
    assert(lang_for(mut f, "settings.properties") == ini, "second extension")
}

// test_syn_detect_exact_filename_precedes_glob_and_extension
fn exact_filename_precedes_glob_and_extension() {
    var f = fix()
    let exact = add(mut f, "order-exact", "[]", "[\"Targetfile\"]", "[]", "", -50)
    let glob = add(mut f, "order-glob", "[]", "[\"*file\"]", "[]", "", 50)
    let ext = add(mut f, "order-ext", "[\"ord\"]", "[]", "[]", "", 100)
    assert(lang_for(mut f, "/tmp/Targetfile") == exact, "exact first")
    assert(lang_for(mut f, "/tmp/Otherfile") == glob, "glob second")
    assert(lang_for(mut f, "Targetfile.ord") == ext, "extension last")
    assert(exact != glob && glob != ext, "three languages")
}

// test_syn_detect_longest_compound_extension_precedes_priority
fn longest_compound_extension_precedes_priority() {
    var f = fix()
    let compound = add(mut f, "compound", "[\"tar.gz\"]", "[]", "[]", "", -100)
    let short_ext = add(mut f, "short", "[\"gz\"]", "[]", "[]", "", 100)
    assert(compound != short_ext, "two languages")
    assert(lang_for(mut f, "archive.tar.gz") == compound, "longest extension wins")
    assert(lang_for(mut f, "archive.GZ") == short_ext, "short extension folds case")
}

// test_syn_detect_priority_breaks_same_stage_ties
fn priority_breaks_same_stage_ties() {
    var f = fix()
    let low = add(mut f, "tie-low", "[\"prio\"]", "[]", "[]", "", -2)
    let high = add(mut f, "tie-high", "[\"prio\"]", "[]", "[]", "", 9)
    assert(high != low, "two languages")
    assert(lang_for(mut f, "x.prio") == high, "higher priority wins")
}

// test_syn_detect_lexicographic_name_breaks_equal_priority_ties
fn lexicographic_name_breaks_equal_priority_ties() {
    var f = fix()
    let zeta = add(mut f, "zeta-tie", "[\"lexi\"]", "[]", "[]", "", 4)
    let alpha = add(mut f, "alpha-tie", "[\"lexi\"]", "[]", "[]", "", 4)
    assert(alpha != zeta, "two languages")
    assert(lang_for(mut f, "x.lexi") == alpha, "lexicographic name breaks the tie")
}

// test_syn_detect_env_and_direct_shebang_interpreters
fn env_and_direct_shebang_interpreters() {
    var f = fix()
    let py = add(mut f, "python-probe", "[]", "[]", "[\"python3\"]", "", 100)
    let sh = add(mut f, "shell-probe", "[]", "[]", "[\"probe-sh\"]", "", 100)
    assert(lang_for_line(mut f, "script", "#!/usr/bin/env python3") == py, "env interpreter")
    assert(lang_for_line(mut f, "script", "#!/usr/bin/env -S python3 -u") == py, "env flags skipped")
    assert(lang_for_line(mut f, "script", "#!/bin/probe-sh -e") == sh, "direct interpreter")
}

// test_syn_detect_shebang_precedes_first_line_regex
fn shebang_precedes_first_line_regex() {
    var f = fix()
    let shebang = add(mut f, "stage-shebang", "[]", "[]", "[\"stagecmd\"]", "", -100)
    let regex = add(mut f, "stage-regex", "[]", "[]", "[]", "\"^#!\"", 100)
    assert(shebang != regex, "two languages")
    assert(lang_for_line(mut f, "script", "#!/usr/bin/env stagecmd") == shebang, "shebang first")
}

// test_syn_detect_first_line_regex_is_last_positive_stage
fn first_line_regex_is_last_positive_stage() {
    var f = fix()
    let regex = add(mut f, "line-probe", "[]", "[]", "[]", "\"^MODE:\\\\s\"", 0)
    assert(lang_for_line(mut f, "untitled", "MODE: detector") == regex, "first-line regex")
}

// test_syn_detect_unknown_path_and_empty_input_return_none
fn unknown_path_and_empty_input_return_none() {
    var f = fix()
    assert(lang_for_line(mut f, "file.xyz", "ordinary text") == 0, "unknown path and text")
    assert(lang_for(mut f, "") == 0, "no path and no line")
    let none = syn.syn_registry_desc(f.reg, 0) else {
        return
    }
    assert(none.id < 0, "YEW_LANG_NONE has no descriptor")
}

fn pack_row(name: str, extensions: str, filenames: str, shebangs: str) -> List[str] {
    var row = List[str]()
    (mut row).push(name)
    (mut row).push(extensions)
    (mut row).push(filenames)
    (mut row).push(shebangs)
    row
}

fn upper(s: List[byte]) -> str {
    var out = List[byte]()
    for b in s {
        let c = b as int
        (mut out).push((if c >= 97 && c <= 122 then c - 32 else c) as byte)
    }
    str_from_utf8(out) else ""
}

fn text(s: List[byte]) -> str {
    str_from_utf8(copy s) else ""
}

// `detector_expand_glob`: the one star replaced by "probe".
fn expand_glob(glob: List[byte]) -> str {
    var out = List[byte]()
    for b in glob {
        if b as int == 42 {
            for p in "probe".bytes() { (mut out).push(p) }
        } else {
            (mut out).push(b)
        }
    }
    str_from_utf8(out) else ""
}

fn has_star(s: List[byte]) -> bool {
    for b in s {
        if b as int == 42 then return true
    }
    false
}

// test_syn_detect_new_pack_exact_metadata_and_near_misses
fn new_pack_exact_metadata_and_near_misses() {
    var expected = List[List[str]]()
    (mut expected).push(pack_row("cpp", "cc,cp,cpp,cxx,c++,hh,hpp,hxx,h++,inl,ipp,tpp", "", ""))
    (mut expected).push(pack_row("objective-c", "m,mm", "", ""))
    (mut expected).push(pack_row("java", "java", "", ""))
    (mut expected).push(pack_row("kotlin", "kt,kts", "", ""))
    (mut expected).push(pack_row("csharp", "cs,csx", "", ""))
    (mut expected).push(pack_row("swift", "swift", "", ""))
    (mut expected).push(pack_row("zig", "zig", "", ""))
    (mut expected).push(pack_row("lua", "lua", "", "lua,lua5.1,lua5.2,lua5.3,lua5.4,luajit"))
    (mut expected).push(pack_row(
        "ruby",
        "rb,rake,gemspec",
        "Rakefile,Gemfile,Guardfile,Vagrantfile,Berksfile,Capfile,Podfile",
        "ruby,jruby",
    ))
    (mut expected).push(pack_row("perl", "pl,pm,t", "", "perl"))
    (mut expected).push(pack_row("r", "r", ".Rprofile", ""))
    (mut expected).push(pack_row("julia", "jl", "", ""))
    (mut expected).push(pack_row("dart", "dart", "", ""))
    (mut expected).push(pack_row("powershell", "ps1,psm1,psd1", "", "pwsh,powershell"))
    (mut expected).push(pack_row("zsh", "zsh", ".zshenv,.zprofile,.zshrc,.zlogin,.zlogout", "zsh"))
    (mut expected).push(pack_row("fish", "fish", "", "fish"))
    (mut expected).push(pack_row("sql", "sql", "", ""))
    (mut expected).push(pack_row("nix", "nix", "", ""))
    (mut expected).push(pack_row("haskell", "hs,lhs", "", ""))
    (mut expected).push(pack_row("ocaml", "ml,mli,mll,mly", "", ""))
    (mut expected).push(pack_row("xml", "xml,xsd,xsl,xslt,svg", "", ""))
    (mut expected).push(pack_row("graphql", "graphql,gql", "", ""))
    (mut expected).push(pack_row("protobuf", "proto", "", ""))
    (mut expected).push(pack_row("hcl", "hcl,tf,tfvars", "", ""))
    (mut expected).push(pack_row(
        "dockerfile",
        "",
        "Dockerfile,Containerfile,Dockerfile.*,*.Dockerfile,Containerfile.*,*.Containerfile",
        "",
    ))
    (mut expected).push(pack_row("cmake", "cmake", "CMakeLists.txt", ""))
    (mut expected).push(pack_row("meson", "", "meson.build,meson_options.txt", ""))
    (mut expected).push(pack_row("diff", "diff,patch", "", ""))
    var f = fix()
    for i in 0..expected.len {
        let id = detect_id(f, expected[i][0])
        assert(id != 0, "pack language {expected[i][0]} is builtin")
        let lang = syn.syn_registry_desc(f.reg, id) else {
            assert(false, "pack language has a descriptor")
            return
        }
        assert(csv(lang.extensions) == expected[i][1], "{expected[i][0]} extensions")
        assert(csv(lang.filenames) == expected[i][2], "{expected[i][0]} filenames")
        assert(csv(lang.shebangs) == expected[i][3], "{expected[i][0]} shebangs")
        for ext in lang.extensions {
            assert(lang_for(mut f, "probe.{text(ext)}") == id, "{expected[i][0]} extension detects")
            assert(lang_for(mut f, "probe.{upper(ext)}") == id, "{expected[i][0]} extension folds case")
        }
        for name in lang.filenames {
            let path = if has_star(name) then "/tmp/{expand_glob(name)}" else "/tmp/{text(name)}"
            assert(lang_for(mut f, path) == id, "{expected[i][0]} filename detects")
        }
        for interp in lang.shebangs {
            assert(lang_for_line(mut f, "script", "#!/usr/bin/env {text(interp)}") == id, "env shebang")
            assert(lang_for_line(mut f, "script", "#!/usr/bin/{text(interp)} -x") == id, "direct shebang")
        }
        assert(lang_for(mut f, "probe.yew-no-syntax-{i}") == 0, "near miss detects nothing")
    }
}

fn key(i: int) -> List[byte] {
    let digits = if i < 10 then "00{i}" else if i < 100 then "0{i}" else "{i}"
    bytes("key-{digits}")
}

// test_syn_detect_indexes_scale_without_definition_scans
fn indexes_scale_without_definition_scans() {
    for size in [0, 1, 19, 48, 257] {
        var entries = syn.syn_detect_entries()
        for i in 0..size { syn.syn_detect_add(mut entries, key(i), i + 1, 0) }
        if size == 0 {
            let probe = bytes("key-000")
            let (first, len) = syn.syn_detect_find(entries, probe, 0, probe.len, true)
            assert(first == -1 && len == 0, "an empty index finds nothing")
        } else {
            let last = key(size - 1)
            let (first, len) = syn.syn_detect_find(entries, last, 0, last.len, true)
            assert(first >= 0 && len == 1 && entries.langs[first] == size, "the last key is found")
            let folded = bytes("KEY-000")
            let (lower, _) = syn.syn_detect_find(entries, folded, 0, folded.len, true)
            assert(lower >= 0 && entries.langs[lower] == 1, "a folded key is found")
        }
        let missing = bytes("missing")
        let (none, count) = syn.syn_detect_find(entries, missing, 0, missing.len, true)
        assert(none == -1 && count == 0, "a missing key finds nothing")
    }
}

// test_syn_detect_index_returns_the_complete_duplicate_key_run
fn index_returns_the_complete_duplicate_key_run() {
    var entries = syn.syn_detect_entries()
    syn.syn_detect_add(mut entries, bytes("alpha"), 1, 0)
    syn.syn_detect_add(mut entries, bytes("duplicate"), 9, 0)
    syn.syn_detect_add(mut entries, bytes("duplicate"), 4, 0)
    syn.syn_detect_add(mut entries, bytes("omega"), 2, 0)
    let probe = bytes("duplicate")
    let (first, len) = syn.syn_detect_find(entries, probe, 0, probe.len, false)
    assert(first == 1 && len == 2, "the whole duplicate run")
    assert(entries.langs[first] == 9 && entries.langs[first + 1] == 4, "the run keeps table order")
    let upper_probe = bytes("DUPLICATE")
    let (missing, _) = syn.syn_detect_find(entries, upper_probe, 0, upper_probe.len, false)
    assert(missing == -1, "an exact index does not fold case")
}

fn main() {
    let selected = (env_get("YEW_SYN_DETECT_CASE") else "-1").to_int() else -1
    for i in 0..12 {
        if selected == -1 || selected == i {
            match i {
                0 => builtin_ini_exact_glob_extension_and_path_basename(),
                1 => exact_filename_precedes_glob_and_extension(),
                2 => longest_compound_extension_precedes_priority(),
                3 => priority_breaks_same_stage_ties(),
                4 => lexicographic_name_breaks_equal_priority_ties(),
                5 => env_and_direct_shebang_interpreters(),
                6 => shebang_precedes_first_line_regex(),
                7 => first_line_regex_is_last_positive_stage(),
                8 => unknown_path_and_empty_input_return_none(),
                9 => new_pack_exact_metadata_and_near_misses(),
                10 => indexes_scale_without_definition_scans(),
                _ => index_returns_the_complete_duplicate_key_run(),
            }
            print("syn_detect_case_{i}: PASS")
        }
    }
}
