//! member: false
//! The two tests/unit/test_state_diff.c cases at sagitta 9ace98c2, in
//! registry order (Sprint 36 §7's retained controls for the shipping
//! Fletch data codec): the writer's key spelling and the pure-literal
//! boundary, on a value-only VM as C's.

use fl

fn state_diff_data_writer_quotes_non_identifier_keys() {
    let expected = "{{\n  plain_key: 1,\n  \"history.scope\": 2,\n}}\n"
    var vm = fl.fl_vm_new(take fl.fl_strings())
    let map = fl.fl_map_new(mut vm)
    let k1 = fl.fl_str_new(mut vm, "plain_key".bytes())
    assert(fl.fl_map_set(mut vm, map, k1, fl.fl_int(1)))
    let k2 = fl.fl_str_new(mut vm, "history.scope".bytes())
    assert(fl.fl_map_set(mut vm, map, k2, fl.fl_int(2)))
    var out = List[byte]()
    fl.fl_data_write(vm, mut out, map, 0)
    let want = expected.bytes()
    assert(out.len == want.len)
    for i in 0..want.len { assert(out[i] == want[i]) }
}

fn state_diff_pure_literal_runs_nothing() {
    var vm = fl.fl_vm_new(take fl.fl_strings())
    var dc = fl.fl_diag_init()
    let _ = fl.fl_data_read(mut vm, "io.write(\"x\", \"bad\")".bytes(), mut dc)
    assert(fl.fl_diag_errors(dc) > 0)
}

fn main() {
    state_diff_data_writer_quotes_non_identifier_keys()
    state_diff_pure_literal_runs_nothing()
    print("edit_state_diff: 2 cases pass")
}
