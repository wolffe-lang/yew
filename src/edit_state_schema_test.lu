//! member: false
//! Ed-backed eight cases of sagitta tests/unit/test_state_schema.c:157-555
//! at 9ace98c2, registry order. The four pure scalar cases are ws's.

use edit
use ws

fn fixture() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    ed
}

fn node_get(d: ws.FlDoc, n: int, key: str) -> int { ws.fl_get(d, n, key.bytes()) else -1 }

fn item(d: ws.FlDoc, n: int, i: int) -> int { ws.fl_at(d, n, i) else -1 }

fn num(d: ws.FlDoc, n: int, key: str) -> int { ws.fl_int_or(d, node_get(d, n, key), -999) }

fn string(d: ws.FlDoc, n: int) -> str {
    let b = ws.fl_string_bytes(d, n) else { return "" }
    str_from_utf8(b) else ""
}

fn emitted(ed: edit.Ed) -> ws.FlDoc {
    let bytes = edit.state_emit_at(ed, 0)
    let parsed = ws.fl_parse(bytes, 0, bytes.len)
    assert(parsed.ok, "emitter output parses: {parsed.err.msg}")
    parsed.doc
}

fn t_emits_a_parseable_v1_document() {
    let ed = fixture()
    let d = emitted(ed)
    assert(num(d, d.root, "version") == 1)
    for key in "workspace options groups tabs files".words() {
        assert(node_get(d, d.root, key) >= 0)
    }
    assert(ws.fl_len(d, node_get(d, d.root, "tabs")) == 1)
}

fn t_writes_groups_before_tabs() {
    let ed = fixture()
    let d = emitted(ed)
    var groups = -1, tabs = -1, i = 0
    for key in d.nodes[d.root].keys {
        let value = str_from_utf8(d.bytes[key.at..key.at + key.len]) else ""
        if value == "groups" { groups = i }
        if value == "tabs" { tabs = i }
        i += 1
    }
    assert(groups >= 0 && tabs > groups)
    let bytes = edit.state_emit_at(ed, 0)
    let s = str_from_utf8(bytes) else ""
    assert((s.find("groups:") else 999) < (s.find("tabs:") else -1))
}

fn t_emits_groups_with_their_fields() {
    var ed = fixture()
    assert(edit.tab_open(mut ed, "target/yew-ss-a.txt") >= 0)
    assert(edit.tab_open(mut ed, "target/yew-ss-b.txt") >= 0)
    let gid = edit.group_create(mut ed, "target", "src/")
    edit.group_add_member(mut ed, gid, 1)
    edit.group_add_member(mut ed, gid, 2)
    let d = emitted(ed)
    let groups = node_get(d, d.root, "groups")
    assert(ws.fl_len(d, groups) == 1)
    let g = item(d, groups, 0)
    assert(num(d, g, "id") == gid)
    assert(string(d, node_get(d, g, "label")) == "src/")
    assert(string(d, node_get(d, g, "dir_path")) == "target")
    let t = item(d, node_get(d, d.root, "tabs"), 1)
    assert(num(d, t, "group") == gid && num(d, t, "group_ordinal") == 1)
}

fn collect(d: ws.FlDoc, node: int, mut seen: List[int]) {
    let win = node_get(d, node, "win")
    if win >= 0 { (mut seen).push(ws.fl_int_or(d, win, -1)); return }
    collect(d, node_get(d, node, "a"), mut seen)
    collect(d, node_get(d, node, "b"), mut seen)
}

fn split(mut ed: edit.Ed, dir: int) {
    let leaf = edit.pane_split(mut ed, ed.focus, dir)
    assert(leaf >= 0)
    ed.focus = leaf
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    ed.tabs[0].root = ed.pane_root
    ed.tabs[0].focus = ed.focus
}

fn t_pane_win_indices_match_the_wins_list() {
    var ed = fixture()
    split(mut ed, edit.SPLIT_H)
    split(mut ed, edit.SPLIT_V)
    let leaves = edit.pane_collect_leaves(ed, ed.pane_root, 16)
    for i in 0..leaves.len { ed.wins[ed.panes[leaves[i]].win].cs.curs[0].goal_col = 100 + i }
    let d = emitted(ed)
    let tab = item(d, node_get(d, d.root, "tabs"), 0)
    let wins = node_get(d, tab, "wins")
    assert(ws.fl_len(d, wins) == 3)
    var seen = List[int]()
    collect(d, node_get(d, tab, "panes"), mut seen)
    assert(seen.len == 3 && seen[0] == 0)
    for i in 0..seen.len {
        assert(seen[i] >= 0 && seen[i] < 3)
        for j in 0..i { assert(seen[i] != seen[j]) }
        let c = item(d, node_get(d, item(d, wins, i), "cursors"), 0)
        assert(num(d, c, "goal") == 100 + i)
    }
}

fn t_splits_carry_permille_not_floats() {
    var ed = fixture()
    split(mut ed, edit.SPLIT_H)
    let d = emitted(ed)
    let panes = node_get(d, item(d, node_get(d, d.root, "tabs"), 0), "panes")
    assert(string(d, node_get(d, panes, "split")) == "h")
    assert(num(d, panes, "ratio_permille") >= 1 && num(d, panes, "ratio_permille") <= 999)
    let bytes = edit.state_emit_at(ed, 0)
    assert(!(str_from_utf8(bytes) else "").contains("0.5"))
}

fn t_deferred_is_an_instruction() {
    var ed = fixture()
    assert(edit.tab_open(mut ed, "target/yew-ss-defer.txt") >= 0)
    assert(!edit.tab_is_resident(ed, 1) && ed.tab_active == 0)
    let d = emitted(ed)
    let tabs = node_get(d, d.root, "tabs")
    assert(!ws.fl_bool_or(d, node_get(d, item(d, tabs, 0), "deferred"), true))
    assert(ws.fl_bool_or(d, node_get(d, item(d, tabs, 1), "deferred"), false))
}

fn t_undo_is_a_reference_only() {
    var ed = fixture()
    let ti = edit.tab_open(mut ed, "target/yew-ss-undo.txt")
    assert(ti >= 0)
    edit.tab_switch(mut ed, ti)
    let d = emitted(ed)
    let files = node_get(d, d.root, "files")
    assert(ws.fl_len(d, files) == 1)
    let undo = node_get(d, item(d, files, 0), "undo")
    assert(string(d, node_get(d, undo, "file")).ends_with(".yewu") && num(d, undo, "version") == 1)
    let bytes = edit.state_emit_at(ed, 0)
    assert(!(str_from_utf8(bytes) else "").contains("\\x"))
}

fn t_emission_is_deterministic() {
    var ed = fixture()
    assert(edit.tab_open(mut ed, "target/yew-ss-det.txt") >= 0)
    let one = edit.state_emit_at(ed, 0)
    let two = edit.state_emit_at(ed, 0)
    assert(edit.comp_bytes_eq(one, two))
    let parsed = ws.fl_parse(one, 0, one.len)
    assert(parsed.ok && edit.comp_bytes_eq(ws.fl_reemit(parsed.doc), one))
}

fn main() {
    t_emits_a_parseable_v1_document()
    print("state_schema_emits_a_parseable_v1_document: PASS")
    t_writes_groups_before_tabs()
    print("state_schema_writes_groups_before_tabs: PASS")
    t_emits_groups_with_their_fields()
    print("state_schema_emits_groups_with_their_fields: PASS")
    t_pane_win_indices_match_the_wins_list()
    print("state_schema_pane_win_indices_match_the_wins_list: PASS")
    t_splits_carry_permille_not_floats()
    print("state_schema_splits_carry_permille_not_floats: PASS")
    t_deferred_is_an_instruction()
    print("state_schema_deferred_is_an_instruction: PASS")
    t_undo_is_a_reference_only()
    print("state_schema_undo_is_a_reference_only: PASS")
    t_emission_is_deterministic()
    print("state_schema_emission_is_deterministic: PASS")
}
