struct Frozen { seq: str, cmd: str, iarg: int, has_sarg: bool, sarg: str }

fn frozen_rows(letter: str) -> List[Frozen] {
    var out = List[Frozen]()
    var on = false
    for line in FROZEN.lines() {
        if line.len == 0 { continue }
        if line.starts_with("@") {
            on = line == "@{letter}"
            continue
        }
        if !on { continue }
        let f = line.split("\x1f")
        let iarg = f[2].to_int() else 0
        (mut out).push(Frozen { seq: f[0], cmd: f[1], iarg: iarg, has_sarg: f[3] == "1", sarg: f[4] })
    }
    out
}

fn read_runtime() -> List[byte] {
    fs_read_bytes("runtime/init.fl") else {
        assert(false, "read runtime/init.fl")
        List[byte]()
    }
}

// effective_binding (test_runtime_defaults.c:507-525): the config layer,
// else the mode's own keymap.
fn effective_binding(ed: edit.Ed, mode: int, seq: str) -> edit.Binding {
    let keys = edit.key_parse_seq(seq, 8)
    assert(keys.len != 0, "parse {seq}")
    var km = edit.bind_keys(ed, mode)
    var (m, _, bi) = edit.keymap_lookup(km, keys, keys.len)
    if m != edit.MATCH_FULL && m != edit.MATCH_FULL_PREFIX {
        km = copy ed.keymaps[edit.km_mode(mode)]
        let (m2, _, bi2) = edit.keymap_lookup(km, keys, keys.len)
        m = m2
        bi = bi2
    }
    assert(m == edit.MATCH_FULL || m == edit.MATCH_FULL_PREFIX, "{edit.mode_name(mode)} {seq} is bound")
    copy km.binds[bi]
}

// assert_frozen_mode (test_runtime_defaults.c:527-541).
fn assert_frozen_mode(ed: edit.Ed, mode: int, rows: List[Frozen]) {
    for r in rows {
        let actual = effective_binding(ed, mode, r.seq)
        assert(edit.cmd_active(ed.reg, actual.cmd), "{r.seq} names a command")
        let name = ed.reg.entries[actual.cmd - 1].name
        assert(name == r.cmd, "{edit.mode_name(mode)} {r.seq}: {name}, want {r.cmd}")
        assert(actual.iarg == r.iarg, "{r.seq} iarg")
        assert(actual.has_sarg == r.has_sarg && actual.sarg == r.sarg, "{r.seq} sarg")
    }
}

// assert_default_value (test_runtime_defaults.c:543-558).
fn assert_default_value(actual: edit.OptVal, want: edit.OptVal) {
    assert(actual.t == want.t)
    if want.t == edit.OPT_BOOL {
        assert(actual.b == want.b)
    } else if want.t == edit.OPT_INT {
        assert(actual.i == want.i)
    } else if want.t == edit.OPT_STRLIST {
        assert(actual.list.len == want.list.len && actual.list.len == 0)
    } else {
        assert(actual.s == want.s)
    }
}

fn runtime_defaults_rebuild_frozen_keymap() {
    let letters = ["L", "W", "B", "", "I", "E", "F"]
    let source = read_runtime()
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    let rebuilds = edit.bind_rebuild_count(ed)
    edit.bind_batch_begin(mut ed)
    assert(edit.fl_runtime_eval(mut ed, source) == edit.CMD_OK)
    edit.bind_batch_end(mut ed)
    assert(edit.bind_rebuild_count(ed) == rebuilds + 1)
    assert(edit.bind_active_count(ed) == 389, "active rows {edit.bind_active_count(ed)}")
    var panic_rows = 0
    for mode in 0..edit.MODE_N {
        if mode != edit.MODE_H { panic_rows += edit.keymap_binding_count(ed.keymaps[edit.km_mode(mode)]) }
        if letters[mode].len != 0 { assert_frozen_mode(ed, mode, frozen_rows(letters[mode])) }
    }
    assert(panic_rows == 60, "panic rows {panic_rows}")
}

fn runtime_defaults_parse_run_style_and_options() {
    let source = read_runtime()
    let text = str_from_utf8(source) else ""
    assert(text.starts_with("# yew default configuration."))
    assert(text.contains("# Budget:"))
    assert(!text.contains("\nimport "))
    assert(text.contains("# -- 8. functions"))
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    edit.bind_batch_begin(mut ed)
    assert(edit.fl_runtime_eval(mut ed, source) == edit.CMD_OK)
    edit.bind_batch_end(mut ed)
    let b = ed.wins[ed.win].buf
    for i in 0..ed.opt.descs.len {
        let d = copy ed.opt.descs[i]
        let actual = edit.opt_get(ed, b, ed.win, d.name) else {
            assert(false, "option {d.name}")
            return
        }
        assert_default_value(actual, d.dflt)
    }
}

fn runtime_defaults_frozen_globals_and_dotted_keys_execute() {
    let source = "import win\nimport ed\nlet cursors = win.current().cursors()\nif cursors[0].pos() != 0 {{ error(\"bad cursor\") }}\nset({{ \"clipboard.sync\": \"yank\", \"search.smartcase\": true }})\nbind(\"L\", \"Z\", \"ed.nop\")\non(\"ed.idle\", fn() nil)\ned.msg(\"modal globals registered\")\n"
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    let b = copy source.bytes()
    assert(edit.fl_runtime_eval(mut ed, b) == edit.CMD_OK)
    assert(edit.bind_active_count(ed) == 1)
    assert(ed.msg.text == "modal globals registered")
}

// YEW_EDIT_RUNTIME_DEFAULTS_CASE: one case alone, in registry order (the whole file is past the
// checked step budget, reg-d3562a4; tools/check-test-cases.txt).
fn main() {
    let chosen = (env_get("YEW_EDIT_RUNTIME_DEFAULTS_CASE") else "-1").to_int() else -1
    if chosen < 0 || chosen == 0 {
        runtime_defaults_rebuild_frozen_keymap()
        print("runtime_defaults_rebuild_frozen_keymap: PASS")
    }
    if chosen < 0 || chosen == 1 {
        runtime_defaults_parse_run_style_and_options()
        print("runtime_defaults_parse_run_style_and_options: PASS")
    }
    if chosen < 0 || chosen == 2 {
        runtime_defaults_frozen_globals_and_dotted_keys_execute()
        print("runtime_defaults_frozen_globals_and_dotted_keys_execute: PASS")
    }
    if chosen < 0 { print("edit_runtime_defaults: 3 cases pass") }
}
