//! member: false
//! The port of sagitta 9ace98c2 tests/unit/test_fl_std_str.c (400 lines),
//! one function per C test under the registry's names and in its order
//! (tools/fl-cases.txt), over the flfix fixture. The corpus case reads
//! tests/fixtures/unicode/corpus.txt, the pin's
//! tests/unit/fixtures/unicode/corpus.txt byte for byte.

use flfix
use std.fs

fn nibble(c: byte) -> int {
    let x = c as int
    if x <= 57 then x - 48 else if x <= 70 then x - 55 else x - 87
}

fn hb(h: str) -> List[byte] {
    var out = List[byte]()
    var i = 0
    while i + 1 < h.len {
        (mut out).push((nibble(h.bytes()[i]) * 16 + nibble(h.bytes()[i + 1])) as byte)
        i += 2
    }
    out
}

// test_fl_std_str.c:46: the two imports every case's program starts with.
fn p() -> str { "import str\nimport fmt\n" }

// test_fl_std_str.c:48-51: a ZWJ family, one cluster of 25 bytes.
fn family() -> str {
    str_from_utf8(hb("f09f91a8e2808df09f91a9e2808df09f91a7e2808df09f91a6")) else ""
}

// test_fl_std_str.c:269-277: every byte as \xNN.
fn escape_bytes(b: List[byte]) -> str {
    let digits = "0123456789abcdef"
    var out = List[byte]()
    for x in b {
        (mut out).push(92 as byte)
        (mut out).push(120 as byte)
        (mut out).push(digits.bytes()[x as int / 16])
        (mut out).push(digits.bytes()[x as int % 16])
    }
    str_from_utf8(out) else ""
}

// test_fl_std_str.c:295-400.
fn fl_str_the_s02_corpus_never_splits_a_cluster() {
    let text = fs.read_text("tests/fixtures/unicode/corpus.txt") else ""
    assert(text.len > 0, "corpus.txt is readable from the repository root")
    var f = flfix.open()
    var cases = 0
    for raw in text.lines() {
        let line = raw.trim_start()
        if line.len == 0 || line.starts_with("#") { continue }
        let fields = line.split("|")
        if fields.len < 3 { continue }
        var bytes = List[byte]()
        for tok in fields[1].words() { (mut bytes).push(hb(tok)[0]) }
        var bounds = List[int]()
        var at = 0
        for tok in fields[2].split(",") {
            let t = tok.trim()
            if t.len == 0 { continue }
            at += t.to_int() else 0
            (mut bounds).push(at)
        }
        if bytes.len == 0 || at != bytes.len { continue }
        let esc = escape_bytes(bytes)
        flfix.eq(mut f, "import str\nreturn str.len(\"{esc}\")\n", "{bounds.len}")
        flfix.eq(
            mut f,
            "import str\nreturn str.from_bytes(str.bytes(\"{esc}\")) == \"{esc}\"\n",
            "true",
        )
        for off in 1..bytes.len {
            var is_bound = false
            for b in bounds { if b == off { is_bound = true } }
            let src = "import str\nreturn str.len_bytes(str.slice_bytes(\"{esc}\", 0, {off}))\n"
            if is_bound {
                flfix.eq(mut f, src, "{off}")
            } else {
                flfix.eq(
                    mut f,
                    src,
                    "!index: str.slice_bytes: offset {off} splits a grapheme cluster",
                )
            }
        }
        cases += 1
    }
    assert(cases >= 20, "the corpus was read: {cases} cases")
    flfix.close(mut f)
}

// test_fl_std_str.c:53-79.
fn fl_str_indexes_by_grapheme_cluster() {
    var f = flfix.open()
    let fam = family()
    flfix.eq(mut f, p() + "return str.len(\"abc\")\n", "3")
    flfix.eq(mut f, p() + "return str.len(\"\")\n", "0")
    flfix.eq(mut f, p() + "return str.len(\"" + fam + "x\")\n", "2")
    flfix.eq(mut f, p() + "return str.len_bytes(\"" + fam + "x\")\n", "26")
    flfix.eq(mut f, p() + "return str.at(\"" + fam + "x\", 0)\n", fam)
    flfix.eq(mut f, p() + "return str.at(\"abc\", 1)\n", "b")
    flfix.eq(mut f, p() + "return str.at(\"abc\", 9)\n", "!index: str.at: index 9 out of range")
    flfix.eq(mut f, p() + "return str.is_empty(\"\")\n", "true")
    flfix.eq(mut f, p() + "return str.is_empty(\"a\")\n", "false")
    flfix.eq(mut f, p() + "return str.width(\"" + fam + "\")\n", "2")
    flfix.eq(mut f, p() + "return str.width(\"\\u{{6F22}}\\u{{5B57}}\")\n", "4")
    flfix.eq(mut f, p() + "return str.width(\"abc\")\n", "3")
    flfix.close(mut f)
}

// test_fl_std_str.c:81-93.
fn fl_str_slices_by_cluster() {
    var f = flfix.open()
    let fam = family()
    flfix.eq(mut f, p() + "return str.slice(\"abcd\", 1, 3)\n", "bc")
    flfix.eq(mut f, p() + "return str.slice(\"abcd\", 2)\n", "cd")
    flfix.eq(mut f, p() + "return str.slice(\"abcd\", 2, 2)\n", "")
    flfix.eq(mut f, p() + "return str.slice(\"" + fam + "x\", 0, 1)\n", fam)
    flfix.eq(mut f, p() + "return str.slice(\"" + fam + "x\", 1)\n", "x")
    flfix.close(mut f)
}

// test_fl_std_str.c:95-126.
fn fl_str_slice_bytes_refuses_a_cluster_split() {
    var f = flfix.open()
    let fam = family()
    flfix.eq(mut f, p() + "return str.slice_bytes(\"abcd\", 1, 3)\n", "bc")
    flfix.eq(mut f, p() + "return str.slice_bytes(\"" + fam + "\", 0, 25)\n", fam)
    for i in 1..25 {
        flfix.eq(
            mut f,
            p() + "return str.slice_bytes(\"" + fam + "\", 0, {i})\n",
            "!index: str.slice_bytes: offset {i} splits a grapheme cluster",
        )
    }
    flfix.close(mut f)
}

// test_fl_std_str.c:128-153.
fn fl_str_searches_and_tests() {
    var f = flfix.open()
    let fam = family()
    flfix.eq(mut f, p() + "return str.find(\"" + fam + "x\", \"x\")\n", "1")
    flfix.eq(mut f, p() + "return str.find_bytes(\"" + fam + "x\", \"x\")\n", "25")
    flfix.eq(mut f, p() + "return str.find(\"abcabc\", \"b\")\n", "1")
    flfix.eq(mut f, p() + "return str.find(\"abcabc\", \"b\", 2)\n", "4")
    flfix.eq(mut f, p() + "return str.find(\"abc\", \"z\")\n", "-1")
    flfix.eq(mut f, p() + "return str.find_bytes(\"abc\", \"z\")\n", "-1")
    flfix.eq(mut f, p() + "return str.rfind(\"abcabc\", \"b\")\n", "4")
    flfix.eq(mut f, p() + "return str.rfind(\"abc\", \"z\")\n", "-1")
    flfix.eq(mut f, p() + "return str.contains(\"abc\", \"bc\")\n", "true")
    flfix.eq(mut f, p() + "return str.contains(\"abc\", \"cb\")\n", "false")
    flfix.eq(mut f, p() + "return str.starts_with(\"abc\", \"ab\")\n", "true")
    flfix.eq(mut f, p() + "return str.starts_with(\"abc\", \"bc\")\n", "false")
    flfix.eq(mut f, p() + "return str.ends_with(\"abc\", \"bc\")\n", "true")
    flfix.eq(mut f, p() + "return str.ends_with(\"abc\", \"ab\")\n", "false")
    flfix.eq(mut f, p() + "return str.find(\"abc\", \"\")\n", "0")
    flfix.close(mut f)
}

// test_fl_std_str.c:155-179.
fn fl_str_case_and_trim_keep_invalid_bytes() {
    var f = flfix.open()
    flfix.eq(mut f, p() + "return str.upper(\"aBc\")\n", "ABC")
    flfix.eq(mut f, p() + "return str.lower(\"AbC\")\n", "abc")
    flfix.eq(mut f, p() + "return str.upper(\"stra\\u{{00DF}}e\")\n", "STRASSE")
    flfix.eq(mut f, p() + "return str.lower(\"\\u{{0130}}\") != \"\"\n", "true")
    flfix.eq(mut f, p() + "return str.trim(\"  a b  \")\n", "a b")
    flfix.eq(mut f, p() + "return str.trim_start(\"  a  \")\n", "a  ")
    flfix.eq(mut f, p() + "return str.trim_end(\"  a  \")\n", "  a")
    flfix.eq(mut f, p() + "return str.trim(\"\\t\\n a \\r\\n\")\n", "a")
    flfix.eq_bytes(mut f, p() + "return str.upper(\"a\\x80b\")\n", hb("418042"))
    flfix.eq_bytes(mut f, p() + "return str.lower(\"A\\x80B\")\n", hb("618062"))
    flfix.eq_bytes(mut f, p() + "return str.trim(\" \\x80 \")\n", hb("80"))
    flfix.eq(mut f, p() + "return str.len_bytes(str.upper(\"\\xff\\xfe\"))\n", "2")
    flfix.close(mut f)
}

// test_fl_std_str.c:181-212.
fn fl_str_splits_and_joins() {
    var f = flfix.open()
    flfix.eq(mut f, p() + "return fmt.repr(str.split(\"a,b,c\", \",\"))\n", "[\"a\", \"b\", \"c\"]")
    flfix.eq(mut f, p() + "return fmt.repr(str.split(\"a,b,c\", \",\", 2))\n", "[\"a\", \"b,c\"]")
    flfix.eq(mut f, p() + "return fmt.repr(str.split(\"abc\", \",\"))\n", "[\"abc\"]")
    flfix.eq(
        mut f,
        p() + "return fmt.repr(str.split_lines(\"a\\nb\\n\"))\n",
        "[\"a\", \"b\", \"\"]",
    )
    flfix.eq(
        mut f,
        p() + "return fmt.repr(str.split_lines(\"a\\r\\nb\\r\\n\"))\n",
        "[\"a\", \"b\", \"\"]",
    )
    flfix.eq(mut f, p() + "return fmt.repr(str.split_lines(\"a\\nb\"))\n", "[\"a\", \"b\"]")
    flfix.eq(mut f, p() + "return str.len_bytes(str.split_lines(\"a\\r\\r\\n\")[0])\n", "2")
    flfix.eq(mut f, p() + "return str.join([\"a\", \"b\"], \"-\")\n", "a-b")
    flfix.eq(mut f, p() + "return str.join([], \"-\")\n", "")
    flfix.eq(mut f, p() + "return str.join(str.split(\"a-b-c\", \"-\"), \"-\")\n", "a-b-c")
    flfix.close(mut f)
}

// test_fl_std_str.c:214-235.
fn fl_str_builds_new_strings() {
    var f = flfix.open()
    flfix.eq(mut f, p() + "return str.replace(\"aXbXc\", \"X\", \"-\")\n", "a-b-c")
    flfix.eq(mut f, p() + "return str.replace(\"aXbXc\", \"X\", \"-\", 1)\n", "a-bXc")
    flfix.eq(mut f, p() + "return str.replace(\"abc\", \"z\", \"-\")\n", "abc")
    flfix.eq(mut f, p() + "return str.repeat(\"ab\", 3)\n", "ababab")
    flfix.eq(mut f, p() + "return str.repeat(\"ab\", 0)\n", "")
    flfix.eq(
        mut f,
        p() + "return str.repeat(\"ab\", 99999999)\n",
        "!limit: str.repeat: result exceeds 64 MiB",
    )
    flfix.eq(mut f, p() + "return str.pad_start(\"ab\", 5)\n", "   ab")
    flfix.eq(mut f, p() + "return str.pad_end(\"ab\", 5, \".\")\n", "ab...")
    flfix.eq_bytes(
        mut f,
        p() + "return str.pad_start(\"\\u{{6F22}}\", 4, \".\")\n",
        hb("2e2ee6bca2"),
    )
    flfix.eq(mut f, p() + "return str.pad_end(\"abcd\", 2)\n", "abcd")
    flfix.close(mut f)
}

// test_fl_std_str.c:237-265.
fn fl_str_converts_to_and_from() {
    var f = flfix.open()
    flfix.eq(mut f, p() + "return fmt.repr(str.bytes(\"ab\"))\n", "[97, 98]")
    flfix.eq(mut f, p() + "return str.from_bytes([97, 98])\n", "ab")
    flfix.eq(mut f, p() + "return str.len_bytes(str.from_bytes(str.bytes(\"a\\x80\")))\n", "2")
    flfix.eq(
        mut f,
        p() + "return str.from_bytes([999])\n",
        "!index: str.from_bytes: item 0 is not a byte",
    )
    flfix.eq(mut f, p() + "return str.to_int(\"42\")\n", "42")
    flfix.eq(mut f, p() + "return str.to_int(\"ff\", 16)\n", "255")
    flfix.eq(mut f, p() + "return str.to_int(\"-7\")\n", "-7")
    flfix.eq(mut f, p() + "return str.to_int(\"nope\")\n", "nil")
    flfix.eq(mut f, p() + "return str.to_int(\"12x\")\n", "nil")
    flfix.eq(mut f, p() + "return fmt.str(str.to_float(\"1.5\"))\n", "1.5")
    flfix.eq(mut f, p() + "return str.to_float(\"nope\")\n", "nil")
    flfix.eq(mut f, p() + "return str.cmp(\"a\", \"b\")\n", "-1")
    flfix.eq(mut f, p() + "return str.cmp(\"b\", \"a\")\n", "1")
    flfix.eq(mut f, p() + "return str.cmp(\"a\", \"a\")\n", "0")
    flfix.eq(mut f, p() + "return str.cmp(\"a\", \"ab\")\n", "-1")
    flfix.close(mut f)
}

fn main() {
    fl_str_the_s02_corpus_never_splits_a_cluster()
    fl_str_indexes_by_grapheme_cluster()
    fl_str_slices_by_cluster()
    fl_str_slice_bytes_refuses_a_cluster_split()
    fl_str_searches_and_tests()
    fl_str_case_and_trim_keep_invalid_bytes()
    fl_str_splits_and_joins()
    fl_str_builds_new_strings()
    fl_str_converts_to_and_from()
    print("PASS fl_std_str: 9 cases")
}
