//! member: false
//!
//! yw25's own case (yew#137): a didChange of a full-sync server's whole
//! text builds the text, its JSON and the frame, and none of it may stay
//! allocated once the call returns: a wolf function allocates in its
//! caller's region and the editor's loop runs in the session's, so what a
//! call leaves behind is held to the session's end. The case builds the
//! document in a named region and reads the region's ledger
//! (`region_bytes`) around repeated flushes of a 40 KiB text: after the
//! frame is written out the ledger must not have grown by more than the
//! queue's own reuse.
//!
//! **SKIP by name on the checked machine**, whose ledger charges a reused
//! buffer's pushes (see `edit_drawbufs_test`); `tools/check-test --native`
//! gates it.

use lsp
use text

fn doc_bytes() -> List[byte] {
    var v = List[byte]()
    var i = 0
    while i < 1000 {
        for b in "let value_{i} = compute(argument_{i}, 42)  // a line\n".bytes() {
            (mut v).push(b)
        }
        i += 1
    }
    v
}

// Whether the ledger charges a push into a list that has room.
fn ledger_charges_reuse() -> bool {
    var d = 0
    region probe {
        var b = List[byte]()
        (mut b).push(1 as byte)
        (mut b).push(2 as byte)
        let _ = (mut b).pop() else 0 as byte
        let _ = (mut b).pop() else 0 as byte
        let b0 = region_bytes(probe)
        var i = 0
        while i < 10 {
            (mut b).push(1 as byte)
            let _ = (mut b).pop() else 0 as byte
            i += 1
        }
        d = region_bytes(probe) - b0
    }
    d != 0
}

fn edit_and_flush(mut rpc: lsp.RpcConn, mut doc: lsp.LspDoc, tb: text.TextBuf) {
    lsp.lsp_doc_note_edit(mut doc, lsp.POSENC_UTF16, 1, tb, text.JOURNAL_INS, 0, 1)
    assert(lsp.lsp_doc_flush(mut rpc, mut doc, 1, tb), "the edit was sent")
    lsp.rpctx_consume(mut rpc.tx, rpc.tx.pending.len)
}

fn flush_ledger(n: int) -> int {
    var grew = -1
    region probe {
        let s = doc_bytes()
        let tb = text.textbuf_from_bytes(s, 0, s.len)
        var doc = lsp.lsp_doc_new(7, "file:///tmp/a.lu")
        var rpc = lsp.rpc_conn_new()
        lsp.lsp_doc_opened(mut doc, tb.gen)
        var i = 0
        while i < 3 {
            edit_and_flush(mut rpc, mut doc, tb)
            i += 1
        }
        let before = region_bytes(probe)
        i = 0
        while i < n {
            edit_and_flush(mut rpc, mut doc, tb)
            i += 1
        }
        grew = region_bytes(probe) - before
    }
    print("lsp_sync_alloc_test: {n} whole-text didChange flushes: {grew} ledger bytes kept")
    grew
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let grew = flush_ledger(20)
    if ledger_charges_reuse() {
        let line = "lsp_sync_alloc_test: SKIP whole-text flush: this machine's ledger charges a reused buffer's pushes (the checked machine); the native lane gates it"
        print(line)
        eprint(line)
        return
    }
    assert(grew <= 4096, "20 flushes of a 50 KiB text kept {grew} ledger bytes (the bound is 4096)")
    print("lsp_sync_alloc_test: 1 case passes")
}
