//! member: false
//! sagitta 9ace98c2 tests/unit/test_state_schema.c:48-124 (four pure cases),
//! test_state_options.c:33-98 (pure overlays only), state_lit.c:151-303.
//! The eight Ed-backed schema cases and options dirty/timer remain in edit.

use ws

fn parse(s: str) -> ws.FlDoc {
    let result = ws.fl_parse(s.bytes(), 0, s.len)
    assert(result.ok, result.err.msg)
    copy result.doc
}

fn literals(s: str) -> ws.StateLiterals {
    var doc = parse(s)
    ws.state_literals_from(take doc) else {
        assert(false, "valid schema expected")
        ws.state_literals()
    }
}

fn t_remaps_group_ids() {
    var ids = List[ws.StateId]()
    ws.state_idmap_put(mut ids, 7, 1)
    ws.state_idmap_put(mut ids, 9, 2)
    ws.state_idmap_put(mut ids, 12, 3)
    assert(ws.state_idmap_get(ids, 7) == 1)
    assert(ws.state_idmap_get(ids, 9) == 2)
    assert(ws.state_idmap_get(ids, 12) == 3)
    for n in [0, 1, 2, 3, 99] { assert(ws.state_idmap_get(ids, n) == 0) }
    ws.state_idmap_put(mut ids, 0, 9)
    ws.state_idmap_put(mut ids, 7, 99)
    assert(ids.len == 4 && ws.state_idmap_get(ids, 7) == 1)
}

fn t_id_map_grows() {
    var ids = List[ws.StateId]()
    for i in 1..=200 { ws.state_idmap_put(mut ids, i, i * 10) }
    for i in 1..=200 { assert(ws.state_idmap_get(ids, i) == i * 10) }
    assert(ws.state_idmap_get(ids, 201) == 0)
}

fn t_permille_is_a_fixpoint() {
    for p in 1..=999 {
        assert(ws.state_ratio_to_permille(ws.state_permille_to_ratio(p)) == p, "permille {p}")
    }
    assert(ws.state_ratio_to_permille(0) == 1)
    assert(ws.state_ratio_to_permille(1065353216) == 999)
    assert(ws.state_ratio_to_permille(3231711232) == 1)
    assert(ws.state_permille_to_ratio(-1) == ws.state_permille_to_ratio(1))
    assert(ws.state_permille_to_ratio(5000) == ws.state_permille_to_ratio(999))
}

fn t_goal_column_round_trips() {
    assert(ws.state_goal_to_i64(ws.STATE_GOAL_EOL) == -1)
    assert(ws.state_goal_from_i64(-1) == ws.STATE_GOAL_EOL)
    assert(ws.state_goal_from_i64(-99) == ws.STATE_GOAL_EOL)
    for n in [0, 14] { assert(ws.state_goal_from_i64(n) == n && ws.state_goal_to_i64(n) == n) }
}

fn t_bool_overlay_preserves_unknown_literals() {
    var s = literals(
        "{{ version: 1, options: {{ \"from.the.future\": 42, \"git.tree.all_files\": \"legacy\", }}, }}",
    )
    assert(
        (
            ws.state_option_string_span(s, "git.tree.all_files".bytes()) else ws.FlSpan {
                at: 0,
                len: 0,
            }
        ).
            len ==
            6,
    )
    assert(ws.state_option_bool_set(mut s, "git.tree.all_files".bytes(), true))
    assert(ws.state_option_bool_set(mut s, "git.tree.show_hidden".bytes(), false))
    assert(ws.state_option_bool(s, "git.tree.all_files".bytes(), false))
    assert(!ws.state_option_bool(s, "git.tree.show_hidden".bytes(), true))
    assert(
        (
            ws.state_option_string_span(s, "git.tree.all_files".bytes()) else ws.FlSpan {
                at: 0,
                len: 0,
            }
        ).
            len ==
            0,
    )
    var e = ws.fl_emit()
    ws.fl_map_open(mut e, false, "".bytes())
    ws.state_emit_options(mut e, s)
    ws.fl_map_close(mut e)
    let bytes = ws.fl_emit_finish(take e)
    let r = ws.fl_parse(bytes, 0, bytes.len)
    assert(r.ok)
    let options = ws.fl_get(r.doc, r.doc.root, "options".bytes()) else -1
    assert(
        ws.fl_int_or(r.doc, ws.fl_get(r.doc, options, "from.the.future".bytes()) else -1, 0) == 42,
    )
    assert(
        ws.fl_bool_or(
            r.doc,
            ws.fl_get(r.doc, options, "git.tree.all_files".bytes()) else -1,
            false,
        ),
    )
}

fn t_bool_overlay_sorted_and_idempotent() {
    var s = ws.state_literals()
    assert(ws.state_option_bool_set(mut s, "z".bytes(), true))
    assert(ws.state_option_bool_set(mut s, "a".bytes(), false))
    assert(!ws.state_option_bool_set(mut s, "a".bytes(), false))
    assert(ws.state_option_bool_set(mut s, "a".bytes(), true))
    assert(s.bool_options.len == 2 && s.bool_options[0].key[0] == 97 as byte)
    assert(!ws.state_option_bool_set(mut s, "".bytes(), true))
    var retained = literals("{{version: 1, options: {{a: true, empty: \"\", wrong: 9,}},}}")
    assert(!ws.state_option_bool_set(mut retained, "a".bytes(), true))
    assert(retained.bool_options.len == 0)
    assert(
        (
            ws.state_option_string_span(retained, "empty".bytes()) else ws.FlSpan { at: 0, len: 0 }
        ).len ==
            0,
    )
    assert(ws.state_option_bool(retained, "wrong".bytes(), true))
}

fn t_retained_identities() {
    var s = literals(
        "{{version: 1, workspace: {{path: \"/w\", newer: 1,}}, future: 7, tabs: [{{id: 7, more: 1,}}, {{id: 8, more: 2,}}, {{id: 9,}},],}}",
    )
    let tabs = ws.fl_get(s.doc, s.doc.root, "tabs".bytes()) else -1
    let a = ws.fl_at(s.doc, tabs, 0) else -1
    let b = ws.fl_at(s.doc, tabs, 1) else -1
    let known = ws.fl_at(s.doc, tabs, 2) else -1
    ws.state_record_retain(mut s, ws.STATE_REC_TAB, 0, 91, a)
    ws.state_record_retain(mut s, ws.STATE_REC_TAB, 0, 19, b)
    ws.state_record_retain(mut s, ws.STATE_REC_TAB, 0, 91, b)
    ws.state_record_retain(mut s, ws.STATE_REC_TAB, 0, 4, known)
    assert(s.records.len == 3)
    let token = ws.state_record_retain_token(mut s, ws.STATE_REC_TAB, 17, a)
    assert(token == 1)
    assert(ws.state_record_retain_token(mut s, ws.STATE_REC_TAB, 17, known) == 0)
    ws.state_records_finish(mut s)
    assert(s.records.len == 3)
    assert((ws.state_record_get(s, ws.STATE_REC_TAB, 0, 91) else -1) == b)
    assert((ws.state_record_get(s, ws.STATE_REC_TAB, 0, 19) else -1) == b)
    assert((ws.state_record_get(s, ws.STATE_REC_TAB, 17, 1) else -1) == a)
    assert((ws.state_record_get(s, ws.STATE_REC_TAB, 0, 4) else -1) == -1)
    assert(ws.state_record_key_known(ws.STATE_REC_MARK, "line".bytes()))
    assert(!ws.state_record_key_known(ws.STATE_REC_MARK, "Line".bytes()))
    var e = ws.fl_emit()
    ws.fl_map_open(mut e, false, "".bytes())
    ws.fl_int(mut e, true, "id".bytes(), 91)
    ws.state_emit_record_unknown(mut e, s, ws.STATE_REC_TAB, 0, 91)
    ws.state_emit_unknown(mut e, s, false)
    ws.fl_map_open(mut e, true, "workspace".bytes())
    ws.state_emit_unknown(mut e, s, true)
    ws.fl_map_close(mut e)
    ws.fl_map_close(mut e)
    let bytes = ws.fl_emit_finish(take e)
    let r = ws.fl_parse(bytes, 0, bytes.len)
    assert(r.ok)
    assert(ws.fl_int_or(r.doc, ws.fl_get(r.doc, r.doc.root, "more".bytes()) else -1, 0) == 2)
    assert(ws.fl_int_or(r.doc, ws.fl_get(r.doc, r.doc.root, "future".bytes()) else -1, 0) == 7)
    ws.state_records_reset(mut s)
    assert(s.records.len == 0 && s.next_token == 1)
}

fn main() {
    t_remaps_group_ids()
    t_id_map_grows()
    t_permille_is_a_fixpoint()
    t_goal_column_round_trips()
    t_bool_overlay_preserves_unknown_literals()
    t_bool_overlay_sorted_and_idempotent()
    t_retained_identities()
    print("ws_state_lit: 4 schema helpers, 2 pure option bridges, retained identities ok")
}
