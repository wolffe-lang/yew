//! member: false
//! Supplemental report-format and reserved-buffer witnesses, s32 section 9.
//! G53: checked List.reset accounting is not native allocation evidence.
//! tools/check-fl-report runs the native residency assertion explicitly.

use fl

fn main() {
    let native_residency = (env_get("YEW_FL_BUG_REPORT_NATIVE") else "0") == "1"
    region proof {
        var strings = fl.fl_strings()
        var vm = fl.fl_vm_new(take strings)
        vm.sp = -1
        let before = region_bytes(proof)
        for _ in 0..100 { fl.fl_bug_report(mut vm, -1, 71, 254, "fl vm: stack underflow", false) }
        let after = region_bytes(proof)
        if native_residency {
            assert(after == before, "report formatting allocated after reservation")
        }
        let report = str_from_utf8(vm.bug_report) else ""
        assert(report.starts_with("fl vm: stack underflow\n"))
        assert(report.contains("  opcode : BAD_OP (0xFE) at pc 0x0047\n"))
        assert(report.contains("  fn     : <fn>/0  file_id 0\n"))
        assert(report.contains("  frames : 0 (depth cap 256)   sp offset: -1   handlers: 0\n"))
        assert(report.contains("  build  : 1.0.0-dev cgoto=0 checks="))
        assert(report.ends_with("  hint   : YEW_FL_DUMP_BAD_CHUNK=<path> writes a disassembly\n"))
        vm.sp = -9223372036854775807 - 1
        fl.fl_bug_report(mut vm, -1, 0, 0, "minimum int", true)
        let minimum = str_from_utf8(vm.bug_report) else ""
        assert(minimum.contains("sp offset: -9223372036854775808"))
        assert(minimum.ends_with("disassembly written to YEW_FL_DUMP_BAD_CHUNK\n"))
        var long = List[byte]()
        (mut long).reserve(5000)
        for _ in 0..5000 { (mut long).push(120 as byte) }
        let text = str_from_utf8(long) else ""
        fl.fl_bug_report(mut vm, -1, 0, 0, text, false)
        assert(vm.bug_report.len == fl.FL_BUG_REPORT_CAP - 1)
        print("fl_bug_report: format, minimum int, bounded truncation: PASS")
        if native_residency {
            print("fl_bug_report: 100 reports, reserved-buffer allocation delta=0: PASS")
        } else {
            print(
                "fl_bug_report: residency RECORDED only here (G53); check-fl-report owns the native assertion",
            )
        }
    }
}
