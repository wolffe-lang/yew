//! member: false
//! sagitta 9ace98c2 tests/unit/test_fl_compile.c:134-842, eleven cases.

use fl

fn corpus(i: int) -> str {
    match i {
        0 => "return 100000\n", // CONST
        1 => "let x = nil\nreturn x\n", // NIL
        2 => "return true\n", // TRUE
        3 => "return false\n", // FALSE
        4 => "return 7\n", // INT8
        5 => "fn f() {{ let a\nlet b\nlet c\nreturn 0 }}\nreturn f()\n", // NIL_N
        6 => "1 + 1\nreturn 0\n", // POP
        7 => "fn f() {{ if true {{ let a = 1\nlet b = 2 }}\nreturn 0 }}\nreturn f()\n", // POPN
        8 => "", // DUP
        9 => "fn f() {{ let a = 1\nreturn a }}\nreturn f()\n", // GET_LOCAL
        10 => "fn f() {{ let a = 1\na = 2\nreturn a }}\nreturn f()\n", // SET_LOCAL
        11 => "fn f() {{ let a = 1\nreturn fn() a }}\nreturn 0\n", // GET_UPVAL
        12 => "fn f() {{ let a = 1\nreturn fn() {{ a = 2\nreturn a }} }}\nreturn 0\n", // SET_UPVAL
        13 => "fn f() {{ let a = 1\nreturn fn() a }}\nreturn 0\n", // CLOSE_UPVALS
        14 => "let g = 1\nreturn g\n", // GET_GLOBAL
        15 => "let g = 1\ng = 2\nreturn g\n", // SET_GLOBAL
        16 => "let g = 1\nreturn g\n", // DEF_GLOBAL
        17 => "return 1 + 2\n", // ADD
        18 => "return 3 - 1\n", // SUB
        19 => "return 3 * 2\n", // MUL
        20 => "return 6 / 2\n", // DIV
        21 => "return 7 % 3\n", // MOD
        22 => "let a = 1\nreturn -a\n", // NEG
        23 => "return not false\n", // NOT
        24 => "return 1 == 1\n", // EQ
        25 => "return 1 != 2\n", // NE
        26 => "return 1 < 2\n", // LT
        27 => "return 1 <= 2\n", // LE
        28 => "return 2 > 1\n", // GT
        29 => "return 2 >= 1\n", // GE
        30 => "if true {{ return 1 }} else {{ return 2 }}\n", // JUMP
        31 => "let n = 0\nwhile n < 3 {{ n = n + 1 }}\nreturn n\n", // JUMP_BACK
        32 => "if true {{ return 1 }}\nreturn 0\n", // JUMP_IF_FALSE
        33 => "", // JUMP_IF_TRUE
        34 => "return nil or 1\n", // OR_JUMP
        35 => "return 1 and 2\n", // AND_JUMP
        36 => "fn f() {{ return 1 }}\nreturn f()\n", // CALL
        37 => "fn f() {{ return 1 }}\nreturn f()\n", // RETURN
        38 => "fn f() {{ let a = 1 }}\nreturn 0\n", // RETURN_NIL
        39 => "fn f() {{ return 1 }}\nreturn f()\n", // CLOSURE
        40 => "return [1, 2][0]\n", // LIST
        41 => "let m = {{a: 1}}\nreturn m.a\n", // MAP
        42 => "return [1, 2][0]\n", // INDEX_GET
        43 => "let l = [1]\nl[0] = 2\nreturn l[0]\n", // INDEX_SET
        44 => "let m = {{a: 1}}\nreturn m.a\n", // FIELD_GET
        45 => "let m = {{a: 1}}\nm.a = 2\nreturn m.a\n", // FIELD_SET
        46 => "let t = 0\nfor x in [1] {{ t = x }}\nreturn t\n", // ITER_NEW
        47 => "let t = 0\nfor x in [1] {{ t = x }}\nreturn t\n", // ITER_NEXT1
        48 => "let t = 0\nlet m = {{a: 1}}\nfor k, v in m {{ t = v }}\nreturn t\n", // ITER_NEXT2
        49 => "edit {{ @[ 2v ] }}\nreturn 0\n", // MOTION
        50 => "import io\nreturn 0\n", // IMPORT
        51 => "edit {{ @[ 2v ] }}\nreturn 0\n", // EDIT_BEGIN
        52 => "edit {{ @[ 2v ] }}\nreturn 0\n", // EDIT_END
        53 => "", // THROW
        54 => "try {{ return 1 }} catch e {{ return 2 }}\n", // TRY_PUSH
        55 => "try {{ return 1 }} catch e {{ return 2 }}\n", // TRY_POP
        56 => "return 0\n", // HALT
        57 => "", // LIST_APPEND
        58 => "", // NOT_NIL
        59 => "", // TRACE_LINE
        _ => "",
    }
}

fn compile(mut vm: fl.FlVm, text: str, mode: int) -> fl.FlValue {
    var src = List[byte]()
    for b in text.bytes() { (mut src).push(b) }
    let p = fl.fl_parse(src, 0, mut vm.dc, mut vm.strings)
    if p.had_error { return fl.fl_nil() }
    if mode == 1 {
        return fl.fl_compile_profiled(mut vm, p, 0, fl.fl_origin_new(4, 0)) else fl.fl_nil()
    }
    if mode == 2 {
        return fl.fl_compile_covered(mut vm, p, 0, fl.fl_origin_new(4, 0)) else fl.fl_nil()
    }
    fl.fl_compile(mut vm, p, 0, fl.fl_origin_new(4, 0)) else fl.fl_nil()
}

fn mark_ops(vm: fl.FlVm, f: fl.FlValue, mut seen: List[bool]) {
    assert(f.t == 7)
    let at = fl.fl_obj_index(vm, f)
    var pc: int = 0
    while pc < vm.gc.slots[at].code.len {
        let op = vm.gc.slots[at].code[pc] as int
        assert(op < 60)
        seen[op] = true
        pc += fl.fl_op_length(vm, f, pc)
    }
    assert(pc == vm.gc.slots[at].code.len)
    for v in vm.gc.slots[at].vals { if v.t == 7 { mark_ops(vm, v, mut seen) } }
}

fn synth(mut vm: fl.FlVm, i: int) -> fl.FlValue {
    let f = fl.fl_gc_alloc(mut vm, 7, 96)
    let at = fl.fl_obj_index(vm, f)
    var code = List[int]()
    match i {
        0 => { code = [4, 7, 8, 17, 37] },
        1 => { code = [2, 33, 3, 0, 4, 1, 37, 4, 2, 37] },
        2 => { code = [4, 9, 53] },
        3 => { code = [40, 0, 0, 4, 5, 57, 1, 9, 1, 4, 0, 42, 37] },
        4 => { code = [1, 58, 32, 3, 0, 4, 1, 37, 4, 0, 37] },
        _ => { code = [59, 4, 0, 4, 3, 37] },
    }
    for b in code { (mut vm.gc.slots[at].code).push(b as byte) }
    (mut vm.gc.slots[at].lines).push(fl.FlLineRun { pc: 0, line: 1, col: 1 })
    vm.gc.slots[at].max_stack = 8
    f
}

fn t_synthetic_execute() {
    let wants = [14, 2, 9, 5, 0, 3]
    for i in 0..6 {
        region r {
            var strings = fl.fl_strings()
            var vm = fl.fl_vm_new(take strings)
            let f = synth(mut vm, i)
            let out = fl.fl_vm_run(mut vm, f)
            assert(vm.raised == (i == 2))
            assert(out.t == 2 && out.i == wants[i])
        }
    }
    print("PASS fl_compile synthetic_opcodes_execute")
}

fn t_synthetic_disassemble() {
    let ops = [8, 33, 53, 57, 58, 59]
    for i in 0..6 {
        region r {
            var strings = fl.fl_strings()
            var vm = fl.fl_vm_new(take strings)
            let f = synth(mut vm, i)
            var out = List[byte]()
            fl.fl_disasm_chunk(vm, f, mut out)
            let text = str_from_utf8(out) else ""
            assert(text.contains(fl.fl_op_name(ops[i])) && !text.contains("BAD_OP"))
        }
    }
    print("PASS fl_compile synthetic_opcodes_disassemble")
}

fn t_opcode_coverage() {
    var seen = List[bool]()
    for _ in 0..60 { (mut seen).push(false) }
    for i in 0..60 {
        let text = corpus(i)
        if text.len == 0 { seen[i] = true; continue }
        region r {
            var strings = fl.fl_strings()
            var vm = fl.fl_vm_new(take strings)
            let f = compile(mut vm, text, 0)
            var one = List[bool]()
            for _ in 0..60 { (mut one).push(false) }
            mark_ops(vm, f, mut one)
            if !one[i] { eprint("missing {fl.fl_op_name(i)}") }
            assert(one[i])
            for j in 0..60 { seen[j] = seen[j] || one[j] }
        }
    }
    for s in seen { assert(s) }
    print("PASS fl_compile every_opcode_is_covered")
}

fn error(src: str, needle: str) {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let f = compile(mut vm, src, 0)
    assert(f.t == 0 && vm.dc.nerrors > 0 && vm.dc.entries[0].msg.contains(needle))
}

fn t_scopes() {
    error("fn f() {{ let x = 1\nif true {{ let x = x }} }}\nreturn 0\n", "own initializer")
    error("fn f() {{ let a = 1\nlet a = 2 }}\nreturn 0\n", "already declared")
    error("break\n", "outside")
    error("continue\n", "outside")
    error("let g = 1\nlet g = 2\nreturn g\n", "already declared in this module")
    error("fn f() {{ }}\nlet f = 1\nreturn f\n", "already declared in this module")
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    assert(compile(mut vm, "let g = 1\nfn h() {{ let g = 2\nreturn g }}\nreturn h()\n", 0).t == 7)
    print("PASS fl_compile rejects_bad_scopes")
}

fn t_constants() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let f = compile(mut vm, "let a = 100000\nlet b = 100000\nreturn a + b\n", 0)
    var hits = 0
    for v in vm.gc.slots[fl.fl_obj_index(vm, f)].vals { if v.t == 2 && v.i == 100000 { hits += 1 } }
    assert(hits == 1)
    let g = compile(mut vm, "let a = 100000\nlet b = 100000.0\nreturn 0\n", 0)
    var ints = 0
    var floats = 0
    for v in vm.gc.slots[fl.fl_obj_index(vm, g)].vals {
        if v.t == 2 && v.i == 100000 { ints += 1 }
        if v.t == 3 { floats += 1 }
    }
    assert(ints == 1 && floats == 1)
    print("PASS fl_compile dedupes_constants")
}

fn count(vm: fl.FlVm, f: fl.FlValue, op: int) -> int {
    let at = fl.fl_obj_index(vm, f)
    var pc: int = 0
    var n: int = 0
    while pc < vm.gc.slots[at].code.len {
        if vm.gc.slots[at].code[pc] as int == op { n += 1 }
        pc += fl.fl_op_length(vm, f, pc)
    }
    n
}

fn t_small_ints() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let f = compile(mut vm, "return 7\n", 0)
    assert(count(vm, f, 4) == 1 && count(vm, f, 0) == 0)
    let g = compile(mut vm, "return 100000\n", 0)
    assert(count(vm, g, 0) == 1)
    print("PASS fl_compile small_ints_avoid_the_constant_pool")
}

fn t_stack() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let f = compile(mut vm, "return 1 + (2 * (3 - (4 / (5 % 6))))\n", 0)
    assert(vm.gc.slots[fl.fl_obj_index(vm, f)].max_stack >= 6)
    let g = compile(mut vm, "return [1,2,3,4,5,6,7,8]\n", 0)
    assert(vm.gc.slots[fl.fl_obj_index(vm, g)].max_stack >= 2)
    print("PASS fl_compile tracks_max_stack")
}

fn t_lines() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let f = compile(mut vm, "let a = 1\nlet b = 2\nlet c = a + b\nreturn c\n", 0)
    let at = fl.fl_obj_index(vm, f)
    var starts = Map[int, bool]()
    var pc: int = 0
    while pc < vm.gc.slots[at].code.len { starts[pc] = true; pc += fl.fl_op_length(vm, f, pc) }
    assert(pc == vm.gc.slots[at].code.len)
    assert(vm.gc.slots[at].lines.len != 0 && vm.gc.slots[at].lines[0].pc == 0)
    var prev: int = -1
    for r in vm.gc.slots[at].lines {
        assert((starts[r.pc] else false) && r.line >= 1 && r.line <= 4 && r.col >= 1 && r.pc > prev)
        prev = r.pc
    }
    print("PASS fl_compile lines_are_recorded_for_every_op")
}

fn t_lengths() {
    for i in 0..60 {
        if corpus(i).len == 0 { continue }
        region r {
            var strings = fl.fl_strings()
            var vm = fl.fl_vm_new(take strings)
            let f = compile(mut vm, corpus(i), 0)
            let at = fl.fl_obj_index(vm, f)
            var pc: int = 0
            while pc < vm.gc.slots[at].code.len { pc += fl.fl_op_length(vm, f, pc) }
            assert(pc == vm.gc.slots[at].code.len)
        }
    }
    print("PASS fl_compile operand_lengths_match_the_emitter")
}

fn t_determinism() {
    let text = "fn outer(p) {{\n    let n = p\n    let g = fn() {{ n = n + 1\nreturn n }}\n    for k, v in {{a: 1, b: 2}} {{ n = n + v }}\n    try {{ n = n / 0 }} catch e {{ n = 0 }}\n    return g\n}}\nreturn outer(1)\n"
    var sa = fl.fl_strings()
    var sb = fl.fl_strings()
    var a = fl.fl_vm_new(take sa)
    var b = fl.fl_vm_new(take sb)
    let fa = compile(mut a, text, 0)
    let fb = compile(mut b, text, 0)
    let ai = fl.fl_obj_index(a, fa)
    let bi = fl.fl_obj_index(b, fb)
    assert(a.gc.slots[ai].code.len == b.gc.slots[bi].code.len)
    assert(a.gc.slots[ai].vals.len == b.gc.slots[bi].vals.len)
    assert(a.gc.slots[ai].max_stack == b.gc.slots[bi].max_stack)
    for j in 0..a.gc.slots[ai].code.len { assert(a.gc.slots[ai].code[j] == b.gc.slots[bi].code[j]) }
    print("PASS fl_compile is_deterministic_across_instances")
}

fn first_fn(vm: fl.FlVm, f: fl.FlValue) -> fl.FlValue {
    for v in vm.gc.slots[fl.fl_obj_index(vm, f)].vals { if v.t == 7 { return copy v } }
    fl.fl_nil()
}

fn t_profile() {
    let src = "fn nested() {{ let hidden = 1\nreturn hidden }}\nreturn 2\nlet skipped = 3\n"
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let plain = compile(mut vm, src, 0)
    assert(count(vm, plain, 59) == 0)
    let marked = compile(mut vm, src, 1)
    assert(count(vm, marked, 59) == 3 && count(vm, first_fn(vm, marked), 59) == 0)
    let result = fl.fl_vm_run(mut vm, marked)
    assert(!vm.raised && result.t == 2 && result.i == 2)
    assert(vm.observed_lines.len == 2 && vm.observed_lines[0] == 1 && vm.observed_lines[1] == 3)
    let covered = compile(
        mut vm,
        "fn nested() {{\n    let hidden = 1\n    return hidden\n}}\nreturn nested()\n",
        2,
    )
    assert(count(vm, covered, 59) == 2 && count(vm, first_fn(vm, covered), 59) == 2)
    (mut vm.observed_lines).reset()
    let _ = fl.fl_vm_run(mut vm, covered)
    assert(vm.observed_lines.len == 4)
    assert(
        vm.observed_lines[0] == 1 &&
            vm.observed_lines[1] == 5 &&
            vm.observed_lines[2] == 2 &&
            vm.observed_lines[3] == 3,
    )
    print("PASS fl_compile profile_markers_are_explicit_and_executed")
}

fn main() {
    t_synthetic_execute()
    t_synthetic_disassemble()
    t_opcode_coverage()
    t_scopes()
    t_constants()
    t_small_ints()
    t_stack()
    t_lines()
    t_lengths()
    t_determinism()
    t_profile()
}
