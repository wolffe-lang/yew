//! member: false
//! Attached-runtime integration regressions for sagitta 9ace98c2
//! flruntime.c:185-280, fleval.c:142-208, fltxn.c:25-84 and motion_tab.c.
//! These supplement, and do not replace, the pinned s34 case inventory.

use edit
use fl
use text

fn editor() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed
}

fn evaluate(mut ed: edit.Ed, src: str) -> (int, fl.FlValue) {
    let origin = fl.fl_origin_new(fl.FL_ORIGIN_CONFIG, fl.FL_CAP_ALL)
    edit.fl_eval_source(mut ed, src.bytes(), "editor-test.fl", origin, false)
}

fn bytes_equal(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

fn result_bytes(ed: edit.Ed, v: fl.FlValue) -> List[byte] {
    assert(v.t == fl.FL_STR)
    copy ed.flrt.vms[0].gc.slots[fl.fl_obj_index(ed.flrt.vms[0], v)].bytes
}

fn t_persistent_runtime() {
    var ed = editor()
    assert(edit.fl_runtime_eval(mut ed, "let shared_value = 3".bytes()) == edit.CMD_OK)
    assert(edit.fl_runtime_eval(mut ed, "shared_value + 4".bytes()) == edit.CMD_OK)
    assert(ed.msg.text == "7")
    assert(ed.flrt.ready && ed.flrt.vms.len == 1 && ed.flrt.macro_cache.len == 26)
    assert(ed.flrt.vms[0].host_kind == 1 && !ed.fltxn.entry_active)
}

fn t_binary_binding_and_implicit_undo() {
    var ed = editor()
    let _ = edit.fl_runtime_init(mut ed)
    ed.flrt.vms[0].gc.stress = true
    let (status, result) = evaluate(
        mut ed,
        "import buf; let b = buf.current(); b.insert(0, \"a\\0b\"); return b.text()",
    )
    assert(status == edit.CMD_OK)
    assert(bytes_equal(result_bytes(ed, result), "a\0b".bytes()))
    let bi = edit.ed_doc(ed)
    assert(text.textbuf_len(ed.bufs[bi].ec.tb) == 3)
    assert(ed.bufs[bi].ec.undo.depth == 0 && ed.fltxn.entries.len == 0)
    let (check, depth) = evaluate(mut ed, "import buf; return buf.current().undo_depth()")
    assert(check == edit.CMD_OK && depth.i == 1)
}

fn t_explicit_rollback_preserves_implicit_prefix() {
    var ed = editor()
    let (status, result) = evaluate(
        mut ed,
        "import buf; let b = buf.current(); b.insert(0, \"kept\"); try {{ edit {{ b.insert(4, \"lost\"); error(\"stop\") }} }} catch e {{ }}; return b.text()",
    )
    assert(status == edit.CMD_OK && bytes_equal(result_bytes(ed, result), "kept".bytes()))
    assert(!ed.fltxn.entry_active && ed.fltxn.depth == 0 && ed.fltxn.entries.len == 0)
}

fn t_motion_and_reuse_after_error() {
    var ed = editor()
    let (failed, _) = evaluate(mut ed, "edit {{ @[ i\"bad\" ]; error(\"stop\") }}")
    assert(failed == edit.CMD_ERR_STATE)
    let bi = edit.ed_doc(ed)
    assert(text.textbuf_len(ed.bufs[bi].ec.tb) == 0 && ed.bufs[bi].ec.undo.depth == 0)
    assert(ed.flrt.vms.len == 1 && ed.flrt.vms[0].sp == 0 && ed.flrt.vms[0].frames.len == 0)
    let (ok, result) = evaluate(mut ed, "import buf; @[ i\"ok\" ]; return buf.current().text()")
    assert(ok == edit.CMD_OK && bytes_equal(result_bytes(ed, result), "ok".bytes()))
}

fn t_nested_edits_one_node_and_caught_error() {
    var ed = editor()
    let (ok, result) = evaluate(
        mut ed,
        "import buf; let b = buf.current(); edit {{ b.insert(0, \"a\"); edit {{ b.insert(1, \"b\"); try {{ error(\"caught\") }} catch e {{ }} }} }}; return b.undo_depth()",
    )
    assert(ok == edit.CMD_OK && result.i == 1)
    let bi = edit.ed_doc(ed)
    assert(bytes_equal(text.textbuf_bytes(ed.bufs[bi].ec.tb), "ab".bytes()))
}

fn main() {
    t_persistent_runtime()
    t_binary_binding_and_implicit_undo()
    t_explicit_rollback_preserves_implicit_prefix()
    t_motion_and_reuse_after_error()
    t_nested_edits_one_node_and_caught_error()
    print("attached Fletch runtime: 5 integration groups PASS")
}
