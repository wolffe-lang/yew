//! member: false
//!
//! The port of sagitta `tests/unit/test_shsession.c` (1,125 lines), one
//! test per C test in registry order. Every one of C's seventeen drives
//! the persistent `$SHELL -s` session — a framed job whose pipes the loop
//! reads while it paints — the job half that STOPs at wolf 0.2.33: ruling
//! R-yw04-1 (G2, wolf-lang#795). Each SKIPs loudly by name. Port-only
//! cases prove the surface 0.2.33 answers: with no session state the
//! session's directory is the workspace root (`shsession.h:93-99`),
//! `shell.session` defaults to persistent, `ed.shell.reset` says C's
//! line, and a `:!` that would enter the session refuses by name.

use edit
use std.fs

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn run_line(mut ed: edit.Ed, line: str) -> int {
    let parsed = edit.cmd_parse(mut ed, bytes_of(line))
    if !edit.cmd_parse_ok(parsed) {
        return edit.CMD_ERR_ARG
    }
    let inv = edit.CmdInvoke {
        range: copy parsed.range,
        argv: copy parsed.argv,
        count: 0,
        bang: parsed.bang,
        win: ed.win,
    }
    edit.ed_invoke_parsed(mut ed, parsed.command, inv)
}

fn t_port_shsession_queries_without_a_session() {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.ws_dir = "/tmp/yew-shsession-root"
    assert(edit.shsession_cwd(ed) == "/tmp/yew-shsession-root", "the workspace root")
    assert(!edit.shsession_busy(ed), "never busy")
    assert(edit.shsession_persistent(ed), "persistent by default")
    ed.opts.store["shell.session"] = "fresh"
    assert(!edit.shsession_persistent(ed), "fresh when set")
    assert(run_line(mut ed, ":shreset") == edit.CMD_OK, ":shreset")
    assert(
        ed.msg.text == "shell session reset; the next :! starts in the workspace root",
        "C's line: {ed.msg.text}",
    )
    assert(run_line(mut ed, ":!cd /tmp") == edit.CMD_ERR_DEFERRED, "a :! refuses")
    assert(
        ed.msg.text.contains("needs os_signal_wait_fds (G2, wolf-lang#795)"),
        "by name: {ed.msg.text}",
    )
}

fn skip(name: str) -> int {
    let why = "the persistent shell session is a framed job whose pipes are read while the loop runs: needs os_signal_wait_fds (G2, wolf-lang#795), R-yw04-1"
    print("shsession_test: SKIP {name}: {why}")
    eprint("shsession_test: SKIP {name}: {why}")
    1
}

fn main() {
    // The session's `--yew-env0` runs this binary (`unit_main.c:14-19`).
    if edit.shsession_env0_requested() {
        os_exit(edit.shsession_env0_main())
    }
    fs.create_dir_all("target/tests") else |_| {}
    env_set("YEW_LOG", "/dev/null") else |_| {}
    var skips = 0
    for name in [
        "shsession_cd_persists",
        "shsession_exports_functions_and_locals",
        "shsession_job_rows_are_per_command",
        "shsession_exit_recovers_last_directory",
        "shsession_reset_returns_to_workspace_root",
        "shsession_fresh_is_sprint19",
        "shsession_non_sh_shell_falls_back_to_fresh",
        "shsession_forged_marker_is_output",
        "shsession_syntax_error_cannot_swallow_frames",
        "shsession_output_shapes",
        "shsession_state_survives_any_bytes",
        "shsession_split_reads_and_replayed_markers",
        "shsession_cancel_keeps_the_session_on_every_shell",
        "shsession_double_cancel_ends_the_session",
        "shsession_busy_runs_alongside",
        "shsession_other_forms_inherit_state",
        "shsession_prompt_hint_names_the_directory",
    ] {
        skips += skip(name)
    }
    t_port_shsession_queries_without_a_session()
    print("shsession_test: {17 - skips} C cases pass, {skips} SKIP; 1 port case passes")
}
