//! member: false
//! Separate legacy command identity from the new key's recorded promotion intent.
use edit
use term
use text

fn fixture() -> edit.Ed {
    let runtime = fs_read_bytes("runtime/init.fl") else List[byte]()
    var ed = edit.ed_new_test(runtime, "")
    let bytes = "aa\nbb\ncc\n".bytes()
    let w = ed.win
    let b = ed.wins[w].buf
    ed.bufs[b].ec.tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    ed.bufs[b].ec.undo = text.undo_new(ed.bufs[b].ec.tb)
    ed.wins[w].cs = text.cset_init(text.cursor_at(0 as text.ByteOff))
    ed.wins[w].cs.curs[0].goal_col = text.CCOL_HERE
    ed
}

fn feed(mut ed: edit.Ed, wire: str) {
    let bytes = wire.bytes()
    term.input_feed(mut ed.input, bytes, 0, bytes.len)
    var key = term.key_new()
    while term.input_next(mut ed.input, 1000, mut key) {
        edit.ed_handle_key(mut ed, key, 1000)
    }
}

fn primary(ed: edit.Ed) -> int {
    ed.wins[ed.win].cs.curs[ed.wins[ed.win].cs.primary].pos
}

fn dotted_retains_upper() {
    var ed = fixture()
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "ed.cursor.add.below")
    feed(mut ed, "\r")
    assert(ed.wins[ed.win].cs.curs.len == 2 && primary(ed) == 0,
        "existing dotted command retains the upper primary like C")
    print("PASS cursor-dotted-retains-primary")
}

fn key_promotes_lower() {
    var ed = fixture()
    feed(mut ed, "\x1b[1;7B")
    assert(ed.wins[ed.win].cs.curs.len == 2 && primary(ed) == 3,
        "new key promotes its lower destination")
    print("PASS cursor-key-promotes-destination")
}

fn key_recording_preserves_frontier() {
    var ed = fixture()
    assert(edit.record_start(mut ed, 97))
    feed(mut ed, "\x1b[1;7B\x1b[1;7B")
    assert(edit.record_stop(mut ed) == edit.CMD_OK)
    assert(ed.wins[ed.win].cs.curs.len == 3 && primary(ed) == 6)
    let value = text.reg_get(mut ed.regs, 97) else text.regval_new()
    let source = str_from_utf8(value.bytes) else ""
    assert(source.contains("cursor_key_below") || source.contains("ed.cursor.key.below"),
        "new key intent must survive the recorder, not just SRC_KEY dispatch")
    ed.wins[ed.win].cs = text.cset_init(text.cursor_at(0 as text.ByteOff))
    ed.wins[ed.win].cs.curs[0].goal_col = text.CCOL_HERE
    assert(edit.macro_replay(mut ed, 97, 1) == edit.CMD_OK)
    assert(ed.wins[ed.win].cs.curs.len == 3 && primary(ed) == 6,
        "recorded new keys replay primary-frontier growth")
    print("PASS cursor-key-recorded-frontier")
}

fn main() {
    let chosen = (env_get("YEW_COMMAND_PRIMARY_CASE") else "-1").to_int() else -1
    if chosen < 0 || chosen == 0 { dotted_retains_upper() }
    if chosen < 0 || chosen == 1 { key_promotes_lower() }
    if chosen < 0 || chosen == 2 { key_recording_preserves_frontier() }
    assert(chosen <= 3, "unknown command-primary case")
}
