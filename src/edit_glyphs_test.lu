//! member: false
//!
//! The port of sagitta `tests/unit/test_glyphs.c` (250 lines), one test
//! per C test in registry order: the chrome glyph vocabulary (Sprint 27
//! §7) — both vocabularies on every row, the same width in both, the
//! one-cell slots kept under ambiguous-wide, the arrows, the AUTO choice
//! from the locale and the single decision. C sets and unsets the process
//! environment between `yew_glyph_reset` calls; the port's resolver reads
//! a `term.Env` (`edit.glyph_resolve`), so each case hands it the table C
//! would have built in the environment.

use edit
use term
use unicode

fn env(pairs: List[(str, str)]) -> term.Env {
    var m = Map[str, str]()
    for p in pairs {
        let (k, v) = p
        m[k] = v
    }
    term.env_of(m)
}

fn is_ascii(s: str) -> bool {
    for b in s.bytes() {
        if b as int >= 128 {
            return false
        }
    }
    true
}

// `test_glyphs_every_row_has_both_vocabularies` (`:30-51`).
fn t_glyphs_every_row_has_both_vocabularies() {
    var i = 0
    while i < edit.GLYPH_N {
        edit.glyph_force_ascii(false)
        let utf8 = edit.glyph(i)
        edit.glyph_force_ascii(true)
        let ascii = edit.glyph(i)
        assert(utf8.len != 0 && ascii.len != 0, "row {i} has both")
        assert(is_ascii(ascii), "row {i}'s fallback is ASCII")
        i += 1
    }
    edit.glyph_reset()
}

// `test_glyphs_grip_and_tick_are_one_cell` (`:59-72`).
fn t_glyphs_grip_and_tick_are_one_cell() {
    edit.glyph_force_ascii(false)
    assert(edit.glyph_cells(edit.GLYPH_GRIP) == 1, "the grip is one cell")
    assert(edit.glyph_cells(edit.GLYPH_TICKED) == 3, "[✓] is three")
    assert(
        edit.glyph_cells(edit.GLYPH_UNTICKED) == edit.glyph_cells(edit.GLYPH_TICKED),
        "[ ] matches it",
    )
    edit.glyph_reset()
}

// `test_glyphs_are_the_same_width_in_both_vocabularies` (`:78-94`).
fn t_glyphs_are_the_same_width_in_both_vocabularies() {
    var i = 0
    while i < edit.GLYPH_N {
        edit.glyph_force_ascii(false)
        let wide = edit.glyph_cells(i)
        edit.glyph_force_ascii(true)
        let narrow = edit.glyph_cells(i)
        assert(wide == narrow, "row {i}: {wide} vs {narrow}")
        assert(wide >= 1, "row {i} is visible")
        i += 1
    }
    edit.glyph_reset()
}

// `test_glyphs_preserve_slots_under_ambiguous_wide` (`:96-117`).
fn t_glyphs_preserve_slots_under_ambiguous_wide() {
    edit.glyph_force_ascii(false)
    unicode.width_set_ambiguous_wide(false)
    var expected = List[int]()
    var i = 0
    while i < edit.GLYPH_N {
        (mut expected).push(edit.glyph_cells(i))
        i += 1
    }
    unicode.width_set_ambiguous_wide(true)
    i = 0
    while i < edit.GLYPH_N {
        assert(edit.glyph_cells(i) == expected[i], "row {i} keeps its slot")
        i += 1
    }
    assert(edit.glyph(edit.GLYPH_DIRTY_TICK) == "+", "the dirty tick falls back")
    assert(edit.glyph(edit.GLYPH_BORDER_V) == "|", "the border falls back")
    assert(edit.glyph(edit.GLYPH_MODIFIED) == "*", "the modified mark is ASCII already")
    unicode.width_set_ambiguous_wide(false)
    edit.glyph_reset()
}

// `test_glyphs_ambiguous_fallback_preserves_grid_neighbor` (`:119-150`).
fn t_glyphs_ambiguous_fallback_preserves_grid_neighbor() {
    unicode.width_set_ambiguous_wide(true)
    edit.glyph_force_ascii(false)
    var g = term.grid_new(1, 3)
    let c = term.color_default()
    let tick = edit.glyph(edit.GLYPH_DIRTY_TICK).bytes()
    assert(term.grid_put(mut g, 0, 0, tick, 0, tick.len, c, c, 0) == 1, "the tick takes one cell")
    let x = "x".bytes()
    assert(term.grid_put(mut g, 0, 1, x, 0, x.len, c, c, 0) == 2, "x lands next to it")
    let c0 = term.grid_back(g, 0, 0)
    let c1 = term.grid_back(g, 0, 1)
    assert(c0.w == 1 && term.cell_byte(c0, 0) == 43, "a one-cell +")
    assert(c1.w == 1 && term.cell_byte(c1, 0) == 120, "x untouched")
    unicode.width_set_ambiguous_wide(false)
    edit.glyph_reset()
}

// `test_glyphs_arrows_point_the_way_the_thing_moves` (`:157-174`).
fn t_glyphs_arrows_point_the_way_the_thing_moves() {
    edit.glyph_force_ascii(false)
    assert(edit.glyph(edit.GLYPH_EXPAND) == "\u{00BB}", "collapsed expands rightward")
    assert(edit.glyph(edit.GLYPH_COLLAPSE) == "\u{00AB}", "expanded collapses leftward")
    assert(edit.glyph(edit.GLYPH_DISCLOSE_SHUT) == "\u{25B6}", "shut")
    assert(edit.glyph(edit.GLYPH_DISCLOSE_OPEN) == "\u{25BC}", "open")
    edit.glyph_force_ascii(true)
    assert(edit.glyph(edit.GLYPH_EXPAND) == ">", "ascii expand")
    assert(edit.glyph(edit.GLYPH_COLLAPSE) == "<", "ascii collapse")
    edit.glyph_reset()
}

// `test_glyphs_ascii_is_auto_from_the_locale` (`:179-226`).
fn t_glyphs_ascii_is_auto_from_the_locale() {
    assert(edit.glyph_resolve(env(List[(str, str)]())), "nothing says UTF-8")
    assert(!edit.glyph_resolve(env([("LANG", "en_US.UTF-8")])), "LANG UTF-8")
    assert(!edit.glyph_resolve(env([("LANG", "en_US.utf8")])), "LANG utf8")
    assert(!edit.glyph_resolve(env([("LANG", "C"), ("LC_CTYPE", "de_DE.UTF-8")])), "LC_CTYPE UTF-8")
    assert(
        !edit.glyph_resolve(env([("LANG", "C"), ("LC_CTYPE", "de_DE.UTF-8"), ("LC_ALL", "POSIX")])),
        "LC_ALL does not veto the others",
    )
    assert(edit.glyph_resolve(env([("LANG", "C"), ("LC_ALL", "POSIX")])), "none says UTF-8")
    assert(
        !edit.glyph_resolve(env([("LANG", "C"), ("LC_ALL", "POSIX"), ("YEW_ASCII", "0")])),
        "YEW_ASCII=0 wins",
    )
    assert(
        edit.glyph_resolve(env([("LANG", "en_US.UTF-8"), ("LC_ALL", "POSIX"), ("YEW_ASCII", "1")])),
        "YEW_ASCII=1 wins",
    )
    edit.glyph_reset()
}

// `test_glyphs_the_vocabulary_is_decided_once` (`:234-250`): the port's
// decision is made by the first read; a later environment is never asked.
fn t_glyphs_the_vocabulary_is_decided_once() {
    assert(!edit.glyph_resolve(env([("LANG", "en_US.UTF-8")])), "decided: UTF-8")
    assert(!edit.glyph_ascii(), "the answer stands")
    assert(edit.glyph(edit.GLYPH_BORDER_V) == "\u{2502}", "the box border")
    edit.glyph_reset()
}

fn main() {
    t_glyphs_every_row_has_both_vocabularies()
    t_glyphs_grip_and_tick_are_one_cell()
    t_glyphs_are_the_same_width_in_both_vocabularies()
    t_glyphs_preserve_slots_under_ambiguous_wide()
    t_glyphs_ambiguous_fallback_preserves_grid_neighbor()
    t_glyphs_arrows_point_the_way_the_thing_moves()
    t_glyphs_ascii_is_auto_from_the_locale()
    t_glyphs_the_vocabulary_is_decided_once()
    print("glyphs_test: 8 cases pass")
}
