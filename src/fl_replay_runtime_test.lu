//! member: false
//! The three tests/unit/test_fl_replay_runtime.c cases at sagitta 9ace98c2,
//! in registry order (Sprint 35: replay through the VM). C's record tap
//! (replay_source_tap, test_fl_replay_runtime.c:14-22) is the registry's
//! logging tap (TAP_LOG), which keeps each recordable dispatch's source.
//! C compares FlFn pointers across a collection; the port's collector
//! compacts, so a cache hit after one is witnessed by no compile happening
//! (the diagnostic file count is unchanged) and the cached root still
//! naming a function.

use edit
use fl
use text

fn open() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    assert(edit.fl_runtime_init(mut ed))
    edit.cmd_set_record_tap(mut ed.reg, edit.TAP_LOG)
    ed
}

fn sources(ed: edit.Ed) -> List[int] {
    var out = List[int]()
    for e in ed.reg.tap_log { (mut out).push(e.source) }
    out
}

fn fl_replay_runtime_propagates_command_source() {
    let source = "import ed\ned.run(\"ed.mode.enter\", {{\"sarg\": \"W\"}})\ned.run(\"ed.fl.eval\", {{\"sarg\": \"@[ l ]\"}})\n"
    var ed = open()
    assert(edit.fl_runtime_eval(mut ed, source.bytes()) == edit.CMD_OK)
    let first = sources(ed)
    assert(first.len == 2)
    assert(first[0] == edit.SRC_FLETCH && first[1] == edit.SRC_FLETCH)
    (mut ed.reg.tap_log).reset()
    let fun = edit.fl_compile_str(mut ed, source.bytes(), "<source-propagation>") else {
        assert(false)
        return
    }
    assert(edit.fl_call_chunk(mut ed, fun, edit.SRC_REPLAY))
    let second = sources(ed)
    assert(second.len == 2)
    assert(second[0] == edit.SRC_REPLAY && second[1] == edit.SRC_REPLAY)
}

fn files(ed: edit.Ed) -> int { ed.flrt.vms[0].dc.files.len }

fn fl_replay_runtime_cache_is_exact_rooted_and_invalidated() {
    let first = "@[ > ]\n"
    let second = "@[ < ]\n"
    var ed = open()
    let a = edit.fl_macro_compile_cached(mut ed, 'a' as int, first.bytes()) else {
        assert(false)
        return
    }
    let n_a = files(ed)
    let hit = edit.fl_macro_compile_cached(mut ed, 'a' as int, first.bytes()) else {
        assert(false)
        return
    }
    assert(hit.t == fl.FL_FN && hit.t == a.t && hit.i == a.i && files(ed) == n_a)
    let changed = edit.fl_macro_compile_cached(mut ed, 'a' as int, second.bytes()) else {
        assert(false)
        return
    }
    assert(files(ed) == n_a + 1 && !(changed.i == a.i))
    fl.fl_gc_collect(mut ed.flrt.vms[0])
    let n_changed = files(ed)
    let again = edit.fl_macro_compile_cached(mut ed, 'a' as int, second.bytes()) else {
        assert(false)
        return
    }
    let root = ed.flrt.macro_cache[0].root
    let held = fl.fl_gc_host_root_get(ed.flrt.vms[0], root)
    assert(files(ed) == n_changed && held.t == fl.FL_FN && held.i == again.i)
    assert(edit.fl_call_chunk(mut ed, again, edit.SRC_REPLAY))
    edit.fl_macro_cache_invalidate(mut ed, 'a' as int)
    let recompiled = edit.fl_macro_compile_cached(mut ed, 'a' as int, second.bytes()) else {
        assert(false)
        return
    }
    assert(recompiled.t == fl.FL_FN && files(ed) == n_changed + 1)
}

fn origin_of(ed: edit.Ed, fun: fl.FlValue) -> fl.FlOrigin {
    copy ed.flrt.vms[0].gc.slots[fl.fl_obj_index(ed.flrt.vms[0], fun)].origin
}

fn reg_bytes(mut ed: edit.Ed, r: int) -> List[byte] {
    let v = text.reg_get(mut ed.regs, r) else { return List[byte]() }
    copy v.bytes
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

fn fl_replay_runtime_cache_preserves_macro_defining_origin() {
    let writer = "import ed\ned.run(\"ed.reg.set\", {{iarg: 97, sarg: \"@[ > ]\\n\"}})\n"
    let yanker = "import ed\ned.run(\"ed.edit.yank\", {{sarg: \"A\", range_kind: \"span\", range_given: true, range_lo: 0, range_hi: 7}})\n"
    let mac = "@[ > ]\n"
    assert(mac.len == 7)
    var ed = open()
    let label = "plugin-macro-writer"
    let path = fl.fl_intern(mut ed.flrt.vms[0].strings, label.bytes(), 0, label.len)
    let plugin = fl.FlOrigin { kind: fl.FL_ORIGIN_PLUGIN, path_id: path, caps: 0, principal_id: 77 }
    let (w, _) = edit.fl_eval_source(mut ed, writer.bytes(), "plugin-macro-writer.fl", plugin, false)
    assert(w == edit.CMD_OK)
    let v1 = reg_bytes(mut ed, 'a' as int)
    assert(same(v1, mac.bytes()))
    let plugin_fn = edit.fl_macro_compile_cached(mut ed, 'a' as int, v1) else {
        assert(false)
        return
    }
    let o1 = origin_of(ed, plugin_fn)
    assert(o1.kind == fl.FL_ORIGIN_PLUGIN && o1.caps == 0 && o1.principal_id == 77)
    // A host rewrite of identical bytes still invalidates the provenance-
    // sensitive cache and restores config authority.
    assert(edit.flapi_reg_write(mut ed, 'a' as int, mac.bytes(), false) == edit.CMD_OK)
    let v2 = reg_bytes(mut ed, 'a' as int)
    let config_fn = edit.fl_macro_compile_cached(mut ed, 'a' as int, v2) else {
        assert(false)
        return
    }
    let o2 = origin_of(ed, config_fn)
    assert(o2.kind == fl.FL_ORIGIN_CONFIG && o2.caps == fl.FL_CAP_ALL)
    // The other named-register door and its uppercase append spelling
    // carry the same provenance rule.
    edit.ed_open_memory(mut ed, mac.bytes(), "macro-source.fl")
    let (y, _) = edit.fl_eval_source(mut ed, yanker.bytes(), "plugin-macro-yanker.fl", plugin, false)
    assert(y == edit.CMD_OK)
    let v3 = reg_bytes(mut ed, 'a' as int)
    assert(v3.len == 2 * mac.len)
    assert(same(v3[0..mac.len], mac.bytes()) && same(v3[mac.len..v3.len], mac.bytes()))
    let appended = edit.fl_macro_compile_cached(mut ed, 'a' as int, v3) else {
        assert(false)
        return
    }
    let o3 = origin_of(ed, appended)
    assert(o3.kind == fl.FL_ORIGIN_PLUGIN && o3.principal_id == 77)
}

fn main() {
    fl_replay_runtime_propagates_command_source()
    fl_replay_runtime_cache_is_exact_rooted_and_invalidated()
    fl_replay_runtime_cache_preserves_macro_defining_origin()
    print("fl_replay_runtime: 3 cases pass")
}
