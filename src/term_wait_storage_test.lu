//! member: false
//! Port-only regression for sc69's signal.wait_fds adapter (yew#24).
//! Sagitta src/edit/loop.c:557-571 waits without retaining per-turn storage.
//! The wrapper allocates an integer descriptor vector; it must die per wait.

use std.fs
use std.process
use term

fn main() {
    let pipe = process.pipe() else { assert(false, "wait storage: pipe required"); return }
    defer fs.close(take fs.File { fd: pipe.read.fd }) else |_| {}
    defer fs.close(take fs.File { fd: pipe.write.fd }) else |_| {}
    var before: int = 0
    var after: int = 0
    region held {
        var tty = term.tty_new()
        var fds = List[int]()
        (mut fds).push(pipe.read.fd)
        let warm = term.tty_ready_extra(mut tty, fds, 0) else -2
        assert(warm == -1, "empty pipe must not be ready")
        before = region_bytes(held)
        for _ in 0..1000 {
            let ready = term.tty_ready_extra(mut tty, fds, 0) else -2
            assert(ready == -1, "empty pipe must remain unready")
        }
        after = region_bytes(held)
    }
    assert(after == before, "wait storage grew: {before} to {after}")
    print("term_wait_storage: 1000 waits, retained bytes {before} -> {after}: PASS")
}
