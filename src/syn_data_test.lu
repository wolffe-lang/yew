//! member: false
//! Definition-compiler front-end seams from sagitta syn/defs.c:272–318
//! and fl_parse_literal. In particular definitions are DATA, not Fletch code.
use fl
use syn

fn literal_document() {
    let data = syn.syn_data_parse("toy.fl", "{{ syntax: 1, language: {{ name: \"toy\" }}, contexts: {{ main: {{ rules: [] }} }} }}".bytes())
    assert(data.diagnostics.nerrors == 0, "literal definition parses")
    let root = data.program.root
    assert(syn.syn_data_is(data, root, fl.FL_A_MAP), "root map")
    let version = syn.syn_data_map_get(data, root, "syntax") else -1
    assert((syn.syn_data_integer(data, version) else -1) == 1, "schema version")
    let language = syn.syn_data_map_get(data, root, "language") else -1
    let name = syn.syn_data_map_get(data, language, "name") else -1
    assert(syn.syn_data_string_is(data, name, "toy"), "language name")
    assert((syn.syn_data_map_get(data, root, "missing") else -1) == -1, "missing is an absent row")
}

fn rejects_execution() {
    let call = syn.syn_data_parse("call.fl", "set({{syntax:1}})".bytes())
    assert(call.program.root < 0 && call.diagnostics.nerrors > 0, "definition never executes a call")
    let expression = syn.syn_data_parse("expr.fl", "{{syntax: 1 + 1}}".bytes())
    assert(expression.program.root < 0 && expression.diagnostics.nerrors > 0, "definition never evaluates an expression")
}

fn exact_byte_strings() {
    let data = syn.syn_data_parse("bytes.fl", "{{ x: \"\\xFF\\0\" }}".bytes())
    assert(data.diagnostics.nerrors == 0, "Fletch byte string accepted")
    let node = syn.syn_data_map_get(data, data.program.root, "x") else -1
    let id = syn.syn_data_string_id(data, node) else 0
    assert(id > 0, "raw string id")
    assert(data.strings.items[id].len == 2, "no lossy Unicode conversion")
    assert(data.strings.items[id][0] as int == 255 && data.strings.items[id][1] as int == 0, "byte and NUL retained")
}

fn kinds_are_distinct() {
    let data = syn.syn_data_parse("types.fl", "{{ a: true, b: 1, c: \"1\", d: [] }}".bytes())
    let a = syn.syn_data_map_get(data, data.program.root, "a") else -1
    let b = syn.syn_data_map_get(data, data.program.root, "b") else -1
    let c = syn.syn_data_map_get(data, data.program.root, "c") else -1
    assert((syn.syn_data_boolean(data, a) else false), "boolean true")
    assert((syn.syn_data_integer(data, a) else -1) == -1, "bool is not int")
    assert((syn.syn_data_integer(data, b) else -1) == 1, "integer literal")
    assert((syn.syn_data_string_id(data, b) else 0) == 0, "int is not string")
    assert(syn.syn_data_string_is(data, c, "1"), "string literal")
    assert((syn.syn_data_boolean(data, b) else false) == false, "int is not bool")
}

fn map_keys() {
    let data = syn.syn_data_parse("keys.fl", "{{ match: 1, \"matchh\": 2, 3: 4 }}".bytes())
    let unknown = syn.syn_data_unknown_keys(data, data.program.root, "match attr")
    assert(unknown.len == 2, "both unknown and non-string key retained for diagnostics")
    assert(syn.syn_data_string_is(data, unknown[0], "matchh"), "unknown key exact source node")
    assert((syn.syn_data_integer(data, unknown[1]) else -1) == 3, "integer key exact source node")
    let first = syn.syn_data_map_get(data, data.program.root, "match") else -1
    assert((syn.syn_data_integer(data, first) else -1) == 1, "known key resolution")
}

fn source_diagnostic() {
    var data = syn.syn_data_parse("position.fl", "{{\n  syntax: 2\n}}".bytes())
    let node = syn.syn_data_map_get(data, data.program.root, "syntax") else -1
    syn.syn_data_error(mut data, node, "unknown schema version 2 (this build understands 1)")
    assert(data.diagnostics.nerrors == 1, "compiler diagnostic captured")
    assert(data.diagnostics.entries[0].sp.line == 2, "source line retained")
    assert(data.diagnostics.entries[0].sp.col == 11, "source byte column retained")
    assert(data.diagnostics.files[0].path == "position.fl", "source identity retained")
}

fn main() {
    let selected = (env_get("YEW_SYN_DATA_CASE") else "-1").to_int() else -1
    var i = 0
    while i < 6 {
        if selected == -1 || selected == i {
            match i {
                0 => literal_document(),
                1 => rejects_execution(),
                2 => exact_byte_strings(),
                3 => kinds_are_distinct(),
                4 => map_keys(),
                _ => source_diagnostic(),
            }
            print("syn_data_case_{i}: PASS")
        }
        i += 1
    }
}
