//! member: false
//!
//! The port of sagitta `tests/unit/test_search_smartcase.c` (191 lines),
//! one test per C test in registry order (`tests/unit/registry.c:1617-
//! 1622`). C's helpers compile through `yew_re_compile` and
//! `yew_search_compile` and match over `yew_re_input_bytes`; the port's
//! through `search.re_compile`, `edit.search_compile` and
//! `search.re_input_bytes` with an empty buffer beside the bytes (the
//! engine's backing travels beside the input's shape).

use edit
use search
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn opts(ignorecase: bool, smartcase: bool) -> edit.SearchOpts {
    var o = edit.search_opts_new()
    o.ignorecase = ignorecase
    o.smartcase = smartcase
    o
}

// `sc_icase` (`test_search_smartcase.c:26-41`).
fn sc_icase(ignorecase: bool, smartcase: bool, pat: List[byte]) -> bool {
    var err = search.re_err_new()
    let re = search.re_compile(pat, 0, mut err) else |_| {
        assert(false, "the probe compiles")
        return false
    }
    edit.search_wants_icase(re, opts(ignorecase, smartcase))
}

// `sc_matches` (`test_search_smartcase.c:43-62`): end to end.
fn sc_matches(ignorecase: bool, smartcase: bool, pat: str, subject: str) -> bool {
    var err = search.re_err_new()
    let re = edit.search_compile(bytes_of(pat), opts(ignorecase, smartcase), mut err) else |_| {
        assert(false, "{pat} compiles")
        return false
    }
    let bytes = bytes_of(subject)
    let inp = search.re_input_bytes(bytes.len)
    let tb = text.textbuf_new()
    var m = search.re_match_new()
    search.re_search(re, tb, bytes, inp, 0 as text.ByteOff, mut m)
}

struct ScCase {
    ignorecase: bool,
    smartcase: bool,
    pat: str,
    want: bool,
}

fn t_search_smartcase_table() {
    let rows = [
        ScCase { ignorecase: false, smartcase: false, pat: "foo", want: false },
        ScCase { ignorecase: false, smartcase: true, pat: "foo", want: false },
        ScCase { ignorecase: false, smartcase: true, pat: "Foo", want: false },
        ScCase { ignorecase: true, smartcase: false, pat: "foo", want: true },
        ScCase { ignorecase: true, smartcase: false, pat: "Foo", want: true },
        ScCase { ignorecase: true, smartcase: true, pat: "foo", want: true },
        ScCase { ignorecase: true, smartcase: true, pat: "Foo", want: false },
        ScCase { ignorecase: false, smartcase: false, pat: "\\cfoo", want: true },
        ScCase { ignorecase: false, smartcase: true, pat: "\\cFoo", want: true },
        ScCase { ignorecase: true, smartcase: false, pat: "\\Cfoo", want: false },
        ScCase { ignorecase: true, smartcase: true, pat: "\\Cfoo", want: false },
        ScCase { ignorecase: true, smartcase: true, pat: "\\CFoo", want: false },
    ]
    for r in rows {
        let got = sc_icase(r.ignorecase, r.smartcase, bytes_of(r.pat))
        assert(
            got == r.want,
            "smartcase /{r.pat}/ ic={r.ignorecase} sc={r.smartcase}: wanted {r.want}, got {got}",
        )
    }
}

// An uppercase BYTE inside an escape is not an uppercase literal.
fn t_search_smartcase_ignores_uppercase_inside_escapes() {
    let pats = ["\\Wfoo", "\\Sfoo", "\\Dfoo", "\\x41foo", "\\Afoo", "\\bfoo", "[[:upper:]]foo"]
    for p in pats {
        assert(sc_icase(true, true, bytes_of(p)), "/{p}/ flipped to case-sensitive")
    }
}

fn t_search_smartcase_backslash_w_still_matches_capitalized() {
    assert(sc_matches(true, true, "\\Wfoo", " Foo"), "\\Wfoo matches Foo")
    assert(!sc_matches(true, true, "\\WFoo", " foo"), "a real capital flips it")
    assert(sc_matches(true, true, "\\WFoo", " Foo"), "and matches itself")
}

fn t_search_smartcase_directives_match_end_to_end() {
    assert(sc_matches(false, true, "\\cFoo", "FOO"), "\\c wins with a capital")
    assert(sc_matches(false, true, "\\cfoo", "FOO"), "\\c wins")
    assert(!sc_matches(true, false, "\\Cfoo", "FOO"), "\\C wins over ignorecase")
    assert(sc_matches(true, false, "\\Cfoo", "foo"), "\\C still matches itself")
    assert(sc_matches(false, false, "\\cfoo", "foo"), "the directive consumes no input")
}

fn t_search_smartcase_uppercase_is_unicode_not_ascii() {
    var zhe = List[byte]()
    (mut zhe).push(208 as byte)
    (mut zhe).push(150 as byte)
    assert(!sc_icase(true, true, zhe), "Zhe is uppercase")
    var zhe_lower = List[byte]()
    (mut zhe_lower).push(208 as byte)
    (mut zhe_lower).push(182 as byte)
    assert(sc_icase(true, true, zhe_lower), "zhe is not")
}

fn t_search_opts_defaults() {
    let o = edit.search_opts_new()
    assert(!o.ignorecase, "exact case")
    assert(o.smartcase, "smartcase on")
    assert(o.wrapscan, "wrap on")
    assert(o.hlsearch, "highlight on")
    assert(!sc_matches(false, true, "foo", "FOO"), "defaults are case-sensitive")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_search_smartcase_table()
    t_search_smartcase_ignores_uppercase_inside_escapes()
    t_search_smartcase_backslash_w_still_matches_capitalized()
    t_search_smartcase_directives_match_end_to_end()
    t_search_smartcase_uppercase_is_unicode_not_ascii()
    t_search_opts_defaults()
    print("search_smartcase_test: 6 cases pass")
}
