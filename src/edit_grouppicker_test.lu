//! member: false
//!
//! The port of sagitta `tests/unit/test_grouppicker.c` (768 lines), one
//! test per C test in registry order (`tests/unit/registry.c:1800-1818`):
//! the group picker driven headless through its accessors (Sprint 24 §4)
//! and s57.13 §4's two row commands. What is tested is the dialog's MODEL
//! and the one thing it gets wrong built the obvious way: ticks that do
//! not survive walking to another directory — so every row that matters
//! walks. C's `mkdtemp` tree is a fresh `/tmp/yew-gp-NNNNNN`, canonical
//! from the start (on macOS /tmp is a link, and the picker stores
//! canonical paths): `<root>/a.txt b.txt sub/c.txt sub/d.txt`. C calls the
//! row commands' handlers directly (`gpt_run`); so does the port.
//!
//! **Port case** (`port_*`): ticks surviving a REAL walk, into `sub/` and
//! back out (s24 DoD 8) — C's own case presses Down, which moves the
//! cursor and walks nowhere.
//!
//! The non-regular fixture is C's FIFO, made by fs_mkfifo at 0.2.35;
//! the earlier /dev/null symlink stand-in is retired (G32).

use edit
use term
use text

// `gpt_make`'s `mkdtemp` (`test_grouppicker.c:51-78`).
fn fresh_dir(prefix: str) -> str {
    var tries = 0
    while tries < 100 {
        var suffix = ""
        for r in os_random(6) {
            suffix = suffix + "{r % 10}"
        }
        let dir = "/tmp/{prefix}-{suffix}"
        fs_create_dir_mode(dir, 448) else |e| match e {
            exists => {
                tries += 1
                continue
            },
            denied => { assert(false, "mkdtemp denied") },
            invalid => { assert(false, "mkdtemp invalid") },
            not_found => { assert(false, "mkdtemp not found") },
            unsupported => { assert(false, "mkdtemp unsupported") },
            io => { assert(false, "mkdtemp io") },
        }
        return dir
    }
    assert(false, "mkdtemp exhausted")
    ""
}

struct Tree {
    root: str,
    sub: str,
    a: str,
    b: str,
    c: str,
    d: str,
}

// `gpt_write` (`:42-49`).
fn gpt_write(path: str) {
    var body = List[byte]()
    for x in "contents of {path}\n".bytes() {
        (mut body).push(x)
    }
    fs_write_bytes(path, body) else |_| {
        assert(false, "write {path}")
    }
}

// `gpt_make` (`:51-78`).
fn gpt_make() -> Tree {
    let made = fresh_dir("yew-gp")
    let root = text.file_realpath(made) else made
    let sub = "{root}/sub"
    fs_create_dir_mode(sub, 448) else |_| {
        assert(false, "mkdir sub")
    }
    let t = Tree {
        root: root,
        sub: sub,
        a: "{root}/a.txt",
        b: "{root}/b.txt",
        c: "{sub}/c.txt",
        d: "{sub}/d.txt",
    }
    gpt_write(t.a)
    gpt_write(t.b)
    gpt_write(t.c)
    gpt_write(t.d)
    t
}

// `gpt_remove` (`:80-88`).
fn gpt_remove(t: Tree) {
    fs_remove(t.a) else |_| {}
    fs_remove(t.b) else |_| {}
    fs_remove(t.c) else |_| {}
    fs_remove(t.d) else |_| {}
    fs_remove_dir(t.sub) else |_| {}
    fs_remove_dir(t.root) else |_| {}
}

// `gpt_ed` (`:90-97`).
fn gpt_ed() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    ed
}

// `gpk` (`:99-112`).
fn gpk(code: int) -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    k.code = code
    if code >= 32 && code < 127 {
        (mut k.text).push(code as byte)
    }
    k
}

fn key(mut ed: edit.Ed, code: int) {
    assert(edit.gp_key(mut ed, gpk(code)), "the dialog takes key {code}")
}

fn cx(ed: edit.Ed) -> edit.CmdCtx {
    edit.cmdctx_new(ed.win, edit.SRC_TEST)
}

// `gpt_run(ed, yew_gp_cmd_toggle)` (`:537-546`).
fn toggle(mut ed: edit.Ed) -> int {
    let c = cx(ed)
    edit.gp_cmd_toggle(mut ed, c)
}

// `gpt_run(ed, yew_gp_cmd_confirm)`.
fn confirm(mut ed: edit.Ed) -> int {
    let c = cx(ed)
    edit.gp_cmd_confirm(mut ed, c)
}

// The listing of `t.root` (`:511-521`): `../` pinned, then directories,
// then files.
const GPT_ROW_SUB: int = 1

const GPT_ROW_A: int = 2

const GPT_ROW_B: int = 3

// `gpt_read_ticks` (`:523-535`): confirm through the KEY route, which
// leaves the result standing for the accessors.
fn read_ticks(mut ed: edit.Ed) {
    key(mut ed, term.KEY_TAB)
    key(mut ed, term.KEY_ENTER)
}

// `test_grouppicker_prefills_the_name_from_the_directory` (`:116-134`).
fn grouppicker_prefills_the_name_from_the_directory() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.sub), "shown")
    assert(edit.gp_active(ed), "up")
    assert(edit.gp_name(ed) == "sub/", "basename(dir)/: {edit.gp_name(ed)}")
    assert(edit.gp_show_edit(mut ed, t.sub, "backend"), "edit shown")
    assert(edit.gp_name(ed) == "backend", "the label in Edit mode")
    edit.gp_close(mut ed)
    gpt_remove(t)
}

// `test_grouppicker_ticks_survive_directory_navigation` (`:136-183`): THE
// test this file exists for.
fn grouppicker_ticks_survive_directory_navigation() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.root), "shown")
    edit.gp_preselect(mut ed, t.a)
    edit.gp_preselect(mut ed, t.b)
    key(mut ed, term.KEY_DOWN)
    edit.gp_preselect(mut ed, t.c)
    read_ticks(mut ed)
    assert(edit.gp_result(ed) == edit.GP_CONFIRMED, "confirmed")
    assert(edit.gp_count(ed) == 3, "three survive")
    var seen_a = 0
    var seen_c = 0
    var i = 0
    while i < edit.gp_count(ed) {
        let p = edit.gp_path(ed, i)
        assert(p.len != 0, "a path")
        if p.contains("a.txt") {
            seen_a += 1
        }
        if p.contains("c.txt") {
            seen_c += 1
        }
        i += 1
    }
    assert(seen_a == 1, "the root's tick, once")
    assert(seen_c == 1, "the other directory's tick, once")
    gpt_remove(t)
}

// `test_grouppicker_preselect_counts_an_out_of_dir_path` (`:185-204`).
fn grouppicker_preselect_counts_an_out_of_dir_path() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.sub), "shown")
    edit.gp_preselect(mut ed, t.a)
    edit.gp_preselect(mut ed, t.c)
    read_ticks(mut ed)
    assert(edit.gp_count(ed) == 2, "the parent's file counted")
    gpt_remove(t)
}

// `test_grouppicker_ticks_are_a_set` (`:206-223`).
fn grouppicker_ticks_are_a_set() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.root), "shown")
    edit.gp_preselect(mut ed, t.a)
    edit.gp_preselect(mut ed, t.a)
    edit.gp_preselect(mut ed, t.a)
    read_ticks(mut ed)
    assert(edit.gp_count(ed) == 1, "a set, not a list")
    gpt_remove(t)
}

// `test_grouppicker_refuses_an_empty_selection` (`:225-248`).
fn grouppicker_refuses_an_empty_selection() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.root), "shown")
    read_ticks(mut ed)
    assert(edit.gp_active(ed), "still up")
    assert(edit.gp_result(ed) == edit.GP_PENDING, "still pending")
    assert(edit.gp_count(ed) == 0, "nothing confirmed")
    edit.gp_close(mut ed)
    gpt_remove(t)
}

// `test_grouppicker_esc_cancels` (`:250-268`).
fn grouppicker_esc_cancels() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.root), "shown")
    edit.gp_preselect(mut ed, t.a)
    key(mut ed, term.KEY_ESCAPE)
    assert(!edit.gp_active(ed), "down")
    assert(edit.gp_result(ed) == edit.GP_CANCELLED, "cancelled")
    edit.gp_apply(mut ed)
    assert(ed.groups.len == 0, "no group came into existence")
    gpt_remove(t)
}

// `test_grouppicker_survives_a_key_storm` (`:270-309`): random keys never
// crash and never put a path in the set that was neither listed nor
// preselected.
fn grouppicker_survives_a_key_storm() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.root), "shown")
    let codes = [
        term.KEY_UP,
        term.KEY_DOWN,
        term.KEY_LEFT,
        term.KEY_RIGHT,
        term.KEY_TAB,
        term.KEY_ENTER,
        32,
        120,
        47,
        term.KEY_BACKSPACE,
    ]
    var seed = 19088743
    var op = 0
    while op < 3000 {
        seed = (seed * 1664525 + 1013904223) % 4294967296
        if !edit.gp_active(ed) {
            edit.gp_apply(mut ed)
            assert(edit.gp_show(mut ed, t.root), "reopened")
        }
        let _ = edit.gp_key(mut ed, gpk(codes[(seed >> 16) % 10]))
        op += 1
    }
    if edit.gp_result(ed) == edit.GP_CONFIRMED {
        var i = 0
        while i < edit.gp_count(ed) {
            assert(edit.gp_path(ed, i).contains(t.root), "a real path under the tree")
            i += 1
        }
    }
    edit.gp_close(mut ed)
    gpt_remove(t)
}

// `test_grouppicker_new_creates_the_group_deferred` (`:315-341`).
fn grouppicker_new_creates_the_group_deferred() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.root), "shown")
    edit.gp_preselect(mut ed, t.a)
    edit.gp_preselect(mut ed, t.b)
    read_ticks(mut ed)
    let base = text.file_load_count()
    edit.gp_apply(mut ed)
    assert(ed.groups.len == 1, "one group")
    assert(edit.group_member_count(ed, ed.groups[0].id) == 2, "two members")
    assert(text.file_load_count() == base, "not one file read to build it")
    gpt_remove(t)
}

// `test_grouppicker_new_adopts_an_already_open_file` (`:343-374`).
fn grouppicker_new_adopts_an_already_open_file() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.tab_open(mut ed, t.a) >= 0, "a open")
    let before = ed.tabs.len
    assert(edit.gp_show(mut ed, t.root), "shown")
    edit.gp_preselect(mut ed, t.a)
    edit.gp_preselect(mut ed, t.b)
    read_ticks(mut ed)
    edit.gp_apply(mut ed)
    assert(ed.tabs.len == before + 1, "one new tab, for b")
    assert(edit.group_member_count(ed, ed.groups[0].id) == 2, "both members")
    assert(edit.tab_find_by_path(ed, t.a) == edit.tab_find_by_path(ed, t.a), "one tab for a")
    gpt_remove(t)
}

// `test_grouppicker_edit_diffs_the_membership` (`:376-438`): from {a, b},
// confirming {a, c} adds c, keeps a, drops b and closes its tab.
fn grouppicker_edit_diffs_the_membership() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.root), "shown")
    edit.gp_preselect(mut ed, t.a)
    edit.gp_preselect(mut ed, t.b)
    read_ticks(mut ed)
    edit.gp_apply(mut ed)
    let gid = ed.groups[0].id
    assert(edit.group_member_count(ed, gid) == 2, "{{a, b}}")
    edit.group_enter(mut ed, gid)
    assert(edit.active_group_id(ed) == gid, "inside")
    let id = edit.cmd_lookup(ed.reg, "ed.group.edit")
    assert(id != 0, "ed.group.edit is registered")
    var c = cx(ed)
    assert(edit.ed_cmd_invoke(mut ed, id, mut c) == edit.CMD_OK, "edit opened")
    assert(edit.gp_active(ed), "up, both members ticked")
    edit.gp_preselect(mut ed, t.c)
    edit.gp_close(mut ed)
    assert(edit.gp_show_edit(mut ed, t.root, "src/"), "re-opened with exactly {{a, c}}")
    edit.gp_preselect(mut ed, t.a)
    edit.gp_preselect(mut ed, t.c)
    read_ticks(mut ed)
    assert(edit.gp_result(ed) == edit.GP_CONFIRMED, "confirmed")
    edit.gp_apply(mut ed)
    assert(edit.group_member_count(ed, gid) == 2, "two members")
    assert(edit.tab_find_by_path(ed, t.a) >= 0, "a stayed")
    assert(edit.tab_find_by_path(ed, t.c) >= 0, "c joined")
    assert(edit.tab_find_by_path(ed, t.b) == -1, "b left and its tab closed")
    gpt_remove(t)
}

// `test_grouppicker_apply_is_idempotent` (`:440-459`).
fn grouppicker_apply_is_idempotent() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.root), "shown")
    edit.gp_preselect(mut ed, t.a)
    read_ticks(mut ed)
    edit.gp_apply(mut ed)
    edit.gp_apply(mut ed)
    edit.gp_apply(mut ed)
    assert(ed.groups.len == 1, "consumed on the first apply")
    gpt_remove(t)
}

// `test_grouppicker_lists_only_directories_and_regular_files`
// (`:461-505`): C's non-regular FIFO fixture.
fn grouppicker_lists_only_directories_and_regular_files() {
    let t = gpt_make()
    let odd = "{t.root}/a-fifo"
    fs_mkfifo(odd, 384) else |e| {
        gpt_remove(t)
        assert(false, "mkfifo fixture: {e}")
        return
    }
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.root), "shown")
    var i = 0
    while i < 8 {
        key(mut ed, 32)
        i += 1
    }
    read_ticks(mut ed)
    var with_odd = 0
    if edit.gp_result(ed) == edit.GP_CONFIRMED {
        i = 0
        while i < edit.gp_count(ed) {
            if edit.gp_path(ed, i).contains("a-fifo") {
                with_odd += 1
            }
            i += 1
        }
    }
    assert(with_odd == 0, "the device is never offered")
    fs_remove(odd) else |_| {}
    gpt_remove(t)
}

// `test_grouppicker_toggle_command_ticks_the_selected_row` (`:548-587`).
fn grouppicker_toggle_command_ticks_the_selected_row() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.root), "shown")
    assert(edit.gp_select_row(mut ed, GPT_ROW_B), "b selected")
    assert(toggle(mut ed) == edit.CMD_OK, "toggled")
    read_ticks(mut ed)
    assert(edit.gp_count(ed) == 1, "one tick")
    assert(edit.gp_path(ed, 0) == t.b, "the row pointed at: {edit.gp_path(ed, 0)}")
    edit.gp_close(mut ed)
    assert(edit.gp_show(mut ed, t.root), "shown again")
    assert(edit.gp_select_row(mut ed, GPT_ROW_B), "b")
    assert(toggle(mut ed) == edit.CMD_OK, "on")
    assert(edit.gp_select_row(mut ed, GPT_ROW_B), "b")
    assert(toggle(mut ed) == edit.CMD_OK, "off")
    assert(confirm(mut ed) == edit.CMD_OK, "confirm runs")
    assert(edit.gp_active(ed), "refused: nothing ticked")
    assert(ed.groups.len == 0, "no group")
    edit.gp_close(mut ed)
    gpt_remove(t)
}

// `test_grouppicker_toggle_command_and_space_are_the_same_act`
// (`:589-627`).
fn grouppicker_toggle_command_and_space_are_the_same_act() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.root), "shown")
    assert(edit.gp_select_row(mut ed, GPT_ROW_A), "a")
    key(mut ed, 32)
    key(mut ed, 32)
    read_ticks(mut ed)
    assert(edit.gp_count(ed) == 2, "Space advanced and ticked b")
    assert(edit.gp_path(ed, 0) == t.a, "a first")
    assert(edit.gp_path(ed, 1) == t.b, "b second")
    edit.gp_close(mut ed)
    assert(edit.gp_show(mut ed, t.root), "shown again")
    assert(edit.gp_select_row(mut ed, GPT_ROW_A), "a")
    assert(toggle(mut ed) == edit.CMD_OK, "toggle a")
    assert(toggle(mut ed) == edit.CMD_OK, "toggle b")
    read_ticks(mut ed)
    assert(edit.gp_count(ed) == 2, "the same two")
    assert(edit.gp_path(ed, 0) == t.a, "a first")
    assert(edit.gp_path(ed, 1) == t.b, "b second")
    edit.gp_close(mut ed)
    gpt_remove(t)
}

// `test_grouppicker_toggle_command_walks_a_directory_row` (`:629-653`).
fn grouppicker_toggle_command_walks_a_directory_row() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.root), "shown")
    assert(edit.gp_select_row(mut ed, GPT_ROW_SUB), "sub/")
    assert(toggle(mut ed) == edit.CMD_OK, "walked")
    assert(edit.gp_select_row(mut ed, 2), "d.txt in sub/")
    assert(toggle(mut ed) == edit.CMD_OK, "ticked")
    read_ticks(mut ed)
    assert(edit.gp_count(ed) == 1, "one tick: the directory added nothing")
    assert(edit.gp_path(ed, 0) == t.d, "d: {edit.gp_path(ed, 0)}")
    edit.gp_close(mut ed)
    gpt_remove(t)
}

// `test_grouppicker_confirm_command_confirms_over_a_directory_row`
// (`:655-690`).
fn grouppicker_confirm_command_confirms_over_a_directory_row() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.root), "shown")
    edit.gp_preselect(mut ed, t.a)
    assert(edit.gp_select_row(mut ed, GPT_ROW_SUB), "a directory focused")
    assert(confirm(mut ed) == edit.CMD_OK, "confirmed")
    assert(!edit.gp_active(ed), "down: it confirmed rather than walked")
    assert(ed.groups.len == 1, "applied")
    assert(edit.group_member_count(ed, ed.groups[0].id) == 1, "one member")
    assert(edit.gp_result(ed) == edit.GP_PENDING, "the result consumed")
    gpt_remove(t)
}

// `test_grouppicker_confirm_command_refuses_an_empty_selection`
// (`:692-710`).
fn grouppicker_confirm_command_refuses_an_empty_selection() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.root), "shown")
    assert(confirm(mut ed) == edit.CMD_OK, "runs")
    assert(edit.gp_active(ed), "up, wearing its note")
    assert(edit.gp_result(ed) == edit.GP_PENDING, "pending")
    assert(ed.groups.len == 0, "no group")
    edit.gp_close(mut ed)
    gpt_remove(t)
}

// `test_grouppicker_row_commands_refuse_when_the_dialog_is_down`
// (`:712-735`).
fn grouppicker_row_commands_refuse_when_the_dialog_is_down() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(!edit.gp_active(ed), "down")
    assert(toggle(mut ed) == edit.CMD_ERR_STATE, "toggle refuses")
    assert(confirm(mut ed) == edit.CMD_ERR_STATE, "confirm refuses")
    assert(ed.groups.len == 0, "no group")
    assert(!edit.gp_select_row(mut ed, 0), "nothing to focus")
    gpt_remove(t)
}

// `test_grouppicker_select_row_rejects_an_index_that_is_gone`
// (`:737-768`).
fn grouppicker_select_row_rejects_an_index_that_is_gone() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.root), "shown")
    assert(edit.gp_select_row(mut ed, GPT_ROW_B), "row 3")
    assert(!edit.gp_select_row(mut ed, 4), "no row 4")
    assert(!edit.gp_select_row(mut ed, -1), "no row -1")
    assert(edit.gp_select_row(mut ed, GPT_ROW_SUB), "sub/")
    assert(toggle(mut ed) == edit.CMD_OK, "walked into sub/")
    assert(!edit.gp_select_row(mut ed, 3), "index 3 is gone in sub/")
    assert(edit.gp_count(ed) == 0, "nothing acted on")
    edit.gp_close(mut ed)
    gpt_remove(t)
}

// Port: DoD 8 with a REAL walk. C's `ticks_survive_directory_navigation`
// presses Down (a cursor move, not a walk), so a dialog that dropped its
// ticks on every re-list passes C's whole file
// (`notes/yw05-evidence/groups/plants/grouppicker-walk-uncaught.txt`).
// Here the walk is into `sub/` and back out through Left, a tick on each
// side.
fn port_grouppicker_ticks_survive_a_real_walk() {
    let t = gpt_make()
    var ed = gpt_ed()
    assert(edit.gp_show(mut ed, t.root), "shown")
    assert(edit.gp_select_row(mut ed, GPT_ROW_A), "a")
    key(mut ed, 32)
    assert(edit.gp_select_row(mut ed, GPT_ROW_SUB), "sub/")
    key(mut ed, 32)
    assert(edit.gp_select_row(mut ed, 1), "c.txt in sub/")
    key(mut ed, 32)
    key(mut ed, term.KEY_LEFT)
    read_ticks(mut ed)
    assert(edit.gp_count(ed) == 2, "both survive two walks: {edit.gp_count(ed)}")
    assert(edit.gp_path(ed, 0) == t.a, "a, ticked before the walk")
    assert(edit.gp_path(ed, 1) == t.c, "c, ticked in sub/")
    gpt_remove(t)
}

fn main() {
    grouppicker_prefills_the_name_from_the_directory()
    grouppicker_ticks_survive_directory_navigation()
    grouppicker_preselect_counts_an_out_of_dir_path()
    grouppicker_ticks_are_a_set()
    grouppicker_refuses_an_empty_selection()
    grouppicker_esc_cancels()
    grouppicker_survives_a_key_storm()
    grouppicker_new_creates_the_group_deferred()
    grouppicker_new_adopts_an_already_open_file()
    grouppicker_edit_diffs_the_membership()
    grouppicker_apply_is_idempotent()
    grouppicker_lists_only_directories_and_regular_files()
    grouppicker_toggle_command_ticks_the_selected_row()
    grouppicker_toggle_command_and_space_are_the_same_act()
    grouppicker_toggle_command_walks_a_directory_row()
    grouppicker_confirm_command_confirms_over_a_directory_row()
    grouppicker_confirm_command_refuses_an_empty_selection()
    grouppicker_row_commands_refuse_when_the_dialog_is_down()
    grouppicker_select_row_rejects_an_index_that_is_gone()
    port_grouppicker_ticks_survive_a_real_walk()
    print("grouppicker_test: 19 cases pass, 0 SKIP; 1 port case passes")
}
