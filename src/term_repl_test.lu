//! member: false
//! The REPL's per-terminal raw-output policy (sagitta tty.c:514-562).
//! Supplements test_tty without changing any pinned unit case.

use term

fn main() {
    var editor = term.tty_new()
    var repl = term.tty_new()
    let editor_mode = term.rawios()
    assert(term.tty_raw_mode(editor) == editor_mode)
    term.tty_set_output_processing(mut repl, true)
    assert(term.tty_raw_mode(repl) == editor_mode - term.MODE_RAW_OUTPUT)
    assert(term.tty_raw_mode(editor) == editor_mode)
    assert(term.tty_raw_mode(repl) & term.MODE_RAW_CR != 0)
    assert(term.tty_raw_mode(repl) & term.MODE_RAW_OUTPUT == 0)
    term.tty_set_output_processing(mut repl, false)
    assert(term.tty_raw_mode(repl) == editor_mode)
    print("term_repl: output processing is per terminal: PASS")
}
