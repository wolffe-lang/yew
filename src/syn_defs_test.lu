//! member: false
//! Ports sagitta tests/unit/test_syn_defs.c at 9ace98c2, one case per C test
//! in its order. Messages and spans are compared byte for byte with the C
//! sink's; every message is also rendered through the shared caret layout.
//! tests/fixtures/syn/ini.fl is the pin's runtime/syntax/ini.fl, byte for
//! byte. Two C assertions read the process-wide language registry
//! (`yew_syn_lang_for`, `yew_syn_lang_named`); wolf compiles without
//! registering, so they read the compiled descriptor and an explicit
//! registry instead.

use fl
use syn

fn compile(source: str) -> syn.SynCompileResult {
    syn.syn_compile("test.fl", source.bytes())
}

fn attr(name: str) -> int {
    syn.syn_attr_id(name) else -1
}

fn bytes_is(bytes: List[byte], text: str) -> bool {
    if bytes.len != text.len then return false
    var i = 0
    for b in text.bytes() {
        if bytes[i] != b then return false
        i += 1
    }
    true
}

fn bytes_has(bytes: List[byte], text: str) -> bool {
    let n = text.len
    if n == 0 then return true
    var at = 0
    while at + n <= bytes.len {
        var same = true
        var i = 0
        for b in text.bytes() {
            if bytes[at + i] != b {
                same = false
                break
            }
            i += 1
        }
        if same then return true
        at += 1
    }
    false
}

// The C sink keeps every message; the rendered form carries it verbatim.
fn rendered_carries(c: syn.SynCompileResult, index: int) -> bool {
    var out = List[byte]()
    syn.syn_compile_diagnostic_render(mut out, c, index)
    bytes_has(out, str_from_utf8(copy c.messages[index]) else "")
}

fn diag_has(c: syn.SynCompileResult, level: int, message: str) -> bool {
    for i in 0..c.diagnostics.entries.len {
        if c.diagnostics.entries[i].level == level && bytes_is(c.messages[i], message) {
            return rendered_carries(c, i)
        }
    }
    false
}

fn expect_one_error(source: str, message: str, line: int, col: int) {
    let c = compile(source)
    assert(!c.valid, "an error refuses the definition")
    assert(c.diagnostics.nerrors == 1, "exactly one error")
    assert(c.diagnostics.nwarnings == 0, "no warnings")
    assert(c.diagnostics.entries.len == 1, "exactly one diagnostic")
    assert(c.diagnostics.entries[0].level == fl.FL_DIAG_ERROR, "error level")
    assert(bytes_is(c.messages[0], message), "message: {message}")
    assert(rendered_carries(c, 0), "rendered message")
    assert(c.diagnostics.entries[0].sp.file_id == 0, "span file")
    assert(c.diagnostics.entries[0].sp.line == line, "span line {line}")
    assert(c.diagnostics.entries[0].sp.col == col, "span column {col}")
    assert(c.diagnostics.entries[0].sp.len > 0, "nonempty span")
}

// test_syn_defs_ini_compiles_to_expected_context_table
fn ini_compiles_to_expected_context_table() {
    let source = fs_read_bytes("tests/fixtures/syn/ini.fl") else {
        assert(false, "ini fixture readable")
        return
    }
    let c = syn.syn_compile("runtime/syntax/ini.fl", source)
    assert(c.valid, "ini compiles")
    assert(c.diagnostics.nerrors == 0 && c.diagnostics.nwarnings == 0, "no diagnostics counted")
    assert(c.diagnostics.entries.len == 0, "no diagnostics emitted")
    assert(bytes_is(c.definition.name, "ini"), "name")
    assert(c.definition.root == 0, "root")
    assert(c.definition.contexts.len == 5, "five contexts")
    assert(c.definition.rules.len == 16, "sixteen rules")
    let names: List[str] = ["main", "value", "strings", "dq", "sq"]
    let first: List[int] = [0, 5, 11, 13, 15]
    let count: List[int] = [5, 6, 2, 2, 1]
    let dflt: List[int] = [attr("text"), attr("text"), attr("text"), attr("string"), attr("string")]
    let eol: List[int] = [
        syn.SYN_OP_STAY,
        syn.SYN_OP_POP,
        syn.SYN_OP_STAY,
        syn.SYN_OP_POP,
        syn.SYN_OP_POP,
    ]
    let flags: List[int] = [
        0,
        syn.SYN_CTX_UNIT_SPAN,
        0,
        syn.SYN_CTX_UNIT_ATOM,
        syn.SYN_CTX_UNIT_ATOM,
    ]
    for i in 0..5 {
        assert(bytes_is(c.definition.context_names[i], names[i]), "context name")
        assert(c.definition.contexts[i].first_rule == first[i], "first rule")
        assert(c.definition.contexts[i].nrules == count[i], "rule count")
        assert(c.definition.contexts[i].default_attr == dflt[i], "default attr")
        assert(c.definition.contexts[i].eol_op == eol[i], "at_eol")
        assert(c.definition.contexts[i].flags == flags[i], "unit flags")
    }
    assert(
        c.definition.contexts[1].eol_nop == 1 &&
            c.definition.contexts[3].eol_nop == 1 &&
            c.definition.contexts[4].eol_nop == 1,
        "eol pops",
    )
    assert(c.definition.context_names.len == 5, "no sixth context name")
    assert(bytes_is(c.definition.patterns[5], "\""), "rule 5 pattern")
    assert(bytes_is(c.definition.patterns[6], "'"), "rule 6 pattern")
    assert(bytes_is(c.definition.patterns[7], "[;#].*$"), "rule 7 pattern")
    assert(c.definition.rules[2].consume == 1, "consume")
    assert(c.definition.rules[2].caps[1] as int == attr("variable.member"), "capture 1")
    assert(
        c.definition.rules[3].op == syn.SYN_OP_PUSH && c.definition.rules[3].target == 1,
        "rule 3 push",
    )
    assert(
        c.definition.rules[5].op == syn.SYN_OP_PUSH && c.definition.rules[5].target == 3,
        "rule 5 push",
    )
    assert(c.definition.rules[6].target == 4, "rule 6 target")
    assert(c.definition.rules[8].attr == attr("boolean"), "rule 8 attr")
    assert(c.definition.rules[9].attr == attr("number"), "rule 9 attr")
    assert(c.definition.rules[10].attr == attr("variable"), "rule 10 attr")
    assert(c.definition.rules[13].attr == attr("string.escape"), "rule 13 attr")
    assert(
        c.definition.rules[14].op == syn.SYN_OP_POP && c.definition.rules[14].nop == 1,
        "rule 14 pop",
    )
    assert(c.definition.patterns.len == c.definition.rules.len, "no pattern past the last rule")
}

// test_syn_defs_alias_include_and_rule_features_pack
fn alias_include_and_rule_features_pack() {
    var c = compile(
        "{{ syntax: 1, attrs: {{ kw: \"keyword.control\" }},\n  language: {{ name: \"features\", extensions: [\"feat\"],\n    filenames: [\"Featurefile\", \"*.feature\"],\n    shebangs: [\"feature\"], first_line: \"^FEATURE\", priority: 7,\n    comment: {{ line: \"//\", block: [\"/*\", \"*/\"] }} }},\n  root: \"main\", contexts: {{\n    main: {{ include: \"common\", rules: [\n      {{ match: \"(B)(C)\", captures: {{ 1: \"number\", 2: \"string\" }},\n        consume: 1, push: [\"left\", \"right\"], set_aux: 2, strip: true, value: true }},\n      {{ match: \"D\", set: \"left\", value: false, if_value: true }},\n      {{ aux: \"line_eq\", pop: true }},\n      {{ match: \"( +)([1-9]?)I\", set_aux: 1, aux_int: true, aux_add: 1,\n        aux_add_capture: 2, push: \"indent\" }} ] }},\n    common: {{ icase: true, rules: [{{ match: \"A\", attr: \"kw\", first_line: true }}] }},\n    left: {{ at_eol: \"set:main\", rules: [\n      {{ aux: \"literal\", aux_pre: \"r\", aux_post: \"#\", pop: 1 }} ] }},\n    right: {{ at_eol: \"pop:2\", rules: [\n      {{ aux: \"fence_close\", pop: 1 }} ] }},\n    indent: {{ rules: [ {{ aux: \"indent_lt\", pop: 1 }} ] }},\n  }} }}",
    )
    assert(c.valid, "features compile")
    assert(c.diagnostics.nerrors == 0 && c.diagnostics.nwarnings == 0, "clean")
    assert(
        c.definition.contexts.len == 5 && c.definition.rules.len == 9,
        "five contexts, nine rules",
    )
    assert(
        bytes_is(c.definition.context_names[0], "main") &&
            bytes_is(c.definition.context_names[1], "common"),
        "context names",
    )
    assert(bytes_is(c.definition.patterns[0], "A"), "included rule first")
    assert(c.definition.rules[0].attr == attr("keyword.control"), "alias attr")
    assert(c.definition.rules[0].flags & syn.SYN_RULE_FIRST_LINE != 0, "first_line flag")
    assert(bytes_is(c.definition.patterns[1], "(B)(C)"), "rule 1 pattern")
    assert(
        c.definition.rules[1].caps[1] as int == attr("number") &&
            c.definition.rules[1].caps[2] as int == attr("string"),
        "captures",
    )
    assert(c.definition.rules[1].consume == 1, "consume")
    assert(c.definition.rules[1].op == syn.SYN_OP_PUSH, "push op")
    assert(
        c.definition.rules[1].pushes.len == 2 &&
            c.definition.rules[1].pushes[0] == 2 &&
            c.definition.rules[1].pushes[1] == 3,
        "push list",
    )
    assert(c.definition.rules[1].flags & syn.SYN_RULE_SET_AUX != 0, "set_aux")
    assert(c.definition.rules[1].flags & syn.SYN_RULE_STRIP != 0, "strip")
    assert(c.definition.rules[1].flags & syn.SYN_RULE_SET_VALUE != 0, "value")
    assert(c.definition.rules[1].aux_group == 2, "aux group")
    assert(c.definition.rules[2].op == syn.SYN_OP_SET && c.definition.rules[2].target == 2, "set")
    assert(c.definition.rules[2].flags & syn.SYN_RULE_CLR_VALUE != 0, "value false")
    assert(c.definition.rules[2].value_pred == syn.SYN_VALUE_SET, "if_value")
    assert(
        c.definition.rules[3].aux_match == syn.SYN_AUXM_LINE_EQ &&
            c.definition.rules[3].op == syn.SYN_OP_POP,
        "line_eq pop",
    )
    assert(
        c.definition.rules[4].op == syn.SYN_OP_PUSH && c.definition.rules[4].target == 4,
        "indent push",
    )
    assert(c.definition.rules[4].flags & syn.SYN_RULE_AUX_INT != 0, "aux_int")
    assert(
        c.definition.rules[4].aux_add == 1 && c.definition.rules[4].aux_add_group == 2,
        "aux_add",
    )
    assert(c.definition.rules[5].attr == attr("keyword.control"), "include repeated")
    assert(c.definition.rules[6].aux_match == syn.SYN_AUXM_LITERAL, "literal")
    assert(
        c.definition.rules[6].aux_pre != 0 && c.definition.rules[6].aux_post != 0,
        "literal pre/post",
    )
    assert(c.definition.rules[7].aux_match == syn.SYN_AUXM_FENCE_CLOSE, "fence_close")
    assert(c.definition.rules[8].aux_match == syn.SYN_AUXM_INDENT_LT, "indent_lt")
    assert(c.definition.rules[8].flags & syn.SYN_RULE_ZERO_TRANSITION != 0, "zero transition")
    assert(c.definition.rules[8].op == syn.SYN_OP_POP, "indent pop")
    assert(
        c.definition.contexts[2].eol_op == syn.SYN_OP_SET &&
            c.definition.contexts[2].eol_target == 0,
        "set:main",
    )
    assert(
        c.definition.contexts[3].eol_op == syn.SYN_OP_POP && c.definition.contexts[3].eol_nop == 2,
        "pop:2",
    )
    // The descriptor through detection, as C reads it: registered, then
    // yew_syn_lang_for("x.feat") and yew_syn_lang_desc.
    var reg = syn.syn_registry_new()
    var pool = syn.syn_pool_new()
    let registered = syn.syn_registry_register(mut reg, mut pool, take c.definition, "features.fl")
    let lang_id = syn.syn_registry_lang_for(mut reg, "x.feat", List[byte](), false)
    assert(lang_id != 0 && lang_id == registered, "x.feat detects the registered language")
    let lang = syn.syn_registry_desc(reg, lang_id) else {
        assert(false, "descriptor exists")
        return
    }
    assert(bytes_is(lang.name, "features"), "descriptor name")
    assert(lang.priority == 7, "descriptor priority")
    assert(bytes_is(lang.comment_line, "//"), "line comment")
    assert(bytes_is(lang.comment_open, "/*") && bytes_is(lang.comment_close, "*/"), "block comment")
}

// test_syn_defs_unknown_schema_diagnostic_is_exact_and_spanned
fn unknown_schema_diagnostic_is_exact_and_spanned() {
    expect_one_error(
        "{{\n    syntax: 2,\n    language: {{ name: \"diag\" }},\n    contexts: {{ main: {{ rules: [] }} }},\n}}\n",
        "unknown schema version 2 (this build understands 1)",
        2,
        13,
    )
}

// test_syn_defs_unknown_rule_key_suggests_match
fn unknown_rule_key_suggests_match() {
    expect_one_error(
        "{{\n  syntax: 1,\n  language: {{ name: \"diag\" }},\n  contexts: {{\n    main: {{\n      rules: [{{ matchh: \"x\" }}],\n    }},\n  }},\n}}\n",
        "unknown key 'matchh' (did you mean 'match'?)",
        6,
        17,
    )
}

// test_syn_defs_unknown_attr_suggests_string
fn unknown_attr_suggests_string() {
    expect_one_error(
        "{{ syntax: 1, language: {{ name: \"diag\" }}, contexts: {{\n  main: {{ rules: [{{ match: \"x\", attr: \"strng\" }}] }},\n}} }}",
        "unknown attr 'strng' (did you mean 'string'?)",
        2,
        39,
    )
}

// test_syn_defs_unknown_push_context_is_rejected
fn unknown_push_context_is_rejected() {
    expect_one_error(
        "{{ syntax: 1, language: {{ name: \"diag\" }}, contexts: {{\n  main: {{ rules: [{{ match: \"x\", push: \"strings2\" }}] }},\n}} }}",
        "no context named 'strings2'",
        2,
        39,
    )
}

// test_syn_defs_two_state_operations_are_rejected
fn two_state_operations_are_rejected() {
    expect_one_error(
        "{{ syntax: 1, language: {{ name: \"diag\" }}, contexts: {{\n  main: {{ rules: [{{ match: \"x\", push: \"child\", pop: 1 }}] }},\n  child: {{ rules: [{{ match: \"x\", pop: 1 }}] }},\n}} }}",
        "rule has both 'push' and 'pop'; a rule performs exactly one state op",
        2,
        19,
    )
}

// test_syn_defs_consume_requires_an_existing_capture
fn consume_requires_an_existing_capture() {
    expect_one_error(
        "{{ syntax: 1, language: {{ name: \"diag\" }}, contexts: {{\n  main: {{ rules: [{{ match: \"(a)(b)\", consume: 3 }}] }},\n}} }}",
        "consume: 3 but the pattern has 2 capture groups",
        2,
        47,
    )
}

// test_syn_defs_capture_index_is_bounded_to_seven
fn capture_index_is_bounded_to_seven() {
    expect_one_error(
        "{{ syntax: 1, language: {{ name: \"diag\" }}, contexts: {{\n  main: {{ rules: [{{ match: \"(a)\", captures: {{ 9: \"string\" }} }}] }},\n}} }}",
        "capture group 9 is out of range (0-7)",
        2,
        47,
    )
}

// test_syn_defs_invalid_pattern_reports_pattern_offset
fn invalid_pattern_reports_pattern_offset() {
    let c = compile(
        "{{ syntax: 1, language: {{ name: \"diag\" }}, contexts: {{\n  main: {{ rules: [{{ match: \"[abc\" }}] }},\n}} }}",
    )
    assert(!c.valid, "refused")
    assert(c.diagnostics.nerrors == 1 && c.diagnostics.nwarnings == 0, "one error")
    assert(c.diagnostics.entries.len == 1, "one diagnostic")
    assert(c.diagnostics.entries[0].sp.file_id == 0, "span file")
    assert(
        c.diagnostics.entries[0].sp.line == 2 && c.diagnostics.entries[0].sp.col == 28,
        "pattern offset span",
    )
    assert(bytes_has(c.messages[0], "invalid pattern at offset"), "offset message")
    assert(bytes_has(c.messages[0], "unterminated"), "parser reason")
    assert(rendered_carries(c, 0), "rendered message")
}

// test_syn_defs_pop_count_above_four_is_rejected
fn pop_count_above_four_is_rejected() {
    expect_one_error(
        "{{ syntax: 1, language: {{ name: \"diag\" }}, contexts: {{\n  main: {{ rules: [{{ match: \"x\", pop: 5 }}] }},\n}} }}",
        "pop count 5 is out of range (1-4)",
        2,
        38,
    )
}

// test_syn_defs_push_list_above_four_is_rejected
fn push_list_above_four_is_rejected() {
    let c = compile(
        "{{ syntax: 1, language: {{ name: \"diag\" }}, contexts: {{\n  main: {{ rules: [{{ match: \"x\", push: [\"a\",\"b\",\"c\",\"d\",\"e\"] }}] }},\n  a:{{rules:[{{match:\"x\",pop:1}}]}}, b:{{rules:[{{match:\"x\",pop:1}}]}},\n  c:{{rules:[{{match:\"x\",pop:1}}]}}, d:{{rules:[{{match:\"x\",pop:1}}]}},\n  e:{{rules:[{{match:\"x\",pop:1}}]}},\n}} }}",
    )
    assert(!c.valid, "refused")
    assert(c.diagnostics.nerrors >= 1, "an error")
    assert(
        diag_has(c, fl.FL_DIAG_ERROR, "push list has 5 entries (limit 1-4)"),
        "push list message",
    )
}

// test_syn_defs_include_cycle_is_rejected
fn include_cycle_is_rejected() {
    let c = compile(
        "{{ syntax: 1, language: {{ name: \"diag\" }}, contexts: {{\n  main: {{ include: \"escapes\", rules: [] }},\n  escapes: {{ include: \"main\", rules: [] }},\n}} }}",
    )
    assert(!c.valid, "refused")
    assert(c.diagnostics.nerrors >= 1 && c.diagnostics.entries.len >= 1, "an error")
    assert(bytes_has(c.messages[0], "include cycle reaches"), "cycle message")
    assert(
        c.diagnostics.entries[0].sp.line >= 2 && c.diagnostics.entries[0].sp.col > 0,
        "cycle span",
    )
    assert(rendered_carries(c, 0), "rendered message")
}

// test_syn_defs_reachable_context_must_have_a_reducing_edge
fn reachable_context_must_have_a_reducing_edge() {
    expect_one_error(
        "{{ syntax: 1, language: {{ name: \"diag\" }}, contexts: {{\n  main: {{ rules: [{{ match: \"x\", push: \"stuck\" }}] }},\n  stuck: {{ rules: [{{ match: \"y\" }}] }},\n}} }}",
        "context 'stuck' can never be popped",
        3,
        10,
    )
}

// test_syn_defs_indent_lt_must_be_first_and_pop
fn indent_lt_must_be_first_and_pop() {
    let c = compile(
        "{{ syntax: 1, language: {{ name: \"diag\" }}, contexts: {{\n  main: {{ rules: [{{ match: \"x\" }}, {{ aux: \"indent_lt\", pop: 1 }}] }},\n}} }}",
    )
    assert(!c.valid, "refused")
    assert(c.diagnostics.nerrors == 1, "one error")
    assert(
        diag_has(c, fl.FL_DIAG_ERROR, "indent_lt must be the first rule in its context"),
        "indent message",
    )
}

// test_syn_defs_static_push_depth_reserves_four_runtime_frames
fn static_push_depth_reserves_four_runtime_frames() {
    expect_one_error(
        "{{ syntax: 1, language: {{ name: \"deep\" }}, contexts: {{\nmain:{{rules:[{{match:\"a\",push:\"c1\"}}]}},\nc1:{{rules:[{{match:\"a\",push:\"c2\"}},{{match:\"z\",pop:1}}]}},\nc2:{{rules:[{{match:\"a\",push:\"c3\"}},{{match:\"z\",pop:1}}]}},\nc3:{{rules:[{{match:\"a\",push:\"c4\"}},{{match:\"z\",pop:1}}]}},\nc4:{{rules:[{{match:\"a\",push:\"c5\"}},{{match:\"z\",pop:1}}]}},\nc5:{{rules:[{{match:\"a\",push:\"c6\"}},{{match:\"z\",pop:1}}]}},\nc6:{{rules:[{{match:\"a\",push:\"c7\"}},{{match:\"z\",pop:1}}]}},\nc7:{{rules:[{{match:\"a\",push:\"c8\"}},{{match:\"z\",pop:1}}]}},\nc8:{{rules:[{{match:\"a\",push:\"c9\"}},{{match:\"z\",pop:1}}]}},\nc9:{{rules:[{{match:\"a\",push:\"c10\"}},{{match:\"z\",pop:1}}]}},\nc10:{{rules:[{{match:\"a\",push:\"c11\"}},{{match:\"z\",pop:1}}]}},\nc11:{{rules:[{{match:\"a\",push:\"c12\"}},{{match:\"z\",pop:1}}]}},\nc12:{{rules:[{{match:\"z\",pop:1}}]}}\n}} }}",
        "context nesting can reach depth 13; the cap is 16 with 4 levels reserved for runtime recursion (see YEW_SYN_DEPTH_MAX)",
        2,
        6,
    )
}

// test_syn_defs_multi_push_depth_uses_maximum_live_branch
fn multi_push_depth_uses_maximum_live_branch() {
    let c = compile(
        "{{syntax:1,language:{{name:\"multi-depth\"}},contexts:{{\nmain:{{rules:[{{match:\"m\",push:[\"a\",\"b\",\"c\",\"d\"]}}]}},\na:{{rules:[{{match:\"x\",push:\"a1\"}},{{match:\"p\",pop:1}}]}},a1:{{rules:[{{match:\"x\",push:\"a2\"}},{{match:\"p\",pop:1}}]}},a2:{{rules:[{{match:\"p\",pop:1}}]}},\nb:{{rules:[{{match:\"x\",push:\"b1\"}},{{match:\"p\",pop:1}}]}},b1:{{rules:[{{match:\"x\",push:\"b2\"}},{{match:\"p\",pop:1}}]}},b2:{{rules:[{{match:\"p\",pop:1}}]}},\nc:{{rules:[{{match:\"x\",push:\"c1\"}},{{match:\"p\",pop:1}}]}},c1:{{rules:[{{match:\"x\",push:\"c2\"}},{{match:\"p\",pop:1}}]}},c2:{{rules:[{{match:\"p\",pop:1}}]}},\nd:{{rules:[{{match:\"x\",push:\"d1\"}},{{match:\"p\",pop:1}}]}},d1:{{rules:[{{match:\"x\",push:\"d2\"}},{{match:\"p\",pop:1}}]}},d2:{{rules:[{{match:\"p\",pop:1}}]}} }} }}",
    )
    assert(c.valid, "four short live branches compile")
    assert(c.diagnostics.nerrors == 0, "no error")
}

// test_syn_defs_invalid_first_line_uses_literal_span
fn invalid_first_line_uses_literal_span() {
    let c = compile(
        "{{ syntax: 1,\n  language: {{ name: \"first\", first_line: \"[\" }},\n  contexts: {{ main: {{ rules: [] }} }} }}",
    )
    assert(!c.valid, "refused")
    assert(c.diagnostics.nerrors == 1, "one error")
    assert(c.diagnostics.entries.len == 1, "one diagnostic")
    assert(c.diagnostics.entries[0].sp.line == 2, "literal line")
    assert(c.diagnostics.entries[0].sp.col == 42, "literal column")
    assert(c.diagnostics.entries[0].sp.len == 3, "literal length")
    assert(bytes_has(c.messages[0], "invalid first_line pattern"), "first_line message")
    assert(rendered_carries(c, 0), "rendered message")
    // C: a refused definition registers no language (yew_syn_lang_named).
    let reg = syn.syn_registry_new()
    assert(syn.syn_registry_lang_named(reg, "first".bytes()) == 0, "nothing registered")
}

// test_syn_defs_validation_warnings_are_nonfatal_and_exact
fn validation_warnings_are_nonfatal_and_exact() {
    let c = compile(
        "{{ syntax: 1, language: {{ name: \"warnings\" }}, contexts: {{\n  main: {{ default: \"error\", rules: [\n    {{ match: \"x\" }}, {{ match: \"x\" }},\n    {{ match: \"y\", push: \"user\" }},\n    {{ match: \"\\\\S+\" }}, {{ match: \"word\" }}] }},\n  legacy: {{ rules: [] }},\n  shared: {{ default: \"text\", rules: [{{ match: \"z\" }}] }},\n  user: {{ include: \"shared\", at_eol: \"pop\", rules: [] }},\n}} }}",
    )
    assert(c.valid, "warnings are not fatal")
    assert(c.diagnostics.nerrors == 0, "no error")
    assert(c.diagnostics.nwarnings == 5, "five warnings")
    let w = fl.FL_DIAG_WARNING
    assert(
        diag_has(c, w, "default: 'error' paints every unmatched byte red; did you mean 'text'?"),
        "error default",
    )
    assert(
        diag_has(c, w, "rule 2 is unreachable: rule 1 has the same pattern"),
        "duplicate pattern",
    )
    assert(
        diag_has(c, w, "rule 5 is unreachable: rule 4 (line 5) matches everything it could match"),
        "shadowed rule",
    )
    assert(diag_has(c, w, "context 'legacy' is unreachable"), "unreachable context")
    assert(diag_has(c, w, "only 'rules' is used at an include site"), "include-site keys")
}

// test_syn_defs_line_eq_ws_is_in_the_closed_aux_set
fn line_eq_ws_is_in_the_closed_aux_set() {
    let c = compile(
        "{{ syntax: 1, language: {{ name: \"line-eq-ws\" }}, contexts: {{\n  main: {{ rules: [{{ match: \"(END)\", set_aux: 1, push: \"body\" }}] }},\n  body: {{ rules: [{{ aux: \"line_eq_ws\", pop: 1 }}] }},\n}} }}",
    )
    assert(c.valid, "line_eq_ws compiles")
    assert(c.diagnostics.nerrors == 0 && c.diagnostics.nwarnings == 0, "clean")
    assert(c.definition.rules.len == 2, "two rules")
    assert(c.definition.rules[1].aux_match == syn.SYN_AUXM_LINE_EQ_WS, "line_eq_ws aux")
}

fn main() {
    let selected = (env_get("YEW_SYN_DEFS_CASE") else "-1").to_int() else -1
    for i in 0..20 {
        if selected == -1 || selected == i {
            match i {
                0 => ini_compiles_to_expected_context_table(),
                1 => alias_include_and_rule_features_pack(),
                2 => unknown_schema_diagnostic_is_exact_and_spanned(),
                3 => unknown_rule_key_suggests_match(),
                4 => unknown_attr_suggests_string(),
                5 => unknown_push_context_is_rejected(),
                6 => two_state_operations_are_rejected(),
                7 => consume_requires_an_existing_capture(),
                8 => capture_index_is_bounded_to_seven(),
                9 => invalid_pattern_reports_pattern_offset(),
                10 => pop_count_above_four_is_rejected(),
                11 => push_list_above_four_is_rejected(),
                12 => include_cycle_is_rejected(),
                13 => reachable_context_must_have_a_reducing_edge(),
                14 => indent_lt_must_be_first_and_pop(),
                15 => static_push_depth_reserves_four_runtime_frames(),
                16 => multi_push_depth_uses_maximum_live_branch(),
                17 => invalid_first_line_uses_literal_span(),
                18 => validation_warnings_are_nonfatal_and_exact(),
                _ => line_eq_ws_is_in_the_closed_aux_set(),
            }
            print("syn_defs_case_{i}: PASS")
        }
    }
}
