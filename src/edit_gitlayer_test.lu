//! member: false
//!
//! The port of sagitta `tests/script/git_layer.c` (927 lines, `make
//! test-git-script`): the s51 layer against REAL git over the fixture
//! `tests/fixtures/git/mkrepo.sh` builds (sagitta's own, copied with its
//! pinned hash ledger), each check a case in C's `main` order — the status
//! grammar over a repository holding every kind C's fixture plants, the
//! upstream and incoming paths, a copied entry and the argv law for its
//! two paths, `ed.git.info` in every mid-operation state, the ignore set's
//! directory compaction over 5,000 files, and the spawn environment's
//! sanitation through a fake `git` on `PATH` — then two port cases over
//! `tests/fixtures/git/mkxy.sh` (yw13's): all seven unmerged XY pairs, and
//! the copy, intent-to-add, deletions, typechange, submodule, ignored and
//! non-UTF-8 records, every path compared as BYTES.
//!
//! The fixtures are built per run under `$TMPDIR` (the lane's root in the
//! container). No git on the host is C's `HARNESS_SKIP`: SKIP by name.
//! `YEW_PICK_CASE=N` runs case N alone; the fixture is built once per run.

use edit
use git
use std.fs
use std.process
use std.signal

fn b(s: str) -> List[byte] {
    var v = List[byte]()
    for x in s.bytes() {
        (mut v).push(x)
    }
    v
}

fn argv_of(words: List[str]) -> List[str] {
    var v = List[str]()
    for w in words {
        (mut v).push(w)
    }
    v
}

fn say(what: str) {
    print("gitlayer_test: {what}")
    eprint("gitlayer_test: {what}")
}

// `run_git` (`git_layer.c:175-225`): `git -C REPO TAIL...`, stdout
// captured as bytes, stderr to /dev/null; exit 0 or false.
fn run_git(repo: str, tail: List[str]) -> (bool, List[byte]) {
    var argv = argv_of(["git", "-C", repo])
    for t in tail {
        (mut argv).push(t)
    }
    run_argv(argv)
}

fn run_argv(argv: List[str]) -> (bool, List[byte]) {
    var out = List[byte]()
    var pipe = process.pipe() else |_| { return (false, out) }
    var null = fs.open_append("/dev/null") else |_| { return (false, out) }
    var c = process.from_argv(argv)
    process.set_stdout(mut c, pipe.write)
    process.set_stderr(mut c, null)
    let child = process.start(c) else |_| { return (false, out) }
    fs.close(take pipe.write) else |_| {}
    fs.close(take null) else |_| {}
    var done = false
    while !done {
        let chunk = fs.read_chunk(mut pipe.read, 65536) else |_| {
            done = true
            List[byte]()
        }
        for x in chunk {
            (mut out).push(x)
        }
    }
    fs.close(take pipe.read) else |_| {}
    let status = process.wait_status(take child) else |_| { return (false, out) }
    let st = process.status_from(status)
    let code = process.exit_code(st) else 255
    (process.is_exited(st) && code == 0, out)
}

fn entry_find(s: git.GitSnapshot, path: List[byte]) -> int {
    var i = 0
    while i < s.entries.len {
        if git.git_snap_path_eq(s, i, path) {
            return i
        }
        i += 1
    }
    -1
}

fn parse(raw: List[byte]) -> git.GitSnapshot {
    var snap = git.git_snapshot_new()
    var err = git.git_parse_err()
    assert(
        git.git_parse_status(mut snap, raw, raw.len, mut err),
        "the stream parses: {err.message}",
    )
    snap
}

fn argv_index(argv: List[str], value: str) -> int {
    var i = 0
    while i < argv.len {
        if argv[i] == value {
            return i
        }
        i += 1
    }
    -1
}

// `check_spawn_argv` (`:434-490`): the awkward paths of the fixture go to
// `stage` as argv elements after `--`, byte for byte, with the pinned
// global options before them.
fn check_spawn_argv(snap: git.GitSnapshot) {
    let awkward = ["space name.txt", "quote\"$dollar.txt", "line\nbreak.txt", "-n", "漢字.txt"]
    var tail = argv_of(["add", "--"])
    for a in awkward {
        let i = entry_find(snap, b(a))
        assert(i >= 0, "{a} is in the snapshot")
        (mut tail).push(str_from_utf8(git.git_snap_path(snap, i)) else a)
    }
    var ed = edit.ed_new()
    edit.git_test_spawn_set(mut ed, true)
    var req = edit.git_req(edit.GREQ_VERB)
    req.literal_paths = true
    let verb = edit.git_verb(ed, "stage")
    assert(verb >= 0, "the stage verb")
    let (id, why) = edit.git_spawn(mut ed, verb, tail, req)
    assert(id != 0, "spawned: {why}")
    let argv = copy ed.git.tlog.argv
    assert(ed.git.tlog.calls == 1 && ed.git.tlog.literal_paths, "one literal-path spawn")
    assert(argv.len >= 13, "the full argv ({argv.len})")
    assert(argv[0] == "git", "git first")
    assert(argv_index(argv, "--no-pager") == 1, "--no-pager second")
    assert(argv_index(argv, "core.quotepath=false") >= 0, "quotepath pinned")
    assert(argv_index(argv, "status.renames=true") >= 0, "renames pinned")
    assert(argv_index(argv, "--no-optional-locks") < 0, "a mutation takes locks")
    let dash = argv_index(argv, "--")
    assert(dash >= 0, "--")
    for a in awkward {
        let i = entry_find(snap, b(a))
        let want = str_from_utf8(git.git_snap_path(snap, i)) else a
        let at = argv_index(argv, want)
        assert(at > dash, "{a} after --, as one element")
        assert(argv[at].len == snap.entries[i].path_len, "{a}: exact bytes")
    }
    assert(tail[3].contains("\"") && tail[3].contains("$"), "the quote and dollar survive")
}

// `check_status_fixture` (`:292-338`).
fn git_layer_status_fixture(repo: str) {
    let tail = argv_of(
        [
            "-c",
            "core.quotepath=false",
            "-c",
            "status.renames=true",
            "status",
            "--porcelain=v2",
            "--branch",
            "-z",
            "--untracked-files=normal",
            "--ignored=no",
        ],
    )
    let (ok, raw) = run_git(repo, tail)
    assert(ok, "git status runs")
    let snap = parse(raw)
    let paths = [
        "copy-candidate.txt",
        "modified.txt",
        "rename-new.txt",
        "staged-and-modified.txt",
        "staged.txt",
        "typechange.txt",
        "conflict.txt",
        "-n",
        "line\nbreak.txt",
        "quote\"$dollar.txt",
        "space name.txt",
        "untracked-dir/",
        "untracked.txt",
        "漢字.txt",
    ]
    assert(
        snap.entries.len == paths.len || snap.entries.len == paths.len + 1,
        "{snap.entries.len} entries",
    )
    for p in paths {
        assert(entry_find(snap, b(p)) >= 0, "{p} is an entry")
    }
    if snap.entries.len == paths.len + 1 {
        assert(entry_find(snap, b("long-path/")) >= 0, "the long path")
    }
    let r = entry_find(snap, b("rename-new.txt"))
    assert(
        snap.entries[r].kind == git.GIT_E_RENAME && snap.entries[r].score == 100,
        "a 100% rename",
    )
    assert(
        git.git_bytes_cmp(git.git_snap_orig(snap, r), b("rename-old.txt")) == 0,
        "from rename-old.txt",
    )
    let c = entry_find(snap, b("conflict.txt"))
    assert(snap.entries[c].kind == git.GIT_E_UNMERGED && snap.entries[c].conflicted, "unmerged")
    let u = entry_find(snap, b("untracked-dir/"))
    assert(
        snap.entries[u].kind == git.GIT_E_UNTRACKED && snap.entries[u].is_dir,
        "an untracked directory",
    )
    assert(snap.conflicted && snap.state == git.GIT_CONFLICTED, "the snapshot is conflicted")
    check_spawn_argv(snap)
}

// `check_incoming` (`:340-385`).
fn git_layer_incoming(repo: str) {
    let upstream = "{repo}/.fixture-variants/upstream"
    let status = argv_of(["status", "--porcelain=v2", "--branch", "-z"])
    let (ok1, raw1) = run_git(repo, status)
    assert(ok1, "status in the fixture")
    let s1 = parse(raw1)
    assert(!s1.has_upstream && s1.state == git.GIT_CONFLICTED, "no upstream, conflicted")
    let (ok2, raw2) = run_git(upstream, status)
    assert(ok2, "status in the upstream variant")
    let s2 = parse(raw2)
    assert(s2.has_upstream, "an upstream")
    assert(git.git_bytes_cmp(git.git_snap_upstream(s2), b("origin/trunk")) == 0, "origin/trunk")
    let (ok3, raw3) = run_git(
        upstream,
        argv_of(["diff", "--name-only", "-z", "HEAD...@{{upstream}}"]),
    )
    assert(ok3, "the incoming diff")
    var incoming = git.git_paths_new()
    var err = git.git_parse_err()
    assert(git.git_parse_z_paths(raw3, raw3.len, mut incoming, mut err), "z paths parse")
    assert(incoming.rows.len == 1, "one incoming path ({incoming.rows.len})")
    assert(git.git_bytes_cmp(git.git_paths_bytes(incoming, 0), b("remote.txt")) == 0, "remote.txt")
}

// `check_copied_entry` (`:387-426`).
fn git_layer_copied_entry() {
    var record = b(
        "2 C. N... 100644 100644 100644 1111111111111111111111111111111111111111 2222222222222222222222222222222222222222 C100 copy-result.txt",
    )
    (mut record).push(0 as byte)
    for x in "copy-source.txt".bytes() {
        (mut record).push(x)
    }
    (mut record).push(0 as byte)
    let snap = parse(record)
    assert(snap.entries.len == 1, "one entry")
    let e = entry_find(snap, b("copy-result.txt"))
    assert(
        e >= 0 && snap.entries[e].kind == git.GIT_E_RENAME && snap.entries[e].x == 67,
        "a C. record",
    )
    assert(snap.entries[e].score == 100, "C100")
    assert(
        git.git_bytes_cmp(git.git_snap_orig(snap, e), b("copy-source.txt")) == 0,
        "from copy-source.txt",
    )
    let tail = argv_of(
        [
            "add",
            "--",
            str_from_utf8(git.git_snap_path(snap, e)) else "",
            str_from_utf8(git.git_snap_orig(snap, e)) else "",
        ],
    )
    var ed = edit.ed_new()
    edit.git_test_spawn_set(mut ed, true)
    var req = edit.git_req(edit.GREQ_VERB)
    req.literal_paths = true
    let verb = edit.git_verb(ed, "stage")
    let (id, why) = edit.git_spawn(mut ed, verb, tail, req)
    assert(id != 0, "spawned: {why}")
    let argv = copy ed.git.tlog.argv
    let dash = argv_index(argv, "--")
    assert(dash >= 0, "--")
    assert(argv_index(argv, tail[2]) > dash, "the copy after --")
    assert(argv_index(argv, tail[3]) > dash, "its source after --")
}

// `run_jobs_idle` (`:515-536`): every job settled.
fn run_jobs_idle(mut ed: edit.Ed) -> bool {
    let start = time_now_ms()
    while ed.jobs.v.len != 0 {
        let fds = edit.job_wait_fds(ed)
        if fds.len != 0 {
            let _ = os_signal_wait_fds(fds, signal.child(), 20) else |_| { (-1, 0) }
        } else {
            time_sleep_ms(5)
        }
        edit.job_pump(mut ed)
        edit.job_reap(mut ed)
        edit.job_tick(mut ed, time_now_ms())
        let _ = edit.job_settle(mut ed)
        if time_now_ms() - start > 10000 {
            return false
        }
    }
    true
}

// `check_info_state` (`:552-588`): a real refresh in a mid-operation
// worktree, then `ed.git.info`'s line.
fn check_info_state(worktree: str, relative: str, directory: bool, want: int, exists: bool) {
    let probe = "{worktree}/.git/{relative}"
    if !exists {
        if directory {
            fs.create_dir(probe) else |_| { assert(false, "mkdir {probe}") }
        } else {
            fs.write_bytes(probe, List[byte]()) else |_| { assert(false, "touch {probe}") }
        }
    } else {
        assert(fs.exists(probe), "{probe} exists")
    }
    var ed = edit.ed_new()
    ed.ws_dir = worktree
    edit.git_test_now_set(mut ed, 1000)
    assert(edit.git_refresh(mut ed, true), "refresh spawns")
    assert(run_jobs_idle(mut ed), "the refresh settles")
    let live = edit.git_snapshot(mut ed)
    assert(ed.git.snap[live].gen == 1, "one snapshot ({ed.git.snap[live].gen})")
    assert(
        ed.git.snap[live].state == want,
        "{relative}: state {ed.git.snap[live].state}, want {want}",
    )
    let id = edit.cmd_lookup(ed.reg, "ed.git.info")
    assert(id != 0, "ed.git.info")
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    cx.count = 1
    assert(edit.ed_cmd_invoke(mut ed, id, mut cx) == edit.CMD_OK, "info runs")
    let expected = "git: {git.git_state_str(want)}; repo {worktree}; branch trunk; age 0 ms"
    assert(ed.msg.active && ed.msg.text == expected, "`{ed.msg.text}` want `{expected}`")
    if !exists {
        if directory {
            fs.remove_dir(probe) else |_| { assert(false, "rmdir") }
        } else {
            fs.remove(probe) else |_| { assert(false, "unlink") }
        }
    }
}

// `check_info_mid_states` (`:590-604`).
fn git_layer_info_mid_states(repo: str) {
    let clean = "{repo}/.fixture-variants/upstream"
    check_info_state(repo, "MERGE_HEAD", false, git.GIT_MID_MERGE, true)
    check_info_state(clean, "rebase-merge", true, git.GIT_MID_REBASE, false)
    check_info_state(clean, "CHERRY_PICK_HEAD", false, git.GIT_MID_CHERRY_PICK, false)
    check_info_state(clean, "REVERT_HEAD", false, git.GIT_MID_REVERT, false)
    check_info_state(clean, "BISECT_LOG", false, git.GIT_MID_BISECT, false)
}

// `check_ignore_compaction` (`:851-896`): 5,000 ignored files compact to
// their directory.
fn git_layer_ignore_compaction(repo: str) {
    let dir = "{repo}/node_modules"
    fs.create_dir(dir) else |_| { assert(false, "mkdir node_modules") }
    let exclude = "{repo}/.git/info/exclude"
    fs.append_text(exclude, "/node_modules/\n") else |_| { assert(false, "the exclude rule") }
    var i = 0
    while i < 5000 {
        let n = if i < 10 {
            "000{i}"
        } else if i < 100 {
            "00{i}"
        } else if i < 1000 {
            "0{i}"
        } else {
            "{i}"
        }
        fs.write_bytes("{dir}/f{n}", List[byte]()) else |_| { assert(false, "f{n}") }
        i += 1
    }
    let (ok, raw) = run_git(
        repo,
        argv_of(
            [
                "ls-files",
                "-z",
                "--others",
                "--ignored",
                "--exclude-standard",
                "--directory",
                "--no-empty-directory",
            ],
        ),
    )
    assert(ok, "ls-files runs")
    var set = git.git_paths_new()
    var err = git.git_parse_err()
    assert(git.git_parse_ignore(raw, raw.len, mut set, mut err), "the ignore set parses")
    assert(set.rows.len == 4, "four compacted rows ({set.rows.len})")
    let a = b("node_modules/f4321")
    assert(git.git_ignored(set, a, 0, a.len), "inside node_modules")
    let d = b("ignored-dir/deep/file")
    assert(git.git_ignored(set, d, 0, d.len), "inside ignored-dir")
    let n2 = b("node_module/f4321")
    assert(!git.git_ignored(set, n2, 0, n2.len), "a prefix is not containment")
}

fn dump_value(dump: str, name: str) -> (bool, str) {
    for line in dump.split("\n") {
        if line.starts_with("{name}=") {
            return (true, line[name.len + 1..line.len])
        }
    }
    (false, "")
}

fn dump_is(dump: str, name: str, want: str) -> bool {
    let (has, v) = dump_value(dump, name)
    if !(has && v == want) {
        let got = if has then "`{v}`" else "absent"
        say("RED git_layer_spawn_env: the child's {name}: want `{want}`, got {got}")
        return false
    }
    true
}

// `check_spawn_env` (`:666-849`): a fake `git` on `PATH` dumps the
// environment a verb's child sees; the parent's own stays untouched.
fn git_layer_spawn_env(repo: str) {
    let names = [
        "PATH",
        "YEW_GIT_ENV_DUMP",
        "GIT_DIR",
        "GIT_WORK_TREE",
        "GIT_COMMON_DIR",
        "GIT_INDEX_FILE",
        "GIT_OBJECT_DIRECTORY",
        "GIT_ALTERNATE_OBJECT_DIRECTORIES",
        "GIT_NAMESPACE",
        "GIT_CEILING_DIRECTORIES",
        "GIT_CONFIG_GLOBAL",
        "GIT_CONFIG_SYSTEM",
        "GIT_CONFIG_COUNT",
        "GIT_CONFIG_KEY_0",
        "GIT_CONFIG_VALUE_0",
        "GIT_SSH",
        "GIT_SSH_COMMAND",
        "GIT_ASKPASS",
        "SSH_ASKPASS",
        "SSH_AUTH_SOCK",
        "SSH_ASKPASS_REQUIRE",
        "GIT_TERMINAL_PROMPT",
        "GIT_EDITOR",
        "GIT_SEQUENCE_EDITOR",
        "EDITOR",
        "VISUAL",
        "GIT_PAGER",
        "PAGER",
        "GIT_FLUSH",
        "GIT_TRACE",
        "GIT_TRACE2_EVENT",
        "GIT_TRACE_PACKET",
        "GIT_TRACE_PERFORMANCE",
        "GIT_CURL_VERBOSE",
        "GIT_TRANSFER_TRACE",
        "LC_ALL",
        "GIT_OPTIONAL_LOCKS",
        "YEW_FILE",
        "YEW_LINE",
        "YEW_COL",
        "YEW_WORKSPACE",
        "YEW_JOB",
        "COLUMNS",
        "LINES",
        "GIT_LITERAL_PATHSPECS",
    ]
    let sentinels = [
        "GIT_DIR=parent-git-dir",
        "GIT_WORK_TREE=parent-work-tree",
        "GIT_COMMON_DIR=parent-common-dir",
        "GIT_INDEX_FILE=parent-index",
        "GIT_OBJECT_DIRECTORY=parent-objects",
        "GIT_ALTERNATE_OBJECT_DIRECTORIES=parent-alt-objects",
        "GIT_NAMESPACE=parent-namespace",
        "GIT_CEILING_DIRECTORIES=parent-ceiling",
        "GIT_CONFIG_GLOBAL=parent-global-config",
        "GIT_CONFIG_SYSTEM=parent-system-config",
        "GIT_CONFIG_COUNT=1",
        "GIT_CONFIG_KEY_0=user.name",
        "GIT_CONFIG_VALUE_0=Yew Test",
        "GIT_SSH=parent-git-ssh",
        "GIT_SSH_COMMAND=ssh -F sentinel",
        "GIT_ASKPASS=parent-git-askpass",
        "SSH_ASKPASS=parent-ssh-askpass",
        "SSH_AUTH_SOCK=/sentinel/agent.sock",
        "SSH_ASKPASS_REQUIRE=force",
        "EDITOR=parent-editor",
        "VISUAL=parent-visual",
        "GIT_OPTIONAL_LOCKS=parent-lock-policy",
        "GIT_TRACE=parent-trace",
        "GIT_TRACE2_EVENT=parent-trace2",
        "GIT_TRACE_PACKET=parent-packet",
        "GIT_TRACE_PERFORMANCE=parent-performance",
        "GIT_CURL_VERBOSE=parent-curl",
        "GIT_TRANSFER_TRACE=parent-transfer",
        "YEW_FILE=parent-file",
        "YEW_LINE=800",
        "YEW_COL=900",
        "YEW_WORKSPACE=parent-workspace",
        "YEW_JOB=parent-job",
        "COLUMNS=132",
        "LINES=43",
    ]
    var had = List[bool]()
    var saved = List[str]()
    for n in names {
        var present = true
        let v = env_get(n) else {
            present = false
            ""
        }
        (mut had).push(present)
        (mut saved).push(v)
    }
    let fake_dir = "{repo}/.fake-git-bin"
    fs.create_dir(fake_dir) else |_| { assert(false, "the fake bin") }
    let fake_git = "{fake_dir}/git"
    let dump_path = "{fake_dir}/env.dump"
    // C's script (`:729-730`) truncates the dump on every run. The refresh
    // a mutation schedules on completion (`git.c:2209-2211`) runs the fake
    // again; C's `yew_ed_free` kills that run before its redirect most of
    // the time, and the port reads the dump while it still runs. The
    // port's script keeps the first dump (`set -C`): deterministic.
    let script = "#!/bin/sh\nset -C\n/usr/bin/env >\"$YEW_GIT_ENV_DUMP\"\nexit 0\n"
    fs.write_text(fake_git, script) else |_| {
        assert(false, "the fake git")
    }
    fs.set_mode(fake_git, 448) else |_| { assert(false, "chmod 0700") }
    env_set("PATH", fake_dir) else |_| {}
    env_set("YEW_GIT_ENV_DUMP", dump_path) else |_| {}
    for row in sentinels {
        let at = row.find("=") else 0
        env_set(row[0..at], row[at + 1..row.len]) else |_| {}
    }
    var ed = edit.ed_new()
    ed.ws_dir = repo
    var req = edit.git_req(edit.GREQ_VERB)
    req.literal_paths = true
    let verb = edit.git_verb(ed, "init")
    assert(verb >= 0, "the init verb")
    let (id, why) = edit.git_spawn(mut ed, verb, argv_of(["init"]), req)
    assert(id != 0, "spawned: {why}")
    let start = time_now_ms()
    while edit.job_find(ed, id) >= 0 {
        let fds = edit.job_wait_fds(ed)
        if fds.len != 0 {
            let _ = os_signal_wait_fds(fds, signal.child(), 20) else |_| { (-1, 0) }
        } else {
            time_sleep_ms(5)
        }
        edit.job_pump(mut ed)
        edit.job_reap(mut ed)
        edit.job_tick(mut ed, time_now_ms())
        let _ = edit.job_settle(mut ed)
        assert(time_now_ms() - start <= 10000, "released in time")
    }
    for row in sentinels {
        let at = row.find("=") else 0
        let now = env_get(row[0..at]) else ""
        assert(now == row[at + 1..row.len], "the parent's {row[0..at]} is untouched")
    }
    var k = 0
    while k < names.len {
        var changed = names[k] == "PATH" || names[k] == "YEW_GIT_ENV_DUMP"
        for row in sentinels {
            if row.starts_with("{names[k]}=") {
                changed = true
            }
        }
        if !changed {
            var present = true
            let now = env_get(names[k]) else {
                present = false
                ""
            }
            assert(present == had[k], "the parent's {names[k]} keeps its presence")
            assert(!had[k] || now == saved[k], "the parent's {names[k]} keeps its value")
        }
        k += 1
    }
    // `yew_ed_free` (`:794`): the refresh the mutation scheduled ends.
    edit.jobs_free(mut ed)
    let dump = fs.read_text(dump_path) else ""
    for row in sentinels {
        if row.starts_with("GIT_TRACE") ||
            row.starts_with("GIT_CURL") ||
            row.starts_with("GIT_TRANSFER") ||
            row.starts_with("YEW_") ||
            row.starts_with("COLUMNS") ||
            row.starts_with("LINES") {
            continue
        }
        let at = row.find("=") else 0
        assert(dump_is(dump, row[0..at], row[at + 1..row.len]), "the child keeps {row[0..at]}")
    }
    assert(dump_is(dump, "GIT_TERMINAL_PROMPT", "0"), "no terminal prompt")
    assert(dump_is(dump, "GIT_EDITOR", "false"), "no editor")
    assert(dump_is(dump, "GIT_SEQUENCE_EDITOR", "false"), "no sequence editor")
    assert(dump_is(dump, "GIT_PAGER", "cat"), "GIT_PAGER=cat")
    assert(dump_is(dump, "PAGER", "cat"), "PAGER=cat")
    assert(dump_is(dump, "YEW_FILE", ""), "YEW_FILE empty")
    assert(dump_is(dump, "YEW_LINE", "1"), "YEW_LINE 1")
    assert(dump_is(dump, "YEW_COL", "1"), "YEW_COL 1")
    assert(dump_is(dump, "YEW_WORKSPACE", repo), "YEW_WORKSPACE")
    assert(dump_is(dump, "YEW_JOB", "1"), "YEW_JOB 1")
    let (hc, _) = dump_value(dump, "COLUMNS")
    let (hl, _) = dump_value(dump, "LINES")
    assert(!hc && !hl, "no COLUMNS or LINES")
    assert(dump_is(dump, "GIT_FLUSH", "1"), "GIT_FLUSH")
    assert(dump_is(dump, "LC_ALL", "C"), "LC_ALL=C")
    assert(dump_is(dump, "GIT_LITERAL_PATHSPECS", "1"), "literal pathspecs")
    for t in [
        "GIT_TRACE",
        "GIT_TRACE2_EVENT",
        "GIT_TRACE_PACKET",
        "GIT_TRACE_PERFORMANCE",
        "GIT_CURL_VERBOSE",
        "GIT_TRANSFER_TRACE",
    ] {
        let (has, _) = dump_value(dump, t)
        assert(!has, "{t} removed")
    }
    var i = 0
    while i < names.len {
        if had[i] {
            env_set(names[i], saved[i]) else |_| {}
        } else {
            env_unset(names[i]) else |_| {}
        }
        i += 1
    }
    fs.remove_dir_all(fake_dir) else |_| {}
}

// The differential's richest variant (`notes/yw13-evidence/porcelain-diff`,
// `copies`): copy detection, every untracked file, ignored files listed.
fn status_all(repo: str) -> git.GitSnapshot {
    let (ok, raw) = run_git(
        repo,
        argv_of(
            [
                "-c",
                "core.quotepath=false",
                "-c",
                "status.renames=copies",
                "status",
                "--porcelain=v2",
                "--branch",
                "-z",
                "--untracked-files=all",
                "--ignored=traditional",
            ],
        ),
    )
    assert(ok, "git status runs in {repo}")
    parse(raw)
}

fn xy_of(s: git.GitSnapshot, i: int) -> str {
    str_from_utf8([s.entries[i].x as byte, s.entries[i].y as byte]) else "??"
}

// Port: all seven unmerged XY pairs, every one conflicted.
fn port_gitlayer_every_unmerged_xy(x: str) {
    let s = status_all("{x}/xy")
    let want = [
        "aa.txt AA",
        "du.txt DU",
        "rr-ours.txt AU",
        "rr-theirs.txt UA",
        "rr.txt DD",
        "ud.txt UD",
        "uu.txt UU",
    ]
    assert(s.entries.len == want.len, "seven entries ({s.entries.len})")
    var i = 0
    for w in want {
        let sp = w.find(" ") else 0
        let path = w[0..sp]
        let xy = w[sp + 1..w.len]
        let at = entry_find(s, b(path))
        assert(at == i, "{path} sorted at {i} ({at})")
        assert(s.entries[at].kind == git.GIT_E_UNMERGED, "{path}: unmerged")
        assert(xy_of(s, at) == xy, "{path}: {xy}, got {xy_of(s, at)}")
        assert(s.entries[at].conflicted, "{path}: conflicted")
        i += 1
    }
    assert(s.conflicted && s.state == git.GIT_CONFLICTED, "the snapshot is conflicted")
}

fn bytes_with(prefix: str, byte_v: int, suffix: str) -> List[byte] {
    var v = b(prefix)
    (mut v).push(byte_v as byte)
    for x in suffix.bytes() {
        (mut v).push(x)
    }
    v
}

// Port: the copy, intent-to-add, deletions, typechange, the submodule in
// each state, ignored entries, and non-UTF-8 paths kept as bytes.
fn port_gitlayer_mix_records(x: str) {
    let s = status_all("{x}/mix")
    let renamed = bytes_with("bad", 253, "renamed.txt")
    let r = entry_find(s, renamed)
    assert(r >= 0, "the non-UTF-8 rename is an entry, its path the exact bytes")
    assert(s.entries[r].kind == git.GIT_E_RENAME && xy_of(s, r) == "R.", "R.")
    assert(
        git.git_bytes_cmp(git.git_snap_orig(s, r), bytes_with("bad", 254, "name.txt")) == 0,
        "its source's bytes",
    )
    let c = entry_find(s, b("copy-dst.txt"))
    assert(c >= 0 && s.entries[c].kind == git.GIT_E_RENAME && xy_of(s, c) == "C.", "a C. copy")
    assert(git.git_bytes_cmp(git.git_snap_orig(s, c), b("copy-src.txt")) == 0, "from copy-src.txt")
    let m = entry_find(s, b("copy-src.txt"))
    assert(m >= 0 && xy_of(s, m) == "M." && s.entries[m].staged, "M. staged")
    let gi = entry_find(s, b("gone-index.txt"))
    assert(gi >= 0 && xy_of(s, gi) == "D." && s.entries[gi].staged && !s.entries[gi].unstaged, "D.")
    let gw = entry_find(s, b("gone-worktree.txt"))
    assert(gw >= 0 && xy_of(s, gw) == ".D" && s.entries[gw].unstaged && !s.entries[gw].staged, ".D")
    let ia = entry_find(s, b("intent.txt"))
    assert(ia >= 0 && xy_of(s, ia) == ".A" && s.entries[ia].unstaged, ".A intent to add")
    let t = entry_find(s, b("typechange.txt"))
    assert(t >= 0 && xy_of(s, t) == "T." && s.entries[t].staged, "T.")
    let sub = entry_find(s, b("sub"))
    assert(sub >= 0 && s.entries[sub].submodule, "the submodule")
    assert(xy_of(s, sub) == ".M" && s.entries[sub].unstaged, "the submodule's .M")
    let raw = entry_find(s, bytes_with("raw", 255, ".txt"))
    assert(
        raw >= 0 && s.entries[raw].kind == git.GIT_E_UNTRACKED && s.entries[raw].untracked,
        "the non-UTF-8 untracked path",
    )
    for ig in ["ignored-dir/deep.txt", "ignored.log", "scratch.tmp"] {
        let at = entry_find(s, b(ig))
        assert(at >= 0 && s.entries[at].kind == git.GIT_E_IGNORED, "{ig} ignored")
    }
    let un = entry_find(s, b("untracked.txt"))
    assert(un >= 0 && s.entries[un].untracked, "untracked.txt")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    // `make test-git-script` runs the binary under `LC_ALL=C`.
    env_set("LC_ALL", "C") else |_| {}
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    let names = [
        "git_layer_status_fixture",
        "git_layer_incoming",
        "git_layer_copied_entry",
        "git_layer_info_mid_states",
        "git_layer_ignore_compaction",
        "git_layer_spawn_env",
        "port_gitlayer_every_unmerged_xy",
        "port_gitlayer_mix_records",
    ]
    let (has_git, _) = run_argv(argv_of(["git", "--version"]))
    if !has_git {
        var s = 0
        while s < names.len {
            if chosen < 0 || chosen == s {
                say("SKIP {names[s]}: git not found (C's HARNESS_SKIP git_layer)")
            }
            s += 1
        }
        return
    }
    if chosen >= names.len {
        print("gitlayer_test: 0 cases run")
        return
    }
    let tmp = env_get("TMPDIR") else "target/tests"
    let base = if tmp.len == 0 then "target/tests" else tmp
    let work = "{base}/yew-gitlayer-{os_pid()}"
    fs.remove_dir_all(work) else |_| {}
    fs.create_dir_all(work) else |_| { assert(false, "mkdir {work}") }
    let (built, _) = run_argv(argv_of(["sh", "tests/fixtures/git/mkrepo.sh", "{work}/repo"]))
    assert(built, "mkrepo.sh builds the fixture and its hashes match the ledger")
    let (xbuilt, _) = run_argv(argv_of(["sh", "tests/fixtures/git/mkxy.sh", "{work}/x"]))
    assert(xbuilt, "mkxy.sh builds")
    let repo = fs.realpath("{work}/repo") else "{work}/repo"
    let x = fs.realpath("{work}/x") else "{work}/x"
    var ran = 0
    var n = 0
    while n < names.len {
        if chosen >= 0 && chosen != n {
            n += 1
            continue
        }
        match n {
            0 => git_layer_status_fixture(repo),
            1 => git_layer_incoming(repo),
            2 => git_layer_copied_entry(),
            3 => git_layer_info_mid_states(repo),
            4 => git_layer_ignore_compaction(repo),
            5 => git_layer_spawn_env(repo),
            6 => port_gitlayer_every_unmerged_xy(x),
            _ => port_gitlayer_mix_records(x),
        }
        print("{names[n]}: PASS")
        ran += 1
        n += 1
    }
    // `remove_long_path` (`:149-173`): the fixture's deeper-than-PATH_MAX
    // tree goes by `rm -r` (fd-relative), then the rest.
    let (gone, _) = run_argv(argv_of(["rm", "-rf", "{repo}/long-path"]))
    assert(gone && !fs.exists("{repo}/long-path"), "the long path is removed")
    let (cleaned, _) = run_argv(argv_of(["rm", "-rf", work]))
    assert(cleaned, "the work tree is removed")
    print("gitlayer_test: {ran} cases run")
}
