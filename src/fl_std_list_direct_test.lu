//! member: false
//! Direct coverage of the list natives beside the flfix suite
//! (src/fl_std_list_test.lu). sagitta 9ace98c2 src/fl/stdlist.c:13-582 and
//! src/util/sort.c:9-68; the behaviours tests/unit/test_fl_std_list.c:32-167
//! names. Every order and comparator log marked "C oracle" is the pinned C
//! yew's own answer to the same program
//! (notes/yw07b-evidence/front/oracle-list/order.fl, order.out). Callbacks
//! are compiled Fletch closures that call no native; the dispatcher is
//! called directly, its arguments in the VM's first stack slots.

use fl

fn vm_new() -> fl.FlVm {
    var strings = fl.fl_strings()
    fl.fl_vm_new(take strings)
}

// Compile and run a program; its value is rooted as the next host root.
fn eval(mut vm: fl.FlVm, text: str) -> int {
    var src = List[byte]()
    for b in text.bytes() { (mut src).push(b) }
    let p = fl.fl_parse(src, 0, mut vm.dc, mut vm.strings)
    assert(!p.had_error)
    let f = fl.fl_compile(mut vm, p, 0, fl.fl_origin_new(4, 0)) else {
        for d in vm.dc.entries { eprint(d.msg) }
        fl.fl_nil()
    }
    assert(f.t == 7)
    let v = fl.fl_vm_run(mut vm, f)
    assert(!vm.raised)
    (mut vm.host_roots).push(v)
    vm.host_roots.len - 1
}

// Element k of host root r, read after any collection has remapped it.
fn root(vm: fl.FlVm, r: int, k: int) -> fl.FlValue {
    fl.fl_list_get(vm, vm.host_roots[r], k) else fl.fl_nil()
}

fn call(mut vm: fl.FlVm, kind: int, args: List[fl.FlValue]) -> fl.FlValue {
    vm.raised = false
    vm.err = fl.fl_nil()
    vm.sp = args.len
    for i in 0..args.len { vm.stack[i] = copy args[i] }
    let defs = fl.fl_list_defs()
    let name = "list.{defs[kind].name}"
    vm.cur_native = fl.fl_intern(mut vm.strings, name.bytes(), 0, name.len)
    let out = fl.fl_std_list_dispatch(mut vm, kind, 0, args.len)
    // Every path, a raise included, releases the roots it took.
    assert(vm.temp.len == 0)
    out
}

// A zero-argument Fletch helper (a log reader, a counter reset).
fn invoke(mut vm: fl.FlVm, f: fl.FlValue) -> fl.FlValue {
    vm.sp = 0
    let out = fl.fl_vm_call(mut vm, f, List[fl.FlValue]())
    assert(!vm.raised)
    out
}

fn list_of(mut vm: fl.FlVm, xs: List[int]) -> fl.FlValue {
    let l = fl.fl_list_new(mut vm)
    for x in xs { fl.fl_list_push(mut vm, l, fl.fl_int(x)) }
    l
}

fn text_of(vm: fl.FlVm, v: fl.FlValue) -> str {
    str_from_utf8(vm.gc.slots[fl.fl_obj_index(vm, v)].bytes) else "?"
}

// fmt.repr's shape for the values these cases hold.
fn show(vm: fl.FlVm, v: fl.FlValue) -> str {
    match v.t {
        0 => "nil",
        1 => if v.i != 0 then "true" else "false",
        2 => "{v.i}",
        3 => if v.f != v.f then "nan" else "{v.f}",
        4 => "\"" + text_of(vm, v) + "\"",
        5 => {
            var s = "["
            for i in 0..fl.fl_list_len(vm, v) {
                if i > 0 { s += ", " }
                s += show(vm, fl.fl_list_get(vm, v, i) else fl.fl_nil())
            }
            s + "]"
        },
        _ => "<{fl.fl_type_name(v.t)}>",
    }
}

fn expect(got: str, want: str) {
    if got != want {
        eprint("got:  {got}")
        eprint("want: {want}")
    }
    assert(got == want)
}

fn err_is(mut vm: fl.FlVm, kind: str, msg: str) {
    assert(vm.raised)
    let k = fl.fl_str_text(mut vm, "kind")
    let m = fl.fl_str_text(mut vm, "msg")
    let kv = fl.fl_map_get(vm, vm.err, k) else fl.fl_nil()
    let mv = fl.fl_map_get(vm, vm.err, m) else fl.fl_nil()
    expect("{text_of(vm, kv)}: {text_of(vm, mv)}", "{kind}: {msg}")
    vm.raised = false
}

fn mods(vm: fl.FlVm, l: fl.FlValue) -> int { vm.gc.slots[fl.fl_obj_index(vm, l)].mods }

fn t_grows_and_shrinks() {
    var vm = vm_new()
    let empty = fl.fl_list_new(mut vm)
    assert(call(mut vm, 0, [copy empty]).i == 0)
    let l = fl.fl_list_new(mut vm)
    var m = mods(vm, l)
    let _ = call(mut vm, 1, [copy l, fl.fl_int(1)])
    assert(mods(vm, l) > m)
    let _ = call(mut vm, 1, [copy l, fl.fl_int(2)])
    expect(show(vm, l), "[1, 2]")
    m = mods(vm, l)
    assert(call(mut vm, 2, [copy l]).i == 2)
    assert(mods(vm, l) > m)
    expect(show(vm, l), "[1]")
    let _ = call(mut vm, 2, [copy empty])
    err_is(mut vm, "index", "list.pop: the list is empty")
    let a = list_of(mut vm, [1, 3])
    m = mods(vm, a)
    let _ = call(mut vm, 3, [copy a, fl.fl_int(1), fl.fl_int(2)])
    assert(mods(vm, a) > m)
    expect(show(vm, a), "[1, 2, 3]")
    let b = list_of(mut vm, [1])
    let _ = call(mut vm, 3, [copy b, fl.fl_int(1), fl.fl_int(2)])
    expect(show(vm, b), "[1, 2]")
    let _ = call(mut vm, 3, [copy b, fl.fl_int(-1), fl.fl_int(0)])
    expect(show(vm, b), "[1, 0, 2]")
    let one = list_of(mut vm, [1])
    let _ = call(mut vm, 3, [copy one, fl.fl_int(5), fl.fl_int(2)])
    err_is(mut vm, "index", "index 5 out of range for length 1")
    let _ = call(mut vm, 3, [copy one, fl.fl_int(-2), fl.fl_int(2)])
    err_is(mut vm, "index", "index -2 out of range for length 1")
    let _ = call(mut vm, 3, [copy one, fl.fl_float(1.0), fl.fl_int(2)])
    err_is(mut vm, "type", "list.insert: argument 2 must be int, found float")
    let c = list_of(mut vm, [1, 2, 3])
    m = mods(vm, c)
    assert(call(mut vm, 4, [copy c, fl.fl_int(1)]).i == 2)
    assert(mods(vm, c) > m)
    assert(call(mut vm, 4, [copy c, fl.fl_int(-1)]).i == 3)
    expect(show(vm, c), "[1]")
    let _ = call(mut vm, 4, [copy one, fl.fl_int(9)])
    err_is(mut vm, "index", "index 9 out of range for length 1")
    let _ = call(mut vm, 4, [copy one, fl.fl_int(1)])
    err_is(mut vm, "index", "index 1 out of range for length 1")
    let d = list_of(mut vm, [1, 2])
    m = mods(vm, d)
    let _ = call(mut vm, 5, [copy d])
    assert(mods(vm, d) > m)
    assert(call(mut vm, 0, [copy d]).i == 0)
    let _ = call(mut vm, 1, [fl.fl_int(7), fl.fl_int(1)])
    err_is(mut vm, "type", "list.push: argument 1 must be list, found int")
    let _ = call(mut vm, 0, [fl.fl_nil()])
    err_is(mut vm, "type", "list.len: argument 1 must be list, found nil")
}

fn t_reads_without_mutating() {
    var vm = vm_new()
    let ab = list_of(mut vm, [1, 2])
    let d = fl.fl_str_text(mut vm, "d")
    assert(call(mut vm, 6, [copy ab, fl.fl_int(1)]).i == 2)
    assert(call(mut vm, 6, [copy ab, fl.fl_int(-1)]).i == 2)
    assert(call(mut vm, 6, [copy ab, fl.fl_int(0), copy d]).i == 1)
    expect(show(vm, call(mut vm, 6, [copy ab, fl.fl_int(9), copy d])), "\"d\"")
    expect(show(vm, call(mut vm, 6, [copy ab, fl.fl_int(-3), copy d])), "\"d\"")
    let _ = call(mut vm, 6, [copy ab, fl.fl_int(9)])
    err_is(mut vm, "index", "index 9 out of range for length 2")
    let _ = call(mut vm, 6, [copy ab, fl.fl_int(-3)])
    err_is(mut vm, "index", "index -3 out of range for length 2")
    let aba = list_of(mut vm, [1, 2, 1])
    assert(call(mut vm, 7, [copy aba, fl.fl_int(1)]).i == 0)
    assert(call(mut vm, 7, [copy aba, fl.fl_int(9)]).i == -1)
    assert(call(mut vm, 7, [copy aba, fl.fl_float(2.0)]).i == 1)
    assert(call(mut vm, 8, [copy ab, fl.fl_float(2.0)]).i == 1)
    assert(call(mut vm, 8, [copy ab, fl.fl_int(9)]).i == 0)
    // Content equality: two 70-byte strings are distinct, uninterned objects.
    let long = "abcdefghij".repeat(7)
    let s1 = fl.fl_str_text(mut vm, long)
    let s2 = fl.fl_str_text(mut vm, long)
    assert(s1.i != s2.i)
    let strs = fl.fl_list_new(mut vm)
    fl.fl_list_push(mut vm, strs, fl.fl_int(0))
    fl.fl_list_push(mut vm, strs, s1)
    assert(call(mut vm, 7, [copy strs, copy s2]).i == 1)
    let four = list_of(mut vm, [1, 2, 3, 4])
    let three = list_of(mut vm, [1, 2, 3])
    expect(show(vm, call(mut vm, 9, [copy four, fl.fl_int(1), fl.fl_int(3)])), "[2, 3]")
    expect(show(vm, call(mut vm, 9, [copy three, fl.fl_int(1)])), "[2, 3]")
    expect(show(vm, call(mut vm, 9, [copy three, fl.fl_int(-2)])), "[2, 3]")
    expect(show(vm, call(mut vm, 9, [copy ab, fl.fl_int(2)])), "[]")
    expect(show(vm, call(mut vm, 9, [copy three, fl.fl_int(2), fl.fl_int(1)])), "[]")
    let _ = call(mut vm, 9, [copy ab, fl.fl_int(0), fl.fl_int(99)])
    err_is(mut vm, "index", "index 99 out of range for length 2")
    let _ = call(mut vm, 9, [copy three, fl.fl_int(4)])
    err_is(mut vm, "index", "index 4 out of range for length 3")
    let _ = call(mut vm, 9, [copy three, fl.fl_int(0), fl.fl_float(1.5)])
    err_is(mut vm, "type", "list.slice: argument 3 must be int, found float")
    let one = list_of(mut vm, [1])
    let twothree = list_of(mut vm, [2, 3])
    expect(show(vm, call(mut vm, 10, [copy one, copy twothree])), "[1, 2, 3]")
    expect(show(vm, call(mut vm, 10, [copy twothree, copy twothree])), "[2, 3, 2, 3]")
    let _ = call(mut vm, 10, [copy one, fl.fl_int(5)])
    err_is(mut vm, "type", "list.concat: argument 2 must be list, found int")
    let m = mods(vm, three)
    let _ = call(mut vm, 11, [copy three])
    expect(show(vm, three), "[3, 2, 1]")
    let _ = call(mut vm, 11, [copy four])
    expect(show(vm, four), "[4, 3, 2, 1]")
    let _ = call(mut vm, 11, [copy one])
    expect(show(vm, one), "[1]")
    let none = fl.fl_list_new(mut vm)
    let _ = call(mut vm, 11, [copy none])
    expect(show(vm, none), "[]")
    assert(mods(vm, three) == m)
    // Shallow: a new list holding the same values, the inner list shared.
    let outer = fl.fl_list_new(mut vm)
    fl.fl_list_push(mut vm, outer, copy one)
    let dup = call(mut vm, 12, [copy outer])
    assert(dup.i != outer.i)
    assert(fl.fl_equal(vm, fl.fl_list_get(vm, dup, 0) else fl.fl_nil(), copy one))
    let _ = call(mut vm, 1, [copy dup, fl.fl_int(2)])
    assert(fl.fl_list_len(vm, outer) == 1)
}

fn t_total_order() {
    var vm = vm_new()
    let r = eval(
        mut vm,
        "let a = [1]\nlet b = [2]\nlet m1 = {{}}\nlet m2 = {{}}\n" +
            "fn f1() {{ return 1 }}\nfn f2() {{ return 2 }}\n" +
            "let mixed = [\"s\", 1, nil, true, 1.5, -2, false, \"\", \"ab\", \"a\", \"b\"]\n" +
            "let nan = 0.0 / 0.0\nlet nans = [2, nan, 1, 0.5, nan, -1]\n" +
            "let objs = [m2, b, f1, m1, a, f2, \"z\"]\n" +
            "return [mixed, nans, objs, a, b, m1, m2, f1, f2]\n",
    )
    let _ = call(mut vm, 13, [root(vm, r, 0)])
    // C oracle: [nil, false, true, -2, 1, 1.5, "", "a", "ab", "b", "s"].
    expect(
        show(vm, root(vm, r, 0)),
        "[nil, false, true, -2, 1, 1.5, \"\", \"a\", \"ab\", \"b\", \"s\"]",
    )
    let _ = call(mut vm, 13, [root(vm, r, 1)])
    // C oracle: NaN equals everything in its band, stability does the rest.
    expect(show(vm, root(vm, r, 1)), "[0.5, 1, 2, nan, nan, -1]")
    let _ = call(mut vm, 13, [root(vm, r, 2)])
    let objs = root(vm, r, 2)
    // C oracle: "z" < a < b < m1 < m2 < f1 < f2, by band then allocation.
    expect(show(vm, fl.fl_list_get(vm, objs, 0) else fl.fl_nil()), "\"z\"")
    for k in 1..7 {
        let got = fl.fl_list_get(vm, objs, k) else fl.fl_nil()
        assert(fl.fl_equal(vm, got, root(vm, r, k + 2)))
    }
    // Bytes order unsigned and shorter-first (memcmp, stdlist.c:319-328).
    let bytes = fl.fl_list_new(mut vm)
    let ff = fl.fl_str_new(mut vm, [255 as byte])
    let z = fl.fl_str_text(mut vm, "z")
    let nul = fl.fl_str_new(mut vm, [0 as byte])
    let za = fl.fl_str_text(mut vm, "za")
    let blank = fl.fl_str_text(mut vm, "")
    for v in [ff, z, nul, za, blank] { fl.fl_list_push(mut vm, bytes, v) }
    let _ = call(mut vm, 13, [copy bytes])
    var lens = ""
    for k in 0..5 {
        let s = fl.fl_list_get(vm, bytes, k) else fl.fl_nil()
        let at = fl.fl_obj_index(vm, s)
        lens += "{vm.gc.slots[at].bytes.len}"
        if vm.gc.slots[at].bytes.len > 0 { lens += ":{vm.gc.slots[at].bytes[0] as int} " }
    }
    expect(lens, "01:0 1:122 2:122 1:255 ")
    // Two equal handles are one value; distinct handles order by payload
    // (C dereferences the payload: undefined), and nothing traps.
    let hs = fl.fl_list_new(mut vm)
    fl.fl_list_push(mut vm, hs, fl.FlValue { t: 16, i: 9, f: 0.0 })
    fl.fl_list_push(mut vm, hs, fl.fl_nil())
    fl.fl_list_push(mut vm, hs, fl.FlValue { t: 16, i: 3, f: 0.0 })
    fl.fl_list_push(mut vm, hs, fl.FlValue { t: 16, i: 9, f: 0.0 })
    let _ = call(mut vm, 13, [copy hs])
    var payload = ""
    for k in 0..4 { payload += "{(fl.fl_list_get(vm, hs, k) else fl.fl_nil()).i} " }
    expect(payload, "0 3 9 9 ")
}

fn comparators(mut vm: fl.FlVm) -> int {
    eval(
        mut vm,
        "let log = []\nlet n = 0\n" +
            "fn cmp(a, b) {{ log = log + [[a, b]]\nreturn a - b }}\n" +
            "fn get() {{ return log }}\nfn reset() {{ log = [] }}\n" +
            "fn desc(a, b) {{ return b - a }}\nfn key(x, y) {{ return x[0] - y[0] }}\n" +
            "fn bad(a, b) {{ n = n + 1\nif n == 2 {{ return 1 / 0 }}\nreturn a - b }}\n" +
            "fn flt(a, b) {{ n = n + 1\nreturn 1.5 }}\n" +
            "fn count() {{ return n }}\nfn zero() {{ n = 0 }}\n" +
            "let pairs = [[1, \"a\"], [0, \"b\"], [1, \"c\"], [0, \"d\"]]\n" +
            "return [cmp, get, reset, desc, key, bad, flt, count, zero, pairs]\n",
    )
}

// Sort xs with the logging comparator; answer the sorted list and the log.
fn logged(mut vm: fl.FlVm, r: int, xs: List[int]) -> str {
    let _ = invoke(mut vm, root(vm, r, 2))
    let l = list_of(mut vm, xs)
    let _ = call(mut vm, 13, [l, root(vm, r, 0)])
    let sorted = show(vm, vm.stack[0])
    let log = invoke(mut vm, root(vm, r, 1))
    "{sorted} {show(vm, log)}"
}

fn t_comparator_order_and_count() {
    var vm = vm_new()
    let r = comparators(mut vm)
    // C oracle (order.out lines 1-6): merge_runs asks cmp(right, left).
    expect(logged(mut vm, r, [3, 1, 2]), "[1, 2, 3] [[1, 3], [2, 1], [2, 3]]")
    expect(
        logged(mut vm, r, [5, 3, 8, 1, 9, 2, 7]),
        "[1, 2, 3, 5, 7, 8, 9] [[3, 5], [1, 8], [2, 9], [1, 3], [8, 3], [8, 5], [7, 2], " +
            "[7, 9], [2, 1], [2, 3], [7, 3], [7, 5], [7, 8], [9, 8]]",
    )
    expect(
        logged(mut vm, r, [4, 4, 1, 4, 0, 9, 9, 2, 6, 5, 3, 8, 7]),
        "[0, 1, 2, 3, 4, 4, 4, 5, 6, 7, 8, 9, 9] [[4, 4], [4, 1], [9, 0], [2, 9], [5, 6], " +
            "[8, 3], [1, 4], [4, 4], [4, 4], [2, 0], [2, 9], [9, 9], [3, 5], [8, 5], [8, 6], " +
            "[0, 1], [2, 1], [2, 4], [9, 4], [9, 4], [9, 4], [7, 3], [7, 5], [7, 6], [7, 8], " +
            "[3, 0], [3, 1], [3, 2], [3, 4], [5, 4], [5, 4], [5, 4], [5, 9], [6, 9], [7, 9], [8, 9]]",
    )
    let up = list_of(mut vm, [1, 2, 3])
    let _ = call(mut vm, 13, [up, root(vm, r, 3)])
    expect(show(vm, vm.stack[0]), "[3, 2, 1]")
    // Stable: equal keys keep their relative order.
    let _ = call(mut vm, 13, [root(vm, r, 9), root(vm, r, 4)])
    expect(show(vm, root(vm, r, 9)), "[[0, \"b\"], [0, \"d\"], [1, \"a\"], [1, \"c\"]]")
}

fn t_comparator_raises_commit_on_success() {
    var vm = vm_new()
    let r = comparators(mut vm)
    // C oracle: the raise on call 2 propagates, the list is untouched and
    // the comparator is never called again.
    let l = list_of(mut vm, [3, 2, 1])
    let _ = call(mut vm, 13, [l, root(vm, r, 5)])
    err_is(mut vm, "div", "division by zero")
    expect(show(vm, vm.stack[0]), "[3, 2, 1]")
    assert(invoke(mut vm, root(vm, r, 7)).i == 2)
    let _ = invoke(mut vm, root(vm, r, 8))
    let f = list_of(mut vm, [3, 2, 1])
    let _ = call(mut vm, 13, [f, root(vm, r, 6)])
    err_is(mut vm, "type", "list.sort: the comparator must return an int, found float")
    expect(show(vm, vm.stack[0]), "[3, 2, 1]")
    assert(invoke(mut vm, root(vm, r, 7)).i == 1)
    // Under two elements the comparator is never called.
    let _ = invoke(mut vm, root(vm, r, 8))
    let single = list_of(mut vm, [5])
    let _ = call(mut vm, 13, [single, root(vm, r, 5)])
    let empty = fl.fl_list_new(mut vm)
    let _ = call(mut vm, 13, [empty, root(vm, r, 5)])
    assert(!vm.raised && invoke(mut vm, root(vm, r, 7)).i == 0)
    let three = list_of(mut vm, [3, 2, 1])
    let _ = call(mut vm, 13, [copy three, fl.fl_int(5)])
    err_is(mut vm, "type", "list.sort: argument 2 must be fn, found int")
    let _ = call(mut vm, 13, [fl.fl_int(5)])
    err_is(mut vm, "type", "list.sort: argument 1 must be list, found int")
    // Sorting moves no structure: an iteration snapshot stays valid.
    let m = mods(vm, three)
    let _ = call(mut vm, 13, [copy three])
    assert(mods(vm, three) == m)
    expect(show(vm, three), "[1, 2, 3]")
}

fn walkers(mut vm: fl.FlVm) -> int {
    eval(
        mut vm,
        "let calls = 0\n" +
            "fn dbl(x) {{ calls = calls + 1\nreturn x * 2 }}\n" +
            "fn gt1(x) {{ calls = calls + 1\nreturn x > 1 }}\n" +
            "fn gt9(x) {{ calls = calls + 1\nreturn x > 9 }}\n" +
            "fn gt0(x) {{ calls = calls + 1\nreturn x > 0 }}\n" +
            "fn add(a, x) {{ return a + x }}\n" +
            "fn no(x) {{ return false }}\nfn yes(x) {{ return true }}\n" +
            "fn bad(x) {{ return x + \"a\" }}\n" +
            "fn ncalls() {{ return calls }}\nfn zero() {{ calls = 0 }}\n" +
            "let fsrc = [\"a\", \"b\", \"c\"]\nlet msrc = [\"a\", \"b\", \"c\"]\n" +
            "fn swap(x) {{ fsrc[0] = \"new\"\nreturn true }}\n" +
            "fn peek(x) {{ msrc[1] = \"z\"\nreturn x }}\n" +
            "fn pair(x) {{ return [x, [x]] }}\nfn grow(a, x) {{ return a + [x] }}\n" +
            "return [dbl, gt1, gt9, gt0, add, no, yes, bad, ncalls, zero, fsrc, msrc, swap, peek, pair, grow]\n",
    )
}

// Run a walk native over xs with walker k; answer the result and the calls.
fn walked(mut vm: fl.FlVm, r: int, kind: int, xs: List[int], k: int) -> str {
    let _ = invoke(mut vm, root(vm, r, 9))
    let l = list_of(mut vm, xs)
    let out = call(mut vm, kind, [l, root(vm, r, k)])
    let shown = show(vm, out)
    let calls = invoke(mut vm, root(vm, r, 8)).i
    "{shown} {calls}"
}

fn t_walks_with_a_function() {
    var vm = vm_new()
    let r = walkers(mut vm)
    expect(walked(mut vm, r, 14, [1, 2], 0), "[2, 4] 2")
    expect(walked(mut vm, r, 15, [1, 2, 3], 1), "[2, 3] 3")
    expect(walked(mut vm, r, 17, [1, 2], 1), "true 2")
    expect(walked(mut vm, r, 17, [5, 1], 1), "true 1")
    expect(walked(mut vm, r, 17, [1, 2], 2), "false 2")
    expect(walked(mut vm, r, 18, [1, 2], 3), "true 2")
    expect(walked(mut vm, r, 18, [1, 2], 1), "false 1")
    expect(walked(mut vm, r, 18, List[int](), 5), "true 0")
    expect(walked(mut vm, r, 17, List[int](), 6), "false 0")
    let l = list_of(mut vm, [1, 2, 3])
    assert(call(mut vm, 16, [l, root(vm, r, 4), fl.fl_int(0)]).i == 6)
    let none = fl.fl_list_new(mut vm)
    assert(call(mut vm, 16, [none, root(vm, r, 4), fl.fl_int(7)]).i == 7)
    // A raise in the callback propagates instead of a half-built result.
    let one = list_of(mut vm, [1])
    let _ = call(mut vm, 14, [copy one, root(vm, r, 7)])
    err_is(mut vm, "type", "cannot add int and str")
    // The callback ran: `one` may have moved, so read it from its root.
    let _ = call(mut vm, 15, [copy vm.stack[0], root(vm, r, 7)])
    err_is(mut vm, "type", "cannot add int and str")
    // reduce hands two arguments to a one-parameter fn: fl_call's arity.
    let _ = call(mut vm, 16, [copy vm.stack[0], root(vm, r, 7), fl.fl_int(0)])
    err_is(mut vm, "arity", "expected 1 arguments, got 2")
    let _ = call(mut vm, 14, [copy vm.stack[0], fl.fl_int(5)])
    err_is(mut vm, "type", "list.map: argument 2 must be fn, found int")
    let _ = call(mut vm, 18, [fl.fl_int(5), root(vm, r, 5)])
    err_is(mut vm, "type", "list.all: argument 1 must be list, found int")
    // filter keeps the item it handed over (stdlist.c:464-471) ...
    let kept = call(mut vm, 15, [root(vm, r, 10), root(vm, r, 12)])
    expect(show(vm, kept), "[\"a\", \"b\", \"c\"]")
    expect(show(vm, root(vm, r, 10)), "[\"new\", \"b\", \"c\"]")
    // ... and map reads l[i] fresh each turn (stdlist.c:436-439).
    let fresh = call(mut vm, 14, [root(vm, r, 11), root(vm, r, 13)])
    expect(show(vm, fresh), "[\"a\", \"z\", \"c\"]")
}

// A collection at every instruction boundary moves every object the walks
// and the sort hold; a stale reference traps at its generation check.
fn t_moving_collections() {
    var vm = vm_new()
    let s = comparators(mut vm)
    let w = walkers(mut vm)
    vm.gc.stress = true
    let before = vm.gc.collections
    expect(
        logged(mut vm, s, [4, 4, 1, 4, 0, 9, 9, 2, 6, 5, 3, 8, 7]),
        "[0, 1, 2, 3, 4, 4, 4, 5, 6, 7, 8, 9, 9] [[4, 4], [4, 1], [9, 0], [2, 9], [5, 6], " +
            "[8, 3], [1, 4], [4, 4], [4, 4], [2, 0], [2, 9], [9, 9], [3, 5], [8, 5], [8, 6], " +
            "[0, 1], [2, 1], [2, 4], [9, 4], [9, 4], [9, 4], [7, 3], [7, 5], [7, 6], [7, 8], " +
            "[3, 0], [3, 1], [3, 2], [3, 4], [5, 4], [5, 4], [5, 4], [5, 9], [6, 9], [7, 9], [8, 9]]",
    )
    assert(vm.gc.collections > before)
    let _ = call(mut vm, 13, [root(vm, s, 9), root(vm, s, 4)])
    expect(show(vm, root(vm, s, 9)), "[[0, \"b\"], [0, \"d\"], [1, \"a\"], [1, \"c\"]]")
    let l = list_of(mut vm, [1, 2, 3])
    let pairs = call(mut vm, 14, [l, root(vm, w, 14)])
    expect(show(vm, pairs), "[[1, [1]], [2, [2]], [3, [3]]]")
    let acc = fl.fl_list_new(mut vm)
    let grown = call(mut vm, 16, [copy vm.stack[0], root(vm, w, 15), acc])
    expect(show(vm, grown), "[1, 2, 3]")
    let kept = call(mut vm, 15, [root(vm, w, 10), root(vm, w, 12)])
    expect(show(vm, kept), "[\"a\", \"b\", \"c\"]")
    let sorted = list_of(mut vm, [3, 1, 2])
    let _ = call(mut vm, 13, [sorted])
    expect(show(vm, vm.stack[0]), "[1, 2, 3]")
    assert(vm.gc.collections > before + 50)
}

fn t_defs_table() {
    let defs = fl.fl_list_defs()
    assert(defs.len == 19)
    var names = ""
    for i in 0..defs.len {
        assert(defs[i].kind == 2000 + i)
        names += defs[i].name + " "
    }
    expect(
        names,
        "len push pop insert remove clear get index_of contains slice concat reverse copy sort map filter reduce any all ",
    )
    assert(
        defs[6].min_ar == 2 && defs[6].max_ar == 3 && defs[13].max_ar == 2 && defs[16].min_ar == 3,
    )
}

fn main() {
    t_grows_and_shrinks()
    t_reads_without_mutating()
    t_total_order()
    t_comparator_order_and_count()
    t_comparator_raises_commit_on_success()
    t_walks_with_a_function()
    t_moving_collections()
    t_defs_table()
    print("PASS stdlist direct: 8 cases")
}
