//! member: false
//!
//! The port of sagitta `tests/unit/test_modes.c` (358 lines), one test per
//! C test in registry order (`tests/unit/registry.c:727-737`). C's
//! `modes_editor` (`test_modes.c:34-41`) is `edit.ed_new()`, a scratch
//! buffer and the runtime configuration (`yew_test_load_runtime`: the
//! built-in `runtime/init.fl`, read from the repository root as the tests
//! run there; the user's configuration is pointed at an empty scratch
//! directory so a host `~/.config/yew/init.fl` never reaches the test).
//! C's `&ed.mode_keys[L]` is the keymap index `edit.km_mode(MODE_L)`.
//!
//! The oracle is built with the fuss module (`YEW_WITH_FUSS=1`, the
//! default `MODULES`), so C's F-mode halves are its `#if YEW_WITH_FUSS`
//! branches: F mode is sagitta Sprint 51, the port's yw13. Each F half
//! asserts the port's refusal by name (`ed.mode.enter F` answers
//! `CMD_ERR_DEFERRED` naming yw13 and leaves the mode) and says SKIP for
//! C's assertion. The numbered tab jumps are `ed.tab.goto` and the jump
//! window (Sprints 23-24, yw05): that case is SKIP by name, after
//! asserting `alt+1` refuses naming its lane. `!` is `ed.shell.open`,
//! whose handler is `edit_cmds.c`'s `yew_edit_cmd_shell_prompt` (the
//! seeded `:` line, ported here); running the shell is yw04's.

use edit
use term
use text

fn say_skip(what: str) -> int {
    print("modes_test: SKIP {what}")
    eprint("modes_test: SKIP {what}")
    1
}

fn key_mods(code: int, mods: int) -> term.Key {
    var k = term.key_new()
    k.code = code
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    k.mods = mods
    k
}

fn key(code: int) -> term.Key {
    var k = key_mods(code, 0)
    if code < 128 {
        (mut k.text).push(code as byte)
    }
    k
}

fn editor() -> edit.Ed {
    let root = env_get("XDG_STATE_HOME") else "target/test-state"
    env_set("XDG_CONFIG_HOME", "{root}/modes-config") else |_| {}
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    edit.ed_load_config(mut ed, edit.startup_default())
    assert(ed.config_error.len == 0, "the runtime configuration loads: {ed.config_error}")
    assert(ed.mode == edit.MODE_L, "starts in L")
    assert(ed.prev_unit == edit.MODE_L, "prev unit L")
    ed
}

fn press(mut ed: edit.Ed, code: int, now: int) {
    edit.ed_handle_key(mut ed, key(code), now)
}

fn t_modes_escape_cancels_chord_before_prompt_or_mode() {
    var ed = editor()
    assert(edit.mode_enter(mut ed, edit.MODE_I) == edit.CMD_OK, "enter I")
    ed.full_damage = false
    edit.ed_prompt(mut ed, edit.PROMPT_QUIT_DIRTY)
    let q = edit.keyid(key(113))
    if ed.chord.seq.len == 0 {
        (mut ed.chord.seq).push(q)
    } else {
        ed.chord.seq[0] = q
    }
    ed.chord.n = 1
    ed.chord.layer = 0
    ed.chord.deadline = 500
    press(mut ed, term.KEY_ESCAPE, 10)
    assert(ed.chord.n == 0, "the chord is gone")
    assert(ed.chord.layer == -1, "no layer")
    assert(ed.chord.deadline == 0, "no deadline")
    assert(ed.prompt == edit.PROMPT_QUIT_DIRTY, "the prompt stays")
    assert(ed.mode == edit.MODE_I, "the mode stays")
}

fn t_modes_every_unit_mode_switches_in_one_key() {
    var from = List[int]()
    var keys = List[int]()
    var want = List[int]()
    (mut from).push(edit.MODE_L)
    (mut keys).push(119)
    (mut want).push(edit.MODE_W)
    (mut from).push(edit.MODE_L)
    (mut keys).push(98)
    (mut want).push(edit.MODE_B)
    (mut from).push(edit.MODE_W)
    (mut keys).push(108)
    (mut want).push(edit.MODE_L)
    (mut from).push(edit.MODE_W)
    (mut keys).push(98)
    (mut want).push(edit.MODE_B)
    (mut from).push(edit.MODE_W)
    (mut keys).push(105)
    (mut want).push(edit.MODE_I)
    (mut from).push(edit.MODE_B)
    (mut keys).push(108)
    (mut want).push(edit.MODE_L)
    (mut from).push(edit.MODE_B)
    (mut keys).push(119)
    (mut want).push(edit.MODE_W)
    (mut from).push(edit.MODE_B)
    (mut keys).push(105)
    (mut want).push(edit.MODE_I)
    var i = 0
    while i < from.len {
        var ed = editor()
        assert(edit.mode_enter(mut ed, from[i]) == edit.CMD_OK, "step {i}: enter")
        assert(ed.mode == from[i], "step {i}: from")
        press(mut ed, keys[i], 10)
        assert(ed.mode == want[i], "step {i}: want {want[i]}, got {ed.mode}")
        i += 1
    }
}

fn refuses_f(ed: edit.Ed, what: str) {
    assert(ed.last_status == edit.CMD_ERR_DEFERRED, "{what}: F refuses")
    assert(ed.msg.active && ed.msg.sev == edit.MSG_ERROR, "{what}: an error message")
    assert(ed.msg.text.contains("(yw13)"), "{what}: naming yw13: {ed.msg.text}")
}

fn t_modes_fuss_opens_from_every_unit_mode() -> int {
    var from = List[int]()
    (mut from).push(edit.MODE_L)
    (mut from).push(edit.MODE_W)
    (mut from).push(edit.MODE_B)
    for m in from {
        var ed = editor()
        assert(edit.mode_enter(mut ed, m) == edit.CMD_OK, "enter {m}")
        press(mut ed, 102, 10)
        refuses_f(ed, "f from mode {m}")
        assert(ed.mode == m, "the mode stays {m}")
    }
    say_skip(
        "modes_fuss_opens_from_every_unit_mode: F mode is sagitta Sprint 51 (yw13); `f` refuses by name from L, W and B",
    )
}

fn t_modes_tab_jumps_are_global_and_insert_keeps_its_digits() -> int {
    var ed = editor()
    edit.ed_handle_key(mut ed, key_mods(49, term.MOD_ALT), 1000)
    assert(ed.last_status == edit.CMD_ERR_DEFERRED, "alt+1 refuses")
    assert(ed.msg.text.contains("(yw05)"), "naming yw05: {ed.msg.text}")
    assert(ed.mode == edit.MODE_L, "the mode stays")
    say_skip(
        "modes_tab_jumps_are_global_and_insert_keeps_its_digits: ed.tab.goto and the jump window are sagitta Sprints 23-24 (yw05); alt+1 refuses by name",
    )
}

fn t_modes_escape_cancels_count_before_prompt_or_mode() {
    var ed = editor()
    assert(edit.mode_enter(mut ed, edit.MODE_I) == edit.CMD_OK, "enter I")
    ed.full_damage = false
    edit.ed_prompt(mut ed, edit.PROMPT_QUIT_DIRTY)
    ed.chord.count = 42
    ed.chord.count_given = true
    press(mut ed, term.KEY_ESCAPE, 10)
    assert(!ed.chord.count_given, "the count is gone")
    assert(ed.chord.count == 0, "count 0")
    assert(ed.prompt == edit.PROMPT_QUIT_DIRTY, "the prompt stays")
    assert(ed.mode == edit.MODE_I, "the mode stays")
}

fn t_modes_escape_closes_prompt_before_changing_mode() {
    var ed = editor()
    assert(edit.mode_enter(mut ed, edit.MODE_I) == edit.CMD_OK, "enter I")
    ed.full_damage = false
    edit.ed_prompt(mut ed, edit.PROMPT_QUIT_DIRTY)
    assert(ed.msg.active, "the prompt is on the message line")
    press(mut ed, term.KEY_ESCAPE, 10)
    assert(ed.prompt == edit.PROMPT_NONE, "the prompt closes")
    assert(!ed.msg.active, "the message clears")
    assert(ed.mode == edit.MODE_I, "the mode stays")
    assert(!ed.full_damage, "no full repaint")
}

fn t_modes_escape_from_insert_enters_line_and_repaints() {
    var ed = editor()
    assert(edit.mode_enter(mut ed, edit.MODE_I) == edit.CMD_OK, "enter I")
    ed.full_damage = false
    press(mut ed, term.KEY_ESCAPE, 10)
    assert(ed.last_status == edit.CMD_OK, "escape answers OK")
    assert(ed.mode == edit.MODE_L, "back to L")
    assert(ed.prev_unit == edit.MODE_L, "prev unit L")
    assert(!ed.full_damage, "no full repaint")
    assert(ed.keys[0] == edit.km_mode(edit.MODE_L), "L's keymap is the base layer")
}

fn t_modes_escape_in_line_is_repaint_noop() {
    var ed = editor()
    ed.full_damage = false
    press(mut ed, term.KEY_ESCAPE, 10)
    assert(ed.mode == edit.MODE_L, "L stays")
    assert(ed.last_status == edit.CMD_OK, "escape answers OK")
    assert(!ed.full_damage, "no full repaint")
    assert(ed.dispatch_count == 1, "one dispatch: {ed.dispatch_count}")
}

fn t_modes_deferred_entries_name_their_sprints() -> int {
    var ed = editor()
    press(mut ed, 101, 10)
    assert(ed.last_status == edit.CMD_OK, "e answers OK")
    assert(ed.mode == edit.MODE_E, "E mode")
    assert(ed.cmdline.active, "the command line is open")
    press(mut ed, term.KEY_ESCAPE, 11)
    assert(ed.mode == edit.MODE_L, "escape returns to L")
    assert(!ed.cmdline.active, "the command line closes")
    press(mut ed, 102, 12)
    refuses_f(ed, "f from L")
    assert(ed.mode == edit.MODE_L, "the mode stays L")
    say_skip(
        "modes_deferred_entries_name_their_sprints' F half: F mode is sagitta Sprint 51 (yw13); `f` refuses by name",
    )
}

fn t_modes_bang_seeds_shell_command_from_command_modes() {
    var from = List[int]()
    (mut from).push(edit.MODE_L)
    (mut from).push(edit.MODE_W)
    (mut from).push(edit.MODE_B)
    (mut from).push(edit.MODE_H)
    for m in from {
        var ed = editor()
        if m != edit.MODE_L {
            assert(edit.mode_enter(mut ed, m) == edit.CMD_OK, "enter {m}")
        }
        press(mut ed, 33, 10)
        assert(ed.last_status == edit.CMD_OK, "! from {m} answers OK")
        assert(ed.mode == edit.MODE_E, "E mode")
        assert(ed.cmdline.active, "the command line is open")
        assert(ed.cmdline.kind == edit.PROMPT_CMD, "the : prompt")
        assert(ed.cmdline.return_mode == m, "returning to {m}")
        let w = ed.cmdline.target_win
        assert(w >= 0, "the command line has its window")
        let b = ed.wins[w].buf
        let tb = ed.bufs[b].ec.tb
        assert(text.textbuf_len(tb) == 1, "one byte seeded")
        assert(text.textbuf_byte_at(tb, 0) == 33, "it is !")
    }
}

fn t_modes_only_line_and_insert_are_enterable_in_sprint14() -> int {
    var ed = editor()
    assert(edit.mode_enter(mut ed, edit.MODE_I) == edit.CMD_OK, "enter I")
    assert(ed.mode == edit.MODE_I && ed.prev_unit == edit.MODE_L, "I, prev L")
    assert(edit.mode_enter(mut ed, edit.MODE_L) == edit.CMD_OK, "enter L")
    assert(ed.mode == edit.MODE_L && ed.prev_unit == edit.MODE_L, "L, prev L")
    assert(edit.mode_enter(mut ed, edit.MODE_W) == edit.CMD_OK, "enter W")
    assert(ed.mode == edit.MODE_W && ed.prev_unit == edit.MODE_W, "W, prev W")
    assert(edit.mode_enter(mut ed, edit.MODE_B) == edit.CMD_OK, "enter B")
    assert(ed.mode == edit.MODE_B && ed.prev_unit == edit.MODE_B, "B, prev B")
    assert(edit.mode_enter(mut ed, edit.MODE_E) == edit.CMD_OK, "enter E")
    assert(ed.mode == edit.MODE_E, "E")
    assert(ed.cmdline.active, "the command line is open")
    edit.cmdline_close(mut ed, false)
    assert(ed.mode == edit.MODE_B, "closing returns to B")
    assert(
        edit.mode_enter(mut ed, edit.MODE_F) == edit.CMD_ERR_DEFERRED,
        "F refuses by name (yw13)",
    )
    assert(ed.mode == edit.MODE_B, "the mode stays B")
    assert(edit.mode_enter(mut ed, edit.MODE_L) == edit.CMD_OK, "enter L, as C's F half leaves it")
    assert(edit.mode_enter(mut ed, edit.MODE_N) == edit.CMD_ERR_ARG, "MODE_N is no mode")
    assert(ed.mode == edit.MODE_L, "L")
    say_skip(
        "modes_only_line_and_insert_are_enterable_in_sprint14's F step: F mode is sagitta Sprint 51 (yw13); enter F refuses by name",
    )
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    var skips = 0
    t_modes_escape_cancels_chord_before_prompt_or_mode()
    t_modes_every_unit_mode_switches_in_one_key()
    skips += t_modes_fuss_opens_from_every_unit_mode()
    skips += t_modes_tab_jumps_are_global_and_insert_keeps_its_digits()
    t_modes_escape_cancels_count_before_prompt_or_mode()
    t_modes_escape_closes_prompt_before_changing_mode()
    t_modes_escape_from_insert_enters_line_and_repaints()
    t_modes_escape_in_line_is_repaint_noop()
    skips += t_modes_deferred_entries_name_their_sprints()
    t_modes_bang_seeds_shell_command_from_command_modes()
    skips += t_modes_only_line_and_insert_are_enterable_in_sprint14()
    print("modes_test: 11 cases run, {skips} SKIP by name (F mode yw13, tab jumps yw05)")
}
