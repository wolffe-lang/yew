//! member: false
//!
//! The port of sagitta `tests/unit/test_fusscommit.c` (201 lines), one test
//! per C test in registry order: COMMIT_EDITMSG comment selection and
//! cleanup, pure bytes. C's `FC_BYTES("…")` is a byte list; C's NULL with a
//! nonzero length is a length past the list (`git.fusscommit`'s header).
//!
//! `YEW_PICK_CASE=N` runs case N alone (the checked machine's per-case run).

use git

fn b(s: str) -> List[byte] {
    var v = List[byte]()
    for x in s.bytes() {
        (mut v).push(x)
    }
    v
}

fn raw(xs: List[int]) -> List[byte] {
    var v = List[byte]()
    for x in xs {
        (mut v).push(x as byte)
    }
    v
}

fn same(a: List[byte], want: List[byte]) -> bool {
    git.git_bytes_cmp(a, want) == 0
}

// `fc_assert_clean` (`test_fusscommit.c:8-20`).
fn assert_clean(input: List[byte], comment: int, want: List[byte]) {
    var clean = List[byte]()
    let nonempty = git.fuss_commit_cleanup(mut clean, input, input.len, comment)
    assert(same(clean, want), "cleaned bytes")
    assert(nonempty == (want.len != 0), "nonempty verdict")
}

// `:22-35`.
fn fusscommit_strips_comments_by_first_nonblank_byte() {
    assert_clean(
        b(
            "subject\n # template\n\t# tabbed template\nbody # retained\n  body\n\x0b# vertical-tab is not blank",
        ),
        35,
        b("subject\nbody # retained\n  body\n\x0b# vertical-tab is not blank"),
    )
    assert_clean(b("subject\r\n \t; template\r\nbody\r\n"), 59, b("subject\nbody"))
}

// `:37-44`.
fn fusscommit_trims_ascii_trailing_space_and_crlf() {
    assert_clean(b("subject \t\x0b\x0c\r\nbody\t \r\nlast"), 35, b("subject\nbody\nlast"))
}

// `:46-54`.
fn fusscommit_collapses_blank_runs_and_trims_outer_blanks() {
    assert_clean(b("\n \t\nsubject\n\n\t\n\nbody\n\n\t\n"), 35, b("subject\n\nbody"))
}

// `:56-68`.
fn fusscommit_comment_lines_do_not_create_blank_lines() {
    assert_clean(b("subject\n# one\n  # two\nbody"), 35, b("subject\nbody"))
    assert_clean(b("subject\n\n# ignored\n\n\nbody\n# trailing"), 35, b("subject\n\nbody"))
}

// `:70-88`.
fn fusscommit_auto_uses_order_and_first_nonblank_bytes() {
    let input = b("  # heading\ntext ; retained\n\t; heading")
    let (ok, sel) = git.fuss_commit_select_comment(input, input.len, b("auto"))
    assert(ok, "auto resolves")
    assert(sel == 64, "auto skips # and ;")
    let used = b("#\n;\n@\n!\n$\n%\n^\n&\n|")
    let expected = b(";@!$%^&|:")
    var n = 1
    while n <= expected.len {
        let (o, s) = git.fuss_commit_select_comment(used, n * 2 - 1, b("auto"))
        assert(o, "auto progressive {n}")
        assert(s == expected[n - 1] as int, "auto progressive choice {n}")
        n += 1
    }
}

// `:90-98`.
fn fusscommit_auto_ignores_candidates_inside_content() {
    let input = b("subject #1; @owner! $cash %done ^top &more | pipe:")
    let (ok, sel) = git.fuss_commit_select_comment(input, input.len, b("auto"))
    assert(ok, "auto resolves")
    assert(sel == 35, "content is not a line start")
}

// `:100-109`.
fn fusscommit_auto_reports_candidate_exhaustion() {
    let input = b("# a\n; b\n@ c\n! d\n$ e\n% f\n^ g\n& h\n| i\n: j")
    let (ok, _) = git.fuss_commit_select_comment(input, input.len, b("auto"))
    assert(!ok, "exhausted")
}

// `:111-126`.
fn fusscommit_default_explicit_and_invalid_settings() {
    let m = b("message")
    let (o1, s1) = git.fuss_commit_select_comment(m, m.len, List[byte]())
    assert(o1 && s1 == 35, "absent setting is #")
    let (o2, s2) = git.fuss_commit_select_comment(m, m.len, b(";"))
    assert(o2 && s2 == 59, "explicit byte")
    let (o3, _) = git.fuss_commit_select_comment(m, m.len, b("Auto"))
    assert(!o3, "Auto is not auto")
    let (o4, _) = git.fuss_commit_select_comment(m, m.len, b("\n"))
    assert(!o4, "LF refused")
}

// `:128-141`.
fn fusscommit_preserves_embedded_nul_bytes() {
    assert_clean(raw([97, 0, 98, 32, 10, 99, 0, 100]), 35, raw([97, 0, 98, 10, 99, 0, 100]))
    assert_clean(
        raw([0, 35, 120, 32, 9, 10, 35, 100, 114, 111, 112, 10, 122, 32, 0, 32, 9]),
        35,
        raw([0, 35, 120, 10, 122, 32, 0]),
    )
}

// `:143-165`.
fn fusscommit_cleanup_is_idempotent() {
    let input = b("\nsubject  \n\n\nbody\t\n# template\n")
    var once = List[byte]()
    var twice = List[byte]()
    assert(git.fuss_commit_cleanup(mut once, input, input.len, 35), "once")
    assert(git.fuss_commit_cleanup(mut twice, once, once.len, 35), "twice")
    assert(same(twice, once), "idempotent")
    for x in b("stale") {
        (mut twice).push(x)
    }
    let r = b("replacement")
    assert(git.fuss_commit_cleanup(mut twice, r, r.len, 35), "replace")
    assert(same(twice, r), "previous contents replaced")
}

// `:167-186`.
fn fusscommit_empty_detection_is_byte_exact() {
    assert(git.fuss_commit_empty(List[byte](), 0), "empty")
    assert(!git.fuss_commit_empty(raw([0]), 1), "NUL is not empty")
    let spaces = b(" \t\n")
    assert(!git.fuss_commit_empty(spaces, spaces.len), "spaces are not empty")
    var clean = List[byte]()
    assert(!git.fuss_commit_cleanup(mut clean, spaces, spaces.len, 35), "spaces clean to nothing")
    assert(git.fuss_commit_empty(clean, clean.len), "cleaned spaces empty")
    let comments = b("# one\n  # two\n")
    assert(
        !git.fuss_commit_cleanup(mut clean, comments, comments.len, 35),
        "comments clean to nothing",
    )
    assert(git.fuss_commit_empty(clean, clean.len), "cleaned comments empty")
}

// `:188-201`: C's NULL with a nonzero length is a length past the list.
fn fusscommit_rejects_invalid_pointer_length_pairs() {
    let (o1, _) = git.fuss_commit_select_comment(List[byte](), 1, List[byte]())
    assert(!o1, "select refuses a length past the bytes")
    var clean = b("kept?")
    assert(
        !git.fuss_commit_cleanup(mut clean, List[byte](), 1, 35),
        "cleanup refuses a length past the bytes",
    )
    assert(clean.len == 0, "and leaves nothing behind")
}

fn main() {
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    var n = 0
    if chosen < 0 || chosen == 0 {
        fusscommit_strips_comments_by_first_nonblank_byte()
        print("fusscommit_strips_comments_by_first_nonblank_byte: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 1 {
        fusscommit_trims_ascii_trailing_space_and_crlf()
        print("fusscommit_trims_ascii_trailing_space_and_crlf: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 2 {
        fusscommit_collapses_blank_runs_and_trims_outer_blanks()
        print("fusscommit_collapses_blank_runs_and_trims_outer_blanks: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 3 {
        fusscommit_comment_lines_do_not_create_blank_lines()
        print("fusscommit_comment_lines_do_not_create_blank_lines: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 4 {
        fusscommit_auto_uses_order_and_first_nonblank_bytes()
        print("fusscommit_auto_uses_order_and_first_nonblank_bytes: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 5 {
        fusscommit_auto_ignores_candidates_inside_content()
        print("fusscommit_auto_ignores_candidates_inside_content: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 6 {
        fusscommit_auto_reports_candidate_exhaustion()
        print("fusscommit_auto_reports_candidate_exhaustion: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 7 {
        fusscommit_default_explicit_and_invalid_settings()
        print("fusscommit_default_explicit_and_invalid_settings: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 8 {
        fusscommit_preserves_embedded_nul_bytes()
        print("fusscommit_preserves_embedded_nul_bytes: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 9 {
        fusscommit_cleanup_is_idempotent()
        print("fusscommit_cleanup_is_idempotent: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 10 {
        fusscommit_empty_detection_is_byte_exact()
        print("fusscommit_empty_detection_is_byte_exact: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 11 {
        fusscommit_rejects_invalid_pointer_length_pairs()
        print("fusscommit_rejects_invalid_pointer_length_pairs: PASS")
        n += 1
    }
    print("git_fusscommit_test: {n} cases run")
}
