//! member: false
//!
//! The port of sagitta `tests/unit/test_groupfromdir.c` (262 lines), one
//! test per C test in registry order (`tests/unit/registry.c:1819-1823`),
//! with two port cases after them. C's fixture is a `mkdtemp` tree
//! `/tmp/yew-group-dir-XXXXXX` (canonical) holding `a.txt`, `z.txt`,
//! `ignored.txt` (named by its `.gitignore`), `sub/m.txt` and
//! `.git/index`, made in a scrambled order (`gd_make`, `:39-73`); the
//! port's is the same tree under `/tmp/yew-group-dir-NNNNNN`.
//!
//! The four cases that call `yew_group_from_dir` run over the port's
//! walk (`ws.walk`, yw06): sorted, recursive or one level, `.gitignore`
//! respected or not, `.git/` and dotfiles out. Two **port cases**
//! (`port_*`) keep the post-walk half (`group_from_files`) tested on its
//! own: fed the listing C's walk gives the fixture it holds case 1's
//! every assertion after the walk, and fed a listing past the cap it
//! waits in the picker with every file preselected.
//!
//! `YEW_PICK_CASE=N` runs case N alone (the checked machine's per-case
//! run, G29).

use edit
use term
use text

fn fresh_dir(prefix: str) -> str {
    var tries = 0
    while tries < 100 {
        var suffix = ""
        for r in os_random(6) {
            suffix = suffix + "{r % 10}"
        }
        let dir = "/tmp/{prefix}-{suffix}"
        fs_create_dir_mode(dir, 448) else |e| match e {
            exists => {
                tries += 1
                continue
            },
            denied => { assert(false, "mkdtemp denied") },
            invalid => { assert(false, "mkdtemp invalid") },
            not_found => { assert(false, "mkdtemp not found") },
            unsupported => { assert(false, "mkdtemp unsupported") },
            io => { assert(false, "mkdtemp io") },
        }
        return dir
    }
    assert(false, "mkdtemp exhausted")
    ""
}

struct Tree {
    root: str,
    sub: str,
    git: str,
    a: str,
    z: str,
    nested: str,
    ignored: str,
    git_file: str,
    ignore_file: str,
}

fn write_text(path: str, s: str) {
    var body = List[byte]()
    for b in s.bytes() {
        (mut body).push(b)
    }
    fs_write_bytes(path, body) else |_| {
        assert(false, "write {path}")
    }
}

// `gd_make` (`:39-73`): deliberately scrambled creation order.
fn gd_make() -> Tree {
    let made = fresh_dir("yew-group-dir")
    let root = text.file_realpath(made) else made
    let t = Tree {
        root: root,
        sub: "{root}/sub",
        git: "{root}/.git",
        a: "{root}/a.txt",
        z: "{root}/z.txt",
        nested: "{root}/sub/m.txt",
        ignored: "{root}/ignored.txt",
        git_file: "{root}/.git/index",
        ignore_file: "{root}/.gitignore",
    }
    fs_create_dir_mode(t.sub, 448) else |_| {
        assert(false, "mkdir sub")
    }
    fs_create_dir_mode(t.git, 448) else |_| {
        assert(false, "mkdir .git")
    }
    write_text(t.z, "group from dir\n")
    write_text(t.nested, "group from dir\n")
    write_text(t.ignored, "group from dir\n")
    write_text(t.a, "group from dir\n")
    write_text(t.git_file, "group from dir\n")
    write_text(t.ignore_file, "ignored.txt\n")
    t
}

// `gd_remove` (`:75-86`).
fn gd_remove(t: Tree) {
    fs_remove(t.a) else |_| {}
    fs_remove(t.z) else |_| {}
    fs_remove(t.nested) else |_| {}
    fs_remove(t.ignored) else |_| {}
    fs_remove(t.git_file) else |_| {}
    fs_remove(t.ignore_file) else |_| {}
    fs_remove_dir(t.sub) else |_| {}
    fs_remove_dir(t.git) else |_| {}
    fs_remove_dir(t.root) else |_| {}
}

// `gd_ed` (`:88-95`).
fn gd_ed() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    ed
}

// `gd_key` (`:97-105`).
fn gd_key(code: int) -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    k.code = code
    k
}

fn opts_of(recursive: bool, respect_ignore: bool, max_members: int, label: str) -> edit.GroupFromDirOpts {
    var o = edit.group_from_dir_opts()
    o.recursive = recursive
    o.respect_ignore = respect_ignore
    o.max_members = max_members
    o.label = label
    o
}

// `test_groupfromdir_sorted_recursive_ignored_and_one_read` (`:107-139`).
fn groupfromdir_sorted_recursive_ignored_and_one_read() {
    let t = gd_make()
    var ed = gd_ed()
    let opts = opts_of(true, true, edit.GROUP_MAX_MEMBERS, "work")
    let reads = text.file_load_count()
    let gid = edit.group_from_dir(mut ed, t.root, opts)
    assert(gid != 0, "a group: {ed.msg.text}")
    assert(text.file_load_count() == reads + 1, "exactly one read")
    let m = edit.group_members(ed, gid)
    assert(m.len == 3, "three members: {m.len}")
    assert(ed.tabs[m[0]].path == t.a, "a first")
    assert(ed.tabs[m[1]].path == t.nested, "sub/m second")
    assert(ed.tabs[m[2]].path == t.z, "z last")
    let at = edit.group_find(ed, gid)
    assert(ed.groups[at].label == "work", "the label")
    assert(ed.groups[at].dir_path == t.root, "the origin")
    assert(ed.groups[at].has_last && ed.groups[at].last_active_member == t.a, "the resume point")
    assert(ed.tab_active == m[0], "viewing the first")
    assert(edit.tab_is_resident(ed, m[0]), "the first read")
    assert(!edit.tab_is_resident(ed, m[1]), "the second deferred")
    assert(!edit.tab_is_resident(ed, m[2]), "the third deferred")
    assert(edit.tab_find_by_path(ed, t.ignored) == -1, "the ignored file is not a tab")
    assert(edit.tab_find_by_path(ed, t.git_file) == -1, ".git is not walked")
    gd_remove(t)
}

// `test_groupfromdir_nonrecursive_and_default_label` (`:141-158`).
fn groupfromdir_nonrecursive_and_default_label() {
    let t = gd_make()
    var ed = gd_ed()
    let opts = opts_of(false, false, edit.GROUP_MAX_MEMBERS, "")
    let gid = edit.group_from_dir(mut ed, t.root, opts)
    assert(gid != 0, "a group: {ed.msg.text}")
    assert(edit.group_member_count(ed, gid) == 3, "three: {edit.group_member_count(ed, gid)}")
    assert(edit.tab_find_by_path(ed, t.nested) == -1, "one level only")
    let at = edit.group_find(ed, gid)
    assert(ed.groups[at].label.contains("yew-group-dir-"), "named for the directory: {ed.groups[at].label}")
    gd_remove(t)
}

// `test_groupfromdir_adopts_without_duplicate_and_repairs_ordinals`
// (`:160-192`).
fn groupfromdir_adopts_without_duplicate_and_repairs_ordinals() {
    let t = gd_make()
    var ed = gd_ed()
    let opts = opts_of(false, false, edit.GROUP_MAX_MEMBERS, "")
    let a = edit.tab_open(mut ed, t.a)
    let nested = edit.tab_open(mut ed, t.nested)
    assert(a >= 0 && nested >= 0, "two tabs")
    let old_gid = edit.group_create(mut ed, t.root, "old")
    edit.group_add_member(mut ed, old_gid, a)
    edit.group_add_member(mut ed, old_gid, nested)
    let tabs_before = ed.tabs.len
    let new_gid = edit.group_from_dir(mut ed, t.root, opts)
    assert(new_gid != 0, "a group: {ed.msg.text}")
    // a is adopted, while z and ignored are newly opened.
    assert(ed.tabs.len == tabs_before + 2, "two new tabs: {ed.tabs.len - tabs_before}")
    assert(edit.group_member_count(ed, new_gid) == 3, "three members")
    assert(edit.group_member_count(ed, old_gid) == 1, "the old group keeps one")
    assert(ed.tabs[nested].group_ordinal == 1, "its ordinal repaired")
    assert(edit.tab_find_by_path(ed, t.a) == a, "a is the same tab")
    gd_remove(t)
}

// `test_groupfromdir_empty_reports_and_oversize_waits_for_confirm`
// (`:194-224`).
fn groupfromdir_empty_reports_and_oversize_waits_for_confirm() {
    let t = gd_make()
    var ed = gd_ed()
    let opts = opts_of(false, true, 1, "")
    let empty = fresh_dir("yew-group-empty")
    assert(edit.group_from_dir(mut ed, empty, edit.group_from_dir_opts()) == 0, "nothing from an empty directory")
    assert(ed.groups.len == 0, "no group")
    assert(ed.msg.text.contains("no files in"), "said so: {ed.msg.text}")
    let tabs_before = ed.tabs.len
    assert(edit.group_from_dir(mut ed, t.root, opts) == 0, "no group yet")
    assert(edit.gp_active(ed), "the picker waits")
    assert(ed.groups.len == 0, "nothing made yet")
    assert(ed.tabs.len == tabs_before, "no tab yet")
    assert(edit.gp_key(mut ed, gd_key(term.KEY_TAB)), "tab")
    assert(edit.gp_key(mut ed, gd_key(term.KEY_ENTER)), "enter")
    assert(ed.groups.len == 0, "confirmed, not applied")
    edit.gp_apply(mut ed)
    assert(ed.groups.len == 1, "applied")
    assert(edit.group_member_count(ed, ed.groups[0].id) == 2, "both preselected files")
    gd_remove(t)
    fs_remove_dir(empty) else |_| {}
}

// `test_groupfromdir_command_opens_empty_picker_and_cancel_is_inert`
// (`:226-262`).
fn groupfromdir_command_opens_empty_picker_and_cancel_is_inert() {
    let t = gd_make()
    var ed = gd_ed()
    let tabs_before = ed.tabs.len
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    cx.sarg = t.root
    cx.has_sarg = true
    assert(edit.group_cmd_from_dir(mut ed, cx) == edit.CMD_OK, "the command")
    assert(edit.gp_active(ed), "the picker is up")
    assert(edit.gp_result(ed) == edit.GP_PENDING, "pending")
    assert(edit.gp_count(ed) == 0, "nothing ticked")
    assert(
        edit.gp_name(ed).contains("yew-group-dir-"),
        "named for the directory: {edit.gp_name(ed)}",
    )
    assert(ed.groups.len == 0, "no group yet")
    assert(ed.tabs.len == tabs_before, "no tab yet")
    assert(edit.gp_key(mut ed, gd_key(term.KEY_ESCAPE)), "esc taken")
    edit.gp_apply(mut ed)
    assert(!edit.gp_active(ed), "down")
    assert(edit.gp_result(ed) == edit.GP_CANCELLED, "cancelled")
    assert(ed.groups.len == 0, "inert: no group")
    assert(ed.tabs.len == tabs_before, "inert: no tab")
    var fx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    fx.sarg = t.a
    fx.has_sarg = true
    assert(edit.group_cmd_from_dir(mut ed, fx) == edit.CMD_ERR_ARG, "a file is refused")
    assert(!edit.gp_active(ed), "no picker for a file")
    assert(ed.msg.text.contains("cannot open group picker"), "said so: {ed.msg.text}")
    gd_remove(t)
}

// Port: case 1's assertions after the walk, fed the walk's listing.
fn port_groupfromdir_after_the_walk_sorted_and_one_read() {
    let t = gd_make()
    var ed = gd_ed()
    var opts = edit.group_from_dir_opts()
    opts.label = "work"
    var files = List[str]()
    (mut files).push("a.txt")
    (mut files).push("sub/m.txt")
    (mut files).push("z.txt")
    let reads = text.file_load_count()
    let gid = edit.group_from_files(mut ed, t.root, opts, files, false)
    assert(gid != 0, "a group")
    assert(text.file_load_count() == reads + 1, "exactly one read")
    let m = edit.group_members(ed, gid)
    assert(m.len == 3, "three members")
    assert(ed.tabs[m[0]].path == t.a, "a first")
    assert(ed.tabs[m[1]].path == t.nested, "sub/m second")
    assert(ed.tabs[m[2]].path == t.z, "z last")
    let at = edit.group_find(ed, gid)
    assert(ed.groups[at].label == "work", "the label")
    assert(ed.groups[at].dir_path == t.root, "the origin")
    assert(ed.groups[at].has_last && ed.groups[at].last_active_member == t.a, "the resume point")
    assert(ed.tab_active == m[0], "viewing the first")
    assert(edit.tab_is_resident(ed, m[0]), "the first read")
    assert(!edit.tab_is_resident(ed, m[1]), "the second deferred")
    assert(!edit.tab_is_resident(ed, m[2]), "the third deferred")
    assert(edit.tab_find_by_path(ed, t.ignored) == -1, "the ignored file is not a tab")
    gd_remove(t)
}

// Port: case 4's second half — past the cap, the picker waits with every
// walked file preselected, and a confirm makes the group.
fn port_groupfromdir_after_the_walk_oversize_waits_for_confirm() {
    let t = gd_make()
    var ed = gd_ed()
    var opts = edit.group_from_dir_opts()
    opts.max_members = 1
    var files = List[str]()
    (mut files).push("a.txt")
    (mut files).push("z.txt")
    let tabs_before = ed.tabs.len
    assert(edit.group_from_files(mut ed, t.root, opts, files, false) == 0, "no group yet")
    assert(edit.gp_active(ed), "the picker waits")
    assert(ed.groups.len == 0 && ed.tabs.len == tabs_before, "nothing made yet")
    assert(edit.gp_key(mut ed, gd_key(term.KEY_TAB)), "tab")
    assert(edit.gp_key(mut ed, gd_key(term.KEY_ENTER)), "enter")
    assert(ed.groups.len == 0, "confirmed, not applied")
    edit.gp_apply(mut ed)
    assert(ed.groups.len == 1, "applied")
    assert(edit.group_member_count(ed, ed.groups[0].id) == 2, "both preselected files")
    gd_remove(t)
}

fn main() {
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    var n = 0
    if chosen < 0 || chosen == 0 {
        groupfromdir_sorted_recursive_ignored_and_one_read()
        print("groupfromdir_sorted_recursive_ignored_and_one_read: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 1 {
        groupfromdir_nonrecursive_and_default_label()
        print("groupfromdir_nonrecursive_and_default_label: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 2 {
        groupfromdir_adopts_without_duplicate_and_repairs_ordinals()
        print("groupfromdir_adopts_without_duplicate_and_repairs_ordinals: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 3 {
        groupfromdir_empty_reports_and_oversize_waits_for_confirm()
        print("groupfromdir_empty_reports_and_oversize_waits_for_confirm: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 4 {
        groupfromdir_command_opens_empty_picker_and_cancel_is_inert()
        print("groupfromdir_command_opens_empty_picker_and_cancel_is_inert: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 5 {
        port_groupfromdir_after_the_walk_sorted_and_one_read()
        print("port_groupfromdir_after_the_walk_sorted_and_one_read: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 6 {
        port_groupfromdir_after_the_walk_oversize_waits_for_confirm()
        print("port_groupfromdir_after_the_walk_oversize_waits_for_confirm: PASS")
        n += 1
    }
    print("groupfromdir_test: {n} cases pass")
}
