//! flfix — Sprint 31's shared Fletch test fixture, sagitta 9ace98c2
//! tests/unit/flfix.h:1-104 and flfix.c:1-229. A RESULT IS RENDERED AS
//! TEXT and a raise reads `!kind: msg`, so a positive and a negative case
//! sit on adjacent lines of a test; the renderer is deliberately dumb
//! (scalars only: a test that needs inside a list asks fmt.repr).
//! Bytes are verbatim: run_bytes never replaces an invalid byte, and the
//! comparison stops at a NUL as C's YEW_ASSERT_EQ_STR does.

use fl

/// flfix.h:27-38's FlFix: the VM, the origin every program compiles under,
/// the first diagnostic and the count, and the private directory.
pub struct FlFix {
    vm: fl.FlVm,
    origin: fl.FlOrigin,
    first: str,
    ndiag: int,
    tmp: str,
    has_tmp: bool,
}

/// FL_EQ's buffer: a rendered outcome is at most 8191 bytes (flfix.h:93).
const FLFIX_CAP: int = 8191

/// flfix.c:30-41: CLI origin, no grants, the builtin modules registered.
pub fn open() -> FlFix {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    fl.fl_std_register(mut vm)
    FlFix {
        vm: vm,
        origin: fl.fl_origin_new(fl.FL_ORIGIN_CLI, 0),
        first: "",
        ndiag: 0,
        tmp: "",
        has_tmp: false,
    }
}

/// flfix.c:57-65: the private directory goes with the fixture.
pub fn close(mut f: FlFix) {
    if f.has_tmp { let _ = fs_remove_dir_all(f.tmp) else |_| {} }
    f.has_tmp = false
}

/// flfix.c:67-90: a private directory with the origin re-pointed at
/// `<dir>/init.fl`, so a quoted import and io.glob resolve inside it.
pub fn tmpdir(mut f: FlFix) -> str {
    if f.has_tmp { return copy f.tmp }
    var made = ""
    var tries = 0
    while tries < 100 && made.len == 0 {
        var suffix = ""
        for r in os_random(6) { suffix = suffix + "{r % 10}" }
        let dir = "/tmp/yew-flfix-{suffix}"
        fs_create_dir_mode(dir, 448) else |e| match e {
            exists => {
                tries += 1
                continue
            },
            _ => { assert(false, "flfix: mkdtemp failed") },
        }
        made = dir
    }
    assert(made.len != 0, "flfix: mkdtemp exhausted")
    f.tmp = fs_realpath(made) else made
    f.has_tmp = true
    let init = "{f.tmp}/init.fl"
    f.origin.path_id = fl.fl_intern(mut f.vm.strings, init.bytes(), 0, init.len)
    copy f.tmp
}

/// flfix.c:92-102: one file under the private directory.
pub fn write(mut f: FlFix, rel: str, body: str) {
    let dir = tmpdir(mut f)
    fs_write_text("{dir}/{rel}", body) else |_| { assert(false, "flfix: write {rel}") }
}

/// flfix.c:104-110: one directory under the private directory.
pub fn mkdir(mut f: FlFix, rel: str) {
    let dir = tmpdir(mut f)
    fs_create_dir_mode("{dir}/{rel}", 511) else |_| { assert(false, "flfix: mkdir {rel}") }
}

/// flfix.c:112-116's flfix_as: re-origin in place; caps is a FL_CAP_* mask.
pub fn set_origin(mut f: FlFix, kind: int, caps: int) {
    f.origin.kind = kind
    f.origin.caps = caps
}

fn upto_nul(b: List[byte], cap: int) -> List[byte] {
    var out = List[byte]()
    for x in b {
        if x as int == 0 || out.len >= cap { break }
        (mut out).push(x)
    }
    out
}

/// flfix.c:119-135: one string field of the error map, as C's
/// `snprintf("%.*s")` into a `cap`-byte buffer reads it.
fn err_field(mut vm: fl.FlVm, err: fl.FlValue, key: str, cap: int) -> List[byte] {
    if err.t != fl.FL_MAP { return List[byte]() }
    let k = fl.fl_str_text(mut vm, key)
    let got = fl.fl_map_get(vm, err, k) else { return List[byte]() }
    if got.t != fl.FL_STR { return List[byte]() }
    upto_nul(vm.gc.slots[fl.fl_obj_index(vm, got)].bytes, cap - 1)
}

fn diag_reset(mut f: FlFix, src: List[byte]) -> int {
    f.ndiag = 0
    f.first = ""
    // Rebuilt per program (flfix.c:144-152), so a long test file never
    // fills one context's file table.
    f.vm.dc = fl.fl_diag_init()
    fl.fl_diag_add_file(mut f.vm.dc, "t.fl", src)
}

fn diag_take(mut f: FlFix) {
    f.ndiag = f.vm.dc.entries.len
    if f.ndiag != 0 { f.first = copy f.vm.dc.entries[0].msg }
}

fn text_bytes(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() { (mut out).push(b) }
    out
}

/// flfix.c:137-200: compile and run `src`, the outcome as text — a
/// string's bytes, `42`/`true`/`nil`, `<type>` for anything else (floats
/// included: their spelling is fmt's business), `!kind: msg` for a raise,
/// `!parse` (the first diagnostic in f.first) or `!compile`.
pub fn run_bytes(mut f: FlFix, src: str) -> List[byte] {
    let bytes = text_bytes(src)
    let file_id = diag_reset(mut f, bytes)
    let p = fl.fl_parse(bytes, file_id, mut f.vm.dc, mut f.vm.strings)
    if p.had_error { diag_take(mut f); return text_bytes("!parse") }
    let entry = fl.fl_compile(mut f.vm, p, file_id, f.origin) else {
        diag_take(mut f)
        return text_bytes("!compile")
    }
    diag_take(mut f)
    let res = fl.fl_vm_run(mut f.vm, entry)
    if f.vm.raised {
        var out = text_bytes("!")
        for b in err_field(mut f.vm, res, "kind", 64) { (mut out).push(b) }
        (mut out).push(58 as byte)
        (mut out).push(32 as byte)
        for b in err_field(mut f.vm, res, "msg", 2048) { (mut out).push(b) }
        f.vm.raised = false
        return upto_nul(out, FLFIX_CAP)
    }
    if res.t == fl.FL_NIL { return text_bytes("nil") }
    if res.t == fl.FL_BOOL { return text_bytes(if res.i != 0 then "true" else "false") }
    if res.t == fl.FL_INT { return text_bytes("{res.i}") }
    if res.t == fl.FL_STR {
        let at = fl.fl_obj_index(f.vm, res)
        var out = List[byte]()
        for b in f.vm.gc.slots[at].bytes {
            if out.len >= FLFIX_CAP { break }
            (mut out).push(b)
        }
        return out
    }
    text_bytes("<{fl.fl_type_name(res.t)}>")
}

/// run_bytes as text; a result that is not UTF-8 traps (use run_bytes).
pub fn run(mut f: FlFix, src: str) -> str {
    let out = run_bytes(mut f, src)
    str_from_utf8(out) else {
        assert(false, "flfix.run: the outcome is not UTF-8; use run_bytes")
        ""
    }
}

fn show(b: List[byte]) -> str {
    let hex = "0123456789abcdef".bytes()
    var out = List[byte]()
    for x in b {
        let c = x as int
        if c >= 32 && c < 127 && c != 92 {
            (mut out).push(x)
        } else {
            (mut out).push(92 as byte)
            (mut out).push(120 as byte)
            (mut out).push(hex[c / 16])
            (mut out).push(hex[c % 16])
        }
    }
    str_from_utf8(out) else "?"
}

/// FL_EQ with the program's bytes compared as C's YEW_ASSERT_EQ_STR does
/// (up to the first NUL); a mismatch prints the program, got and want.
pub fn eq_bytes(mut f: FlFix, src: str, want: List[byte]) {
    let got = upto_nul(run_bytes(mut f, src), FLFIX_CAP)
    let w = upto_nul(want, FLFIX_CAP)
    var same = got.len == w.len
    var i = 0
    while same && i < got.len {
        same = got[i] == w[i]
        i += 1
    }
    if !same {
        eprint(
            "flfix: FL_EQ failed\n  program: {show(text_bytes(src))}\n  got:  {show(got)}\n  want: {show(w)}",
        )
        if f.ndiag != 0 { eprint("  first diagnostic: {f.first}") }
    }
    assert(same, "flfix: FL_EQ")
}

/// FL_EQ over text.
pub fn eq(mut f: FlFix, src: str, want: str) { eq_bytes(mut f, src, text_bytes(want)) }

/// flfix.c:202-229's flfix_run_trace: run `src` with its entry chunk's
/// fnkind set to `kind` and render the §6 error block; empty when the
/// program completed, did not parse or did not compile.
pub fn run_trace(mut f: FlFix, src: str, kind: int) -> str {
    let bytes = text_bytes(src)
    let file_id = diag_reset(mut f, bytes)
    let p = fl.fl_parse(bytes, file_id, mut f.vm.dc, mut f.vm.strings)
    if p.had_error { diag_take(mut f); return "" }
    let entry = fl.fl_compile(mut f.vm, p, file_id, f.origin) else {
        diag_take(mut f)
        return ""
    }
    diag_take(mut f)
    f.vm.gc.slots[fl.fl_obj_index(f.vm, entry)].fnkind = kind
    let res = fl.fl_vm_run(mut f.vm, entry)
    if !f.vm.raised { return "" }
    f.vm.raised = false
    var out = List[byte]()
    fl.fl_trace_render(mut f.vm, res, mut out)
    str_from_utf8(upto_nul(out, 8191)) else ""
}
