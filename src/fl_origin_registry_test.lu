//! member: false
//! sagitta 9ace98c2 tests/unit/test_fl_origin.c, all six registry cases.
//! The sole native injection is a kind-id probe through the normal VM host.

use fl
use flfix

fn label(r: fl.FlOriginReg, id: int) -> str { str_from_utf8(fl.fl_origin_label(r, id)) else "" }

fn reg(mut r: fl.FlOriginReg, kind: int, name: str, caps: int) -> int {
    fl.fl_origin_register(mut r, kind, name.bytes(), caps)
}

fn fl_origin_registry_reserves_config_zero() {
    var r = fl.fl_origin_reg_new()
    assert(r.v.len == 1 && fl.FL_ORIGIN_ID_CONFIG == 0)
    assert(label(r, 0) == "the user config" && fl.fl_origin_caps(r, 0) == fl.FL_CAP_ALL)
    let kinds = [
        fl.FL_ORIGIN_BUILTIN,
        fl.FL_ORIGIN_WORKSPACE,
        fl.FL_ORIGIN_PLUGIN,
        fl.FL_ORIGIN_CLI,
        fl.FL_ORIGIN_REPL,
    ]
    let labels = ["a builtin", "workspace.fl", "plugin.fl", "the command line", "the REPL"]
    var ids = List[int]()
    for i in 0..kinds.len {
        let id = reg(mut r, kinds[i], labels[i], 1 << i)
        assert(id != 0 && id != fl.FL_ORIGIN_ID_NONE && id == i + 1)
        assert(label(r, id) == labels[i] && fl.fl_origin_caps(r, id) == 1 << i)
        for other in ids { assert(id != other) }
        (mut ids).push(id)
    }
    assert(r.v.len == 6)
    assert(label(r, fl.FL_ORIGIN_ID_NONE) == "an unknown origin")
    assert(fl.fl_origin_caps(r, fl.FL_ORIGIN_ID_NONE) == 0)
    var absent = fl.fl_origin_reg_none()
    assert(label(absent, 0) == "an unknown origin" && fl.fl_origin_caps(absent, 0) == 0)
    assert(reg(mut absent, fl.FL_ORIGIN_PLUGIN, "x", 0) == fl.FL_ORIGIN_ID_NONE)
}

fn fl_origin_registry_is_idempotent_and_updates_caps() {
    var r = fl.fl_origin_reg_new()
    let config = reg(mut r, fl.FL_ORIGIN_CONFIG, "the user config", fl.FL_CAP_FS_READ)
    assert(config == 0 && r.v.len == 1 && fl.fl_origin_caps(r, config) == fl.FL_CAP_FS_READ)
    let first = reg(mut r, fl.FL_ORIGIN_PLUGIN, "same.fl", fl.FL_CAP_FS_READ)
    let again = reg(mut r, fl.FL_ORIGIN_PLUGIN, "same.fl", fl.FL_CAP_NET)
    assert(again == first && r.v.len == 2 && label(r, first) == "same.fl")
    assert(fl.fl_origin_caps(r, first) == fl.FL_CAP_NET)
    let other = reg(mut r, fl.FL_ORIGIN_WORKSPACE, "same.fl", fl.FL_CAP_FS_WRITE)
    assert(other != first && r.v.len == 3 && label(r, other) == "same.fl")
    assert(fl.fl_origin_caps(r, other) == fl.FL_CAP_FS_WRITE)
    let unnamed = reg(mut r, fl.FL_ORIGIN_PLUGIN, "an unnamed origin", 0)
    assert(
        unnamed != 0 &&
            label(r, unnamed) == "an unnamed origin" &&
            fl.fl_origin_caps(r, unnamed) == 0,
    )
}

fn fl_origin_masking_is_idempotent() {
    var r = fl.fl_origin_reg_new()
    let a = reg(mut r, fl.FL_ORIGIN_PLUGIN, "a.fl", 0)
    let b = reg(mut r, fl.FL_ORIGIN_PLUGIN, "b.fl", 0)
    assert(!fl.fl_origin_masked(r, a) && !fl.fl_origin_masked(r, b))
    var absent = fl.fl_origin_reg_none()
    assert(!fl.fl_origin_masked(absent, a))
    fl.fl_origin_mask(mut r, a)
    assert(fl.fl_origin_masked(r, a) && !fl.fl_origin_masked(r, b))
    assert(r.masked.len == 1)
    fl.fl_origin_mask(mut r, a)
    assert(r.masked.len == 1)
    fl.fl_origin_mask(mut r, b)
    assert(fl.fl_origin_masked(r, a) && fl.fl_origin_masked(r, b) && r.masked.len == 2)
    fl.fl_origin_unmask(mut r, a)
    assert(!fl.fl_origin_masked(r, a) && fl.fl_origin_masked(r, b) && r.masked.len == 1)
    fl.fl_origin_unmask(mut r, a)
    assert(r.masked.len == 1)
    fl.fl_origin_unmask(mut r, b)
    assert(!fl.fl_origin_masked(r, b) && r.masked.len == 0)
    fl.fl_origin_mask(mut absent, a)
    fl.fl_origin_unmask(mut absent, a)
    assert(absent.masked.len == 0)
}

fn fl_origin_of_frame_uses_attached_root_origin() {
    var f = flfix.open()
    var r = fl.fl_origin_reg_none()
    assert(fl.fl_origin_of_frame(mut r, f.vm) == fl.FL_ORIGIN_ID_NONE)
    r = fl.fl_origin_reg_new()
    let path = "/tmp/root-plugin.fl"
    f.vm.root_origin.kind = fl.FL_ORIGIN_PLUGIN
    f.vm.root_origin.path_id = fl.fl_intern(mut f.vm.strings, path.bytes(), 0, path.len)
    f.vm.root_origin.caps = fl.FL_CAP_FS_READ
    let id = fl.fl_origin_of_frame(mut r, f.vm)
    assert(id != 0 && id != fl.FL_ORIGIN_ID_NONE)
    assert(label(r, id) == path && fl.fl_origin_caps(r, id) == fl.FL_CAP_FS_READ)
    assert(fl.fl_origin_of_frame(mut r, f.vm) == id && r.v.len == 2)
    let helper = "/tmp/helper.fl"
    f.vm.root_origin.path_id = fl.fl_intern(mut f.vm.strings, helper.bytes(), 0, helper.len)
    f.vm.root_origin.principal_id = id
    assert(fl.fl_origin_of_frame(mut r, f.vm) == id && r.v.len == 2)
    flfix.close(mut f)
}

struct OriginHost { origins: fl.FlOriginReg }

impl fl.FlHost for OriginHost {
    fn api(mut self, mut vm: fl.FlVm, kind: int, base: int, argc: int) -> fl.FlValue {
        if kind == 13008 { return fl.fl_int(fl.fl_origin_of_frame(mut self.origins, vm)) }
        fl.fl_native_dispatch(mut vm, kind, base, argc)
    }
    #[allow(w1002)] // Null transaction/motion methods preserve the host trait's modes.
    fn motion(mut self, mut vm: fl.FlVm, program: fl.FlValue) -> bool {
        let _ = self.origins.present
        let _ = program
        let _ = fl.fl_raise(mut vm, "motion", "no editor host")
        false
    }
    #[allow(w1002)]
    fn edit_begin(mut self, mut vm: fl.FlVm) -> bool {
        let _ = self.origins.present
        let _ = vm.sp
        true
    }
    #[allow(w1002)]
    fn edit_end(mut self, mut vm: fl.FlVm, commit: bool) -> bool {
        let _ = self.origins.present
        let _ = vm.sp
        let _ = commit
        true
    }
    #[allow(w1002)]
    fn run_begin(mut self, mut vm: fl.FlVm) -> bool {
        let _ = self.origins.present
        let _ = vm.sp
        true
    }
    #[allow(w1002)]
    fn run_end(mut self, mut vm: fl.FlVm, commit: bool) -> bool {
        let _ = self.origins.present
        let _ = vm.sp
        let _ = commit
        true
    }
    fn run_active(self) -> bool { let _ = self.origins.present; false }
    // C's NULL hook ops (flhook.h:84): fl_call, nothing masked, no notice.
    fn hook_call(mut self, mut vm: fl.FlVm, f: fl.FlValue, args: List[fl.FlValue]) -> (
        bool,
        fl.FlValue,
    ) {
        fl.fl_hook_default_call(mut vm, mut self, f, args)
    }
    fn hook_masked(self, origin: int) -> bool {
        let _ = origin
        let _ = self.origins.present
        false
    }
    #[allow(w1002)]
    fn hook_notice(
        mut self,
        mut vm: fl.FlVm,
        what: int,
        event: int,
        ledger_id: int,
        errs: int,
        err: fl.FlValue,
    ) {
        let _ = self.origins.present
        let _ = vm.sp
        let _ = what
        let _ = event
        let _ = ledger_id
        let _ = errs
        let _ = err
    }
}

fn run(mut f: flfix.FlFix, mut h: OriginHost, src: str) -> str {
    let file = fl.fl_diag_add_file(mut f.vm.dc, "origin-test.fl", src.bytes())
    let parsed = fl.fl_parse(src.bytes(), file, mut f.vm.dc, mut f.vm.strings)
    assert(!parsed.had_error)
    let entry = fl.fl_compile(mut f.vm, parsed, file, f.origin) else { assert(false); return "" }
    let result = fl.fl_vm_run_host(mut f.vm, mut h, entry)
    assert(!f.vm.raised)
    if result.t == fl.FL_INT { return "{result.i}" }
    assert(result.t == fl.FL_STR)
    str_from_utf8(f.vm.gc.slots[fl.fl_obj_index(f.vm, result)].bytes) else ""
}

fn fl_origin_plugin_helper_chain_denial_is_catchable() {
    var f = flfix.open()
    var h = OriginHost { origins: fl.fl_origin_reg_new() }
    let owner = reg(mut h.origins, fl.FL_ORIGIN_PLUGIN, "entry-plugin.fl", 0)
    let name = "principal_probe"
    let id = fl.fl_intern(mut f.vm.strings, name.bytes(), 0, name.len)
    let native = fl.fl_native_new(mut f.vm, id, 13008, 0, 0, 0)
    let prelude = copy f.vm.prelude
    assert(fl.fl_map_set(mut f.vm, prelude, fl.fl_int(id), native))
    let dir = flfix.tmpdir(mut f)
    flfix.write(mut f, "payload.txt", "secret\n")
    flfix.write(
        mut f,
        "helper.fl",
        "import io\nfn peek(p) {{ return io.read(p) }}\nfn owner() {{ return principal_probe() }}\n",
    )
    flfix.set_origin(mut f, fl.FL_ORIGIN_CONFIG, fl.FL_CAP_FS_READ)
    assert(
        run(mut f, mut h, "import \"helper.fl\" as h\nreturn h.peek(\"{dir}/payload.txt\")\n") ==
            "secret\n",
    )
    flfix.set_origin(mut f, fl.FL_ORIGIN_PLUGIN, 0)
    f.origin.principal_id = owner
    assert(run(mut f, mut h, "import \"helper.fl\" as h\nreturn h.owner()\n") == "{owner}")
    assert(h.origins.v.len == 2)
    let denied = run(
        mut f,
        mut h,
        "import \"helper.fl\" as h\ntry {{ h.peek(\"{dir}/payload.txt\") }} catch e {{ return e.kind + \":\" + e.msg }}\nreturn \"authority leaked\"\n",
    )
    assert(denied == "capability:fs.read denied to {dir}/helper.fl")
    assert(f.vm.mods.len == 2)
    let a = fl.fl_module_exports(f.vm, 0) else fl.fl_nil()
    let b = fl.fl_module_exports(f.vm, 1) else fl.fl_nil()
    assert(a.i != b.i)
    flfix.close(mut f)
}

fn fl_origin_cap_check_requires_every_requested_bit() {
    var f = flfix.open()
    f.vm.root_origin.kind = fl.FL_ORIGIN_PLUGIN
    f.vm.root_origin.caps = fl.FL_CAP_FS_READ | fl.FL_CAP_SHELL
    assert(fl.fl_cap_check(mut f.vm, fl.FL_CAP_FS_READ))
    assert(fl.fl_cap_check(mut f.vm, fl.FL_CAP_SHELL))
    assert(fl.fl_cap_check(mut f.vm, fl.FL_CAP_FS_READ | fl.FL_CAP_SHELL))
    assert(!fl.fl_cap_check(mut f.vm, fl.FL_CAP_FS_READ | fl.FL_CAP_NET))
    let key = fl.fl_str_text(mut f.vm, "kind")
    let kind = fl.fl_map_get(f.vm, f.vm.err, key) else fl.fl_nil()
    assert(kind.t == fl.FL_STR)
    assert(
        (str_from_utf8(f.vm.gc.slots[fl.fl_obj_index(f.vm, kind)].bytes) else "") == "capability",
    )
    flfix.close(mut f)
}

fn main() {
    fl_origin_registry_reserves_config_zero()
    fl_origin_registry_is_idempotent_and_updates_caps()
    fl_origin_masking_is_idempotent()
    fl_origin_of_frame_uses_attached_root_origin()
    fl_origin_plugin_helper_chain_denial_is_catchable()
    fl_origin_cap_check_requires_every_requested_bit()
    print("fl_origin: 6 pinned cases PASS")
}
