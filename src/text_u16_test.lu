//! member: false
//!
//! The port of sagitta `tests/unit/test_u16.c` (130 lines), one test per
//! C test in registry order (`tests/unit/registry.c:576-580`).
//! `test_u16_diff.c`'s one test (`u16_differential_200_lines`,
//! `registry.c:581`) is a differential of `mod/lsp/sync.c`'s position
//! conversion against this unit, and lands with that module (yw11).

use text
use unicode

fn list_of(xs: List[int]) -> List[byte] {
    var v = List[byte]()
    for x in xs {
        (mut v).push(x as byte)
    }
    v
}

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn assert_boundary_roundtrips(bytes: List[byte]) {
    var tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    let line = text.textbuf_line_span(tb, text.lineno(0))
    var off = 0
    loop {
        let col = text.off_to_u16col(tb, line, text.byteoff(off))
        assert(text.u16col_to_off(tb, line, col) as int == off, "round trip at {off}")
        if off == bytes.len {
            break
        }
        off = unicode.gb_next_bytes(bytes, bytes.len, off)
    }
    text.textbuf_free(mut tb)
}

fn t_u16_code_unit_table() {
    let bytes = list_of([0, 194, 162, 226, 130, 172, 240, 159, 152, 128, 255, 9])
    let offsets = [0, 1, 3, 6, 10, 11, 12]
    let cols = [0, 1, 2, 3, 5, 6, 7]
    var tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    let line = text.textbuf_line_span(tb, text.lineno(0))
    var i = 0
    while i < offsets.len {
        assert(text.off_to_u16col(tb, line, text.byteoff(offsets[i])) as int == cols[i], "col {i}")
        assert(text.u16col_to_off(tb, line, cols[i] as text.U16Col) as int == offsets[i], "off {i}")
        i += 1
    }
    text.textbuf_free(mut tb)
}

fn t_u16_grapheme_corpus_roundtrips() {
    assert_boundary_roundtrips(bytes_of("plain ASCII"))
    assert_boundary_roundtrips(list_of([230, 151, 165, 230, 156, 172]))
    assert_boundary_roundtrips(list_of([240, 159, 152, 128]))
    assert_boundary_roundtrips(
        list_of(
            [
                240,
                159,
                145,
                168,
                226,
                128,
                141,
                240,
                159,
                145,
                169,
                226,
                128,
                141,
                240,
                159,
                145,
                167,
            ],
        ),
    )
    assert_boundary_roundtrips(list_of([240, 159, 135, 186, 240, 159, 135, 184]))
    assert_boundary_roundtrips(list_of([49, 239, 184, 143, 226, 131, 163]))
    assert_boundary_roundtrips(list_of([101, 204, 129, 204, 167]))
    assert_boundary_roundtrips(list_of([255, 120]))
}

fn t_u16_clamps_surrogate_and_line_end() {
    let bytes = list_of([97, 240, 159, 152, 128, 98, 13, 10, 122])
    var tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    let first = text.textbuf_line_span(tb, text.lineno(0))
    assert(text.u16col_to_off(tb, first, 2 as text.U16Col) as int == 1, "inside the astral")
    assert(text.u16col_to_off(tb, first, 99 as text.U16Col) as int == 6, "past the content")
    assert(text.off_to_u16col(tb, first, text.byteoff(7)) as int == 4, "inside the CRLF")
    assert(text.off_to_u16col(tb, first, text.byteoff(99)) as int == 4, "past the line")
    assert(text.off_to_u16col(tb, first, text.byteoff(3)) as int == 1, "inside the scalar")
    text.textbuf_free(mut tb)
}

fn t_u16_decodes_across_piece_seams() {
    let lead = list_of([97, 240, 159])
    let tail = list_of([152, 128, 98])
    var tb = text.textbuf_from_bytes(lead, 0, lead.len)
    text.textbuf_insert(mut tb, text.byteoff(lead.len), tail)
    let line = text.textbuf_line_span(tb, text.lineno(0))
    assert(text.off_to_u16col(tb, line, text.byteoff(5)) as int == 3, "col across the seam")
    assert(text.u16col_to_off(tb, line, 3 as text.U16Col) as int == 5, "off across the seam")
    text.textbuf_free(mut tb)
}

fn t_u16_large_astral_line_uses_u64() {
    let count = 100000
    var bytes = List[byte]()
    var i = 0
    while i < count {
        (mut bytes).push(240 as byte)
        (mut bytes).push(159 as byte)
        (mut bytes).push(152 as byte)
        (mut bytes).push(128 as byte)
        i += 1
    }
    let len = bytes.len
    var tb = text.textbuf_from_bytes(bytes, 0, len)
    let line = text.textbuf_line_span(tb, text.lineno(0))
    assert(text.off_to_u16col(tb, line, text.byteoff(len)) as int == count * 2, "units")
    assert(text.u16col_to_off(tb, line, (count * 2) as text.U16Col) as int == len, "offset")
    text.textbuf_free(mut tb)
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_u16_code_unit_table()
    t_u16_grapheme_corpus_roundtrips()
    t_u16_clamps_surrogate_and_line_end()
    t_u16_decodes_across_piece_seams()
    t_u16_large_astral_line_uses_u64()
    print("u16_test: 5 cases pass")
}
