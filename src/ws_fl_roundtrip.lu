//! member: false
//! Pure byte differential companion to sagitta 9ace98c2
//! tests/unit/test_state_corpus.c:75-101; no editor or schema application.

use ws

fn main() -> int {
    let args = env_args()
    let bench = args.len == 3 && args[0] == "--bench"
    if args.len != 2 && !bench {
        eprint("usage: codec-roundtrip INPUT OUTPUT | --bench INPUT REPEATS")
        return 2
    }
    let path = if bench then args[1] else args[0]
    let count = if bench then (args[2].to_int() else 0) else 1
    if count <= 0 { return 2 }
    let raw = fs_read_bytes(path) else { eprint("cannot read {path}"); return 2 }
    var sum: int = 0
    for _ in 0..count {
        region iteration {
            let r = ws.fl_parse(raw, 0, raw.len)
            if !r.ok { eprint("{r.err.line}:{r.err.col}: {r.err.msg}"); return 1 }
            let out = ws.fl_reemit(r.doc)
            sum += out.len
            if !bench {
                let fd = fs_open_mode(args[1], 1) else { return 2 }
                fs_write_chunk(fd, out) else { fs_close(fd) else |_| {}; return 2 }
                fs_close(fd) else { return 2 }
            }
        }
    }
    if bench { print("{sum}") }
    0
}
