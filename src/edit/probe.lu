//! edit.probe — what a unit test's probe command does when it runs.
//!
//! sagitta's tests register C functions as commands (`test_cmdreg.c`'s
//! counting probe, `test_multicursor.c:144-207`'s inserting and failing
//! ones); the port's registry holds no function values (the shape ruled
//! at launch, G19/G20), so a test registers `HANDLER_PROBE` and the probe
//! is chosen here by the name it was registered under. `ed_cmd_invoke`
//! counts every probe call in `CmdReg.probe_*` first (`invoke.lu`); a name
//! with no behaviour here answers `CMD_OK`, which is the counting probe.
//! Only a test registers these names.

/// The probe registered as `id`, run.
pub fn probe_run(mut ed: Ed, id: int, cx: CmdCtx) -> int {
    let name = ed.reg.entries[id - 1].name
    if name == "ed.ai.rename" {
        // `cmdline_open_successor` (`test_cmdline.c:174-178`): a command
        // that replaces its own prompt with an input one.
        cmdline_open_input(mut ed, "successor", INPUT_DONE_NONE, 0)
        return CMD_OK
    }
    if name == "ed.edit.mc.insert" {
        return probe_mc_insert(mut ed, cx)
    }
    if name == "ed.edit.mc.cancel" {
        // `mc_probe_fail_second` (`test_multicursor.c:159-164`).
        if cx.cursor_index == 1 {
            return CMD_ERR_STATE
        }
        return probe_mc_insert(mut ed, cx)
    }
    if name == "ed.edit.mc.toggle" {
        // `mc_probe_fail_700` (`test_multicursor.c:170-181`): the calls
        // must visit the cursors in ascending order — a call out of order
        // answers `CMD_ERR_IO`, which the test reads as C's
        // `mc_audit_ascending == false`.
        if cx.cursor_index != ed.reg.probe_calls - 1 {
            return CMD_ERR_IO
        }
        if cx.cursor_index == 700 {
            return CMD_ERR_STATE
        }
        return probe_mc_insert(mut ed, cx)
    }
    CMD_OK
}

// `mc_probe_insert` (`test_multicursor.c:144-157`): one `X` at the acting
// cursor, through the focused window.
fn probe_mc_insert(mut ed: Ed, cx: CmdCtx) -> int {
    let w = cx.win
    if w < 0 || w >= ed.wins.len || cx.cursor_index >= ed.wins[w].cs.curs.len {
        return CMD_ERR_STATE
    }
    let at = ed.wins[w].cs.curs[cx.cursor_index].pos
    var x = List[byte]()
    (mut x).push(88 as byte)
    if ed_edit_insert(mut ed, ed.win, at, x, 0, 1) then CMD_OK else CMD_ERR_IO
}
