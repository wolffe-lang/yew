pub fn comp_shell_cache_free(ed: Ed) {}

/// `exec_keep` (`cmdcomp.c:1241-1272`).
pub fn comp_exec_keep(scan_dir: str, row: List[byte], force_unknown: bool) -> bool {
    false
}

/// `enumerate_exec` (`cmdcomp.c:1605-1646`).
pub fn comp_enumerate_exec(mut ed: Ed, req: CompReq, mut out: List[CompItem]) -> int {
    shell_refuse(mut ed, "the $PATH executable source", "57.18")
    out = List[CompItem]()
    0
}

