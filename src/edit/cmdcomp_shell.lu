//! edit.cmdcomp_shell — the `:!` half of the completion engine.
//!
//! PLACEHOLDER on the fork branches only (yw04-comp): the shell work
//! owns this file and replaces it whole — sagitta `src/ui/cmdcomp.c`'s
//! $PATH executable source (`:1113-1647`, Sprint 57.18 §2), the generic
//! shell sources (`:1686-1912`, 57.23 §4), the router and the dispatcher
//! (`:1913-3228`, 57.23 §3/§5, 57.24, 57.25, 57.26, 57.32). `edit.cmdcomp`
//! calls exactly the functions below; each body here refuses LOUDLY by
//! name (on the log and as an empty answer), never silently, and the
//! lane's integration removes the placeholder.

use util

/// The shell half's own state (C's `exec_cache` and friends).
pub struct CompShellState {
    refused: int,
}

/// The shell half before its first use.
pub fn compshell_new() -> CompShellState {
    CompShellState { refused: 0 }
}

/// A SHELL answer's identity beyond head and pattern (`shell_ctx_key`,
/// `cmdcomp.c:3542-3590`): the key, the pending generator key and the
/// pager's `where` note.
pub struct CompShellKey {
    key: str,
    has_key: bool,
    gen_key: str,
    has_gen: bool,
    where: str,
}

/// No shell key (every non-SHELL kind).
pub fn compshellkey_none() -> CompShellKey {
    CompShellKey { key: "", has_key: false, gen_key: "", has_gen: false, where: "" }
}

fn shell_refuse(mut ed: Ed, what: str, sprint: str) {
    ed.comp.shell.refused += 1
    util.log_error("yew: error: not yet ported: {what}: sagitta Sprint {sprint} (yw04)")
}

/// `shell_ctx_key` (`cmdcomp.c:3542-3590`).
pub fn comp_shell_ctx_key(mut ed: Ed, q: CompQuery) -> CompShellKey {
    shell_refuse(mut ed, "the :! completion context", "57.23")
    var k = compshellkey_none()
    k.key = "refused|{q.shell_cursor}"
    k.has_key = true
    k
}

/// `yew_compgen_awaiting || yew_comphelp_awaiting || yew_compfish_awaiting`.
pub fn comp_shell_awaiting(ed: Ed, gen_key: str) -> bool {
    false
}

/// `users_underscore_last` (`cmdcomp.c:1801-1820`): `~_name` accounts
/// after the people, each group in its order.
pub fn comp_users_underscore_last(mut items: List[CompItem]) {
    var head = List[CompItem]()
    var tail = List[CompItem]()
    for it in items {
        if it.kind == COMP_USER &&
            it.ranked.len >= 2 &&
            it.ranked[0] as int == 126 &&
            it.ranked[1] as int == 95 {
            (mut tail).push(copy it)
        } else {
            (mut head).push(copy it)
        }
    }
    if tail.len == 0 {
        return
    }
    for it in tail {
        (mut head).push(copy it)
    }
    items = head
}

/// `exec_scan_pending` (`cmdcomp.c:1220-1229`).
pub fn comp_shell_scan_pending(ed: Ed) -> bool {
    false
}

/// `exec_scan_advance` (`cmdcomp.c:1308-1313`).
pub fn comp_shell_scan_advance(ed: Ed, slice_us: int) -> bool {
