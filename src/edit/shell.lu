//! edit.shell — E mode's shell surface (Sprint 19, 57.18 §4, 57.31 §3).
//!
//! Ports sagitta `src/edit/shell.c` (1,200 lines) and `shell.h` (78) at
//! 9ace98c2 as far as wolf 0.2.33 lets it run. What runs: mode (d), the
//! terminal handover — `:!!cmd` and the argv route (`yew_shell_term_run`,
//! `yew_shell_term_argv`, `shell.c:650-747`) — a synchronous child the
//! editor waits for while it paints nothing, so it needs no wait over N
//! descriptors (`edit.job_run_sync`). What STOPs by name (ruling
//! R-yw04-1): mode (a), the stream into a job buffer (`yew_shell_run`),
//! mode (c), read at the cursor (`yew_shell_read`), and mode (b), the
//! region filter (`yew_shell_filter`) — each reads a child's pipe while
//! the loop runs (G2, wolf-lang#795); the filter's interleaved write is
//! ALSO wolf-lang#818's (G30, ruling R-yw04-3: a 1 MiB output before the
//! child reads its stdin deadlocks a blocking write). `:!yew FILE`
//! (`yew_shell_try_self_open`, `shell.c:531-647`) opens the file as a
//! tab of its own — several tabs are yw05's — and is not recognised: the
//! line reaches the stream's refusal like any other `:!`.

/// `yew_shell_term_run` (`shell.c:687-725`): `:!!cmd` — the child is
/// handed the real terminal and waited for. `(ok, wait, error)`.
pub fn shell_term_run(mut ed: Ed, cmdline0: str) -> (bool, JobWait, str) {
    let cmdline = cmdline0.trim_start()
    let none = JobWait { state: JOB_RUNNING, exit_code: 0, termsig: 0, exec_errno: 0 }
    if cmdline.len == 0 {
        return (false, none, ":!! needs a command")
    }
    if ed.headless {
        return (
            false,
            none,
            ":!! requires a terminal and is not available under --batch; use ed.shell.run",
        )
    }
    job_run_sync(mut ed, List[str](), cmdline)
}

/// `yew_shell_term_argv` (`shell.c:727-747`): the same handover for an
/// argv yew built — no shell parses the words.
pub fn shell_term_argv(mut ed: Ed, argv: List[str]) -> (bool, JobWait, str) {
    let none = JobWait { state: JOB_RUNNING, exit_code: 0, termsig: 0, exec_errno: 0 }
    if argv.len == 0 || argv[0].len == 0 {
        return (false, none, "invalid interactive command")
    }
    if ed.headless {
        return (false, none, "a terminal handover is not available under --batch")
    }
    job_run_sync(mut ed, argv, "")
}

/// Mode (a), the stream into a job buffer (`yew_shell_run`,
/// `shell.c:749-797`): the refusal (R-yw04-1).
pub fn shell_run_refusal() -> str {
    job_stop_g2("streaming a command's output into a job buffer")
}

/// Mode (c), read at the cursor (`yew_shell_read`, `shell.c:834-866`).
pub fn shell_read_refusal() -> str {
    job_stop_g2("reading a command's output at the cursor")
}

/// Mode (b), the region filter (`yew_shell_filter`, `shell.c:993-1080`):
/// R-yw04-1, and its write side R-yw04-3.
pub fn shell_filter_refusal() -> str {
    "not yet ported: the region filter: needs os_signal_wait_fds (G2, wolf-lang#795) and a non-blocking pipe write (G30, wolf-lang#818), sagitta Sprint 19 (yw04, R-yw04-1, R-yw04-3)"
}
