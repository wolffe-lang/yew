    next_win_id: int,
    tabs: List[Tab],
    tab_active: int,
    next_tab_id: int,
    tab_scroll: int,
    journals: text.JournalSet,
    // yw04-shell: the completion-spec registry (C's compspec.c statics).
    specs: CompSpecs,
    gen: CompGen,
    help: CompHelp,
    fish: CompFish,
    regs: text.Registers,
    yank: text.YankStack,
