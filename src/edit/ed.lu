//! edit.ed — the editor: buffers, windows, tabs, the edit seam, damage,
//! prompts, save and quit.
//!
//! Ports sagitta `src/edit/ed.c` (3,142 lines) and `ed.h` (513) at
//! 9ace98c2, under `s14-modes-L-I.md` — the parts campaign 03 reaches. C's
//! `Ed` holds a pane tree of `Win *`, a workspace of `Buffer *` and a tab
//! array, each by pointer; the port's `Ed` holds them as lists and refers
//! by index (`Win.buf`, `Ed.win`), one tab per open file, one window
//! (panes, splits and tab switching are campaign 05's, yw05).
//!
//! **The ownership seam** (contract deliverable 2). yw02's `text.EditCtx`
//! OWNS the text, marks, journal, undo tree and file metadata, so each
//! `Buffer` owns one `EditCtx` for its life, with a SPARE cursor set in
//! its `cset` slot; the window owns the real `CursorSet`, and the editor
//! owns the one `JournalSet` (C's process-wide journal owner list). An
//! edit swaps the window's set and the editor's journal list into the
//! buffer's context through a local and swaps them back
//! (`edit_take`/`edit_give`): no allocation, measured (`notes/yw03`; a
//! fresh empty set per edit would hold 48 bytes for the session, G33).
//!
//! What C's `Ed` carries for later campaigns — the workspace state and
//! symbol index (yw06/yw11), jobs and the shell session (yw04), LSP, AI,
//! git, plugins, Fletch (yw07+), search (yw04), the mouse (yw06) — lands
//! with them; a command that reaches one refuses by name (`edit.cmd`).

use term
use text
use util

/// A scratch buffer (`YEW_BUF_SCRATCH`, `buf.h:6-10`).
pub const BUF_SCRATCH: int = 1

/// Edits are not recorded for undo (`YEW_BUF_NOUNDO`).
pub const BUF_NOUNDO: int = 2

/// Read-only (`YEW_BUF_READONLY`).
pub const BUF_READONLY: int = 4

/// No prompt (`PromptKind`, `ed.h:47-56`).
pub const PROMPT_NONE: int = 0

/// The crash-journal recovery prompt.
pub const PROMPT_RECOVER: int = 1

/// The dirty-quit prompt.
pub const PROMPT_QUIT_DIRTY: int = 2

/// The changed-on-disk overwrite prompt.
pub const PROMPT_OVERWRITE: int = 3

/// An information message (`MsgSev`, `message.h:9-13`).
pub const MSG_INFO: int = 0

/// A warning.
pub const MSG_WARN: int = 1

/// An error.
pub const MSG_ERROR: int = 2

/// The editor's buffer (`Buffer`, `edit/buf.h:12-52`): its edit context
/// (the text and everything that rides it) and C's scalars.
pub struct Buffer {
    id: int,
    ec: text.EditCtx,
    resident: bool,
    path: str,
    has_path: bool,
    name: str,
    has_name: bool,
    flags: int,
    tabwidth: int,
    recovery_pending: bool,
    pairs: PairState,
    named: NamedMarks,
}

/// A tab (`Tab`, `ui/tabs.h:36-62`): the buffer it was opened on, its own
/// pane tree (`root`) and the focused leaf within it (`focus`), both
/// indices into `Ed.panes` (`edit.layout`), its canonical path and the
/// path it displays.
pub struct Tab {
    tab_id: int,
    buffer_id: int,
    root: int,
    focus: int,
    path: str,
    display_path: str,
    has_path: bool,
}

/// A message (`Msg`, `message.h:15-25`).
pub struct Msg {
    text: str,
    sev: int,
    expiry: int,
    active: bool,
    prompt: bool,
    truncated: bool,
    expanded: bool,
}

/// No message.
pub fn msg_none() -> Msg {
    Msg {
        text: "",
        sev: MSG_INFO,
        expiry: 0,
        active: false,
        prompt: false,
        truncated: false,
        expanded: false,
    }
}

/// The key chord in flight (`Chord`, `dispatch.h:13-21`).
pub struct Chord {
    seq: List[int],
    n: int,
    layer: int,
    count: int,
    count_given: bool,
    deadline: int,
}

