    footer_dirty: bool,
    cursor_follow_pending: bool,
    doc_damage_lo: int,
    doc_damage_hi: int,
    damage_batching: bool,
    damage_batch_pending: bool,
    damage_batch_full: bool,
    damage_batch_line_pending: bool,
    damage_batch_row_pending: bool,
    damage_batch_win: int,
    damage_batch_lines: int,
    damage_batch_gen: int,
    damage_batch_line_lo: int,
