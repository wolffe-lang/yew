pub struct FussTarget {
    known: bool,
    status_known: bool,
    is_file: bool,
    staged: bool,
    unstaged: bool,
    untracked: bool,
    incoming: bool,
    conflicted: bool,
    expanded: bool,
}

/// No target (`memset(out, 0, …)`).
pub fn fuss_target_none() -> FussTarget {
    FussTarget {
        known: false,
        status_known: false,
        is_file: false,
        staged: false,
        unstaged: false,
        untracked: false,
        incoming: false,
        conflicted: false,
        expanded: false,
    }
}

