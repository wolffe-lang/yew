// `fuss_damage` (`fussmode.c:420-426`).
fn fuss_damage(mut ed: Ed) {
    ed.fuss.draw_dirty = true
    ed.footer_dirty = true
}

/// `yew_fuss_active` (`fussmode.c:1046-1049`).
pub fn fuss_active(ed: Ed) -> bool {
    ed.fuss.active
}

// `fuss_row` (`fussmode.c:721-724`).
fn fuss_row(ed: Ed) -> int {
    git.fuss_row_of(ed.fuss.tree, ed.fuss.sel)
}

fn fuss_item_ok(ed: Ed, row: int) -> bool {
    row >= 0 &&
        row < ed.fuss.tree.items.len &&
        ed.fuss.tree.items[row].node < ed.fuss.tree.nodes.len
}

// `fuss_select_row` (`fussmode.c:740-745`).
fn fuss_select_row(mut ed: Ed, row: int) {
    git.fuss_sel_from_row(mut ed.fuss.sel, ed.fuss.tree, row)
}

/// Row `row`'s path bytes (C's `item->path`).
pub fn fuss_row_path(ed: Ed, row: int) -> List[byte] {
    git.fuss_item_path(ed.fuss.tree, row)
}

// ------------------------------------------------------------------
// The open files and the effective expansion (`fussmode.c:747-935`)
// ------------------------------------------------------------------

// `fuss_relative_path_valid` (`fussmode.c:760-781`).
fn fuss_relative_path_valid(p: List[byte], at: int, len: int) -> bool {
    if len == 0 || p[at] as int == 47 {
        return false
    }
    var i = at
    let end = at + len
    while i < end {
        let start = i
        while i < end && p[i] as int != 47 {
            i += 1
        }
        let part = i - start
        if part == 0 ||
            part == 1 && p[start] as int == 46 ||
            part == 2 && p[start] as int == 46 && p[start + 1] as int == 46 {
            return false
        }
        i += 1
    }
    p[end - 1] as int != 47
}

// `fuss_open_scratch_push` (`fussmode.c:783-830`): `path` made
// workspace-relative under `root` and recorded.
fn fuss_open_scratch_push(mut s: git.GitPaths, path: str, root: str) {
    if path.len == 0 {
        return
    }
    let pb = path.bytes()
    let rb = root.bytes()
    var at = 0
    var len = pb.len
    var ok = false
    if pb[0] as int != 47 {
        while len >= 2 && pb[at] as int == 46 && pb[at + 1] as int == 47 {
            at += 2
            len -= 2
        }
        ok = true
    } else if rb.len == 1 && rb[0] as int == 47 && pb.len > 1 {
        at = 1
        len = pb.len - 1
        ok = true
    } else if rb.len != 0 && pb.len > rb.len + 1 && pb[rb.len] as int == 47 {
        var same = true
        var i = 0
        while i < rb.len {
            if pb[i] != rb[i] {
                same = false
                break
            }
            i += 1
        }
        if same {
            at = rb.len + 1
            len = pb.len - rb.len - 1
            ok = true
        }
    }
    if !ok || !fuss_relative_path_valid(pb, at, len) {
        return
    }
    let start = git.git_pool_add(mut s.pool, pb, at, at + len)
    (mut s.tmp).push(git.GitPathRow { at: start, len: len, is_dir: false })
}

// `fuss_collect_pane_paths` (`fussmode.c:832-850`).
fn fuss_collect_pane_paths(mut ed: Ed, root: int, workspace: str) {
    if !pane_live(ed, root) {
        return
    }
    let leaves = pane_collect_leaves(ed, root, PANE_MAX_LEAVES)
    for l in leaves {
        let w = ed.panes[l].win
        if w < 0 || w >= ed.wins.len {
            continue
        }
        let b = ed.wins[w].buf
        if b >= 0 && b < ed.bufs.len && ed.bufs[b].flags & BUF_SCRATCH == 0 && ed.bufs[b].has_path {
            let p = copy ed.bufs[b].path
            fuss_open_scratch_push(mut ed.fuss.open_scratch, p, workspace)
        }
    }
}

// `fuss_open_files_refresh` (`fussmode.c:852-906`): every tab's path and
// every pane's file, workspace-relative, sorted and unique; true when
// the set changed (the memory rebuilt from it).
fn fuss_open_files_refresh(mut ed: Ed) -> bool {
    let workspace = shell_ws_root(ed)
    git.git_paths_reset(mut ed.fuss.open_scratch)
    var t = 0
    while t < ed.tabs.len {
        if ed.tabs[t].has_path {
            let p = copy ed.tabs[t].path
            fuss_open_scratch_push(mut ed.fuss.open_scratch, p, workspace)
        }
        let root = ed.tabs[t].root
        fuss_collect_pane_paths(mut ed, root, workspace)
        t += 1
    }
    let pr = ed.pane_root
    fuss_collect_pane_paths(mut ed, pr, workspace)
    git.git_paths_sort(mut ed.fuss.open_scratch)
    // Unique, in place.
    var unique = 0
    var i = 0
    let n = ed.fuss.open_scratch.rows.len
    while i < n {
        let r = copy ed.fuss.open_scratch.rows[i]
        if unique != 0 {
            let u = copy ed.fuss.open_scratch.rows[unique - 1]
            if git.git_span_cmp(
                ed.fuss.open_scratch.pool,
                u.at,
                u.len,
                ed.fuss.open_scratch.pool,
                r.at,
                r.len,
            ) ==
                0 {
                i += 1
                continue
            }
        }
        ed.fuss.open_scratch.rows[unique] = r
        unique += 1
        i += 1
    }
    while ed.fuss.open_scratch.rows.len > unique {
        let _ = (mut ed.fuss.open_scratch.rows).pop() else git.GitPathRow {
            at: 0,
            len: 0,
            is_dir: false,
        }
    }
    var changed = ed.fuss.open_files.rows.len != unique
    i = 0
    while !changed && i < unique {
        let old = copy ed.fuss.open_files.rows[i]
        let now = copy ed.fuss.open_scratch.rows[i]
        changed = git.git_span_cmp(
            ed.fuss.open_files.pool,
            old.at,
            old.len,
            ed.fuss.open_scratch.pool,
            now.at,
            now.len,
        ) !=
            0
        i += 1
    }
    if !changed {
        return false
    }
    git.fuss_open_memory_clear(mut ed.fuss.open_files)
    i = 0
    while i < unique {
        let r = copy ed.fuss.open_scratch.rows[i]
        let _ = git.fuss_open_memory_set(
            mut ed.fuss.open_files,
            ed.fuss.open_scratch.pool,
            r.at,
            r.len,
            true,
        )
        i += 1
    }
    true
}

// `fuss_apply_effective` (`fussmode.c:908-935`): the manual memory and
// the open files' ancestry applied; a changed natural width relayouts.
fn fuss_apply_effective(mut ed: Ed) {
    let old = ed.fuss.natural_cols
    let manual = copy ed.fuss.manual_open
    let open = copy ed.fuss.open_files
    git.fuss_apply_expansion(mut ed.fuss.tree, manual, open)
    ed.fuss.natural_cols = fuss_tree_natural_width(ed.fuss.tree)
    if ed.fuss.natural_cols != old {
        ed.fuss.backdrop_dirty = true
        ed.layout_dirty = true
        ed.full_damage = true
    }
}

// `fuss_build` (`fussmode.c:937-960`): the tree from snapshot `live`
// (unless `force` is off and it was built from this generation), the
// walk's files merged, the expansion applied, the selection kept.
fn fuss_build(mut ed: Ed, live: int, force: bool) {
    if git_repo_ready(ed) && ed.git.repo.has_top {
        let top = ed.git.repo.top_level
        let _ = git.fuss_tree_scope_roots(mut ed.fuss.tree, top, shell_ws_root(ed))
    }
    if !force && ed.fuss.tree.snap_gen == ed.git.snap[live].gen {
        return
    }
    let o = copy ed.fuss.opts
    git.fuss_build(mut ed.fuss.tree, ed.git.snap[live], o)
    fuss_rebase_progress_update(mut ed, live)
    if ed.fuss.opts.all_files && !ed.fuss.has_walk && ed.fuss.files.paths.len != 0 {
        let files = copy ed.fuss.files
        let _ = git.fuss_merge_files(mut ed.fuss.tree, files, ed.git.snap[live], o)
    }
    let _ = fuss_open_files_refresh(mut ed)
    fuss_apply_effective(mut ed)
    if fuss_row(ed) < 0 && ed.fuss.tree.items.len != 0 {
        fuss_select_row(mut ed, 0)
    }
    ed.fuss.scroll = 0
    fuss_damage(mut ed)
}

/// `yew_fuss_workspace_changed` (`fussmode.c:1027-1044`): a new
/// workspace forgets both memories.
pub fn fuss_workspace_changed(mut ed: Ed) {
    git.fuss_open_memory_clear(mut ed.fuss.manual_open)
    git.fuss_open_memory_clear(mut ed.fuss.open_files)
    git.git_paths_reset(mut ed.fuss.open_scratch)
    if ed.fuss.active {
        let _ = fuss_open_files_refresh(mut ed)
        fuss_apply_effective(mut ed)
        fuss_damage(mut ed)
    }
}

// The walk's end: its files merged into the tree (`fussmode.c:1088-1100`,
// `:1171-1185`).
fn fuss_walk_finish(mut ed: Ed, live: int) {
    ws.walk_end(mut ed.fuss.walk)
    ed.fuss.has_walk = false
    ed.fuss.files = copy ed.fuss.walk.out
    let o = copy ed.fuss.opts
    let files = copy ed.fuss.files
    if git.fuss_merge_files(mut ed.fuss.tree, files, ed.git.snap[live], o) {
        let _ = fuss_open_files_refresh(mut ed)
        fuss_apply_effective(mut ed)
        if fuss_row(ed) < 0 && ed.fuss.tree.items.len != 0 {
            fuss_select_row(mut ed, 0)
        }
        fuss_damage(mut ed)
    }
}

/// `yew_fuss_mode_enter` (`fussmode.c:1051-1104`): the glyph option read,
/// a first entry's options, the deterministic loading frame, the saved
/// buffer, the walk restarted; the tree built from what is published; a
/// refresh requested.
pub fn fuss_mode_enter(mut ed: Ed) -> int {
    let ov = opt_get(ed, -1, -1, "git.ascii_glyphs") else optv_bool(false)
    if ov.t == OPT_BOOL {
        ed.fuss.ascii_glyphs = ov.b
    }
    if !ed.fuss.active {
        ed.fuss.opts.all_files = state_option_bool(ed, "git.tree.all_files", true)
        ed.fuss.opts.show_hidden = state_option_bool(ed, "git.tree.show_hidden", false)
        ed.fuss.active = true
        // F mode owns a deterministic loading frame even when s53's
        // consumers have already warmed the cache (`fussmode.c:1066-1070`).
        // Entered before the loop's first turn (a directory launch,
        // `ed.now_ms` still 0), C's stamp is `0 + 16` against a clock that
        // counts from the host's boot: the frame is the pre-loop paint and
        // ends at the first tick. The port's clock counts from the process
        // (G61), so that stamp is 0 (R-yw13-6).
        ed.fuss.opening = true
        ed.fuss.opening_until_ms = if ed.now_ms == 0 {
            0
        } else if ed.now_ms > I64_MAX - FUSS_OPENING_FRAME_MS {
            I64_MAX
        } else {
            ed.now_ms + FUSS_OPENING_FRAME_MS
        }
        ed.fuss.saved_buffer_id = if ed.win >= 0 && ed.wins[ed.win].buf >= 0 {
            ed.bufs[ed.wins[ed.win].buf].id
        } else {
            0
        }
        ed.fuss.backdrop_dirty = true
        ed.fuss.seen_detect_state = git_detect_state(ed)
        ed.fuss.seen_detect_result = git_detect_result(ed)
        ed.layout_dirty = true
        ed.full_damage = true
        fuss_walk_restart(mut ed)
    }
    let live = git_snapshot(mut ed)
    fuss_build(mut ed, live, false)
    if ed.fuss.has_walk && !ws.walk_step(mut ed.fuss.walk, 2000) {
        fuss_walk_finish(mut ed, live)
    }
    let _ = git_refresh(mut ed, false)
    fuss_damage(mut ed)
    CMD_OK
}

/// `yew_fuss_mode_leave` (`fussmode.c:1106-1122`): not while the commit
/// scratch owns focus.
pub fn fuss_mode_leave(mut ed: Ed) {
    if ed.fuss.commit_editing {
        return
    }
    ed.fuss.active = false
    fuss_expand_clear(mut ed)
    fuss_jump_init(mut ed.fuss)
    fuss_viewer_close(mut ed)
    ed.layout_dirty = true
    ed.full_damage = true
    ed.footer_dirty = true
}

/// `yew_fuss_footer_rows` (`fussmode.c:1124-1127`).
pub fn fuss_footer_rows(ed: Ed) -> int {
    if fuss_active(ed) then 2 else 0
}

/// `yew_fuss_tick` (`fussmode.c:1129-1189`): a result delivered, the
/// opening frame expired, detection changes repainted, the tree rebuilt
/// from a new generation, the idle hook rearmed after a mutation's final
/// refresh, the walk and the untracked scan stepped, the jump expired.
pub fn fuss_tick(mut ed: Ed, now: int) {
    fuss_result_tick(mut ed)
    if !fuss_active(ed) {
        return
    }
    if ed.fuss.opening && now >= ed.fuss.opening_until_ms {
        ed.fuss.opening = false
        fuss_damage(mut ed)
    }
    let ds = git_detect_state(ed)
    let dr = git_detect_result(ed)
    if ds != ed.fuss.seen_detect_state || dr != ed.fuss.seen_detect_result {
        // Detection owns the header and the footer; a completion after the
        // opening frame must repaint the header's `loading` suffix.
        ed.fuss.seen_detect_state = ds
        ed.fuss.seen_detect_result = dr
        fuss_damage(mut ed)
    }
    let live = git_snapshot(mut ed)
    fuss_build(mut ed, live, false)
    if ed.fuss.mutation_snapshot_pending &&
        ed.git.snap[live].gen != ed.fuss.mutation_snapshot_gen &&
        !git_refresh_busy(ed) {
        // The idle hook is the public observation point for asynchronous
        // FUSS state, rearmed only after the mutation's final refresh.
        ed.fuss.mutation_snapshot_pending = false
        ed.flrt.idle_pending = true
        ed.flrt.idle_fired = false
    }
    if ed.fuss.has_walk && !ws.walk_step(mut ed.fuss.walk, 2000) {
        fuss_walk_finish(mut ed, live)
    }
    fuss_expand_tick(mut ed)
    if fuss_jump_tick(mut ed.fuss, now) {
        ed.footer_dirty = true
    }
}

/// `yew_fuss_deadline` (`fussmode.c:1191-1214`): the opening frame, a
/// walk or scan to step (0), the jump's expiry; -1 for none.
pub fn fuss_deadline(ed: Ed, now: int) -> int {
    if !ed.fuss.active {
        return -1
    }
    if ed.fuss.opening {
        if ed.fuss.opening_until_ms <= now {
            return 0
        }
        return ed.fuss.opening_until_ms - now
    }
    if ed.fuss.has_walk || ed.fuss.has_expand_walk {
        return 0
    }
    if !ed.fuss.jump_armed {
        return -1
    }
    if ed.fuss.jump_deadline_ms <= now {
        return 0
    }
    ed.fuss.jump_deadline_ms - now
}

/// `yew_fuss_key` (`fussmode.c:1236-1278`): type-to-jump in F mode only
/// (the commit scratch's Insert input is not FUSS's), never inside a
/// structural chord (`C-w s`'s tail reaches the keymap); a non-printable
/// key disarms and falls through to dispatch.
pub fn fuss_key(mut ed: Ed, key: term.Key, now: int) -> bool {
    if !fuss_active(ed) || ed.mode != MODE_F {
        return false
    }
    if ed.chord.n != 0 {
        return false
    }
    if !fuss_jump_printable(key) && key.code != term.KEY_BACKSPACE {
        if ed.fuss.jump_armed {
            fuss_jump_init(mut ed.fuss)
            ed.footer_dirty = true
        }
        return false
    }
    if !ed.fuss.jump_armed && key.code == term.KEY_BACKSPACE {
        return false
    }
    var labels = List[List[byte]]()
    var i = 0
    while i < ed.fuss.tree.items.len {
        (mut labels).push(git.fuss_item_path(ed.fuss.tree, i))
        i += 1
    }
    if labels.len == 0 {
        let (consumed, _) = fuss_jump_key(mut ed.fuss, key, now, labels, -1)
        if consumed {
            fuss_damage(mut ed)
        }
        return consumed
    }
    let r = fuss_row(ed)
    let row = if r < 0 then 0 else r
    let (consumed, got) = fuss_jump_key(mut ed.fuss, key, now, labels, row)
    if consumed && got >= 0 && got < labels.len {
        fuss_select_row(mut ed, got)
        fuss_damage(mut ed)
    }
    consumed
}

// ------------------------------------------------------------------
// The viewer and the commit view (`fussmode.c:177-298`, `:428-565`)
// ------------------------------------------------------------------

// `fuss_viewer_close` (`fussmode.c:177-194`).
fn fuss_viewer_close(mut ed: Ed) {
    if ed.fuss.viewer {
        let owner = ed_win_by_id(ed, ed.fuss.viewer_win_id)
        if owner >= 0 {
            panel_close(mut ed, owner)
        }
    }
    ed.fuss.viewer = false
    ed.fuss.viewer_win_id = 0
    ed.fuss.viewer_buffer_id = 0
    fuss_damage(mut ed)
}

/// Buffer `bi`'s bytes (`fuss_buffer_bytes`, `fussmode.c:2657-2684`).
pub fn fuss_buffer_bytes(ed: Ed, bi: int) -> List[byte] {
    text.textbuf_bytes(ed.bufs[bi].ec.tb)
}

// `fuss_viewer_open` (`fussmode.c:196-298`): buffer `bi` in the floating
// panel — centred in the content area for a fullscreen drawer, else
// anchored beside the drawer at the editor's top; a viewer with no room
// is recorded open with nothing drawn.
fn fuss_viewer_open(mut ed: Ed, bi: int) -> bool {
    if bi < 0 || !ed.fuss.active || ed.win < 0 {
        return false
    }
    let body = fuss_buffer_bytes(ed, bi)
    var spec = panel_spec_new()
    spec.title = if ed.bufs[bi].has_name then ed.bufs[bi].name else "preview"
    spec.body = body
    let content = fuss_backdrop_rect(ed)
    let drawer = fuss_drawer_rect(ed)
    let layout = fuss_drawer_layout(ed.grid.cols, ed.fuss.natural_cols)
    let w = ed.win
    if layout.fullscreen {
        var area = copy content
        if content.w < 3 || content.h < 3 {
            ed.fuss.viewer = true
            ed.fuss.viewer_win_id = ed.wins[w].id
            ed.fuss.viewer_buffer_id = ed.bufs[bi].id
            return true
        }
        if area.w > 4 {
            area.x = area.x + 2
            area.w = area.w - 4
        }
        if area.h > 4 {
            area.y = area.y + 2
            area.h = area.h - 4
        }
        spec.place = PANEL_CENTER
        spec.area = copy area
        spec.has_area = true
        spec.max_w = if area.w > PANEL_MAX_W then PANEL_MAX_W else area.w
        spec.max_h = if area.h > PANEL_MAX_H then PANEL_MAX_H else area.h
        spec.role = "git.ignored"
        if !panel_open(mut ed, w, spec) {
            return false
        }
        ed.fuss.viewer = true
        ed.fuss.viewer_win_id = ed.wins[w].id
        ed.fuss.viewer_buffer_id = ed.bufs[bi].id
        ed.full_damage = true
        fuss_damage(mut ed)
        return true
    }
    let area_right = ed.wins[w].rect.x + ed.wins[w].rect.w
    let drawer_right = drawer.x + drawer.w
    var anchor_x = ed.wins[w].rect.x
    if drawer_right > anchor_x && drawer_right <= 65535 {
        anchor_x = drawer_right
    }
    spec.x = anchor_x
    spec.y = ed.wins[w].rect.y
    spec.place = PANEL_CURSOR
    let room = if area_right > anchor_x + 2 then area_right - anchor_x - 2 else 0
    spec.max_w = if room < PANEL_MAX_W then room else PANEL_MAX_W
    spec.max_h = PANEL_MAX_H
    spec.role = "git.ignored"
    if room == 0 {
        ed.fuss.viewer = true
        ed.fuss.viewer_win_id = ed.wins[w].id
        ed.fuss.viewer_buffer_id = ed.bufs[bi].id
        return true
    }
    if !panel_open(mut ed, w, spec) {
        return false
    }
    ed.fuss.viewer = true
    ed.fuss.viewer_win_id = ed.wins[w].id
    ed.fuss.viewer_buffer_id = ed.bufs[bi].id
    ed.full_damage = true
    fuss_damage(mut ed)
    true
}

/// `fuss_show_buffer` (`fussmode.c:428-431`).
pub fn fuss_show_buffer(mut ed: Ed, bi: int) -> bool {
    fuss_viewer_open(mut ed, bi)
}

// The leaf showing window id `want` in any tab (`fuss_leaf_for_win_id`,
// `fussmode.c:459-477`), -1 for none.
fn fuss_leaf_for_win_id(ed: Ed, want: int) -> int {
    if want == 0 {
        return -1
    }
    var t = 0
    while t < ed.tabs.len {
        let root = if t == ed.tab_active && pane_live(ed, ed.pane_root) {
            ed.pane_root
        } else {
            ed.tabs[t].root
        }
        if pane_live(ed, root) {
            for l in pane_collect_leaves(ed, root, PANE_MAX_LEAVES) {
                let w = ed.panes[l].win
                if w >= 0 && w < ed.wins.len && ed.wins[w].id == want {
                    return l
                }
            }
        }
        t += 1
    }
    -1
}

// `fuss_commit_view_open` (`fussmode.c:433-457`): the focused leaf shows
// a clone of the live window over the commit buffer; the live window is
// kept to come back to.
fn fuss_commit_view_open(mut ed: Ed, bi: int) -> bool {
    if bi < 0 ||
        !pane_live(ed, ed.focus) ||
        !ed.panes[ed.focus].is_leaf ||
        ed.win < 0 ||
        ed.panes[ed.focus].win != ed.win {
        return false
    }
    if ed.fuss.commit_win_id != 0 {
        return false
    }
    fuss_viewer_close(mut ed)
    let w = ed_win_clone(mut ed, ed.win)
    if w < 0 {
        return false
    }
    ed_win_set_buffer(mut ed, w, bi)
    ed.fuss.commit_saved_win_id = ed.wins[ed.win].id
    ed.fuss.commit_win_id = ed.wins[w].id
    let f = ed.focus
    ed.panes[f].win = w
    ed.win = w
    ed.full_damage = true
    true
}

/// `fuss_commit_view_close` (`fussmode.c:479-507`): the saved window put
/// back in the commit view's leaf, the clone released.
pub fn fuss_commit_view_close(mut ed: Ed) {
    let w = ed_win_by_id(ed, ed.fuss.commit_win_id)
    if w < 0 {
        return
    }
    let saved = ed_win_by_id(ed, ed.fuss.commit_saved_win_id)
    if saved < 0 {
        return
    }
    let leaf = fuss_leaf_for_win_id(ed, ed.fuss.commit_win_id)
    if leaf >= 0 {
        ed.panes[leaf].win = saved
        if ed.win == w {
            ed.win = saved
        }
    }
    ed.fuss.commit_win_id = 0
    ed.fuss.commit_saved_win_id = 0
    if leaf >= 0 {
        ed_win_release(mut ed, w)
    }
    ed.full_damage = true
}

/// `yew_fuss_win_releasing` (`fussmode.c:509-535`): a released window the
/// viewer or the commit view held; the commit's saved window is released
/// with it and the commit cancelled at the next structural settle.
pub fn fuss_win_releasing(mut ed: Ed, win_id: int) {
    if win_id == 0 {
        return
    }
    if ed.fuss.viewer_win_id == win_id {
        ed.fuss.viewer = false
        ed.fuss.viewer_win_id = 0
        ed.fuss.viewer_buffer_id = 0
    }
    if ed.fuss.commit_win_id == win_id {
        let saved = ed_win_by_id(ed, ed.fuss.commit_saved_win_id)
        ed.fuss.commit_win_id = 0
        ed.fuss.commit_saved_win_id = 0
        ed.fuss.commit_editing = false
        ed.fuss.commit_amend = false
        ed.fuss.commit_comment = 0
        ed.fuss.commit_cancel_pending = true
        if saved >= 0 {
            ed_win_release(mut ed, saved)
        }
    }
}

/// `yew_fuss_windows_changed` (`fussmode.c:537-565`): the open-file set
/// and its ancestry re-derived; a commit whose view closed is aborted and
/// F mode re-entered.
pub fn fuss_windows_changed(mut ed: Ed) {
    if ed.fuss.active && fuss_open_files_refresh(mut ed) {
        fuss_apply_effective(mut ed)
        let row = fuss_row(ed)
        if row >= 0 {
            fuss_select_row(mut ed, row)
        }
        fuss_damage(mut ed)
    }
    if !ed.fuss.commit_cancel_pending {
        return
    }
    ed.fuss.commit_cancel_pending = false
    let commit = buf_index_of_id(ed, ed.fuss.commit_buffer_id)
    ed.fuss.commit_buffer_id = 0
    if commit >= 0 {
        ws_scratch_drop(mut ed, commit)
    }
    ed_msg(mut ed, MSG_INFO, "commit aborted because its editor view closed")
    if mode_enter(mut ed, MODE_F) != CMD_OK {
        let _ = mode_enter(mut ed, MODE_L)
    }
}

/// The buffer index of id `id`, -1 for none (C's `yew_ws_buf_by_id`).
pub fn buf_index_of_id(ed: Ed, id: int) -> int {
    if id == 0 {
        return -1
    }
    var i = 0
    while i < ed.bufs.len {
        if ed.bufs[i].id == id && ed.bufs[i].resident {
            return i
        }
        i += 1
    }
    -1
}

/// `fuss_replace_buffer` (`fussmode.c:567-587`): buffer `bi`'s text
/// replaced by `bytes` through the edit chokepoint (outside undo for a
/// `BUF_NOUNDO` buffer).
pub fn fuss_replace_buffer(mut ed: Ed, bi: int, bytes: List[byte]) -> bool {
    if bi < 0 || bi >= ed.bufs.len {
        return false
    }
    let had_undo = ed.bufs[bi].ec.has_undo
    if ed.bufs[bi].flags & BUF_NOUNDO != 0 {
        ed.bufs[bi].ec.has_undo = false
    }
    let shown = ed.win >= 0 && ed.wins[ed.win].buf == bi
    let w = ed.win
    if shown {
        edit_take(mut ed, w)
    }
    var ok = true
    let old = text.textbuf_len(ed.bufs[bi].ec.tb)
    if old != 0 {
        ok = text.edit_delete(mut ed.bufs[bi].ec, text.span(0, old))
    }
    if ok && bytes.len != 0 {
        ok = text.edit_insert_part(mut ed.bufs[bi].ec, 0 as text.ByteOff, bytes, 0, bytes.len)
    }
    if shown {
        edit_give(mut ed, w)
    }
    ed.bufs[bi].ec.has_undo = had_undo
    ed.full_damage = true
    ok
}

/// `fuss_show_result` (`fussmode.c:589-607`): the result's stdout in
/// `*git-view*`, shown in the viewer.
pub fn fuss_show_result(mut ed: Ed) {
    var bi = ws_scratch_find(ed, "*git-view*")
    if bi < 0 {
        bi = ws_scratch_new(mut ed, "*git-view*", BUF_NOUNDO | BUF_READONLY)
    }
    if bi < 0 {
        return
    }
    let out = copy ed.git.result.out
    if !fuss_replace_buffer(mut ed, bi, out) {
        ed_msg(mut ed, MSG_ERROR, "could not update Git viewer buffer")
        return
    }
    text.undo_mark_saved(mut ed.bufs[bi].ec.undo, ed.bufs[bi].ec.tb)
    let _ = fuss_show_buffer(mut ed, bi)
}

fn fuss_bytes_has(bytes: List[byte], needle: str) -> bool {
    let nb = needle.bytes()
    if nb.len == 0 || bytes.len < nb.len {
        return false
    }
    var at = 0
    while at + nb.len <= bytes.len {
        var k = 0
        while k < nb.len && bytes[at + k] == nb[k] {
            k += 1
        }
        if k == nb.len {
            return true
        }
        at += 1
    }
    false
}

// `fuss_result_tick` (`fussmode.c:624-719`): the pending verb's result,
// once: a mutation records the generation the idle hook waits past; a
// pick continues its picker; a view shows its output; otherwise the
// verb's completion or its stderr on the message line.
fn fuss_result_tick(mut ed: Ed) {
    if ed.fuss.pending_job == 0 {
        return
    }
    if ed.git.result.job_id != ed.fuss.pending_job ||
        ed.git.result.job_id == ed.fuss.seen_result_job {
        return
    }
    ed.fuss.seen_result_job = ed.git.result.job_id
    ed.fuss.pending_job = 0
    let pick = ed.fuss.pending_pick
    ed.fuss.pending_pick = FUSS_PICK_NONE
    let verb = ed.git.result.verb
    let state = ed.git.result.state
    if state == git.GIT_OK {
        let v = git_verb(ed, verb)
        if v >= 0 && ed.git.verbs[v].kind != GV_READ {
            ed.fuss.mutation_snapshot_gen = if git_snapshot_cached(ed) {
                ed.git.snap[ed.git.live].gen
            } else {
                0
            }
            ed.fuss.mutation_snapshot_pending = true
        }
        if pick == FUSS_PICK_COMMIT_AMEND {
            let out = copy ed.git.result.out
            let _ = fuss_commit_begin(mut ed, true, out)
        } else if pick == FUSS_PICK_REBASE_CONFIRM {
            fuss_show_result(mut ed)
            ed.fuss.prompt_action = FUSS_PROMPT_REBASE
            cmdline_open_input(mut ed, "", INPUT_DONE_FUSS, 0)
            if ed.cmdline.active {
                ed_msg(mut ed, MSG_WARN, "review the rebase range, then type 'rebase' to continue")
            } else {
                fuss_prompt_clear(mut ed)
            }
        } else if pick != FUSS_PICK_NONE {
            let _ = fuss_picker_result(mut ed, pick)
        } else if ed.fuss.pending_view {
            fuss_show_result(mut ed)
        } else {
            ed_msg(mut ed, MSG_INFO, "{if verb.len == 0 then "git" else verb} complete")
        }
        if verb == "branch-delete" && ed.fuss.prompt_action == FUSS_PROMPT_NONE {
            ed.fuss.prompt_path = ""
            ed.fuss.has_prompt_path = false
        }
    } else if verb == "branch-delete" &&
        ed.fuss.has_prompt_path &&
        ed.fuss.prompt_action == FUSS_PROMPT_NONE &&
        fuss_bytes_has(ed.git.result.err, "not fully merged") {
        ed.fuss.prompt_action = FUSS_PROMPT_BRANCH_DELETE
        cmdline_open_input(mut ed, "", INPUT_DONE_FUSS, 0)
        if ed.cmdline.active {
            ed_msg(
                mut ed,
                MSG_WARN,
                "force-delete branch {ed.fuss.prompt_path} — type 'delete' to confirm",
            )
        } else {
            fuss_prompt_clear(mut ed)
        }
    } else if ed.git.result.err.len != 0 {
        let err = copy ed.git.result.err
        ed_msg_bytes(mut ed, MSG_ERROR, err)
    } else {
        ed_msg(mut ed, MSG_ERROR, git.git_state_str(state))
    }
    if state != git.GIT_OK && verb == "branch-delete" && ed.fuss.prompt_action == FUSS_PROMPT_NONE {
        ed.fuss.prompt_path = ""
        ed.fuss.has_prompt_path = false
    }
    if state != git.GIT_OK && pick == FUSS_PICK_REBASE_CONFIRM {
        fuss_prompt_clear(mut ed)
    }
    if state != git.GIT_OK && pick == FUSS_PICK_REMOTE_CHECK {
        fuss_picker_open(mut ed, FUSS_PICK_REMOTE, "remote")
    }
    ed.fuss.pending_view = false
    fuss_damage(mut ed)
}

// ------------------------------------------------------------------
// The observers (`fussmode.c:1733-1917`, s57.13 §3–§4)
// ------------------------------------------------------------------

/// The interned id of `path` (C's `yew_intern(&ed->interner, …)`), 0 when
/// it cannot be a payload.
pub fn fuss_path_id(mut ed: Ed, path: List[byte]) -> int {
    let id = util.intern_bytes(mut ed.fuss.paths, path, 0, path.len)
    if id <= 0 || id > 2147483647 then 0 else id
}

/// The path interned as `id` (C's `yew_intern_str`).
pub fn fuss_path_of_id(ed: Ed, id: int) -> (bool, List[byte]) {
    if id <= 0 {
        return (false, List[byte]())
    }
    let s = util.intern_str(ed.fuss.paths, id) else { return (false, List[byte]()) }
    var out = List[byte]()
    for b in s.bytes() {
        (mut out).push(b)
    }
    (true, out)
}

// `fuss_item_by_path_id` (`fussmode.c:1733-1755`): the row a region
// payload names (an interned PATH, not a row index: the tree rebuilds
// under the pointer), -1 for none.
fn fuss_item_by_path_id(ed: Ed, id: int) -> int {
    if !fuss_active(ed) || id == 0 {
        return -1
    }
    let (ok, path) = fuss_path_of_id(ed, id)
    if !ok || path.len == 0 {
        return -1
    }
    var i = 0
    while i < ed.fuss.tree.items.len {
        if git.fuss_item_path_eq(ed.fuss.tree, i, path, 0, path.len) {
            return i
        }
        i += 1
    }
    -1
}

/// `yew_fuss_path_is_dir` (`fussmode.c:1757-1765`): (known, is_dir), from
/// the tree, never from the path text.
pub fn fuss_path_is_dir(ed: Ed, id: int) -> (bool, bool) {
    let row = fuss_item_by_path_id(ed, id)
    if row < 0 {
        return (false, false)
    }
    (true, !ed.fuss.tree.items[row].is_file)
}

fn fuss_node_target(ed: Ed, row: int) -> FussTarget {
    var out = fuss_target_none()
    let n = copy ed.fuss.tree.nodes[ed.fuss.tree.items[row].node]
    out.known = true
    // Status is known because the node is in the tree, not because
    // anything below it is dirty (`fussmode.c:1781-1787`).
    out.status_known = true
    out.is_file = n.is_file
    out.staged = n.staged
    out.unstaged = n.unstaged
    out.untracked = n.untracked
    out.incoming = n.incoming
    out.conflicted = n.conflicted
    out.expanded = !n.is_file && n.expanded
    out
}

/// `yew_fuss_path_target` (`fussmode.c:1767-1796`).
pub fn fuss_path_target(ed: Ed, id: int) -> (bool, FussTarget) {
    let row = fuss_item_by_path_id(ed, id)
    if row < 0 || !fuss_item_ok(ed, row) {
        return (false, fuss_target_none())
    }
    (true, fuss_node_target(ed, row))
}

/// `yew_fuss_state` (`fussmode.c:1798-1833`).
pub fn fuss_state(ed: Ed) -> (bool, FussState) {
    var out = FussState {
        path: List[byte](),
        active: false,
        known: false,
        is_file: false,
        staged: false,
        unstaged: false,
        untracked: false,
        expanded: false,
        actions_open: false,
        clean: false,
    }
    if !fuss_active(ed) {
        return (false, out)
    }
    out.active = true
    let row = fuss_row(ed)
    if fuss_item_ok(ed, row) {
        let n = copy ed.fuss.tree.nodes[ed.fuss.tree.items[row].node]
        out.path = git.fuss_item_path(ed.fuss.tree, row)
        out.known = true
        out.is_file = n.is_file
        out.staged = n.staged
        out.unstaged = n.unstaged
        out.untracked = n.untracked
        out.expanded = !n.is_file && n.expanded
    }
    out.actions_open = ed.fuss.picker_action == FUSS_PICK_ACTIONS && picker_active(ed)
    let s = ed.git.live
    let st = ed.git.snap[s].state
    out.clean = git_snapshot_cached(ed) &&
        ed.git.snap[s].entries.len == 0 &&
        (
            st == git.GIT_OK ||
                st == git.GIT_NO_HEAD ||
                st == git.GIT_DETACHED ||
                st == git.GIT_NO_UPSTREAM
        )
    (true, out)
}

/// `yew_fuss_selected_anchor` (`fussmode.c:1835-1869`): the selected row's
/// path id and its cell (the drawer's header row is the +1, the same
/// arithmetic the draw places regions with); (false, …) when scrolled out.
pub fn fuss_selected_anchor(mut ed: Ed) -> (bool, int, int, int) {
    if !fuss_active(ed) {
        return (false, 0, 0, 0)
    }
    let tree = fuss_drawer_rect(ed)
    if tree.w == 0 || tree.h == 0 {
        return (false, 0, 0, 0)
    }
    let row = fuss_row(ed)
    if !fuss_item_ok(ed, row) || row < ed.fuss.scroll {
        return (false, 0, 0, 0)
    }
    let offset = row - ed.fuss.scroll
    if offset + 1 >= tree.h {
        return (false, 0, 0, 0)
    }
    let path = git.fuss_item_path(ed.fuss.tree, row)
    let id = fuss_path_id(mut ed, path)
    if id == 0 {
        return (false, 0, 0, 0)
    }
    (true, id, tree.x, tree.y + 1 + offset)
}

/// `yew_fuss_select_path` (`fussmode.c:1871-1885`): selecting is not
/// opening.
pub fn fuss_select_path(mut ed: Ed, id: int) {
    let row = fuss_item_by_path_id(ed, id)
    if row < 0 {
        return
    }
    let path = git.fuss_item_path(ed.fuss.tree, row)
    git.fuss_sel_set(mut ed.fuss.sel, path, 0, path.len)
    fuss_damage(mut ed)
}

/// `yew_fuss_scroll` (`fussmode.c:1887-1916`): the wheel moves THROUGH
/// the selection (the scroll offset is derived from it every draw).
pub fn fuss_scroll(mut ed: Ed, rows: int) {
    if !fuss_active(ed) || rows == 0 || ed.fuss.tree.items.len == 0 {
        return
    }
    let last = ed.fuss.tree.items.len - 1
    var row = fuss_row(ed)
    if row < 0 {
        row = 0
    }
    row += rows
    if row < 0 {
        row = 0
    }
    if row > last {
        row = last
    }
    fuss_select_row(mut ed, row)
    fuss_damage(mut ed)
}

/// `yew_fuss_draw_dirty` (`fussmode.c:1918-1921`).
pub fn fuss_draw_dirty(ed: Ed) -> bool {
    fuss_active(ed) && ed.fuss.draw_dirty
}

/// `yew_fuss_state_free` (`fussmode.c:984-1025`).
pub fn fuss_state_free(mut ed: Ed) {
    fuss_commit_view_close(mut ed)
    ed.fuss.commit_editing = false
    ed.fuss.active = false
    if ed.fuss.preview_job != 0 {
        let _ = job_signal(mut ed, ed.fuss.preview_job, signal.terminate())
    }
    if ed.fuss.has_walk {
        ws.walk_end(mut ed.fuss.walk)
        ed.fuss.has_walk = false
    }
    fuss_expand_clear(mut ed)
}
