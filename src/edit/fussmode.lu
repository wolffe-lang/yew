/// `yew_fuss_state_init` (`fussmode.c:967-982`).
pub fn fuss_state_new() -> FussMode {
    let (_, w0) = ws.walk_begin("", ws.walk_opts())
    let (_, w1) = ws.walk_begin("", ws.walk_opts())
    FussMode {
        tree: git.fuss_tree_new(),
        manual_open: git.fuss_open_memory_new(),
        open_files: git.fuss_open_memory_new(),
        open_scratch: git.git_paths_new(),
        natural_cols: 0,
        opts: git.FussOpts { all_files: false, show_hidden: false },
        sel: git.fuss_sel_new(),
        jump: typejump_new(),
        jump_armed: false,
        jump_deadline_ms: 0,
        active: false,
        opening: false,
        opening_until_ms: 0,
        ascii_glyphs: false,
        viewer: false,
        viewer_win_id: 0,
        draw_dirty: false,
        backdrop_dirty: false,
        seen_detect_state: GIT_ASYNC_UNTRIED,
        seen_detect_result: git.GIT_OK,
        scroll: 0,
        saved_buffer_id: 0,
        viewer_buffer_id: 0,
        commit_buffer_id: 0,
        pending_job: 0,
        seen_result_job: 0,
        mutation_snapshot_gen: 0,
        pending_view: false,
        mutation_snapshot_pending: false,
        commit_editing: false,
        commit_amend: false,
        commit_cancel_pending: false,
        commit_comment: 0,
        commit_win_id: 0,
        commit_saved_win_id: 0,
        prompt_action: FUSS_PROMPT_NONE,
        prompt_path: "",
        has_prompt_path: false,
        prompt_untracked: false,
        pending_pick: FUSS_PICK_NONE,
        picker_action: FUSS_PICK_NONE,
        picker_items: List[PickItem](),
        picker_values: List[str](),
        picker_aux: "",
        has_picker_aux: false,
        picker_aux2: "",
        has_picker_aux2: false,
        picker_alt: false,
        preview_job: 0,
        preview_value: "",
        has_preview_value: false,
        preview_bytes: List[byte](),
        preview_ready: false,
        files: ws.filelist_new(),
        walk: w0,
        has_walk: false,
        expand_walk: w1,
        has_expand_walk: false,
        expand_path: List[byte](),
        has_expand_path: false,
        rebase_step: 0,
        rebase_total: 0,
        paths: util.interner_new(),
    }
}

// ------------------------------------------------------------------
// The jump (`fussmode.c:300-418`)
// ------------------------------------------------------------------

/// `yew_fuss_jump_init` (`fussmode.c:311-317`).
pub fn fuss_jump_init(mut f: FussMode) {
    typejump_clear(mut f.jump)
    f.jump_armed = false
    f.jump_deadline_ms = 0
}

/// `yew_fuss_jump_arm` (`fussmode.c:319-326`): an empty 500 ms window.
pub fn fuss_jump_arm(mut f: FussMode, now: int) {
    typejump_clear(mut f.jump)
    f.jump_armed = true
    f.jump_deadline_ms = now + TYPEJUMP_RESET_MS
}

// `fuss_jump_printable` (`fussmode.c:328-338`): Space expands or
// collapses the selected directory; every other ordinary printable byte
// can occur in a filename and belongs to type-to-jump.
fn fuss_jump_printable(key: term.Key) -> bool {
    if key.text.len != 1 {
        return false
    }
    let mods = term.MOD_CTRL | term.MOD_ALT | term.MOD_SUPER | term.MOD_HYPER | term.MOD_META
    if key.mods & mods != 0 {
        return false
    }
    key.text[0] as int > 32 && key.text[0] as int != 127
}

/// `yew_fuss_jump_key` (`fussmode.c:340-398`): the jump's own engine over
/// `labels` (the visible rows' paths), path-mode ranked; answers
/// (consumed, the new selection).
pub fn fuss_jump_key(
    mut f: FussMode,
    key: term.Key,
    now: int,
    labels: List[List[byte]],
    sel_in: int,
) -> (bool, int) {
    var sel = sel_in
    var printable = fuss_jump_printable(key)
    let n = labels.len
    if key.code == term.KEY_BACKSPACE {
        if !f.jump_armed {
            return (false, sel)
        }
        if f.jump.len != 0 {
            f.jump.len -= 1
        }
        f.jump.pat[f.jump.len] = 0 as byte
        f.jump_deadline_ms = now + TYPEJUMP_RESET_MS
        f.jump.deadline_ms = f.jump_deadline_ms
        if f.jump.len == 0 || n == 0 || sel < 0 {
            return (true, sel)
        }
        printable = false
    }
    if !printable {
        if key.code != term.KEY_BACKSPACE {
            fuss_jump_init(mut f)
            return (false, sel)
        }
    } else {
        if !f.jump_armed {
            fuss_jump_arm(mut f, now)
        }
        if f.jump.len == 0 || now >= f.jump_deadline_ms {
            f.jump.len = 0
        }
        if f.jump.len + 1 < TYPEJUMP_PAT_MAX {
            f.jump.pat[f.jump.len] = key.text[0]
            f.jump.len += 1
            f.jump.pat[f.jump.len] = 0 as byte
        }
        f.jump_deadline_ms = now + TYPEJUMP_RESET_MS
        f.jump.deadline_ms = f.jump_deadline_ms
    }
    if n == 0 || sel < 0 {
        return (true, sel)
    }
    if sel < n {
        let here = ws.fz_score(f.jump.pat, 0, f.jump.len, labels[sel], 0, labels[sel].len)
        if here >= 10000 {
            return (true, sel)
        }
    }
    let ranked = ws.fz_rank(f.jump.pat, 0, f.jump.len, labels, true)
    if ranked.len != 0 {
        sel = ranked[0].idx
    }
    (true, sel)
}

/// `yew_fuss_jump_tick` (`fussmode.c:400-406`): the window self-clears.
pub fn fuss_jump_tick(mut f: FussMode, now: int) -> bool {
    if !f.jump_armed || now < f.jump_deadline_ms {
        return false
    }
    fuss_jump_init(mut f)
    true
}

/// `yew_fuss_jump_armed` (`fussmode.c:408-411`).
pub fn fuss_jump_armed(f: FussMode) -> bool {
    f.jump_armed
}

/// `yew_fuss_jump_pattern` (`fussmode.c:413-418`): the typed bytes.
pub fn fuss_jump_pattern(f: FussMode) -> List[byte] {
    var out = List[byte]()
    var i = 0
    while i < f.jump.len && i < f.jump.pat.len {
        (mut out).push(f.jump.pat[i])
        i += 1
    }
    out
}

// ------------------------------------------------------------------
// Damage, rows, the selection
