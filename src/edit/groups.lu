//! edit.groups — the half of sagitta's tab-group model the tab strip
//! asks, before Sprint 24 lands.
//!
//! Ports the readers of sagitta `src/ui/groups.c` (507 lines) at 9ace98c2
//! that `src/ui/tabs.c` calls — `yew_active_group_id`, the COMPUTED
//! `yew_group_member_count` and `yew_group_members`, and
//! `yew_group_remove_member`'s ordinal compaction — because membership
//! lives on the TAB (`Tab.group_id`, `Tab.group_ordinal`, `groups.h:4-
//! 20`) and every one of them is a question about the tabs array. The
//! group VALUES (the label, the dir, the resume path), their creation,
//! dissolution and every `ed.group.*` command are Sprint 24's and the
//! groups fork's (yw05): until it lands nothing can set a `group_id`, so
//! the paths that need a group value are unreachable and refuse by name
//! if ever reached (invariant 3), never answering a guess.

fn groups_unported(what: str) {
    bug("not yet ported: {what}: sagitta Sprint 24 (tab groups) (yw05)")
}

/// `yew_active_group_id` (`groups.c:305-311`): DERIVED from the active
/// tab, never stored.
pub fn active_group_id(ed: Ed) -> int {
    if ed.tab_active < 0 || ed.tab_active >= ed.tabs.len {
        return 0
    }
    ed.tabs[ed.tab_active].group_id
}

/// `yew_group_member_count` (`groups.c:134-147`): counted, never
/// remembered.
pub fn group_member_count(ed: Ed, gid: int) -> int {
    if gid == 0 {
        return 0
    }
    var n = 0
    for t in ed.tabs {
        if t.group_id == gid {
            n += 1
        }
    }
    n
}

/// `yew_group_members` (`groups.c:167-195`): the member tab indices
/// ordered by ordinal — SORTED, not indexed (mid-removal the ordinals
/// have a hole), stably, so equal ordinals keep array order (invariant
/// 5). C caps the scan at `YEW_TAB_MAX` refs, which the tab cap makes the
/// whole array.
pub fn group_members(ed: Ed, gid: int) -> List[int] {
    var out = List[int]()
    if gid == 0 {
        return out
    }
    var ords = List[int]()
    var i = 0
    while i < ed.tabs.len {
        if ed.tabs[i].group_id == gid {
            // A stable insertion: past every entry whose ordinal is not
            // greater (`yew_sort_stable`'s order for `member_cmp`).
            let ord = ed.tabs[i].group_ordinal
            var at = out.len
            while at > 0 && ords[at - 1] > ord {
                at -= 1
            }
            (mut out).push(i)
            (mut ords).push(ord)
            var j = out.len - 1
            while j > at {
                out[j] = out[j - 1]
                ords[j] = ords[j - 1]
                j -= 1
            }
            out[at] = i
            ords[at] = ord
        }
        i += 1
    }
    out
}

/// `yew_group_remove_member` (`groups.c:229-257`): the tab leaves its
/// group and the ordinals above the vacated one compact; an emptied group
/// auto-dissolves (`yew_group_dissolve`, the group value's — Sprint 24).
/// Tab close calls this BEFORE the array compaction, while `idx` still
/// names the right tab.
pub fn group_remove_member(mut ed: Ed, idx: int) {
    if idx < 0 || idx >= ed.tabs.len || ed.tabs[idx].group_id == 0 {
        return
    }
    let gid = ed.tabs[idx].group_id
    let vacated = ed.tabs[idx].group_ordinal
    ed.tabs[idx].group_id = 0
    ed.tabs[idx].group_ordinal = 0
    var i = 0
    while i < ed.tabs.len {
        if ed.tabs[i].group_id == gid && ed.tabs[i].group_ordinal > vacated {
            ed.tabs[i].group_ordinal -= 1
        }
        i += 1
    }
    if group_member_count(ed, gid) == 0 {
        groups_unported("yew_group_dissolve")
    }
}

/// `yew_group_label` (`groups.c:289-303`): "label (N)" — the group
/// value's label (Sprint 24); unreachable while no group exists.
pub fn group_label(ed: Ed, gid: int) -> str {
    if gid == 0 {
        return ""
    }
    groups_unported("yew_group_label")
    ""
}

/// `yew_group_note_position` (`groups.c:482-496`): records the active
/// tab's path as its group's resume point; nothing when ungrouped.
pub fn group_note_position(ed: Ed) {
    let gid = active_group_id(ed)
    if gid == 0 {
        return
    }
    groups_unported("yew_group_note_position")
}

/// `yew_group_enter` (`groupnav.c`): entering a group at its resume
/// member — Sprint 24's; reached only through a negative strip payload,
/// which no row-1 entry carries while no group exists.
pub fn group_enter(ed: Ed, gid: int) {
    groups_unported("yew_group_enter of group {gid}")
}
