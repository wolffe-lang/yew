//! edit.region — the clickable-region registry.
//!
//! Ports sagitta `src/ui/region.c` (147 lines) and `region.h` (129) at
//! 9ace98c2 whole, under `s22-layout-panes.md` §6: ONE SOURCE OF TRUTH
//! for mapping screen cells to meaning — render passes populate it with
//! the same `Rect` they drew, the input path queries it, nothing else
//! maps a cell to a thing. yw04 ported its core for the menu's rows
//! (ruling R-yw04-2 = A); yw05 widens it to every kind (`region.h:20-89`,
//! C's enum numbering kept). C's registry is a file static; the port's is
//! a VALUE the editor owns (`Ed.regions`, the threaded-value idiom of
//! `docs/MAP.md` §1), cleared at frame BEGIN and rebuilt by the draw that
//! paints the regions (`region.c:18-31`).
//!
//! Storage: frame_begin keeps the rows' list and overwrites it in place
//! (a `List` replaced inside the session-long `Ed` would be held to the
//! session's end, G33), so a frame registers without allocating once the
//! list has grown to its high-water mark.

use util

/// No region (`YEW_REGION_NONE`).
pub const REGION_NONE: int = 0

/// A pane's leaf; payload: its index in the frame's leaf table
/// (`YEW_REGION_PANE`).
pub const REGION_PANE: int = 1

/// A split's border; payload: its index in the frame's split table.
pub const REGION_PANE_BORDER: int = 2

/// A tab-strip entry (s23/s24). THE PAYLOAD SIGN CONVENTION
/// (`region.h:28-37`), documented here once so the click router and the
/// renderer cannot invent it twice: `payload >= 0` is a tab index,
/// `payload < 0` is a group id, negated.
pub const REGION_TAB: int = 3

/// A strip scroll chevron; payload `+1` scrolls right, `-1` left.
pub const REGION_TAB_SCROLL: int = 4

/// Row one's ` + ` new-tab action (s57.8); payload unused.
pub const REGION_TAB_NEW: int = 5

/// Inert: owns its rectangle and means nothing (`YEW_REGION_BLOCK`): a
/// click on it never falls through to what lies beneath.
pub const REGION_BLOCK: int = 6

/// The group picker's name field (s24 §4).
pub const REGION_GP_NAME: int = 7

/// A group-picker listing row; payload: its index in the listing.
pub const REGION_GP_ROW: int = 8

/// A menu row; the payload is the row's index in the menu's CURRENT
/// items (`YEW_REGION_MENU_ROW`, `region.h:51-57`).
pub const REGION_MENU_ROW: int = 9

/// A completion-popup item (s44): its index in the focused window's open
/// completion.
pub const REGION_COMPL_ROW: int = 10

/// A picker row (s26 §5); payload: the item's PAYLOAD, never the row.
pub const REGION_PICK_ROW: int = 11

/// A context-menu row (s27 §5); payload: the row's index in the OPEN menu
/// (never the menu's target, captured at open time).
pub const REGION_CTX_ROW: int = 12

/// A FUSS tree row (s52); payload: the item's interned path id.
pub const REGION_FUSS_ROW: int = 13

/// A frame with this many regions is a rendering bug (`YEW_REGION_MAX`).
pub const REGION_MAX: int = 256

/// One clickable rectangle (`Region`, `region.h:91-95`).
pub struct Region {
    kind: int,
    rect: Rect,
    payload: int,
}

/// The registry (`region.c:10-16`'s static): `rows[0..len)` are this
/// frame's.
pub struct Regions {
    rows: List[Region],
    len: int,
    empty_queries: int,
    warned_full: bool,
    frozen: bool,
}

/// An empty registry.
pub fn regions_new() -> Regions {
    Regions { rows: List[Region](), len: 0, empty_queries: 0, warned_full: false, frozen: false }
}

fn region_none() -> Region {
    Region { kind: REGION_NONE, rect: rect(0, 0, 0, 0), payload: 0 }
}

/// `yew_region_frame_begin` (`region.c:18-31`): cleared at frame BEGIN,
/// never at its end, so a frame that bails early leaves no stale table.
pub fn region_frame_begin(mut rs: Regions) {
    rs.len = 0
    rs.warned_full = false
}

/// `yew_region_add` (`region.c:33-55`): a collapsed rectangle is not
/// clickable; past `REGION_MAX` the rest drop with one warning a frame.
pub fn region_add(mut rs: Regions, kind: int, r: Rect, payload: int) {
    if r.w <= 0 || r.h <= 0 {
        return
    }
    if rs.len >= REGION_MAX {
        if !rs.warned_full {
            util.log_warn("region table full at {REGION_MAX} entries; dropping the rest")
            rs.warned_full = true
        }
        return
    }
    let row = Region { kind: kind, rect: copy r, payload: payload }
    if rs.len < rs.rows.len {
        rs.rows[rs.len] = row
    } else {
        (mut rs.rows).push(row)
    }
    rs.len += 1
}

/// `yew_region_remove_kind` (`region.c:57-71`).
pub fn region_remove_kind(mut rs: Regions, kind: int) {
    var write = 0
    var read = 0
    while read < rs.len {
        if rs.rows[read].kind != kind {
            if write != read {
                rs.rows[write] = copy rs.rows[read]
            }
            write += 1
        }
        read += 1
    }
    rs.len = write
}

/// `yew_region_remove_rect` (`region.c:73-89`): for a kind several
/// overlays share (`REGION_BLOCK`), only the entries owning exactly `r`.
pub fn region_remove_rect(mut rs: Regions, kind: int, r: Rect) {
    var write = 0
    var read = 0
    while read < rs.len {
        let q = copy rs.rows[read].rect
        let same = rs.rows[read].kind == kind &&
            q.x == r.x &&
            q.y == r.y &&
            q.w == r.w &&
            q.h == r.h
        if !same {
            if write != read {
                rs.rows[write] = copy rs.rows[read]
            }
            write += 1
        }
        read += 1
    }
    rs.len = write
}

/// `yew_region_freeze` (`region.c:91-94`).
pub fn region_freeze(mut rs: Regions, on: bool) {
    rs.frozen = on
}

/// `yew_region_frozen` (`region.c:96-99`).
pub fn region_frozen(rs: Regions) -> bool {
    rs.frozen
}

/// `yew_region_hit` (`region.c:101-136`): the LAST region added that
/// contains the cell wins an overlap; none answers `REGION_NONE`. A hit
/// while frozen is the bug C aborts on (Sprint 27 §5).
pub fn region_hit(mut rs: Regions, x: int, y: int) -> Region {
    if rs.frozen {
        util.bug(
            "edit.region",
            "region hit-test during a context-menu action: the menu's target is captured at open time (Sprint 27 §5)",
        )
    }
    if rs.len == 0 {
        rs.empty_queries += 1
        return region_none()
    }
    region_find(rs, x, y)
}

/// `yew_region_hit`'s lookup for a reader that holds the registry
/// read-only — `yew_mouse_deadline` takes a `const Ed` (`mouse.c:2738`),
/// which C's file-static table does not need to know about. The same
/// answer (last added wins), without counting an empty query.
pub fn region_find(rs: Regions, x: int, y: int) -> Region {
    var i = rs.len
    while i > 0 {
        let r = copy rs.rows[i - 1].rect
        if x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h {
            return copy rs.rows[i - 1]
        }
        i -= 1
    }
    region_none()
}

/// `yew_region_count` (`region.c:138-141`).
pub fn region_count(rs: Regions) -> int {
    rs.len
}

/// `yew_region_empty_queries` (`region.c:143-146`).
pub fn region_empty_queries(rs: Regions) -> int {
    rs.empty_queries
}
