//! edit.mode — the seven modes and their descriptors.
//!
//! Ports sagitta `src/edit/mode.c` (175 lines) and `mode.h` (37) at
//! 9ace98c2, under `s14-modes-L-I.md` (the Esc law) and
//! `s17-mode-H-multicursor.md` (H's mode memory), with the Fletch mode
//! hooks (yw09). The shadow dismissals (yw11) and F mode (yw13) are later
//! campaigns'; job output's Esc dismissal is yw04's.

use fl
use text

/// L, line (`Mode`, `mode.h:10-19`).
pub const MODE_L: int = 0

/// W, word.
pub const MODE_W: int = 1

/// B, block.
pub const MODE_B: int = 2

/// H, highlight.
pub const MODE_H: int = 3

/// I, insert.
pub const MODE_I: int = 4

/// E, execute (the command line).
pub const MODE_E: int = 5

/// F, FUSS (campaign 11's).
pub const MODE_F: int = 6

/// The mode count (`YEW_MODE__N`).
pub const MODE_N: int = 7

/// `yew_modes[].name` (`mode.c:27-35`).
pub fn mode_name(m: int) -> str {
    match m {
        0 => "L",
        1 => "W",
        2 => "B",
        3 => "H",
        4 => "I",
        5 => "E",
        6 => "F",
        _ => "?",
    }
}

/// `yew_modes[].long_name`.
pub fn mode_long_name(m: int) -> str {
    match m {
        0 => "line",
        1 => "word",
        2 => "block",
        3 => "highlight",
        4 => "insert",
        5 => "execute",
        6 => "fuss",
        _ => "?",
    }
}

/// `yew_modes[].is_unit`: L, W and B.
pub fn mode_is_unit(m: int) -> bool {
    m == MODE_L || m == MODE_W || m == MODE_B
}

/// `yew_modes[].takes_count`: L, W, B and H.
pub fn mode_takes_count(m: int) -> bool {
    m == MODE_L || m == MODE_W || m == MODE_B || m == MODE_H
}

/// The mode named by a one-letter string (`ed.mode.enter`'s `sarg`).
pub fn mode_of_name(s: str) -> int {
    var m = 0
    while m < MODE_N {
        if mode_name(m) == s {
            return m
        }
        m += 1
    }
    -1
}

// `mode_transition` (`mode.c:15-25`): mode.leave, the switch, mode.enter.
fn mode_transition(mut ed: Ed, mode: int) {
    let old = ed.mode
    if old == mode {
        return
    }
    ed_hook_mode(mut ed, fl.FL_EV_MODE_LEAVE, mode_name(old))
    dispatch_set_mode(mut ed, mode)
    ed_hook_mode(mut ed, fl.FL_EV_MODE_ENTER, mode_name(mode))
}

/// `yew_mode_enter_execute` (`mode.c:37-48`): the `:` prompt, seeded.
pub fn mode_enter_execute(mut ed: Ed, seed: str) -> int {
    if ed.mode == MODE_I {
        ed_insert_barrier(mut ed)
    }
    cmdline_open(mut ed, PROMPT_CMD, seed)
    CMD_OK
}

fn clamp_cursors(mut ed: Ed) {
    if ed.win < 0 {
        return
    }
    let w = ed.win
    let b = ed.wins[w].buf
    var i = 0
    while i < ed.wins[w].cs.curs.len {
        text.cursor_clamp(ed.bufs[b].ec.tb, mut ed.wins[w].cs.curs[i])
        i += 1
    }
}

/// `yew_mode_enter` (`mode.c:50-104`): H keeps the unit it came from (I
/// counts as the char unit); E opens the prompt, seeded with `'<,'>` from
/// an H selection; leaving I closes its undo run and clamps the cursors;
/// F enters through the FUSS drawer, and leaving F closes it.
pub fn mode_enter(mut ed: Ed, mode: int) -> int {
    if mode < 0 || mode >= MODE_N {
        return CMD_ERR_ARG
    }
    if mode == MODE_H {
        let unit = if ed.mode == MODE_I then MODE_I else ed.prev_unit
        return mode_enter_highlight(mut ed, unit, false)
    }
    if mode == MODE_E {
        var seed = ""
        if ed.mode == MODE_H && ed.win >= 0 && ed.wins[ed.win].cs.curs.len != 0 {
            let p = ed.wins[ed.win].cs.primary
            if ed.wins[ed.win].cs.curs[p].anchor != ed.wins[ed.win].cs.curs[p].pos {
                seed = "'<,'>"
            }
        }
        return mode_enter_execute(mut ed, seed)
    }
    if mode == MODE_F {
        let status = fuss_mode_enter(mut ed)
        if status != CMD_OK {
            return status
        }
    } else if ed.mode == MODE_F {
        fuss_mode_leave(mut ed)
    }
    if ed.mode == MODE_I && mode != MODE_I {
        ed_insert_barrier(mut ed)
        clamp_cursors(mut ed)
    }
    if mode_is_unit(mode) {
        ed.prev_unit = mode
    }
    mode_transition(mut ed, mode)
    ed.footer_dirty = true
    CMD_OK
}

/// `yew_mode_enter_highlight` (`mode.c:106-138`): H over `unit`'s engine,
/// its motion keys installed.
pub fn mode_enter_highlight(mut ed: Ed, unit: int, sticky: bool) -> int {
    if ed.win < 0 {
        return CMD_ERR_STATE
    }
    let kind = if unit == MODE_I then UNIT_CHAR else unit_of_mode(unit)
    if kind == UNIT_NONE {
        return CMD_ERR_ARG
    }
    if ed.mode == MODE_I {
        ed_insert_barrier(mut ed)
        clamp_cursors(mut ed)
    }
    let w = ed.win
    ed.wins[w].h.from = unit
    ed.wins[w].h.unit = kind
    ed.wins[w].h.kind = SEL_CHAR
    ed.wins[w].h.sticky = sticky
    keys_highlight_install(mut ed, unit)
    mode_transition(mut ed, MODE_H)
    ed.footer_dirty = true
    CMD_OK
}

/// `yew_mode_escape` (`mode.c:130-175`), the Esc law: a chord first, then
/// the command line, then a prompt, then an H selection — each wins its
/// own press — then a focused job output, which Escape retires (a VIEW,
/// not a mode: it returns without entering L), and only then L.
pub fn mode_escape(mut ed: Ed) -> int {
    var handled = false
    ed.chord.n = 0
    ed.chord.layer = -1
    ed.chord.count = 0
    ed.chord.count_given = false
    ed.chord.deadline = 0
    if ed.cmdline.active {
        cmdline_close(mut ed, false)
        return CMD_OK
    }
    if ed.prompt != PROMPT_NONE {
        ed.prompt = PROMPT_NONE
        ed_msg_clear(mut ed)
        handled = true
    }
    if ed.mode == MODE_H && ed.win >= 0 && ed.wins[ed.win].cs.curs.len != 0 {
        handled = true
        let w = ed.win
        var i = 0
        while i < ed.wins[w].cs.curs.len {
            ed.wins[w].cs.curs[i].anchor = ed.wins[w].cs.curs[i].pos
            i += 1
        }
        text.cset_remove_all_but_primary(mut ed.wins[w].cs)
        selstack_clear(mut ed.wins[w])
        ed_damage_document(mut ed)
    }
    if !handled && shell_dismiss_output(mut ed) {
        return CMD_OK
    }
    mode_enter(mut ed, MODE_L)
}
