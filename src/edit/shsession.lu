//! edit.shsession — the persistent shell session (Sprint 57.27), as far as
//! wolf 0.2.33 lets it run: not at all.
//!
//! Ports the queries of sagitta `src/edit/shsession.c` (1,187 lines) and
//! `shsession.h` (126) at 9ace98c2 that the rest of the editor asks. The
//! session is one long-lived `$SHELL -s` per editor, a FRAMED job whose
//! output pipe the loop reads while it paints (`shsession.h:4-19`); at
//! 0.2.33 there is no wait over the tty and N job pipes (G2,
//! wolf-lang#795), so the session STOPs by name (ruling R-yw04-1) and
//! every query answers what C answers with no session state
//! (`shsession.h:93-99`): the workspace root and the process environment.

/// `shell.session` is `persistent` (`session_persistent`,
/// `shsession.c:117-125`; C's default `YEW_SHELL_SESSION_DEFAULT`,
/// `option.c:117-119`): the literal option store until yw09.
pub fn shsession_persistent(ed: Ed) -> bool {
    let v = ed.opts.store["shell.session"] else "persistent"
    v != "fresh"
}

/// `yew_shsession_busy` (`shsession.c:172-176`): no session ever runs.
pub fn shsession_busy(ed: Ed) -> bool {
    let _ = ed.win
    false
}

/// `yew_shsession_cwd` (`shsession.c:178-186`): with no session state,
/// the workspace root.
pub fn shsession_cwd(ed: Ed) -> str {
    shell_ws_root(ed)
}

/// `yew_shsession_run` (`shsession.c`): the session's frame is a job
/// whose pipes are read while the loop runs — the refusal (R-yw04-1).
pub fn shsession_run_refusal() -> str {
    job_stop_g2("the persistent shell session")
}
