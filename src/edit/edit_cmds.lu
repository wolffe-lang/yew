//! edit.edit_cmds — the editing and motion commands.
//!
//! Ports sagitta `src/edit/edit_cmds.c` (2,248 lines) and `edit_cmds.h`
//! (94) at 9ace98c2, under `s14`–`s17`. C's handlers resolve `cx->win`,
//! its buffer's `TextBuf` and a cursor POINTER (`edit_window_at`,
//! `edit_cmds.c:26-56`); the port resolves the window, buffer and cursor
//! INDICES (`ew`) and reaches the cursor as `ed.wins[w].cs.curs[c]`, so a
//! command that edits and then moves its caret re-reads it by index, as C
//! re-fetches its pointer. Every edit goes through the seam
//! (`ed_edit_insert`/`ed_edit_delete`, `ed.lu`). The options C reads from
//! the option store (`autoindent`, `autopair`, `expandtab`, `tabwidth`)
//! come from `ed.opts` until the store lands (yw09).

use text

// `edit_window_at` (`edit_cmds.c:26-56`): (ok, window, buffer, cursor).
fn ew(ed: Ed, cx: CmdCtx) -> (bool, int, int, int) {
    let w = cx.win
    if w < 0 || w >= ed.wins.len {
        return (false, 0, 0, 0)
    }
    let b = ed.wins[w].buf
    if b < 0 ||
        !ed.bufs[b].resident ||
        ed.wins[w].cs.curs.len == 0 ||
        ed.wins[w].cs.primary >= ed.wins[w].cs.curs.len {
        return (false, 0, 0, 0)
    }
    var ci = if cx.cursor_given then cx.cursor_index else ed.wins[w].cs.primary
    if cx.cursor_given {
        if ci >= ed.wins[w].cs.curs.len {
            return (false, 0, 0, 0)
        }
    } else if ed.wins[w].cs.active != text.MC_ACTIVE_NONE {
        if cx.cursor_index >= ed.wins[w].cs.curs.len || cx.cursor_index != ed.wins[w].cs.active {
            return (false, 0, 0, 0)
        }
        ci = cx.cursor_index
    }
    (true, w, b, ci)
}

fn tabw(ed: Ed, b: int) -> int {
    if ed.bufs[b].tabwidth != 0 then ed.bufs[b].tabwidth else VP_TABWIDTH
}

// `damage_offsets` (`edit_cmds.c:63-101`): the FOCUSED window's rows
// between two offsets, as C's reads `ed->win`.
fn damage_offsets(mut ed: Ed, first: int, second: int) {
    if ed.win < 0 {
        return
    }
    if ed.damage_batching {
        ed_damage_document(mut ed)
        return
    }
    let w = ed.win
    let b = ed.wins[w].buf
    if !ed.bufs[b].resident {
        return
    }
    var lo = text.textbuf_line_of(
        ed.bufs[b].ec.tb,
        (if first < second then first else second) as text.ByteOff,
    ) as int
    var hi = text.textbuf_line_of(
        ed.bufs[b].ec.tb,
        (if first > second then first else second) as text.ByteOff,
    ) as int
    if ed.wins[w].vp.wrap {
        ed_damage_document(mut ed)
        return
    }
    let top = ed.wins[w].vp.top
    let bottom = vp_last_visible_line(mut ed.wins[w], ed.bufs[b].ec.tb)
    if hi < top || lo > bottom {
        return
    }
    if lo < top {
        lo = top
    }
    if hi > bottom {
        hi = bottom
    }
    let (ok1, rlo) = vp_row_of_line(mut ed.wins[w], ed.bufs[b].ec.tb, lo, 0)
    let (ok2, rhi) = vp_row_of_line(mut ed.wins[w], ed.bufs[b].ec.tb, hi, 0)
    if !ok1 || !ok2 {
        return
    }
    ed_damage_rows(mut ed, rlo, rhi + 1)
}

// `cursor_set_bounds` (`edit_cmds.c:103-123`).
fn cursor_set_bounds(cs: text.CursorSet) -> (int, int) {
    var lo = cs.curs[0].pos
    var hi = cs.curs[0].pos
    for c in cs.curs {
        if c.pos < lo {
            lo = c.pos
        }
        if c.anchor < lo {
            lo = c.anchor
        }
        if c.pos > hi {
            hi = c.pos
        }
        if c.anchor > hi {
            hi = c.anchor
        }
    }
    (lo, hi)
}

// `cursor_place` (`edit_cmds.c:133-139`).
fn place(mut ed: Ed, w: int, c: int, pos: int) {
    ed.wins[w].cs.curs[c].pos = pos
    ed.wins[w].cs.curs[c].anchor = pos
    ed.wins[w].cs.curs[c].goal_col = text.CCOL_HERE
}

// `finish_direct_motion` (`edit_cmds.c:141-151`): H keeps its anchor.
fn finish_direct(mut ed: Ed, w: int, c: int, anchor: int, old_pos: int) {
    if ed.mode != MODE_H {
        return
    }
    ed.wins[w].cs.curs[c].anchor = anchor
    let pos = ed.wins[w].cs.curs[c].pos
    damage_offsets(mut ed, anchor, if old_pos < pos then old_pos else pos)
    damage_offsets(mut ed, anchor, if old_pos > pos then old_pos else pos)
}

fn follow(mut ed: Ed, w: int) {
    let b = ed.wins[w].buf
    vp_follow(mut ed.wins[w], ed.bufs[b].ec.tb)
}

fn ascii_blank_cluster(tb: text.TextBuf, at: int, next: int) -> bool {
    if next != at + 1 {
        return false
    }
    let b = text.textbuf_byte_at(tb, at)
    b == 32 || b == 9
}

// `move_vertical` (`edit_cmds.c:185-225`).
fn move_vertical(mut ed: Ed, cx: CmdCtx, down: bool, rows: int) -> int {
    let (ok, w, b, c) = ew(ed, cx)
    if !ok {
        return CMD_ERR_STATE
    }
    let anchor = ed.wins[w].cs.curs[c].anchor
    let old_pos = ed.wins[w].cs.curs[c].pos
    if ed.wins[w].vp.wrap {
        let amount = if down then rows else -rows
        let _ = vp_move_display(mut ed.wins[w], mut ed.bufs[b].ec.tb, amount)
    } else {
        let t = tabw(ed, b)
        var i = 0
        while i < rows {
            if down {
                text.cursor_down(ed.bufs[b].ec.tb, mut ed.wins[w].cs.curs[c], t)
            } else {
                text.cursor_up(ed.bufs[b].ec.tb, mut ed.wins[w].cs.curs[c], t)
            }
            i += 1
        }
    }
    if ed.mode == MODE_H {
        ed.wins[w].cs.curs[c].anchor = anchor
        let pos = ed.wins[w].cs.curs[c].pos
        damage_offsets(mut ed, anchor, if old_pos < pos then old_pos else pos)
        damage_offsets(mut ed, anchor, if old_pos > pos then old_pos else pos)
    }
    follow(mut ed, w)
    CMD_OK
}

/// `ed.move.buf.home` (`edit_cmds.c:227-239`).
pub fn ec_move_buf_home(mut ed: Ed, cx: CmdCtx) -> int {
    let (ok, w, _, c) = ew(ed, cx)
    if !ok {
        return CMD_ERR_STATE
    }
    text.cursor_buf_home(mut ed.wins[w].cs.curs[c])
    ed.wins[w].wrap_goal_valid = false
    follow(mut ed, w)
    CMD_OK
}

/// `ed.move.buf.end` (`edit_cmds.c:241-261`): with a count, that line.
pub fn ec_move_buf_end(mut ed: Ed, cx: CmdCtx) -> int {
    let (ok, w, b, c) = ew(ed, cx)
    if !ok {
        return CMD_ERR_STATE
    }
    if cx.count_given {
        let lines = text.textbuf_line_count(ed.bufs[b].ec.tb)
        let requested = if cx.count == 0 then 0 else cx.count - 1
        let line = if requested < lines then requested else lines - 1
        let start = text.textbuf_line_start(ed.bufs[b].ec.tb, line as text.LineNo) as int
        place(mut ed, w, c, start)
    } else {
        text.cursor_buf_end(ed.bufs[b].ec.tb, mut ed.wins[w].cs.curs[c])
    }
    ed.wins[w].wrap_goal_valid = false
    follow(mut ed, w)
    CMD_OK
}

/// `ed.move.line.home` (`edit_cmds.c:263-279`).
pub fn ec_move_line_home(mut ed: Ed, cx: CmdCtx) -> int {
    let (ok, w, b, c) = ew(ed, cx)
    if !ok {
        return CMD_ERR_STATE
    }
    let anchor = ed.wins[w].cs.curs[c].anchor
    let old_pos = ed.wins[w].cs.curs[c].pos
    text.cursor_line_home(ed.bufs[b].ec.tb, mut ed.wins[w].cs.curs[c])
    finish_direct(mut ed, w, c, anchor, old_pos)
    ed.wins[w].wrap_goal_valid = false
    follow(mut ed, w)
    CMD_OK
}

/// `ed.move.line.home_toggle` (`edit_cmds.c:312-338`): the first
/// non-blank, then column 0, then back; no memory of the last press.
pub fn ec_move_line_home_toggle(mut ed: Ed, cx: CmdCtx) -> int {
    let (ok, w, b, c) = ew(ed, cx)
    if !ok {
        return CMD_ERR_STATE
    }
    let pos = ed.wins[w].cs.curs[c].pos
    let ls = text.textbuf_line_span(
        ed.bufs[b].ec.tb,
        text.textbuf_line_of(ed.bufs[b].ec.tb, pos as text.ByteOff),
    )
    let info = indent_info(ed.bufs[b].ec.tb, ls, tabw(ed, b))
    let target = if info.blank || pos == info.first then ls.lo else info.first
    let anchor = ed.wins[w].cs.curs[c].anchor
    place(mut ed, w, c, target)
    finish_direct(mut ed, w, c, anchor, pos)
    ed.wins[w].wrap_goal_valid = false
    follow(mut ed, w)
    CMD_OK
}

/// `ed.move.line.end` (`edit_cmds.c:340-357`).
pub fn ec_move_line_end(mut ed: Ed, cx: CmdCtx) -> int {
    let (ok, w, b, c) = ew(ed, cx)
    if !ok {
        return CMD_ERR_STATE
    }
    let anchor = ed.wins[w].cs.curs[c].anchor
    let old_pos = ed.wins[w].cs.curs[c].pos
    text.cursor_line_end(mut ed.bufs[b].ec.tb, mut ed.wins[w].cs.curs[c])
    finish_direct(mut ed, w, c, anchor, old_pos)
    ed.wins[w].wrap_goal_valid = false
    follow(mut ed, w)
    CMD_OK
}

/// `ed.move.line.up` (`edit_cmds.c:359-362`).
pub fn ec_move_line_up(mut ed: Ed, cx: CmdCtx) -> int {
    move_vertical(mut ed, cx, false, 1)
}

/// `ed.move.line.down` (`edit_cmds.c:364-367`).
pub fn ec_move_line_down(mut ed: Ed, cx: CmdCtx) -> int {
    move_vertical(mut ed, cx, true, 1)
}

/// `ed.move.line.first_nonblank` (`edit_cmds.c:369-394`).
pub fn ec_move_line_first_nonblank(mut ed: Ed, cx: CmdCtx) -> int {
    let (ok, w, b, c) = ew(ed, cx)
    if !ok {
        return CMD_ERR_STATE
    }
    let line = text.textbuf_line_of(
        ed.bufs[b].ec.tb,
        ed.wins[w].cs.curs[c].pos as text.ByteOff,
    ) as int
    var pos = text.textbuf_line_start(ed.bufs[b].ec.tb, line as text.LineNo) as int
    let end = line_content_end(mut ed.bufs[b].ec.tb, line)
    while pos < end {
        let next = text.grapheme_next_boundary(ed.bufs[b].ec.tb, pos as text.ByteOff) as int
        if !ascii_blank_cluster(ed.bufs[b].ec.tb, pos, next) {
            break
        }
        pos = next
    }
    place(mut ed, w, c, pos)
    ed.wins[w].wrap_goal_valid = false
    follow(mut ed, w)
    CMD_OK
}

/// `ed.move.line.last_nonblank` (`edit_cmds.c:396-423`).
pub fn ec_move_line_last_nonblank(mut ed: Ed, cx: CmdCtx) -> int {
    let (ok, w, b, c) = ew(ed, cx)
    if !ok {
        return CMD_ERR_STATE
    }
    let line = text.textbuf_line_of(
        ed.bufs[b].ec.tb,
        ed.wins[w].cs.curs[c].pos as text.ByteOff,
    ) as int
    var pos = text.textbuf_line_start(ed.bufs[b].ec.tb, line as text.LineNo) as int
    let end = line_content_end(mut ed.bufs[b].ec.tb, line)
    var last = pos
    while pos < end {
        let next = text.grapheme_next_boundary(ed.bufs[b].ec.tb, pos as text.ByteOff) as int
        if !ascii_blank_cluster(ed.bufs[b].ec.tb, pos, next) {
            last = pos
        }
        pos = next
    }
    place(mut ed, w, c, last)
    ed.wins[w].wrap_goal_valid = false
    follow(mut ed, w)
    CMD_OK
}

/// `ed.move.line.half_page_up` (`edit_cmds.c:425-433`).
pub fn ec_move_line_half_page_up(mut ed: Ed, cx: CmdCtx) -> int {
    if cx.win < 0 {
        return CMD_ERR_STATE
    }
    let rows = ed.wins[cx.win].vp.rows / 2
    move_vertical(mut ed, cx, false, if rows == 0 then 1 else rows)
}

/// `ed.move.line.half_page_down` (`edit_cmds.c:435-443`).
pub fn ec_move_line_half_page_down(mut ed: Ed, cx: CmdCtx) -> int {
    if cx.win < 0 {
        return CMD_ERR_STATE
    }
    let rows = ed.wins[cx.win].vp.rows / 2
    move_vertical(mut ed, cx, true, if rows == 0 then 1 else rows)
}

fn view_page(mut ed: Ed, cx: CmdCtx, pages: int) -> int {
    if cx.win < 0 {
        return CMD_ERR_STATE
    }
    let w = cx.win
    let b = ed.wins[w].buf
    vp_page(mut ed.wins[w], ed.bufs[b].ec.tb, pages)
    vp_push_cursor(mut ed.wins[w], mut ed.bufs[b].ec.tb, tabw(ed, b))
    ed.full_damage = true
    CMD_OK
}

/// `ed.view.page_up` (`edit_cmds.c:445-453`).
pub fn ec_view_page_up(mut ed: Ed, cx: CmdCtx) -> int {
    view_page(mut ed, cx, -1)
}

/// `ed.view.page_down` (`edit_cmds.c:455-463`).
pub fn ec_view_page_down(mut ed: Ed, cx: CmdCtx) -> int {
    view_page(mut ed, cx, 1)
}

// `view_scroll` (`edit_cmds.c:465-473`).
fn view_scroll(mut ed: Ed, cx: CmdCtx, rows: int) -> int {
    if cx.win < 0 {
        return CMD_ERR_STATE
    }
    let w = cx.win
    let b = ed.wins[w].buf
    vp_scroll(mut ed.wins[w], ed.bufs[b].ec.tb, rows)
    vp_push_cursor(mut ed.wins[w], mut ed.bufs[b].ec.tb, tabw(ed, b))
    ed.full_damage = true
    CMD_OK
}

/// `ed.view.scroll_up`.
pub fn ec_view_scroll_up(mut ed: Ed, cx: CmdCtx) -> int {
    view_scroll(mut ed, cx, -1)
}

/// `ed.view.scroll_down`.
pub fn ec_view_scroll_down(mut ed: Ed, cx: CmdCtx) -> int {
    view_scroll(mut ed, cx, 1)
}

/// `ed.view.half_page_up` (`edit_cmds.c:485-493`).
pub fn ec_view_half_page_up(mut ed: Ed, cx: CmdCtx) -> int {
    if cx.win < 0 {
        return CMD_ERR_STATE
    }
    let rows = ed.wins[cx.win].vp.rows / 2
    view_scroll(mut ed, cx, if rows == 0 then -1 else -rows)
}

/// `ed.view.half_page_down` (`edit_cmds.c:495-503`).
pub fn ec_view_half_page_down(mut ed: Ed, cx: CmdCtx) -> int {
    if cx.win < 0 {
        return CMD_ERR_STATE
    }
    let rows = ed.wins[cx.win].vp.rows / 2
    view_scroll(mut ed, cx, if rows == 0 then 1 else rows)
}

/// `ed.view.center` (`edit_cmds.c:505-512`).
pub fn ec_view_center(mut ed: Ed, cx: CmdCtx) -> int {
    if cx.win < 0 {
        return CMD_ERR_STATE
    }
    let b = ed.wins[cx.win].buf
    vp_center(mut ed.wins[cx.win], ed.bufs[b].ec.tb)
    ed.full_damage = true
    CMD_OK
}

/// `ed.view.top` (`edit_cmds.c:514-521`).
pub fn ec_view_top(mut ed: Ed, cx: CmdCtx) -> int {
    if cx.win < 0 {
        return CMD_ERR_STATE
    }
    let b = ed.wins[cx.win].buf
    vp_top(mut ed.wins[cx.win], ed.bufs[b].ec.tb)
    ed.full_damage = true
    CMD_OK
}

/// `ed.view.bottom` (`edit_cmds.c:523-530`).
pub fn ec_view_bottom(mut ed: Ed, cx: CmdCtx) -> int {
    if cx.win < 0 {
        return CMD_ERR_STATE
    }
    let b = ed.wins[cx.win].buf
    vp_bottom(mut ed.wins[cx.win], ed.bufs[b].ec.tb)
    ed.full_damage = true
    CMD_OK
}

/// `ed.view.goto_line` (`edit_cmds.c:532-551`): the count's line,
/// centered.
pub fn ec_view_goto_line(mut ed: Ed, cx: CmdCtx) -> int {
    let (ok, w, b, c) = ew(ed, cx)
    if !ok {
        return CMD_ERR_STATE
    }
    let lines = text.textbuf_line_count(ed.bufs[b].ec.tb)
    var requested = if cx.count == 0 then 0 else cx.count - 1
    if requested >= lines {
        requested = lines - 1
    }
    let start = text.textbuf_line_start(ed.bufs[b].ec.tb, requested as text.LineNo) as int
    place(mut ed, w, c, start)
    ed.wins[w].wrap_goal_valid = false
    vp_center(mut ed.wins[w], ed.bufs[b].ec.tb)
    ed.full_damage = true
    CMD_OK
}

/// `ed.view.toggle_wrap` (`edit_cmds.c:553-566`).
pub fn ec_view_toggle_wrap(mut ed: Ed, cx: CmdCtx) -> int {
    if cx.win < 0 {
        return CMD_ERR_STATE
    }
    let w = cx.win
    let b = ed.wins[w].buf
    ed.wins[w].vp.wrap = !ed.wins[w].vp.wrap
    ed.wins[w].vp.left = 0
    ed.wins[w].vp.top_sub = 0
    ed.wins[w].wrap_goal_valid = false
    vp_invalidate(mut ed.wins[w])
    vp_clamp(mut ed.wins[w], ed.bufs[b].ec.tb)
    vp_follow(mut ed.wins[w], ed.bufs[b].ec.tb)
    ed.full_damage = true
    CMD_OK
}

/// `ed.view.number_style` (`edit_cmds.c:568-598`).
pub fn ec_view_number_style(mut ed: Ed, cx: CmdCtx) -> int {
    if cx.win < 0 || !cx.has_sarg {
        return CMD_ERR_ARG
    }
    let style = match cx.sarg {
        "none" => NUM_NONE,
        "abs" => NUM_ABS,
        "rel" => NUM_REL,
        "hybrid" => NUM_HYBRID,
        _ => -1,
    }
    if style < 0 {
        return CMD_ERR_ARG
    }
    ed.wins[cx.win].number_style = style
    ed.layout_dirty = true
    ed.full_damage = true
    CMD_OK
}

/// `ed.view.number_cycle` (`edit_cmds.c:600-610`): none, abs, rel, hybrid.
pub fn ec_view_number_cycle(mut ed: Ed, cx: CmdCtx) -> int {
    if cx.win < 0 {
        return CMD_ERR_STATE
    }
    ed.wins[cx.win].number_style = (ed.wins[cx.win].number_style + 1) % (NUM_HYBRID + 1)
    ed.layout_dirty = true
    ed.full_damage = true
    CMD_OK
}

/// `ed.ui.message_expand` (`edit_cmds.c:612-620`).
pub fn ec_message_expand(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    if !ed_msg_expand(mut ed) {
        return CMD_ERR_STATE
    }
    ed.full_damage = true
    CMD_OK
}

/// `ed.ui.cancel` (`edit_cmds.c:622-630`).
pub fn ec_ui_cancel(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    let _ = ed_msg_dismiss_overlay(mut ed)
    if ed.prompt != PROMPT_NONE {
        ed_prompt(mut ed, PROMPT_NONE)
    }
    CMD_OK
}

/// `ed.move.char.prev` (`edit_cmds.c:632-649`).
pub fn ec_move_char_prev(mut ed: Ed, cx: CmdCtx) -> int {
    let (ok, w, b, c) = ew(ed, cx)
    if !ok {
        return CMD_ERR_STATE
    }
    let anchor = ed.wins[w].cs.curs[c].anchor
    let old_pos = ed.wins[w].cs.curs[c].pos
    text.cursor_left(mut ed.bufs[b].ec.tb, mut ed.wins[w].cs.curs[c])
    finish_direct(mut ed, w, c, anchor, old_pos)
    ed.wins[w].wrap_goal_valid = false
    follow(mut ed, w)
    CMD_OK
}

/// `ed.move.char.next` (`edit_cmds.c:651-668`).
pub fn ec_move_char_next(mut ed: Ed, cx: CmdCtx) -> int {
    let (ok, w, b, c) = ew(ed, cx)
    if !ok {
        return CMD_ERR_STATE
    }
    let anchor = ed.wins[w].cs.curs[c].anchor
    let old_pos = ed.wins[w].cs.curs[c].pos
    text.cursor_right(ed.bufs[b].ec.tb, mut ed.wins[w].cs.curs[c])
    finish_direct(mut ed, w, c, anchor, old_pos)
    ed.wins[w].wrap_goal_valid = false
    follow(mut ed, w)
    CMD_OK
}

// `shift_highlight_begin` (`edit_cmds.c:670-692`).
fn shift_highlight_begin(mut ed: Ed, cx: CmdCtx) -> int {
    if cx.win < 0 || ed.wins[cx.win].cs.curs.len == 0 {
        return CMD_ERR_STATE
    }
    if ed.mode == MODE_H {
        return CMD_OK
    }
    var i = 0
    while i < ed.wins[cx.win].cs.curs.len {
        ed.wins[cx.win].cs.curs[i].anchor = ed.wins[cx.win].cs.curs[i].pos
        i += 1
    }
    mode_enter_highlight(mut ed, MODE_I, false)
}

// The motions `sel_extend` wraps (`edit_cmds.c:694-750`), by kind: C
// passes a function pointer.
fn extend_move(mut ed: Ed, cx: CmdCtx, which: int) -> int {
    match which {
        0 => ec_move_char_prev(mut ed, cx),
        1 => ec_move_char_next(mut ed, cx),
        2 => ec_move_line_up(mut ed, cx),
        3 => ec_move_line_down(mut ed, cx),
        4 => ec_move_word_prev(mut ed, cx),
        5 => ec_move_word_next(mut ed, cx),
        6 => ec_move_line_home(mut ed, cx),
        _ => ec_move_line_end(mut ed, cx),
    }
}

// `sel_extend` (`edit_cmds.c:694-711`): in the prompt the anchor is put
// back after the motion; elsewhere Shift enters H by character.
fn sel_extend(mut ed: Ed, cx: CmdCtx, which: int) -> int {
    if ed.cmdline.active &&
        cx.win == cmdline_target(ed) &&
        ed.wins[cx.win].cs.primary < ed.wins[cx.win].cs.curs.len {
        let p = ed.wins[cx.win].cs.primary
        let anchor = ed.wins[cx.win].cs.curs[p].anchor
        let status = extend_move(mut ed, cx, which)
        if p < ed.wins[cx.win].cs.curs.len {
            ed.wins[cx.win].cs.curs[p].anchor = anchor
        }
        return status
    }
    let status = shift_highlight_begin(mut ed, cx)
    if status == CMD_OK then extend_move(mut ed, cx, which) else status
}

