/// `ed.edit.delete.unit` (`edit_cmds.c:921-943`).
pub fn ec_delete_unit(mut ed: Ed, cx: CmdCtx) -> int {
    let (ok, w, b, c) = ew(ed, cx)
    if !ok {
        return CMD_ERR_STATE
    }
    if ed.mode == MODE_H {
        return sc_delete(mut ed, cx)
    }
    let kind = if ed.prev_unit == MODE_I then UNIT_CHAR else unit_of_mode(ed.mode)
    if kind == UNIT_NONE {
        return CMD_ERR_STATE
    }
    if kind == UNIT_LINE {
        return ec_delete_line(mut ed, cx)
    }
    let u = unitctx_of(ed, b)
    let sp = unit_span(kind, mut ed.bufs[b].ec.tb, u, ed.wins[w].cs.curs[c].pos, false)
    delete_span(mut ed, cx, sp)
}

// `move_block_match` (`edit_cmds.c:945-969`).
fn move_block_match(mut ed: Ed, cx: CmdCtx, next: bool) -> int {
    let (ok, w, b, c) = ew(ed, cx)
    if !ok {
        return CMD_ERR_STATE
    }
    let u = unitctx_of(ed, b)
    let anchor = ed.wins[w].cs.curs[c].anchor
    let old_pos = ed.wins[w].cs.curs[c].pos
    let (found, pos) = block_match(ed.bufs[b].ec.tb, u, old_pos, next)
    if !found {
        ed_msg(mut ed, MSG_INFO, "no enclosing delimiter")
        return CMD_OK
    }
    place(mut ed, w, c, pos)
    finish_direct(mut ed, w, c, anchor, old_pos)
    ed.wins[w].wrap_goal_valid = false
    follow(mut ed, w)
    CMD_OK
}

/// `ed.move.block.match_prev`.
pub fn ec_move_block_match_prev(mut ed: Ed, cx: CmdCtx) -> int {
    move_block_match(mut ed, cx, false)
}

/// `ed.move.block.match_next`.
pub fn ec_move_block_match_next(mut ed: Ed, cx: CmdCtx) -> int {
    move_block_match(mut ed, cx, true)
}

// `move_word_sub` (`edit_cmds.c:981-1011`).
fn move_word_sub(mut ed: Ed, cx: CmdCtx, next: bool) -> int {
    let (ok, w, b, c) = ew(ed, cx)
    if !ok {
        return CMD_ERR_STATE
    }
    let u = unitctx_of(ed, b)
    let anchor = ed.wins[w].cs.curs[c].anchor
    let old_pos = ed.wins[w].cs.curs[c].pos
    let pos = if next {
        word_sub_next(ed.bufs[b].ec.tb, u, old_pos)
    } else {
        word_sub_prev(mut ed.bufs[b].ec.tb, u, old_pos)
    }
    place(mut ed, w, c, pos)
    finish_direct(mut ed, w, c, anchor, old_pos)
    ed.wins[w].wrap_goal_valid = false
    follow(mut ed, w)
    CMD_OK
}

// `move_word` (`edit_cmds.c:1013-1035`): the word unit whatever the mode.
fn move_word(mut ed: Ed, cx: CmdCtx, next: bool) -> int {
    let (ok, w, b, c) = ew(ed, cx)
    if !ok {
        return CMD_ERR_STATE
    }
    let u = unitctx_of(ed, b)
    let anchor = ed.wins[w].cs.curs[c].anchor
    let old_pos = ed.wins[w].cs.curs[c].pos
    let pos = if next {
        unit_next(UNIT_WORD, mut ed.bufs[b].ec.tb, u, ed.wins[w], old_pos, false)
    } else {
        unit_prev(UNIT_WORD, mut ed.bufs[b].ec.tb, u, ed.wins[w], old_pos, false)
    }
    place(mut ed, w, c, pos)
    finish_direct(mut ed, w, c, anchor, old_pos)
    ed.wins[w].wrap_goal_valid = false
    follow(mut ed, w)
    CMD_OK
}

/// `ed.move.word.prev`.
pub fn ec_move_word_prev(mut ed: Ed, cx: CmdCtx) -> int {
    move_word(mut ed, cx, false)
}

/// `ed.move.word.next`.
pub fn ec_move_word_next(mut ed: Ed, cx: CmdCtx) -> int {
    move_word(mut ed, cx, true)
}

/// `ed.move.word.sub_prev`.
pub fn ec_move_word_sub_prev(mut ed: Ed, cx: CmdCtx) -> int {
    move_word_sub(mut ed, cx, false)
}

/// `ed.move.word.sub_next`.
pub fn ec_move_word_sub_next(mut ed: Ed, cx: CmdCtx) -> int {
    move_word_sub(mut ed, cx, true)
