fn unitctx_of(ed: Ed, b: int) -> UnitCtx {
    UnitCtx { has_buf: true, tabwidth: ed.bufs[b].tabwidth, has_lang: false, has_win: true }
}

// `move_unit` (`edit_cmds.c:762-859`): 0 next, 1 prev, 2 home, 3 end.
fn move_unit(mut ed: Ed, cx: CmdCtx, motion: int, alt: bool) -> int {
    let (ok, w, b, c) = ew(ed, cx)
    if !ok {
        return CMD_ERR_STATE
    }
    var kind = UNIT_NONE
    if ed.mode == MODE_H {
        kind = ed.wins[w].h.unit
    } else if ed.prev_unit == MODE_I && motion != 0 && motion != 1 {
        kind = UNIT_CHAR
    } else {
        kind = unit_of_mode(ed.mode)
    }
    if kind == UNIT_NONE {
        return CMD_ERR_STATE
    }
    let line_vertical = kind == UNIT_LINE && (motion == 0 || motion == 1)
    let t = tabw(ed, b)
    if line_vertical && !ed.wins[w].vp.wrap {
        ed.wins[w].cs.curs[c].goal_col = text.cursor_goal(
            ed.bufs[b].ec.tb,
            ed.wins[w].cs.curs[c],
            t,
        ) as int
    }
    let vertical_goal = ed.wins[w].cs.curs[c].goal_col
    let old_pos = ed.wins[w].cs.curs[c].pos
    let unselected = ed.wins[w].cs.curs[c].anchor == old_pos
    if line_vertical && ed.wins[w].vp.wrap && !ed.wins[w].wrap_goal_valid {
        ed.wins[w].wrap_goal = vp_display_col(ed.wins[w], ed.bufs[b].ec.tb, old_pos)
        ed.wins[w].wrap_goal_valid = true
    }
    let u = unitctx_of(ed, b)
    var pos = 0
    if motion == 0 {
        pos = unit_next(kind, mut ed.bufs[b].ec.tb, u, ed.wins[w], old_pos, alt)
    } else if motion == 1 {
        pos = unit_prev(kind, mut ed.bufs[b].ec.tb, u, ed.wins[w], old_pos, alt)
    } else if motion == 2 {
        pos = unit_home(kind, mut ed.bufs[b].ec.tb, u, old_pos, alt)
    } else {
        pos = unit_end(kind, mut ed.bufs[b].ec.tb, u, old_pos, alt)
    }
    if ed.mode == MODE_H {
        ed.wins[w].cs.curs[c].pos = pos
        ed.wins[w].cs.curs[c].goal_col = if line_vertical then vertical_goal else text.CCOL_HERE
        ed.wins[w].wrap_goal_valid = false
        let anchor = ed.wins[w].cs.curs[c].anchor
        damage_offsets(mut ed, anchor, if old_pos < pos then old_pos else pos)
        damage_offsets(mut ed, anchor, if old_pos > pos then old_pos else pos)
    } else if line_vertical {
        ed.wins[w].cs.curs[c].pos = pos
        if unselected {
            ed.wins[w].cs.curs[c].anchor = pos
        }
        ed.wins[w].cs.curs[c].goal_col = vertical_goal
        if !ed.wins[w].vp.wrap {
            ed.wins[w].wrap_goal_valid = false
        }
    } else {
        place(mut ed, w, c, pos)
        ed.wins[w].wrap_goal_valid = false
    }
    follow(mut ed, w)
    CMD_OK
}

/// `ed.move.unit.next`.
pub fn ec_move_unit_next(mut ed: Ed, cx: CmdCtx) -> int {
    move_unit(mut ed, cx, 0, false)
}

