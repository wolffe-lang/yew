//! edit.theme — the theme: a Fletch data file compiled to flat tables,
//! one per rendition.
//!
//! Ports sagitta `src/syn/theme.c` (1,087 lines) and `syn/theme.h` at
//! 9ace98c2 — the compile (`compile_document`, the palette with `@`
//! references and cycle detection, the ui roles, the 54 semantic attrs
//! with their parent fallback (`attr_parent`, `theme.c:61-116`), the five
//! renditions: truecolor, 256, 16, mono, dumb) and the selection by name
//! (`discover_path`) — and the editor half of `src/edit/theme_cmds.c`
//! (`active_rendition`, `yew_theme_sync_surfaces`, `yew_theme_load`).
//! Themes are campaign 08's (yw10) in the map; campaign 03 needs the
//! default theme's colours from its first frame (every golden's legend is
//! `quiver-dark`'s), so the compile lands here over `edit.fldata` (C walks
//! the Fletch AST, `fl_parse_literal`). The `ed.theme.*` commands and
//! `theme_auto` stay yw10's. The diagnostics are C's message text, the
//! first one kept (C's `capture_diag` keeps the first too).

use term

/// The rendition count (`YEW_THEME_RENDITION_COUNT`): truecolor, 256, 16,
/// mono, dumb.
pub const THEME_RENDITIONS: int = 5

/// Truecolor (`YewThemeRendition`).
pub const THEME_TRUECOLOR: int = 0

/// 256 colours.
pub const THEME_256: int = 1

/// 16 colours.
pub const THEME_16: int = 2

/// Monochrome (`NO_COLOR`).
pub const THEME_MONO: int = 3

/// `TERM=dumb`.
pub const THEME_DUMB: int = 4

/// The semantic attr count (`YEW_ATTR__COUNT`, `syn/attr.h`).
pub const ATTR_COUNT: int = 54

/// The plain-text attr (`YEW_ATTR_TEXT`).
pub const ATTR_TEXT: int = 0

/// The comment attr (`YEW_ATTR_COMMENT`).
pub const ATTR_COMMENT: int = 16

/// One compiled style (`ThemeEnt`).
pub struct ThemeEnt {
    fg: term.Color,
    bg: term.Color,
    attrs: int,
}

/// A ui role's five renditions (`ThemeUiRole`).
pub struct ThemeUiRole {
    name: str,
    tab: List[ThemeEnt],
}

/// A compiled theme (`Theme`, `theme.h:44-53`): `tab` is
/// `rendition * ATTR_COUNT + attr`; `ul` is `rendition * 3 + which` for
/// the three colour renditions.
pub struct Theme {
    tab: List[ThemeEnt],
    ul: List[term.Color],
    ui: List[ThemeUiRole],
    name: str,
    has_name: bool,
    explicit_attrs: int,
    kind: int,
}

/// No theme loaded (`yew_theme_init`).
pub fn theme_none() -> Theme {
    Theme {
        tab: List[ThemeEnt](),
        ul: List[term.Color](),
        ui: List[ThemeUiRole](),
        name: "",
        has_name: false,
        explicit_attrs: 0,
        kind: 0,
    }
}

fn ent_default() -> ThemeEnt {
    ThemeEnt { fg: term.color_default(), bg: term.color_default(), attrs: 0 }
}

// `attr_names` (`syn/defs.c`, the `SynAttr` order of `syn/attr.h`).
fn attr_names() -> str {
    "text keyword keyword.control keyword.op keyword.storage type type.builtin constant constant.builtin number boolean character string string.escape string.interp string.special comment comment.doc comment.todo function function.builtin function.macro method variable variable.builtin variable.param variable.member namespace label attribute preproc operator punct punct.bracket punct.delim tag tag.attr heading link emphasis strong code list quote diff.add diff.del error warning whitespace.special motion.unit motion.arrow motion.count motion.cmd ui.invisible"
}

/// `yew_syn_attr_id` (`syn/defs.c:240-254`): the attr named `name`, or -1.
pub fn theme_attr_id(name: str) -> int {
    var i = 0
    for n in attr_names().words() {
        if n == name {
            return i
        }
        i += 1
    }
    -1
}

/// `yew_syn_attr_parent` (`theme.c:61-120`).
pub fn theme_attr_parent(attr: int) -> int {
    // keyword.*: keyword; type.builtin: type; constant.builtin, number,
    // boolean: constant; character, string.*: string; comment.*: comment;
    // function.*, method: function; variable.*: variable; punct.*: punct;
    // tag.attr: tag; motion.unit: keyword; motion.arrow: operator;
    // motion.count: number; motion.cmd: function; the rest: text.
    match attr {
        2 => 1,
        3 => 1,
        4 => 1,
        6 => 5,
        8 => 7,
        9 => 7,
        10 => 7,
        11 => 12,
        13 => 12,
        14 => 12,
        15 => 12,
        17 => 16,
        18 => 16,
        20 => 19,
        21 => 19,
        22 => 19,
        24 => 23,
        25 => 23,
        26 => 23,
        33 => 32,
        34 => 32,
        36 => 35,
        49 => 1,
        50 => 31,
        51 => 9,
        52 => 19,
        _ => 0,
    }
}

// The compile's working state (`ThemeCompile`, `theme.c:44-52`).
struct Tc {
    error: str,
    pal_names: List[str],
    pal_nodes: List[int],
    pal_colors: List[term.Color],
    pal_state: List[int],
}

// `StyleSpec` (`theme.c:26-36`).
struct Style {
    fg: term.Color,
    fg_set: bool,
    bg: term.Color,
    bg_set: bool,
    c256: int,
    c16: int,
    attrs: int,
    mono: int,
    ul: int,
    mono_set: bool,
    present: bool,
}

fn style_new() -> Style {
    Style {
        fg: term.color_default(),
        fg_set: false,
        bg: term.color_default(),
        bg_set: false,
        c256: -1,
        c16: -1,
        attrs: 0,
        mono: 0,
        ul: 0,
        mono_set: false,
        present: false,
    }
}

fn diag(mut c: Tc, doc: FlDoc, n: int, what: str) {
    if c.error.len == 0 {
        if n >= 0 {
            c.error = "{doc.nodes[n].line}:{doc.nodes[n].col}: {what}"
        } else {
            c.error = what
        }
    }
}

fn hex_digit(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    -1
}

// `parse_hex` (`theme.c:274-295`).
fn parse_hex(mut c: Tc, doc: FlDoc, n: int, text: str) -> (bool, term.Color) {
    if text.len != 7 || text.bytes()[0] as int != 35 {
        diag(mut c, doc, n, "invalid theme colour '{text}'")
        return (false, term.color_default())
    }
    var h = List[int]()
    var i = 1
    while i < 7 {
        let d = hex_digit(text.bytes()[i] as int)
        if d < 0 {
            diag(mut c, doc, n, "invalid theme colour '{text}'")
            return (false, term.color_default())
        }
        (mut h).push(d)
        i += 1
    }
    (true, term.color_rgb(h[0] * 16 + h[1], h[2] * 16 + h[3], h[4] * 16 + h[5]))
}

// `palette_resolve` (`theme.c:311-329`).
fn palette_resolve(mut c: Tc, doc: FlDoc, i: int) -> (bool, term.Color) {
    if c.pal_state[i] == 2 {
        return (true, copy c.pal_colors[i])
    }
    if c.pal_state[i] == 1 {
        diag(mut c, doc, c.pal_nodes[i], "palette reference cycle at '{c.pal_names[i]}'")
        return (false, term.color_default())
    }
    c.pal_state[i] = 1
    let (ok, color) = color_value(mut c, doc, c.pal_nodes[i])
    if !ok {
        return (false, color)
    }
    c.pal_colors[i] = copy color
    c.pal_state[i] = 2
    (true, color)
}

// `color_value` (`theme.c:331-377`): `#rrggbb`, `@palette`, `{ idx: N }`
// or `none`.
fn color_value(mut c: Tc, doc: FlDoc, n: int) -> (bool, term.Color) {
    let k = fl_kind(doc, n)
    if k == FN_STR {
        let text = doc.nodes[n].text
        if text == "none" {
            return (true, term.color_default())
        }
        if text.len != 0 && text.bytes()[0] as int == 64 {
            let name = text[1..]
            var i = 0
            while i < c.pal_names.len {
                if c.pal_names[i] == name {
                    return palette_resolve(mut c, doc, i)
                }
                i += 1
            }
            diag(mut c, doc, n, "unknown palette colour '{name}'")
            return (false, term.color_default())
        }
        return parse_hex(mut c, doc, n, text)
    }
    if k == FN_MAP {
        validate_keys(mut c, doc, n, "idx")
        let idx = fl_map_find(doc, n, "idx")
        if idx < 0 {
            diag(mut c, doc, n, "indexed colour requires 'idx'")
            return (false, term.color_default())
        }
        if fl_kind(doc, idx) != FN_INT {
            diag(mut c, doc, idx, "colour idx must be an integer")
            return (false, term.color_default())
        }
        let v = doc.nodes[idx].num
        if v < 0 || v > 255 {
            diag(mut c, doc, idx, "colour idx must be between 0 and 255")
            return (false, term.color_default())
        }
        return (true, term.color_indexed(v))
    }
    diag(mut c, doc, n, "colour must be #rrggbb, @palette, {{ idx: N }}, or none")
    (false, term.color_default())
}

fn word_listed(word: str, list: str) -> bool {
    for w in list.words() {
        if w == word {
            return true
        }
    }
    false
}

// `validate_keys` (`theme.c:198-214`).
fn validate_keys(mut c: Tc, doc: FlDoc, map: int, known: str) {
    if fl_kind(doc, map) != FN_MAP {
        return
    }
    for k in doc.nodes[map].keys {
        if !word_listed(doc.nodes[k].text, known) {
            diag(mut c, doc, k, "unknown theme key '{doc.nodes[k].text}'")
        }
    }
}

// `parse_palette` (`theme.c:379-415`).
fn parse_palette(mut c: Tc, doc: FlDoc, n: int) {
    if fl_kind(doc, n) != FN_MAP {
        diag(mut c, doc, n, "palette must be a map")
        return
    }
    var i = 0
    while i < doc.nodes[n].keys.len {
        let key = doc.nodes[doc.nodes[n].keys[i]].text
        var dup = false
        for p in c.pal_names {
            if p == key {
                dup = true
            }
        }
        if dup {
            diag(mut c, doc, doc.nodes[n].keys[i], "duplicate palette colour '{key}'")
        } else {
            (mut c.pal_names).push(key)
            (mut c.pal_nodes).push(doc.nodes[n].vals[i])
            (mut c.pal_colors).push(term.color_default())
            (mut c.pal_state).push(0)
        }
        i += 1
    }
    var j = 0
    while j < c.pal_names.len {
        let _ = palette_resolve(mut c, doc, j)
        j += 1
    }
}

// `style_bit` (`theme.c:417-427`).
fn style_bit(key: str) -> int {
    match key {
        "bold" => term.ATTR_BOLD,
        "italic" => term.ATTR_ITALIC,
        "underline" => term.ATTR_UNDERLINE,
        "undercurl" => term.ATTR_UNDERCURL,
        "strike" => term.ATTR_STRIKE,
        "dim" => term.ATTR_DIM,
        "reverse" => term.ATTR_REVERSE,
        _ => 0,
    }
}

// `parse_style` (`theme.c:451-526`).
fn parse_style(mut c: Tc, doc: FlDoc, n: int) -> Style {
    var s = style_new()
    s.present = true
    if fl_kind(doc, n) != FN_MAP {
        diag(mut c, doc, n, "theme style must be a map")
        return s
    }
    validate_keys(
        mut c,
        doc,
        n,
        "fg bg bold italic underline undercurl strike dim reverse c256 c16 ul mono",
    )
    var i = 0
    while i < doc.nodes[n].keys.len {
        let key = doc.nodes[doc.nodes[n].keys[i]].text
        let v = doc.nodes[n].vals[i]
        let bit = style_bit(key)
        if key == "fg" {
            let (ok, color) = color_value(mut c, doc, v)
            s.fg = color
            s.fg_set = ok
        } else if key == "bg" {
            let (ok, color) = color_value(mut c, doc, v)
            s.bg = color
            s.bg_set = ok
        } else if bit != 0 {
            if fl_kind(doc, v) != FN_BOOL {
                diag(mut c, doc, v, "{key} must be a boolean")
            } else if doc.nodes[v].num != 0 {
                s.attrs = s.attrs | bit
            } else {
                s.attrs = s.attrs - (s.attrs & bit)
            }
        } else if key == "c256" || key == "c16" {
            let limit = if key == "c16" then 15 else 255
            if fl_kind(doc, v) != FN_INT {
                diag(mut c, doc, v, "{key} must be an integer")
            } else if doc.nodes[v].num < 0 || doc.nodes[v].num > limit {
                diag(mut c, doc, v, "{key} must be between 0 and {limit}")
            } else if limit == 15 {
                s.c16 = doc.nodes[v].num
            } else {
                s.c256 = doc.nodes[v].num
            }
        } else if key == "ul" {
            let t = if fl_kind(doc, v) == FN_STR then doc.nodes[v].text else ""
            if t == "error" {
                s.ul = 1
            } else if t == "warn" {
                s.ul = 2
            } else if t == "info" {
                s.ul = 3
            } else {
                diag(mut c, doc, v, "ul must be error, warn, or info")
            }
        } else if key == "mono" {
            let t = if fl_kind(doc, v) == FN_STR then doc.nodes[v].text else ""
            let mb = style_bit(t)
            if t == "plain" {
                s.mono = 0
                s.mono_set = true
            } else if mb == 0 || mb == term.ATTR_UNDERCURL || mb == term.ATTR_STRIKE {
                diag(mut c, doc, v, "mono must be plain, bold, italic, underline, reverse, or dim")
            } else {
                s.mono = mb
                s.mono_set = true
            }
        }
        i += 1
    }
    s
}

fn color_256(c: term.Color) -> term.Color {
    if c.tag != term.COLOR_RGB {
        return c
    }
    term.color_indexed(term.rgb_to_256(c.r, c.g, c.b))
}

fn color_16(c: term.Color) -> term.Color {
    if c.tag != term.COLOR_RGB {
        return c
    }
    term.color_indexed(term.rgb_to_16(c.r, c.g, c.b))
}

// `compile_style_tabs` (`theme.c:544-564`).
fn compile_style_tabs(s: Style) -> List[ThemeEnt] {
    let fg = if s.fg_set then copy s.fg else term.color_default()
    let bg = if s.bg_set then copy s.bg else term.color_default()
    let attrs = s.attrs | s.ul * 1024
    var fg256 = color_256(copy fg)
    var fg16 = color_16(copy fg)
    if s.c256 >= 0 {
        fg256 = term.color_indexed(s.c256)
    }
    if s.c16 >= 0 {
        fg16 = term.color_indexed(s.c16)
    }
    var tab = List[ThemeEnt]()
    (mut tab).push(ThemeEnt { fg: copy fg, bg: copy bg, attrs: attrs })
    (mut tab).push(ThemeEnt { fg: fg256, bg: color_256(copy bg), attrs: attrs })
    (mut tab).push(ThemeEnt { fg: fg16, bg: color_16(copy bg), attrs: attrs })
    (mut tab).push(ThemeEnt {
        fg: term.color_default(),
        bg: term.color_default(),
        attrs: if s.mono_set then s.mono else 0,
    })
    (mut tab).push(ent_default())
    tab
}

// `parse_attrs` + `resolve_attrs` (`theme.c:576-622`).
fn parse_attrs(mut c: Tc, doc: FlDoc, n: int, mut t: Theme) {
    var specs = List[Style]()
    var a = 0
    while a < ATTR_COUNT {
        (mut specs).push(style_new())
        a += 1
    }
    if fl_kind(doc, n) != FN_MAP {
        diag(mut c, doc, n, "attrs must be a map")
        return
    }
    var i = 0
    while i < doc.nodes[n].keys.len {
        let kn = doc.nodes[n].keys[i]
        let key = doc.nodes[kn].text
        let attr = theme_attr_id(key)
        if attr < 0 {
            diag(mut c, doc, kn, "unknown theme attr '{key}'")
        } else if specs[attr].present {
            diag(mut c, doc, kn, "duplicate theme attr '{key}'")
        } else {
            specs[attr] = parse_style(mut c, doc, doc.nodes[n].vals[i])
            t.explicit_attrs = t.explicit_attrs | pow2(attr)
        }
        i += 1
    }
    var tab = List[ThemeEnt]()
    var k = 0
    while k < THEME_RENDITIONS * ATTR_COUNT {
        (mut tab).push(ent_default())
        k += 1
    }
    var x = 0
    while x < ATTR_COUNT {
        if specs[x].present {
            let st = compile_style_tabs(specs[x])
            var r = 0
            while r < THEME_RENDITIONS {
                tab[r * ATTR_COUNT + x] = copy st[r]
                r += 1
            }
        } else {
            let p = theme_attr_parent(x)
            var r = 0
            while r < THEME_RENDITIONS {
                tab[r * ATTR_COUNT + x] = copy tab[r * ATTR_COUNT + p]
                r += 1
            }
        }
        x += 1
    }
    t.tab = tab
}

fn pow2(n: int) -> int {
    var v = 1
    var i = 0
    while i < n {
        v = v * 2
        i += 1
    }
    v
}

// `parse_ui` (`theme.c:626-708`).
fn parse_ui(mut c: Tc, doc: FlDoc, n: int, mut t: Theme) {
    if fl_kind(doc, n) != FN_MAP {
        diag(mut c, doc, n, "ui must be a map")
        return
    }
    var i = 0
    while i < doc.nodes[n].keys.len {
        let kn = doc.nodes[n].keys[i]
        let key = doc.nodes[kn].text
        let v = doc.nodes[n].vals[i]
        if key != "ul" {
            var dup = false
            for role in t.ui {
                if role.name == key {
                    dup = true
                }
            }
            if dup {
                diag(mut c, doc, kn, "duplicate ui role '{key}'")
            } else if key == "bg" || key == "fg" {
                var s = style_new()
                let (ok, color) = color_value(mut c, doc, v)
                if ok {
                    if key == "bg" {
                        s.bg = color
                        s.bg_set = true
                    } else {
                        s.fg = color
                        s.fg_set = true
                    }
                }
                (mut t.ui).push(ThemeUiRole { name: key, tab: compile_style_tabs(s) })
            } else {
                let s = parse_style(mut c, doc, v)
                (mut t.ui).push(ThemeUiRole { name: key, tab: compile_style_tabs(s) })
            }
        }
        i += 1
    }
    let ul = fl_map_find(doc, n, "ul")
    if ul < 0 {
        diag(mut c, doc, n, "ui.ul is required")
        return
    }
    if fl_kind(doc, ul) != FN_MAP {
        diag(mut c, doc, ul, "ui.ul must be a map")
        return
    }
    validate_keys(mut c, doc, ul, "error warn info")
    var uls = List[term.Color]()
    var k = 0
    while k < 9 {
        (mut uls).push(term.color_default())
        k += 1
    }
    var w = 0
    for which in "error warn info".words() {
        let value = fl_map_find(doc, ul, which)
        if value < 0 {
            diag(mut c, doc, ul, "ui.ul.{which} is required")
        } else {
            let (ok, color) = color_value(mut c, doc, value)
            if ok {
                uls[THEME_TRUECOLOR * 3 + w] = copy color
                uls[THEME_256 * 3 + w] = color_256(copy color)
                uls[THEME_16 * 3 + w] = color_16(color)
            }
        }
        w += 1
    }
    t.ul = uls
}

/// `yew_theme_compile` (`theme.c:799-830`): the document `src` compiled.
/// Answers (ok, theme, first diagnostic).
pub fn theme_compile(src: List[byte]) -> (bool, Theme, str) {
    var t = theme_none()
    if src.len > 1048576 {
        return (false, t, "theme exceeds the 1 MiB limit")
    }
    let doc = fl_read_literal(src)
    if doc.error.len != 0 {
        return (false, t, doc.error)
    }
    var c = Tc {
        error: "",
        pal_names: List[str](),
        pal_nodes: List[int](),
        pal_colors: List[term.Color](),
        pal_state: List[int](),
    }
    let top = doc.top[0]
    if fl_kind(doc, top) != FN_MAP {
        return (false, t, "theme must be a map")
    }
    validate_keys(mut c, doc, top, "theme name kind palette ui attrs")
    let version = fl_map_find(doc, top, "theme")
    if version < 0 {
        diag(mut c, doc, top, "theme schema version is required")
    } else if fl_kind(doc, version) != FN_INT {
        diag(mut c, doc, version, "theme must be an integer")
    } else if doc.nodes[version].num != 1 {
        diag(
            mut c,
            doc,
            version,
            "unknown theme schema version {doc.nodes[version].num} (this build understands 1)",
        )
    }
    let name = fl_map_find(doc, top, "name")
    if fl_kind(doc, name) == FN_STR {
        t.name = doc.nodes[name].text
        t.has_name = true
    } else {
        diag(mut c, doc, name, "name must be a string")
    }
    let kind = fl_map_find(doc, top, "kind")
    let ktext = if fl_kind(doc, kind) == FN_STR then doc.nodes[kind].text else ""
    if ktext == "dark" {
        t.kind = 0
    } else if ktext == "light" {
        t.kind = 1
    } else {
        diag(mut c, doc, kind, "kind must be 'dark' or 'light'")
    }
    let palette = fl_map_find(doc, top, "palette")
    if palette >= 0 {
        parse_palette(mut c, doc, palette)
    } else {
        diag(mut c, doc, top, "palette is required")
    }
    let ui = fl_map_find(doc, top, "ui")
    if ui >= 0 {
        parse_ui(mut c, doc, ui, mut t)
    } else {
        diag(mut c, doc, top, "ui is required")
    }
    let attrs = fl_map_find(doc, top, "attrs")
    if attrs >= 0 {
        parse_attrs(mut c, doc, attrs, mut t)
    } else {
        diag(mut c, doc, top, "attrs is required")
    }
    if c.error.len != 0 {
        return (false, theme_none(), c.error)
    }
    (true, t, "")
}

/// `yew_theme_ui` (`theme.c:1040-1054`): the role's entry at `rendition`,
/// or (false, default).
pub fn theme_ui(t: Theme, role: str, rendition: int) -> (bool, ThemeEnt) {
    for r in t.ui {
        if r.name == role {
            return (true, copy r.tab[rendition])
        }
    }
    (false, ent_default())
}

/// The attr table entry (`yew_theme_table(theme, rendition)[attr]`).
pub fn theme_attr(t: Theme, rendition: int, attr: int) -> ThemeEnt {
    if t.tab.len == 0 {
        return ent_default()
    }
    copy t.tab[rendition * ATTR_COUNT + attr]
}

/// `yew_theme_underline` (`theme.c:1029-1038`).
pub fn theme_underline(t: Theme, rendition: int, which: int) -> term.Color {
    if t.ul.len == 0 || rendition > THEME_16 || which < 0 || which > 2 {
        return term.color_default()
    }
    copy t.ul[rendition * 3 + which]
}

/// `valid_name` (`theme.c:848-866`).
pub fn theme_valid_name(name: str) -> bool {
    if name.len == 0 {
        return false
    }
    for b in name.bytes() {
        let c = b as int
        if !(c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 45 || c == 95) {
            return false
        }
    }
    true
}

/// `active_rendition` (`theme_cmds.c:54-67`): the renderer's state
/// selects the table, once per frame.
pub fn theme_rendition_of(r: term.Render) -> int {
    if r.plain {
        return THEME_DUMB
    }
    if r.no_color {
        return THEME_MONO
    }
    if r.tier == term.TIER_TRUECOLOR {
        return THEME_TRUECOLOR
    }
    if r.tier == term.TIER_256 {
        return THEME_256
    }
    THEME_16
}
