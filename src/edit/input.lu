//! edit.input — keys, pastes and resizes into the editor.
//!
//! Ports `ed_handle_key` (`ed.c:2302-2433`), `yew_ed_handle_paste`
//! (`ed.c:2435-2476`), `yew_ed_input_enable` and `yew_ed_resize`
//! (`ed.c:2478-2525`) at 9ace98c2, under `s14-modes-L-I.md` §3. The
//! layers C consults before the keymap that belong to later campaigns —
//! the mouse gesture and context menu (yw06), the group and list pickers
//! (yw05/yw06), the LSP rename (yw11), panels and completion menus
//! (yw11), the tab-jump window (yw05), FUSS (yw13) — have no instance
//! before their campaign, so a key falls past each as C's does when none
//! is open.

use term

/// `ed_handle_key` (`ed.c:2310-2433`): an Esc ends a pending chord; a
/// prompt owns the keyboard; the command line takes its printables; an
/// error message clears; I mode types text through the registry; the
/// rest is the keymap's.
pub fn ed_handle_key(mut ed: Ed, key: term.Key, now: int) {
    ed_handle_key_inner(mut ed, key, now)
    // s57.31 §2: an event boundary — a `*command-line*` buffer closed by
    // this key gives its line back to the prompt here (`ed.c:2302-2308`).
    cmdedit_settle(mut ed)
}

fn ed_handle_key_inner(mut ed: Ed, key: term.Key, now: int) {
    let command_mods = term.MOD_ALT |
        term.MOD_CTRL |
        term.MOD_SUPER |
        term.MOD_HYPER |
        term.MOD_META
    if key.kind != term.EV_KEY {
        return
    }
    if key.ev != term.KEY_RELEASE && !(ed.search.active && key.code == term.KEY_ENTER) {
        search_preview_cancel(mut ed)
    }
    ed.now_ms = now
    // Esc mid-gesture cancels it and restores the state the gesture
    // started from, before any mode acts on Escape (`ed.c:2321-2330`).
    if key.code == term.KEY_ESCAPE && mouse_gesture_active(ed) {
        mouse_cancel(mut ed)
        return
    }
    if key.code == term.KEY_ESCAPE && (ed.chord.n != 0 || ed.chord.count_given) {
        dispatch_key(mut ed, key, now)
        return
    }
    if ed.prompt != PROMPT_NONE {
        let _ = ed_prompt_key(mut ed, key)
        return
    }
    if key.ev != term.KEY_RELEASE && ed_msg_dismiss_overlay(mut ed) {
        return
    }
    if ed.cmdline.active && cmdline_key(mut ed, key) {
        return
    }
    // Sprint 24 §7 (`ed.c:2386-2394`): BEFORE the insert-mode text path —
    // a digit inside the jump window is the second half of a chord.
    if tab_jump_key(mut ed, key) {
        return
    }
    if ed.msg.active && ed.msg.sev == MSG_ERROR {
        ed_msg_clear(mut ed)
    }
    if ed.mode == MODE_I &&
        key.ev != term.KEY_RELEASE &&
        key.text.len != 0 &&
        key.mods & command_mods == 0 {
        let id = cmd_lookup(ed.reg, "ed.edit.insert.text")
        var cx = cmdctx_new(ed.win, SRC_KEY)
        cx.sarg = str_from_utf8(key.text) else ""
        cx.has_sarg = true
        ed.last_cmd = id
        ed.last_status = ed_cmd_invoke(mut ed, id, mut cx)
        ed.dispatch_count += 1
        return
    }
    dispatch_key(mut ed, key, now)
}

/// `yew_ed_handle_paste` (`ed.c:2435-2476`): a bracketed paste collects
/// and lands as ONE `ed.edit.insert.text` in I mode (one transaction,
/// `TXN_PASTE` is the clipboard's), or into the open command line.
pub fn ed_handle_paste(mut ed: Ed, bytes: List[byte], begin: bool, end: bool) {
    if begin {
        while ed.paste.len != 0 {
            let _ = (mut ed.paste).pop() else 0 as byte
        }
        ed.paste_active = true
        return
    }
    if !ed.paste_active {
        return
    }
    if !end {
        for b in bytes {
            (mut ed.paste).push(b)
        }
        return
    }
    if ed.cmdline.active && ed.paste.len != 0 {
        let collected = copy ed.paste
        cmdline_paste(mut ed, collected)
    } else if ed.mode == MODE_I && ed.prompt == PROMPT_NONE && ed.paste.len != 0 {
        let id = cmd_lookup(ed.reg, "ed.edit.insert.text")
        var cx = cmdctx_new(ed.win, SRC_KEY)
        cx.sbytes = copy ed.paste
        cx.has_sbytes = true
        cx.has_sarg = true
        ed.last_cmd = id
        ed.last_status = ed_cmd_invoke(mut ed, id, mut cx)
        ed.dispatch_count += 1
    }
    while ed.paste.len != 0 {
        let _ = (mut ed.paste).pop() else 0 as byte
    }
    ed.paste_active = false
    cmdedit_settle(mut ed)
}

/// `yew_ed_resize` (`ed.c:2488-2525`): a continue re-enters the alternate
/// screen and the input modes; a size change resizes the grid; either is
/// a full repaint — an identical size is nothing at all.
pub fn ed_resize(mut ed: Ed, resumed: bool) {
    if !ed.tty_ready {
        return
    }
    var resized = false
    if resumed {
        if !term.tty_is_raw(ed.tty) {
            ed.quit = true
            ed.exit_code = 3
            return
        }
        term.tty_altscreen(mut ed.tty, true)
        term.input_enable(term.tty_caps(ed.tty))
        // `yew_ed_input_enable` (`ed.c:2478-2486`): the base modes just
        // selected 1002 over the 1003 a chevron holds.
        mouse_motion_reassert(mut ed)
    }
    if term.tty_winsize(mut ed.tty) &&
        ed.grid_ready &&
        (ed.grid.rows != term.tty_rows(ed.tty) || ed.grid.cols != term.tty_cols(ed.tty)) {
        if !term.grid_resize(mut ed.grid, term.tty_rows(ed.tty), term.tty_cols(ed.tty)) {
            ed.quit = true
            ed.exit_code = 3
            return
        }
        if ed.win >= 0 {
            vp_invalidate(mut ed.wins[ed.win])
        }
        resized = true
    }
    if !resumed && !resized {
        return
    }
    if resumed && ed.grid_ready {
        term.grid_invalidate(mut ed.grid)
    }
    ed.layout_dirty = true
    ed.full_damage = true
    ed.footer_dirty = true
}

// `YEW_WHEEL_ROWS` (`mouse.h:46`).
const WHEEL_ROWS: int = 3

/// `yew_mouse_claimed_by_menu` (`mouse.c:109-170`), the command line's
/// half (the completion popup's is yw11's): a wheel over the menu scrolls
/// the LIST, never the selection; a left press on a row is the click; the
/// release of a press it handled, and a press on the menu's inert block,
/// are swallowed. False for anything that is not a mouse event over the
/// open prompt's menu.
pub fn mouse_claimed_by_menu(mut ed: Ed, key: term.Key) -> bool {
    if key.kind != term.EV_MOUSE || !ed.cmdline.active {
        return false
    }
    let hit = region_hit(mut ed.regions, key.col, key.row)
    if hit.kind != REGION_MENU_ROW && hit.kind != REGION_BLOCK {
        return false
    }
    if key.button == term.MB_WHEEL_UP || key.button == term.MB_WHEEL_DOWN {
        let _ = cmdline_menu_scroll(
            mut ed,
            if key.button == term.MB_WHEEL_UP then -WHEEL_ROWS else WHEEL_ROWS,
        )
        return true
    }
    if key.button != term.MB_LEFT {
        return false
    }
    if key.ev != term.KEY_PRESS {
        return true
    }
    if hit.kind == REGION_MENU_ROW {
        let _ = cmdline_menu_click(mut ed, hit.payload)
    }
    true
}

/// No gesture (`YEW_MP_IDLE`, `mouse.h`).
pub const MP_IDLE: int = 0

/// A press is down and has not moved off its cell (`YEW_MP_ARMED`).
pub const MP_ARMED: int = 1

/// A pane border is being dragged (`YEW_MP_DRAG_BORDER`).
pub const MP_DRAG_BORDER: int = 2

/// The router's gesture state (`MouseState`, `mouse.h`), the fields
/// Sprint 22's two gestures use: the phase and the press, its region
/// CAPTURED at press time.
pub struct MouseState {
    phase: int,
    press_x: int,
    press_y: int,
    press_kind: int,
    press_payload: int,
    press_rect: Rect,
    drag_tab_id: int,
    drag_gid: int,
}

/// At rest (`yew_mouse_init`, `mouse.c:56-89`).
pub fn mousestate_new() -> MouseState {
    MouseState {
        phase: MP_IDLE,
        press_x: 0,
        press_y: 0,
        press_kind: REGION_NONE,
        press_payload: 0,
        press_rect: rect(0, 0, 0, 0),
        drag_tab_id: 0,
        drag_gid: 0,
    }
}

// `press_tab` (`mouse.c:1282-1294`): a press on a strip entry ARMS and does
// nothing visible; the identity is captured now (a negative payload is a
// group, s24) and the switch happens at release.
fn press_tab(mut ed: Ed, payload: int) {
    if payload < 0 {
        ed.mouse.drag_gid = 0 - payload
        ed.mouse.drag_tab_id = 0
    } else {
        ed.mouse.drag_gid = 0
        ed.mouse.drag_tab_id = if payload < ed.tabs.len then ed.tabs[payload].tab_id else 0
    }
}

// `click_tab` (`mouse.c:2385-2402`): resolved from the identity captured
// at press, never from the cells under the release. An EXPLICIT group
// entry resumes where the user left off (`yew_group_note_position`, then
// `yew_group_enter`), unlike a mid-walk arrival.
fn click_tab(mut ed: Ed) {
    if ed.mouse.drag_gid != 0 {
        group_note_position(ed)
        group_enter(ed, ed.mouse.drag_gid)
        return
    }
    if ed.mouse.drag_tab_id != 0 {
        let idx = tab_index_of_id(ed, ed.mouse.drag_tab_id)
        if idx >= 0 {
            tab_switch(mut ed, idx)
        }
    }
}

/// `yew_mouse_gesture_active` (`mouse.c:91-94`).
pub fn mouse_gesture_active(ed: Ed) -> bool {
    ed.mouse.phase != MP_IDLE
}

/// `yew_mouse_cancel` (`mouse.c:2544-2580`), Sprint 22's half: a border
/// drag in flight restores its entry ratio; the gesture ends. (The
/// multi-click counter, the hover chevron and the strip drags it also
/// resets are Sprint 27's, yw06.)
pub fn mouse_cancel(mut ed: Ed) {
    if ed.mouse.phase == MP_IDLE {
        return
    }
    if ed.mouse.phase == MP_DRAG_BORDER {
        pane_drag_cancel(mut ed)
    }
    ed.mouse = mousestate_new()
}

// `mouse_press` (`mouse.c:1349-1470`) for the left button: the menu's
// claim first, then the region under the press, captured. A PANE press
// focuses and lands the cursor (`press_pane` → `yew_pane_click`); a
// BORDER press starts its drag (`press_border`). Every other region's
// press is Sprint 23's, 24's or 27's to route.
fn mouse_press(mut ed: Ed, key: term.Key) {
    let hit = region_hit(mut ed.regions, key.col, key.row)
    if key.button != term.MB_LEFT {
        return
    }
    if mouse_claimed_by_menu(mut ed, key) {
        return
    }
    ed.mouse.phase = MP_ARMED
    ed.mouse.press_x = key.col
    ed.mouse.press_y = key.row
    ed.mouse.press_kind = hit.kind
    ed.mouse.press_payload = hit.payload
    ed.mouse.press_rect = copy hit.rect
    if hit.kind == REGION_PANE {
        if pane_leaf_by_index(ed, hit.payload) >= 0 {
            let _ = pane_click(mut ed, key.col, key.row)
        }
    } else if hit.kind == REGION_PANE_BORDER {
        let split = pane_split_by_index(ed, hit.payload)
        if split >= 0 {
            pane_drag_begin(mut ed, split, ed.mouse.press_x, ed.mouse.press_y)
            ed.mouse.phase = MP_DRAG_BORDER
        }
    } else if hit.kind == REGION_TAB {
        press_tab(mut ed, hit.payload)
    } else if hit.kind == REGION_TAB_SCROLL {
        // A chevron scrolls on the press (`mouse.c:1420-1423`): ±1 an
        // entry, ±2 a page (s57.15's sign convention); row 2's chevrons
        // carry the same payloads.
        let _ = strip_scroll(
            mut ed,
            hit.payload == 2 || hit.payload == -2,
            if hit.payload < 0 then -1 else 1,
        )
    }
    // REGION_TAB_NEW is armed only (`mouse.c:1424-1427`): a release in the
    // same region invokes the command, so a press that slides away creates
    // nothing.
}

// `mouse_motion` (`mouse.c:2308-2370`): unheld motion is the hover (yw06);
// a held motion drags the border. Leaving the pressed cell from an ARMED
// press begins Sprint 27's drag-select or strip drag (yw06): until then
// the press stays armed.
fn mouse_motion(mut ed: Ed, key: term.Key) {
    if key.button == term.MB_NONE || ed.mouse.phase == MP_IDLE {
        return
    }
    if ed.mouse.phase == MP_DRAG_BORDER {
        pane_drag_motion(mut ed, key.col, key.row)
    }
}

// `mouse_release` (`mouse.c:2404-2540`): a border drag ends (its ratio was
// converted once per accepted motion, s22's pitfall); the gesture resets.
fn mouse_release(mut ed: Ed, key: term.Key) {
    if key.button != term.MB_LEFT {
        return
    }
    if mouse_claimed_by_menu(mut ed, key) {
        ed.mouse = mousestate_new()
        return
    }
    if ed.mouse.phase == MP_IDLE {
        return
    }
    if ed.mouse.phase == MP_DRAG_BORDER {
        pane_drag_end(mut ed)
    } else if ed.mouse.phase == MP_ARMED && ed.mouse.press_kind == REGION_TAB {
        click_tab(mut ed)
    } else if ed.mouse.phase == MP_ARMED && ed.mouse.press_kind == REGION_TAB_NEW {
        // A release in the SAME region invokes `ed.tab.new` (`mouse.c:2440-
        // 2449`), Sprint 57.8's command, through the registry.
        let up = region_hit(mut ed.regions, key.col, key.row)
        let pr = copy ed.mouse.press_rect
        if up.kind == REGION_TAB_NEW &&
            up.rect.x == pr.x &&
            up.rect.y == pr.y &&
            up.rect.w == pr.w &&
            up.rect.h == pr.h {
            let id = cmd_lookup(ed.reg, "ed.tab.new")
            if id > 0 {
                var cx = cmdctx_new(ed.win, SRC_MOUSE)
                let _ = ed_cmd_invoke(mut ed, id, mut cx)
            }
        }
    }
    ed.mouse = mousestate_new()
}

/// `yew_mouse_event` (`mouse.c:2868-2903`): a wheel never enters the phase
/// machine (it has no release); a press, a held motion and a release run
/// it. The command line's menu claims its own rows (Sprint 18.5 §8,
/// R-yw04-2); Sprint 22 adds click-to-focus and the border drag through
/// the region registry; the router's other gestures — selection, the
/// document's wheel, tabs, menus — are Sprint 23's, 24's and 27's.
pub fn ed_mouse_event(mut ed: Ed, key: term.Key) {
    if key.kind != term.EV_MOUSE {
        return
    }
    let b = key.button
    if b == term.MB_WHEEL_UP ||
        b == term.MB_WHEEL_DOWN ||
        b == term.MB_WHEEL_LEFT ||
        b == term.MB_WHEEL_RIGHT {
        let _ = mouse_claimed_by_menu(mut ed, key)
        return
    }
    if key.ev == term.KEY_PRESS {
        mouse_press(mut ed, key)
    } else if key.ev == term.KEY_REPEAT {
        mouse_motion(mut ed, key)
    } else if key.ev == term.KEY_RELEASE {
        mouse_release(mut ed, key)
    }
}
