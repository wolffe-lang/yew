//! edit.ed_marks — a buffer's 26 named marks.
//!
//! Ports sagitta `src/edit/ed.c:1070-1100` (`yew_ed_mark_set`,
//! `yew_ed_mark_get`) and the `named[26]`/`named_set[26]` fields of
//! `Buffer` (`edit/buf.h`) at 9ace98c2 — Sprint 21 §7's name table: a
//! name is a mark in the buffer's mark set (left bias), so it follows
//! every edit, and re-setting a name drops the old mark rather than
//! leaking one per `ma`. Pulled forward by yw04's grammar fork because
//! the `'a` range address (`cmdparse.c:395-411`) resolves through it; the
//! `m`/`'` commands that set and jump are search's (yw04).

use text

const NAMED_N: int = 26

/// The table (`Buffer.named`, `Buffer.named_set`).
pub struct NamedMarks {
    ids: List[text.MarkId],
    set: List[bool],
    pending: List[int],
    pending_set: List[bool],
}

/// No name set.
pub fn named_marks_new() -> NamedMarks {
    var ids = List[text.MarkId]()
    var set = List[bool]()
    var pending = List[int]()
    var pending_set = List[bool]()
    var i = 0
    while i < NAMED_N {
        (mut ids).push(text.MarkId { id: -1, gen: 0 })
        (mut set).push(false)
        (mut pending).push(0)
        (mut pending_set).push(false)
        i += 1
    }
    NamedMarks { ids: ids, set: set, pending: pending, pending_set: pending_set }
}

/// `yew_ed_mark_set` (`ed.c:1070-1085`): name `name` ('a'..'z', as a byte
/// value) marks `at` in buffer index `bi`; false for another name or a
/// buffer with no mark set.
pub fn ed_mark_set(mut ed: Ed, bi: int, name: int, at: int) -> bool {
    if bi < 0 || bi >= ed.bufs.len || !ed.bufs[bi].ec.has_marks || name < 97 || name > 122 {
        return false
    }
    let slot = name - 97
    if ed.bufs[bi].named.set[slot] {
        let old = copy ed.bufs[bi].named.ids[slot]
        if text.mark_alive(ed.bufs[bi].ec.marks, old) {
            text.mark_del(mut ed.bufs[bi].ec.marks, old)
        }
    }
    let id = text.mark_add(mut ed.bufs[bi].ec.marks, at as text.ByteOff, text.BIAS_LEFT)
    ed.bufs[bi].named.ids[slot] = id
    ed.bufs[bi].named.set[slot] = true
    true
}

/// `yew_ed_mark_get` (`ed.c:1087-1100`): where name `name` is in buffer
/// index `bi`, or `none` when it is unset or its mark has died.
pub fn ed_mark_get(ed: Ed, bi: int, name: int) -> int ! {none} {
    if bi < 0 || bi >= ed.bufs.len || !ed.bufs[bi].ec.has_marks || name < 97 || name > 122 {
        return none
    }
    let slot = name - 97
    if !ed.bufs[bi].named.set[slot] {
        return none
    }
    let id = copy ed.bufs[bi].named.ids[slot]
    if !text.mark_alive(ed.bufs[bi].ec.marks, id) {
        return none
    }
    text.mark_pos(ed.bufs[bi].ec.marks, id) as int
}
