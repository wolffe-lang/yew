//! Reuse the menu's owned slots (sagitta menu.c:119-157, cmdcomp.c:3496-3532).
//! Physical slots stay at their high-water count; n_items is the live prefix.
//! Direct refill avoids G50's native row-move failure across scratch regions.

use util

fn menu_refill_bytes(mut dst: List[byte], src: List[byte]) {
    (mut dst).reset()
    (mut dst).reserve(src.len)
    for b in src { (mut dst).push(b) }
}

/// Prepare row owners before entering a ranking scratch region.
pub fn menu_reserve(mut m: Menu, n: int) {
    (mut m.items).reserve(n)
    while m.items.len < n { (mut m.items).push(compitem_text(List[byte](), 0)) }
}

/// Replace the live prefix by value, retaining every nested vector's buffer.
/// Call menu_reserve outside scratch first. No row header moves out and back
/// (G50: notes/yw07-evidence/reuse-row-move); detail bytes belong to this menu.
pub fn menu_refill(mut m: Menu, rows: List[CompItem]) {
    assert(m.items.len >= rows.len, "menu_reserve precedes ranking")
    for i in 0..rows.len {
        menu_refill_bytes(mut m.items[i].text, rows[i].text)
        menu_refill_bytes(mut m.items[i].ranked, rows[i].ranked)
        menu_refill_bytes(mut m.items[i].suffix, rows[i].suffix)
        (mut m.items[i].m.pos).reset()
        (mut m.items[i].m.pos).reserve(rows[i].m.pos.len)
        for pos in rows[i].m.pos { (mut m.items[i].m.pos).push(pos) }
        let detail_id = util.intern(mut m.details, rows[i].detail)
        m.items[i].detail = m.details.strings[detail_id]
        m.items[i].kind = rows[i].kind
        m.items[i].is_dir = rows[i].is_dir
        m.items[i].deferred = rows[i].deferred
        m.items[i].score = rows[i].score
        m.items[i].match_off = rows[i].match_off
    }
    m.n_items = rows.len
}

/// Install rows for non-live hosts, preparing reusable slots first.
pub fn menu_install(mut m: Menu, rows: List[CompItem]) {
    menu_reserve(mut m, rows.len)
    menu_refill(mut m, rows)
}
