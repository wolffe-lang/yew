    var r = List[BindRow]()
    (mut r).push(bindrow("<left>", "ed.move.unit.home"))
    (mut r).push(bindrow("<right>", "ed.move.unit.end"))
    (mut r).push(bindrow("<up>", "ed.move.unit.prev"))
    (mut r).push(bindrow("<down>", "ed.move.unit.next"))
