/// H mode's selection actions, every unit (`keys_highlight.c:59-96`).
pub fn keys_h_common() -> List[BindRow] {
    var r = List[BindRow]()
    (mut r).push(bindrow("S-<left>", "ed.sel.extend.left"))
    (mut r).push(bindrow("S-<right>", "ed.sel.extend.right"))
    (mut r).push(bindrow("S-<up>", "ed.sel.extend.up"))
    (mut r).push(bindrow("S-<down>", "ed.sel.extend.down"))
    (mut r).push(bindrow_s(":", "ed.mode.enter", "E"))
    (mut r).push(bindrow("!", "ed.shell.open"))
    (mut r).push(bindrow("C-c", "ed.clip.copy"))
    (mut r).push(bindrow("C-x", "ed.clip.cut"))
    (mut r).push(bindrow("C-v", "ed.clip.paste"))
    (mut r).push(bindrow("y", "ed.sel.yank"))
    (mut r).push(bindrow("d", "ed.sel.delete"))
    (mut r).push(bindrow("<del>", "ed.sel.delete"))
    (mut r).push(bindrow("c", "ed.sel.change"))
    (mut r).push(bindrow("U", "ed.sel.case_upper"))
    (mut r).push(bindrow("u", "ed.sel.case_lower"))
    (mut r).push(bindrow("~", "ed.sel.case_toggle"))
    (mut r).push(bindrow(">", "ed.sel.indent"))
    (mut r).push(bindrow("<lt>", "ed.sel.dedent"))
    (mut r).push(bindrow("A-<lt>", "ed.sel.shift_left"))
    (mut r).push(bindrow("A->", "ed.sel.shift_right"))
    (mut r).push(bindrow("J", "ed.sel.join"))
    (mut r).push(bindrow("r", "ed.sel.replace_char"))
    (mut r).push(bindrow("I", "ed.edit.rect.insert"))
    (mut r).push(bindrow("A", "ed.edit.rect.append"))
    (mut r).push(bindrow("o", "ed.sel.swap_ends"))
    (mut r).push(bindrow_s("v c", "ed.sel.kind", "c"))
    (mut r).push(bindrow_s("v l", "ed.sel.kind", "l"))
    (mut r).push(bindrow_s("v r", "ed.sel.kind", "r"))
    (mut r).push(bindrow("<cr>", "ed.cursor.lift.lines"))
    (mut r).push(bindrow("m", "ed.cursor.lift.matches"))
    (mut r).push(bindrow("e", "ed.cursor.lift.ends"))
    (mut r).push(bindrow("C-A-<up>", "ed.cursor.add.above"))
    (mut r).push(bindrow("C-A-<down>", "ed.cursor.add.below"))
    (mut r).push(bindrow("C-A-<bs>", "ed.cursor.drop"))
    (mut r).push(bindrow("<esc>", "ed.mode.escape"))
    (mut r).push(bindrow("C-g", "ed.ui.message_expand"))
    r
}

/// The panic rows of mode `m` (`yew_keys_default_install`,
/// `keys_default.c:89-112`): L, E and F have floors, the rest none.
pub fn keys_panic(m: int) -> List[BindRow] {
    if m == MODE_L {
        return keys_panic_l()
    }
    if m == MODE_E {
        return keys_panic_e()
    }
    if m == MODE_F {
        return keys_panic_f()
    }
    List[BindRow]()
}

/// H's rows for `unit` (`yew_keys_highlight_install`): the unit's
/// motions, then the common actions.
pub fn keys_highlight(unit: int) -> List[BindRow] {
    var rows = if unit == MODE_W {
        keys_h_word()
    } else if unit == MODE_B {
        keys_h_block()
    } else if unit == MODE_I {
        keys_h_char()
    } else {
        keys_h_line()
    }
    if unit != MODE_L && unit != MODE_W && unit != MODE_B && unit != MODE_I {
        bug("invalid H unit mode")
    }
    for row in keys_h_common() {
        (mut rows).push(copy row)
    }
    rows
}
