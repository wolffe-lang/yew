/// H motions entered from I (by character) (`keys_highlight.c:50-57`).
pub fn keys_h_char() -> List[BindRow] {
    var r = List[BindRow]()
    (mut r).push(bindrow("<left>", "ed.move.unit.prev"))
    (mut r).push(bindrow("<right>", "ed.move.unit.next"))
    (mut r).push(bindrow("<up>", "ed.move.line.up"))
