    (mut r).push(bindrow("<up>", "ed.move.line.up"))
    (mut r).push(bindrow("<down>", "ed.move.line.down"))
    (mut r).push(bindrow("A-<left>", "ed.move.unit.prev_alt"))
    (mut r).push(bindrow("A-<right>", "ed.move.unit.next_alt"))
