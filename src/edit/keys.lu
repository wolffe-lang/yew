/// H motions entered from L (`keys_highlight.c:13-24`).
pub fn keys_h_line() -> List[BindRow] {
    var r = List[BindRow]()
    (mut r).push(bindrow("<left>", "ed.move.unit.home"))
    (mut r).push(bindrow("<right>", "ed.move.unit.end"))
    (mut r).push(bindrow("<up>", "ed.move.unit.prev"))
    (mut r).push(bindrow("<down>", "ed.move.unit.next"))
    (mut r).push(bindrow("A-<left>", "ed.move.unit.home_alt"))
    (mut r).push(bindrow("A-<right>", "ed.move.unit.end_alt"))
    (mut r).push(bindrow("A-<up>", "ed.move.unit.prev_alt"))
    (mut r).push(bindrow("A-<down>", "ed.move.unit.next_alt"))
    (mut r).push(bindrow("<home>", "ed.move.line.home_toggle"))
    (mut r).push(bindrow("<end>", "ed.move.unit.end"))
    r
}

