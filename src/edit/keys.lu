    (mut r).push(bindrow("<end>", "ed.move.buf.end"))
    (mut r).push(bindrow("A-a", "ed.git.stage"))
    (mut r).push(bindrow("A-u", "ed.git.unstage"))
    (mut r).push(bindrow("A-S", "ed.git.stage.all"))
    (mut r).push(bindrow("A-U", "ed.git.unstage.all"))
    (mut r).push(bindrow("A-m", "ed.git.commit"))
    (mut r).push(bindrow("A-M", "ed.git.commit.amend"))
    (mut r).push(bindrow("A-p", "ed.git.push"))
    (mut r).push(bindrow("A-l", "ed.git.pull"))
    (mut r).push(bindrow("A-f", "ed.git.fetch"))
    (mut r).push(bindrow("A-d", "ed.git.diff"))
    (mut r).push(bindrow("A-D", "ed.git.diff.view"))
    (mut r).push(bindrow("A-s", "ed.git.status"))
    (mut r).push(bindrow("A-w", "ed.git.blame"))
    (mut r).push(bindrow("A-h", "ed.git.history"))
    (mut r).push(bindrow("A-L", "ed.git.reflog"))
    (mut r).push(bindrow("A-c", "ed.git.view"))
    (mut r).push(bindrow("A-b", "ed.git.branch.switch"))
    (mut r).push(bindrow("A-n", "ed.git.branch.create"))
    (mut r).push(bindrow("A-R", "ed.git.branch.delete"))
    (mut r).push(bindrow("A-G", "ed.git.merge"))
    (mut r).push(bindrow("A-O", "ed.git.reset"))
    (mut r).push(bindrow("A-I", "ed.git.rebase.interactive"))
    (mut r).push(bindrow("A-y", "ed.git.cherry_pick"))
    (mut r).push(bindrow("A-v", "ed.git.revert"))
    (mut r).push(bindrow("A-z", "ed.git.stash.push"))
    (mut r).push(bindrow("A-Z", "ed.git.stash.pop"))
    (mut r).push(bindrow("A-t", "ed.git.tag"))
    (mut r).push(bindrow("A-x", "ed.git.discard"))
    (mut r).push(bindrow("A-r", "ed.git.file.delete"))
    (mut r).push(bindrow("A-N", "ed.git.file.rename"))
    (mut r).push(bindrow("<cr>", "ed.git.open"))
    (mut r).push(bindrow("A-g", "ed.group.from_dir"))
    (mut r).push(bindrow("A-T", "ed.git.tree.all"))
