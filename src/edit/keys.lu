//! edit.keys — the built-in key tables as data: the panic floor beneath
//! `runtime/init.fl` and the H-mode motion tables.
//!
//! Ports sagitta `src/edit/keys_default.c` (112 lines) and
//! `src/edit/keys_highlight.c` (137) at 9ace98c2, row for row (the rows
//! were transcribed from C's arrays by a script and are checked against
//! them by `src/edit_keymap_test.lu`). The panic floor is six L/E rows
//! enough to leave, enter and submit a command, or abandon one, when the
//! shipped or user configuration is broken (`keys_default.c:9-26`), and
//! F mode's direct keys (F mode is campaign 11's; its commands refuse by
//! name until then). H's motions depend on the unit H was entered from
//! and are rebuilt on each H entry (`keys_highlight.c:96-137`).

/// The panic floor of L mode (`keys_default.c:15-21`).
pub fn keys_panic_l() -> List[BindRow] {
    var r = List[BindRow]()
    (mut r).push(bindrow("<esc>", "ed.nop"))
    (mut r).push(bindrow("q", "ed.quit"))
    (mut r).push(bindrow("q !", "ed.quit_force"))
    (mut r).push(bindrow_s(":", "ed.mode.enter", "E"))
    (mut r).push(bindrow("!", "ed.shell.open"))
    r
}

/// The panic floor of E mode (`keys_default.c:23-26`).
pub fn keys_panic_e() -> List[BindRow] {
    var r = List[BindRow]()
    (mut r).push(bindrow("<cr>", "ed.cmdline.accept"))
    (mut r).push(bindrow("<esc>", "ed.cmdline.cancel"))
    r
}

