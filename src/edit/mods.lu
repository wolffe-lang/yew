//! edit.mods — the optional-module registry: sagitta 9ace98c2
//! src/mod/mods.c:1-62 and mods.h.
//!
//! C builds each optional module in or out (`MODULES ?= lsp ai fuss
//! plugins`, Makefile:100; `YEW_WITH_*`). FUSS is in since yw13; the other
//! three are absent before their lanes (LSP yw11, AI yw12, plugins yw14),
//! so for them the port answers as C's module-less build does (s56.5 §1):
//! a write to a module-owned option refused with C's own words
//! (option.c:550-566, YEW-F-075).

/// `YewMod` (mods.h).
pub const MOD_LSP: int = 0

/// The AI module.
pub const MOD_AI: int = 1

/// FUSS, the git UI.
pub const MOD_FUSS: int = 2

/// Plugins.
pub const MOD_PLUGINS: int = 3

/// The module count.
pub const MOD_COUNT: int = 4

/// `yew_mod_enabled` (mods.c:18-33): FUSS (yw13) is the one optional
/// module in the port so far.
pub fn mod_enabled(m: int) -> bool {
    m == MOD_FUSS
}

/// `yew_mod_name` (mods.c:35-45).
pub fn mod_name(m: int) -> str {
    match m {
        0 => "lsp",
        1 => "ai",
        2 => "fuss",
        3 => "plugins",
        _ => "unknown",
    }
}

/// `yew_mod_require` (mods.c:47-61): "" when built in, else the refusal.
pub fn mod_require(m: int) -> str {
    if mod_enabled(m) { return "" }
    let name = mod_name(m)
    "this build has no {name} module; rebuild with 'make MODULES=\"… {name}\"'"
}
