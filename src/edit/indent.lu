//! edit.indent — the one place that answers "what is this line's
//! indentation" (Sprint 57.16 §1).
//!
//! Ports sagitta `src/edit/indent.c` (222 lines) and `indent.h` (65) at
//! 9ace98c2: the classifier `yew_indent_info` (the block units' `line_info`
//! delegates here, `block.c:137-162`), `yew_indent_last_nonwhite` (the
//! block unit's continuation heuristic), `yew_indent_back` (one Backspace
//! inside leading whitespace) and `yew_indent_lead_append`. C's
//! `yew_indent_unit` and `yew_indent_unit_append` read the `expandtab`
//! option (`indent.c:150-166`, `yew_opt_buffer_bool`), the option store of
//! Sprint 36 (yw09), and land with the I-mode Enter that emits them.
//!
//! C walks the bytes with a chunk iterator; the port reads them with
//! `text.textbuf_byte_at` (a descent, no allocation): the scan stops at
//! the first non-blank byte, so it touches the leading run only, and a
//! per-line iterator here would allocate a descent stack per line into
//! the caller's region, which in the editor is the session's.

use text

/// `IndentInfo` (`indent.h:34-39`): the first non-blank byte (the content
/// end when blank), the indent width in cells (tab-expanded), whether the
/// line is all whitespace, whether its leading run begins with a tab.
pub struct IndentInfo {
    first: int,
    width: int,
    blank: bool,
    tabs: bool,
}

fn ascii_white(b: int) -> bool {
    b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12
}

// `ascii_first_nonwhite` (`indent.c:19-55`): (decided, first, blank);
// `decided` is false when a non-ASCII byte comes before any non-blank
// one, the only case that needs the cluster walk.
fn ascii_first_nonwhite(tb: text.TextBuf, line: text.Span) -> (bool, int, bool) {
    var at = line.lo
    while at < line.hi {
        let b = text.textbuf_byte_at(tb, at)
        if b >= 128 {
            return (false, line.lo, true)
        }
        if !ascii_white(b) {
            return (true, at, false)
        }
        at += 1
    }
    (true, line.lo, true)
}

// `line_content_hi` (`indent.c:68-78`).
fn indent_content_hi(tb: text.TextBuf, line: text.Span) -> int {
    var hi = line.hi
    if hi != line.lo && text.textbuf_byte_at(tb, hi - 1) == 10 {
        hi -= 1
        if hi != line.lo && text.textbuf_byte_at(tb, hi - 1) == 13 {
            hi -= 1
        }
    }
    hi
}

/// `yew_indent_last_nonwhite` (`indent.c:80-96`): the line's last byte
/// that is not ASCII whitespace, or false when it has none.
pub fn indent_last_nonwhite(tb: text.TextBuf, line: text.Span) -> (bool, int) {
    var at = line.hi
    while at != line.lo {
        at -= 1
        let b = text.textbuf_byte_at(tb, at)
        if !ascii_white(b) {
            return (true, b)
        }
    }
    (false, 0)
}

/// `yew_indent_info` (`indent.c:98-131`): classify `line` (a span from
/// `textbuf_line_span`, its EOL included) at tab width `tabwidth_in` (0
/// for `VP_TABWIDTH`). Every real line has an answer.
pub fn indent_info(tb: text.TextBuf, line: text.Span, tabwidth_in: int) -> IndentInfo {
    let tabwidth = if tabwidth_in == 0 then VP_TABWIDTH else tabwidth_in
    var first = indent_content_hi(tb, line)
    let tabs = line.hi != line.lo && text.textbuf_byte_at(tb, line.lo) == 9
    let (decided, ascii_first, ascii_blank) = ascii_first_nonwhite(tb, line)
    var blank = ascii_blank
    if decided {
        if !blank {
            first = ascii_first
        }
    } else {
        var at = line.lo
        while at < line.hi {
            let (ok, cl) = text.text_cluster_next(tb, line, at as text.ByteOff)
            if !ok {
                break
            }
            if !unicode_is_white_space(cl.base_cp) {
                blank = false
                first = at
                break
            }
            at = cl.hi
        }
    }
    let width = text.off_to_ccol(tb, line, first as text.ByteOff, tabwidth) as int
    IndentInfo { first: first, width: width, blank: blank, tabs: tabs }
}

/// `yew_indent_lead_append` (`indent.c:175-201`): append the bytes of
/// `lead` to `out` verbatim.
pub fn indent_lead_append(tb: text.TextBuf, lead: text.Span, mut out: List[byte]) {
    if lead.hi <= lead.lo {
        return
    }
    text.textbuf_append_range(mut out, tb, lead.lo, lead.hi)
}

/// `yew_indent_back` (`indent.c:203-222`): where one Backspace inside the
/// leading whitespace lands — the previous tab stop, a ragged indent
/// snapped back to the stop below it; outside the leading whitespace,
/// the previous grapheme boundary.
pub fn indent_back(mut tb: text.TextBuf, line: text.Span, tabwidth_in: int, from: int) -> int {
    let tabwidth = if tabwidth_in == 0 then VP_TABWIDTH else tabwidth_in
    if from <= line.lo || from > line.hi {
        return text.grapheme_prev_boundary(mut tb, from as text.ByteOff) as int
    }
    let info = indent_info(tb, line, tabwidth)
    if from > info.first {
        return text.grapheme_prev_boundary(mut tb, from as text.ByteOff) as int
    }
    let col = text.off_to_ccol(tb, line, from as text.ByteOff, tabwidth) as int
    if col == 0 {
        return line.lo
    }
    let target = (col - 1) / tabwidth * tabwidth
    var at = from
    while at > line.lo && text.off_to_ccol(tb, line, at as text.ByteOff, tabwidth) as int > target {
        at = text.grapheme_prev_boundary(mut tb, at as text.ByteOff) as int
    }
    at
}
