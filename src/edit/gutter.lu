//! edit.gutter — the line-number gutter and its sign column.
//!
//! Ports sagitta `src/ui/gutter.c` (367 lines) and `ui/gutter.h` (64) at
//! 9ace98c2, under `s15-viewport-statusline.md` §4. The signs
//! (`yew_gutter_sign_set` and its clears, Sprint 43) are written by later
//! campaigns (diagnostics yw11, git yw13, shadow yw11); campaign 03 draws
//! them and owns the table (`test_gutter_sign`).
//!
//! C's one-warning-per-kind mask is process state (`invalid_sign_
//! warned`, `gutter.c:16`); the port keeps it as a module `int` behind
//! `unsafe` as `unicode.width` keeps its startup option (invariant 8: the
//! core is single-threaded, the main task alone reads and writes it).

use term
use text
use unicode
use util

var invalid_sign_warned: int = 0

/// `YEW_GUTTER_SIGN_COLS` (`gutter.h:20`): the two sign cells always
/// reserved.
pub const GUTTER_SIGN_COLS: int = 2

/// A diagnostic sign (`SignKind`, `gutter.h:22-27`).
pub const SIGN_DIAG: int = 0

/// A git hunk sign.
pub const SIGN_GIT: int = 1

/// A shadow-completion sign.
pub const SIGN_SHADOW: int = 2

/// The sign-kind count.
pub const SIGN_NKIND: int = 3

/// `GutterSign` (`gutter.h:29-34`): C borrows the glyph bytes and role
/// name; the port owns a copy.
pub struct GutterSign {
    glyph: List[byte],
    role: str,
    attrs: int,
}

/// `GutterSignLine` (`gutter.h:36-40`): one line's signs, one per kind,
/// `mask` the kinds present.
pub struct GutterSignLine {
    line: int,
    sign: List[GutterSign],
    mask: int,
}

/// `GutterSigns` (`gutter.h:42-46`), sorted by line.
pub struct GutterSigns {
    v: List[GutterSignLine],
}

/// No signs.
pub fn gutter_signs_new() -> GutterSigns {
    GutterSigns { v: List[GutterSignLine]() }
}

/// An empty sign (C's zeroed `GutterSign`).
pub fn gutter_sign_none() -> GutterSign {
    GutterSign { glyph: List[byte](), role: "", attrs: 0 }
}

/// A sign of `glyph` in theme role `role` with `attrs` added.
pub fn gutter_sign(glyph: str, role: str, attrs: int) -> GutterSign {
    GutterSign { glyph: bytes_of(glyph), role: role, attrs: attrs }
}

// `sign_fallback` (`gutter.c:18-39`): the ASCII glyph of `kind`, a
// diagnostic's by its severity role.
fn sign_fallback(kind: int, role: str) -> int {
    if kind < 0 || kind >= SIGN_NKIND {
        bug("gutter sign: invalid kind")
    }
    if kind == SIGN_DIAG {
        if role == "diag.error" {
            return 69
        }
        if role == "diag.warn" {
            return 87
        }
        if role == "diag.info" {
            return 105
        }
        if role == "diag.hint" {
            return 104
        }
    }
    if kind == SIGN_DIAG then 33 else if kind == SIGN_GIT then 43 else 115
}

// `sign_lower_bound` (`gutter.c:41-55`): the first entry at or after
// `line`.
fn sign_lower_bound(signs: GutterSigns, line: int) -> int {
    var lo = 0
    var hi = signs.v.len
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if signs.v[mid].line < line {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    lo
}

// `sign_line` with `create` (`gutter.c:57-81`): the entry of `line`,
// inserted in order (all kinds empty) when absent; answers its index.
fn sign_line_create(mut signs: GutterSigns, line: int) -> int {
    let at = sign_lower_bound(signs, line)
    if at < signs.v.len && signs.v[at].line == line {
        return at
    }
    var empty = List[GutterSign]()
    var k = 0
    while k < SIGN_NKIND {
        (mut empty).push(gutter_sign_none())
        k += 1
    }
    var next = List[GutterSignLine]()
    var i = 0
    while i < signs.v.len {
        if i == at {
            (mut next).push(GutterSignLine { line: line, sign: copy empty, mask: 0 })
        }
        (mut next).push(copy signs.v[i])
        i += 1
    }
    if at == signs.v.len {
        (mut next).push(GutterSignLine { line: line, sign: empty, mask: 0 })
    }
    // s255 (wolf-lang#821): the table is reset and refilled, never replaced.
    (mut signs.v).reset()
    var k = 0
    while k < next.len {
        (mut signs.v).push(copy next[k])
        k += 1
    }
    at
}

fn warned_mask() -> int {
    // # Safety: invariant 8 — the core is single-threaded; the main task
    // alone reads the warn-once mask it alone writes.
    unsafe {
        invalid_sign_warned
    }
}

fn warned_note(bit: int) {
    // # Safety: invariant 8 — as `warned_mask`.
    unsafe {
        invalid_sign_warned = invalid_sign_warned | bit
    }
}

/// `yew_gutter_sign_set` (`gutter.c:83-112`): window `w`'s sign of `kind`
/// on `line`. A glyph that is not one cell is replaced by the kind's
/// ASCII fallback, warned once per kind per process.
pub fn gutter_sign_set(mut w: Win, line: int, kind: int, sign: GutterSign) {
    if kind < 0 || kind >= SIGN_NKIND {
        bug("gutter sign set: invalid argument")
    }
    let bit = pow2_small(kind)
    let at = sign_line_create(mut w.signs, line)
    var entry = copy sign
    if sign.glyph.len == 0 || unicode.cluster_width(sign.glyph, 0, sign.glyph.len) != 1 {
        var fallback = List[byte]()
        (mut fallback).push(sign_fallback(kind, sign.role) as byte)
        entry.glyph = fallback
        if warned_mask() & bit == 0 {
            util.log_at(
                util.LOG_WARN,
                "gutter sign kind {kind} is not one cell; using ASCII fallback",
            )
            warned_note(bit)
        }
    }
    w.signs.v[at].sign[kind] = entry
    w.signs.v[at].mask = w.signs.v[at].mask | bit
}

/// `yew_gutter_sign_set` with a `NULL` sign (`gutter.c:92-98`): the kind
/// cleared on `line`, the entry kept.
pub fn gutter_sign_unset(mut w: Win, line: int, kind: int) {
    if kind < 0 || kind >= SIGN_NKIND {
        bug("gutter sign set: invalid argument")
    }
    let at = sign_lower_bound(w.signs, line)
    if at < w.signs.v.len && w.signs.v[at].line == line {
        w.signs.v[at].mask = w.signs.v[at].mask & 7 - pow2_small(kind)
    }
}

// The entries `[first, last)` removed.
fn signs_cut(mut signs: GutterSigns, first: int, last: int) {
    var next = List[GutterSignLine]()
    var i = 0
    while i < signs.v.len {
        if i < first || i >= last {
            (mut next).push(copy signs.v[i])
        }
        i += 1
    }
    (mut signs.v).reset()
    var k = 0
    while k < next.len {
        (mut signs.v).push(copy next[k])
        k += 1
    }
}

/// `yew_gutter_signs_clear` (`gutter.c:114-131`): every sign on lines
/// `[lo, hi)`.
pub fn gutter_signs_clear(mut w: Win, lo: int, hi: int) {
    if lo >= hi {
        return
    }
    let first = sign_lower_bound(w.signs, lo)
    let last = sign_lower_bound(w.signs, hi)
    if first >= last {
        return
    }
    signs_cut(mut w.signs, first, last)
}

/// `yew_gutter_sign_clear_kind` (`gutter.c:133-156`): `kind`'s signs on
/// lines `[lo, hi)`; an entry left with none goes.
pub fn gutter_sign_clear_kind(mut w: Win, lo: int, hi: int, kind: int) {
    if lo >= hi || kind < 0 || kind >= SIGN_NKIND {
        return
    }
    var at = sign_lower_bound(w.signs, lo)
    let keep = 7 - pow2_small(kind)
    while at < w.signs.v.len && w.signs.v[at].line < hi {
        w.signs.v[at].mask = w.signs.v[at].mask & keep
        if w.signs.v[at].mask != 0 {
            at += 1
            continue
        }
        signs_cut(mut w.signs, at, at + 1)
    }
}

/// `yew_gutter_signs_free` (`gutter.c:158-164`): the table emptied.
pub fn gutter_signs_free(mut w: Win) {
    (mut w.signs.v).reset()
}

/// The entries in window `w`'s sign table (C's `gutter_signs.len`).
pub fn gutter_signs_len(w: Win) -> int {
    w.signs.v.len
}

fn decimal_digits(v_in: int) -> int {
    var v = v_in
    var d = 1
    while v >= 10 {
        v = v / 10
        d += 1
    }
    d
}

/// `yew_gutter_width_for` (`gutter.c:210-219`): two sign cells, at least
/// three digits, one space.
pub fn gutter_width_for(line_count: int, style: int) -> int {
    let _ = style
    var digits = decimal_digits(if line_count == 0 then 1 else line_count)
    if digits < 3 {
        digits = 3
    }
    GUTTER_SIGN_COLS + digits + 1
}

/// `yew_gutter_number` (`gutter.c:229-265`): the number text of `line`
/// with the cursor on `cursor_line`; empty on a continuation row or with
/// numbers off.
pub fn gutter_number(style: int, line: int, cursor_line: int, continuation: bool) -> str {
    if continuation || style == NUM_NONE {
        return ""
    }
    let v = if style == NUM_ABS {
        line + 1
    } else if style == NUM_REL {
        if line >= cursor_line then line - cursor_line else cursor_line - line
    } else if line == cursor_line {
        line + 1
    } else if line > cursor_line {
        line - cursor_line
    } else {
        cursor_line - line
    }
    "{v}"
}

// `sign_pick` (`gutter.c:166-177`): window `w`'s sign of `kind` on `line`.
fn sign_pick(w: Win, line: int, kind: int) -> (bool, GutterSign) {
    let at = sign_lower_bound(w.signs, line)
    if at >= w.signs.v.len ||
        w.signs.v[at].line != line ||
        w.signs.v[at].mask & pow2_small(kind) == 0 {
        return (false, gutter_sign_none())
    }
    (true, copy w.signs.v[at].sign[kind])
}

fn pow2_small(k: int) -> int {
    if k == 0 then 1 else if k == 1 then 2 else 4
}

// `draw_sign` (`gutter.c:179-197`).
fn draw_sign(mut ed: Ed, row: int, col: int, has: bool, sign: GutterSign, base: term.Cell) {
    if !has || col >= ed.grid.cols {
        return
    }
    var fg = copy base.fg
    var bg = copy base.bg
    var attrs = base.attrs
    if sign.role.len != 0 {
        let (ok, role) = theme_ui(ed.theme, sign.role, theme_rendition_of(ed.render))
        if ok {
            if role.fg.tag != term.COLOR_DEFAULT {
                fg = copy role.fg
            }
            if role.bg.tag != term.COLOR_DEFAULT {
                bg = copy role.bg
            }
            attrs = attrs | role.attrs
        }
    }
    attrs = attrs | sign.attrs
    let _ = term.grid_put(mut ed.grid, row, col, sign.glyph, 0, sign.glyph.len, fg, bg, attrs)
}

/// `yew_gutter_draw` (`gutter.c:267-367`): window `wi`'s gutter rows
/// `[lo, hi)`.
pub fn gutter_draw(mut ed: Ed, wi: int, lo: int, hi_in: int) {
    let bi = ed.wins[wi].buf
    var width = ed.wins[wi].gutter_width
    let rx = ed.wins[wi].rect.x
    let grid_col = if rx >= width then rx - width else 0
    if grid_col >= ed.grid.cols {
        return
    }
    if width > ed.grid.cols - grid_col {
        width = ed.grid.cols - grid_col
    }
    if width == 0 || lo >= hi_in {
        return
    }
    let p = ed.wins[wi].cs.primary
    let cpos = ed.wins[wi].cs.curs[p].pos
    let cursor_line = text.textbuf_line_of(ed.bufs[bi].ec.tb, cpos as text.ByteOff) as int
    let r = theme_rendition_of(ed.render)
    let (has_gutter, gutter) = theme_ui(ed.theme, "gutter", r)
    let (has_gcur, gutter_cursor) = theme_ui(ed.theme, "gutter.cursor", r)
    var blank = copy ed.grid.blank
    if has_gutter {
        if gutter.fg.tag != term.COLOR_DEFAULT {
            blank.fg = copy gutter.fg
        }
        if gutter.bg.tag != term.COLOR_DEFAULT {
            blank.bg = copy gutter.bg
        }
        blank.attrs = gutter.attrs
    }
    let number_width = if width > GUTTER_SIGN_COLS + 1 then width - GUTTER_SIGN_COLS - 1 else 0
    let hi = if hi_in > ed.wins[wi].rect.h then ed.wins[wi].rect.h else hi_in
    var row = lo
    while row < hi {
        let grid_row = ed.wins[wi].rect.y + row
        if grid_row >= ed.grid.rows {
            break
        }
        term.grid_fill(mut ed.grid, grid_row, grid_col, grid_col + width, copy blank)
        let (ok, line, sub) = vp_line_of_row(mut ed.wins[wi], ed.bufs[bi].ec.tb, row)
        if ok {
            let (hd, diag) = sign_pick(ed.wins[wi], line, SIGN_DIAG)
            let (hg, git) = sign_pick(ed.wins[wi], line, SIGN_GIT)
            let (hs, shadow) = sign_pick(ed.wins[wi], line, SIGN_SHADOW)
            if hd {
                draw_sign(mut ed, grid_row, grid_col, true, copy diag, copy blank)
            } else {
                draw_sign(mut ed, grid_row, grid_col, hg, copy git, copy blank)
            }
            if width > 1 {
                if hd && hg {
                    draw_sign(mut ed, grid_row, grid_col + 1, true, git, copy blank)
                } else {
                    draw_sign(mut ed, grid_row, grid_col + 1, hs, shadow, copy blank)
                }
            }
            if number_width != 0 {
                let number = gutter_number(ed.wins[wi].number_style, line, cursor_line, sub != 0)
                var len = number.len
                if len > number_width {
                    len = number_width
                }
                if len != 0 {
                    let use_cursor = line == cursor_line && sub == 0 && has_gcur
                    var fg = copy blank.fg
                    var bg = copy blank.bg
                    var attrs = blank.attrs
                    if use_cursor || has_gutter {
                        let ns = if use_cursor then copy gutter_cursor else copy gutter
                        if ns.fg.tag != term.COLOR_DEFAULT {
                            fg = copy ns.fg
                        }
                        if ns.bg.tag != term.COLOR_DEFAULT {
                            bg = copy ns.bg
                        }
                        attrs = ns.attrs
                    }
                    let col = grid_col + GUTTER_SIGN_COLS + number_width - len
                    let nb = bytes_of(number)
                    let _ = term.grid_puts(mut ed.grid, grid_row, col, nb, 0, len, fg, bg, attrs)
                }
            }
        }
        row += 1
    }
}
