//! edit.gutter — the line-number gutter and its sign column.
//!
//! Ports sagitta `src/ui/gutter.c` (367 lines) and `ui/gutter.h` (64) at
//! 9ace98c2, under `s15-viewport-statusline.md` §4. The signs
//! (`yew_gutter_sign_set` and its clears) are written by later campaigns
//! (diagnostics yw11, git yw13, shadow yw11); campaign 03 draws them.

use term
use text

/// `YEW_GUTTER_SIGN_COLS` (`gutter.h:20`): the two sign cells always
/// reserved.
pub const GUTTER_SIGN_COLS: int = 2

/// A diagnostic sign (`SignKind`, `gutter.h:22-27`).
pub const SIGN_DIAG: int = 0

/// A git hunk sign.
pub const SIGN_GIT: int = 1

/// A shadow-completion sign.
pub const SIGN_SHADOW: int = 2

/// The sign-kind count.
pub const SIGN_NKIND: int = 3

/// `GutterSign` (`gutter.h:29-34`): C borrows the glyph bytes and role
/// name; the port owns a copy.
pub struct GutterSign {
    glyph: List[byte],
    role: str,
    attrs: int,
}

/// `GutterSignLine` (`gutter.h:36-40`): one line's signs, one per kind,
/// `mask` the kinds present.
pub struct GutterSignLine {
    line: int,
    sign: List[GutterSign],
    mask: int,
}

/// `GutterSigns` (`gutter.h:42-46`), sorted by line.
pub struct GutterSigns {
    v: List[GutterSignLine],
}

/// No signs.
pub fn gutter_signs_new() -> GutterSigns {
    GutterSigns { v: List[GutterSignLine]() }
}

fn decimal_digits(v_in: int) -> int {
    var v = v_in
    var d = 1
    while v >= 10 {
        v = v / 10
        d += 1
    }
    d
}

/// `yew_gutter_width_for` (`gutter.c:210-219`): two sign cells, at least
/// three digits, one space.
pub fn gutter_width_for(line_count: int, style: int) -> int {
    let _ = style
    var digits = decimal_digits(if line_count == 0 then 1 else line_count)
    if digits < 3 {
        digits = 3
    }
    GUTTER_SIGN_COLS + digits + 1
}

/// `yew_gutter_number` (`gutter.c:229-265`): the number text of `line`
/// with the cursor on `cursor_line`; empty on a continuation row or with
/// numbers off.
pub fn gutter_number(style: int, line: int, cursor_line: int, continuation: bool) -> str {
    if continuation || style == NUM_NONE {
        return ""
    }
    let v = if style == NUM_ABS {
        line + 1
    } else if style == NUM_REL {
        if line >= cursor_line then line - cursor_line else cursor_line - line
    } else if line == cursor_line {
        line + 1
    } else if line > cursor_line {
        line - cursor_line
    } else {
        cursor_line - line
    }
    "{v}"
}

// `sign_pick` (`gutter.c:166-177`): window `w`'s sign of `kind` on `line`.
fn sign_pick(w: Win, line: int, kind: int) -> (bool, GutterSign) {
    for sl in w.signs.v {
        if sl.line == line && sl.mask & pow2_small(kind) != 0 {
            return (true, copy sl.sign[kind])
        }
    }
    (false, GutterSign { glyph: List[byte](), role: "", attrs: 0 })
}

fn pow2_small(k: int) -> int {
    if k == 0 then 1 else if k == 1 then 2 else 4
}

// `draw_sign` (`gutter.c:179-197`).
fn draw_sign(mut ed: Ed, row: int, col: int, has: bool, sign: GutterSign, base: term.Cell) {
    if !has || col >= ed.grid.cols {
        return
    }
    var fg = copy base.fg
    var bg = copy base.bg
    var attrs = base.attrs
    if sign.role.len != 0 {
        let (ok, role) = theme_ui(ed.theme, sign.role, theme_rendition_of(ed.render))
        if ok {
            if role.fg.tag != term.COLOR_DEFAULT {
                fg = copy role.fg
            }
            if role.bg.tag != term.COLOR_DEFAULT {
                bg = copy role.bg
            }
            attrs = attrs | role.attrs
        }
    }
    attrs = attrs | sign.attrs
    let _ = term.grid_put(mut ed.grid, row, col, sign.glyph, 0, sign.glyph.len, fg, bg, attrs)
}

/// `yew_gutter_draw` (`gutter.c:267-367`): window `wi`'s gutter rows
/// `[lo, hi)`.
pub fn gutter_draw(mut ed: Ed, wi: int, lo: int, hi_in: int) {
    let bi = ed.wins[wi].buf
    var width = ed.wins[wi].gutter_width
    let rx = ed.wins[wi].rect.x
    let grid_col = if rx >= width then rx - width else 0
    if grid_col >= ed.grid.cols {
        return
    }
    if width > ed.grid.cols - grid_col {
        width = ed.grid.cols - grid_col
    }
    if width == 0 || lo >= hi_in {
        return
    }
    let p = ed.wins[wi].cs.primary
    let cpos = ed.wins[wi].cs.curs[p].pos
    let cursor_line = text.textbuf_line_of(ed.bufs[bi].ec.tb, cpos as text.ByteOff) as int
    let r = theme_rendition_of(ed.render)
    let (has_gutter, gutter) = theme_ui(ed.theme, "gutter", r)
    let (has_gcur, gutter_cursor) = theme_ui(ed.theme, "gutter.cursor", r)
    var blank = copy ed.grid.blank
    if has_gutter {
        if gutter.fg.tag != term.COLOR_DEFAULT {
            blank.fg = copy gutter.fg
        }
        if gutter.bg.tag != term.COLOR_DEFAULT {
            blank.bg = copy gutter.bg
        }
        blank.attrs = gutter.attrs
    }
    let number_width = if width > GUTTER_SIGN_COLS + 1 then width - GUTTER_SIGN_COLS - 1 else 0
    let hi = if hi_in > ed.wins[wi].rect.h then ed.wins[wi].rect.h else hi_in
    var row = lo
    while row < hi {
        let grid_row = ed.wins[wi].rect.y + row
        if grid_row >= ed.grid.rows {
            break
        }
        term.grid_fill(mut ed.grid, grid_row, grid_col, grid_col + width, copy blank)
        let (ok, line, sub) = vp_line_of_row(mut ed.wins[wi], ed.bufs[bi].ec.tb, row)
        if ok {
            let (hd, diag) = sign_pick(ed.wins[wi], line, SIGN_DIAG)
            let (hg, git) = sign_pick(ed.wins[wi], line, SIGN_GIT)
            let (hs, shadow) = sign_pick(ed.wins[wi], line, SIGN_SHADOW)
            if hd {
                draw_sign(mut ed, grid_row, grid_col, true, copy diag, copy blank)
            } else {
                draw_sign(mut ed, grid_row, grid_col, hg, copy git, copy blank)
            }
            if width > 1 {
                if hd && hg {
                    draw_sign(mut ed, grid_row, grid_col + 1, true, git, copy blank)
                } else {
                    draw_sign(mut ed, grid_row, grid_col + 1, hs, shadow, copy blank)
                }
            }
            if number_width != 0 {
                let number = gutter_number(ed.wins[wi].number_style, line, cursor_line, sub != 0)
                var len = number.len
                if len > number_width {
                    len = number_width
                }
                if len != 0 {
                    let use_cursor = line == cursor_line && sub == 0 && has_gcur
                    var fg = copy blank.fg
                    var bg = copy blank.bg
                    var attrs = blank.attrs
                    if use_cursor || has_gutter {
                        let ns = if use_cursor then copy gutter_cursor else copy gutter
                        if ns.fg.tag != term.COLOR_DEFAULT {
                            fg = copy ns.fg
                        }
                        if ns.bg.tag != term.COLOR_DEFAULT {
                            bg = copy ns.bg
                        }
                        attrs = ns.attrs
                    }
                    let col = grid_col + GUTTER_SIGN_COLS + number_width - len
                    let nb = bytes_of(number)
                    let _ = term.grid_puts(mut ed.grid, grid_row, col, nb, 0, len, fg, bg, attrs)
                }
            }
        }
        row += 1
    }
}
