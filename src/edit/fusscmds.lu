/// `ed.git.tree.all` (`fussmode.c:4404-4421`).
pub fn fuss_cmd_tree_all(mut ed: Ed, _cx: CmdCtx) -> int {
    if !ed.fuss.active {
        return CMD_ERR_STATE
    }
    ed.fuss.opts.all_files = !ed.fuss.opts.all_files
    let _ = state_option_bool_set(mut ed, "git.tree.all_files", ed.fuss.opts.all_files)
    let live = git_snapshot(mut ed)
    fuss_build(mut ed, live, true)
    fuss_walk_restart(mut ed)
    ed_msg(
        mut ed,
        MSG_INFO,
        "all-files tree {if ed.fuss.opts.all_files then "enabled" else "disabled"}",
    )
    CMD_OK
}

