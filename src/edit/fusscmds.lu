    if has {
        return fuss_spawn0(mut ed, "switch", fc_argv(["switch", "--", name]))
    }
    fuss_pick_branches(mut ed, FUSS_PICK_BRANCH_SWITCH)
}

/// `ed.git.branch.create` (`fussmode.c:4751-4775`).
pub fn fuss_cmd_branch_create(mut ed: Ed, cx: CmdCtx) -> int {
    let (has, name) = fc_sarg(cx)
    if has {
        if name.starts_with("-") {
            ed_msg(mut ed, MSG_ERROR, "branch name must not begin with '-'")
            return CMD_ERR_ARG
        }
        return fuss_spawn0(mut ed, "switch-create", fc_argv(["switch", "-c", name]))
    }
    fuss_prompt(mut ed, FUSS_PROMPT_BRANCH_CREATE, "", "", false, "new branch name")
}

