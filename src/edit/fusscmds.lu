// `fuss_open_path` (`fussmode.c:4617-4670`): a directory toggles; a file
// opens in its tab leaving F mode (`leave`), or is shown in the viewer.
fn fuss_open_path(mut ed: Ed, cx: CmdCtx, leave: bool) -> int {
    let row = git.fuss_row_of(ed.fuss.tree, ed.fuss.sel)
    let is_dir = row >= 0 &&
        row < ed.fuss.tree.items.len &&
        ed.fuss.tree.items[row].node < ed.fuss.tree.nodes.len &&
        !ed.fuss.tree.nodes[ed.fuss.tree.items[row].node].is_file
    if !cx.has_sarg && is_dir {
        return fuss_cmd_nav_toggle(mut ed, cx)
    }
    let (ok, path) = fuss_selected_path(ed, cx)
    if !ok {
        return CMD_ERR_ARG
    }
    let (pass, _) = fuss_target_guard(
        mut ed,
        path,
        FUSS_TARGET_FILE,
        if leave then "open" else "view",
    )
    if !pass {
        return CMD_ERR_STATE
    }
    let (jok, absolute) = fuss_join_root(ed, path)
    if !jok {
        return CMD_ERR_ARG
    }
    let bi = ws_file_buf(mut ed, absolute)
    if bi < 0 {
        return CMD_ERR_IO
    }
    let was_resident = ed.bufs[bi].resident
    if buf_hydrate(mut ed, bi) != 0 {
        return CMD_ERR_IO
    }
    if !was_resident {
        ed_hook_buffer(mut ed, fl.FL_EV_BUF_OPEN, bi)
    }
    if leave {
        fuss_viewer_close(mut ed)
        let tab = tab_open(mut ed, ed.bufs[bi].path)
        if tab < 0 {
            return CMD_ERR_STATE
        }
        if mode_enter(mut ed, MODE_L) != CMD_OK {
            return CMD_ERR_STATE
        }
        tab_switch(mut ed, tab)
        return CMD_OK
    }
    if fuss_show_buffer(mut ed, bi) then CMD_OK else CMD_ERR_STATE
}

/// `ed.git.view`.
pub fn fuss_cmd_view(mut ed: Ed, cx: CmdCtx) -> int {
    fuss_open_path(mut ed, cx, false)
}

/// `ed.git.open`.
pub fn fuss_cmd_open(mut ed: Ed, cx: CmdCtx) -> int {
    fuss_open_path(mut ed, cx, true)
}

// `fuss_open_split` (`fussmode.c:4674-4718`).
fn fuss_open_split(mut ed: Ed, cx: CmdCtx, dir: int) -> int {
    if !pane_live(ed, ed.focus) {
        return CMD_ERR_STATE
    }
    let (ok, path) = fuss_selected_path(ed, cx)
    if !ok {
        return CMD_ERR_ARG
    }
    let (pass, _) = fuss_target_guard(mut ed, path, FUSS_TARGET_FILE, "open split")
    if !pass {
        return CMD_ERR_STATE
    }
    let (jok, absolute) = fuss_join_root(ed, path)
    if !jok {
        return CMD_ERR_ARG
    }
    let bi = ws_file_buf(mut ed, absolute)
    if bi < 0 {
        return CMD_ERR_IO
    }
    let was_resident = ed.bufs[bi].resident
    if buf_hydrate(mut ed, bi) != 0 {
        return CMD_ERR_IO
    }
    if !was_resident {
        ed_hook_buffer(mut ed, fl.FL_EV_BUF_OPEN, bi)
    }
    let leaf = ed.focus
    let split = pane_split(mut ed, leaf, dir)
    if split < 0 {
        ed_msg(mut ed, MSG_ERROR, "no room to split")
        return CMD_ERR_STATE
    }
    let w = ed.panes[split].win
    ed_win_set_buffer(mut ed, w, bi)
    fuss_windows_changed(mut ed)
    pane_refocus(mut ed, split)
    if mode_enter(mut ed, MODE_L) != CMD_OK {
        return CMD_ERR_STATE
    }
    CMD_OK
}

/// `ed.git.open_split_h`.
pub fn fuss_cmd_open_split_h(mut ed: Ed, cx: CmdCtx) -> int {
    fuss_open_split(mut ed, cx, SPLIT_H)
}

/// `ed.git.open_split_v`.
pub fn fuss_cmd_open_split_v(mut ed: Ed, cx: CmdCtx) -> int {
    fuss_open_split(mut ed, cx, SPLIT_V)
}

fn fc_sarg(cx: CmdCtx) -> (bool, str) {
    if cx.has_sarg && cx.sarg.len != 0 {
        for b in cx.sarg.bytes() {
            if b as int == 0 {
                return (false, "")
            }
        }
        return (true, cx.sarg)
    }
    (false, "")
}

/// `ed.git.branch.switch` (`fussmode.c:4730-4749`).
pub fn fuss_cmd_branch_switch(mut ed: Ed, cx: CmdCtx) -> int {
