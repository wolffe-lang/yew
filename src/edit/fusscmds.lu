/// `ed.git.copy_path` (`fussmode.c:5050-5080`): the captured or selected
/// path into register `+` (no repository needed).
pub fn fuss_cmd_copy_path(mut ed: Ed, cx: CmdCtx) -> int {
    let (ok, path) = fuss_selected_path(ed, cx)
    if !ok {
        ed_msg(mut ed, MSG_ERROR, "no path is selected")
        return CMD_ERR_ARG
    }
    var v = text.regval_new()
    v.bytes = fc_bytes(path)
    v.kind = text.REG_CHARWISE
    text.reg_yank(mut ed.regs, '+' as int, v)
    ed_msg(mut ed, MSG_INFO, "copied {path}")
    CMD_OK
}
