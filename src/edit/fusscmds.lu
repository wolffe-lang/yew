/// `ed.git.nav.toggle` (`fussmode.c:4449-4480`): a directory opens or
/// closes in the manual memory; one kept open by an open file says so.
pub fn fuss_cmd_nav_toggle(mut ed: Ed, _cx: CmdCtx) -> int {
    if !ed.fuss.active {
        return CMD_ERR_STATE
    }
    let row = git.fuss_row_of(ed.fuss.tree, ed.fuss.sel)
    if row < 0 ||
        row >= ed.fuss.tree.items.len ||
        ed.fuss.tree.items[row].node >= ed.fuss.tree.nodes.len {
        return CMD_OK
    }
    let n = copy ed.fuss.tree.nodes[ed.fuss.tree.items[row].node]
    if n.is_file {
        return CMD_OK
    }
    if fuss_expand_start(mut ed) {
        return CMD_OK
    }
    let p = git.fuss_item_path(ed.fuss.tree, row)
    let remembered = git.fuss_open_memory_has(ed.fuss.manual_open, p, 0, p.len)
    if n.expanded && !remembered {
        ed_msg(mut ed, MSG_INFO, "kept open: contains an open file")
        return CMD_OK
    }
    let _ = git.fuss_open_memory_set(mut ed.fuss.manual_open, p, 0, p.len, !n.expanded)
    fuss_apply_effective(mut ed)
    let r = git.fuss_row_of(ed.fuss.tree, ed.fuss.sel)
    git.fuss_sel_from_row(mut ed.fuss.sel, ed.fuss.tree, r)
    ed.fuss.draw_dirty = true
    ed.footer_dirty = true
    CMD_OK
}

/// `ed.git.jump.arm` (`fussmode.c:4482-4491`).
pub fn fuss_cmd_jump_arm(mut ed: Ed, _cx: CmdCtx) -> int {
    if !ed.fuss.active {
        return CMD_ERR_STATE
    }
    fuss_jump_arm(mut ed.fuss, now_ms())
    ed.footer_dirty = true
    CMD_OK
}

