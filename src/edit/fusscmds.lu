/// `ed.git.push` (`fussmode.c:4536-4548`): a branch with no upstream
/// picks its remote first.
pub fn fuss_cmd_push(mut ed: Ed, _cx: CmdCtx) -> int {
    let live = git_snapshot(mut ed)
    if ed.git.snap[live].has_branch &&
        (!ed.git.snap[live].has_upstream || ed.git.snap[live].upstream_len == 0) {
        return fuss_pick_remotes(mut ed)
    }
    fuss_spawn0(mut ed, "push", fc_argv(["push"]))
}

