/// `ed.git.reset` (`fussmode.c:4823-4857`): `[soft |mixed |hard ]REF`.
pub fn fuss_cmd_reset(mut ed: Ed, cx: CmdCtx) -> int {
    let (has, value) = fc_sarg(cx)
    if has {
        var mode = "--mixed"
        var r = value
        if value.len > 5 && value.starts_with("soft ") {
            mode = "--soft"
            r = value[5..value.len]
        } else if value.len > 6 && value.starts_with("mixed ") {
            r = value[6..value.len]
        } else if value.len > 5 && value.starts_with("hard ") {
            mode = "--hard"
            r = value[5..value.len]
        }
        if r.len == 0 {
            return CMD_ERR_ARG
        }
        return fuss_spawn0(mut ed, "reset", fc_argv(["reset", mode, r]))
    }
    fuss_pick_commits(mut ed, FUSS_PICK_RESET_COMMIT, "", false)
}

