//! edit.macrolib — the macro library (Sprint 38): sagitta 9ace98c2
//! src/fl/macrolib.c:1-936 and macrolib.h:1-72.
//!
//! s38-macrolib: until the library lands in this lane, a named replay
//! refuses by name.

/// `yew_macrolib_enable` (macrolib.h): the library armed after the first
/// configuration load (flconf.c:627).
pub fn macrolib_enable(mut ed: Ed) { ed.footer_dirty = ed.footer_dirty }

/// `yew_macrolib_scan` (macrolib.h): the library rescanned after a reload
/// (flconf.c:672).
pub fn macrolib_scan(mut ed: Ed) { ed.footer_dirty = ed.footer_dirty }

/// `yew_macrolib_option_changed` (macrolib.h): `macro.dir` moved.
pub fn macrolib_option_changed(mut ed: Ed) { ed.footer_dirty = ed.footer_dirty }

/// `yew_macrolib_call` (macrolib.h): a library macro replayed by name.
pub fn macrolib_call(mut ed: Ed, name: str) -> int {
    ed_msg(mut ed, MSG_ERROR, "not yet ported: macro library call {name}: sagitta Sprint 38 (yw09)")
    CMD_ERR_DEFERRED
}
