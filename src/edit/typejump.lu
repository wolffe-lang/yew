//! edit.typejump — type-to-jump, for lists that cannot carry a filter
//! line.
//!
//! Ports sagitta `src/ui/typejump.c` (105 lines) and `ui/typejump.h` (63)
//! at 9ace98c2, under `s26-fuzzy-finder.md` §8. The four rules
//! (`typejump.h:9-30`): a printable key INSIDE the 500 ms window appends,
//! after it REPLACES (`s`, pause, `s` is "the next thing starting with
//! s"); the hint expires on its own; an EXACT match under the cursor stays
//! put (fuss's rule — `README` on `README` never jumps to `README.md`);
//! a non-printable or modified key clears FIRST and is not consumed, so
//! the host list keeps its own bindings.
//!
//! At the pin the "deadline" is a timestamp the next key and
//! `typejump_active` compare against (`typejump.c:22-25`, `:69-75`), not a
//! timer-heap entry, and no production code calls `yew_typejump_key`:
//! FUSS keeps its own jump (`fussmode.c:310-391`, Sprint 52, yw13) and
//! s24's group picker has none (the C witness W4,
//! `notes/yw06-evidence/pick/witness/c-witness.log`). The port is C's
//! engine with C's clock argument (R-yw06-P1), ready for the host that
//! arrives with FUSS.
//!
//! The port's shapes: C's `char pat[64]` is a byte list made once and
//! written in place; C's `u32 *sel` in/out is passed in and answered
//! beside "consumed". C's NULL rows (`test_typejump.c:279-285`) have no
//! wolf shape.

use term
use ws

/// `YEW_TYPEJUMP_RESET_MS` (`typejump.h:36`).
pub const TYPEJUMP_RESET_MS: int = 500

/// `YEW_TYPEJUMP_PAT_MAX` (`typejump.h:38-40`).
pub const TYPEJUMP_PAT_MAX: int = 64

/// `TypeJump` (`typejump.h:42-46`).
pub struct TypeJump {
    pat: List[byte],
    len: int,
    deadline_ms: int,
}

/// A cleared jump (`yew_typejump_clear` on fresh storage).
pub fn typejump_new() -> TypeJump {
    var tj = TypeJump { pat: List[byte](), len: 0, deadline_ms: 0 }
    var i = 0
    while i < TYPEJUMP_PAT_MAX {
        (mut tj.pat).push(0 as byte)
        i += 1
    }
    tj
}

/// `yew_typejump_clear` (`typejump.c:13-20`).
pub fn typejump_clear(mut tj: TypeJump) {
    tj.len = 0
    tj.pat[0] = 0 as byte
    tj.deadline_ms = 0
}

/// `yew_typejump_active` (`typejump.c:22-25`): a pattern accumulating,
/// for the status hint; false from the deadline on with no key.
pub fn typejump_active(tj: TypeJump, now_ms: int) -> bool {
    tj.len > 0 && now_ms < tj.deadline_ms
}

// `printable` (`typejump.c:33-41`): one byte of text, no modifier, not a
// control byte.
fn tj_printable(key: term.Key) -> bool {
    if key.text.len != 1 {
        return false
    }
    let mods = term.MOD_CTRL | term.MOD_ALT | term.MOD_SUPER | term.MOD_HYPER | term.MOD_META
    if key.mods & mods != 0 {
        return false
    }
    key.text[0] as int >= 32 && key.text[0] as int != 127
}

/// `yew_typejump_key` (`typejump.c:43-105`): consumes a printable key,
/// moving the selection `sel` of `n` of `items` to the best match;
/// answers (consumed, the selection). Not consumed: a non-printable key
/// (the state cleared first) or an empty list.
pub fn typejump_key(
    mut tj: TypeJump,
    key: term.Key,
    now_ms: int,
    items: List[PickItem],
    n: int,
    sel: int,
) -> (bool, int) {
    if !tj_printable(key) {
        typejump_clear(mut tj)
        return (false, sel)
    }
    if n == 0 || items.len == 0 {
        return (false, sel)
    }
    // Rule 1: outside the window the key REPLACES.
    if tj.len == 0 || now_ms >= tj.deadline_ms {
        tj.len = 0
    }
    if tj.len + 1 < TYPEJUMP_PAT_MAX {
        tj.pat[tj.len] = key.text[0]
        tj.len += 1
        tj.pat[tj.len] = 0 as byte
    }
    tj.deadline_ms = now_ms + TYPEJUMP_RESET_MS
    // Rule 3, BEFORE ranking: an exact match under the cursor stays put.
    if sel >= 0 && sel < n && sel < items.len {
        let label = items[sel].label
        let here = ws.fz_score(tj.pat, 0, tj.len, label.bytes(), 0, label.len)
        if here >= 10000 {
            return (true, sel)
        }
    }
    // path_mode false: list labels, never their last segment.
    var labels = List[List[byte]]()
    var i = 0
    while i < n && i < items.len {
        var b = List[byte]()
        for x in items[i].label.bytes() {
            (mut b).push(x)
        }
        (mut labels).push(b)
        i += 1
    }
    let ranked = ws.fz_rank(tj.pat, 0, tj.len, labels, false)
    if ranked.len > 0 {
        return (true, ranked[0].idx)
    }
    (true, sel)
}
