//! edit.runtime — where the runtime files come from.
//!
//! Ports sagitta `src/util/runtime_asset.c`'s root decision
//! (`yew_runtime_root`, `yew_runtime_file`, `runtime_asset.c:253-349`)
//! and the theme discovery (`discover_path`, `syn/theme.c:916-971`):
//! `$YEW_RUNTIME_DIR` when set (the only directory then), else the install
//! prefix (`/usr/local/share/yew/runtime`) when its `init.fl` is identical
//! to this build's embedded init (R-yw09b-1 A),
//! else `./runtime`. C's default build embeds nothing (`EMBED_RUNTIME=0`);
//! the port always carries the copies `tools/gen-runtime` embeds
//! (`runtime_blob.lu`) and falls back to them where C would find no file,
//! so the editor starts anywhere, PAX included (track rule 7). Unlike C's
//! runtime_asset.c:283-310, a readable but skewed prefix selects ONLY the
//! embedded copies: the shared prefix may belong to a newer C build.
//! The explicit override still wins, as C's does.

use util

/// C's `YEW_RUNTIME_DIR_DEFAULT` for `PREFIX=/usr/local`.
pub const RUNTIME_PREFIX: str = "/usr/local/share/yew/runtime"

fn readable(path: str) -> bool {
    let _ = fs_read_bytes(path) else |_| {
        return false
    }
    true
}

/// The oracle this build's embedded runtime belongs to (sagitta.pin).
pub const RUNTIME_PIN: str = "9ace98c2adfeb9d63e7da4bdb4fd6e29ae5c3e4a"

// Compare every byte, including a final newline. No hash collision admits skew.
fn runtime_prefix_identity(prefix: str) -> (bool, bool) {
    let bytes = fs_read_bytes("{prefix}/init.fl") else { return (false, false) }
    let (ok, embedded) = runtime_embedded("init.fl")
    if !ok || bytes.len != embedded.len { return (true, false) }
    for i in 0..bytes.len {
        if bytes[i] != embedded.bytes()[i] { return (true, false) }
    }
    (true, true)
}

/// The startup notice; the config owner emits it once per editor, not per asset.
pub fn runtime_skew_warning_at(prefix0: str) -> str {
    let env = env_get("YEW_RUNTIME_DIR") else ""
    if env.len != 0 { return "" }
    let prefix = if prefix0.len == 0 then RUNTIME_PREFIX else prefix0
    let (found, identical) = runtime_prefix_identity(prefix)
    if !found || identical { return "" }
    "runtime at {prefix} is not this build's (sagitta {RUNTIME_PIN}); using the built-in runtime"
}

/// Read runtime file `relative`: answers (found, bytes, the path or
/// `<embedded>`). Completion specs, init and themes share the root decision.
pub fn runtime_read(relative: str) -> (bool, List[byte], str) {
    let (kind, dir) = runtime_root_at("")
    if kind == RUNTIME_ROOT_ENV || kind == RUNTIME_ROOT_PREFIX || kind == RUNTIME_ROOT_SOURCE {
        let path = "{dir}/{relative}"
        let bytes = fs_read_bytes(path) else {
            if kind == RUNTIME_ROOT_ENV { return (false, List[byte](), path) }
            List[byte]()
        }
        if kind == RUNTIME_ROOT_ENV || bytes.len != 0 { return (true, bytes, path) }
    }
    let (ok, text) = runtime_embedded(relative)
    if !ok {
        return (false, List[byte](), relative)
    }
    var out = List[byte]()
    for b in text.bytes() {
        (mut out).push(b)
    }
    (true, out, "<embedded>")
}

/// The theme `name`'s source (`discover_path`, `theme.c:916-971`):
/// `$XDG_CONFIG_HOME/yew/themes/NAME.fl` first, then the runtime's.
pub fn runtime_theme(name: str) -> (bool, List[byte], str) {
    let config = util.xdg_config_dir() else ""
    if config.len != 0 {
        let path = "{config}/themes/{name}.fl"
        let bytes = fs_read_bytes(path) else List[byte]()
        if bytes.len != 0 {
            return (true, bytes, path)
        }
    }
    runtime_read("themes/{name}.fl")
}

/// `YEW_RUNTIME_ROOT_ENV`: `$YEW_RUNTIME_DIR`, the only directory then.
pub const RUNTIME_ROOT_ENV: int = 0

/// `YEW_RUNTIME_ROOT_PREFIX`: the install prefix, its `init.fl` identical.
pub const RUNTIME_ROOT_PREFIX: int = 1

/// `YEW_RUNTIME_ROOT_SOURCE`: an uninstalled build's `./runtime`.
pub const RUNTIME_ROOT_SOURCE: int = 2

/// `YEW_RUNTIME_ROOT_EMBEDDED`: the copies `tools/gen-runtime` embeds.
pub const RUNTIME_ROOT_EMBEDDED: int = 3

/// `YEW_RUNTIME_ROOT_NONE`: no runtime at all.
pub const RUNTIME_ROOT_NONE: int = 4

/// `yew_runtime_root` (`runtime_asset.c:283-310`) with the install prefix
/// given (`prefix` "" is the compiled one, C's `yew_runtime_prefix_dir`
/// unless a test replaced it): `(kind, directory)`. The completion specs
/// read it (yw04) so a shipped spec comes from where `init.fl` came from,
/// never a second search.
pub fn runtime_root_at(prefix0: str) -> (int, str) {
    let env = env_get("YEW_RUNTIME_DIR") else ""
    if env.len != 0 {
        return (RUNTIME_ROOT_ENV, env)
    }
    let prefix = if prefix0.len == 0 then RUNTIME_PREFIX else prefix0
    let (found, identical) = runtime_prefix_identity(prefix)
    if found {
        if identical { return (RUNTIME_ROOT_PREFIX, prefix) }
        return (RUNTIME_ROOT_EMBEDDED, "")
    }
    if readable("runtime/init.fl") {
        return (RUNTIME_ROOT_SOURCE, "runtime")
    }
    let (ok, _) = runtime_embedded("init.fl")
    if ok {
        return (RUNTIME_ROOT_EMBEDDED, "")
    }
    (RUNTIME_ROOT_NONE, "")
}
