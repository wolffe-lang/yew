//! edit.runtime — where the runtime files come from.
//!
//! Ports sagitta `src/util/runtime_asset.c`'s root decision
//! (`yew_runtime_root`, `yew_runtime_file`, `runtime_asset.c:253-349`)
//! and the theme discovery (`discover_path`, `syn/theme.c:916-971`):
//! `$YEW_RUNTIME_DIR` when set (the only directory then), else the install
//! prefix (`/usr/local/share/yew/runtime`) when its `init.fl` is readable,
//! else `./runtime`. C's default build embeds nothing (`EMBED_RUNTIME=0`);
//! the port always carries the copies `tools/gen-runtime` embeds
//! (`runtime_blob.lu`) and falls back to them where C would find no file,
//! so the editor starts anywhere, PAX included (track rule 7).

use util

/// C's `YEW_RUNTIME_DIR_DEFAULT` for `PREFIX=/usr/local`.
pub const RUNTIME_PREFIX: str = "/usr/local/share/yew/runtime"

fn readable(path: str) -> bool {
    let _ = fs_read_bytes(path) else |_| {
        return false
    }
    true
}

/// Read runtime file `relative`: answers (found, bytes, the path or
/// `<embedded>`).
pub fn runtime_read(relative: str) -> (bool, List[byte], str) {
    let env = env_get("YEW_RUNTIME_DIR") else ""
    if env.len != 0 {
        let path = "{env}/{relative}"
        let bytes = fs_read_bytes(path) else |_| {
            return (false, List[byte](), path)
        }
        return (true, bytes, path)
    }
    if readable("{RUNTIME_PREFIX}/init.fl") {
        let path = "{RUNTIME_PREFIX}/{relative}"
        let bytes = fs_read_bytes(path) else List[byte]()
        if bytes.len != 0 {
            return (true, bytes, path)
        }
    }
    let local = "runtime/{relative}"
    let lb = fs_read_bytes(local) else List[byte]()
    if lb.len != 0 {
        return (true, lb, local)
    }
    let (ok, text) = runtime_embedded(relative)
    if !ok {
        return (false, List[byte](), relative)
    }
    var out = List[byte]()
    for b in text.bytes() {
        (mut out).push(b)
    }
    (true, out, "<embedded>")
}

/// The theme `name`'s source (`discover_path`, `theme.c:916-971`):
/// `$XDG_CONFIG_HOME/yew/themes/NAME.fl` first, then the runtime's.
pub fn runtime_theme(name: str) -> (bool, List[byte], str) {
    let config = util.xdg_config_dir() else ""
    if config.len != 0 {
        let path = "{config}/themes/{name}.fl"
        let bytes = fs_read_bytes(path) else List[byte]()
        if bytes.len != 0 {
            return (true, bytes, path)
        }
    }
    runtime_read("themes/{name}.fl")
}
