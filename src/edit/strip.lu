//! edit.strip — the strip layout engine: entries to cell spans.
//!
//! Ports sagitta `src/ui/strip.c` (134 lines) and `ui/strip.h` (83) at
//! 9ace98c2, under `s23-tabs.md` §3 and `s57_15-strip-scrolling.md` §1:
//! ONE engine, reused verbatim by Sprint 24's row-2 member strip, so the
//! two rows cannot disagree about where a click landed. The engine
//! answers spans in CELLS; the renderer draws with them and registers
//! regions with them, never recomputing a position from a label's
//! length (the Sprint 22 law). `active < 0` means "do not follow": an
//! offset the user chose survives the render (s57.15 §1, `strip.h:42-
//! 64`). yw03's one-tab strip carried this placement inline in
//! `edit.tabs` (R-yw03-3); it is its own unit again here.

use unicode

/// `YEW_STRIP_LABEL_CELLS` (`strip.h:22-25`): labels clip here; a long
/// path should not eat the strip.
pub const STRIP_LABEL_CELLS: int = 24

/// `StripEntry.label`'s capacity (`strip.h:28`, `char label[64]`): every
/// label C builds with `snprintf` into it keeps at most 63 bytes.
pub const STRIP_LABEL_MAX: int = 64

/// A strip entry (`StripEntry`, `strip.h:27-32`): the label's bytes, the
/// payload a click answers (a tab index, or a negated group id), the dim
/// (orphan) and modified renditions.
pub struct StripEntry {
    label: List[byte],
    payload: int,
    dim: bool,
    modified: bool,
}

/// A placed entry (`StripSpan`, `strip.h:34-37`): the index into the
/// entry list and its half-open cell range.
pub struct StripSpan {
    idx: int,
    col0: int,
    col1: int,
}

/// What `strip_layout` answers (C's out-parameters, `strip.h:65-67`):
/// the spans, the first visible entry (`*scroll` written back) and the
/// two overflow flags.
pub struct StripLayout {
    spans: List[StripSpan],
    scroll: int,
    more_left: bool,
    more_right: bool,
}

/// `label` as C's `snprintf(out, 64, …)` leaves it: at most 63 bytes,
/// cut at the byte (C's truncation is byte-wise; the clipper below then
/// measures what is left).
pub fn strip_label_cap(label: List[byte]) -> List[byte] {
    if label.len < STRIP_LABEL_MAX {
        return copy label
    }
    var out = List[byte]()
    var i = 0
    while i < STRIP_LABEL_MAX - 1 {
        (mut out).push(label[i])
        i += 1
    }
    out
}

/// `yew_strip_label_cells` (`strip.c:11-27`): the cells a label occupies
/// once clipped — measured through the Sprint 2 clipper, which is the
/// only thing that knows a character can be two cells wide.
pub fn strip_label_cells(label: List[byte]) -> int {
    let (_, cells) = unicode.str_clip(label, 0, label.len, STRIP_LABEL_CELLS)
    if cells < 0 then 0 else cells
}

/// `yew_strip_label_bytes` (`strip.c:29-37`): the BYTES of the label that
/// fit those cells. A renderer draws this many and no more.
pub fn strip_label_bytes(label: List[byte]) -> int {
    let (bytes, _) = unicode.str_clip(label, 0, label.len, STRIP_LABEL_CELLS)
    bytes
}

/// No layout (an empty strip, a zero width), the first entry `scroll`.
fn layout_empty(scroll: int) -> StripLayout {
    StripLayout {
        spans: List[StripSpan](),
        scroll: scroll,
        more_left: false,
        more_right: false,
    }
}

/// `yew_strip_layout` (`strip.c:39-134`): lays `entries` left to right
/// into `width` cells from the first visible entry `scroll`, adjusting it
/// MINIMALLY to keep `active` visible (`active < 0`: no follow, the
/// offset is the user's — only clamped into range). An entry too wide
/// for the whole strip is placed clipped, so the strip always shows
/// something. C leaves `*scroll` untouched on an empty strip or a zero
/// width; so does this (the answer's `scroll` is the one passed in).
pub fn strip_layout(
    entries: List[StripEntry],
    width: int,
    active: int,
    scroll: int,
) -> StripLayout {
    let n = entries.len
    if n <= 0 || width == 0 {
        return layout_empty(scroll)
    }
    var first = scroll
    if first < 0 {
        first = 0
    }
    if first >= n {
        first = n - 1
    }
    // Keep the active entry visible, adjusting as little as possible:
    // scrolling left is trivial; scrolling right walks the first visible
    // entry forward one at a time until the active entry fits
    // (`strip.c:76-100`).
    if active >= 0 && active < n {
        if active < first {
            first = active
        } else {
            loop {
                var used = 0
                var fits = false
                var i = first
                while i < n {
                    let w = strip_label_cells(entries[i].label)
                    if used + w > width {
                        break
                    }
                    used += w
                    if i == active {
                        fits = true
                        break
                    }
                    i += 1
                }
                if fits || first >= active {
                    break
                }
                first += 1
            }
        }
    }
    var spans = List[StripSpan]()
    var at = 0
    var k = first
    while k < n {
        let w = strip_label_cells(entries[k].label)
        if at + w > width {
            break
        }
        (mut spans).push(StripSpan { idx: k, col0: at, col1: at + w })
        at += w
        k += 1
    }
    // `strip.c:115-124`: the oversized entry, placed clipped.
    if spans.len == 0 && first < n {
        (mut spans).push(StripSpan { idx: first, col0: 0, col1: width })
    }
    let count = spans.len
    StripLayout {
        spans: spans,
        scroll: first,
        more_left: first > 0,
        more_right: first + count < n,
    }
}
