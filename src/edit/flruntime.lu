//! edit.flruntime — persistent VM ownership and evaluation, sagitta 9ace98c2
//! src/fl/flruntime.c:185-280, flruntime_int.h:15-39 and fleval.c:1-327.
//! R-yw09-4: the real VM is held in a retained one-element list. A running
//! call owns it locally; an editor command parks it so synchronous hooks can
//! re-enter the SAME VM. No region is used (G50/G54), and no VM is copied.
//! The actual-VM/compacting-GC witness is src/fl_parking_test.lu.

use fl
use text
use util

/// Macro cache references are host-root indices, never stale heap references.
pub struct FlMacroCache {
    root: int,
    source: List[byte],
    has_source: bool,
    hash: int,
    origin: fl.FlOrigin,
}

/// Coalesced buffer damage, keyed by stable buffer identity.
pub struct FlPendingChange { buffer_id: int, lo: int, hi: int }

/// Session-owned compiler/VM, diagnostic capture and replay provenance.
pub struct FlRuntime {
    vms: List[fl.FlVm],
    ready: bool,
    command_source: int,
    macro_cache: List[FlMacroCache],
    last_diag: List[byte],
    last_span: fl.FlSpan,
    has_last_diag: bool,
    diag_error: bool,
    diag_message: List[byte],
    idle_since: int,
    changes: List[FlPendingChange],
    flushing_change: bool,
}

/// An uninitialized runtime, with no VM storage allocated yet.
pub fn fl_runtime_new() -> FlRuntime {
    FlRuntime {
        vms: List[fl.FlVm](),
        ready: false,
        command_source: SRC_FLETCH,
        macro_cache: List[FlMacroCache](),
        last_diag: List[byte](),
        last_span: fl.FlSpan { file_id: 0, line: 0, col: 0, len: 0 },
        has_last_diag: false,
        diag_error: false,
        diag_message: List[byte](),
        idle_since: -1,
        changes: List[FlPendingChange](),
        flushing_change: false,
    }
}

/// Snapshot the command registry in C's declaration order for ed.commands.
pub fn fl_command_rows(reg: CmdReg) -> List[fl.FlHostCmd] {
    var rows = List[fl.FlHostCmd]()
    for i in 0..cmd_count(reg) {
        let e = cmd_entry(reg, i + 1)
        (mut rows).push(fl.FlHostCmd {
            name: copy e.name,
            help: copy e.help,
            flags: e.flags,
            word: copy e.word,
            has_word: e.has_word,
        })
    }
    rows
}

/// Initialize once; callbacks may call this while the VM is already executing.
pub fn fl_runtime_init(mut ed: Ed) -> bool {
    if ed.flrt.ready { return true }
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    fl.fl_std_register(mut vm)
    let rows = fl_command_rows(ed.reg)
    fl.fl_vm_set_commands(mut vm, rows)
    assert(fl.fl_api_check_table().len == 0)
    for kind in fl.fl_api_kinds() {
        let d = fl.fl_api_desc(kind) else { continue }
        if d.cmd.len != 0 {
            assert(cmd_lookup(ed.reg, d.cmd) != 0, "unknown Fletch command {d.cmd}")
        }
    }
    vm.host_kind = 1
    // fl_hook_table_init + the root-11 provider (flruntime.c:221-222).
    fl.fl_gc_root_provider(mut vm, fl.FL_GC_PROVIDER_HOOKS, 0)
    for _ in 0..26 {
        let root = fl.fl_gc_host_root_add(mut vm, fl.fl_nil())
        (mut ed.flrt.macro_cache).push(FlMacroCache {
            root: root,
            source: List[byte](),
            has_source: false,
            hash: 0,
            origin: fl.fl_origin_new(fl.FL_ORIGIN_CONFIG, fl.FL_CAP_ALL),
        })
    }
    (mut ed.flrt.vms).push(vm)
    ed.flrt.ready = true
    ed.flrt.idle_since = -1
    true
}

fn runtime_missing_vm() -> fl.FlVm {
    util.bug("edit.flruntime", "active Fletch VM was not restored")
    var strings = fl.fl_strings()
    fl.fl_vm_new(take strings)
}

fn runtime_take(mut ed: Ed) -> fl.FlVm {
    (mut ed.flrt.vms).pop() else runtime_missing_vm()
}

fn runtime_cstr(mut out: List[byte], bytes: List[byte], cap: int) {
    (mut out).reset()
    for b in bytes { if b == 0 as byte || out.len >= cap { break }; (mut out).push(b) }
}

fn runtime_diag_capture(mut ed: Ed, vm: fl.FlVm, first: int) {
    for i in first..vm.dc.entries.len {
        let d = copy vm.dc.entries[i]
        var rendered = List[byte]()
        fl.fl_diag_render(mut rendered, vm.dc, d.level, d.sp, d.msg)
        var logged = List[byte]()
        util.buf_append_str(mut logged, "Fletch: ")
        util.buf_append(mut logged, rendered)
        let level = if d.level == fl.FL_DIAG_ERROR {
            util.LOG_ERROR
        } else if d.level == fl.FL_DIAG_WARNING {
            util.LOG_WARN
        } else {
            util.LOG_INFO
        }
        util.log_at_bytes(level, logged)
        ed.flrt.last_span = d.sp
        ed.flrt.has_last_diag = true
        runtime_cstr(mut ed.flrt.last_diag, rendered, rendered.len)
        if d.level == fl.FL_DIAG_ERROR {
            ed.flrt.diag_error = true
            runtime_cstr(mut ed.flrt.diag_message, rendered, 255)
        }
    }
}

fn runtime_compile(
    mut ed: Ed,
    mut vm: fl.FlVm,
    source: List[byte],
    label: str,
    origin: fl.FlOrigin,
    repl: bool,
) -> fl.FlValue ! {none} {
    ed.flrt.diag_error = false
    ed.flrt.has_last_diag = false
    (mut ed.flrt.diag_message).reset()
    (mut ed.flrt.last_diag).reset()
    let first = vm.dc.entries.len
    let file = fl.fl_diag_add_file(mut vm.dc, label, source)
    let p = fl.fl_parse(source, file, mut vm.dc, mut vm.strings)
    if p.had_error { runtime_diag_capture(mut ed, vm, first); return none }
    let entry = (
        if repl {
            fl.fl_compile_repl(mut vm, p, file, origin)
        } else {
            fl.fl_compile(mut vm, p, file, origin)
        }
    ) else {
        runtime_diag_capture(mut ed, vm, first)
        return none
    }
    runtime_diag_capture(mut ed, vm, first)
    entry
}

/// Compile and execute one editor source while retaining its VM and globals.
/// A parse/compile error returns ERR_ARG; an uncaught VM error ERR_STATE.
pub fn fl_eval_source(
    mut ed: Ed,
    source: List[byte],
    label: str,
    origin: fl.FlOrigin,
    repl: bool,
) -> (int, fl.FlValue) {
    let _ = fl_runtime_init(mut ed)
    var vm = runtime_take(mut ed)
    let entry = runtime_compile(mut ed, mut vm, source, label, origin, repl) else {
        (mut ed.flrt.vms).push(vm)
        return (CMD_ERR_ARG, fl.fl_nil())
    }
    let result = if vm.frames.len == 0 {
        fl.fl_vm_run_host(mut vm, mut ed, entry)
    } else {
        let closure = fl.fl_closure_new(mut vm, entry)
        fl.fl_vm_call_host(mut vm, mut ed, closure, List[fl.FlValue]())
    }
    let status = if vm.raised then CMD_ERR_STATE else CMD_OK
    (mut ed.flrt.vms).push(vm)
    (status, result)
}

/// Ordinary E-mode evaluation, including the byte-preserving result/trace message.
pub fn fl_runtime_eval(mut ed: Ed, source: List[byte]) -> int {
    let origin = fl.fl_origin_new(fl.FL_ORIGIN_CONFIG, fl.FL_CAP_ALL)
    let (status, result) = fl_eval_source(mut ed, source, "<E>", origin, true)
    if status == CMD_ERR_ARG {
        if ed.flrt.diag_message.len != 0 {
            let msg = copy ed.flrt.diag_message
            ed_msg_bytes(mut ed, MSG_ERROR, msg)
        } else {
            ed_msg(mut ed, MSG_ERROR, "Fletch parse failed")
        }
        return status
    }
    var rendered = List[byte]()
    if status != CMD_OK {
        fl.fl_trace_render(mut ed.flrt.vms[0], result, mut rendered)
        var log = List[byte]()
        util.buf_append_str(mut log, "Fletch E-mode error: ")
        util.buf_append(mut log, rendered)
        util.log_at_bytes(util.LOG_ERROR, log)
        var first = List[byte]()
        for b in rendered {
            if b == 0 as byte || b == 10 as byte || first.len == 255 { break }
            (mut first).push(b)
        }
        if first.len == 0 { util.buf_append_str(mut first, "Fletch error") }
        ed_msg_bytes(mut ed, MSG_ERROR, first)
        return status
    }
    if result.t != fl.FL_NIL {
        if !fl.fl_fmt_repl(mut ed.flrt.vms[0], mut rendered, result, 8) {
            ed_msg(mut ed, MSG_ERROR, "Fletch result could not be rendered")
            return CMD_ERR_STATE
        }
        ed_msg_bytes(mut ed, MSG_INFO, rendered)
    }
    CMD_OK
}

/// The only point that parks the active VM while a resolved editor command runs.
pub fn fl_invoke_command(mut vm: fl.FlVm, mut ed: Ed, id: int, mut cx: CmdCtx) -> int ! {raised} {
    let changes = cmd_active(ed.reg, id) && ed.reg.entries[id - 1].flags & CMD_CHANGES_BUFFER != 0
    if changes && ed.fl_model_teardown {
        let _ = fl.fl_raise(mut vm, "user", "editor mutation during model teardown")
        return raised
    }
    if changes && !fl_txn_enlist(mut vm, mut ed, cx.win) { return raised }
    assert(ed.flrt.vms.len == 0, "Fletch command found a second active VM")
    (mut ed.flrt.vms).push(vm)
    let status = ed_dispatch_resolved(mut ed, id, mut cx)
    vm = runtime_take(mut ed)
    if changes && !fl_txn_enlist(mut vm, mut ed, cx.win) { return raised }
    status
}

impl fl.FlHost for Ed {
    fn api(mut self, mut vm: fl.FlVm, kind: int, base: int, argc: int) -> fl.FlValue {
        fl_attached_api(mut vm, mut self, kind, base, argc)
    }
    fn motion(mut self, mut vm: fl.FlVm, program: fl.FlValue) -> bool {
        fl_motion_host_dispatch(mut vm, mut self, program)
    }
    fn edit_begin(mut self, mut vm: fl.FlVm) -> bool { fl_txn_edit_begin(mut vm, mut self) }
    fn edit_end(mut self, mut vm: fl.FlVm, commit: bool) -> bool {
        fl_txn_edit_end(mut vm, mut self, commit)
    }
    fn run_begin(mut self, mut vm: fl.FlVm) -> bool { fl_txn_run_begin(mut vm, mut self) }
    #[allow(w1002)] // The host ABI permits a VM error; C's run_end never raises.
    fn run_end(mut self, mut vm: fl.FlVm, commit: bool) -> bool {
        let _ = vm.sp
        fl_txn_run_end(mut self, commit)
    }
    fn run_active(self) -> bool { self.fltxn.entry_active }
    fn hook_call(mut self, mut vm: fl.FlVm, f: fl.FlValue, args: List[fl.FlValue]) -> (
        bool,
        fl.FlValue,
    ) {
        runtime_hook_call(mut vm, mut self, f, args)
    }
    fn hook_masked(self, origin: int) -> bool { fl.fl_origin_masked(self.origins, origin) }
    fn hook_notice(
        mut self,
        mut vm: fl.FlVm,
        what: int,
        event: int,
        ledger_id: int,
        errs: int,
        err: fl.FlValue,
    ) {
        runtime_hook_notice(mut vm, mut self, what, event, ledger_id, errs, err)
    }
}

// ---- hooks (flruntime.c:55-184, 282-507) ------------------------------

// hook_call (flruntime.c:55-87): an outer fire opens the editor's implicit
// transaction, a nested one an edit boundary, so a failing hook rolls back
// only its own edits. A retained closure runs as its defining principal
// (builtin frames are transparent to capability checks).
fn runtime_hook_call(mut vm: fl.FlVm, mut ed: Ed, f: fl.FlValue, args: List[fl.FlValue]) -> (
    bool,
    fl.FlValue,
) {
    let nested = ed.fltxn.entry_active
    let opened = if nested {
        fl_txn_edit_begin(mut vm, mut ed)
    } else {
        fl_txn_run_begin(mut vm, mut ed)
    }
    if !opened {
        // C returns false with *err untouched (its caller's FL_NIL_V).
        vm.raised = false
        return (false, fl.fl_nil())
    }
    let saved = copy vm.root_origin
    if f.t == fl.FL_CLOSURE {
        let fun = copy vm.gc.slots[fl.fl_obj_index(vm, f)].fn_value
        vm.root_origin = copy vm.gc.slots[fl.fl_obj_index(vm, fun)].origin
    }
    let _ = fl.fl_vm_call_host(mut vm, mut ed, f, args)
    let ok = !vm.raised
    vm.root_origin = saved
    let err = if ok then fl.fl_nil() else copy vm.err
    vm.raised = false
    if nested {
        let _ = fl_txn_edit_end(mut vm, mut ed, ok)
    } else {
        let _ = fl_txn_run_end(mut ed, ok)
    }
    vm.raised = false
    (ok, err)
}

// first_line (flruntime.c:94-106): up to the first newline, 255 bytes.
fn runtime_first_line(text: List[byte]) -> List[byte] {
    var out = List[byte]()
    for b in text {
        if b == 10 as byte || out.len == 255 { break }
        (mut out).push(b)
    }
    if out.len == 0 { util.buf_append_str(mut out, "hook error") }
    out
}

// hook_notice (flruntime.c:116-184), less the plugin-origin rows: a plugin
// origin exists only once yw14 loads plugins (`yew_plug_hook_error`, the
// disabled-hook reprieve), so no origin reaches them before that lane.
fn runtime_hook_notice(
    mut vm: fl.FlVm,
    mut ed: Ed,
    what: int,
    event: int,
    ledger_id: int,
    errs: int,
    err: fl.FlValue,
) {
    let _ = ledger_id
    let name = fl.fl_event_name(event) else "?"
    let limit = vm.hooks.error_limit
    if what == fl.FL_HOOK_NOTICE_REENTRANT {
        util.log_at(util.LOG_WARN, "hook \"{name}\" reentrant fire dropped")
        return
    }
    if what == fl.FL_HOOK_NOTICE_DEPTH {
        util.log_at(util.LOG_ERROR, "hook \"{name}\" exceeded nesting depth")
        ed_msg(mut ed, MSG_WARN, "hook \"{name}\" error ({errs}/{limit}): nesting depth exceeded")
        return
    }
    if what == fl.FL_HOOK_NOTICE_DISABLED {
        util.log_at(util.LOG_ERROR, "hook \"{name}\" disabled after {errs} errors")
        ed_msg(mut ed, MSG_WARN, "hook \"{name}\" disabled after {errs} errors")
        return
    }
    var trace = List[byte]()
    fl.fl_trace_render(mut vm, err, mut trace)
    var logged = List[byte]()
    util.buf_append_str(mut logged, "hook \"{name}\" error ({errs}/{limit}): ")
    util.buf_append(mut logged, trace)
    util.log_at_bytes(util.LOG_ERROR, logged)
    var shown = List[byte]()
    util.buf_append_str(mut shown, "hook \"{name}\" error ({errs}/{limit}): ")
    util.buf_append(mut shown, runtime_first_line(trace))
    ed_msg_bytes(mut ed, MSG_WARN, shown)
}

// yew_fl_vm (flruntime.c:250-254): the runtime's VM is parked or idle.
fn runtime_vm_available(ed: Ed) -> bool { ed.flrt.ready && ed.flrt.vms.len != 0 }

/// `fl_runtime_on` (flruntime.c:282-314): `on(event, fn)`, the hook's
/// stable ledger id. The plugin manifest rows are yw14's (no plugin origin
/// exists before it).
pub fn fl_runtime_on(mut vm: fl.FlVm, mut ed: Ed, base: int, argc: int) -> fl.FlValue {
    let event = copy vm.stack[base]
    let f = copy vm.stack[base + 1]
    if argc != 2 || event.t != fl.FL_STR || f.t != fl.FL_CLOSURE && f.t != fl.FL_NATIVE {
        return fl.fl_raise(mut vm, "type", "on expects (event string, function)")
    }
    let name = copy vm.gc.slots[fl.fl_obj_index(vm, event)].bytes
    let id = fl.fl_event_parse(name) else {
        var msg = List[byte]()
        util.buf_append_str(mut msg, "unknown editor event '")
        util.buf_append(mut msg, name)
        util.buf_append_str(mut msg, "'")
        return fl.fl_raise_bytes(mut vm, "name", msg)
    }
    let origin = fl.fl_origin_of_frame(mut ed.origins, vm)
    if origin == fl.FL_ORIGIN_ID_NONE {
        return fl.fl_raise(mut vm, "handle", "on: callback has no editor origin")
    }
    let callback = copy vm.stack[base + 1]
    fl.fl_int(fl.fl_hook_add(mut vm.hooks, origin, id, callback))
}

/// `fl_macro_cache_invalidate` (fleval.c:206-217): register `reg`'s
/// compiled macro is forgotten (its host root released to nil).
pub fn fl_macro_cache_invalidate(mut ed: Ed, reg: int) {
    if !ed.flrt.ready || reg < 'a' as int || reg > 'z' as int { return }
    let i = reg - 'a' as int
    if ed.flrt.vms.len != 0 {
        let root = ed.flrt.macro_cache[i].root
        fl.fl_gc_host_root_set(mut ed.flrt.vms[0], root, fl.fl_nil())
    }
    (mut ed.flrt.macro_cache[i].source).reset()
    ed.flrt.macro_cache[i].has_source = false
    ed.flrt.macro_cache[i].hash = 0
}

/// `fl_macro_source_written` (fleval.c:219-232): YEW-F-008, register text
/// becomes executable on replay, so the WRITER's principal is kept now
/// (config's when no Fletch frame is live), then the cache is forgotten.
pub fn fl_macro_source_written(mut ed: Ed, reg: int) {
    if !ed.flrt.ready || reg < 'a' as int || reg > 'z' as int { return }
    let i = reg - 'a' as int
    let idle = ed.flrt.vms.len == 0 || ed.flrt.vms[0].frames.len == 0
    ed.flrt.macro_cache[i].origin = if idle {
        fl.fl_origin_new(fl.FL_ORIGIN_CONFIG, fl.FL_CAP_ALL)
    } else {
        fl.fl_cap_origin(ed.flrt.vms[0])
    }
    fl_macro_cache_invalidate(mut ed, reg)
}

/// `fl_txn_prepare_save(yew_fl_vm(ed), undo)` from editor code: the
/// runtime VM, parked or idle, flushes implicit edits or refuses inside an
/// explicit edit block; true when there is no runtime.
pub fn ed_txn_prepare_save(mut ed: Ed, buffer_id: int) -> bool {
    if !runtime_vm_available(ed) { return true }
    var vm = runtime_take(mut ed)
    let ok = fl_txn_prepare_save(mut vm, mut ed, buffer_id)
    (mut ed.flrt.vms).push(vm)
    ok
}

/// Whether a live, enabled, unmasked hook would consume `event` (the
/// listens checks in front of every yew_fl_hook_* payload).
pub fn ed_hook_listens(ed: Ed, event: int) -> bool {
    if !runtime_vm_available(ed) { return false }
    fl.fl_hook_listens(ed.flrt.vms[0].hooks, ed, event)
}

/// `yew_fl_hook_fire` (flruntime.c:316-328): the runtime VM, parked or
/// idle, runs the event's hooks; a command a hook runs parks it again.
/// The plugin drain at depth 0 is yw14's.
pub fn ed_hook_fire(mut ed: Ed, event: int, args: List[fl.FlValue]) {
    if !runtime_vm_available(ed) { return }
    var vm = runtime_take(mut ed)
    fl.fl_hook_fire(mut vm, mut ed, event, args)
    (mut ed.flrt.vms).push(vm)
}

/// `yew_fl_hook_buffer` (flruntime.c:330-339): one buffer handle.
pub fn ed_hook_buffer(mut ed: Ed, event: int, bi: int) {
    if bi < 0 || bi >= ed.bufs.len || !ed_hook_listens(ed, event) { return }
    let arg = fl_h_buf_make(mut ed, bi)
    ed_hook_fire(mut ed, event, [arg])
}

/// `yew_fl_hook_mode` (flruntime.c:341-351): the mode's name as a string.
pub fn ed_hook_mode(mut ed: Ed, event: int, mode: str) {
    if !ed_hook_listens(ed, event) { return }
    var vm = runtime_take(mut ed)
    let arg = fl.fl_str_text(mut vm, mode)
    fl.fl_hook_fire(mut vm, mut ed, event, [arg])
    (mut ed.flrt.vms).push(vm)
}

/// `yew_fl_hook_window` (flruntime.c:353-362): one window handle.
pub fn ed_hook_window(mut ed: Ed, event: int, wi: int) {
    if wi < 0 || wi >= ed.wins.len || !ed_hook_listens(ed, event) { return }
    let arg = fl_h_win_make(mut ed, wi)
    ed_hook_fire(mut ed, event, [arg])
}

fn cursor_hash_word(h0: wrapping[u64], word: int) -> wrapping[u64] {
    var h = h0
    var i: int = 0
    while i < 8 {
        let b = word >> i * 8 & 255
        h = h ^ b as wrapping[u64]
        h = h * 1099511628211
        i += 1
    }
    h
}

/// `yew_fl_cursor_burst_state` (flruntime.c:364-394): an FNV-1a digest of
/// the window's identity, cursor count, primary and every cursor.
pub fn ed_cursor_burst_state(ed: Ed, wi: int) -> wrapping[u64] {
    var hash: wrapping[u64] = 14695981039346656037
    if wi < 0 || wi >= ed.wins.len { return 0 }
    hash = cursor_hash_word(hash, ed.wins[wi].id)
    hash = cursor_hash_word(hash, ed.wins[wi].cs.curs.len)
    hash = cursor_hash_word(hash, ed.wins[wi].cs.primary)
    for i in 0..ed.wins[wi].cs.curs.len {
        hash = cursor_hash_word(hash, ed.wins[wi].cs.stamps[i])
        hash = cursor_hash_word(hash, ed.wins[wi].cs.curs[i].pos as int)
        hash = cursor_hash_word(hash, ed.wins[wi].cs.curs[i].anchor as int)
        hash = cursor_hash_word(hash, ed.wins[wi].cs.curs[i].goal_col as int)
    }
    hash
}

/// `yew_fl_hook_flush_cursor` (flruntime.c:396-401): the focused window's
/// cursor.move when its burst state moved.
pub fn ed_hook_flush_cursor(mut ed: Ed, wi: int, before: wrapping[u64]) {
    if wi >= 0 && wi == ed.win && ed_cursor_burst_state(ed, wi) != before {
        ed_hook_window(mut ed, fl.FL_EV_CURSOR_MOVE, wi)
    }
}

/// `yew_fl_hook_workspace` (flruntime.c:403-414): the workspace root.
pub fn ed_hook_workspace(mut ed: Ed, event: int) {
    if !ed_hook_listens(ed, event) { return }
    let root = ws_root(ed)
    var vm = runtime_take(mut ed)
    let arg = fl.fl_str_text(mut vm, root)
    fl.fl_hook_fire(mut vm, mut ed, event, [arg])
    (mut ed.flrt.vms).push(vm)
}

/// `yew_fl_hook_note_change` (flruntime.c:416-455): coalesce one buffer's
/// change into [lo, hi), keyed by its stable identity.
pub fn ed_hook_note_change(mut ed: Ed, bi: int, at_in: int) {
    if bi < 0 || bi >= ed.bufs.len || !ed.bufs[bi].resident || ed.flrt.flushing_change { return }
    let len = text.textbuf_len(ed.bufs[bi].ec.tb)
    let at = if at_in > len then len else at_in
    let hi = if at < len then at + 1 else at
    let id = ed.bufs[bi].id
    for i in 0..ed.flrt.changes.len {
        if ed.flrt.changes[i].buffer_id == id {
            if at < ed.flrt.changes[i].lo { ed.flrt.changes[i].lo = at }
            if hi > ed.flrt.changes[i].hi { ed.flrt.changes[i].hi = hi }
            return
        }
    }
    (mut ed.flrt.changes).push(FlPendingChange { buffer_id: id, lo: at, hi: hi })
}

/// `yew_fl_hook_flush_change` (flruntime.c:457-507): one buf.change per
/// pending buffer, in workspace order, with a span of the coalesced range.
/// Nobody listening clears the coalescer before any payload is built (a
/// span handle retains two marks for the buffer's life).
pub fn ed_hook_flush_change(mut ed: Ed) {
    if ed.flrt.changes.len == 0 || ed.flrt.flushing_change { return }
    if !runtime_vm_available(ed) || !ed_hook_listens(ed, fl.FL_EV_BUF_CHANGE) {
        (mut ed.flrt.changes).reset()
        return
    }
    let pending = copy ed.flrt.changes
    (mut ed.flrt.changes).reset()
    ed.flrt.flushing_change = true
    for bi in 0..ed.bufs.len {
        for p in pending {
            if ed.bufs[bi].id != p.buffer_id || !ed.bufs[bi].resident { continue }
            let len = text.textbuf_len(ed.bufs[bi].ec.tb)
            let lo = if p.lo > len then len else p.lo
            let hi = if p.hi > len then len else p.hi
            let hb = fl_h_buf_make(mut ed, bi)
            let hs = fl_h_span_make(mut ed, bi, lo, hi)
            ed_hook_fire(mut ed, fl.FL_EV_BUF_CHANGE, [hb, hs])
            break
        }
    }
    ed.flrt.flushing_change = false
}
