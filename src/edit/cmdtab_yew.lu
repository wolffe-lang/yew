//! edit.cmdtab_yew — yew's own registry rows: commands sagitta does not
//! have. Hand-written (`cmdtab.lu` is generated from sagitta's `cmd.c` and
//! never edited), in `CMDTAB`'s format: one row per command, eight fields
//! separated by 0x1f (name, handler, arity, flags, help, recorder word,
//! E-mode meta, the handler's file). `cmdreg_builtin` registers them after
//! C's rows, so every C command keeps C's id.
//!
//! - `ed.keys` (yw15): the keys help (`edit.keyshelp`). Flags 0, as C's
//!   `ed.macro.list`, a picker opener C does not mark as prompting.

/// The number of rows in `CMDTAB_YEW`.
pub const CMDTAB_YEW_ROWS: int = 1

/// yew's own descriptor rows, one per line, fields separated by 0x1f.
pub const CMDTAB_YEW: str = """
ed.keys\x1fyew_keys_cmd_open\x1f0\x1f0\x1fList every mode's key bindings, marking what is not ported yet (yew's own)\x1f\x1f\x1fsrc/edit/keyshelp.lu
"""
