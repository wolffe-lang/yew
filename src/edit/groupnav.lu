//! edit.groupnav — navigation as ONE CONTINUOUS LINE, and the group
//! commands.
//!
//! Ports sagitta `src/ui/groupnav.c` (434 lines) and `ui/groupnav.h` (70)
//! at 9ace98c2 under `s24-tab-groups.md` §6 (and the two Sprint 27 §5/§8
//! rows the file also holds, `ed.group.add_tab` and `ed.group.rename`:
//! commands, so the mouse and the keyboard run the same code once the
//! menu lands, yw06).
//!
//! Left and right walk through every open file, grouped or not: inside a
//! group you step through its members by ordinal; step off either end and
//! you FALL THROUGH to the row-1 walk, landing on the entry beside the
//! group (`groupnav.h:4-18`). The fall-through is the guaranteed exit — a
//! user whose window manager eats the leave chord can always press right
//! until out. The walk builds its entry list with `tab_row1_entries`, the
//! renderer's own call, so it cannot skip an entry the user can see.
//!
//! A walk ENTERS a group from the side it arrived from (moving right lands
//! on the first member, left on the last), which is what makes N rights
//! then N lefts retrace the same files; the explicit `ed.group.enter`
//! resumes at `last_active_member` instead. DoD 6's hook counts the
//! resume reads (`Ed.group_resume_reads`, C's file static `resume_reads`,
//! a value of the `Ed`: E1010) so the mid-walk path is proven never to
//! consult it. Every switch is `tab_switch`, which hydrates first.

/// `yew_group_resume_reads` (`groupnav.c:18-24`): how many explicit
/// entries consulted `last_active_member` (DoD 6's test hook).
pub fn group_resume_reads(ed: Ed) -> int {
    ed.group_resume_reads
}

/// `yew_group_enter_at_edge` (`groupnav.c:26-43`): the first member when
/// the walk moved right (`delta >= 0`), the last when it moved left. Note
/// what is NOT here: any look at `last_active_member` — resuming mid-walk
/// would skip every member between the edge and wherever the user last
/// was, invisibly.
pub fn group_enter_at_edge(mut ed: Ed, gid: int, delta: int) {
    if gid == 0 {
        return
    }
    let members = group_members(ed, gid)
    if members.len == 0 {
        return
    }
    tab_switch(mut ed, if delta >= 0 then members[0] else members[members.len - 1])
}

/// `yew_group_enter` (`groupnav.c:45-77`): the EXPLICIT entry — resume at
/// `last_active_member`, resolved by PATH against the CURRENT members; a
/// dangling path (its member closed since) falls back to the first
/// member rather than refusing to enter.
pub fn group_enter(mut ed: Ed, gid: int) {
    if gid == 0 {
        return
    }
    let members = group_members(ed, gid)
    if members.len == 0 {
        return
    }
    let at = group_find(ed, gid)
    ed.group_resume_reads += 1
    if at >= 0 && ed.groups[at].has_last {
        let want = ed.groups[at].last_active_member
        for m in members {
            if ed.tabs[m].has_path && ed.tabs[m].path == want {
                tab_switch(mut ed, m)
                return
            }
        }
    }
    tab_switch(mut ed, members[0])
}

/// `yew_group_leave` (`groupnav.c:79-110`): the position noted first (so
/// coming back resumes here), then the nearest tab AFTER the group in
/// array order, else the nearest before — leaving forwards is the common
/// direction. False, with a message, when every open file is in this
/// group; false and silent outside a group.
pub fn group_leave(mut ed: Ed) -> bool {
    let gid = active_group_id(ed)
    if gid == 0 {
        return false
    }
    group_note_position(mut ed)
    let n = ed.tabs.len
    var i = ed.tab_active + 1
    while i < n {
        if ed.tabs[i].group_id != gid {
            tab_switch(mut ed, i)
            return true
        }
        i += 1
    }
    i = ed.tab_active - 1
    while i >= 0 {
        if ed.tabs[i].group_id != gid {
            tab_switch(mut ed, i)
            return true
        }
        i -= 1
    }
    ed_msg(mut ed, MSG_INFO, "every open file is in this group")
    false
}

/// `yew_file_step` (`groupnav.c:112-178`): one step along the line. Step
/// 1, inside a group, the members by ordinal — a target in range is the
/// whole answer; off either end the position is noted and the walk FALLS
/// THROUGH with the group's own row-1 entry as "here". Step 2, the row-1
/// entries (the renderer's construction), `here + delta` wrapping at both
/// ends. Step 3, a tab is a switch and a group is entered at its edge.
pub fn file_step(mut ed: Ed, delta: int) {
    if delta == 0 || ed.tabs.len == 0 {
        return
    }
    let gid = active_group_id(ed)
    if gid != 0 {
        let members = group_members(ed, gid)
        var at = -1
        var i = 0
        while i < members.len {
            if members[i] == ed.tab_active {
                at = i
            }
            i += 1
        }
        if at >= 0 {
            let want = at + delta
            if want >= 0 && want < members.len {
                tab_switch(mut ed, members[want])
                return
            }
            group_note_position(mut ed)
        }
    }
    let entries = tab_row1_entries(ed)
    let n = entries.len
    if n <= 0 {
        return
    }
    var here = tab_row1_active(ed, entries)
    if here < 0 {
        here = 0
    }
    var target = here + delta
    // Wrapping at both ends: "next" from the last meaning nothing is a
    // worse answer than the ring the strip shows.
    while target < 0 {
        target += n
    }
    target = target % n
    if target == here && n == 1 {
        return
    }
    let payload = entries[target].payload
    if payload >= 0 {
        tab_switch(mut ed, payload)
    } else {
        group_enter_at_edge(mut ed, -payload, delta)
    }
}

/// `ed.file.next` and `ed.group.next` (`yew_file_cmd_next`,
/// `groupnav.c:180-186`).
pub fn file_cmd_next(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    file_step(mut ed, 1)
    CMD_OK
}

/// `ed.file.prev` and `ed.group.prev` (`yew_file_cmd_prev`,
/// `groupnav.c:188-194`).
pub fn file_cmd_prev(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    file_step(mut ed, -1)
    CMD_OK
}

/// `ed.group.enter` (`yew_group_cmd_enter`, `groupnav.c:196-227`):
/// already inside is OK; else the nearest group to the RIGHT of the
/// active tab, else the first group anywhere — so the command is
/// reachable without a mouse.
pub fn group_cmd_enter(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    if active_group_id(ed) != 0 {
        return CMD_OK
    }
    let n = ed.tabs.len
    var i = ed.tab_active + 1
    while i < n {
        if ed.tabs[i].group_id != 0 {
            group_enter(mut ed, ed.tabs[i].group_id)
            return CMD_OK
        }
        i += 1
    }
    i = 0
    while i < n {
        if ed.tabs[i].group_id != 0 {
            group_enter(mut ed, ed.tabs[i].group_id)
            return CMD_OK
        }
        i += 1
    }
    ed_msg(mut ed, MSG_ERROR, "no tab groups")
    CMD_ERR_STATE
}

/// `ed.group.leave` (`yew_group_cmd_leave`, `groupnav.c:229-238`).
pub fn group_cmd_leave(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    if active_group_id(ed) == 0 {
        ed_msg(mut ed, MSG_ERROR, "not in a tab group")
        return CMD_ERR_STATE
    }
    if group_leave(mut ed) then CMD_OK else CMD_ERR_STATE
}

/// `ed.group.dissolve` (`yew_group_cmd_dissolve`, `groupnav.c:240-257`):
/// the tabs stay open and become ungrouped — dissolving is not a way to
/// close files.
pub fn group_cmd_dissolve(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    let gid = active_group_id(ed)
    if gid == 0 {
        ed_msg(mut ed, MSG_ERROR, "not in a tab group")
        return CMD_ERR_STATE
    }
    group_dissolve(mut ed, gid)
    ed.layout_dirty = true
    ed.full_damage = true
    CMD_OK
}

/// `ed.group.close` (`yew_group_cmd_close`, `groupnav.c:259-308`): the
/// active tab's close when ungrouped (its dirty prompt kept); inside a
/// group, ONE gesture — refused before any mutation when it would empty
/// the editor or need several dirty-tab answers; then every member closed
/// by its captured tab ID, resolved after each compaction.
pub fn group_cmd_close(mut ed: Ed, cx: CmdCtx) -> int {
    let gid = active_group_id(ed)
    if gid == 0 {
        return tab_cmd_close(mut ed, cx)
    }
    let members = group_members(ed, gid)
    if members.len <= 0 {
        bug("active group has no members")
    }
    if members.len >= ed.tabs.len {
        ed_msg(mut ed, MSG_ERROR, "cannot close group: it contains every tab")
        return CMD_ERR_STATE
    }
    var doomed = List[int]()
    for m in members {
        (mut doomed).push(ed.tabs[m].tab_id)
        if tab_modified(ed, m) {
            ed_msg(mut ed, MSG_ERROR, "unsaved changes in group; save or force first")
            return CMD_ERR_STATE
        }
    }
    for id in doomed {
        let idx = tab_index_of_id(ed, id)
        if idx >= 0 {
            let _ = tab_close(mut ed, idx)
        }
    }
    ed.layout_dirty = true
    ed.full_damage = true
    CMD_OK
}

/// `ed.group.remove_tab` (`yew_group_cmd_remove_tab`, `groupnav.c:310-
/// 322`): the active tab leaves its group (the last one out dissolves
/// it).
pub fn group_cmd_remove_tab(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    if active_group_id(ed) == 0 {
        ed_msg(mut ed, MSG_ERROR, "not in a tab group")
        return CMD_ERR_STATE
    }
    group_remove_member(mut ed, ed.tab_active)
    ed.layout_dirty = true
    ed.full_damage = true
    CMD_OK
}

/// `ed.group.add_tab` (`yew_group_cmd_add_tab`, `groupnav.c:335-393`,
/// Sprint 27 §5's keyboard twin of a drop into a group): the ACTIVE tab
/// joins the first group whose label starts with the argument, in Sprint
/// 24's order — out of its old group, in, moved to the end by ordinal
/// (the off-by-one is `group_set_ordinal`'s pinned pitfall), and the
/// block made contiguous at its lowest member.
pub fn group_cmd_add_tab(mut ed: Ed, cx: CmdCtx) -> int {
    let idx = ed.tab_active
    if idx < 0 {
        return CMD_ERR_STATE
    }
    if !cx.has_sarg || cx.sarg.len == 0 {
        ed_msg(mut ed, MSG_ERROR, "which group?")
        return CMD_ERR_ARG
    }
    var gid = 0
    for g in ed.groups {
        if gid == 0 && g.label.starts_with(cx.sarg) {
            gid = g.id
        }
    }
    if gid == 0 {
        ed_msg(mut ed, MSG_ERROR, "no such group")
        return CMD_ERR_ARG
    }
    if ed.tabs[idx].group_id == gid {
        ed_msg(mut ed, MSG_ERROR, "already in that group")
        return CMD_ERR_STATE
    }
    if ed.tabs[idx].group_id != 0 {
        group_remove_member(mut ed, idx)
    }
    group_add_member(mut ed, gid, idx)
    group_set_ordinal(mut ed, idx, group_member_count(ed, gid))
    let members = group_members(ed, gid)
    var lowest = -1
    for m in members {
        if lowest < 0 || m < lowest {
            lowest = m
        }
    }
    if lowest >= 0 {
        group_reorder_block(mut ed, gid, lowest)
    }
    ed.layout_dirty = true
    ed.full_damage = true
    CMD_OK
}

/// `ed.group.rename` (`yew_group_cmd_rename`, `groupnav.c:395-434`): with
/// an argument, the active group's new label; without one, the command
/// line opened already holding `grename <label>` (C's 128-byte seed), so
/// renaming is an edit rather than a retype.
pub fn group_cmd_rename(mut ed: Ed, cx: CmdCtx) -> int {
    let gid = active_group_id(ed)
    if gid == 0 {
        ed_msg(mut ed, MSG_ERROR, "not in a tab group")
        return CMD_ERR_STATE
    }
    let at = group_find(ed, gid)
    if at < 0 {
        return CMD_ERR_STATE
    }
    if !cx.has_sarg || cx.sarg.len == 0 {
        let seed = group_utf8_prefix("grename {ed.groups[at].label}", 127)
        cmdline_open(mut ed, PROMPT_CMD, seed)
        return CMD_OK
    }
    ed.groups[at].label = copy cx.sarg
    ed.full_damage = true
    CMD_OK
}
