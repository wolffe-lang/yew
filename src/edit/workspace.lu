//! edit.workspace — the workspace-root override.
//! Ports sagitta src/edit/ed.c:808-844 at 9ace98c2; root changes are
//! accepted only after canonicalization and directory validation.

use std.fs

/// Replace the root only when path resolves to an existing directory.
pub fn ed_set_workspace_root(mut ed: Ed, path: str) -> bool {
    if path.len == 0 { return false }
    let canonical = fs_realpath(path) else { return false }
    if !fs.is_dir(canonical) { return false }
    ed.ws_dir = canonical
    true
}

/// The current canonical root (the initial unconfigured root is dot).
pub fn ws_root(ed: Ed) -> str { ed.ws_dir }
