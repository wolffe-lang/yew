//! edit.workspace — the workspace root and its display spelling.
//! Ports sagitta src/edit/ed.c:807-844 at 9ace98c2 (`yew_ws_root`,
//! `yew_ws_display_root`, `ed_set_workspace_roots`,
//! `yew_ed_set_workspace_root`): a root is accepted only after it stats as
//! a directory and canonicalizes; the canonical path is the workspace's
//! identity (Sprint 25's key), the display spelling is what the user typed
//! (s56.5 §1: `--workspace LINK` shows LINK, keys the realpath).
//! `yew_fuss_workspace_changed` (the drawer's re-root) is yw13's: with no
//! FUSS ported there is no drawer to re-root.

use std.fs

/// `ed_set_workspace_roots` (`ed.c:820-839`): `dir` must stat as a
/// directory and canonicalize; `display` ("" for none) is kept as typed,
/// else the canonical root.
pub fn ed_set_workspace_roots(mut ed: Ed, dir: str, display: str) -> bool {
    if dir.len == 0 || !fs.is_dir(dir) { return false }
    let canonical = fs_realpath(dir) else { return false }
    ed.ws_dir = canonical
    ed.ws_display_dir = if display.len != 0 then display else canonical
    true
}

/// `yew_ed_set_workspace_root` (`ed.c:841-844`): the root and its display
/// spelling from one path.
pub fn ed_set_workspace_root(mut ed: Ed, path: str) -> bool {
    ed_set_workspace_roots(mut ed, path, path)
}

/// `yew_ws_root` (`ed.c:807-810`): the canonical root (the initial
/// unconfigured root is dot).
pub fn ws_root(ed: Ed) -> str { ed.ws_dir }

/// `yew_ws_display_root` (`ed.c:812-818`): the root as the user spelled
/// it, else the canonical root.
pub fn ws_display_root(ed: Ed) -> str {
    if ed.ws_display_dir.len != 0 then ed.ws_display_dir else ws_root(ed)
}
