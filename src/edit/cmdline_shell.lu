//! edit.cmdline_shell — where the prompt reads a `:!` line as the shell
//! will: the word A-. takes, the word the token walk starts on, and A-h's
//! man page.
//!
//! Ports `last_word`'s and `tok_at`'s bang halves (`cmdline.c:2629-2658`,
//! `2773-2810`) and A-h (`man_*`, `yew_cmdline_man_argv`,
//! `yew_cmdline_cmd_man_page`, `cmdline.c:3070-3275`) at 9ace98c2, over
//! the shell fork's lexer (`edit.shctx`) and spec registry
//! (`edit.compspec`). A-h runs the user's pager on the real terminal
//! through the shell's terminal handover (`yew_shell_term_argv`, s57.18);
//! until that lands in this branch the command refuses the run by name
//! (`cl_shell_term_argv`), never silently.

use text

// The shell word ending at `n` in `entry[body..n)` (`last_word`'s bang
// half): the lexer's replace span at the end, rebased; empty when there
// is none.
fn cl_shell_word_before(entry: List[byte], body: int, n: int) -> text.Span {
    let (ok, ctx) = shctx_at(entry[body..n], n - body)
    if ok && ctx.replace_lo < ctx.replace_hi {
        return text.span(ctx.replace_lo + body, ctx.replace_hi + body)
    }
    text.span(n, n)
}

// Where the shell word under `caret` starts (`tok_at`'s bang half).
fn cl_shell_word_start(line: List[byte], body: int, caret: int) -> int {
    let (ok, ctx) = shctx_at(line[body..line.len], caret - body)
    if ok && ctx.replace_lo <= ctx.replace_hi {
        return ctx.replace_lo + body
    }
    caret
}

// `man_one` and `man_two` (`cmdline.c:3083-3084`): the names reach the
// child only as `$1` and `$2` of a FIXED script (the injection rule).
fn man_one() -> str {
    "man -- \"$1\""
}

fn man_two() -> str {
    "man -- \"$1\" 2>/dev/null || man -- \"$2\""
}

fn man_breaks(c: int) -> bool {
    c == 32 ||
        c == 9 ||
        c == 10 ||
        c == 59 ||
        c == 124 ||
        c == 38 ||
        c == 60 ||
        c == 62 ||
        c == 40 ||
        c == 41 ||
        c == 96
}

// `man_word_end` (`cmdline.c:3086-3115`): the end of the shell word `at`
// is in, starting in quote state `q0`.
fn man_word_end(s: List[byte], at_in: int, q0: int) -> int {
    let n = s.len
    var q = if q0 == SH_Q_DOUBLE then 34 else if q0 == SH_Q_NONE then 0 else 39
    var dollar = q0 == SH_Q_DOLLAR
    var at = at_in
    while at < n {
        let c = s[at] as int
        if q == 0 && man_breaks(c) {
            break
        }
        if (q != 39 || dollar) && c == 92 && at + 1 < n {
            at += 2
            continue
        }
        if q == 0 && (c == 39 || c == 34) {
            q = c
            dollar = c == 39 && at != 0 && s[at - 1] as int == 36
        } else if q != 0 && c == q {
            q = 0
            dollar = false
        }
        at += 1
    }
    at
}

// `man_plain_word` (`cmdline.c:3117-3136`).
fn man_plain_word(w: str) -> bool {
    if w.len == 0 || w.bytes()[0] as int == 45 {
        return false
    }
    for b in w.bytes() {
        let c = b as int
        let ok = c >= 97 && c <= 122 ||
            c >= 65 && c <= 90 ||
            c >= 48 && c <= 57 ||
            c == 46 ||
            c == 95 ||
            c == 43 ||
            c == 45
        if !ok {
            return false
        }
    }
    true
}

// `man_subcommand` (`cmdline.c:3138-3166`): the first-level node the spec
// walk reached, else the caret's own word where the command takes a
// subcommand; "" for none.
fn man_subcommand(mut ed: Ed, command: str, ctx: ShCtx) -> str {
    let si = compspec_get(mut ed.specs, command)
    if si < 0 || ctx.arg_index == 0 {
        return ""
    }
    let spec = copy ed.specs.pool[si]
    if spec.nodes.len == 0 || spec.nodes[0].subs.len == 0 {
        return ""
    }
    let (ok, pt) = compspec_resolve(spec, ctx)
    if !ok {
        return ""
    }
    var node = pt.node
    while node >= 0 && spec.nodes[node].parent >= 0 && spec.nodes[node].parent != 0 {
        node = spec.nodes[node].parent
    }
    if node > 0 {
        let name = spec.nodes[node].name
        return if man_plain_word(name) then name else ""
    }
    let stem = str_from_utf8(ctx.stem) else ""
    if pt.subcommands_allowed && man_plain_word(stem) {
        return stem
    }
    ""
}

/// `yew_cmdline_man_argv` (`cmdline.c:3168-3230`): the argv A-h runs —
/// `/bin/sh -c SCRIPT sh NAME [FALLBACK]` — the names only as `$1`/`$2`.
/// Answers (argv, why): an empty argv with `why` saying what is missing.
pub fn cmdline_man_argv(mut ed: Ed, line: List[byte], caret_in: int) -> (List[str], str) {
    var argv = List[str]()
    let len = line.len
    let body = cmd_bang_body(ed, line) else {
        return (argv, "A-h: man pages are for :! commands")
    }
    if caret_in > len || body > len {
        return (argv, "A-h: man pages are for :! commands")
    }
    let caret = if caret_in < body then body else caret_in
    let shell_body = line[body..len]
    let (ok0, at_caret) = shctx_at(shell_body, caret - body)
    if !ok0 {
        return (argv, "A-h: no command under the caret")
    }
    let end = man_word_end(line, caret, at_caret.quote)
    let (ok1, ctx) = shctx_at_specs(shell_body, end - body, mut ed.specs)
    if !ok1 {
        return (argv, "A-h: no command under the caret")
    }
    var command = ""
    if ctx.arg_index == 0 {
        command = str_from_utf8(ctx.stem) else ""
    } else if ctx.argc != 0 {
        command = str_from_utf8(ctx.argv[0]) else ""
    }
    if command.len == 0 {
        return (argv, "A-h: no command under the caret")
    }
    let slash = command.rfind("/") else -1
    if slash >= 0 {
        command = command[slash + 1..]
    }
    if command.len == 0 || command.bytes()[0] as int == 45 {
        return (argv, "A-h: no command under the caret")
    }
    let sub = man_subcommand(mut ed, command, ctx)
    (mut argv).push("/bin/sh")
    (mut argv).push("-c")
    if sub.len != 0 {
        (mut argv).push(man_two())
        (mut argv).push("sh")
        (mut argv).push("{command}-{sub}")
        (mut argv).push(command)
    } else {
        (mut argv).push(man_one())
        (mut argv).push("sh")
        (mut argv).push(command)
    }
    (argv, "")
}

// The terminal handover A-h runs through (`yew_shell_term_argv`, s57.18,
// the shell fork's `edit.shell`).
fn cl_shell_term_argv(mut ed: Ed, argv: List[str]) -> int {
    let _ = argv.len
    ed_msg(
        mut ed,
        MSG_ERROR,
        "not yet ported: the terminal handover: sagitta Sprint 57.18 (shell completion) (yw04)",
    )
    CMD_ERR_DEFERRED
}

/// `ed.cmdline.man_page` (`yew_cmdline_cmd_man_page`,
/// `cmdline.c:3232-3275`): the man page of the bang line's command under
/// the caret, on the real terminal; the prompt stays as it was.
pub fn cmdline_man_page_cmd(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    if !ed.cmdline.active {
        return CMD_ERR_STATE
    }
    if ed.cmdline.kind != PROMPT_CMD {
        ed_msg(mut ed, MSG_WARN, "A-h: man pages are for :! commands")
        return CMD_OK
    }
    let (argv, why) = cmdline_man_argv(mut ed, cmdline_text(ed), cmdline_caret(ed))
    if argv.len == 0 {
        ed_msg(mut ed, MSG_WARN, why)
        return CMD_OK
    }
    let status = cl_shell_term_argv(mut ed, argv)
    ed.full_damage = true
    ed.footer_dirty = true
    if status == CMD_ERR_DEFERRED then CMD_ERR_DEFERRED else CMD_OK
}
