    rename_answer_status(mut ed, LSP_RENAME_DIFF)
}

/// `yew_lsp_cmd_rename_cancel` (`lsp_cmds.c:153-156`).
pub fn lsp_cmd_rename_cancel(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    rename_answer_status(mut ed, LSP_RENAME_CANCEL)
}
