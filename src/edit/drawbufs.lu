//! edit.drawbufs — the storage a frame's drawing writes into, owned by the
//! editor and reused frame after frame (yw05-hot: the contract's
//! deliverable 6, R-yw05-3 = R-yw03-7 A).
//!
//! C draws through stack buffers — a cluster's `u8 local[64]`
//! (`draw.c:879`, `cmdline.c:3816`), a gutter number's `char number[32]`
//! (`gutter.c:338`), the statusline's position, percent and badge
//! `char[]`s and its `Segment segments[16]` (`statusline.c:362-400`), a
//! cluster reader on the stack of every boundary query (`coords.c:1522`)
//! — and frees what it mallocs per frame. At wolf 0.2.34 a session-long
//! loop frees nothing it allocates until the session ends: a function
//! allocates in its caller's region and the loop's is the session's,
//! and a per-turn `region` is E1010 while the turn mutates the editor
//! (G18/G33, wolf-lang#839; s255's per-turn region is 0.2.35's). So the
//! hot paths' temporaries are these buffers, emptied in place and
//! refilled: once each has grown to its frame's size, drawing allocates
//! nothing on them. Nothing here changes a cell or a byte of the frame.

use text

/// The draw paths' reused storage (`Ed.dbuf`).
pub struct DrawBufs {
    // `draw_span`'s cluster bytes (C's `local[64]`, `draw.c:879`).
    cluster: List[byte],
    // The reader each cluster's boundary query reuses (`draw.c:874`).
    reader: text.ClusterReader,
    // A gutter number's digits (C's `number[32]`, `gutter.c:338`).
    num: List[byte],
    // The statusline's text (C's caller-owned `StatuslineText`,
    // `statusline.c:362`), its sixteen segment slots (`segments[16]`) and
    // their texts' pool (the `position`, `percent` and badge `char[]`s),
    // and the clipped path (`clipped_path_inline`).
    status: StatusText,
    segs: List[StatusSeg],
    seg_text: List[byte],
    path: List[byte],
    // The message row's bytes (`message_draw`, the prompt's hint row).
    msg: List[byte],
    // A menu row's label, its footer's count and the footer (C's
    // `label[512]` and `footer[]`, `menu.c:505-506`).
    label: List[byte],
    count: List[byte],
    foot: List[byte],
    // The prompt's line, read in place, and its ghost (C's caller buffer,
    // `cmdline.c:2443-2455`).
    line: List[byte],
    ghost: List[byte],
}

/// Empty buffers: each grows to its frame's size on first use.
pub fn drawbufs_new() -> DrawBufs {
    DrawBufs {
        cluster: List[byte](),
        reader: text.cluster_reader_new(),
        num: List[byte](),
        status: statustext_new(),
        segs: List[StatusSeg](),
        seg_text: List[byte](),
        path: List[byte](),
        msg: List[byte](),
        label: List[byte](),
        count: List[byte](),
        foot: List[byte](),
        line: List[byte](),
        ghost: List[byte](),
    }
}

/// `v`'s decimal digits appended to `out` in place (C's `%llu` into a
/// caller's buffer): no `str` is built.
pub fn push_dec(mut out: List[byte], v_in: int) {
    var v = v_in
    if v < 0 {
        (mut out).push(45 as byte)
        v = 0 - v
    }
    var scale = 1
    while v / scale >= 10 {
        scale = scale * 10
    }
    while scale > 0 {
        (mut out).push((48 + v / scale % 10) as byte)
        scale = scale / 10
    }
}
