//! edit.word — STUB until the word fork lands (yw03-word): the W unit
//! engine (`src/edit/word.c`) with UAX #29 word boundaries.

use text

fn word_stub_touch(mut tb: text.TextBuf, p: int) -> int {
    let at = motion_clamp(tb, p)
    if at > 0 {
        return text.grapheme_prev_boundary(mut tb, at as text.ByteOff) as int + at - at
    }
    at
}

fn word_stub(u: UnitCtx, alt: bool) {
    if u.has_win && alt {
        bug("unreachable")
    }
    bug("not yet ported: the word unit engine (yw03-word)")
}

// stub: `word_next` until the fork lands.
fn word_next(mut tb: text.TextBuf, u: UnitCtx, p: int, alt: bool) -> int {
    word_stub(u, alt)
    let at = word_stub_touch(mut tb, p)
    at
}

// stub: `word_prev` until the fork lands.
fn word_prev(mut tb: text.TextBuf, u: UnitCtx, p: int, alt: bool) -> int {
    word_stub(u, alt)
    let at = word_stub_touch(mut tb, p)
    at
}

// stub: `word_home` until the fork lands.
fn word_home(mut tb: text.TextBuf, u: UnitCtx, p: int, alt: bool) -> int {
    word_stub(u, alt)
    let at = word_stub_touch(mut tb, p)
    at
}

// stub: `word_end` until the fork lands.
fn word_end(mut tb: text.TextBuf, u: UnitCtx, p: int, alt: bool) -> int {
    word_stub(u, alt)
    let at = word_stub_touch(mut tb, p)
    at
}

// stub: `word_unit_span` until the fork lands.
fn word_unit_span(mut tb: text.TextBuf, u: UnitCtx, p: int, alt: bool) -> text.Span {
    word_stub(u, alt)
    let at = word_stub_touch(mut tb, p)
    text.span(at, at)
}

// `yew_unicode_is_white_space` (`unicode/wordbreak.c`), until the fork.
fn unicode_is_white_space(cp: int) -> bool {
    word_stub(unitctx_text(), false)
    cp == 32
}
