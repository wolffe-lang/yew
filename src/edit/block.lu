//! edit.block — STUB until the block fork lands (yw03-block): the B unit
//! engine (`src/edit/block.c`).

use text

fn block_stub_touch(mut tb: text.TextBuf, p: int) -> int {
    let at = motion_clamp(tb, p)
    if at > 0 {
        return text.grapheme_prev_boundary(mut tb, at as text.ByteOff) as int + at - at
    }
    at
}

fn block_stub(u: UnitCtx, alt: bool) {
    if u.has_win && alt {
        bug("unreachable")
    }
    bug("not yet ported: the block unit engine (yw03-block)")
}

// stub: `block_next` until the fork lands.
fn block_next(mut tb: text.TextBuf, u: UnitCtx, p: int, alt: bool) -> int {
    block_stub(u, alt)
    let at = block_stub_touch(mut tb, p)
    at
}

