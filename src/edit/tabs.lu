//! edit.tabs — the tab model, the tab strip and the tab commands.
//!
//! Ports sagitta `src/ui/tabs.c` (2,197 lines) and `ui/tabs.h` (327) at
//! 9ace98c2 whole as far as campaign 05's first half reaches, under
//! `s23-tabs.md`, `s24-tab-groups.md` §3/§7 and `s57_8-modern-tabs.md`:
//! a `Tab` owns a pane tree and carries a STABLE `tab_id` (monotonic,
//! never reused) that survives the array's compaction, so anything that
//! must name "this tab" across a mutation holds the id (`tabs.h:4-16`);
//! closing decides the survivor BY ID before compacting; reorder is an
//! insertion; the modified `*` is ASKED of the undo tree every time,
//! never cached (s23 DoD 4); the 512-tab cap refuses loudly and every
//! `tab_open` result is checked; a file tab is born non-resident and is
//! read at its first switch (`tab_hydrate`, s24 §3); the row-1 entry
//! list is built in one place (`tab_row1_entries`), laid out by the ONE
//! strip engine (`edit.strip`) and registered with the cells it drew;
//! s57.8's padded, bracket-free pills, the theme roles and the ` + `
//! tail; the dirty-close prompt holds the tab ID; numbered jumps jump
//! now and arm the 500 ms digit window. Replaces yw03's one-tab strip
//! (R-yw03-3) and yw04's narrow open and close (R-yw04-5).
//!
//! C's file statics — the jump window, the two strip slot tables, the
//! chevron flag — are fields of the `Ed` (E1010: module state of a
//! run-time value). Sprint 27 §4's drag picture (yw06) is here as C's:
//! the held entry's preview and gap on both rows, the float, the dwell's
//! cue and the dwell-opened member strip, each asked of `edit.mouse`. What
//! is NOT here, by owner: the group values and `ed.group.*` (Sprint 24: `edit.groups`), the
//! FUSS inset (s57.7, yw13), the Fletch hooks (yw09), workspace state
//! (s25, yw06), `ed.tab.split_*` (`pane_cmds.c`, `edit.pane_cmds`).

use fl
use term
use text
use ws

/// `YEW_TAB_MAX` (`tabs.h:30-35`): a directory opened as a group
/// routinely exceeds a small cap.
pub const TAB_MAX: int = 512

/// `YEW_TAB_LABEL_MAX` (`tabs.h:34`).
pub const TAB_LABEL_MAX: int = 64

/// `YEW_JUMP_WINDOW_MS` (`tabs.h:290-292`): the digit-extension window.
pub const JUMP_WINDOW_MS: int = 500

/// The jump window's expiry (`jump_expire`, `tabs.c:1796-1811`), a kind
/// on the loop's timer heap.
pub const TIMER_TAB_JUMP: int = 30

/// `JUMP_ROW1` (`tabs.c:1734-1737`): a number counts row 1.
pub const JUMP_ROW1: int = 0

/// `JUMP_MEMBER`: a number counts the active group's members.
pub const JUMP_MEMBER: int = 1

/// One row's slot table (`StripSlots`, `tabs.c:880-897`): the half-open
/// screen cells each entry was drawn in (0/0 when the layout scrolled it
/// off) and the payload that occupied the position before a drag's
/// permutation. The lists keep their storage across frames; `n` is the
/// live length (G33: a rebuilt list is held to the session's end).
pub struct StripSlots {
    col0: List[int],
    col1: List[int],
    pre: List[int],
    n: int,
    y: int,
    tail_x: int,
}

/// An empty slot table.
pub fn strip_slots_new() -> StripSlots {
    StripSlots {
        col0: List[int](),
        col1: List[int](),
        pre: List[int](),
        n: 0,
        y: 0,
        tail_x: 0,
    }
}

// Grow a slot table's storage to `n` and reset its live part
// (`strip_render_row1`'s clearing loop, `tabs.c:1069-1078`).
fn slots_reset(mut s: StripSlots, n: int, y: int, x: int) {
    while s.col0.len < n {
        (mut s.col0).push(0)
        (mut s.col1).push(0)
        (mut s.pre).push(0)
    }
    s.n = n
    s.y = y
    s.tail_x = x
    var i = 0
    while i < n {
        s.col0[i] = 0
        s.col1[i] = 0
        i += 1
    }
}

// ---- the scroll ownership (s57.15 §1) -----------------------------------

/// `yew_tabs_scroll_owned` (`tabs.c:39-51`): the offset on this row is
/// now the USER'S.
pub fn tabs_scroll_owned(mut ed: Ed, row2: bool) {
    if row2 {
        ed.tab_member_scroll_user = true
    } else {
        ed.tab_scroll_user = true
    }
}

/// `yew_tabs_follow_active` (`tabs.c:53-59`): both rows follow again.
pub fn tabs_follow_active(mut ed: Ed) {
    ed.tab_scroll_user = false
    ed.tab_member_scroll_user = false
}

/// `yew_tabs_scroll_is_owned` (`tabs.c:61-66`).
pub fn tabs_scroll_is_owned(ed: Ed, row2: bool) -> bool {
    if row2 then ed.tab_member_scroll_user else ed.tab_scroll_user
}

// ---- the model -----------------------------------------------------------

// `tab_destroy` (`tabs.c:68-89`): each leaf's window released, then the
// tree's nodes freed. The buffer stays in the workspace's list.
fn tab_destroy(mut ed: Ed, idx: int) {
    let root = ed.tabs[idx].root
    if pane_live(ed, root) {
        let leaves = pane_collect_leaves(ed, root, PANE_MAX_LEAVES * 2)
        for l in leaves {
            ed_win_release(mut ed, ed.panes[l].win)
        }
        pane_free(mut ed, root)
    }
    ed.tabs[idx].root = -1
    ed.tabs[idx].focus = -1
}

/// `yew_tab_count` (`tabs.c:125-128`).
pub fn tab_count(ed: Ed) -> int {
    ed.tabs.len
}

/// `yew_tab_display_path` (`tabs.c:144-149`): the logical spelling, else
/// the canonical path; "" for an untitled tab.
pub fn tab_display_path(t: Tab) -> str {
    if !t.has_path {
        return ""
    }
    if t.display_path.len != 0 then t.display_path else t.path
}

/// `yew_tab_index_of_id` (`tabs.c:151-163`): the index, or -1 — gone,
/// rather than "whatever is there now". Id 0 is never a tab.
pub fn tab_index_of_id(ed: Ed, id: int) -> int {
    if id == 0 {
        return -1
    }
    var i = 0
    while i < ed.tabs.len {
        if ed.tabs[i].tab_id == id {
            return i
        }
        i += 1
    }
    -1
}

/// `canonical_path` (`tabs.c:165-188`): the realpath, or the path as
/// typed when it does not exist yet; "" for no path (C's NULL, which an
/// empty path also gives).
pub fn canonical_path(path: str) -> str {
    if path.len == 0 {
        return ""
    }
    text.file_realpath(path) else path
}

/// `logical_path` (`tabs.c:190-219`): the canonical path under the
/// workspace root, else the spelling the user typed (an absolute one
/// kept as typed: Darwin's /tmp alias), else the canonical path.
pub fn logical_path(ed: Ed, path: str, canonical: str) -> str {
    if canonical.len == 0 {
        return ""
    }
    let root = ed.ws_dir
    if root.len != 0 {
        if root == "/" && canonical.starts_with("/") && canonical.len > 1 {
            return canonical[1..]
        }
        if canonical.starts_with(root) &&
            canonical.len > root.len + 1 &&
            canonical.bytes()[root.len] as int == 47 {
            return canonical[root.len + 1..]
        }
    }
    if path.starts_with("/") {
        return path
    }
    var p = path
    while p.starts_with("./") {
        p = p[2..]
    }
    if p.len != 0 {
        return p
    }
    canonical
}

/// `yew_tab_find_by_path` (`tabs.c:221-241`): the tab whose canonical
/// path is the same FILE (`yew_file_same_identity`: the same spelling or
/// the same device and inode), or -1.
pub fn tab_find_by_path(ed: Ed, path: str) -> int {
    let want = canonical_path(path)
    if want.len == 0 {
        return -1
    }
    var i = 0
    while i < ed.tabs.len {
        if ed.tabs[i].has_path && text.file_same_identity(ed.tabs[i].path, want) {
            return i
        }
        i += 1
    }
    -1
}

/// `yew_tab_set_path` (`tabs.c:243-258`): renames what a tab shows (the
/// save-as path), canonicalized here, at the one site that establishes a
/// tab's name.
pub fn tab_set_path(mut ed: Ed, idx: int, path: str) {
    if idx < 0 || idx >= ed.tabs.len {
        return
    }
    let canonical = canonical_path(path)
    let display = logical_path(ed, path, canonical)
    ed.tabs[idx].path = canonical
    ed.tabs[idx].display_path = display
    ed.tabs[idx].has_path = canonical.len != 0
    state_mark_dirty(mut ed)
}

/// `yew_ws_file_buf` (`ed.c:378-417`): the workspace's ONE buffer for
/// `path` (two buffers on one path are two claims on one save
/// destination), else a new one — born NON-resident for a file (the read
/// is the first switch's), born loaded and empty for an untitled tab
/// ("" path), which has nowhere to be read from. Answers its index.
pub fn ws_file_buf(mut ed: Ed, path: str) -> int {
    if !ed.model_ready {
        return -1
    }
    if path.len != 0 {
        var i = 0
        while i < ed.bufs.len {
            if !ed.bufs[i].has_name &&
                ed.bufs[i].has_path &&
                text.file_same_identity(ed.bufs[i].path, path) {
                return i
            }
            i += 1
        }
    }
    if path.len == 0 {
        let b = buffer_around(mut ed, take text.textbuf_new(), text.filemeta_new(), "", false)
        (mut ed.bufs).push(b)
        return ed.bufs.len - 1
    }
    let id = ed.next_buf_id
    ed.next_buf_id += 1
    var ec = text.editctx_new(take text.textbuf_new())
    ec.meta = text.filemeta_new()
    ec.change_hook = true
    ec.change_buf_id = id
    (mut ed.bufs).push(Buffer {
        id: id,
        ec: ec,
        resident: false,
        path: path,
        has_path: true,
        name: "",
        has_name: false,
        flags: 0,
        tabwidth: VP_TABWIDTH,
        recovery_pending: false,
        pairs: pairstate_new(),
        named: named_marks_new(),
        macro_reg: 0,
    })
    ed.bufs.len - 1
}

/// A tab on buffer id `buffer_id` whose tree is the one leaf `leaf`
/// (`tabs.c:308-325`): ungrouped, ordinal 0.
pub fn tab_value(tid: int, buffer_id: int, leaf: int, path: str, display: str) -> Tab {
    Tab {
        tab_id: tid,
        buffer_id: buffer_id,
        root: leaf,
        focus: leaf,
        path: path,
        display_path: display,
        has_path: path.len != 0,
        group_id: 0,
        group_ordinal: 0,
        missing_at_restore: false,
    }
}

/// `yew_tab_open` (`tabs.c:260-339`): one tab per file — a path already
/// open is switched to and its own buffer shown again (a scratch view in
/// its focused pane gives way); else, under the cap, a new tab with a
/// view cloned from the focused window pointed at the file's buffer, its
/// tree one leaf. "" opens an untitled tab. Answers the index, -1 when
/// refused (the message says why) — every caller checks it (DoD 6).
pub fn tab_open(mut ed: Ed, path: str) -> int {
    if path.len != 0 {
        let existing = tab_find_by_path(ed, path)
        if existing >= 0 {
            let doc = ed_buf_index(ed, ed.tabs[existing].buffer_id)
            let was_loaded = doc >= 0 && ed.bufs[doc].resident
            tab_switch(mut ed, existing)
            if doc < 0 || buf_hydrate(mut ed, doc) != 0 {
                ed_msg(mut ed, MSG_ERROR, "could not open {path}")
                return -1
            }
            ed_show_buffer(mut ed, doc)
            if ed.win < 0 || ed.wins[ed.win].buf != doc {
                ed_msg(mut ed, MSG_ERROR, "could not open {path}")
                return -1
            }
            // tabs.c:290-291: computed before the switch, whose hydrate
            // fires buf.open too, as C's does.
            if !was_loaded {
                ed_hook_buffer(mut ed, fl.FL_EV_BUF_OPEN, doc)
            }
            if ed.prompt == PROMPT_NONE && ed.bufs[doc].recovery_pending {
                ed_prompt(mut ed, PROMPT_RECOVER)
            }
            return existing
        }
    }
    if ed.tabs.len >= TAB_MAX {
        ed_msg(mut ed, MSG_ERROR, "too many tabs (max {TAB_MAX})")
        return -1
    }
    let win = ed_win_clone(mut ed, ed.win)
    if win < 0 {
        ed_msg(mut ed, MSG_ERROR, "no room for another view")
        return -1
    }
    let tid = ed.next_tab_id
    ed.next_tab_id += 1
    let canonical = canonical_path(path)
    let display = logical_path(ed, path, canonical)
    let bi = ws_file_buf(mut ed, canonical)
    if bi < 0 {
        ed_win_release(mut ed, win)
        ed_msg(mut ed, MSG_ERROR, "no room for another buffer")
        return -1
    }
    ed_win_set_buffer(mut ed, win, bi)
    apply_win_opts(ed.opts, mut ed.wins[win])
    let leaf = pane_new_leaf(mut ed, win)
    (mut ed.tabs).push(tab_value(tid, ed.bufs[bi].id, leaf, canonical, display))
    mouse_tabs_changed(mut ed)
    // s57.15 §1: an OPEN changes the entry list under the offset; a tab
    // opened for a group is never switched to, so the follow resumes here.
    tabs_follow_active(mut ed)
    state_mark_dirty(mut ed)
    ed.tabs.len - 1
}

/// `yew_tab_open_buffer` (`tabs.c:341-372`): a new untitled tab showing
/// the existing buffer index `bi` (A-e's scratch, s57.31 §2), not
/// switched to; -1 when refused.
pub fn tab_open_buffer(mut ed: Ed, bi: int) -> int {
    if ed.win < 0 || bi < 0 || bi >= ed.bufs.len {
        return -1
    }
    if ed.tabs.len >= TAB_MAX {
        ed_msg(mut ed, MSG_ERROR, "too many tabs (max {TAB_MAX})")
        return -1
    }
    let win = ed_win_clone(mut ed, ed.win)
    if win < 0 {
        ed_msg(mut ed, MSG_ERROR, "no room for another view")
        return -1
    }
    let tid = ed.next_tab_id
    ed.next_tab_id += 1
    ed_win_set_buffer(mut ed, win, bi)
    apply_win_opts(ed.opts, mut ed.wins[win])
    let leaf = pane_new_leaf(mut ed, win)
    (mut ed.tabs).push(tab_value(tid, ed.bufs[bi].id, leaf, "", ""))
    mouse_tabs_changed(mut ed)
    tabs_follow_active(mut ed)
    state_mark_dirty(mut ed)
    ed.tabs.len - 1
}

// `pick_survivor_id` (`tabs.c:374-391`): which tab is active once `idx`
// is gone — decided by ID, BEFORE the compaction.
fn pick_survivor_id(ed: Ed, idx: int) -> int {
    let active = ed.tab_active
    let n = ed.tabs.len
    if active != idx {
        return if active >= 0 && active < n then ed.tabs[active].tab_id else 0
    }
    if idx + 1 < n {
        return ed.tabs[idx + 1].tab_id
    }
    if idx - 1 >= 0 {
        return ed.tabs[idx - 1].tab_id
    }
    0
}

/// `yew_tab_close` (`tabs.c:393-424`): the survivor chosen by id before
/// the compaction; the tab leaves its group while `idx` still names it;
/// its tree and windows freed; the survivor resolved after, from the id.
/// False only for an index that names no tab (the veto is the
/// command's).
pub fn tab_close(mut ed: Ed, idx: int) -> bool {
    if idx < 0 || idx >= ed.tabs.len {
        return false
    }
    let survivor = pick_survivor_id(ed, idx)
    group_remove_member(mut ed, idx)
    tab_destroy(mut ed, idx)
    // The compaction, in place: everything above `idx` slides down one.
    var i = idx
    while i + 1 < ed.tabs.len {
        ed.tabs[i] = copy ed.tabs[i + 1]
        i += 1
    }
    let _ = (mut ed.tabs).pop()
    mouse_tabs_changed(mut ed)
    ed.tab_active = tab_index_of_id(ed, survivor)
    if ed.tab_active < 0 && ed.tabs.len > 0 {
        ed.tab_active = 0
    }
    tab_switch(mut ed, ed.tab_active)
    state_mark_dirty(mut ed)
    true
}

/// `yew_tab_switch` (`tabs.c:426-484`): the strip resumes following (the
/// one funnel every active-entry change goes through, before the bail);
/// the tab is hydrated FIRST, then its tree is the visible one — each
/// window owns its cursors and viewport, so swapping the tree is the
/// whole switch; a pending recovery asks.
pub fn tab_switch(mut ed: Ed, idx: int) {
    tabs_follow_active(mut ed)
    let before = ed.win
    if idx < 0 || idx >= ed.tabs.len {
        if ed.tabs.len == 0 {
            ed.tab_active = -1
        }
        return
    }
    ed.tab_active = idx
    let _ = tab_hydrate(mut ed, idx)
    ed.pane_root = ed.tabs[idx].root
    ed.focus = ed.tabs[idx].focus
    if pane_live(ed, ed.focus) && ed.panes[ed.focus].win >= 0 {
        ed.win = ed.panes[ed.focus].win
    }
    if ed.prompt == PROMPT_NONE && ed.win >= 0 {
        let bi = ed.wins[ed.win].buf
        if bi >= 0 && ed.bufs[bi].recovery_pending {
            ed_prompt(mut ed, PROMPT_RECOVER)
        }
    }
    ed.layout_dirty = true
    ed.full_damage = true
    state_mark_dirty(mut ed)
    if ed.win != before {
        let w = ed.win
        ed_hook_window(mut ed, fl.FL_EV_WIN_FOCUS, w)
    }
}

/// `yew_tab_shifted_index` (`tabs.c:486-493`): where index `i` lands when
/// `from` moves to `to`.
pub fn tab_shifted_index(i: int, from: int, to: int) -> int {
    if i == from {
        return to
    }
    if to > from {
        return if i > from && i <= to then i - 1 else i
    }
    if i >= to && i < from then i + 1 else i
}

/// `yew_tab_reorder` (`tabs.c:495-518`): an INSERTION, so the tabs the
/// moved one passes keep their relative order; the active tab is a
/// position, remapped through the shift.
pub fn tab_reorder(mut ed: Ed, from: int, to: int) {
    let n = ed.tabs.len
    if from < 0 || from >= n || to < 0 || to >= n || from == to {
        return
    }
    let moved = copy ed.tabs[from]
    if to > from {
        var i = from
        while i < to {
            ed.tabs[i] = copy ed.tabs[i + 1]
            i += 1
        }
    } else {
        var i = from
        while i > to {
            ed.tabs[i] = copy ed.tabs[i - 1]
            i -= 1
        }
    }
    ed.tabs[to] = moved
    if ed.tab_active >= 0 {
        ed.tab_active = tab_shifted_index(ed.tab_active, from, to)
    }
    state_mark_dirty(mut ed)
}

/// `yew_tab_modified` (`tabs.c:520-537`): ASKED of the focused window's
/// buffer every time (`yew_buf_dirty`), never remembered — undoing back
/// to the clean state clears the marker.
pub fn tab_modified(ed: Ed, idx: int) -> bool {
    if idx < 0 || idx >= ed.tabs.len {
        return false
    }
    let w = tab_focus_win(ed, idx)
    if w < 0 || w >= ed.wins.len {
        return false
    }
    let bi = ed.wins[w].buf
    bi >= 0 && bi < ed.bufs.len && buf_dirty(ed.bufs[bi])
}

/// `yew_tab_buffer` (`tabs.c:543-550`): the buffer index the tab's
/// focused window shows, -1 for none.
pub fn tab_buffer(ed: Ed, idx: int) -> int {
    let w = tab_focus_win(ed, idx)
    if w < 0 || w >= ed.wins.len then -1 else ed.wins[w].buf
}

/// `yew_tab_is_resident` (`tabs.c:552-560`): asked of the buffer — does
/// it hold its text (ruling R-yw05-4 = A: the piece tree built) — never
/// of a tab flag.
pub fn tab_is_resident(ed: Ed, idx: int) -> bool {
    let bi = tab_buffer(ed, idx)
    bi >= 0 && ed.bufs[bi].resident
}

/// `yew_buf_hydrate` (`ed.c:426-484`): read a non-resident file buffer —
/// a missing path opens empty — with the undo tree at its save point and
/// the journal probe that arms recovery. Answers 0, or -1 when the read
/// failed (or there is no path to read).
pub fn buf_hydrate(mut ed: Ed, bi: int) -> int {
    if bi < 0 || bi >= ed.bufs.len {
        return -1
    }
    if ed.bufs[bi].resident {
        return 0
    }
    if !ed.bufs[bi].has_path {
        return -1
    }
    let (status, tb, meta) = if sp_byte_path(ed, bi) {
        (text.LOAD_ENOENT, text.textbuf_new(), text.filemeta_new())
    } else {
        text.file_load(ed.bufs[bi].path)
    }
    if status != text.LOAD_OK && status != text.LOAD_ENOENT {
        return -1
    }
    let id = ed.bufs[bi].id
    var ec = text.editctx_new(take tb)
    ec.undo = text.undo_new(ec.tb)
    ec.has_undo = true
    text.undo_mark_saved(mut ec.undo, ec.tb)
    ec.marks = text.marks_new()
    ec.has_marks = true
    ec.meta = meta
    ec.has_meta = true
    ec.change_hook = true
    ec.change_buf_id = id
    ec.changes = ed.bufs[bi].ec.changes
    ed.bufs[bi].ec.changes = text.changelist_new()
    ed.bufs[bi].ec = ec
    ed.bufs[bi].resident = true
    // Pending state marks materialize only once text exists (ed.c:462-481).
    var mark = 0
    let size = text.textbuf_len(ed.bufs[bi].ec.tb)
    while mark < 26 {
        if ed.bufs[bi].named.pending_set[mark] {
            ed.bufs[bi].named.pending_set[mark] = false
            let offset = ed.bufs[bi].named.pending[mark]
            let _ = ed_mark_set(mut ed, bi, 97 + mark, if offset > size then size else offset)
            state_wire_clear(mut ed, ws.STATE_REC_MARK, ed.bufs[bi].id, 97 + mark, "pos")
        }
        mark += 1
    }
    ed.bufs[bi].tabwidth = ed.opts.tabwidth
    ed.bufs[bi].recovery_pending = !ed.headless &&
        ed.bufs[bi].ec.meta.has_realpath &&
        text.journal_probe(ed.journals, ed.bufs[bi].ec.meta.realpath, ed.bufs[bi].ec.meta)
    0
}

/// `yew_tab_hydrate` (`tabs.c:562-626`): resident returns without
/// touching the disk; else the read, then the view rebuilt against the
/// text with its SCROLL POSITION kept (s25 §6 restores it into a deferred
/// tab's window first), and every cursor of the tab's windows on that
/// buffer normalized against the text it now has. Answers 0 or -1.
pub fn tab_hydrate(mut ed: Ed, idx: int) -> int {
    let bi = tab_buffer(ed, idx)
    if bi < 0 || idx < 0 || idx >= ed.tabs.len {
        return -1
    }
    if ed.bufs[bi].resident {
        return 0
    }
    if buf_hydrate(mut ed, bi) != 0 {
        let what = if ed.tabs[idx].has_path then ed.tabs[idx].path else "untitled"
        ed_msg(mut ed, MSG_ERROR, "could not read {what}")
        return -1
    }
    let w = tab_focus_win(ed, idx)
    if w >= 0 {
        let top = ed.wins[w].vp.top
        let top_sub = ed.wins[w].vp.top_sub
        let left = ed.wins[w].vp.left
        let wrap = ed.wins[w].vp.wrap
        let number_style = ed.wins[w].number_style
        vp_init(mut ed.wins[w])
        ed.wins[w].number_style = number_style
        ed.wins[w].vp.top = top
        ed.wins[w].vp.top_sub = top_sub
        ed.wins[w].vp.left = left
        ed.wins[w].vp.wrap = wrap
        vp_clamp(mut ed.wins[w], ed.bufs[bi].ec.tb)
        state_wire_clear(mut ed, ws.STATE_REC_VIEW, ed.wins[w].id, 0, "top")
        if ed.wins[w].vp.wrap {
            state_wire_clear(mut ed, ws.STATE_REC_VIEW, ed.wins[w].id, 0, "left")
        }
    }
    let root = ed.tabs[idx].root
    if pane_live(ed, root) {
        let leaves = pane_collect_leaves(ed, root, PANE_MAX_LEAVES * 2)
        for l in leaves {
            let lw = ed.panes[l].win
            if lw >= 0 && ed.wins[lw].buf == bi {
                text.cset_normalize(ed.bufs[bi].ec.tb, mut ed.wins[lw].cs)
                state_wire_clear(mut ed, ws.STATE_REC_CURSOR, ed.wins[lw].id, -1, "")
            }
        }
    }
    ed_hook_buffer(mut ed, fl.FL_EV_BUF_OPEN, bi)
    0
}

// ---- the row-1 entries (s23 §3, s57.8 §1) ----------------------------------

// `tab_label` (`tabs.c:664-679`): " N basename* " — N the tab's POSITION
// ON ITS ROW (s57.10), the `*` asked for, never remembered; padding is
// part of the hit span. Capped as C's 64-byte buffer leaves it.
fn tab_label(ed: Ed, idx: int, num: int) -> List[byte] {
    let mark = if tab_modified(ed, idx) then glyph(GLYPH_MODIFIED) else ""
    strip_label_cap(bytes_of(" {num} {tab_basename(ed, ed.tabs[idx])}{mark} "))
}

// `tab_group_label` (`tabs.c:681-711`): " N label " with the label
// clipped so the trailing pad always fits in the 64-byte entry.
fn tab_group_label(number: int, label: str) -> List[byte] {
    var out = bytes_of(" {number} ")
    let lb = bytes_of(label)
    var keep = lb.len
    if keep > TAB_LABEL_MAX - out.len - 2 {
        keep = TAB_LABEL_MAX - out.len - 2
    }
    var i = 0
    while i < keep {
        (mut out).push(lb[i])
        i += 1
    }
    (mut out).push(32 as byte)
    out
}

// `tab_is_orphan` (`tabs.c:713-731`): outside the workspace root (a
// prefix test on two canonical spellings), or gone at restore (s25 §6).
fn tab_is_orphan(ed: Ed, idx: int) -> bool {
    if ed.tabs[idx].missing_at_restore {
        return true
    }
    ed.tabs[idx].has_path && ed.ws_dir.len != 0 && !ed.tabs[idx].path.starts_with(ed.ws_dir)
}

/// `yew_tab_row1_entries` (`tabs.c:733-788`): THE row-1 entry list — a
/// group is one entry where its FIRST member sits, payload = −gid, with
/// its label; an ungrouped tab is itself, payload = its index. Members
/// never appear individually on row 1.
pub fn tab_row1_entries(ed: Ed) -> List[StripEntry] {
    var out = List[StripEntry]()
    var seen = List[int]()
    var i = 0
    while i < ed.tabs.len {
        let gid = ed.tabs[i].group_id
        if gid != 0 {
            var dup = false
            for s in seen {
                if s == gid {
                    dup = true
                }
            }
            if !dup {
                (mut seen).push(gid)
                (mut out).push(StripEntry {
                    label: tab_group_label(out.len + 1, group_label(ed, gid)),
                    payload: -gid,
                    dim: false,
                    modified: false,
                })
            }
        } else {
            let label = tab_label(ed, i, out.len + 1)
            (mut out).push(StripEntry {
                label: label,
                payload: i,
                dim: tab_is_orphan(ed, i),
                modified: tab_modified(ed, i),
            })
        }
        i += 1
    }
    out
}

/// `yew_tab_row1_active` (`tabs.c:790-808`): the entry the active tab
/// belongs to (its group's, inside one), -1 for none.
pub fn tab_row1_active(ed: Ed, entries: List[StripEntry]) -> int {
    if ed.tab_active < 0 {
        return -1
    }
    let gid = active_group_id(ed)
    var i = 0
    while i < entries.len {
        if gid != 0 {
            if entries[i].payload == -gid {
                return i
            }
        } else if entries[i].payload == ed.tab_active {
            return i
        }
        i += 1
    }
    -1
}

/// `yew_tab_strip_rows` (`tabs.c:810-842`): one row whenever row one has
/// an entry (s57.8: even one tab owns a row, its tail carries the
/// new-untitled action); two inside a group, and two while a dwell has
/// opened a group's member strip as a drop target (Sprint 27 §4).
pub fn tab_strip_rows(ed: Ed) -> int {
    var rows = if ed.tabs.len > 0 then 1 else 0
    if active_group_id(ed) != 0 {
        rows = 2
    }
    if mouse_preview_group(ed) != 0 {
        rows = 2
    }
    rows
}

// ---- the slot tables (Sprint 27 §4, s57.14) ---------------------------------

/// `yew_strip_slot_at` (`tabs.c:902-915`): the row-1 slot under (x, y),
/// -1 off row 1.
pub fn strip_slot_at(ed: Ed, x: int, y: int) -> int {
    if ed.strip_row1.n == 0 || y != ed.strip_row1.y {
        return -1
    }
    var i = 0
    while i < ed.strip_row1.n {
        if x >= ed.strip_row1.col0[i] && x < ed.strip_row1.col1[i] {
            return i
        }
        i += 1
    }
    -1
}

/// `yew_strip_pre_payload` (`tabs.c:917-923`).
pub fn strip_pre_payload(ed: Ed, slot: int) -> (bool, int) {
    if slot < 0 || slot >= ed.strip_row1.n {
        return (false, 0)
    }
    (true, ed.strip_row1.pre[slot])
}

/// `yew_strip_slot_cells` (`tabs.c:925-938`): false for a slot the
/// layout scrolled off.
pub fn strip_slot_cells(ed: Ed, slot: int) -> (bool, int, int) {
    if slot < 0 || slot >= ed.strip_row1.n || ed.strip_row1.col1[slot] <= ed.strip_row1.col0[slot] {
        return (false, 0, 0)
    }
    (true, ed.strip_row1.col0[slot], ed.strip_row1.col1[slot])
}

/// `yew_strip_slot_count` (`tabs.c:940-943`).
pub fn strip_slot_count(ed: Ed) -> int {
    ed.strip_row1.n
}

/// `yew_strip_tail_x` (`tabs.c:945-948`).
pub fn strip_tail_x(ed: Ed) -> int {
    ed.strip_row1.tail_x
}

/// `yew_strip_member_slot_count` (`tabs.c:959-962`).
pub fn strip_member_slot_count(ed: Ed) -> int {
    ed.strip_row2.n
}

/// `yew_strip_member_slot_cells` (`tabs.c:964-974`).
pub fn strip_member_slot_cells(ed: Ed, slot: int) -> (bool, int, int) {
    if slot < 0 || slot >= ed.strip_row2.n || ed.strip_row2.col1[slot] <= ed.strip_row2.col0[slot] {
        return (false, 0, 0)
    }
    (true, ed.strip_row2.col0[slot], ed.strip_row2.col1[slot])
}

/// `yew_strip_member_tail_x` (`tabs.c:976-980`).
pub fn strip_member_tail_x(ed: Ed) -> int {
    ed.strip_row2.tail_x
}

// ---- the renderer ----------------------------------------------------------

// `tab_base_style` (`tabs.c:1081-1101`).
fn tab_base_style(ed: Ed) -> ThemeEnt {
    let r = theme_rendition_of(ed.render)
    let (hf, fg) = theme_ui(ed.theme, "fg", r)
    let (hb, bg) = theme_ui(ed.theme, "bg", r)
    var style = ThemeEnt { fg: term.color_default(), bg: term.color_default(), attrs: 0 }
    if hf {
        if fg.fg.tag != term.COLOR_DEFAULT {
            style.fg = copy fg.fg
        }
        style.attrs = fg.attrs
    }
    if hb {
        if bg.bg.tag != term.COLOR_DEFAULT {
            style.bg = copy bg.bg
        }
        style.attrs = style.attrs | bg.attrs
    }
    style
}

// `tab_role_style` (`tabs.c:1103-1121`): a role is an OVERLAY — a colour
// only where it names one; presence owns the attributes.
fn tab_role_style(ed: Ed, role: str, fallback_in: ThemeEnt) -> ThemeEnt {
    var fallback = fallback_in
    let (ok, themed) = theme_ui(ed.theme, role, theme_rendition_of(ed.render))
    if !ok {
        return fallback
    }
    if themed.fg.tag != term.COLOR_DEFAULT {
        fallback.fg = copy themed.fg
    }
    if themed.bg.tag != term.COLOR_DEFAULT {
        fallback.bg = copy themed.bg
    }
    fallback.attrs = themed.attrs
    fallback
}

// `tab_blank` (`tabs.c:1123-1132`).
fn tab_blank(style: ThemeEnt) -> term.Cell {
    var c = term.cell_blank()
    c.fg = copy style.fg
    c.bg = copy style.bg
    c.attrs = style.attrs
    c
}

// Record a drawn span's cells in the row's slot table (`strip_render`,
// `tabs.c:1260-1268`).
fn slot_record(mut s: StripSlots, idx: int, x0: int, x1: int) {
    if idx >= 0 && idx < s.n {
        s.col0[idx] = x0
        s.col1[idx] = x1
        if x1 > s.tail_x {
            s.tail_x = x1
        }
    }
}

// `strip_render` (`tabs.c:1134-1291`): THE renderer, both rows. The row
// blanked in `tab.bar`; the layout told −1 for a user-owned offset (the
// highlight still uses `active_entry`); each span drawn with the bytes
// that fit and registered with the SAME cells (`REGION_TAB`, the
// payload); `<` and `>N` chevrons registered with ±`scroll_mag` (1 row
// 1, 2 row 2); the ` + ` in otherwise-empty tail space on row 1 only,
// never under right overflow. `held_idx` is a drag's gap (Sprint 27;
// -1 with no drag in flight). Answers the row's new offset.
fn strip_render(
    mut ed: Ed,
    r: Rect,
    entries: List[StripEntry],
    active_entry: int,
    scroll: int,
    user_scroll: bool,
    scroll_mag: int,
    row2: bool,
    draw_new: bool,
    held_idx: int,
) -> int {
    if r.w == 0 || r.h == 0 {
        return scroll
    }
    let n = entries.len
    let base = tab_base_style(ed)
    let surface = tab_role_style(ed, "tab.bar", copy base)
    let inactive = tab_role_style(ed, "tab.inactive", copy surface)
    var modified = copy surface
    modified.attrs = modified.attrs | term.ATTR_BOLD
    modified = tab_role_style(ed, "tab.modified", modified)
    var orphan = copy surface
    orphan.attrs = orphan.attrs | term.ATTR_DIM
    orphan = tab_role_style(ed, "tab.orphan", orphan)
    var act = copy surface
    act.attrs = act.attrs | term.ATTR_REVERSE
    act = tab_role_style(ed, "tab.active", act)
    var add = copy surface
    add.attrs = add.attrs | term.ATTR_BOLD
    add = tab_role_style(ed, "tab.add", add)
    // s57.14 §3: the dwell's cue, asked once per render of the clock
    // (`ed.now_ms`), never of a frame counter (invariant 5).
    let flash_gid = mouse_dwell_flash(ed)
    term.grid_fill(mut ed.grid, r.y, r.x, r.x + r.w, tab_blank(copy surface))
    if n <= 0 {
        return scroll
    }
    // Reserve a cell for `<` when scrolled, so the indicator never
    // overlaps the first entry it points away from.
    var avail = r.w
    if scroll > 0 && avail > 1 {
        avail -= 1
    }
    let lay = strip_layout(entries, avail, if user_scroll then -1 else active_entry, scroll)
    let shift = if lay.more_left then 1 else 0
    var tail_x = r.x + shift
    var s = 0
    while s < lay.spans.len {
        let idx = lay.spans[s].idx
        let x = r.x + lay.spans[s].col0 + shift
        let w = lay.spans[s].col1 - lay.spans[s].col0
        var style = copy inactive
        if idx == active_entry {
            style = copy act
        } else if entries[idx].dim {
            style = copy orphan
        } else if entries[idx].modified {
            style = copy modified
        }
        // The cue TOGGLES reverse rather than substituting a style, so it
        // shows on the active entry too.
        if flash_gid != 0 && entries[idx].payload == 0 - flash_gid {
            style.attrs = style.attrs ^ term.ATTR_REVERSE
        }
        if idx != held_idx {
            let lb = strip_label_bytes(entries[idx].label)
            let _ = term.grid_puts(
                mut ed.grid,
                r.y,
                x,
                entries[idx].label,
                0,
                lb,
                copy style.fg,
                copy style.bg,
                style.attrs,
            )
            region_add(mut ed.regions, REGION_TAB, rect(x, r.y, w, 1), entries[idx].payload)
        }
        tail_x = x + w
        if row2 {
            slot_record(mut ed.strip_row2, idx, x, x + w)
        } else {
            slot_record(mut ed.strip_row1, idx, x, x + w)
        }
        s += 1
    }
    // The chevrons and the `+` through the editor's draw bytes (C's stack
    // buffers; yw05-hot, deliverable 6): no list a frame.
    if lay.more_left {
        clear_bytes(mut ed.dbuf.foot)
        push_str(mut ed.dbuf.foot, glyph(GLYPH_MORE_LEFT))
        let lt_len = ed.dbuf.foot.len
        let _ = term.grid_puts(
            mut ed.grid,
            r.y,
            r.x,
            ed.dbuf.foot,
            0,
            lt_len,
            copy orphan.fg,
            copy surface.bg,
            term.ATTR_DIM,
        )
        region_add(mut ed.regions, REGION_TAB_SCROLL, rect(r.x, r.y, 1, 1), -scroll_mag)
        ed.strip_any_chevron = true
    }
    if lay.more_right {
        let last = if lay.spans.len > 0 then lay.spans[lay.spans.len - 1].idx + 1 else 0
        let past = n - last
        clear_bytes(mut ed.dbuf.foot)
        push_str(mut ed.dbuf.foot, glyph(GLYPH_MORE_RIGHT))
        push_dec(mut ed.dbuf.foot, past)
        let w = ed.dbuf.foot.len
        if w < r.w {
            let x = r.x + r.w - w
            let _ = term.grid_puts(
                mut ed.grid,
                r.y,
                x,
                ed.dbuf.foot,
                0,
                w,
                copy orphan.fg,
                copy surface.bg,
                term.ATTR_DIM,
            )
            region_add(mut ed.regions, REGION_TAB_SCROLL, rect(x, r.y, w, 1), scroll_mag)
            ed.strip_any_chevron = true
        }
    } else if draw_new && tail_x + 3 <= r.x + r.w {
        clear_bytes(mut ed.dbuf.foot)
        push_str(mut ed.dbuf.foot, " + ")
        let _ = term.grid_puts(
            mut ed.grid,
            r.y,
            tail_x,
            ed.dbuf.foot,
            0,
            3,
            copy add.fg,
            copy add.bg,
            add.attrs,
        )
        region_add(mut ed.regions, REGION_TAB_NEW, rect(tail_x, r.y, 3, 1), 0)
    }
    lay.scroll
}

// `apply_drag_preview` (`tabs.c:989-1046`): the held entry drawn where
// it would land — NOTHING in the tab array changes until the drop. The
// FLOAT decides whether an entry is held (a drag with no target yet still
// carries something), insertion not swap moves it, and the active entry
// is remapped as `tab_reorder` would. Answers (the GAP's index, -1 for
// none; the active entry).
fn apply_drag_preview(ed: Ed, mut entries: List[StripEntry], active_in: int) -> (int, int) {
    let (floating, held, _, _, _) = mouse_drag_float(ed)
    if !floating {
        return (-1, active_in)
    }
    let n = entries.len
    var from = -1
    var i = 0
    while i < n {
        if entries[i].payload == held {
            from = i
            break
        }
        i += 1
    }
    // A member dragged off row 2 has no row-1 entry to hold open.
    if from < 0 {
        return (-1, active_in)
    }
    let (has_target, _, target) = mouse_drag_preview(ed)
    if n <= 1 || !has_target {
        return (from, active_in)
    }
    var to = target
    if to < 0 {
        to = 0
    }
    if to >= n {
        to = n - 1
    }
    let moved = copy entries[from]
    if from < to {
        var k = from
        while k < to {
            entries[k] = copy entries[k + 1]
            k += 1
        }
    } else if to < from {
        var k = from
        while k > to {
            entries[k] = copy entries[k - 1]
            k -= 1
        }
    }
    entries[to] = moved
    var active = active_in
    if active >= 0 {
        active = tab_shifted_index(active, from, to)
    }
    (to, active)
}

// `strip_render_row1` (`tabs.c:1053-1079`): the pre-drag list recorded
// and the slot table cleared before the render fills the cells in (a
// slot scrolled out of view must not keep last frame's cells); the drag's
// preview applied to what is drawn. With no drag in flight the pre-drag
// list IS the drawn one, and nothing is copied.
fn strip_render_row1(mut ed: Ed, r: Rect, entries: List[StripEntry], active_entry: int) {
    let n = entries.len
    slots_reset(mut ed.strip_row1, n, r.y, r.x)
    var i = 0
    while i < n {
        ed.strip_row1.pre[i] = entries[i].payload
        i += 1
    }
    let user = tabs_scroll_is_owned(ed, false)
    let scroll = ed.tab_scroll
    let (floating, _, _, _, _) = mouse_drag_float(ed)
    if !floating {
        ed.tab_scroll = strip_render(
            mut ed,
            r,
            entries,
            active_entry,
            scroll,
            user,
            1,
            false,
            true,
            -1,
        )
        return
    }
    var drawn = copy entries
    let (held, active) = apply_drag_preview(ed, mut drawn, active_entry)
    ed.tab_scroll = strip_render(mut ed, r, drawn, active, scroll, user, 1, false, true, held)
}

/// `yew_tab_member_strip_draw` (`tabs.c:1293-1420`): row 2 — the members
/// of `gid`, numbered 1..n, payload = the GLOBAL tab index (so a click is
/// the ordinary `REGION_TAB` case), its own offset and its own slot
/// table, through the same renderer (no `+`).
pub fn tab_member_strip_draw(mut ed: Ed, r: Rect, gid: int) {
    if gid == 0 {
        return
    }
    // Row 2 hides the held member as row 1 does (`tabs.c:1321-1327`): a
    // tab carried at the pointer is not also in the row it left.
    let (floating, held_payload, _, _, _) = mouse_drag_float(ed)
    var order = group_members(ed, gid)
    var held = -1
    // s57.14's field repair, THE GAP on row 2 (`tabs.c:1329-1389`): only
    // while row 2 owns the preview; permuted for a member of this group,
    // INSERTED for a tab joining from outside (its list is one longer).
    let (row2_preview, want_gid, target) = mouse_drag_member_preview(ed)
    if floating && held_payload >= 0 && order.len < TAB_MAX && row2_preview && want_gid == gid {
        var from = -1
        var f = 0
        while f < order.len {
            if order[f] == held_payload {
                from = f
                break
            }
            f += 1
        }
        var to = target
        if from >= 0 {
            if to < 0 {
                to = 0
            }
            if to > order.len - 1 {
                to = order.len - 1
            }
            if from < to {
                var k = from
                while k < to {
                    order[k] = order[k + 1]
                    k += 1
                }
            } else if to < from {
                var k = from
                while k > to {
                    order[k] = order[k - 1]
                    k -= 1
                }
            }
        } else {
            if to < 0 {
                to = 0
            }
            if to > order.len {
                to = order.len
            }
            (mut order).push(0)
            var k = order.len - 1
            while k > to {
                order[k] = order[k - 1]
                k -= 1
            }
        }
        order[to] = held_payload
        held = to
    }
    var entries = List[StripEntry]()
    var active_entry = -1
    var i = 0
    while i < order.len {
        let t = order[i]
        let mark = if tab_modified(ed, t) then glyph(GLYPH_MODIFIED) else ""
        (mut entries).push(StripEntry {
            label: strip_label_cap(bytes_of(" {i + 1} {tab_basename(ed, ed.tabs[t])}{mark} ")),
            payload: t,
            dim: tab_is_orphan(ed, t),
            modified: tab_modified(ed, t),
        })
        if t == ed.tab_active {
            active_entry = i
        }
        if held < 0 && floating && held_payload >= 0 && t == held_payload {
            held = i
        }
        i += 1
    }
    slots_reset(mut ed.strip_row2, order.len, r.y, r.x)
    var k = 0
    while k < order.len {
        ed.strip_row2.pre[k] = order[k]
        k += 1
    }
    let user = tabs_scroll_is_owned(ed, true)
    let scroll = ed.tab_member_scroll
    ed.tab_member_scroll = strip_render(
        mut ed,
        r,
        entries,
        active_entry,
        scroll,
        user,
        2,
        true,
        false,
        held,
    )
}

/// `yew_strip_float_rect` (`tabs.c:1437-1440`): the cells the last
/// render's float covered; `w == 0` when none.
pub fn strip_float_rect(ed: Ed) -> Rect {
    copy ed.strip_float
}

// `n` bytes of `b` at most: `snprintf`'s truncation into a fixed buffer.
fn bytes_cap(b: List[byte], n: int) -> List[byte] {
    if b.len <= n {
        return copy b
    }
    var out = List[byte]()
    var i = 0
    while i < n {
        (mut out).push(b[i])
        i += 1
    }
    out
}

// `strip_float_label` (`tabs.c:1442-1471`): built from the payload (a
// member dragged off row 2 has no row-1 entry to copy) — ` basename* `
// for a tab, ` group (N) ` for a group — with no leading NUMBER: a float
// is between positions.
fn strip_float_label(ed: Ed, payload: int) -> List[byte] {
    if payload < 0 {
        let label = bytes_cap(bytes_of(group_label(ed, 0 - payload)), TAB_LABEL_MAX - 5)
        var out = List[byte]()
        (mut out).push(32 as byte)
        for b in label {
            (mut out).push(b)
        }
        (mut out).push(32 as byte)
        return bytes_cap(out, TAB_LABEL_MAX - 1)
    }
    if payload >= ed.tabs.len {
        return List[byte]()
    }
    let mark = if tab_modified(ed, payload) then glyph(GLYPH_MODIFIED) else ""
    bytes_cap(bytes_of(" {tab_basename(ed, ed.tabs[payload])}{mark} "), TAB_LABEL_MAX - 1)
}

// `strip_draw_float` (`tabs.c:1473-1530`): drawn LAST, after both rows,
// and REGISTERING NO REGION — these cells are already in the user's
// hand; the grip the press took, clamped into the grid on both axes; the
// strip's own active-entry chain, reversed and bold.
fn strip_draw_float(mut ed: Ed) {
    ed.strip_float = rect(0, 0, 0, 0)
    if !ed.grid_ready || ed.grid.cols == 0 || ed.grid.rows == 0 {
        return
    }
    let (ok, payload, px, py_in, grab) = mouse_drag_float(ed)
    if !ok {
        return
    }
    let label = strip_float_label(ed, payload)
    if label.len == 0 {
        return
    }
    var w = strip_label_cells(label)
    if w == 0 {
        return
    }
    if w > ed.grid.cols {
        w = ed.grid.cols
    }
    var x0 = if px > grab then px - grab else 0
    if x0 + w > ed.grid.cols {
        x0 = ed.grid.cols - w
    }
    var py = py_in
    if py >= ed.grid.rows {
        py = ed.grid.rows - 1
    }
    var style = tab_role_style(ed, "tab.active", tab_role_style(ed, "tab.bar", tab_base_style(ed)))
    style.attrs = style.attrs | term.ATTR_REVERSE | term.ATTR_BOLD
    let end = term.grid_puts(
        mut ed.grid,
        py,
        x0,
        label,
        0,
        strip_label_bytes(label),
        copy style.fg,
        copy style.bg,
        style.attrs,
    )
    ed.strip_float = rect(x0, py, if end > x0 then end - x0 else 0, 1)
}

// `strip_draw_rows` (`tabs.c:1532-1560`): row 1, then row 2 when the
// strip has two rows — the PREVIEWED group's when a dwell opened one
// (Sprint 27 §4: the same renderer, so the pinned row and the preview
// cannot disagree), else the active group's — then the float, over
// everything the strip just drew.
fn strip_draw_rows(mut ed: Ed, r: Rect) {
    if r.w == 0 || r.h == 0 {
        return
    }
    let entries = tab_row1_entries(ed)
    let active = tab_row1_active(ed, entries)
    strip_render_row1(mut ed, rect(r.x, r.y, r.w, 1), entries, active)
    var gid = active_group_id(ed)
    if mouse_preview_group(ed) != 0 {
        gid = mouse_preview_group(ed)
    }
    if r.h >= 2 && gid != 0 {
        tab_member_strip_draw(mut ed, rect(r.x, r.y + 1, r.w, 1), gid)
    }
    strip_draw_float(mut ed)
}

/// `yew_tab_strip_draw` (`tabs.c:1562-1588`): the chevron flag reset and
/// row 2's slot table cleared at frame BEGIN (a frame that draws no row 2
/// must not leave the last one's positions answering), then the rows.
pub fn tab_strip_draw(mut ed: Ed, r: Rect) {
    ed.strip_any_chevron = false
    ed.strip_row2.n = 0
    ed.strip_row2.tail_x = 0
    // C's entries, labels and spans are frame-local scratch. Reclaim
    // them after drawing instead of retaining another 832 B per frame.
    region strip_frame {
        strip_draw_rows(mut ed, r)
    }
    mouse_note_chevrons(mut ed, ed.strip_any_chevron)
}

/// `yew_tab_strip_click` (`tabs.c:1590-1646`): a click on a chevron
/// scrolls the row its payload's MAGNITUDE names (±1 row 1, ±2 row 2), in
/// its sign's direction, the offset then the user's; on a tab span a
/// negative payload ENTERS that group (an explicit entry resumes where
/// the user left off), a tab index switches. Anything else is ignored.
pub fn tab_strip_click(mut ed: Ed, x: int, y: int) -> bool {
    let hit = region_hit(mut ed.regions, x, y)
    if hit.kind == REGION_TAB_SCROLL {
        let row2 = hit.payload == 2 || hit.payload == -2
        let cur = if row2 then ed.tab_member_scroll else ed.tab_scroll
        var limit = ed.tabs.len
        if row2 {
            limit = group_member_count(ed, active_group_id(ed))
        }
        var to = cur + (if hit.payload < 0 then -1 else 1)
        if to < 0 {
            to = 0
        }
        if to >= limit {
            to = if limit > 0 then limit - 1 else 0
        }
        if row2 {
            ed.tab_member_scroll = to
        } else {
            ed.tab_scroll = to
        }
        tabs_scroll_owned(mut ed, row2)
        ed.full_damage = true
        return true
    }
    if hit.kind != REGION_TAB {
        return false
    }
    if hit.payload < 0 {
        group_note_position(mut ed)
        group_enter(mut ed, -hit.payload)
        return true
    }
    tab_switch(mut ed, hit.payload)
    true
}

// ---- the commands (s23 §5) ---------------------------------------------------

/// `ed.tab.new` (`yew_tab_cmd_new`, `tabs.c:1652-1666`): an untitled tab,
/// switched to; the cap's refusal is the status.
pub fn tab_cmd_new(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    let idx = tab_open(mut ed, "")
    if idx < 0 {
        return CMD_ERR_STATE
    }
    tab_switch(mut ed, idx)
    CMD_OK
}

/// `ed.tab.open` (`yew_tab_cmd_open`, `tabs.c:1668-1680`).
pub fn tab_cmd_open(mut ed: Ed, cx: CmdCtx) -> int {
    if !cx.has_sarg {
        return CMD_ERR_ARG
    }
    let idx = tab_open(mut ed, cx.sarg)
    if idx < 0 {
        return CMD_ERR_STATE
    }
    tab_switch(mut ed, idx)
    CMD_OK
}

// `tab_step` (`tabs.c:1682-1700`): cyclic.
fn tab_step(mut ed: Ed, delta: int) -> int {
    let n = ed.tabs.len
    if n <= 1 {
        return CMD_OK
    }
    var at = ed.tab_active + delta
    while at < 0 {
        at += n
    }
    tab_switch(mut ed, at % n)
    CMD_OK
}

/// `ed.tab.next` (`tabs.c:1702-1705`).
pub fn tab_cmd_next(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    tab_step(mut ed, 1)
}

/// `ed.tab.prev` (`tabs.c:1707-1710`).
pub fn tab_cmd_prev(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    tab_step(mut ed, -1)
}

// ---- the jump window (s24 §7, s57.10) -----------------------------------------

/// `yew_tab_jump_armed` (`tabs.c:1748-1751`): the test seam.
pub fn tab_jump_armed(ed: Ed) -> bool {
    ed.tab_jump_on
}

/// `yew_tab_jump_clear` (`tabs.c:1753-1763`).
pub fn tab_jump_clear(mut ed: Ed) {
    if ed.tab_jump_timer != 0 {
        let _ = timer_cancel(mut ed.timers, ed.tab_jump_timer)
        ed.tab_jump_timer = 0
    }
    ed.tab_jump_on = false
    ed.tab_jump_value = 0
    ed.tab_jump_deadline_ms = 0
    ed.tab_jump_mode = JUMP_ROW1
}

// `jump_to_row1` (`tabs.c:1765-1789`): row-1 entry `pos` (1-based) —
// switched to, or ENTERED for a group; the position noted first.
fn jump_to_row1(mut ed: Ed, pos: int) -> bool {
    let entries = tab_row1_entries(ed)
    if pos < 1 || pos > entries.len {
        return false
    }
    let payload = entries[pos - 1].payload
    group_note_position(mut ed)
    if payload < 0 {
        group_enter(mut ed, -payload)
    } else {
        tab_switch(mut ed, payload)
    }
    true
}

// `jump_to_member` (`tabs.c:1791-1801`): member `pos` of `gid`, as row 2
// shows it.
fn jump_to_member(mut ed: Ed, gid: int, pos: int) -> bool {
    let members = group_members(ed, gid)
    if pos < 1 || pos > members.len {
        return false
    }
    tab_switch(mut ed, members[pos - 1])
    true
}

/// `jump_expire` (`tabs.c:1803-1818`): the window's timer fired — the
/// hint's promise is withdrawn on an idle editor too.
pub fn tab_jump_expire(mut ed: Ed) {
    if !ed.tab_jump_on {
        return
    }
    ed.tab_jump_timer = 0
    tab_jump_clear(mut ed)
    ed_msg_clear(mut ed)
    ed.footer_dirty = true
}

// `jump_window_allowed` (`tabs.c:1820-1840`): Insert and FUSS read bare
// digits, so they get single-digit jumps only.
fn jump_window_allowed(ed: Ed) -> bool {
    ed.mode != MODE_I && ed.mode != MODE_F
}

// `jump_arm` (`tabs.c:1842-1856`).
fn jump_arm(mut ed: Ed, mode: int, value: int) {
    tab_jump_clear(mut ed)
    if !jump_window_allowed(ed) {
        return
    }
    ed.tab_jump_on = true
    ed.tab_jump_mode = mode
    ed.tab_jump_value = value
    ed.tab_jump_deadline_ms = ed.now_ms + JUMP_WINDOW_MS
    ed.tab_jump_timer = timer_add(mut ed.timers, ed.tab_jump_deadline_ms, TIMER_TAB_JUMP, 0)
    let what = if mode == JUMP_MEMBER then "member" else "tab"
    ed_msg(mut ed, MSG_INFO, "{what} {value} — a digit extends to {value}_")
}

// `jump_mode_for_alt` (`tabs.c:1858-1862`): the row the active tab is on.
fn jump_mode_for_alt(ed: Ed) -> int {
    if active_group_id(ed) != 0 then JUMP_MEMBER else JUMP_ROW1
}

/// `yew_tab_jump_key` (`tabs.c:1864-1941`): inside the window a digit
/// extends the jump in its MODE (`ctrl+1` `2` is row-1 entry 12); a held
/// modifier continues only a window of its own kind; anything else
/// clears and dispatches normally. True when the key was CONSUMED — an
/// out-of-range digit is swallowed, never typed into the document.
pub fn tab_jump_key(mut ed: Ed, key: term.Key) -> bool {
    if !ed.tab_jump_on {
        return false
    }
    if key.ev == term.KEY_RELEASE {
        return false
    }
    if ed.now_ms >= ed.tab_jump_deadline_ms {
        tab_jump_clear(mut ed)
        return false
    }
    if key.code < 48 || key.code > 57 {
        tab_jump_clear(mut ed)
        return false
    }
    if key.mods & term.MOD_CTRL != 0 && ed.tab_jump_mode != JUMP_ROW1 {
        tab_jump_clear(mut ed)
        return false
    }
    if key.mods & term.MOD_ALT != 0 && ed.tab_jump_mode != jump_mode_for_alt(ed) {
        tab_jump_clear(mut ed)
        return false
    }
    let target = ed.tab_jump_value * 10 + (key.code - 48)
    var ok = false
    let mode = ed.tab_jump_mode
    if mode == JUMP_MEMBER {
        let gid = active_group_id(ed)
        ok = gid != 0 && jump_to_member(mut ed, gid, target)
        if !ok {
            ed_msg(mut ed, MSG_ERROR, "no member {target}")
        }
    } else {
        ok = jump_to_row1(mut ed, target)
        if !ok {
            ed_msg(mut ed, MSG_ERROR, "no tab {target}")
        }
    }
    if ok {
        jump_arm(mut ed, mode, target)
    } else {
        tab_jump_clear(mut ed)
    }
    true
}

// `goto_want` (`tabs.c:1943-1953`): the argument, a count overriding it,
// 0 meaning 10 (the digit row reads 1..9 then 0).
fn goto_want(cx: CmdCtx) -> int {
    var want = cx.iarg
    if cx.count_given && cx.count != 0 {
        want = cx.count
    }
    if want == 0 then 10 else want
}

// `goto_row1` (`tabs.c:1955-1967`): jump now, then arm.
fn goto_row1(mut ed: Ed, want: int) -> int {
    if !jump_to_row1(mut ed, want) {
        ed_msg(mut ed, MSG_ERROR, "no tab {want}")
        return CMD_ERR_ARG
    }
    jump_arm(mut ed, JUMP_ROW1, want)
    CMD_OK
}

/// `ed.tab.goto` (`yew_tab_cmd_goto`, `tabs.c:1969-1987`): the row the
/// active tab is on — row 1 outside a group, the members inside one.
pub fn tab_cmd_goto(mut ed: Ed, cx: CmdCtx) -> int {
    let want = goto_want(cx)
    let gid = active_group_id(ed)
    if gid == 0 {
        return goto_row1(mut ed, want)
    }
    if !jump_to_member(mut ed, gid, want) {
        ed_msg(mut ed, MSG_ERROR, "no member {want}")
        return CMD_ERR_ARG
    }
    jump_arm(mut ed, JUMP_MEMBER, want)
    CMD_OK
}

/// `ed.tab.goto_bar` (`yew_tab_cmd_goto_bar`, `tabs.c:1989-1994`): row 1
/// from anywhere.
pub fn tab_cmd_goto_bar(mut ed: Ed, cx: CmdCtx) -> int {
    goto_row1(mut ed, goto_want(cx))
}

/// `ed.tab.move` (`yew_tab_cmd_move`, `tabs.c:1996-2015`): the active tab
/// to position N (1-based).
pub fn tab_cmd_move(mut ed: Ed, cx: CmdCtx) -> int {
    if ed.tab_active < 0 {
        return CMD_ERR_STATE
    }
    var want = cx.iarg
    if cx.count_given && cx.count != 0 {
        want = cx.count
    }
    let to = want - 1
    if to < 0 || to >= ed.tabs.len {
        ed_msg(mut ed, MSG_ERROR, "no position {want}")
        return CMD_ERR_ARG
    }
    tab_reorder(mut ed, ed.tab_active, to)
    ed.full_damage = true
    CMD_OK
}

// ---- the dirty-close prompt (s23 §6) --------------------------------------------

// `tab_prompt_show` (`tabs.c:2017-2033`): the question resolves the ID
// it holds; a tab gone meanwhile dissolves it.
fn tab_prompt_show(mut ed: Ed) {
    let idx = tab_index_of_id(ed, ed.tab_prompt_id)
    if idx < 0 {
        ed.tab_prompt_active = false
        return
    }
    let what = if ed.tabs[idx].has_path then ed.tabs[idx].path else "untitled"
    ed_msg(mut ed, MSG_INFO, "save changes to {what}?  [w]rite  [d]iscard  [esc] cancel")
}

/// `ed.tab.close` (`yew_tab_cmd_close`, `tabs.c:2035-2061`): A-e's tab
/// returns its line (s57.31 §2); the last tab stays; a clean tab closes
/// silently; a modified one asks, holding the tab's ID.
pub fn tab_cmd_close(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    let idx = ed.tab_active
    if idx < 0 {
        return CMD_ERR_STATE
    }
    if ed.win >= 0 && cmdedit_owns(ed, ed.wins[ed.win].buf) {
        return cmdedit_close(mut ed, false)
    }
    if ed.tabs.len <= 1 {
        ed_msg(mut ed, MSG_ERROR, "cannot close the last tab")
        return CMD_ERR_STATE
    }
    if !tab_modified(ed, idx) {
        let _ = tab_close(mut ed, idx)
        return CMD_OK
    }
    ed.tab_prompt_id = ed.tabs[idx].tab_id
    ed.tab_prompt_active = true
    tab_prompt_show(mut ed)
    CMD_OK
}

/// `ed.tab.close_others` (`yew_tab_cmd_close_others`, `tabs.c:2063-
/// 2113`): IDS FIRST, then close; a modified other tab refuses the whole
/// gesture rather than closing half of them.
pub fn tab_cmd_close_others(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    if ed.tab_active < 0 {
        return CMD_ERR_STATE
    }
    if ed.tabs.len <= 1 {
        ed_msg(mut ed, MSG_ERROR, "no other tabs")
        return CMD_ERR_STATE
    }
    let keep = ed.tabs[ed.tab_active].tab_id
    var doomed = List[int]()
    for t in ed.tabs {
        if t.tab_id != keep {
            (mut doomed).push(t.tab_id)
        }
    }
    for id in doomed {
        let idx = tab_index_of_id(ed, id)
        if idx >= 0 && tab_modified(ed, idx) {
            ed_msg(mut ed, MSG_ERROR, "unsaved changes in another tab; save or force first")
            return CMD_ERR_STATE
        }
    }
    for id in doomed {
        let idx = tab_index_of_id(ed, id)
        if idx >= 0 {
            let _ = tab_close(mut ed, idx)
        }
    }
    ed.layout_dirty = true
    ed.full_damage = true
    CMD_OK
}

/// `ed.tab.copy_path` (`yew_tab_cmd_copy_path`, `tabs.c:2115-2144`): the
/// CANONICAL path into register `+` (the system clipboard, out through
/// OSC 52).
pub fn tab_cmd_copy_path(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    if ed.tab_active < 0 || ed.tab_active >= ed.tabs.len || !ed.tabs[ed.tab_active].has_path {
        ed_msg(mut ed, MSG_ERROR, "this tab has no path")
        return CMD_ERR_STATE
    }
    let path = ed.tabs[ed.tab_active].path
    var v = text.regval_new()
    v.bytes = bytes_of(path)
    v.kind = text.REG_CHARWISE
    text.reg_yank(mut ed.regs, '+' as int, v)
    ed_msg(mut ed, MSG_INFO, "copied {path}")
    CMD_OK
}

/// `yew_tab_prompt_key` (`tabs.c:2146-2197`): the answer to the
/// dirty-close question, resolved by ID — `w` writes through the ONE save
/// path and closes only on success (an I/O error aborts the close and the
/// tab keeps its text, invariant 1); `d` discards; Esc cancels; any other
/// key is swallowed with the question restated. True when consumed.
pub fn tab_prompt_key(mut ed: Ed, answer: int) -> bool {
    if !ed.tab_prompt_active {
        return false
    }
    let idx = tab_index_of_id(ed, ed.tab_prompt_id)
    if idx < 0 {
        ed.tab_prompt_active = false
        ed_msg_clear(mut ed)
        return true
    }
    if answer == 119 {
        let id = ed.tabs[idx].tab_id
        tab_switch(mut ed, idx)
        let st = ed_file_save(mut ed, false)
        if st != CMD_OK {
            ed.tab_prompt_active = false
            return true
        }
        let now = tab_index_of_id(ed, id)
        if now >= 0 {
            let _ = tab_close(mut ed, now)
        }
    } else if answer == 100 {
        let _ = tab_close(mut ed, idx)
    } else if answer != 27 {
        tab_prompt_show(mut ed)
        return true
    }
    ed.tab_prompt_active = false
    ed_msg_clear(mut ed)
    true
}

/// The tab strip's marks for the redraw check (`tab_marks_record`,
/// `ed.c:2609-2618`): what each tab shows as modified.
pub fn tab_marks(ed: Ed) -> str {
    var out = ""
    var i = 0
    while i < ed.tabs.len {
        out = out + (if tab_modified(ed, i) then "1" else "0")
        i += 1
    }
    out
}
