//! edit.tabs — the tab model the startup path needs, and the strip.
//!
//! Ports the parts of sagitta `src/ui/tabs.c` (2,197 lines) and
//! `src/ui/strip.c` (134) at 9ace98c2 that every campaign-03 frame
//! reaches: C's editor ALWAYS has a tab and its row-0 strip ("even one tab
//! owns a row because its tail carries the always-reachable new-untitled
//! action", `tabs.c:812-830`), so the goldens of campaign 03 paint the
//! strip in the default theme (ruling R-yw03-3 asks for this to stand as
//! yw03's). Ported: `canonical_path`/`logical_path`, `yew_tab_open`
//! (a tab per file, the buffer born non-resident), `yew_tab_hydrate`
//! (the read and the journal probe), `yew_tab_switch`, `yew_tab_close`,
//! the row-1 entries and `strip_render` with `yew_strip_layout`'s
//! placement and the `+` tail. yw04 adds `ed.tab.close` as far as A-e's
//! `*command-line*` tab needs it (R-yw04-5): that tab, the last tab and an
//! unmodified one. Tab groups, the row-2 member strip, drag, the dwell
//! flash, scroll ownership, a modified tab's close and the other tab
//! commands (`ed.tab.*`) are campaign 05's (yw05) and refuse by name until
//! then.

use term
use text
use unicode

/// `YEW_STRIP_LABEL_CELLS` (`strip.h:24`): a label's cell cap.
pub const STRIP_LABEL_CELLS: int = 24

/// `canonical_path` (`tabs.c:166-183`): the realpath, or the path as
/// typed when it does not exist yet.
pub fn canonical_path(path: str) -> str {
    text.file_realpath(path) else path
}

/// `logical_path` (`tabs.c:185-215`): the canonical path under the
/// workspace root, else the spelling the user typed.
pub fn logical_path(ed: Ed, path: str, canonical: str) -> str {
    let root = ed.ws_dir
    if root.len != 0 {
        if root == "/" && canonical.starts_with("/") && canonical.len > 1 {
            return canonical[1..]
        }
        if canonical.starts_with(root) &&
            canonical.len > root.len + 1 &&
            canonical.bytes()[root.len] as int == 47 {
            return canonical[root.len + 1..]
        }
    }
    if path.starts_with("/") {
        return path
    }
    var p = path
    while p.starts_with("./") {
        p = p[2..]
    }
    if p.len != 0 {
        return p
    }
    canonical
}

/// `yew_tab_find_by_path` (`tabs.c:217-238`).
pub fn tab_find_by_path(ed: Ed, path: str) -> int {
    let want = canonical_path(path)
    var i = 0
    while i < ed.tabs.len {
        if ed.tabs[i].has_path && ed.tabs[i].path == want {
            return i
        }
        i += 1
    }
    -1
}

/// `yew_tab_open` (`tabs.c:258-345`): a new tab on `path` with its own
/// non-resident buffer and its own window; answers its index.
pub fn tab_open(mut ed: Ed, path: str) -> int {
    let existing = tab_find_by_path(ed, path)
    if existing >= 0 {
        tab_switch(mut ed, existing)
        return existing
    }
    let canonical = canonical_path(path)
    let display = logical_path(ed, path, canonical)
    let id = ed.next_buf_id
    ed.next_buf_id += 1
    var ec = text.editctx_new(take text.textbuf_new())
    ec.meta = text.filemeta_new()
    (mut ed.bufs).push(Buffer {
        id: id,
        ec: ec,
        resident: false,
        path: canonical,
        has_path: true,
        name: "",
        has_name: false,
        flags: 0,
        tabwidth: VP_TABWIDTH,
        recovery_pending: false,
        pairs: pairstate_new(),
        named: named_marks_new(),
    })
    let bi = ed.bufs.len - 1
    let wid = ed.next_win_id
    ed.next_win_id += 1
    var w = win_new(wid, bi)
    vp_init(mut w)
    apply_win_opts(ed.opts, mut w)
    (mut ed.wins).push(w)
    // `tabs.c:328-329`: the tab's tree is one leaf, focused.
    let leaf = pane_new_leaf(mut ed, ed.wins.len - 1)
    let tid = ed.next_tab_id
    ed.next_tab_id += 1
    (mut ed.tabs).push(Tab {
        tab_id: tid,
        buffer_id: id,
        root: leaf,
        focus: leaf,
        path: canonical,
        display_path: display,
        has_path: true,
    })
    ed.tabs.len - 1
}

/// `yew_buf_hydrate` (`ed.c:426-484`) via `yew_tab_hydrate`
/// (`tabs.c:560-623`): read the file, a missing path opening empty; the
/// undo tree at its save point; the journal probe that arms recovery.
/// Answers 0 or -1.
pub fn tab_hydrate(mut ed: Ed, idx: int) -> int {
    if idx < 0 || idx >= ed.tabs.len {
        return -1
    }
    let bi = ed_buf_index(ed, ed.tabs[idx].buffer_id)
    if bi < 0 {
        return -1
    }
    if ed.bufs[bi].resident {
        return 0
    }
    if !ed.bufs[bi].has_path {
        return -1
    }
    let (status, tb, meta) = text.file_load(ed.bufs[bi].path)
    if status != text.LOAD_OK && status != text.LOAD_ENOENT {
        return -1
    }
    var ec = text.editctx_new(take tb)
    ec.undo = text.undo_new(ec.tb)
    ec.has_undo = true
    text.undo_mark_saved(mut ec.undo, ec.tb)
    ec.marks = text.marks_new()
    ec.has_marks = true
    ec.meta = meta
    ec.has_meta = true
    ed.bufs[bi].ec = ec
    ed.bufs[bi].resident = true
    ed.bufs[bi].tabwidth = ed.opts.tabwidth
    ed.bufs[bi].recovery_pending = !ed.headless &&
        ed.bufs[bi].ec.meta.has_realpath &&
        text.journal_probe(ed.journals, ed.bufs[bi].ec.meta.realpath, ed.bufs[bi].ec.meta)
    0
}

/// `yew_tab_switch` (`tabs.c:428-479`): hydrate, then the tab's window is
/// the focused one; a pending recovery asks.
pub fn tab_switch(mut ed: Ed, idx: int) {
    if idx < 0 || idx >= ed.tabs.len {
        if ed.tabs.len == 0 {
            ed.tab_active = -1
        }
        return
    }
    ed.tab_active = idx
    let _ = tab_hydrate(mut ed, idx)
    // `tabs.c:460-470`: swapping the visible tree is the whole switch; each
    // window owns its cursors and viewport.
    ed.pane_root = ed.tabs[idx].root
    ed.focus = ed.tabs[idx].focus
    if pane_live(ed, ed.focus) && ed.panes[ed.focus].win >= 0 {
        ed.win = ed.panes[ed.focus].win
    }
    let bi = ed.wins[ed.win].buf
    if ed.prompt == PROMPT_NONE && ed.bufs[bi].recovery_pending {
        ed_prompt(mut ed, PROMPT_RECOVER)
    }
    ed.layout_dirty = true
    ed.full_damage = true
}

// `tab_destroy` (`tabs.c:65-87`): each leaf's window released, then the
// tree's nodes freed. The buffer stays in its list (the workspace owns
// buffers), unreachable from the tab.
fn tab_destroy(mut ed: Ed, idx: int) {
    let root = ed.tabs[idx].root
    if pane_live(ed, root) {
        let leaves = pane_collect_leaves(ed, root, PANE_MAX_LEAVES * 2)
        for l in leaves {
            ed_win_release(mut ed, ed.panes[l].win)
        }
        pane_free(mut ed, root)
    }
    ed.tabs[idx].root = -1
    ed.tabs[idx].focus = -1
}

/// `yew_tab_close` (`tabs.c:398-426`): the survivor is chosen by id
/// before the compaction (its right neighbour, else its left); the closed
/// tab's tree and windows are freed (`tab_destroy`).
pub fn tab_close(mut ed: Ed, idx: int) -> bool {
    if idx < 0 || idx >= ed.tabs.len {
        return false
    }
    let n = ed.tabs.len
    var survivor = 0
    if ed.tab_active != idx {
        survivor = if ed.tab_active >= 0 && ed.tab_active < n {
            ed.tabs[ed.tab_active].tab_id
        } else {
            0
        }
    } else if idx + 1 < n {
        survivor = ed.tabs[idx + 1].tab_id
    } else if idx - 1 >= 0 {
        survivor = ed.tabs[idx - 1].tab_id
    }
    tab_destroy(mut ed, idx)
    var kept = List[Tab]()
    var i = 0
    while i < n {
        if i != idx {
            (mut kept).push(copy ed.tabs[i])
        }
        i += 1
    }
    ed.tabs = kept
    ed.tab_active = -1
    var j = 0
    while j < ed.tabs.len {
        if ed.tabs[j].tab_id == survivor {
            ed.tab_active = j
        }
        j += 1
    }
    if ed.tab_active < 0 && ed.tabs.len > 0 {
        ed.tab_active = 0
    }
    tab_switch(mut ed, ed.tab_active)
    true
}

/// The tab index showing tab id `id`, or -1 (`yew_tab_index_of_id`).
pub fn tab_index_of_id(ed: Ed, id: int) -> int {
    var i = 0
    while i < ed.tabs.len {
        if ed.tabs[i].tab_id == id {
            return i
        }
        i += 1
    }
    -1
}

// A strip entry (`StripEntry`, `strip.h`).
struct StripEntry {
    label: List[byte],
    payload: int,
    dim: bool,
    modified: bool,
}

// `tab_is_orphan` (`tabs.c:722-734`): outside the workspace root.
fn tab_is_orphan(ed: Ed, idx: int) -> bool {
    let p = ed.tabs[idx].path
    ed.tabs[idx].has_path && ed.ws_dir.len != 0 && !p.starts_with(ed.ws_dir)
}

// `yew_tab_row1_entries` (`tabs.c:736-791`), groups aside (yw05).
fn row1_entries(ed: Ed) -> List[StripEntry] {
    var out = List[StripEntry]()
    var i = 0
    while i < ed.tabs.len {
        let modified = tab_modified(ed, i)
        let label = " {out.len + 1} {tab_basename(ed, ed.tabs[i])}{if modified then "*" else ""} "
        (mut out).push(StripEntry {
            label: bytes_of(label),
            payload: i,
            dim: tab_is_orphan(ed, i),
            modified: modified,
        })
        i += 1
    }
    out
}

/// `yew_tab_strip_rows` (`tabs.c:812-842`): one row while there is a
/// tab (row 2 is a group's, yw05).
pub fn tab_strip_rows(ed: Ed) -> int {
    if ed.tabs.len > 0 then 1 else 0
}

/// `yew_strip_label_cells` (`strip.c:11-27`).
pub fn strip_label_cells(label: List[byte]) -> int {
    let (_, cells) = unicode.str_clip(label, 0, label.len, STRIP_LABEL_CELLS)
    if cells < 0 then 0 else cells
}

fn strip_label_bytes(label: List[byte]) -> int {
    let (bytes, _) = unicode.str_clip(label, 0, label.len, STRIP_LABEL_CELLS)
    bytes
}

// `tab_base_style` (`tabs.c:1085-1106`).
fn tab_base_style(ed: Ed) -> ThemeEnt {
    let r = theme_rendition_of(ed.render)
    let (hf, fg) = theme_ui(ed.theme, "fg", r)
    let (hb, bg) = theme_ui(ed.theme, "bg", r)
    var style = ThemeEnt { fg: term.color_default(), bg: term.color_default(), attrs: 0 }
    if hf {
        if fg.fg.tag != term.COLOR_DEFAULT {
            style.fg = copy fg.fg
        }
        style.attrs = fg.attrs
    }
    if hb {
        if bg.bg.tag != term.COLOR_DEFAULT {
            style.bg = copy bg.bg
        }
        style.attrs = style.attrs | bg.attrs
    }
    style
}

// `tab_role_style` (`tabs.c:1114-1127`): a role is an overlay.
fn tab_role_style(ed: Ed, role: str, fallback_in: ThemeEnt) -> ThemeEnt {
    var fallback = fallback_in
    let (ok, themed) = theme_ui(ed.theme, role, theme_rendition_of(ed.render))
    if !ok {
        return fallback
    }
    if themed.fg.tag != term.COLOR_DEFAULT {
        fallback.fg = copy themed.fg
    }
    if themed.bg.tag != term.COLOR_DEFAULT {
        fallback.bg = copy themed.bg
    }
    fallback.attrs = themed.attrs
    fallback
}

fn tab_blank(style: ThemeEnt) -> term.Cell {
    var c = term.cell_blank()
    c.fg = copy style.fg
    c.bg = copy style.bg
    c.attrs = style.attrs
    c
}

/// `yew_tab_strip_draw` (`tabs.c:1576-1606`) with `strip_render` over row
/// 1 (`tabs.c:1148-1316`) and `yew_strip_layout` (`strip.c:39-134`).
pub fn tab_strip_draw(mut ed: Ed, r: Rect) {
    if r.w == 0 || r.h == 0 {
        return
    }
    let entries = row1_entries(ed)
    let n = entries.len
    let active = ed.tab_active
    let base = tab_base_style(ed)
    let surface = tab_role_style(ed, "tab.bar", copy base)
    let inactive = tab_role_style(ed, "tab.inactive", copy surface)
    var modified = copy surface
    modified.attrs = modified.attrs | term.ATTR_BOLD
    modified = tab_role_style(ed, "tab.modified", modified)
    var orphan = copy surface
    orphan.attrs = orphan.attrs | term.ATTR_DIM
    orphan = tab_role_style(ed, "tab.orphan", orphan)
    var act = copy surface
    act.attrs = act.attrs | term.ATTR_REVERSE
    act = tab_role_style(ed, "tab.active", act)
    var add = copy surface
    add.attrs = add.attrs | term.ATTR_BOLD
    add = tab_role_style(ed, "tab.add", add)
    term.grid_fill(mut ed.grid, r.y, r.x, r.x + r.w, tab_blank(copy surface))
    if n <= 0 {
        return
    }
    var avail = r.w
    if ed.tab_scroll > 0 && avail > 1 {
        avail -= 1
    }
    // `yew_strip_layout`: keep the active entry visible, moving as little
    // as possible; place what fits; an entry too wide for the strip is
    // placed clipped.
    var first = ed.tab_scroll
    if first < 0 {
        first = 0
    }
    if first >= n {
        first = n - 1
    }
    if active >= 0 && active < n {
        if active < first {
            first = active
        } else {
            loop {
                var used = 0
                var fits = false
                var i = first
                while i < n {
                    let w = strip_label_cells(entries[i].label)
                    if used + w > avail {
                        break
                    }
                    used += w
                    if i == active {
                        fits = true
                        break
                    }
                    i += 1
                }
                if fits || first >= active {
                    break
                }
                first += 1
            }
        }
    }
    var span_idx = List[int]()
    var span_c0 = List[int]()
    var span_c1 = List[int]()
    var at = 0
    var k = first
    while k < n {
        let w = strip_label_cells(entries[k].label)
        if at + w > avail {
            break
        }
        (mut span_idx).push(k)
        (mut span_c0).push(at)
        (mut span_c1).push(at + w)
        at += w
        k += 1
    }
    if span_idx.len == 0 && first < n {
        (mut span_idx).push(first)
        (mut span_c0).push(0)
        (mut span_c1).push(avail)
    }
    ed.tab_scroll = first
    let more_left = first > 0
    let more_right = first + span_idx.len < n
    var tail_x = r.x + (if more_left then 1 else 0)
    var s = 0
    while s < span_idx.len {
        let idx = span_idx[s]
        let x = r.x + span_c0[s] + (if more_left then 1 else 0)
        var style = copy inactive
        if idx == active {
            style = copy act
        } else if entries[idx].dim {
            style = copy orphan
        } else if entries[idx].modified {
            style = copy modified
        }
        let lb = strip_label_bytes(entries[idx].label)
        let _ = term.grid_puts(
            mut ed.grid,
            r.y,
            x,
            entries[idx].label,
            0,
            lb,
            copy style.fg,
            copy style.bg,
            style.attrs,
        )
        tail_x = x + span_c1[s] - span_c0[s]
        s += 1
    }
    if more_left {
        let lt = bytes_of("<")
        let _ = term.grid_puts(
            mut ed.grid,
            r.y,
            r.x,
            lt,
            0,
            1,
            copy orphan.fg,
            copy surface.bg,
            term.ATTR_DIM,
        )
    }
    if more_right {
        let past = n - (if span_idx.len > 0 then span_idx[span_idx.len - 1] + 1 else 0)
        let more = bytes_of(">{past}")
        let w = more.len
        if w < r.w {
            let _ = term.grid_puts(
                mut ed.grid,
                r.y,
                r.x + r.w - w,
                more,
                0,
                w,
                copy orphan.fg,
                copy surface.bg,
                term.ATTR_DIM,
            )
        }
    } else if tail_x + 3 <= r.x + r.w {
        let plus = bytes_of(" + ")
        let _ = term.grid_puts(
            mut ed.grid,
            r.y,
            tail_x,
            plus,
            0,
            3,
            copy add.fg,
            copy add.bg,
            add.attrs,
        )
    }
}

/// The tab strip's marks for the redraw check (`tab_marks_record`,
/// `ed.c:2594-2618`): what each tab shows as modified.
pub fn tab_marks(ed: Ed) -> str {
    var out = ""
    var i = 0
    while i < ed.tabs.len {
        out = out + (if tab_modified(ed, i) then "1" else "0")
        i += 1
    }
    out
}

/// `ed.tab.close` (`yew_tab_cmd_close`, `tabs.c:2028-2054`): A-e's tab
/// returns its line (s57.31 §2); the last tab stays; an unmodified tab
/// closes. A modified tab's save-or-discard question is Sprint 23's
/// (`tab_prompt_show`, yw05) and refuses by name until then.
pub fn tab_cmd_close(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    let idx = ed.tab_active
    if idx < 0 {
        return CMD_ERR_STATE
    }
    if ed.win >= 0 && cmdedit_owns(ed, ed.wins[ed.win].buf) {
        return cmdedit_close(mut ed, false)
    }
    if ed.tabs.len <= 1 {
        ed_msg(mut ed, MSG_ERROR, "cannot close the last tab")
        return CMD_ERR_STATE
    }
    if !tab_modified(ed, idx) {
        let _ = tab_close(mut ed, idx)
        return CMD_OK
    }
    ed_msg(
        mut ed,
        MSG_ERROR,
        "not yet ported: closing a modified tab: sagitta Sprint 23 (tabs) (yw05)",
    )
    CMD_ERR_DEFERRED
}
