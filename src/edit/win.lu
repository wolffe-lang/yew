//! edit.win — a window: one view of one buffer, with its own cursor set.
//!
//! Ports sagitta `src/ui/win.c` (77 lines) and `ui/win.h` (122) at
//! 9ace98c2, under `s14-modes-L-I.md` and `s15-viewport-statusline.md`.
//! sagitta's `ui` files take the `Ed` and `ed` calls them, a module cycle
//! wolf refuses (E0303), so campaign 03's `ui` files live in `edit`
//! (`docs/MAP.md` §2, yw03).
//!
//! The ownership seam (contract deliverable 2): C's `Win` holds a pointer
//! to its `Buffer` and the cursor set by value ("multi-cursor lives on the
//! window, not the buffer", `01-architecture.md`). The port's `Win` holds
//! its buffer as an index into `Ed.bufs` and OWNS its `CursorSet`; an edit
//! swaps the set into the buffer's `EditCtx` and back through a local
//! (`ed_edit_begin`/`ed_edit_end`, `ed.lu`), which allocates nothing — a
//! fresh empty set per edit would cost 48 bytes held for the session
//! (G33, measured).
//!
//! What C's window carries for later campaigns — the jump list (s21,
//! yw04), the search overlay (s20, yw04), the syntax span scratch (yw10),
//! the shadow, completion menu and floating panel (yw11), the LSP request
//! lanes (yw11), git presentation (yw13), option overrides (s36, yw09) —
//! lands with those campaigns.

use text

/// `Rect` (`ui/layout.h:27-29`): a rectangle of cells.
pub struct Rect {
    x: int,
    y: int,
    w: int,
    h: int,
}

/// A rectangle at (`x`, `y`) of `w` by `h` cells.
pub fn rect(x: int, y: int, w: int, h: int) -> Rect {
    Rect { x: x, y: y, w: w, h: h }
}

/// A character selection (`SelKind`, `select.h`).
pub const SEL_CHAR: int = 0

/// A line selection.
pub const SEL_LINE: int = 1

/// A rectangular selection.
pub const SEL_RECT: int = 2

/// `HState` (`select.h`): what H mode was entered from, the unit engine
/// it extends by (C's `UnitOps *`, here a `UNIT_*` kind), the selection
/// kind and whether it sticks.
pub struct HState {
    from: int,
    unit: int,
    kind: int,
    sticky: bool,
}

/// H state at rest: from L, by line, a character selection.
pub fn hstate_new() -> HState {
    HState { from: MODE_L, unit: UNIT_LINE, kind: SEL_CHAR, sticky: false }
}

/// No numbers (`NumStyle`, `gutter.h`): the field blanked, the geometry kept.
pub const NUM_NONE: int = 0

/// Absolute numbers.
pub const NUM_ABS: int = 1

/// Relative numbers.
pub const NUM_REL: int = 2

/// The cursor line absolute, the others relative.
pub const NUM_HYBRID: int = 3

/// `Win` (`ui/win.h:40-121`), the fields campaign 03 reads.
pub struct Win {
    id: int,
    buf: int,
    cs: text.CursorSet,
    h: HState,
    vp: Viewport,
    wrap_cache: WrapCache,
    rect: Rect,
    number_style: int,
    gutter_width: int,
    signs: GutterSigns,
    wrap_goal: int,
    wrap_goal_valid: bool,
    jumps: text.JumpList,
    overlay: MatchOverlay,
}

/// A window over buffer index `buf`, its one cursor at offset 0.
pub fn win_new(id: int, buf: int) -> Win {
    Win {
        id: id,
        buf: buf,
        cs: text.cset_init(text.cursor_at(0 as text.ByteOff)),
        h: hstate_new(),
        vp: viewport_new(),
        wrap_cache: wrapcache_new(),
        rect: rect(0, 0, 0, 0),
        number_style: NUM_ABS,
        gutter_width: 0,
        signs: gutter_signs_new(),
        wrap_goal: 0,
        wrap_goal_valid: false,
        jumps: text.jumplist_new(),
        overlay: overlay_new(),
    }
}

/// The window a unit engine gets when it has none (C's `u->win == NULL`):
/// line motions read `has_win` first and never look further.
pub fn win_detached() -> Win {
    win_new(0, -1)
}
