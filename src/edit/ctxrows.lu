//! edit.ctxrows — WHAT IS UNDER THE POINTER, and WHICH ROWS IT DESERVES.
//!
//! Ports sagitta `src/ui/ctxrows.c` (838 lines) and `ui/ctxrows.h` (303)
//! at 9ace98c2, under `s57_13-mouse-overhaul-context-menus.md` §3-§4 (and
//! s57.22 §5's `Open in Split Left` row): the kinds, the context, the
//! target discipline, the action table, and one builder per kind.
//!
//! THE ACTION TABLE IS THE DISPATCH (`ctxrows.h:25-30`): a row's meaning
//! is DATA — a registry command NAME, how the captured target is applied
//! before it runs, one integer argument — and `apply_menu_action` (the
//! router's glue) is its only reader. C's `const CtxActionDesc
//! yew_ctx_actions[CTXA__N]` is `ctx_actions(action)`, one `match` on
//! literal action ids (module state of a `List` is refused, G15; a `match`
//! arm on a const NAME is a binding, W0801), each arm's `CTXA_*` name in
//! its comment. A row carries an action ID, never a function value
//! (G19/G20); a command is found by `cmd_lookup` and run by
//! `ed_cmd_invoke`.
//!
//! THE TARGET IS CAPTURED HERE, ONCE, at build time (`ctxrows.c:13-17`):
//! the tab id and canonical path, the gid, the leaf index; rows re-find
//! it from that identity when they fire. TWO LAWS (`ctxrows.c:19-30`): a
//! ROW is greyed, never hidden; a SECTION whose feature is unavailable for
//! this buffer is omitted whole. The document menu's LSP section is
//! yw11's and its git section yw13's: before them no buffer has a server
//! or a repository (C's `yew_lsp_attached` and `yew_git_repo_cached`
//! answer for none), so both sections are omitted exactly as C omits them
//! for such a buffer. The panel's rename shape is yw11's for the same
//! reason (`yew_lsp_rename_confirm_active` false: the bare `Close`).
//!
//! THE FUSS KINDS (FUSS_FILE, FUSS_DIR, FUSS_BLANK) are yw13's (R-yw06-4 =
//! A): their rows read the FUSS tree and its git status (Sprint 52), so
//! each builder REFUSES BY NAME — the message line and the log say
//! `not yet ported: ... (yw13)` — and builds nothing; no FUSS row is ever
//! drawn before yw13, so the router never reaches one. The FUSS ACTIONS
//! stay in the table (they are data; `ctxrows_the_action_table_is_wholly
//! _resolvable` checks them against the registry).
//!
//! Ellipses are three ASCII dots (`ctxrows.c:32-35`), as C's labels spell
//! them.

use text
use util

/// Nothing (`YEW_CTX_KIND_NONE`, `ctxrows.h:43-61`; the router never
/// answers it).
pub const CTX_KIND_NONE: int = 0

/// A tab entry (`YEW_CTX_KIND_TAB`).
pub const CTX_KIND_TAB: int = 1

/// A group entry.
pub const CTX_KIND_GROUP: int = 2

/// The strip's blank tail, chevrons, the `+`.
pub const CTX_KIND_STRIP: int = 3

/// Pane text or gutter.
pub const CTX_KIND_DOC: int = 4

/// A pane border.
pub const CTX_KIND_BORDER: int = 5

/// The statusline / message row.
pub const CTX_KIND_FOOTER: int = 6

/// A FUSS file row (yw13).
pub const CTX_KIND_FUSS_FILE: int = 7

/// A FUSS directory row (yw13).
pub const CTX_KIND_FUSS_DIR: int = 8

/// FUSS's header, blank drawer, backdrop (yw13).
pub const CTX_KIND_FUSS_BLANK: int = 9

/// A picker row.
pub const CTX_KIND_PICK_ROW: int = 10

/// The picker's box, off its rows.
pub const CTX_KIND_PICKER: int = 11

/// A completion row (yw11).
pub const CTX_KIND_COMPL_ROW: int = 12

/// The hover / signature / rename-confirm panel (yw11).
pub const CTX_KIND_PANEL: int = 13

/// A group-picker row.
pub const CTX_KIND_GP_ROW: int = 14

/// The group picker's box.
pub const CTX_KIND_GP: int = 15

/// Nothing under the pointer.
pub const CTX_KIND_EDITOR: int = 16

/// `CtxContext` (`ctxrows.h:63-79`): the router's answer and all a builder
/// is told. `id` is the IDENTITY the rows act on (a tab id, a gid, an
/// interned path id, a leaf index), never a row index; `payload` the raw
/// region payload; `rect` the region's rectangle, or the pane's for DOC.
pub struct CtxContext {
    kind: int,
    id: int,
    payload: int,
    rect: Rect,
}

/// An empty context (C's zeroed `CtxContext`).
pub fn ctxcontext_new(kind: int, id: int) -> CtxContext {
    CtxContext { kind: kind, id: id, payload: id, rect: rect(0, 0, 0, 0) }
}

/// Invoke as-is (`CTX_TGT_NONE`, `ctxrows.h:81-131`).
pub const CTX_TGT_NONE: int = 0

/// Switch to the captured tab id first.
pub const CTX_TGT_TAB: int = 1

/// Enter the captured gid first.
pub const CTX_TGT_GROUP: int = 2

/// Focus the captured leaf, the cursor to the click cell.
pub const CTX_TGT_PANE: int = 3

/// Focus the captured leaf and LEAVE THE CARET ALONE (placing it would
/// collapse the selection `Cut`/`Copy`/`Delete` act on).
pub const CTX_TGT_LEAF: int = 4

/// `cx.sarg` = the captured path (and select it).
pub const CTX_TGT_PATH: int = 5

/// Move the FUSS selection to the captured path, invoke with no sarg.
pub const CTX_TGT_FUSS_ROW: int = 6

/// Select the captured payload, then accept by `iarg`.
pub const CTX_TGT_PICK: int = 7

/// Select the captured completion item first.
pub const CTX_TGT_COMPL: int = 8

/// Move the group picker's focus to the captured listing index.
pub const CTX_TGT_GP_ROW: int = 9

/// One action's meaning (`CtxActionDesc`, `ctxrows.h:133-138`): a
/// registry name (`has_cmd` false is C's NULL: the row closes an overlay
/// inline, or its target IS its action), the target, one argument.
pub struct CtxActionDesc {
    cmd: str,
    has_cmd: bool,
    target: int,
    iarg: int,
}

