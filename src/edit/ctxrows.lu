const CTX_PICK_ACCEPT_HSPLIT: int = 2

fn ctx_desc(cmd: str, target: int, iarg: int) -> CtxActionDesc {
    CtxActionDesc { cmd: cmd, has_cmd: true, target: target, iarg: iarg }
}

fn ctx_desc_inline(target: int, iarg: int) -> CtxActionDesc {
    CtxActionDesc { cmd: "", has_cmd: false, target: target, iarg: iarg }
}

/// `yew_ctx_actions[action]` (`ctxrows.c:60-260`): THE DISPATCH, as data.
/// An action outside the table is CTXA_NONE's inert entry.
pub fn ctx_actions(action: int) -> CtxActionDesc {
    match action {
        1 => ctx_desc("ed.tab.close", CTX_TGT_TAB, 0), // CTXA_TAB_CLOSE
        2 => ctx_desc("ed.tab.close_others", CTX_TGT_TAB, 0), // CTXA_TAB_CLOSE_OTHERS
        3 => ctx_desc("ed.tab.copy_path", CTX_TGT_TAB, 0), // CTXA_TAB_COPY_PATH
        4 => ctx_desc("ed.group.remove_tab", CTX_TGT_TAB, 0), // CTXA_TAB_LEAVE_GROUP
        5 => ctx_desc("ed.group.edit", CTX_TGT_GROUP, 0), // CTXA_GROUP_EDIT
        6 => ctx_desc("ed.group.rename", CTX_TGT_GROUP, 0), // CTXA_GROUP_RENAME
        7 => ctx_desc("ed.group.dissolve", CTX_TGT_GROUP, 0), // CTXA_GROUP_DISSOLVE
        8 => ctx_desc("ed.find.command", CTX_TGT_NONE, 0), // CTXA_PALETTE
        9 => ctx_desc("ed.find.command", CTX_TGT_PANE, 0), // CTXA_PALETTE_HERE
        10 => ctx_desc("ed.git.open", CTX_TGT_PATH, 0), // CTXA_FUSS_OPEN
        // The document rows (`ctxrows.c:84-137`): CTX_TGT_LEAF for the
        // rows whose subject is the buffer's current state (the
        // selection, Select All, undo/redo), CTX_TGT_PANE for every row
        // that means "here". Cut/Copy/Paste are the SYSTEM clipboard's.
        11 => ctx_desc("ed.clip.cut", CTX_TGT_LEAF, 0), // CTXA_DOC_CUT
        12 => ctx_desc("ed.clip.copy", CTX_TGT_LEAF, 0), // CTXA_DOC_COPY
        13 => ctx_desc("ed.clip.paste", CTX_TGT_PANE, 0), // CTXA_DOC_PASTE
        14 => ctx_desc("ed.sel.delete", CTX_TGT_LEAF, 0), // CTXA_DOC_DELETE
        15 => ctx_desc("ed.sel.all", CTX_TGT_LEAF, 0), // CTXA_DOC_SELECT_ALL
        16 => ctx_desc("ed.edit.undo", CTX_TGT_LEAF, 0), // CTXA_DOC_UNDO
        17 => ctx_desc("ed.edit.redo", CTX_TGT_LEAF, 0), // CTXA_DOC_REDO
        18 => ctx_desc("ed.pane.split_h", CTX_TGT_PANE, 0), // CTXA_DOC_SPLIT_RIGHT
        19 => ctx_desc("ed.pane.split_v", CTX_TGT_PANE, 0), // CTXA_DOC_SPLIT_BELOW
        20 => ctx_desc("ed.pane.close", CTX_TGT_PANE, 0), // CTXA_DOC_CLOSE_PANE
        21 => ctx_desc("ed.file.save", CTX_TGT_PANE, 0), // CTXA_DOC_SAVE
        22 => ctx_desc("ed.file.save_as", CTX_TGT_PANE, 0), // CTXA_DOC_SAVE_AS
        23 => ctx_desc("ed.file.reload", CTX_TGT_PANE, 0), // CTXA_DOC_RELOAD
        24 => ctx_desc("ed.lsp.goto_def", CTX_TGT_PANE, 0), // CTXA_DOC_LSP_DEF
        25 => ctx_desc("ed.lsp.references", CTX_TGT_PANE, 0), // CTXA_DOC_LSP_REFS
        26 => ctx_desc("ed.lsp.rename", CTX_TGT_PANE, 0), // CTXA_DOC_LSP_RENAME
        27 => ctx_desc("ed.lsp.hover", CTX_TGT_PANE, 0), // CTXA_DOC_LSP_HOVER
        28 => ctx_desc("ed.git.blame.toggle", CTX_TGT_PANE, 0), // CTXA_DOC_BLAME_TOGGLE
        29 => ctx_desc("ed.git.diff.view", CTX_TGT_PANE, 0), // CTXA_DOC_DIFF
        30 => ctx_desc("ed.find.file", CTX_TGT_PANE, 0), // CTXA_DOC_FIND_FILE
        31 => ctx_desc("ed.view.goto_line", CTX_TGT_PANE, 0), // CTXA_DOC_GOTO_LINE
        32 => ctx_desc("ed.view.toggle_wrap", CTX_TGT_PANE, 0), // CTXA_DOC_TOGGLE_WRAP
        33 => ctx_desc("ed.tab.new", CTX_TGT_NONE, 0), // CTXA_TAB_NEW
        // s57.22 §5: the SIDED commands, the three sides the drag lands on.
        34 => ctx_desc("ed.tab.split_right", CTX_TGT_TAB, 0), // CTXA_TAB_OPEN_SPLIT_RIGHT
        35 => ctx_desc("ed.tab.split_left", CTX_TGT_TAB, 0), // CTXA_TAB_OPEN_SPLIT_LEFT
        36 => ctx_desc("ed.tab.split_down", CTX_TGT_TAB, 0), // CTXA_TAB_OPEN_SPLIT_BELOW
        37 => ctx_desc("ed.group.close", CTX_TGT_GROUP, 0), // CTXA_GROUP_CLOSE
        38 => ctx_desc("ed.group.new", CTX_TGT_NONE, 0), // CTXA_GROUP_NEW
        39 => ctx_desc("ed.find.file", CTX_TGT_NONE, 0), // CTXA_FIND_FILE
        40 => ctx_desc("ed.find.buffer", CTX_TGT_NONE, 0), // CTXA_FIND_BUFFER
        // The border rows act on the FOCUSED pane (`ctxrows.c:162-168`): a
        // border's payload names a split, not a leaf.
        41 => ctx_desc("ed.pane.close", CTX_TGT_NONE, 0), // CTXA_PANE_CLOSE
        42 => ctx_desc("ed.pane.grow", CTX_TGT_NONE, 0), // CTXA_PANE_GROW
        43 => ctx_desc("ed.pane.shrink", CTX_TGT_NONE, 0), // CTXA_PANE_SHRINK
        44 => ctx_desc("ed.pane.focus_next", CTX_TGT_NONE, 0), // CTXA_PANE_FOCUS_NEXT
        45 => ctx_desc("ed.view.goto_line", CTX_TGT_NONE, 0), // CTXA_GOTO_LINE
        46 => ctx_desc("ed.view.toggle_wrap", CTX_TGT_NONE, 0), // CTXA_TOGGLE_WRAP
        47 => ctx_desc("ed.view.number_cycle", CTX_TGT_NONE, 0), // CTXA_NUMBER_CYCLE
        48 => ctx_desc("ed.mouse.disable", CTX_TGT_NONE, 0), // CTXA_MOUSE_DISABLE
        49 => ctx_desc("ed.git.open_split_h", CTX_TGT_PATH, 0), // CTXA_FUSS_OPEN_SPLIT_RIGHT
        50 => ctx_desc("ed.git.open_split_v", CTX_TGT_PATH, 0), // CTXA_FUSS_OPEN_SPLIT_BELOW
        51 => ctx_desc("ed.git.view", CTX_TGT_PATH, 0), // CTXA_FUSS_PREVIEW
        52 => ctx_desc("ed.git.stage", CTX_TGT_PATH, 0), // CTXA_FUSS_STAGE
        53 => ctx_desc("ed.git.unstage", CTX_TGT_PATH, 0), // CTXA_FUSS_UNSTAGE
        54 => ctx_desc("ed.git.discard", CTX_TGT_PATH, 0), // CTXA_FUSS_DISCARD
        55 => ctx_desc("ed.git.diff", CTX_TGT_PATH, 0), // CTXA_FUSS_DIFF
        56 => ctx_desc("ed.git.blame", CTX_TGT_PATH, 0), // CTXA_FUSS_BLAME
        57 => ctx_desc("ed.git.file.rename", CTX_TGT_PATH, 0), // CTXA_FUSS_RENAME
        58 => ctx_desc("ed.git.file.delete", CTX_TGT_PATH, 0), // CTXA_FUSS_DELETE
        59 => ctx_desc("ed.git.nav.toggle", CTX_TGT_FUSS_ROW, 0), // CTXA_FUSS_TOGGLE
        60 => ctx_desc("ed.git.copy_path", CTX_TGT_PATH, 0), // CTXA_FUSS_COPY_PATH
        61 => ctx_desc("ed.group.from_dir", CTX_TGT_FUSS_ROW, 0), // CTXA_FUSS_GROUP_FROM_DIR
        62 => ctx_desc("ed.git.refresh", CTX_TGT_NONE, 0), // CTXA_FUSS_REFRESH
        63 => ctx_desc("ed.git.commit", CTX_TGT_NONE, 0), // CTXA_FUSS_COMMIT
        64 => ctx_desc("ed.git.push", CTX_TGT_NONE, 0), // CTXA_FUSS_PUSH
        65 => ctx_desc("ed.git.pull", CTX_TGT_NONE, 0), // CTXA_FUSS_PULL
        66 => ctx_desc("ed.git.fetch", CTX_TGT_NONE, 0), // CTXA_FUSS_FETCH
        67 => ctx_desc("ed.git.status", CTX_TGT_NONE, 0), // CTXA_FUSS_STATUS
        68 => ctx_desc("ed.git.history", CTX_TGT_NONE, 0), // CTXA_FUSS_HISTORY
        69 => ctx_desc("ed.git.mode.leave", CTX_TGT_NONE, 0), // CTXA_FUSS_LEAVE
        // A picker row's command IS its accept, `iarg` the accept MODE
        // (`ctxrows.c:220-231`): HSPLIT is the side-by-side one.
        70 => ctx_desc_inline(CTX_TGT_PICK, CTX_PICK_ACCEPT_HERE), // CTXA_PICK_OPEN
        71 => ctx_desc_inline(CTX_TGT_PICK, CTX_PICK_ACCEPT_HSPLIT), // CTXA_PICK_SPLIT_RIGHT
        72 => ctx_desc_inline(CTX_TGT_PICK, CTX_PICK_ACCEPT_VSPLIT), // CTXA_PICK_SPLIT_BELOW
        73 => ctx_desc("ed.compl.accept", CTX_TGT_COMPL, 0), // CTXA_COMPL_ACCEPT
        74 => ctx_desc("ed.compl.doc_toggle", CTX_TGT_NONE, 0), // CTXA_COMPL_DOCS
        75 => ctx_desc("ed.compl.cancel", CTX_TGT_NONE, 0), // CTXA_COMPL_CANCEL
        76 => ctx_desc("ed.lsp.rename.apply", CTX_TGT_NONE, 0), // CTXA_RENAME_APPLY
        77 => ctx_desc("ed.lsp.rename.diff", CTX_TGT_NONE, 0), // CTXA_RENAME_DIFF
        78 => ctx_desc("ed.lsp.rename.cancel", CTX_TGT_NONE, 0), // CTXA_RENAME_CANCEL
        79 => ctx_desc("ed.group.pick.toggle", CTX_TGT_GP_ROW, 0), // CTXA_GP_TOGGLE
        // CONFIRM TAKES NO TARGET (`ctxrows.c:251-256`): it is about the
        // whole tick set.
        80 => ctx_desc("ed.group.pick.confirm", CTX_TGT_NONE, 0), // CTXA_GP_CONFIRM
        81 => ctx_desc_inline(CTX_TGT_NONE, 0), // CTXA_OVERLAY_CLOSE
        _ => ctx_desc_inline(CTX_TGT_NONE, 0), // CTXA_NONE
    }
}

// ---- what the rows turn on --------------------------------------------------

// `doc_win` (`ctxrows.c:266-273`): the window of the leaf that was POINTED
// AT, not necessarily the focused one; -1 when the leaf is gone.
fn ctxrows_doc_win(ed: Ed, c: CtxContext) -> int {
    let leaf = pane_leaf_by_index(ed, c.id)
    if leaf < 0 {
        return -1
    }
    ed.panes[leaf].win
}

// `doc_buf` (`ctxrows.c:275-278`).
fn ctxrows_doc_buf(ed: Ed, wi: int) -> int {
    if wi < 0 || wi >= ed.wins.len {
        return -1
    }
    ed.wins[wi].buf
}

// `has_selection` (`ctxrows.c:280-295`): HIGHLIGHT MODE IS THE WHOLE TEST —
// an anchor outside H is not drawn, and `ed.clip.cut`/`.copy` refuse there.
fn ctxrows_has_selection(ed: Ed, wi: int) -> bool {
    wi >= 0 && wi < ed.wins.len && ed.wins[wi].cs.curs.len != 0 && ed.mode == MODE_H
}

// `can_undo` (`ctxrows.c:297-301`).
fn ctxrows_can_undo(ed: Ed, bi: int) -> bool {
    if bi < 0 || bi >= ed.bufs.len || !ed.bufs[bi].ec.has_undo {
        return false
    }
    text.undo_current(ed.bufs[bi].ec.undo) != ed.bufs[bi].ec.undo.root
}

// `can_redo` (`ctxrows.c:303-312`): the node the buffer sits on has a
// child to redo INTO — true after an undo on a branch too.
fn ctxrows_can_redo(ed: Ed, bi: int) -> bool {
    if bi < 0 || bi >= ed.bufs.len || !ed.bufs[bi].ec.has_undo {
        return false
    }
    let cur = text.undo_current(ed.bufs[bi].ec.undo)
    text.undo_children(ed.bufs[bi].ec.undo, cur).len != 0
}

// `more_than_one_leaf` (`ctxrows.c:314-317`).
fn ctxrows_more_than_one_leaf(ed: Ed) -> bool {
    pane_leaf_count(ed, ed.pane_root) > 1
}

// ---- the document -----------------------------------------------------------

// `build_doc` (`ctxrows.c:353-434`).
fn ctxrows_build_doc(mut ed: Ed, c: CtxContext) {
    let wi = ctxrows_doc_win(ed, c)
    let bi = ctxrows_doc_buf(ed, wi)
    let sel = ctxrows_has_selection(ed, wi)
    let ro = bi >= 0 && buf_readonly(ed.bufs[bi])
    let dirty = bi >= 0 && buf_dirty(ed.bufs[bi])
    let has_path = bi >= 0 && ed.bufs[bi].has_path
    let undo = ctxrows_can_undo(ed, bi)
    let redo = ctxrows_can_redo(ed, bi)
    let many = ctxrows_more_than_one_leaf(ed)
    ctx_begin(mut ed.ctx, CTX_KIND_DOC)
    // The leaf index is the target; the CELL is the router's to capture
    // after the build.
    ctx_target(mut ed.ctx, c.id, "", false)
    ctx_item(mut ed.ctx, "Cut", "", CTXA_DOC_CUT, sel && !ro, 0)
    ctx_item(mut ed.ctx, "Copy", "", CTXA_DOC_COPY, sel, 0)
    // PASTE IS ENABLED WHENEVER THE BUFFER CAN TAKE BYTES
    // (`ctxrows.c:368-380`): the system clipboard cannot be read from a
    // menu build on the render path.
    ctx_item(mut ed.ctx, "Paste", "", CTXA_DOC_PASTE, !ro, 0)
    ctx_item(mut ed.ctx, "Delete", "", CTXA_DOC_DELETE, sel && !ro, 1)
    ctx_item(mut ed.ctx, "Select All", "", CTXA_DOC_SELECT_ALL, true, 1)
    ctx_sep(mut ed.ctx)
    ctx_item(mut ed.ctx, "Undo", "", CTXA_DOC_UNDO, undo, 1)
    ctx_item(mut ed.ctx, "Redo", "", CTXA_DOC_REDO, redo, 1)
    ctx_sep(mut ed.ctx)
    ctx_item(mut ed.ctx, "Split Right", "", CTXA_DOC_SPLIT_RIGHT, true, 2)
    ctx_item(mut ed.ctx, "Split Below", "", CTXA_DOC_SPLIT_BELOW, true, 2)
    ctx_item(mut ed.ctx, "Close Pane", "", CTXA_DOC_CLOSE_PANE, many, 2)
    ctx_sep(mut ed.ctx)
    ctx_item(mut ed.ctx, "Save", "", CTXA_DOC_SAVE, dirty, 1)
    // ALWAYS ENABLED (`ctxrows.c:394-400`): a scratch buffer and a clean
    // one are the two cases the row is most often reached for.
    ctx_item(mut ed.ctx, "Save As...", "", CTXA_DOC_SAVE_AS, true, 2)
    ctx_item(mut ed.ctx, "Reload", "", CTXA_DOC_RELOAD, has_path, 3)
    // The LSP section (`ctxrows.c:405-418`, yw11) and the git section
    // (`:419-426`, yw13) are omitted whole: no buffer has a server or a
    // repository before their lanes (this file's header).
    ctx_sep(mut ed.ctx)
    ctx_item(mut ed.ctx, "Command Palette...", "", CTXA_PALETTE_HERE, true, 0)
    ctx_item(mut ed.ctx, "Find File...", "", CTXA_DOC_FIND_FILE, true, 1)
    ctx_item(mut ed.ctx, "Go to Line...", "", CTXA_DOC_GOTO_LINE, true, 2)
    ctx_item(mut ed.ctx, "Toggle Wrap", "", CTXA_DOC_TOGGLE_WRAP, true, 3)
}

// ---- the tab strip ----------------------------------------------------------

// `build_tab` (`ctxrows.c:440-475`): the target captured NOW — the tab id
// and the canonical path; a tab gone between the press and here builds
// nothing.
fn ctxrows_build_tab(mut ed: Ed, c: CtxContext) {
    let idx = tab_index_of_id(ed, c.id)
    if idx < 0 || idx >= ed.tabs.len {
        return
    }
    let many = tab_count(ed) > 1
    let path = ed.tabs[idx].path
    let has_path = ed.tabs[idx].has_path
    let grouped = ed.tabs[idx].group_id != 0
    ctx_begin(mut ed.ctx, CTX_KIND_TAB)
    ctx_target(mut ed.ctx, c.id, path, has_path)
    ctx_item(mut ed.ctx, "Close Tab", "C-w", CTXA_TAB_CLOSE, many, 0)
    // GREYED, never hidden (`ctxrows.c:457-459`).
    ctx_item(mut ed.ctx, "Close Other Tabs", "", CTXA_TAB_CLOSE_OTHERS, many, 1)
    ctx_sep(mut ed.ctx)
    ctx_item(mut ed.ctx, "Copy Path", "", CTXA_TAB_COPY_PATH, has_path, 1)
    ctx_item(mut ed.ctx, "Remove from Group", "", CTXA_TAB_LEAVE_GROUP, grouped, 2)
    ctx_sep(mut ed.ctx)
    ctx_item(mut ed.ctx, "New Tab", "", CTXA_TAB_NEW, true, 2)
    ctx_item(mut ed.ctx, "Open in Split Right", "", CTXA_TAB_OPEN_SPLIT_RIGHT, true, 3)
    ctx_item(mut ed.ctx, "Open in Split Left", "", CTXA_TAB_OPEN_SPLIT_LEFT, true, 3)
    ctx_item(mut ed.ctx, "Open in Split Below", "", CTXA_TAB_OPEN_SPLIT_BELOW, true, 3)
}

// `build_group` (`ctxrows.c:477-490`).
fn ctxrows_build_group(mut ed: Ed, c: CtxContext) {
    if group_find(ed, c.id) < 0 {
        return
    }
    ctx_begin(mut ed.ctx, CTX_KIND_GROUP)
    ctx_target(mut ed.ctx, c.id, "", false)
    ctx_item(mut ed.ctx, "Edit Group...", "", CTXA_GROUP_EDIT, true, 0)
    ctx_item(mut ed.ctx, "Rename Group...", "", CTXA_GROUP_RENAME, true, 1)
    ctx_sep(mut ed.ctx)
    ctx_item(mut ed.ctx, "Close Group", "", CTXA_GROUP_CLOSE, true, 1)
    ctx_item(mut ed.ctx, "Dissolve Group", "", CTXA_GROUP_DISSOLVE, true, 1)
}

// `build_strip` (`ctxrows.c:492-511`): the strip's blank tail and the bare
// backdrop get one row set — the pointer is on the workspace.
fn ctxrows_build_strip(mut ed: Ed, c: CtxContext) {
    ctx_begin(mut ed.ctx, c.kind)
    ctx_target(mut ed.ctx, 0, "", false)
    ctx_item(mut ed.ctx, "New Tab", "", CTXA_TAB_NEW, true, 0)
    ctx_item(mut ed.ctx, "Open File...", "", CTXA_FIND_FILE, true, 0)
    ctx_item(mut ed.ctx, "New Group...", "", CTXA_GROUP_NEW, true, 1)
    ctx_sep(mut ed.ctx)
    ctx_item(mut ed.ctx, "Command Palette...", "", CTXA_PALETTE, true, 0)
    ctx_item(mut ed.ctx, "Find Buffer...", "", CTXA_FIND_BUFFER, true, 2)
}

// ---- the pane border and the footer -----------------------------------------

// `build_border` (`ctxrows.c:517-530`).
fn ctxrows_build_border(mut ed: Ed, c: CtxContext) {
    let many = ctxrows_more_than_one_leaf(ed)
    ctx_begin(mut ed.ctx, CTX_KIND_BORDER)
    ctx_target(mut ed.ctx, c.id, "", false)
    ctx_item(mut ed.ctx, "Close Pane", "", CTXA_PANE_CLOSE, many, 0)
    ctx_item(mut ed.ctx, "Grow", "", CTXA_PANE_GROW, many, 1)
    ctx_item(mut ed.ctx, "Shrink", "", CTXA_PANE_SHRINK, many, 1)
    ctx_sep(mut ed.ctx)
    ctx_item(mut ed.ctx, "Focus Next", "", CTXA_PANE_FOCUS_NEXT, many, 2)
}

// `number_style_name` (`ctxrows.c:532-547`).
fn ctxrows_number_style_name(ed: Ed) -> str {
    let style = if ed.win < 0 then NUM_NONE else ed.wins[ed.win].number_style
    if style == NUM_ABS {
        return "abs"
    }
    if style == NUM_REL {
        return "rel"
    }
    if style == NUM_HYBRID {
        return "hybrid"
    }
    "none"
}

// `build_footer` (`ctxrows.c:549-568`): the number row NAMES THE CURRENT
// STYLE.
fn ctxrows_build_footer(mut ed: Ed) {
    let numbers = "Line Numbers: {ctxrows_number_style_name(ed)}"
    ctx_begin(mut ed.ctx, CTX_KIND_FOOTER)
    ctx_target(mut ed.ctx, 0, "", false)
    ctx_item(mut ed.ctx, "Command Palette...", "", CTXA_PALETTE, true, 0)
    ctx_item(mut ed.ctx, "Go to Line...", "", CTXA_GOTO_LINE, true, 1)
    ctx_sep(mut ed.ctx)
    ctx_item(mut ed.ctx, "Toggle Wrap", "", CTXA_TOGGLE_WRAP, true, 2)
    ctx_item(mut ed.ctx, numbers, "", CTXA_NUMBER_CYCLE, true, 2)
    ctx_sep(mut ed.ctx)
    ctx_item(mut ed.ctx, "Disable Mouse", "", CTXA_MOUSE_DISABLE, true, 3)
}

// ---- FUSS (yw13) ------------------------------------------------------------

/// The FUSS builders' refusal (`build_fuss_file`/`_dir`/`_blank`,
/// `ctxrows.c:574-673`, R-yw06-4 = A): their rows read the FUSS tree and
/// its git status, Sprint 52's, so each refuses by name on the message
/// line and in the log and builds nothing.
pub fn ctxrows_fuss_refusal(kind: int) -> str {
    let what = if kind == CTX_KIND_FUSS_FILE {
        "file"
    } else if kind == CTX_KIND_FUSS_DIR {
        "directory"
    } else {
        "drawer"
    }
    "not yet ported: the FUSS {what} context menu (the FUSS tree and its git status): sagitta Sprint 52 (yw13)"
}

fn ctxrows_build_fuss(mut ed: Ed, kind: int) {
    let message = ctxrows_fuss_refusal(kind)
    util.log_at(util.LOG_ERROR, message)
    ed_msg(mut ed, MSG_ERROR, message)
}

// ---- the transient overlays -------------------------------------------------

// `build_pick_row` (`ctxrows.c:679-693`): the ITEM PAYLOAD is the target —
// the list refilters while the menu is up.
fn ctxrows_build_pick_row(mut ed: Ed, c: CtxContext) {
    ctx_begin(mut ed.ctx, CTX_KIND_PICK_ROW)
    ctx_target(mut ed.ctx, c.id, "", false)
    ctx_item(mut ed.ctx, "Open", "", CTXA_PICK_OPEN, true, 0)
    ctx_item(mut ed.ctx, "Open in Split Right", "", CTXA_PICK_SPLIT_RIGHT, true, 1)
    ctx_item(mut ed.ctx, "Open in Split Below", "", CTXA_PICK_SPLIT_BELOW, true, 1)
    ctx_sep(mut ed.ctx)
    ctx_item(mut ed.ctx, "Close", "", CTXA_OVERLAY_CLOSE, true, 0)
}

// `build_picker` (`ctxrows.c:695-703`).
fn ctxrows_build_picker(mut ed: Ed, c: CtxContext) {
    ctx_begin(mut ed.ctx, c.kind)
    ctx_target(mut ed.ctx, 0, "", false)
    ctx_item(mut ed.ctx, "Close", "", CTXA_OVERLAY_CLOSE, true, 0)
}

// `build_compl_row` (`ctxrows.c:705-714`).
fn ctxrows_build_compl_row(mut ed: Ed, c: CtxContext) {
    ctx_begin(mut ed.ctx, CTX_KIND_COMPL_ROW)
    ctx_target(mut ed.ctx, c.id, "", false)
    ctx_item(mut ed.ctx, "Accept", "", CTXA_COMPL_ACCEPT, true, 0)
    ctx_item(mut ed.ctx, "Toggle Docs", "", CTXA_COMPL_DOCS, true, 1)
    ctx_sep(mut ed.ctx)
    ctx_item(mut ed.ctx, "Cancel", "", CTXA_COMPL_CANCEL, true, 0)
}

// `build_panel` (`ctxrows.c:716-751`): ONE PANEL SLOT, TWO SHAPES. No
// rename confirmation can be up before yw11 (`yew_lsp_rename_confirm_
// active` false, as C's stripped shim answers), so this is the bare
// `Close`; the rename shape's three answers are yw11's to reach.
fn ctxrows_build_panel(mut ed: Ed) {
    ctx_begin(mut ed.ctx, CTX_KIND_PANEL)
    ctx_target(mut ed.ctx, 0, "", false)
    ctx_item(mut ed.ctx, "Close", "", CTXA_OVERLAY_CLOSE, true, 0)
}

// `build_gp` (`ctxrows.c:753-776`): `Toggle` is a ROW's row (its target the
// LISTING INDEX); `Confirm` and `Cancel` are the dialog's.
fn ctxrows_build_gp(mut ed: Ed, c: CtxContext) {
    let row = c.kind == CTX_KIND_GP_ROW
    ctx_begin(mut ed.ctx, c.kind)
    ctx_target(mut ed.ctx, c.id, "", false)
    if row {
        ctx_item(mut ed.ctx, "Toggle", "", CTXA_GP_TOGGLE, true, 0)
        ctx_sep(mut ed.ctx)
    }
    ctx_item(mut ed.ctx, "Confirm", "", CTXA_GP_CONFIRM, true, 0)
    ctx_item(mut ed.ctx, "Cancel", "", CTXA_OVERLAY_CLOSE, true, 0)
}

// ---- the one entry point ----------------------------------------------------

/// `yew_ctx_build` (`ctxrows.c:782-838`): the rows for `c` into the widget
/// (`Ed.ctx`) — begin, the target, the items. It does NOT place the menu;
/// a kind with no rows (a target gone, a FUSS kind refused) leaves the
/// widget empty and `ctx_show` refuses. The kind is matched HERE, once
/// (G19/G20), on literal ids.
pub fn ctx_build(mut ed: Ed, c: CtxContext) {
    match c.kind {
        1 => ctxrows_build_tab(mut ed, c), // CTX_KIND_TAB
        2 => ctxrows_build_group(mut ed, c), // CTX_KIND_GROUP
        4 => ctxrows_build_doc(mut ed, c), // CTX_KIND_DOC
        3 => ctxrows_build_strip(mut ed, c), // CTX_KIND_STRIP
        16 => ctxrows_build_strip(mut ed, c), // CTX_KIND_EDITOR
        5 => ctxrows_build_border(mut ed, c), // CTX_KIND_BORDER
        6 => ctxrows_build_footer(mut ed), // CTX_KIND_FOOTER
        7 => ctxrows_build_fuss(mut ed, c.kind), // CTX_KIND_FUSS_FILE (yw13)
        8 => ctxrows_build_fuss(mut ed, c.kind), // CTX_KIND_FUSS_DIR (yw13)
        9 => ctxrows_build_fuss(mut ed, c.kind), // CTX_KIND_FUSS_BLANK (yw13)
        10 => ctxrows_build_pick_row(mut ed, c), // CTX_KIND_PICK_ROW
        11 => ctxrows_build_picker(mut ed, c), // CTX_KIND_PICKER
        12 => ctxrows_build_compl_row(mut ed, c), // CTX_KIND_COMPL_ROW
        13 => ctxrows_build_panel(mut ed), // CTX_KIND_PANEL
        14 => ctxrows_build_gp(mut ed, c), // CTX_KIND_GP_ROW
        15 => ctxrows_build_gp(mut ed, c), // CTX_KIND_GP
        // CTX_KIND_NONE: nothing the fall-through could name; opening a
        // menu would be inventing a surface (`ctxrows.c:831-836`).
        _ => {},
    }
}
