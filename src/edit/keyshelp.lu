//! edit.keyshelp — `ed.keys`, the keys help. A yew addition: sagitta has
//! no such command (its nearest, `ed.map`, `bind.c:475-522`, lists the
//! current mode's configured layer as one message).
//!
//! It opens the list picker (`edit.picker`, `PICK_HOST_KEYS`: sagitta's
//! rule that every list is that widget, `picker.h:7-11`) over every
//! mode's bindings, each row its mode, its keys (`key_format_seq`), its
//! command and arguments, and, for a binding the port refuses, the sagitta
//! sprint and yew lane that own it: `(unsupported: sagitta Sprint N,
//! ywNN)`; the command's one-line help takes the room the row leaves.
//!
//! **What a mode's rows are** is the dispatcher's rule, not a list kept
//! here: the first key picks the top layer of the mode's stack that knows
//! it, and the rest of the chord is read in that layer only
//! (`dispatch.c:278-291`, `dispatch_key`). So each layer's rows (the
//! config layer, the user layer, the mode's floor) are listed when the
//! dispatcher would reach them, and a floor row whose first key a higher
//! layer owns is not. H's floor is rebuilt for the unit it is entered from
//! (`keys_highlight.c`): a row the same from every unit is listed once
//! (`H`), the others per unit (`H/L`, `H/W`, `H/B`, `H/I`).
//!
//! **What "unsupported" means** is the refusal's own decision, read from
//! the functions the refusals are written from (R-yw15-7): a built-in
//! whose C handler is not ported (`IMPL_UNPORTED`, owned per
//! `cmd_entry_owner`, as `cmd_unported_message` says), C's own deferral
//! (`CMD_DEFERRED`), a plugin command (`cmd_plugin_owner`), and
//! `ed.mode.enter` naming a mode the port refuses (`mode_unported_owner`).
//!
//! **The key** is `A-?` (a legacy terminal's `ESC ?`) and `A-S-/` (the
//! kitty protocol's report of the same keys), in the user layer every
//! mode's stack shares (C's `ed->user_keys`, built empty at
//! `keys_default.c:107-111`; R-yw15-2, R-yw15-3).

use unicode
use util

/// One row of the keys help.
pub struct KeysRow {
    /// The mode whose stack reaches it.
    mode: int,
    /// H's unit for a row that differs by unit, else -1.
    unit: int,
    /// The mode as shown: `L`, `H`, `H/W`.
    label: str,
    /// The keys (`key_format_seq`).
    seq: str,
    cmd: int,
    name: str,
    iarg: int,
    sarg: str,
    has_sarg: bool,
    /// The command's one-line help (the registry's).
    help: str,
    /// `""`, or `(unsupported: sagitta Sprint N, ywNN)`.
    status: str,
}

/// The user layer's rows (yew's own; C's is empty): the keys help in
/// every mode.
pub fn keys_user_rows() -> List[BindRow] {
    var r = List[BindRow]()
    (mut r).push(bindrow("A-?", "ed.keys"))
    (mut r).push(bindrow("A-S-/", "ed.keys"))
    r
}

// A listed binding: its key ids and what it binds.
struct KhEntry {
    seq: List[int],
    bind: Binding,
}

fn kh_seq_less(a: KhEntry, b: KhEntry) -> bool {
    var i = 0
    while i < a.seq.len && i < b.seq.len {
        if a.seq[i] != b.seq[i] {
            return a.seq[i] < b.seq[i]
        }
        i += 1
    }
    a.seq.len < b.seq.len
}

// The rows the dispatcher reaches in the stack floor, user, config.
fn kh_stack_rows(ed: Ed, floor: Keymap, mode: int) -> List[KhEntry] {
    var stack = List[Keymap]()
    (mut stack).push(copy floor)
    (mut stack).push(copy ed.keymaps[km_user()])
    (mut stack).push(copy ed.keymaps[km_bind(mode)])
    var out = List[KhEntry]()
    var li = 0
    while li < stack.len {
        let (_, entries) = keymap_list(stack[li])
        for e in entries {
            if e.seq.len == 0 {
                continue
            }
            var first = List[int]()
            (mut first).push(e.seq[0])
            var top = stack.len
            while top != 0 {
                let (m, _, _) = keymap_lookup(stack[top - 1], first, 1)
                if m != MATCH_NONE {
                    break
                }
                top -= 1
            }
            if top - 1 == li {
                (mut out).push(KhEntry { seq: copy e.seq, bind: copy e.bind })
            }
        }
        li += 1
    }
    if out.len > 1 {
        util.sort_stable(mut out, kh_seq_less)
    }
    out
}

// `cmd_owner`'s sprint as the label shows it: its number, the first word.
fn kh_sprint_number(sprint: str) -> str {
    let sp = sprint.find(" ") else -1
    if sp < 0 then sprint else sprint[0..sp]
}

/// The status of a binding of command `id` with argument `sarg`: `""`
/// when invoking it runs it, `(unsupported: sagitta Sprint N, LANE)` when
/// it answers the deferred refusal before anything runs (R-yw15-7).
pub fn keys_status(ed: Ed, id: int, sarg: str, has_sarg: bool) -> str {
    if !cmd_active(ed.reg, id) {
        return ""
    }
    let e = copy ed.reg.entries[id - 1]
    var sprint = ""
    var lane = ""
    if e.handler == HANDLER_PLUGIN {
        let (s, l) = cmd_plugin_owner()
        sprint = s
        lane = l
    } else if e.handler != HANDLER_BUILTIN {
        return ""
    } else if e.flags & CMD_DEFERRED != 0 {
        let (_, l) = cmd_entry_owner(e)
        sprint = cmd_deferred_sprint(e)
        lane = l
    } else if e.impl_id == IMPL_UNPORTED {
        let (s, l) = cmd_entry_owner(e)
        sprint = s
        lane = l
    } else if e.name == "ed.mode.enter" && has_sarg && sarg.len == 1 && sarg != "C" {
        let (s, l) = mode_unported_owner(mode_of_name(sarg))
        sprint = s
        lane = l
    }
    if sprint.len == 0 {
        return ""
    }
    "(unsupported: sagitta Sprint {kh_sprint_number(sprint)}, {lane})"
}

fn kh_row(ed: Ed, mode: int, unit: int, label: str, e: KhEntry) -> KeysRow {
    var text = List[byte]()
    key_format_seq(e.seq, e.seq.len, mut text)
    let b = e.bind
    let name = if cmd_active(ed.reg, b.cmd) then ed.reg.entries[b.cmd - 1].name else "<unknown>"
    let help = if cmd_active(ed.reg, b.cmd) then ed.reg.entries[b.cmd - 1].help else ""
    KeysRow {
        mode: mode,
        unit: unit,
        label: label,
        seq: str_from_utf8(text) else "?",
        cmd: b.cmd,
        name: name,
        iarg: b.iarg,
        sarg: b.sarg,
        has_sarg: b.has_sarg,
        help: help,
        status: keys_status(ed, b.cmd, b.sarg, b.has_sarg),
    }
}

// A binding's identity across H's four unit tables.
fn kh_key(e: KhEntry) -> str {
    var text = List[byte]()
    key_format_seq(e.seq, e.seq.len, mut text)
    let s = str_from_utf8(text) else "?"
    let b = e.bind
    let has = if b.has_sarg then 1 else 0
    "{s}\x1f{b.cmd}\x1f{b.iarg}\x1f{has}\x1f{b.sarg}"
}

/// Every mode's rows, modes in the registry's order (L W B H I E F), rows
/// in key order within a mode; H's shared rows, then its per-unit rows.
pub fn keys_rows(ed: Ed) -> List[KeysRow] {
    var out = List[KeysRow]()
    for m in 0..MODE_N {
        if m != MODE_H {
            let floor = copy ed.keymaps[km_mode(m)]
            for e in kh_stack_rows(ed, floor, m) {
                (mut out).push(kh_row(ed, m, -1, mode_name(m), e))
            }
            continue
        }
        let units = [MODE_L, MODE_W, MODE_B, MODE_I]
        var per = List[List[KhEntry]]()
        var seen = Map[str, int]()
        for u in units {
            let (ok, floor) = keymap_build(ed.reg, "H", keys_highlight(u))
            if !ok {
                bug("keys help: H's {mode_name(u)} table does not build")
            }
            let rows = kh_stack_rows(ed, floor, MODE_H)
            for e in rows {
                let k = kh_key(e)
                (mut seen).set(k, (seen.get(k) else 0) + 1)
            }
            (mut per).push(rows)
        }
        for e in per[0] {
            if (seen.get(kh_key(e)) else 0) == units.len {
                (mut out).push(kh_row(ed, MODE_H, -1, "H", e))
            }
        }
        var i = 0
        while i < units.len {
            for e in per[i] {
                if (seen.get(kh_key(e)) else 0) != units.len {
                    (mut out).push(kh_row(ed, MODE_H, units[i], "H/{mode_name(units[i])}", e))
                }
            }
            i += 1
        }
    }
    out
}

fn kh_cells(s: str) -> int {
    let (_, cells) = unicode.str_clip(s.bytes(), 0, s.len, 100000)
    cells
}

fn kh_pad(s: str, cells: int) -> str {
    var out = s
    var n = kh_cells(s)
    while n < cells {
        out = out + " "
        n += 1
    }
    out
}

fn kh_args(r: KeysRow) -> str {
    var out = ""
    if r.iarg != 0 {
        out = out + " {r.iarg}"
    }
    if r.has_sarg {
        out = out + " {r.sarg}"
    }
    out
}

/// The widest keys column over `rows`, in cells.
pub fn keys_seq_width(rows: List[KeysRow]) -> int {
    var w = 0
    for r in rows {
        let n = kh_cells(r.seq)
        if n > w {
            w = n
        }
    }
    w
}

/// A row as the picker lists it: the mode (three cells), the keys padded
/// to `seq_w`, the command with its arguments, and the status; the help
/// is the picker's detail column.
pub fn keys_row_label(r: KeysRow, seq_w: int) -> str {
    let head = "{kh_pad(r.label, 3)} {kh_pad(r.seq, seq_w)}  {r.name}{kh_args(r)}"
    if r.status.len == 0 then head else "{head}  {r.status}"
}

/// A row whole, as Enter shows it on the message row: mode, keys,
/// command and arguments, help, status.
pub fn keys_row_line(r: KeysRow) -> str {
    var line = "{r.label}  {r.seq}  {r.name}{kh_args(r)}"
    if r.help.len != 0 {
        line = line + "  {r.help}"
    }
    if r.status.len != 0 {
        line = line + "  {r.status}"
    }
    line
}

/// `ed.keys`: the keys help in the picker. An open prompt is closed first:
/// the picker's filter line is the same widget (`picker.h`'s second law).
pub fn keys_cmd_open(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    if ed.cmdline.active {
        cmdline_close(mut ed, false)
    }
    let rows = keys_rows(ed)
    let w = keys_seq_width(rows)
    var items = List[PickItem]()
    var i = 0
    while i < rows.len {
        (mut items).push(PickItem {
            label: keys_row_label(rows[i], w),
            detail: rows[i].help,
            has_detail: rows[i].help.len != 0,
            payload: i + 1,
            flags: if rows[i].status.len != 0 then PICK_DEFERRED else 0,
        })
        i += 1
    }
    var spec = picker_spec(PICK_HOST_KEYS, "Keys", take items)
    spec.footer = "type to filter . enter show the row . esc"
    spec.has_footer = true
    picker_open(mut ed, spec)
    CMD_OK
}

/// The keys help's host call: accept puts the row's whole line on the
/// message row (the picker has closed already); nothing else is asked.
pub fn keys_pick_host(mut ed: Ed, call: int, payload: int) -> PkAnswer {
    if call != PK_ACCEPT {
        return pk_no()
    }
    let rows = keys_rows(ed)
    if payload < 1 || payload > rows.len {
        return pk_no()
    }
    ed_msg(mut ed, MSG_INFO, keys_row_line(rows[payload - 1]))
    PkAnswer { ok: true, text: "" }
}
