//! edit.cmdline_seams — where the prompt meets the grammar, the history,
//! the completion engine and search.
//!
//! The prompt's core (`edit.cmdline`) calls these by name; each is the
//! one place a sibling unit of campaign 04 is reached: `cmdparse` and
//! `cmdhist` (the grammar), `cmdcomp` and `menu` (completion), `searchui`
//! (s21). Until a sibling lands in this branch its seam answers what C's
//! answers when that subsystem has nothing to say — no menu is open, no
//! history walk is on, no search prompt can open — and the commands that
//! need it (Tab, Up, `/`) keep refusing by name through the registry's
//! `IMPL_UNPORTED` (`edit.impl`), so nothing is silent. The narrow `:`
//! grammar (R-yw03-1) runs accept until the grammar lands.

use text

// ---- completion (cmdcomp, menu) ---------------------------------------

fn cl_menu_open(mut ed: Ed) {
    ed.cmdline.click_row = -1
}

fn cl_menu_discard(mut ed: Ed) {
    ed.cmdline.has_menu_stem = false
    ed.cmdline.menu_stem = List[byte]()
    ed.cmdline.menu_original = text.span(0, 0)
    ed.cmdline.comp_total = 0
    ed.cmdline.comp_asked = false
}

fn cl_menu_dismiss(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
}

fn cl_menu_blur(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
}

fn cl_menu_chosen(ed: Ed) -> bool {
    let _ = ed.cmdline.active
    false
}

fn cl_menu_take_chosen(mut ed: Ed) -> int {
    ed.cmdline.seam_calls += 1
    CMD_OK
}

fn cl_menu_owned(ed: Ed) -> bool {
    let _ = ed.cmdline.active
    false
}

fn cl_menu_cancel(mut ed: Ed) -> int {
    ed.cmdline.seam_calls += 1
    CMD_OK
}

fn cl_menu_open_rows(ed: Ed) -> bool {
    let _ = ed.cmdline.active
    false
}

fn cl_draw_menu(mut ed: Ed, footer: int, style: UiStyle) {
    let _ = footer
    let _ = style.attrs
    ed.cmdline.seam_calls += 1
}

fn cl_refilter(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
}

fn cl_prompt_closed(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
}

/// The ghost after the caret (`yew_cmdline_ghost`, `cmdline.c:2443-2455`):
/// empty while no source suggests one.
pub fn cmdline_ghost(mut ed: Ed) -> List[byte] {
    ed.cmdline.seam_calls += 1
    List[byte]()
}

// ---- the grammar and the history (cmdparse, cmdhist) ------------------

fn cl_history_open(mut ed: Ed, kind: int) {
    let _ = kind
    ed.cmdline.seam_calls += 1
}

fn cl_history_release(mut ed: Ed, kind: int) {
    let _ = kind
    ed.cmdline.seam_calls += 1
}

fn cl_history_dispose(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
}

fn cl_history_add(mut ed: Ed, line: List[byte]) {
    let _ = line.len
    ed.cmdline.seam_calls += 1
}

fn cl_history_add_closed(mut ed: Ed, kind: int, line: List[byte]) {
    let _ = kind
    let _ = line.len
    ed.cmdline.seam_calls += 1
}

fn cl_walk_end(mut ed: Ed) {
    ed.cmdline.walk_prefix = 0
    ed.cmdline.walk_bang = false
}

fn cl_suggest_reset(mut ed: Ed) {
    ed.cmdline.suggest_loaded = false
}

fn cl_hsearch_accept(mut ed: Ed) -> int {
    ed.cmdline.hsearch = false
    CMD_OK
}

fn cl_hsearch_cancel(mut ed: Ed) -> int {
    ed.cmdline.hsearch = false
    CMD_OK
}

/// `yew_cmdline_hist_match` (`cmdline.c:1478-1504`): the bytes of the line
/// the history highlight covers; (false, empty) while no walked entry is
/// on the line.
pub fn cmdline_hist_match(ed: Ed) -> (bool, text.Span) {
    let _ = ed.cmdline.active
    (false, text.span(0, 0))
}

// `tok_forget` (`cmdline.c:2749-2759`).
fn cl_tok_forget(mut ed: Ed) {
    ed.cmdline.tok_term = List[byte]()
    ed.cmdline.tok_seen = List[TokHit]()
    ed.cmdline.tok_seq = 0
}

// The narrow `:` grammar (yw03's, R-yw03-1): `name[!] [arg ...]`, the
// name or its abbreviation; answers (status, the line that ran).
fn cl_resolve_name(ed: Ed, name: str) -> int {
    let id = cmd_lookup(ed.reg, name)
    if id != 0 {
        return id
    }
    var i = 0
    while i < ed.reg.entries.len {
        if ed.reg.entries[i].active &&
            ed.reg.entries[i].has_abbrev &&
            ed.reg.entries[i].abbrev == name {
            return i + 1
        }
        i += 1
    }
    0
}

fn cl_run_line(mut ed: Ed, raw: List[byte]) -> (int, List[byte]) {
    let gen = ed.cmdline.generation
    let kind = ed.cmdline.kind
    let line = str_from_utf8(raw) else ""
    var words = List[str]()
    for w in line.words() {
        (mut words).push(w)
    }
    if words.len == 0 {
        cmdline_close(mut ed, true)
        return (CMD_OK, copy raw)
    }
    var name = words[0]
    let first = name.bytes()[0] as int
    if first >= 48 && first <= 57 || first == 37 || first == 46 || first == 39 || first == 36 {
        cmdline_set_error(
            mut ed,
            0,
            1,
            "not yet ported: command ranges: sagitta Sprint 18 (the command line) (yw04)",
        )
        return (CMD_ERR_DEFERRED, copy raw)
    }
    if first == 33 {
        cmdline_set_error(
            mut ed,
            0,
            1,
            "not yet ported: shell commands: sagitta Sprint 19 (shell jobs) (yw04)",
        )
        return (CMD_ERR_DEFERRED, copy raw)
    }
    var bang = false
    if name.ends_with("!") {
        bang = true
        name = name[0..name.len - 1]
    }
    let id = cl_resolve_name(ed, name)
    if id == 0 {
        cmdline_set_error(mut ed, 0, name.len, "unknown command '{name}' (try Tab)")
        return (CMD_ERR_ARG, copy raw)
    }
    var cx = cmdctx_new(ed.win, SRC_CMDLINE)
    cx.bang = bang
    for w in words {
        (mut cx.argv).push(w)
    }
    let arity = ed.reg.entries[id - 1].arity
    if words.len > 1 {
        if arity == ARITY_STR || arity == ARITY_OPT_STR {
            cx.sarg = words[1]
            cx.has_sarg = true
        } else if arity == ARITY_INT || arity == ARITY_OPT_INT {
            cx.iarg = words[1].to_int() else {
                return (CMD_ERR_ARG, copy raw)
            }
        }
    }
    let lead = line.len - line.trim_start().len
    let status = ed_cmd_invoke(mut ed, id, mut cx)
    if status != CMD_OK {
        cmdline_failed(mut ed, status, id, lead, lead + words[0].len, kind, gen)
    }
    (status, copy raw)
}

// ---- search (searchui, s21) -------------------------------------------

fn cl_search_open(mut ed: Ed, backward: bool) {
    let _ = backward
    ed_msg(
        mut ed,
        MSG_ERROR,
        "not yet ported: the search prompt: sagitta Sprint 21 (search and replace) (yw04)",
    )
}

fn cl_search_accept(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
}

fn cl_search_cancel(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
}

fn cl_search_input(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
}

fn cl_search_preview_pending(ed: Ed) -> bool {
    let _ = ed.cmdline.active
    false
}

fn cl_search_confirm_reprompt(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
}
