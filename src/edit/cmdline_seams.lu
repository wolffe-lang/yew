//! edit.cmdline_seams — where the prompt meets search.
//!
//! The prompt's core (`edit.cmdline`) calls these by name: they are the
//! one place the search UI (`edit.searchui`, `searchui.c`, s21) is
//! reached from the prompt (`cmdline.c:552`, `:614-622`, `:666-668`,
//! `:1121-1126`).

// ---- search (searchui, s21) -------------------------------------------

fn cl_search_open(mut ed: Ed, backward: bool) {
    ed.cmdline.seam_calls += 1
    search_open(mut ed, ed.win, backward)
}

fn cl_search_accept(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
    search_accept(mut ed, ed.win)
}

fn cl_search_cancel(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
    search_cancel(mut ed, ed.win)
}

fn cl_search_input(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
    search_input(mut ed, ed.win)
}

fn cl_search_preview_pending(ed: Ed) -> bool {
    ed.search.preview_pending
}

fn cl_search_confirm_reprompt(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
    search_confirm_reprompt(mut ed)
}
