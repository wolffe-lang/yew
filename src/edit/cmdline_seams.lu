//! edit.cmdline_seams — where the prompt meets search.
//!
//! The prompt's core (`edit.cmdline`) calls these by name: they are the
//! one place the search UI (`searchui.c`, s21, the search fork) is
//! reached. Until it lands in this branch a search prompt cannot open (it
//! refuses by name, and `/` and `?` keep refusing through the registry's
//! `IMPL_UNPORTED`), so the other hooks are never reached with a search
//! prompt up.

// ---- search (searchui, s21) -------------------------------------------

fn cl_search_open(mut ed: Ed, backward: bool) {
    let _ = backward
    ed_msg(
        mut ed,
        MSG_ERROR,
        "not yet ported: the search prompt: sagitta Sprint 21 (search and replace) (yw04)",
    )
}

fn cl_search_accept(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
}

fn cl_search_cancel(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
}

fn cl_search_input(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
}

fn cl_search_preview_pending(ed: Ed) -> bool {
    let _ = ed.cmdline.active
    false
}

fn cl_search_confirm_reprompt(mut ed: Ed) {
    ed.cmdline.seam_calls += 1
}
