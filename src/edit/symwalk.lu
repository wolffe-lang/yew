//! edit.symwalk — the workspace symbol walk's discovery decision, pulled
//! forward from yw11 (R-yw13-4).
//!
//! sagitta `src/ws/symwalk.c` (636 lines) at 9ace98c2 starts the
//! workspace symbol walk at startup (`ed.c:3081-3082`): inside a
//! repository (`.git` lstat-able at the workspace root) with `git` on
//! `PATH` it lists files with `git ls-files`; inside one WITHOUT `git` on
//! `PATH` it posts the INFO notice `git discovery unavailable; using
//! workspace walk` and falls back to the directory walk. Every F-mode
//! golden opens in a fixture repository under a child with no `PATH`, and
//! waits for that notice in its first frame (`registry.c`'s `s52_open`),
//! so the notice is yw13's to post; the walk, the `ls-files` job and the
//! symbol index it feeds stay yw11's (`ws/symidx.c`).

// `executable_in_path` (`symwalk.c:85-112`): the first `PATH` entry (an
// empty one is `.`) holding an executable `name`; no `PATH` is none.
fn sw_executable_in_path(name: str) -> bool {
    let path = env_get("PATH") else { return false }
    var at = 0
    let b = path.bytes()
    loop {
        var end = at
        while end < b.len && b[end] as int != 58 {
            end += 1
        }
        let dir = if end == at then "." else path[at..end]
        var ok = true
        fs_access("{dir}/{name}", 1) else |_| { ok = false }
        if ok {
            return true
        }
        if end >= b.len {
            break
        }
        at = end + 1
    }
    false
}

// `repo_marker` (`symwalk.c:77-83`).
fn sw_repo_marker(root: str) -> bool {
    var ok = true
    let _ = fs_lstat("{root}/.git") else |_| {
        ok = false
        List[int]()
    }
    ok
}

/// `yew_symwalk_start` (`symwalk.c:455-503`), the discovery half: a
/// repository without `git` on `PATH` posts the fallback notice (C's
/// `fallback_begin(ed, true)`). The `ls-files` job and both walks are
/// yw11's (R-yw13-4).
pub fn symwalk_start(mut ed: Ed) {
    if !sw_repo_marker(shell_ws_root(ed)) {
        return
    }
    if !sw_executable_in_path("git") {
        ed_msg(mut ed, MSG_INFO, "git discovery unavailable; using workspace walk")
    }
}
