//! edit.cursor_click — bounded speculation for Alt single/double clicks.

use term
use text

pub struct CursorClick {
    valid: bool,
    previous_stamp: int,
    previous_pos: int,
    added_stamp: int,
    target_stamp: int,
    target_pos: int,
    count: int,
    next_stamp: int,
    rec_active: bool,
    rec_reg: int,
    rec_events: int,
    rec_blob: int,
    rec_in_prompt: bool,
}

fn cursor_click_new() -> CursorClick {
    CursorClick {
        valid: false,
        previous_stamp: 0,
        previous_pos: 0,
        added_stamp: 0,
        target_stamp: 0,
        target_pos: 0,
        count: 0,
        next_stamp: 0,
        rec_active: false,
        rec_reg: 0,
        rec_events: 0,
        rec_blob: 0,
        rec_in_prompt: false,
    }
}

fn cursor_click_same(ed: Ed, hit: Region, k: term.Key) -> bool {
    let age = ed.now_ms - ed.mouse.last_click_ms
    if ed.mouse.click_n == 0 || age < 0 || age >= CLICK_MULTI_MS ||
        ed.mouse.last_click_x != k.col || ed.mouse.last_click_y != k.row ||
        ed.mouse.last_click_kind != hit.kind || ed.mouse.last_click_payload != hit.payload {
        return false
    }
    let leaf = pane_leaf_by_index(ed, hit.payload)
    if leaf < 0 { return false }
    let w = ed.panes[leaf].win
    if w < 0 || w >= ed.wins.len { return false }
    let b = ed.wins[w].buf
    b >= 0 && b < ed.bufs.len &&
        ed.mouse.last_click_view == ed.wins[w].id &&
        ed.mouse.last_click_bid == ed.bufs[b].ec.tb.bid &&
        ed.mouse.last_click_gen == ed.bufs[b].ec.tb.gen &&
        ed.mouse.last_click_seq == ed.invoke_seq
}

fn cursor_click_record_ready(ed: Ed, c: CursorClick) -> bool {
    if !c.rec_active { return !ed.rec.active }
    if !ed.rec.active || ed.rec.reg != c.rec_reg ||
        ed.rec.ev.len != c.rec_events + 1 || ed.rec.blob.len != c.rec_blob {
        return false
    }
    let ev = ed.rec.ev[c.rec_events]
    ev.cmd == cmd_lookup(ed.reg, "ed.cursor.add.at") &&
        ev.iarg == c.target_pos && ev.src == SRC_KEY &&
        ev.sarg_at == c.rec_blob && ev.sarg_len == 0 &&
        ev.range_kind == REC_RANGE_NONE && !ev.range_given &&
        ev.count == 1 && !ev.count_given && !ev.bang
}

fn cursor_click_restore(mut ed: Ed, w: int, k: term.Key) -> bool {
    let c = copy ed.mouse.cursor_click
    if !c.valid || !cursor_add_ready(ed, w) ||
        ed.wins[w].cs.curs.len != c.count ||
        ed.wins[w].cs.next_stamp != c.next_stamp ||
        !cursor_click_record_ready(ed, c) {
        return false
    }
    let (hit_ok, pos) = win_click_offset(mut ed, w, k.col, k.row)
    if !hit_ok || pos != c.target_pos { return false }
    var previous = -1
    var target = -1
    var latest = -1
    for i in 0..ed.wins[w].cs.curs.len {
        let stamp = ed.wins[w].cs.stamps[i]
        if stamp == c.previous_stamp { previous = i }
        if stamp == c.target_stamp { target = i }
        if stamp != c.previous_stamp &&
            (latest < 0 || stamp > ed.wins[w].cs.stamps[latest]) {
            latest = i
        }
    }
    if previous < 0 || target < 0 || ed.wins[w].cs.primary != target ||
        ed.wins[w].cs.curs[previous].pos != c.previous_pos ||
        ed.wins[w].cs.curs[target].pos != c.target_pos {
        return false
    }
    if c.added_stamp != 0 &&
        (latest < 0 || ed.wins[w].cs.stamps[latest] != c.added_stamp) {
        return false
    }
    // The only removable identity is the newest secondary just introduced by
    // this gesture. The existing primitive preserves all other identities and
    // leaves next_stamp monotonic.
    ed.wins[w].cs.primary = previous
    if c.added_stamp != 0 { let _ = text.cset_drop_latest(mut ed.wins[w].cs) }
    if c.rec_active {
        let _ = (mut ed.rec.ev).pop() else { return false }
        ed.rec.in_prompt = c.rec_in_prompt
        ed.footer_dirty = true
    }
    ed.mouse.cursor_click.valid = false
    ed.mouse.last_click_add = false
    true
}

fn cursor_click_legacy(mut ed: Ed, hit: Region, k: term.Key) -> bool {
    if !cursor_click_same(ed, hit, k) { return false }
    // A third press continues the existing line-selection gesture. A fresh H
    // Alt click still cannot add mixed-selection carets.
    if ed.mouse.click_n == 2 && !ed.mouse.last_click_add { return true }
    if ed.mouse.click_n != 1 { return false }
    if !ed.mouse.last_click_add { return true }
    let leaf = pane_leaf_by_index(ed, hit.payload)
    cursor_click_restore(mut ed, ed.panes[leaf].win, k)
}
