# -- 3. I mode ----------------------------------------------------------
bind(\"I\", \"A-h\", \"ed.mode.enter\", {{ sarg: \"H\" }})
bind(\"I\", \"<esc>\", \"ed.shadow.dismiss\")
bind(\"I\", \"C-g\", \"ed.ui.message_expand\")
# Alt+arrow is the word jump in I mode.  Alt+Right stays contextual: it
# accepts one word of a suggestion only while one is showing, and is
# the word jump otherwise, so the key is never dead.
bind(\"I\", \"A-<left>\", \"ed.move.word.prev\")
# Readline spelling of the same motions.  A terminal that will not
# send CSI 1;3D for alt+arrow almost always sends ESC b / ESC f,
# which the decoder already reports as A-b / A-f -- so these are
# what actually reach yew under Terminal.app and tmux.
bind(\"I\", \"A-b\", \"ed.move.word.prev\")
bind(\"I\", \"A-f\", \"ed.move.word.next\")
bind(\"I\", \"A-<right>\", \"ed.shadow.accept_or_word\")
bind(\"I\", \"A-S-<right>\", \"ed.shadow.accept_word_alt\")
bind(\"I\", \"A-<down>\", \"ed.shadow.accept_line\")
bind(\"I\", \"A-<cr>\", \"ed.shadow.accept_all\")
bind(\"I\", \"A-]\", \"ed.shadow.next\")
bind(\"I\", \"A-[\", \"ed.shadow.prev\")
bind(\"I\", \"C-<space>\", \"ed.compl.complete\")
# Signature help moves off C-k, which every readline user's fingers
# already spend on kill-to-end.
bind(\"I\", \"A-k\", \"ed.lsp.signature\")
bind(\"I\", \"<cr>\", \"ed.edit.insert.newline\")
bind(\"I\", \"<tab>\", \"ed.edit.insert.tab\")
bind(\"I\", \"<bs>\", \"ed.edit.delete.grapheme_left\")
bind(\"I\", \"<del>\", \"ed.edit.delete.grapheme\")
bind(\"I\", \"<left>\", \"ed.move.unit.prev\")
bind(\"I\", \"<right>\", \"ed.move.unit.next\")
bind(\"I\", \"<up>\", \"ed.move.line.up\")
bind(\"I\", \"<down>\", \"ed.move.line.down\")
bind(\"I\", \"S-<left>\", \"ed.sel.extend.left\")
bind(\"I\", \"S-<right>\", \"ed.sel.extend.right\")
bind(\"I\", \"S-<up>\", \"ed.sel.extend.up\")
bind(\"I\", \"S-<down>\", \"ed.sel.extend.down\")
bind(\"I\", \"C-v\", \"ed.clip.paste\")
# C-c / C-x copy and cut a selection.  Insert's Shift+arrows enter H,
# where these keys act; in Insert itself there is none, so they do nothing.
bind(\"I\", \"C-c\", \"ed.clip.copy\")
bind(\"I\", \"C-x\", \"ed.clip.cut\")
bind(\"I\", \"<home>\", \"ed.move.line.home_toggle\")
bind(\"I\", \"<end>\", \"ed.move.line.end\")
# Ctrl+arrow is the LINE's start and end here, the same pair <home>/<end>
# give above -- NOT the word jump the usual convention puts on Ctrl+arrow.
# In yew the word jump is Alt+arrow (below), so leave these alone.
# The unix line keys, which every terminal sends as plain control
# bytes -- unlike ctrl+arrow, which Terminal.app and an unconfigured
# tmux swallow entirely.  Same pair the command line already uses.
bind(\"I\", \"C-a\", \"ed.move.line.home_toggle\")
bind(\"I\", \"C-e\", \"ed.move.line.end\")
bind(\"I\", \"C-<left>\", \"ed.move.line.home_toggle\")
bind(\"I\", \"C-<right>\", \"ed.move.line.end\")

# The rest of the readline/Emacs editing set.  They fan out to every live
# cursor and they are recordable; the prompt binds the same commands.
# Alt+Backspace and C-w are the same kill; a terminal sends one or the
# other depending on how it was configured, so both are bound.
bind(\"I\", \"C-w\", \"ed.edit.kill.word_prev\")
bind(\"I\", \"A-<bs>\", \"ed.edit.kill.word_prev\")
bind(\"I\", \"A-d\", \"ed.edit.kill.word_next\")
bind(\"I\", \"A-<del>\", \"ed.edit.kill.word_next\")
# C-u is kill-to-START of line, the unix line-discard, NOT the whole
# line -- what is already typed to the right of the caret survives.
bind(\"I\", \"C-u\", \"ed.edit.kill.to_home\")
bind(\"I\", \"C-k\", \"ed.edit.kill.to_end\")
# C-d deletes one grapheme forward and NOTHING else.  In a shell it is
# also EOF; here that would close a buffer on a keystroke meant to
# delete a character, so it is only ever the delete.
bind(\"I\", \"C-d\", \"ed.edit.delete.grapheme\")
# C-y yanks the newest kill from the yank stack -- readline's kill ring,
# shared with the prompt and apart from the registers: no register (and
# no clipboard) ever holds a kill.  A-y straight after swaps it for the
# next older kill.  C-v stays the SYSTEM clipboard paste above.
bind(\"I\", \"C-y\", \"ed.edit.kill.yank\")
bind(\"I\", \"A-y\", \"ed.edit.kill.yank_pop\")
bind(\"I\", \"C-p\", \"ed.move.line.up\")
bind(\"I\", \"C-n\", \"ed.move.line.down\")
# Undo.  A terminal in legacy mode sends 0x1F for both ctrl+_ and
# ctrl+/, which the decoder reports as C-_; under the kitty keyboard
# protocol ctrl+/ arrives as itself.  Bind both so the chord works
# whichever protocol is negotiated.
bind(\"I\", \"C-_\", \"ed.edit.undo\")
bind(\"I\", \"C-/\", \"ed.edit.undo\")
bind(\"I\", \"C-t\", \"ed.edit.transpose.chars\")
bind(\"I\", \"A-t\", \"ed.edit.transpose.words\")
bind(\"I\", \"A-u\", \"ed.edit.case.upper_word\")
bind(\"I\", \"A-l\", \"ed.edit.case.lower_word\")
bind(\"I\", \"A-c\", \"ed.edit.case.cap_word\")

