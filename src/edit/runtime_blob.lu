    flags: [
        {{ short: \"a\", desc: \"use this authentication style\",
          arg: {{ kind: \"none\" }} }},
        {{ short: \"C\", desc: \"check this config file and exit\",
          arg: {{ kind: \"path\" }} }},
        {{ short: \"L\", desc: \"clear persisted authentications\" }},
        {{ short: \"n\", desc: \"non-interactive: fail instead of prompting\" }},
        {{ short: \"s\", desc: \"run the user's shell\" }},
        {{ short: \"u\", desc: \"run as this user\", arg: {{ kind: \"user\" }} }},
    ],
}}
"""

