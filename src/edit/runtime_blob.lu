              {{ long: \"branch\", short: \"b\", desc: \"checkout <branch>, not the remote HEAD\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"depth\", desc: \"create a shallow clone of that depth\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"single-branch\", desc: \"clone only one branch\" }},
              {{ long: \"no-tags\", desc: \"do not clone tags\" }},
              {{ long: \"filter\", desc: \"object filtering\",
                arg: {{ kind: \"none\" }} }},
          ],
          args: [ {{ kind: \"none\" }}, {{ kind: \"dir\" }} ] }},

        {{ name: \"commit\", desc: \"record changes to the repository\",
          flags: [
              {{ long: \"quiet\", short: \"q\", desc: \"suppress summary after commit\" }},
              {{ long: \"verbose\", short: \"v\", desc: \"show diff in commit message template\" }},
              {{ long: \"file\", short: \"F\", desc: \"read message from file\",
                arg: {{ kind: \"path\" }} }},
              {{ long: \"author\", desc: \"override author for commit\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"date\", desc: \"override date for commit\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"message\", short: \"m\", desc: \"commit message\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"reuse-message\", short: \"C\", desc: \"reuse a commit's message\",
                arg: {{ kind: \"generator\", generator: \"branches\" }} }},
              {{ long: \"fixup\", desc: \"fixup! message for a commit\",
                arg: {{ kind: \"generator\", generator: \"branches\" }} }},
              {{ long: \"squash\", desc: \"squash! message for a commit\",
                arg: {{ kind: \"generator\", generator: \"branches\" }} }},
              {{ long: \"signoff\", short: \"s\", desc: \"add a Signed-off-by trailer\" }},
              {{ long: \"template\", short: \"t\", desc: \"use specified template file\",
                arg: {{ kind: \"path\" }} }},
              {{ long: \"edit\", short: \"e\", desc: \"force edit of commit\" }},
              {{ long: \"no-edit\", desc: \"use the message without launching an editor\" }},
              {{ long: \"cleanup\", desc: \"how to strip spaces and #comments\",
                arg: {{ kind: \"values\", values: [\"strip\", \"whitespace\", \"verbatim\",
                                                \"scissors\", \"default\"] }} }},
              {{ long: \"gpg-sign\", short: \"S\", desc: \"GPG sign commit\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"all\", short: \"a\", desc: \"commit all changed files\" }},
              {{ long: \"include\", short: \"i\", desc: \"add specified files to index\" }},
              {{ long: \"patch\", short: \"p\", desc: \"interactively add changes\" }},
              {{ long: \"only\", short: \"o\", desc: \"commit only specified files\" }},
              {{ long: \"no-verify\", short: \"n\", desc: \"bypass pre-commit and commit-msg hooks\" }},
              {{ long: \"dry-run\", desc: \"show what would be committed\" }},
              {{ long: \"amend\", desc: \"amend previous commit\" }},
              {{ long: \"allow-empty\", desc: \"allow a commit with no changes\" }},
              {{ long: \"untracked-files\", short: \"u\", desc: \"show untracked files\",
                arg: {{ kind: \"values\", values: [\"all\", \"normal\", \"no\"] }},
                arg_optional: true }},
          ],
          args: [ {{ kind: \"path\", repeat: true }} ],
          after_dashdash: {{ kind: \"path\", repeat: true }} }},

        {{ name: \"describe\", desc: \"name an object from an available ref\",
          flags: [
              {{ long: \"contains\", desc: \"find the tag that comes after the commit\" }},
              {{ long: \"all\", desc: \"use any ref\" }},
              {{ long: \"tags\", desc: \"use any tag, even unannotated\" }},
              {{ long: \"long\", desc: \"always use long format\" }},
              {{ long: \"abbrev\", desc: \"use <n> digits to display object names\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"exact-match\", desc: \"only output exact matches\" }},
              {{ long: \"match\", desc: \"only consider tags matching <pattern>\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"always\", desc: \"show abbreviated commit as fallback\" }},
              {{ long: \"dirty\", desc: \"append <mark> on dirty working tree\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\", repeat: true }} ] }},

        {{ name: \"diff\", desc: \"show changes between commits, trees, files\",
          flags: [
              {{ long: \"cached\", desc: \"changes staged for the next commit\" }},
              {{ long: \"staged\", desc: \"synonym of --cached\" }},
              {{ long: \"merge-base\", desc: \"diff against the merge base\" }},
              {{ long: \"no-index\", desc: \"compare two paths outside a repository\" }},
              {{ long: \"patch\", short: \"p\", desc: \"generate patch\" }},
              {{ long: \"no-patch\", short: \"s\", desc: \"suppress diff output\" }},
              {{ long: \"unified\", short: \"U\", desc: \"generate diffs with <n> lines context\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"stat\", desc: \"show diffstat instead of patch\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"numstat\", desc: \"machine friendly --stat\" }},
              {{ long: \"shortstat\", desc: \"output only the last line of --stat\" }},
              {{ long: \"name-only\", desc: \"show only names of changed files\" }},
              {{ long: \"name-status\", desc: \"show names and status of changed files\" }},
              {{ long: \"color\", desc: \"show colored diff\",
                arg: {{ kind: \"values\", values: [\"always\", \"never\", \"auto\"] }},
                arg_optional: true }},
              {{ long: \"no-color\", desc: \"turn off colored diff\" }},
              {{ long: \"word-diff\", desc: \"show a word diff\",
                arg: {{ kind: \"values\", values: [\"color\", \"plain\", \"porcelain\", \"none\"] }},
                arg_optional: true }},
              {{ long: \"find-renames\", short: \"M\", desc: \"detect renames\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"ignore-all-space\", short: \"w\", desc: \"ignore whitespace when comparing\" }},
              {{ long: \"ignore-space-change\", short: \"b\",
                desc: \"ignore changes in amount of whitespace\" }},
              {{ long: \"diff-algorithm\", desc: \"choose a diff algorithm\",
                arg: {{ kind: \"values\", values: [\"myers\", \"minimal\", \"patience\",
                                                \"histogram\"] }} }},
              {{ long: \"relative\", desc: \"show paths relative to a subdirectory\",
                arg: {{ kind: \"dir\" }}, arg_optional: true }},
              {{ long: \"exit-code\", desc: \"exit with 1 if there were differences\" }},
              {{ long: \"quiet\", desc: \"disable all output of the program\" }},
              {{ long: \"diff-filter\", desc: \"select files by diff type (ACDMRTUXB)\",
                arg: {{ kind: \"none\" }} }},
              {{ short: \"S\", desc: \"changes adding or removing the string\",
                arg: {{ kind: \"none\" }} }},
              {{ short: \"G\", desc: \"changes whose lines match the regex\",
                arg: {{ kind: \"none\" }} }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\" }},
                  {{ kind: \"path\", repeat: true }} ],
          after_dashdash: {{ kind: \"path\", repeat: true }} }},

        {{ name: \"fetch\", desc: \"download objects and refs from a repository\",
          flags: [
              {{ long: \"verbose\", short: \"v\", desc: \"be more verbose\" }},
              {{ long: \"quiet\", short: \"q\", desc: \"be more quiet\" }},
              {{ long: \"all\", desc: \"fetch from all remotes\" }},
              {{ long: \"force\", short: \"f\", desc: \"force overwrite of local reference\" }},
              {{ long: \"multiple\", short: \"m\", desc: \"fetch from multiple remotes\" }},
              {{ long: \"tags\", short: \"t\", desc: \"fetch all tags and associated objects\" }},
              {{ long: \"no-tags\", short: \"n\", desc: \"do not fetch all tags\" }},
              {{ long: \"jobs\", short: \"j\", desc: \"submodules fetched in parallel\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"prune\", short: \"p\", desc: \"prune remote-tracking branches\" }},
              {{ long: \"prune-tags\", short: \"P\", desc: \"prune local tags no longer on remote\" }},
              {{ long: \"recurse-submodules\", desc: \"fetch submodules too\",
                arg: {{ kind: \"values\", values: [\"yes\", \"on-demand\", \"no\"] }},
                arg_optional: true }},
              {{ long: \"dry-run\", desc: \"dry run\" }},
              {{ long: \"depth\", desc: \"deepen history of shallow clone\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"unshallow\", desc: \"convert to a complete repository\" }},
          ],
          args: [ {{ kind: \"generator\", generator: \"remotes\" }},
                  {{ kind: \"generator\", generator: \"branches\", repeat: true }} ] }},

        {{ name: \"format-patch\", desc: \"prepare patches for e-mail submission\",
          flags: [
              {{ long: \"numbered\", short: \"n\", desc: \"use [PATCH n/m] even with one patch\" }},
              {{ long: \"no-numbered\", short: \"N\", desc: \"use [PATCH] even with many patches\" }},
              {{ long: \"signoff\", short: \"s\", desc: \"add a Signed-off-by trailer\" }},
              {{ long: \"stdout\", desc: \"print patches to standard out\" }},
              {{ long: \"cover-letter\", desc: \"generate a cover letter\" }},
              {{ long: \"reroll-count\", short: \"v\", desc: \"mark the series as Nth re-roll\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"rfc\", desc: \"add <rfc> (default 'RFC') before 'PATCH'\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"subject-prefix\", desc: \"use [<prefix>] instead of [PATCH]\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"output-directory\", short: \"o\", desc: \"store resulting files in <dir>\",
                arg: {{ kind: \"dir\" }} }},
              {{ long: \"keep-subject\", short: \"k\", desc: \"don't strip/add [PATCH]\" }},
              {{ long: \"ignore-if-in-upstream\", desc: \"skip patches already upstream\" }},
              {{ long: \"to\", desc: \"add To: header\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"cc\", desc: \"add Cc: header\",
                arg: {{ kind: \"none\" }} }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\" }} ] }},

        {{ name: \"gc\", desc: \"clean up and optimize the local repository\",
          flags: [
              {{ long: \"quiet\", short: \"q\", desc: \"suppress progress reporting\" }},
              {{ long: \"prune\", desc: \"prune unreferenced objects\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"no-prune\", desc: \"do not prune loose objects\" }},
              {{ long: \"aggressive\", desc: \"be more thorough (increased runtime)\" }},
              {{ long: \"auto\", desc: \"enable auto-gc mode\" }},
          ] }},

        {{ name: \"grep\", desc: \"print lines matching a pattern\",
          flags: [
              {{ long: \"cached\", desc: \"search in index instead of the work tree\" }},
              {{ long: \"no-index\", desc: \"find in contents not managed by git\" }},
              {{ long: \"invert-match\", short: \"v\", desc: \"show non-matching lines\" }},
              {{ long: \"ignore-case\", short: \"i\", desc: \"case insensitive matching\" }},
              {{ long: \"word-regexp\", short: \"w\", desc: \"match at word boundaries only\" }},
              {{ long: \"extended-regexp\", short: \"E\", desc: \"use extended POSIX regexps\" }},
              {{ long: \"fixed-strings\", short: \"F\", desc: \"interpret patterns as fixed strings\" }},
              {{ long: \"line-number\", short: \"n\", desc: \"show line numbers\" }},
              {{ short: \"h\", desc: \"don't show filenames\" }},
              {{ short: \"H\", desc: \"show filenames\" }},
              {{ long: \"full-name\", desc: \"show filenames relative to top directory\" }},
              {{ long: \"files-with-matches\", short: \"l\", desc: \"show only filenames\" }},
              {{ long: \"only-matching\", short: \"o\", desc: \"show only matching parts of a line\" }},
              {{ long: \"count\", short: \"c\", desc: \"show the number of matches\" }},
              {{ long: \"context\", short: \"C\", desc: \"show <n> lines around matches\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"before-context\", short: \"B\", desc: \"show <n> lines before matches\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"after-context\", short: \"A\", desc: \"show <n> lines after matches\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"show-function\", short: \"p\", desc: \"show the function name before matches\" }},
              {{ short: \"f\", desc: \"read patterns from file\",
                arg: {{ kind: \"path\" }} }},
              {{ short: \"e\", desc: \"match <pattern>\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"quiet\", short: \"q\", desc: \"indicate hit with exit status only\" }},
              {{ long: \"all-match\", desc: \"only files that match all patterns\" }},
              {{ long: \"max-count\", short: \"m\", desc: \"maximum number of results per file\",
                arg: {{ kind: \"none\" }} }},
          ],
          args: [ {{ kind: \"none\" }}, {{ kind: \"path\", repeat: true }} ],
          after_dashdash: {{ kind: \"path\", repeat: true }} }},

        {{ name: \"init\", desc: \"create an empty Git repository\",
          flags: [
              {{ long: \"bare\", desc: \"create a bare repository\" }},
              {{ long: \"quiet\", short: \"q\", desc: \"be quiet\" }},
              {{ long: \"initial-branch\", short: \"b\", desc: \"the name of the initial branch\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"object-format\", desc: \"the hash algorithm to use\",
                arg: {{ kind: \"values\", values: [\"sha1\", \"sha256\"] }} }},
          ],
          args: [ {{ kind: \"dir\" }} ] }},

        {{ name: \"log\", desc: \"show commit logs\",
          flags: [
              {{ long: \"quiet\", short: \"q\", desc: \"suppress diff output\" }},
              {{ long: \"decorate\", desc: \"print ref names of shown commits\",
                arg: {{ kind: \"values\", values: [\"short\", \"full\", \"auto\", \"no\"] }},
                arg_optional: true }},
              {{ short: \"L\", desc: \"trace a line range or function in a file\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"oneline\", desc: \"one line per commit\" }},
              {{ long: \"graph\", desc: \"draw the history graph\" }},
              {{ long: \"pretty\", desc: \"pretty-print commits in a format\",
                arg: {{ kind: \"values\", values: [\"oneline\", \"short\", \"medium\", \"full\",
                                                \"fuller\", \"reference\", \"email\",
                                                \"raw\"] }},
                arg_optional: true }},
              {{ long: \"format\", desc: \"pretty-print commits in a format\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"abbrev-commit\", desc: \"abbreviate commit object names\" }},
              {{ long: \"date\", desc: \"how dates are shown\",
                arg: {{ kind: \"values\", values: [\"relative\", \"local\", \"iso\", \"iso-strict\",
                                                \"rfc\", \"short\", \"raw\", \"human\",
                                                \"unix\", \"default\"] }} }},
              {{ long: \"relative-date\", desc: \"show dates relative to now\" }},
              {{ long: \"max-count\", short: \"n\", desc: \"limit the number of commits\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"skip\", desc: \"skip <n> commits\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"since\", desc: \"commits newer than a date\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"until\", desc: \"commits older than a date\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"author\", desc: \"commits by an author matching <pattern>\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"committer\", desc: \"commits by a committer matching <pattern>\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"grep\", desc: \"commits whose message matches <pattern>\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"merges\", desc: \"only merge commits\" }},
              {{ long: \"no-merges\", desc: \"no merge commits\" }},
              {{ long: \"first-parent\", desc: \"follow only the first parent\" }},
              {{ long: \"all\", desc: \"every ref, as if listed on the command line\" }},
              {{ long: \"reverse\", desc: \"output commits in reverse order\" }},
              {{ long: \"topo-order\", desc: \"no parent before all its children\" }},
              {{ long: \"follow\", desc: \"continue listing a file across renames\" }},
              {{ long: \"patch\", short: \"p\", desc: \"generate patch\" }},
              {{ long: \"stat\", desc: \"generate a diffstat\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"name-only\", desc: \"show only names of changed files\" }},
              {{ long: \"name-status\", desc: \"show names and status of changed files\" }},
              {{ long: \"color\", desc: \"show colored output\",
                arg: {{ kind: \"values\", values: [\"always\", \"never\", \"auto\"] }},
                arg_optional: true }},
              {{ short: \"S\", desc: \"commits adding or removing the string\",
                arg: {{ kind: \"none\" }} }},
              {{ short: \"G\", desc: \"commits whose diff matches the regex\",
                arg: {{ kind: \"none\" }} }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\" }},
                  {{ kind: \"path\", repeat: true }} ],
          after_dashdash: {{ kind: \"path\", repeat: true }} }},

        {{ name: \"maintenance\", desc: \"run tasks to optimize repository data\",
          subcommands: [
              {{ name: \"run\", desc: \"run one or more maintenance tasks\",
                flags: [
                    {{ long: \"auto\", desc: \"run tasks based on repository state\" }},
                    {{ long: \"detach\", desc: \"perform maintenance in the background\" }},
                    {{ long: \"schedule\", desc: \"run tasks based on frequency\",
                      arg: {{ kind: \"values\", values: [\"hourly\", \"daily\", \"weekly\"] }} }},
                    {{ long: \"quiet\", desc: \"do not report progress on stderr\" }},
                    {{ long: \"task\", desc: \"run a specific task\",
                      arg: {{ kind: \"values\", values: [
                          \"commit-graph\", \"prefetch\", \"gc\", \"loose-objects\",
                          \"incremental-repack\", \"pack-refs\", \"reflog-expire\",
                          \"rerere-gc\", \"worktree-prune\",
                      ] }} }},
                ] }},
              {{ name: \"start\", desc: \"register and schedule background runs\",
                flags: [
                    {{ long: \"scheduler\", desc: \"the scheduler to trigger runs\",
                      arg: {{ kind: \"values\", values: [\"auto\", \"crontab\",
                                                      \"systemd-timer\",
                                                      \"launchctl\", \"schtasks\"] }} }},
                ] }},
              {{ name: \"stop\", desc: \"halt the background maintenance schedule\" }},
              {{ name: \"register\", desc: \"add this repository to maintenance\",
                flags: [
                    {{ long: \"config-file\", desc: \"use given config file\",
                      arg: {{ kind: \"path\" }} }},
                ] }},
              {{ name: \"unregister\", desc: \"remove this repository from maintenance\",
                flags: [
                    {{ long: \"config-file\", desc: \"use given config file\",
                      arg: {{ kind: \"path\" }} }},
                    {{ long: \"force\", short: \"f\", desc: \"succeed even if not registered\" }},
                ] }},
          ] }},

        {{ name: \"merge\", desc: \"join two or more development histories\",
          flags: [
              {{ short: \"n\", desc: \"do not show a diffstat at the end\" }},
              {{ long: \"stat\", desc: \"show a diffstat at the end of the merge\" }},
              {{ long: \"log\", desc: \"add shortlog entries to the message\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"squash\", desc: \"create a single commit, not a merge\" }},
              {{ long: \"commit\", desc: \"commit if the merge succeeds (default)\" }},
              {{ long: \"no-commit\", desc: \"stop before committing the merge\" }},
              {{ long: \"edit\", short: \"e\", desc: \"edit message before committing\" }},
              {{ long: \"no-edit\", desc: \"accept the auto-generated message\" }},
              {{ long: \"ff\", desc: \"allow fast-forward (default)\" }},
              {{ long: \"no-ff\", desc: \"always create a merge commit\" }},
              {{ long: \"ff-only\", desc: \"abort if fast-forward is not possible\" }},
              {{ long: \"strategy\", short: \"s\", desc: \"merge strategy to use\",
                arg: {{ kind: \"values\", values: [\"ort\", \"recursive\", \"resolve\",
                                                \"octopus\", \"ours\", \"subtree\"] }} }},
              {{ long: \"strategy-option\", short: \"X\", desc: \"option for the strategy\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"message\", short: \"m\", desc: \"merge commit message\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"file\", short: \"F\", desc: \"read message from file\",
                arg: {{ kind: \"path\" }} }},
              {{ long: \"verbose\", short: \"v\", desc: \"be more verbose\" }},
              {{ long: \"quiet\", short: \"q\", desc: \"be more quiet\" }},
              {{ long: \"abort\", desc: \"abort the current in-progress merge\" }},
              {{ long: \"continue\", desc: \"continue the current in-progress merge\" }},
              {{ long: \"allow-unrelated-histories\", desc: \"allow merging unrelated histories\" }},
              {{ long: \"gpg-sign\", short: \"S\", desc: \"GPG sign commit\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"autostash\", desc: \"stash before and pop after\" }},
              {{ long: \"signoff\", desc: \"add a Signed-off-by trailer\" }},
              {{ long: \"no-verify\", desc: \"bypass pre-merge-commit, commit-msg hooks\" }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\", repeat: true }} ] }},

        {{ name: \"mv\", desc: \"move or rename a file, directory, or symlink\",
          flags: [
              {{ long: \"verbose\", short: \"v\", desc: \"be verbose\" }},
              {{ long: \"dry-run\", short: \"n\", desc: \"dry run\" }},
              {{ long: \"force\", short: \"f\", desc: \"move/rename even if target exists\" }},
              {{ short: \"k\", desc: \"skip move/rename errors\" }},
              {{ long: \"sparse\", desc: \"allow updating outside the sparse cone\" }},
          ],
          args: [ {{ kind: \"path\", repeat: true }} ],
          after_dashdash: {{ kind: \"path\", repeat: true }} }},

        {{ name: \"notes\", desc: \"add or inspect object notes\",
          flags: [
              {{ long: \"ref\", desc: \"use notes from <notes-ref>\",
                arg: {{ kind: \"none\" }} }},
          ],
          subcommands: [
              {{ name: \"list\", desc: \"list the notes, or an object's note\",
                args: [ {{ kind: \"generator\", generator: \"branches\" }} ] }},
              {{ name: \"add\", desc: \"add notes for an object\",
                flags: [
                    {{ long: \"message\", short: \"m\", desc: \"note contents as a string\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"file\", short: \"F\", desc: \"note contents in a file\",
                      arg: {{ kind: \"path\" }} }},
                    {{ long: \"reedit-message\", short: \"c\",
                      desc: \"reuse and edit specified note object\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"reuse-message\", short: \"C\",
                      desc: \"reuse specified note object\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"edit\", short: \"e\", desc: \"edit note message in editor\" }},
                    {{ long: \"allow-empty\", desc: \"allow storing empty note\" }},
                    {{ long: \"force\", short: \"f\", desc: \"replace existing notes\" }},
                ],
                args: [ {{ kind: \"generator\", generator: \"branches\" }} ] }},
              {{ name: \"copy\", desc: \"copy the notes of one object to another\",
                flags: [
                    {{ short: \"f\", desc: \"overwrite existing notes\" }},
                ],
                args: [ {{ kind: \"generator\", generator: \"branches\" }},
                        {{ kind: \"generator\", generator: \"branches\" }} ] }},
              {{ name: \"append\", desc: \"append to the notes of an object\",
                flags: [
                    {{ short: \"m\", desc: \"note contents as a string\",
                      arg: {{ kind: \"none\" }} }},
                    {{ short: \"F\", desc: \"note contents in a file\",
                      arg: {{ kind: \"path\" }} }},
                    {{ short: \"e\", desc: \"edit note message in editor\" }},
                    {{ long: \"allow-empty\", desc: \"allow storing empty note\" }},
                ],
                args: [ {{ kind: \"generator\", generator: \"branches\" }} ] }},
              {{ name: \"edit\", desc: \"edit the notes for an object\",
                flags: [
                    {{ long: \"allow-empty\", desc: \"allow storing empty note\" }},
                ],
                args: [ {{ kind: \"generator\", generator: \"branches\" }} ] }},
              {{ name: \"show\", desc: \"show the notes for an object\",
                args: [ {{ kind: \"generator\", generator: \"branches\" }} ] }},
              {{ name: \"merge\", desc: \"merge a notes ref into the current one\",
                flags: [
                    {{ long: \"verbose\", short: \"v\", desc: \"be more verbose\" }},
                    {{ long: \"quiet\", short: \"q\", desc: \"be more quiet\" }},
                    {{ long: \"strategy\", short: \"s\", desc: \"resolve conflicts this way\",
                      arg: {{ kind: \"values\", values: [\"manual\", \"ours\", \"theirs\",
                                                      \"union\", \"cat_sort_uniq\"] }} }},
                    {{ long: \"commit\", desc: \"finalize an in-progress notes merge\" }},
                    {{ long: \"abort\", desc: \"abort an in-progress notes merge\" }},
                ],
                args: [ {{ kind: \"none\" }} ] }},
              {{ name: \"remove\", desc: \"remove the notes for objects\",
                flags: [
                    {{ long: \"ignore-missing\", desc: \"a missing note is not an error\" }},
                    {{ long: \"stdin\", desc: \"read object names from standard input\" }},
                ],
                args: [ {{ kind: \"generator\", generator: \"branches\", repeat: true }} ] }},
              {{ name: \"prune\", desc: \"remove notes for missing objects\",
                flags: [
                    {{ short: \"n\", desc: \"do not remove, show only\" }},
                    {{ short: \"v\", desc: \"report pruned notes\" }},
                ] }},
              {{ name: \"get-ref\", desc: \"print the current notes ref\" }},
          ] }},

        {{ name: \"pull\", desc: \"fetch from and integrate with another branch\",
          flags: [
              {{ long: \"verbose\", short: \"v\", desc: \"be more verbose\" }},
              {{ long: \"quiet\", short: \"q\", desc: \"be more quiet\" }},
              {{ long: \"rebase\", short: \"r\", desc: \"rebase rather than merge\",
                arg: {{ kind: \"values\", values: [\"false\", \"true\", \"merges\",
                                                \"interactive\"] }},
                arg_optional: true }},
              {{ long: \"no-rebase\", desc: \"merge rather than rebase\" }},
              {{ long: \"squash\", desc: \"create a single commit, not a merge\" }},
              {{ long: \"no-edit\", desc: \"accept the auto-generated message\" }},
              {{ long: \"no-ff\", desc: \"always create a merge commit\" }},
              {{ long: \"ff-only\", desc: \"abort if fast-forward is not possible\" }},
              {{ long: \"autostash\", desc: \"stash before and pop after\" }},
              {{ long: \"all\", desc: \"fetch from all remotes\" }},
              {{ long: \"tags\", short: \"t\", desc: \"fetch all tags and associated objects\" }},
              {{ long: \"prune\", short: \"p\", desc: \"prune remote-tracking branches\" }},
              {{ long: \"depth\", desc: \"deepen history of shallow clone\",
                arg: {{ kind: \"none\" }} }},
          ],
          args: [ {{ kind: \"generator\", generator: \"remotes\" }},
                  {{ kind: \"generator\", generator: \"branches\", repeat: true }} ] }},

        {{ name: \"push\", desc: \"update remote refs and associated objects\",
          flags: [
              {{ long: \"verbose\", short: \"v\", desc: \"be more verbose\" }},
              {{ long: \"quiet\", short: \"q\", desc: \"be more quiet\" }},
              {{ long: \"all\", desc: \"push all branches\" }},
              {{ long: \"mirror\", desc: \"mirror all refs\" }},
              {{ long: \"delete\", short: \"d\", desc: \"delete refs\" }},
              {{ long: \"tags\", desc: \"push tags\" }},
              {{ long: \"dry-run\", short: \"n\", desc: \"dry run\" }},
              {{ long: \"force\", short: \"f\", desc: \"force updates\" }},
              {{ long: \"force-with-lease\", desc: \"force only if the ref is as expected\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"set-upstream\", short: \"u\", desc: \"set upstream for git pull/status\" }},
              {{ long: \"prune\", desc: \"prune locally removed refs\" }},
              {{ long: \"no-verify\", desc: \"bypass pre-push hook\" }},
              {{ long: \"follow-tags\", desc: \"push missing but relevant tags\" }},
              {{ long: \"push-option\", short: \"o\", desc: \"option to transmit\",
                arg: {{ kind: \"none\" }} }},
          ],
          args: [ {{ kind: \"generator\", generator: \"remotes\" }},
                  {{ kind: \"generator\", generator: \"branches\", repeat: true }} ] }},

        {{ name: \"range-diff\", desc: \"compare two commit ranges\",
          flags: [
              {{ long: \"creation-factor\", desc: \"percentage weighting creation\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"left-only\", desc: \"only output for the first range\" }},
              {{ long: \"right-only\", desc: \"only output for the second range\" }},
              {{ long: \"no-patch\", short: \"s\", desc: \"suppress diff output\" }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\", repeat: true }} ] }},

        {{ name: \"rebase\", desc: \"reapply commits on top of another base tip\",
          flags: [
              {{ long: \"onto\", desc: \"rebase onto given branch, not upstream\",
                arg: {{ kind: \"generator\", generator: \"branches\" }} }},
              {{ long: \"keep-base\", desc: \"use the merge-base as the current base\" }},
              {{ long: \"quiet\", short: \"q\", desc: \"be quiet. implies --no-stat\" }},
              {{ long: \"signoff\", desc: \"add a Signed-off-by trailer to each commit\" }},
              {{ long: \"continue\", desc: \"continue\" }},
              {{ long: \"skip\", desc: \"skip current patch and continue\" }},
              {{ long: \"abort\", desc: \"abort and check out the original branch\" }},
              {{ long: \"edit-todo\", desc: \"edit the todo list of a rebase\" }},
              {{ long: \"merge\", short: \"m\", desc: \"use merging strategies to rebase\" }},
              {{ long: \"interactive\", short: \"i\", desc: \"edit the list of commits to rebase\" }},
              {{ long: \"autosquash\", desc: \"move squash!/fixup! commits under -i\" }},
              {{ long: \"update-refs\", desc: \"update branches pointing at rebased commits\" }},
              {{ long: \"gpg-sign\", short: \"S\", desc: \"GPG-sign commits\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"autostash\", desc: \"stash before and pop after\" }},
              {{ long: \"exec\", short: \"x\", desc: \"add exec lines after each commit\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"rebase-merges\", short: \"r\", desc: \"rebase merges, don't skip them\",
                arg: {{ kind: \"values\", values: [\"rebase-cousins\", \"no-rebase-cousins\"] }},
                arg_optional: true }},
              {{ long: \"strategy-option\", short: \"X\", desc: \"pass through to the strategy\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"root\", desc: \"rebase all reachable commits to the root\" }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\" }},
                  {{ kind: \"generator\", generator: \"branches\" }} ] }},

        {{ name: \"reset\", desc: \"reset current HEAD to the specified state\",
          flags: [
              {{ long: \"quiet\", short: \"q\", desc: \"be quiet, only report errors\" }},
              {{ long: \"mixed\", desc: \"reset HEAD and index\" }},
              {{ long: \"soft\", desc: \"reset only HEAD\" }},
              {{ long: \"hard\", desc: \"reset HEAD, index and working tree\" }},
              {{ long: \"patch\", short: \"p\", desc: \"select hunks interactively\" }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\" }},
                  {{ kind: \"path\", repeat: true }} ],
          after_dashdash: {{ kind: \"path\", repeat: true }} }},

        {{ name: \"restore\", desc: \"restore working tree files\",
          flags: [
              {{ long: \"source\", short: \"s\", desc: \"which tree-ish to checkout from\",
                arg: {{ kind: \"generator\", generator: \"branches\" }} }},
              {{ long: \"staged\", short: \"S\", desc: \"restore the index\" }},
              {{ long: \"worktree\", short: \"W\", desc: \"restore the working tree (default)\" }},
              {{ long: \"quiet\", short: \"q\", desc: \"suppress progress reporting\" }},
              {{ long: \"merge\", short: \"m\", desc: \"recreate the conflicted merge\" }},
              {{ long: \"ours\", short: \"2\", desc: \"our version for unmerged files\" }},
              {{ long: \"theirs\", short: \"3\", desc: \"their version for unmerged files\" }},
              {{ long: \"patch\", short: \"p\", desc: \"select hunks interactively\" }},
          ],
          args: [ {{ kind: \"path\", repeat: true }} ],
          after_dashdash: {{ kind: \"path\", repeat: true }} }},

        {{ name: \"revert\", desc: \"revert some existing commits\",
          flags: [
              {{ long: \"continue\", desc: \"resume the revert sequence\" }},
              {{ long: \"abort\", desc: \"cancel the revert sequence\" }},
              {{ long: \"skip\", desc: \"skip current commit and continue\" }},
              {{ long: \"no-commit\", short: \"n\", desc: \"don't automatically commit\" }},
              {{ long: \"no-edit\", desc: \"do not edit the commit message\" }},
              {{ long: \"signoff\", short: \"s\", desc: \"add a Signed-off-by trailer\" }},
              {{ long: \"mainline\", short: \"m\", desc: \"select mainline parent\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"strategy-option\", short: \"X\", desc: \"option for merge strategy\",
                arg: {{ kind: \"none\" }} }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\", repeat: true }} ] }},

        {{ name: \"rm\", desc: \"remove files from the working tree and index\",
          flags: [
              {{ long: \"dry-run\", short: \"n\", desc: \"dry run\" }},
              {{ long: \"quiet\", short: \"q\", desc: \"do not list removed files\" }},
              {{ long: \"cached\", desc: \"only remove from the index\" }},
              {{ long: \"force\", short: \"f\", desc: \"override the up-to-date check\" }},
              {{ short: \"r\", desc: \"allow recursive removal\" }},
              {{ long: \"ignore-unmatch\", desc: \"exit zero even if nothing matched\" }},
          ],
          args: [ {{ kind: \"path\", repeat: true }} ],
          after_dashdash: {{ kind: \"path\", repeat: true }} }},

        {{ name: \"shortlog\", desc: \"summarize 'git log' output\",
          flags: [
              {{ long: \"committer\", short: \"c\", desc: \"group by committer, not author\" }},
              {{ long: \"numbered\", short: \"n\", desc: \"sort by number of commits\" }},
              {{ long: \"summary\", short: \"s\", desc: \"only provide commit counts\" }},
              {{ long: \"email\", short: \"e\", desc: \"show each author's email address\" }},
              {{ long: \"group\", desc: \"group by field\",
                arg: {{ kind: \"values\", values: [\"author\", \"committer\", \"trailer:\"] }} }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\" }} ],
          after_dashdash: {{ kind: \"path\", repeat: true }} }},

        {{ name: \"show\", desc: \"show various types of objects\",
          flags: [
              {{ long: \"quiet\", short: \"q\", desc: \"suppress diff output\" }},
              {{ long: \"oneline\", desc: \"one line per commit\" }},
              {{ long: \"pretty\", desc: \"pretty-print commits in a format\",
                arg: {{ kind: \"values\", values: [\"oneline\", \"short\", \"medium\", \"full\",
                                                \"fuller\", \"reference\", \"email\",
                                                \"raw\"] }},
                arg_optional: true }},
              {{ long: \"format\", desc: \"pretty-print commits in a format\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"stat\", desc: \"generate a diffstat\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"name-only\", desc: \"show only names of changed files\" }},
              {{ long: \"name-status\", desc: \"show names and status of changed files\" }},
              {{ long: \"no-patch\", short: \"s\", desc: \"suppress diff output\" }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\", repeat: true }} ] }},

        {{ name: \"sparse-checkout\", desc: \"reduce the working tree to a subset\",
          subcommands: [
              {{ name: \"init\", desc: \"enable sparse-checkout (deprecated)\",
                flags: [
                    {{ long: \"cone\", desc: \"use cone mode\" }},
                    {{ long: \"sparse-index\", desc: \"use a sparse index\" }},
                ] }},
              {{ name: \"list\", desc: \"list the sparse-checkout directories\" }},
              {{ name: \"set\", desc: \"enable and set the sparse-checkout patterns\",
                flags: [
                    {{ long: \"cone\", desc: \"use cone mode\" }},
                    {{ long: \"no-cone\", desc: \"use full gitignore-style patterns\" }},
                    {{ long: \"sparse-index\", desc: \"use a sparse index\" }},
                    {{ long: \"skip-checks\", desc: \"skip sanity checks on the paths\" }},
                    {{ long: \"stdin\", desc: \"read patterns from standard in\" }},
                ],
                args: [ {{ kind: \"dir\", repeat: true }} ] }},
              {{ name: \"add\", desc: \"add patterns to the sparse-checkout\",
                flags: [
                    {{ long: \"skip-checks\", desc: \"skip sanity checks on the paths\" }},
                    {{ long: \"stdin\", desc: \"read patterns from standard in\" }},
                ],
                args: [ {{ kind: \"dir\", repeat: true }} ] }},
              {{ name: \"reapply\", desc: \"reapply the patterns to the working tree\" }},
              {{ name: \"disable\", desc: \"disable sparse-checkout, restore all files\" }},
              {{ name: \"check-rules\", desc: \"check paths against the sparsity rules\" }},
          ] }},

        {{ name: \"stash\", desc: \"stash away changes in a dirty working tree\",
          subcommands: [
              {{ name: \"push\", desc: \"save local changes to a new stash entry\",
                flags: [
                    {{ long: \"patch\", short: \"p\", desc: \"stash in patch mode\" }},
                    {{ long: \"staged\", short: \"S\", desc: \"stash staged changes only\" }},
                    {{ long: \"keep-index\", short: \"k\", desc: \"keep index\" }},
                    {{ long: \"quiet\", short: \"q\", desc: \"quiet mode\" }},
                    {{ long: \"include-untracked\", short: \"u\",
                      desc: \"include untracked files in stash\" }},
                    {{ long: \"all\", short: \"a\", desc: \"include ignored files\" }},
                    {{ long: \"message\", short: \"m\", desc: \"stash message\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"pathspec-from-file\", desc: \"read pathspec from file\",
                      arg: {{ kind: \"path\" }} }},
                    {{ long: \"pathspec-file-nul\", desc: \"pathspec file is NUL-separated\" }},
                ],
                args: [ {{ kind: \"path\", repeat: true }} ],
                after_dashdash: {{ kind: \"path\", repeat: true }} }},
              {{ name: \"save\", desc: \"save local changes (deprecated for push)\",
                flags: [
                    {{ long: \"patch\", short: \"p\", desc: \"stash in patch mode\" }},
                    {{ long: \"staged\", short: \"S\", desc: \"stash staged changes only\" }},
                    {{ long: \"keep-index\", short: \"k\", desc: \"keep index\" }},
                    {{ long: \"quiet\", short: \"q\", desc: \"quiet mode\" }},
                    {{ long: \"include-untracked\", short: \"u\",
                      desc: \"include untracked files in stash\" }},
                    {{ long: \"all\", short: \"a\", desc: \"include ignored files\" }},
                ],
                args: [ {{ kind: \"none\" }} ] }},
              {{ name: \"list\", desc: \"list the stash entries\" }},
              {{ name: \"show\", desc: \"show the changes in a stash entry\",
                flags: [
                    {{ long: \"include-untracked\", short: \"u\", desc: \"show untracked files too\" }},
                    {{ long: \"only-untracked\", desc: \"show only untracked files\" }},
                    {{ long: \"patch\", short: \"p\", desc: \"show the full diff\" }},
                    {{ long: \"stat\", desc: \"show a diffstat\" }},
                ],
                args: [ {{ kind: \"none\" }} ] }},
              {{ name: \"drop\", desc: \"remove a stash entry\",
                flags: [
                    {{ long: \"quiet\", short: \"q\", desc: \"quiet mode\" }},
                ],
                args: [ {{ kind: \"none\" }} ] }},
              {{ name: \"pop\", desc: \"apply a stash entry and remove it\",
                flags: [
                    {{ long: \"index\", desc: \"restore the index too\" }},
                    {{ long: \"quiet\", short: \"q\", desc: \"quiet mode\" }},
                ],
                args: [ {{ kind: \"none\" }} ] }},
              {{ name: \"apply\", desc: \"apply a stash entry, keeping it\",
                flags: [
                    {{ long: \"index\", desc: \"restore the index too\" }},
                    {{ long: \"quiet\", short: \"q\", desc: \"quiet mode\" }},
                ],
                args: [ {{ kind: \"none\" }} ] }},
              {{ name: \"branch\", desc: \"create a branch from a stash entry\",
                args: [ {{ kind: \"none\" }}, {{ kind: \"none\" }} ] }},
              {{ name: \"clear\", desc: \"remove all the stash entries\" }},
              {{ name: \"create\", desc: \"create a stash commit, print its name\",
                args: [ {{ kind: \"none\" }} ] }},
              {{ name: \"store\", desc: \"store a stash commit in the stash reflog\",
                flags: [
                    {{ long: \"message\", short: \"m\", desc: \"stash message\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"quiet\", short: \"q\", desc: \"quiet mode\" }},
                ],
                args: [ {{ kind: \"none\" }} ] }},
          ] }},

        {{ name: \"status\", desc: \"show the working tree status\",
          flags: [
              {{ long: \"verbose\", short: \"v\", desc: \"be verbose\" }},
              {{ long: \"short\", short: \"s\", desc: \"show status concisely\" }},
              {{ long: \"branch\", short: \"b\", desc: \"show branch information\" }},
              {{ long: \"porcelain\", desc: \"machine-readable output\",
                arg: {{ kind: \"values\", values: [\"v1\", \"v2\"] }}, arg_optional: true }},
              {{ long: \"untracked-files\", short: \"u\", desc: \"show untracked files\",
                arg: {{ kind: \"values\", values: [\"all\", \"normal\", \"no\"] }},
                arg_optional: true }},
              {{ long: \"ignored\", desc: \"show ignored files\",
                arg: {{ kind: \"values\", values: [\"traditional\", \"matching\", \"no\"] }},
                arg_optional: true }},
              {{ long: \"no-renames\", desc: \"do not detect renames\" }},
          ],
          args: [ {{ kind: \"path\", repeat: true }} ],
          after_dashdash: {{ kind: \"path\", repeat: true }} }},

        {{ name: \"submodule\", desc: \"initialize, update or inspect submodules\",
          flags: [
              {{ long: \"quiet\", desc: \"only print error messages\" }},
              {{ long: \"cached\", desc: \"use the commit in the index\" }},
          ],
          subcommands: [
              {{ name: \"add\", desc: \"add a repository as a submodule\",
                flags: [
                    {{ short: \"b\", desc: \"the branch to track\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"force\", short: \"f\", desc: \"add even if ignored\" }},
                    {{ long: \"name\", desc: \"the submodule's name\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"reference\", desc: \"reference repository\",
                      arg: {{ kind: \"dir\" }} }},
                ],
                args: [ {{ kind: \"none\" }}, {{ kind: \"dir\" }} ],
                after_dashdash: {{ kind: \"none\" }} }},
              {{ name: \"status\", desc: \"show the status of the submodules\",
                flags: [
                    {{ long: \"cached\", desc: \"use the commit in the index\" }},
                    {{ long: \"recursive\", desc: \"recurse into nested submodules\" }},
                ],
                args: [ {{ kind: \"path\", repeat: true }} ],
                after_dashdash: {{ kind: \"path\", repeat: true }} }},
              {{ name: \"init\", desc: \"initialize the submodules in .gitmodules\",
                args: [ {{ kind: \"path\", repeat: true }} ],
                after_dashdash: {{ kind: \"path\", repeat: true }} }},
              {{ name: \"deinit\", desc: \"unregister the given submodules\",
                flags: [
                    {{ long: \"force\", short: \"f\", desc: \"remove even with local changes\" }},
                    {{ long: \"all\", desc: \"unregister all submodules\" }},
                ],
                args: [ {{ kind: \"path\", repeat: true }} ],
                after_dashdash: {{ kind: \"path\", repeat: true }} }},
              {{ name: \"update\", desc: \"update the registered submodules\",
                flags: [
                    {{ long: \"init\", desc: \"initialize uninitialized submodules\" }},
                    {{ long: \"filter\", desc: \"partial clone filter\",
                      arg: {{ kind: \"none\" }}, arg_optional: true }},
                    {{ long: \"remote\", desc: \"use the remote-tracking branch\" }},
                    {{ long: \"no-fetch\", short: \"N\", desc: \"don't fetch new objects\" }},
                    {{ long: \"force\", short: \"f\", desc: \"force checkout\" }},
                    {{ long: \"checkout\", desc: \"check out the commit (default)\" }},
                    {{ long: \"merge\", desc: \"merge the commit into the current branch\" }},
                    {{ long: \"rebase\", desc: \"rebase the current branch onto it\" }},
                    {{ long: \"recommend-shallow\", desc: \"follow shallow recommendation\" }},
                    {{ long: \"reference\", desc: \"reference repository\",
                      arg: {{ kind: \"dir\" }} }},
                    {{ long: \"recursive\", desc: \"recurse into nested submodules\" }},
                    {{ long: \"single-branch\", desc: \"clone only one branch\" }},
                ],
                args: [ {{ kind: \"path\", repeat: true }} ],
                after_dashdash: {{ kind: \"path\", repeat: true }} }},
              {{ name: \"set-branch\", desc: \"set the tracked branch of a submodule\",
                flags: [
                    {{ long: \"default\", short: \"d\", desc: \"track the default branch\" }},
                    {{ long: \"branch\", short: \"b\", desc: \"the branch to track\",
                      arg: {{ kind: \"none\" }} }},
                ],
                args: [ {{ kind: \"path\" }} ],
                after_dashdash: {{ kind: \"path\" }} }},
              {{ name: \"set-url\", desc: \"set the URL of a submodule\",
                args: [ {{ kind: \"path\" }}, {{ kind: \"none\" }} ] }},
              {{ name: \"summary\", desc: \"summarize the submodule commits\",
                flags: [
                    {{ long: \"cached\", desc: \"use the commit in the index\" }},
                    {{ long: \"files\", desc: \"compare with the working tree\" }},
                    {{ long: \"summary-limit\", desc: \"limit the summary size\",
                      arg: {{ kind: \"none\" }} }},
                ],
                args: [ {{ kind: \"generator\", generator: \"branches\" }},
                        {{ kind: \"path\", repeat: true }} ],
                after_dashdash: {{ kind: \"path\", repeat: true }} }},
              {{ name: \"foreach\", desc: \"run a command in each submodule\",
                flags: [
                    {{ long: \"recursive\", desc: \"recurse into nested submodules\" }},
                ],
                args: [ {{ kind: \"command\" }} ] }},
              {{ name: \"sync\", desc: \"sync the remote URL from .gitmodules\",
                flags: [
                    {{ long: \"recursive\", desc: \"recurse into nested submodules\" }},
                ],
                args: [ {{ kind: \"path\", repeat: true }} ],
                after_dashdash: {{ kind: \"path\", repeat: true }} }},
              {{ name: \"absorbgitdirs\", desc: \"move submodule git dirs into the parent\",
                args: [ {{ kind: \"path\", repeat: true }} ],
                after_dashdash: {{ kind: \"path\", repeat: true }} }},
          ] }},

        {{ name: \"switch\", desc: \"switch branches\",
          flags: [
              {{ long: \"create\", short: \"c\", desc: \"create and switch to a new branch\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"force-create\", short: \"C\", desc: \"create/reset and switch to a branch\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"guess\", desc: \"guess a remote branch\" }},
              {{ long: \"no-guess\", desc: \"do not guess a remote branch\" }},
              {{ long: \"discard-changes\", desc: \"throw away local modifications\" }},
              {{ long: \"quiet\", short: \"q\", desc: \"suppress progress reporting\" }},
              {{ long: \"recurse-submodules\", desc: \"update submodules too\" }},
              {{ long: \"merge\", short: \"m\", desc: \"3-way merge with the new branch\" }},
              {{ long: \"conflict\", desc: \"conflict style\",
                arg: {{ kind: \"values\", values: [\"merge\", \"diff3\", \"zdiff3\"] }} }},
              {{ long: \"detach\", short: \"d\", desc: \"detach HEAD at named commit\" }},
              {{ long: \"track\", short: \"t\", desc: \"set branch tracking configuration\",
                arg: {{ kind: \"values\", values: [\"direct\", \"inherit\"] }},
                arg_optional: true }},
              {{ long: \"force\", short: \"f\", desc: \"throw away local modifications\" }},
              {{ long: \"orphan\", desc: \"new unborn branch\",
                arg: {{ kind: \"none\" }} }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\" }} ] }},

        {{ name: \"tag\", desc: \"create, list, delete or verify tags\",
          flags: [
              {{ long: \"list\", short: \"l\", desc: \"list tag names\" }},
              {{ short: \"n\", desc: \"print <n> lines of each tag message\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"delete\", short: \"d\", desc: \"delete tags\" }},
              {{ long: \"verify\", short: \"v\", desc: \"verify tags\" }},
              {{ long: \"annotate\", short: \"a\", desc: \"annotated tag, needs a message\" }},
              {{ long: \"message\", short: \"m\", desc: \"tag message\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"file\", short: \"F\", desc: \"read message from file\",
                arg: {{ kind: \"path\" }} }},
              {{ long: \"edit\", short: \"e\", desc: \"force edit of tag message\" }},
              {{ long: \"sign\", short: \"s\", desc: \"annotated and GPG-signed tag\" }},
              {{ long: \"local-user\", short: \"u\", desc: \"use another key to sign the tag\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"force\", short: \"f\", desc: \"replace the tag if exists\" }},
              {{ long: \"contains\", desc: \"only tags that contain the commit\",
                arg: {{ kind: \"generator\", generator: \"branches\" }} }},
              {{ long: \"merged\", desc: \"only tags that are merged\",
                arg: {{ kind: \"generator\", generator: \"branches\" }} }},
              {{ long: \"sort\", desc: \"field name to sort on\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"points-at\", desc: \"only tags of the object\",
                arg: {{ kind: \"generator\", generator: \"branches\" }} }},
              {{ long: \"format\", desc: \"format to use for the output\",
                arg: {{ kind: \"none\" }} }},
          ],
          args: [ {{ kind: \"generator\", generator: \"tags\", repeat: true }} ] }},

        {{ name: \"worktree\", desc: \"manage multiple working trees\",
          subcommands: [
              {{ name: \"add\", desc: \"create a working tree\",
                flags: [
                    {{ long: \"force\", short: \"f\", desc: \"check out even if in another worktree\" }},
                    {{ short: \"b\", desc: \"create a new branch\",
                      arg: {{ kind: \"none\" }} }},
                    {{ short: \"B\", desc: \"create or reset a branch\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"orphan\", desc: \"create unborn branch\" }},
                    {{ long: \"detach\", short: \"d\", desc: \"detach HEAD at named commit\" }},
                    {{ long: \"checkout\", desc: \"populate the new working tree\" }},
                    {{ long: \"no-checkout\", desc: \"do not populate the working tree\" }},
                    {{ long: \"lock\", desc: \"keep the new working tree locked\" }},
                    {{ long: \"reason\", desc: \"reason for locking\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"quiet\", short: \"q\", desc: \"suppress progress reporting\" }},
                    {{ long: \"track\", desc: \"set up tracking mode\" }},
                    {{ long: \"guess-remote\", desc: \"match the name to a remote branch\" }},
                    {{ long: \"relative-paths\", desc: \"use relative paths for worktrees\" }},
                ],
                args: [ {{ kind: \"dir\" }},
                        {{ kind: \"generator\", generator: \"branches\" }} ] }},
              {{ name: \"list\", desc: \"list the working trees\",
                flags: [
                    {{ long: \"porcelain\", desc: \"machine-readable output\" }},
                    {{ long: \"verbose\", short: \"v\", desc: \"show extended annotations\" }},
                    {{ long: \"expire\", desc: \"mark worktrees older than <time> prunable\",
                      arg: {{ kind: \"none\" }} }},
                    {{ short: \"z\", desc: \"terminate records with a NUL character\" }},
                ] }},
              {{ name: \"lock\", desc: \"keep a working tree from being pruned\",
                flags: [
                    {{ long: \"reason\", desc: \"reason for locking\",
                      arg: {{ kind: \"none\" }} }},
                ],
                args: [ {{ kind: \"dir\" }} ] }},
              {{ name: \"move\", desc: \"move a working tree\",
                flags: [
                    {{ long: \"force\", short: \"f\", desc: \"move even if dirty or locked\" }},
                    {{ long: \"relative-paths\", desc: \"use relative paths for worktrees\" }},
                ],
                args: [ {{ kind: \"dir\" }}, {{ kind: \"dir\" }} ] }},
              {{ name: \"prune\", desc: \"prune stale working tree information\",
                flags: [
                    {{ long: \"dry-run\", short: \"n\", desc: \"do not remove, show only\" }},
                    {{ long: \"verbose\", short: \"v\", desc: \"report pruned working trees\" }},
                    {{ long: \"expire\", desc: \"expire working trees older than <time>\",
                      arg: {{ kind: \"none\" }} }},
                ] }},
              {{ name: \"remove\", desc: \"remove a working tree\",
                flags: [
                    {{ long: \"force\", short: \"f\", desc: \"remove even if dirty or locked\" }},
                ],
                args: [ {{ kind: \"dir\" }} ] }},
              {{ name: \"repair\", desc: \"repair working tree administrative files\",
                args: [ {{ kind: \"dir\", repeat: true }} ] }},
              {{ name: \"unlock\", desc: \"unlock a working tree\",
                args: [ {{ kind: \"dir\" }} ] }},
          ] }},

        # ---------------------------------------------------------------
        # Ancillary commands: manipulators
        # ---------------------------------------------------------------
        {{ name: \"config\", desc: \"get and set repository or global options\",
          subcommands: [
              {{ name: \"list\", desc: \"list all variables and their values\",
                flags: [
                    {{ long: \"global\", desc: \"use global config file\" }},
                    {{ long: \"system\", desc: \"use system config file\" }},
                    {{ long: \"local\", desc: \"use repository config file\" }},
                    {{ long: \"worktree\", desc: \"use per-worktree config file\" }},
                    {{ long: \"file\", short: \"f\", desc: \"use given config file\",
                      arg: {{ kind: \"path\" }} }},
                    {{ long: \"blob\", desc: \"read config from given blob object\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"null\", short: \"z\", desc: \"terminate values with NUL byte\" }},
                    {{ long: \"name-only\", desc: \"show variable names only\" }},
                    {{ long: \"show-origin\", desc: \"show origin of config\" }},
                    {{ long: \"show-scope\", desc: \"show scope of config\" }},
                    {{ long: \"includes\", desc: \"respect include directives\" }},
                ] }},
              {{ name: \"get\", desc: \"print the value of a variable\",
                flags: [
                    {{ long: \"global\", desc: \"use global config file\" }},
                    {{ long: \"system\", desc: \"use system config file\" }},
                    {{ long: \"local\", desc: \"use repository config file\" }},
                    {{ long: \"worktree\", desc: \"use per-worktree config file\" }},
                    {{ long: \"file\", short: \"f\", desc: \"use given config file\",
                      arg: {{ kind: \"path\" }} }},
                    {{ long: \"all\", desc: \"return all values of a multi-valued key\" }},
                    {{ long: \"regexp\", desc: \"interpret the name as a regex\" }},
                    {{ long: \"value\", desc: \"only values matching the pattern\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"fixed-value\", desc: \"compare values by string equality\" }},
                    {{ long: \"url\", desc: \"show config matching the given URL\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"null\", short: \"z\", desc: \"terminate values with NUL byte\" }},
                    {{ long: \"show-origin\", desc: \"show origin of config\" }},
                    {{ long: \"show-scope\", desc: \"show scope of config\" }},
                    {{ long: \"show-names\", desc: \"show config keys with their values\" }},
                    {{ long: \"type\", short: \"t\", desc: \"value is given this type\",
                      arg: {{ kind: \"values\", values: [\"bool\", \"int\", \"bool-or-int\",
                                                      \"path\", \"expiry-date\",
                                                      \"color\"] }} }},
                    {{ long: \"includes\", desc: \"respect include directives\" }},
                    {{ long: \"default\", desc: \"use this value when missing\",
                      arg: {{ kind: \"none\" }} }},
                ],
                args: [ {{ kind: \"none\" }} ] }},
              {{ name: \"set\", desc: \"set a variable\",
                flags: [
                    {{ long: \"global\", desc: \"use global config file\" }},
                    {{ long: \"system\", desc: \"use system config file\" }},
                    {{ long: \"local\", desc: \"use repository config file\" }},
                    {{ long: \"worktree\", desc: \"use per-worktree config file\" }},
                    {{ long: \"file\", short: \"f\", desc: \"use given config file\",
                      arg: {{ kind: \"path\" }} }},
                    {{ long: \"type\", short: \"t\", desc: \"value is given this type\",
                      arg: {{ kind: \"values\", values: [\"bool\", \"int\", \"bool-or-int\",
                                                      \"path\", \"expiry-date\",
                                                      \"color\"] }} }},
                    {{ long: \"all\", desc: \"replace every value of a multi-valued key\" }},
                    {{ long: \"value\", desc: \"only values matching the pattern\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"fixed-value\", desc: \"compare values by string equality\" }},
                    {{ long: \"comment\", desc: \"human-readable comment string\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"append\", desc: \"add a line, keeping existing values\" }},
                ],
                args: [ {{ kind: \"none\" }}, {{ kind: \"none\" }} ] }},
              {{ name: \"unset\", desc: \"unset a variable\",
                flags: [
                    {{ long: \"global\", desc: \"use global config file\" }},
                    {{ long: \"system\", desc: \"use system config file\" }},
                    {{ long: \"local\", desc: \"use repository config file\" }},
                    {{ long: \"worktree\", desc: \"use per-worktree config file\" }},
                    {{ long: \"file\", short: \"f\", desc: \"use given config file\",
                      arg: {{ kind: \"path\" }} }},
                    {{ long: \"all\", desc: \"unset every value of a multi-valued key\" }},
                    {{ long: \"value\", desc: \"only values matching the pattern\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"fixed-value\", desc: \"compare values by string equality\" }},
                ],
                args: [ {{ kind: \"none\" }} ] }},
              {{ name: \"rename-section\", desc: \"rename a section\",
                flags: [
                    {{ long: \"global\", desc: \"use global config file\" }},
                    {{ long: \"system\", desc: \"use system config file\" }},
                    {{ long: \"local\", desc: \"use repository config file\" }},
                    {{ long: \"file\", short: \"f\", desc: \"use given config file\",
                      arg: {{ kind: \"path\" }} }},
                ],
                args: [ {{ kind: \"none\" }}, {{ kind: \"none\" }} ] }},
              {{ name: \"remove-section\", desc: \"remove a section\",
                flags: [
                    {{ long: \"global\", desc: \"use global config file\" }},
                    {{ long: \"system\", desc: \"use system config file\" }},
                    {{ long: \"local\", desc: \"use repository config file\" }},
                    {{ long: \"file\", short: \"f\", desc: \"use given config file\",
                      arg: {{ kind: \"path\" }} }},
                ],
                args: [ {{ kind: \"none\" }} ] }},
              {{ name: \"edit\", desc: \"open the config file in an editor\",
                flags: [
                    {{ long: \"global\", desc: \"use global config file\" }},
                    {{ long: \"system\", desc: \"use system config file\" }},
                    {{ long: \"local\", desc: \"use repository config file\" }},
                    {{ long: \"worktree\", desc: \"use per-worktree config file\" }},
                    {{ long: \"file\", short: \"f\", desc: \"use given config file\",
                      arg: {{ kind: \"path\" }} }},
                ] }},
          ] }},

        {{ name: \"fast-export\", desc: \"git data exporter\",
          flags: [
              {{ long: \"progress\", desc: \"show progress after <n> objects\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"signed-tags\", desc: \"select handling of signed tags\",
                arg: {{ kind: \"values\", values: [\"verbatim\", \"warn-verbatim\", \"warn\",
                                                \"strip\", \"abort\"] }} }},
              {{ long: \"export-marks\", desc: \"dump marks to this file\",
                arg: {{ kind: \"path\" }} }},
              {{ long: \"import-marks\", desc: \"import marks from this file\",
                arg: {{ kind: \"path\" }} }},
              {{ long: \"no-data\", desc: \"skip output of blob data\" }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\", repeat: true }} ] }},

        # fast-import takes each option only as --name=value.
        {{ name: \"fast-import\", desc: \"backend for fast Git data importers\",
          flags: [
              {{ long: \"date-format\", desc: \"the date format of the stream\",
                arg: {{ kind: \"values\", values: [\"raw\", \"raw-permissive\", \"rfc2822\",
                                                \"now\"] }},
                arg_optional: true }},
              {{ long: \"max-pack-size\", desc: \"maximum size of each packfile\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"depth\", desc: \"maximum delta depth\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"export-marks\", desc: \"dump the marks table to this file\",
                arg: {{ kind: \"path\" }}, arg_optional: true }},
          ] }},

        {{ name: \"filter-branch\", desc: \"rewrite branches\",
          flags: [
              {{ long: \"subdirectory-filter\", desc: \"make a subdirectory the root\",
                arg: {{ kind: \"dir\" }} }},
              {{ long: \"env-filter\", desc: \"filter the commit environment\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"tree-filter\", desc: \"filter the checked-out tree\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"index-filter\", desc: \"filter the index\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"msg-filter\", desc: \"filter the commit messages\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"tag-name-filter\", desc: \"filter the tag names\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"force\", short: \"f\", desc: \"rewrite even if a backup exists\" }},
          ],
          after_dashdash: {{ kind: \"generator\", generator: \"branches\", repeat: true }} }},

        {{ name: \"mergetool\", desc: \"run merge conflict resolution tools\",
          flags: [
              {{ long: \"tool\", desc: \"use this merge tool\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ long: \"tool-help\", desc: \"list the merge tools that may be used\" }},
              {{ short: \"y\", desc: \"do not prompt before each file\" }},
              {{ long: \"no-prompt\", desc: \"do not prompt before each file\" }},
              {{ long: \"gui\", short: \"g\", desc: \"use merge.guitool\" }},
          ],
          args: [ {{ kind: \"path\", repeat: true }} ] }},

        {{ name: \"pack-refs\", desc: \"pack heads and tags for efficient access\",
          flags: [
              {{ long: \"all\", desc: \"pack everything\" }},
              {{ long: \"no-prune\", desc: \"keep loose refs\" }},
              {{ long: \"auto\", desc: \"auto-pack refs as needed\" }},
          ] }},

        {{ name: \"prune\", desc: \"prune unreachable objects from the database\",
          flags: [
              {{ long: \"dry-run\", short: \"n\", desc: \"do not remove, show only\" }},
              {{ long: \"verbose\", short: \"v\", desc: \"report pruned objects\" }},
              {{ long: \"progress\", desc: \"show progress\" }},
              {{ long: \"expire\", desc: \"expire objects older than <time>\",
                arg: {{ kind: \"none\" }} }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\", repeat: true }} ],
          after_dashdash: {{ kind: \"generator\", generator: \"branches\", repeat: true }} }},

        {{ name: \"reflog\", desc: \"manage reflog information\",
          subcommands: [
              {{ name: \"show\", desc: \"show the log of a reference\",
                args: [ {{ kind: \"generator\", generator: \"branches\" }} ] }},
              {{ name: \"list\", desc: \"list the references that have a reflog\" }},
              {{ name: \"expire\", desc: \"prune older reflog entries\",
                flags: [
                    {{ long: \"expire\", desc: \"prune entries older than this\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"expire-unreachable\", desc: \"prune unreachable older entries\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"rewrite\", desc: \"rewrite old SHA1 of following entry\" }},
                    {{ long: \"updateref\", desc: \"update ref to the top reflog entry\" }},
                    {{ long: \"stale-fix\", desc: \"prune entries of broken commits\" }},
                    {{ long: \"dry-run\", short: \"n\", desc: \"do not prune any entries\" }},
                    {{ long: \"verbose\", desc: \"print extra information\" }},
                    {{ long: \"all\", desc: \"process the reflogs of all references\" }},
                    {{ long: \"single-worktree\", desc: \"only this worktree's reflogs\" }},
                ],
                args: [ {{ kind: \"generator\", generator: \"branches\", repeat: true }} ] }},
              {{ name: \"delete\", desc: \"delete single entries from the reflog\",
                flags: [
                    {{ long: \"rewrite\", desc: \"rewrite old SHA1 of following entry\" }},
                    {{ long: \"updateref\", desc: \"update ref to the top reflog entry\" }},
                    {{ long: \"dry-run\", short: \"n\", desc: \"do not prune any entries\" }},
                    {{ long: \"verbose\", desc: \"print extra information\" }},
                ],
                args: [ {{ kind: \"none\", repeat: true }} ] }},
              {{ name: \"drop\", desc: \"delete the entire reflog of references\",
                flags: [
                    {{ long: \"all\", desc: \"drop the reflogs of all references\" }},
                    {{ long: \"single-worktree\", desc: \"only this worktree's reflogs\" }},
                ],
                args: [ {{ kind: \"generator\", generator: \"branches\", repeat: true }} ] }},
              {{ name: \"exists\", desc: \"check whether a ref has a reflog\",
                args: [ {{ kind: \"generator\", generator: \"branches\" }} ] }},
          ] }},

        {{ name: \"refs\", desc: \"low-level access to refs\",
          subcommands: [
              {{ name: \"migrate\", desc: \"migrate the ref store to another format\",
                flags: [
                    {{ long: \"ref-format\", desc: \"the reference format to convert to\",
                      arg: {{ kind: \"values\", values: [\"files\", \"reftable\"] }} }},
                    {{ long: \"dry-run\", desc: \"perform a non-destructive dry-run\" }},
                    {{ long: \"no-reflog\", desc: \"drop reflogs during the migration\" }},
                ] }},
              {{ name: \"verify\", desc: \"verify reference database consistency\",
                flags: [
                    {{ long: \"strict\", desc: \"enable strict checking\" }},
                    {{ long: \"verbose\", desc: \"be verbose\" }},
                ] }},
          ] }},

        {{ name: \"remote\", desc: \"manage the set of tracked repositories\",
          flags: [
              {{ long: \"verbose\", short: \"v\", desc: \"be verbose; before a subcommand\" }},
          ],
          subcommands: [
              {{ name: \"add\", desc: \"add a remote\",
                flags: [
                    {{ long: \"fetch\", short: \"f\", desc: \"fetch the remote branches\" }},
                    {{ long: \"tags\", desc: \"import all tags when fetching\" }},
                    {{ long: \"no-tags\", desc: \"do not import tags when fetching\" }},
                    {{ long: \"track\", short: \"t\", desc: \"branch(es) to track\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"master\", short: \"m\", desc: \"the remote's HEAD branch\",
                      arg: {{ kind: \"none\" }} }},
                    {{ long: \"mirror\", desc: \"set up the remote as a mirror\",
                      arg: {{ kind: \"values\", values: [\"push\", \"fetch\"] }},
                      arg_optional: true }},
                ],
                args: [ {{ kind: \"none\" }}, {{ kind: \"none\" }} ] }},
              {{ name: \"rename\", desc: \"rename a remote\",
                flags: [
                    {{ long: \"progress\", desc: \"force progress reporting\" }},
                ],
                args: [ {{ kind: \"generator\", generator: \"remotes\" }},
                        {{ kind: \"none\" }} ] }},
              {{ name: \"remove\", aliases: [\"rm\"], desc: \"remove a remote\",
                args: [ {{ kind: \"generator\", generator: \"remotes\" }} ] }},
              {{ name: \"set-head\", desc: \"set or delete a remote's default branch\",
                flags: [
                    {{ long: \"auto\", short: \"a\", desc: \"set it according to the remote\" }},
                    {{ long: \"delete\", short: \"d\", desc: \"delete refs/remotes/<name>/HEAD\" }},
                ],
                args: [ {{ kind: \"generator\", generator: \"remotes\" }},
                        {{ kind: \"generator\", generator: \"branches\" }} ] }},
              {{ name: \"show\", desc: \"show information about a remote\",
                flags: [
                    {{ short: \"n\", desc: \"do not query remotes\" }},
                ],
                args: [ {{ kind: \"generator\", generator: \"remotes\" }} ] }},
              {{ name: \"prune\", desc: \"delete stale remote-tracking branches\",
                flags: [
                    {{ long: \"dry-run\", short: \"n\", desc: \"dry run\" }},
                ],
                args: [ {{ kind: \"generator\", generator: \"remotes\" }} ] }},
              {{ name: \"update\", desc: \"fetch updates for remotes or groups\",
                flags: [
                    {{ long: \"prune\", short: \"p\", desc: \"prune remotes after fetching\" }},
                ],
                args: [ {{ kind: \"generator\", generator: \"remotes\", repeat: true }} ] }},
              {{ name: \"set-branches\", desc: \"change the branches a remote tracks\",
                flags: [
                    {{ long: \"add\", desc: \"add branch\" }},
                ],
                args: [ {{ kind: \"generator\", generator: \"remotes\" }},
                        {{ kind: \"none\", repeat: true }} ] }},
              {{ name: \"get-url\", desc: \"print the URLs of a remote\",
                flags: [
                    {{ long: \"push\", desc: \"query push URLs, not fetch URLs\" }},
                    {{ long: \"all\", desc: \"return all URLs\" }},
                ],
                args: [ {{ kind: \"generator\", generator: \"remotes\" }} ] }},
              {{ name: \"set-url\", desc: \"change the URLs of a remote\",
                flags: [
                    {{ long: \"push\", desc: \"manipulate push URLs\" }},
                    {{ long: \"add\", desc: \"add URL\" }},
                    {{ long: \"delete\", desc: \"delete URLs\" }},
                ],
                args: [ {{ kind: \"generator\", generator: \"remotes\" }},
                        {{ kind: \"none\" }}, {{ kind: \"none\" }} ] }},
          ] }},

        {{ name: \"repack\", desc: \"pack unpacked objects in a repository\",
          flags: [
              {{ short: \"a\", desc: \"pack everything in a single pack\" }},
              {{ short: \"d\", desc: \"remove redundant packs\" }},
              {{ long: \"quiet\", short: \"q\", desc: \"be quiet\" }},
          ] }},

        {{ name: \"replace\", desc: \"create, list, delete refs to replace objects\",
          flags: [
              {{ long: \"list\", short: \"l\", desc: \"list replace refs\" }},
              {{ long: \"delete\", short: \"d\", desc: \"delete replace refs\" }},
              {{ long: \"edit\", short: \"e\", desc: \"edit existing object\" }},
              {{ long: \"graft\", short: \"g\", desc: \"change a commit's parents\" }},
              {{ long: \"force\", short: \"f\", desc: \"replace the ref if it exists\" }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\", repeat: true }} ] }},

        # ---------------------------------------------------------------
        # Ancillary commands: interrogators
        # ---------------------------------------------------------------
        {{ name: \"annotate\", desc: \"annotate file lines with commit information\",
          flags: [
              {{ short: \"b\", desc: \"blank object names of boundary commits\" }},
              {{ long: \"root\", desc: \"do not treat root commits as boundaries\" }},
              {{ long: \"porcelain\", short: \"p\", desc: \"machine-readable output\" }},
              {{ short: \"w\", desc: \"ignore whitespace differences\" }},
              {{ short: \"C\", desc: \"find line copies within and across files\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ short: \"M\", desc: \"find line movements within and across files\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ short: \"L\", desc: \"process only a line range or function\",
                arg: {{ kind: \"none\" }} }},
          ],
          args: [ {{ kind: \"path\" }} ],
          after_dashdash: {{ kind: \"path\" }} }},

        {{ name: \"blame\", desc: \"show who last modified each line of a file\",
          flags: [
              {{ short: \"b\", desc: \"blank object names of boundary commits\" }},
              {{ long: \"root\", desc: \"do not treat root commits as boundaries\" }},
              {{ long: \"porcelain\", short: \"p\", desc: \"machine-readable output\" }},
              {{ long: \"show-name\", short: \"f\", desc: \"show original filename\" }},
              {{ long: \"show-number\", short: \"n\", desc: \"show original line number\" }},
              {{ long: \"show-email\", short: \"e\", desc: \"show author email, not name\" }},
              {{ short: \"w\", desc: \"ignore whitespace differences\" }},
              {{ long: \"ignore-rev\", desc: \"ignore <rev> when blaming\",
                arg: {{ kind: \"generator\", generator: \"branches\" }} }},
              {{ long: \"ignore-revs-file\", desc: \"ignore revisions from <file>\",
                arg: {{ kind: \"path\" }} }},
              {{ short: \"C\", desc: \"find line copies within and across files\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ short: \"M\", desc: \"find line movements within and across files\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
              {{ short: \"L\", desc: \"process only a line range or function\",
                arg: {{ kind: \"none\" }} }},
          ],
          args: [ {{ kind: \"path\" }} ],
          after_dashdash: {{ kind: \"path\" }} }},

        {{ name: \"bugreport\", desc: \"collect information for a bug report\",
          flags: [
              {{ long: \"diagnose\", desc: \"also create a diagnostics zip archive\",
                arg: {{ kind: \"values\", values: [\"stats\", \"all\"] }},
                arg_optional: true }},
              {{ long: \"output-directory\", short: \"o\", desc: \"where to write the report\",
                arg: {{ kind: \"dir\" }} }},
              {{ long: \"suffix\", short: \"s\", desc: \"strftime suffix for the filename\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"no-suffix\", desc: \"no suffix on the filename\" }},
          ] }},

        {{ name: \"count-objects\", desc: \"count unpacked objects and their size\",
          flags: [
              {{ long: \"verbose\", short: \"v\", desc: \"be verbose\" }},
              {{ long: \"human-readable\", short: \"H\", desc: \"print sizes in human readable form\" }},
          ] }},

        {{ name: \"diagnose\", desc: \"zip up diagnostic information\",
          flags: [
              {{ long: \"output-directory\", short: \"o\", desc: \"where to write the archive\",
                arg: {{ kind: \"dir\" }} }},
              {{ long: \"suffix\", short: \"s\", desc: \"strftime suffix for the filename\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"mode\", desc: \"what the archive contains\",
                arg: {{ kind: \"values\", values: [\"stats\", \"all\"] }} }},
          ] }},

        {{ name: \"difftool\", desc: \"show changes using common diff tools\",
          flags: [
              {{ long: \"gui\", short: \"g\", desc: \"use diff.guitool, not diff.tool\" }},
              {{ long: \"dir-diff\", short: \"d\", desc: \"perform a full-directory diff\" }},
              {{ long: \"no-prompt\", short: \"y\", desc: \"do not prompt before each tool\" }},
              {{ long: \"tool\", short: \"t\", desc: \"use the specified diff tool\",
                arg: {{ kind: \"none\" }} }},
              {{ long: \"tool-help\", desc: \"list the diff tools usable with --tool\" }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\" }},
                  {{ kind: \"path\", repeat: true }} ],
          after_dashdash: {{ kind: \"path\", repeat: true }} }},

        {{ name: \"fsck\", desc: \"verify the objects in the database\",
          flags: [
              {{ long: \"verbose\", short: \"v\", desc: \"be verbose\" }},
              {{ long: \"unreachable\", desc: \"show unreachable objects\" }},
              {{ long: \"full\", desc: \"also consider packs and alternates\" }},
              {{ long: \"strict\", desc: \"enable more strict checking\" }},
          ],
          args: [ {{ kind: \"none\", repeat: true }} ] }},

        {{ name: \"help\", desc: \"display help information about Git\",
          flags: [
              {{ long: \"all\", short: \"a\", desc: \"print all available commands\" }},
              {{ long: \"man\", short: \"m\", desc: \"show man page\" }},
              {{ long: \"web\", short: \"w\", desc: \"show manual in web browser\" }},
              {{ long: \"guides\", short: \"g\", desc: \"print list of useful guides\" }},
              {{ long: \"config\", short: \"c\", desc: \"print all configuration variable names\" }},
          ],
          args: [ {{ kind: \"none\" }} ] }},

        {{ name: \"merge-tree\", desc: \"merge without touching index or working tree\",
          flags: [
              {{ long: \"write-tree\", desc: \"do a real merge, not a trivial one\" }},
              {{ long: \"name-only\", desc: \"list filenames without modes/oids/stages\" }},
              {{ long: \"merge-base\", desc: \"specify a merge-base for the merge\",
                arg: {{ kind: \"generator\", generator: \"branches\" }} }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\" }},
                  {{ kind: \"generator\", generator: \"branches\" }},
                  {{ kind: \"generator\", generator: \"branches\" }} ] }},

        {{ name: \"rerere\", desc: \"reuse recorded resolution of conflicted merges\",
          flags: [
              {{ long: \"rerere-autoupdate\", desc: \"register clean resolutions in index\" }},
          ],
          subcommands: [
              {{ name: \"clear\", desc: \"reset the metadata used by rerere\" }},
              {{ name: \"forget\", desc: \"forget the resolutions for paths\",
                args: [ {{ kind: \"path\", repeat: true }} ] }},
              {{ name: \"diff\", desc: \"diff the current state of the resolution\" }},
              {{ name: \"status\", desc: \"print paths rerere will record\" }},
              {{ name: \"remaining\", desc: \"print paths not resolved by rerere\" }},
              {{ name: \"gc\", desc: \"prune old records of conflicted merges\" }},
          ] }},

        {{ name: \"show-branch\", desc: \"show branches and their commits\",
          flags: [
              {{ long: \"all\", short: \"a\", desc: \"show remote-tracking and local branches\" }},
              {{ long: \"remotes\", short: \"r\", desc: \"show remote-tracking branches\" }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\", repeat: true }} ] }},

        {{ name: \"verify-commit\", desc: \"check the GPG signature of commits\",
          flags: [
              {{ long: \"verbose\", short: \"v\", desc: \"print commit contents\" }},
              {{ long: \"raw\", desc: \"print raw gpg status output\" }},
          ],
          args: [ {{ kind: \"generator\", generator: \"branches\", repeat: true }} ] }},

        {{ name: \"verify-tag\", desc: \"check the GPG signature of tags\",
          flags: [
              {{ long: \"verbose\", short: \"v\", desc: \"print tag contents\" }},
              {{ long: \"raw\", desc: \"print raw gpg status output\" }},
              {{ long: \"format\", desc: \"format to use for the output\",
                arg: {{ kind: \"none\" }} }},
          ],
          args: [ {{ kind: \"generator\", generator: \"tags\", repeat: true }} ] }},

        {{ name: \"version\", desc: \"display version information about Git\",
          flags: [
              {{ long: \"build-options\", desc: \"also print build options\" }},
