/// The embedded copy of runtime file `relative`, or (false, "").
pub fn runtime_embedded(relative: str) -> (bool, str) {
    match relative {
        "init.fl" => (true, RUNTIME_FILE_0),
        "themes/quiver-dark.fl" => (true, RUNTIME_FILE_1),
        "themes/quiver-light.fl" => (true, RUNTIME_FILE_2),
        "completions/brew.fl" => (true, RUNTIME_FILE_3),
        "completions/cargo.fl" => (true, RUNTIME_FILE_4),
        "completions/cd.fl" => (true, RUNTIME_FILE_5),
        "completions/doas.fl" => (true, RUNTIME_FILE_6),
        "completions/env.fl" => (true, RUNTIME_FILE_7),
        "completions/gh.fl" => (true, RUNTIME_FILE_8),
        "completions/git.fl" => (true, RUNTIME_FILE_9),
        "completions/kill.fl" => (true, RUNTIME_FILE_10),
        "completions/make.fl" => (true, RUNTIME_FILE_11),
        "completions/mkdir.fl" => (true, RUNTIME_FILE_12),
        "completions/nice.fl" => (true, RUNTIME_FILE_13),
        "completions/nohup.fl" => (true, RUNTIME_FILE_14),
        "completions/pushd.fl" => (true, RUNTIME_FILE_15),
        "completions/rmdir.fl" => (true, RUNTIME_FILE_16),
        "completions/scp.fl" => (true, RUNTIME_FILE_17),
        "completions/ssh.fl" => (true, RUNTIME_FILE_18),
        "completions/sudo.fl" => (true, RUNTIME_FILE_19),
        "completions/tar.fl" => (true, RUNTIME_FILE_20),
        "completions/time.fl" => (true, RUNTIME_FILE_21),
        "completions/timeout.fl" => (true, RUNTIME_FILE_22),
        "completions/uv.fl" => (true, RUNTIME_FILE_23),
        "completions/watch.fl" => (true, RUNTIME_FILE_24),
        "completions/wolf.fl" => (true, RUNTIME_FILE_25),
        "completions/xargs.fl" => (true, RUNTIME_FILE_26),
        _ => (false, ""),
    }
}

/// Every embedded runtime file's relative path, in the order above.
pub fn runtime_embedded_names() -> List[str] {
    var out = List[str]()
    (mut out).push("init.fl")
    (mut out).push("themes/quiver-dark.fl")
    (mut out).push("themes/quiver-light.fl")
    (mut out).push("completions/brew.fl")
    (mut out).push("completions/cargo.fl")
    (mut out).push("completions/cd.fl")
    (mut out).push("completions/doas.fl")
    (mut out).push("completions/env.fl")
    (mut out).push("completions/gh.fl")
    (mut out).push("completions/git.fl")
    (mut out).push("completions/kill.fl")
    (mut out).push("completions/make.fl")
    (mut out).push("completions/mkdir.fl")
    (mut out).push("completions/nice.fl")
    (mut out).push("completions/nohup.fl")
    (mut out).push("completions/pushd.fl")
    (mut out).push("completions/rmdir.fl")
    (mut out).push("completions/scp.fl")
    (mut out).push("completions/ssh.fl")
    (mut out).push("completions/sudo.fl")
    (mut out).push("completions/tar.fl")
    (mut out).push("completions/time.fl")
    (mut out).push("completions/timeout.fl")
    (mut out).push("completions/uv.fl")
    (mut out).push("completions/watch.fl")
    (mut out).push("completions/wolf.fl")
    (mut out).push("completions/xargs.fl")
    out
}
