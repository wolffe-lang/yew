/// `runtime/completions/git.fl`, byte for byte.
const RUNTIME_FILE_9: str = """
# git 2.50.1 (Apple Git-155) -- from `git help -a` and `git <command> -h`.
#
# runtime/completions/git.fl: completion spec for git.
# Every command here is one `git help -a` lists under \"Main Porcelain
# Commands\" or \"Ancillary Commands\" and the installed git runs; every flag
# is one `git <command> -h` prints, or -- where `-h` prints only a usage
# line (log, show, diff) -- one the installed man page documents.  Flags
# are the common ones, not all of them.  The global options go before the
# command, so none of them is `global`.  Branch, tag and remote names come
# from the read-only generators below; `add` offers what is modified or
# untracked.
{{
    completion: 1,
    command: \"git\",
    description: \"the stupid content tracker\",

    generators: {{
        branches: {{ argv: [\"git\", \"for-each-ref\", \"--format=%(refname:short)\",
                           \"refs/heads\", \"refs/remotes\"],
                    pass_flags: [\"--git-dir\", \"--work-tree\"] }},
        tags: {{ argv: [\"git\", \"for-each-ref\", \"--format=%(refname:short)\",
                       \"refs/tags\"],
                pass_flags: [\"--git-dir\", \"--work-tree\"] }},
        remotes: {{ argv: [\"git\", \"remote\"],
                   pass_flags: [\"--git-dir\", \"--work-tree\"] }},
        modified: {{ argv: [\"git\", \"ls-files\", \"--modified\", \"--others\",
                           \"--exclude-standard\"],
                    pass_flags: [\"--git-dir\", \"--work-tree\"] }},
    }},

    flags: [
        {{ short: \"C\", desc: \"run as if git started in this directory\",
          arg: {{ kind: \"dir\" }}, changes_dir: true }},
        {{ short: \"c\", desc: \"set a config value for this run (name=value)\",
          arg: {{ kind: \"none\" }} }},
        {{ long: \"config-env\", desc: \"set config from an env var (name=envvar)\",
          arg: {{ kind: \"none\" }} }},
        {{ long: \"git-dir\", desc: \"the repository (.git) directory\",
          arg: {{ kind: \"dir\" }} }},
        {{ long: \"work-tree\", desc: \"the working tree directory\",
          arg: {{ kind: \"dir\" }} }},
        {{ long: \"namespace\", desc: \"the git namespace\",
          arg: {{ kind: \"none\" }} }},
        {{ long: \"exec-path\", desc: \"where git's programs are, or print it\",
          arg: {{ kind: \"dir\" }}, arg_optional: true }},
        {{ long: \"html-path\", desc: \"print where the HTML docs are\" }},
        {{ long: \"man-path\", desc: \"print the manpath for git's man pages\" }},
        {{ long: \"info-path\", desc: \"print where the info files are\" }},
        {{ long: \"paginate\", short: \"p\", desc: \"pipe all output into the pager\" }},
        {{ long: \"no-pager\", short: \"P\", desc: \"do not pipe output into a pager\" }},
        {{ long: \"no-replace-objects\", desc: \"do not use replacement refs\" }},
        {{ long: \"no-lazy-fetch\", desc: \"do not fetch missing objects on demand\" }},
        {{ long: \"no-optional-locks\", desc: \"do not take optional locks\" }},
        {{ long: \"no-advice\", desc: \"disable all advice hints\" }},
        {{ long: \"bare\", desc: \"treat the repository as a bare repository\" }},
        {{ long: \"version\", short: \"v\", desc: \"print the git version\" }},
        {{ long: \"help\", short: \"h\", desc: \"print help\" }},
    ],

    subcommands: [
        # ---------------------------------------------------------------
        # Main porcelain commands
        # ---------------------------------------------------------------
        {{ name: \"add\", desc: \"add file contents to the index\",
          flags: [
              {{ long: \"dry-run\", short: \"n\", desc: \"dry run\" }},
              {{ long: \"verbose\", short: \"v\", desc: \"be verbose\" }},
              {{ long: \"interactive\", short: \"i\", desc: \"interactive picking\" }},
              {{ long: \"patch\", short: \"p\", desc: \"select hunks interactively\" }},
              {{ long: \"edit\", short: \"e\", desc: \"edit current diff and apply\" }},
              {{ long: \"force\", short: \"f\", desc: \"allow adding otherwise ignored files\" }},
              {{ long: \"update\", short: \"u\", desc: \"update tracked files\" }},
              {{ long: \"intent-to-add\", short: \"N\",
                desc: \"record only that the path will be added later\" }},
              {{ long: \"all\", short: \"A\", desc: \"add changes from all files\" }},
              {{ long: \"chmod\", desc: \"override the executable bit\",
                arg: {{ kind: \"values\", values: [\"+x\", \"-x\"] }} }},
          ],
          args: [ {{ kind: \"generator\", generator: \"modified\", repeat: true }} ],
          after_dashdash: {{ kind: \"path\", repeat: true }} }},

        {{ name: \"am\", desc: \"apply a series of patches from a mailbox\",
          flags: [
              {{ long: \"interactive\", short: \"i\", desc: \"run interactively\" }},
              {{ long: \"3way\", short: \"3\", desc: \"fall back on 3-way merge if needed\" }},
              {{ long: \"quiet\", short: \"q\", desc: \"be quiet\" }},
              {{ long: \"signoff\", short: \"s\", desc: \"add a Signed-off-by trailer\" }},
              {{ long: \"continue\", desc: \"continue after resolving a conflict\" }},
              {{ long: \"skip\", desc: \"skip the current patch\" }},
              {{ long: \"abort\", desc: \"restore the original branch and abort\" }},
              {{ long: \"gpg-sign\", short: \"S\", desc: \"GPG-sign commits\",
                arg: {{ kind: \"none\" }}, arg_optional: true }},
          ],
          args: [ {{ kind: \"path\", repeat: true }} ] }},

        {{ name: \"archive\", desc: \"create an archive of files from a named tree\",
          flags: [
