bind(\"I\", \"C-2\", \"ed.tab.goto_bar\", {{ iarg: 2 }})
bind(\"I\", \"C-3\", \"ed.tab.goto_bar\", {{ iarg: 3 }})
bind(\"I\", \"C-4\", \"ed.tab.goto_bar\", {{ iarg: 4 }})
bind(\"I\", \"C-5\", \"ed.tab.goto_bar\", {{ iarg: 5 }})
bind(\"I\", \"C-6\", \"ed.tab.goto_bar\", {{ iarg: 6 }})
bind(\"I\", \"C-7\", \"ed.tab.goto_bar\", {{ iarg: 7 }})
bind(\"I\", \"C-8\", \"ed.tab.goto_bar\", {{ iarg: 8 }})
bind(\"I\", \"C-9\", \"ed.tab.goto_bar\", {{ iarg: 9 }})
bind(\"I\", \"C-0\", \"ed.tab.goto_bar\")
bind(\"H\", \"A-1\", \"ed.tab.goto\", {{ iarg: 1 }})
bind(\"H\", \"A-2\", \"ed.tab.goto\", {{ iarg: 2 }})
bind(\"H\", \"A-3\", \"ed.tab.goto\", {{ iarg: 3 }})
bind(\"H\", \"A-4\", \"ed.tab.goto\", {{ iarg: 4 }})
bind(\"H\", \"A-5\", \"ed.tab.goto\", {{ iarg: 5 }})
bind(\"H\", \"A-6\", \"ed.tab.goto\", {{ iarg: 6 }})
bind(\"H\", \"A-7\", \"ed.tab.goto\", {{ iarg: 7 }})
bind(\"H\", \"A-8\", \"ed.tab.goto\", {{ iarg: 8 }})
bind(\"H\", \"A-9\", \"ed.tab.goto\", {{ iarg: 9 }})
bind(\"H\", \"A-0\", \"ed.tab.goto\")
bind(\"H\", \"C-1\", \"ed.tab.goto_bar\", {{ iarg: 1 }})
bind(\"H\", \"C-2\", \"ed.tab.goto_bar\", {{ iarg: 2 }})
bind(\"H\", \"C-3\", \"ed.tab.goto_bar\", {{ iarg: 3 }})
bind(\"H\", \"C-4\", \"ed.tab.goto_bar\", {{ iarg: 4 }})
bind(\"H\", \"C-5\", \"ed.tab.goto_bar\", {{ iarg: 5 }})
bind(\"H\", \"C-6\", \"ed.tab.goto_bar\", {{ iarg: 6 }})
bind(\"H\", \"C-7\", \"ed.tab.goto_bar\", {{ iarg: 7 }})
bind(\"H\", \"C-8\", \"ed.tab.goto_bar\", {{ iarg: 8 }})
bind(\"H\", \"C-9\", \"ed.tab.goto_bar\", {{ iarg: 9 }})
bind(\"H\", \"C-0\", \"ed.tab.goto_bar\")

# The prompt's line editing (Sprint 57.28): readline's and fish's keys,
# on the SAME commands Insert mode binds -- the prompt is a one-line Win,
# so a kill here feeds the one yank stack C-y reads in either place.
# None of these touch a register or the system clipboard.
bind(\"E\", \"<left>\", \"ed.move.char.prev\")
bind(\"E\", \"C-b\", \"ed.move.char.prev\")
# <right>, C-f: the whole ghost at the end of the line, else one
# grapheme right.  A-f, A-<right>: one ghost word, else one word right.
bind(\"E\", \"<right>\", \"ed.cmdline.ghost.accept\")
bind(\"E\", \"C-f\", \"ed.cmdline.ghost.accept\")
bind(\"E\", \"A-f\", \"ed.cmdline.ghost.accept_word\")
bind(\"E\", \"A-<right>\", \"ed.cmdline.ghost.accept_word\")
bind(\"E\", \"A-b\", \"ed.move.word.prev\")
bind(\"E\", \"A-<left>\", \"ed.move.word.prev\")
bind(\"E\", \"<home>\", \"ed.move.line.home_toggle\")
bind(\"E\", \"<end>\", \"ed.move.line.end\")
bind(\"E\", \"C-a\", \"ed.move.line.home\")
bind(\"E\", \"C-<left>\", \"ed.move.line.home\")
# C-e, C-<right>: fish's end of line, which takes a whole ghost too.
bind(\"E\", \"C-e\", \"ed.cmdline.ghost.accept_line\")
bind(\"E\", \"C-<right>\", \"ed.cmdline.ghost.accept_line\")
bind(\"E\", \"<bs>\", \"ed.edit.delete.grapheme_left\")
# C-h: kitty-protocol terminals report ctrl+h as itself; a legacy terminal
# that sends ^H (0x08) for Backspace decodes as C-<bs>.  Both delete left.
bind(\"E\", \"C-h\", \"ed.edit.delete.grapheme_left\")
bind(\"E\", \"C-<bs>\", \"ed.edit.delete.grapheme_left\")
bind(\"E\", \"<del>\", \"ed.edit.delete.grapheme\")
# C-d only ever deletes forward; it never cancels the prompt.
bind(\"E\", \"C-d\", \"ed.edit.delete.grapheme\")
# C-w is bash's unix-word-rubout: back to the previous BLANK, so a path
# goes whole.  A-<bs> is the word-character kill Insert mode's C-w is.
bind(\"E\", \"C-w\", \"ed.edit.kill.ws_word_prev\")
bind(\"E\", \"A-<bs>\", \"ed.edit.kill.word_prev\")
bind(\"E\", \"A-d\", \"ed.edit.kill.word_next\")
bind(\"E\", \"A-<del>\", \"ed.edit.kill.word_next\")
bind(\"E\", \"C-u\", \"ed.edit.kill.to_home\")
bind(\"E\", \"C-k\", \"ed.edit.kill.to_end\")
bind(\"E\", \"C-t\", \"ed.edit.transpose.chars\")
bind(\"E\", \"A-t\", \"ed.edit.transpose.words\")
bind(\"E\", \"A-u\", \"ed.edit.case.upper_word\")
bind(\"E\", \"A-l\", \"ed.edit.case.lower_word\")
bind(\"E\", \"A-c\", \"ed.edit.case.cap_word\")
# Readline wins the clashes: C-y yanks (redo is A-/, fish's key), C-v
# pastes the system clipboard (literal-next is C-q, readline's
# quoted-insert), and insert-register gains A-r.
bind(\"E\", \"C-y\", \"ed.edit.kill.yank\")
bind(\"E\", \"A-y\", \"ed.edit.kill.yank_pop\")
bind(\"E\", \"A-.\", \"ed.cmdline.last_arg\")
# Up/Down (and C-p/C-n, exactly) are history -- fish's substring search
# on the typed text -- unless Tab has entered the completion table; in
# it they move rows (Sprint 57.30).
bind(\"E\", \"<up>\", \"ed.cmdline.up\")
bind(\"E\", \"<down>\", \"ed.cmdline.down\")
bind(\"E\", \"C-p\", \"ed.cmdline.up\")
bind(\"E\", \"C-n\", \"ed.cmdline.down\")
bind(\"E\", \"<tab>\", \"ed.cmdline.complete_next\")
bind(\"E\", \"S-<tab>\", \"ed.cmdline.complete_prev\")
bind(\"E\", \"<pgdn>\", \"ed.cmdline.menu.page_next\")
bind(\"E\", \"<pgup>\", \"ed.cmdline.menu.page_prev\")
# A-<up>/A-<down>: fish's token search -- the word under the caret
# becomes older (newer) history words holding it (Sprint 57.30).
bind(\"E\", \"A-<up>\", \"ed.cmdline.token_prev\")
bind(\"E\", \"A-<down>\", \"ed.cmdline.token_next\")
# C-r searches history in the pager (Sprint 57.30); A-r inserts a register.
bind(\"E\", \"C-r\", \"ed.cmdline.hist_search\")
bind(\"E\", \"A-r\", \"ed.cmdline.insert_register\")
bind(\"E\", \"C-q\", \"ed.cmdline.literal_next\")
bind(\"E\", \"C-v\", \"ed.clip.paste\")
bind(\"E\", \"C-z\", \"ed.edit.undo\")
bind(\"E\", \"C-_\", \"ed.edit.undo\")
bind(\"E\", \"C-/\", \"ed.edit.undo\")
bind(\"E\", \"A-/\", \"ed.edit.redo\")
bind(\"E\", \"C-g\", \"ed.cmdline.cancel\")
# The prompt's selection (Sprint 57.29): Shift+motion selects, typing,
# pasting or yanking replaces it, <bs>/<del> delete it.  C-c copies it
# to the system clipboard and stays; with nothing selected C-c cancels,
# exactly as C-g does.  C-x cuts it, and without one does nothing.
bind(\"E\", \"S-<left>\", \"ed.sel.extend.left\")
bind(\"E\", \"S-<right>\", \"ed.sel.extend.right\")
bind(\"E\", \"A-S-<left>\", \"ed.sel.extend.word_prev\")
bind(\"E\", \"A-S-<right>\", \"ed.sel.extend.word_next\")
bind(\"E\", \"S-<home>\", \"ed.sel.extend.line_home\")
bind(\"E\", \"S-<end>\", \"ed.sel.extend.line_end\")
bind(\"E\", \"C-S-<left>\", \"ed.sel.extend.line_home\")
bind(\"E\", \"C-S-<right>\", \"ed.sel.extend.line_end\")
bind(\"E\", \"C-c\", \"ed.cmdline.copy_or_cancel\")
bind(\"E\", \"C-x\", \"ed.clip.cut\")
# fish's extras (Sprint 57.31): A-s toggles sudo at the front of a :!
# command; A-h opens the man page of the command under the caret; A-e
# (and A-v, as in fish) edits the line in a *command-line* buffer --
# :q returns the text to the prompt, :q! the line as it was.
bind(\"E\", \"A-s\", \"ed.cmdline.toggle_sudo\")
bind(\"E\", \"A-h\", \"ed.cmdline.man_page\")
bind(\"E\", \"A-e\", \"ed.cmdline.edit_in_buffer\")
bind(\"E\", \"A-v\", \"ed.cmdline.edit_in_buffer\")

bind(\"F\", \"<esc>\", \"ed.git.mode.leave\")
bind(\"F\", \"C-w s\", \"ed.git.open_split_h\")
bind(\"F\", \"C-w v\", \"ed.git.open_split_v\")

# -- 6. macros ----------------------------------------------------------
bind(\"*\", \"q\", \"ed.macro.record\")
bind(\"*\", \"@\", \"ed.macro.replay\")
bind(\"*\", \"@ @\", \"ed.macro.replay_last\")
bind(\"*\", \"Q\", \"ed.macro.list\")

# -- 7. hooks -----------------------------------------------------------
# Hooks are intentionally absent by default: examples must not produce
# messages or mutate options in an otherwise idle editor.

# -- 8. functions -------------------------------------------------------
# User helpers belong in the personal init.fl above this shipped baseline.
"""

