const RUNTIME_FILE_3: str = """
# Homebrew 7.0.4-30-g14c54f7 -- from `brew commands` and `brew <command> --help` (services subcommands from `man brew`).
#
# runtime/completions/brew.fl: completion spec for Homebrew.
# Every command and flag here is one the installed brew prints in its own
# help; each command carries its most common flags, not every one.
# Aliases are the ones each command's `Usage:` line names.
#
# Formula and cask names to install are not offered: there is no cheap,
# offline list of them. Installed ones come from `brew list -1`, which
# reads the Cellar and Caskroom and never touches the network.
# The dash-spelled commands (`--prefix`, `--cellar`, ...) are root flags,
# since a word starting with `-` completes as a flag.
