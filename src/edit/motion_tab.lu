//! edit.motion_tab — sagitta 9ace98c2 src/fl/motion_tab.c:16-311.
//! Every operation resolves a CMDWORD and reaches the existing resolved
//! dispatcher. A program is a rooted FlValue; re-read its scalar op after
//! every command, because synchronous hooks may compact the Fletch heap.

use fl
use util

fn motion_status(mut vm: fl.FlVm, status: int, word: str) -> bool {
    if status == CMD_OK { return true }
    let kind = match status {
        1 => "type",
        2 => "user",
        3 => "io",
        4 => "name",
        _ => "user",
    }
    let _ = fl.fl_raise(mut vm, kind, "command word '{word}' failed")
    false
}

fn motion_word(
    mut vm: fl.FlVm,
    mut ed: Ed,
    wi: int,
    word: str,
    count: int,
    given: bool,
    sarg: List[byte],
    has_sarg: bool,
) -> bool {
    let id = cmd_by_word(ed.reg, word)
    if id == 0 { let _ = fl.fl_raise(mut vm, "name", "no command has word '{word}'"); return false }
    var cx = cmdctx_new(wi, ed.flrt.command_source)
    cx.count = if count == 0 then 1 else count
    cx.count_given = given
    cx.has_sarg = has_sarg
    cx.has_sbytes = has_sarg
    cx.sarg = str_from_utf8(sarg) else ""
    for b in sarg { (mut cx.sbytes).push(b) }
    let status = fl_invoke_command(mut vm, mut ed, id, mut cx) else { return false }
    motion_status(mut vm, status, word)
}

fn motion_mode(mut vm: fl.FlVm, mut ed: Ed, wi: int, mode: str, count: int, given: bool) -> bool {
    motion_word(mut vm, mut ed, wi, "mode", count, given, mode.bytes(), true)
}

fn motion_close_highlights(mut vm: fl.FlVm, mut ed: Ed, wi: int, depth: int) {
    let id = cmd_by_word(ed.reg, "escape")
    if id == 0 { return }
    for _ in 0..depth {
        var cx = cmdctx_new(wi, ed.flrt.command_source)
        // C deliberately dispatches cleanup without enlistment or error mapping.
        assert(ed.flrt.vms.len == 0)
        (mut ed.flrt.vms).push(take vm)
        let _ = ed_dispatch_resolved(mut ed, id, mut cx)
        vm = runtime_take(mut ed)
    }
}

fn motion_operation(mut vm: fl.FlVm, mut ed: Ed, wi: int, op: fl.FlMotionOp) -> bool {
    let given = op.flags & 2 != 0
    let alt = op.flags & 1 != 0
    var word = ""
    if op.kind == fl.FL_MK_UNIT {
        let mode = match op.ch {
            108 => "L",
            119 => "W",
            98 => "B",
            99 => "C",
            _ => "",
        }
        if mode.len == 0 {
            let _ = fl.fl_raise(mut vm, "motion", "invalid motion unit")
            return false
        }
        return motion_mode(mut vm, mut ed, wi, mode, op.count, given)
    }
    if op.kind == fl.FL_MK_ARROW {
        word = match op.ch {
            62 => if alt then "unit_next_alt" else "unit_next",
            60 => if alt then "unit_prev_alt" else "unit_prev",
            94 => if alt then "unit_up_alt" else "unit_up",
            118 => if alt then "unit_down_alt" else "unit_down",
            _ => "",
        }
        if word.len == 0 {
            let _ = fl.fl_raise(mut vm, "motion", "invalid motion arrow")
            return false
        }
    } else if op.kind == fl.FL_MK_INSERT || op.kind == fl.FL_MK_WORD {
        if op.arg <= 0 || op.arg >= vm.strings.items.len {
            let what = if op.kind == fl.FL_MK_INSERT {
                "invalid motion string"
            } else {
                "invalid command word"
            }
            let _ = fl.fl_raise(mut vm, "motion", what)
            return false
        }
        let bytes = copy vm.strings.items[op.arg]
        if op.kind == fl.FL_MK_INSERT {
            return motion_word(mut vm, mut ed, wi, "insert", op.count, given, bytes, true)
        }
        word = str_from_utf8(bytes) else {
            let _ = fl.fl_raise(mut vm, "motion", "invalid command word")
            return false
        }
    } else if op.kind == fl.FL_MK_DEL {
        word = "delete_unit"
    } else if op.kind == fl.FL_MK_ESC {
        word = "escape"
    } else {
        let _ = fl.fl_raise(mut vm, "motion", "invalid motion operation")
        return false
    }
    motion_word(mut vm, mut ed, wi, word, op.count, given, List[byte](), false)
}

fn motion_rooted(mut vm: fl.FlVm, mut ed: Ed, wi: int, root: int) -> bool {
    let value = fl.fl_temp_get(vm, root)
    let n = vm.gc.slots[fl.fl_obj_index(vm, value)].ops.len
    var ends = List[int]()
    var i = 0
    while i < n {
        while ends.len != 0 && i == ends[ends.len - 1] {
            if !motion_word(mut vm, mut ed, wi, "escape", 1, false, List[byte](), false) {
                motion_close_highlights(mut vm, mut ed, wi, ends.len - 1)
                return false
            }
            let _ = (mut ends).pop() else 0
        }
        let current = fl.fl_temp_get(vm, root)
        let op = copy vm.gc.slots[fl.fl_obj_index(vm, current)].ops[i]
        if op.kind == fl.FL_MK_HIGHLIGHT {
            let parent_end = if ends.len == 0 then n else ends[ends.len - 1]
            if ends.len == 256 {
                motion_close_highlights(mut vm, mut ed, wi, ends.len)
                let _ = fl.fl_raise(mut vm, "limit", "motion nesting limit exceeded")
                return false
            }
            if op.arg < 0 || op.arg > parent_end - i - 1 {
                motion_close_highlights(mut vm, mut ed, wi, ends.len)
                let _ = fl.fl_raise(mut vm, "motion", "invalid highlight extent")
                return false
            }
            if !motion_mode(mut vm, mut ed, wi, "H", op.count, op.flags & 2 != 0) {
                motion_close_highlights(mut vm, mut ed, wi, ends.len)
                return false
            }
            (mut ends).push(i + 1 + op.arg)
        } else if !motion_operation(mut vm, mut ed, wi, op) {
            motion_close_highlights(mut vm, mut ed, wi, ends.len)
            return false
        }
        i += 1
    }
    while ends.len != 0 {
        if ends[ends.len - 1] != n {
            motion_close_highlights(mut vm, mut ed, wi, ends.len)
            let _ = fl.fl_raise(mut vm, "motion", "invalid highlight extent")
            return false
        }
        if !motion_word(mut vm, mut ed, wi, "escape", 1, false, List[byte](), false) {
            motion_close_highlights(mut vm, mut ed, wi, ends.len - 1)
            return false
        }
        let _ = (mut ends).pop() else 0
    }
    true
}

/// Execute a rooted preassembled motion program against the supplied window.
pub fn fl_motion_exec(mut vm: fl.FlVm, mut ed: Ed, wi: int, program: fl.FlValue) -> bool {
    if wi < 0 || wi >= ed.wins.len || ed.wins[wi].id == 0 || program.t != fl.FL_MOTION_PROG {
        let _ = fl.fl_raise(mut vm, "motion", "no editor host")
        return false
    }
    let root = fl.fl_temp_push(mut vm, program)
    let ok = motion_rooted(mut vm, mut ed, wi, root)
    fl.fl_temp_pop(mut vm, 1)
    ok
}

/// FlHost's motion callback always uses the focused view.
pub fn fl_motion_host_dispatch(mut vm: fl.FlVm, mut ed: Ed, program: fl.FlValue) -> bool {
    let wi = ed.win
    fl_motion_exec(mut vm, mut ed, wi, program)
}

/// Validate one macro word and supply C's scoped did-you-mean diagnostic.
pub fn fl_motion_word_validate(ed: Ed, word: List[byte], mut detail: List[byte]) -> bool {
    let name = str_from_utf8(word) else { return false }
    if name.len == 0 { return false }
    if cmd_by_word(ed.reg, name) != 0 { return true }
    util.buf_append_str(mut detail, "no command has word '{name}'")
    var suggest = fl.fl_suggest_new()
    for e in ed.reg.entries { if e.has_word { fl.fl_suggest_add(mut suggest, e.word.bytes(), 2) } }
    var suffix = List[byte]()
    if fl.fl_suggest_render(mut suggest, word, mut suffix) != 0 {
        util.buf_append_str(mut detail, "; ")
        util.buf_append(mut detail, suffix)
    }
    false
}
