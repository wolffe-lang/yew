//! edit.option_cmdline — `:set NAME VALUE` and the option commands:
//! `parse_option_value` and `yew_opt_cmdline_set` (`ed.opt.set_many`,
//! sagitta 9ace98c2 src/ui/cmdline.c:61-111) and `ed.opt.get`/`ed.opt.set`
//! (`yew_opt_cmd_get`/`yew_opt_cmd_set`, src/edit/option.c:1869-1900), all
//! over the one option table (edit.option). Before Sprint 36 this file was
//! the interim setter over `Opts`; the table retires it.

use util

// `parse_option_value` (cmdline.c:61-91): the value word as the
// descriptor's type; a string list has no E-mode spelling.
fn opt_parse_value(d: OptDesc, text: str) -> OptVal ! {invalid} {
    if d.t == OPT_BOOL {
        if text == "true" { return optv_bool(true) }
        if text == "false" { return optv_bool(false) }
        return invalid
    }
    if d.t == OPT_INT {
        if text.len == 0 { return invalid }
        let n = text.to_int() else { return invalid }
        return optv_int(n)
    }
    if d.t == OPT_STRLIST { return invalid }
    OptVal { t: d.t, b: false, i: 0, s: text, list: List[str]() }
}

/// `ed.opt.set_many` (`yew_opt_cmdline_set`, cmdline.c:93-111): one name
/// and one value word through the shared setter; a refusal is logged.
pub fn opt_cmdline_set_cmd(mut ed: Ed, cx: CmdCtx) -> int {
    if cx.argv.len != 3 { return CMD_ERR_ARG }
    let name = cx.argv[1]
    let i = opt_desc_index(ed.opt, name)
    if i < 0 { return CMD_ERR_ARG }
    let value = opt_parse_value(ed.opt.descs[i], cx.argv[2]) else { return CMD_ERR_ARG }
    let why = opt_set(mut ed, OPT_SCOPE_DECLARED, name, value)
    if why.len != 0 {
        util.log_at(util.LOG_ERROR, ":set: {why}")
        return CMD_ERR_ARG
    }
    CMD_OK
}

/// `shell.session` set through the table (C's option row, option.c:
/// 356-358, and its effect, :814-818): `fresh` ends a running session.
pub fn opt_shell_session_set(mut ed: Ed, v: str) {
    let _ = opt_set(mut ed, OPT_SCOPE_DECLARED, "shell.session", optv_enum(v))
}

/// `ed.opt.get` (`yew_opt_cmd_get`, option.c:1869-1882): only the binding
/// layer supplies `opt_out` (`opt.get`, which the port answers from the
/// store in edit.flapi with the same result and errors), so through the
/// registry it is C's missing-argument refusal.
pub fn opt_cmd_get(mut ed: Ed, cx: CmdCtx) -> int {
    if !cx.has_sarg || !cx.has_opt_out { return CMD_ERR_ARG }
    let _ = opt_get_current(ed, cx.sarg) else { return CMD_ERR_ARG }
    ed.footer_dirty = ed.footer_dirty
    CMD_OK
}

/// `ed.opt.set` (`yew_opt_cmd_set`, option.c:1884-1900): `opt_in` set in
/// the option's declared scope; through the registry `opt_in` is never
/// supplied (the binding layer's `opt.set` sets the store directly).
pub fn opt_cmd_set(mut ed: Ed, cx: CmdCtx) -> int {
    if !cx.has_sarg || !cx.has_opt_in { return CMD_ERR_ARG }
    let why = opt_set(mut ed, OPT_SCOPE_DECLARED, cx.sarg, copy cx.opt_in)
    if why.len != 0 then CMD_ERR_ARG else CMD_OK
}
