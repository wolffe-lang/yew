//! edit.option_cmdline — `:set NAME VALUE` before the options model.
//!
//! Ports `parse_option_value` and `yew_opt_cmdline_set` (`ed.opt.set_many`,
//! `cmdline.c:60-111`) at 9ace98c2 over the options campaign 03 already
//! holds (`edit.config`'s `Opts`, the descriptor rows of `option.c:213-260`
//! that `set_option` reaches) and the two `:!` enums the prompt reads
//! (`shell.suggest_history`, `option.c:350-353`; `history.scope`). The
//! descriptor table, the scopes and the change hooks are the options
//! model's (s36, yw09): any other name refuses by name naming it, never
//! silently. A malformed value is C's `YEW_CMD_ERR_ARG`.

// `parse_option_value`'s integer (`strtoll`, the whole token).
fn opt_int(v: str) -> int ! {invalid} {
    if v.len == 0 {
        return invalid
    }
    v.to_int() else {
        return invalid
    }
}

fn opt_bool(v: str) -> int ! {invalid} {
    if v == "true" {
        return 1
    }
    if v == "false" {
        return 0
    }
    invalid
}

/// `ed.opt.set_many` (`yew_opt_cmdline_set`, `cmdline.c:84-111`).
pub fn opt_cmdline_set_cmd(mut ed: Ed, cx: CmdCtx) -> int {
    if cx.argv.len != 3 {
        return CMD_ERR_ARG
    }
    let name = cx.argv[1]
    let v = cx.argv[2]
    if name == "tabwidth" || name == "scrolloff" || name == "chord_timeout_ms" {
        let n = opt_int(v) else {
            return CMD_ERR_ARG
        }
        let hi = if name == "tabwidth" then 16 else if name == "scrolloff" then 99 else 5000
        let lo = if name == "tabwidth" then 1 else 0
        if n < lo || n > hi {
            return CMD_ERR_ARG
        }
        if name == "tabwidth" {
            ed.opts.tabwidth = n
            if ed.win >= 0 {
                let b = ed.wins[ed.win].buf
                ed.bufs[b].tabwidth = n
            }
        } else if name == "scrolloff" {
            ed.opts.scrolloff = n
            if ed.win >= 0 {
                ed.wins[ed.win].vp.scrolloff = n
            }
        } else {
            ed.opts.chord_timeout_ms = n
            ed.chord_timeout_ms = n
        }
    } else if name == "expandtab" ||
        name == "autoindent" ||
        name == "autopair" ||
        name == "wrap" ||
        name == "errorbells" ||
        name == "subword" ||
        name == "undo.break_on_newline" {
        let f = opt_bool(v) else {
            return CMD_ERR_ARG
        }
        let on = f == 1
        if name == "expandtab" {
            ed.opts.expandtab = on
        } else if name == "autoindent" {
            ed.opts.autoindent = on
        } else if name == "autopair" {
            ed.opts.autopair = on
        } else if name == "wrap" {
            ed.opts.wrap = on
            if ed.win >= 0 {
                ed.wins[ed.win].vp.wrap = on
            }
        } else if name == "errorbells" {
            ed.opts.errorbells = on
            ed.errorbells = on
        } else if name == "subword" {
            ed.opts.subword = on
        } else {
            ed.opts.undo_break_on_newline = on
            ed.undo_break_on_newline = on
        }
    } else if name == "shell.suggest_history" {
        if v != "all" && v != "yew" {
            return CMD_ERR_ARG
        }
    } else if name == "history.scope" {
        if v != "workspace" && v != "global" {
            return CMD_ERR_ARG
        }
    } else {
        ed_msg(mut ed, MSG_ERROR, "not yet ported: :set {name}: sagitta Sprint 36 (options) (yw09)")
        return CMD_ERR_DEFERRED
    }
    ed.opts.store[name] = v
    ed.full_damage = true
    CMD_OK
}
