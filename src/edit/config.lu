//! edit.config — the configuration the editor starts with: the options
//! and key bindings `runtime/init.fl` sets.
//!
//! C runs `init.fl` in the Fletch VM before the first paint
//! (`yew_config_load_all`, `fl/flconf.c`, Sprint 36); its `set()` writes
//! the option store (`edit/option.c:213-330`, the descriptors with their
//! defaults and ranges) and its `bind()` adds rows to the binding ledger
//! (`edit/bind.c:291-415`), from which each mode's "config" keymap is
//! rebuilt with the LAST row per sequence winning (`rows_for_mode`,
//! `bind.c:196-238`). Until Fletch lands (yw07–yw09) the port reads the
//! file's flat shape with `edit.fldata` and does the same two things: the
//! options campaign 03 reads become the typed fields of `Opts` (each
//! with C's descriptor default, so a missing `set` key keeps C's value),
//! every key `set` names is kept in `Opts.store` as C's store would hold
//! it, and the `bind` rows become per-mode `BindRow` lists through the
//! same builder (`keymap_build`). A statement the reader cannot take
//! fails the load by line and column naming yw09, the config runtime's
//! owner since yw07 landed the VM (R-yw03-2, adopted contract's Decided).

use util

/// The option values campaign 03 reads (`edit/option.c` descriptors).
pub struct Opts {
    tabwidth: int,
    expandtab: bool,
    autoindent: bool,
    autopair: bool,
    wrap: bool,
    scrolloff: int,
    number_style: int,
    status_cell_column: bool,
    errorbells: bool,
    ambiguous_wide: bool,
    subword: bool,
    chord_timeout_ms: int,
    undo_break_on_newline: bool,
    theme: str,
    store: Map[str, str],
}

/// C's descriptor defaults (`option.c:213-330`).
pub fn opts_default() -> Opts {
    Opts {
        tabwidth: 4,
        expandtab: false,
        autoindent: true,
        autopair: true,
        wrap: false,
        scrolloff: 3,
        number_style: NUM_HYBRID,
        status_cell_column: false,
        errorbells: false,
        ambiguous_wide: false,
        subword: false,
        chord_timeout_ms: 500,
        undo_break_on_newline: true,
        theme: "quiver-dark",
        store: Map[str, str](),
    }
}

/// What a configuration load produced: the options, each mode's bind
/// rows (last wins per sequence, in ledger order), the names `let`
/// bound with each value's rendering (C's config globals,
/// `yew_config_get_global`, `flconf.c:686-720`; read by the campaigns
/// that consume them — `lsp` is yw11's), and the first error.
pub struct Config {
    opts: Opts,
    binds: List[List[BindRow]],
    globals: Map[str, str],
    error: str,
}

fn node_text(doc: FlDoc, n: int) -> str {
    if fl_kind(doc, n) == FN_STR then doc.nodes[n].text else ""
}

fn render_value(doc: FlDoc, n: int) -> str {
    let k = fl_kind(doc, n)
    if k == FN_STR {
        return doc.nodes[n].text
    }
    if k == FN_INT {
        return "{doc.nodes[n].num}"
    }
    if k == FN_BOOL {
        return if doc.nodes[n].num != 0 then "true" else "false"
    }
    "nil"
}

// `option_changed_target`'s campaign-03 rows (`option.c:825-860`), with
// the descriptor ranges (`option.c:213-260`).
fn set_option(mut c: Config, doc: FlDoc, key: str, v: int) {
    let k = fl_kind(doc, v)
    let num = doc.nodes[v].num
    let flag = k == FN_BOOL && num != 0
    c.opts.store[key] = render_value(doc, v)
    if key == "tabwidth" {
        if k != FN_INT || num < 1 || num > 16 {
            config_fail(mut c, "set: tabwidth must be an integer 1..16")
            return
        }
        c.opts.tabwidth = num
    } else if key == "expandtab" {
        c.opts.expandtab = flag
    } else if key == "autoindent" {
        c.opts.autoindent = flag
    } else if key == "autopair" {
        c.opts.autopair = flag
    } else if key == "wrap" {
        c.opts.wrap = flag
    } else if key == "scrolloff" {
        if k != FN_INT || num < 0 || num > 99 {
            config_fail(mut c, "set: scrolloff must be an integer 0..99")
            return
        }
        c.opts.scrolloff = num
    } else if key == "number" {
        let s = node_text(doc, v)
        c.opts.number_style = if s == "off" {
            NUM_NONE
        } else if s == "rel" {
            NUM_REL
        } else if s == "both" {
            NUM_HYBRID
        } else {
            NUM_ABS
        }
    } else if key == "statusline.column" {
        c.opts.status_cell_column = node_text(doc, v) != "gcol"
    } else if key == "errorbells" {
        c.opts.errorbells = flag
    } else if key == "ambiguous_wide" {
        c.opts.ambiguous_wide = flag
    } else if key == "subword" {
        c.opts.subword = flag
    } else if key == "chord_timeout_ms" {
        if k != FN_INT || num < 0 || num > 5000 {
            config_fail(mut c, "set: chord_timeout_ms must be an integer 0..5000")
            return
        }
        c.opts.chord_timeout_ms = num
    } else if key == "undo.break_on_newline" {
        c.opts.undo_break_on_newline = flag
    } else if key == "theme" {
        c.opts.theme = node_text(doc, v)
    }
}

fn config_fail(mut c: Config, what: str) {
    if c.error.len == 0 {
        c.error = what
    }
}

fn mode_letter(s: str) -> int {
    var m = 0
    while m < MODE_N {
        if mode_name(m) == s {
            return m
        }
        m += 1
    }
    -1
}

fn add_bind(mut c: Config, m: int, row: BindRow) {
    // Last wins per sequence (`rows_for_mode`): drop an earlier row with
    // the same sequence text, keep ledger order otherwise.
    var kept = List[BindRow]()
    for r in c.binds[m] {
        if r.seq != row.seq {
            (mut kept).push(copy r)
        }
    }
    (mut kept).push(row)
    c.binds[m] = kept
}

// `fl_bind_native` (`bind.c:647-715`) over the literal reader's call.
fn run_bind(mut c: Config, doc: FlDoc, call: int) {
    let args = copy doc.nodes[call].vals
    if args.len != 3 && args.len != 4 {
        config_fail(mut c, "bind: expected 3 or 4 arguments")
        return
    }
    if fl_kind(doc, args[0]) != FN_STR || fl_kind(doc, args[1]) != FN_STR {
        config_fail(mut c, "bind: mode and sequence must be strings")
        return
    }
    if fl_kind(doc, args[2]) != FN_STR {
        config_fail(mut c, "bind: a closure target needs the Fletch VM (yw09)")
        return
    }
    var row = bindrow(doc.nodes[args[1]].text, doc.nodes[args[2]].text)
    if args.len == 4 {
        let m = args[3]
        if fl_kind(doc, m) != FN_MAP {
            config_fail(mut c, "bind arguments must be a map")
            return
        }
        var i = 0
        while i < doc.nodes[m].keys.len {
            let key = doc.nodes[doc.nodes[m].keys[i]].text
            let v = doc.nodes[m].vals[i]
            if key == "iarg" || key == "count" {
                if fl_kind(doc, v) != FN_INT {
                    config_fail(mut c, "bind iarg must be an integer")
                    return
                }
                row.iarg = doc.nodes[v].num
            } else if key == "sarg" {
                if fl_kind(doc, v) != FN_STR {
                    config_fail(mut c, "bind sarg must be a string")
                    return
                }
                row.sarg = doc.nodes[v].text
                row.has_sarg = true
            } else {
                config_fail(mut c, "unknown bind argument '{key}'")
                return
            }
            i += 1
        }
    }
    let mode = doc.nodes[args[0]].text
    if mode == "*" {
        add_bind(mut c, MODE_L, copy row)
        add_bind(mut c, MODE_W, copy row)
        add_bind(mut c, MODE_B, row)
        return
    }
    let m = mode_letter(mode)
    if m < 0 {
        config_fail(mut c, "unknown editor mode '{mode}'")
        return
    }
    add_bind(mut c, m, row)
}

/// An empty load over `base`: no rows, no globals.
pub fn config_new(base: Opts) -> Config {
    var binds = List[List[BindRow]]()
    var m = 0
    while m < MODE_N {
        (mut binds).push(List[BindRow]())
        m += 1
    }
    Config { opts: copy base, binds: binds, globals: Map[str, str](), error: "" }
}

/// Run one configuration file's text on `c` (C runs the sources in order
/// into one option store and one bind ledger, `yew_config_load_all`,
/// `flconf.c:599-627`): `set`, `bind` and `let` statements in order. The
/// first error stops this file and is left in `c.error`.
pub fn config_apply(mut c: Config, src: List[byte]) {
    c.error = ""
    let doc = fl_read_calls(src)
    if doc.error.len != 0 {
        c.error = doc.error
        return
    }
    for call in doc.top {
        let name = doc.nodes[call].text
        if doc.nodes[call].kind == FN_LET {
            c.globals[name] = render_value(doc, doc.nodes[call].vals[0])
        } else if name == "set" {
            let args = copy doc.nodes[call].vals
            if args.len != 1 || fl_kind(doc, args[0]) != FN_MAP {
                config_fail(mut c, "set: expected one map")
                return
            }
            let map = args[0]
            var i = 0
            while i < doc.nodes[map].keys.len {
                set_option(
                    mut c,
                    doc,
                    doc.nodes[doc.nodes[map].keys[i]].text,
                    doc.nodes[map].vals[i],
                )
                i += 1
            }
        } else if name == "bind" {
            run_bind(mut c, doc, call)
        } else {
            config_fail(
                mut c,
                "{doc.nodes[call].line}:{doc.nodes[call].col}: '{name}' needs the Fletch config runtime (yw09)",
            )
        }
        if c.error.len != 0 {
            return
        }
    }
}

/// Run a configuration file's text over `base` (one source).
pub fn config_run(src: List[byte], base: Opts) -> Config {
    var c = config_new(base)
    config_apply(mut c, src)
    c
}

/// Read a file's bytes, or the error row.
pub fn config_read_file(path: str) -> List[byte] ! {missing} {
    let bytes = fs_read_bytes(path) else |_| {
        return missing
    }
    let _ = util.EXIT_OK
    bytes
}
