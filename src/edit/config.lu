//! edit.config — the option values new views and buffers start from.
//!
//! Sprint 36 retired the interim configuration reader this file held:
//! `runtime/init.fl` and the user's `init.fl` now run in the VM
//! (edit.flconf), `set()` writes the option store (edit.option) and
//! `bind()` the binding ledger (edit.bind). What stays is `Opts`, the
//! store's mirror of the values the port seeds a fresh window or buffer
//! with (`apply_win_opts`, the new-buffer `tabwidth` sites): the option
//! effects keep it current (`opt_changed_target`). C seeds a new view
//! from `yew_vp_init`'s constants and a new buffer from
//! `YEW_VP_TABWIDTH` (viewport.c:359-376, draw.c:139), which equal the
//! shipped `init.fl` values; under a user config that changes them the
//! port's seed follows the configured value, the port's existing
//! behaviour, and a named divergence (notes/yw09-fletch-in-the-editor.md).

/// The configured window and buffer seeds (the store's mirror).
pub struct Opts {
    tabwidth: int,
    wrap: bool,
    scrolloff: int,
    number_style: int,
    ambiguous_wide: bool,
    theme: str,
}

/// C's descriptor defaults (`option.c:213-330`).
pub fn opts_default() -> Opts {
    Opts {
        tabwidth: 4,
        wrap: false,
        scrolloff: 3,
        number_style: NUM_HYBRID,
        ambiguous_wide: false,
        theme: "quiver-dark",
    }
}
