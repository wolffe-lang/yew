//! edit.cmd — the named-command registry: one descriptor table, one
//! invoke choke point that keys, E mode, Fletch and the recorder reach.
//!
//! Ports sagitta `src/edit/cmd.c` (2,242 lines) and `cmd.h` (200) at
//! 9ace98c2, under `s13-keymap-engine.md` §3. **The shape (ruled at
//! launch, contract deliverable 1).** C's descriptor is a table row with a
//! function pointer (`CmdDesc.fn`, `cmd.h:137-160`) and the registry is a
//! process-global array. Module state of a run-time value is E1010;
//! mutable function values remain refused (G48, wolf-lang#917), although
//! s251 resolved G19/G20's cross-module failure. R-yw07-10 = A keeps a
//! single id/`match` representation. The port's registry is a VALUE
//! (`CmdReg`, threaded through `Ed`) of descriptor rows — names, arity,
//! flags, help, the recorder's word — each carrying an IMPLEMENTATION id
//! (`impl`, C's handler identity: two descriptors with one handler are an
//! alias pair) and a HANDLER KIND (a built-in implementation, a plugin's
//! Fletch closure (yw14), or a unit test's probe), and ONE invoke
//! (`ed_cmd_invoke`, `ed.lu`) that matches on the implementation id. The
//! built-in rows are C's own, generated from `cmd.c` into `cmdtab.lu`
//! (`tools/gen-cmdtab`), in C's order, so a command's id is C's.
//!
//! An id whose C handler campaign 03 has not ported answers C's deferred
//! shape (`YEW_CMD_ERR_DEFERRED`) with "not yet ported", its sagitta
//! sprint and its port lane, on the message line and in the log
//! (invariant 3: no silent stubs).

use util

/// Repeat the command `count` times (`YEW_CMD_REPEATABLE`, `cmd.h:113-126`).
pub const CMD_REPEATABLE: int = 1

/// The command reads the count itself (`YEW_CMD_TAKES_COUNT`).
pub const CMD_TAKES_COUNT: int = 2

/// The recorder records it; it has a recorder word (`YEW_CMD_RECORDABLE`).
pub const CMD_RECORDABLE: int = 4

/// It needs a window (`YEW_CMD_NEEDS_WIN`).
pub const CMD_NEEDS_WIN: int = 8

/// It changes the buffer (`YEW_CMD_CHANGES_BUFFER`).
pub const CMD_CHANGES_BUFFER: int = 16

/// It prompts (`YEW_CMD_PROMPTS`); registration adds `CMD_INTERACTIVE`.
pub const CMD_PROMPTS: int = 32

/// C itself defers it to a later sprint (`YEW_CMD_DEFERRED`).
pub const CMD_DEFERRED: int = 64

/// It consumes the cursor set instead of running per cursor.
pub const CMD_MULTI_AGGREGATE: int = 128

/// A binding without `sarg` captures the next text-producing key.
pub const CMD_CAPTURES_TEXT: int = 256

/// Keymap plumbing a typed E command may not name.
pub const CMD_INTERNAL: int = 512

/// It interacts with the user (`YEW_CMD_INTERACTIVE`).
pub const CMD_INTERACTIVE: int = 1024

const CMD_KNOWN_FLAGS: int = 2047

/// No argument (`CmdArity`, `cmd.h:105-111`).
pub const ARITY_NONE: int = 0

/// An integer argument.
pub const ARITY_INT: int = 1

/// A string argument.
pub const ARITY_STR: int = 2

/// An optional integer.
pub const ARITY_OPT_INT: int = 3

/// An optional string.
pub const ARITY_OPT_STR: int = 4

/// Success (`CmdStatus`, `cmd.h:95-101`).
pub const CMD_OK: int = 0

/// Bad arguments.
pub const CMD_ERR_ARG: int = 1

/// The editor's state refuses it.
pub const CMD_ERR_STATE: int = 2

/// An I/O failure.
pub const CMD_ERR_IO: int = 3

/// Not implemented yet: C's deferral, or the port's own.
pub const CMD_ERR_DEFERRED: int = 4

/// A key binding (`CmdSource`, `cmd.h:64-71`).
pub const SRC_KEY: int = 0

/// The E-mode command line.
pub const SRC_CMDLINE: int = 1

/// A Fletch call.
pub const SRC_FLETCH: int = 2

/// A macro replay.
pub const SRC_REPLAY: int = 3

/// The mouse.
pub const SRC_MOUSE: int = 4

/// A unit test.
pub const SRC_TEST: int = 5

/// A built-in implementation: `impl` names it.
pub const HANDLER_BUILTIN: int = 0

/// A plugin command (Fletch, yw14): refused until then.
pub const HANDLER_PLUGIN: int = 1

/// A unit test's probe: `ed_cmd_invoke` counts the call in the registry
/// (`CmdReg.probe_*`) and answers `CMD_OK` — the port's stand-in for the
/// test's C function (`test_cmdreg.c:23-36`).
pub const HANDLER_PROBE: int = 2

/// No record tap (`yew_cmd_set_record_tap(NULL)`).
pub const TAP_NONE: int = 0

/// The test's probe tap (`test_cmdreg.c:38-43`).
pub const TAP_PROBE: int = 1

/// The recorder's tap (Sprint 35, yw09).
pub const TAP_RECORDER: int = 2

/// A unit test's logging tap (`motion_tap`, `test_fl_motion.c:27-48`):
/// each recordable dispatch's context, copied into `CmdReg.tap_log`.
pub const TAP_LOG: int = 3

/// One dispatch a logging tap saw: C's `CmdRecordTap(id, cx)` arguments,
/// the string argument's bytes copied (`sarg`/`sarg_len`, binary-safe).
pub struct CmdTapEvent {
    id: int,
    count: int,
    count_given: bool,
    sarg: List[byte],
    source: int,
}

/// A descriptor to register (`CmdDesc`, `cmd.h:137-160`): C's `fn` is
/// `handler` + `impl` (or the probe's), and C's `NULL` word is
/// `has_word == false`.
pub struct CmdDesc {
    name: str,
    handler: int,
    impl_id: int,
    arity: int,
    flags: int,
    help: str,
    word: str,
    has_word: bool,
}

/// A registry row (`CmdEntry`, `cmd.h:162-170`): the descriptor, C's
/// handler name and file (an alias pair shares the handler), the E-mode
/// grammar (`argspec`, the range policy, an abbreviation) and whether it
/// is registered now.
pub struct CmdEntry {
    name: str,
    handler: int,
    impl_id: int,
    c_handler: str,
    c_file: str,
    arity: int,
    flags: int,
    help: str,
    word: str,
    has_word: bool,
    argspec: str,
    range_policy: int,
    abbrev: str,
    has_abbrev: bool,
    active: bool,
}

/// The registry (`CmdRegistry`, `cmd.c:58-69`) as a value: rows by id - 1,
/// names and words to ids, the active count, the record tap and the probe
/// tallies a unit test reads.
pub struct CmdReg {
    entries: List[CmdEntry],
    names: Map[str, int],
    words: Map[str, int],
    active_count: int,
    record_tap: int,
    tap_calls: int,
    tap_id: int,
    tap_count: int,
    probe_calls: int,
    probe_count: int,
    probe_invoked_id: int,
    tap_log: List[CmdTapEvent],
}

/// A line range (`CmdRange`, `cmd.h:24-30`).
pub struct CmdRange {
    kind: int,
    lo: int,
    hi: int,
    given: bool,
    // C's tok: source-token bounds for parsed lines, raw byte span for Fletch.
    tok_lo: int,
    tok_hi: int,
}

/// A cursor snapshot an aggregate command takes (`CmdCursorArg`).
pub struct CmdCursorArg {
    pos: int,
    anchor: int,
    goal_col: int,
}

/// The invocation context (`CmdCtx`, `cmd.h:73-93`): C's `Ed *` is the
/// `ed` every command takes beside it; `win` is a window index (-1: none);
/// C's `sarg`/`sarg_len` with `NULL` is `sarg` with `has_sarg`.
pub struct CmdCtx {
    win: int,
    invoked_id: int,
    range: CmdRange,
    argv: List[str],
    cursor_index: int,
    cursor_given: bool,
    count: int,
    count_given: bool,
    bang: bool,
    iarg: int,
    sarg: str,
    has_sarg: bool,
    sbytes: List[byte],
    has_sbytes: bool,
    cursor_args: List[CmdCursorArg],
    // The option commands' resolved value in and out (C's opt_in, opt_out,
    // opt_error and opt_error_msg, cmd.h:89-92; Sprint 36).
    opt_in: OptVal,
    has_opt_in: bool,
    opt_out: OptVal,
    has_opt_out: bool,
    opt_error: int,
    opt_error_msg: str,
    source: int,
}

/// `YEW_OPT_ERROR_NONE` (cmd.h:96-100).
pub const OPT_ERROR_NONE: int = 0

/// The option name is unknown.
pub const OPT_ERROR_NAME: int = 1

/// The value does not fit the option.
pub const OPT_ERROR_TYPE: int = 2

/// A context for one run of a command: count 1, no argument, `source`.
pub fn cmdctx_new(win: int, source: int) -> CmdCtx {
    CmdCtx {
        win: win,
        invoked_id: 0,
        range: CmdRange { kind: 0, lo: 0, hi: 0, given: false, tok_lo: 0, tok_hi: 0 },
        argv: List[str](),
        cursor_index: 0,
        cursor_given: false,
        count: 1,
        count_given: false,
        bang: false,
        iarg: 0,
        sarg: "",
        has_sarg: false,
        sbytes: List[byte](),
        has_sbytes: false,
        cursor_args: List[CmdCursorArg](),
        opt_in: optv_bool(false),
        has_opt_in: false,
        opt_out: optv_bool(false),
        has_opt_out: false,
        opt_error: OPT_ERROR_NONE,
        opt_error_msg: "",
        source: source,
    }
}

/// An empty registry (`yew_cmd_shutdown`'s state).
pub fn cmdreg_empty() -> CmdReg {
    CmdReg {
        entries: List[CmdEntry](),
        names: Map[str, int](),
        words: Map[str, int](),
        active_count: 0,
        record_tap: TAP_NONE,
        tap_calls: 0,
        tap_id: 0,
        tap_count: 0,
        probe_calls: 0,
        probe_count: 0,
        probe_invoked_id: 0,
        tap_log: List[CmdTapEvent](),
    }
}

fn word_in(word: str, words: str) -> bool {
    for w in words.words() {
        if w == word {
            return true
        }
    }
    false
}

fn app_verbs() -> str {
    "quit quit_force suspend redraw repeat nop map"
}

fn domains() -> str {
    "move edit mode sel cursor view ui file buf tab group pane win reg search macro job git lsp ai plug cmdline del shell opt fl config syn theme shadow compl prof clip jump change mark find ws undo mouse"
}

// `command_name_valid`'s verbs (`cmd.c:1520-1620`), in C's order.
fn verbs() -> str {
    """
home end next prev up down left right copy cut goto insert delete replace change yank paste toggle
open close save new enter leave grow shrink expand contract list reload cancel text undo redo escape
add above below center message_expand split_h split_v open_split_h open_split_v record stop name
split_left split_right split_down replay replay_last stage map first_nonblank last_nonblank
half_page_up half_page_down page_up page_down after newline tab grapheme_left grapheme undo_barrier
open_above open_below top bottom goto_line toggle_wrap number_style next_alt prev_alt home_alt
end_alt match_prev match_next sub_prev sub_next kind swap_ends lines matches ends drop collapse
case_upper case_lower case_toggle indent dedent shift_left shift_right join replace_char append
write write_quit hist_prev hist_next complete_next complete_prev insert_register literal_next
accept word_prev to_home to_end page_next page_prev dismiss command run run_bg read filter term
kill kill_force jump clear_finished rerun back fwd older newer global open_back word_next
clear_highlight set split_h split_v focus_left focus_right focus_up focus_down focus_next
focus_prev move dissolve remove_tab from_dir edit save_state restore_state info forget migrate
file buffer branches symbol close_others copy_path rename context_menu add_tab enable disable at
span unit up_alt down_alt get eval set_many split focus closure reload status stats accept_word
accept_word_alt accept_line accept_all doc_toggle reindex log restart diagnostics diag_next
diag_prev goto_def goto_decl goto_type goto_impl references hover symbols signature complete
backends models ping privacy preset abort actions all amend arm blame cherry_pick commit continue
create diff discard fetch first force hidden history init interactive last merge parent pop pull
push reflog refresh reset revert row_next row_prev switch tag unstage view ours theirs report dump
frames mark goto_bar number_cycle save_as apply confirm home_toggle accept_or_word term_run chars
words upper_word lower_word cap_word complete_forget ws_word_prev yank_pop last_arg line_home
line_end copy_or_cancel hist_search token_prev token_next toggle_sudo man_page edit_in_buffer
"""
}

fn is_lower(c: int) -> bool {
    c >= 97 && c <= 122
}

fn is_digit(c: int) -> bool {
    c >= 48 && c <= 57
}

// `plugin_command_token_valid` (`cmd.c:1463-1481`): `[a-z][a-z0-9_]*`,
// at most 32 bytes.
fn plugin_token_valid(token: str) -> bool {
    if token.len == 0 || token.len > 32 {
        return false
    }
    var i = 0
    for b in token.bytes() {
        let c = b as int
        if i == 0 && !is_lower(c) {
            return false
        }
        if i > 0 && !is_lower(c) && !is_digit(c) && c != 95 {
            return false
        }
        i += 1
    }
    true
}

// `plugin_command_name_valid` (`cmd.c:1483-1502`): `ed.plug.<a>.<b>`.
fn plugin_name_valid(name: str) -> bool {
    if !name.starts_with("ed.plug.") {
        return false
    }
    let rest = name[8..]
    let dot = rest.find(".") else -1
    if dot < 0 {
        return false
    }
    plugin_token_valid(rest[0..dot]) && plugin_token_valid(rest[dot + 1..])
}

/// `command_name_valid` (`cmd.c:1504-1671`): `ed.<verb>` for the seven
/// application verbs, else `ed.<domain>.<…>.<verb>` of three or four
/// segments, each `[a-z][a-z0-9_]{0,15}`.
pub fn cmd_name_valid(name: str) -> bool {
    if plugin_name_valid(name) {
        return true
    }
    let segs = name.split(".")
    if segs.len > 4 {
        return false
    }
    for seg in segs {
        if seg.len == 0 || seg.len > 16 {
            return false
        }
        var i = 0
        for b in seg.bytes() {
            let c = b as int
            if i == 0 && !is_lower(c) {
                return false
            }
            if i > 0 && !is_lower(c) && !is_digit(c) && c != 95 {
                return false
            }
            i += 1
        }
    }
    if segs[0] != "ed" {
        return false
    }
    if segs.len == 2 {
        return word_in(segs[1], app_verbs())
    }
    if segs.len != 3 && segs.len != 4 || !word_in(segs[1], domains()) {
        return false
    }
    word_in(segs[segs.len - 1], verbs())
}

// `help_names_sprint` (`cmd.c:1673-1684`): "Sprint " then a digit.
fn help_names_sprint(help: str) -> bool {
    let at = help.find("Sprint ") else -1
    if at < 0 || at + 7 >= help.len {
        return false
    }
    is_digit(help.bytes()[at + 7] as int)
}

// `cmdword_is_motion_syntax` (`cmd.c:1686-1692`).
fn word_is_motion_syntax(word: str) -> bool {
    word_in(word, "l w b c v av del esc")
}

// `word_validate` (`cmd.c:1704-1733`): what YEW_BUG would say, or "".
fn word_problem(d: CmdDesc) -> str {
    if d.flags & CMD_RECORDABLE != 0 && !d.has_word {
        return "recordable command {d.name} has no CMDWORD"
    }
    if !d.has_word {
        return ""
    }
    if d.flags & CMD_RECORDABLE == 0 {
        return "command {d.name} has a CMDWORD but is not recordable"
    }
    let w = d.word
    if w.len == 0 || w.len > 16 {
        return "command {d.name} has a CMDWORD of bad length"
    }
    if !is_lower(w.bytes()[0] as int) {
        return "command {d.name} CMDWORD must start with a letter"
    }
    var i = 0
    for b in w.bytes() {
        let c = b as int
        if i > 0 && !is_lower(c) && !is_digit(c) && c != 95 {
            return "command {d.name} has an invalid CMDWORD"
        }
        i += 1
    }
    if word_is_motion_syntax(w) {
        return "command {d.name} CMDWORD is reserved motion syntax"
    }
    ""
}

/// `desc_validate` (`cmd.c:1735-1767`): the message C's `YEW_BUG` would
/// print for `d`, or "" when the descriptor is sound. Registration calls
/// it and exits `EXIT_BUG` on a message; the tests read it directly.
pub fn cmd_desc_problem(d: CmdDesc) -> str {
    if !cmd_name_valid(d.name) {
        return "invalid command name: {d.name}"
    }
    if d.handler == HANDLER_BUILTIN && d.impl_id <= 0 {
        return "command {d.name} has no implementation"
    }
    if d.arity < 0 || d.arity > ARITY_OPT_STR {
        return "command {d.name} has invalid arity {d.arity}"
    }
    if d.flags & !CMD_KNOWN_FLAGS != 0 {
        return "command {d.name} has unknown flags"
    }
    if d.flags & CMD_REPEATABLE != 0 && d.flags & CMD_TAKES_COUNT != 0 {
        return "command {d.name} is both REPEATABLE and TAKES_COUNT"
    }
    if d.flags & CMD_CAPTURES_TEXT != 0 && d.arity != ARITY_STR {
        return "command {d.name} captures text without string arity"
    }
    if d.help.len == 0 {
        return "command {d.name} has empty help"
    }
    if d.flags & CMD_DEFERRED != 0 && !help_names_sprint(d.help) {
        return "deferred command {d.name} help does not name its sprint"
    }
    word_problem(d)
}

fn argspec_problem(name: str, argspec: str, abbrev: str, has_abbrev: bool) -> str {
    let n = argspec.len
    var i = 0
    for b in argspec.bytes() {
        let c = b as int
        let ok = c == 102 ||
            c == 98 ||
            c == 111 ||
            c == 118 ||
            c == 112 ||
            c == 115 ||
            c == 42 && i == n - 1
        if !ok {
            return "command {name} has invalid argspec"
        }
        i += 1
    }
    if has_abbrev {
        if abbrev.len == 0 {
            return "command {name} has empty abbreviation"
        }
        for b in abbrev.bytes() {
            let c = b as int
            if !is_lower(c) && !is_digit(c) && !(c >= 65 && c <= 90) && c != 95 {
                return "command {name} has invalid abbreviation"
            }
        }
    }
    ""
}

/// What `YEW_BUG` would say registering `d` into `reg` now, or "": an
/// invalid descriptor (`cmd_desc_problem`), a live duplicate name, or a
/// live command already owning `d`'s word (`register_entry`,
/// `cmd.c:1803-1866`). Registration calls it and exits `EXIT_BUG` on a
/// message; the tests read it directly (C forks a child per case,
/// `test_cmdreg.c:323-348`).
pub fn cmd_register_problem(reg: CmdReg, d: CmdDesc) -> str {
    let problem = cmd_desc_problem(d)
    if problem.len != 0 {
        return problem
    }
    let id = reg.names[d.name] else 0
    if id != 0 && reg.entries[id - 1].active {
        return "duplicate command registration: {d.name}"
    }
    if d.has_word {
        let owner = reg.words[d.word] else 0
        let mine = if id != 0 then id else reg.entries.len + 1
        if owner != 0 && owner != mine && reg.entries[owner - 1].active {
            return "duplicate CMDWORD '{d.word}' on {d.name}"
        }
    }
    ""
}

/// `register_entry` (`cmd.c:1803-1866`): a fresh name takes the next id; a
/// name registered before and since unregistered takes its old id back; a
/// live duplicate, a live word collision or an invalid row is `YEW_BUG`.
/// Answers the id.
pub fn cmd_register_entry(
    mut reg: CmdReg,
    d: CmdDesc,
    c_handler: str,
    c_file: str,
    argspec_in: str,
    has_argspec: bool,
    range_policy: int,
    abbrev: str,
    has_abbrev: bool,
) -> int {
    let problem = cmd_register_problem(reg, d)
    if problem.len != 0 {
        bug(problem)
    }
    if range_policy < 0 || range_policy > 4 {
        bug("command {d.name} has invalid range policy")
    }
    let argspec = if has_argspec then argspec_in else if d.arity == ARITY_NONE then "" else "s"
    let ap = argspec_problem(d.name, argspec, abbrev, has_abbrev)
    if ap.len != 0 {
        bug(ap)
    }
    var id = reg.names[d.name] else 0
    if id == 0 {
        id = reg.entries.len + 1
    }
    var flags = d.flags
    if flags & CMD_PROMPTS != 0 {
        flags = flags | CMD_INTERACTIVE
    }
    if d.has_word {
        reg.words[d.word] = id
    }
    let e = CmdEntry {
        name: d.name,
        handler: d.handler,
        impl_id: d.impl_id,
        c_handler: c_handler,
        c_file: c_file,
        arity: d.arity,
        flags: flags,
        help: d.help,
        word: d.word,
        has_word: d.has_word,
        argspec: argspec,
        range_policy: range_policy,
        abbrev: abbrev,
        has_abbrev: has_abbrev,
        active: true,
    }
    if id == reg.entries.len + 1 {
        (mut reg.entries).push(e)
        reg.names[d.name] = id
    } else {
        reg.entries[id - 1] = e
    }
    reg.active_count += 1
    id
}

/// `yew_cmd_register` (`cmd.c:1927-1931`): a descriptor with C's default
/// E grammar.
pub fn cmd_register(mut reg: CmdReg, d: CmdDesc) -> int {
    let handler_name = if d.handler == HANDLER_PROBE then "probe" else "builtin"
    cmd_register_entry(mut reg, d, handler_name, "", "", false, 0, "", false)
}

/// `yew_cmd_register_plugin_flags` (`cmd.c:1953-2024`): `ed.plug.<plugin>.
/// <local>`, recordable with `local` as its word. Answers (ok, id, error).
pub fn cmd_register_plugin_flags(
    mut reg: CmdReg,
    plugin: str,
    local: str,
    handler: int,
    help: str,
    flags: int,
) -> (bool, int, str) {
    let allowed = CMD_REPEATABLE |
        CMD_TAKES_COUNT |
        CMD_NEEDS_WIN |
        CMD_CHANGES_BUFFER |
        CMD_PROMPTS
    if !plugin_token_valid(plugin) || !plugin_token_valid(local) {
        return (false, 0, "invalid plugin command name")
    }
    if local.len > 16 || word_is_motion_syntax(local) {
        return (false, 0, "plugin command name is not a valid CMDWORD")
    }
    if help.len == 0 {
        return (false, 0, "invalid plugin command descriptor")
    }
    if flags & !allowed != 0 || flags & CMD_REPEATABLE != 0 && flags & CMD_TAKES_COUNT != 0 {
        return (false, 0, "invalid plugin command flags")
    }
    let name = "ed.plug.{plugin}.{local}"
    if cmd_lookup(reg, name) != 0 {
        return (false, 0, "plugin command already registered")
    }
    if cmd_by_word(reg, local) != 0 {
        return (false, 0, "plugin command CMDWORD already registered")
    }
    let d = CmdDesc {
        name: name,
        handler: handler,
        impl_id: 0,
        arity: ARITY_NONE,
        flags: flags | CMD_RECORDABLE,
        help: help,
        word: local,
        has_word: true,
    }
    (true, cmd_register(mut reg, d), "")
}

/// `yew_cmd_unregister` (`cmd.c:2034-2043`).
pub fn cmd_unregister(mut reg: CmdReg, id: int) -> bool {
    if id <= 0 || id > reg.entries.len || !reg.entries[id - 1].active {
        return false
    }
    reg.entries[id - 1].active = false
    reg.active_count -= 1
    true
}

/// `yew_cmd_lookup` (`cmd.c:2045-2061`): the live id named `name`, or 0.
pub fn cmd_lookup(reg: CmdReg, name: str) -> int {
    let id = reg.names[name] else 0
    if id == 0 || id > reg.entries.len || !reg.entries[id - 1].active {
        return 0
    }
    id
}

/// `yew_cmd_by_word` (`cmd.c:2063-2080`): the live id whose recorder word
/// is `word`, or 0.
pub fn cmd_by_word(reg: CmdReg, word: str) -> int {
    if word.len == 0 {
        return 0
    }
    let id = reg.words[word] else 0
    if !cmd_active(reg, id) {
        return 0
    }
    if !reg.entries[id - 1].has_word || reg.entries[id - 1].word != word {
        return 0
    }
    id
}

/// Whether `id` is registered now (C's `yew_cmd_desc(id) != NULL`).
pub fn cmd_active(reg: CmdReg, id: int) -> bool {
    id > 0 && id <= reg.entries.len && reg.entries[id - 1].active
}

/// `yew_cmd_count` (`cmd.c:2218-2222`): every id ever handed out.
pub fn cmd_count(reg: CmdReg) -> int {
    reg.entries.len
}

/// `yew_cmd_active_count` (`cmd.c:2224-2228`).
pub fn cmd_active_count(reg: CmdReg) -> int {
    reg.active_count
}

/// The row of a live id (C's `yew_cmd_entry`); the caller checks
/// `cmd_active` first.
pub fn cmd_entry(reg: CmdReg, id: int) -> CmdEntry {
    copy reg.entries[id - 1]
}

/// `yew_cmd_set_record_tap` (`cmd.c:2238-2242`).
pub fn cmd_set_record_tap(mut reg: CmdReg, tap: int) {
    reg.record_tap = tap
}

fn field(row: str, n: int) -> str {
    var i = 0
    for f in row.split("\x1f") {
        if i == n {
            return f
        }
        i += 1
    }
    ""
}

/// `yew_cmd_init` (`cmd.c:1900-1913`): the built-in rows, in C's order,
/// each validated as C validates it; then `install_builtin_meta`'s E-mode
/// grammar (`cmd.c:1878-1898`), which the generated rows carry inline.
pub fn cmdreg_builtin() -> CmdReg {
    var reg = cmdreg_empty()
    for row in CMDTAB.lines() {
        if row.len == 0 {
            continue
        }
        let name = field(row, 0)
        let c_handler = field(row, 1)
        let word = field(row, 5)
        let meta = field(row, 6)
        let d = CmdDesc {
            name: name,
            handler: HANDLER_BUILTIN,
            impl_id: impl_of_handler(c_handler),
            arity: field(row, 2).to_int() else -1,
            flags: field(row, 3).to_int() else -1,
            help: field(row, 4),
            word: word,
            has_word: word.len != 0,
        }
        var argspec = ""
        var has_argspec = false
        var range_policy = 0
        var abbrev = ""
        var has_abbrev = false
        if meta.len != 0 {
            let parts = meta.split("^")
            argspec = parts[0]
            has_argspec = true
            range_policy = parts[1].to_int() else -1
            abbrev = parts[2]
            has_abbrev = abbrev.len != 0
        }
        let _ = cmd_register_entry(
            mut reg,
            d,
            c_handler,
            field(row, 7),
            argspec,
            has_argspec,
            range_policy,
            abbrev,
            has_abbrev,
        )
    }
    reg
}

fn args_valid(e: CmdEntry, cx: CmdCtx) -> bool {
    if cx.source < SRC_KEY || cx.source > SRC_TEST || cx.count <= 0 {
        return false
    }
    match e.arity {
        0 => !cx.has_sarg,
        1 => !cx.has_sarg,
        3 => !cx.has_sarg,
        2 => cx.has_sarg,
        4 => cx.iarg == 0,
        _ => false,
    }
}

// `command_fail` (`cmd.c:2122-2127`).
fn command_fail(name: str, reason: str, status: int) -> int {
    util.log_at(util.LOG_ERROR, "command failed: {name}: {reason}")
    status
}

// `deferred_sprint` (`cmd.c:2129-2142`): the digits after "Sprint ".
fn deferred_sprint(help: str) -> str {
    let at = help.find("Sprint ") else -1
    if at < 0 {
        return ""
    }
    var end = at + 7
    while end < help.len && is_digit(help.bytes()[end] as int) {
        end += 1
    }
    help[at + 7..end]
}

/// `command_deferred` (`cmd.c:2144-2169`): C's own deferral.
pub fn cmd_deferred_message(e: CmdEntry) -> str {
    "command not implemented yet: {e.name} lands in Sprint {deferred_sprint(e.help)}"
}

/// `yew_cmd_prepare` (`cmd.c:2171-2198`) up to the record tap: the window
/// check, the internal-command check, C's deferral, the arity. Answers the
/// status; `CMD_OK` means the caller runs it.
pub fn cmd_prepare(mut reg: CmdReg, id: int, cx: CmdCtx) -> int {
    if !cmd_active(reg, id) {
        return CMD_ERR_ARG
    }
    let name = reg.entries[id - 1].name
    let flags = reg.entries[id - 1].flags
    if flags & CMD_NEEDS_WIN != 0 && cx.win < 0 {
        return command_fail(name, "no window", CMD_ERR_STATE)
    }
    if flags & CMD_INTERNAL != 0 && cx.source == SRC_CMDLINE {
        return command_fail(name, "internal E command", CMD_ERR_ARG)
    }
    if flags & CMD_DEFERRED != 0 {
        util.log_at(util.LOG_ERROR, cmd_deferred_message(reg.entries[id - 1]))
        return CMD_ERR_DEFERRED
    }
    if !args_valid(reg.entries[id - 1], cx) {
        return command_fail(name, "invalid arguments", CMD_ERR_ARG)
    }
    CMD_OK
}

/// A unit test's tap (TAP_PROBE or TAP_LOG) seeing one recordable
/// dispatch: the tallies, and for the logging tap the context's copy.
/// The recorder's own tap and the preflight before any tap are
/// edit.record's (`cmd_prepare_ed`, cmd.c:2188-2195).
pub fn cmd_test_tap(mut reg: CmdReg, id: int, cx: CmdCtx) {
    if reg.record_tap == TAP_LOG {
        (mut reg.tap_log).push(CmdTapEvent {
            id: id,
            count: cx.count,
            count_given: cx.count_given,
            sarg: if cx.has_sbytes then copy cx.sbytes else bytes_of(cx.sarg),
            source: cx.source,
        })
    }
    reg.tap_calls += 1
    reg.tap_id = id
    reg.tap_count = cx.count
}

/// The sagitta sprint and port lane that own a C handler's file, for the
/// "not yet ported" refusal (`docs/MAP.md` §2-§3).
pub fn cmd_owner(c_file: str) -> (str, str) {
    if c_file.starts_with("src/mod/git/") {
        return ("51 (FUSS and git)", "yw13")
    }
    if c_file.starts_with("src/mod/ai/") {
        return ("48 (AI)", "yw12")
    }
    if c_file.starts_with("src/mod/plug/") {
        return ("54 (plugins)", "yw14")
    }
    match c_file {
        "src/edit/bind.c" => ("36 (bind)", "yw09"),
        "src/edit/flapi_cmds.c" => ("34 (editor handles)", "yw09"),
        "src/edit/jumplist.c" => ("21 (jumps and changes)", "yw04"),
        "src/edit/lsp_cmds.c" => ("46 (LSP)", "yw11"),
        "src/edit/option.c" => ("36 (options)", "yw09"),
        "src/edit/pane_cmds.c" => ("22 (panes)", "yw05"),
        "src/edit/prof_cmds.c" => ("56 (the profiler)", "yw15"),
        "src/edit/readline_cmds.c" => ("57.21 (the readline insert keys)", "yw04"),
        "src/edit/search_cmds.c" => ("20 (search)", "yw04"),
        "src/edit/shadow_cmds.c" => ("43 (shadow completion)", "yw11"),
        "src/edit/shell_cmds.c" => ("19 (shell jobs)", "yw04"),
        "src/edit/theme_cmds.c" => ("40 (themes)", "yw10"),
        "src/edit/ws_cmds.c" => ("25 (workspace state)", "yw06"),
        "src/fl/flconf.c" => ("36 (configuration)", "yw09"),
        "src/fl/record.c" => ("35 (the recorder)", "yw09"),
        "src/ui/cmdedit.c" => ("57.31 (edit in buffer)", "yw04"),
        "src/ui/cmdline.c" => ("18 (the command line)", "yw04"),
        "src/ui/comphelp.c" => ("57.25 (completion help)", "yw04"),
        "src/ui/complmenu.c" => ("44 (the completion menu)", "yw11"),
        "src/ui/groupfromdir.c" => ("24 (groups)", "yw05"),
        "src/ui/groupnav.c" => ("24 (groups)", "yw05"),
        "src/ui/grouppicker.c" => ("24 (groups)", "yw05"),
        "src/ui/macrobrowse.c" => ("38 (the macro browser)", "yw09"),
        "src/ui/mouse.c" => ("27 (the mouse)", "yw06"),
        "src/ui/panel.c" => ("47 (floating panels)", "yw11"),
        "src/ui/pickers.c" => ("26 (pickers)", "yw06"),
        "src/ui/tabs.c" => ("23 (tabs)", "yw05"),
        "src/edit/cmd.c" => ("39 (highlighting)", "yw10"),
        _ => ("?", "?"),
    }
}

/// The sagitta sprint and port lane that own one command: its C file's
/// (`cmd_owner`), except `ed.fl.eval` — s18's `:fl` slot, whose handler
/// sits in `option.c` (`option.c:1902-1907`) but which waited for Sprint
/// 32's persistent runtime (`s18-cmdline.md:37`), campaign 06's second
/// lane (the yw04 contract: `:fl` refuses naming yw08).
pub fn cmd_entry_owner(e: CmdEntry) -> (str, str) {
    if e.name == "ed.fl.eval" {
        return ("32 (the REPL and errors)", "yw08")
    }
    cmd_owner(e.c_file)
}

/// The port's own refusal for a command whose C handler is not ported
/// yet: "not yet ported: NAME: sagitta Sprint N (LANE)".
pub fn cmd_unported_message(e: CmdEntry) -> str {
    let (sprint, lane) = cmd_entry_owner(e)
    "not yet ported: {e.name}: sagitta Sprint {sprint} ({lane})"
}
