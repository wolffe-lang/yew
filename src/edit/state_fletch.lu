//! edit.state_fletch — workspace state read through the real Fletch
//! pure-literal reader, sagitta 9ace98c2 src/ws/state_fletch.c:1-234
//! (`yew_fl_parse_fletch`): fl.data's value tree adapted to v1's literal
//! tree (ws.FlDoc), so the mapper (edit.state_parse) is unchanged. The
//! first error keeps the legacy codec's position for the four messages
//! whose Fletch span differs (state_diag_sink, :19-79). Sprint 36 swapped
//! the state path onto it (state_parse.c:1021); yw06's hand codec
//! (ws.fl_parse) stays for the tools and as fl_data_test's control.

use fl
use ws

/// FlParseErr's three fields the recovery reason prints.
pub struct StateFlErr { line: int, col: int, msg: str }

fn sf_has(msg: str, part: str) -> bool { msg.contains(part) }

// state_diag_sink (state_fletch.c:19-79): the legacy codec's position.
fn sf_position(src: List[byte], sp: fl.FlSpan, msg: str) -> (int, int) {
    var line = sp.line
    var col = sp.col
    if sf_has(msg, "integer literal does not fit") {
        var at = 0
        var ln = 1
        var here = 1
        while at < src.len && (ln < sp.line || here < sp.col) {
            let c = src[at]
            at += 1
            if c == 10 as byte {
                ln += 1
                here = 1
            } else {
                here += 1
            }
        }
        if at < src.len && src[at] == '-' as int as byte {
            at += 1
            col += 1
        }
        while at < src.len && src[at] >= '0' as int as byte && src[at] <= '9' as int as byte {
            at += 1
            col += 1
        }
    } else if sf_has(msg, "unknown escape in string literal") {
        col += 2
    } else if sf_has(msg, "expected ':', found 'identifier'") {
        col += 1
    } else if sf_has(msg, "unterminated string literal") ||
        sf_has(msg, "newline in string literal") {
        line = 1
        col = 1
        for c in src {
            if c == 10 as byte {
                line += 1
                col = 1
            } else {
                col += 1
            }
        }
    }
    (line, col)
}

// state_value_to_lit (state_fletch.c:129-192): none for a float, a
// runtime value, or a map key that is not a string.
fn sf_lit(vm: fl.FlVm, mut doc: ws.FlDoc, v: fl.FlValue) -> int ! {none} {
    let id = doc.nodes.len
    var lit = ws.FlLit {
        kind: ws.FL_NIL,
        num: 0,
        text: ws.FlSpan { at: 0, len: 0 },
        items: List[int](),
        keys: List[ws.FlSpan](),
    }
    if v.t == fl.FL_NIL {
        (mut doc.nodes).push(lit)
        return id
    }
    if v.t == fl.FL_BOOL || v.t == fl.FL_INT {
        lit.kind = if v.t == fl.FL_BOOL then ws.FL_BOOL else ws.FL_INT
        lit.num = v.i
        (mut doc.nodes).push(lit)
        return id
    }
    if v.t == fl.FL_STR {
        let at = fl.fl_obj_index(vm, v)
        lit.kind = ws.FL_STR
        lit.text = ws.FlSpan { at: doc.bytes.len, len: vm.gc.slots[at].bytes.len }
        for b in vm.gc.slots[at].bytes { (mut doc.bytes).push(b) }
        (mut doc.nodes).push(lit)
        return id
    }
    if v.t == fl.FL_LIST {
        lit.kind = ws.FL_LIST
        (mut doc.nodes).push(lit)
        for i in 0..fl.fl_list_len(vm, v) {
            let item = fl.fl_list_get(vm, v, i)?
            let child = sf_lit(vm, mut doc, item)?
            (mut doc.nodes[id].items).push(child)
        }
        return id
    }
    if v.t == fl.FL_MAP {
        lit.kind = ws.FL_MAP
        (mut doc.nodes).push(lit)
        var cursor = 0
        loop {
            let (next, key, val) = fl.fl_map_iter(vm, v, cursor) else break
            cursor = next
            if key.t != fl.FL_STR { return none }
            let at = fl.fl_obj_index(vm, key)
            let span = ws.FlSpan { at: doc.bytes.len, len: vm.gc.slots[at].bytes.len }
            for b in vm.gc.slots[at].bytes { (mut doc.bytes).push(b) }
            let child = sf_lit(vm, mut doc, val)?
            (mut doc.nodes[id].keys).push(span)
            (mut doc.nodes[id].items).push(child)
        }
        return id
    }
    // The frozen workspace schema has no floats or runtime values.
    none
}

/// `yew_fl_parse_fletch` (state_fletch.c:194-234): (read, doc, first
/// error). A clean read of a non-schema value is C's 1:1 refusal.
pub fn state_parse_fletch(src: List[byte]) -> (bool, ws.FlDoc, StateFlErr) {
    var err = StateFlErr { line: 0, col: 0, msg: "" }
    var vm = fl.fl_vm_new(take fl.fl_strings())
    var dc = fl.fl_diag_init()
    let v = fl.fl_data_read(mut vm, src, mut dc)
    var doc = ws.fl_doc()
    if fl.fl_diag_errors(dc) != 0 {
        for d in dc.entries {
            if d.level != fl.FL_DIAG_ERROR { continue }
            let (line, col) = sf_position(src, d.sp, d.msg)
            err = StateFlErr { line: line, col: col, msg: d.msg }
            break
        }
        return (false, doc, err)
    }
    let root = sf_lit(vm, mut doc, v) else {
        err = StateFlErr { line: 1, col: 1, msg: "workspace state contains a non-schema literal" }
        return (false, ws.fl_doc(), err)
    }
    doc.root = root
    (true, doc, err)
}
