//! edit.pairs — auto-pairing in I mode: an opener inserts its closer, a
//! typed closer steps over the remembered one, one Backspace takes an
//! empty pair.
//!
//! Ports sagitta `src/edit/pairs.c` (316 lines) and `pairs.h` at
//! 9ace98c2, under `s57.16` (campaign 05's field repairs in the map, but
//! `runtime/init.fl` sets `autopair: true`, so every I-mode bracket or
//! quote a campaign-03 user types goes through it; ported here so typing
//! is byte-identical). The remembered closers ride the buffer's marks
//! with right bias; the per-language tables key on the buffer's language,
//! which is none until yw10, so the default table holds; the string-or-
//! comment query is the syntax engine's (inert until yw10, `block.lu`).

use text

const PAIR_STACK_MAX: int = 32

/// The remembered closers (`PairState`, `pairs.h:12-30`).
pub struct PairState {
    marks: List[text.MarkId],
    closers: List[int],
    syn_line: int,
    syn_lines: int,
    syn_in: bool,
    syn_valid: bool,
}

/// No pairs remembered.
pub fn pairstate_new() -> PairState {
    PairState {
        marks: List[text.MarkId](),
        closers: List[int](),
        syn_line: 0,
        syn_lines: 0,
        syn_in: false,
        syn_valid: false,
    }
}

/// No pairing (`YEW_PAIR_LITERAL`).
pub const PAIR_LITERAL: int = 0

/// Insert the closer too (`YEW_PAIR_CLOSE`).
pub const PAIR_CLOSE: int = 1

/// Step over the remembered closer (`YEW_PAIR_SKIP`).
pub const PAIR_SKIP: int = 2

/// `yew_pairs_interesting` (`pairs.c:60-76`).
pub fn pairs_interesting(byte_value: int) -> bool {
    byte_value == 40 ||
        byte_value == 41 ||
        byte_value == 91 ||
        byte_value == 93 ||
        byte_value == 123 ||
        byte_value == 125 ||
        byte_value == 34 ||
        byte_value == 39 ||
        byte_value == 96
}

// `pairs_default` (`pairs.c:25-29`): ( [ { " '.
fn table_close(open: int) -> int {
    match open {
        40 => 41,
        91 => 93,
        123 => 125,
        34 => 34,
        39 => 39,
        _ => -1,
    }
}

fn table_open_of(close: int) -> int {
    match close {
        41 => 40,
        93 => 91,
        125 => 123,
        34 => 34,
        39 => 39,
        _ => -1,
    }
}

fn byte_at(tb: text.TextBuf, off: int) -> int {
    if off < 0 || off >= text.textbuf_len(tb) {
        return -1
    }
    text.textbuf_byte_at(tb, off)
}

fn word_byte(b: int) -> bool {
    b >= 97 && b <= 122 || b >= 65 && b <= 90 || b >= 48 && b <= 57 || b == 95 || b >= 128
}

fn drop_at(mut b: Buffer, at: int) {
    let id = copy b.pairs.marks[at]
    if text.mark_alive(b.ec.marks, copy id) {
        text.mark_del(mut b.ec.marks, id)
    }
    var ms = List[text.MarkId]()
    var cs = List[int]()
    var i = 0
    while i < b.pairs.marks.len {
        if i != at {
            (mut ms).push(copy b.pairs.marks[i])
            (mut cs).push(b.pairs.closers[i])
        }
        i += 1
    }
    b.pairs.marks = ms
    b.pairs.closers = cs
}

/// `yew_pairs_clear` (`pairs.c:118-124`).
pub fn pairs_clear(mut b: Buffer) {
    while b.pairs.marks.len != 0 {
        drop_at(mut b, b.pairs.marks.len - 1)
    }
    b.pairs.syn_valid = false
}

/// `yew_pairs_note_edit` (`pairs.c:126-133`).
pub fn pairs_note_edit(mut b: Buffer, line: int) {
    if !b.resident || !b.pairs.syn_valid {
        return
    }
    if b.pairs.syn_line == line || b.pairs.syn_lines != text.textbuf_line_count(b.ec.tb) {
        b.pairs.syn_valid = false
    }
}

// `pairs_in_string_or_comment` (`pairs.c:135-158`): the syntax engine's
// answer, cached per line; none until yw10.
fn in_string_or_comment(mut b: Buffer, at: int) -> bool {
    let line = text.textbuf_line_of(b.ec.tb, at as text.ByteOff) as int
    let lines = text.textbuf_line_count(b.ec.tb)
    if b.pairs.syn_valid && b.pairs.syn_line == line && b.pairs.syn_lines == lines {
        return b.pairs.syn_in
    }
    b.pairs.syn_in = syn_in_string_or_comment(unitctx_buf(b.tabwidth, false), at)
    b.pairs.syn_line = line
    b.pairs.syn_lines = lines
    b.pairs.syn_valid = true
    b.pairs.syn_in
}

/// `yew_pairs_decide` (`pairs.c:160-212`): what typing `byte` at `at`
/// does. Answers (action, closer).
pub fn pairs_decide(mut b: Buffer, autopair: bool, at: int, byte_value: int) -> (int, int) {
    if !b.resident || !pairs_interesting(byte_value) || !autopair {
        return (PAIR_LITERAL, 0)
    }
    var i = b.pairs.marks.len
    while i > 0 {
        i -= 1
        if !text.mark_alive(b.ec.marks, copy b.pairs.marks[i]) {
            continue
        }
        if b.pairs.closers[i] != byte_value ||
            text.mark_pos(b.ec.marks, copy b.pairs.marks[i]) as int != at {
            continue
        }
        if byte_at(b.ec.tb, at) != byte_value {
            drop_at(mut b, i)
            continue
        }
        drop_at(mut b, i)
        return (PAIR_SKIP, 0)
    }
    let close = table_close(byte_value)
    if close < 0 {
        return (PAIR_LITERAL, 0)
    }
    if close == byte_value && at != 0 && word_byte(byte_at(b.ec.tb, at - 1)) {
        return (PAIR_LITERAL, 0)
    }
    if in_string_or_comment(mut b, at) {
        return (PAIR_LITERAL, 0)
    }
    (PAIR_CLOSE, close)
}

/// `yew_pairs_remember` (`pairs.c:214-236`): the closer at `closer_at`,
/// the oldest dropped past 32.
pub fn pairs_remember(mut b: Buffer, closer_at: int, closer: int) {
    if !b.ec.has_marks {
        return
    }
    if b.pairs.marks.len >= PAIR_STACK_MAX {
        drop_at(mut b, 0)
    }
    let id = text.mark_add(mut b.ec.marks, closer_at as text.ByteOff, text.BIAS_RIGHT)
    (mut b.pairs.marks).push(id)
    (mut b.pairs.closers).push(closer)
}

/// `yew_pairs_backspace` (`pairs.c:252-290`): the empty pair around `at`
/// to delete in one Backspace, if the closer is a remembered one.
pub fn pairs_backspace(mut b: Buffer, autopair: bool, at: int) -> (bool, text.Span) {
    if !b.resident || at == 0 || !autopair {
        return (false, text.span(0, 0))
    }
    let here = byte_at(b.ec.tb, at)
    let prev = byte_at(b.ec.tb, at - 1)
    let opener = table_open_of(here)
    if here < 0 || prev < 0 || opener < 0 || prev != opener {
        return (false, text.span(0, 0))
    }
    var i = b.pairs.marks.len
    while i > 0 {
        i -= 1
        if !text.mark_alive(b.ec.marks, copy b.pairs.marks[i]) {
            continue
        }
        if b.pairs.closers[i] != here ||
            text.mark_pos(b.ec.marks, copy b.pairs.marks[i]) as int != at {
            continue
        }
        drop_at(mut b, i)
        return (true, text.span(at - 1, at + 1))
    }
    (false, text.span(0, 0))
}
