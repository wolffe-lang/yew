//! edit.ctxcmd — `ed.ui.context_menu`, the keyboard's way into the menu.
//!
//! Ports `yew_ui_cmd_context_menu` and its three helpers
//! (`open_strip_menu`, `focused_leaf_index`, `open_focus_menu`) from
//! sagitta `src/ui/mouse.c:2905-3036` at 9ace98c2, under
//! `s27-mouse-and-feel.md` §5/§8 and `s57_13-mouse-overhaul-context-
//! menus.md` §5: INVARIANT 9's entry — the keyboard opens the SAME menu
//! for whatever the keyboard is on, with no pointer anywhere. `iarg 1` is
//! the TAB STRIP (Sprint 27's behaviour, the active group's menu or the
//! active tab's); `iarg 0` or absent is the FOCUS: the FUSS row when F
//! mode is up (yw13: F mode cannot be entered before it), the picker row
//! when a picker is up (yw06-pick, wired at its merge), else the document
//! at the cursor cell. `t m` is the latter (`runtime/init.fl`). The rest
//! of `mouse.c` is the router's (`edit.mouse`, the yw06-mouse fork).

/// `open_strip_menu` (`mouse.c:2905-2934`): the active group's menu, else
/// the active tab's, hung under the strip.
fn open_strip_menu(mut ed: Ed) -> int {
    let x = ed.tab_strip_rect.x
    let y = ed.tab_strip_rect.y + ed.tab_strip_rect.h
    let gid = active_group_id(ed)
    if gid != 0 {
        if !mouse_open_group_menu(mut ed, gid, x, y) {
            return CMD_ERR_STATE
        }
        return CMD_OK
    }
    if ed.tab_active < 0 || ed.tab_active >= ed.tabs.len {
        return CMD_ERR_STATE
    }
    let tab_id = ed.tabs[ed.tab_active].tab_id
    if !mouse_open_tab_menu(mut ed, tab_id, x, y) {
        return CMD_ERR_STATE
    }
    CMD_OK
}

/// `focused_leaf_index` (`mouse.c:2936-2955`): the focused leaf's index in
/// THIS frame's leaf table, the region payloads' own identity; -1 when no
/// frame registered a pane.
fn focused_leaf_index(ed: Ed) -> int {
    var i = 0
    while i < ed.nleaf_tab {
        if pane_leaf_by_index(ed, i) == ed.focus {
            return i
        }
        i += 1
    }
    -1
}

/// `open_focus_menu` (`mouse.c:2957-3011`): the document menu at THE
/// CURSOR CELL as the renderer last placed it, or the pane's corner when a
/// modal has hidden it.
fn open_focus_menu(mut ed: Ed) -> int {
    let leaf = focused_leaf_index(ed)
    if leaf < 0 || ed.focus < 0 {
        return CMD_ERR_STATE
    }
    var c = ctxcontext_new(CTX_KIND_DOC, leaf)
    c.rect = copy ed.panes[ed.focus].rect
    var x = ed.panes[ed.focus].rect.x
    var y = ed.panes[ed.focus].rect.y
    if ed.grid.cur_vis {
        x = ed.grid.cur_col
        y = ed.grid.cur_row
    }
    if !menu_open_at(mut ed, c, x, y, x, y, MENU_PLACE_AFTER_ANCHOR) {
        return CMD_ERR_STATE
    }
    CMD_OK
}

/// `yew_ui_cmd_context_menu` (`mouse.c:3013-3029`), `ed.ui.context_menu`.
pub fn ui_cmd_context_menu(mut ed: Ed, cx: CmdCtx) -> int {
    if ed.tab_active < 0 {
        return CMD_ERR_STATE
    }
    let st = if cx.iarg == 1 then open_strip_menu(mut ed) else open_focus_menu(mut ed)
    if st != CMD_OK {
        return st
    }
    ed.full_damage = true
    CMD_OK
}
