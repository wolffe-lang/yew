//! edit.select — selection geometry: character, line and rectangular.
//!
//! Ports sagitta `src/edit/select.c` (183 lines) and `select.h` (42) at
//! 9ace98c2, under `s17-mode-H-multicursor.md` §2. C's functions take the
//! `Win` and read its buffer's `TextBuf` and tab width through it; the
//! port's take the text and the tab width explicitly beside the window's
//! selection kind. A rectangular selection is `CCol`-based: its columns
//! are the anchor's and the caret's cell columns, each row widened to
//! whole clusters where an edge lands inside a wide glyph or a tab.

use text

fn check_cursor(tb: text.TextBuf, c: text.Cursor) {
    let len = text.textbuf_len(tb)
    if c.pos > len || c.anchor > len {
        bug("selection geometry: cursor outside text buffer")
    }
}

/// The tab width a selection measures with (`selection_tabwidth`).
pub fn sel_tabwidth(buf_tabwidth: int) -> int {
    if buf_tabwidth != 0 then buf_tabwidth else VP_TABWIDTH
}

fn rows_of(tb: text.TextBuf, c: text.Cursor) -> (int, int) {
    let pos = text.textbuf_line_of(tb, c.pos as text.ByteOff) as int
    let anchor = text.textbuf_line_of(tb, c.anchor as text.ByteOff) as int
    if pos < anchor then (pos, anchor) else (anchor, pos)
}

fn rect_columns(tb: text.TextBuf, c: text.Cursor, tabw: int) -> (int, int) {
    let pl = text.textbuf_line_of(tb, c.pos as text.ByteOff)
    let al = text.textbuf_line_of(tb, c.anchor as text.ByteOff)
    let ps = text.textbuf_line_span(tb, pl)
    let as_ = text.textbuf_line_span(tb, al)
    let pc = text.off_to_ccol(tb, ps, c.pos as text.ByteOff, tabw) as int
    let ac = text.off_to_ccol(tb, as_, c.anchor as text.ByteOff, tabw) as int
    if pc < ac then (pc, ac) else (ac, pc)
}

fn sel_line_content_end(tb: text.TextBuf, line: text.Span, tabw: int) -> int {
    text.ccol_to_off_padded(tb, line, text.CCOL_EOL as text.CCol, tabw) as int
}

/// `yew_sel_span` (`select.c:80-99`): a CHAR or LINE selection's span; a
/// LINE selection covers whole lines with their newlines.
pub fn sel_span(tb: text.TextBuf, kind: int, c: text.Cursor) -> text.Span {
    check_cursor(tb, c)
    let lo = if c.pos < c.anchor then c.pos else c.anchor
    let hi = if c.pos < c.anchor then c.anchor else c.pos
    if kind == SEL_CHAR {
        return text.span(lo, hi)
    }
    if kind == SEL_LINE {
        let first = text.textbuf_line_of(tb, lo as text.ByteOff)
        let last = text.textbuf_line_of(tb, hi as text.ByteOff)
        return text.span(
            text.textbuf_line_start(tb, first) as int,
            text.textbuf_line_span(tb, last).hi,
        )
    }
    if kind == SEL_RECT {
        bug("yew_sel_span: rectangular selection requires row geometry")
    }
    bug("yew_sel_span: invalid selection kind")
    text.span(lo, hi)
}

/// `yew_sel_rows` (`select.c:101-110`).
pub fn sel_rows(tb: text.TextBuf, c: text.Cursor) -> int {
    check_cursor(tb, c)
    let (first, last) = rows_of(tb, c)
    last - first + 1
}

/// `yew_sel_rect_row` (`select.c:112-160`): row `line`'s span of a
/// rectangular selection and the requested columns. Answers (covered,
/// span, c0, c1); a short row is an empty span at its content end.
pub fn sel_rect_row(tb: text.TextBuf, kind: int, tabw: int, c: text.Cursor, line: int) -> (
    bool,
    text.Span,
    int,
    int,
) {
    check_cursor(tb, c)
    if kind != SEL_RECT {
        bug("yew_sel_rect_row: selection is not rectangular")
    }
    let (first, last) = rows_of(tb, c)
    if line < first || line > last {
        return (false, text.span(0, 0), 0, 0)
    }
    let (c0, c1) = rect_columns(tb, c, tabw)
    let ls = text.textbuf_line_span(tb, line as text.LineNo)
    let content_end = sel_line_content_end(tb, ls, tabw)
    let end_col = text.off_to_ccol(tb, ls, content_end as text.ByteOff, tabw) as int
    if end_col <= c0 {
        return (true, text.span(content_end, content_end), c0, c1)
    }
    let lo = text.ccol_to_off_padded(tb, ls, c0 as text.CCol, tabw) as int
    if c0 == c1 {
        return (true, text.span(lo, lo), c0, c1)
    }
    var hi = text.ccol_to_off_padded(tb, ls, c1 as text.CCol, tabw) as int
    let hi_landed = text.off_to_ccol(tb, ls, hi as text.ByteOff, tabw) as int
    if hi < content_end && hi_landed < c1 {
        hi = text.grapheme_next_boundary(tb, hi as text.ByteOff) as int
    }
    if hi > content_end {
        hi = content_end
    }
    (true, text.span(lo, hi), c0, c1)
}

/// `yew_sel_rect_spans` (`select.c:162-183`): one span per selected row.
pub fn sel_rect_spans(tb: text.TextBuf, kind: int, tabw: int, c: text.Cursor) -> List[text.Span] {
    check_cursor(tb, c)
    if kind != SEL_RECT {
        bug("yew_sel_rect_spans: selection is not rectangular")
    }
    let (first, last) = rows_of(tb, c)
    var out = List[text.Span]()
    var line = first
    while line <= last {
        let (ok, sp, _, _) = sel_rect_row(tb, kind, tabw, c, line)
        if !ok {
            bug("yew_sel_rect_spans: covered row rejected")
        }
        (mut out).push(sp)
        line += 1
    }
    out
}
