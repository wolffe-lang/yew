//! edit.trust_prompt — the workspace-trust prompt, sagitta 9ace98c2
//! src/ws/trust_prompt.c:1-207 and trust_prompt.h:1-35. The event loop's
//! UI for a `.yew.fl` that needs an answer; it never reads input itself.
//! C's probe pointer is a copy taken at begin; its db is the live
//! configuration state's (ed.cfg[0]: a prompt whose state is disposed is
//! cancelled first, flconf.c:231-233); `done` is always flconf's answer
//! handler and `ctx` that state's serial, so a prompt outliving its state
//! answers nothing (flconf.c:511-513).

use text

/// `YEW_PROMPT_WORKSPACE_TRUST` (`ed.h:55`).
pub const PROMPT_WORKSPACE_TRUST: int = 5

/// `YewTrustPrompt` (trust_prompt.h:15-24).
pub struct TrustPrompt {
    probe: TrustProbe,
    active: bool,
    viewing: bool,
    view_buffer_id: int,
    reason: int,
    ctx: int,
}

/// An idle prompt.
pub fn trust_prompt_none() -> TrustPrompt {
    TrustPrompt {
        probe: trust_probe_new(),
        active: false,
        viewing: false,
        view_buffer_id: 0,
        reason: TRUST_NO_CONFIG,
        ctx: 0,
    }
}

// trust_reason_prompts (trust_prompt.c:12-17).
fn tp_reason_prompts(reason: int) -> bool {
    reason == TRUST_PROMPT_NEW || reason == TRUST_PROMPT_CHANGED || reason == TRUST_PROMPT_REPLACED
}

// trust_size_text (trust_prompt.c:19-30).
fn tp_size_text(bytes: int) -> str {
    if bytes < 1024 { return "{bytes} B" }
    let tenths = (bytes * 10 + 512) / 1024
    "{tenths / 10}.{tenths % 10} KiB"
}

// trust_age_text (trust_prompt.c:32-53).
fn tp_age_text(path: str) -> str {
    let w = fs_stat(path) else { return "unknown" }
    let now = time_unix_ms() / 1000
    let age = if now > w[14] then now - w[14] else 0
    if age < 60 { return "just now" }
    if age < 3600 { return "{age / 60} minutes ago" }
    if age < 86400 { return "{age / 3600} hours ago" }
    "{age / 86400} days ago"
}

// trust_prompt_show (trust_prompt.c:55-70).
fn tp_show(mut ed: Ed) {
    ed.prompt = PROMPT_WORKSPACE_TRUST
    let size = tp_size_text(ed.trust_prompt.probe.bytes.len)
    let path = ed.trust_prompt.probe.config_path
    let age = tp_age_text(path)
    let why = trust_decision_reason(ed.trust_prompt.reason)
    ed_msg(
        mut ed,
        MSG_WARN,
        "workspace config: {path} ({size}, modified {age}); {why}; [t]rust always [o]nce [n]ever [v]iew [s]kip",
    )
    ed.msg.prompt = true
}

// trust_prompt_finish (trust_prompt.c:72-82).
fn tp_finish(mut ed: Ed, answer: int) {
    let ctx = ed.trust_prompt.ctx
    ed.trust_prompt = trust_prompt_none()
    ed.prompt = PROMPT_NONE
    ed_msg_clear(mut ed)
    config_trust_prompt_done(mut ed, answer, ctx)
}

// trust_prompt_persist (trust_prompt.c:84-100).
fn tp_persist(mut ed: Ed, answer: int) -> bool {
    let now = time_unix_ms() / 1000
    let probe = copy ed.trust_prompt.probe
    if ed.cfg.len == 0 ||
        !trust_answer(mut ed.cfg[0].trust_db, probe, answer, now) ||
        !trust_db_write(mut ed.cfg[0].trust_db, now, TRUST_PRUNE_DAYS_DEFAULT) {
        ed_msg(
            mut ed,
            MSG_ERROR,
            "could not persist workspace trust decision; [t]rust always [o]nce [n]ever [v]iew [s]kip",
        )
        ed.msg.prompt = true
        return false
    }
    true
}

// trust_prompt_view (trust_prompt.c:102-130).
fn tp_view(mut ed: Ed) -> bool {
    if !ed.model_ready { return false }
    let name = "*trust: {ed.trust_prompt.probe.config_path}*"
    let bi = ws_scratch_new(mut ed, name, BUF_NOUNDO | BUF_READONLY)
    let bytes = copy ed.trust_prompt.probe.bytes
    text.textbuf_insert(mut ed.bufs[bi].ec.tb, 0 as text.ByteOff, bytes)
    text.undo_mark_saved(mut ed.bufs[bi].ec.undo, ed.bufs[bi].ec.tb)
    ed_show_buffer(mut ed, bi)
    ed.trust_prompt.viewing = true
    ed.trust_prompt.view_buffer_id = ed.bufs[bi].id
    ed.prompt = PROMPT_NONE
    ed_msg_clear(mut ed)
    ed_msg(mut ed, MSG_INFO, "viewing workspace config; close this buffer to answer trust prompt")
    true
}

/// `yew_trust_prompt_begin` (trust_prompt.c:132-150): ask about `probe`
/// for the configuration state `ctx`; false when no prompt can open.
pub fn trust_prompt_begin(mut ed: Ed, probe: TrustProbe, reason: int, ctx: int) -> bool {
    if !probe.has_config || !tp_reason_prompts(reason) ||
        ed.trust_prompt.active || ed.prompt != PROMPT_NONE {
        return false
    }
    ed.trust_prompt.probe = probe
    ed.trust_prompt.reason = reason
    ed.trust_prompt.ctx = ctx
    ed.trust_prompt.active = true
    tp_show(mut ed)
    true
}

/// `yew_trust_prompt_key` (trust_prompt.c:152-188): one answer byte (0x1b
/// for escape, 0 for a key that is not one).
pub fn trust_prompt_key(mut ed: Ed, answer: int) -> bool {
    if !ed.trust_prompt.active || ed.trust_prompt.viewing { return false }
    if answer == 't' as int {
        if tp_persist(mut ed, TRUST_ALWAYS) { tp_finish(mut ed, TRUST_ALWAYS) }
    } else if answer == 'o' as int {
        let probe = copy ed.trust_prompt.probe
        if ed.cfg.len != 0 && trust_answer(mut ed.cfg[0].trust_db, probe, TRUST_ONCE, time_unix_ms() / 1000) {
            tp_finish(mut ed, TRUST_ONCE)
        }
    } else if answer == 'n' as int {
        if tp_persist(mut ed, TRUST_NEVER) { tp_finish(mut ed, TRUST_NEVER) }
    } else if answer == 'v' as int {
        if !tp_view(mut ed) { tp_show(mut ed) }
    } else if answer == 's' as int || answer == 27 {
        let probe = copy ed.trust_prompt.probe
        if ed.cfg.len != 0 { let _ = trust_answer(mut ed.cfg[0].trust_db, probe, TRUST_SKIP, time_unix_ms() / 1000) }
        tp_finish(mut ed, TRUST_SKIP)
    } else {
        tp_show(mut ed)
    }
    true
}

/// `yew_trust_prompt_buffer_closed` (trust_prompt.c:190-200): closing the
/// viewed config asks again.
pub fn trust_prompt_buffer_closed(mut ed: Ed, buffer_id: int) {
    if !ed.trust_prompt.active || !ed.trust_prompt.viewing ||
        ed.trust_prompt.view_buffer_id != buffer_id {
        return
    }
    ed.trust_prompt.viewing = false
    ed.trust_prompt.view_buffer_id = 0
    tp_show(mut ed)
}

/// `yew_trust_prompt_cancel` (trust_prompt.c:202-207).
pub fn trust_prompt_cancel(mut ed: Ed) {
    if ed.prompt == PROMPT_WORKSPACE_TRUST { ed.prompt = PROMPT_NONE }
    ed.trust_prompt = trust_prompt_none()
}
