//! edit.statusline — the statusline: the mode chip, the path, the
//! metadata segments by priority, the position.
//!
//! Ports sagitta `src/ui/statusline.c` (885 lines) and `ui/statusline.h`
//! (50) at 9ace98c2, under `s15-viewport-statusline.md` §3. The segments
//! C builds for later campaigns — the macro recorder's REC chip (yw09),
//! the job badge (yw04), the search count and wrap glyph (yw04), the
//! syntax badge (yw10), diagnostics and the LSP badge (yw11), the git
//! branch (yw13), the AI badge (yw12) — are present in C's order with
//! their priorities and never shown before their campaign lands (none of
//! their sources exist), so the layout arithmetic is C's whole.

use term
use text
use unicode

const STATUS_TABWIDTH: int = 4

const STATUS_WARN_COLOR: int = 214

/// `yew_statusline_mode_style` (`statusline.c:38-74`): each mode's
/// built-in chip and row colours.
pub fn statusline_mode_style(mode: int) -> UiStyle {
    let b = term.ATTR_BOLD
    match mode {
        0 =>
            UiStyle {
                chip_fg: term.color_rgb(235, 244, 255),
                chip_bg: term.color_rgb(38, 110, 186),
                row_fg: term.color_rgb(218, 229, 240),
                row_bg: term.color_rgb(20, 48, 76),
                attrs: b,
            },
        1 =>
            UiStyle {
                chip_fg: term.color_rgb(10, 35, 40),
                chip_bg: term.color_rgb(66, 190, 202),
                row_fg: term.color_rgb(205, 235, 238),
                row_bg: term.color_rgb(19, 62, 67),
                attrs: b,
            },
        2 =>
            UiStyle {
                chip_fg: term.color_rgb(245, 238, 255),
                chip_bg: term.color_rgb(126, 87, 194),
                row_fg: term.color_rgb(228, 218, 244),
                row_bg: term.color_rgb(52, 37, 78),
                attrs: b,
            },
        3 =>
            UiStyle {
                chip_fg: term.color_rgb(43, 31, 8),
                chip_bg: term.color_rgb(225, 168, 44),
                row_fg: term.color_rgb(245, 229, 194),
                row_bg: term.color_rgb(75, 57, 20),
                attrs: b,
            },
        4 =>
            UiStyle {
                chip_fg: term.color_rgb(225, 247, 230),
                chip_bg: term.color_rgb(42, 145, 72),
                row_fg: term.color_rgb(216, 238, 222),
                row_bg: term.color_rgb(18, 64, 31),
                attrs: b,
            },
        5 =>
            UiStyle {
                chip_fg: term.color_rgb(47, 24, 6),
                chip_bg: term.color_rgb(231, 125, 36),
                row_fg: term.color_rgb(247, 224, 204),
                row_bg: term.color_rgb(78, 42, 15),
                attrs: b,
            },
        _ =>
            UiStyle {
                chip_fg: term.color_rgb(250, 235, 248),
                chip_bg: term.color_rgb(177, 61, 155),
                row_fg: term.color_rgb(239, 215, 235),
                row_bg: term.color_rgb(72, 27, 64),
                attrs: b,
            },
    }
}

fn cells_of(s: List[byte]) -> int {
    let w = unicode.str_width(s, 0, s.len, STATUS_TABWIDTH)
    if w < 0 then 0 else w
}

fn str_cells(s: str) -> int {
    cells_of(bytes_of(s))
}

// `mode_theme_role` (`statusline.c:84-97`).
fn mode_theme_role(mode: int) -> str {
    match mode {
        0 => "mode.line",
        1 => "mode.word",
        2 => "mode.block",
        3 => "mode.highlight",
        4 => "mode.insert",
        5 => "mode.explore",
        _ => "mode.git",
    }
}

/// `statusline_apply_theme` (`statusline.c:99-122`).
pub fn statusline_apply_theme(ed: Ed, mode: int, mut style: UiStyle) {
    let r = theme_rendition_of(ed.render)
    let (has_chip, chip) = theme_ui(ed.theme, mode_theme_role(mode), r)
    let (has_fg, fg) = theme_ui(ed.theme, "fg", r)
    let (has_bg, bg) = theme_ui(ed.theme, "bg", r)
    if has_chip {
        if chip.fg.tag != term.COLOR_DEFAULT {
            style.chip_fg = copy chip.fg
        }
        if chip.bg.tag != term.COLOR_DEFAULT {
            style.chip_bg = copy chip.bg
        }
        style.attrs = chip.attrs
    }
    if has_fg && fg.fg.tag != term.COLOR_DEFAULT {
        style.row_fg = copy fg.fg
    }
    if has_bg && bg.bg.tag != term.COLOR_DEFAULT {
        style.row_bg = copy bg.bg
    }
}

fn base_name(path: str) -> str {
    let slash = path.rfind("/") else -1
    if slash < 0 then path else path[slash + 1..]
}

fn suffix_matches(path: str, suffix: str) -> bool {
    if suffix.len > path.len || !path.ends_with(suffix) {
        return false
    }
    suffix.len == path.len || path.bytes()[path.len - suffix.len - 1] as int == 47
}

// `unambiguous_path` (`statusline.c:152-183`): the shortest path suffix
// no other buffer's path shares.
fn unambiguous_path(ed: Ed, bi: int) -> str {
    if ed.bufs[bi].has_name {
        return ed.bufs[bi].name
    }
    if !ed.bufs[bi].has_path {
        return "[no name]"
    }
    let path = ed.bufs[bi].path
    var start = path.len - base_name(path).len
    loop {
        let suffix = path[start..]
        var matches = 0
        for b in ed.bufs {
            if b.has_path && suffix_matches(b.path, suffix) {
                matches += 1
            }
        }
        if matches <= 1 {
            return suffix
        }
        if start == 0 {
            return path
        }
        start -= 1
        while start > 0 && path.bytes()[start - 1] as int != 47 {
            start -= 1
        }
    }
    path
}

fn read_only(b: Buffer) -> bool {
    b.ec.meta.exists && b.ec.meta.mode & 146 == 0
}

fn eol_text(eol: int) -> str {
    if eol == text.EOL_LF {
        return "lf"
    }
    if eol == text.EOL_CRLF {
        return "crlf"
    }
    "mixed!"
}

// `percent_text` (`statusline.c:205-230`).
fn percent_text(mut w: Win, tb: text.TextBuf) -> str {
    let lines = text.textbuf_line_count(tb)
    let rows = w.vp.rows
    if lines <= rows {
        return "all"
    }
    if w.vp.top == 0 {
        return "top"
    }
    if vp_last_visible_line(mut w, tb) + 1 >= lines {
        return "bot"
    }
    var percent = w.vp.top * 100 / (lines - rows)
    if percent > 100 {
        percent = 100
    }
    "{percent}%"
}

// `highlight_unit` (`statusline.c:232-245`).
fn highlight_unit(w: Win) -> str {
    if w.h.unit == UNIT_LINE {
        return "L"
    }
    if w.h.unit == UNIT_WORD {
        return "W"
    }
    if w.h.unit == UNIT_BLOCK {
        return "B"
    }
    if w.h.unit == UNIT_CHAR {
        return "C"
    }
    if w.h.from >= MODE_L && w.h.from <= MODE_B {
        return mode_name(w.h.from)
    }
    "C"
}

fn chip_text(ed: Ed, w: Win) -> str {
    if ed.mode == MODE_H {
        return " H\u{b7}{highlight_unit(w)} "
    }
    " {mode_name(ed.mode)} "
}

// A statusline segment (`Segment`, `statusline.c:31-35`).
struct Segment {
    text: str,
    priority: int,
    shown: bool,
}

fn right_width(segments: List[Segment]) -> int {
    var width = 0
    for s in segments {
        if !s.shown || s.text.len == 0 {
            continue
        }
        if width != 0 {
            width += 2
        }
        width += str_cells(s.text)
    }
    width
}

fn drop_priority(mut segments: List[Segment], priority: int) {
    var i = 0
    while i < segments.len {
        if segments[i].priority == priority {
            segments[i].shown = false
        }
        i += 1
    }
}

// `path_clip` (`statusline.c:292-344`).
fn path_clip(path: str, max_cells: int) -> str {
    let ellipsis = "\u{2026}"
    if max_cells <= 0 {
        return ""
    }
    if str_cells(path) <= max_cells {
        return path
    }
    let base = base_name(path)
    let base_at = path.len - base.len
    if base_at != 0 && str_cells(base) + 2 <= max_cells {
        var suffix = base_at
        var component = base_at
        while component > 0 {
            var previous = component - 1
            while previous > 0 && path.bytes()[previous - 1] as int != 47 {
                previous -= 1
            }
            if previous == 0 && path.bytes()[0] as int == 47 {
                previous = 1
            }
            if previous >= component || str_cells(path[previous..]) + 2 > max_cells {
                break
            }
            suffix = previous
            component = previous
        }
        return "{ellipsis}/{path[suffix..]}"
    }
    if max_cells == 1 {
        return ellipsis
    }
    let bb = bytes_of(base)
    let (keep, _) = unicode.str_clip(bb, 0, bb.len, max_cells - 1)
    "{base[0..keep]}{ellipsis}"
}

/// What the statusline shows (`StatuslineText`, `statusline.h:20-41`).
pub struct StatusText {
    chip: List[byte],
    recording: List[byte],
    recording_cells: int,
    chip_cells: int,
    body: List[byte],
    body_cells: int,
    warn_at: int,
    warn_len: int,
}

/// `yew_statusline_build` (`statusline.c:362-749`) for window `wi` at
/// `cols` cells.
pub fn statusline_build(mut ed: Ed, wi: int, cols: int) -> StatusText {
    let bi = ed.wins[wi].buf
    let chip = bytes_of(chip_text(ed, ed.wins[wi]))
    let chip_cells = cells_of(chip)
    var out = StatusText {
        chip: chip,
        recording: List[byte](),
        recording_cells: 0,
        chip_cells: chip_cells,
        body: List[byte](),
        body_cells: 0,
        warn_at: 0,
        warn_len: 0,
    }
    if cols <= chip_cells {
        return out
    }
    let available = cols - chip_cells
    let path = unambiguous_path(ed, bi)
    let p = ed.wins[wi].cs.primary
    let cursor = copy ed.wins[wi].cs.curs[p]
    let line = text.textbuf_line_of(ed.bufs[bi].ec.tb, cursor.pos as text.ByteOff) as int
    let lspan = text.textbuf_line_span(ed.bufs[bi].ec.tb, line as text.LineNo)
    let gcol = text.off_to_gcol(mut ed.bufs[bi].ec.tb, lspan, cursor.pos as text.ByteOff) as int
    var position = "{line + 1}:{gcol + 1}"
    if ed.wins[wi].cs.selstacks[p].n != 0 && cursor.anchor != cursor.pos {
        let aline = text.textbuf_line_of(ed.bufs[bi].ec.tb, cursor.anchor as text.ByteOff) as int
        let aspan = text.textbuf_line_span(ed.bufs[bi].ec.tb, aline as text.LineNo)
        let agcol = text.off_to_gcol(
            mut ed.bufs[bi].ec.tb,
            aspan,
            cursor.anchor as text.ByteOff,
        ) as int
        position = "{line + 1}:{gcol + 1}@{aline + 1}:{agcol + 1}"
    }
    let percent = percent_text(mut ed.wins[wi], ed.bufs[bi].ec.tb)
    let meta = copy ed.bufs[bi].ec.meta
    let encoding = if meta.binary then "utf-8 bin" else "utf-8"
    let ncurs = ed.wins[wi].cs.curs.len
    var segments = List[Segment]()
    let ro = read_only(ed.bufs[bi])
    (mut segments).push(Segment { text: if ro then "[ro]" else "", priority: 4, shown: ro })
    (mut segments).push(Segment { text: encoding, priority: 3, shown: true })
    (mut segments).push(Segment { text: eol_text(meta.eol), priority: 3, shown: true })
    (mut segments).push(Segment { text: "bom", priority: 3, shown: meta.had_bom })
    (mut segments).push(Segment { text: "!utf8", priority: 2, shown: meta.had_invalid_utf8 })
    (mut segments).push(Segment { text: position, priority: 1, shown: true })
    (mut segments).push(Segment { text: percent, priority: 5, shown: true })
    (mut segments).push(Segment {
        text: if ncurs > 1 then "\u{d7}{ncurs}" else "",
        priority: 1,
        shown: ncurs > 1,
    })
    // The job badge (s19), the search count (s21) and wrap glyph (s20),
    // the syntax badge (s39), diagnostics (s46), the Fortran language
    // (s42), git (s51) and AI (s48): C's slots 8-15, empty before their
    // campaigns.
    (mut segments).push(Segment { text: "", priority: 2, shown: false })
    (mut segments).push(Segment { text: "", priority: 2, shown: false })
    (mut segments).push(Segment { text: "", priority: 2, shown: false })
    (mut segments).push(Segment { text: "", priority: 4, shown: false })
    (mut segments).push(Segment { text: "", priority: 5, shown: false })
    (mut segments).push(Segment { text: "", priority: 3, shown: false })
    (mut segments).push(Segment { text: "", priority: 5, shown: false })
    (mut segments).push(Segment { text: "", priority: 5, shown: false })
    var path_cells = str_cells(path)
    let dirty = buf_dirty(ed.bufs[bi])
    let dirty_cells = if dirty then 2 else 0
    var right_cells = right_width(segments)
    var min_cells = 1 + path_cells + dirty_cells + (if right_cells == 0 then 0 else 2 + right_cells)
    var priority = 5
    while priority >= 1 && min_cells > available {
        drop_priority(mut segments, priority)
        right_cells = right_width(segments)
        min_cells = 1 + path_cells + dirty_cells + (if right_cells == 0 then 0 else 2 + right_cells)
        priority -= 1
    }
    right_cells = right_width(segments)
    let reserved = 1 + dirty_cells + (if right_cells == 0 then 0 else 2 + right_cells)
    var path_budget = available - reserved
    if path_budget < 0 {
        path_budget = 0
    }
    let clipped = path_clip(path, path_budget)
    path_cells = str_cells(clipped)
    var body = List[byte]()
    push_str(mut body, " ")
    push_str(mut body, clipped)
    if dirty {
        push_str(mut body, " *")
    }
    if right_cells != 0 {
        let used = 1 + path_cells + dirty_cells
        var gap = available - used - right_cells
        if gap < 2 {
            gap = 2
        }
        while gap > 0 {
            push_str(mut body, " ")
            gap -= 1
        }
        var prior = false
        var i = 0
        while i < segments.len {
            if segments[i].shown && segments[i].text.len != 0 {
                if prior {
                    push_str(mut body, "  ")
                }
                if i == 2 && meta.eol == text.EOL_MIXED {
                    out.warn_at = body.len
                }
                push_str(mut body, segments[i].text)
                if i == 2 && meta.eol == text.EOL_MIXED {
                    out.warn_len = body.len - out.warn_at
                }
                prior = true
            }
            i += 1
        }
    }
    out.body_cells = cells_of(body)
    out.body = body
    out
}

/// `yew_statusline_draw` (`statusline.c:843-885`).
pub fn statusline_draw(mut ed: Ed, wi: int) {
    if ed.footer_rect.h == 0 || ed.footer_rect.y >= ed.grid.rows || ed.grid.cols == 0 {
        return
    }
    let row = ed.footer_rect.y
    var style = statusline_mode_style(ed.mode)
    statusline_apply_theme(ed, ed.mode, mut style)
    let st = statusline_build(mut ed, wi, ed.footer_rect.w)
    var blank = copy ed.grid.blank
    blank.fg = copy style.row_fg
    blank.bg = copy style.row_bg
    blank.attrs = 0
    term.grid_fill(mut ed.grid, row, ed.footer_rect.x, ed.footer_rect.x + ed.footer_rect.w, blank)
    var col = term.grid_puts(
        mut ed.grid,
        row,
        ed.footer_rect.x,
        st.chip,
        0,
        st.chip.len,
        copy style.chip_fg,
        copy style.chip_bg,
        style.attrs,
    )
    if col < ed.grid.cols && st.body.len != 0 {
        if st.warn_len != 0 {
            col = term.grid_puts(
                mut ed.grid,
                row,
                col,
                st.body,
                0,
                st.warn_at,
                copy style.row_fg,
                copy style.row_bg,
                0,
            )
            col = term.grid_puts(
                mut ed.grid,
                row,
                col,
                st.body,
                st.warn_at,
                st.warn_at + st.warn_len,
                term.color_indexed(STATUS_WARN_COLOR),
                copy style.row_bg,
                term.ATTR_BOLD,
            )
            let _ = term.grid_puts(
                mut ed.grid,
                row,
                col,
                st.body,
                st.warn_at + st.warn_len,
                st.body.len,
                copy style.row_fg,
                copy style.row_bg,
                0,
            )
        } else {
            let _ = term.grid_puts(
                mut ed.grid,
                row,
                col,
                st.body,
                0,
                st.body.len,
                copy style.row_fg,
                copy style.row_bg,
                0,
            )
        }
    }
}
