//! edit.statusline — the statusline: the mode chip, the path, the
//! metadata segments by priority, the position.
//!
//! Ports sagitta `src/ui/statusline.c` (885 lines) and `ui/statusline.h`
//! (50) at 9ace98c2, under `s15-viewport-statusline.md` §3. The segments
//! C builds for later campaigns — the macro recorder's REC chip (yw09),
//! the job badge (yw04), the search count and wrap glyph (yw04), the
//! syntax badge (yw10), diagnostics and the LSP badge (yw11), the git
//! branch (yw13), the AI badge (yw12) — are present in C's order with
//! their priorities and never shown before their campaign lands (none of
//! their sources exist), so the layout arithmetic is C's whole.

use term
use text
use unicode

const STATUS_TABWIDTH: int = 4

const STATUS_WARN_COLOR: int = 214

/// `yew_statusline_mode_style` (`statusline.c:38-74`): each mode's
/// built-in chip and row colours.
pub fn statusline_mode_style(mode: int) -> UiStyle {
    let b = term.ATTR_BOLD
    match mode {
        0 =>
            UiStyle {
                chip_fg: term.color_rgb(235, 244, 255),
                chip_bg: term.color_rgb(38, 110, 186),
                row_fg: term.color_rgb(218, 229, 240),
                row_bg: term.color_rgb(20, 48, 76),
                attrs: b,
            },
        1 =>
            UiStyle {
                chip_fg: term.color_rgb(10, 35, 40),
                chip_bg: term.color_rgb(66, 190, 202),
                row_fg: term.color_rgb(205, 235, 238),
                row_bg: term.color_rgb(19, 62, 67),
                attrs: b,
            },
        2 =>
            UiStyle {
                chip_fg: term.color_rgb(245, 238, 255),
                chip_bg: term.color_rgb(126, 87, 194),
                row_fg: term.color_rgb(228, 218, 244),
                row_bg: term.color_rgb(52, 37, 78),
                attrs: b,
            },
        3 =>
            UiStyle {
                chip_fg: term.color_rgb(43, 31, 8),
                chip_bg: term.color_rgb(225, 168, 44),
                row_fg: term.color_rgb(245, 229, 194),
                row_bg: term.color_rgb(75, 57, 20),
                attrs: b,
            },
        4 =>
            UiStyle {
                chip_fg: term.color_rgb(225, 247, 230),
                chip_bg: term.color_rgb(42, 145, 72),
                row_fg: term.color_rgb(216, 238, 222),
                row_bg: term.color_rgb(18, 64, 31),
                attrs: b,
            },
        5 =>
            UiStyle {
                chip_fg: term.color_rgb(47, 24, 6),
                chip_bg: term.color_rgb(231, 125, 36),
                row_fg: term.color_rgb(247, 224, 204),
                row_bg: term.color_rgb(78, 42, 15),
                attrs: b,
            },
        _ =>
            UiStyle {
                chip_fg: term.color_rgb(250, 235, 248),
                chip_bg: term.color_rgb(177, 61, 155),
                row_fg: term.color_rgb(239, 215, 235),
                row_bg: term.color_rgb(72, 27, 64),
                attrs: b,
            },
    }
}

fn cells_of(s: List[byte]) -> int {
    range_cells(s, 0, s.len)
}

// The cells of bytes `[lo, hi)` of `s` (C's `cells`, `statusline.c:23-29`).
fn range_cells(s: List[byte], lo: int, hi: int) -> int {
    let w = unicode.str_width(s, lo, hi, STATUS_TABWIDTH)
    if w < 0 then 0 else w
}

// A `str`'s cells, its bytes read in place (a bound `.bytes()` copies).
fn str_cells(s: str) -> int {
    let w = unicode.str_width(s.bytes(), 0, s.len, STATUS_TABWIDTH)
    if w < 0 then 0 else w
}

// `mode_theme_role` (`statusline.c:84-97`).
fn mode_theme_role(mode: int) -> str {
    match mode {
        0 => "mode.line",
        1 => "mode.word",
        2 => "mode.block",
        3 => "mode.highlight",
        4 => "mode.insert",
        5 => "mode.explore",
        _ => "mode.git",
    }
}

/// `statusline_apply_theme` (`statusline.c:99-122`).
pub fn statusline_apply_theme(ed: Ed, mode: int, mut style: UiStyle) {
    let r = theme_rendition_of(ed.render)
    let (has_chip, chip) = theme_ui(ed.theme, mode_theme_role(mode), r)
    let (has_fg, fg) = theme_ui(ed.theme, "fg", r)
    let (has_bg, bg) = theme_ui(ed.theme, "bg", r)
    if has_chip {
        if chip.fg.tag != term.COLOR_DEFAULT {
            style.chip_fg = copy chip.fg
        }
        if chip.bg.tag != term.COLOR_DEFAULT {
            style.chip_bg = copy chip.bg
        }
        style.attrs = chip.attrs
    }
    if has_fg && fg.fg.tag != term.COLOR_DEFAULT {
        style.row_fg = copy fg.fg
    }
    if has_bg && bg.bg.tag != term.COLOR_DEFAULT {
        style.row_bg = copy bg.bg
    }
}

fn base_name(path: str) -> str {
    let slash = path.rfind("/") else -1
    if slash < 0 then path else path[slash + 1..]
}

fn suffix_matches(path: str, suffix: str) -> bool {
    if suffix.len > path.len || !path.ends_with(suffix) {
        return false
    }
    suffix.len == path.len || path.bytes()[path.len - suffix.len - 1] as int == 47
}

// `unambiguous_path` (`statusline.c:152-183`): the shortest path suffix
// no other buffer's path shares.
fn unambiguous_path(ed: Ed, bi: int) -> str {
    if ed.bufs[bi].has_name {
        return ed.bufs[bi].name
    }
    if !ed.bufs[bi].has_path {
        return "[no name]"
    }
    let path = ed.bufs[bi].path
    var start = path.len - base_name(path).len
    loop {
        let suffix = path[start..]
        var matches = 0
        var i = 0
        while i < ed.bufs.len {
            if ed.bufs[i].has_path && suffix_matches(ed.bufs[i].path, suffix) {
                matches += 1
            }
            i += 1
        }
        if matches <= 1 {
            return suffix
        }
        if start == 0 {
            return path
        }
        start -= 1
        while start > 0 && path.bytes()[start - 1] as int != 47 {
            start -= 1
        }
    }
    path
}

fn read_only(b: Buffer) -> bool {
    b.ec.meta.exists && b.ec.meta.mode & 146 == 0
}

fn eol_text(eol: int) -> str {
    if eol == text.EOL_LF {
        return "lf"
    }
    if eol == text.EOL_CRLF {
        return "crlf"
    }
    "mixed!"
}

// `percent_text` (`statusline.c:205-230`), appended to `out` in place.
fn percent_into(mut out: List[byte], mut w: Win, tb: text.TextBuf) {
    let lines = text.textbuf_line_count(tb)
    let rows = w.vp.rows
    if lines <= rows {
        push_str(mut out, "all")
        return
    }
    if w.vp.top == 0 {
        push_str(mut out, "top")
        return
    }
    if vp_last_visible_line(mut w, tb) + 1 >= lines {
        push_str(mut out, "bot")
        return
    }
    var percent = w.vp.top * 100 / (lines - rows)
    if percent > 100 {
        percent = 100
    }
    push_dec(mut out, percent)
    push_str(mut out, "%")
}

// `highlight_unit` (`statusline.c:232-245`).
fn highlight_unit(w: Win) -> str {
    if w.h.unit == UNIT_LINE {
        return "L"
    }
    if w.h.unit == UNIT_WORD {
        return "W"
    }
    if w.h.unit == UNIT_BLOCK {
        return "B"
    }
    if w.h.unit == UNIT_CHAR {
        return "C"
    }
    if w.h.from >= MODE_L && w.h.from <= MODE_B {
        return mode_name(w.h.from)
    }
    "C"
}

// `chip_text` (`statusline.c:247-254`), into `out` (emptied first).
fn chip_into(mut out: List[byte], mode: int, w: Win) {
    clear_bytes(mut out)
    push_str(mut out, " ")
    if mode == MODE_H {
        push_str(mut out, "H\u{b7}")
        push_str(mut out, highlight_unit(w))
    } else {
        push_str(mut out, mode_name(mode))
    }
    push_str(mut out, " ")
}

/// C's `Segment segments[16]` (`statusline.c:395`): the slots in C's order.
pub const STATUS_SEGS: int = 16

/// A statusline segment (`Segment`, `statusline.c:31-35`): its text is
/// bytes `[lo, hi)` of the frame's segment pool (`ed.dbuf.seg_text`).
pub struct StatusSeg {
    lo: int,
    hi: int,
    priority: int,
    shown: bool,
}

// Slot `i`: the pool's bytes from `lo` to its end, appended just before.
fn seg_put(mut d: DrawBufs, i: int, lo: int, priority: int, shown: bool) {
    let sg = StatusSeg { lo: lo, hi: d.seg_text.len, priority: priority, shown: shown }
    if i < d.segs.len {
        d.segs[i] = sg
    } else {
        (mut d.segs).push(sg)
    }
}

// Slot `i` holding the constant `t`.
fn seg_str(mut d: DrawBufs, i: int, t: str, priority: int, shown: bool) {
    let lo = d.seg_text.len
    push_str(mut d.seg_text, t)
    seg_put(mut d, i, lo, priority, shown)
}

fn right_width(d: DrawBufs) -> int {
    var width = 0
    var i = 0
    while i < STATUS_SEGS {
        if d.segs[i].shown && d.segs[i].hi != d.segs[i].lo {
            if width != 0 {
                width += 2
            }
            width += range_cells(d.seg_text, d.segs[i].lo, d.segs[i].hi)
        }
        i += 1
    }
    width
}

fn drop_priority(mut d: DrawBufs, priority: int) {
    var i = 0
    while i < STATUS_SEGS {
        if d.segs[i].priority == priority {
            d.segs[i].shown = false
        }
        i += 1
    }
}

// `path_clip` (`statusline.c:292-344`) into `dst` (emptied first; C's
// `dst`/`cap`).
fn path_clip_into(mut dst: List[byte], path: str, max_cells: int) {
    let ellipsis = "\u{2026}"
    clear_bytes(mut dst)
    if max_cells <= 0 {
        return
    }
    // Measured through `dst` (a `str`'s `.bytes()` handed to a call can
    // be a list made a frame); it is the answer when it fits.
    push_str(mut dst, path)
    if cells_of(dst) <= max_cells {
        return
    }
    clear_bytes(mut dst)
    let base = base_name(path)
    let base_at = path.len - base.len
    if base_at != 0 && str_cells(base) + 2 <= max_cells {
        var suffix = base_at
        var component = base_at
        while component > 0 {
            var previous = component - 1
            while previous > 0 && path.bytes()[previous - 1] as int != 47 {
                previous -= 1
            }
            if previous == 0 && path.bytes()[0] as int == 47 {
                previous = 1
            }
            if previous >= component || str_cells(path[previous..]) + 2 > max_cells {
                break
            }
            suffix = previous
            component = previous
        }
        push_str(mut dst, ellipsis)
        push_str(mut dst, "/")
        push_str(mut dst, path[suffix..])
        return
    }
    if max_cells == 1 {
        push_str(mut dst, ellipsis)
        return
    }
    let (keep, _) = unicode.str_clip(base.bytes(), 0, base.len, max_cells - 1)
    push_str(mut dst, base[0..keep])
    push_str(mut dst, ellipsis)
}

/// What the statusline shows (`StatuslineText`, `statusline.h:20-41`).
pub struct StatusText {
    chip: List[byte],
    recording: List[byte],
    recording_cells: int,
    chip_cells: int,
    body: List[byte],
    body_cells: int,
    warn_at: int,
    warn_len: int,
}

/// An empty statusline text (C's `memset(out, 0, …)`).
pub fn statustext_new() -> StatusText {
    StatusText {
        chip: List[byte](),
        recording: List[byte](),
        recording_cells: 0,
        chip_cells: 0,
        body: List[byte](),
        body_cells: 0,
        warn_at: 0,
        warn_len: 0,
    }
}

/// `yew_statusline_build` (`statusline.c:362-749`) for window `wi` at
/// `cols` cells, as a value (the tests' form): `statusline_build_into`'s
/// text, copied out.
pub fn statusline_build(mut ed: Ed, wi: int, cols: int) -> StatusText {
    statusline_build_into(mut ed, wi, cols)
    copy ed.dbuf.status
}

/// `yew_statusline_build` (`statusline.c:362-749`) for window `wi` at
/// `cols` cells into the editor's `ed.dbuf.status` — C's caller-owned
/// `StatuslineText *out` with its inline body (`statusline.c:404-414`).
/// The segments' texts (C's `position[112]`, `percent[16]`, the badges'
/// `char[]`s) are written into one pool, `ed.dbuf.seg_text`, the digits
/// in place: a frame's statusline builds no `str` (deliverable 6).
pub fn statusline_build_into(mut ed: Ed, wi: int, cols: int) {
    let bi = ed.wins[wi].buf
    let mode = ed.mode
    chip_into(mut ed.dbuf.status.chip, mode, ed.wins[wi])
    clear_bytes(mut ed.dbuf.status.recording)
    clear_bytes(mut ed.dbuf.status.body)
    let chip_cells = cells_of(ed.dbuf.status.chip)
    ed.dbuf.status.recording_cells = 0
    ed.dbuf.status.chip_cells = chip_cells
    ed.dbuf.status.body_cells = 0
    ed.dbuf.status.warn_at = 0
    ed.dbuf.status.warn_len = 0
    if cols <= chip_cells {
        return
    }
    let available = cols - chip_cells
    let path = unambiguous_path(ed, bi)
    let p = ed.wins[wi].cs.primary
    let cursor = copy ed.wins[wi].cs.curs[p]
    let line = text.textbuf_line_of(ed.bufs[bi].ec.tb, cursor.pos as text.ByteOff) as int
    let lspan = text.textbuf_line_span(ed.bufs[bi].ec.tb, line as text.LineNo)
    let gcol = text.off_to_gcol(mut ed.bufs[bi].ec.tb, lspan, cursor.pos as text.ByteOff) as int
    let anchored = ed.wins[wi].cs.selstacks[p].n != 0 && cursor.anchor != cursor.pos
    var aline = 0
    var agcol = 0
    if anchored {
        aline = text.textbuf_line_of(ed.bufs[bi].ec.tb, cursor.anchor as text.ByteOff) as int
        let aspan = text.textbuf_line_span(ed.bufs[bi].ec.tb, aline as text.LineNo)
        agcol = text.off_to_gcol(mut ed.bufs[bi].ec.tb, aspan, cursor.anchor as text.ByteOff) as int
    }
    let eol = ed.bufs[bi].ec.meta.eol
    let ncurs = ed.wins[wi].cs.curs.len
    let ro = read_only(ed.bufs[bi])
    clear_bytes(mut ed.dbuf.seg_text)
    seg_str(mut ed.dbuf, 0, if ro then "[ro]" else "", 4, ro)
    seg_str(mut ed.dbuf, 1, if ed.bufs[bi].ec.meta.binary then "utf-8 bin" else "utf-8", 3, true)
    seg_str(mut ed.dbuf, 2, eol_text(eol), 3, true)
    seg_str(mut ed.dbuf, 3, "bom", 3, ed.bufs[bi].ec.meta.had_bom)
    seg_str(mut ed.dbuf, 4, "!utf8", 2, ed.bufs[bi].ec.meta.had_invalid_utf8)
    // `position[112]`: `%llu:%llu`, `@%llu:%llu` with a selection
    // (`statusline.c:448-462`).
    var lo = ed.dbuf.seg_text.len
    push_dec(mut ed.dbuf.seg_text, line + 1)
    push_str(mut ed.dbuf.seg_text, ":")
    push_dec(mut ed.dbuf.seg_text, gcol + 1)
    if anchored {
        push_str(mut ed.dbuf.seg_text, "@")
        push_dec(mut ed.dbuf.seg_text, aline + 1)
        push_str(mut ed.dbuf.seg_text, ":")
        push_dec(mut ed.dbuf.seg_text, agcol + 1)
    }
    seg_put(mut ed.dbuf, 5, lo, 1, true)
    lo = ed.dbuf.seg_text.len
    percent_into(mut ed.dbuf.seg_text, mut ed.wins[wi], ed.bufs[bi].ec.tb)
    seg_put(mut ed.dbuf, 6, lo, 5, true)
    lo = ed.dbuf.seg_text.len
    if ncurs > 1 {
        push_str(mut ed.dbuf.seg_text, "\u{d7}")
        push_dec(mut ed.dbuf.seg_text, ncurs)
    }
    seg_put(mut ed.dbuf, 7, lo, 1, ncurs > 1)
    // The job badge (s19), the search count (s21) and wrap glyph (s20),
    // the syntax badge (s39), diagnostics (s46), the Fortran language
    // (s42), git (s51) and AI (s48): C's slots 8-15, empty before their
    // campaigns.
    seg_str(mut ed.dbuf, 8, "", 2, false)
    // Sprint 21 §3 (`statusline.c:504-530`): `[3/17]`, `[3/10000+]` past
    // the cap; the `+` says the editor stopped counting.
    let ov_total = ed.wins[wi].overlay.count_total
    let ov_capped = ed.wins[wi].overlay.count_capped
    let ov_cur = ed.wins[wi].overlay.cur_index
    lo = ed.dbuf.seg_text.len
    if ov_total != 0 {
        push_str(mut ed.dbuf.seg_text, "[")
        if ov_cur >= 0 {
            push_dec(mut ed.dbuf.seg_text, ov_cur + 1)
            push_str(mut ed.dbuf.seg_text, "/")
        }
        push_dec(mut ed.dbuf.seg_text, ov_total)
        if ov_capped {
            push_str(mut ed.dbuf.seg_text, "+")
        }
        push_str(mut ed.dbuf.seg_text, "]")
    }
    seg_put(mut ed.dbuf, 9, lo, 2, ov_total != 0)
    // The wrap indicator for the two seconds after a search came round
    // (`statusline.c:531-542`).
    let wrap_shown = search_wrap_until(ed) > ed.now_ms
    seg_str(mut ed.dbuf, 10, if wrap_shown then "\u{21bb}" else "", 2, wrap_shown)
    seg_str(mut ed.dbuf, 11, "", 4, false)
    seg_str(mut ed.dbuf, 12, "", 5, false)
    seg_str(mut ed.dbuf, 13, "", 3, false)
    seg_str(mut ed.dbuf, 14, "", 5, false)
    seg_str(mut ed.dbuf, 15, "", 5, false)
    clear_bytes(mut ed.dbuf.path)
    push_str(mut ed.dbuf.path, path)
    var path_cells = cells_of(ed.dbuf.path)
    let dirty = buf_dirty(ed.bufs[bi])
    let dirty_cells = if dirty then 2 else 0
    var right_cells = right_width(ed.dbuf)
    var min_cells = 1 + path_cells + dirty_cells + (if right_cells == 0 then 0 else 2 + right_cells)
    var priority = 5
    while priority >= 1 && min_cells > available {
        drop_priority(mut ed.dbuf, priority)
        right_cells = right_width(ed.dbuf)
        min_cells = 1 + path_cells + dirty_cells + (if right_cells == 0 then 0 else 2 + right_cells)
        priority -= 1
    }
    right_cells = right_width(ed.dbuf)
    let reserved = 1 + dirty_cells + (if right_cells == 0 then 0 else 2 + right_cells)
    var path_budget = available - reserved
    if path_budget < 0 {
        path_budget = 0
    }
    path_clip_into(mut ed.dbuf.path, path, path_budget)
    path_cells = cells_of(ed.dbuf.path)
    push_str(mut ed.dbuf.status.body, " ")
    var k = 0
    while k < ed.dbuf.path.len {
        let b = ed.dbuf.path[k]
        (mut ed.dbuf.status.body).push(b)
        k += 1
    }
    if dirty {
        push_str(mut ed.dbuf.status.body, " *")
    }
    if right_cells != 0 {
        let used = 1 + path_cells + dirty_cells
        var gap = available - used - right_cells
        if gap < 2 {
            gap = 2
        }
        while gap > 0 {
            push_str(mut ed.dbuf.status.body, " ")
            gap -= 1
        }
        var prior = false
        var i = 0
        while i < STATUS_SEGS {
            let sg = copy ed.dbuf.segs[i]
            if sg.shown && sg.hi != sg.lo {
                if prior {
                    push_str(mut ed.dbuf.status.body, "  ")
                }
                if i == 2 && eol == text.EOL_MIXED {
                    ed.dbuf.status.warn_at = ed.dbuf.status.body.len
                }
                var j = sg.lo
                while j < sg.hi {
                    let b = ed.dbuf.seg_text[j]
                    (mut ed.dbuf.status.body).push(b)
                    j += 1
                }
                if i == 2 && eol == text.EOL_MIXED {
                    ed.dbuf.status.warn_len = ed.dbuf.status.body.len - ed.dbuf.status.warn_at
                }
                prior = true
            }
            i += 1
        }
    }
    ed.dbuf.status.body_cells = cells_of(ed.dbuf.status.body)
}

/// `yew_statusline_draw` (`statusline.c:843-885`).
pub fn statusline_draw(mut ed: Ed, wi: int) {
    if ed.footer_rect.h == 0 || ed.footer_rect.y >= ed.grid.rows || ed.grid.cols == 0 {
        return
    }
    let row = ed.footer_rect.y
    var style = statusline_mode_style(ed.mode)
    statusline_apply_theme(ed, ed.mode, mut style)
    let fw = ed.footer_rect.w
    statusline_build_into(mut ed, wi, fw)
    let chip_len = ed.dbuf.status.chip.len
    let body_len = ed.dbuf.status.body.len
    let warn_at = ed.dbuf.status.warn_at
    let warn_len = ed.dbuf.status.warn_len
    var blank = copy ed.grid.blank
    blank.fg = copy style.row_fg
    blank.bg = copy style.row_bg
    blank.attrs = 0
    term.grid_fill(mut ed.grid, row, ed.footer_rect.x, ed.footer_rect.x + ed.footer_rect.w, blank)
    var col = term.grid_puts(
        mut ed.grid,
        row,
        ed.footer_rect.x,
        ed.dbuf.status.chip,
        0,
        chip_len,
        copy style.chip_fg,
        copy style.chip_bg,
        style.attrs,
    )
    if col < ed.grid.cols && body_len != 0 {
        if warn_len != 0 {
            col = term.grid_puts(
                mut ed.grid,
                row,
                col,
                ed.dbuf.status.body,
                0,
                warn_at,
                copy style.row_fg,
                copy style.row_bg,
                0,
            )
            col = term.grid_puts(
                mut ed.grid,
                row,
                col,
                ed.dbuf.status.body,
                warn_at,
                warn_at + warn_len,
                term.color_indexed(STATUS_WARN_COLOR),
                copy style.row_bg,
                term.ATTR_BOLD,
            )
            let _ = term.grid_puts(
                mut ed.grid,
                row,
                col,
                ed.dbuf.status.body,
                warn_at + warn_len,
                body_len,
                copy style.row_fg,
                copy style.row_bg,
                0,
            )
        } else {
            let _ = term.grid_puts(
                mut ed.grid,
                row,
                col,
                ed.dbuf.status.body,
                0,
                body_len,
                copy style.row_fg,
                copy style.row_bg,
                0,
            )
        }
    }
}
