//! edit.cursor_add — yew's collapsed-caret document gestures.
//! H selections keep their existing commands until per-cursor shapes land.

use text

// Registry help is shared by the keys picker and command introspection.
// Keep generated reference descriptors unchanged while stating this scope.
fn cursor_add_help(name: str, fallback: str) -> str {
    match name {
        "ed.cursor.add.above" =>
            "L/W/B/I collapsed carets: add above and promote target (:cursor-above). H mixed-selection additions are held.",
        "ed.cursor.add.below" =>
            "L/W/B/I collapsed carets: add below and promote target (:cursor-below). H mixed-selection additions are held.",
        "ed.cursor.drop" => "Drop the latest secondary caret, preserving primary (:cursor-drop)",
        "ed.cursor.collapse" =>
            "Keep only the primary caret (:cursor-only). H mixed-selection geometry and internal paste remain held.",
        _ => fallback,
    }
}

fn cursor_add_document_mode(mode: int) -> bool {
    mode == MODE_L || mode == MODE_W || mode == MODE_B || mode == MODE_I
}

// E remains the dispatcher mode until the prompt closes. Only a command-line
// invocation may borrow that prompt's originating mode; mouse hit testing
// continues to inspect the real editor mode. H means H, not its borrowed unit.
fn cursor_add_command_mode(ed: Ed, cx: CmdCtx) -> int {
    if cx.source == SRC_CMDLINE &&
        ed.mode == MODE_E &&
        ed.cmdline.active &&
        ed.cmdline.kind == PROMPT_CMD {
        return ed.cmdline.return_mode
    }
    ed.mode
}

fn cursor_add_ready(ed: Ed, w: int) -> bool {
    cursor_add_ready_in_mode(ed, w, ed.mode)
}

fn cursor_add_ready_in_mode(ed: Ed, w: int, mode: int) -> bool {
    if !cursor_add_document_mode(mode) || w < 0 || w >= ed.wins.len {
        return false
    }
    let b = ed.wins[w].buf
    if b < 0 || b >= ed.bufs.len || !ed.bufs[b].resident || ed.wins[w].cs.curs.len == 0 {
        return false
    }
    for c in ed.wins[w].cs.curs {
        if c.pos != c.anchor { return false }
    }
    true
}

// Duplicate detection precedes the cap: promotion never consumes an identity.
// All callers resolve one collapsed target before changing the live set.
fn cursor_add_collapsed(mut ed: Ed, w: int, c: text.Cursor, mode: int) -> int {
    if !cursor_add_ready_in_mode(ed, w, mode) {
        ed_msg(
            mut ed,
            MSG_INFO,
            "Cursor additions need collapsed carets in L/W/B/I; H selections are held",
        )
        return CMD_ERR_STATE
    }
    var existing = -1
    for i in 0..ed.wins[w].cs.curs.len {
        if ed.wins[w].cs.curs[i].pos == c.pos { existing = i; break }
    }
    if existing < 0 && ed.wins[w].cs.curs.len >= text.MC_MAX {
        ed_msg(mut ed, MSG_ERROR, "cursor limit is 10000")
        return CMD_ERR_STATE
    }
    ed_insert_barrier(mut ed)
    if existing >= 0 {
        ed.wins[w].cs.primary = existing
        ed.wins[w].cs.curs[existing].goal_col = c.goal_col
    } else {
        if !text.cset_add(mut ed.wins[w].cs, c) { return CMD_ERR_STATE }
        for i in 0..ed.wins[w].cs.curs.len {
            if ed.wins[w].cs.curs[i].pos == c.pos {
                ed.wins[w].cs.primary = i
                break
            }
        }
    }
    ed_damage_document(mut ed)
    CMD_OK
}

fn cursor_add_document_vertical(mut ed: Ed, cx: CmdCtx, below: bool) -> int {
    let w = cx.win
    let mode = cursor_add_command_mode(ed, cx)
    if !cursor_add_ready_in_mode(ed, w, mode) {
        ed_msg(
            mut ed,
            MSG_INFO,
            "Cursor additions need collapsed carets in L/W/B/I; H selections are held",
        )
        return CMD_ERR_STATE
    }
    let b = ed.wins[w].buf
    var c = copy ed.wins[w].cs.curs[ed.wins[w].cs.primary]
    // Ordinary click placement and cursor_at use zero as their initial goal.
    // Resolve that initial goal at the actual position, then preserve it over
    // short logical lines. A real zero-column goal resolves to zero again.
    if c.goal_col == 0 { c.goal_col = text.CCOL_HERE }
    let before = c.pos
    if below {
        text.cursor_down(ed.bufs[b].ec.tb, mut c, tabw(ed, b))
    } else {
        text.cursor_up(ed.bufs[b].ec.tb, mut c, tabw(ed, b))
    }
    if c.pos == before {
        ed_msg(mut ed, MSG_INFO, if below then "No line below" else "No line above")
        return CMD_OK
    }
    cursor_add_collapsed(mut ed, w, c, mode)
}

/// A resolved grapheme offset, not screen coordinates, is recorded/replayed.
pub fn cursor_add_at_cmd(mut ed: Ed, cx: CmdCtx) -> int {
    let w = cx.win
    let mode = cursor_add_command_mode(ed, cx)
    if !cursor_add_ready_in_mode(ed, w, mode) {
        ed_msg(
            mut ed,
            MSG_INFO,
            "Cursor additions need collapsed carets in L/W/B/I; H selections are held",
        )
        return CMD_ERR_STATE
    }
    let b = ed.wins[w].buf
    if cx.iarg < 0 ||
        cx.iarg > text.textbuf_len(ed.bufs[b].ec.tb) ||
        !text.is_grapheme_boundary(ed.bufs[b].ec.tb, cx.iarg as text.ByteOff) {
        return CMD_ERR_ARG
    }
    var c = text.cursor_at(cx.iarg as text.ByteOff)
    c.goal_col = text.CCOL_HERE
    cursor_add_collapsed(mut ed, w, c, mode)
}
