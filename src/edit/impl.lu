/// Run implementation `which` (the registry's match): answers the status.
pub fn run_impl(mut ed: Ed, which: int, id: int, cx: CmdCtx) -> int {
    match which {
        900 => ws_cmd_save_state(mut ed, cx), // yw06 ws_cmds.c
        901 => ws_cmd_restore_state(mut ed, cx), // yw06 ws_cmds.c
        902 => ws_cmd_info(mut ed, cx), // yw06 ws_cmds.c
        903 => ws_cmd_forget(mut ed, cx), // yw06 ws_cmds.c
        904 => ws_cmd_migrate(mut ed, cx), // yw06 ws_cmds.c
        920 => find_cmd_file(mut ed, cx), // yw06-pick yew_find_cmd_file
        921 => find_cmd_buffer(mut ed, cx), // yw06-pick yew_find_cmd_buffer
        922 => undo_cmd_branches(mut ed, cx), // yw06-pick yew_undo_cmd_branches
        923 => find_cmd_command(mut ed, cx), // yw06-pick yew_find_cmd_command
        950 => mouse_cmd_enable(mut ed, cx), // yew_mouse_cmd_enable (mouse.c:3063)
        951 => mouse_cmd_disable(mut ed, cx), // yew_mouse_cmd_disable (mouse.c:3073)
        980 => ui_cmd_context_menu(mut ed, cx), // yw06-ctx mouse.c yew_ui_cmd_context_menu
        2 => ec_insert_at(mut ed, cx), // IMPL_YEW_EDIT_CMD_INSERT_AT
        3 => ec_delete_span_cmd(mut ed, cx), // IMPL_YEW_EDIT_CMD_DELETE_SPAN
        4 => ec_replace_span(mut ed, cx), // IMPL_YEW_EDIT_CMD_REPLACE_SPAN
        5 => ec_delete_unit(mut ed, cx), // IMPL_YEW_EDIT_CMD_DELETE_UNIT
        6 => ec_move_unit_up(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_UNIT_UP
        7 => ec_move_unit_down(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_UNIT_DOWN
        8 => ec_move_unit_up_alt(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_UNIT_UP_ALT
        9 => ec_move_unit_down_alt(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_UNIT_DOWN_ALT
        10 => fc_buf_open(mut ed, cx), // IMPL_YEW_FILE_CMD_BUF_OPEN
        11 => fc_buf_close(mut ed, cx), // IMPL_YEW_FILE_CMD_BUF_CLOSE
        12 => ec_cursor_set(mut ed, cx), // IMPL_YEW_EDIT_CMD_CURSOR_SET
        13 => cmd_nop_run(ed, cx), // IMPL_CMD_NOP
        14 => shadow_dismiss_cmd(mut ed, cx), // IMPL_YEW_SHADOW_CMD_DISMISS
        15 => fc_quit(mut ed, cx), // IMPL_YEW_FILE_CMD_QUIT
        16 => fc_quit_force(mut ed, cx), // IMPL_YEW_FILE_CMD_QUIT_FORCE
        17 => fc_suspend(mut ed, cx), // IMPL_YEW_FILE_CMD_SUSPEND
        18 => fc_redraw(mut ed, cx), // IMPL_YEW_FILE_CMD_REDRAW
        19 => ec_move_buf_home(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_BUF_HOME
        20 => ec_move_buf_end(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_BUF_END
        21 => ec_move_line_home(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_LINE_HOME
        22 => ec_move_line_home_toggle(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_LINE_HOME_TOGGLE
        23 => ec_move_line_end(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_LINE_END
        24 => ec_move_line_up(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_LINE_UP
        25 => ec_move_line_down(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_LINE_DOWN
        26 => ec_move_line_first_nonblank(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_LINE_FIRST_NONBLANK
        27 => ec_move_line_last_nonblank(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_LINE_LAST_NONBLANK
        28 => ec_move_line_half_page_up(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_LINE_HALF_PAGE_UP
        29 => ec_move_line_half_page_down(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_LINE_HALF_PAGE_DOWN
        30 => ec_move_unit_next(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_UNIT_NEXT
        31 => ec_move_unit_prev(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_UNIT_PREV
        32 => ec_move_unit_home(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_UNIT_HOME
        33 => ec_move_unit_end(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_UNIT_END
        34 => ec_move_unit_next_alt(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_UNIT_NEXT_ALT
        35 => ec_move_unit_prev_alt(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_UNIT_PREV_ALT
        36 => ec_move_unit_home_alt(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_UNIT_HOME_ALT
        37 => ec_move_unit_end_alt(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_UNIT_END_ALT
        38 => ec_move_block_match_prev(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_BLOCK_MATCH_PREV
        39 => ec_move_block_match_next(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_BLOCK_MATCH_NEXT
        40 => ec_move_word_prev(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_WORD_PREV
        41 => ec_move_word_next(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_WORD_NEXT
        42 => ec_move_word_sub_prev(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_WORD_SUB_PREV
        43 => ec_move_word_sub_next(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_WORD_SUB_NEXT
        44 => ec_move_char_prev(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_CHAR_PREV
        45 => ec_move_char_next(mut ed, cx), // IMPL_YEW_EDIT_CMD_MOVE_CHAR_NEXT
        46 => ec_insert_text(mut ed, cx), // IMPL_YEW_EDIT_CMD_INSERT_TEXT
        47 => ec_insert_newline(mut ed, cx), // IMPL_YEW_EDIT_CMD_INSERT_NEWLINE
        48 => ec_insert_tab(mut ed, cx), // IMPL_YEW_EDIT_CMD_INSERT_TAB
        49 => ec_insert_after(mut ed, cx), // IMPL_YEW_EDIT_CMD_INSERT_AFTER
        50 => ec_open_below(mut ed, cx), // IMPL_YEW_EDIT_CMD_OPEN_BELOW
        51 => ec_open_above(mut ed, cx), // IMPL_YEW_EDIT_CMD_OPEN_ABOVE
        52 => ec_delete_grapheme_left(mut ed, cx), // IMPL_YEW_EDIT_CMD_DELETE_GRAPHEME_LEFT
        53 => ec_delete_grapheme(mut ed, cx), // IMPL_YEW_EDIT_CMD_DELETE_GRAPHEME
        54 => ec_delete_line(mut ed, cx), // IMPL_YEW_EDIT_CMD_DELETE_LINE
        55 => ec_undo(mut ed, cx), // IMPL_YEW_EDIT_CMD_UNDO
        56 => ec_redo(mut ed, cx), // IMPL_YEW_EDIT_CMD_REDO
        57 => ec_undo_barrier(mut ed, cx), // IMPL_YEW_EDIT_CMD_UNDO_BARRIER
        58 => ec_mode_enter(mut ed, cx), // IMPL_YEW_EDIT_CMD_MODE_ENTER
