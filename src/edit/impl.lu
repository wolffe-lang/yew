/// The implementation id of C handler `name` (IMPL_UNPORTED when campaign
/// 03 has not ported it).
pub fn impl_of_handler(name: str) -> int {
    match name {
        // yw09 (record.c, flapi_cmds.c)
        "yew_record_cmd_repeat" => 1000,
        "yew_flapi_cmd_win_split" => 1001,
        "yew_flapi_cmd_win_focus" => 1002,
        "yew_flapi_cmd_cursor_set_many" => 1003,
        "yew_flapi_cmd_cursor_move" => 1004,
        "yew_flapi_cmd_span_yank" => 1005,
        "yew_flapi_cmd_reg_set" => 1006,
        "yew_fl_cmd_eval" => 1007,
        "yew_record_cmd_record" => 1008,
        "yew_record_cmd_stop" => 1009,
        "yew_record_cmd_replay" => 1010,
        "yew_record_cmd_replay_last" => 1011,
        "yew_bind_closure_cmd" => 1012,
        "yew_bind_cmd_map" => 1013,
        "yew_opt_cmd_get" => 1014,
        "yew_opt_cmd_set" => 1015,
        "yew_config_cmd_reload" => 1016,
        "yew_config_cmd_edit" => 1017,
        "yew_ws_cmd_save_state" => 900,
        "yew_ws_cmd_restore_state" => 901,
        "yew_ws_cmd_info" => 902,
        "yew_ws_cmd_forget" => 903,
        "yew_ws_cmd_migrate" => 904,
        // yw06-pick (pickers.c)
        "yew_find_cmd_file" => 920,
        "yew_find_cmd_buffer" => 921,
        "yew_undo_cmd_branches" => 922,
        "yew_find_cmd_command" => 923,
        // yw06-mouse: the registry rows `mouse.c` owns.
        "yew_mouse_cmd_enable" => 950,
        "yew_mouse_cmd_disable" => 951,
        "yew_ui_cmd_context_menu" => 980,
        "yew_edit_cmd_insert_at" => IMPL_YEW_EDIT_CMD_INSERT_AT,
        "yew_edit_cmd_delete_span" => IMPL_YEW_EDIT_CMD_DELETE_SPAN,
        "yew_edit_cmd_replace_span" => IMPL_YEW_EDIT_CMD_REPLACE_SPAN,
        "yew_edit_cmd_delete_unit" => IMPL_YEW_EDIT_CMD_DELETE_UNIT,
        "yew_edit_cmd_move_unit_up" => IMPL_YEW_EDIT_CMD_MOVE_UNIT_UP,
        "yew_edit_cmd_move_unit_down" => IMPL_YEW_EDIT_CMD_MOVE_UNIT_DOWN,
