        "yew_edit_cmd_cursor_set" => IMPL_YEW_EDIT_CMD_CURSOR_SET,
        "cmd_nop" => IMPL_CMD_NOP,
        "yew_shadow_cmd_dismiss" => IMPL_YEW_SHADOW_CMD_DISMISS,
        "yew_file_cmd_quit" => IMPL_YEW_FILE_CMD_QUIT,
