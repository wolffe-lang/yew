//! edit.base — the module's small shared pieces: the internal-error exit
//! (C's `YEW_BUG`, `util/log.h`) and the "not yet ported" refusal
//! (invariant 3: an unported path hard-errors naming its sagitta sprint
//! and its port lane).

use util

/// `YEW_BUG` for this module: logs and exits `EXIT_BUG` (`util.bug`).
pub fn bug(message: str) {
    util.bug("edit", message)
}
