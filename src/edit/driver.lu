//! edit.driver — the editor's startup and its one run.
//!
//! Ports `yew_ed_driver_files_opts`, `ed_driver_inner`,
//! `yew_start_plan_resolve`, `start_canonical_dir` and
//! `ed_apply_start_files` (`ed.c:2815-3142`) at 9ace98c2, under
//! `s14-modes-L-I.md` §1 and s56.5 §1 and §6 (the one startup-target
//! resolver). The order is C's: the plan resolved before the terminal (a
//! directory beside another target, or a `--workspace` that is not a
//! directory, refused on stderr before raw mode), the workspace roots (the
//! canonical identity and the user's spelling), the terminal (open, raw,
//! the alternate screen, the probe started — not awaited), the bootstrap
//! scratch tab, the grid and the renderer, the configuration
//! (`runtime/init.fl`, `edit.config`) and its theme, the workspace state
//! opened and RESTORED (`ed.c:3012-3015`), then the startup files applied
//! over the restore (each registered or focused, only the last read), the
//! bootstrap tab closed, a directory launch's F drawer requested, the
//! first layout and paint, the loop, the state's closing save. The
//! workspace is the startup cwd unless `--workspace` or one positional
//! directory selects another — never the first file's parent (s56.5 §1's
//! pitfall). What C does between those steps for later campaigns — the
//! user and workspace configuration (`$XDG_CONFIG_HOME/yew/init.fl`,
//! `.yew.fl`; yw09), `theme_auto`, plugins (yw14), the symbol walk (yw11),
//! the Fletch hooks (yw09), the tutor's startup group and
//! `restore_state_in_clean` (`tutor.c:1034-1040`, yw16) — refuses by name
//! where a user reaches it, and is absent otherwise (a user `init.fl` that
//! needs the VM is reported on the message line, as C reports a
//! configuration error, and the built-in configuration stands). A
//! directory launch's drawer is FUSS's (yw13): `mode_enter(MODE_F)`
//! refuses by name on the message line and the editor stays in L mode,
//! the shape s56.5 §1 gives a build without the module.

use std.fs
use term
use text
use util

/// `YewEdStartup` (`ed.h:94-108`), the fields campaign 03 honours.
pub struct Startup {
    clean: bool,
    config_path: str,
    theme: str,
    has_theme: bool,
    workspace: str,
    has_workspace: bool,
}

/// A default startup.
pub fn startup_default() -> Startup {
    Startup {
        clean: false,
        config_path: "",
        theme: "",
        has_theme: false,
        workspace: "",
        has_workspace: false,
    }
}

fn is_dir(path: str) -> bool {
    fs.is_dir(path)
}

// `user_path` (`flconf.c:146-159`): `--config PATH`, else
// `$XDG_CONFIG_HOME/yew/init.fl`; "" when neither resolves.
fn user_config_path(s: Startup) -> str {
    if s.config_path.len != 0 {
        return s.config_path
    }
    let dir = util.xdg_config_dir() else ""
    if dir.len == 0 then "" else "{dir}/init.fl"
}

/// Load the configuration and its theme (`yew_config_load_all`,
/// `flconf.c:599-627`, then the `theme` option's `yew_theme_apply`,
/// `theme_cmds.c:227-245`): the built-in `runtime/init.fl` (required),
/// the user's `init.fl` (optional; `--config` names it), one option
/// store and one bind ledger across both, each mode's keymap rebuilt
/// from the ledger. `--clean` loads none of them (`source_enabled`,
/// `flconf.c:372-386`). The workspace's `.yew.fl` is trust-gated and
/// campaign 06's (yw06, the trust database): never read here.
pub fn ed_load_config(mut ed: Ed, s: Startup) {
    var c = config_new(opts_default())
    if !s.clean {
        let (found, src, path) = runtime_read("init.fl")
        if !found {
            util.log_at(
                util.LOG_ERROR,
                "config missing: {path} (set YEW_RUNTIME_DIR to the shipped runtime directory)",
            )
        } else {
            config_apply(mut c, src)
            if c.error.len != 0 {
                config_report(mut ed, path, c.error)
            }
        }
        let user = user_config_path(s)
        if user.len != 0 {
            let bytes = fs_read_bytes(user) else |_| List[byte]()
            if bytes.len == 0 {
                util.log_at(util.LOG_INFO, "config missing: {user}")
            } else {
                config_apply(mut c, bytes)
                if c.error.len != 0 {
                    config_report(mut ed, user, c.error)
                }
            }
        }
    }
    ed.config_globals = c.globals
    ed.opts = c.opts
    var m = 0
    while m < MODE_N {
        let (ok, km, row, err) = keymap_build_diag(ed.reg, "config", c.binds[m])
        if ok {
            ed.keymaps[km_bind(m)] = km
        } else {
            let rows = copy c.binds[m]
            config_report(mut ed, "bind {mode_name(m)} {rows[row].seq}", keymap_error_string(err))
        }
        m += 1
    }
    ed.chord_timeout_ms = ed.opts.chord_timeout_ms
    ed.undo_break_on_newline = ed.opts.undo_break_on_newline
    ed.errorbells = ed.opts.errorbells
    ed_theme_set(mut ed, ed.opts.theme)
    var i = 0
    while i < ed.wins.len {
        apply_win_opts(ed.opts, mut ed.wins[i])
        i += 1
    }
}

// A configuration the reader refuses: C's VM would run it, so the port
// names the gap (invariant 3) on the message line and in the log; the
// statements before the refusal stand, as C's would have run.
fn config_report(mut ed: Ed, where: str, what: str) {
    ed.config_error = "not yet ported: {where}: {what}: sagitta Sprint 36 (yw09)"
    util.log_at(util.LOG_ERROR, ed.config_error)
    ed_msg(mut ed, MSG_ERROR, ed.config_error)
}

/// `yew_theme_set` (`theme_cmds.c:247-273`): select and compile `name`;
/// on failure the message names why and the old theme stays.
pub fn ed_theme_set(mut ed: Ed, name: str) {
    if !theme_valid_name(name) {
        ed_msg(mut ed, MSG_ERROR, "invalid theme name '{name}'")
        return
    }
    let (found, src, path) = runtime_theme(name)
    if !found {
        ed_msg(mut ed, MSG_ERROR, "theme '{name}' was not found")
        return
    }
    let (ok, t, err) = theme_compile(src)
    if !ok {
        ed_msg(mut ed, MSG_ERROR, "{path}: {err}")
        return
    }
    if t.name != name {
        ed_msg(mut ed, MSG_ERROR, "theme file '{name}' declares name '{t.name}'")
        return
    }
    ed.theme = t
    theme_sync_surfaces(mut ed)
}

/// `YewStartKind` (`ed.h:75-79`): `yew` with no target.
pub const START_RESUME: int = 0

/// `YEW_START_FILES`: one or more positional files.
pub const START_FILES: int = 1

/// `YEW_START_DIRECTORY`: one positional directory (`yew DIR`, `yew .`).
pub const START_DIRECTORY: int = 2

/// `YewStartPlan` (`ed.h:81-90`): `workspace` is the canonical identity,
/// `workspace_display` the user's spelling; `files` the positional
/// targets in order.
pub struct StartPlan {
    kind: int,
    workspace: str,
    workspace_display: str,
    files: List[str],
    enter_fuss: bool,
}

/// An empty plan (`memset(out, 0, ...)`).
pub fn start_plan_empty() -> StartPlan {
    StartPlan {
        kind: START_RESUME,
        workspace: "",
        workspace_display: "",
        files: List[str](),
        enter_fuss: false,
    }
}

// `start_canonical_dir` (`ed.c:2815-2821`): `stat` says directory, then
// the realpath; "" when either fails.
fn start_canonical_dir(dir: str) -> str {
    if dir.len == 0 || !is_dir(dir) { return "" }
    text.file_realpath(dir) else ""
}

/// `yew_start_plan_resolve` (`ed.c:2823-2883`): the workspace (the cwd, or
/// `--workspace DIR`) canonicalized first; then the first positional
/// directory, which must stand alone and without `--workspace`; else a
/// resume (no targets) or a files start. Answers the plan and "" or the
/// refusal C prints after `yew: error: `.
pub fn start_plan_resolve(paths: List[str], workspace_dir: str, has_workspace: bool) -> (StartPlan, str) {
    var plan = start_plan_empty()
    let ws = if has_workspace then workspace_dir else "."
    plan.workspace = start_canonical_dir(ws)
    if plan.workspace.len == 0 {
        return (plan, "workspace is not a directory: {ws}")
    }
    plan.workspace_display = if has_workspace then workspace_dir else plan.workspace
    var directory = -1
    var i = 0
    while i < paths.len {
        if is_dir(paths[i]) {
            directory = i
            break
        }
        i += 1
    }
    if directory >= 0 {
        let d = paths[directory]
        if paths.len != 1 || has_workspace {
            return (plan, "directory argument cannot be combined with files or --workspace: {d}")
        }
        plan.workspace = start_canonical_dir(d)
        if plan.workspace.len == 0 {
            return (plan, "workspace is not a directory: {d}")
        }
        plan.workspace_display = d
        plan.kind = START_DIRECTORY
        plan.enter_fuss = true
        return (plan, "")
    }
    plan.kind = if paths.len == 0 then START_RESUME else START_FILES
    plan.files = copy paths
    (plan, "")
}

// `ed_apply_start_files` (`ed.c:2885-2917`): every target registered
// first, in order — a restored tab with the same canonical path FOCUSED,
// never duplicated (`yew_tab_find_by_path`) — then ONLY the last one, the
// one the user sees, read and switched to; the others stay non-resident
// until their first switch (YEW-F-072). Answers "" or the target that
// could not be opened.
fn ed_apply_start_files(mut ed: Ed, files: List[str]) -> str {
    var last_idx = -1
    for p in files {
        var idx = tab_find_by_path(ed, p)
        if idx < 0 {
            idx = tab_open(mut ed, p)
        }
        if idx < 0 {
            return p
        }
        last_idx = idx
    }
    if last_idx >= 0 && tab_hydrate(mut ed, last_idx) != 0 {
        return files[files.len - 1]
    }
    tab_switch(mut ed, last_idx)
    ""
}

/// `yew_ed_driver_files_opts` and `ed_driver_inner` (`ed.c:2919-3142`)
/// over `paths`.
pub fn ed_run(paths: List[str], s: Startup) -> int {
    let (plan, err) = start_plan_resolve(paths, s.workspace, s.has_workspace)
    if err.len != 0 {
        eprint("yew: error: {err}")
        return util.EXIT_ERR
    }
    var ed = ed_new()
    ed.clean = s.clean
    if !ed_set_workspace_roots(mut ed, plan.workspace, plan.workspace_display) {
        eprint("yew: error: workspace is not a directory: {plan.workspace}")
        return util.EXIT_ERR
    }
    // `workspace_state` (`ed.c:2945-2946`): `--clean` keeps no state.
    let workspace_state = !ed.clean
    term.tty_open(mut ed.tty) else |e| {
        term.tty_close(mut ed.tty)
        return if "{e}" == "not_tty" then util.EXIT_ERR else util.EXIT_IO
    }
    ed.tty_ready = true
    term.tty_raw(mut ed.tty) else |_| {
        term.tty_close(mut ed.tty)
        return util.EXIT_IO
    }
    term.tty_altscreen(mut ed.tty, true)
    if !term.tty_is_alt(ed.tty) {
        term.tty_close(mut ed.tty)
        return util.EXIT_IO
    }
    term.tty_probe_start(mut ed.tty, now_ms())
    let caps = term.tty_caps(ed.tty)
    term.input_enable(caps)
    ed.input = term.input_new(caps)
    ed.input_ready = true
    ed_open_scratch(mut ed)
    let bootstrap = ed.tabs[0].tab_id
    let rows = if term.tty_rows(ed.tty) > 0 then term.tty_rows(ed.tty) else 24
    let cols = if term.tty_cols(ed.tty) > 0 then term.tty_cols(ed.tty) else 80
    ed.grid = term.grid_new(rows, cols)
    ed.grid_ready = true
    ed.render = term.render_new(term.tty_caps(ed.tty), term.env_process())
    ed.render_ready = true
    ed_load_config(mut ed, s)
    if s.has_theme {
        ed_theme_set(mut ed, s.theme)
    } else {
        let (env_theme, present) = term.env_getv("YEW_THEME")
        if present {
            ed_theme_set(mut ed, env_theme)
        }
    }
    // State comes up AFTER the buffers so a restore has somewhere to land
    // (`ed.c:3008-3015`), and is RESTORED before the explicit files are
    // applied (s56.5 §1): a restored tab a file names is focused, a new
    // file is a new tab, the final file is active.
    if workspace_state {
        state_open(mut ed)
        let _ = ws_restore(mut ed)
    }
    if plan.files.len != 0 {
        let failed = ed_apply_start_files(mut ed, plan.files)
        if failed.len != 0 {
            state_dispose(mut ed)
            term.tty_close(mut ed.tty)
            eprint("yew: error: cannot open tab: {failed}")
            return util.EXIT_IO
        }
        // The untitled tab existed only so state had a model to restore
        // into: explicit targets replace that bootstrap tab, never
        // restored tabs, groups, panes or cursors (`ed.c:3032-3040`).
        if ed.tabs.len > 1 {
            let b = tab_index_of_id(ed, bootstrap)
            if b >= 0 {
                let _ = tab_close(mut ed, b)
            }
        }
    }
    // A directory launch requests the F drawer (`ed.c:3089-3090`): FUSS is
    // yw13's, so the request refuses by name on the message line, once,
    // and leaves a usable L-mode editor (s56.5 §1's module-less shape).
    if plan.enter_fuss {
        let _ = mode_enter(mut ed, MODE_F)
    }
    ed_layout(mut ed)
    ed_render(mut ed)
    let result = if ed.quit then ed.exit_code else loop_run(mut ed)
    // Teardown kills every live job's group and reaps it: no orphan may
    // hold the terminal (`ed.c:870-873`, `job.c:324-341`).
    if workspace_state {
        state_close(mut ed)
    }
    jobs_free(mut ed)
    text.clip_shutdown(mut ed.regs.clip)
    term.input_disable()
    term.tty_altscreen(mut ed.tty, false)
    term.tty_close(mut ed.tty)
    result
}
