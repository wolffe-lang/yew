//! edit.option — the one typed option table Fletch and E mode share
//! (Sprint 36): sagitta 9ace98c2 src/edit/option.c:1-1907 and option.h.
//!
//! The descriptor table is C's, row for row and in its order (option.c:
//! 213-479). A value lives in the global store, or for a buffer- or
//! window-scoped option in that buffer's or window's override map; a read
//! falls from window to buffer to global. Every write runs one setter that
//! validates (type, range, enum, the per-option validators, the module
//! gate) and then applies the option's editor effect (option_changed_
//! target, option.c:805-934).
//!
//! `set({...})` from Fletch is a registration: each name is checkpointed,
//! set, and committed to the hook table's ledger as REG_OPTION under the
//! calling origin, so removing a registration (an origin's teardown, or a
//! reload) restores the value beneath it, splicing around newer layers
//! (option.c:1301-1593).
//!
//! The port is module-less (edit.mods): every module-owned option keeps
//! its descriptor and refuses a write with C's words. Plugin-declared
//! options (`ctx.set`, option.c:1595-1803) are yw14's; the effects that
//! reach unported surfaces say whose they are where they would run.

use fl
use text
use unicode
use util

/// `OptValType` (option.h:18-24).
pub const OPT_BOOL: int = 0

/// An integer.
pub const OPT_INT: int = 1

/// A string.
pub const OPT_STR: int = 2

/// One of the descriptor's names.
pub const OPT_ENUM: int = 3

/// A list of strings.
pub const OPT_STRLIST: int = 4

/// `OptScope` (option.h:26-31).
pub const OPT_GLOBAL: int = 0

/// Per buffer.
pub const OPT_BUFFER: int = 1

/// Per window.
pub const OPT_WINDOW: int = 2

/// The descriptor's own scope.
pub const OPT_SCOPE_DECLARED: int = 255

/// `OptModule` (option.h:33-41): zero is core; the rest are YewMod + 1.
pub const OPT_MODULE_CORE: int = 0

/// LSP's.
pub const OPT_MODULE_LSP: int = 1

/// The AI module's.
pub const OPT_MODULE_AI: int = 2

/// FUSS's.
pub const OPT_MODULE_FUSS: int = 3

/// Plugins'.
pub const OPT_MODULE_PLUGINS: int = 4

/// No validator beyond type, range and enum.
const VALIDATE_NONE: int = 0

/// `shadow_providers_validate` (option.c:135-173).
const VALIDATE_SHADOW_PROVIDERS: int = 1

/// `ai_exclude_paths_validate` (option.c:175-199).
const VALIDATE_AI_EXCLUDE: int = 2

const I64_MIN: int = -9223372036854775807 - 1

const I64_MAX: int = 9223372036854775807

/// `OptVal` (option.h:48-59): the field the type names holds the value.
pub struct OptVal {
    t: int,
    b: bool,
    i: int,
    s: str,
    list: List[str],
}

/// `OptDesc` (option.h:61-74); C's validate pointer is a validator id,
/// and every row's on_change is option_changed.
pub struct OptDesc {
    name: str,
    t: int,
    oscope: int,
    dflt: OptVal,
    enums: List[str],
    imin: int,
    imax: int,
    validator: int,
    help: str,
    module: int,
}

/// `YewOptUndo` (option.c:48-57): one checkpoint, pending until committed
/// as a ledger registration, active until removed.
pub struct OptUndo {
    previous: OptVal,
    order: int,
    target_id: int,
    ledger_id: int,
    desc_index: int,
    oscope: int,
    pending: bool,
    active: bool,
}

/// The editor's option state: the table, the global store, the in-flight
/// guard and the registration history (C's opt_globals, opt_inflight and
/// opt_history).
pub struct OptState {
    descs: List[OptDesc],
    globals: List[OptVal],
    // C's Buffer.opt_overrides and Win.opt_overrides, keyed by the stable
    // buffer and window ids (an id is never reused).
    buf_over: Map[int, Map[str, OptVal]],
    win_over: Map[int, Map[str, OptVal]],
    inflight: List[bool],
    undo: List[OptUndo],
    next_order: int,
    theme_inflight: bool,
}

/// A boolean value.
pub fn optv_bool(b: bool) -> OptVal { OptVal { t: OPT_BOOL, b: b, i: 0, s: "", list: List[str]() } }

/// An integer value.
pub fn optv_int(i: int) -> OptVal { OptVal { t: OPT_INT, b: false, i: i, s: "", list: List[str]() } }

/// A string value.
pub fn optv_str(s: str) -> OptVal { OptVal { t: OPT_STR, b: false, i: 0, s: s, list: List[str]() } }

/// An enum value.
pub fn optv_enum(s: str) -> OptVal { OptVal { t: OPT_ENUM, b: false, i: 0, s: s, list: List[str]() } }

/// An empty string list.
pub fn optv_list(list: List[str]) -> OptVal {
    OptVal { t: OPT_STRLIST, b: false, i: 0, s: "", list: list }
}

fn od(
    name: str,
    t: int,
    oscope: int,
    dflt: OptVal,
    enums: List[str],
    imin: int,
    imax: int,
    help: str,
    module: int,
) -> OptDesc {
    OptDesc {
        name: name,
        t: t,
        oscope: oscope,
        dflt: dflt,
        enums: enums,
        imin: imin,
        imax: imax,
        validator: VALIDATE_NONE,
        help: help,
        module: module,
    }
}

fn odb(name: str, oscope: int, d: bool, help: str, module: int) -> OptDesc {
    od(name, OPT_BOOL, oscope, optv_bool(d), List[str](), 0, 0, help, module)
}

fn odi(name: str, oscope: int, d: int, lo: int, hi: int, help: str, module: int) -> OptDesc {
    od(name, OPT_INT, oscope, optv_int(d), List[str](), lo, hi, help, module)
}

fn ods(name: str, d: str, help: str, module: int) -> OptDesc {
    od(name, OPT_STR, OPT_GLOBAL, optv_str(d), List[str](), 0, 0, help, module)
}

fn ode(name: str, oscope: int, d: str, enums: List[str], help: str, module: int) -> OptDesc {
    od(name, OPT_ENUM, oscope, optv_enum(d), enums, 0, 0, help, module)
}

/// `yew_opts` (option.c:213-479), in C's order.
pub fn opt_table() -> List[OptDesc] {
    let core = OPT_MODULE_CORE
    let ai = OPT_MODULE_AI
    var t = List[OptDesc]()
    (mut t).push(odi("tabwidth", OPT_BUFFER, 4, 1, 16, "Indent and tab display width (1..16)", core))
    (mut t).push(odb("expandtab", OPT_BUFFER, false, "Insert spaces when indentation emits a tab", core))
    (mut t).push(odb("autoindent", OPT_BUFFER, true, "Carry indentation onto the line Enter opens", core))
