    (mut t).push(odb("wrap", OPT_WINDOW, false, "Wrap long lines in this window", core))
    (mut t).push(odi("scrolloff", OPT_WINDOW, 3, 0, 99, "Minimum screen rows around the cursor", core))
    (mut t).push(ode(
        "number",
        OPT_WINDOW,
        "both",
        ["off", "abs", "rel", "both"],
        "Line numbers: off, abs, rel, or both",
        core,
    ))
    (mut t).push(ode(
        "statusline.column",
        OPT_GLOBAL,
        "gcol",
        ["gcol", "gcol_ccol"],
        "Show grapheme column or grapheme and cell columns",
