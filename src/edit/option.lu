    ))
    (mut t).push(odb("errorbells", OPT_GLOBAL, false, "Ring the terminal bell for editor errors", core))
    (mut t).push(odb(
        "ambiguous_wide",
        OPT_GLOBAL,
        false,
        "Render document East Asian ambiguous characters as two cells",
        core,
    ))
    (mut t).push(odb("subword", OPT_BUFFER, false, "Use subword boundaries for word navigation", core))
    (mut t).push(ode(
        "fortran_form",
        OPT_BUFFER,
        "auto",
        ["auto", "free", "fixed"],
        "Fortran source form: auto, free, or fixed",
        core,
    ))
    (mut t).push(odi("chord_timeout_ms", OPT_GLOBAL, 500, 0, 5000, "Milliseconds to wait for a key chord", core))
    (mut t).push(odb("undo.break_on_newline", OPT_BUFFER, true, "End an insert undo group at a newline", core))
    (mut t).push(odi(
        "undo.bytes_max",
        OPT_BUFFER,
        67108864,
        1,
        I64_MAX,
        "Maximum in-memory undo bytes per buffer",
