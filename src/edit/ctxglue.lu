//! edit.ctxglue — the router's context-menu glue: opening, closing, the
//! row's dispatch, the menu's key layer and its draw.
//!
//! Ports sagitta `src/ui/mouse.c:390-1123` at 9ace98c2 (Sprint 27 §5,
//! Sprint 57.13 §1-§3 and §6, Sprint 57.15 §2's second 1003 want) — the
//! half of `mouse.c` the context menu cannot work without. The yw06 forks
//! split `mouse.c` (2026-10-23): `edit.mouse` (the `yw06-mouse` fork)
//! ports the router and folds THIS FILE into itself at its merge, under
//! these exact names (C's less `yew_`); `mouse_context_at` and the right
//! press stay the router's. Every function here is C's, line for line.
//!
//! THE ONE 1003 OWNER (`mouse.c:484-543`): any-motion reporting is a
//! FUNCTION of its two wants — an open menu and a drawn strip chevron —
//! recomputed by `motion_sync` and nowhere else (`edit.tabs` holds the
//! strip's half and `motion_wanted`). THE ONE CLOSE PATH (`menu_close`):
//! every way a menu goes away ends there, so 1003 is never left armed.
//! The region table is FROZEN while a row runs (`apply_menu_action`) and
//! thawed on every path out.
//!
//! The overlay layers a row can target before their lanes have no
//! instance here, as `edit.input`'s header has it for the key route: the
//! list picker (`CTX_TGT_PICK`, its `Close`) is `yw06-pick`'s and wired
//! at its merge; the completion popup and the floating panel are yw11's;
//! the FUSS selection is yw13's (F mode cannot be entered before it, so
//! `yew_fuss_select_path` is C's no-op with F mode down). None can be open
//! in this branch, so each answers as C's does when it is not.

use term

/// A keyboard/focus anchor: the corner below-right (`MENU_PLACE_AFTER_
/// ANCHOR`, `mouse.c:593-596`).
pub const MENU_PLACE_AFTER_ANCHOR: int = 0

/// A pointer cell: the corner on the click (`MENU_PLACE_AT_POINTER`).
pub const MENU_PLACE_AT_POINTER: int = 1

/// `menu_allowed` (`mouse.c:402-410`): everything above the footer.
pub fn menu_allowed(ed: Ed) -> Rect {
    var rows = ed.grid.rows
    if rows > 1 {
        rows -= 1
    }
    rect(0, 0, ed.grid.cols, rows)
}

/// `menu_role_style` (`mouse.c:412-438`): a UI role is an OVERLAY — a
/// colour only where it names one; presence owns the attributes, so
/// `mono: "plain"` clears a rendition's emphasis.
pub fn menu_role_style(ed: Ed, role: str, fallback_in: ThemeEnt) -> ThemeEnt {
    var fallback = fallback_in
    let (ok, themed) = theme_ui(ed.theme, role, theme_rendition_of(ed.render))
    if !ok {
        return fallback
    }
    if themed.fg.tag != term.COLOR_DEFAULT {
        fallback.fg = copy themed.fg
    }
    if themed.bg.tag != term.COLOR_DEFAULT {
        fallback.bg = copy themed.bg
    }
    fallback.attrs = themed.attrs
    fallback
}

/// `menu_base_style` (`mouse.c:440-455`): the editor's `fg`/`bg`, no
/// attributes.
pub fn menu_base_style(ed: Ed) -> ThemeEnt {
    let r = theme_rendition_of(ed.render)
    let (hf, fg) = theme_ui(ed.theme, "fg", r)
    let (hb, bg) = theme_ui(ed.theme, "bg", r)
    var style = ThemeEnt { fg: term.color_default(), bg: term.color_default(), attrs: 0 }
    if hf && fg.fg.tag != term.COLOR_DEFAULT {
        style.fg = copy fg.fg
    }
    if hb && bg.bg.tag != term.COLOR_DEFAULT {
        style.bg = copy bg.bg
    }
    style
}

/// `menu_emphasis` (`mouse.c:457-461`).
pub fn menu_emphasis(base_in: ThemeEnt, attrs: int) -> ThemeEnt {
    var base = base_in
    base.attrs = base.attrs | attrs
    base
}

/// `menu_style` (`mouse.c:463-479`): the six `menu.*` roles (Sprint 57.13
/// §6), each over the surface with attributes alone as the fallback —
/// reverse hover, dim greyed rows, accelerators and rules — so the menu is
/// legible before any theme is, and under NO_COLOR.
pub fn menu_style(ed: Ed) -> CtxStyle {
    let surface = menu_role_style(ed, "menu.surface", menu_base_style(ed))
    let row = menu_role_style(ed, "menu.row", copy surface)
    let hover = menu_role_style(ed, "menu.hover", menu_emphasis(copy surface, term.ATTR_REVERSE))
    let disabled = menu_role_style(ed, "menu.disabled", menu_emphasis(copy surface, term.ATTR_DIM))
    let accel = menu_role_style(ed, "menu.accel", menu_emphasis(copy surface, term.ATTR_DIM))
    let sep = menu_role_style(ed, "menu.sep", menu_emphasis(copy surface, term.ATTR_DIM))
    CtxStyle {
        surface: surface,
        row: row,
        hover: hover,
        disabled: disabled,
        accel: accel,
        sep: sep,
    }
}

/// `motion_sync` (`mouse.c:514-517`): the mode recomputed from its wants
/// (`motion_wanted`, `edit.tabs`). A headless editor has no terminal to
/// tell, as `mouse_note_chevrons` has it.
pub fn motion_sync(mut ed: Ed) {
    if ed.tty_ready {
        term.tty_mouse_motion(mut ed.tty, motion_wanted(ed))
    }
}

/// `menu_close` (`mouse.c:545-566`): THE ONE CLOSE PATH — a row fired, a
/// key, Esc, a click outside, a wheel, the mouse disabled — and it asks
/// the owner to recompute rather than disarming on its own authority.
/// Safe with nothing open.
pub fn menu_close(mut ed: Ed) {
    ctx_close(mut ed.ctx)
    motion_sync(mut ed)
    ed.full_damage = true
}

/// `menu_settle` (`mouse.c:568-577`): the widget deactivated itself (Esc,
/// a chosen row); 1003 follows it out.
pub fn menu_settle(mut ed: Ed) {
    if !ctx_active(ed.ctx) {
        menu_close(mut ed)
    }
}

/// `menu_open_at` (`mouse.c:579-620`): closes what was up, builds `c`,
/// captures the clicked CELL as the target rect, places the box (clamped)
/// at the anchor or the pointer; a refused build or a box that cannot hold
/// its priority-0 rows opens nothing and leaves 1003 disarmed.
pub fn menu_open_at(
    mut ed: Ed,
    c: CtxContext,
    anchor_x: int,
    anchor_y: int,
    cell_x: int,
    cell_y: int,
    placement: int,
) -> bool {
    menu_close(mut ed)
    ctx_build(mut ed, c)
    ctx_target_rect(mut ed.ctx, rect(cell_x, cell_y, 1, 1))
    let allowed = menu_allowed(ed)
    let shown = if placement == MENU_PLACE_AT_POINTER {
        ctx_show_at(mut ed.ctx, anchor_x, anchor_y, allowed)
    } else {
        ctx_show(mut ed.ctx, anchor_x, anchor_y, allowed)
    }
    if !shown {
        menu_close(mut ed)
        return false
    }
    motion_sync(mut ed)
    ed.full_damage = true
    true
}

/// `yew_mouse_open_tab_menu` (`mouse.c:622-633`).
pub fn mouse_open_tab_menu(mut ed: Ed, tab_id: int, x: int, y: int) -> bool {
    let c = ctxcontext_new(CTX_KIND_TAB, tab_id)
    menu_open_at(mut ed, c, x, y, x, y, MENU_PLACE_AFTER_ANCHOR)
}

/// `yew_mouse_open_group_menu` (`mouse.c:635-646`).
pub fn mouse_open_group_menu(mut ed: Ed, gid: int, x: int, y: int) -> bool {
    let c = ctxcontext_new(CTX_KIND_GROUP, gid)
    menu_open_at(mut ed, c, x, y, x, y, MENU_PLACE_AFTER_ANCHOR)
}

/// `apply_target` (`mouse.c:874-970`): the captured target put in place,
/// false when it is gone — and then NOTHING runs (a row fired against
/// whatever inherited the identity would act on a file the user never
/// pointed at).
pub fn apply_target(mut ed: Ed, d: CtxActionDesc, id: int, cell: Rect) -> bool {
    let t = d.target
    if t == CTX_TGT_TAB {
        // The target becomes active first, resolved from its ID.
        let idx = tab_index_of_id(ed, id)
        if idx < 0 {
            return false
        }
        tab_switch(mut ed, idx)
        return true
    }
    if t == CTX_TGT_GROUP {
        if group_find(ed, id) < 0 {
            return false
        }
        if active_group_id(ed) != id {
            group_enter(mut ed, id)
        }
        return true
    }
    if t == CTX_TGT_PANE || t == CTX_TGT_LEAF {
        let leaf = pane_leaf_by_index(ed, id)
        if leaf < 0 {
            return false
        }
        // `yew_pane_click` re-resolves the leaf from the FROZEN region
        // table and cannot be used; the leaf and the cell were captured at
        // open precisely so this path needs neither (`mouse.c:909-916`).
        pane_refocus(mut ed, leaf)
        // CTX_TGT_LEAF STOPS HERE: placing the caret collapses the
        // selection Cut/Copy/Delete act on.
        let wi = ed.panes[leaf].win
        if t == CTX_TGT_PANE && wi >= 0 && wi < ed.wins.len && ed.wins[wi].buf >= 0 {
            win_click_to_cursor(mut ed, wi, cell.x, cell.y)
        }
        return true
    }
    if t == CTX_TGT_PICK {
        // `yew_picker_active` (`mouse.c:930-937`): the list picker is
        // yw06-pick's, wired at its merge; none is open in this branch.
        return false
    }
    if t == CTX_TGT_COMPL {
        // The completion popup is yw11's: none is open (`mouse.c:938-942`).
        return false
    }
    if t == CTX_TGT_GP_ROW {
        // The captured LISTING INDEX can be gone (`mouse.c:943-951`).
        return gp_select_row(mut ed, id)
    }
    // CTX_TGT_PATH / CTX_TGT_FUSS_ROW: `yew_fuss_select_path` is a no-op
    // with F mode down (yw13: F mode cannot be entered before it); the
    // path travels as `cx.sarg` (`mouse.c:952-964`). CTX_TGT_NONE: as-is.
    true
}

/// `close_overlay_for` (`mouse.c:972-1007`): WHICH overlay a `Close` row
/// closes is the MENU'S OWN KIND. The panel and the completion popup are
/// yw11's and the list picker yw06-pick's: none is open here.
pub fn close_overlay_for(mut ed: Ed, kind: int) {
    if (kind == CTX_KIND_GP_ROW || kind == CTX_KIND_GP) && gp_active(ed) {
        gp_close(mut ed)
    }
}

/// `invoke_desc` (`mouse.c:1009-1033`): the row's registry command, its
/// `iarg`, `SRC_MOUSE` (Sprint 27's `YEW_SRC_KEY` here was wrong); a
/// path-addressed row with no path does nothing.
pub fn invoke_desc(mut ed: Ed, d: CtxActionDesc, path: str, has_path: bool) {
    let id = cmd_lookup(ed.reg, d.cmd)
    var cx = cmdctx_new(ed.win, SRC_MOUSE)
    cx.iarg = d.iarg
    if d.target == CTX_TGT_PATH {
        if !has_path || path.len == 0 {
            return
        }
        cx.sarg = path
        cx.has_sarg = true
    }
    let _ = ed_cmd_invoke(mut ed, id, mut cx)
}

/// `apply_menu_action` (`mouse.c:1035-1071`): the chosen row, against the
/// target the menu captured, TABLE-DRIVEN (`ctx_actions` is its only
/// meaning). The region table is FROZEN for the run and thawed on every
/// path out.
pub fn apply_menu_action(mut ed: Ed) {
    let action = ctx_take(mut ed.ctx)
    let kind = ctx_kind(ed.ctx)
    let target = ctx_target_id(ed.ctx)
    let has_path = ed.ctx.has_target_path
    let path = ed.ctx.target_path
    let cell = ctx_target_rect_get(ed.ctx)
    if action == CTXA_NONE || action >= CTXA_N {
        return
    }
    let d = ctx_actions(action)
    region_freeze(mut ed.regions, true)
    if apply_target(mut ed, d, target, cell) {
        if d.has_cmd {
            invoke_desc(mut ed, d, path, has_path)
        } else if d.target == CTX_TGT_NONE {
            close_overlay_for(mut ed, kind)
        }
    }
    region_freeze(mut ed.regions, false)
    ed.layout_dirty = true
    ed.full_damage = true
}

/// `yew_mouse_menu_key` (`mouse.c:1073-1085`): the menu is a keymap layer
/// — it takes the key before any mode does and swallows what it does not
/// use; Esc and Enter leave the widget inactive, and 1003 follows.
pub fn mouse_menu_key(mut ed: Ed, k: term.Key) -> bool {
    if !ctx_active(ed.ctx) {
        return false
    }
    if !ctx_key(mut ed.ctx, k) {
        return false
    }
    apply_menu_action(mut ed)
    menu_settle(mut ed)
    ed.full_damage = true
    true
}

/// `yew_mouse_menu_draw` (`mouse.c:1087-1113`): the menu's own regions go
/// first — a hover repaint does not begin a frame, so re-adding without
/// removing would push the table past its ceiling: CTX_ROW by kind (the
/// menu's alone), the BLOCK by RECT (shared with every modal). The style
/// resolved once per draw from the theme.
pub fn mouse_menu_draw(mut ed: Ed) {
    region_remove_kind(mut ed.regions, REGION_CTX_ROW)
    region_remove_rect(mut ed.regions, REGION_BLOCK, ctx_box(ed.ctx))
    let style = menu_style(ed)
    ctx_draw(ed.ctx, mut ed.grid, mut ed.regions, style)
}
