//! edit.shadow_context — Insert's context-sensitive Alt+Down.
//! Follows sagitta src/edit/shadow_cmds.c:26-61's accept-or-word dispatch
//! pattern: inspect visibility once, then invoke the named target through
//! the registry, so the recorder sees the command that actually ran.
//!
//! No shadow provider or drawn shadow state is ported yet. The shared
//! visibility seam therefore answers false; actual visible-shadow
//! acceptance remains unmeasured until the shadow/AI phase. The existing
//! ed.shadow.accept_line handler keeps its named Sprint-43 refusal.

/// The common drawn-shadow predicate. No provider can make one visible
/// at this pin; the future shadow port replaces this one seam.
pub fn shadow_visible(ed: Ed, win: int) -> bool {
    let _ = ed.mode
    let _ = win
    false
}

/// Route a captured visibility answer. The bool is explicit so a probe
/// can cover both branches without pretending to draw a real suggestion.
/// Acceptance failure never falls through to a line move.
pub fn shadow_line_dispatch(mut ed: Ed, cx: CmdCtx, showing: bool) -> int {
    if cx.win < 0 || cx.win >= ed.wins.len { return CMD_ERR_STATE }
    let name = if showing then "ed.shadow.accept_line" else "ed.edit.lines.down"
    let id = cmd_lookup(ed.reg, name)
    if id == 0 { bug("shadow line dispatch: target command is missing") }
    var again = copy cx
    ed_cmd_invoke(mut ed, id, mut again)
}

/// Internal key plumbing: the child command owns its transaction and
/// recording. Insert Alt+Down moves a line today because no shadow is
/// drawable, while preserving the future accepting half of the key.
pub fn shadow_cmd_accept_or_line(mut ed: Ed, cx: CmdCtx) -> int {
    let showing = shadow_visible(ed, cx.win)
    shadow_line_dispatch(mut ed, cx, showing)
}
