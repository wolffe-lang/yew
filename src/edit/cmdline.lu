//! edit.cmdline — the `:`, `/` and `?` prompt (E mode).
//!
//! Ports sagitta `src/ui/cmdline.c` (3,957 lines) and `cmdline.h` at
//! 9ace98c2 under `s18-cmdline.md` §1–§2, §7, `s18_5-reactive-cmdline.md`
//! §6–§9, `s57_17`, `s57_28`–`s57_31`. It replaces yw03's narrow `:`
//! (R-yw03-1) and keeps its shape: the prompt is a one-line `TextBuf` with
//! a real cursor in its own hidden `Win` — the TARGET the E-mode editing
//! commands run on through the registry (`yew_cmdline_target`), so there
//! is no second editor (s18 DoD 3). C copies the target's primary cursor
//! into `CmdLine.cur` and syncs it back and forth (`sync_from_target`,
//! `sync_to_target`, `cmdline.c:146-162`); the port reads and writes the
//! target window's cursor itself, so the two can never drift. C's prompt
//! target is a fresh buffer and window per prompt; the port keeps one
//! window and buffer for the session and gives each prompt a fresh edit
//! context (text, undo tree, marks). C's file-static `comp_idle_dirty`
//! (`cmdline.c:56-58`) is a field (module state of a run-time value is
//! E1010, the threaded-value idiom), and C's `YewCmdlineInputDone`
//! callback with its `void *ctx` is a KIND matched in one place
//! (`cmdline_input_done`, G19/G20).
//!
//! This file is the prompt's core: open, close, restore, the target,
//! typing and pasting through `ed.edit.insert.text`, the selection and its
//! collapse table (s57.29), errors and their caret (s18 §7), accept and
//! cancel, the register and literal inserts, and the draw.

use term
use text
use unicode

/// The `:` prompt (`YEW_PROMPT_CMD`).
pub const PROMPT_CMD: int = 0

/// The forward search prompt `/` (`YEW_PROMPT_SEARCH_F`).
pub const PROMPT_SEARCH_F: int = 1

/// The backward search prompt `?` (`YEW_PROMPT_SEARCH_B`).
pub const PROMPT_SEARCH_B: int = 2

/// A question another subsystem asks (`YEW_PROMPT_INPUT`).
pub const PROMPT_INPUT: int = 3

/// No answer is awaited (C's NULL `input_done`).
pub const INPUT_DONE_NONE: int = 0

/// The unit tests' probe: the answer is recorded in `CmdLine.input_*`.
pub const INPUT_DONE_TEST: int = 1

// `YEW_CMDLINE_TABWIDTH` (`cmdline.c:37`).
const CMDLINE_TABWIDTH: int = 4

/// One token a token walk showed (`YewTokHit`, `cmdline.h:28-35`): word
/// `word` of view entry `entry`, bytes [lo, hi) of it.
pub struct TokHit {
    entry: int,
    word: int,
    lo: int,
    hi: int,
}

/// The command line (`CmdLine`, `cmdline.h:37-150`).
pub struct CmdLine {
    kind: int,
    active: bool,
    generation: int,
    target_win: int,
    err_lo: int,
    err_hi: int,
    err_msg: str,
    hint: str,
    scroll: int,
    click_row: int,
    return_mode: int,
    hsearch: bool,
    hsearch_line: List[byte],
    walk_prefix: int,
    walk_bang: bool,
    comp_total: int,
    comp_asked: bool,
    comp_idle_dirty: bool,
    menu_stem: List[byte],
    has_menu_stem: bool,
    menu_original: text.Span,
    suggest_loaded: bool,
    input_done: int,
    input_ctx: int,
    input_seen: int,
    input_accepted: bool,
    input_closed: bool,
    input_text: List[byte],
    last_arg_seq: int,
    last_arg_gen: int,
    last_arg_entry: int,
    last_arg_span: text.Span,
    tok_seq: int,
    tok_gen: int,
    tok_bang: bool,
    tok_term: List[byte],
    tok_span: text.Span,
    tok_seen: List[TokHit],
    seam_calls: int,
    filter: CompFilter,
    menu: Menu,
    history: CmdHist,
    has_history: bool,
    memory_history: List[CmdHist],
    memory_has: List[bool],
    walk: HistWalk,
    suggest: HistSuggest,
}

/// A closed command line.
pub fn cmdline_new() -> CmdLine {
    CmdLine {
        kind: PROMPT_CMD,
        active: false,
        generation: 0,
        target_win: -1,
        err_lo: 0,
        err_hi: 0,
        err_msg: "",
        hint: "",
        scroll: 0,
        click_row: -1,
        return_mode: MODE_L,
        hsearch: false,
        hsearch_line: List[byte](),
        walk_prefix: 0,
        walk_bang: false,
        comp_total: 0,
        comp_asked: false,
        comp_idle_dirty: false,
        menu_stem: List[byte](),
        has_menu_stem: false,
        menu_original: text.span(0, 0),
        suggest_loaded: false,
        input_done: INPUT_DONE_NONE,
        input_ctx: 0,
        input_seen: 0,
        input_accepted: false,
        input_closed: false,
        input_text: List[byte](),
        last_arg_seq: 0,
        last_arg_gen: 0,
        last_arg_entry: 0,
        last_arg_span: text.span(0, 0),
        tok_seq: 0,
        tok_gen: 0,
        tok_bang: false,
        tok_term: List[byte](),
        tok_span: text.span(0, 0),
        tok_seen: List[TokHit](),
        seam_calls: 0,
        filter: compfilter_new(),
        menu: menu_new(menuspec_default()),
        history: hist_open_memory(),
        has_history: false,
        memory_history: cl_memory_slots(),
        memory_has: cl_memory_flags(),
        walk: hist_walk_new(),
        suggest: hist_suggest_new(),
    }
}

// The three cached in-memory histories (`CmdLine.memory_history[3]`:
// command, search, input).
fn cl_memory_slots() -> List[CmdHist] {
    var v = List[CmdHist]()
    var i = 0
    while i < 3 {
        (mut v).push(hist_open_memory())
        i += 1
    }
    v
}

fn cl_memory_flags() -> List[bool] {
    var v = List[bool]()
    var i = 0
    while i < 3 {
        (mut v).push(false)
        i += 1
    }
    v
}

/// The window E-mode commands run on (`yew_cmdline_target`,
/// `cmdline.c:688-698`): the prompt's while it is open, else the focused
/// one.
pub fn cmdline_target(ed: Ed) -> int {
    if ed.cmdline.active then ed.cmdline.target_win else ed.win
}

// The prompt buffer's index.
fn cl_buf(ed: Ed) -> int {
    ed.wins[ed.cmdline.target_win].buf
}

/// The prompt's length in bytes (0 when closed).
pub fn cmdline_len(ed: Ed) -> int {
    if !ed.cmdline.active {
        return 0
    }
    text.textbuf_len(ed.bufs[cl_buf(ed)].ec.tb)
}

/// The prompt's caret, a byte offset (C's `CmdLine.cur.pos`).
pub fn cmdline_caret(ed: Ed) -> int {
    if !ed.cmdline.active {
        return 0
    }
    let w = ed.cmdline.target_win
    let p = ed.wins[w].cs.primary
    if p >= ed.wins[w].cs.curs.len {
        return 0
    }
    ed.wins[w].cs.curs[p].pos
}

// Put the caret (and the anchor) at `at`, clamped (`line->cur = …;
// yew_cursor_clamp; sync_to_target`).
fn cl_set_caret(mut ed: Ed, at: int) {
    let w = ed.cmdline.target_win
    let b = ed.wins[w].buf
    let p = ed.wins[w].cs.primary
    if p >= ed.wins[w].cs.curs.len {
        return
    }
    ed.wins[w].cs.curs[p].pos = at
    ed.wins[w].cs.curs[p].anchor = at
    ed.wins[w].cs.curs[p].goal_col = 0
    text.cursor_clamp(ed.bufs[b].ec.tb, mut ed.wins[w].cs.curs[p])
}

/// The prompt's current text (`yew_cmdline_text`, `cmdline.c:1129-1145`):
/// empty when there is no prompt.
pub fn cmdline_text(ed: Ed) -> List[byte] {
    if !ed.cmdline.active || ed.cmdline.target_win < 0 {
        return List[byte]()
    }
    text.textbuf_bytes(ed.bufs[cl_buf(ed)].ec.tb)
}

/// `yew_cmdline_sync` (`cmdline.c:1147-1153`): the caret lives in the
/// target window, so only the footer repaints.
pub fn cmdline_sync(mut ed: Ed) {
    if ed.cmdline.active {
        ed.footer_dirty = true
    }
}

// `sanitize_bytes` (`cmdline.c:247-260`): each run of CR and LF becomes
// one space; every other byte is kept.
fn sanitize_bytes(bytes: List[byte], mut out: List[byte]) {
    var newline_run = false
    for b in bytes {
        let c = b as int
        if c == 10 || c == 13 {
            if !newline_run {
                (mut out).push(32 as byte)
            }
            newline_run = true
        } else {
            (mut out).push(b)
            newline_run = false
        }
    }
}

fn sanitize_str(s: str, mut out: List[byte]) {
    var newline_run = false
    for b in s.bytes() {
        let c = b as int
        if c == 10 || c == 13 {
            if !newline_run {
                (mut out).push(32 as byte)
            }
            newline_run = true
        } else {
            (mut out).push(b)
            newline_run = false
        }
    }
}

/// `yew_cmdline_clean` (`cmdline.c:296-312`): `b` bound for window `w`,
/// as it may land there. The prompt is one line: a newline run folds to
/// one blank and a NUL is refused (false, with the message). Any other
/// window takes the bytes verbatim.
pub fn cmdline_clean(mut ed: Ed, w: int, b: List[byte]) -> (bool, List[byte]) {
    if !ed.cmdline.active || w != cmdline_target(ed) {
        return (true, copy b)
    }
    for x in b {
        if x as int == 0 {
            ed_msg(mut ed, MSG_ERROR, "NUL byte is not valid in a command line")
            return (false, List[byte]())
        }
    }
    var out = List[byte]()
    sanitize_bytes(b, mut out)
    (true, out)
}

// `invoke_prompt_text` (`cmdline.c:244-260`): the bytes through THE
// invoke as `ed.edit.insert.text` on the prompt's window — as BYTES, so a
// paste of invalid UTF-8 lands verbatim (yew#18).
fn invoke_prompt_text(mut ed: Ed, bytes: List[byte]) -> int {
    var cx = cmdctx_new(ed.cmdline.target_win, SRC_KEY)
    cx.sbytes = copy bytes
    cx.has_sbytes = true
    cx.has_sarg = true
    let id = cmd_lookup(ed.reg, "ed.edit.insert.text")
    ed_cmd_invoke(mut ed, id, mut cx)
}

// `insert_sanitized` (`cmdline.c:314-328`).
fn insert_sanitized(mut ed: Ed, bytes: List[byte]) -> int {
    let (ok, clean) = cmdline_clean(mut ed, ed.cmdline.target_win, bytes)
    if !ok {
        return CMD_ERR_ARG
    }
    invoke_prompt_text(mut ed, clean)
}

// `replace_span` (`cmdline.c:330-370`): `bytes` over `sp` of the prompt as
// ONE typing transaction, the caret after it; an edit ends the history
// walk when `reset_history`.
fn replace_span(mut ed: Ed, sp: text.Span, bytes: List[byte], reset_history: bool) -> bool {
    let w = ed.cmdline.target_win
    let b = ed.wins[w].buf
    let len = text.textbuf_len(ed.bufs[b].ec.tb)
    if sp.lo > sp.hi || sp.hi > len {
        return false
    }
    ed_undo_begin(mut ed, w, text.TXN_TYPE)
    var ok = true
    if sp.lo != sp.hi {
        ok = ed_edit_delete(mut ed, w, sp.lo, sp.hi)
    }
    if ok && bytes.len != 0 {
        ok = ed_edit_insert(mut ed, w, sp.lo, bytes, 0, bytes.len)
    }
    if ok {
        ed_undo_end(mut ed, w)
    } else {
        ed_undo_abort(mut ed, w)
    }
    ed_finish_edit(mut ed, w)
    if !ok {
        return false
    }
    cl_set_caret(mut ed, sp.lo + bytes.len)
    if reset_history {
        cl_walk_end(mut ed)
    }
    cl_clear_error(mut ed)
    ed.footer_dirty = true
    true
}

fn replace_all(mut ed: Ed, bytes: List[byte], reset_history: bool) -> bool {
    replace_span(mut ed, text.span(0, cmdline_len(ed)), bytes, reset_history)
}

// `clear_error` (`cmdline.c:191-199`).
fn cl_clear_error(mut ed: Ed) {
    if ed.cmdline.err_msg.len != 0 {
        ed.cmdline.err_msg = ""
        ed.cmdline.err_lo = 0
        ed.cmdline.err_hi = 0
        ed.full_damage = true
    }
    if ed.msg.active && ed.msg.sev == MSG_ERROR {
        ed_msg_clear(mut ed)
    }
}

/// `set_error` (`cmdline.c:201-237`): the prompt stays open WITH the
/// message and the offending token, the caret at its start; a live menu
/// goes (the menu and the message share the rows above the prompt).
pub fn cmdline_set_error(mut ed: Ed, lo_in: int, hi_in: int, msg: str) {
    cl_menu_dismiss(mut ed)
    let len = cmdline_len(ed)
    var lo = lo_in
    var hi = hi_in
    if len != 0 {
        if lo >= len {
            lo = len - 1
        }
        if hi <= lo {
            hi = lo + 1
        }
        if hi > len {
            hi = len
        }
    }
    ed.cmdline.err_lo = lo
    ed.cmdline.err_hi = hi
    ed.cmdline.err_msg = msg
    cl_set_caret(mut ed, if len == 0 then 0 else lo)
    ed_msg(mut ed, MSG_ERROR, "E: {msg}")
    ed.full_damage = true
    ed.footer_dirty = true
}

// ---- open, close, restore ---------------------------------------------

// The prompt's window and buffer, made once (C makes a fresh pair per
// prompt, `cmdline.c:470-491`); each open gives the buffer a fresh edit
// context holding `seed`.
fn cl_target_reset(mut ed: Ed, seed: List[byte]) {
    var ec = text.editctx_new(take text.textbuf_from_bytes(seed, 0, seed.len))
    ec.undo = text.undo_new(ec.tb)
    ec.has_undo = true
    ec.marks = text.marks_new()
    ec.has_marks = true
    if ed.cmdline.target_win < 0 {
        let id = ed.next_buf_id
        ed.next_buf_id += 1
        (mut ed.bufs).push(Buffer {
            id: id,
            ec: ec,
            resident: true,
            path: "",
            has_path: false,
            name: "*cmdline*",
            has_name: true,
            flags: BUF_SCRATCH,
            tabwidth: CMDLINE_TABWIDTH,
            recovery_pending: false,
            pairs: pairstate_new(),
            named: named_marks_new(),
        })
        let wid = ed.next_win_id
        ed.next_win_id += 1
        var w = win_new(wid, ed.bufs.len - 1)
        vp_init(mut w)
        (mut ed.wins).push(w)
        ed.cmdline.target_win = ed.wins.len - 1
    } else {
        let bi = ed.wins[ed.cmdline.target_win].buf
        ed.bufs[bi].ec = ec
    }
    let tw = ed.cmdline.target_win
    ed.wins[tw].cs = text.cset_init(text.cursor_at(seed.len as text.ByteOff))
}

fn cl_forget_state(mut ed: Ed) {
    ed.cmdline.err_msg = ""
    ed.cmdline.err_lo = 0
    ed.cmdline.err_hi = 0
    // C's open and close leave `hint` as the last refilter left it
    // (`cmdline.c:463-540`, `584-674`): a reopened prompt shows the
    // previous line's hint until its own first edit (s57_31's roundtrip
    // golden pins this).
    ed.cmdline.scroll = 0
    ed.cmdline.click_row = -1
    ed.cmdline.hsearch = false
    ed.cmdline.hsearch_line = List[byte]()
    ed.cmdline.walk_prefix = 0
    ed.cmdline.walk_bang = false
    ed.cmdline.comp_total = 0
    ed.cmdline.comp_asked = false
    ed.cmdline.has_menu_stem = false
    ed.cmdline.menu_stem = List[byte]()
    ed.cmdline.menu_original = text.span(0, 0)
    cl_tok_forget(mut ed)
}

/// `yew_cmdline_open` (`cmdline.c:463-540`): a fresh prompt of `kind`
/// holding `seed` (sanitized), its caret at the end, E mode.
pub fn cmdline_open(mut ed: Ed, kind: int, seed: str) {
    var clean = List[byte]()
    sanitize_str(seed, mut clean)
    cmdline_open_bytes(mut ed, kind, clean)
}

/// `yew_cmdline_open` over a seed of bytes (already sanitized).
pub fn cmdline_open_bytes(mut ed: Ed, kind: int, seed: List[byte]) {
    if ed.cmdline.active {
        cmdline_close(mut ed, false)
    }
    let old = ed.mode
    ed.cmdline.generation += 1
    if ed.cmdline.generation == 0 {
        ed.cmdline.generation = 1
    }
    cl_target_reset(mut ed, seed)
    ed.cmdline.kind = kind
    ed.cmdline.active = true
    ed.cmdline.return_mode = ed.mode
    cl_forget_state(mut ed)
    cl_menu_open(mut ed)
    cl_history_open(mut ed, kind)
    cl_walk_end(mut ed)
    cl_suggest_reset(mut ed)
    ed.cmdline.comp_idle_dirty = true
    ed_msg_clear(mut ed)
    if old != MODE_E {
        dispatch_set_mode(mut ed, MODE_E)
    }
    ed.full_damage = true
    ed.footer_dirty = true
}

/// `yew_cmdline_open_input` (`cmdline.c:572-582`): an input prompt whose
/// answer goes to `done` (a kind) with `ctx`.
pub fn cmdline_open_input(mut ed: Ed, seed: str, done: int, ctx: int) {
    cmdline_open(mut ed, PROMPT_INPUT, seed)
    if ed.cmdline.active {
        ed.cmdline.input_done = done
        ed.cmdline.input_ctx = ctx
    }
}

/// `yew_cmdline_restore` (`cmdline.c:542-570`, s57.31 §2): reopen a
/// prompt a command took away — its kind, its text, the caret at `caret`,
/// the mode it returns to.
pub fn cmdline_restore(mut ed: Ed, kind: int, line: List[byte], caret: int, return_mode: int) {
    if kind == PROMPT_SEARCH_F || kind == PROMPT_SEARCH_B {
        if ed.win < 0 {
            return
        }
        cl_search_open(mut ed, kind == PROMPT_SEARCH_B)
        if !ed.cmdline.active || !replace_all(mut ed, line, true) {
            return
        }
        cmdline_edited(mut ed)
    } else {
        if ed.mode == MODE_I {
            ed_insert_barrier(mut ed)
        }
        var clean = List[byte]()
        sanitize_bytes(line, mut clean)
        cmdline_open_bytes(mut ed, PROMPT_CMD, clean)
        if !ed.cmdline.active {
            return
        }
    }
    if return_mode >= 0 && return_mode < MODE_N && return_mode != MODE_E {
        ed.cmdline.return_mode = return_mode
    }
    cl_set_caret(mut ed, caret)
    ed.footer_dirty = true
}

/// `yew_cmdline_close` (`cmdline.c:584-674`): back to the mode it was
/// opened from; an accepted command's message stays; an input prompt's
/// answer goes to its owner after the mode is restored.
pub fn cmdline_close(mut ed: Ed, accepted: bool) {
    if !ed.cmdline.active {
        return
    }
    let input_done = ed.cmdline.input_done
    let input_ctx = ed.cmdline.input_ctx
    ed.cmdline.input_done = INPUT_DONE_NONE
    ed.cmdline.input_ctx = 0
    var input_text = List[byte]()
    if input_done != INPUT_DONE_NONE {
        input_text = cmdline_text(ed)
    }
    let kind = ed.cmdline.kind
    let search = kind == PROMPT_SEARCH_F || kind == PROMPT_SEARCH_B
    let keep_message = accepted &&
        ed.msg.active &&
        (kind == PROMPT_CMD || search && cl_search_preview_pending(ed))
    if search {
        if accepted {
            cl_search_accept(mut ed)
        } else {
            cl_search_cancel(mut ed)
        }
    }
    var restore = ed.cmdline.return_mode
    if restore < 0 || restore >= MODE_N || restore == MODE_E {
        restore = MODE_L
    }
    cl_menu_discard(mut ed)
    cl_prompt_closed(mut ed)
    ed.cmdline.comp_idle_dirty = false
    cl_suggest_reset(mut ed)
    cl_history_release(mut ed, kind)
    cl_walk_end(mut ed)
    ed.cmdline.hsearch = false
    ed.cmdline.hsearch_line = List[byte]()
    cl_tok_forget(mut ed)
    ed.cmdline.active = false
    ed.cmdline.err_msg = ""
    ed.cmdline.err_lo = 0
    ed.cmdline.err_hi = 0
    ed.cmdline.scroll = 0
    if !keep_message {
        ed_msg_clear(mut ed)
    }
    if ed.mode != restore {
        dispatch_set_mode(mut ed, restore)
    }
    ed.full_damage = true
    ed.footer_dirty = true
    cl_search_confirm_reprompt(mut ed)
    if input_done != INPUT_DONE_NONE {
        cmdline_input_done(mut ed, input_done, input_ctx, accepted, input_text)
    }
}

/// The input prompts' owners (C's `YewCmdlineInputDone` pointers, one
/// `match` on the kind): the LSP rename (yw11), the AI opt-in (yw12) and
/// FUSS's questions (yw13) add their kinds with their campaigns.
pub fn cmdline_input_done(mut ed: Ed, done: int, ctx: int, accepted: bool, answer: List[byte]) {
    match done {
        1 => {
            ed.cmdline.input_seen += 1
            ed.cmdline.input_accepted = accepted
            ed.cmdline.input_closed = !ed.cmdline.active && ed.mode == MODE_L
            ed.cmdline.input_text = copy answer
            ed.cmdline.input_ctx = ctx
        },
        _ => bug("command line: an input prompt's answer has no owner (kind {done})"),
    }
}

/// `yew_cmdline_dispose` (`cmdline.c:676-686`).
pub fn cmdline_dispose(mut ed: Ed) {
    if ed.cmdline.active {
        cmdline_close(mut ed, false)
    }
    cl_history_dispose(mut ed)
}

// ---- typing -----------------------------------------------------------

/// `yew_cmdline_key` (`cmdline.c:1331-1359`): a printable key types into
/// the line through the registry, which lands in `cmdline_edited`;
/// everything else falls to the keymap.
pub fn cmdline_key(mut ed: Ed, key: term.Key) -> bool {
    if !ed.cmdline.active {
        return false
    }
    if key.ev == term.KEY_RELEASE {
        return true
    }
    if ed.capture_cmd != 0 {
        return false
    }
    let command_mods = term.MOD_ALT |
        term.MOD_CTRL |
        term.MOD_SUPER |
        term.MOD_HYPER |
        term.MOD_META
    if key.code < term.KEY_BASE && key.text.len != 0 && key.mods & command_mods == 0 {
        let _ = insert_sanitized(mut ed, key.text)
        return true
    }
    false
}

/// `yew_cmdline_paste` (`cmdline.c:1361-1367`).
pub fn cmdline_paste(mut ed: Ed, bytes: List[byte]) {
    if ed.cmdline.active && bytes.len != 0 {
        let _ = insert_sanitized(mut ed, bytes)
    }
}

/// `yew_cmdline_edited` (`cmdline.c:1102-1127`): the one place that
/// reacts to a prompt edit — the walk ends, the error clears, the table
/// blurs and refilters; the search prompts preview.
pub fn cmdline_edited(mut ed: Ed) {
    if !ed.cmdline.active {
        return
    }
    cl_walk_end(mut ed)
    cl_clear_error(mut ed)
    cl_menu_blur(mut ed)
    ed.cmdline.comp_asked = false
    ed.cmdline.comp_idle_dirty = true
    cl_refilter(mut ed)
    ed.footer_dirty = true
    if ed.cmdline.kind == PROMPT_SEARCH_F || ed.cmdline.kind == PROMPT_SEARCH_B {
        cl_search_input(mut ed)
    }
}

// ---- the selection (s57.29) -------------------------------------------

// The collapse table's rules (`PromptSel`, `cmdline.c:1164-1172`).
const PSEL_COLLAPSE: int = 0

const PSEL_EXTEND: int = 1

const PSEL_KEEP: int = 2

const PSEL_START: int = 3

const PSEL_END: int = 4

const PSEL_REPLACE: int = 5

const PSEL_DELETE: int = 6

// `prompt_sel_rows` and `prompt_sel_rule` (`cmdline.c:1174-1226`).
fn prompt_sel_rule(command: str) -> int {
    if command.starts_with("ed.sel.extend.") {
        return PSEL_EXTEND
    }
    match command {
        "ed.clip.copy" => PSEL_KEEP,
        "ed.clip.cut" => PSEL_KEEP,
        "ed.cmdline.copy_or_cancel" => PSEL_KEEP,
        "ed.cmdline.last_arg" => PSEL_KEEP,
        "ed.cmdline.insert_register" => PSEL_KEEP,
        "ed.cmdline.literal_next" => PSEL_KEEP,
        "ed.move.char.prev" => PSEL_START,
        "ed.move.char.left" => PSEL_START,
        "ed.move.char.next" => PSEL_END,
        "ed.move.char.right" => PSEL_END,
        "ed.cmdline.ghost.accept" => PSEL_END,
        "ed.edit.insert.text" => PSEL_REPLACE,
        "ed.clip.paste" => PSEL_REPLACE,
        "ed.edit.kill.yank" => PSEL_REPLACE,
        "ed.edit.delete.grapheme_left" => PSEL_DELETE,
        "ed.edit.delete.grapheme" => PSEL_DELETE,
        _ => PSEL_COLLAPSE,
    }
}

/// `yew_cmdline_selection` (`cmdline.c:1240-1250`): the prompt's
/// selection, [min(anchor, pos), max(anchor, pos)) of its primary cursor —
/// STATE, never text. (false, empty) when it is empty or there is no
/// prompt.
pub fn cmdline_selection(ed: Ed) -> (bool, text.Span) {
    if !ed.cmdline.active || ed.cmdline.target_win < 0 {
        return (false, text.span(0, 0))
    }
    let w = ed.cmdline.target_win
    let p = ed.wins[w].cs.primary
    if p >= ed.wins[w].cs.curs.len {
        return (false, text.span(0, 0))
    }
    let pos = ed.wins[w].cs.curs[p].pos
    let anchor = ed.wins[w].cs.curs[p].anchor
    if anchor == pos {
        return (false, text.span(0, 0))
    }
    if pos < anchor {
        return (true, text.span(pos, anchor))
    }
    (true, text.span(anchor, pos))
}

// `prompt_sel_collapse` (`cmdline.c:1252-1263`).
fn prompt_sel_collapse(mut ed: Ed, at: int) {
    let w = ed.cmdline.target_win
    let p = ed.wins[w].cs.primary
    if p >= ed.wins[w].cs.curs.len {
        return
    }
    ed.wins[w].cs.curs[p].pos = at
    ed.wins[w].cs.curs[p].anchor = at
    ed.wins[w].cs.curs[p].goal_col = text.CCOL_HERE
    ed.footer_dirty = true
}

// `prompt_sel_delete` (`cmdline.c:1265-1277`): joins the transaction the
// dispatcher opened for the command, so a replacement is ONE undo step.
fn prompt_sel_delete(mut ed: Ed, sp: text.Span) -> bool {
    let w = ed.cmdline.target_win
    let ok = ed_edit_delete(mut ed, w, sp.lo, sp.hi)
    ed_finish_edit(mut ed, w)
    if ok {
        prompt_sel_collapse(mut ed, sp.lo)
    }
    ok
}

/// `yew_cmdline_sel` (`cmdline.c:1279-1318`): the collapse table, applied
/// by THE invoke around every command it runs on the prompt's window.
/// `after` false runs before the command, inside its transaction, and
/// answers true when the selection was the whole event; `after` true
/// leaves the selection collapsed unless the command was a Shift+motion.
pub fn cmdline_sel(mut ed: Ed, command: str, after: bool) -> bool {
    if !ed.cmdline.active {
        return false
    }
    let w = ed.cmdline.target_win
    let p = ed.wins[w].cs.primary
    if p >= ed.wins[w].cs.curs.len {
        return false
    }
    let rule = prompt_sel_rule(command)
    let pos = ed.wins[w].cs.curs[p].pos
    if after {
        if rule != PSEL_EXTEND && ed.wins[w].cs.curs[p].anchor != pos {
            prompt_sel_collapse(mut ed, pos)
        }
        return false
    }
    let (has, sp) = cmdline_selection(ed)
    if !has {
        return false
    }
    if rule == PSEL_EXTEND || rule == PSEL_KEEP {
        return false
    }
    if rule == PSEL_START {
        prompt_sel_collapse(mut ed, sp.lo)
        return true
    }
    if rule == PSEL_END {
        prompt_sel_collapse(mut ed, sp.hi)
        return true
    }
    if rule == PSEL_REPLACE {
        return !prompt_sel_delete(mut ed, sp)
    }
    if rule == PSEL_DELETE {
        let _ = prompt_sel_delete(mut ed, sp)
        return true
    }
    prompt_sel_collapse(mut ed, pos)
    false
}

/// `ed.cmdline.copy_or_cancel` (`yew_cmdline_cmd_copy_or_cancel`,
/// `cmdline.c:1320-1329`): copy a selection and stay; none, cancel.
pub fn cmdline_copy_or_cancel_cmd(mut ed: Ed, cx: CmdCtx) -> int {
    if !ed.cmdline.active {
        return CMD_ERR_STATE
    }
    let (has, _) = cmdline_selection(ed)
    if !has {
        return cmdline_cancel_cmd(mut ed, cx)
    }
    var c = copy cx
    c.win = cmdline_target(ed)
    sc_clip_copy(mut ed, c)
}

// ---- the register and literal inserts ---------------------------------

/// `ed.cmdline.insert_register` (`yew_cmdline_cmd_insert_register`,
/// `cmdline.c:2272-2288`).
pub fn cmdline_insert_register_cmd(mut ed: Ed, cx: CmdCtx) -> int {
    if !ed.cmdline.active || !cx.has_sarg || cx.sarg.len == 0 {
        return CMD_ERR_ARG
    }
    let name = cx.sarg.bytes()[0] as int
    let value = text.reg_get(mut ed.regs, name) else {
        ed_msg(mut ed, MSG_ERROR, "unknown register '{cx.sarg}'")
        return CMD_ERR_ARG
    }
    insert_sanitized(mut ed, value.bytes)
}

/// `ed.cmdline.literal_next` (`yew_cmdline_cmd_literal_next`,
/// `cmdline.c:2290-2296`).
pub fn cmdline_literal_next_cmd(mut ed: Ed, cx: CmdCtx) -> int {
    if !ed.cmdline.active || !cx.has_sarg {
        return CMD_ERR_ARG
    }
    insert_sanitized(mut ed, sarg_bytes(cx))
}

// ---- accept and cancel ------------------------------------------------

/// `ed.cmdline.accept` (`yew_cmdline_cmd_accept`, `cmdline.c:3401-3553`).
pub fn cmdline_accept_cmd(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    if !ed.cmdline.active {
        return CMD_ERR_STATE
    }
    if ed.cmdline.hsearch {
        return cl_hsearch_accept(mut ed)
    }
    let kind = ed.cmdline.kind
    let gen = ed.cmdline.generation
    if cl_menu_chosen(ed) {
        return cl_menu_take_chosen(mut ed)
    }
    let line = cmdline_text(ed)
    if line.len == 0 {
        cmdline_close(mut ed, true)
        return CMD_OK
    }
    if kind == PROMPT_SEARCH_F || kind == PROMPT_SEARCH_B || kind == PROMPT_INPUT {
        cl_history_add(mut ed, line)
        cmdline_close(mut ed, true)
        return CMD_OK
    }
    let (status, ran) = cl_run_line(mut ed, line, kind, gen)
    if status != CMD_OK {
        return status
    }
    let same = ed.cmdline.active && ed.cmdline.generation == gen && ed.cmdline.kind == kind
    if same {
        cl_history_add(mut ed, ran)
    } else {
        cl_history_add_closed(mut ed, kind, ran)
    }
    text.reg_set_cmdline(mut ed.regs, ran)
    if same {
        cmdline_close(mut ed, true)
    }
    CMD_OK
}

// The parse and the run of an accepted `:` line (`cmdline.c:3474-3528`):
// a line the grammar refuses asks the filter (s57.17 §1) and, failing
// that, keeps the user's OWN error at the line they typed; a command that
// fails names its sprint or keeps its message. Answers (status, the line
// that ran — the rewritten one when the fuzzy fallback resolved it).
fn cl_run_line(mut ed: Ed, typed: List[byte], kind: int, gen: int) -> (int, List[byte]) {
    var line = copy typed
    var parsed = cmd_parse(mut ed, line)
    if !cmd_parse_ok(parsed) {
        let typed_err = copy parsed.err
        var resolved = false
        let fuzzy = cmdline_fuzzy_line(mut ed, line) else List[byte]()
        if fuzzy.len != 0 {
            let again = cmd_parse(mut ed, fuzzy)
            if cmd_parse_ok(again) {
                resolved = true
                parsed = again
                line = fuzzy
            }
        }
        if !resolved {
            cmdline_set_error(mut ed, typed_err.tok_lo, typed_err.tok_hi, cmderr_text(typed_err))
            return (CMD_ERR_ARG, line)
        }
    }
    let inv = CmdInvoke {
        range: copy parsed.range,
        argv: copy parsed.argv,
        count: 0,
        bang: parsed.bang,
        win: ed.win,
    }
    let status = ed_invoke_parsed(mut ed, parsed.command, inv)
    if status != CMD_OK {
        cmdline_failed(
            mut ed,
            status,
            parsed.command,
            parsed.name_tok.lo,
            parsed.name_tok.hi,
            kind,
            gen,
        )
    }
    (status, line)
}

/// `ed.cmdline.cancel` (`yew_cmdline_cmd_cancel`, `cmdline.c:3555-3600`):
/// Esc leaves C-r's pager, then a menu the user opened or entered
/// (putting the stem back), then the prompt.
pub fn cmdline_cancel_cmd(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    if !ed.cmdline.active {
        return CMD_ERR_STATE
    }
    if ed.cmdline.hsearch {
        return cl_hsearch_cancel(mut ed)
    }
    if cl_menu_owned(ed) {
        return cl_menu_cancel(mut ed)
    }
    cmdline_close(mut ed, false)
    CMD_OK
}

// `%.Ns`: at most `n` bytes of `s`, cut back to a code-point boundary.
fn clip_bytes(s: str, n: int) -> str {
    if s.len <= n {
        return s
    }
    var k = n
    while k > 0 && s.bytes()[k] as int >= 128 && s.bytes()[k] as int < 192 {
        k -= 1
    }
    s[0..k]
}

// `deferred_dispatch_error` (`cmdline.c:3277-3320`): a deferred command's
// error names the sprint its help names.
fn deferred_dispatch_error(mut ed: Ed, id: int, lo: int, hi: int) {
    let known = id > 0 && id <= ed.reg.entries.len
    // The port's own deferral (invariant 3): a built-in whose C handler is
    // not ported yet names its sagitta sprint and port lane on the prompt
    // as on the message row — C's `:NAME lands in Sprint N` for the
    // port's unported rows (C's help names no sprint for them, so C's
    // branch below would say only `:NAME failed`).
    if known &&
        ed.reg.entries[id - 1].handler == HANDLER_BUILTIN &&
        ed.reg.entries[id - 1].impl_id == IMPL_UNPORTED {
        let refusal = cmd_unported_message(ed.reg.entries[id - 1])
        cmdline_set_error(mut ed, lo, hi, clip_bytes(refusal, 127))
        return
    }
    let name = if known then ed.reg.entries[id - 1].name else ""
    let label = if !known {
        "command"
    } else if name.starts_with("ed.") {
        name[3..]
    } else {
        name
    }
    let help = if known then ed.reg.entries[id - 1].help else ""
    let preserve = name.starts_with("ed.ai.") && ed.msg.active && ed.msg.text.len != 0
    var msg = ":{label} failed"
    let at = help.find("Sprint ") else -1
    if at >= 0 {
        var n = at + 7
        while n < help.len &&
            n - at - 7 < 15 &&
            help.bytes()[n] as int >= 48 &&
            help.bytes()[n] as int <= 57 {
            n += 1
        }
        let number = help[at + 7..n]
        if preserve {
            msg = "{clip_bytes(ed.msg.text, 64)}; :{clip_bytes(label, 24)} lands in Sprint {number}"
        } else {
            msg = ":{label} lands in Sprint {number}"
        }
    }
    cmdline_set_error(mut ed, lo, hi, msg)
}

/// After a command parsed from the prompt ran and failed
/// (`cmdline.c:3500-3527`): a deferred command names its sprint (a
/// command the port has not ported, its sprint and lane); any other
/// failure keeps the message the command left, at the name's token.
pub fn cmdline_failed(mut ed: Ed, status: int, id: int, lo: int, hi: int, kind: int, gen: int) {
    let same = ed.cmdline.active && ed.cmdline.generation == gen && ed.cmdline.kind == kind
    if !same {
        return
    }
    if status == CMD_ERR_DEFERRED {
        deferred_dispatch_error(mut ed, id, lo, hi)
        return
    }
    var msg = "command failed"
    if ed.msg.active && ed.msg.text.len != 0 {
        msg = clip_bytes(ed.msg.text, 127)
    }
    cmdline_set_error(mut ed, lo, hi, msg)
}

// ---- drawing ----------------------------------------------------------

fn cl_blank(style: UiStyle) -> term.Cell {
    var cell = term.cell_blank()
    cell.fg = copy style.row_fg
    cell.bg = copy style.row_bg
    cell.attrs = style.attrs
    cell.w = 1
    cell
}

// The cell column of byte offset `off` in the prompt (`yew_off_to_ccol`
// over the whole line, tab width 4).
fn cl_ccol(ed: Ed, off: int) -> int {
    let bi = cl_buf(ed)
    let n = text.textbuf_len(ed.bufs[bi].ec.tb)
    text.off_to_ccol(
        ed.bufs[bi].ec.tb,
        text.span(0, n),
        off as text.ByteOff,
        CMDLINE_TABWIDTH,
    ) as int
}

// `prompt_message_row` (`cmdline.c:3629-3655`): how much of `s[at..end)`
// one row of `cells` takes, and how far to advance past it.
fn prompt_message_row(s: List[byte], at: int, end: int, cells: int) -> (int, int) {
    var nl = at
    while nl < end && s[nl] as int != 10 {
        nl += 1
    }
    let line_len = nl - at
    if line_len == 0 {
        return (0, if nl < end then 1 else 0)
    }
    let (n_take, _) = unicode.str_clip(s, at, nl, cells)
    if n_take == 0 {
        let next = unicode.gb_next_bytes(s, nl, at)
        return (0, next - at)
    }
    var advance = n_take
    if n_take == line_len && nl < end {
        advance += 1
    }
    (n_take, advance)
}

// `draw_prompt_message_full` (`cmdline.c:3657-3705`): a multi-line
// disclosure over the rows above the prompt, its tail kept when the
// terminal is too short.
fn draw_prompt_message_full(mut ed: Ed, footer: int, style: UiStyle, s: List[byte]) {
    var pos = 0
    var rows = 0
    while pos < s.len {
        let (_, advance) = prompt_message_row(s, pos, s.len, ed.grid.cols)
        if advance == 0 {
            break
        }
        pos += advance
        rows += 1
    }
    if rows == 0 {
        return
    }
    let skip = if rows > footer then rows - footer else 0
    var row = if rows < footer then footer - rows else 0
    var seen = 0
    pos = 0
    while pos < s.len && row < footer {
        let (n_take, advance) = prompt_message_row(s, pos, s.len, ed.grid.cols)
        if advance == 0 {
            break
        }
        if seen >= skip {
            term.grid_fill(mut ed.grid, row, 0, ed.grid.cols, cl_blank(style))
            if n_take != 0 {
                let _ = term.grid_puts(
                    mut ed.grid,
                    row,
                    0,
                    s,
                    pos,
                    pos + n_take,
                    copy style.row_fg,
                    copy style.row_bg,
                    style.attrs,
                )
            }
            row += 1
        }
        seen += 1
        pos += advance
    }
}

// `draw_prompt_message` (`cmdline.c:3707-3761`): the error, else the
// message, else the parser's hint, on the row above the prompt — unless a
// menu holds it.
fn draw_prompt_message(mut ed: Ed, footer: int, style: UiStyle) {
    if footer == 0 || cl_menu_open_rows(ed) {
        return
    }
    var mstyle = copy style
    var message = ""
    if ed.cmdline.err_msg.len != 0 {
        mstyle.row_fg = term.color_indexed(196)
        mstyle.attrs = mstyle.attrs | term.ATTR_BOLD
        message = "E: {ed.cmdline.err_msg}"
    } else if ed.msg.active {
        mstyle = message_style(ed)
        if ed.cmdline.kind == PROMPT_INPUT && ed.msg.text.contains("\n") {
            draw_prompt_message_full(mut ed, footer, mstyle, bytes_of(ed.msg.text))
            return
        }
        message = if ed.msg.sev == MSG_ERROR then "E: {ed.msg.text}" else ed.msg.text
    } else if ed.cmdline.hint.len != 0 {
        mstyle.attrs = mstyle.attrs | term.ATTR_DIM
        message = ed.cmdline.hint
    } else {
        return
    }
    term.grid_fill(mut ed.grid, footer - 1, 0, ed.grid.cols, cl_blank(mstyle))
    let mb = bytes_of(message)
    let _ = term.grid_puts(
        mut ed.grid,
        footer - 1,
        0,
        mb,
        0,
        mb.len,
        copy mstyle.row_fg,
        copy mstyle.row_bg,
        mstyle.attrs,
    )
}

// The screen cells [x0, x1) of prompt bytes `sp`, clamped to the text
// drawn (`col`): the history match's and the selection's arithmetic
// (`cmdline.c:3880-3933`).
fn cl_span_cells(ed: Ed, r: Rect, sp: text.Span, col: int) -> (int, int) {
    let lo = cl_ccol(ed, sp.lo)
    let hi = cl_ccol(ed, sp.hi)
    let base = r.x + 1
    let scroll = ed.cmdline.scroll
    let x0v = if lo > scroll then base + lo - scroll else base
    let x1v = if hi > scroll then base + hi - scroll else base
    (if x0v > col then col else x0v, if x1v > col then col else x1v)
}

/// `yew_cmdline_draw` (`cmdline.c:3763-3957`): `:`, `/` or `?` in E's chip
/// colours, the line scrolled to the caret, the error token, the history
/// match, the selection, the ghost, the menu above, the message or hint
/// above that, the terminal's bar cursor at the caret.
pub fn cmdline_draw(mut ed: Ed, r: Rect) {
    if !ed.cmdline.active || r.h == 0 || r.y >= ed.grid.rows {
        return
    }
    let style = statusline_mode_style(MODE_E)
    let blank = cl_blank(style)
    term.grid_fill(mut ed.grid, r.y, r.x, r.x + r.w, copy blank)
    let prefix = if ed.cmdline.kind == PROMPT_SEARCH_F {
        bytes_of("/")
    } else if ed.cmdline.kind == PROMPT_SEARCH_B {
        bytes_of("?")
    } else {
        bytes_of(":")
    }
    var col = term.grid_put(
        mut ed.grid,
        r.y,
        r.x,
        prefix,
        0,
        1,
        copy style.chip_fg,
        copy style.chip_bg,
        style.attrs,
    )
    let right = if r.x + r.w > ed.grid.cols then ed.grid.cols else r.x + r.w
    let bi = cl_buf(ed)
    let len = text.textbuf_len(ed.bufs[bi].ec.tb)
    let line = text.span(0, len)
    let caret = cl_ccol(ed, cmdline_caret(ed))
    let visible = if right > col then right - col else 0
    if caret < ed.cmdline.scroll {
        ed.cmdline.scroll = caret
    } else if visible != 0 && caret >= ed.cmdline.scroll + visible {
        ed.cmdline.scroll = caret - visible + 1
    }
    var at = text.ccol_to_off(
        ed.bufs[bi].ec.tb,
        line,
        ed.cmdline.scroll as text.CCol,
        CMDLINE_TABWIDTH,
    ) as int
    var logical = cl_ccol(ed, at)
    if logical > ed.cmdline.scroll && col < right {
        let gap = logical - ed.cmdline.scroll
        let n_take = if gap > right - col then right - col else gap
        term.grid_fill(mut ed.grid, r.y, col, col + n_take, copy blank)
        col += n_take
    }
    while at < len && col < right {
        let (ok, cl) = text.text_cluster_next(ed.bufs[bi].ec.tb, line, at as text.ByteOff)
        if !ok {
            bug("cannot decode command line cluster")
        }
        if cl.tab {
            let cells = text.tab_cells(logical as text.CCol, CMDLINE_TABWIDTH)
            let n_take = if cells > right - col then right - col else cells
            term.grid_fill(mut ed.grid, r.y, col, col + n_take, copy blank)
            col += n_take
        } else {
            var bytes = List[byte]()
            text.textbuf_append_range(mut bytes, ed.bufs[bi].ec.tb, cl.lo, cl.hi)
            col = term.grid_put(
                mut ed.grid,
                r.y,
                col,
                bytes,
                0,
                bytes.len,
                copy style.row_fg,
                copy style.row_bg,
                0,
            )
        }
        logical += cl.cells
        at = cl.hi
    }
    if ed.cmdline.err_hi > ed.cmdline.err_lo && len != 0 {
        let lo = cl_ccol(ed, ed.cmdline.err_lo)
        let hi = cl_ccol(ed, ed.cmdline.err_hi)
        let scroll = ed.cmdline.scroll
        let x0v = if lo > scroll then r.x + 1 + lo - scroll else r.x + 1
        let x1v = if hi > scroll then r.x + 1 + hi - scroll else x0v + 1
        var cell = copy blank
        cell.bg = term.color_indexed(196)
        cell.attrs = cell.attrs | term.ATTR_UNDERLINE
        let x0 = if x0v > right then right else x0v
        var x1 = if x1v > right then right else x1v
        if x1 <= x0 && x0 < right {
            x1 = x0 + 1
        }
        term.grid_overlay(mut ed.grid, r.y, x0, x1, cell, term.OVERLAY_BG | term.OVERLAY_ATTRS)
    }
    let (hist_hit, hit) = cmdline_hist_match(ed)
    if hist_hit {
        let (x0, x1) = cl_span_cells(ed, r, hit, col)
        let (match_style, fields) = draw_search_style(ed, false)
        if x0 < x1 {
            term.grid_overlay(mut ed.grid, r.y, x0, x1, match_style, fields)
        }
    }
    let (has_sel, sel) = cmdline_selection(ed)
    if has_sel {
        let (x0, x1) = cl_span_cells(ed, r, sel, col)
        let (sel_style, fields) = draw_sel_style(ed)
        if x0 < x1 {
            term.grid_overlay(mut ed.grid, r.y, x0, x1, sel_style, fields)
        }
    }
    if col < right {
        let ghost = cmdline_ghost(mut ed)
        if ghost.len != 0 {
            let (keep, _) = unicode.str_clip(ghost, 0, ghost.len, right - col)
            let _ = term.grid_puts(
                mut ed.grid,
                r.y,
                col,
                ghost,
                0,
                keep,
                copy style.row_fg,
                copy style.row_bg,
                style.attrs | term.ATTR_DIM,
            )
        }
    }
    cl_draw_menu(mut ed, r.y, style)
    draw_prompt_message(mut ed, r.y, style)
    let cursor_x = r.x + 1 + (if caret > ed.cmdline.scroll then caret - ed.cmdline.scroll else 0)
    let x = if cursor_x >= right {
        if right == 0 then 0 else right - 1
    } else {
        cursor_x
    }
    term.grid_cursor_shape(mut ed.grid, term.CURSOR_BAR)
    term.grid_cursor(mut ed.grid, r.y, x, right != 0)
}

// ---- the completion scan's idle tick (s18.5 §4) ------------------------

/// The idle path's slice of the completion scan
/// (`YEW_CMDLINE_LIVE_BUDGET_US`, `cmdline.c:54`).
pub const CMDLINE_LIVE_BUDGET_US: int = 1500

/// `yew_cmdline_comp_scanning` (`cmdline.c:1000-1014`): the ONE condition
/// the loop's deadline and the tick share — a `:` prompt is up, not in
/// C-r's pager, and the completion scan has more to read.
pub fn cmdline_comp_scanning(ed: Ed) -> bool {
    ed.cmdline.active &&
        ed.cmdline.kind == PROMPT_CMD &&
        !ed.cmdline.hsearch &&
        comp_listing_pending(ed)
}

/// `yew_cmdline_comp_tick` (`cmdline.c:1016-1048`): one live-budget slice
/// of the scan on the idle path, after input; complete, the cached set is
/// stale by definition and the menu is re-ranked ONCE. True while more
/// remains.
pub fn cmdline_comp_tick(mut ed: Ed) -> bool {
    if !cmdline_comp_scanning(ed) {
        return false
    }
    if comp_listing_advance(mut ed, CMDLINE_LIVE_BUDGET_US) {
        return true
    }
    comp_filter_invalidate(mut ed.cmdline.filter)
    cl_refilter(mut ed)
    ed.footer_dirty = true
    false
}

/// `yew_cmdline_comp_idle_pending` (`cmdline.c:1050-1065`, Sprint 57.25
/// §6): the line changed since the idle path last looked at it (a new
/// caret for the prewarm), the `:!` history snapshot is not taken yet
/// (57.26: the first idle turn takes it), or a fish or `--help` request
/// could be spawned. The ONE predicate the loop's deadline and
/// `cmdline_comp_idle` share, as the scan tick's pair does.
pub fn cmdline_comp_idle_pending(ed: Ed) -> bool {
    if !ed.cmdline.active || ed.cmdline.kind != PROMPT_CMD {
        return false
    }
    ed.cmdline.comp_idle_dirty || !ed.cmdline.suggest_loaded || comp_shell_idle_ready(ed)
}

/// `yew_cmdline_comp_idle` (`cmdline.c:1067-1095`): on a turn with no
/// input, the `:!` history snapshot, the prewarm of the caret's shell word
/// (a missing help tree asked for here, never on a keystroke), then one
/// fish or `--help` spawn (`comp_shell_idle`). Answers the jobs started.
pub fn cmdline_comp_idle(mut ed: Ed) -> int {
    if !cmdline_comp_idle_pending(ed) {
        return 0
    }
    if !ed.cmdline.suggest_loaded {
        suggest_ensure(mut ed)
    }
    if ed.cmdline.comp_idle_dirty {
        ed.cmdline.comp_idle_dirty = false
        let line = cmdline_text(ed)
        let caret = cmdline_caret(ed)
        let (ok, q) = comp_query(mut ed, line, caret)
        if ok && q.kind == COMP_SHELL && q.has_shell {
            let (cok, ctx) = comp_shell_ctx_of(mut ed, q.shell_line, q.shell_cursor)
            if cok {
                comp_shell_prewarm(mut ed, ctx)
            }
        }
    }
    comp_shell_idle(mut ed)
}
