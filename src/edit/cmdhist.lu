//! edit.cmdhist — the prompts' persistent histories, the shells' history
//! suggestions, and the smart walk.
//!
//! Ports sagitta `src/ui/cmdhist.c` (1,367 lines) and `cmdhist.h` (208)
//! at 9ace98c2: Sprint 18 §3 (`s18-cmdline.md:116-156`: one file per
//! prompt kind under `$XDG_STATE_HOME/yew/history/`, the 1,000-entry cap,
//! dedupe-to-end, the 4,096-byte line cap, the frozen-stem walk, appends
//! that survive two editors, in-memory histories for `--clean` and
//! `--batch`), Sprint 25 §8's workspace scope (`yew_hist_open_scoped`),
//! Sprint 57.26 §3's history suggestions for `:!` bodies (the fish, zsh
//! and bash readers, the secret and control refusals, newest first) and
//! Sprint 57.30 §2's smart walk (substring, a frozen term, duplicates
//! skipped, Down back to the draft). It lives in `edit` with the prompt
//! that owns it (yw04's module seam), though it takes no `Ed`.
//!
//! The wolf shapes, and why:
//!
//! - **Entries are bytes.** C's entries are C strings — any byte but NUL
//!   — and the history round-trips `0xff` (`test_cmdhist.c:255-258`); a
//!   `str` cannot hold that, so the history is one byte pool with offsets
//!   (`CmdHist.pool`, `off`, `lens`) and an entry is read back as a
//!   `List[byte]`. Removing an entry shifts two `List[int]`s in place and
//!   counts the pool bytes it leaves behind; the pool is compacted when
//!   the garbage passes half of it (G33: a replaced `List` is held until
//!   its owner's region ends, so the history never rebuilds per add).
//! - **A value, threaded by its owner** (the prompt, through `Ed`): no
//!   module state (E1010). C's `hist_shell_opens` test seam is a field of
//!   the suggestion snapshot (`HistSuggest.shell_opens`), not a static.
//! - **A view names its source** (`VIEW_HIST`, `VIEW_SUGGEST`) and the
//!   walk takes both values: C's `YewHistView` holds two pointers, and a
//!   stored lent value is E1004.
//! - **No advisory lock (G32).** C serialises an append and a compaction
//!   with `fcntl(F_SETLKW)` on `<path>.lock` (`cmdhist.c:300-324`); wolf
//!   0.2.33 has no advisory lock, so `no_lock_g32` takes none and says so
//!   by its name. Two editors compacting at the same instant can lose the
//!   other's append; a single editor, and appends without a compaction
//!   between them, are unaffected (`cmdhist_concurrent_handles_preserve_
//!   appends` holds). The pin with a lock changes that one body.
//! - The read is whole-file (`fs.read_bytes`) where C reads 4 KiB blocks:
//!   the same lines, the same overlong and incomplete rules.

use std.fs
use text
use util

/// The cap on entries (`YEW_HIST_MAX`).
pub const HIST_MAX: int = 1000

/// The cap on one entry's bytes (`YEW_HIST_LINE_MAX`).
pub const HIST_LINE_MAX: int = 4096

/// The cap on suggestion entries (`YEW_HIST_SUGGEST_MAX`).
pub const HIST_SUGGEST_MAX: int = 20000

/// A shell history larger than this is read from its tail
/// (`YEW_HIST_SHELL_READ_MAX`, 8 MiB).
pub const HIST_SHELL_READ_MAX: int = 8388608

// An encoded line longer than this is dropped (`ENCODED_MAX`,
// `cmdhist.c:239`).
const HIST_ENCODED_MAX: int = 16384

/// A view over the prompt's own history (`YewHistView.hist`).
pub const VIEW_HIST: int = 0

/// A view over the `:!` suggestion snapshot (`YewHistView.suggest`).
pub const VIEW_SUGGEST: int = 1

/// A command history (`struct CmdHist`, `cmdhist.c:17-23`): entries
/// oldest first in one byte pool.
pub struct CmdHist {
    pool: List[byte],
    off: List[int],
    lens: List[int],
    garbage: int,
    path: str,
    has_path: bool,
    memory: bool,
}

fn hist_empty() -> CmdHist {
    CmdHist {
        pool: List[byte](),
        off: List[int](),
        lens: List[int](),
        garbage: 0,
        path: "",
        has_path: false,
        memory: false,
    }
}

/// The number of entries (`yew_hist_len`).
pub fn hist_len(h: CmdHist) -> int {
    h.off.len
}

/// Entry `index`, oldest first (`yew_hist_at`); `none` past the end.
pub fn hist_at(h: CmdHist, index: int) -> List[byte] ! {none} {
    if index < 0 || index >= h.off.len {
        return none
    }
    h.pool[h.off[index]..h.off[index] + h.lens[index]]
}

/// Is it an in-memory history (`yew_hist_is_memory`)?
pub fn hist_is_memory(h: CmdHist) -> bool {
    h.memory
}

/// Where writes go (`yew_hist_path`): `none` for an in-memory history.
pub fn hist_path_of(h: CmdHist) -> str ! {none} {
    if !h.has_path {
        return none
    }
    h.path
}

// Entry `i` equals `s[lo..lo+n)`.
fn hist_entry_eq(h: CmdHist, i: int, s: List[byte], lo: int, n: int) -> bool {
    if h.lens[i] != n {
        return false
    }
    let base = h.off[i]
    var k = 0
    while k < n {
        if h.pool[base + k] != s[lo + k] {
            return false
        }
        k += 1
    }
    true
}

// `hist_remove` (`cmdhist.c:57-65`): the int lists shift in place; the
// entry's bytes become garbage until a compaction.
fn hist_remove(mut h: CmdHist, index: int) {
    h.garbage += h.lens[index]
    var i = index
    while i + 1 < h.off.len {
        h.off[i] = h.off[i + 1]
        h.lens[i] = h.lens[i + 1]
        i += 1
    }
    let _ = (mut h.off).pop() else 0
    let _ = (mut h.lens).pop() else 0
    if h.garbage > 65536 && h.garbage * 2 > h.pool.len {
        hist_compact(mut h)
    }
}

// Rebuild the pool from the live entries (the port's own: C frees each
// entry as it goes).
fn hist_compact(mut h: CmdHist) {
    var pool = List[byte]()
    var i = 0
    while i < h.off.len {
        let base = h.off[i]
        h.off[i] = pool.len
        var k = 0
        while k < h.lens[i] {
            (mut pool).push(h.pool[base + k])
            k += 1
        }
        i += 1
    }
    h.pool = pool
    h.garbage = 0
}

fn hist_push(mut h: CmdHist, s: List[byte], lo: int, n: int) {
    (mut h.off).push(h.pool.len)
    (mut h.lens).push(n)
    var k = 0
    while k < n {
        (mut h.pool).push(s[lo + k])
        k += 1
    }
}

// `hist_store` (`cmdhist.c:67-92`): an empty line or one that starts with
// a space is not kept; the line is capped at `HIST_LINE_MAX` bytes; an
// equal entry moves to the end (none at all when it is the last); past
// the cap the oldest goes.
fn hist_store(mut h: CmdHist, line: List[byte], lo: int, len_in: int) -> bool {
    if len_in == 0 || line[lo] as int == 32 {
        return false
    }
    let n = if len_in > HIST_LINE_MAX then HIST_LINE_MAX else len_in
    var i = 0
    while i < h.off.len {
        if hist_entry_eq(h, i, line, lo, n) {
            if i + 1 == h.off.len {
                return false
            }
            hist_remove(mut h, i)
            break
        }
        i += 1
    }
    hist_push(mut h, line, lo, n)
    if h.off.len > HIST_MAX {
        hist_remove(mut h, 0)
    }
    true
}

// `hist_kind_valid` (`cmdhist.c:94-107`).
fn hist_kind_valid(kind: str) -> bool {
    if kind.len == 0 {
        return false
    }
    for b in kind.bytes() {
        let c = b as int
        let ok = c >= 97 && c <= 122 ||
            c >= 65 && c <= 90 ||
            c >= 48 && c <= 57 ||
            c == 95 ||
            c == 45
        if !ok {
            return false
        }
    }
    true
}

// `hist_path` (`cmdhist.c:109-133`): `<state>/history/<kind>`, the
// directory made 0700.
fn hist_file_path(kind: str) -> str ! {none} {
    if !hist_kind_valid(kind) {
        return none
    }
    let state = util.xdg_state_dir()?
    let dir = "{state}/history"
    if !util.mkdirs(dir, 0o700) {
        return none
    }
    "{dir}/{kind}"
}

/// Append `line[lo..hi)` escaped (`hist_escape`, `cmdhist.c:135-163`): a
/// backslash, newline and tab by name, any other control byte or DEL as
/// `\xHH`, at most `HIST_LINE_MAX` source bytes.
fn hist_escape(mut out: List[byte], line: List[byte], lo: int, hi_in: int) {
    let hex = "0123456789ABCDEF"
    let hi = if hi_in - lo > HIST_LINE_MAX then lo + HIST_LINE_MAX else hi_in
    var i = lo
    while i < hi {
        let c = line[i] as int
        if c == 92 {
            (mut out).push(92 as byte)
            (mut out).push(92 as byte)
        } else if c == 10 {
            (mut out).push(92 as byte)
            (mut out).push(110 as byte)
        } else if c == 9 {
            (mut out).push(92 as byte)
            (mut out).push(116 as byte)
        } else if c < 32 || c == 127 {
            (mut out).push(92 as byte)
            (mut out).push(120 as byte)
            (mut out).push(hex.bytes()[c >> 4])
            (mut out).push(hex.bytes()[c & 15])
        } else {
            (mut out).push(line[i])
        }
        i += 1
    }
}

fn hist_hex_value(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return 10 + c - 97
    }
    if c >= 65 && c <= 70 {
        return 10 + c - 65
    }
    -1
}

// `hist_unescape` (`cmdhist.c:177-225`): `none` for a corrupt line (a raw
// NUL, an unknown escape, a bad or zero `\x`, a trailing backslash). C
// cuts the output back to `HIST_LINE_MAX` after each escape; that drops
// only bytes past the cap, which `hist_store`'s own cap drops anyway, so
// the port keeps the whole decode and lets the store cut it.
fn hist_unescape(line: List[byte]) -> List[byte] ! {none} {
    var out = List[byte]()
    let n = line.len
    var i = 0
    while i < n {
        let c = line[i] as int
        if c != 92 {
            if c == 0 {
                return none
            }
            (mut out).push(line[i])
            i += 1
            continue
        }
        i += 1
        if i >= n {
            return none
        }
        let e = line[i] as int
        if e == 92 {
            (mut out).push(92 as byte)
        } else if e == 110 {
            (mut out).push(10 as byte)
        } else if e == 116 {
            (mut out).push(9 as byte)
        } else if e == 120 {
            if i + 2 >= n {
                return none
            }
            let hi = hist_hex_value(line[i + 1] as int)
            let lo = hist_hex_value(line[i + 2] as int)
            if hi < 0 || lo < 0 || hi == 0 && lo == 0 {
                return none
            }
            (mut out).push((hi * 16 + lo) as byte)
            i += 2
        } else {
            return none
        }
        i += 1
    }
    out
}

fn hist_where(h: CmdHist) -> str {
    if h.has_path then h.path else "memory history"
}

// `hist_parse_line` (`cmdhist.c:227-237`).
fn hist_parse_line(mut h: CmdHist, line: List[byte]) {
    let decoded = hist_unescape(line) else {
        util.log_warn("dropping corrupt history entry in {hist_where(h)}")
        return
    }
    let _ = hist_store(mut h, decoded, 0, hist_nul_len(decoded, 0, decoded.len))
}

// `strlen` over `s[lo..hi)`: the bytes before the first NUL.
fn hist_nul_len(s: List[byte], lo: int, hi: int) -> int {
    var i = lo
    while i < hi && s[i] as int != 0 {
        i += 1
    }
    i - lo
}

// strerror's words for the rows a read or write can answer; a directory
// is checked first because C's `read(2)` names it (EISDIR).
fn hist_io_reason(path: str, row: str) -> str {
    if fs.is_dir(path) {
        return "Is a directory"
    }
    match row {
        "not_found" => "No such file or directory",
        "denied" => "Permission denied",
        _ => "Input/output error",
    }
}

// `hist_read` (`cmdhist.c:239-298`): true when the file was read or does
// not exist; a line longer than `HIST_ENCODED_MAX` and an unterminated
// tail are dropped with a warning.
fn hist_read(mut h: CmdHist) -> bool {
    if !h.has_path {
        return false
    }
    let path = h.path
    if fs.is_dir(path) {
        util.log_warn("cannot read command history {path}: Is a directory")
        return false
    }
    let data = fs.read_bytes(path) else |e| match e {
        not_found => { return true },
        denied => {
            util.log_warn("cannot read command history {path}: {hist_io_reason(path, "denied")}")
            return false
        },
        io => {
            util.log_warn("cannot read command history {path}: {hist_io_reason(path, "io")}")
            return false
        },
    }
    var line = List[byte]()
    var overlong = false
    var i = 0
    while i < data.len {
        if data[i] as int == 10 {
            if overlong {
                util.log_warn("dropping overlong history entry in {path}")
            } else {
                hist_parse_line(mut h, line)
            }
            line = List[byte]()
            overlong = false
        } else if !overlong {
            if line.len == HIST_ENCODED_MAX {
                overlong = true
                line = List[byte]()
            } else {
                (mut line).push(data[i])
            }
        }
        i += 1
    }
    if line.len != 0 || overlong {
        util.log_warn("dropping incomplete history entry in {path}")
    }
    true
}

// G32: wolf 0.2.33 has no advisory lock (`hist_lock`, `cmdhist.c:300-
// 324`, `fcntl(F_SETLKW)` on `<path>.lock`). Takes none, and its name is
// the claim; the pin with a lock gives this body one.
fn no_lock_g32(path: str) -> bool {
    path.len != 0
}

/// `yew_hist_open` (`cmdhist.c:332-345`): the persistent history of
/// `kind` under the XDG state directory, or an in-memory one (warned)
/// when there is none.
pub fn hist_open(kind: str) -> CmdHist {
    var h = hist_empty()
    let path = hist_file_path(kind) else ""
    h.path = path
    h.has_path = path.len != 0
    h.memory = !h.has_path
    if h.memory {
        util.log_warn("command history unavailable; using in-memory history")
    } else {
        let _ = hist_read(mut h)
    }
    h
}

// `ws_hist_path` (`cmdhist.c:347-368`): `<ws_dir>/history/<kind>`.
fn ws_hist_path(kind: str, ws_dir: str) -> str ! {none} {
    if !hist_kind_valid(kind) || ws_dir.len == 0 {
        return none
    }
    let dir = "{ws_dir}/history"
    if !util.mkdirs(dir, 0o700) {
        return none
    }
    "{dir}/{kind}"
}

/// `yew_hist_open_scoped` (`cmdhist.c:370-427`, Sprint 25 §8): reads
/// merge (global first, the workspace second, so the most local entries
/// are newest), writes go to the scope's file only; a scope with no file
/// falls back to the other before memory.
pub fn hist_open_scoped(kind: str, ws_dir: str, workspace_scope: bool) -> CmdHist {
    var h = hist_empty()
    let global = hist_file_path(kind) else ""
    let local = ws_hist_path(kind, ws_dir) else ""
    if global.len != 0 {
        h.path = global
        h.has_path = true
        let _ = hist_read(mut h)
    }
    if local.len != 0 {
        h.path = local
        h.has_path = true
        let _ = hist_read(mut h)
    }
    if workspace_scope && local.len != 0 {
        h.path = local
    } else if !workspace_scope && global.len != 0 {
        h.path = global
    } else {
        h.path = if local.len != 0 then local else global
    }
    h.has_path = h.path.len != 0
    h.memory = !h.has_path
    if h.memory {
        util.log_warn("command history unavailable; using in-memory history")
    }
    h
}

/// `yew_hist_open_memory` (`cmdhist.c:434-440`): `--clean` and `--batch`.
pub fn hist_open_memory() -> CmdHist {
    var h = hist_empty()
    h.memory = true
    h
}

fn hist_append_file(path: str, bytes: List[byte]) {
    if !fs.exists(path) {
        let made = fs.create_with_mode(path, 0o600) else |_| {
            util.log_warn("cannot append command history {path}: {hist_io_reason(path, "denied")}")
            return
        }
        fs.close(take made) else |_| {}
    }
    var f = fs.open_append(path) else |e| match e {
        not_found => {
            util.log_warn(
                "cannot append command history {path}: {hist_io_reason(path, "not_found")}",
            )
            return
        },
        denied => {
            util.log_warn("cannot append command history {path}: {hist_io_reason(path, "denied")}")
            return
        },
        io => {
            util.log_warn("cannot append command history {path}: {hist_io_reason(path, "io")}")
            return
        },
    }
    fs.write_chunk(mut f, bytes) else |_| {
        util.log_warn("short append to command history {path}")
    }
    fs.close(take f) else |_| {}
}

/// `yew_hist_add` (`cmdhist.c:452-489`): store the line (up to its first
/// NUL, as C's string ends there) and, for a persistent history, append
/// it escaped to the file.
pub fn hist_add(mut h: CmdHist, line: List[byte]) {
    let n = hist_nul_len(line, 0, line.len)
    if n == 0 || line[0] as int == 32 {
        return
    }
    if !hist_store(mut h, line, 0, n) || h.memory {
        return
    }
    var encoded = List[byte]()
    hist_escape(mut encoded, line, 0, n)
    (mut encoded).push(10 as byte)
    let _ = no_lock_g32(h.path)
    hist_append_file(h.path, encoded)
}

/// The same, for a `str` line.
pub fn hist_add_str(mut h: CmdHist, line: str) {
    var b = List[byte]()
    for x in line.bytes() {
        (mut b).push(x)
    }
    hist_add(mut h, b)
}

/// `yew_hist_flush` (`cmdhist.c:491-536`): re-read the file (other
/// editors' appends included), write it back compacted through a
/// temporary and a rename, and adopt it; a read failure keeps the state.
pub fn hist_flush(mut h: CmdHist) {
    if h.memory {
        return
    }
    let _ = no_lock_g32(h.path)
    var merged = hist_empty()
    merged.path = h.path
    merged.has_path = true
    if !hist_read(mut merged) {
        return
    }
    var encoded = List[byte]()
    var i = 0
    while i < merged.off.len {
        hist_escape(mut encoded, merged.pool, merged.off[i], merged.off[i] + merged.lens[i])
        (mut encoded).push(10 as byte)
        i += 1
    }
    if text.file_write_atomic(h.path, encoded, 0o600) != text.SAVE_OK {
        util.log_warn("cannot compact command history {h.path}: {hist_io_reason(h.path, "io")}")
        return
    }
    h.pool = merged.pool
    h.off = merged.off
    h.lens = merged.lens
    h.garbage = merged.garbage
}

/// A frozen-stem walk (`HistCur`, `cmdhist.h:48-52`): `idx` -1 at the
/// draft; the stem is frozen by the first `hist_prev`.
pub struct HistCur {
    idx: int,
    stem: List[byte],
    has_stem: bool,
    draft: List[byte],
    has_draft: bool,
}

/// A walk at rest (`{.idx = -1}`).
pub fn histcur_new() -> HistCur {
    HistCur {
        idx: -1,
        stem: List[byte](),
        has_stem: false,
        draft: List[byte](),
        has_draft: false,
    }
}

/// `yew_hist_cur_reset` (`cmdhist.c:552-561`).
pub fn hist_cur_reset(mut c: HistCur, draft: List[byte]) {
    c.idx = -1
    c.stem = List[byte]()
    c.has_stem = false
    c.draft = copy draft
    c.has_draft = true
}

/// `yew_hist_cur_dispose` (`cmdhist.c:563-570`).
pub fn hist_cur_dispose(mut c: HistCur) {
    c.idx = -1
    c.stem = List[byte]()
    c.has_stem = false
    c.draft = List[byte]()
    c.has_draft = false
}

// `hist_has_prefix` (`cmdhist.c:572-575`).
fn hist_has_prefix(h: CmdHist, i: int, stem: List[byte]) -> bool {
    if h.lens[i] < stem.len {
        return false
    }
    let base = h.off[i]
    var k = 0
    while k < stem.len {
        if h.pool[base + k] != stem[k] {
            return false
        }
        k += 1
    }
    true
}

/// `yew_hist_prev` (`cmdhist.c:577-596`): the next older entry that
/// starts with the stem (the draft, frozen at the first step); `none`
/// past the oldest, the walk staying put.
pub fn hist_prev(h: CmdHist, mut c: HistCur) -> List[byte] ! {none} {
    if !c.has_draft {
        c.draft = List[byte]()
        c.has_draft = true
    }
    if !c.has_stem {
        c.stem = copy c.draft
        c.has_stem = true
    }
    var i = if c.idx < 0 then h.off.len - 1 else c.idx - 1
    while i >= 0 {
        if hist_has_prefix(h, i, c.stem) {
            c.idx = i
            return hist_at(h, i)?
        }
        i -= 1
    }
    none
}

/// `yew_hist_next` (`cmdhist.c:598-613`): the next newer match, or —
/// past the newest — the draft with the walk back at rest; `none` when it
/// is already there.
pub fn hist_next(h: CmdHist, mut c: HistCur) -> List[byte] ! {none} {
    if c.idx < 0 {
        return none
    }
    var i = c.idx + 1
    while i < h.off.len {
        let matched = if c.has_stem then hist_has_prefix(h, i, c.stem) else true
        if matched {
            c.idx = i
            return hist_at(h, i)?
        }
        i += 1
    }
    c.idx = -1
    if c.has_draft then copy c.draft else List[byte]()
}

// ================================================================
// Sprint 57.26 §3: history suggestions
// ================================================================

/// The `:!` suggestion snapshot (`YewHistSuggest`, `cmdhist.h:83-97`):
/// bodies newest first, each NUL-terminated in `pool` at `off[i]`, with
/// an open-addressed set (`slots`, index + 1) for the dedupe.
/// `shell_opens` counts the shell history files opened (C's test seam
/// `hist_shell_opens`, a value here).
pub struct HistSuggest {
    pool: List[byte],
    off: List[int],
    lens: List[int],
    hashes: List[int],
    slots: List[int],
    shell_opens: int,
}

/// An empty snapshot (`yew_hist_suggest_init`).
pub fn hist_suggest_new() -> HistSuggest {
    HistSuggest {
        pool: List[byte](),
        off: List[int](),
        lens: List[int](),
        hashes: List[int](),
        slots: List[int](),
        shell_opens: 0,
    }
}

/// The number of entries (`YewHistSuggest.n`).
pub fn hist_suggest_len(s: HistSuggest) -> int {
    s.off.len
}

/// Entry `i`, 0 the newest, up to its NUL (`yew_hist_suggest_at`).
pub fn hist_suggest_at(s: HistSuggest, i: int) -> List[byte] ! {none} {
    if i < 0 || i >= s.off.len {
        return none
    }
    let lo = s.off[i]
    let n = hist_nul_len(s.pool, lo, s.pool.len)
    s.pool[lo..lo + n]
}

// Eight bytes of `s` from `at` (fewer at the end, zero-filled), little
// endian: C's `memcpy` into a `u64` on the hosts yew builds on.
fn hist_word_le(s: List[byte], at: int, n: int) -> wrapping[u64] {
    var w: wrapping[u64] = 0
    var k = n - 1
    while k >= 0 {
        w = w << 8 | s[at + k] as int as wrapping[u64]
        k -= 1
    }
    w
}

// `suggest_hash` (`cmdhist.c:663-683`): in memory only; nothing is
// ordered by it.
fn hist_suggest_hash(s: List[byte], lo: int, len_in: int) -> int {
    var h: wrapping[u64] = 11400714819323198485
    h = h ^ len_in as wrapping[u64]
    var at = lo
    var len = len_in
    while len >= 8 {
        let w = hist_word_le(s, at, 8)
        h = (h ^ w) * 18397679294719823053
        h = h ^ h >> 32
        at += 8
        len -= 8
    }
    var w: wrapping[u64] = 0
    if len != 0 {
        w = hist_word_le(s, at, len)
    }
    h = (h ^ w) * 14181476777654086739
    h = h ^ h >> 29
    let folded = h ^ h >> 32
    (folded & 4294967295) as int
}

fn hist_is_blank(c: int) -> bool {
    c == 32 || c == 9
}

fn hist_name_start(c: int) -> bool {
    c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95
}

fn hist_name_char(c: int) -> bool {
    hist_name_start(c) || c >= 48 && c <= 57
}

// `secret_min_len` (`cmdhist.c:697-715`): the shortest fragment.
fn hist_secret_min_len() -> int {
    var min_len = 1
    var i = 0
    for f in util.secret_fragments() {
        let l = f.len
        if i == 0 || l < min_len {
            min_len = if l == 0 then 1 else l
        }
        i += 1
    }
    min_len
}

/// `yew_hist_suggest_refused` (`cmdhist.c:717-765`): a control byte (a
/// newline is a multi-line command) or a `NAME=value` whose NAME is a
/// secret, anywhere on the line. C's eight-bytes-a-step scan is the same
/// answer as this byte loop.
pub fn hist_suggest_refused(s: List[byte], lo: int, len: int) -> bool {
    let end = lo + len
    var i = lo
    while i < end {
        let c = s[i] as int
        if c < 32 || c == 127 {
            return true
        }
        i += 1
    }
    let min_len = hist_secret_min_len()
    var eq = lo
    while eq < end {
        if s[eq] as int != 61 {
            eq += 1
            continue
        }
        var start = eq
        while start > lo && hist_name_char(s[start - 1] as int) {
            start -= 1
        }
        while start < eq && !hist_name_start(s[start] as int) {
            start += 1
        }
        var n = eq - start
        if n >= min_len {
            if n >= 128 {
                n = 127
            }
            if util.secret_name(s, start, start + n) {
                return true
            }
        }
        if eq + 1 >= end {
            break
        }
        eq += 1
    }
    false
}

fn hist_suggest_has(s: HistSuggest, text: List[byte], lo: int, len: int, h: int) -> bool {
    let n_slots = s.slots.len
    if n_slots == 0 {
        return false
    }
    let mask = n_slots - 1
    var at = h & mask
    while s.slots[at] != 0 {
        let k = s.slots[at] - 1
        if s.lens[k] == len {
            let base = s.off[k]
            var same = true
            var j = 0
            while j < len {
                if s.pool[base + j] != text[lo + j] {
                    same = false
                    break
                }
                j += 1
            }
            if same {
                return true
            }
        }
        at = at + 1 & mask
    }
    false
}

fn hist_suggest_slot(mut s: HistSuggest, index: int, h: int) {
    let mask = s.slots.len - 1
    var at = h & mask
    while s.slots[at] != 0 {
        at = at + 1 & mask
    }
    s.slots[at] = index + 1
}

// `suggest_grow` (`cmdhist.c:796-826`): the set kept at most half full.
fn hist_suggest_grow(mut s: HistSuggest) {
    let n = s.off.len
    if (n + 1) * 2 > s.slots.len {
        let size = if s.slots.len == 0 then 512 else s.slots.len * 2
        var slots = List[int]()
        var k = 0
        while k < size {
            (mut slots).push(0)
            k += 1
        }
        s.slots = slots
        var i = 0
        while i < n {
            hist_suggest_slot(mut s, i, s.hashes[i])
            i += 1
        }
    }
}

/// `yew_hist_suggest_add` (`cmdhist.c:828-855`): offer one body, newest
/// first; leading blanks dropped; an empty, overlong, refused or repeated
/// body, or one past the cap, is not kept.
pub fn hist_suggest_add(mut s: HistSuggest, text: List[byte], lo_in: int, len_in: int) -> bool {
    var lo = lo_in
    var len = len_in
    while len != 0 && hist_is_blank(text[lo] as int) {
        lo += 1
        len -= 1
    }
    if len == 0 || len > HIST_LINE_MAX || s.off.len >= HIST_SUGGEST_MAX {
        return false
    }
    if hist_suggest_refused(text, lo, len) {
        return false
    }
    let h = hist_suggest_hash(text, lo, len)
    if hist_suggest_has(s, text, lo, len, h) {
        return false
    }
    hist_suggest_grow(mut s)
    let idx = s.off.len
    (mut s.off).push(s.pool.len)
    (mut s.lens).push(len)
    (mut s.hashes).push(h)
    var k = 0
    while k < len {
        (mut s.pool).push(text[lo + k])
        k += 1
    }
    (mut s.pool).push(0 as byte)
    hist_suggest_slot(mut s, idx, h)
    true
}

/// `yew_hist_suggest_match` (`cmdhist.c:857-885`): the newest entry that
/// starts with `body` (leading blanks ignored) and is longer — answered
/// as (the remainder's offset in the entry, the entry index), or `none`.
/// Byte-exact and case-sensitive.
pub fn hist_suggest_match(s: HistSuggest, body: List[byte], lo_in: int, len_in: int) -> (
    int,
    int,
) ! {none} {
    var lo = lo_in
    var len = len_in
    while len != 0 && hist_is_blank(body[lo] as int) {
        lo += 1
        len -= 1
    }
    if len == 0 {
        return none
    }
    var i = 0
    while i < s.off.len {
        let base = s.off[i]
        if s.lens[i] > len && s.pool[base] == body[lo] {
            var same = true
            var j = 0
            while j < len {
                if s.pool[base + j] != body[lo + j] {
                    same = false
                    break
                }
                j += 1
            }
            if same {
                return (len, i)
            }
        }
        i += 1
    }
    none
}

/// The remainder `hist_suggest_match` found: entry `i` from byte `at`.
pub fn hist_suggest_rest(s: HistSuggest, i: int, at: int) -> List[byte] {
    let base = s.off[i]
    s.pool[base + at..base + s.lens[i]]
}

// A parser's entries, oldest first, as spans of `text` (`HistEntries`,
// `cmdhist.c:887-925`), offered newest first.
struct HistEntries {
    text: List[byte],
    off: List[int],
    lens: List[int],
}

fn hist_entries_new() -> HistEntries {
    HistEntries { text: List[byte](), off: List[int](), lens: List[int]() }
}

fn hist_entries_offer(mut s: HistSuggest, e: HistEntries, base: List[byte], use_base: bool) {
    var i = e.off.len
    while i > 0 && s.off.len < HIST_SUGGEST_MAX {
        if use_base {
            let _ = hist_suggest_add(mut s, base, e.off[i - 1], e.lens[i - 1])
        } else {
            let _ = hist_suggest_add(mut s, e.text, e.off[i - 1], e.lens[i - 1])
        }
        i -= 1
    }
}

// The next line of `data` from `at`: (start, length, the next `at`), or
// `none` at the end (`next_line`, `cmdhist.c:929-945`).
fn hist_next_line(data: List[byte], at: int) -> (int, int, int) ! {none} {
    if at >= data.len {
        return none
    }
    var i = at
    while i < data.len && data[i] as int != 10 {
        i += 1
    }
    (at, i - at, i + 1)
}

fn hist_push_range(mut out: List[byte], s: List[byte], lo: int, n: int) {
    var k = 0
    while k < n {
        (mut out).push(s[lo + k])
        k += 1
    }
}

fn hist_has_at(s: List[byte], at: int, lit: str) -> bool {
    if at + lit.len > s.len {
        return false
    }
    var k = 0
    while k < lit.len {
        if s[at + k] != lit.bytes()[k] {
            return false
        }
        k += 1
    }
    true
}

/// `yew_hist_parse_fish` (`cmdhist.c:947-986`): `- cmd: <text>` lines;
/// `\\` is a backslash and `\n` a newline, any other backslash literal.
pub fn hist_parse_fish(mut s: HistSuggest, data: List[byte]) {
    var e = hist_entries_new()
    var at = 0
    loop {
        let (lo, n0, next) = hist_next_line(data, at) else {
            break
        }
        at = next
        if n0 < 7 || !hist_has_at(data, lo, "- cmd: ") {
            continue
        }
        let line = lo + 7
        let n = n0 - 7
        let start = e.text.len
        var i = 0
        while i < n {
            let c = data[line + i] as int
            if c == 92 && i + 1 < n && data[line + i + 1] as int == 92 {
                (mut e.text).push(92 as byte)
                i += 1
            } else if c == 92 && i + 1 < n && data[line + i + 1] as int == 110 {
                (mut e.text).push(10 as byte)
                i += 1
            } else {
                (mut e.text).push(data[line + i])
            }
            i += 1
        }
        (mut e.off).push(start)
        (mut e.lens).push(e.text.len - start)
    }
    hist_entries_offer(mut s, e, data, false)
}

/// `yew_hist_unmetafy` (`cmdhist.c:988-1004`): zsh's metafication undone
/// (0x83 then b is b ^ 0x20), answered as a new list.
pub fn hist_unmetafy(bytes: List[byte]) -> List[byte] {
    var out = List[byte]()
    var i = 0
    while i < bytes.len {
        if bytes[i] as int == 131 && i + 1 < bytes.len {
            (mut out).push((bytes[i + 1] as int ^ 32) as byte)
            i += 1
        } else {
            (mut out).push(bytes[i])
        }
        i += 1
    }
    out
}

// `zsh_prefix_len` (`cmdhist.c:1006-1027`): `: <start>:<elapsed>;`.
fn hist_zsh_prefix_len(d: List[byte], lo: int, n: int) -> int {
    if n < 2 || d[lo] as int != 58 || d[lo + 1] as int != 32 {
        return 0
    }
    var i = 2
    if i >= n || d[lo + i] as int < 48 || d[lo + i] as int > 57 {
        return 0
    }
    while i < n && d[lo + i] as int >= 48 && d[lo + i] as int <= 57 {
        i += 1
    }
    if i >= n || d[lo + i] as int != 58 {
        return 0
    }
    i += 1
    while i < n && d[lo + i] as int >= 48 && d[lo + i] as int <= 57 {
        i += 1
    }
    if i >= n || d[lo + i] as int != 59 {
        return 0
    }
    i + 1
}

/// `yew_hist_parse_zsh` (`cmdhist.c:1029-1074`): unmetafied FIRST, the
/// `EXTENDED_HISTORY` prefix dropped, a line ending `\` continued (the
/// multi-line entry then refused).
pub fn hist_parse_zsh(mut s: HistSuggest, data: List[byte]) {
    let plain = hist_unmetafy(data)
    var e = hist_entries_new()
    var at = 0
    var start = 0
    var open = false
    loop {
        let (lo0, n0, next) = hist_next_line(plain, at) else {
            break
        }
        at = next
        var lo = lo0
        var n = n0
        if !open {
            let skip = hist_zsh_prefix_len(plain, lo, n)
            lo += skip
            n -= skip
            start = e.text.len
        } else {
            (mut e.text).push(10 as byte)
        }
        let more = n != 0 && plain[lo + n - 1] as int == 92
        hist_push_range(mut e.text, plain, lo, if more then n - 1 else n)
        open = more
        if !open {
            (mut e.off).push(start)
            (mut e.lens).push(e.text.len - start)
        }
    }
    if open {
        (mut e.off).push(start)
        (mut e.lens).push(e.text.len - start)
    }
    hist_entries_offer(mut s, e, plain, false)
}

/// `yew_hist_parse_bash` (`cmdhist.c:1076-1101`): plain lines;
/// `HISTTIMEFORMAT`'s `#<digits>` lines skipped.
pub fn hist_parse_bash(mut s: HistSuggest, data: List[byte]) {
    var e = hist_entries_new()
    var at = 0
    loop {
        let (lo, n, next) = hist_next_line(data, at) else {
            break
        }
        at = next
        if n > 1 && data[lo] as int == 35 {
            var i = 1
            while i < n && data[lo + i] as int >= 48 && data[lo + i] as int <= 57 {
                i += 1
            }
            if i == n {
                continue
            }
        }
        if n != 0 {
            (mut e.off).push(lo)
            (mut e.lens).push(n)
        }
    }
    hist_entries_offer(mut s, e, data, true)
}

// `shell_file_read` (`cmdhist.c:1103-1162`): the whole regular file, or
// its last `HIST_SHELL_READ_MAX` bytes from a line start; `none` when it
// is not a readable regular file. Counts the open.
fn hist_shell_file_read(mut s: HistSuggest, path: str) -> List[byte] ! {none} {
    if path.len == 0 {
        return none
    }
    var f = fs.open(path) else {
        return none
    }
    s.shell_opens += 1
    let info = fs.fstat(mut f) else {
        fs.close(take f) else |_| {}
        return none
    }
    if info.kind != 0 {
        fs.close(take f) else |_| {}
        return none
    }
    var skip = false
    if info.size > HIST_SHELL_READ_MAX {
        let _ = fs.seek(mut f, info.size - HIST_SHELL_READ_MAX) else {
            fs.close(take f) else |_| {}
            return none
        }
        skip = true
    }
    var b = List[byte]()
    loop {
        let chunk = fs.read_chunk(mut f, 16384) else {
            break
        }
        var k = 0
        while k < chunk.len && b.len < HIST_SHELL_READ_MAX {
            (mut b).push(chunk[k])
            k += 1
        }
        if b.len >= HIST_SHELL_READ_MAX {
            break
        }
    }
    fs.close(take f) else |_| {}
    var from = 0
    if skip {
        while from < b.len && b[from] as int != 10 {
            from += 1
        }
        if from < b.len {
            from += 1
        }
    }
    if from == 0 then b else b[from..b.len]
}

// `env_path` (`cmdhist.c:1164-1179`): an absolute root and a suffix.
fn hist_env_path(root: str, suffix: str) -> str {
    if root.len == 0 || root.bytes()[0] as int != 47 {
        return ""
    }
    "{root}{suffix}"
}

/// `yew_hist_suggest_read_shells` (`cmdhist.c:1193-1225`): fish, zsh and
/// bash's history files, in that order, named by the environment only.
pub fn hist_suggest_read_shells(mut s: HistSuggest) {
    let home = env_get("HOME") else ""
    let data_home = env_get("XDG_DATA_HOME") else ""
    var histfile = env_get("HISTFILE") else ""
    var zsh_file = false
    if histfile.len != 0 && histfile.bytes()[0] as int == 47 {
        let cut = histfile.rfind("/") else 0
        zsh_file = histfile[cut + 1..].contains("zsh")
    } else {
        histfile = ""
    }
    var fish = hist_env_path(home, "/.local/share/fish/fish_history")
    if data_home.len != 0 && data_home.bytes()[0] as int == 47 {
        fish = hist_env_path(data_home, "/fish/fish_history")
    }
    let fdata = hist_shell_file_read(mut s, fish) else List[byte]()
    if fdata.len != 0 {
        hist_parse_fish(mut s, fdata)
    }
    var zsh = hist_env_path(home, "/.zsh_history")
    if histfile.len != 0 && zsh_file {
        zsh = hist_env_path(histfile, "")
    }
    let zdata = hist_shell_file_read(mut s, zsh) else List[byte]()
    if zdata.len != 0 {
        hist_parse_zsh(mut s, zdata)
    }
    var bash = hist_env_path(home, "/.bash_history")
    if histfile.len != 0 && !zsh_file {
        bash = hist_env_path(histfile, "")
    }
    let bdata = hist_shell_file_read(mut s, bash) else List[byte]()
    if bdata.len != 0 {
        hist_parse_bash(mut s, bdata)
    }
}

// ================================================================
// Sprint 57.30 §2: the smart walk
// ================================================================

/// `yew_hist_view_len` (`cmdhist.c:1231-1238`): the entries of the view
/// `v` (`VIEW_HIST` over `h`, `VIEW_SUGGEST` over `s`).
pub fn hist_view_len(h: CmdHist, s: HistSuggest, v: int) -> int {
    if v == VIEW_HIST then h.off.len else s.off.len
}

/// `yew_hist_view_at` (`cmdhist.c:1240-1250`): entry `i`, 0 the newest.
pub fn hist_view_at(h: CmdHist, s: HistSuggest, v: int, i: int) -> List[byte] ! {none} {
    let n = hist_view_len(h, s, v)
    if i < 0 || i >= n {
        return none
    }
    if v == VIEW_HIST {
        return hist_at(h, n - 1 - i)?
    }
    hist_suggest_at(s, i)?
}

/// `yew_hist_find` (`cmdhist.c:1252-1279`): the first occurrence of
/// `term` in `text`, case-sensitive and byte-exact; an empty term is
/// found at 0.
pub fn hist_find(text: List[byte], term: List[byte]) -> int ! {none} {
    let tl = term.len
    if tl == 0 {
        return 0
    }
    if tl > text.len {
        return none
    }
    var p = 0
    while p + tl <= text.len {
        if text[p] == term[0] {
            var k = 1
            while k < tl && text[p + k] == term[k] {
                k += 1
            }
            if k == tl {
                return p
            }
        }
        p += 1
    }
    none
}

/// One smart walk (`YewHistWalk`, `cmdhist.h:177-195`): the frozen term,
/// the draft, and the stack of view indices shown, oldest last.
pub struct HistWalk {
    on: bool,
    term: List[byte],
    draft: List[byte],
    seen: List[int],
}

/// A zeroed walk.
pub fn hist_walk_new() -> HistWalk {
    HistWalk { on: false, term: List[byte](), draft: List[byte](), seen: List[int]() }
}

/// `yew_hist_walk_begin` (`cmdhist.c:1281-1292`).
pub fn hist_walk_begin(mut w: HistWalk, draft: List[byte], term: List[byte]) {
    hist_walk_end(mut w)
    w.on = true
    w.draft = copy draft
    w.term = copy term
}

/// `yew_hist_walk_end` (`cmdhist.c:1294-1302`): safe on an ended walk.
pub fn hist_walk_end(mut w: HistWalk) {
    w.on = false
    w.term = List[byte]()
    w.draft = List[byte]()
    w.seen = List[int]()
}

fn hist_same_bytes(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

// `walk_seen_text` (`cmdhist.c:1304-1316`).
fn hist_walk_seen_text(w: HistWalk, h: CmdHist, s: HistSuggest, v: int, text: List[byte]) -> bool {
    for i in w.seen {
        let seen = hist_view_at(h, s, v, i) else {
            continue
        }
        if hist_same_bytes(seen, text) {
            return true
        }
    }
    false
}

/// `yew_hist_walk_older` (`cmdhist.c:1318-1343`): the next OLDER distinct
/// match, or `none` (the walk stays put).
pub fn hist_walk_older(mut w: HistWalk, h: CmdHist, s: HistSuggest, v: int) -> List[byte] ! {none} {
    if !w.on {
        return none
    }
    let n = hist_view_len(h, s, v)
    var i = if w.seen.len == 0 then 0 else w.seen[w.seen.len - 1] + 1
    while i < n {
        let entry = hist_view_at(h, s, v, i) else {
            i += 1
            continue
        }
        let found = hist_find(entry, w.term) else -1
        if found < 0 || hist_walk_seen_text(w, h, s, v, entry) {
            i += 1
            continue
        }
        (mut w.seen).push(i)
        return entry
    }
    none
}

/// `yew_hist_walk_newer` (`cmdhist.c:1345-1360`): one step NEWER —
/// answered as (the entry, at_draft): past the newest the entry is empty
/// and at_draft true, the walk back at its draft; `none` when there was
/// nothing to step back over.
pub fn hist_walk_newer(mut w: HistWalk, h: CmdHist, s: HistSuggest, v: int) -> (
    List[byte],
    bool,
) ! {none} {
    if !w.on || w.seen.len == 0 {
        return none
    }
    let _ = (mut w.seen).pop() else 0
    if w.seen.len == 0 {
        return (List[byte](), true)
    }
    let e = hist_view_at(h, s, v, w.seen[w.seen.len - 1])?
    (e, false)
}

/// `yew_hist_walk_current` (`cmdhist.c:1362-1367`): the entry the walk
/// shows now, or `none` at the draft.
pub fn hist_walk_current(w: HistWalk, h: CmdHist, s: HistSuggest, v: int) -> List[byte] ! {none} {
    if !w.on || w.seen.len == 0 {
        return none
    }
    hist_view_at(h, s, v, w.seen[w.seen.len - 1])?
}
