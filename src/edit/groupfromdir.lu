//! edit.groupfromdir — a directory as a tab group (`ed.group.from_dir`).
//!
//! Ports sagitta `src/ui/groupfromdir.c` (205 lines) and
//! `ui/groupfromdir.h` (20) at 9ace98c2 (`s24-tab-groups.md` §8: Sprint
//! 53 delivered `ed.group.from_dir` through the registry and Sprint 24's
//! picker).
//!
//! The command — the argument canonicalized, refused unless it is a
//! directory, and the group picker opened on it with nothing ticked
//! (`A-g`, `:` with the directory); and `yew_group_from_dir`: the
//! directory walked — sagitta Sprint 26's budgeted, sorted,
//! `.gitignore`-aware workspace walk (`ws.walk`, yw06), run to completion
//! as C's one unbudgeted step is (`groupfromdir.c:148`), its scratch freed
//! as one region (`ws.walk_all`) — then `group_from_files`: no files is a
//! note, a listing past the cap or truncated becomes the picker with
//! every file preselected, else the group made, each file adopted or
//! opened deferred, the first member viewed — one read — and its position
//! noted.
//!
//! What refuses by name: without an argument, the directory selected in
//! F mode's tree (`yew_fuss_selected_directory`, Sprint 53, yw13). F mode
//! is itself refused at its entry (`edit.mode`), so FUSS is never active
//! and C's answer for an inactive FUSS — no selection, the "select a
//! directory" message — is the port's; the guard below names the owner
//! should F mode ever be reachable before yw13.

use text
use ws

/// `YEW_GROUP_MAX_MEMBERS` (`groupfromdir.h:7-9`).
pub const GROUP_MAX_MEMBERS: int = 200

/// `GroupFromDirOpts` (`groupfromdir.h:11-16`); `label` "" is C's NULL.
pub struct GroupFromDirOpts {
    recursive: bool,
    respect_ignore: bool,
    max_members: int,
    label: str,
}

/// C's defaults (`groupfromdir.c:113-115`): recursive, ignore files
/// respected, 200 members, the directory's own label.
pub fn group_from_dir_opts() -> GroupFromDirOpts {
    GroupFromDirOpts {
        recursive: true,
        respect_ignore: true,
        max_members: GROUP_MAX_MEMBERS,
        label: "",
    }
}

// `group_path_join` (`groupfromdir.c:22-43`): "" for no relative part.
fn gfd_join(root: str, relative: str) -> str {
    if relative.len == 0 {
        return ""
    }
    if root.len != 0 && !root.ends_with("/") then "{root}/{relative}" else "{root}{relative}"
}

// `group_picker_open` (`groupfromdir.c:45-61`): the picker on `root`
// with every walked file ticked, waiting for a confirm.
fn gfd_picker_open(mut ed: Ed, root: str, files: List[str]) -> bool {
    if !gp_show(mut ed, root) {
        return false
    }
    for f in files {
        let path = gfd_join(root, f)
        if path.len != 0 {
            gp_preselect(mut ed, path)
        }
    }
    true
}

// `group_open_members` (`groupfromdir.c:63-108`): the group made, each
// file adopted (`tab_find_by_path`: `group_add_member` takes an adopted
// tab out of its old group first, both ordinal runs kept) or opened and
// kept deferred; none at all dissolves it. Switching is the hydration
// boundary: every new member stays deferred but the first, one read.
fn gfd_open_members(mut ed: Ed, root: str, opts: GroupFromDirOpts, files: List[str]) -> int {
    let gid = group_create(mut ed, root, opts.label)
    if gid == 0 {
        return 0
    }
    for f in files {
        let path = gfd_join(root, f)
        if path.len == 0 {
            continue
        }
        var idx = tab_find_by_path(ed, path)
        var opened = false
        if idx < 0 {
            idx = tab_open(mut ed, path)
            opened = idx >= 0
        }
        if idx < 0 {
            continue
        }
        group_add_member(mut ed, gid, idx)
        if opened {
            tab_defer(mut ed, idx)
        }
    }
    var members = group_members(ed, gid)
    // C reads them into `int members[YEW_GROUP_MAX_MEMBERS]`.
    while members.len > GROUP_MAX_MEMBERS {
        let _ = (mut members).pop()
    }
    if members.len == 0 {
        group_dissolve(mut ed, gid)
        ed_msg(mut ed, MSG_ERROR, "could not open files from {root}")
        return 0
    }
    tab_switch(mut ed, members[0])
    group_note_position(mut ed)
    gid
}

/// The half of `yew_group_from_dir` after its walk (`groupfromdir.c:151-
/// 162`): `files` the walk's sorted listing relative to the canonical
/// `root`, `truncated` its overflow. 0 unless a group was made.
pub fn group_from_files(
    mut ed: Ed,
    root: str,
    opts_in: GroupFromDirOpts,
    files: List[str],
    truncated: bool,
) -> int {
    var opts = opts_in
    if opts.max_members == 0 || opts.max_members > GROUP_MAX_MEMBERS {
        opts.max_members = GROUP_MAX_MEMBERS
    }
    if files.len == 0 {
        ed_msg(mut ed, MSG_INFO, "no files in {root}")
        return 0
    }
    if truncated || files.len > opts.max_members {
        if !gfd_picker_open(mut ed, root, files) {
            ed_msg(mut ed, MSG_ERROR, "cannot open group picker")
        }
        return 0
    }
    gfd_open_members(mut ed, root, opts, files)
}

/// `yew_group_from_dir` (`groupfromdir.c:110-163`): `dir` canonicalized
/// (a failure is "cannot open directory"), walked — no links followed,
/// ignore files as `opts.respect_ignore` says, files only, one level
/// unless `opts.recursive`, at most one past the member cap so overflow is
/// seen — and its listing handed to `group_from_files`. 0 unless a group
/// was made.
pub fn group_from_dir(mut ed: Ed, dir: str, opts_in: GroupFromDirOpts) -> int {
    if dir.len == 0 {
        return 0
    }
    var opts = opts_in
    if opts.max_members == 0 || opts.max_members > GROUP_MAX_MEMBERS {
        opts.max_members = GROUP_MAX_MEMBERS
    }
    let root = text.file_realpath(dir) else {
        ed_msg(mut ed, MSG_ERROR, "cannot open directory {dir}")
        return 0
    }
    var wo = ws.walk_opts()
    wo.follow_symlinks = false
    wo.use_gitignore = opts.respect_ignore
    wo.include_dirs = false
    wo.max_depth = if opts.recursive then 0 else 1
    wo.max_entries = opts.max_members + 1
    let (ok, files) = ws.walk_all(root, wo)
    if !ok {
        ed_msg(mut ed, MSG_ERROR, "cannot scan directory {root}")
        return 0
    }
    group_from_files(mut ed, root, opts, files.paths, files.truncated)
}

/// `ed.group.from_dir` (`yew_group_cmd_from_dir`, `groupfromdir.c:165-
/// 205`): the picker opened on the argument's canonical directory with
/// nothing ticked; no argument and no F-mode selection is "select a
/// directory"; anything that is not a directory is refused.
pub fn group_cmd_from_dir(mut ed: Ed, cx: CmdCtx) -> int {
    let dir = if cx.has_sarg then cx.sarg else ""
    if dir.len == 0 && ed.mode == MODE_F {
        ed_msg(
            mut ed,
            MSG_ERROR,
            "not yet ported: ed.group.from_dir's F-mode selection: sagitta Sprint 53 (FUSS directory groups) (yw13)",
        )
        return CMD_ERR_DEFERRED
    }
    if dir.len == 0 {
        ed_msg(mut ed, MSG_ERROR, "select a directory to open as a group")
        return CMD_ERR_ARG
    }
    let root = text.file_realpath(dir) else {
        ed_msg(mut ed, MSG_ERROR, "cannot open group picker for {dir}")
        return CMD_ERR_ARG
    }
    let st = fs_stat(root) else {
        ed_msg(mut ed, MSG_ERROR, "cannot open group picker for {dir}")
        return CMD_ERR_ARG
    }
    if st[0] != 1 {
        ed_msg(mut ed, MSG_ERROR, "cannot open group picker for {dir}")
        return CMD_ERR_ARG
    }
    if !gp_show(mut ed, root) {
        ed_msg(mut ed, MSG_ERROR, "cannot open group picker for {root}")
        return CMD_ERR_STATE
    }
    CMD_OK
}
