//! edit.record — the macro recorder (Sprint 35): sagitta 9ace98c2
//! src/fl/record.c:1-849 and record.h:1-84. Commands are recorded, not
//! keys; a macro is terse Fletch source in a named register and replays
//! through the VM only (the round-trip law, s35:55-78).

/// `RecEvent` (record.h:23-37): one recorded command, resolved; a string
/// argument is a slice of the recording's blob.
pub struct RecEvent {
    cmd: int,
    count: int,
    count_given: bool,
    bang: bool,
    iarg: int,
    range_lo: int,
    range_hi: int,
    sarg_at: int,
    sarg_len: int,
    mode: int,
    src: int,
    range_kind: int,
    range_given: bool,
}

/// `Rec` (record.h:41-52): the recorder's state, the editor's.
pub struct Rec {
    ev: List[RecEvent],
    blob: List[byte],
    reg: int,
    mode_at_start: int,
    last_reg: int,
    txn_depth_at_start: int,
    active: bool,
    in_prompt: bool,
    append: bool,
    import_ed: bool,
}

/// `yew_record_init` (record.c:35-42): idle, importing `ed` on stop.
pub fn rec_new() -> Rec {
    Rec {
        ev: List[RecEvent](),
        blob: List[byte](),
        reg: 0,
        mode_at_start: 0,
        last_reg: 0,
        txn_depth_at_start: 0,
        active: false,
        in_prompt: false,
        append: false,
        import_ed: true,
    }
}

/// `yew_record_cmd_repeat` (record.c:842-849): `ed.repeat` is unavailable,
/// since resolved command arguments are retained only while recording.
pub fn record_cmd_repeat(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    ed_msg(
        mut ed,
        MSG_ERROR,
        "ed.repeat is unavailable because resolved command arguments are not retained outside recordings",
    )
    CMD_ERR_STATE
}
