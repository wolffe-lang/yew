//! edit.file_cmds — save, write, quit, suspend, redraw, buffers.
//!
//! Ports sagitta `src/edit/file_cmds.c` (448 lines) and `file_cmds.h`
//! (23) at 9ace98c2, and `yew_ed_file_write_to_win` (`ed.c:2078-2184`),
//! under `s14-modes-L-I.md`. What C's commands consult for later
//! campaigns — FUSS's commit-message buffer (`yew_fuss_commit_save` and
//! `_close`, yw13: saving commits, closing aborts), a macro-register
//! buffer (`yew_macro_store`, yw09's
//! `edit.macrobrowse`, routed here since Sprint 38), A-e's
//! command buffer (`yew_cmdedit_*`, yw04), job output (`yew_shell_
//! dismiss_output`, yw04), job-owned buffers and Fletch transactions —
//! has no instance before its campaign, so each check answers "not
//! this" exactly as C's does for an ordinary buffer. C closes a buffer by
//! retargeting every view in every tab's pane tree to the primary buffer
//! (`retarget_buffer`, `close_primary`); the port's single window shows a
//! fresh untitled buffer instead, which is the same picture.

use fl
use term
use text

/// `ed.file.save` (`yew_file_cmd_save_current`, `file_cmds.c:41-56`):
/// the context's window, not necessarily the focused one.
pub fn fc_save_current(mut ed: Ed, cx: CmdCtx) -> int {
    let w = if cx.win >= 0 then cx.win else ed.win
    // The `*commit*` scratch commits (`file_cmds.c:49-53`).
    let (handled, status) = fuss_commit_save(mut ed, if w >= 0 then ed.wins[w].buf else -1)
    if handled {
        return status
    }
    // A `*macro r*` scratch saves into its register (`file_cmds.c:54-56`).
    if w >= 0 && ed.bufs[ed.wins[w].buf].macro_reg != 0 {
        return macro_store(mut ed, ed.wins[w].buf)
    }
    ed_file_save_win(mut ed, w, false)
}

/// `ed.file.write` (`file_cmds.c:58-78`): a path writes there (`!`
/// forces); none saves; a path with an embedded NUL is refused.
pub fn fc_write(mut ed: Ed, cx: CmdCtx) -> int {
    if fc_has_nul(cx) {
        return CMD_ERR_ARG
    }
    let w = if cx.win >= 0 then cx.win else ed.win
    if cx.has_sarg && cx.sarg.len != 0 {
        return ed_file_write_to_win(mut ed, w, cx.sarg, cx.bang)
    }
    let (handled, status) = fuss_commit_save(mut ed, if w >= 0 then ed.wins[w].buf else -1)
    if handled {
        return status
    }
    // `file_cmds.c:78-80`.
    if w >= 0 && ed.bufs[ed.wins[w].buf].macro_reg != 0 {
        return macro_store(mut ed, ed.wins[w].buf)
    }
    ed_file_save_win(mut ed, w, cx.bang)
}

/// `ed.file.save_as` (`file_cmds.c:101-120`): the prompt seeded with
/// `w <path>`.
pub fn fc_save_as(mut ed: Ed, cx: CmdCtx) -> int {
    if cx.win < 0 {
        return CMD_ERR_STATE
    }
    let b = ed.wins[cx.win].buf
    let path = if ed.bufs[b].has_path then ed.bufs[b].path else ""
    cmdline_open(mut ed, PROMPT_CMD, "w {path}")
    CMD_OK
}

/// `ed.file.write_quit` (`file_cmds.c:122-135`).
pub fn fc_write_quit(mut ed: Ed, cx: CmdCtx) -> int {
    // s57.31 §2: `:wq` in A-e's buffer returns the line — no file to
    // write, no editor to quit (`file_cmds.c:127-131`).
    if ed.win >= 0 && cmdedit_owns(ed, ed.wins[ed.win].buf) {
        return cmdedit_close(mut ed, false)
    }
    let status = fc_write(mut ed, cx)
    if status != CMD_OK {
        return status
    }
    ed_request_quit(mut ed, false)
}

/// `ed.file.new` (`file_cmds.c:137-152`): an empty buffer, or `path`.
pub fn fc_new(mut ed: Ed, cx: CmdCtx) -> int {
    let d = ed_doc(ed)
    if d >= 0 && buf_dirty(ed.bufs[d]) && !cx.bang {
        ed_msg(mut ed, MSG_ERROR, "buffer has unsaved changes (use :new!)")
        return CMD_ERR_STATE
    }
    if !cx.has_sarg || cx.sarg.len == 0 {
        let fresh = buffer_untitled(mut ed)
        ed_show_buffer(mut ed, fresh)
        return CMD_OK
    }
    let status = fc_open_path(mut ed, cx.sarg)
    // `yew_ed_open` fires buf.open for the buffer it read (ed.c:953).
    if status == CMD_OK {
        let d2 = ed_doc(ed)
        ed_hook_buffer(mut ed, fl.FL_EV_BUF_OPEN, d2)
    }
    status
}

/// A fresh untitled buffer; answers its index.
pub fn buffer_untitled(mut ed: Ed) -> int {
    let b = buffer_around(mut ed, take text.textbuf_new(), text.filemeta_new(), "", false)
    (mut ed.bufs).push(b)
    ed.bufs.len - 1
}

// `yew_ws_file_buf` + `yew_buf_hydrate` + `yew_ed_show_buffer` for `path`.
fn fc_open_path(mut ed: Ed, path: str) -> int {
    let canonical = canonical_path(path)
    var bi = -1
    var i = 0
    while i < ed.bufs.len {
        if ed.bufs[i].has_path && !ed.bufs[i].has_name && ed.bufs[i].path == canonical {
            bi = i
        }
        i += 1
    }
    if bi < 0 {
        let (status, tb, meta) = text.file_load(canonical)
        if status != text.LOAD_OK && status != text.LOAD_ENOENT {
            return CMD_ERR_IO
        }
        var b = buffer_around(mut ed, take tb, meta, canonical, true)
        b.tabwidth = ed.opts.tabwidth
        b.recovery_pending = !ed.headless &&
            b.ec.meta.has_realpath &&
            text.journal_probe(ed.journals, b.ec.meta.realpath, b.ec.meta)
        (mut ed.bufs).push(b)
        bi = ed.bufs.len - 1
    }
    ed_show_buffer(mut ed, bi)
    CMD_OK
}

fn fc_has_nul(cx: CmdCtx) -> bool {
    if !cx.has_sbytes { return false }
    for b in cx.sbytes { if b == 0 as byte { return true } }
    false
}

/// `ed.buf.open` (`yew_file_cmd_buf_open`, `file_cmds.c:157-192`): the
/// workspace's one buffer for the path, read on its first open, shown;
/// buf.open fires only for a buffer this open loaded.
pub fn fc_buf_open(mut ed: Ed, cx: CmdCtx) -> int {
    if !cx.has_sarg || cx.sarg.len == 0 || !ed.model_ready || ed.fl_model_teardown {
        return CMD_ERR_ARG
    }
    if fc_has_nul(cx) {
        return CMD_ERR_ARG
    }
    let before = ed.bufs.len
    let status = fc_open_path(mut ed, cx.sarg)
    if status != CMD_OK {
        return status
    }
    if ed.bufs.len != before {
        ed_hook_buffer(mut ed, fl.FL_EV_BUF_OPEN, ed_doc(ed))
    }
    CMD_OK
}

// `retarget_tree` + `retarget_buffer` (`file_cmds.c:207-250`): every view
// of `from`, in every tab's tree, shows `to`; a tab named for `from` is
// renamed for `to`.
fn fc_retarget_buffer(mut ed: Ed, from: int, to: int) {
    if ed.win >= 0 && ed.wins[ed.win].buf == from {
        ed_show_buffer(mut ed, to)
    }
    let from_id = ed.bufs[from].id
    var t = 0
    while t < ed.tabs.len {
        let root = ed.tabs[t].root
        fc_retarget_tree(mut ed, root, from, to)
        if ed.tabs[t].buffer_id == from_id {
            ed.tabs[t].buffer_id = ed.bufs[to].id
            ed.tabs[t].path = if ed.bufs[to].has_path then ed.bufs[to].path else ""
        }
        t += 1
    }
    let root = ed.pane_root
    fc_retarget_tree(mut ed, root, from, to)
}

fn fc_retarget_tree(mut ed: Ed, root: int, from: int, to: int) {
    if root < 0 {
        return
    }
    for leaf in pane_collect_leaves(ed, root, PANE_MAX_LEAVES) {
        let w = ed.panes[leaf].win
        if w >= 0 && ed.wins[w].buf == from {
            ed_win_set_buffer(mut ed, w, to)
        }
    }
}

// `reset_primary_tree` (`file_cmds.c:252-279`): a view of the primary
// buffer starts over at offset 0 with a fresh viewport.
fn fc_reset_primary_tree(mut ed: Ed, root: int) {
    if root < 0 {
        return
    }
    for leaf in pane_collect_leaves(ed, root, PANE_MAX_LEAVES) {
        let w = ed.panes[leaf].win
        if w >= 0 && ed.wins[w].buf == 0 {
            ed.wins[w].cs = text.cset_init(text.cursor_at(0 as text.ByteOff))
            vp_init(mut ed.wins[w])
        }
    }
}

// `ed_buffer_dispose`'s journal row (`ed.c:239-242`).
fn fc_journal_close(mut ed: Ed, bi: int) {
    if ed.bufs[bi].ec.has_jrnl {
        text.journal_close(mut ed.journals, mut ed.bufs[bi].ec.jrnl)
        ed.bufs[bi].ec.has_jrnl = false
    }
}

// `close_primary` (`file_cmds.c:281-327`): the primary buffer (index 0,
// C's embedded `ed->buffer`) is never freed; it is emptied under a NEW id,
// so no handle or tab aliases the closed one.
fn fc_close_primary(mut ed: Ed) {
    let old_id = ed.bufs[0].id
    fl_h_drop_buffer(mut ed, old_id)
    fc_journal_close(mut ed, 0)
    ed.bufs[0] = buffer_around(mut ed, take text.textbuf_new(), text.filemeta_new(), "", false)
    let id = ed.bufs[0].id
    var t = 0
    while t < ed.tabs.len {
        let root = ed.tabs[t].root
        fc_reset_primary_tree(mut ed, root)
        if ed.tabs[t].buffer_id == old_id {
            ed.tabs[t].buffer_id = id
            ed.tabs[t].path = ""
        }
        t += 1
    }
    let root = ed.pane_root
    fc_reset_primary_tree(mut ed, root)
    ed.layout_dirty = true
    ed.full_damage = true
    ed.footer_dirty = true
    ed.drawn_cursor_line_valid = false
    ed.drawn_top_valid = false
    state_mark_dirty(mut ed)
}

// `yew_ws_scratch_drop` (`ed.c:577-602`) for a closed buffer: C frees it
// and removes it from the workspace list; the port addresses buffers by
// index, so the slot is RETIRED in place: no identity (id 0), no text, no
// path or name, and no enumeration of the workspace sees it.
fn fc_buf_drop(mut ed: Ed, bi: int) {
    if bi <= 0 || bi >= ed.bufs.len {
        return
    }
    fc_journal_close(mut ed, bi)
    if ed.win >= 0 && ed.wins[ed.win].buf == bi {
        ed_show_buffer(mut ed, 0)
    }
    ws_scratch_drop(mut ed, bi)
    ed.bufs[bi].ec = text.editctx_new(take text.textbuf_new())
    ed.bufs[bi].resident = false
    ed.bufs[bi].id = 0
    ed.bufs[bi].path = ""
    ed.bufs[bi].has_path = false
    ed.bufs[bi].name = ""
    ed.bufs[bi].has_name = false
    ed.bufs[bi].flags = 0
}

// `job_uses_buffer` (`file_cmds.c:194-205`): a job's output buffer. The
// port copies a job's input bytes (`Job.in_bytes`), so no job reads a
// buffer's text in place (C's `in_buf`).
fn fc_job_uses_buffer(ed: Ed, bi: int) -> bool {
    for j in ed.jobs.v { if j.buf == bi { return true } }
    false
}

/// `ed.buf.close` (`yew_file_cmd_buf_close`, `file_cmds.c:329-384`): a
/// dirty buffer needs `!`; a buffer a job or a Fletch transaction holds is
/// refused; buf.close fires under the model-teardown guard, and every view
/// falls back to the primary buffer (closing the primary empties it).
pub fn fc_buf_close(mut ed: Ed, cx: CmdCtx) -> int {
    if !ed.model_ready || ed.fl_model_teardown {
        return CMD_ERR_ARG
    }
    let b = if cx.win >= 0 then ed.wins[cx.win].buf else ed_doc(ed)
    if b < 0 {
        return CMD_ERR_STATE
    }
    // s57.31 §2: A-e's buffer returns its line on the way out; `!` the
    // original (`file_cmds.c:341-344`). Closing the `*commit*` scratch
    // aborts the commit (`:345-347`).
    if cmdedit_owns(ed, b) {
        return cmdedit_close(mut ed, cx.bang)
    }
    let (handled, status) = fuss_commit_close(mut ed, b)
    if handled {
        return status
    }
    if buf_dirty(ed.bufs[b]) && !cx.bang {
        return CMD_ERR_IO
    }
    if fc_job_uses_buffer(ed, b) || fl_txn_enlisted(ed, ed.bufs[b].id) {
        return CMD_ERR_STATE
    }
    ed.fl_model_teardown = true
    ed_hook_buffer(mut ed, fl.FL_EV_BUF_CLOSE, b)
    if buf_dirty(ed.bufs[b]) && !cx.bang {
        ed.fl_model_teardown = false
        return CMD_ERR_IO
    }
    if fl_txn_enlisted(ed, ed.bufs[b].id) {
        ed.fl_model_teardown = false
        return CMD_ERR_STATE
    }
    // yew_lsp_buffer_close is yw11's (no client before it).
    if b == 0 {
        fc_close_primary(mut ed)
        ed.fl_model_teardown = false
        return CMD_OK
    }
    fc_retarget_buffer(mut ed, b, 0)
    let id = ed.bufs[b].id
    fl_h_drop_buffer(mut ed, id)
    fc_buf_drop(mut ed, b)
    trust_prompt_buffer_closed(mut ed, id)
    state_mark_dirty(mut ed)
    ed.fl_model_teardown = false
    CMD_OK
}

/// `ed.file.reload` (`file_cmds.c:347-366`).
pub fn fc_reload(mut ed: Ed, cx: CmdCtx) -> int {
    let d = ed_doc(ed)
    if d < 0 || !ed.bufs[d].has_path {
        ed_msg(mut ed, MSG_ERROR, "buffer has no file name")
        return CMD_ERR_STATE
    }
    if buf_dirty(ed.bufs[d]) && !cx.bang {
        ed_msg(mut ed, MSG_ERROR, "buffer has unsaved changes (use :reload!)")
        return CMD_ERR_STATE
    }
    let (status, tb, meta) = text.file_load(ed.bufs[d].path)
    if status != text.LOAD_OK {
        return CMD_ERR_IO
    }
    let path = ed.bufs[d].path
    var b = buffer_around(mut ed, take tb, meta, path, true)
    b.tabwidth = ed.opts.tabwidth
    (mut ed.bufs).push(b)
    let fresh = ed.bufs.len - 1
    ed_show_buffer(mut ed, fresh)
    ed_hook_buffer(mut ed, fl.FL_EV_BUF_OPEN, fresh)
    CMD_OK
}

/// `ed.quit` (`file_cmds.c:407-421`): A-e's buffer closes, a focused job
/// output is hidden (back to the buffer that launched it), else the quit.
pub fn fc_quit(mut ed: Ed, cx: CmdCtx) -> int {
    // s57.31 §2: `:q` closes A-e's buffer and returns its line; `:q!` the
    // original (`file_cmds.c:407-414`).
    if ed.win >= 0 && cmdedit_owns(ed, ed.wins[ed.win].buf) {
        return cmdedit_close(mut ed, cx.bang)
    }
    if !cx.bang && shell_dismiss_output(mut ed) {
        ed_msg(mut ed, MSG_INFO, "job output hidden; :jobs to reopen")
        return CMD_OK
    }
    ed_request_quit(mut ed, cx.bang)
}

/// `ed.quit_force` (`file_cmds.c:384-389`).
pub fn fc_quit_force(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    ed_request_quit(mut ed, true)
}

/// `ed.suspend` (`file_cmds.c:391-399`): the terminal restored and the
/// process stopped; the continue re-enters raw (the loop's `SIG_CONT`).
pub fn fc_suspend(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    term.tty_suspend(mut ed.tty)
    ed.layout_dirty = true
    ed.full_damage = true
    CMD_OK
}

/// `ed.redraw` (`file_cmds.c:401-409`).
pub fn fc_redraw(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    if ed.win >= 0 {
        vp_invalidate(mut ed.wins[ed.win])
    }
    ed.full_damage = true
    CMD_OK
}

/// `yew_ed_file_write_to_win` (`ed.c:2078-2184`): write the focused
/// buffer to `path`; it then IS that file (the tab renamed, the metadata
/// replaced).
pub fn ed_file_write_to(mut ed: Ed, path: str, force: bool) -> int {
    let w = ed.win
    ed_file_write_to_win(mut ed, w, path, force)
}

/// `yew_ed_file_write_to_win` (`ed.c:2078-2184`): window `w_in`'s buffer
/// written to `path`, which it is renamed for; buf.save first, the window
/// and buffer found again by identity after it, buf.saved last.
pub fn ed_file_write_to_win(mut ed: Ed, w_in: int, path: str, force: bool) -> int {
    if !ed.model_ready ||
        w_in < 0 ||
        w_in >= ed.wins.len ||
        ed.wins[w_in].buf < 0 ||
        path.len == 0 {
        return CMD_ERR_ARG
    }
    ed_insert_barrier(mut ed)
    var w = w_in
    var b = ed.wins[w].buf
    if !ed.bufs[b].resident {
        ed_msg(mut ed, MSG_ERROR, "nothing loaded; nothing written")
        return CMD_ERR_STATE
    }
    let doc_id = ed.bufs[b].id
    let win_id = ed.wins[w].id
    if !ed_txn_prepare_save(mut ed, doc_id) {
        return CMD_ERR_STATE
    }
    ed_hook_buffer(mut ed, fl.FL_EV_BUF_SAVE, b)
    w = ed_win_by_id(ed, win_id)
    b = if w < 0 then -1 else ed.wins[w].buf
    if b < 0 || ed.bufs[b].id != doc_id || !ed.bufs[b].resident {
        return CMD_ERR_STATE
    }
    if !ed_txn_prepare_save(mut ed, doc_id) {
        return CMD_ERR_STATE
    }
    let (load, _, next) = text.file_load(path)
    if load != text.LOAD_OK && load != text.LOAD_ENOENT {
        ed_msg(mut ed, MSG_ERROR, "could not inspect {path}")
        return CMD_ERR_IO
    }
    edit_take(mut ed, w)
    let old_meta = ed.bufs[b].ec.meta
    let had_meta = ed.bufs[b].ec.has_meta
    ed.bufs[b].ec.meta = next
    ed.bufs[b].ec.has_meta = true
    var result = 0
    if force {
        result = text.file_save_force_opts(
            mut ed.bufs[b].ec.tb,
            mut ed.bufs[b].ec.meta,
            path,
            text.save_opts_default(),
        )
        if text.save_committed(result) {
            text.undo_boundary(mut ed.bufs[b].ec.undo)
            text.undo_mark_saved(mut ed.bufs[b].ec.undo, ed.bufs[b].ec.tb)
            if ed.bufs[b].ec.has_jrnl {
                let _ = text.journal_discard(mut ed.bufs[b].ec.journals, mut ed.bufs[b].ec.jrnl)
                ed.bufs[b].ec.has_jrnl = false
            }
        }
    } else {
        result = text.edit_save_opts(mut ed.bufs[b].ec, path, text.save_opts_default())
    }
    if !text.save_committed(result) {
        ed.bufs[b].ec.meta = old_meta
        ed.bufs[b].ec.has_meta = had_meta
        edit_give(mut ed, w)
        ed_finish_edit(mut ed, w)
        ed_msg(mut ed, MSG_ERROR, "could not write {path}")
        return CMD_ERR_IO
    }
    edit_give(mut ed, w)
    ed_finish_edit(mut ed, w)
    ed.bufs[b].path = path
    ed.bufs[b].has_path = true
    var t = 0
    while t < ed.tabs.len {
        if tree_has_window(ed, ed.tabs[t].root, w) {
            ed.tabs[t].path = canonical_path(path)
            ed.tabs[t].display_path = logical_path(ed, path, ed.tabs[t].path)
            ed.tabs[t].has_path = true
        }
        t += 1
    }
    ed.durability_failed = false
    let lines = text.textbuf_line_count(ed.bufs[b].ec.tb)
    if result == text.SAVE_BACKUP_FAILED {
        ed_msg(mut ed, MSG_WARN, "wrote {path}, but backup retention failed")
    } else {
        ed_msg(mut ed, MSG_INFO, "wrote {path}, {lines} lines")
    }
    ed_hook_buffer(mut ed, fl.FL_EV_BUF_SAVED, b)
    CMD_OK
}
