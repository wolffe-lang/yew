//! edit.file_cmds — save, write, quit, suspend, redraw, buffers.
//!
//! Ports sagitta `src/edit/file_cmds.c` (448 lines) and `file_cmds.h`
//! (23) at 9ace98c2, and `yew_ed_file_write_to_win` (`ed.c:2078-2184`),
//! under `s14-modes-L-I.md`. What C's commands consult for later
//! campaigns — FUSS's commit-message buffer (`yew_fuss_commit_save`,
//! yw13), a macro-register buffer (`yew_macro_store`, yw09), A-e's
//! command buffer (`yew_cmdedit_*`, yw04), job output (`yew_shell_
//! dismiss_output`, yw04), job-owned buffers and Fletch transactions —
//! has no instance before its campaign, so each check answers "not
//! this" exactly as C's does for an ordinary buffer. C closes a buffer by
//! retargeting every view in every tab's pane tree to the primary buffer
//! (`retarget_buffer`, `close_primary`); the port's single window shows a
//! fresh untitled buffer instead, which is the same picture.

use term
use text

/// `ed.file.save` (`yew_file_cmd_save_current`, `file_cmds.c:38-54`).
pub fn fc_save_current(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    ed_file_save(mut ed, false)
}

/// `ed.file.write` (`file_cmds.c:56-78`): a path writes there (`!`
/// forces); none saves.
pub fn fc_write(mut ed: Ed, cx: CmdCtx) -> int {
    if cx.has_sarg && cx.sarg.len != 0 {
        return ed_file_write_to(mut ed, cx.sarg, cx.bang)
    }
    ed_file_save(mut ed, cx.bang)
}

/// `ed.file.save_as` (`file_cmds.c:101-120`): the prompt seeded with
/// `w <path>`.
pub fn fc_save_as(mut ed: Ed, cx: CmdCtx) -> int {
    if cx.win < 0 {
        return CMD_ERR_STATE
    }
    let b = ed.wins[cx.win].buf
    let path = if ed.bufs[b].has_path then ed.bufs[b].path else ""
    cmdline_open(mut ed, PROMPT_CMD, "w {path}")
    CMD_OK
}

/// `ed.file.write_quit` (`file_cmds.c:122-135`).
pub fn fc_write_quit(mut ed: Ed, cx: CmdCtx) -> int {
    // s57.31 §2: `:wq` in A-e's buffer returns the line — no file to
    // write, no editor to quit (`file_cmds.c:127-131`).
    if ed.win >= 0 && cmdedit_owns(ed, ed.wins[ed.win].buf) {
        return cmdedit_close(mut ed, false)
    }
    let status = fc_write(mut ed, cx)
    if status != CMD_OK {
        return status
    }
    ed_request_quit(mut ed, false)
}

/// `ed.file.new` (`file_cmds.c:137-152`): an empty buffer, or `path`.
pub fn fc_new(mut ed: Ed, cx: CmdCtx) -> int {
    let d = ed_doc(ed)
    if d >= 0 && buf_dirty(ed.bufs[d]) && !cx.bang {
        ed_msg(mut ed, MSG_ERROR, "buffer has unsaved changes (use :new!)")
        return CMD_ERR_STATE
    }
    if !cx.has_sarg || cx.sarg.len == 0 {
        let fresh = buffer_untitled(mut ed)
        ed_show_buffer(mut ed, fresh)
        return CMD_OK
    }
    fc_open_path(mut ed, cx.sarg)
}

/// A fresh untitled buffer; answers its index.
pub fn buffer_untitled(mut ed: Ed) -> int {
    let b = buffer_around(mut ed, take text.textbuf_new(), text.filemeta_new(), "", false)
    (mut ed.bufs).push(b)
    ed.bufs.len - 1
}

// `yew_ws_file_buf` + `yew_buf_hydrate` + `yew_ed_show_buffer` for `path`.
fn fc_open_path(mut ed: Ed, path: str) -> int {
    let canonical = canonical_path(path)
    var bi = -1
    var i = 0
    while i < ed.bufs.len {
        if ed.bufs[i].has_path && !ed.bufs[i].has_name && ed.bufs[i].path == canonical {
            bi = i
        }
        i += 1
    }
    if bi < 0 {
        let (status, tb, meta) = text.file_load(canonical)
        if status != text.LOAD_OK && status != text.LOAD_ENOENT {
            return CMD_ERR_IO
        }
        var b = buffer_around(mut ed, take tb, meta, canonical, true)
        b.tabwidth = ed.opts.tabwidth
        b.recovery_pending = !ed.headless &&
            b.ec.meta.has_realpath &&
            text.journal_probe(ed.journals, b.ec.meta.realpath, b.ec.meta)
        (mut ed.bufs).push(b)
        bi = ed.bufs.len - 1
    }
    ed_show_buffer(mut ed, bi)
    CMD_OK
}

/// `ed.buf.open` (`file_cmds.c:154-184`).
pub fn fc_buf_open(mut ed: Ed, cx: CmdCtx) -> int {
    if !cx.has_sarg || cx.sarg.len == 0 || !ed.model_ready {
        return CMD_ERR_ARG
    }
    fc_open_path(mut ed, cx.sarg)
}

/// `ed.buf.close` (`file_cmds.c:285-345`): a dirty buffer needs `!`.
pub fn fc_buf_close(mut ed: Ed, cx: CmdCtx) -> int {
    if !ed.model_ready {
        return CMD_ERR_ARG
    }
    let w = if cx.win >= 0 then cx.win else ed.win
    let b = ed.wins[w].buf
    // s57.31 §2: A-e's buffer returns its line on the way out; `!` the
    // original (`file_cmds.c:341-344`).
    if cmdedit_owns(ed, b) {
        return cmdedit_close(mut ed, cx.bang)
    }
    if buf_dirty(ed.bufs[b]) && !cx.bang {
        return CMD_ERR_IO
    }
    let fresh = buffer_untitled(mut ed)
    ed_show_buffer(mut ed, fresh)
    CMD_OK
}

/// `ed.file.reload` (`file_cmds.c:347-366`).
pub fn fc_reload(mut ed: Ed, cx: CmdCtx) -> int {
    let d = ed_doc(ed)
    if d < 0 || !ed.bufs[d].has_path {
        ed_msg(mut ed, MSG_ERROR, "buffer has no file name")
        return CMD_ERR_STATE
    }
    if buf_dirty(ed.bufs[d]) && !cx.bang {
        ed_msg(mut ed, MSG_ERROR, "buffer has unsaved changes (use :reload!)")
        return CMD_ERR_STATE
    }
    let (status, tb, meta) = text.file_load(ed.bufs[d].path)
    if status != text.LOAD_OK {
        return CMD_ERR_IO
    }
    let path = ed.bufs[d].path
    var b = buffer_around(mut ed, take tb, meta, path, true)
    b.tabwidth = ed.opts.tabwidth
    (mut ed.bufs).push(b)
    ed_show_buffer(mut ed, ed.bufs.len - 1)
    CMD_OK
}

/// `ed.quit` (`file_cmds.c:368-382`).
pub fn fc_quit(mut ed: Ed, cx: CmdCtx) -> int {
    // s57.31 §2: `:q` closes A-e's buffer and returns its line; `:q!` the
    // original (`file_cmds.c:407-414`).
    if ed.win >= 0 && cmdedit_owns(ed, ed.wins[ed.win].buf) {
        return cmdedit_close(mut ed, cx.bang)
    }
    ed_request_quit(mut ed, cx.bang)
}

/// `ed.quit_force` (`file_cmds.c:384-389`).
pub fn fc_quit_force(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    ed_request_quit(mut ed, true)
}

/// `ed.suspend` (`file_cmds.c:391-399`): the terminal restored and the
/// process stopped; the continue re-enters raw (the loop's `SIG_CONT`).
pub fn fc_suspend(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    term.tty_suspend(mut ed.tty)
    ed.layout_dirty = true
    ed.full_damage = true
    CMD_OK
}

/// `ed.redraw` (`file_cmds.c:401-409`).
pub fn fc_redraw(mut ed: Ed, cx: CmdCtx) -> int {
    let _ = cx.win
    if ed.win >= 0 {
        vp_invalidate(mut ed.wins[ed.win])
    }
    ed.full_damage = true
    CMD_OK
}

/// `yew_ed_file_write_to_win` (`ed.c:2078-2184`): write the focused
/// buffer to `path`; it then IS that file (the tab renamed, the metadata
/// replaced).
pub fn ed_file_write_to(mut ed: Ed, path: str, force: bool) -> int {
    if !ed.model_ready || ed.win < 0 || path.len == 0 {
        return CMD_ERR_ARG
    }
    ed_insert_barrier(mut ed)
    let w = ed.win
    let b = ed.wins[w].buf
    if !ed.bufs[b].resident {
        ed_msg(mut ed, MSG_ERROR, "nothing loaded; nothing written")
        return CMD_ERR_STATE
    }
    let (load, _, next) = text.file_load(path)
    if load != text.LOAD_OK && load != text.LOAD_ENOENT {
        ed_msg(mut ed, MSG_ERROR, "could not inspect {path}")
        return CMD_ERR_IO
    }
    edit_take(mut ed, w)
    let old_meta = ed.bufs[b].ec.meta
    let had_meta = ed.bufs[b].ec.has_meta
    ed.bufs[b].ec.meta = next
    ed.bufs[b].ec.has_meta = true
    var result = 0
    if force {
        result = text.file_save_force_opts(
            mut ed.bufs[b].ec.tb,
            mut ed.bufs[b].ec.meta,
            path,
            text.save_opts_default(),
        )
        if text.save_committed(result) {
            text.undo_boundary(mut ed.bufs[b].ec.undo)
            text.undo_mark_saved(mut ed.bufs[b].ec.undo, ed.bufs[b].ec.tb)
            if ed.bufs[b].ec.has_jrnl {
                let _ = text.journal_discard(mut ed.bufs[b].ec.journals, mut ed.bufs[b].ec.jrnl)
                ed.bufs[b].ec.has_jrnl = false
            }
        }
    } else {
        result = text.edit_save_opts(mut ed.bufs[b].ec, path, text.save_opts_default())
    }
    if !text.save_committed(result) {
        ed.bufs[b].ec.meta = old_meta
        ed.bufs[b].ec.has_meta = had_meta
        edit_give(mut ed, w)
        ed_finish_edit(mut ed, w)
        ed_msg(mut ed, MSG_ERROR, "could not write {path}")
        return CMD_ERR_IO
    }
    edit_give(mut ed, w)
    ed_finish_edit(mut ed, w)
    ed.bufs[b].path = path
    ed.bufs[b].has_path = true
    var t = 0
    while t < ed.tabs.len {
        if ed.tabs[t].win == w {
            ed.tabs[t].path = canonical_path(path)
            ed.tabs[t].display_path = logical_path(ed, path, ed.tabs[t].path)
            ed.tabs[t].has_path = true
        }
        t += 1
    }
    ed.durability_failed = false
    let lines = text.textbuf_line_count(ed.bufs[b].ec.tb)
    if result == text.SAVE_BACKUP_FAILED {
        ed_msg(mut ed, MSG_WARN, "wrote {path}, but backup retention failed")
    } else {
        ed_msg(mut ed, MSG_INFO, "wrote {path}, {lines} lines")
    }
    CMD_OK
}
