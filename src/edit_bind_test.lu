//! member: false
//! The five tests/unit/test_bind.c cases at sagitta 9ace98c2, in registry
//! order (Sprint 36: origin-owned bindings). C's `ed.bind_keys[mode]` is
//! `edit.bind_keys(ed, mode)`; C's `ed.keys.n` is the active stack's
//! length; the VM's error is read from the runtime's parked VM.

use edit
use fl
use term

fn bind_key(c: int) -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    k.code = c
    (mut k.text).push(c as byte)
    k
}

fn bind_keymap_diagnostics_classify_all_six_failures() {
    let ed = edit.ed_new()
    let reg = ed.reg
    let bad_seq = [edit.bindrow("<nope>", "ed.nop")]
    let unknown = [edit.bindrow("a", "ed.missing")]
    let duplicate = [edit.bindrow("a", "ed.nop"), edit.bindrow("a", "ed.nop")]
    let arity = [edit.bindrow("a", "ed.mode.enter")]
    let escape = [edit.bindrow("<esc> a", "ed.nop")]
    let long_seq = [edit.bindrow("a b c d e f g h i", "ed.nop")]
    let (e0, _) = edit.keymap_validate_row(reg, bad_seq[0])
    assert(e0 == edit.KEYMAP_ERR_SEQUENCE)
    let (e1, _) = edit.keymap_validate_row(reg, unknown[0])
    assert(e1 == edit.KEYMAP_ERR_COMMAND)
    let (e2, _) = edit.keymap_validate_row(reg, duplicate[0])
    assert(e2 == edit.KEYMAP_ERR_NONE)
    let (e3, _) = edit.keymap_validate_row(reg, arity[0])
    assert(e3 == edit.KEYMAP_ERR_ARITY)
    let (e4, _) = edit.keymap_validate_row(reg, escape[0])
    assert(e4 == edit.KEYMAP_ERR_ESCAPE_PREFIX)
    let (e5, _) = edit.keymap_validate_row(reg, long_seq[0])
    assert(e5 == edit.KEYMAP_ERR_TOO_LONG)
    let cases = [bad_seq, unknown, duplicate, arity, escape, long_seq]
    let errors = [
        edit.KEYMAP_ERR_SEQUENCE,
        edit.KEYMAP_ERR_COMMAND,
        edit.KEYMAP_ERR_DUPLICATE,
        edit.KEYMAP_ERR_ARITY,
        edit.KEYMAP_ERR_ESCAPE_PREFIX,
        edit.KEYMAP_ERR_TOO_LONG,
    ]
    let texts = [
        "invalid key sequence",
        "unknown command",
        "duplicate key sequence",
        "command arguments do not match its arity",
        "<esc> may not be a chord prefix",
        "key sequence exceeds eight keys",
    ]
    for i in 0..cases.len {
        let (ok, map, _, err) = edit.keymap_build_diag(reg, "invalid", cases[i])
        assert(!ok)
        assert(err == errors[i])
        assert(edit.keymap_error_string(err) == texts[i])
        assert(map.nodes.len == 0)
    }
}

// trace_has (test_bind.c:87-98).
fn trace_has(mut ed: edit.Ed, needle: str) -> bool {
    var trace = List[byte]()
    let err = copy ed.flrt.vms[0].err
    fl.fl_trace_render(mut ed.flrt.vms[0], err, mut trace)
    let text = str_from_utf8(trace) else ""
    text.contains(needle)
}

fn bind_fletch_validation_errors_carry_source_positions() {
    let sources = [
        "bind(\"L\", \"<nope>\", \"ed.nop\")",
        "bind(\"L\", \"a\", \"ed.missing\")",
        "bind(\"L\", \"a\", \"ed.mode.enter\")",
        "bind(\"L\", \"<esc> a\", \"ed.nop\")",
        "bind(\"L\", \"a b c d e f g h i\", \"ed.nop\")",
    ]
    let duplicate = "bind(\"L\", \"a\", \"ed.nop\")"
    var ed = edit.ed_new()
    for src in sources {
        let b = copy src.bytes()
        assert(edit.fl_runtime_eval(mut ed, b) == edit.CMD_ERR_STATE)
        assert(trace_has(mut ed, "at <repl> (<E>:1:"))
        assert(trace_has(mut ed, "^"))
    }
    let d = copy duplicate.bytes()
    assert(edit.fl_runtime_eval(mut ed, d) == edit.CMD_OK)
    assert(edit.fl_runtime_eval(mut ed, d) == edit.CMD_ERR_STATE)
    assert(trace_has(mut ed, "duplicate key sequence"))
    assert(trace_has(mut ed, "at <repl> (<E>:1:"))
}

fn bind_closure_dispatches_from_frozen_mode_layer() {
    let script = "bind(\"L\", \"Z\", fn() set({{ errorbells: true }}))"
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    assert(!ed.errorbells)
    let b = copy script.bytes()
    assert(edit.fl_runtime_eval(mut ed, b) == edit.CMD_OK)
    assert(edit.bind_active_count(ed) == 1)
    assert(ed.keys.len == 3)
    let id = edit.key_parse_seq("Z", 1)
    assert(id.len == 1)
    let km = edit.bind_keys(ed, edit.MODE_L)
    let (m, _, bi) = edit.keymap_lookup(km, id, 1)
    assert(m == edit.MATCH_FULL)
    let binding = km.binds[bi]
    assert(ed.reg.entries[binding.cmd - 1].name == "ed.fl.closure")
    let cx = edit.cmdctx_new(ed.win, edit.SRC_KEY)
    assert(edit.bind_cmd_map(mut ed, cx) == edit.CMD_OK)
    assert(ed.msg.text.contains("Z  ed.fl.closure"))
    edit.ed_handle_key(mut ed, bind_key('Z' as int), 10)
    assert(ed.errorbells)
    assert(ed.dispatch_count == 1)
}

fn bind_origin_ownership_copies_rows_and_batches_one_rebuild() {
    var ed = edit.ed_new()
    let nop = edit.cmd_lookup(ed.reg, "ed.nop")
    let enter = edit.cmd_lookup(ed.reg, "ed.mode.enter")
    let label = copy "plug:test".bytes()
    let plugin = fl.fl_origin_register(mut ed.origins, fl.FL_ORIGIN_PLUGIN, label, 0)
    let before = edit.bind_rebuild_count(ed)
    edit.bind_batch_begin(mut ed)
    var seq = "X"
    var sarg = "owned"
    let first = edit.bind_add(mut ed, plugin, edit.MODE_L, seq, enter, 0, sarg, true, fl.fl_nil())
    let second = edit.bind_add(mut ed, plugin, edit.MODE_W, "Y", nop, 0, "", false, fl.fl_nil())
    assert(first != 0)
    assert(second != 0)
    assert(edit.bind_rebuild_count(ed) == before)
    // C rewrites its caller-owned buffers here; a wolf string is a value,
    // so the row owning its copy is the same law.
    seq = "Q"
    sarg = "xwned"
    edit.bind_batch_end(mut ed)
    assert(edit.bind_rebuild_count(ed) == before + 1)
    let key = edit.key_parse_seq("X", 1)
    assert(key.len == 1)
    let km = edit.bind_keys(ed, edit.MODE_L)
    let (m, _, bi) = edit.keymap_lookup(km, key, 1)
    assert(m == edit.MATCH_FULL)
    assert(km.binds[bi].sarg == "owned")
    assert(seq == "Q" && sarg == "xwned")
    let unbind_src = copy "unbind(\"L\", \"X\")".bytes()
    assert(edit.fl_runtime_eval(mut ed, unbind_src) == edit.CMD_ERR_STATE)
    assert(trace_has(mut ed, "owned by plug:test"))
    assert(edit.bind_active_count(ed) == 2)
    assert(edit.bind_remove(mut ed, first))
    assert(!edit.bind_remove(mut ed, first))
    assert(edit.bind_active_count(ed) == 1)
}

fn bind_later_origin_shadows_then_teardown_reveals_prior() {
    var ed = edit.ed_new()
    let nop = edit.cmd_lookup(ed.reg, "ed.nop")
    let enter = edit.cmd_lookup(ed.reg, "ed.mode.enter")
    let b_label = copy "/runtime/init.fl".bytes()
    let w_label = copy "/work/.yew.fl".bytes()
    let builtin = fl.fl_origin_register(mut ed.origins, fl.FL_ORIGIN_BUILTIN, b_label, 0)
    let workspace = fl.fl_origin_register(mut ed.origins, fl.FL_ORIGIN_WORKSPACE, w_label, 0)
    edit.bind_batch_begin(mut ed)
    let lower = edit.bind_add(mut ed, builtin, edit.MODE_L, "Z", nop, 0, "", false, fl.fl_nil())
    let upper = edit.bind_add(mut ed, workspace, edit.MODE_L, "Z", enter, 0, "W", true, fl.fl_nil())
    edit.bind_batch_end(mut ed)
    assert(lower != 0)
    assert(upper != 0)
    assert(edit.bind_active_count(ed) == 2)
    let key = edit.key_parse_seq("Z", 1)
    assert(key.len == 1)
    var km = edit.bind_keys(ed, edit.MODE_L)
    let (m, _, bi) = edit.keymap_lookup(km, key, 1)
    assert(m == edit.MATCH_FULL)
    assert(ed.reg.entries[km.binds[bi].cmd - 1].name == "ed.mode.enter")
    assert(km.binds[bi].sarg == "W")
    assert(edit.bind_remove(mut ed, upper))
    km = edit.bind_keys(ed, edit.MODE_L)
    let (m2, _, bi2) = edit.keymap_lookup(km, key, 1)
    assert(m2 == edit.MATCH_FULL)
    assert(ed.reg.entries[km.binds[bi2].cmd - 1].name == "ed.nop")
    assert(edit.bind_remove(mut ed, lower))
}

fn main() {
    bind_keymap_diagnostics_classify_all_six_failures()
    bind_fletch_validation_errors_carry_source_positions()
    bind_closure_dispatches_from_frozen_mode_layer()
    bind_origin_ownership_copies_rows_and_batches_one_rebuild()
    bind_later_origin_shadows_then_teardown_reveals_prior()
    print("edit_bind: 5 cases pass")
}
