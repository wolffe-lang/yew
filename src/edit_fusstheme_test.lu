//! member: false
//!
//! The port of sagitta `tests/unit/test_fusstheme.c` (138 lines): its one
//! case, `fuss_theme_roles_are_shipped`, over the two shipped themes
//! (`runtime/themes/quiver-{dark,light}.fl`, byte-identical to the pin's):
//! every git role s51-s53 draw with compiles without a diagnostic, the
//! pre-S52 `mode.fuss` spelling stays, and the drawer's and its edge's
//! renditions are C's colours.
//!
//! `YEW_PICK_CASE=N` runs case N alone.

use edit
use std.fs
use term

fn want(ok: bool, what: str) {
    if !ok {
        print("fusstheme_test: RED check failed: {what}")
        eprint("fusstheme_test: RED check failed: {what}")
        assert(false, what)
    }
}

fn ui(t: edit.Theme, role: str, rendition: int) -> edit.ThemeEnt {
    let (found, e) = edit.theme_ui(t, role, rendition)
    want(found, "{role} at rendition {rendition}")
    e
}

fn rgb(c: term.Color, r: int, g: int, b: int) -> bool {
    c.tag == term.COLOR_RGB && c.r == r && c.g == g && c.b == b
}

// `test_fuss_theme_roles_are_shipped` (`test_fusstheme.c:49-138`).
fn fuss_theme_roles_are_shipped() {
    let paths = ["runtime/themes/quiver-dark.fl", "runtime/themes/quiver-light.fl"]
    let roles = [
        "mode.git",
        "git.drawer",
        "git.drawer.edge",
        "git.staged",
        "git.modified",
        "git.untracked",
        "git.incoming",
        "git.conflict",
        "git.ignored",
        "git.blame",
        "git.blame.stale",
        "git.sign.add",
        "git.sign.mod",
        "git.sign.del",
        "git.sign.conflict",
        "git.sign.unknown",
        "git.diff.add",
        "git.diff.del",
        "git.diff.mod",
        "git.diff.filler",
        "git.diff.intra.add",
        "git.diff.intra.del",
    ]
    var file = 0
    while file < paths.len {
        let src = fs.read_bytes(paths[file]) else |_| {
            want(false, "read {paths[file]}")
            List[byte]()
        }
        let (ok, theme, diag) = edit.theme_compile(src)
        want(ok && diag.len == 0, "{paths[file]} compiles without a diagnostic: {diag}")
        for role in roles {
            let _ = ui(theme, role, edit.THEME_TRUECOLOR)
        }
        // Keep the pre-S52 spelling available to user themes/configuration.
        let _ = ui(theme, "mode.fuss", edit.THEME_TRUECOLOR)
        let mode = ui(theme, "mode.git", edit.THEME_TRUECOLOR)
        let conflict = ui(theme, "git.conflict", edit.THEME_TRUECOLOR)
        let drawer = ui(theme, "git.drawer", edit.THEME_TRUECOLOR)
        let drawer256 = ui(theme, "git.drawer", edit.THEME_256)
        let drawer16 = ui(theme, "git.drawer", edit.THEME_16)
        let drawer_mono = ui(theme, "git.drawer", edit.THEME_MONO)
        let edge = ui(theme, "git.drawer.edge", edit.THEME_TRUECOLOR)
        let edge256 = ui(theme, "git.drawer.edge", edit.THEME_256)
        let edge16 = ui(theme, "git.drawer.edge", edit.THEME_16)
        let edge_mono = ui(theme, "git.drawer.edge", edit.THEME_MONO)
        want(mode.bg.tag == term.COLOR_RGB, "mode.git's background is RGB")
        want(conflict.fg.tag == term.COLOR_RGB, "git.conflict's foreground is RGB")
        want(conflict.attrs & term.ATTR_BOLD != 0, "git.conflict is bold")
        want(drawer.bg.tag == term.COLOR_RGB, "the drawer's truecolor background")
        want(drawer256.bg.tag == term.COLOR_INDEXED, "the drawer's 256 background")
        want(drawer16.bg.tag == term.COLOR_INDEXED, "the drawer's 16 background")
        want(drawer_mono.bg.tag == term.COLOR_DEFAULT, "the drawer's mono background")
        if file == 0 {
            want(rgb(drawer.bg, 27, 32, 42), "quiver-dark's drawer is #1b202a")
        } else {
            want(rgb(drawer.bg, 238, 241, 244), "quiver-light's drawer is #eef1f4")
        }
        if file == 0 {
            want(rgb(edge.fg, 255, 255, 255), "quiver-dark's edge is white")
        } else {
            want(rgb(edge.fg, 87, 96, 106), "quiver-light's edge is #57606a")
        }
        want(edge.attrs & term.ATTR_BOLD != 0, "the edge is bold")
        want(edge256.fg.tag == term.COLOR_INDEXED, "the edge's 256 foreground")
        want(edge16.fg.tag == term.COLOR_INDEXED, "the edge's 16 foreground")
        want(edge_mono.fg.tag == term.COLOR_DEFAULT, "the edge's mono foreground")
        want(edge_mono.attrs & term.ATTR_BOLD != 0, "the mono edge stays bold")
        file += 1
    }
}

fn main() {
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    if chosen < 0 || chosen == 0 {
        fuss_theme_roles_are_shipped()
        print("fuss_theme_roles_are_shipped: PASS")
    }
}
