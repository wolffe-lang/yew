//! member: false
//!
//! The port of sagitta `tests/unit/test_ctxrows.c` (1,213 lines), one test
//! per C test in registry order (`tests/unit/registry.c:2691-2712`, 17
//! cases in this file; `ctxrows_doc_lsp_section_appears_with_a_server`,
//! registered between them under `#if YEW_WITH_LSP`, lives in
//! `test_lsp_life.c` and is yw11's): the row sets pinned by EXACT LABEL
//! LIST, every enable condition in both states, and the seam between a
//! row and its registry command.
//!
//! **The FUSS cases.** The oracle builds `YEW_WITH_FUSS=1`, so C registers
//! the five `ctxrows_fuss_*` (`registry.c:2704-2710`); they build FUSS
//! rows over Git fixtures and the FUSS tree (Sprint 52), yw13's
//! (R-yw06-4 = A). Each is RED BY NAME naming yw13 — printed on both
//! streams and counted — and asserts the port's refusal: the builder
//! refuses on the message line and builds nothing, so the day yw13 lands
//! the assertion fails and the case is ported.
//!
//! **SKIP by name inside a case.** `ctxrows_doc_optional_sections_are_
//! absent_not_greyed` asks the two queries the sections hang on directly
//! (`yew_lsp_attached`, `yew_git_repo_cached`, `test_ctxrows.c:309-318`):
//! neither exists before yw11 and yw13, so those two asserts say SKIP;
//! the absent-not-greyed half runs. `ctxrows_every_row_resolves_to_a_
//! registry_command` walks every kind; the three FUSS kinds refuse
//! (above), so they say SKIP and the walk covers the other thirteen (54
//! commanded rows, the guard's 40 still met) — R-yw06-C1, asked; the FUSS
//! ACTIONS are still checked against the registry, arity included, by
//! `ctxrows_the_action_table_is_wholly_resolvable`.
//!
//! **Port case** (`port_*`): the FUSS kinds refuse by name naming yw13 and
//! leave the widget empty (R-yw06-4 = A's witness).
//!
//! `YEW_CTX_CASE=N` runs case N alone (0-based, registry order, the port
//! case last), for the checked machine's per-case runs (G29).

use edit
use std.fs
use term
use text

fn say(what: str) {
    print("ctxrows_test: {what}")
    eprint("ctxrows_test: {what}")
}

fn say_skip(what: str) -> int {
    say("SKIP {what}")
    1
}

fn bytes_of(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() {
        (mut out).push(b)
    }
    out
}

// `cr_fixture` (`test_ctxrows.c:57-67`).
fn cr_fixture() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    edit.ed_layout(mut ed)
    ed.now_ms = 1000
    ed
}

// `cr_leaf` (`:69-82`): the leaf index is a PAINT-TIME identity.
fn cr_leaf(mut ed: edit.Ed) -> int {
    edit.pane_tables_reset(mut ed)
    let f = ed.focus
    let leaf = edit.pane_table_add_leaf(mut ed, f)
    assert(leaf >= 0, "a leaf index")
    leaf
}

// `cr_build` (`:84-101`): CLOSED FIRST, exactly as the router does it.
fn cr_build(mut ed: edit.Ed, kind: int, id: int) {
    let c = edit.ctxcontext_new(kind, id)
    edit.ctx_close(mut ed.ctx)
    edit.ctx_build(mut ed, c)
}

// `cr_rows_are` (`:103-121`): the row list, exactly; "" is a separator.
fn cr_rows_are(ed: edit.Ed, want: List[str]) {
    assert(edit.ctx_rows(ed.ctx) == want.len, "{want.len} rows, got {edit.ctx_rows(ed.ctx)}")
    var i = 0
    while i < want.len {
        if want[i].len == 0 {
            assert(edit.ctx_row_is_sep(ed.ctx, i), "row {i} a separator")
        } else {
            assert(!edit.ctx_row_is_sep(ed.ctx, i), "row {i} not a separator")
            let got = edit.ctx_row_label(ed.ctx, i)
            assert(got == want[i], "row {i}: want {want[i]}, got {got}")
        }
        i += 1
    }
}

// `cr_index` (`:123-132`).
fn cr_index(ed: edit.Ed, label: str) -> int {
    var i = 0
    while i < edit.ctx_rows(ed.ctx) {
        if edit.ctx_row_label(ed.ctx, i) == label {
            return i
        }
        i += 1
    }
    -1
}

fn cr_has(ed: edit.Ed, label: str) -> bool {
    cr_index(ed, label) >= 0
}

fn cr_enabled(ed: edit.Ed, label: str) -> bool {
    let at = cr_index(ed, label)
    assert(at >= 0, "row {label} present")
    edit.ctx_row_enabled(ed.ctx, at)
}

fn cr_priority(ed: edit.Ed, label: str) -> int {
    let at = cr_index(ed, label)
    assert(at >= 0, "row {label} present")
    edit.ctx_priority(ed.ctx, at)
}

fn pri_is(ed: edit.Ed, label: str, want: int) {
    let got = cr_priority(ed, label)
    assert(got == want, "{label} priority {want}, got {got}")
}

fn doc_rows() -> List[str] {
    [
        "Cut",
        "Copy",
        "Paste",
        "Delete",
        "Select All",
        "",
        "Undo",
        "Redo",
        "",
        "Split Right",
        "Split Below",
        "Close Pane",
        "",
        "Save",
        "Save As...",
        "Reload",
        "",
        "Command Palette...",
        "Find File...",
        "Go to Line...",
        "Toggle Wrap",
    ]
}

// ---- the document -----------------------------------------------------------

fn ctxrows_doc_rows_match_the_contract() {
    var ed = cr_fixture()
    let leaf = cr_leaf(mut ed)
    cr_build(mut ed, edit.CTX_KIND_DOC, leaf)
    cr_rows_are(ed, doc_rows())
    pri_is(ed, "Cut", 0)
    pri_is(ed, "Copy", 0)
    pri_is(ed, "Paste", 0)
    pri_is(ed, "Delete", 1)
    pri_is(ed, "Select All", 1)
    pri_is(ed, "Undo", 1)
    pri_is(ed, "Redo", 1)
    pri_is(ed, "Split Right", 2)
    pri_is(ed, "Split Below", 2)
    pri_is(ed, "Close Pane", 2)
    pri_is(ed, "Save", 1)
    pri_is(ed, "Save As...", 2)
    pri_is(ed, "Reload", 3)
    pri_is(ed, "Command Palette...", 0)
    pri_is(ed, "Find File...", 1)
    pri_is(ed, "Go to Line...", 2)
    pri_is(ed, "Toggle Wrap", 3)
    edit.ctx_close(mut ed.ctx)
}

// The enable conditions, each in BOTH states (`:177-288`).
fn ctxrows_doc_enables_follow_the_live_state() {
    var ed = cr_fixture()
    var leaf = cr_leaf(mut ed)
    // No selection, nothing to undo.
    cr_build(mut ed, edit.CTX_KIND_DOC, leaf)
    assert(!cr_enabled(ed, "Cut"), "no Cut")
    assert(!cr_enabled(ed, "Copy"), "no Copy")
    assert(!cr_enabled(ed, "Delete"), "no Delete")
    assert(cr_enabled(ed, "Paste"), "Paste is live from the first frame")
    assert(!cr_enabled(ed, "Undo"), "no Undo")
    assert(!cr_enabled(ed, "Redo"), "no Redo")
    assert(!cr_enabled(ed, "Save"), "a clean buffer")
    assert(!cr_enabled(ed, "Reload"), "a scratch has no path")
    assert(!cr_enabled(ed, "Close Pane"), "one leaf")
    assert(cr_enabled(ed, "Select All"), "Select All always")
    // A selection, made the ordinary way.
    let w = ed.win
    let text_in = bytes_of("hello world\n")
    edit.ed_undo_begin(mut ed, w, text.TXN_TYPE)
    assert(
        edit.ed_edit_insert(mut ed, w, edit.ed_cursor_pos(ed), text_in, 0, text_in.len),
        "insert",
    )
    edit.ed_undo_end(mut ed, w)
    edit.ed_finish_edit(mut ed, w)
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].anchor = 0
    ed.wins[w].cs.curs[p].pos = 5
    leaf = cr_leaf(mut ed)
    cr_build(mut ed, edit.CTX_KIND_DOC, leaf)
    // STILL GREY: the mode is still L.
    assert(!cr_enabled(ed, "Cut"), "L: no Cut")
    assert(!cr_enabled(ed, "Copy"), "L: no Copy")
    assert(!cr_enabled(ed, "Delete"), "L: no Delete")
    assert(cr_enabled(ed, "Save"), "dirty")
    assert(cr_enabled(ed, "Undo"), "something to undo")
    assert(!cr_enabled(ed, "Redo"), "nothing to redo")
    // H is what makes it a selection.
    ed.mode = edit.MODE_H
    leaf = cr_leaf(mut ed)
    cr_build(mut ed, edit.CTX_KIND_DOC, leaf)
    assert(cr_enabled(ed, "Cut"), "H: Cut")
    assert(cr_enabled(ed, "Copy"), "H: Copy")
    assert(cr_enabled(ed, "Delete"), "H: Delete")
    // H over one grapheme IS a selection of one.
    ed.wins[w].cs.curs[p].anchor = ed.wins[w].cs.curs[p].pos
    leaf = cr_leaf(mut ed)
    cr_build(mut ed, edit.CTX_KIND_DOC, leaf)
    assert(cr_enabled(ed, "Copy"), "a selection of one")
    // Read-only locks every row that writes and none that only read.
    let b = ed.wins[w].buf
    ed.bufs[b].flags = ed.bufs[b].flags | edit.BUF_READONLY
    leaf = cr_leaf(mut ed)
    cr_build(mut ed, edit.CTX_KIND_DOC, leaf)
    assert(!cr_enabled(ed, "Paste"), "read-only: no Paste")
    assert(!cr_enabled(ed, "Cut"), "read-only: no Cut")
    assert(!cr_enabled(ed, "Delete"), "read-only: no Delete")
    assert(cr_enabled(ed, "Copy"), "reading is always allowed")
    ed.bufs[b].flags = ed.bufs[b].flags - (ed.bufs[b].flags & edit.BUF_READONLY)
    ed.mode = edit.MODE_L
    // Undone: now there is a redo and no undo.
    let ucx = edit.cmdctx_new(w, edit.SRC_TEST)
    assert(edit.ec_undo(mut ed, ucx) == edit.CMD_OK, "undo")
    leaf = cr_leaf(mut ed)
    cr_build(mut ed, edit.CTX_KIND_DOC, leaf)
    assert(!cr_enabled(ed, "Undo"), "undone: no Undo")
    assert(cr_enabled(ed, "Redo"), "undone: Redo")
    // A second leaf unlocks Close Pane.
    let scx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    assert(edit.pane_cmd_split_h(mut ed, scx) == edit.CMD_OK, "split")
    leaf = cr_leaf(mut ed)
    cr_build(mut ed, edit.CTX_KIND_DOC, leaf)
    assert(cr_enabled(ed, "Close Pane"), "two leaves: Close Pane")
    edit.ctx_close(mut ed.ctx)
}

// The section-omission rule (`:290-327`).
fn ctxrows_doc_optional_sections_are_absent_not_greyed() -> int {
    var ed = cr_fixture()
    let leaf = cr_leaf(mut ed)
    cr_build(mut ed, edit.CTX_KIND_DOC, leaf)
    assert(!cr_has(ed, "Go to Definition"), "no Go to Definition")
    assert(!cr_has(ed, "Find References..."), "no Find References...")
    assert(!cr_has(ed, "Rename..."), "no Rename...")
    assert(!cr_has(ed, "Hover"), "no Hover")
    assert(!cr_has(ed, "Toggle Blame"), "no Toggle Blame")
    assert(!cr_has(ed, "Diff"), "no Diff")
    var skips = say_skip(
        "ctxrows_doc_optional_sections_are_absent_not_greyed: !yew_lsp_attached (test_ctxrows.c:309-314): no LSP attachment before sagitta Sprint 46 (yw11)",
    )
    skips += say_skip(
        "ctxrows_doc_optional_sections_are_absent_not_greyed: yew_git_repo_cached == NULL (test_ctxrows.c:315-318): no repository detection before sagitta Sprint 51 (yw13)",
    )
    assert(cr_has(ed, "Command Palette..."), "the palette row")
    assert(cr_has(ed, "Toggle Wrap"), "the wrap row")
    edit.ctx_close(mut ed.ctx)
    skips
}

// ---- the tab strip ----------------------------------------------------------

fn tab_rows() -> List[str] {
    [
        "Close Tab",
        "Close Other Tabs",
        "",
        "Copy Path",
        "Remove from Group",
        "",
        "New Tab",
        "Open in Split Right",
        "Open in Split Left",
        "Open in Split Below",
    ]
}

fn ctxrows_tab_rows_match_the_contract() {
    var ed = cr_fixture()
    var tab_id = ed.tabs[ed.tab_active].tab_id
    cr_build(mut ed, edit.CTX_KIND_TAB, tab_id)
    cr_rows_are(ed, tab_rows())
    // One tab, no path, no group: greyed, and all still THERE.
    assert(!cr_enabled(ed, "Close Tab"), "one tab: no Close Tab")
    assert(!cr_enabled(ed, "Close Other Tabs"), "one tab: no Close Other Tabs")
    assert(!cr_enabled(ed, "Copy Path"), "no path: no Copy Path")
    assert(!cr_enabled(ed, "Remove from Group"), "ungrouped")
    assert(cr_enabled(ed, "New Tab"), "New Tab")
    pri_is(ed, "Close Tab", 0)
    pri_is(ed, "Close Other Tabs", 1)
    pri_is(ed, "Copy Path", 1)
    pri_is(ed, "Remove from Group", 2)
    pri_is(ed, "New Tab", 2)
    pri_is(ed, "Open in Split Right", 3)
    pri_is(ed, "Open in Split Left", 3)
    pri_is(ed, "Open in Split Below", 3)
    // Sprint 57.22 §5: the three SIDED commands, each spending the tab id.
    let r = edit.ctx_actions(edit.CTXA_TAB_OPEN_SPLIT_RIGHT)
    let l = edit.ctx_actions(edit.CTXA_TAB_OPEN_SPLIT_LEFT)
    let d = edit.ctx_actions(edit.CTXA_TAB_OPEN_SPLIT_BELOW)
    assert(r.cmd == "ed.tab.split_right", "right")
    assert(l.cmd == "ed.tab.split_left", "left")
    assert(d.cmd == "ed.tab.split_down", "below")
    assert(r.target == edit.CTX_TGT_TAB, "right spends the tab id")
    assert(l.target == edit.CTX_TGT_TAB, "left spends the tab id")
    assert(d.target == edit.CTX_TGT_TAB, "below spends the tab id")
    // A second tab, with a path, in a group. The file has to EXIST: a
    // tab's path is its canonical realpath.
    let tmp = env_get("TMPDIR") else "build/tmp"
    let dir = if tmp.len == 0 then "build/tmp" else tmp
    fs.create_dir_all(dir) else |_| {}
    let file = "{dir}/yew-ctxrows-tab.txt"
    fs_write_bytes(file, bytes_of("tab\n")) else |_| {
        assert(false, "write {file}")
    }
    let idx = edit.tab_open(mut ed, file)
    assert(idx >= 0, "open {file}")
    edit.tab_switch(mut ed, idx)
    fs.remove(file) else |_| {}
    let gid = edit.group_create(mut ed, "/tmp", "grp")
    assert(gid != 0, "a group")
    let active = ed.tab_active
    edit.group_add_member(mut ed, gid, active)
    assert(ed.tabs[ed.tab_active].group_id == gid, "grouped")
    tab_id = ed.tabs[ed.tab_active].tab_id
    cr_build(mut ed, edit.CTX_KIND_TAB, tab_id)
    cr_rows_are(ed, tab_rows())
    assert(cr_enabled(ed, "Close Tab"), "Close Tab")
    assert(cr_enabled(ed, "Close Other Tabs"), "Close Other Tabs")
    assert(cr_enabled(ed, "Copy Path"), "Copy Path")
    assert(cr_enabled(ed, "Remove from Group"), "Remove from Group")
    let captured = edit.ctx_target_path(ed.ctx) else ""
    assert(captured.len != 0, "the path captured at build time")
    assert(edit.ctx_target_id(ed.ctx) == tab_id, "the tab id captured")
    edit.ctx_close(mut ed.ctx)
}

fn ctxrows_group_rows_match_the_contract() {
    var ed = cr_fixture()
    let gid = edit.group_create(mut ed, "/tmp", "grp")
    assert(gid != 0, "a group")
    cr_build(mut ed, edit.CTX_KIND_GROUP, gid)
    cr_rows_are(ed, ["Edit Group...", "Rename Group...", "", "Close Group", "Dissolve Group"])
    assert(edit.ctx_target_id(ed.ctx) == gid, "the gid captured")
    pri_is(ed, "Edit Group...", 0)
    pri_is(ed, "Rename Group...", 1)
    pri_is(ed, "Close Group", 1)
    pri_is(ed, "Dissolve Group", 1)
    // A gid that is not a group builds NOTHING.
    cr_build(mut ed, edit.CTX_KIND_GROUP, gid + 99)
    assert(edit.ctx_rows(ed.ctx) == 0, "no rows for a gone group")
    edit.ctx_close(mut ed.ctx)
}

fn strip_rows() -> List[str] {
    ["New Tab", "Open File...", "New Group...", "", "Command Palette...", "Find Buffer..."]
}

// The strip's tail and the editor backdrop are ONE row set (`:487-516`).
fn ctxrows_strip_and_editor_share_one_row_set() {
    var ed = cr_fixture()
    cr_build(mut ed, edit.CTX_KIND_STRIP, 0)
    cr_rows_are(ed, strip_rows())
    assert(edit.ctx_kind(ed.ctx) == edit.CTX_KIND_STRIP, "the strip kind")
    cr_build(mut ed, edit.CTX_KIND_EDITOR, 0)
    cr_rows_are(ed, strip_rows())
    assert(edit.ctx_kind(ed.ctx) == edit.CTX_KIND_EDITOR, "the editor kind")
    pri_is(ed, "New Tab", 0)
    pri_is(ed, "Open File...", 0)
    pri_is(ed, "New Group...", 1)
    pri_is(ed, "Command Palette...", 0)
    pri_is(ed, "Find Buffer...", 2)
    edit.ctx_close(mut ed.ctx)
}

// ---- border and footer ------------------------------------------------------

fn ctxrows_border_rows_need_a_second_pane() {
    let want = ["Close Pane", "Grow", "Shrink", "", "Focus Next"]
    var ed = cr_fixture()
    cr_build(mut ed, edit.CTX_KIND_BORDER, 0)
    cr_rows_are(ed, want)
    assert(!cr_enabled(ed, "Close Pane"), "one leaf: no Close Pane")
    assert(!cr_enabled(ed, "Grow"), "one leaf: no Grow")
    assert(!cr_enabled(ed, "Shrink"), "one leaf: no Shrink")
    assert(!cr_enabled(ed, "Focus Next"), "one leaf: no Focus Next")
    let scx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    assert(edit.pane_cmd_split_v(mut ed, scx) == edit.CMD_OK, "split")
    cr_build(mut ed, edit.CTX_KIND_BORDER, 0)
    cr_rows_are(ed, want)
    assert(cr_enabled(ed, "Close Pane"), "Close Pane")
    assert(cr_enabled(ed, "Grow"), "Grow")
    assert(cr_enabled(ed, "Shrink"), "Shrink")
    assert(cr_enabled(ed, "Focus Next"), "Focus Next")
    pri_is(ed, "Close Pane", 0)
    pri_is(ed, "Grow", 1)
    pri_is(ed, "Shrink", 1)
    pri_is(ed, "Focus Next", 2)
    edit.ctx_close(mut ed.ctx)
}

// The footer's number row NAMES THE CURRENT STYLE (`:552-588`).
fn ctxrows_footer_names_the_current_number_style() {
    var ed = cr_fixture()
    let w = ed.win
    ed.wins[w].number_style = edit.NUM_NONE
    cr_build(mut ed, edit.CTX_KIND_FOOTER, 0)
    cr_rows_are(
        ed,
        [
            "Command Palette...",
            "Go to Line...",
            "",
            "Toggle Wrap",
            "Line Numbers: none",
            "",
            "Disable Mouse",
        ],
    )
    pri_is(ed, "Command Palette...", 0)
    pri_is(ed, "Go to Line...", 1)
    pri_is(ed, "Toggle Wrap", 2)
    pri_is(ed, "Line Numbers: none", 2)
    pri_is(ed, "Disable Mouse", 3)
    ed.wins[w].number_style = edit.NUM_ABS
    cr_build(mut ed, edit.CTX_KIND_FOOTER, 0)
    assert(cr_has(ed, "Line Numbers: abs"), "abs")
    ed.wins[w].number_style = edit.NUM_REL
    cr_build(mut ed, edit.CTX_KIND_FOOTER, 0)
    assert(cr_has(ed, "Line Numbers: rel"), "rel")
    ed.wins[w].number_style = edit.NUM_HYBRID
    cr_build(mut ed, edit.CTX_KIND_FOOTER, 0)
    assert(cr_has(ed, "Line Numbers: hybrid"), "hybrid")
    edit.ctx_close(mut ed.ctx)
}

// ---- the transient overlays -------------------------------------------------

fn ctxrows_overlay_rows_match_the_contract() {
    var ed = cr_fixture()
    cr_build(mut ed, edit.CTX_KIND_PICK_ROW, 7)
    cr_rows_are(ed, ["Open", "Open in Split Right", "Open in Split Below", "", "Close"])
    assert(edit.ctx_target_id(ed.ctx) == 7, "the ITEM PAYLOAD is the target")
    pri_is(ed, "Open", 0)
    pri_is(ed, "Open in Split Right", 1)
    pri_is(ed, "Open in Split Below", 1)
    pri_is(ed, "Close", 0)
    cr_build(mut ed, edit.CTX_KIND_PICKER, 0)
    cr_rows_are(ed, ["Close"])
    cr_build(mut ed, edit.CTX_KIND_PANEL, 0)
    cr_rows_are(ed, ["Close"])
    cr_build(mut ed, edit.CTX_KIND_COMPL_ROW, 3)
    cr_rows_are(ed, ["Accept", "Toggle Docs", "", "Cancel"])
    assert(edit.ctx_target_id(ed.ctx) == 3, "the completion item")
    cr_build(mut ed, edit.CTX_KIND_GP_ROW, 2)
    cr_rows_are(ed, ["Toggle", "", "Confirm", "Cancel"])
    assert(edit.ctx_target_id(ed.ctx) == 2, "the LISTING INDEX")
    pri_is(ed, "Toggle", 0)
    pri_is(ed, "Confirm", 0)
    pri_is(ed, "Cancel", 0)
    cr_build(mut ed, edit.CTX_KIND_GP, 0)
    cr_rows_are(ed, ["Confirm", "Cancel"])
    edit.ctx_close(mut ed.ctx)
}

// ONE PANEL SLOT, TWO SHAPES (`:617-647`).
fn ctxrows_panel_without_a_rename_is_a_bare_close() {
    var ed = cr_fixture()
    cr_build(mut ed, edit.CTX_KIND_PANEL, 0)
    cr_rows_are(ed, ["Close"])
    let action = edit.ctx_row_action(ed.ctx, 0)
    assert(action == edit.CTXA_OVERLAY_CLOSE, "the closing row")
    assert(!edit.ctx_actions(action).has_cmd, "the one action with no command")
    assert(!cr_has(ed, "Apply"), "no Apply")
    assert(!cr_has(ed, "Show Diff"), "no Show Diff")
    edit.ctx_close(mut ed.ctx)
}

// ---- FUSS (yw13) ------------------------------------------------------------

// A FUSS case, red by name: the builder's refusal asserted (`build_fuss_*`
// refuses, the widget stays empty), C's assertions yw13's.
fn fuss_red(name: str, kind: int) -> int {
    var ed = cr_fixture()
    cr_build(mut ed, kind, 1)
    assert(edit.ctx_rows(ed.ctx) == 0, "{name}: the FUSS builder builds nothing before yw13")
    assert(ed.msg.text == edit.ctxrows_fuss_refusal(kind), "{name}: refused by name")
    say(
        "RED {name}: FUSS rows over Git fixtures and the FUSS tree (test_ctxrows.c:654-1092): sagitta Sprint 52 (yw13), R-yw06-4 = A",
    )
    1
}

// ---- the seam between a row and its command ---------------------------------

// EVERY ROW OF EVERY KIND NAMES SOMETHING THAT EXISTS (`:1094-1171`).
fn ctxrows_every_row_resolves_to_a_registry_command() -> int {
    let kinds = [
        edit.CTX_KIND_TAB,
        edit.CTX_KIND_GROUP,
        edit.CTX_KIND_STRIP,
        edit.CTX_KIND_DOC,
        edit.CTX_KIND_BORDER,
        edit.CTX_KIND_FOOTER,
        edit.CTX_KIND_FUSS_FILE,
        edit.CTX_KIND_FUSS_DIR,
        edit.CTX_KIND_FUSS_BLANK,
        edit.CTX_KIND_PICK_ROW,
        edit.CTX_KIND_PICKER,
        edit.CTX_KIND_COMPL_ROW,
        edit.CTX_KIND_PANEL,
        edit.CTX_KIND_GP_ROW,
        edit.CTX_KIND_GP,
        edit.CTX_KIND_EDITOR,
    ]
    var ed = cr_fixture()
    let gid = edit.group_create(mut ed, "/tmp", "grp")
    assert(gid != 0, "a group")
    var checked = 0
    var skips = 0
    for kind in kinds {
        if kind == edit.CTX_KIND_FUSS_FILE ||
            kind == edit.CTX_KIND_FUSS_DIR ||
            kind == edit.CTX_KIND_FUSS_BLANK {
            skips += say_skip(
                "ctxrows_every_row_resolves_to_a_registry_command: FUSS kind {kind} refuses by name before yw13 (R-yw06-4 = A, R-yw06-C1)",
            )
            continue
        }
        var id = 0
        if kind == edit.CTX_KIND_GROUP {
            id = gid
        } else if kind == edit.CTX_KIND_TAB {
            id = ed.tabs[ed.tab_active].tab_id
        }
        cr_build(mut ed, kind, id)
        let rows = edit.ctx_rows(ed.ctx)
        assert(rows != 0, "kind {kind} builds rows")
        var i = 0
        while i < rows {
            if !edit.ctx_row_is_sep(ed.ctx, i) {
                let action = edit.ctx_row_action(ed.ctx, i)
                assert(action != edit.CTXA_NONE, "kind {kind} row {i} has an action")
                assert(action < edit.CTXA_N, "kind {kind} row {i} in the table")
                let d = edit.ctx_actions(action)
                if !d.has_cmd {
                    assert(
                        d.target == edit.CTX_TGT_NONE || d.target == edit.CTX_TGT_PICK,
                        "an inline action",
                    )
                } else {
                    assert(edit.cmd_lookup(ed.reg, d.cmd) != 0, "{d.cmd} is registered")
                    checked += 1
                }
            }
            i += 1
        }
    }
    assert(checked > 40, "the walk checked {checked} rows")
    edit.ctx_close(mut ed.ctx)
    skips
}

// The whole table, arity included (`:1173-1213`).
fn ctxrows_the_action_table_is_wholly_resolvable() {
    let ed = cr_fixture()
    var a = 1
    while a < edit.CTXA_N {
        let d = edit.ctx_actions(a)
        if !d.has_cmd {
            assert(
                d.target == edit.CTX_TGT_NONE || d.target == edit.CTX_TGT_PICK,
                "action {a} inline",
            )
        } else {
            let id = edit.cmd_lookup(ed.reg, d.cmd)
            assert(id != 0, "action {a}: {d.cmd} is registered")
            let arity = edit.cmd_entry(ed.reg, id).arity
            if d.target == edit.CTX_TGT_PATH {
                assert(
                    arity == edit.ARITY_STR || arity == edit.ARITY_OPT_STR,
                    "{d.cmd} takes the path",
                )
            } else {
                assert(
                    arity != edit.ARITY_STR && arity != edit.ARITY_INT,
                    "{d.cmd} needs no argument",
                )
            }
        }
        a += 1
    }
}

// ---- port case --------------------------------------------------------------

// R-yw06-4 = A: each FUSS kind refuses by name naming yw13 and leaves the
// widget empty, so a menu over FUSS opens nothing (`ctx_show` refuses an
// empty menu).
fn port_ctxrows_fuss_kinds_refuse_by_name() {
    var ed = cr_fixture()
    for kind in [edit.CTX_KIND_FUSS_FILE, edit.CTX_KIND_FUSS_DIR, edit.CTX_KIND_FUSS_BLANK] {
        cr_build(mut ed, kind, 1)
        assert(edit.ctx_rows(ed.ctx) == 0, "kind {kind}: no rows")
        assert(
            !edit.ctx_show(mut ed.ctx, 0, 0, edit.rect(0, 0, 80, 23)),
            "kind {kind}: nothing opens",
        )
        let m = ed.msg.text
        assert(m == edit.ctxrows_fuss_refusal(kind), "kind {kind}: the refusal on the message line")
        assert(
            m.starts_with("not yet ported: ") && m.ends_with("(yw13)"),
            "kind {kind}: names yw13",
        )
    }
}

fn main() {
    fs.create_dir_all("target/tests") else |_| {}
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let chosen = (env_get("YEW_CTX_CASE") else "-1").to_int() else -1
    var ran = 0
    var skips = 0
    var reds = 0
    var n = 0
    while n < 18 {
        if chosen >= 0 && chosen != n {
            n += 1
            continue
        }
        var name = ""
        var red = 0
        if n == 0 {
            name = "ctxrows_doc_rows_match_the_contract"
            ctxrows_doc_rows_match_the_contract()
        } else if n == 1 {
            name = "ctxrows_doc_enables_follow_the_live_state"
            ctxrows_doc_enables_follow_the_live_state()
        } else if n == 2 {
            name = "ctxrows_doc_optional_sections_are_absent_not_greyed"
            skips += ctxrows_doc_optional_sections_are_absent_not_greyed()
        } else if n == 3 {
            name = "ctxrows_tab_rows_match_the_contract"
            ctxrows_tab_rows_match_the_contract()
        } else if n == 4 {
            name = "ctxrows_group_rows_match_the_contract"
            ctxrows_group_rows_match_the_contract()
        } else if n == 5 {
            name = "ctxrows_strip_and_editor_share_one_row_set"
            ctxrows_strip_and_editor_share_one_row_set()
        } else if n == 6 {
            name = "ctxrows_border_rows_need_a_second_pane"
            ctxrows_border_rows_need_a_second_pane()
        } else if n == 7 {
            name = "ctxrows_footer_names_the_current_number_style"
            ctxrows_footer_names_the_current_number_style()
        } else if n == 8 {
            name = "ctxrows_overlay_rows_match_the_contract"
            ctxrows_overlay_rows_match_the_contract()
        } else if n == 9 {
            name = "ctxrows_panel_without_a_rename_is_a_bare_close"
            ctxrows_panel_without_a_rename_is_a_bare_close()
        } else if n == 10 {
            name = "ctxrows_fuss_file_rows_follow_git_status"
            red = fuss_red(name, edit.CTX_KIND_FUSS_FILE)
        } else if n == 11 {
            name = "ctxrows_fuss_dir_rows_follow_expansion_and_subtree"
            red = fuss_red(name, edit.CTX_KIND_FUSS_DIR)
        } else if n == 12 {
            name = "ctxrows_fuss_dir_menu_acts_on_the_clicked_row"
            red = fuss_red(name, edit.CTX_KIND_FUSS_DIR)
        } else if n == 13 {
            name = "ctxrows_fuss_blank_rows_match_the_contract"
            red = fuss_red(name, edit.CTX_KIND_FUSS_BLANK)
        } else if n == 14 {
            name = "ctxrows_fuss_unknown_path_greys_the_status_rows"
            red = fuss_red(name, edit.CTX_KIND_FUSS_FILE)
        } else if n == 15 {
            name = "ctxrows_every_row_resolves_to_a_registry_command"
            skips += ctxrows_every_row_resolves_to_a_registry_command()
        } else if n == 16 {
            name = "ctxrows_the_action_table_is_wholly_resolvable"
            ctxrows_the_action_table_is_wholly_resolvable()
        } else {
            name = "port_ctxrows_fuss_kinds_refuse_by_name"
            port_ctxrows_fuss_kinds_refuse_by_name()
        }
        if red == 0 {
            print("{name}: PASS")
            ran += 1
        }
        reds += red
        n += 1
    }
    print(
        "ctxrows_test: {ran} cases pass (the port case among them), {reds} RED by name (FUSS, yw13), {skips} SKIP by name",
    )
}
