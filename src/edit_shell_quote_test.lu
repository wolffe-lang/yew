//! member: false
//!
//! The port of sagitta `tests/unit/test_shell_quote.c` (207 lines), one
//! test per C test in registry order (Sprint 19 §9 + DoD 10):
//! `edit.shell_quote` must round-trip every byte through a real
//! `/bin/sh`. C hands the shell its script as `-c` ARGV and reads stdout
//! through a pipe (`test_shell_quote.c:17-66`); a wolf argv is a `str`,
//! which cannot carry the invalid UTF-8 the random corpus holds, so the
//! port writes the script to a file and runs `/bin/sh FILE` — the same
//! parser on the same bytes — with stdout to a scratch file. It spawns
//! shells: it runs inside the container (RULES §5).

use edit
use std.fs
use std.process

const SCRATCH: str = "target/tests/shell-quote"

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

/// `sh_capture` (`test_shell_quote.c:17-66`): the script run by /bin/sh,
/// its stdout; `ok` an exit of 0.
fn sh_capture(script: List[byte]) -> (bool, List[byte]) {
    let path = "{SCRATCH}/script.sh"
    let out = "{SCRATCH}/out.bin"
    fs.write_bytes(path, script) else |_| { return (false, List[byte]()) }
    fs.remove(out) else |_| {}
    var c = process.command("/bin/sh")
    process.push_arg(mut c, path)
    let sink = fs.create(out) else |_| { return (false, List[byte]()) }
    process.set_stdout(mut c, sink)
    let ch = process.start(c) else |_| {
        fs.close(take sink) else |_| {}
        return (false, List[byte]())
    }
    let status = process.wait_status(take ch) else -1
    fs.close(take sink) else |_| {}
    let got = fs.read_bytes(out) else List[byte]()
    (status == 0, got)
}

fn sh_roundtrip(src: List[byte]) -> (bool, List[byte]) {
    var cmd = bytes_of("printf %s ")
    edit.shell_quote_into(mut cmd, src, 0, src.len)
    (mut cmd).push(10 as byte)
    sh_capture(cmd)
}

fn t_shell_quote_algorithm() {
    assert(same(edit.shell_quote(List[byte]()), bytes_of("''")), "empty")
    assert(same(edit.shell_quote(bytes_of("plain")), bytes_of("'plain'")), "plain")
    assert(
        same(edit.shell_quote(bytes_of("it's")), bytes_of("'it'\\''s'")),
        "the one interesting byte",
    )
    assert(
        same(edit.shell_quote(bytes_of("$x `y` \\z")), bytes_of("'$x `y` \\z'")),
        "nothing else escaped",
    )
}

fn t_shell_quote_roundtrips_hard_cases() {
    var cases = List[List[byte]]()
    for s in [
        "",
        "plain",
        "with space",
        "it's",
        "'",
        "''",
        "'''",
        "$HOME",
        "`whoami`",
        "back\\slash",
        "semi;colon",
        "pipe|char",
        "amp&sand",
        "new\nline",
        "tab\there",
        "quote\"double",
        "star*glob?",
        "paren(s)",
        "brace{{s}}",
        "dollar$(cmd)",
        "emoji \u{1F600} here",
        "cjk \u{65E5}\u{672C}",
        "combining e\u{301}",
        "-leading-dash",
        "--flag=value",
        "trailing space ",
        " leading space",
        "mixed '$(x)' \"y\" `z`",
    ] {
        (mut cases).push(bytes_of(s))
    }
    for c in cases {
        let (ok, got) = sh_roundtrip(c)
        assert(ok, "the shell ran")
        assert(same(got, c), "round trip of `{str_from_utf8(c) else "?"}`")
    }
}

// DoD 10: 100,000 deterministic random strings of bytes 1..255
// (`test_shell_quote.c:142-207`), 256 a script.
fn t_shell_quote_roundtrips_random_bytes() {
    var seed: wrapping[u64] = 1516337689
    var cmd = List[byte]()
    var expected = List[byte]()
    var iter = 0
    var batches = 0
    while iter < 100000 {
        let len = (seed % 33) as int
        var src = List[byte]()
        var k = 0
        while k < len {
            seed = seed * 6364136223846793005 + 1442695040888963407
            (mut src).push((1 + ((seed >> 33) % 255) as int) as byte)
            k += 1
        }
        seed = seed * 6364136223846793005 + 1442695040888963407
        for b in "printf %s ".bytes() {
            (mut cmd).push(b)
        }
        edit.shell_quote_into(mut cmd, src, 0, src.len)
        for b in "; printf '\\000'\n".bytes() {
            (mut cmd).push(b)
        }
        for b in src {
            (mut expected).push(b)
        }
        (mut expected).push(0 as byte)
        if (iter + 1) % 256 == 0 || iter + 1 == 100000 {
            let (ok, got) = sh_capture(cmd)
            assert(ok, "batch {batches}: the shell ran")
            assert(same(got, expected), "batch {batches}: byte-exact")
            cmd = List[byte]()
            expected = List[byte]()
            batches += 1
        }
        iter += 1
    }
    assert(iter == 100000, "100,000 strings")
    print("shell_quote_test: 100000 random strings in {batches} /bin/sh runs round-trip")
}

fn main() {
    fs.create_dir_all(SCRATCH) else |_| {}
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_shell_quote_algorithm()
    t_shell_quote_roundtrips_hard_cases()
    t_shell_quote_roundtrips_random_bytes()
    print("shell_quote_test: 3 cases pass")
}
