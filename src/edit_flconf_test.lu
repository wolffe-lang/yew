//! member: false
//! The twelve tests/unit/test_flconf.c cases at sagitta 9ace98c2, in
//! registry order (registry.c:18-27, then :1556-1557; Sprint 36: ordered, origin-owned configuration; the
//! two AI grant rows registry.c lists beside them are
//! test_flconf_ai_trust.c's, the AI module's). C's fixture (cf_init,
//! test_flconf.c:76-115) is a mkdtemp tree under /tmp with the runtime,
//! XDG config and state roots pointed into it; the port's is a fresh
//! /tmp/yew-flconf-PID-N tree, the same way. C's hook ledger is the
//! runtime VM's here (R-yw09-2).

use edit
use fl
use std.fs

struct ConfigFix {
    root: str,
    runtime: str,
    runtime_init: str,
    overlay: str,
    user_init: str,
    workspace: str,
    workspace_init: str,
    old_runtime: str,
    had_runtime: bool,
    old_config: str,
    had_config: bool,
    old_state: str,
    had_state: bool,
}

var fix_counter: int = 0

fn env_copy(name: str) -> (str, bool) {
    let v = env_get(name) else |_| { return ("", false) }
    (v, true)
}

fn env_restore(name: str, value: str, had: bool) {
    if had {
        env_set(name, value) else |_| { assert(false, "restore {name}") }
    } else {
        env_unset(name) else |_| {}
    }
}

fn cf_write(path: str, source: str) {
    fs.write_text(path, source) else |_| { assert(false, "config test fixture write failed: {path}") }
}

// cf_init (test_flconf.c:76-115): the tree, the environment, a scratch
// editor rooted at the workspace, and the startup policy.
fn cf_init(s: edit.Startup) -> (ConfigFix, edit.Ed) {
    var n = 0
    // # Safety: the test is one thread; the counter names fresh trees.
    unsafe {
        fix_counter += 1
        n = fix_counter
    }
    let root = "/tmp/yew-flconf-{os_pid()}-{n}"
    fs.remove_dir_all(root) else |_| {}
    let (old_runtime, had_runtime) = env_copy("YEW_RUNTIME_DIR")
    let (old_config, had_config) = env_copy("XDG_CONFIG_HOME")
    let (old_state, had_state) = env_copy("XDG_STATE_HOME")
    let f = ConfigFix {
        root: root,
        runtime: "{root}/runtime",
        runtime_init: "{root}/runtime/init.fl",
        overlay: "{root}/runtime/tutor.fl",
        user_init: "{root}/config/yew/init.fl",
        workspace: "{root}/work",
        workspace_init: "{root}/work/.yew.fl",
        old_runtime: old_runtime,
        had_runtime: had_runtime,
        old_config: old_config,
        had_config: had_config,
        old_state: old_state,
        had_state: had_state,
    }
    for d in [f.runtime, "{root}/config/yew", "{root}/state", f.workspace] {
        fs.create_dir_all(d) else |_| { assert(false, "config test fixture mkdir failed: {d}") }
    }
    cf_write(f.runtime_init, "\n")
    env_set("YEW_RUNTIME_DIR", f.runtime) else |_| { assert(false, "env") }
    env_set("XDG_CONFIG_HOME", "{root}/config") else |_| { assert(false, "env") }
    env_set("XDG_STATE_HOME", "{root}/state") else |_| { assert(false, "env") }
    var ed = edit.ed_new()
    ed.ws_dir = f.workspace
    edit.ed_open_scratch(mut ed)
    edit.config_init(mut ed, s)
    (f, ed)
}

// cf_free (test_flconf.c:117-140).
fn cf_free(f: ConfigFix) {
    env_restore("YEW_RUNTIME_DIR", f.old_runtime, f.had_runtime)
    env_restore("XDG_CONFIG_HOME", f.old_config, f.had_config)
    env_restore("XDG_STATE_HOME", f.old_state, f.had_state)
    assert(f.root.starts_with("/tmp/yew-flconf-"), "only a /tmp/yew-flconf-* tree is removed")
    fs.remove_dir_all(f.root) else |_| {}
}

fn cf_opt(ed: edit.Ed, name: str) -> edit.OptVal {
    let v = edit.opt_get(ed, edit.ed_doc(ed), ed.win, name) else {
        assert(false, "option {name}")
        edit.optv_int(0)
    }
    v
}

// cf_error_contains (test_flconf.c:151-173): the VM error's message.
fn cf_error_contains(mut ed: edit.Ed, needle: str) -> bool {
    if ed.flrt.vms.len == 0 { return false }
    let err = copy ed.flrt.vms[0].err
    if err.t != fl.FL_MAP { return false }
    let name = copy "msg".bytes()
    let key = fl.fl_str_new(mut ed.flrt.vms[0], name)
    let v = fl.fl_map_get(ed.flrt.vms[0], err, key) else { return false }
    if v.t != fl.FL_STR { return false }
    let msg = str_from_utf8(ed.flrt.vms[0].gc.slots[fl.fl_obj_index(ed.flrt.vms[0], v)].bytes) else ""
    msg.contains(needle)
}

// cf_active_ledger (test_flconf.c:175-184).
fn cf_active_ledger(ed: edit.Ed) -> int {
    var n = 0
    for r in ed.flrt.vms[0].hooks.ledger.rows { if r.active { n += 1 } }
    n
}

fn ledger_len(ed: edit.Ed) -> int { ed.flrt.vms[0].hooks.ledger.rows.len }

fn hook_len(ed: edit.Ed) -> int { ed.flrt.vms[0].hooks.rows.len }

fn int_global(mut ed: edit.Ed, name: str) -> int {
    let v = edit.config_get_global(mut ed, name) else {
        assert(false, "global {name}")
        return 0
    }
    assert(v.t == fl.FL_INT, "global {name} is an int")
    v.i
}

fn has_global(mut ed: edit.Ed, name: str) -> bool {
    let _ = edit.config_get_global(mut ed, name) else { return false }
    true
}

fn flconf_loads_builtin_user_workspace_in_precedence_order() {
    var s = edit.startup_default()
    s.trust_workspace = true
    var (f, ed) = cf_init(s)
    cf_write(f.runtime_init, "set({{tabwidth: 5}})\n")
    cf_write(f.user_init, "set({{tabwidth: 6}})\n")
    cf_write(f.workspace_init, "set({{tabwidth: 7}})\n")
    assert(edit.config_load_all(mut ed) == edit.CFG_OK)
    assert(cf_opt(ed, "tabwidth").i == 7)
    assert(ed.bufs[edit.ed_doc(ed)].tabwidth == 7)
    cf_free(f)
}

fn flconf_workspace_cannot_weaken_ai_redaction() {
    var s = edit.startup_default()
    s.trust_workspace = true
    var (f, ed) = cf_init(s)
    cf_write(f.user_init, "set({{\"ai.on_redact\": \"elide\"}})\n")
    cf_write(f.workspace_init, "set({{errorbells: true, \"ai.on_redact\": \"off\"}})\n")
    assert(edit.config_load_all(mut ed) == edit.CFG_RUN)
    let v = cf_opt(ed, "ai.on_redact")
    if edit.mod_enabled(edit.MOD_AI) {
        assert(v.s == "elide")
    } else {
        assert(v.s == "block")
    }
    assert(cf_error_contains(mut ed, "FL_ORIGIN_WORKSPACE"))
    assert(cf_error_contains(mut ed, "workspace config"))
    assert(!cf_opt(ed, "errorbells").b)
    cf_free(f)
}

fn flconf_global_accessor_reads_private_layers_in_precedence_order() {
    var s = edit.startup_default()
    s.trust_workspace = true
    var (f, ed) = cf_init(s)
    cf_write(f.runtime_init, "let shared = 1\nlet builtin_only = 2\nlet nil_value = nil\n")
    cf_write(f.user_init, "let shared = 3\nlet user_only = 4\n")
    cf_write(f.workspace_init, "let shared = 5\n")
    assert(edit.config_load_all(mut ed) == edit.CFG_OK)
    let vm_only = copy "let vm_only = 99\n".bytes()
    assert(edit.fl_runtime_eval(mut ed, vm_only) == edit.CMD_OK)
    assert(int_global(mut ed, "shared") == 5)
    assert(int_global(mut ed, "user_only") == 4)
    assert(int_global(mut ed, "builtin_only") == 2)
    let nil_value = edit.config_get_global(mut ed, "nil_value") else {
        assert(false, "nil_value is bound")
        return
    }
    assert(nil_value.t == fl.FL_NIL)
    assert(!has_global(mut ed, "missing"))
    assert(!has_global(mut ed, "vm_only"))
    cf_free(f)
}

fn flconf_global_accessor_follows_successful_reload() {
    var s = edit.startup_default()
    s.no_workspace_config = true
    var (f, ed) = cf_init(s)
    cf_write(f.runtime_init, "let setting = 1\n")
    cf_write(f.user_init, "let setting = 2\n")
    assert(edit.config_load_all(mut ed) == edit.CFG_OK)
    assert(int_global(mut ed, "setting") == 2)
    cf_write(f.user_init, "let replacement = 3\n")
    assert(edit.config_reload(mut ed) == edit.CFG_OK)
    assert(int_global(mut ed, "setting") == 1)
    assert(int_global(mut ed, "replacement") == 3)
    cf_free(f)
}

fn flconf_parse_error_isolated_to_its_source() {
    var s = edit.startup_default()
    s.trust_workspace = true
    var (f, ed) = cf_init(s)
    cf_write(f.runtime_init, "fn broken(\n")
    cf_write(f.user_init, "set({{errorbells: true}})\n")
    cf_write(f.workspace_init, "set({{\"search.ignorecase\": true}})\n")
    assert(edit.config_load_all(mut ed) == edit.CFG_PARSE)
    assert(cf_opt(ed, "errorbells").b)
    assert(cf_opt(ed, "search.ignorecase").b)
    cf_free(f)
}

fn flconf_reload_parse_error_keeps_old_binding_live() {
    var s = edit.startup_default()
    s.no_workspace_config = true
    var (f, ed) = cf_init(s)
    cf_write(f.user_init, "bind(\"L\", \"Z\", \"ed.nop\")\n")
    assert(edit.config_load_all(mut ed) == edit.CFG_OK)
    let binds = edit.bind_active_count(ed)
    let ledger = cf_active_ledger(ed)
    assert(binds == 1)
    cf_write(f.user_init, "bind(\"L\", \"Z\",\n")
    assert(edit.config_reload(mut ed) == edit.CFG_PARSE)
    assert(edit.bind_active_count(ed) == binds)
    assert(cf_active_ledger(ed) == ledger)
    let key = edit.key_parse_seq("Z", 1)
    assert(key.len == 1)
    let km = edit.bind_keys(ed, edit.MODE_L)
    let (m, _, bi) = edit.keymap_lookup(km, key, 1)
    assert(m == edit.MATCH_FULL)
    assert(ed.reg.entries[km.binds[bi].cmd - 1].name == "ed.nop")
    cf_free(f)
}

fn flconf_runtime_error_tears_down_source_and_continues() {
    var s = edit.startup_default()
    s.no_workspace_config = true
    var (f, ed) = cf_init(s)
    cf_write(f.runtime_init, "bind(\"L\", \"Z\", \"ed.nop\")\nerror(\"boom\")\n")
    cf_write(f.user_init, "set({{errorbells: true}})\n")
    assert(edit.config_load_all(mut ed) == edit.CFG_RUN)
    assert(edit.bind_active_count(ed) == 0)
    assert(cf_opt(ed, "errorbells").b)
    cf_free(f)
}

fn flconf_twenty_reloads_leave_no_registry_residue() {
    var s = edit.startup_default()
    s.no_workspace_config = true
    var (f, ed) = cf_init(s)
    cf_write(f.user_init, "bind(\"L\", \"Z\", \"ed.nop\")\non(\"ws.open\", fn(ws) set({{errorbells: true}}))\n")
    var rebuilds = edit.bind_rebuild_count(ed)
    assert(edit.config_load_all(mut ed) == edit.CFG_OK)
    assert(edit.bind_rebuild_count(ed) == rebuilds + 1)
    let ledger_n = ledger_len(ed)
    let hook_n = hook_len(ed)
    for _ in 0..100 {
        rebuilds = edit.bind_rebuild_count(ed)
        assert(edit.config_reload(mut ed) == edit.CFG_OK)
        assert(edit.bind_rebuild_count(ed) == rebuilds + 1)
        assert(ledger_len(ed) == ledger_n)
        assert(hook_len(ed) == hook_n)
        assert(cf_active_ledger(ed) == 2)
        assert(edit.bind_active_count(ed) == 1)
    }
    cf_free(f)
}

fn flconf_reloaded_hook_fires_once() {
    var s = edit.startup_default()
    s.no_workspace_config = true
    var (f, ed) = cf_init(s)
    cf_write(f.user_init, "on(\"ws.open\", fn(ws) set({{errorbells: true}}))\n")
    assert(edit.config_load_all(mut ed) == edit.CFG_OK)
    for _ in 0..20 { assert(edit.config_reload(mut ed) == edit.CFG_OK) }
    assert(edit.opt_set(mut ed, edit.OPT_GLOBAL, "errorbells", edit.optv_bool(false)).len == 0)
    let active_before = cf_active_ledger(ed)
    edit.ed_hook_workspace(mut ed, fl.FL_EV_WS_OPEN)
    assert(cf_opt(ed, "errorbells").b)
    assert(cf_active_ledger(ed) == active_before + 1)
    let ledger_n = ledger_len(ed)
    for _ in 0..20 {
        assert(edit.opt_set(mut ed, edit.OPT_GLOBAL, "errorbells", edit.optv_bool(false)).len == 0)
        edit.ed_hook_workspace(mut ed, fl.FL_EV_WS_OPEN)
        assert(cf_opt(ed, "errorbells").b)
        assert(cf_active_ledger(ed) == active_before + 1)
        assert(ledger_len(ed) == ledger_n)
    }
    assert(edit.opt_set(mut ed, edit.OPT_GLOBAL, "errorbells", edit.optv_bool(false)).len == 0)
    edit.origin_teardown(mut ed, fl.FL_ORIGIN_ID_CONFIG)
    assert(!cf_opt(ed, "errorbells").b)
    cf_free(f)
}

fn flconf_deleted_set_restores_default_on_reload() {
    var s = edit.startup_default()
    s.no_workspace_config = true
    var (f, ed) = cf_init(s)
    cf_write(f.user_init, "set({{errorbells: true}})\n")
    assert(edit.config_load_all(mut ed) == edit.CFG_OK)
    assert(cf_opt(ed, "errorbells").b)
    cf_write(f.user_init, "\n")
    assert(edit.config_reload(mut ed) == edit.CFG_OK)
    assert(!cf_opt(ed, "errorbells").b)
    cf_free(f)
}

fn flconf_clean_skips_every_fletch_config_source() {
    var s = edit.startup_default()
    s.clean = true
    s.trust_workspace = true
    var (f, ed) = cf_init(s)
    cf_write(f.runtime_init, "set({{errorbells: true}})\n")
    cf_write(f.user_init, "bind(\"L\", \"Z\", \"ed.nop\")\n")
    cf_write(f.workspace_init, "set({{tabwidth: 9}})\n")
    let rebuilds = edit.bind_rebuild_count(ed)
    assert(edit.config_load_all(mut ed) == edit.CFG_OK)
    assert(!cf_opt(ed, "errorbells").b)
    assert(cf_opt(ed, "tabwidth").i == 4)
    assert(edit.bind_active_count(ed) == 0)
    assert(cf_active_ledger(ed) == 0)
    assert(edit.bind_rebuild_count(ed) == rebuilds)
    cf_free(f)
}

fn flconf_clean_builtins_loads_only_shipped_layers() {
    var (f, ed) = cf_init(edit.startup_default())
    cf_write(f.runtime_init, "set({{errorbells: true}})\nlet builtin_value = 1\n")
    cf_write(f.overlay, "set({{tabwidth: 6}})\nlet overlay_value = 2\n")
    cf_write(f.user_init, "set({{tabwidth: 8}})\nlet hostile_user = true\n")
    cf_write(f.workspace_init, "set({{tabwidth: 9}})\nlet hostile_workspace = true\n")
    var s = edit.startup_default()
    s.clean = true
    s.clean_builtins = true
    s.builtin_overlay = f.overlay
    s.trust_workspace = true
    edit.config_init(mut ed, s)
    assert(edit.config_load_all(mut ed) == edit.CFG_OK)
    assert(cf_opt(ed, "errorbells").b)
    assert(cf_opt(ed, "tabwidth").i == 6)
    assert(int_global(mut ed, "builtin_value") == 1)
    assert(int_global(mut ed, "overlay_value") == 2)
    assert(!has_global(mut ed, "hostile_user"))
    assert(!has_global(mut ed, "hostile_workspace"))
    assert(edit.config_reload(mut ed) == edit.CFG_OK)
    assert(int_global(mut ed, "overlay_value") == 2)
    cf_free(f)
}

fn main() {
    flconf_loads_builtin_user_workspace_in_precedence_order()
    flconf_workspace_cannot_weaken_ai_redaction()
    flconf_parse_error_isolated_to_its_source()
    flconf_reload_parse_error_keeps_old_binding_live()
    flconf_runtime_error_tears_down_source_and_continues()
    flconf_twenty_reloads_leave_no_registry_residue()
    flconf_reloaded_hook_fires_once()
    flconf_deleted_set_restores_default_on_reload()
    flconf_clean_skips_every_fletch_config_source()
    flconf_clean_builtins_loads_only_shipped_layers()
    flconf_global_accessor_reads_private_layers_in_precedence_order()
    flconf_global_accessor_follows_successful_reload()
    print("edit_flconf: 12 cases pass")
}
