//! member: false
//! The port of sagitta 9ace98c2 tests/unit/test_fl_std_map.c (155 lines),
//! one function per C test under the registry's names and in its order
//! (tools/fl-cases.txt), over the flfix fixture.

use flfix

// test_fl_std_map.c:21: the two imports every case's program starts with.
fn p() -> str { "import map\nimport fmt\n" }

// test_fl_std_map.c:23-63.
fn fl_map_len_counts_live_entries() {
    var f = flfix.open()
    flfix.eq(mut f, p() + "return map.len({{}})\n", "0")
    flfix.eq(mut f, p() + "return map.len({{a: 1, b: 2}})\n", "2")
    flfix.eq(
        mut f,
        p() +
            "let m = {{a: 1, b: 2}}\nmap.remove(m, \"a\")\nmap.set(m, \"a\", 9)\nreturn map.len(m)\n",
        "2",
    )
    flfix.eq(mut f, p() + "let m = {{a: 1, b: 2}}\nmap.clear(m)\nreturn map.len(m)\n", "0")
    flfix.eq(mut f, p() + "let m = {{a: 1, b: 2, c: 3}}\nmap.clear(m)\nreturn map.len(m)\n", "0")
    flfix.eq(
        mut f,
        p() + "let m = {{a: 1, b: 2, c: 3, d: 4, e: 5}}\nmap.clear(m)\nreturn map.len(m)\n",
        "0",
    )
    flfix.eq(
        mut f,
        p() +
            "let m = {{a: 1, b: 2, c: 3}}\nmap.clear(m)\nmap.set(m, \"a\", 7)\nreturn fmt.repr(m)\n",
        "{{a: 7}}",
    )
    flfix.eq(
        mut f,
        p() + "let m = {{a: 1, b: 2, c: 3}}\nmap.clear(m)\nreturn map.has(m, \"c\")\n",
        "false",
    )
    flfix.eq(
        mut f,
        p() + "import math\nreturn map.clear(math)\n",
        "!type: map.clear: the map is frozen",
    )
    flfix.close(mut f)
}

// test_fl_std_map.c:65-94.
fn fl_map_reads_and_writes_by_key() {
    var f = flfix.open()
    flfix.eq(mut f, p() + "return map.get({{a: 1}}, \"a\")\n", "1")
    flfix.eq(mut f, p() + "return map.get({{a: 1}}, \"z\", 7)\n", "7")
    flfix.eq(mut f, p() + "return map.get({{a: 1}}, \"z\")\n", "!key: map.get: no such key")
    flfix.eq(mut f, p() + "return map.has({{a: 1}}, \"a\")\n", "true")
    flfix.eq(mut f, p() + "return map.has({{a: 1}}, \"z\")\n", "false")
    flfix.eq(mut f, p() + "let m = {{}}\nmap.set(m, \"k\", 5)\nreturn map.get(m, \"k\")\n", "5")
    flfix.eq(mut f, p() + "let m = {{a: 1}}\nreturn map.remove(m, \"a\")\n", "1")
    flfix.eq(
        mut f,
        p() + "let m = {{a: 1}}\nreturn map.remove(m, \"z\")\n",
        "!key: map.remove: no such key",
    )
    flfix.eq(
        mut f,
        p() + "return map.set({{}}, 1.5, 1)\n",
        "!key: map key must be string, int, or bool, found float",
    )
    flfix.eq(
        mut f,
        p() + "return map.get({{}}, [1])\n",
        "!key: map key must be string, int, or bool, found list",
    )
    flfix.eq(
        mut f,
        p() +
            "let m = {{}}\nmap.set(m, 7, \"i\")\nmap.set(m, true, \"b\")\n" +
            "return map.get(m, 7) + map.get(m, true)\n",
        "ib",
    )
    flfix.eq(
        mut f,
        p() + "import math\nreturn map.set(math, \"pi\", 3)\n",
        "!type: map.set: the map is frozen",
    )
    flfix.close(mut f)
}

// test_fl_std_map.c:96-126.
fn fl_map_iterates_in_insertion_order() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        p() + "return fmt.repr(map.keys({{b: 1, a: 2, c: 3}}))\n",
        "[\"b\", \"a\", \"c\"]",
    )
    flfix.eq(mut f, p() + "return fmt.repr(map.values({{b: 1, a: 2, c: 3}}))\n", "[1, 2, 3]")
    flfix.eq(
        mut f,
        p() + "return fmt.repr(map.entries({{b: 1, a: 2}}))\n",
        "[[\"b\", 1], [\"a\", 2]]",
    )
    flfix.eq(
        mut f,
        p() +
            "let m = {{a: 1, b: 2, c: 3}}\nmap.remove(m, \"a\")\nmap.set(m, \"a\", 9)\n" +
            "return fmt.repr(map.keys(m))\n",
        "[\"b\", \"c\", \"a\"]",
    )
    flfix.eq(
        mut f,
        p() + "let m = {{a: 1, b: 2}}\nmap.set(m, \"a\", 9)\nreturn fmt.repr(map.entries(m))\n",
        "[[\"a\", 9], [\"b\", 2]]",
    )
    flfix.eq(mut f, p() + "return fmt.repr(map.keys({{}}))\n", "[]")
    flfix.close(mut f)
}

// test_fl_std_map.c:128-155.
fn fl_map_merges_copies_and_freezes() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        p() + "return fmt.repr(map.merge({{a: 1, b: 2}}, {{b: 9, c: 3}}))\n",
        "{{a: 1, b: 9, c: 3}}",
    )
    flfix.eq(
        mut f,
        p() +
            "let a = {{x: 1}}\nlet m = map.merge(a, {{}})\nmap.set(m, \"x\", 2)\nreturn map.get(a, \"x\")\n",
        "1",
    )
    flfix.eq(
        mut f,
        p() +
            "let a = {{x: 1}}\nlet c = map.copy(a)\nmap.set(c, \"x\", 2)\nreturn map.get(a, \"x\")\n",
        "1",
    )
    flfix.eq(
        mut f,
        p() +
            "import math\nlet c = map.copy(math)\nmap.set(c, \"pi\", 3)\nreturn map.get(c, \"pi\")\n",
        "3",
    )
    flfix.eq(mut f, p() + "let m = {{a: 1}}\nreturn map.freeze(m) == m\n", "true")
    flfix.eq(
        mut f,
        p() + "let m = {{a: 1}}\nmap.freeze(m)\nreturn map.set(m, \"a\", 2)\n",
        "!type: map.set: the map is frozen",
    )
    flfix.close(mut f)
}

fn main() {
    fl_map_len_counts_live_entries()
    fl_map_reads_and_writes_by_key()
    fl_map_iterates_in_insertion_order()
    fl_map_merges_copies_and_freezes()
    print("PASS fl_std_map: 4 cases")
}
