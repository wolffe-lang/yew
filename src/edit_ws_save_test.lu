//! member: false
//! Ports sagitta tests/unit/test_ws_save.c:174-1189 at9ace98c2.
//! Twenty-seven registry-order cases. Fork rows signal ONLY their own child,
//! in ctr; shim child roles are native, loud named SKIPs on checked.

use std.process
use std.signal
use edit
use term
use text
use util
use ws

struct Fix { root: str, work: str, saved: str, had: bool }

fn fixture() -> Fix {
    let saved = env_get("XDG_STATE_HOME") else ""
    let had = saved.len != 0
    assert(util.mkdirs("target/ws-save-fixtures", 448))
    var root = ""
    loop {
        var suffix = ""
        for r in os_random(8) { suffix = "{suffix}{r % 10}" }
        root = "target/ws-save-fixtures/{suffix}"
        fs_create_dir_mode(root, 448) else |e| match e {
            exists => { continue },
            _ => { assert(false, "mkdir fixture: {e}") },
        }
        break
    }
    root = fs_realpath(root) else {
        assert(false)
        return Fix { root: "", work: "", saved: "", had: false }
    }
    let work = "{root}/work"
    assert(util.mkdirs(work, 448))
    env_set("XDG_STATE_HOME", "{root}/state") else { assert(false) }
    Fix { root: root, work: work, saved: saved, had: had }
}

fn remove_tree(path: str) {
    let entries = fs_read_dir(path) else { return }
    for name in entries {
        let p = "{path}/{name}"
        fs_remove(p) else |_| {
            remove_tree(p)
            fs_remove_dir(p) else { assert(false, "remove dir {p}") }
        }
    }
}

fn finish(f: Fix) {
    if f.had {
        env_set("XDG_STATE_HOME", f.saved) else { assert(false) }
    } else {
        env_unset("XDG_STATE_HOME") else { assert(false) }
    }
    remove_tree(f.root)
    fs_remove_dir(f.root) else { assert(false) }
}

fn fresh(f: Fix) -> edit.Ed {
    var ed = edit.ed_new()
    ed.ws_dir = f.work
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(24, 80)
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    ed
}

fn file(f: Fix, name: str, body: str) -> str {
    let path = "{f.work}/{name}"
    assert(text.file_write_atomic(path, body.bytes(), 384) == text.SAVE_OK)
    path
}

fn exists(path: str) -> bool { let _ = fs_stat(path) else { return false }; true }

fn content(path: str) -> str {
    let b = fs_read_bytes(path) else { return "" }
    str_from_utf8(b) else ""
}

fn key_only(mut ed: edit.Ed) {
    assert(ws.ws_key(mut ed.state.key, ed.ws_dir) && ws.ws_ensure_dir(mut ed.state.key))
}

fn lock(ed: edit.Ed, body: str) {
    assert(text.file_write_atomic(ws.ws_lock_path(ed.state.key), body.bytes(), 384) == text.SAVE_OK)
}

fn tick(mut ed: edit.Ed, ms: int) { ed.now_ms += ms; edit.ed_timers_fire(mut ed, ed.now_ms) }

fn parsed_file(path: str) -> bool {
    let b = fs_read_bytes(path) else { return false }
    let p = ws.fl_parse(b, 0, b.len)
    p.ok && ws.state_validate_v1(p.doc)
}

fn t_open_claims_the_lock() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    defer edit.state_dispose(mut ed)
    assert(
        ed.state.ready &&
            ed.state.writer &&
            ed.state.owner_pid == 0 &&
            (content(ws.ws_lock_path(ed.state.key)).trim().to_int() else 0) == os_pid(),
    )
}

fn t_dispose_releases_the_lock() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    let path = ws.ws_lock_path(ed.state.key)
    assert(exists(path))
    edit.state_dispose(mut ed)
    assert(!exists(path) && !ed.state.writer && !ed.state.ready)
    edit.state_dispose(mut ed)
    assert(!exists(path))
}

fn t_writes_a_parseable_document() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    defer edit.state_dispose(mut ed)
    assert(
        edit.state_save(mut ed) &&
            ed.state.writes == 1 &&
            !ed.state.dirty &&
            parsed_file(ws.ws_state_path(ed.state.key)),
    )
}

fn t_is_byte_identical_when_nothing_changed() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    defer edit.state_dispose(mut ed)
    let a = edit.state_emit_at(ed, 0), b = edit.state_emit_at(ed, 0)
    assert(edit.comp_bytes_eq(a, b))
}

fn t_debounce_coalesces_a_burst() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    defer edit.state_dispose(mut ed)
    ed.now_ms = 1000
    edit.state_mark_dirty(mut ed)
    assert(ed.state.dirty && ed.state.timer != 0)
    for _ in 0..9 {
        let before = ed.state.timer
        tick(mut ed, 100)
        edit.state_mark_dirty(mut ed)
        assert(ed.state.timer == before)
    }
    assert(ed.state.writes == 0)
    tick(mut ed, 1100)
    assert(ed.state.writes == 1 && !ed.state.dirty && ed.state.timer == 0)
}

fn t_idle_writes_nothing() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    defer edit.state_dispose(mut ed)
    assert(ed.state.timer == 0)
    tick(mut ed, 10000)
    assert(ed.state.writes == 0 && !exists(ws.ws_state_path(ed.state.key)))
}

fn t_rearms_after_firing() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    defer edit.state_dispose(mut ed)
    edit.state_mark_dirty(mut ed)
    tick(mut ed, 2000)
    assert(ed.state.writes == 1)
    edit.state_mark_dirty(mut ed)
    assert(ed.state.timer != 0)
    tick(mut ed, 2000)
    assert(ed.state.writes == 2)
}

fn t_close_saves_inside_the_window() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    let path = ws.ws_state_path(ed.state.key)
    edit.state_mark_dirty(mut ed)
    tick(mut ed, 50)
    assert(!exists(path))
    edit.state_close(mut ed)
    assert(exists(path) && !exists(ws.ws_lock_path(ed.state.key)))
}

fn t_close_of_a_clean_session_still_saves() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    assert(!ed.state.dirty)
    edit.state_close(mut ed)
    assert(ed.state.writes == 1)
}

fn t_close_captures_motion_after_the_timer_fired() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    let path = ws.ws_state_path(ed.state.key)
    edit.state_mark_dirty(mut ed)
    tick(mut ed, 2001)
    assert(ed.state.writes == 1 && !ed.state.dirty)
    let first = edit.state_emit_at(ed, 0)
    ed.wins[ed.win].cs.curs[0].pos = 7
    ed.wins[ed.win].cs.curs[0].anchor = 7
    ed.wins[ed.win].vp.top = 3
    let last = edit.state_emit_at(ed, 0)
    assert(!edit.comp_bytes_eq(first, last) && !ed.state.dirty)
    edit.state_close(mut ed)
    assert(
        ed.state.writes == 2 &&
            content(path).contains("pos: 7,") &&
            content(path).contains("top: 3,"),
    )
}

fn t_structural_events_mark_dirty() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    defer edit.state_dispose(mut ed)
    ed.state.dirty = false
    let ti = edit.tab_open(mut ed, "{f.work}/a.txt")
    assert(ti >= 0 && ed.state.dirty)
    ed.state.dirty = false
    edit.tab_switch(mut ed, ti)
    assert(ed.state.dirty)
    ed.state.dirty = false
    let gid = edit.group_create(mut ed, f.work, "g")
    assert(ed.state.dirty)
    ed.state.dirty = false
    edit.group_add_member(mut ed, gid, ti)
    assert(ed.state.dirty)
    ed.state.dirty = false
    assert(edit.tab_close(mut ed, ti) && ed.state.dirty)
}

fn t_cursor_motion_is_not_a_trigger() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    defer edit.state_dispose(mut ed)
    ed.state.dirty = false
    ed.wins[ed.win].cs.curs[0].pos = 0
    ed.wins[ed.win].vp.top = 0
    assert(!ed.state.dirty && ed.state.timer == 0)
}

// The live lock row uses an owned child, never host pid1. Readiness crosses a pipe.
fn holder(mut ed: edit.Ed, claim: bool) -> (int, int) ! {none} {
    let (r, w) = os_pipe() else { assert(false, "pipe creation failed"); return none }
    let (pid, h) = os_fork() else |e| {
        fs_close(r) else |_| {}
        fs_close(w) else |_| {}
        if "{e}" != "unsupported" { assert(false, "fork failed: {e}") }
        return none
    }
    if pid == 0 {
        fs_close(r) else |_| {}
        if claim { edit.state_open(mut ed); if !ed.state.writer { os_exit(3) } }
        fs_write_chunk(w, "r".bytes()) else { os_exit(3) }
        fs_close(w) else |_| {}
        loop { time_sleep_ms(1000) }
    }
    fs_close(w) else |_| {}
    let ready = fs_read_chunk(r, 1) else { assert(false); return none }
    fs_close(r) else |_| {}
    assert(ready.len == 1)
    let status = content("/proc/{pid}/status")
    for line in status.lines() {
        if line.starts_with("SigBlk:") || line.starts_with("SigIgn:") {
            print("owned child {pid} {line}")
        }
    }
    (pid, h)
}

fn reap(pid: int, h: int) {
    os_signal_send(pid, signal.kill()) else { assert(false) }
    assert((os_wait_status(h) else 0) == -9)
}

fn reap_maybe(flag: bool, pid: int, h: int) { if flag { reap(pid, h) } }

fn lock_child_case(which: int) -> bool {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    key_only(mut ed)
    let (pid, h) = holder(mut ed, which == 4) else {
        let names = "live_lock_demotes_us_to_a_reader|reader_leaves_the_owners_lock_alone|ownership_message_is_shown_once|stale_lock_is_taken_over|kill9_stale_lock_is_taken_over".
            split("|")
        print("SKIP ws_save_{names[which]}: os_fork unsupported on checked; native required")
        return false
    }
    if which == 3 || which == 4 { reap(pid, h) }
    defer reap_maybe(which < 3, pid, h)
    if which != 4 { lock(ed, "{pid}\n") }
    let path = ws.ws_lock_path(ed.state.key)
    edit.state_open(mut ed)
    if which >= 3 {
        assert(ed.state.writer && edit.state_save(mut ed) && ed.state.writes == 1)
        edit.state_dispose(mut ed)
        return true
    }
    assert(ed.state.ready && !ed.state.writer && ed.state.owner_pid == pid)
    if which == 0 {
        edit.state_mark_dirty(mut ed)
        assert(!ed.state.dirty && ed.state.timer == 0 && !edit.state_save(mut ed))
        tick(mut ed, 10000)
        assert(ed.state.writes == 0 && !exists(ws.ws_state_path(ed.state.key)))
        edit.state_close(mut ed)
        assert(!exists(ws.ws_state_path(ed.state.key)))
    } else if which == 1 {
        edit.state_close(mut ed)
        assert(exists(path))
    } else {
        assert(!ed.state.owner_told)
        for _ in 0..20 { edit.state_mark_dirty(mut ed) }
        assert(ed.state.owner_told)
        edit.state_dispose(mut ed)
    }
    true
}

fn t_live_lock_demotes_us_to_a_reader() -> bool { lock_child_case(0) }

fn t_reader_leaves_the_owners_lock_alone() -> bool { lock_child_case(1) }

fn t_ownership_message_is_shown_once() -> bool { lock_child_case(2) }

fn t_stale_lock_is_taken_over() -> bool { lock_child_case(3) }

fn t_kill9_stale_lock_is_taken_over() -> bool { lock_child_case(4) }

fn lock_text(body: str) {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    key_only(mut ed)
    lock(ed, body)
    edit.state_open(mut ed)
    assert(ed.state.writer)
    edit.state_dispose(mut ed)
}

fn t_own_pid_lock_is_reclaimed() { lock_text("{os_pid()}\n") }

fn t_unparseable_lock_is_taken_over() { lock_text("not-a-pid\n") }

fn t_empty_lock_is_taken_over() { lock_text("") }

fn t_stateless_is_a_silent_no_op() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    assert(!ed.state.ready && !ed.state.writer)
    edit.state_mark_dirty(mut ed)
    assert(
        !ed.state.dirty && ed.state.timer == 0 && !edit.state_save(mut ed) && ed.state.writes == 0,
    )
    edit.state_close(mut ed)
    edit.state_dispose(mut ed)
}

fn t_unusable_state_home_runs_stateless() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    let blocked = file(f, "blocked", "")
    env_set("XDG_STATE_HOME", blocked) else { assert(false) }
    edit.state_open(mut ed)
    assert(!ed.state.ready && !ed.state.writer)
    edit.state_mark_dirty(mut ed)
    assert(!edit.state_save(mut ed))
    edit.state_dispose(mut ed)
}

fn t_has_no_second_atomic_primitive() {
    for path in ["src/ws/workspace.lu", "src/edit/state_save.lu"] {
        let src = content(path)
        assert(
            !src.contains("fs_sync(") &&
                !src.contains("fs_sync_dir(") &&
                !src.contains("fs_rename("),
        )
    }
}

fn t_leaves_a_git_checkout_clean() -> bool {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    let init = process.run(process.from_argv(["git", "-C", f.work, "init", "-q"])) else |e| {
        if "{e}" == "unsupported" {
            print(
                "SKIP ws_save_leaves_a_git_checkout_clean: process spawn unsupported on checked; native required",
            )
            return false
        }
        assert(false, "git init {e}")
        return false
    }
    assert(init == 0)
    let path = file(f, "tracked.txt", "hello\n")
    assert((process.run(process.from_argv(["git", "-C", f.work, "add", "."])) else -1) == 0)
    assert(
        (
            process.run(
                process.from_argv(
                    [
                        "git",
                        "-C",
                        f.work,
                        "-c",
                        "user.name=state-test",
                        "-c",
                        "user.email=state-test@example.invalid",
                        "-c",
                        "commit.gpgsign=false",
                        "commit",
                        "-qm",
                        "init",
                    ],
                ),
            ) else -1
        ) ==
            0,
    )
    edit.state_open(mut ed)
    assert(edit.tab_open(mut ed, path) >= 0)
    edit.state_mark_dirty(mut ed)
    assert(edit.state_save(mut ed))
    edit.state_close(mut ed)
    assert(
        (
            process.run(
                process.from_argv(["git", "-C", f.work, "diff", "--exit-code", "HEAD"]),
            ) else -1
        ) ==
            0,
    )
    let entries = fs_read_dir(f.work) else { assert(false); return false }
    assert(entries.len == 2, "only .git and tracked.txt")
    true
}

fn t_never_writes_into_the_workspace() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    edit.state_mark_dirty(mut ed)
    edit.state_close(mut ed)
    let entries = fs_read_dir(f.work) else { assert(false); return }
    assert(entries.len == 0)
}

fn shim_case(mode: str, name: str) -> bool {
    let exe = os_exe() else ""
    if exe.len == 0 || text.path_basename(exe) == "wolf" {
        print("SKIP {name}: self-reexec native child role required (G23)")
        return false
    }
    let rc = process.run(
        process.from_argv(["python3", "-I", "tools/state-save/atomic.py", exe, mode]),
    ) else { assert(false); return false }
    assert(rc == 0)
    true
}

fn t_write_is_atomic_in_order() -> bool { shim_case("order", "ws_save_write_is_atomic_in_order") }

fn t_survives_kill9_at_every_step() -> bool {
    shim_case("kill", "ws_save_survives_kill9_at_every_step")
}

fn child(torture: bool) {
    let work = env_get("YEW_WS_TEST_WORK") else ""
    assert(work.len > 0)
    var ed = edit.ed_new()
    ed.ws_dir = work
    edit.ed_open_scratch(mut ed)
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    edit.state_open(mut ed)
    assert(ed.state.writer)
    if torture { for i in 0..12 { assert(edit.tab_open(mut ed, "{work}/f{i}.txt") >= 0) } }
    env_set("YEW_FAULT_ENABLE", "1") else { assert(false) }
    assert(edit.state_save(mut ed))
    env_set("YEW_FAULT_ENABLE", "0") else { assert(false) }
    edit.state_dispose(mut ed)
}

fn main() -> int {
    let args = env_args()
    if args.len > 0 {
        if args[0] == "--self-probe" { return 73 }
        if args[0] == "--atomic-child" { child(false); return 0 }
        if args[0] == "--torture-child" { child(true); return 0 }
        if args[0] == "--validate" && args.len == 2 { return if parsed_file(args[1]) then 0 else 1 }
    }
    let chosen = (env_get("YEW_STATE_CASE") else "-1").to_int() else -1
    if chosen < 0 || chosen == 0 {
        t_open_claims_the_lock()
        print("ws_save_open_claims_the_lock: PASS")
    }
    if chosen < 0 || chosen == 1 {
        t_dispose_releases_the_lock()
        print("ws_save_dispose_releases_the_lock: PASS")
    }
    if chosen < 0 || chosen == 2 {
        t_writes_a_parseable_document()
        print("ws_save_writes_a_parseable_document: PASS")
    }
    if chosen < 0 || chosen == 3 {
        t_is_byte_identical_when_nothing_changed()
        print("ws_save_is_byte_identical_when_nothing_changed: PASS")
    }
    if chosen < 0 || chosen == 4 {
        t_debounce_coalesces_a_burst()
        print("ws_save_debounce_coalesces_a_burst: PASS")
    }
    if chosen < 0 || chosen == 5 {
        t_idle_writes_nothing()
        print("ws_save_idle_writes_nothing: PASS")
    }
    if chosen < 0 || chosen == 6 {
        t_rearms_after_firing()
        print("ws_save_rearms_after_firing: PASS")
    }
    if chosen < 0 || chosen == 7 {
        t_close_saves_inside_the_window()
        print("ws_save_close_saves_inside_the_window: PASS")
    }
    if chosen < 0 || chosen == 8 {
        t_close_of_a_clean_session_still_saves()
        print("ws_save_close_of_a_clean_session_still_saves: PASS")
    }
    if chosen < 0 || chosen == 9 {
        t_close_captures_motion_after_the_timer_fired()
        print("ws_save_close_captures_motion_after_the_timer_fired: PASS")
    }
    if chosen < 0 || chosen == 10 {
        t_structural_events_mark_dirty()
        print("ws_save_structural_events_mark_dirty: PASS")
    }
    if chosen < 0 || chosen == 11 {
        t_cursor_motion_is_not_a_trigger()
        print("ws_save_cursor_motion_is_not_a_trigger: PASS")
    }
    if chosen < 0 || chosen == 12 {
        if t_live_lock_demotes_us_to_a_reader() {
            print("ws_save_live_lock_demotes_us_to_a_reader: PASS")
        }
    }
    if chosen < 0 || chosen == 13 {
        if t_reader_leaves_the_owners_lock_alone() {
            print("ws_save_reader_leaves_the_owners_lock_alone: PASS")
        }
    }
    if chosen < 0 || chosen == 14 {
        if t_ownership_message_is_shown_once() {
            print("ws_save_ownership_message_is_shown_once: PASS")
        }
    }
    if chosen < 0 || chosen == 15 {
        if t_stale_lock_is_taken_over() { print("ws_save_stale_lock_is_taken_over: PASS") }
    }
    if chosen < 0 || chosen == 16 {
        if t_kill9_stale_lock_is_taken_over() {
            print("ws_save_kill9_stale_lock_is_taken_over: PASS")
        }
    }
    if chosen < 0 || chosen == 17 {
        t_own_pid_lock_is_reclaimed()
        print("ws_save_own_pid_lock_is_reclaimed: PASS")
    }
    if chosen < 0 || chosen == 18 {
        t_unparseable_lock_is_taken_over()
        print("ws_save_unparseable_lock_is_taken_over: PASS")
    }
    if chosen < 0 || chosen == 19 {
        t_empty_lock_is_taken_over()
        print("ws_save_empty_lock_is_taken_over: PASS")
    }
    if chosen < 0 || chosen == 20 {
        t_stateless_is_a_silent_no_op()
        print("ws_save_stateless_is_a_silent_no_op: PASS")
    }
    if chosen < 0 || chosen == 21 {
        t_unusable_state_home_runs_stateless()
        print("ws_save_unusable_state_home_runs_stateless: PASS")
    }
    if chosen < 0 || chosen == 22 {
        t_has_no_second_atomic_primitive()
        print("ws_save_has_no_second_atomic_primitive: PASS")
    }
    if chosen < 0 || chosen == 23 {
        if t_leaves_a_git_checkout_clean() { print("ws_save_leaves_a_git_checkout_clean: PASS") }
    }
    if chosen < 0 || chosen == 24 {
        t_never_writes_into_the_workspace()
        print("ws_save_never_writes_into_the_workspace: PASS")
    }
    if chosen < 0 || chosen == 25 {
        if t_write_is_atomic_in_order() { print("ws_save_write_is_atomic_in_order: PASS") }
    }
    if chosen < 0 || chosen == 26 {
        if t_survives_kill9_at_every_step() { print("ws_save_survives_kill9_at_every_step: PASS") }
    }
    0
}
