//! syn.compiler_schema — literal schema, aliases and source diagnostics.
//! Ports sagitta src/syn/defs.c:256–736 at 9ace98c2. Data and diagnostic
//! payloads retain bytes; only known schema spellings are Unicode strings.

use fl

/// Compiled tables plus diagnostics. messages preserves the exact bounded
/// diagnostic bytes, including non-UTF-8 names; diagnostics supplies spans.
pub struct SynCompileResult {
    valid: bool,
    definition: SynDefinition,
    diagnostics: fl.DiagCtx,
    messages: List[List[byte]],
}

struct SynAliasSpec { name: int, value: int, node: int }

struct SynContextSpec {
    name: int,
    node: int,
    rules: int,
    includes: int,
    default_node: int,
    eol_node: int,
    unit_node: int,
    icase: bool,
    include_used: bool,
    pushed: bool,
    reachable: bool,
    embed_set: bool,
    embed: SynEmbed,
}

struct SynRuleRef { node: int, owner: int }

struct SynCompiler {
    data: SynData,
    definition: SynDefinition,
    aliases: List[SynAliasSpec],
    specs: List[SynContextSpec],
    messages: List[List[byte]],
    rule_nodes: List[int],
}

fn c_get(c: SynCompiler, node: int, key: str) -> int {
    syn_data_map_get(c.data, node, key) else -1
}

fn c_span(c: SynCompiler, node: int) -> fl.FlSpan {
    if node >= 0 && node < c.data.program.nodes.len { return copy c.data.program.nodes[node].sp }
    fl.FlSpan { file_id: c.data.file_id, line: 1, col: 1, len: 1 }
}

fn c_emit_bytes(mut c: SynCompiler, level: int, node: int, message: List[byte]) {
    var bounded = List[byte]()
    var i = 0
    while i < message.len && i < 511 { (mut bounded).push(message[i]); i += 1 }
    let readable = str_from_utf8(bounded) else "non-UTF-8 syntax diagnostic"
    let span = c_span(c, node)
    fl.fl_diag_emit(mut c.data.diagnostics, level, span, readable)
    (mut c.messages).push(bounded)
}

fn c_error(mut c: SynCompiler, node: int, message: str) {
    c_emit_bytes(mut c, fl.FL_DIAG_ERROR, node, message.bytes())
}

fn c_warning(mut c: SynCompiler, node: int, message: str) {
    c_emit_bytes(mut c, fl.FL_DIAG_WARNING, node, message.bytes())
}

fn c_named(mut c: SynCompiler, level: int, node: int, before: str, name_id: int, after: str) {
    if name_id <= 0 || name_id >= c.data.strings.items.len {
        syn_bug("syntax: diagnostic string id out of range")
    }
    var message = model_bytes(before)
    // C's precision-bounded %s still terminates at an embedded NUL.
    var i = 0
    while i < c.data.strings.items[name_id].len && c.data.strings.items[name_id][i] as int != 0 {
        (mut message).push(c.data.strings.items[name_id][i])
        i += 1
    }
    for b in after.bytes() { (mut message).push(b) }
    c_emit_bytes(mut c, level, node, message)
}

fn c_string(mut c: SynCompiler, node: int, what: str) -> int {
    syn_data_string_id(c.data, node) else {
        c_error(mut c, node, "{what} must be a string")
        return 0
    }
}

fn c_int(mut c: SynCompiler, node: int, what: str) -> int {
    syn_data_integer(c.data, node) else {
        c_error(mut c, node, "{what} must be an integer")
        return 0
    }
}

fn c_bool(mut c: SynCompiler, node: int, what: str) -> bool {
    syn_data_boolean(c.data, node) else {
        c_error(mut c, node, "{what} must be a boolean")
        return false
    }
}

fn c_map(mut c: SynCompiler, node: int, what: str) -> bool {
    if syn_data_is(c.data, node, fl.FL_A_MAP) { return true }
    c_error(mut c, node, "{what} must be a map")
    false
}

fn c_key(c: SynCompiler, map_node: int, index: int) -> int {
    c.data.program.edges[c.data.program.nodes[map_node].a + index]
}

fn c_value(c: SynCompiler, map_node: int, index: int) -> int {
    c.data.program.edges[c.data.program.nodes[map_node].b + index]
}

fn c_item(c: SynCompiler, list_node: int, index: int) -> int {
    c.data.program.edges[c.data.program.nodes[list_node].a + index]
}

fn c_bytes_is(bytes: List[byte], word: str) -> bool {
    if bytes.len != word.len { return false }
    var i = 0
    while i < bytes.len { if bytes[i] != word.bytes()[i] { return false }; i += 1 }
    true
}

fn c_bytes_equal(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    var i = 0
    while i < a.len { if a[i] != b[i] { return false }; i += 1 }
    true
}

fn c_has_nul(bytes: List[byte]) -> bool {
    for b in bytes { if b as int == 0 { return true } }
    false
}

fn c_distance(a: List[byte], b: str) -> int {
    if a.len >= 96 || b.len >= 96 { return 4294967295 }
    var row = List[int]()
    var next = List[int]()
    var j = 0
    while j <= b.len {
        (mut row).push(j)
        (mut next).push(0)
        j += 1
    }
    var i = 0
    while i < a.len {
        next[0] = i + 1
        j = 0
        while j < b.len {
            let sub = row[j] + (if a[i] == b.bytes()[j] then 0 else 1)
            let del = row[j + 1] + 1
            let ins = next[j] + 1
            var best = if sub < del then sub else del
            if ins < best { best = ins }
            next[j + 1] = best
            j += 1
        }
        j = 0
        while j <= b.len { row[j] = next[j]; j += 1 }
        i += 1
    }
    row[b.len]
}

fn c_suggest(bytes: List[byte], words: str) -> str {
    var best = ""
    var distance = 3
    for word in words.words() {
        let d = c_distance(bytes, word)
        if d < distance { best = word; distance = d }
    }
    best
}

fn c_keys(mut c: SynCompiler, node: int, known: str) {
    if !syn_data_is(c.data, node, fl.FL_A_MAP) { return }
    var i = 0
    while i < c.data.program.nodes[node].c {
        let kn = c_key(c, node, i)
        let id = syn_data_string_id(c.data, kn) else 0
        if id == 0 {
            c_error(mut c, kn, "map key must be a string or name")
            i += 1
            continue
        }
        var found = false
        for name in known.words() {
            if c_bytes_is(c.data.strings.items[id], name) { found = true; break }
        }
        if !found {
            if c_bytes_is(c.data.strings.items[id], "embed") {
                c_error(mut c, kn, "'embed' is only valid on a rule")
            } else {
                let maybe = c_suggest(c.data.strings.items[id], known)
                let suffix = if maybe.len == 0 then "'" else "' (did you mean '{maybe}'?)"
                c_named(mut c, fl.FL_DIAG_ERROR, kn, "unknown key '", id, suffix)
            }
        }
        i += 1
    }
}

fn c_builtin_attr(bytes: List[byte]) -> int {
    var i = 0
    for name in syn_attr_names().words() { if c_bytes_is(bytes, name) { return i }; i += 1 }
    -1
}

fn c_attr(mut c: SynCompiler, node: int) -> int {
    var id = c_string(mut c, node, "attr")
    if id == 0 { return 0 }
    var i = 0
    while i < c.aliases.len {
        if c_bytes_equal(c.data.strings.items[c.aliases[i].name], c.data.strings.items[id]) {
            id = c.aliases[i].value
            break
        }
        i += 1
    }
    let attr = c_builtin_attr(c.data.strings.items[id])
    if attr >= 0 { return attr }
    let maybe = c_suggest(c.data.strings.items[id], syn_attr_names())
    let suffix = if maybe.len == 0 then "'" else "' (did you mean '{maybe}'?)"
    c_named(mut c, fl.FL_DIAG_ERROR, node, "unknown attr '", id, suffix)
    0
}

fn c_aliases(mut c: SynCompiler, node: int) {
    if node < 0 || !c_map(mut c, node, "attrs") { return }
    var i = 0
    while i < c.data.program.nodes[node].c {
        let kn = c_key(c, node, i)
        let vn = c_value(c, node, i)
        let key = c_string(mut c, kn, "attr alias name")
        let value = c_string(mut c, vn, "attr alias value")
        if key != 0 && value != 0 {
            var duplicate = false
            var j = 0
            while j < c.aliases.len {
                if c_bytes_equal(
                    c.data.strings.items[key],
                    c.data.strings.items[c.aliases[j].name],
                ) {
                    duplicate = true
                    break
                }
                j += 1
            }
            if duplicate {
                c_named(mut c, fl.FL_DIAG_ERROR, kn, "duplicate attr alias '", key, "'")
            } else {
                (mut c.aliases).push(SynAliasSpec { name: key, value: value, node: vn })
            }
        }
        i += 1
    }
    i = 0
    while i < c.aliases.len {
        let id = c.aliases[i].value
        if c_builtin_attr(c.data.strings.items[id]) < 0 {
            let at = c.aliases[i].node
            c_named(mut c, fl.FL_DIAG_ERROR, at, "unknown attr '", id, "'")
        }
        i += 1
    }
}

fn c_string_list(mut c: SynCompiler, node: int, what: str) -> List[List[byte]] {
    var out = List[List[byte]]()
    if node < 0 { return out }
    if !syn_data_is(c.data, node, fl.FL_A_LIST) {
        c_error(mut c, node, "{what} must be a list")
        return out
    }
    var i = 0
    while i < c.data.program.nodes[node].b {
        let item = c_item(c, node, i)
        let id = c_string(mut c, item, what)
        if id != 0 {
            if c_has_nul(c.data.strings.items[id]) {
                c_error(mut c, item, "{what} entries may not contain NUL")
            } else {
                (mut out).push(copy c.data.strings.items[id])
            }
        }
        i += 1
    }
    out
}

fn c_cstring_is(bytes: List[byte], text: str) -> bool {
    var n = 0
    while n < bytes.len && bytes[n] as int != 0 { n += 1 }
    if n != text.len { return false }
    var i = 0
    while i < n { if bytes[i] != text.bytes()[i] { return false }; i += 1 }
    true
}

fn c_language(mut c: SynCompiler, node: int) {
    if !c_map(mut c, node, "language") { return }
    c_keys(mut c, node, "name extensions filenames shebangs first_line priority comment")
    let name = c_get(c, node, "name")
    if name < 0 {
        c_error(mut c, node, "language.name is required")
    } else {
        let id = c_string(mut c, name, "language.name")
        if id != 0 {
            var unsafe_name = c.data.strings.items[id].len == 0 ||
                c_cstring_is(c.data.strings.items[id], ".") ||
                c_cstring_is(c.data.strings.items[id], "..")
            var i = 0
            while i < c.data.strings.items[id].len && c.data.strings.items[id][i] as int != 0 {
                if c.data.strings.items[id][i] as int == 47 { unsafe_name = true }
                i += 1
            }
            if unsafe_name {
                c_error(mut c, name, "language.name must be a non-empty cache-safe name")
            } else {
                c.definition.language.name = copy c.data.strings.items[id]
                c.definition.name = copy c.data.strings.items[id]
            }
        }
    }
    c.definition.language.extensions = c_string_list(
        mut c,
        c_get(c, node, "extensions"),
        "language.extensions",
    )
    c.definition.language.filenames = c_string_list(
        mut c,
        c_get(c, node, "filenames"),
        "language.filenames",
    )
    c.definition.language.shebangs = c_string_list(
        mut c,
        c_get(c, node, "shebangs"),
        "language.shebangs",
    )
    let first = c_get(c, node, "first_line")
    if first >= 0 {
        let id = c_string(mut c, first, "language.first_line")
        if id != 0 {
            c.definition.language.first_line = copy c.data.strings.items[id]
            c.definition.language.has_first_line = true
        }
    }
    let priority = c_get(c, node, "priority")
    if priority >= 0 {
        let value = c_int(mut c, priority, "language.priority")
        if value < -2147483648 || value > 2147483647 {
            c_error(mut c, priority, "language.priority is out of range")
        } else {
            c.definition.language.priority = value
        }
    }
    let comment = c_get(c, node, "comment")
    if comment >= 0 && c_map(mut c, comment, "language.comment") {
        c_keys(mut c, comment, "line block")
        let line = c_get(c, comment, "line")
        if line >= 0 {
            let id = c_string(mut c, line, "comment.line")
            if id != 0 { c.definition.language.comment_line = copy c.data.strings.items[id] }
        }
        let block = c_get(c, comment, "block")
        if block >= 0 {
            if !syn_data_is(c.data, block, fl.FL_A_LIST) || c.data.program.nodes[block].b != 2 {
                c_error(mut c, block, "comment.block must be a two-string list")
            } else {
                let open = c_string(mut c, c_item(c, block, 0), "comment block opener")
                let close = c_string(mut c, c_item(c, block, 1), "comment block closer")
                if open != 0 {
                    c.definition.language.comment_open = copy c.data.strings.items[open]
                }
                if close != 0 {
                    c.definition.language.comment_close = copy c.data.strings.items[close]
                }
            }
        }
    }
}

fn c_ctx_index(c: SynCompiler, name: List[byte]) -> int {
    var i = 0
    while i < c.specs.len {
        if c_bytes_equal(c.data.strings.items[c.specs[i].name], name) { return i }
        i += 1
    }
    -1
}

fn c_contexts(mut c: SynCompiler, node: int) {
    if !c_map(mut c, node, "contexts") { return }
    let count = c.data.program.nodes[node].c
    if count == 0 { c_error(mut c, node, "contexts must not be empty"); return }
    if count > 4096 { c_error(mut c, node, "too many contexts (max 4096)"); return }
    var i = 0
    while i < count {
        let kn = c_key(c, node, i)
        let vn = c_value(c, node, i)
        let id = c_string(mut c, kn, "context name")
        if id != 0 && c_map(mut c, vn, "context") {
            if c_ctx_index(c, c.data.strings.items[id]) >= 0 {
                c_named(mut c, fl.FL_DIAG_ERROR, kn, "duplicate context '", id, "'")
                i += 1
                continue
            }
            c_keys(mut c, vn, "rules default at_eol icase unit include")
            let icase_node = c_get(c, vn, "icase")
            let icase = if icase_node < 0 then false else c_bool(mut c, icase_node, "context icase")
            let rules = c_get(c, vn, "rules")
            if rules >= 0 && !syn_data_is(c.data, rules, fl.FL_A_LIST) {
                c_error(mut c, rules, "rules must be a list")
            }
            (mut c.specs).push(SynContextSpec {
                name: id,
                node: vn,
                rules: rules,
                includes: c_get(c, vn, "include"),
                default_node: c_get(c, vn, "default"),
                eol_node: c_get(c, vn, "at_eol"),
                unit_node: c_get(c, vn, "unit"),
                icase: icase,
                include_used: false,
                pushed: false,
                reachable: false,
                embed_set: false,
                embed: syn_embed_none(),
            })
            (mut c.definition.context_names).push(copy c.data.strings.items[id])
        }
        i += 1
    }
}

/// Render a diagnostic using the shared source/caret layout while retaining
/// the byte-exact message even when a quoted source name is not UTF-8.
pub fn syn_compile_diagnostic_render(mut out: List[byte], result: SynCompileResult, index: int) {
    if index < 0 || index >= result.diagnostics.entries.len || index >= result.messages.len {
        syn_bug("syntax: diagnostic index out of range")
    }
    var skeleton = List[byte]()
    let level = result.diagnostics.entries[index].level
    let span = copy result.diagnostics.entries[index].sp
    fl.fl_diag_render(mut skeleton, result.diagnostics, level, span, "")
    var split = 0
    while split < skeleton.len && skeleton[split] as int != 10 { split += 1 }
    var i = 0
    while i < split { (mut out).push(skeleton[i]); i += 1 }
    for b in result.messages[index] { (mut out).push(b) }
    while i < skeleton.len { (mut out).push(skeleton[i]); i += 1 }
}
