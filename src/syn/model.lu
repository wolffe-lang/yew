//! syn.model — data-driven compiled contexts/rules and definition metadata.
//! Ports sagitta src/syn/{engine.h,defs.h} at 9ace98c2. Regexes are the
//! already ported search engine's programs. No language-specific tokens or
//! terminal styles are compiled into these types.

use fl
use search

/// Leave the qualified context stack unchanged.
pub const SYN_OP_STAY: int = 0

/// Push a context in the active definition.
pub const SYN_OP_PUSH: int = 1

/// Pay refused-push debt or pop frames without removing root.
pub const SYN_OP_POP: int = 2

/// Replace the top context while keeping its qualification.
pub const SYN_OP_SET: int = 3

/// Enter a guest through the qualified-engine dispatcher.
pub const SYN_OP_EMBED: int = 4

/// Use the compiled regex rather than an aux matcher.
pub const SYN_AUXM_NONE: int = 0

/// The whole line equals the retained delimiter (TAB stripping optional).
pub const SYN_AUXM_LINE_EQ: int = 1

/// Match literal prefix, retained delimiter and literal suffix.
pub const SYN_AUXM_LITERAL: int = 2

/// Match a compatible Markdown closing fence at physical line start.
pub const SYN_AUXM_FENCE_CLOSE: int = 3

/// Zero-width nonblank dedent against the retained integer indentation.
pub const SYN_AUXM_INDENT_LT: int = 4

/// Zero-width match of an empty physical line.
pub const SYN_AUXM_LINE_EMPTY: int = 5

/// Zero-width match at physical line start.
pub const SYN_AUXM_LINE_START: int = 6

/// Whole-line delimiter equality after leading spaces and TABs.
pub const SYN_AUXM_LINE_EQ_WS: int = 7

/// No stateful value predicate.
pub const SYN_VALUE_ANY: int = 0

/// Match only while the stateful value bit is clear.
pub const SYN_VALUE_CLEAR: int = 1

/// Match only while the stateful value bit is set.
pub const SYN_VALUE_SET: int = 2

/// Store a capture in the active definition-level aux slot.
pub const SYN_RULE_SET_AUX: int = 1

/// Set the line-local value bit after matching.
pub const SYN_RULE_SET_VALUE: int = 2

/// Clear the line-local value bit after matching.
pub const SYN_RULE_CLR_VALUE: int = 4

/// Trim capture whitespace and enable TAB-stripped delimiter matching.
pub const SYN_RULE_STRIP: int = 8

/// Allow a bounded nonconsuming state transition at line start.
pub const SYN_RULE_ZERO_TRANSITION: int = 16

/// Interpret the aux capture as a decimal or indentation integer.
pub const SYN_RULE_AUX_INT: int = 32

/// Clear aux only when an operation actually pops a frame.
pub const SYN_RULE_CLR_AUX: int = 64

/// Enable this rule only before the first physical line was consumed.
pub const SYN_RULE_FIRST_LINE: int = 128

/// Context contributes a structural enclosing span.
pub const SYN_CTX_UNIT_SPAN: int = 1

/// Context contributes a structural atom.
pub const SYN_CTX_UNIT_ATOM: int = 2

/// Context supplies a host boundary around a guest definition.
pub const SYN_CTX_EMBED_BRIDGE: int = 4

/// No guest selector.
pub const SYN_EMBED_LANG_NONE: int = 0

/// Guest language name is an interned literal.
pub const SYN_EMBED_LANG_LITERAL: int = 1

/// Guest language name comes from a capture.
pub const SYN_EMBED_LANG_CAPTURE: int = 2

/// Guest is another level of the current definition.
pub const SYN_EMBED_LANG_SELF: int = 3

/// No guest boundary policy.
pub const SYN_EMBED_END_NONE: int = 0

/// Line-delimited host boundary.
pub const SYN_EMBED_END_LINE: int = 1

/// Inline host boundary regardless of the guest root context.
pub const SYN_EMBED_END_INLINE: int = 2

/// Inline host boundary only at the guest root context.
pub const SYN_EMBED_END_INLINE_ROOT: int = 3

/// Line boundary respecting a trailing continuation.
pub const SYN_EMBED_END_LINE_CONTINUATION: int = 4

/// Activate the guest on the next physical line.
pub const SYN_EMBED_DEFER: int = 1

/// Match at most 64 KiB of one physical line before honest degradation.
pub const SYN_LINE_BYTE_CAP: int = 65536

/// Selector and host boundary policy for a declarative embed site.
pub struct SynEmbed {
    lang: int,
    ctx: int,
    lang_kind: int,
    lang_group: int,
    end_kind: int,
    fallback: int,
    flags: int,
}

/// An empty selector with plain-text fallback and no boundary.
pub fn syn_embed_none() -> SynEmbed {
    SynEmbed { lang: 0, ctx: 0, lang_kind: 0, lang_group: 0, end_kind: 0, fallback: 0, flags: 0 }
}

/// All matching/state information is compiled from data, not callbacks.
pub struct SynRule {
    regex: int,
    attr: int,
    op: int,
    nop: int,
    aux_match: int,
    target: int,
    consume: int,
    flags: int,
    value_pred: int,
    aux_add: int,
    aux_add_group: int,
    caps: List[byte],
    aux_group: int,
    end_boundary: bool,
    aux_pre: int,
    aux_post: int,
    pushes: List[int],
    first: List[byte],
    embed: SynEmbed,
}

/// Every regex-less rule must name an aux matcher before use. A default
/// first-byte mask accepts everything until compiler analysis narrows it.
pub fn syn_rule_new(regex: int, attr: int) -> SynRule {
    var caps = List[byte]()
    var i = 0
    while i < 8 {
        (mut caps).push(255 as byte)
        i += 1
    }
    SynRule {
        regex: regex,
        attr: attr,
        op: SYN_OP_STAY,
        nop: 0,
        aux_match: SYN_AUXM_NONE,
        target: 0,
        consume: 0,
        flags: 0,
        value_pred: SYN_VALUE_ANY,
        aux_add: 0,
        aux_add_group: 0,
        caps: caps,
        aux_group: 0,
        end_boundary: false,
        aux_pre: 0,
        aux_post: 0,
        pushes: List[int](),
        first: syn_first_new(true),
        embed: syn_embed_none(),
    }
}

/// A flat rule range and end-of-line transition.
pub struct SynContext {
    first_rule: int,
    nrules: int,
    default_attr: int,
    eol_op: int,
    eol_nop: int,
    eol_target: int,
    flags: int,
    first: List[byte],
    embed: SynEmbed,
}

/// An empty ordered rule range with the given semantic default.
pub fn syn_context_new(default_attr: int) -> SynContext {
    SynContext {
        first_rule: 0,
        nrules: 0,
        default_attr: default_attr,
        eol_op: SYN_OP_STAY,
        eol_nop: 0,
        eol_target: 0,
        flags: 0,
        first: syn_first_new(false),
        embed: syn_embed_none(),
    }
}

/// Detection metadata is independent of compiled patterns and their cache.
pub struct SynLanguage {
    id: int,
    name: List[byte],
    source: str,
    extensions: List[List[byte]],
    filenames: List[List[byte]],
    shebangs: List[List[byte]],
    first_line: List[byte],
    priority: int,
    comment_line: List[byte],
    comment_open: List[byte],
    comment_close: List[byte],
}

/// Empty detection metadata for a named definition; no assigned registry id.
pub fn syn_language_new(name: str) -> SynLanguage {
    SynLanguage {
        id: 0,
        name: model_bytes(name),
        source: "",
        extensions: List[List[byte]](),
        filenames: List[List[byte]](),
        shebangs: List[List[byte]](),
        first_line: List[byte](),
        priority: 0,
        comment_line: List[byte](),
        comment_open: List[byte](),
        comment_close: List[byte](),
    }
}

/// Compiled ordered tables. regexes[0] is the null-pattern placeholder;
/// real patterns start at one. strings preserves arbitrary bytes in aux,
/// including NUL/non-UTF-8, without a string conversion in the matcher.
pub struct SynDefinition {
    name: List[byte],
    root: int,
    contexts: List[SynContext],
    rules: List[SynRule],
    regexes: List[search.Re],
    strings: fl.FlStrings,
    context_names: List[List[byte]],
    patterns: List[List[byte]],
    language: SynLanguage,
}

/// Empty owned tables, aux interner and reserved null-pattern slot.
pub fn syn_definition_new(name: str) -> SynDefinition {
    var regexes = List[search.Re]()
    (mut regexes).push(search.re_empty())
    SynDefinition {
        name: model_bytes(name),
        root: 0,
        contexts: List[SynContext](),
        rules: List[SynRule](),
        regexes: regexes,
        strings: fl.fl_strings(),
        context_names: List[List[byte]](),
        patterns: List[List[byte]](),
        language: syn_language_new(name),
    }
}

/// Exactly 256 first-byte bits. A broad mask is safe; a false negative is not.
pub fn syn_first_new(all: bool) -> List[byte] {
    var first = List[byte]()
    var i = 0
    while i < 32 {
        (mut first).push((if all then 255 else 0) as byte)
        i += 1
    }
    first
}

/// Test one byte in an exact 32-byte mask; invalid shapes are internal errors.
pub fn syn_first_has(first: List[byte], value: int) -> bool {
    if first.len != 32 || value < 0 || value > 255 {
        syn_bug("syntax: invalid first-byte mask")
    }
    first[value >> 3] as int & 1 << (value & 7) != 0
}

/// Add one byte to a 32-byte mask; invalid shapes are internal errors.
pub fn syn_first_add(mut first: List[byte], value: int) {
    if first.len != 32 || value < 0 || value > 255 {
        syn_bug("syntax: invalid first-byte addition")
    }
    let at = value >> 3
    first[at] = (first[at] as int | 1 << (value & 7)) as byte
}

/// Union conservative masks without removing any possible first byte.
pub fn syn_first_union(mut first: List[byte], other: List[byte]) {
    if first.len != 32 || other.len != 32 {
        syn_bug("syntax: invalid first-byte union")
    }
    var i = 0
    while i < 32 {
        first[i] = (first[i] as int | other[i] as int) as byte
        i += 1
    }
}

// Materialize at an ownership boundary, never in the matching loop.
fn model_bytes(text: str) -> List[byte] {
    var bytes = List[byte]()
    for b in text.bytes() { (mut bytes).push(b) }
    bytes
}
