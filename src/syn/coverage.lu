//! syn.coverage — optional per-definition hit counters for `syn check
//! --coverage` and the coverage unit rows.
//! Ports sagitta src/syn/engine.c:2284–2382 at 9ace98c2 (SynCoverage,
//! coverage_context/rule/embed/frame/transition). Counting is off unless
//! a table is attached, and an explicit trace (a stack probe) never counts.

/// One definition's counters: contexts entered, rules matched and embed
/// bridges opened, indexed as the program's tables are.
pub struct SynCoverage {
    program: int,
    contexts: List[int],
    rules: List[int],
    embeds: List[int],
}

fn zeros(n: int) -> List[int] {
    var out = List[int]()
    for _ in 0..n { (mut out).push(0) }
    out
}

/// yew_syn_coverage_init: zeroed counters sized to a pooled program.
pub fn syn_coverage_new(pool: SynPool, program: int) -> SynCoverage {
    if program < 0 || program >= pool.programs.len {
        syn_bug("syntax: coverage for an unknown program")
    }
    SynCoverage {
        program: program,
        contexts: zeros(pool.programs[program].contexts.len),
        rules: zeros(pool.programs[program].rules.len),
        embeds: zeros(pool.programs[program].contexts.len),
    }
}

/// yew_syn_coverage_clear: every counter back to zero.
pub fn syn_coverage_clear(mut coverage: SynCoverage) {
    for i in 0..coverage.contexts.len { coverage.contexts[i] = 0 }
    for i in 0..coverage.rules.len { coverage.rules[i] = 0 }
    for i in 0..coverage.embeds.len { coverage.embeds[i] = 0 }
}

/// yew_syn_engine_set_coverage: attach a program's table, replacing any
/// earlier one for that program. A table sized for another definition is
/// an internal error, as in C.
pub fn syn_engine_set_coverage(mut engine: SynEngine, pool: SynPool, take coverage: SynCoverage) {
    let program = coverage.program
    if program < 0 ||
        program >= pool.programs.len ||
        coverage.contexts.len != pool.programs[program].contexts.len ||
        coverage.rules.len != pool.programs[program].rules.len {
        syn_bug("syntax: coverage table does not match definition")
    }
    let at = syn_engine_coverage_at(engine, program)
    if at >= 0 {
        engine.coverage[at] = coverage
    } else {
        (mut engine.coverage).push(coverage)
    }
}

/// Detach every table (C's set_coverage(engine, NULL)).
pub fn syn_engine_clear_coverage(mut engine: SynEngine) {
    engine.coverage = List[SynCoverage]()
}

/// The attached table for a program, or -1.
pub fn syn_engine_coverage_at(engine: SynEngine, program: int) -> int {
    for i in 0..engine.coverage.len {
        if engine.coverage[i].program == program then return i
    }
    -1
}

fn cov_context(mut engine: SynEngine, program: int, ctx: int) {
    let at = syn_engine_coverage_at(engine, program)
    if at >= 0 && ctx >= 0 && ctx < engine.coverage[at].contexts.len {
        engine.coverage[at].contexts[ctx] += 1
    }
}

fn cov_rule(mut engine: SynEngine, program: int, rule: int) {
    let at = syn_engine_coverage_at(engine, program)
    if at >= 0 && rule >= 0 && rule < engine.coverage[at].rules.len {
        engine.coverage[at].rules[rule] += 1
    }
}

fn cov_embed(mut engine: SynEngine, program: int, ctx: int) {
    let at = syn_engine_coverage_at(engine, program)
    if at >= 0 && ctx >= 0 && ctx < engine.coverage[at].embeds.len {
        engine.coverage[at].embeds[ctx] += 1
    }
}

// coverage_frame: a frame's context, counted against its own definition.
fn cov_frame(mut engine: SynEngine, depth: int) {
    let slot = syn_state_def(engine.state, depth)
    if slot < 0 || slot >= engine.residents.len then return
    cov_context(mut engine, engine.residents[slot], syn_state_ctx(engine.state, depth))
}

// coverage_transition from engine.before to engine.state: every newly
// pushed frame, or the new top when the stack shrank or the top changed.
fn cov_transition(mut engine: SynEngine) {
    let before = syn_state_depth(engine.before)
    let after = syn_state_depth(engine.state)
    if after == 0 then return
    if after > before {
        for i in before..after { cov_frame(mut engine, i) }
    } else if after != before ||
        syn_state_ctx(engine.state, after - 1) != syn_state_ctx(engine.before, before - 1) ||
        syn_state_def(engine.state, after - 1) != syn_state_def(engine.before, before - 1) {
        cov_frame(mut engine, after - 1)
    }
}
