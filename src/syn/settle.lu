//! syn.settle — budgeted propagation over real TextBuf lines.
//! Ports sagitta engine.c:5143–5376 at 9ace98c2. Loading a guest remains
//! an owner/registry operation; only already-loaded programs install here.

use text
use util

/// Work, timing and damage of one propagation slice. lines counts actual
/// syn_line calls, not byte spans or an estimate of work.
pub struct SynSettleReport {
    lines: int,
    us: int,
    fixpoint: bool,
    hit_view: bool,
    provisional: bool,
    damage_lo: int,
    damage_hi: int,
}

/// Install a queued guest outside matching, then rewind its opener without
/// raising an earlier edit wave. The old tail cannot prove a fixpoint until
/// it has been recomputed with the now-resident definition.
pub fn syn_buffer_install_guest(
    mut buffer: SynBuffer,
    mut engine: SynEngine,
    pool: SynPool,
    program: int,
) -> bool {
    if program < 0 || program >= pool.programs.len { return false }
    let language = pool.programs[program].language.id
    var index = -1
    var i = 0
    while i < buffer.pending_langs.len {
        if buffer.pending_langs[i] == language { index = i; break }
        i += 1
    }
    if index < 0 || !syn_engine_install(mut engine, pool, program) { return false }
    let line = buffer.pending_lines[index]
    i = index + 1
    while i < buffer.pending_langs.len {
        buffer.pending_langs[i - 1] = buffer.pending_langs[i]
        buffer.pending_lines[i - 1] = buffer.pending_lines[i]
        i += 1
    }
    let _ = (mut buffer.pending_langs).pop() else 0
    let _ = (mut buffer.pending_lines).pop() else 0
    let count = syn_ids_len(buffer.lines.entry)
    if line < count {
        i = (line + 1) * 4
        while i < buffer.lines.entry.bytes.len { buffer.lines.entry.bytes[i] = 0 as byte; i += 1 }
        if buffer.lines.wave > line { buffer.lines.wave = line }
        if buffer.lines.settled_to > line + 1 { buffer.lines.settled_to = line + 1 }
        buffer.lines.must_reach = count
        buffer.lines.settling = true
        buffer.lines.spec_valid = false
        buffer_cache_invalidate(mut buffer.cache)
    }
    true
}

// syn_settle_embed_line's warning: an embed selected a language that is
// not available, so the bridge's fallback styles it. Once per buffer.
fn settle_unknown_warning(buffer: SynBuffer, engine: SynEngine, pool: SynPool) {
    var message = List[byte]()
    for b in "syntax embed language '".bytes() { (mut message).push(b) }
    if engine.unknown_program >= 0 {
        let name_len = pool.aux[engine.unknown_program].items[engine.unknown_literal].len
        let shown = if name_len > 120 then 120 else name_len
        for i in 0..shown {
            (mut message).push(pool.aux[engine.unknown_program].items[engine.unknown_literal][i])
        }
    } else {
        let shown = if engine.unknown_len > 120 then 120 else engine.unknown_len
        for i in 0..shown { (mut message).push(buffer.line_bytes[engine.unknown_start + i]) }
    }
    for b in "' is unavailable; using fallback".bytes() { (mut message).push(b) }
    util.log_at_bytes(util.LOG_WARN, message)
}

/// `yew_syn_embed_pump`: with at least the 2,000-us guest load budget,
/// install the head queued guest once its owner has pooled the program,
/// then replay from its opener (syn_buffer_install_guest). Loading and
/// compiling a definition is the owner's I/O, done before this call.
pub fn syn_embed_pump(
    mut buffer: SynBuffer,
    mut engine: SynEngine,
    pool: SynPool,
    budget_us: int,
) -> bool {
    if budget_us < 2000 ||
        buffer.pending_langs.len == 0 ||
        engine.residents.len >= SYN_RESIDENT_MAX {
        return false
    }
    let program = pool_for_language(pool, buffer.pending_langs[0])
    if program < 0 then return false
    syn_buffer_install_guest(mut buffer, mut engine, pool, program)
}

/// The queued guest language an owner should load next, or 0 for none.
pub fn syn_embed_wanted(buffer: SynBuffer) -> int {
    if buffer.pending_langs.len == 0 then return 0
    buffer.pending_langs[0]
}

fn status_name(name: List[byte]) -> str {
    let s = str_from_utf8(copy name) else { return "?" }
    s
}

/// `yew_syn_status`: the settling badge's report line, naming the root and
/// active definitions, the qualified depth, the degraded mark and any
/// queued or refused guest.
pub fn syn_buffer_status(
    buffer: SynBuffer,
    engine: SynEngine,
    pool: SynPool,
    line_count: int,
) -> str {
    let count = syn_ids_len(buffer.lines.entry)
    var at = buffer.lines.wave
    if at >= count { at = if count == 0 then 0 else count - 1 }
    let root_name = status_name(pool.programs[engine.residents[0]].name)
    var active_name = "none"
    var ndefs = 0
    var depth = 0
    var active = syn_state_root(0, 0)
    if count != 0 &&
        syn_state_read(mut active, engine.states, syn_ids_get(buffer.lines.entry, at)) {
        depth = syn_state_depth(active)
        ndefs = syn_state_ndef(active)
        let slot = syn_state_def(active, depth - 1)
        if slot < engine.residents.len {
            active_name = status_name(pool.programs[engine.residents[slot]].name)
        }
    }
    var refused_name = "none"
    if buffer.refused_lang != 0 {
        for i in 0..engine.known_ids.len {
            if engine.known_ids[i] == buffer.refused_lang {
                refused_name = status_name(engine.known_names[i])
                break
            }
        }
    }
    let degraded = if buffer.degraded then "yes" else "no"
    let states = syn_state_count(engine.states)
    "settled {buffer.lines.settled_to}/{line_count}, wave {buffer.lines.wave}, root={root_name} active={active_name} defs={ndefs}/{SYN_DEF_MAX} depth={depth}/{SYN_DEPTH_MAX} states={states} degraded={degraded} embed_pending={buffer.pending_langs.len} embed_refused={refused_name}"
}

/// Spend at most a line-granular budget, retaining a wave across calls.
/// budget_us <= 0 runs to a verified fixpoint. Real clocks observe every
/// four lines with 64-us headroom; injected clocks preserve C's 256-line
/// observation quantum. A single line has its own byte/span/attempt caps.
pub fn syn_settle(
    mut buffer: SynBuffer,
    mut engine: SynEngine,
    mut pool: SynPool,
    tb: text.TextBuf,
    view_lo: int,
    view_hi: int,
    budget_us: int,
) -> SynSettleReport {
    var report = SynSettleReport {
        lines: 0,
        us: 0,
        fixpoint: false,
        hit_view: false,
        provisional: false,
        damage_lo: 9223372036854775807,
        damage_hi: 0,
    }
    let started = buffer_now(mut buffer)
    let quantum = if buffer.fake_clock then 256 else 4
    var deadline = budget_us
    if !buffer.fake_clock && deadline > 64 { deadline -= 64 }
    buffer_reconcile(mut buffer, engine, tb)
    if budget_us >= 4000 { let _ = syn_embed_pump(mut buffer, mut engine, pool, 2000) }
    let count = syn_ids_len(buffer.lines.entry)
    if !buffer.enabled || count == 0 {
        buffer.lines.settling = false
        buffer.lines.wave = count
        buffer.lines.settled_to = count
        report.fixpoint = true
        report.damage_lo = 0
        report.damage_hi = 0
        return report
    }
    if buffer.lines.wave >= count { buffer.lines.wave = count - 1 }
    buffer.lines.settling = true
    var elapsed: int = 0
    while buffer.lines.wave < count {
        let line = buffer.lines.wave
        let entry = syn_lines_next_entry(buffer.lines)
        let len = buffer_line(mut buffer, tb, line)
        syn_line(mut engine, mut pool, entry, buffer.line_bytes, len, mut buffer.scratch, false)
        let _ = buffer_cache_store(mut buffer.cache, line, tb.gen, entry, buffer.scratch)
        report.lines += 1
        buffer_note_stop(mut buffer, engine, buffer.scratch.stop)
        if engine.pending_lang != 0 { buffer_pending_add(mut buffer, engine.pending_lang, line) }
        if engine.refused_lang != 0 {
            buffer.refused_lang = engine.refused_lang
            buffer.degraded = true
        }
        if !buffer.embed_unknown_logged &&
            (engine.unknown_start >= 0 || engine.unknown_program >= 0) {
            settle_unknown_warning(buffer, engine, pool)
            buffer.embed_unknown_logged = true
        }
        if report.damage_lo == 9223372036854775807 { report.damage_lo = line }
        report.damage_hi = line + 1
        if line >= view_lo && line < view_hi { report.hit_view = true }
        let corrections = buffer.lines.provisional_corrections
        let finished = syn_lines_accept(mut buffer.lines, buffer.scratch.exit_state)
        if buffer.lines.provisional_corrections != corrections { report.provisional = true }
        if finished { report.fixpoint = true; break }
        if line + 1 >= view_lo && line + 1 < view_hi {
            report.hit_view = true
            report.damage_hi = line + 2
        }
        if line & quantum - 1 == 0 && budget_us > 0 { elapsed = buffer_now(mut buffer) - started }
        if elapsed >= deadline && budget_us > 0 {
            if buffer.lines.wave < view_lo {
                buffer.lines.spec_from = view_lo
                buffer.lines.spec_valid = true
                report.provisional = true
            }
            break
        }
    }
    if report.fixpoint { elapsed = buffer_now(mut buffer) - started }
    report.us = if elapsed > 0 then elapsed else 0
    if report.damage_lo == 9223372036854775807 { report.damage_lo = 0; report.damage_hi = 0 }
    buffer.gen = tb.gen
    report
}

/// The settling badge is delayed by 250 ms and degraded highlighting is
/// sticky. This reads the same monotonic clock as the propagation budget.
pub fn syn_buffer_status_visible(mut buffer: SynBuffer) -> bool {
    buffer.enabled &&
        (
            buffer.degraded ||
                buffer.lines.settling && buffer_now(mut buffer) - buffer.edit_us >= 250000
        )
}
