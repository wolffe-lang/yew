//! syn.pool — shared compiled programs and separately mutable aux storage.
//! Ports the definition/resident ownership boundary of sagitta engine.c
//! and registry.c at 9ace98c2. Programs are never copied per line/token.
use fl

/// Process-owner storage. programs have their seed interner moved into aux;
/// use the explicit-aux matcher for pooled programs. Indices remain stable
/// while engines retain them. Loading/discovery is outside this pure core.
pub struct SynPool {
    programs: List[SynDefinition],
    aux: List[fl.FlStrings],
    known_ids: List[int],
    known_names: List[List[byte]],
}

/// Empty explicit storage, with no global registry or ambient I/O.
pub fn syn_pool_new() -> SynPool {
    SynPool {
        programs: List[SynDefinition](), aux: List[fl.FlStrings](),
        known_ids: List[int](), known_names: List[List[byte]](),
    }
}

/// Register detection metadata before constructing an engine's name
/// snapshot. C-string name identity ends at NUL; syntax data retains bytes.
pub fn syn_pool_name(mut pool: SynPool, language: int, name: List[byte]) {
    if language <= 0 || language > 4294967295 { syn_bug("syntax: invalid language id") }
    var normalized = List[byte]()
    var i = 0
    while i < name.len && name[i] as int != 0 { (mut normalized).push(name[i]); i += 1 }
    i = 0
    while i < pool.known_ids.len {
        if pool.known_ids[i] == language { pool.known_names[i] = normalized; return }
        i += 1
    }
    (mut pool.known_ids).push(language)
    (mut pool.known_names).push(normalized)
}

/// Take one compiled definition without duplicating regex programs or aux
/// strings. The mutable aux owner is a different pool field from programs,
/// permitting exclusive interning while rules remain read-only.
pub fn syn_pool_add(mut pool: SynPool, take definition: SynDefinition, language: int) -> int {
    if language <= 0 || language > 4294967295 { syn_bug("syntax: invalid pooled language id") }
    var program = definition
    program.language.id = language
    let aux = program.strings
    program.strings = fl.fl_strings()
    let index = pool.programs.len
    (mut pool.programs).push(program)
    (mut pool.aux).push(aux)
    // Metadata copying happens at installation, never during matching.
    let name = copy pool.programs[index].name
    syn_pool_name(mut pool, language, name)
    index
}

fn pool_for_language(pool: SynPool, language: int) -> int {
    var i = pool.programs.len
    while i > 0 {
        i -= 1
        if pool.programs[i].language.id == language { return i }
    }
    -1
}
