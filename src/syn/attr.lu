//! syn.attr — semantic ids, never colors.
//! Ports sagitta src/syn/attr.h, defs.c:235–254 and theme.c:61–120
//! at 9ace98c2. The numeric vocabulary is closed and already understood
//! by edit.theme; the editor adapter will consume these same ids.

/// The semantic vocabulary is closed at 54 entries.
pub const SYN_ATTR_COUNT: int = 54
/// Unmatched and degraded bytes use the plain-text semantic slot.
pub const SYN_ATTR_TEXT: int = 0

/// Names in numeric id order (attr.h).
pub fn syn_attr_names() -> str {
    "text keyword keyword.control keyword.op keyword.storage type type.builtin constant constant.builtin number boolean character string string.escape string.interp string.special comment comment.doc comment.todo function function.builtin function.macro method variable variable.builtin variable.param variable.member namespace label attribute preproc operator punct punct.bracket punct.delim tag tag.attr heading link emphasis strong code list quote diff.add diff.del error warning whitespace.special motion.unit motion.arrow motion.count motion.cmd ui.invisible"
}

/// Resolve a data-file attribute name; an unknown name is a diagnostic row.
pub fn syn_attr_id(name: str) -> int ! {none} {
    var i = 0
    for n in syn_attr_names().words() {
        if n == name {
            return i
        }
        i += 1
    }
    none
}

/// The stable dump/diagnostic name of an id.
pub fn syn_attr_name(attr: int) -> str ! {none} {
    var i = 0
    for name in syn_attr_names().words() {
        if i == attr {
            return name
        }
        i += 1
    }
    none
}

/// Theme-load inheritance, never a per-cell chain walk.
pub fn syn_attr_parent(attr: int) -> int {
    match attr {
        2 => 1,
        3 => 1,
        4 => 1,
        6 => 5,
        8 => 7,
        9 => 7,
        10 => 7,
        11 => 12,
        13 => 12,
        14 => 12,
        15 => 12,
        17 => 16,
        18 => 16,
        20 => 19,
        21 => 19,
        22 => 19,
        24 => 23,
        25 => 23,
        26 => 23,
        33 => 32,
        34 => 32,
        36 => 35,
        49 => 1,
        50 => 31,
        51 => 9,
        52 => 19,
        _ => SYN_ATTR_TEXT,
    }
}
