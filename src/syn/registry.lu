//! syn.registry — the builtin language table and lazy definition slots.
//! Ports sagitta src/syn/registry.c (the builtin registry and its
//! load-once slots) and the lookups of src/syn/defs.c:2054–2159
//! (`yew_syn_lang_desc`, `yew_syn_lang_named`, `yew_syn_lang_by_name`,
//! `yew_syn_lang_count`) at 9ace98c2. The table is the generated
//! `SYN_BUILTINS`; reading a definition file is the caller's I/O, so this
//! owner holds no global state and never touches the filesystem.

use search

/// The builtin languages in table order, and each one's load slot. A slot
/// is tried at most once per registry (C's BuiltinDef.tried); `programs`
/// holds the pool index of the loaded definition, or -1. A first-line
/// pattern compiles lazily, once (`first_res` indexes `first_compiled`).
pub struct SynRegistry {
    ids: List[int],
    names: List[List[byte]],
    sources: List[str],
    priorities: List[int],
    first_lines: List[List[byte]],
    first_res: List[int],
    first_compiled: List[search.Re],
    tried: List[bool],
    programs: List[int],
    compiles: int,
}

fn registry_field(text: List[byte], lo: int, hi: int) -> List[byte] {
    var out = List[byte]()
    for i in lo..hi { (mut out).push(text[i]) }
    out
}

fn registry_int(text: List[byte], lo: int, hi: int) -> int {
    var n: int = 0
    var negative = false
    var at = lo
    if at < hi && text[at] as int == 45 {
        negative = true
        at += 1
    }
    if at >= hi then syn_bug("syntax: malformed builtin registry number")
    while at < hi {
        let d = text[at] as int - 48
        if d < 0 || d > 9 then syn_bug("syntax: malformed builtin registry number")
        n = n * 10 + d
        at += 1
    }
    if negative then -n else n
}

fn registry_line_end(text: List[byte], at: int) -> int {
    var end = at
    while end < text.len && text[end] as int != 10 { end += 1 }
    end
}

/// `yew_syn_builtin_registry_build` over a seed table: `rows` holds one
/// `ID NAME PRIORITY SOURCE` line per language (the `SYN_BUILTINS` shape)
/// and `first_lines` one `PATTERN<TAB>ID` line per first-line detector
/// (the `SYN_DETECT_FIRST_LINES` shape). A malformed row is a build defect.
pub fn syn_registry_build(rows: str, first_lines: str) -> SynRegistry {
    var reg = SynRegistry {
        ids: List[int](),
        names: List[List[byte]](),
        sources: List[str](),
        priorities: List[int](),
        first_lines: List[List[byte]](),
        first_res: List[int](),
        first_compiled: List[search.Re](),
        tried: List[bool](),
        programs: List[int](),
        compiles: 0,
    }
    let text = model_bytes(rows)
    var at = 0
    while at < text.len {
        let end = registry_line_end(text, at)
        var cuts = List[int]()
        for i in at..end {
            if text[i] as int == 32 then (mut cuts).push(i)
        }
        if cuts.len != 3 then syn_bug("syntax: malformed builtin registry row")
        (mut reg.ids).push(registry_int(text, at, cuts[0]))
        (mut reg.names).push(registry_field(text, cuts[0] + 1, cuts[1]))
        (mut reg.priorities).push(registry_int(text, cuts[1] + 1, cuts[2]))
        (mut reg.sources).push(buf_str(registry_field(text, cuts[2] + 1, end)))
        (mut reg.first_lines).push(List[byte]())
        (mut reg.first_res).push(-1)
        (mut reg.tried).push(false)
        (mut reg.programs).push(-1)
        at = end + 1
    }
    let detectors = model_bytes(first_lines)
    at = 0
    while at < detectors.len {
        let end = registry_line_end(detectors, at)
        var tab = end
        while tab > at && detectors[tab - 1] as int != 9 { tab -= 1 }
        if tab <= at then syn_bug("syntax: malformed first-line detector row")
        let ordinal = syn_registry_ordinal(reg, registry_int(detectors, tab, end))
        if ordinal < 0 then syn_bug("syntax: first-line detector names no builtin")
        reg.first_lines[ordinal] = registry_field(detectors, at, tab - 1)
        at = end + 1
    }
    reg
}

/// The generated 48-language registry.
pub fn syn_registry_new() -> SynRegistry {
    syn_registry_build(SYN_BUILTINS, SYN_DETECT_FIRST_LINES)
}

fn buf_str(bytes: List[byte]) -> str {
    let s = str_from_utf8(bytes) else {
        syn_bug("syntax: builtin registry source is not UTF-8")
        return ""
    }
    s
}

/// `yew_syn_lang_count` over the builtins.
pub fn syn_registry_count(reg: SynRegistry) -> int {
    reg.ids.len
}

/// The ordinal of a builtin language id, or -1.
pub fn syn_registry_ordinal(reg: SynRegistry, language: int) -> int {
    for i in 0..reg.ids.len {
        if reg.ids[i] == language then return i
    }
    -1
}

/// `yew_syn_lang_by_name`: an exact byte comparison, no case folding.
pub fn syn_registry_lang_by_name(reg: SynRegistry, name: List[byte], lo: int, hi: int) -> int {
    for i in 0..reg.names.len {
        if reg.names[i].len == hi - lo {
            var same = true
            for j in 0..reg.names[i].len {
                if reg.names[i][j] != name[lo + j] {
                    same = false
                    break
                }
            }
            if same then return reg.ids[i]
        }
    }
    0
}

/// `yew_syn_lang_named` for a whole name; 0 is YEW_LANG_NONE.
pub fn syn_registry_lang_named(reg: SynRegistry, name: List[byte]) -> int {
    syn_registry_lang_by_name(reg, name, 0, name.len)
}

/// A builtin's name; empty for an unknown id.
pub fn syn_registry_name(reg: SynRegistry, language: int) -> List[byte] {
    let i = syn_registry_ordinal(reg, language)
    if i < 0 then return List[byte]()
    copy reg.names[i]
}

/// A builtin's repository-relative source (`runtime/syntax/NAME.fl`).
pub fn syn_registry_source(reg: SynRegistry, language: int) -> str {
    let i = syn_registry_ordinal(reg, language)
    if i < 0 then return ""
    reg.sources[i]
}

/// The builtin name whose repository-relative source is exactly `path`
/// (the first pass of `builtin_language_for_source`), or empty.
pub fn syn_registry_name_for_source(reg: SynRegistry, path: str) -> List[byte] {
    for i in 0..reg.sources.len {
        if reg.sources[i] == path then return copy reg.names[i]
    }
    List[byte]()
}

/// Seed a pool's name snapshot with every builtin, in id order, before any
/// engine is built (C's engine snapshot of `yew_syn_lang_snapshot`).
pub fn syn_registry_seed(reg: SynRegistry, mut pool: SynPool) {
    for i in 0..reg.ids.len {
        syn_pool_name(mut pool, reg.ids[i], copy reg.names[i])
    }
}

/// Whether a builtin's slot was already tried.
pub fn syn_registry_tried(reg: SynRegistry, language: int) -> bool {
    let i = syn_registry_ordinal(reg, language)
    i >= 0 && reg.tried[i]
}

/// The pooled program of a loaded builtin, or -1.
pub fn syn_registry_program(reg: SynRegistry, language: int) -> int {
    let i = syn_registry_ordinal(reg, language)
    if i < 0 then return -1
    reg.programs[i]
}

/// Mark a builtin's slot tried without a definition (its source could not
/// be read): the load is never retried, as C's slot is not.
pub fn syn_registry_refuse(mut reg: SynRegistry, language: int) {
    let i = syn_registry_ordinal(reg, language)
    if i >= 0 then reg.tried[i] = true
}

/// Compile a builtin's source once and pool it (`yew_syn_builtin_registry_load`
/// with `load_builtin_definition`). A definition whose language name is not
/// the builtin's is refused, as `yew_syn_def_load` refuses it. Answers the
/// pooled program or -1; diagnostics stay with the caller's result.
pub fn syn_registry_load(
    mut reg: SynRegistry,
    mut pool: SynPool,
    language: int,
    path: str,
    source: List[byte],
) -> int {
    let i = syn_registry_ordinal(reg, language)
    if i < 0 then return -1
    if reg.tried[i] then return reg.programs[i]
    reg.tried[i] = true
    reg.compiles += 1
    var result = syn_compile(path, source)
    if !result.valid then return -1
    if result.definition.name.len != reg.names[i].len then return -1
    for j in 0..reg.names[i].len {
        if result.definition.name[j] != reg.names[i][j] then return -1
    }
    let program = syn_pool_add(mut pool, take result.definition, language)
    reg.programs[i] = program
    program
}

/// `yew_syn_builtin_registry_first_line`: an ordinal's first-line pattern,
/// compiled on first use and kept. Answers an index into `first_compiled`,
/// or -1 when the language has no pattern or it does not compile.
pub fn syn_registry_first_line(mut reg: SynRegistry, ordinal: int) -> int {
    if ordinal < 0 || ordinal >= reg.ids.len || reg.first_lines[ordinal].len == 0 then return -1
    if reg.first_res[ordinal] >= 0 then return reg.first_res[ordinal]
    var err = search.re_err_new()
    let re = search.re_compile(copy reg.first_lines[ordinal], 0, mut err) else {
        return -1
    }
    if err.msg.len != 0 then return -1
    reg.first_res[ordinal] = reg.first_compiled.len
    (mut reg.first_compiled).push(re)
    reg.first_res[ordinal]
}
