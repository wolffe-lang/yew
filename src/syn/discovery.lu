//! syn.discovery — user syntax definitions from the config directory.
//! Ports sagitta src/syn/defs.c:1877–2041 (`discover_user_definitions`,
//! `yew_syn_discovery_reset`, `yew_syn_discovery_set_bypass`) at 9ace98c2.
//! This file is the one place in syn that reads the filesystem: it lists
//! CONFIG/syntax, reads each `*.fl` there in bytewise name order, compiles
//! it and registers it. C discovers lazily inside every lookup; here the
//! owner calls `syn_registry_discover` once before lookups, which keeps
//! every other registry function free of I/O. C's log warnings are kept in
//! `warnings` for the owner to log.

use util

/// C's `yew_syn_discovery_set_bypass` (`yew --clean`): later discovery
/// registers nothing.
pub fn syn_registry_set_discovery_bypass(mut reg: SynRegistry, bypass: bool) {
    reg.discovery_bypass = bypass
}

/// `yew_syn_discovery_reset`: retire every discovered language and allow
/// the next `syn_registry_discover` to scan again. Pooled programs stay,
/// so an engine that installed a discovered guest keeps it.
pub fn syn_registry_discovery_reset(mut reg: SynRegistry) {
    for u in 0..reg.users.len {
        if reg.user_discovered[u] {
            reg.user_retired[u] = true
        }
    }
    reg.discovery_done = false
}

fn discovery_name_less(a: List[byte], b: List[byte]) -> bool {
    let n = if a.len < b.len then a.len else b.len
    for i in 0..n {
        if a[i] != b[i] then return a[i] as int < b[i] as int
    }
    a.len < b.len
}

fn discovery_filename(name: List[byte]) -> bool {
    let n = name.len
    n > 3 && name[n - 3] as int == 46 && name[n - 2] as int == 102 && name[n - 1] as int == 108
}

fn discovered_name_exists(reg: SynRegistry, name: List[byte]) -> bool {
    for u in 0..reg.users.len {
        if reg.user_discovered[u] && !reg.user_retired[u] && same_name(reg.users[u].name, name) {
            return true
        }
    }
    false
}

fn builtin_name_exists(reg: SynRegistry, name: List[byte]) -> bool {
    for i in 0..reg.names.len {
        if same_name(reg.names[i], name) then return true
    }
    false
}

/// `discover_user_definitions`: once per reset, unless bypassed, scan
/// `config/syntax` (config is the yew config directory, empty for none).
/// An absent directory is silent; an invalid file, a duplicate name and a
/// builtin's name are skipped with a warning each. Every definition read
/// counts as a compile.
pub fn syn_registry_discover(mut reg: SynRegistry, mut pool: SynPool, config: str) {
    if reg.discovery_done then return
    reg.discovery_done = true
    if reg.discovery_bypass || config.len == 0 then return
    let dir = "{config}/syntax"
    let entries = fs_read_dir_entries(dir) else {
        let _ = fs_stat(dir) else {
            let e = os_error()
            if e != 0 && e != 2 {
                (mut reg.warnings).push("cannot scan syntax definitions: {dir}")
            }
            return
        }
        (mut reg.warnings).push("cannot scan syntax definitions: {dir}")
        return
    }
    var names = List[List[byte]]()
    for entry in entries {
        // Byte 0 of an entry is its kind; the name follows.
        if entry.len > 1 {
            let name = entry[1..entry.len]
            if discovery_filename(name) {
                (mut names).push(name)
            }
        }
    }
    util.sort_stable(mut names, discovery_name_less)
    for name in names {
        let text = str_from_utf8(copy name) else {
            (mut reg.warnings).push("ignoring invalid syntax definition: {dir}/<non-UTF-8 name>")
            continue
        }
        let path = "{dir}/{text}"
        let source = fs_read_bytes(path) else {
            (mut reg.warnings).push("ignoring invalid syntax definition: {path}")
            continue
        }
        reg.compiles += 1
        var result = syn_compile(path, source)
        if !result.valid {
            (mut reg.warnings).push("ignoring invalid syntax definition: {path}")
            continue
        }
        if builtin_name_exists(reg, result.definition.name) ||
            discovered_name_exists(reg, result.definition.name) {
            let shown = str_from_utf8(copy result.definition.name) else "<bytes>"
            (mut reg.warnings).push("ignoring duplicate syntax language '{shown}': {path}")
            continue
        }
        let _ = syn_registry_register(mut reg, mut pool, take result.definition, path)
        reg.user_discovered[reg.user_discovered.len - 1] = true
    }
}
