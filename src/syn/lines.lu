//! syn.lines — the retained entry-state wave, independent of matching.
//!
//! Ports sagitta src/syn/engine.c:4942–4988 and :5214–5366 at 9ace98c2.
//! The matcher feeds one computed exit id to syn_lines_accept. This small
//! state machine owns tail retention and the must_reach frontier, so the
//! budgeted caller can pause between any two lines without losing an edit.
//! No clock, filesystem, colors or text decoding lives here.

/// Per-buffer retained entry ids and the propagation frontier.
pub struct SynLines {
    entry: SynIds,
    settled_to: int,
    wave: int,
    must_reach: int,
    settling: bool,
    spec_valid: bool,
    spec_from: int,
    splice_count: int,
    accepted_lines: int,
    provisional_corrections: int,
}

/// Begin with ROOT entering line zero; all other entries are UNKNOWN.
pub fn syn_lines_new(count: int) -> SynLines {
    if count < 0 {
        syn_bug("syntax: negative line count")
    }
    var entry = syn_ids_new()
    var i = 0
    while i < count {
        syn_ids_push(mut entry, if i == 0 then SYN_STATE_ROOT else SYN_STATE_UNKNOWN)
        i += 1
    }
    SynLines {
        entry: entry,
        settled_to: if count > 0 then 1 else 0,
        wave: 0,
        must_reach: 0,
        settling: count > 0,
        spec_valid: false,
        spec_from: 0,
        splice_count: 0,
        accepted_lines: 0,
        provisional_corrections: 0,
    }
}

/// Splice exactly at lo+1. The state entering the edited line is proven,
/// and the retained tail is the evidence that later permits a fixpoint.
/// removed/inserted are newline counts, not a net line-count difference.
pub fn syn_lines_edit(mut lines: SynLines, lo: int, removed: int, inserted: int) {
    let n = syn_ids_len(lines.entry)
    if lo < 0 || lo >= n || removed < 0 || inserted < 0 {
        syn_bug("syntax: edit line count exceeds state array")
    }
    let at = lo + 1
    if removed > n - at {
        syn_bug("syntax: edit splice outside state array")
    }
    var frontier = lines.must_reach
    if lines.settling && frontier < lines.wave + 1 {
        frontier = lines.wave + 1
    }
    if frontier > at {
        if frontier <= at + removed {
            frontier = at + inserted
        } else {
            frontier = frontier - removed + inserted
        }
    }
    syn_ids_splice(mut lines.entry, at, removed, inserted)
    let count = syn_ids_len(lines.entry)
    if count != 0 {
        syn_ids_set(mut lines.entry, 0, SYN_STATE_ROOT)
    }
    if lines.settled_to > lo + 1 {
        lines.settled_to = lo + 1
    }
    if lines.wave > lo {
        lines.wave = lo
    }
    lines.settling = true
    lines.spec_valid = false
    if frontier < at + inserted {
        frontier = at + inserted
    }
    if frontier > count {
        frontier = count
    }
    lines.must_reach = frontier
    lines.splice_count += 1
}

/// Entry for the next line evaluation. UNKNOWN is styled provisionally
/// from ROOT; it can never prove a fixpoint against another UNKNOWN.
pub fn syn_lines_next_entry(lines: SynLines) -> int {
    if !lines.settling || lines.wave < 0 || lines.wave >= syn_ids_len(lines.entry) {
        syn_bug("syntax: no propagation line to evaluate")
    }
    let held = syn_ids_get(lines.entry, lines.wave)
    if held == SYN_STATE_UNKNOWN then SYN_STATE_ROOT else held
}

fn lines_finished(mut lines: SynLines) {
    let count = syn_ids_len(lines.entry)
    lines.wave = count
    lines.settled_to = count
    lines.must_reach = 0
    lines.settling = false
    lines.spec_valid = false
}

/// Commit one evaluated line. True means a verified fixpoint/end-of-file;
/// false leaves wave at the next line, ready for this or a later budget.
pub fn syn_lines_accept(mut lines: SynLines, exit_state: int) -> bool {
    let count = syn_ids_len(lines.entry)
    let at = lines.wave
    if !lines.settling ||
        at < 0 ||
        at >= count ||
        exit_state <= SYN_STATE_UNKNOWN ||
        exit_state >= SYN_MAX_STATES {
        syn_bug("syntax: invalid evaluated line")
    }
    lines.accepted_lines += 1
    if at + 1 >= count {
        lines_finished(mut lines)
        return true
    }
    let held = syn_ids_get(lines.entry, at + 1)
    if held != SYN_STATE_UNKNOWN && held == exit_state && at + 1 >= count {
        if lines.spec_valid && at + 1 >= lines.spec_from {
            lines.provisional_corrections += 1
        }
        lines_finished(mut lines)
        return true
    }
    syn_ids_set(mut lines.entry, at + 1, exit_state)
    if lines.spec_valid && at + 1 >= lines.spec_from {
        lines.provisional_corrections += 1
        lines.spec_valid = false
    }
    lines.settled_to = at + 2
    lines.wave = at + 1
    false
}
