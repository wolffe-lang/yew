//! syn.ids — packed four-byte ids and their single-pass edit splice.
//!
//! Ports SynU32Vec/vec_splice (sagitta src/syn/engine.c:4657–4694 at
//! 9ace98c2). Packing explicitly keeps a million line entries at 4 MiB,
//! independent of wolf's native int stride. This module knows no colors.

/// A packed little-endian u32 vector. Zero is the UNKNOWN entry id.
pub struct SynIds {
    bytes: List[byte],
}

/// An empty retained-entry vector.
pub fn syn_ids_new() -> SynIds {
    SynIds { bytes: List[byte]() }
}

/// Number of ids, not bytes.
pub fn syn_ids_len(ids: SynIds) -> int {
    ids.bytes.len / 4
}

/// Observable storage payload, excluding the vector header/capacity.
pub fn syn_ids_bytes(ids: SynIds) -> int {
    ids.bytes.len
}

/// Read a retained id.
pub fn syn_ids_get(ids: SynIds, at: int) -> int {
    if at < 0 || at >= syn_ids_len(ids) {
        syn_bug("syntax: id index out of range")
    }
    let p = at * 4
    ids.bytes[p] as int |
        ids.bytes[p + 1] as int << 8 |
        ids.bytes[p + 2] as int << 16 |
        ids.bytes[p + 3] as int << 24
}

/// Replace an existing id without resizing.
pub fn syn_ids_set(mut ids: SynIds, at: int, value: int) {
    if at < 0 || at >= syn_ids_len(ids) || value < 0 || value > 4294967295 {
        syn_bug("syntax: id assignment out of range")
    }
    let p = at * 4
    ids.bytes[p] = value as byte
    ids.bytes[p + 1] = (value >> 8) as byte
    ids.bytes[p + 2] = (value >> 16) as byte
    ids.bytes[p + 3] = (value >> 24) as byte
}

/// Append exactly four bytes, growing geometrically through List.
pub fn syn_ids_push(mut ids: SynIds, value: int) {
    if value < 0 || value > 4294967295 {
        syn_bug("syntax: id exceeds u32")
    }
    (mut ids.bytes).push(value as byte)
    (mut ids.bytes).push((value >> 8) as byte)
    (mut ids.bytes).push((value >> 16) as byte)
    (mut ids.bytes).push((value >> 24) as byte)
}

/// Replace a range with UNKNOWN ids; retain the rest in one memmove pass.
/// Callers splice at edited_line+1, never discard the proven entering state.
pub fn syn_ids_splice(mut ids: SynIds, at: int, removed: int, inserted: int) {
    let n = syn_ids_len(ids)
    if at < 0 || at > n || removed < 0 || removed > n - at || inserted < 0 {
        syn_bug("syntax: invalid id splice")
    }
    let result = n - removed + inserted
    if result > 2305843009213693951 {
        syn_bug("syntax: id splice exceeds address space")
    }
    let old_end = (at + removed) * 4
    let new_end = (at + inserted) * 4
    let old_bytes = ids.bytes.len
    while ids.bytes.len < result * 4 {
        (mut ids.bytes).push(0 as byte)
    }
    if new_end > old_end {
        var p = old_bytes
        while p > old_end {
            p -= 1
            ids.bytes[p - old_end + new_end] = ids.bytes[p]
        }
    } else if new_end < old_end {
        var p = old_end
        while p < old_bytes {
            ids.bytes[p - old_end + new_end] = ids.bytes[p]
            p += 1
        }
    }
    while ids.bytes.len > result * 4 {
        let _ = (mut ids.bytes).pop() else 0 as byte
    }
    var p = at * 4
    while p < new_end {
        ids.bytes[p] = 0 as byte
        p += 1
    }
}
