//! syn.data — the syntax compiler's literal-data front end.
//! Ports sagitta src/syn/defs.c:272–318 and its fl_parse_literal boundary
//! at 9ace98c2. No Fletch bytecode is compiled or executed. String ids
//! reference the byte-preserving Fletch interner; regex/delimiter bytes
//! never pass through a Unicode string conversion.
use fl

/// One parsed definition and its structural diagnostics. Later compiler
/// phases keep source node ids for caret locations and include ownership.
pub struct SynData {
    program: fl.FlProgram,
    strings: fl.FlStrings,
    diagnostics: fl.DiagCtx,
    file_id: int,
}

/// Parse the same pure-literal grammar as the C definition compiler.
pub fn syn_data_parse(path: str, source: List[byte]) -> SynData {
    var diagnostics = fl.fl_diag_init()
    let file_id = fl.fl_diag_add_file(mut diagnostics, path, source)
    var strings = fl.fl_strings()
    let program = fl.fl_parse_literal(source, file_id, mut diagnostics, mut strings)
    SynData { program: program, strings: strings, diagnostics: diagnostics, file_id: file_id }
}

/// A missing or invalid node is never indexed.
pub fn syn_data_is(data: SynData, node: int, kind: int) -> bool {
    node >= 0 && node < data.program.nodes.len && data.program.nodes[node].kind == kind
}

fn data_literal_is(data: SynData, node: int, kind: int) -> bool {
    syn_data_is(data, node, fl.FL_A_LIT) && data.program.nodes[node].a == kind
}

/// Borrow a byte string by its stable interner id, not an owned byte copy.
pub fn syn_data_string_id(data: SynData, node: int) -> int ! {none} {
    if !data_literal_is(data, node, fl.FL_L_STR) { return none }
    let id = data.program.nodes[node].i
    if id <= 0 || id >= data.strings.items.len { return none }
    id
}

/// Compare a known schema spelling without allocating or decoding bytes.
pub fn syn_data_string_is(data: SynData, node: int, spelling: str) -> bool {
    let id = syn_data_string_id(data, node) else { return false }
    if data.strings.items[id].len != spelling.len { return false }
    var i = 0
    while i < spelling.len {
        if data.strings.items[id][i] != spelling.bytes()[i] { return false }
        i += 1
    }
    true
}

/// First matching key, as map_find in defs.c. Key/value edge arrays are
/// independently indexed; an integer map key cannot masquerade as a name.
pub fn syn_data_map_get(data: SynData, map_node: int, key: str) -> int ! {none} {
    if !syn_data_is(data, map_node, fl.FL_A_MAP) { return none }
    let count = data.program.nodes[map_node].c
    var i = 0
    while i < count {
        let key_node = data.program.edges[data.program.nodes[map_node].a + i]
        if syn_data_string_is(data, key_node, key) {
            return data.program.edges[data.program.nodes[map_node].b + i]
        }
        i += 1
    }
    none
}

/// Booleans, strings and integers remain distinct literal kinds.
pub fn syn_data_integer(data: SynData, node: int) -> int ! {none} {
    if !data_literal_is(data, node, fl.FL_L_INT) { return none }
    data.program.nodes[node].i
}

pub fn syn_data_boolean(data: SynData, node: int) -> bool ! {none} {
    if !data_literal_is(data, node, fl.FL_L_BOOL) { return none }
    data.program.nodes[node].i != 0
}

/// Keep exact offending key nodes for the compiler's source-order
/// diagnostics/suggestions, including non-string keys. Nothing is dropped
/// or converted lossily to produce this inventory.
pub fn syn_data_unknown_keys(data: SynData, map_node: int, spellings: str) -> List[int] {
    var unknown = List[int]()
    if !syn_data_is(data, map_node, fl.FL_A_MAP) { return unknown }
    var i = 0
    while i < data.program.nodes[map_node].c {
        let node = data.program.edges[data.program.nodes[map_node].a + i]
        var found = false
        for known in spellings.words() {
            if syn_data_string_is(data, node, known) { found = true; break }
        }
        if !found { (mut unknown).push(node) }
        i += 1
    }
    unknown
}

/// Emit a compiler diagnostic at the original literal node's span.
pub fn syn_data_error(mut data: SynData, node: int, message: str) {
    var span = fl.FlSpan { file_id: data.file_id, line: 1, col: 1, len: 1 }
    if node >= 0 && node < data.program.nodes.len { span = copy data.program.nodes[node].sp }
    fl.fl_diag_emit(mut data.diagnostics, fl.FL_DIAG_ERROR, span, message)
}
