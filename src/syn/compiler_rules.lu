//! syn.compiler_rules — patterns, captures, state operations and embedding
//! descriptors. Ports sagitta src/syn/defs.c:894–1342 at 9ace98c2.

use fl
use search

fn c_aux_intern(mut c: SynCompiler, source_id: int) -> int {
    let n = c.data.strings.items[source_id].len
    fl.fl_intern(mut c.definition.strings, c.data.strings.items[source_id], 0, n)
}

fn c_captures(mut c: SynCompiler, node: int, mut rule: SynRule, groups: int) {
    if node < 0 { return }
    if !syn_data_is(c.data, node, fl.FL_A_MAP) {
        c_error(mut c, node, "captures must be a map")
        return
    }
    var i = 0
    while i < c.data.program.nodes[node].c {
        let key = c_key(c, node, i)
        let value = c_value(c, node, i)
        let group = syn_data_integer(c.data, key) else {
            c_error(mut c, key, "capture group must be an integer")
            i += 1
            continue
        }
        if group < 0 || group > 7 {
            c_error(mut c, key, "capture group {group} is out of range (0-7)")
        } else if group >= groups {
            let n = if groups == 0 then 0 else groups - 1
            c_error(mut c, key, "capture group {group} but the pattern has {n} capture groups")
        } else {
            rule.caps[group] = c_attr(mut c, value) as byte
        }
        i += 1
    }
}

fn c_aux_kind(mut c: SynCompiler, node: int) -> int {
    let id = c_string(mut c, node, "aux")
    if id == 0 { return SYN_AUXM_NONE }
    var i = 1
    for name in "line_eq literal fence_close indent_lt line_empty line_start line_eq_ws".words() {
        if c_bytes_is(c.data.strings.items[id], name) { return i }
        i += 1
    }
    c_named(mut c, fl.FL_DIAG_ERROR, node, "unknown aux matcher '", id, "'")
    SYN_AUXM_NONE
}

fn c_embed_same(a: SynEmbed, b: SynEmbed) -> bool {
    a.ctx == b.ctx && a.end_kind == b.end_kind && a.fallback == b.fallback
}

fn c_embed(mut c: SynCompiler, node: int, push: int, target: int, groups: int) -> SynEmbed {
    var desc = syn_embed_none()
    let before = c.data.diagnostics.nerrors
    if !c_map(mut c, node, "embed") { return desc }
    c_keys(mut c, node, "lang ctx end defer fallback interleave")
    let interleave = c_get(c, node, "interleave")
    if interleave >= 0 {
        c_error(mut c, interleave, "embed.interleave is deferred until after 1.0")
    }
    if push < 0 {
        c_error(mut c, node, "embed requires exactly one string 'push' bridge target")
    } else if (syn_data_string_id(c.data, push) else 0) == 0 {
        c_error(mut c, push, "embed bridge 'push' must be one context name, not a list")
    }
    let lang_node = c_get(c, node, "lang")
    let lang = c_string(mut c, lang_node, "embed.lang")
    if lang != 0 {
        let n = c.data.strings.items[lang].len
        if n == 0 || c_has_nul(c.data.strings.items[lang]) {
            c_error(mut c, lang_node, "embed.lang must be a non-empty string without NUL")
        } else if c_bytes_is(c.data.strings.items[lang], "@self") {
            desc.lang_kind = SYN_EMBED_LANG_SELF
        } else if c.data.strings.items[lang][0] as int == 64 {
            var group: int = 0
            var bad = n == 1
            var i = 1
            while i < n {
                let b = c.data.strings.items[lang][i] as int
                if b < 48 || b > 57 || group > 429496728 { bad = true; break }
                group = group * 10 + b - 48
                i += 1
            }
            if bad || group == 0 || group == 4294967295 {
                c_error(mut c, lang_node, "embed.lang reference must be '@self' or '@N'")
            } else if group > 7 || group >= groups {
                let captures = if groups == 0 then 0 else groups - 1
                c_error(
                    mut c,
                    lang_node,
                    "embed.lang: @{group} but the pattern has {captures} capture groups",
                )
            } else {
                desc.lang_kind = SYN_EMBED_LANG_CAPTURE
                desc.lang_group = group
            }
        } else {
            desc.lang_kind = SYN_EMBED_LANG_LITERAL
            desc.lang = c_aux_intern(mut c, lang)
        }
    }
    let ctx_node = c_get(c, node, "ctx")
    if ctx_node >= 0 {
        let ctx = c_string(mut c, ctx_node, "embed.ctx")
        if ctx != 0 {
            if c.data.strings.items[ctx].len == 0 || c_has_nul(c.data.strings.items[ctx]) {
                c_error(mut c, ctx_node, "embed.ctx must be a non-empty string without NUL")
            } else {
                desc.ctx = c_aux_intern(mut c, ctx)
            }
        }
    }
    let end_node = c_get(c, node, "end")
    let end = c_string(mut c, end_node, "embed.end")
    if end != 0 {
        if c_bytes_is(c.data.strings.items[end], "line") {
            desc.end_kind = SYN_EMBED_END_LINE
        } else if c_bytes_is(c.data.strings.items[end], "inline") {
            desc.end_kind = SYN_EMBED_END_INLINE
        } else if c_bytes_is(c.data.strings.items[end], "inline-root") {
            desc.end_kind = SYN_EMBED_END_INLINE_ROOT
        } else if c_bytes_is(c.data.strings.items[end], "line-continuation") {
            desc.end_kind = SYN_EMBED_END_LINE_CONTINUATION
        } else {
            c_error(
                mut c,
                end_node,
                "embed.end must be 'line', 'inline', 'inline-root', or 'line-continuation'",
            )
        }
    }
    let deferred = c_get(c, node, "defer")
    if deferred >= 0 && c_bool(mut c, deferred, "embed.defer") {
        desc.flags = desc.flags | SYN_EMBED_DEFER
    }
    let fallback = c_get(c, node, "fallback")
    if fallback >= 0 {
        desc.fallback = c_attr(mut c, fallback)
    } else if target < c.specs.len && c.specs[target].default_node >= 0 {
        desc.fallback = c_attr(mut c, c.specs[target].default_node)
    }
    if before != c.data.diagnostics.nerrors || push < 0 || target >= c.specs.len {
        return syn_embed_none()
    }
    let pushed = syn_data_string_id(c.data, push) else 0
    if pushed == 0 || c_ctx_from(c, pushed, 0) < 0 { return syn_embed_none() }
    if c.specs[target].embed_set {
        if !c_embed_same(c.specs[target].embed, desc) {
            let id = c.specs[target].name
            c_named(
                mut c,
                fl.FL_DIAG_ERROR,
                node,
                "context '",
                id,
                "' has incompatible embed bridge descriptors",
            )
        }
    } else {
        c.specs[target].embed.ctx = desc.ctx
        c.specs[target].embed.end_kind = desc.end_kind
        c.specs[target].embed.fallback = desc.fallback
        c.specs[target].embed_set = true
    }
    desc
}

fn c_rule(mut c: SynCompiler, node: int, context: int) -> SynRule {
    var rule = syn_rule_new(0, SYN_ATTR_TEXT)
    let before = c.data.diagnostics.nerrors
    c_keys(
        mut c,
        node,
        "match attr captures consume push pop set icase set_aux strip aux aux_pre aux_post aux_int aux_add aux_add_capture value if_value first_line embed end",
    )
    let matcher = c_get(c, node, "match")
    let aux = c_get(c, node, "aux")
    let push = c_get(c, node, "push")
    let pop = c_get(c, node, "pop")
    let set = c_get(c, node, "set")
    let embed = c_get(c, node, "embed")
    if matcher < 0 && aux < 0 && before == c.data.diagnostics.nerrors {
        c_error(mut c, node, "rule requires 'match' or one aux matcher")
    }
    if matcher >= 0 && aux >= 0 {
        c_error(mut c, aux, "rule has both 'match' and 'aux'; choose one matcher")
    }
    let operations = (if push >= 0 then 1 else 0) +
        (if pop >= 0 then 1 else 0) +
        (if set >= 0 then 1 else 0)
    if embed < 0 && operations > 1 {
        let a = if push >= 0 then "push" else "pop"
        let b = if set >= 0 then "set" else "pop"
        c_error(mut c, node, "rule has both '{a}' and '{b}'; a rule performs exactly one state op")
    }
    if embed >= 0 && (pop >= 0 || set >= 0) {
        c_error(mut c, node, "embed is a state op; a rule performs exactly one")
    }
    var icase = c.specs[context].icase
    let case_node = c_get(c, node, "icase")
    if case_node >= 0 { icase = c_bool(mut c, case_node, "rule icase") }
    let first = c_get(c, node, "first_line")
    if first >= 0 && c_bool(mut c, first, "rule first_line") {
        rule.flags = rule.flags | SYN_RULE_FIRST_LINE
    }
    var groups = 0
    var pattern = List[byte]()
    if matcher >= 0 {
        let id = c_string(mut c, matcher, "match")
        if id != 0 {
            pattern = copy c.data.strings.items[id]
            var err = search.re_err_new()
            let flags = if icase then search.RE_ICASE else 0
            let re = search.re_compile(c.data.strings.items[id], flags, mut err) else {
                c_error(mut c, matcher, "invalid pattern at offset {err.off}: {err.msg}")
                search.re_empty()
            }
            if err.msg.len == 0 {
                groups = re.ngroups
                if re.min_len == 0 {
                    c_error(
                        mut c,
                        matcher,
                        "pattern may match empty; use a sanctioned zero-width aux matcher",
                    )
                }
                let first_bytes = search.re_first_bytes(re)
                rule.first = syn_first_new(false)
                var b = 0
                while b < 256 { if first_bytes[b] { syn_first_add(mut rule.first, b) }; b += 1 }
                rule.regex = c.definition.regexes.len
                (mut c.definition.regexes).push(re)
            }
        }
    } else if aux >= 0 {
        rule.aux_match = c_aux_kind(mut c, aux)
        if rule.aux_match == SYN_AUXM_INDENT_LT || rule.aux_match == SYN_AUXM_LINE_START {
            rule.flags = rule.flags | SYN_RULE_ZERO_TRANSITION
        }
    }
    (mut c.definition.patterns).push(pattern)
    let attr = c_get(c, node, "attr")
    if attr >= 0 {
        rule.attr = c_attr(mut c, attr)
    } else if c.specs[context].default_node >= 0 {
        rule.attr = c_attr(mut c, c.specs[context].default_node)
    }
    c_captures(mut c, c_get(c, node, "captures"), mut rule, groups)
    let consume = c_get(c, node, "consume")
    if consume >= 0 {
        let (ok, group) = c_rule_integer(mut c, consume, "consume")
        if ok {
            if group < 0 || group > 7 {
                c_error(mut c, consume, "consume group {group} is out of range (0-7)")
            } else if group >= groups {
                let count = if groups == 0 then 0 else groups - 1
                c_error(
                    mut c,
                    consume,
                    "consume: {group} but the pattern has {count} capture groups",
                )
            } else {
                rule.consume = group
            }
        }
    }
    if push >= 0 {
        rule.op = SYN_OP_PUSH
        if (syn_data_string_id(c.data, push) else 0) != 0 {
            let target = c_target(mut c, push, "push")
            if target >= 0 { rule.target = target; c.specs[target].pushed = true }
        } else if syn_data_is(c.data, push, fl.FL_A_LIST) {
            let n = c.data.program.nodes[push].b
            if n == 0 || n > 4 {
                c_error(mut c, push, "push list has {n} entries (limit 1-4)")
            } else {
                var i = 0
                while i < n {
                    let target = c_target(mut c, c_item(c, push, i), "push")
                    (mut rule.pushes).push(if target < 0 then 0 else target)
                    if target >= 0 { c.specs[target].pushed = true }
                    i += 1
                }
            }
        } else {
            c_error(mut c, push, "push must be a context name or list")
        }
    } else if pop >= 0 {
        rule.op = SYN_OP_POP
        rule.nop = c_pop(mut c, pop)
    } else if set >= 0 {
        rule.op = SYN_OP_SET
        let target = c_target(mut c, set, "set")
        if target >= 0 { rule.target = target; c.specs[target].pushed = true }
    }
    if embed >= 0 {
        rule.op = SYN_OP_EMBED
        rule.embed = c_embed(mut c, embed, push, rule.target, groups)
    }
    let boundary = c_get(c, node, "end")
    if boundary >= 0 { rule.end_boundary = c_bool(mut c, boundary, "rule end") }
    let set_aux = c_get(c, node, "set_aux")
    if set_aux >= 0 {
        let (ok, group) = c_rule_integer(mut c, set_aux, "set_aux")
        if ok {
            if group >= 0 && group <= 7 && group < groups {
                rule.flags = rule.flags | SYN_RULE_SET_AUX
                rule.aux_group = group
            } else {
                let count = if groups == 0 then 0 else groups - 1
                c_error(
                    mut c,
                    set_aux,
                    "set_aux: {group} but the pattern has {count} capture groups",
                )
            }
        }
    }
    let aux_int = c_get(c, node, "aux_int")
    if aux_int >= 0 && c_bool(mut c, aux_int, "rule aux_int") {
        if set_aux < 0 { c_error(mut c, aux_int, "aux_int requires set_aux on the same rule") }
        rule.flags = rule.flags | SYN_RULE_AUX_INT
    }
    let aux_add = c_get(c, node, "aux_add")
    if aux_add >= 0 {
        let (ok, value) = c_rule_integer(mut c, aux_add, "aux_add")
        if ok {
            if value < 0 || value > 255 {
                c_error(mut c, aux_add, "aux_add {value} is out of range (0-255)")
            } else {
                if aux_int < 0 {
                    c_error(mut c, aux_add, "aux_add requires aux_int on the same rule")
                }
                rule.aux_add = value
            }
        }
    }
    let add_capture = c_get(c, node, "aux_add_capture")
    if add_capture >= 0 {
        let (ok, value) = c_rule_integer(mut c, add_capture, "aux_add_capture")
        if ok {
            if value < 1 || value > 7 || value >= groups {
                let count = if groups == 0 then 0 else groups - 1
                c_error(
                    mut c,
                    add_capture,
                    "aux_add_capture: {value} but the pattern has {count} capture groups",
                )
            } else {
                if aux_int < 0 {
                    c_error(mut c, add_capture, "aux_add_capture requires aux_int on the same rule")
                }
                rule.aux_add_group = value
            }
        }
    }
    let strip = c_get(c, node, "strip")
    if strip >= 0 && c_bool(mut c, strip, "strip") {
        if set_aux < 0 { c_error(mut c, strip, "strip requires set_aux on the same rule") }
        rule.flags = rule.flags | SYN_RULE_STRIP
    }
    let value = c_get(c, node, "value")
    if value >= 0 {
        let enabled = syn_data_boolean(c.data, value) else {
            c_error(mut c, value, "value must be a boolean")
            false
        }
        rule.flags = rule.flags | (if enabled then SYN_RULE_SET_VALUE else SYN_RULE_CLR_VALUE)
    }
    let predicate = c_get(c, node, "if_value")
    if predicate >= 0 {
        rule.value_pred = if c_bool(mut c, predicate, "rule if_value") {
            SYN_VALUE_SET
        } else {
            SYN_VALUE_CLEAR
        }
    }
    let pre = c_get(c, node, "aux_pre")
    if pre >= 0 {
        let id = c_string(mut c, pre, "aux_pre")
        if id != 0 { rule.aux_pre = c_aux_intern(mut c, id) }
    }
    let post = c_get(c, node, "aux_post")
    if post >= 0 {
        let id = c_string(mut c, post, "aux_post")
        if id != 0 { rule.aux_post = c_aux_intern(mut c, id) }
    }
    if (pre >= 0 || post >= 0) && rule.aux_match != SYN_AUXM_LITERAL {
        c_error(mut c, node, "aux_pre and aux_post require aux: 'literal'")
    }
    if rule.aux_match == SYN_AUXM_INDENT_LT && rule.op != SYN_OP_POP {
        c_error(mut c, node, "indent_lt is zero-width and must pop")
    }
    if rule.aux_match == SYN_AUXM_LINE_START && rule.op == SYN_OP_STAY {
        c_error(mut c, node, "line_start is zero-width and requires a state operation")
    }
    rule
}

fn c_rule_integer(mut c: SynCompiler, node: int, what: str) -> (bool, int) {
    let value = syn_data_integer(c.data, node) else {
        c_error(mut c, node, "{what} must be an integer")
        return (false, 0)
    }
    (true, value)
}
