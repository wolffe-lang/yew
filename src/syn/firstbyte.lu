//! syn.firstbyte — the compiled first-byte masks against the regexes.
//! Ports sagitta src/syn/defs.c:3250–3291 (yew_syn_def_firstbyte_check)
//! at 9ace98c2: a mask may be broad, never narrow.

use search
use text

/// Every byte that starts a match of a rule's regex, probed with C's eight
/// tails, is in the rule's compiled mask. Answers (ok, bad_rule, bad_byte)
/// for the first failure in rule then byte order, or (true, -1, -1); rules
/// without a regex are skipped. A byte already in the mask cannot fail, so
/// it is not probed.
pub fn syn_firstbyte_check(def: SynDefinition) -> (bool, int, int) {
    let tails = ["", "a", "0", " ", "true", "=value", "]", "\"text\""]
    let backing = text.textbuf_new()
    var m = search.re_match_new()
    for rule in 0..def.rules.len {
        let index = def.rules[rule].regex
        if index > 0 && index < def.regexes.len {
            for b in 0..256 {
                if !syn_first_has(def.rules[rule].first, b) {
                    for t in 0..tails.len {
                        var sample = List[byte]()
                        (mut sample).push(b as byte)
                        for c in tails[t].bytes() { (mut sample).push(c) }
                        let hit = search.re_match_at(
                            def.regexes[index],
                            backing,
                            sample,
                            search.re_input_bytes(sample.len),
                            0 as text.ByteOff,
                            mut m,
                        )
                        if hit then return (false, rule, b)
                    }
                }
            }
        }
    }
    (true, -1, -1)
}
