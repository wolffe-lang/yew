//! syn.compiler — flat table assembly and compiled-graph validation.
//! Ports sagitta src/syn/defs.c:1420–1830 at 9ace98c2. Definition
//! compilation is explicit state, with no process-global metadata registry.
use fl
use search

fn c_reachable(mut c: SynCompiler) {
    var pending = List[int]()
    let root = c.definition.root
    c.specs[root].reachable = true
    (mut pending).push(root)
    while pending.len != 0 {
        let ctx = (mut pending).pop() else 0
        let first = c.definition.contexts[ctx].first_rule
        let count = c.definition.contexts[ctx].nrules
        var i = 0
        while i < count {
            let rule = first + i
            let op = c.definition.rules[rule].op
            if op == SYN_OP_PUSH || op == SYN_OP_EMBED || op == SYN_OP_SET {
                if c.definition.rules[rule].pushes.len == 0 {
                    let target = c.definition.rules[rule].target
                    if target < c.specs.len && !c.specs[target].reachable {
                        c.specs[target].reachable = true; (mut pending).push(target)
                    }
                } else {
                    var j = 0
                    while j < c.definition.rules[rule].pushes.len {
                        let target = c.definition.rules[rule].pushes[j]
                        if target < c.specs.len && !c.specs[target].reachable {
                            c.specs[target].reachable = true; (mut pending).push(target)
                        }
                        j += 1
                    }
                }
            }
            i += 1
        }
        if c.definition.contexts[ctx].eol_op == SYN_OP_SET {
            let target = c.definition.contexts[ctx].eol_target
            if target < c.specs.len && !c.specs[target].reachable {
                c.specs[target].reachable = true; (mut pending).push(target)
            }
        }
    }
}

fn c_reduces(definition: SynDefinition, id: int) -> bool {
    let op = definition.contexts[id].eol_op
    if op == SYN_OP_POP || op == SYN_OP_SET { return true }
    let first = definition.contexts[id].first_rule
    var i = 0
    while i < definition.contexts[id].nrules {
        let rule_op = definition.rules[first + i].op
        if rule_op == SYN_OP_POP || rule_op == SYN_OP_SET { return true }
        i += 1
    }
    false
}

struct SynDepthFrame { ctx: int, rule: int, child: int, maximum: int, add: int }

fn c_depth(definition: SynDefinition) -> int {
    var active = List[bool]()
    var i = 0
    while i < definition.contexts.len { (mut active).push(false); i += 1 }
    var stack = List[SynDepthFrame]()
    let root = definition.root
    active[root] = true
    (mut stack).push(SynDepthFrame { ctx: root, rule: 0, child: 0, maximum: 1, add: 0 })
    var result = 1
    while stack.len != 0 {
        let top = stack.len - 1
        let ctx = stack[top].ctx
        if stack[top].rule >= definition.contexts[ctx].nrules {
            result = stack[top].maximum
            active[ctx] = false
            let _ = (mut stack).pop() else SynDepthFrame { ctx: 0, rule: 0, child: 0, maximum: 1, add: 0 }
            if stack.len != 0 {
                let parent = stack.len - 1
                let candidate = stack[parent].add + result
                if candidate > stack[parent].maximum { stack[parent].maximum = candidate }
            }
            continue
        }
        let rule = definition.contexts[ctx].first_rule + stack[top].rule
        let op = definition.rules[rule].op
        if op != SYN_OP_PUSH && op != SYN_OP_EMBED {
            stack[top].rule += 1; stack[top].child = 0; continue
        }
        let n = if definition.rules[rule].pushes.len == 0 then 1 else definition.rules[rule].pushes.len
        if stack[top].child >= n { stack[top].rule += 1; stack[top].child = 0; continue }
        let child = stack[top].child
        let target = if definition.rules[rule].pushes.len == 0 then definition.rules[rule].target else definition.rules[rule].pushes[child]
        stack[top].child += 1
        let add = child + 1
        if target >= definition.contexts.len || active[target] {
            if add + 1 > stack[top].maximum { stack[top].maximum = add + 1 }
            continue
        }
        stack[top].add = add
        active[target] = true
        (mut stack).push(SynDepthFrame { ctx: target, rule: 0, child: 0, maximum: 1, add: 0 })
    }
    result
}

fn c_rule_span(c: SynCompiler, rule: int) -> int {
    let node = c.rule_nodes[rule]
    let pattern = c_get(c, node, "match")
    if pattern < 0 then node else pattern
}

fn c_pattern_same(a: List[byte], b: List[byte]) -> bool {
    var i = 0
    loop {
        let av = if i >= a.len then 0 else a[i] as int
        let bv = if i >= b.len then 0 else b[i] as int
        if av != bv { return false }
        if av == 0 { return true }
        i += 1
    }
}

fn c_first_superset(a: List[byte], b: List[byte]) -> bool {
    var i = 0
    while i < 32 { if (a[i] as int | b[i] as int) != a[i] as int { return false }; i += 1 }
    true
}

fn c_validate(mut c: SynCompiler) {
    c_reachable(mut c)
    var i = 0
    while i < c.specs.len {
        let node = c.specs[i].node
        let name = c.specs[i].name
        if !c.specs[i].reachable && !c.specs[i].include_used { c_named(mut c, fl.FL_DIAG_WARNING, node, "context '", name, "' is unreachable") }
        if i != c.definition.root && c.specs[i].reachable && c.specs[i].pushed && !c_reduces(c.definition, i) {
            c_named(mut c, fl.FL_DIAG_ERROR, node, "context '", name, "' can never be popped")
        }
        if c.specs[i].include_used && !c.specs[i].pushed && i != c.definition.root &&
            (c.specs[i].default_node >= 0 || c.specs[i].eol_node >= 0 || c.specs[i].unit_node >= 0) {
            c_warning(mut c, node, "only 'rules' is used at an include site")
        }
        if c.definition.contexts[i].default_attr == 46 {
            c_warning(mut c, c.specs[i].default_node, "default: 'error' paints every unmatched byte red; did you mean 'text'?")
        }
        let first = c.definition.contexts[i].first_rule
        var has_end = false
        var j = 0
        while j < c.definition.contexts[i].nrules {
            let index = first + j
            let span = c_rule_span(c, index)
            if c.definition.rules[index].end_boundary {
                has_end = true
                if c.definition.contexts[i].flags & SYN_CTX_EMBED_BRIDGE == 0 { c_error(mut c, span, "'end' marks a rule that returns from an embedded language") }
            }
            if c.definition.rules[index].aux_match == SYN_AUXM_INDENT_LT && j != 0 { c_error(mut c, c.specs[i].rules, "indent_lt must be the first rule in its context") }
            if c_get(c, c.rule_nodes[index], "match") >= 0 {
                var k = 0
                while k < j {
                    let earlier = first + k
                    if c_get(c, c.rule_nodes[earlier], "match") >= 0 && c_pattern_same(c.definition.patterns[earlier], c.definition.patterns[index]) {
                        let a = j + 1; let b = k + 1
                        c_warning(mut c, span, "rule {a} is unreachable: rule {b} has the same pattern")
                        break
                    }
                    let regex = c.definition.rules[earlier].regex
                    if regex > 0 && search.re_is_simple_catch_all(c.definition.regexes[regex]) && c_first_superset(c.definition.rules[earlier].first, c.definition.rules[index].first) {
                        let a = j + 1; let b = k + 1
                        let line = c_span(c, c_rule_span(c, earlier)).line
                        c_warning(mut c, span, "rule {a} is unreachable: rule {b} (line {line}) matches everything it could match")
                        break
                    }
                    k += 1
                }
            }
            j += 1
        }
        let op = c.definition.contexts[i].eol_op
        if c.definition.contexts[i].flags & SYN_CTX_EMBED_BRIDGE != 0 && !has_end && op != SYN_OP_POP && op != SYN_OP_SET {
            c_named(mut c, fl.FL_DIAG_ERROR, node, "context '", name, "' embeds a language it can never leave")
        }
        i += 1
    }
    let depth = c_depth(c.definition)
    if depth > 12 {
        let root_node = c.specs[c.definition.root].node
        c_error(mut c, root_node, "context nesting can reach depth {depth}; the cap is 16 with 4 levels reserved for runtime recursion (see YEW_SYN_DEPTH_MAX)")
    }
}

fn c_build(mut c: SynCompiler) {
    let root_node = c.data.program.root
    if root_node < 0 || !c_map(mut c, root_node, "syntax definition") { return }
    c_keys(mut c, root_node, "syntax language contexts root attrs")
    let version = c_get(c, root_node, "syntax")
    if version < 0 { c_error(mut c, root_node, "missing schema version (this build understands 1)") }
    else {
        let (ok, value) = c_rule_integer(mut c, version, "syntax")
        if ok && value != 1 { c_error(mut c, version, "unknown schema version {value} (this build understands 1)") }
    }
    let language = c_get(c, root_node, "language")
    if language < 0 { c_error(mut c, root_node, "language is required") }
    else { c_language(mut c, language) }
    c_aliases(mut c, c_get(c, root_node, "attrs"))
    let contexts = c_get(c, root_node, "contexts")
    if contexts < 0 { c_error(mut c, root_node, "contexts is required") }
    else { c_contexts(mut c, contexts) }
    if c.specs.len == 0 || c.definition.name.len == 0 { return }
    let root = c_get(c, root_node, "root")
    if root >= 0 {
        let selected = c_target(mut c, root, "root")
        if selected >= 0 { c.definition.root = selected }
    } else {
        var selected = -1
        var i = 0
        while i < c.specs.len {
            if c_bytes_is(c.data.strings.items[c.specs[i].name], "main") { selected = i; break }
            i += 1
        }
        if selected < 0 { c_error(mut c, contexts, "no context named 'main'") }
        else { c.definition.root = selected }
    }
    var i = 0
    while i < c.specs.len {
        let expanded = c_expand(mut c, i)
        var ctx = syn_context_new(SYN_ATTR_TEXT)
        ctx.first_rule = c.definition.rules.len
        ctx.nrules = expanded.len
        if c.specs[i].default_node >= 0 { ctx.default_attr = c_attr(mut c, c.specs[i].default_node) }
        c_eol(mut c, i, mut ctx)
        c_unit(mut c, i, mut ctx)
        for reference in expanded {
            (mut c.rule_nodes).push(reference.node)
            let rule = c_rule(mut c, reference.node, i)
            syn_first_union(mut ctx.first, rule.first)
            (mut c.definition.rules).push(rule)
        }
        (mut c.definition.contexts).push(ctx)
        i += 1
    }
    i = 0
    while i < c.specs.len {
        c.definition.contexts[i].embed = copy c.specs[i].embed
        if c.specs[i].embed_set { c.definition.contexts[i].flags = c.definition.contexts[i].flags | SYN_CTX_EMBED_BRIDGE }
        i += 1
    }
    c_validate(mut c)
    if c.data.diagnostics.nerrors == 0 && c.definition.language.has_first_line {
        let node = c_get(c, language, "first_line")
        var n = 0
        while n < c.definition.language.first_line.len && c.definition.language.first_line[n] as int != 0 { n += 1 }
        let source = copy c.definition.language.first_line[0..n]
        var err = search.re_err_new()
        let re = search.re_compile(source, 0, mut err) else {
            c_error(mut c, node, "invalid first_line pattern at offset {err.off}: {err.msg}")
            search.re_empty()
        }
        if err.msg.len == 0 {
            c.definition.language.first_line_regex = c.definition.regexes.len
            (mut c.definition.regexes).push(re)
        }
    }
}

/// Compile literal syntax data to ordered semantic/state tables. valid is
/// false on any error; warnings stay visible and can be made strict by the
/// CLI. No runtime discovery or process-global registration occurs here.
pub fn syn_compile(path: str, source: List[byte]) -> SynCompileResult {
    let data = syn_data_parse(path, source)
    var messages = List[List[byte]]()
    for diagnostic in data.diagnostics.entries { (mut messages).push(model_bytes(diagnostic.msg)) }
    var c = SynCompiler {
        data: data, definition: syn_definition_new(""), aliases: List[SynAliasSpec](),
        specs: List[SynContextSpec](), messages: messages, rule_nodes: List[int](),
    }
    c.definition.language.source = copy path
    c_build(mut c)
    let valid = c.data.diagnostics.nerrors == 0 && c.definition.contexts.len != 0 && c.definition.name.len != 0
    SynCompileResult { valid: valid, definition: c.definition, diagnostics: c.data.diagnostics, messages: c.messages }
}
