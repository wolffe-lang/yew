//! member: false
//! Sprint 31 deliverable 7's `io` module: sagitta 9ace98c2
//! tests/unit/test_fl_std_io.c:1-358 (13 cases, registry order,
//! tests/unit/registry.c:2062-2074), over flfix. Every case runs as a
//! config that may read and write (`io_open`, test_fl_std_io.c:39-47); C's
//! `IO_EQ` fills each `%s` with the fixture's directory, as the
//! interpolations below do. C writes `bin`'s invalid UTF-8 with
//! flfix_write; a wolf `str` cannot hold it, so this file writes those
//! bytes itself.

use fl
use flfix

fn io_open(mut f: flfix.FlFix) -> str {
    flfix.set_origin(mut f, fl.FL_ORIGIN_CONFIG, fl.FL_CAP_FS_READ | fl.FL_CAP_FS_WRITE)
    flfix.tmpdir(mut f)
}

fn bytes_of(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() { (mut out).push(b) }
    out
}

fn write_bytes(mut f: flfix.FlFix, rel: str, body: List[byte]) {
    let dir = flfix.tmpdir(mut f)
    fs_write_bytes("{dir}/{rel}", body) else |_| { assert(false, "io test: write {rel}") }
}

fn fl_io_read_returns_the_bytes_verbatim() {
    var f = flfix.open()
    let dir = io_open(mut f)
    flfix.write(mut f, "a.txt", "hello\nworld\n")
    flfix.eq(mut f, "import io\nreturn io.read(\"{dir}/a.txt\")\n", "hello\nworld\n")
    // No UTF-8 validation anywhere: a file that is not text is still a file.
    var bin = List[byte]()
    for x in [97, 128, 255, 98] { (mut bin).push(x as byte) }
    write_bytes(mut f, "bin", bin)
    flfix.eq_bytes(mut f, "import io\nreturn io.read(\"{dir}/bin\")\n", bin)
    flfix.close(mut f)
}

fn fl_io_read_names_the_errno_and_the_path() {
    var f = flfix.open()
    let dir = io_open(mut f)
    flfix.mkdir(mut f, "sub")
    flfix.eq(mut f, "import io\nreturn io.read(\"{dir}/nope\")\n", "!io: ENOENT: {dir}/nope")
    flfix.eq(mut f, "import io\nreturn io.read(\"{dir}/sub\")\n", "!io: EISDIR: {dir}/sub")
    // An embedded NUL is REFUSED, not truncated.
    flfix.eq(
        mut f,
        "import io\nreturn io.read(\"a\\0b\")\n",
        "!io: path contains a NUL byte at offset 1",
    )
    flfix.eq(mut f, "import io\nreturn io.read(\"\")\n", "!io: the path is empty")
    flfix.close(mut f)
}

fn fl_io_read_lines_is_split_lines_of_the_file() {
    var f = flfix.open()
    let dir = io_open(mut f)
    flfix.write(mut f, "u.txt", "a\nb\n")
    flfix.write(mut f, "w.txt", "a\r\nb\r\n")
    flfix.write(mut f, "n.txt", "a\nb")
    flfix.eq(
        mut f,
        "import io\nimport fmt\nreturn fmt.repr(io.read_lines(\"{dir}/u.txt\"))\n",
        "[\"a\", \"b\", \"\"]",
    )
    flfix.eq(
        mut f,
        "import io\nimport fmt\nreturn fmt.repr(io.read_lines(\"{dir}/w.txt\"))\n",
        "[\"a\", \"b\", \"\"]",
    )
    flfix.eq(
        mut f,
        "import io\nimport fmt\nreturn fmt.repr(io.read_lines(\"{dir}/n.txt\"))\n",
        "[\"a\", \"b\"]",
    )
    flfix.close(mut f)
}

fn fl_io_write_then_read_round_trips() {
    var f = flfix.open()
    let dir = io_open(mut f)
    flfix.eq(
        mut f,
        "import io\nio.write(\"{dir}/w.txt\", \"one\")\nreturn io.read(\"{dir}/w.txt\")\n",
        "one",
    )
    flfix.eq(
        mut f,
        "import io\nio.write(\"{dir}/w.txt\", \"one\")\nio.append(\"{dir}/w.txt\", \"two\")\nreturn io.read(\"{dir}/w.txt\")\n",
        "onetwo",
    )
    // Bytes, not text, on the way out as well as in.
    flfix.eq(
        mut f,
        "import io\nio.write(\"{dir}/b\", \"x\\x00y\")\nreturn io.size(\"{dir}/b\")\n",
        "3",
    )
    flfix.close(mut f)
}

fn fl_io_interrogates_without_raising() {
    var f = flfix.open()
    let dir = io_open(mut f)
    flfix.write(mut f, "a.txt", "hi")
    flfix.mkdir(mut f, "sub")
    flfix.eq(mut f, "import io\nreturn io.exists(\"{dir}/a.txt\")\n", "true")
    flfix.eq(mut f, "import io\nreturn io.exists(\"{dir}/nope\")\n", "false")
    flfix.eq(mut f, "import io\nreturn io.exists(\"{dir}/nope/deeper\")\n", "false")
    flfix.eq(mut f, "import io\nreturn io.is_dir(\"{dir}/sub\")\n", "true")
    flfix.eq(mut f, "import io\nreturn io.is_dir(\"{dir}/a.txt\")\n", "false")
    flfix.eq(mut f, "import io\nreturn io.is_dir(\"{dir}/nope\")\n", "false")
    flfix.close(mut f)
}

fn fl_io_size_reports_bytes_or_raises() {
    var f = flfix.open()
    let dir = io_open(mut f)
    flfix.write(mut f, "a.txt", "hello\nworld\n")
    flfix.eq(mut f, "import io\nreturn io.size(\"{dir}/a.txt\")\n", "12")
    flfix.eq(mut f, "import io\nreturn io.size(\"{dir}/nope\")\n", "!io: ENOENT: {dir}/nope")
    flfix.close(mut f)
}

fn fl_io_remove_takes_a_file_or_an_empty_dir() {
    var f = flfix.open()
    let dir = io_open(mut f)
    flfix.write(mut f, "a.txt", "hi")
    flfix.mkdir(mut f, "empty")
    flfix.mkdir(mut f, "full")
    flfix.write(mut f, "full/x", "x")
    flfix.eq(
        mut f,
        "import io\nio.remove(\"{dir}/a.txt\")\nreturn io.exists(\"{dir}/a.txt\")\n",
        "false",
    )
    flfix.eq(
        mut f,
        "import io\nio.remove(\"{dir}/empty\")\nreturn io.exists(\"{dir}/empty\")\n",
        "false",
    )
    flfix.eq(mut f, "import io\nreturn io.remove(\"{dir}/full\")\n", "!io: ENOTEMPTY: {dir}/full")
    flfix.eq(mut f, "import io\nreturn io.remove(\"{dir}/nope\")\n", "!io: ENOENT: {dir}/nope")
    flfix.close(mut f)
}

fn fl_io_mkdir_makes_one_level_or_all_of_them() {
    var f = flfix.open()
    let dir = io_open(mut f)
    flfix.eq(mut f, "import io\nio.mkdir(\"{dir}/one\")\nreturn io.is_dir(\"{dir}/one\")\n", "true")
    // Without `parents`, a missing intermediate is an error.
    flfix.eq(mut f, "import io\nreturn io.mkdir(\"{dir}/q/r\")\n", "!io: ENOENT: {dir}/q/r")
    flfix.eq(
        mut f,
        "import io\nio.mkdir(\"{dir}/x/y/z\", true)\nreturn io.is_dir(\"{dir}/x/y/z\")\n",
        "true",
    )
    // An existing directory is not an error under `parents`.
    flfix.eq(
        mut f,
        "import io\nio.mkdir(\"{dir}/x/y/z\", true)\nreturn io.is_dir(\"{dir}/x/y/z\")\n",
        "true",
    )
    flfix.close(mut f)
}

// The tree every glob case matches against (test_fl_std_io.c:229-244).
fn glob_tree(mut f: flfix.FlFix) {
    flfix.write(mut f, "a.txt", "a")
    flfix.write(mut f, "b.md", "b")
    flfix.write(mut f, ".hidden", "h")
    flfix.mkdir(mut f, "sub")
    flfix.mkdir(mut f, "sub/deep")
    flfix.write(mut f, "sub/b.txt", "sb")
    flfix.write(mut f, "sub/deep/c.txt", "dc")
    // A symlink pointing at the root: descending it would loop.
    let dir = flfix.tmpdir(mut f)
    fs_symlink(dir, "{dir}/sub/loop") else |_| { assert(false, "io test: symlink") }
}

fn repr_glob(arg: str) -> str { "import io\nimport fmt\nreturn fmt.repr(io.glob({arg}))\n" }

fn fl_io_glob_matches_the_documented_syntax() {
    var f = flfix.open()
    let dir = io_open(mut f)
    glob_tree(mut f)
    flfix.eq(mut f, repr_glob("\"*.txt\""), "[\"{dir}/a.txt\"]")
    flfix.eq(mut f, repr_glob("\"?.md\""), "[\"{dir}/b.md\"]")
    flfix.eq(mut f, repr_glob("\"[ab]*\""), "[\"{dir}/a.txt\", \"{dir}/b.md\"]")
    flfix.eq(mut f, repr_glob("\"sub/*.txt\""), "[\"{dir}/sub/b.txt\"]")
    // `**` crosses directories and matches zero levels too.
    flfix.eq(mut f, repr_glob("\"**/c.txt\""), "[\"{dir}/sub/deep/c.txt\"]")
    flfix.eq(
        mut f,
        repr_glob("\"**/*.txt\""),
        "[\"{dir}/a.txt\", \"{dir}/sub/b.txt\", \"{dir}/sub/deep/c.txt\"]",
    )
    // A dot-file matches only when the component asks for one.
    flfix.eq(mut f, repr_glob("\".*\""), "[\"{dir}/.hidden\"]")
    flfix.eq(mut f, repr_glob("\"nothing/*\""), "[]")
    flfix.eq(mut f, "import io\nreturn io.glob(\"\")\n", "!type: io.glob: the pattern is empty")
    flfix.close(mut f)
}

fn fl_io_glob_is_sorted_and_never_follows_a_link() {
    var f = flfix.open()
    let dir = io_open(mut f)
    glob_tree(mut f)
    // The symlinked directory is MATCHED but never descended.
    flfix.eq(
        mut f,
        repr_glob("\"sub/*\""),
        "[\"{dir}/sub/b.txt\", \"{dir}/sub/deep\", \"{dir}/sub/loop\"]",
    )
    // Sorted BYTEWISE over the whole result, not per directory.
    flfix.mkdir(mut f, "zz")
    flfix.write(mut f, "zz/q.txt", "q")
    flfix.write(mut f, "zz.txt", "z")
    flfix.eq(
        mut f,
        repr_glob("\"**/*.txt\""),
        "[\"{dir}/a.txt\", \"{dir}/sub/b.txt\", \"{dir}/sub/deep/c.txt\", \"{dir}/zz.txt\", \"{dir}/zz/q.txt\"]",
    )
    flfix.close(mut f)
}

fn fl_io_glob_roots_at_the_importing_module() {
    var f = flfix.open()
    let dir = io_open(mut f)
    glob_tree(mut f)
    // The default root is the importing FILE's directory, never the cwd.
    flfix.eq(mut f, repr_glob("\"*.txt\""), "[\"{dir}/a.txt\"]")
    // An explicit root wins over it.
    flfix.eq(mut f, repr_glob("\"*.txt\", \"{dir}/sub\""), "[\"{dir}/sub/b.txt\"]")
    flfix.close(mut f)
}

fn fl_io_env_is_the_one_getenv() {
    var f = flfix.open()
    flfix.set_origin(mut f, fl.FL_ORIGIN_CONFIG, fl.FL_CAP_FS_READ)
    flfix.eq(mut f, "import io\nreturn io.env(\"YEW_UNSET_FOR_THIS_TEST\")\n", "nil")
    env_set("YEW_SET_FOR_THIS_TEST", "yes") else |_| { assert(false, "io test: setenv") }
    flfix.eq(mut f, "import io\nreturn io.env(\"YEW_SET_FOR_THIS_TEST\")\n", "yes")
    env_unset("YEW_SET_FOR_THIS_TEST") else |_| { assert(false, "io test: unsetenv") }
    flfix.close(mut f)
}

fn fl_io_print_needs_no_capability() {
    var f = flfix.open()
    // Asserted with NO grants at all, which is the whole point.
    flfix.set_origin(mut f, fl.FL_ORIGIN_PLUGIN, 0)
    flfix.eq(mut f, "import io\nio.print()\nreturn 1\n", "1")
    flfix.eq(mut f, "import io\nio.eprint()\nreturn 1\n", "1")
    // And it is still denied everything else.
    flfix.eq(
        mut f,
        "import io\nreturn io.read(\"/nope\")\n",
        "!capability: fs.read denied to a plugin",
    )
    flfix.close(mut f)
}

fn main() {
    // G29: stressed, the whole file is past the checked machine's 20M-step
    // budget, so YEW_IO_CASE runs one case alone (tools/check-test-cases.txt);
    // unset, all thirteen run in registry order.
    let only = (env_get("YEW_IO_CASE") else "-1").to_int() else -1
    let names = [
        "fl_io_read_returns_the_bytes_verbatim",
        "fl_io_read_names_the_errno_and_the_path",
        "fl_io_read_lines_is_split_lines_of_the_file",
        "fl_io_write_then_read_round_trips",
        "fl_io_interrogates_without_raising",
        "fl_io_size_reports_bytes_or_raises",
        "fl_io_remove_takes_a_file_or_an_empty_dir",
        "fl_io_mkdir_makes_one_level_or_all_of_them",
        "fl_io_glob_matches_the_documented_syntax",
        "fl_io_glob_is_sorted_and_never_follows_a_link",
        "fl_io_glob_roots_at_the_importing_module",
        "fl_io_env_is_the_one_getenv",
        "fl_io_print_needs_no_capability",
    ]
    var ran = 0
    for n in 0..13 {
        if only >= 0 && n != only { continue }
        match n {
            0 => fl_io_read_returns_the_bytes_verbatim(),
            1 => fl_io_read_names_the_errno_and_the_path(),
            2 => fl_io_read_lines_is_split_lines_of_the_file(),
            3 => fl_io_write_then_read_round_trips(),
            4 => fl_io_interrogates_without_raising(),
            5 => fl_io_size_reports_bytes_or_raises(),
            6 => fl_io_remove_takes_a_file_or_an_empty_dir(),
            7 => fl_io_mkdir_makes_one_level_or_all_of_them(),
            8 => fl_io_glob_matches_the_documented_syntax(),
            9 => fl_io_glob_is_sorted_and_never_follows_a_link(),
            10 => fl_io_glob_roots_at_the_importing_module(),
            11 => fl_io_env_is_the_one_getenv(),
            12 => fl_io_print_needs_no_capability(),
            _ => { assert(false, "unregistered fl_std_io case") },
        }
        print("{names[n]}: PASS")
        ran += 1
    }
    print("fl_std_io: {ran} of 13 cases run")
}
