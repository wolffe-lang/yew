//! search.replace — replacement templates, the substitute plan and its
//! one-transaction apply, and the confirm walk.
//!
//! Ports sagitta `src/search/replace.c` (544 lines) and `replace.h` (125)
//! at 9ace98c2, under `s21-search-replace.md` §4. Two halves that are
//! deliberately separable (`replace.h:6-19`): the expansion is pure (a
//! match plus a template in, bytes out), and the plan finds every match
//! in a range first and the apply edits back to front inside ONE undo
//! transaction, so a confirm run's answers cannot invalidate a later
//! match's offsets and the whole run — one ended with `q` included — is
//! one undo step.
//!
//! The port's shape. C's expansion reads the subject through a
//! `YewReInput` and the match's group spans; the subject of every
//! substitution is the buffer, so the port's walker reads the `TextBuf`
//! and the `ReMatch` (a group that did not take part is -1 where C has
//! `UINT64_MAX`). `&` is a
//! LITERAL ampersand (`replace.h:39-44`), the deliberate divergence from
//! vim and sed. C's `Bytebuf` text is a `List[byte]`; C's `const char *`
//! template is the template's bytes.

use text
use unicode

/// `g`: every match per line (`YEW_SUB_GLOBAL`).
pub const SUB_GLOBAL: int = 1

/// `c`: confirm each (`YEW_SUB_CONFIRM`).
pub const SUB_CONFIRM: int = 2

/// `n`: report, change nothing (`YEW_SUB_COUNT_ONLY`).
pub const SUB_COUNT_ONLY: int = 4

/// `i`: ignore case (`YEW_SUB_ICASE`).
pub const SUB_ICASE: int = 8

/// `I`: match case (`YEW_SUB_CASE`).
pub const SUB_CASE: int = 16

/// `p`: infer the case from the match (`YEW_SUB_PRESERVE`).
pub const SUB_PRESERVE: int = 32

/// `e`: no error when nothing matches (`YEW_SUB_QUIET`).
pub const SUB_QUIET: int = 64

/// A template error (`YewReplErr`): the byte offset into the template and
/// the message; `ok` when there is none.
pub struct ReplErr {
    ok: bool,
    off: int,
    msg: str,
}

/// No error.
pub fn repl_err_none() -> ReplErr {
    ReplErr { ok: true, off: 0, msg: "" }
}

fn repl_fail(off: int, msg: str) -> ReplErr {
    ReplErr { ok: false, off: off, msg: msg }
}

const CASE_NONE: int = 0

const CASE_UP: int = 1

const CASE_DOWN: int = 2

// `Emitter` (`replace.c:27-34`): the `\U`/`\L` span, a pending `\u`/`\l`,
// and the `p` flag's inferred shape.
struct Emitter {
    mode: int,
    one: int,
    forced: int,
    force_first_only: bool,
    seen_cased: bool,
}

fn emitter_new() -> Emitter {
    Emitter {
        mode: CASE_NONE,
        one: CASE_NONE,
        forced: CASE_NONE,
        force_first_only: false,
        seen_cased: false,
    }
}

// `case_one` (`replace.c:36-50`): simple mappings only — a one-to-many
// expansion would change the replacement's length the user did not write.
fn case_one(cp: int, kind: int) -> int {
    let (at, len) = unicode.case_map_span(cp, kind)
    if len == 1 then unicode.case_data_at(at) else cp
}

// Whether `cp` is cased for the walker (`replace.c:57-58`).
fn is_cased(cp: int) -> bool {
    unicode.cat_rec(cp) & (unicode.CAT_UPPER | unicode.CAT_LOWER | unicode.CAT_ALPHA) != 0
}

// `emit_cp` (`replace.c:52-82`): one codepoint with the case state in
// effect; the `p` flag never overrides an explicit `\u`/`\U`.
fn emit_cp(mut e: Emitter, mut out: List[byte], cp_in: int) {
    var cp = cp_in
    var apply = CASE_NONE
    let cased = is_cased(cp)
    if e.one != CASE_NONE {
        apply = e.one
        e.one = CASE_NONE
    } else if e.mode != CASE_NONE {
        apply = e.mode
    } else if e.forced != CASE_NONE {
        if !e.force_first_only {
            apply = e.forced
        } else if cased && !e.seen_cased {
            apply = e.forced
        }
    }
    if cased {
        e.seen_cased = true
    }
    if apply == CASE_UP {
        cp = case_one(cp, unicode.CASE_UPPER)
    } else if apply == CASE_DOWN {
        cp = case_one(cp, unicode.CASE_LOWER)
    }
    let _ = unicode.utf8_encode_into(mut out, cp)
}

// Up to four bytes of the subject at `at`, never past `hi`.
fn subject_window(tb: text.TextBuf, at: int, hi: int) -> List[byte] {
    let end = if hi - at < unicode.UTF8_MAX then hi else at + unicode.UTF8_MAX
    text.textbuf_copy_range(tb, at, end)
}

// `emit_span` (`replace.c:84-110`): subject bytes decoded so the case
// state applies per codepoint.
fn emit_span(mut e: Emitter, mut out: List[byte], tb: text.TextBuf, lo: int, hi: int) {
    var at = lo
    while at < hi {
        let raw = subject_window(tb, at, hi)
        if raw.len == 0 {
            break
        }
        let (cp, used_in) = unicode.utf8_decode(raw, 0, raw.len)
        let used = if used_in == 0 then 1 else used_in
        emit_cp(mut e, mut out, cp)
        at += used
    }
}

// `infer_case` (`replace.c:121-170`): all uppercase needs two or more
// cased characters; Titlecase is one leading capital and the rest lower.
fn infer_case(mut e: Emitter, tb: text.TextBuf, lo: int, hi: int) {
    var at = lo
    var cased = 0
    var upper = 0
    var lower_after_first = 0
    var first_is_upper = false
    while at < hi {
        let raw = subject_window(tb, at, hi)
        if raw.len == 0 {
            break
        }
        let (cp, used_in) = unicode.utf8_decode(raw, 0, raw.len)
        let used = if used_in == 0 then 1 else used_in
        let cat = unicode.cat_rec(cp)
        if cat & (unicode.CAT_UPPER | unicode.CAT_LOWER) != 0 {
            let up = cat & unicode.CAT_UPPER != 0
            if cased == 0 {
                first_is_upper = up
            } else if !up {
                lower_after_first += 1
            }
            cased += 1
            if up {
                upper += 1
            }
        }
        at += used
    }
    if cased >= 2 && upper == cased {
        e.forced = CASE_UP
        return
    }
    if first_is_upper && cased >= 1 && upper == 1 && lower_after_first == cased - 1 {
        e.forced = CASE_UP
        e.force_first_only = true
        return
    }
    e.forced = CASE_NONE
}

fn unknown_escape(tpl: List[byte], i: int) -> str {
    // C prints the escape's one byte (`replace.c:288-293`); a `str`
    // cannot hold half a codepoint, so the port names the whole one.
    let (cp, n) = unicode.utf8_decode(tpl, i, tpl.len)
    var b = List[byte]()
    let _ = unicode.utf8_encode_into(mut b, cp)
    let shown = str_from_utf8(b) else "?"
    let _ = n
    "unknown replacement escape '\\{shown}'"
}

fn group_ref_fail(esc: int) -> ReplErr {
    repl_fail(esc, "replacement refers to a group the pattern does not have")
}

// The one template walker (`repl_walk`, `replace.c:172-299`): with
// `expand` false it only validates, so the grammar the command line checks
// and the one the buffer gets cannot drift.
fn repl_walk(
    mut out: List[byte],
    tpl: List[byte],
    expand: bool,
    tb: text.TextBuf,
    m: ReMatch,
    ngroups: int,
    preserve_case: bool,
) -> ReplErr {
    var e = emitter_new()
    if preserve_case && expand {
        infer_case(mut e, tb, m.lo[0], m.hi[0])
    }
    let tlen = tpl.len
    var i = 0
    while i < tlen {
        let c = tpl[i] as int
        let esc = i
        if c != 92 {
            // `&` lands here: a literal ampersand.
            if expand {
                let (cp, used) = unicode.utf8_decode(tpl, i, tlen)
                emit_cp(mut e, mut out, cp)
                i += if used == 0 then 1 else used
            } else {
                i += 1
            }
            continue
        }
        i += 1
        if i >= tlen {
            return repl_fail(esc, "trailing backslash in replacement")
        }
        let d = tpl[i] as int
        if d >= 48 && d <= 57 {
            let g = d - 48
            i += 1
            if g >= ngroups {
                return group_ref_fail(esc)
            }
            if expand && m.lo[g] >= 0 && m.hi[g] >= m.lo[g] {
                emit_span(mut e, mut out, tb, m.lo[g], m.hi[g])
            }
        } else if d == 123 {
            var g = 0
            let start = i
            var any = false
            i += 1
            while i < tlen && tpl[i] as int >= 48 && tpl[i] as int <= 57 {
                g = g * 10 + (tpl[i] as int - 48)
                any = true
                i += 1
                if g > RE_MAX_GROUPS {
                    break
                }
            }
            if !any || i >= tlen || tpl[i] as int != 125 {
                return repl_fail(start, "expected \\{{N}} group reference")
            }
            i += 1
            if g >= ngroups {
                return group_ref_fail(esc)
            }
            if expand && m.lo[g] >= 0 && m.hi[g] >= m.lo[g] {
                emit_span(mut e, mut out, tb, m.lo[g], m.hi[g])
            }
        } else if d == 110 {
            i += 1
            if expand {
                emit_cp(mut e, mut out, 10)
            }
        } else if d == 116 {
            i += 1
            if expand {
                emit_cp(mut e, mut out, 9)
            }
        } else if d == 114 {
            i += 1
            if expand {
                emit_cp(mut e, mut out, 13)
            }
        } else if d == 92 {
            i += 1
            if expand {
                emit_cp(mut e, mut out, 92)
            }
        } else if d == 117 {
            i += 1
            e.one = CASE_UP
        } else if d == 108 {
            i += 1
            e.one = CASE_DOWN
        } else if d == 85 {
            i += 1
            e.mode = CASE_UP
        } else if d == 76 {
            i += 1
            e.mode = CASE_DOWN
        } else if d == 69 {
            i += 1
            e.mode = CASE_NONE
        } else {
            return repl_fail(esc, unknown_escape(tpl, i))
        }
    }
    repl_err_none()
}

/// Expand `tpl` for match `m` of buffer `tb` onto `out`
/// (`yew_repl_expand`, `replace.c:301-309`).
pub fn repl_expand(
    mut out: List[byte],
    tpl: List[byte],
    tb: text.TextBuf,
    m: ReMatch,
    preserve_case: bool,
) -> ReplErr {
    repl_walk(mut out, tpl, true, tb, m, m.ngroups, preserve_case)
}

/// Validate a template with no match to expand against
/// (`yew_repl_check`, `replace.c:311-317`), so the command line rejects
/// `\q` before touching the buffer.
pub fn repl_check(tpl: List[byte], ngroups: int) -> ReplErr {
    var scratch = List[byte]()
    let tb = text.textbuf_new()
    repl_walk(mut scratch, tpl, false, tb, re_match_new(), ngroups, false)
}

/// One planned edit (`YewReplEdit`): replace `[lo, hi)` with `text`.
pub struct ReplEdit {
    lo: int,
    hi: int,
    text: List[byte],
    line: int,
    accepted: bool,
}

/// A plan (`YewReplPlan`): the edits in buffer order and the distinct
/// lines they touch.
pub struct ReplPlan {
    v: List[ReplEdit],
    lines: int,
}

/// An empty plan (`yew_repl_plan_init`).
pub fn repl_plan_new() -> ReplPlan {
    ReplPlan { v: List[ReplEdit](), lines: 0 }
}

/// Find every match of `re` in lines `[lo, hi]` of `tb` and expand the
/// template for each (`yew_repl_plan_build`, `replace.c:347-447`):
/// without `SUB_GLOBAL` only a line's first match is planned; every
/// entry starts accepted. The engine's window stays the WHOLE buffer
/// while the loop is bounded by the range, so `^`, `\A` and `\b` are
/// measured against the buffer (the Sprint 20 window trap). A zero-width
/// match fires and the scan steps one GRAPHEME past it.
pub fn repl_plan_build(
    re: Re,
    tb: text.TextBuf,
    lo: int,
    hi_in: int,
    tpl: List[byte],
    flags: int,
) -> (bool, ReplPlan, ReplErr) {
    var p = repl_plan_new()
    let nlines = text.textbuf_line_count(tb)
    if nlines == 0 {
        return (true, p, repl_err_none())
    }
    let hi = if hi_in >= nlines then nlines - 1 else hi_in
    if lo > hi {
        return (true, p, repl_err_none())
    }
    let inp = re_input_textbuf(tb)
    let nob = List[byte]()
    let len = text.textbuf_len(tb)
    var at = text.textbuf_line_start(tb, lo as text.LineNo) as int
    let stop = if hi + 1 < nlines {
        text.textbuf_line_start(tb, (hi + 1) as text.LineNo) as int
    } else {
        len
    }
    var have_last_line = false
    var last_line = 0
    var m = re_match_new()
    loop {
        if at > len {
            break
        }
        if !re_search(re, tb, nob, inp, at as text.ByteOff, mut m) {
            break
        }
        if m.lo[0] >= stop {
            break
        }
        let line = text.textbuf_line_of(tb, m.lo[0] as text.ByteOff) as int
        if flags & SUB_GLOBAL == 0 && have_last_line && line == last_line {
            // Without `g` only a line's first match: skip to the next
            // line rather than to the next match.
            if line + 1 >= nlines {
                break
            }
            at = text.textbuf_line_start(tb, (line + 1) as text.LineNo) as int
            continue
        }
        var bytes = List[byte]()
        let err = repl_expand(mut bytes, tpl, tb, m, flags & SUB_PRESERVE != 0)
        if !err.ok {
            return (false, repl_plan_new(), err)
        }
        (mut p.v).push(ReplEdit {
            lo: m.lo[0],
            hi: m.hi[0],
            text: bytes,
            line: line,
            accepted: true,
        })
        if !have_last_line || last_line != line {
            p.lines += 1
        }
        have_last_line = true
        last_line = line
        if m.hi[0] == m.lo[0] {
            let next = text.grapheme_next(tb, m.hi[0] as text.ByteOff) as int
            if next <= m.hi[0] {
                break
            }
            at = next
        } else {
            at = m.hi[0]
        }
    }
    (true, p, repl_err_none())
}

/// Apply the accepted entries back to front inside one transaction
/// (`yew_repl_plan_apply`, `replace.c:449-499`); answers how many. A
/// zero-width entry with an empty template changes nothing and is not
/// counted, so a run of only those opens no empty transaction.
pub fn repl_plan_apply(p: ReplPlan, mut ec: text.EditCtx) -> int {
    if p.v.len == 0 {
        return 0
    }
    var applied = 0
    let own = ec.undo.depth == 0
    if own {
        text.undo_begin(mut ec, text.TXN_REPLACE)
    }
    var i = p.v.len
    while i > 0 {
        let lo = p.v[i - 1].lo
        let hi = p.v[i - 1].hi
        if p.v[i - 1].accepted && !(hi == lo && p.v[i - 1].text.len == 0) {
            if hi > lo && !text.edit_delete(mut ec, text.span(lo, hi)) {
                break
            }
            if p.v[i - 1].text.len > 0 &&
                !text.edit_insert(mut ec, lo as text.ByteOff, p.v[i - 1].text) {
                break
            }
            applied += 1
        }
        i -= 1
    }
    if own {
        text.undo_end(mut ec)
    }
    applied
}

/// The confirm walk (`YewReplConfirm`): the plan's index being asked
/// about and whether the run is over. The plan itself is the caller's
/// (C holds a pointer; the walk reads and writes the plan it is handed).
pub struct ReplConfirm {
    at: int,
    done: bool,
}

/// Begin a confirm walk over `p` (`yew_repl_confirm_begin`,
/// `replace.c:505-519`): nothing is approved until asked.
pub fn repl_confirm_begin(mut p: ReplPlan) -> ReplConfirm {
    var i = 0
    while i < p.v.len {
        p.v[i].accepted = false
        i += 1
    }
    ReplConfirm { at: 0, done: p.v.len == 0 }
}

/// Whether a question is pending (`yew_repl_confirm_pending`).
pub fn repl_confirm_pending(c: ReplConfirm, p: ReplPlan) -> bool {
    !c.done && c.at < p.v.len
}

/// The plan index being asked about, or -1 (`yew_repl_confirm_current`).
pub fn repl_confirm_current(c: ReplConfirm, p: ReplPlan) -> int {
    if repl_confirm_pending(c, p) then c.at else -1
}

/// Answer the pending question (`yew_repl_confirm_answer`,
/// `replace.c:534-577`): y accept, n skip, a accept all remaining, l
/// accept this and stop, q or Esc stop keeping what was approved; false
/// when `key` is not an answer (^E/^Y scroll while deciding).
pub fn repl_confirm_answer(mut c: ReplConfirm, mut p: ReplPlan, key: int) -> bool {
    if !repl_confirm_pending(c, p) {
        return false
    }
    if key == 121 {
        p.v[c.at].accepted = true
        c.at += 1
    } else if key == 110 {
        c.at += 1
    } else if key == 97 {
        var i = c.at
        while i < p.v.len {
            p.v[i].accepted = true
            i += 1
        }
        c.at = p.v.len
    } else if key == 108 {
        p.v[c.at].accepted = true
        c.at = p.v.len
    } else if key == 113 || key == 27 {
        c.at = p.v.len
    } else {
        return false
    }
    if c.at >= p.v.len {
        c.done = true
    }
    true
}
