//! search.literal — the literal prefilter.
//!
//! Ports sagitta `src/search/literal.c` (73 lines) at 9ace98c2, under
//! `s20-regex-engine.md` §7: the Horspool skip table and, past 32 bytes,
//! the KMP failure table a long literal streams through a piece tree
//! with; the find over a flat range searches for the literal's required
//! LAST byte first and confirms each candidate with a full compare (C
//! calls libc's `memchr` and `memcmp`; the port scans the bytes itself,
//! no dependency but wolf-std).

/// The prefilter for `s[at..end)` (`yew_lit_prepare`, `literal.c:6-38`):
/// the bytes copied, the skip table (the last byte excluded: the classic
/// Horspool table), the KMP table past `RE_LIT_SMALL` bytes.
fn lit_prepare(kind: int, s: List[byte], at: int, end: int) -> ReLit {
    let n = end - at
    var bytes = List[byte]()
    var i = at
    while i < end {
        (mut bytes).push(s[i])
        i += 1
    }
    var kmp = List[int]()
    if n > RE_LIT_SMALL {
        (mut kmp).push(0)
        var prefix = 0
        i = 1
        while i < n {
            while prefix != 0 && bytes[prefix] != bytes[i] {
                prefix = kmp[prefix - 1]
            }
            if bytes[prefix] == bytes[i] {
                prefix += 1
            }
            (mut kmp).push(prefix)
            i += 1
        }
    }
    var skip = List[int]()
    i = 0
    while i < 256 {
        (mut skip).push(n)
        i += 1
    }
    i = 0
    while i + 1 < n {
        skip[bytes[i] as int] = n - 1 - i
        i += 1
    }
    var has = List[bool]()
    i = 0
    while i < 256 {
        (mut has).push(false)
        i += 1
    }
    for b in bytes {
        has[b as int] = true
    }
    ReLit { kind: kind, n: n, s: bytes, kmp: kmp, skip: skip, has: has, anchored: false }
}

/// The first occurrence of the literal in `hay[at..end)`, as an offset
/// from `at`, or -1 (`yew_lit_find`, `literal.c:40-73`). C searches for
/// the literal's required LAST byte with libc's vectorized `memchr` and
/// confirms with `memcmp`; the port has neither, and a Horspool walk is
/// latency-bound on its own skip chain (a measured 3.5 GiB/s against
/// memchr's 14), so it filters STRIDE POINTS: every occurrence covers
/// exactly one of the offsets `at + n - 1 + k * n`, holding a byte of the
/// literal there, so a stride point whose byte the literal lacks rules
/// out every start that covers it, and the loop's iterations are
/// independent. Candidates are verified in ascending start order, so the
/// first verified one is the leftmost — C's answer. A literal longer than
/// 32 bytes streams KMP state instead (linear whatever the text).
fn lit_find(l: ReLit, hay: List[byte], at: int, end: int) -> int {
    let n = end - at
    if l.kind == RE_LIT_NONE || l.n == 0 || n < l.n {
        return -1
    }
    let m = l.n
    if m == 1 {
        let want = l.s[0]
        var i = at
        while i < end {
            if hay[i] == want {
                return i - at
            }
            i += 1
        }
        return -1
    }
    if m > RE_LIT_SMALL {
        var matched = 0
        var i = at
        while i < end {
            let b = hay[i]
            while matched != 0 && l.s[matched] != b {
                matched = l.kmp[matched - 1]
            }
            if l.s[matched] == b {
                matched += 1
            }
            if matched == m {
                return i + 1 - m - at
            }
            i += 1
        }
        return -1
    }
    var q = at + m - 1
    while q < end {
        let b = hay[q]
        if l.has[b as int] {
            var j = m - 1
            while j >= 0 {
                let st = q - j
                if l.s[j] == b && st >= at && st + m <= end {
                    var k = 0
                    while k < m && hay[st + k] == l.s[k] {
                        k += 1
                    }
                    if k == m {
                        return st - at
                    }
                }
                j -= 1
            }
        }
        q += m
    }
    -1
}
