//! member: false
//! Sprint 32 §6's runtime error quality: sagitta 9ace98c2
//! tests/unit/test_fl_trace.c:1-245 (7 cases, registry order), over flfix.

use fl
use flfix

fn has(hay: str, needle: str) -> bool {
    if needle.len > hay.len { return false }
    var i = 0
    while i + needle.len <= hay.len {
        if hay[i..i + needle.len] == needle { return true }
        i += 1
    }
    false
}

fn count(hay: str, needle: str) -> int {
    var n = 0
    var i = 0
    while i + needle.len <= hay.len {
        if hay[i..i + needle.len] == needle { n += 1; i += needle.len } else { i += 1 }
    }
    n
}

fn want_line(got: str, needle: str) {
    if !has(got, needle) { eprint("trace missing |{needle}| in:\n{got}") }
    assert(has(got, needle))
}

fn fl_trace_names_every_frame_kind() {
    var f = flfix.open()
    var got = flfix.run_trace(
        mut f,
        "fn named(g) {{ return g() }}\nreturn named(fn() {{ return 1 + \"x\" }})\n",
        3,
    )
    want_line(got, "error: type:")
    want_line(got, "  at <fn> (t.fl:2:")
    want_line(got, "  at named (t.fl:1:")
    want_line(got, "  at <script> (t.fl:2:")
    got = flfix.run_trace(mut f, "return 1 + \"x\"\n", 4)
    want_line(got, "  at <repl> (t.fl:1:")
    got = flfix.run_trace(mut f, "macro m = @[ 2v ]\nreturn m()\n", 3)
    want_line(got, "error: motion:")
    want_line(got, "  at macro m (t.fl:1:")
    want_line(got, "  at <script> (t.fl:2:")
    flfix.close(mut f)
}

fn fl_trace_names_a_module_and_a_native() {
    var f = flfix.open()
    let _ = flfix.tmpdir(mut f)
    flfix.write(mut f, "boom.fl", "fn go() {{ return 1 + \"x\" }}\n")
    var got = flfix.run_trace(
        mut f,
        "import list\nimport \"boom.fl\" as b\nreturn list.map([1], fn(x) {{ return b.go() }})\n",
        3,
    )
    want_line(got, "  at go (")
    want_line(got, "  at <fn> (t.fl:3:")
    want_line(got, "  at <native list.map>")
    want_line(got, "  at <script> (t.fl:3:")
    flfix.write(mut f, "bad.fl", "let x = 1 + \"x\"\n")
    got = flfix.run_trace(mut f, "import \"bad.fl\" as b\nreturn 1\n", 3)
    want_line(got, "  at <module init> (")
    flfix.close(mut f)
}

fn fl_trace_sites_are_the_call_not_the_next_op() {
    var f = flfix.open()
    let got = flfix.run_trace(
        mut f,
        "fn e() {{ return 1 + \"x\" }}\nfn d() {{ return e() }}\nfn c() {{ return d() }}\nfn b() {{ return c() }}\nfn a() {{ return b() }}\nreturn a()\n",
        3,
    )
    want_line(got, "  at e (t.fl:1:19)")
    want_line(got, "  at d (t.fl:2:18)")
    want_line(got, "  at c (t.fl:3:18)")
    want_line(got, "  at b (t.fl:4:18)")
    want_line(got, "  at a (t.fl:5:18)")
    want_line(got, "  at <script> (t.fl:6:9)")
    flfix.close(mut f)
}

fn fl_trace_elides_the_middle_of_a_deep_stack() {
    var f = flfix.open()
    let got = flfix.run_trace(mut f, "fn r(n) {{ return r(n + 1) }}\nreturn r(0)\n", 3)
    want_line(got, "error: limit:")
    want_line(got, "frames elided ...")
    let ats = count(got, "\n  at ")
    if ats != 32 { eprint("printed {ats} frames:\n{got}") }
    assert(ats == 32)
    flfix.close(mut f)
}

fn fl_trace_carets_innermost() {
    var f = flfix.open()
    let got = flfix.run_trace(mut f, "fn f() {{\n    return 1 + \"x\"\n}}\nreturn f()\n", 3)
    want_line(got, "  2 |     return 1 + \"x\"")
    want_line(got, "    |              ^")
    assert(count(got, "^") == 1)
    flfix.close(mut f)
}

fn fl_trace_omits_the_caret_without_source() {
    var f = flfix.open()
    let got = flfix.run_trace(mut f, "return 1 + \"x\"\n", 3)
    want_line(got, "  1 | return 1 + \"x\"")
    // Drop the source out from under it and re-render the same error.
    (mut f.vm.dc.files).reset()
    f.vm.err_caret = ""
    var out = List[byte]()
    fl.fl_trace_render(mut f.vm, fl.fl_nil(), mut out)
    var carets = 0
    for b in out { if b as int == 94 { carets += 1 } }
    assert(carets == 0)
    flfix.close(mut f)
}

fn fl_trace_is_absent_when_a_catch_claims_it() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        "import map\nimport list\ntry {{ let q = 1 + \"x\" }}\ncatch e {{ return list.len(map.keys(e)) }}\n",
        "2",
    )
    flfix.eq(
        mut f,
        "import map\ntry {{ let q = 1 + \"x\" }}\ncatch e {{ return map.has(e, \"trace\") }}\n",
        "false",
    )
    flfix.eq(
        mut f,
        "import map\ntry {{ let q = 1 + \"x\" }}\ncatch e {{ return map.has(e, \"kind\") }}\n",
        "true",
    )
    flfix.close(mut f)
}

fn main() {
    fl_trace_names_every_frame_kind()
    fl_trace_names_a_module_and_a_native()
    fl_trace_sites_are_the_call_not_the_next_op()
    fl_trace_elides_the_middle_of_a_deep_stack()
    fl_trace_carets_innermost()
    fl_trace_omits_the_caret_without_source()
    fl_trace_is_absent_when_a_catch_claims_it()
    print("PASS fl_trace 7")
}
