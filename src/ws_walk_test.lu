//! member: false
//!
//! The port of sagitta `tests/unit/test_walk.c` (837 lines), one test per
//! C test in registry order (`tests/unit/registry.c:2282-2301`):
//! relative paths, regular files only, one level of directory rows,
//! determinism over a deliberately SCRAMBLED creation order, a sliced walk
//! equal to an unsliced one, the symlink loop counted, dotfiles opt-in,
//! `.git` always out, truncation flagged, `max_depth`, a 120-deep tree
//! with no recursion, a missing root, an empty root, the syscall
//! counters, a trailing slash, and §4/§4.1 through the walk — a nested
//! ignore file, a negation blocking the prune, the prune costing one stat
//! and no read (DoD 5), the root's ignore file.
//!
//! The port's shapes: C's `mkdtemp` fixtures `/tmp/yew-walk-XXXXXX` are
//! `/tmp/yew-walk-NNNNNN`; C's `mkfifo(3)` is fs_mkfifo at 0.2.35;
//! a failed fixture is an error, not an uncounted skip. C's test hooks
//! (`yew_walk_counts_reset` then the counts) are the walk's own counters
//! read after it; C's NULL root and NULL list (`test_walk.c:591-594`) have
//! no wolf shape, so the empty root is their half.
//!
//! `YEW_PICK_CASE=N` runs case N alone (the checked machine's per-case
//! run, G29).

use ws

fn b(s: str) -> List[byte] {
    var v = List[byte]()
    for x in s.bytes() {
        (mut v).push(x)
    }
    v
}

// `wk_make` (`test_walk.c:54-58`).
fn wk_make() -> str {
    var tries = 0
    while tries < 100 {
        var suffix = ""
        for r in os_random(6) {
            suffix = suffix + "{r % 10}"
        }
        let dir = "/tmp/yew-walk-{suffix}"
        fs_create_dir_mode(dir, 448) else |e| match e {
            exists => {
                tries += 1
                continue
            },
            denied => { assert(false, "mkdtemp denied") },
            invalid => { assert(false, "mkdtemp invalid") },
            not_found => { assert(false, "mkdtemp not found") },
            unsupported => { assert(false, "mkdtemp unsupported") },
            io => { assert(false, "mkdtemp io") },
        }
        return dir
    }
    assert(false, "mkdtemp exhausted")
    ""
}

// `wk_rm_rf` (`test_walk.c:39-52`): best-effort teardown, never following
// a link (the loop fixtures hold one).
fn wk_remove(root: str) {
    fs_remove_dir_all(root) else |_| {}
}

// `wk_file` (`test_walk.c:72-82`).
fn wk_file(root: str, rel: str) {
    fs_write_bytes("{root}/{rel}", b("x\n")) else |_| {
        assert(false, "write {rel}")
    }
}

// `wk_dir` (`test_walk.c:84-90`).
fn wk_dir(root: str, rel: str) {
    fs_create_dir_mode("{root}/{rel}", 448) else |_| {
        assert(false, "mkdir {rel}")
    }
}

// `wk_walk` (`test_walk.c:93-103`): a walk to completion.
fn wk_walk(root: str, o: ws.WalkOpts) -> ws.WalkState {
    let (ok, st) = ws.walk_begin(root, o)
    assert(ok, "walk_begin {root}")
    var w = st
    while ws.walk_step(mut w, 0) {}
    ws.walk_end(mut w)
    w
}

// `wk_join_paths` (`test_walk.c:106-117`).
fn wk_join_paths(fl: ws.FileList) -> str {
    var out = ""
    for p in fl.paths {
        out = out + p + "\n"
    }
    out
}

// `wk_has` (`test_walk.c:119-128`).
fn wk_has(fl: ws.FileList, rel: str) -> bool {
    for p in fl.paths {
        if p == rel {
            return true
        }
    }
    false
}

// `wk_ignore_file` (`test_walk.c:670-690`).
fn wk_ignore_file(root: str, rel_dir: str, text: str) {
    let path = if rel_dir.len == 0 then "{root}/.gitignore" else "{root}/{rel_dir}/.gitignore"
    fs_write_bytes(path, b(text)) else |_| {
        assert(false, "write {path}")
    }
}

fn opts() -> ws.WalkOpts {
    ws.walk_opts()
}

// `test_walk_lists_files_relative_to_the_root` (`:136-161`).
fn walk_lists_files_relative_to_the_root() {
    let root = wk_make()
    wk_file(root, "a.txt")
    wk_dir(root, "src")
    wk_file(root, "src/main.c")
    wk_dir(root, "src/ui")
    wk_file(root, "src/ui/draw.c")
    let w = wk_walk(root, opts())
    let fl = w.out
    assert(fl.paths.len == 3, "three files: {fl.paths.len}")
    assert(wk_has(fl, "a.txt"), "a.txt")
    assert(wk_has(fl, "src/main.c"), "src/main.c")
    assert(wk_has(fl, "src/ui/draw.c"), "src/ui/draw.c")
    assert(!fl.paths[0].starts_with("/"), "no leading slash")
    assert(!fl.paths[0].contains("/tmp/"), "no absolute prefix")
    assert(fl.n_files == 3, "n_files {fl.n_files}")
    assert(fl.n_dirs == 2, "n_dirs {fl.n_dirs}")
    assert(!fl.truncated, "not truncated")
    wk_remove(root)
}

// `test_walk_lists_only_regular_files` (`:164-186`).
fn walk_lists_only_regular_files() {
    let root = wk_make()
    wk_file(root, "real.txt")
    wk_dir(root, "adir")
    fs_mkfifo("{root}/afifo", 384) else |e| {
        wk_remove(root)
        assert(false, "mkfifo fixture: {e}")
        return
    }
    let w = wk_walk(root, opts())
    assert(w.out.paths.len == 1, "one path: {w.out.paths.len}")
    assert(w.out.paths[0] == "real.txt", "real.txt")
    wk_remove(root)
}

// `test_walk_can_include_one_level_directory_rows` (`:188-217`).
fn walk_can_include_one_level_directory_rows() {
    let root = wk_make()
    wk_dir(root, "sub")
    wk_file(root, "sub/nested.c")
    wk_dir(root, "empty")
    wk_file(root, "root.c")
    var o = opts()
    o.include_dirs = true
    o.max_depth = 1
    let w = wk_walk(root, o)
    let fl = w.out
    assert(fl.paths.len == 3, "three rows: {fl.paths.len}")
    assert(fl.is_dir.len == fl.paths.len, "parallel")
    assert(fl.paths[0] == "empty" && fl.is_dir[0], "empty, a directory")
    assert(fl.paths[1] == "root.c" && !fl.is_dir[1], "root.c, a file")
    assert(fl.paths[2] == "sub" && fl.is_dir[2], "sub, a directory")
    assert(!wk_has(fl, "sub/nested.c"), "one level")
    assert(fl.n_dirs == 2, "n_dirs {fl.n_dirs}")
    assert(fl.n_files == 1, "n_files {fl.n_files}")
    wk_remove(root)
}

// `test_walk_is_deterministic_regardless_of_creation_order` (`:232-278`).
fn walk_is_deterministic_regardless_of_creation_order() {
    let root = wk_make()
    wk_file(root, "mmm.txt")
    wk_file(root, "aaa.txt")
    wk_file(root, "zzz.txt")
    wk_file(root, "bbb.txt")
    wk_dir(root, "zdir")
    wk_file(root, "zdir/two.c")
    wk_file(root, "zdir/one.c")
    wk_dir(root, "adir")
    wk_file(root, "adir/nine.c")
    wk_file(root, "adir/eight.c")
    let first = wk_walk(root, opts())
    let second = wk_walk(root, opts())
    assert(wk_join_paths(first.out) == wk_join_paths(second.out), "byte-identical")
    let p = first.out.paths
    assert(p[0] == "aaa.txt", "0 aaa.txt")
    assert(p[1] == "adir/eight.c", "1 adir/eight.c")
    assert(p[2] == "adir/nine.c", "2 adir/nine.c")
    assert(p[3] == "bbb.txt", "3 bbb.txt")
    assert(p[4] == "mmm.txt", "4 mmm.txt")
    assert(p[5] == "zdir/one.c", "5 zdir/one.c")
    assert(p[6] == "zdir/two.c", "6 zdir/two.c")
    assert(p[7] == "zzz.txt", "7 zzz.txt")
    wk_remove(root)
}

// `test_walk_sliced_equals_unsliced` (`:288-345`).
fn walk_sliced_equals_unsliced() {
    let root = wk_make()
    var i = 0
    while i < 12 {
        let d = if i < 10 then "d0{i}" else "d{i}"
        wk_dir(root, d)
        var k = 0
        while k < 6 {
            wk_file(root, "{d}/f0{k}.c")
            k += 1
        }
        i += 1
    }
    let whole = wk_walk(root, opts())
    let (ok, st) = ws.walk_begin(root, opts())
    assert(ok, "walk_begin")
    var w = st
    var steps = 0
    // A 1 us budget forces a return after essentially every entry.
    while ws.walk_step(mut w, 1) {
        steps += 1
        if steps >= 10000 {
            break
        }
    }
    assert(steps < 10000, "never loops")
    ws.walk_end(mut w)
    assert(steps > 1, "it really was sliced: {steps}")
    assert(whole.out.paths.len == 72, "72 files: {whole.out.paths.len}")
    assert(wk_join_paths(whole.out) == wk_join_paths(w.out), "sliced equals unsliced")
    wk_remove(root)
}

// `test_walk_symlink_loop_terminates_and_is_counted` (`:357-384`).
fn walk_symlink_loop_terminates_and_is_counted() {
    let root = wk_make()
    wk_dir(root, "a")
    wk_file(root, "a/inside.txt")
    fs_symlink("{root}/a", "{root}/a/b") else |_| {
        wk_remove(root)
        return
    }
    var o = opts()
    o.follow_symlinks = true
    let w = wk_walk(root, o)
    assert(w.out.n_loops == 1, "one loop: {w.out.n_loops}")
    assert(wk_has(w.out, "a/inside.txt"), "a/inside.txt")
    assert(w.out.paths.len == 1, "listed once: {w.out.paths.len}")
    wk_remove(root)
}

// `test_walk_does_not_follow_symlinks_by_default` (`:396-418`).
fn walk_does_not_follow_symlinks_by_default() {
    let root = wk_make()
    wk_dir(root, "a")
    wk_file(root, "a/inside.txt")
    fs_symlink("{root}/a", "{root}/a/b") else |_| {
        wk_remove(root)
        return
    }
    let w = wk_walk(root, opts())
    assert(w.out.n_loops == 0, "no loop: {w.out.n_loops}")
    assert(w.out.paths.len == 1, "one path: {w.out.paths.len}")
    assert(wk_has(w.out, "a/inside.txt"), "a/inside.txt")
    wk_remove(root)
}

// `test_walk_hidden_files_are_opt_in` (`:425-450`).
fn walk_hidden_files_are_opt_in() {
    let root = wk_make()
    wk_file(root, "visible.txt")
    wk_file(root, ".hidden")
    wk_dir(root, ".hiddendir")
    wk_file(root, ".hiddendir/inside.txt")
    let w = wk_walk(root, opts())
    assert(w.out.paths.len == 1, "one: {w.out.paths.len}")
    assert(wk_has(w.out, "visible.txt"), "visible.txt")
    var o = opts()
    o.hidden = true
    let h = wk_walk(root, o)
    assert(h.out.paths.len == 3, "three: {h.out.paths.len}")
    assert(wk_has(h.out, ".hidden"), ".hidden")
    assert(wk_has(h.out, ".hiddendir/inside.txt"), ".hiddendir/inside.txt")
    wk_remove(root)
}

// `test_walk_always_skips_dot_git` (`:458-478`).
fn walk_always_skips_dot_git() {
    let root = wk_make()
    wk_file(root, "src.c")
    wk_dir(root, ".git")
    wk_file(root, ".git/config")
    wk_dir(root, ".git/objects")
    wk_file(root, ".git/objects/abc")
    var o = opts()
    o.hidden = true
    let w = wk_walk(root, o)
    assert(w.out.paths.len == 1, "one: {w.out.paths.len}")
    assert(w.out.paths[0] == "src.c", "src.c")
    wk_remove(root)
}

// `test_walk_truncation_is_flagged` (`:481-508`).
fn walk_truncation_is_flagged() {
    let root = wk_make()
    var i = 0
    while i < 20 {
        wk_file(root, if i < 10 then "f0{i}.txt" else "f{i}.txt")
        i += 1
    }
    var o = opts()
    o.max_entries = 5
    let w = wk_walk(root, o)
    assert(w.out.paths.len == 5, "five: {w.out.paths.len}")
    assert(w.out.truncated, "flagged")
    let all = wk_walk(root, opts())
    assert(all.out.paths.len == 20, "twenty: {all.out.paths.len}")
    assert(!all.out.truncated, "not flagged")
    wk_remove(root)
}

// `test_walk_max_depth_bounds_the_descent` (`:511-536`).
fn walk_max_depth_bounds_the_descent() {
    let root = wk_make()
    wk_file(root, "top.txt")
    wk_dir(root, "one")
    wk_file(root, "one/a.txt")
    wk_dir(root, "one/two")
    wk_file(root, "one/two/b.txt")
    wk_dir(root, "one/two/three")
    wk_file(root, "one/two/three/c.txt")
    var o = opts()
    o.max_depth = 2
    let w = wk_walk(root, o)
    assert(wk_has(w.out, "top.txt"), "top.txt")
    assert(wk_has(w.out, "one/a.txt"), "one/a.txt")
    assert(!wk_has(w.out, "one/two/b.txt"), "past the bound")
    assert(!wk_has(w.out, "one/two/three/c.txt"), "past the bound, deeper")
    wk_remove(root)
}

// `test_walk_deep_tree_does_not_recurse` (`:545-577`).
fn walk_deep_tree_does_not_recurse() {
    let root = wk_make()
    var rel = ""
    var i = 0
    while i < 120 {
        rel = if rel.len == 0 then "d" else "{rel}/d"
        fs_create_dir_mode("{root}/{rel}", 448) else |_| {
            break
        }
        i += 1
    }
    var o = opts()
    o.max_depth = 200
    let w = wk_walk(root, o)
    assert(w.out.n_dirs > 100, "completed: {w.out.n_dirs} directories")
    wk_remove(root)
}

// `test_walk_missing_root_is_null` (`:581-595`): the NULL root and NULL
// list rows have no wolf shape (the header); the empty root is theirs.
fn walk_missing_root_is_null() {
    let (ok, _) = ws.walk_begin("/tmp/yew-walk-does-not-exist-xyz", opts())
    assert(!ok, "a missing root")
    let (eok, _) = ws.walk_begin("", opts())
    assert(!eok, "an empty root")
}

// `test_walk_empty_root_is_empty` (`:598-610`).
fn walk_empty_root_is_empty() {
    let root = wk_make()
    let w = wk_walk(root, opts())
    assert(w.out.paths.len == 0, "no paths")
    assert(w.out.n_files == 0, "no files")
    assert(!w.out.truncated, "not truncated")
    wk_remove(root)
}

// `test_walk_counts_syscalls` (`:617-641`): the counters are the walk's
// own, so a fresh walk starts them at zero (C's reset).
fn walk_counts_syscalls() {
    let root = wk_make()
    wk_file(root, "a.txt")
    wk_dir(root, "sub")
    wk_file(root, "sub/b.txt")
    let (ok, st) = ws.walk_begin(root, opts())
    assert(ok, "walk_begin")
    var w = st
    while ws.walk_step(mut w, 0) {}
    ws.walk_end(mut w)
    assert(w.opendirs == 2, "root plus one: {w.opendirs}")
    assert(w.statats >= 3, "one per entry plus the root: {w.statats}")
    let fresh = ws.walk_opts()
    let (_, z) = ws.walk_begin("/tmp/yew-walk-does-not-exist-xyz", fresh)
    assert(z.opendirs == 0 && z.statats == 0, "a refused walk counts nothing")
    wk_remove(root)
}

// `test_walk_root_trailing_slash_is_normalized` (`:644-664`).
fn walk_root_trailing_slash_is_normalized() {
    let root = wk_make()
    wk_file(root, "a.txt")
    let w = wk_walk("{root}/", opts())
    assert(w.out.paths.len == 1, "one: {w.out.paths.len}")
    assert(w.out.paths[0] == "a.txt", "a.txt: {w.out.paths[0]}")
    wk_remove(root)
}

// `test_walk_nested_gitignore_applies_to_its_subtree` (`:815-837`).
fn walk_nested_gitignore_applies_to_its_subtree() {
    let root = wk_make()
    wk_ignore_file(root, "", "*.log\n")
    wk_file(root, "root.log")
    wk_dir(root, "sub")
    wk_ignore_file(root, "sub", "!important.log\n")
    wk_file(root, "sub/important.log")
    wk_file(root, "sub/other.log")
    var o = opts()
    o.use_gitignore = true
    let w = wk_walk(root, o)
    assert(!wk_has(w.out, "root.log"), "root.log")
    assert(wk_has(w.out, "sub/important.log"), "sub/important.log")
    assert(!wk_has(w.out, "sub/other.log"), "sub/other.log")
    wk_remove(root)
}

// `test_walk_descends_when_a_negation_blocks_pruning` (`:783-811`).
fn walk_descends_when_a_negation_blocks_pruning() {
    let root = wk_make()
    wk_ignore_file(root, "", "node_modules/\n!node_modules/keep.js\n")
    wk_file(root, "app.js")
    wk_dir(root, "node_modules")
    wk_file(root, "node_modules/keep.js")
    wk_file(root, "node_modules/other.js")
    var o = opts()
    o.use_gitignore = true
    let w = wk_walk(root, o)
    assert(w.opendirs == 2, "root plus node_modules: {w.opendirs}")
    assert(wk_has(w.out, "app.js"), "app.js")
    assert(wk_has(w.out, "node_modules/keep.js"), "re-included")
    assert(!wk_has(w.out, "node_modules/other.js"), "still out")
    wk_remove(root)
}

// `test_walk_prunes_an_ignored_directory_without_opening_it` (`:732-774`).
fn walk_prunes_an_ignored_directory_without_opening_it() {
    let root = wk_make()
    wk_ignore_file(root, "", "node_modules/\n")
    wk_file(root, "app.js")
    wk_dir(root, "node_modules")
    var i = 0
    while i < 500 {
        let n = if i < 10 then "00{i}" else if i < 100 then "0{i}" else "{i}"
        wk_file(root, "node_modules/pkg{n}.js")
        i += 1
    }
    var o = opts()
    o.use_gitignore = true
    let w = wk_walk(root, o)
    assert(wk_has(w.out, "app.js"), "app.js")
    assert(!wk_has(w.out, "node_modules/pkg000.js"), "pruned")
    assert(w.opendirs == 1, "the root only: {w.opendirs}")
    assert(w.statats < 10, "nothing inside it stat'ed: {w.statats}")
    wk_remove(root)
}

// `test_walk_honours_gitignore` (`:693-721`).
fn walk_honours_gitignore() {
    let root = wk_make()
    wk_ignore_file(root, "", "*.o\nbuild/\n")
    wk_file(root, "main.c")
    wk_file(root, "main.o")
    wk_dir(root, "build")
    wk_file(root, "build/out.bin")
    var o = opts()
    o.use_gitignore = true
    let w = wk_walk(root, o)
    assert(wk_has(w.out, "main.c"), "main.c")
    assert(!wk_has(w.out, "main.o"), "main.o")
    assert(!wk_has(w.out, "build/out.bin"), "build/out.bin")
    assert(w.out.n_ignored > 0, "counted")
    let plain = wk_walk(root, opts())
    assert(wk_has(plain.out, "main.o"), "off by default: main.o")
    assert(wk_has(plain.out, "build/out.bin"), "off by default: build/out.bin")
    wk_remove(root)
}

fn main() {
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    var n = 0
    if chosen < 0 || chosen == 0 {
        walk_lists_files_relative_to_the_root()
        print("walk_lists_files_relative_to_the_root: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 1 {
        walk_lists_only_regular_files()
        print("walk_lists_only_regular_files: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 2 {
        walk_can_include_one_level_directory_rows()
        print("walk_can_include_one_level_directory_rows: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 3 {
        walk_is_deterministic_regardless_of_creation_order()
        print("walk_is_deterministic_regardless_of_creation_order: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 4 {
        walk_sliced_equals_unsliced()
        print("walk_sliced_equals_unsliced: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 5 {
        walk_symlink_loop_terminates_and_is_counted()
        print("walk_symlink_loop_terminates_and_is_counted: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 6 {
        walk_does_not_follow_symlinks_by_default()
        print("walk_does_not_follow_symlinks_by_default: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 7 {
        walk_hidden_files_are_opt_in()
        print("walk_hidden_files_are_opt_in: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 8 {
        walk_always_skips_dot_git()
        print("walk_always_skips_dot_git: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 9 {
        walk_truncation_is_flagged()
        print("walk_truncation_is_flagged: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 10 {
        walk_max_depth_bounds_the_descent()
        print("walk_max_depth_bounds_the_descent: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 11 {
        walk_deep_tree_does_not_recurse()
        print("walk_deep_tree_does_not_recurse: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 12 {
        walk_missing_root_is_null()
        print("walk_missing_root_is_null: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 13 {
        walk_empty_root_is_empty()
        print("walk_empty_root_is_empty: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 14 {
        walk_counts_syscalls()
        print("walk_counts_syscalls: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 15 {
        walk_root_trailing_slash_is_normalized()
        print("walk_root_trailing_slash_is_normalized: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 16 {
        walk_nested_gitignore_applies_to_its_subtree()
        print("walk_nested_gitignore_applies_to_its_subtree: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 17 {
        walk_descends_when_a_negation_blocks_pruning()
        print("walk_descends_when_a_negation_blocks_pruning: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 18 {
        walk_prunes_an_ignored_directory_without_opening_it()
        print("walk_prunes_an_ignored_directory_without_opening_it: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 19 {
        walk_honours_gitignore()
        print("walk_honours_gitignore: PASS")
        n += 1
    }
    print("walk_test: {n} cases pass")
}
