//! member: false
//! The eight tests/unit/test_fl_handle.c cases at sagitta 9ace98c2, in
//! registry order. Resolves through real editor buffers, cursor stamps and
//! marks. C's regex leak detector has no region-free analogue: only its
//! structural ownership assertions are claimed (G33/G54, wolf-lang#948).

use edit
use fl
use search
use text

fn fixture_vm() -> fl.FlVm { var strings = fl.fl_strings(); fl.fl_vm_new(take strings) }

fn fixture_ed() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed
}

fn clear(mut vm: fl.FlVm) { vm.err = fl.fl_nil(); vm.raised = false }

fn error_kind(mut vm: fl.FlVm) -> str {
    if vm.err.t != fl.FL_MAP { return "" }
    let key = fl.fl_str_text(mut vm, "kind")
    let value = fl.fl_map_get(vm, vm.err, key) else { return "" }
    str_from_utf8(vm.gc.slots[fl.fl_obj_index(vm, value)].bytes) else ""
}

fn resolve(mut vm: fl.FlVm, mut ed: edit.Ed, kind: int, h: fl.FlValue) -> str {
    clear(mut vm)
    let ok = match kind {
        1 => (edit.fl_h_buf(mut vm, ed, h) else -1) >= 0,
        2 => { let (w, _) = edit.fl_h_cur(mut vm, mut ed, h) else (-1, -1); w >= 0 },
        3 => { let (b, _, _) = edit.fl_h_span(mut vm, ed, h) else (-1, -1, -1); b >= 0 },
        4 => (edit.fl_h_win(mut vm, ed, h) else -1) >= 0,
        5 => (edit.fl_h_re(mut vm, ed, h) else -1) >= 0,
        _ => { assert(false); false },
    }
    if ok then "" else error_kind(mut vm)
}

fn synthetic(mut ed: edit.Ed, kind: int) -> fl.FlValue {
    var p = fl.fl_h_payload_new()
    p.buf = 4242
    p.win = 4242
    fl.fl_h_make(mut ed.handles, kind, p)
}

fn regex(mut ed: edit.Ed, pat: str) -> fl.FlValue {
    var err = search.re_err_new()
    let re = search.re_compile_str(pat, 0, mut err) else { assert(false); return fl.fl_nil() }
    edit.fl_h_re_make(mut ed, take re)
}

fn fl_handle_dead_matrix_free_and_reuse_all_kinds() {
    var vm = fixture_vm()
    var ed = fixture_ed()
    for kind in 1..6 {
        let h = synthetic(mut ed, kind)
        assert(fl.fl_h_is(h) && fl.fl_h_kind_of(h) == kind && fl.fl_h_alive(ed.handles, h))
        assert(edit.fl_h_free(mut ed, h))
        assert(!fl.fl_h_alive(ed.handles, h))
        assert(resolve(mut vm, mut ed, kind, h) == "handle")
        assert(!edit.fl_h_free(mut ed, h))
        let reused = synthetic(mut ed, kind)
        assert(fl.fl_h_decode(reused).slot == fl.fl_h_decode(h).slot)
        assert(fl.fl_h_alive(ed.handles, reused) && !fl.fl_h_alive(ed.handles, h))
        assert(resolve(mut vm, mut ed, kind, h) == "handle")
        assert(edit.fl_h_free(mut ed, reused))
    }
}

fn fl_handle_dead_matrix_object_close() {
    var vm = fixture_vm()
    var ed = fixture_ed()
    let bi = edit.ed_doc(ed)
    let wi = ed.win
    let hb = edit.fl_h_buf_make(mut ed, bi)
    let hw = edit.fl_h_win_make(mut ed, wi)
    let hc = edit.fl_h_cur_make(mut ed, wi, 0)
    let hs = edit.fl_h_span_make(mut ed, bi, 0, 0)
    assert(resolve(mut vm, mut ed, 1, hb) == "")
    assert(resolve(mut vm, mut ed, 4, hw) == "")
    assert(resolve(mut vm, mut ed, 2, hc) == "")
    assert(resolve(mut vm, mut ed, 3, hs) == "")
    let wid = ed.wins[wi].id
    edit.fl_h_drop_window(mut ed, wid)
    assert(resolve(mut vm, mut ed, 4, hw) == "handle")
    assert(resolve(mut vm, mut ed, 2, hc) == "handle")
    let bid = ed.bufs[bi].id
    edit.fl_h_drop_buffer(mut ed, bid)
    assert(resolve(mut vm, mut ed, 1, hb) == "handle")
    assert(resolve(mut vm, mut ed, 3, hs) == "handle")
    let hr = regex(mut ed, "a+")
    assert(resolve(mut vm, mut ed, 5, hr) == "")
    assert(edit.fl_h_free(mut ed, hr))
    assert(resolve(mut vm, mut ed, 5, hr) == "handle")
    for kind in [1, 4] {
        let orphan = synthetic(mut ed, kind)
        assert(fl.fl_h_alive(ed.handles, orphan))
        assert(resolve(mut vm, mut ed, kind, orphan) == "handle")
    }
}

fn random(mut state: wrapping[u64]) -> wrapping[u64] {
    state = state ^ state >> 12
    state = state ^ state << 25
    state = state ^ state >> 27
    state * 2685821657736338717
}

fn deleted(pos: int, at: int, n: int) -> int {
    if pos < at then pos else if pos < at + n then at else pos - n
}

fn prepare_marks(mut ed: edit.Ed, bi: int, seed: str) {
    ed.bufs[bi].ec.has_undo = false
    ed.bufs[bi].ec.has_cset = false
    ed.bufs[bi].ec.change_hook = false
    assert(text.edit_insert_str(mut ed.bufs[bi].ec, 0 as text.ByteOff, seed))
}

fn fl_handle_span_tracks_1000_random_edits() {
    var vm = fixture_vm()
    var ed = fixture_ed()
    let bi = edit.ed_doc(ed)
    prepare_marks(mut ed, bi, "x".repeat(256))
    var lo: int = 64
    var hi: int = 192
    var len: int = 256
    let hs = edit.fl_h_span_make(mut ed, bi, lo, hi)
    var state: wrapping[u64] = 0xa0761d6478bd642f
    for i in 0..1000 {
        let insert = len == 0 || random(mut state) & 1 != 0
        if insert {
            let at = if i % 17 == 0 {
                lo
            } else if i % 19 == 0 {
                hi
            } else {
                (random(mut state) % (len + 1) as wrapping[u64]) as int
            }
            let n = 1 + (random(mut state) % 8) as int
            var bytes = List[byte]()
            for _ in 0..n { (mut bytes).push(i as byte) }
            assert(text.edit_insert(mut ed.bufs[bi].ec, at as text.ByteOff, bytes))
            if at < lo { lo += n }
            if at <= hi { hi += n }
            len += n
        } else {
            let at = (random(mut state) % len as wrapping[u64]) as int
            let wanted = 1 + (random(mut state) % (len - at) as wrapping[u64]) as int
            let n = if wanted > 8 then 8 else wanted
            assert(text.edit_delete(mut ed.bufs[bi].ec, text.span(at, at + n)))
            lo = deleted(lo, at, n)
            hi = deleted(hi, at, n)
            if lo > hi { lo = hi }
            len -= n
        }
        clear(mut vm)
        let (b, a, z) = edit.fl_h_span(mut vm, ed, hs) else { assert(false); return }
        assert(b == bi && a == lo && z == hi && z <= len)
    }
    let p = copy ed.handles.slots[fl.fl_h_decode(hs).slot].payload
    assert(edit.fl_h_free(mut ed, hs))
    assert(!text.mark_alive(ed.bufs[bi].ec.marks, text.MarkId { id: p.lo_id, gen: p.lo_gen }))
    assert(!text.mark_alive(ed.bufs[bi].ec.marks, text.MarkId { id: p.hi_id, gen: p.hi_gen }))
}

fn fl_handle_collapsed_span_resolves_zero_length() {
    var vm = fixture_vm()
    var ed = fixture_ed()
    let bi = edit.ed_doc(ed)
    prepare_marks(mut ed, bi, "0123456789")
    let hs = edit.fl_h_span_make(mut ed, bi, 2, 8)
    assert(text.edit_delete(mut ed.bufs[bi].ec, text.span(1, 9)))
    let (b, lo, hi) = edit.fl_h_span(mut vm, ed, hs) else { assert(false); return }
    assert(b == bi && lo == 1 && hi == 1 && hi - lo == 0)
}

fn fl_handle_regex_10000_cycles_keep_ownership_bounded() {
    var vm = fixture_vm()
    var ed = fixture_ed()
    var slot = -1
    for i in 0..10000 {
        let h = regex(mut ed, "a(b|c)*z")
        let at = fl.fl_h_decode(h).slot
        if i == 0 { slot = at }
        assert(at == slot)
        assert((edit.fl_h_re(mut vm, ed, h) else -1) == 0)
        assert(ed.handles.live == 1)
        assert(edit.fl_h_free(mut ed, h))
        assert(ed.handles.live == 0 && ed.handles.slots.len == 1)
        assert(ed.handles.slots[slot].payload.regex_slot == -1)
        assert(ed.handle_regex.len == 1 && !ed.handle_regex[0].live)
        assert(ed.handle_regex[0].re.prog.len == 0)
    }
}

fn fl_handle_wrong_kind_is_a_type_error() {
    var vm = fixture_vm()
    var ed = fixture_ed()
    let bi = edit.ed_doc(ed)
    let hb = edit.fl_h_buf_make(mut ed, bi)
    assert(resolve(mut vm, mut ed, 4, hb) == "type")
    assert(resolve(mut vm, mut ed, 5, hb) == "type")
    assert(resolve(mut vm, mut ed, 1, fl.fl_nil()) == "type")
}

fn fl_handle_generation_wraparound_retires_the_slot() {
    var ed = fixture_ed()
    let first = synthetic(mut ed, fl.FL_H_BUF)
    let doomed = fl.fl_h_decode(first).slot
    assert(edit.fl_h_free(mut ed, first))
    ed.handles.slots[doomed].gen = 4294967295
    let h = synthetic(mut ed, fl.FL_H_BUF)
    assert(fl.fl_h_decode(h).slot == doomed && fl.fl_h_decode(h).gen == 4294967295)
    assert(edit.fl_h_free(mut ed, h))
    assert(!fl.fl_h_alive(ed.handles, h))
    let next = synthetic(mut ed, fl.FL_H_BUF)
    assert(fl.fl_h_decode(next).slot != doomed && fl.fl_h_alive(ed.handles, next))
    assert(edit.fl_h_free(mut ed, next))
}

fn fl_handle_drop_buffer_releases_spans() {
    var vm = fixture_vm()
    var ed = fixture_ed()
    let bi = edit.ed_doc(ed)
    let wi = ed.win
    let hs = edit.fl_h_span_make(mut ed, bi, 0, 0)
    let hb = edit.fl_h_buf_make(mut ed, bi)
    let hw = edit.fl_h_win_make(mut ed, wi)
    let hc = edit.fl_h_cur_make(mut ed, wi, 0)
    assert(ed.handles.live == 4)
    for _ in 0..100000 {
        assert(edit.fl_h_span_make(mut ed, bi, 0, 0).i == hs.i)
        assert(edit.fl_h_buf_make(mut ed, bi).i == hb.i)
        assert(edit.fl_h_win_make(mut ed, wi).i == hw.i)
        assert(edit.fl_h_cur_make(mut ed, wi, 0).i == hc.i)
    }
    assert(ed.handles.live == 4 && ed.handles.slots.len == 4)
    assert(text.cset_add(mut ed.wins[wi].cs, text.cursor_at(20 as text.ByteOff)))
    let moved = edit.fl_h_cur_make(mut ed, wi, 1)
    assert(text.cset_add(mut ed.wins[wi].cs, text.cursor_at(10 as text.ByteOff)))
    let removed = edit.fl_h_cur_make(mut ed, wi, 1)
    let (w, c) = edit.fl_h_cur(mut vm, mut ed, moved) else { assert(false); return }
    assert(ed.wins[w].cs.curs[c].pos == 20)
    assert(fl.fl_h_decode(moved).slot == fl.fl_h_decode(edit.fl_h_cur_make(mut ed, wi, 2)).slot)
    assert(text.cset_drop_latest(mut ed.wins[wi].cs))
    assert(resolve(mut vm, mut ed, 2, removed) == "handle")
    assert(text.cset_add(mut ed.wins[wi].cs, text.cursor_at(10 as text.ByteOff)))
    assert(resolve(mut vm, mut ed, 2, removed) == "handle")
    let id = ed.bufs[bi].id
    edit.fl_h_drop_buffer(mut ed, id)
    assert(!fl.fl_h_alive(ed.handles, hs) && !fl.fl_h_alive(ed.handles, hb))
    assert(resolve(mut vm, mut ed, 3, hs) == "handle")
}

fn main() {
    let chosen = (env_get("YEW_FL_HANDLE_CASE") else "-1").to_int() else -1
    if chosen < 0 || chosen == 0 {
        fl_handle_dead_matrix_free_and_reuse_all_kinds()
        print("fl_handle_dead_matrix_free_and_reuse_all_kinds: PASS")
    }
    if chosen < 0 || chosen == 1 {
        fl_handle_dead_matrix_object_close()
        print("fl_handle_dead_matrix_object_close: PASS")
    }
    if chosen < 0 || chosen == 2 {
        fl_handle_span_tracks_1000_random_edits()
        print("fl_handle_span_tracks_1000_random_edits: PASS")
    }
    if chosen < 0 || chosen == 3 {
        fl_handle_collapsed_span_resolves_zero_length()
        print("fl_handle_collapsed_span_resolves_zero_length: PASS")
    }
    if chosen < 0 || chosen == 4 {
        fl_handle_regex_10000_cycles_keep_ownership_bounded()
        print("fl_handle_regex_10000_cycles_keep_ownership_bounded: PASS")
    }
    if chosen < 0 || chosen == 5 {
        fl_handle_wrong_kind_is_a_type_error()
        print("fl_handle_wrong_kind_is_a_type_error: PASS")
    }
    if chosen < 0 || chosen == 6 {
        fl_handle_generation_wraparound_retires_the_slot()
        print("fl_handle_generation_wraparound_retires_the_slot: PASS")
    }
    if chosen < 0 || chosen == 7 {
        fl_handle_drop_buffer_releases_spans()
        print("fl_handle_drop_buffer_releases_spans: PASS")
    }
    if chosen < 0 { print("fl_handle: 8 pinned cases PASS; regex reclamation remains G33/G54") }
}
