//! member: false
//! Ports sagitta tests/unit/test_syn_state.c at 9ace98c2, one case per C test
//! in its order. The ninth reads the language detector and the registry's
//! load slot, with the definition's source read by the test.

use syn

fn frames_def(state: syn.SynState, def: int) -> bool {
    for i in 0..syn.syn_state_depth(state) {
        if syn.syn_state_def(state, i) != def then return false
    }
    true
}

// test_syn_state_root_is_reserved_and_canonical
fn root_is_reserved_and_canonical() {
    var tab = syn.syn_state_tab_new(7)
    assert(!syn.syn_state_has(tab, syn.SYN_STATE_UNKNOWN), "UNKNOWN has no tuple")
    let root = syn.syn_state_get(tab, syn.SYN_STATE_ROOT) else {
        assert(false, "ROOT exists")
        return
    }
    assert(syn.syn_state_depth(root) == 1, "root depth")
    assert(syn.syn_state_ndef(root) == 1, "root definition depth")
    assert(syn.syn_state_ctx(root, 0) == 7, "root context")
    assert(syn.syn_state_def(root, 0) == 0, "root definition")
    assert(syn.syn_state_lost(root) == 0, "root debt")
    let copy_of = copy root
    assert(syn.syn_state_intern(mut tab, copy_of) == syn.SYN_STATE_ROOT, "root interns as ROOT")
    assert(syn.syn_state_count(tab) == 2, "UNKNOWN and ROOT only")
}

// test_syn_state_equal_tuples_share_identity
fn equal_tuples_share_identity() {
    var tab = syn.syn_state_tab_new(0)
    var state = syn.syn_state_root(0, 0)
    syn.syn_state_set_aux(mut state, 0, 91)
    syn.syn_state_set_flags(mut state, syn.SYN_F_VALUE)
    let first = syn.syn_state_intern(mut tab, state)
    assert(first > syn.SYN_STATE_ROOT, "a new id")
    for _ in 0..40 {
        assert(syn.syn_state_intern(mut tab, state) == first, "equal tuples share an id")
    }
    assert(syn.syn_state_count(tab) == 3, "one new tuple")
}

// test_syn_state_different_tuples_have_different_identities
fn different_tuples_have_different_identities() {
    var tab = syn.syn_state_tab_new(0)
    var state = syn.syn_state_root(0, 0)
    var ids = List[int]()
    for i in 0..40 {
        syn.syn_state_set_aux(mut state, 0, i + 1)
        let id = syn.syn_state_intern(mut tab, state)
        assert(id > syn.SYN_STATE_ROOT, "a new id")
        for earlier in ids {
            assert(id != earlier, "distinct tuples, distinct ids")
        }
        (mut ids).push(id)
    }
    assert(syn.syn_state_count(tab) == 42, "forty new tuples")
}

// test_syn_state_depth_cap_balances_refused_pushes
fn depth_cap_balances_refused_pushes() {
    var state = syn.syn_state_root(0, 2)
    let entry = copy state
    for i in 0..40 { syn.syn_state_push(mut state, i + 1) }
    assert(syn.syn_state_depth(state) == syn.SYN_DEPTH_MAX, "depth capped")
    assert(syn.syn_state_lost(state) == 40 - (syn.SYN_DEPTH_MAX - 1), "refused pushes counted")
    assert(frames_def(state, 2), "pushes inherit the definition")
    for _ in 0..40 { syn.syn_state_pop(mut state, 1) }
    assert(syn.syn_state_equal(state, entry), "balanced pops restore the entry tuple")
}

// test_syn_state_lost_saturates_and_marks_degraded
fn lost_saturates_and_marks_degraded() {
    var state = syn.syn_state_root(0, 0)
    for i in 1..syn.SYN_DEPTH_MAX { syn.syn_state_push(mut state, i) }
    for _ in 0..300 { syn.syn_state_push(mut state, 99) }
    assert(syn.syn_state_depth(state) == syn.SYN_DEPTH_MAX, "depth capped")
    assert(syn.syn_state_lost(state) == 255, "debt saturates at YEW_SYN_LOST_MAX")
    assert(syn.syn_state_flags(state) & syn.SYN_F_DEGRADED != 0, "saturation degrades")
    syn.syn_state_pop(mut state, 4)
    assert(syn.syn_state_lost(state) == 251, "pops pay debt first")
    assert(syn.syn_state_depth(state) == syn.SYN_DEPTH_MAX, "frames kept while debt remains")
}

// test_syn_state_pop_never_removes_root
fn pop_never_removes_root() {
    var state = syn.syn_state_root(17, 3)
    syn.syn_state_set_aux(mut state, 0, 12)
    syn.syn_state_set_flags(mut state, syn.SYN_F_VALUE)
    let entry = copy state
    syn.syn_state_pop(mut state, 1)
    assert(syn.syn_state_equal(state, entry), "one pop keeps the root")
    syn.syn_state_pop(mut state, 4)
    assert(syn.syn_state_equal(state, entry), "four pops keep the root")
}

// test_syn_state_set_replaces_top_without_changing_depth
fn set_replaces_top_without_changing_depth() {
    var state = syn.syn_state_root(3, 2)
    syn.syn_state_push(mut state, 4)
    syn.syn_state_push(mut state, 5)
    syn.syn_state_set_frame_flags(mut state, 2, syn.SYN_FR_BRIDGE)
    syn.syn_state_set(mut state, 77)
    assert(syn.syn_state_depth(state) == 3, "depth unchanged")
    assert(
        syn.syn_state_ctx(state, 0) == 3 && syn.syn_state_ctx(state, 1) == 4,
        "lower frames kept",
    )
    assert(syn.syn_state_ctx(state, 2) == 77, "top replaced")
    assert(syn.syn_state_def(state, 2) == 2, "qualification kept")
    assert(syn.syn_state_frame_flags(state, 2) == syn.SYN_FR_BRIDGE, "bridge flag kept")
    syn.syn_state_pop(mut state, 1)
    assert(
        syn.syn_state_ctx(state, 2) == 0 &&
            syn.syn_state_def(state, 2) == 0 &&
            syn.syn_state_frame_flags(state, 2) == 0,
        "a popped frame is zeroed",
    )
}

// test_syn_state_table_exhaustion_degrades_to_root
fn table_exhaustion_degrades_to_root() {
    var tab = syn.syn_state_tab_new(0)
    var state = syn.syn_state_root(0, 0)
    var last = 0
    for i in 1..syn.SYN_MAX_STATES + 8 {
        syn.syn_state_set_aux(mut state, 0, i)
        last = syn.syn_state_intern(mut tab, state)
    }
    assert(tab.exhausted, "exhaustion reported")
    assert(syn.syn_state_count(tab) == syn.SYN_MAX_STATES, "bounded at YEW_SYN_MAX_STATES")
    assert(last == syn.SYN_STATE_ROOT, "an exhausted intern degrades to ROOT")
    assert(syn.syn_state_has(tab, syn.SYN_STATE_ROOT), "ROOT survives")
}

// test_syn_deferred_surfaces_fail_loudly: an unknown extension detects no
// language; `.ini` detects ini, whose definition loads by that language
// (its source is the pinned file, read here: the registry does no I/O).
fn deferred_surfaces_fail_loudly() {
    var reg = syn.syn_registry_new()
    var pool = syn.syn_pool_new()
    assert(syn.syn_registry_lang_for(mut reg, "example.xyz", List[byte](), false) == 0, "unknown extension")
    let ini = syn.syn_registry_lang_for(mut reg, "example.ini", List[byte](), false)
    assert(ini != 0, "ini detected by extension")
    let source = fs_read_bytes("tests/fixtures/syn/ini.fl") else {
        assert(false, "ini fixture readable")
        return
    }
    let program = syn.syn_registry_load(mut reg, mut pool, ini, "tests/fixtures/syn/ini.fl", source)
    assert(program >= 0, "ini definition loads")
    assert(syn.syn_registry_def_for(reg, ini) == program, "the loaded definition is the language's")
    let name = str_from_utf8(copy pool.programs[program].name) else ""
    assert(name == "ini", "definition name")
}

fn main() {
    let selected = (env_get("YEW_SYN_STATE_CASE") else "-1").to_int() else -1
    for i in 0..9 {
        if selected == -1 || selected == i {
            match i {
                0 => root_is_reserved_and_canonical(),
                1 => equal_tuples_share_identity(),
                2 => different_tuples_have_different_identities(),
                3 => depth_cap_balances_refused_pushes(),
                4 => lost_saturates_and_marks_degraded(),
                5 => pop_never_removes_root(),
                6 => set_replaces_top_without_changing_depth(),
                7 => table_exhaustion_degrades_to_root(),
                _ => deferred_surfaces_fail_loudly(),
            }
            print("syn_state_case_{i}: PASS")
        }
    }
}
