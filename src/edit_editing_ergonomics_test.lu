//! member: false
//! Editing comfort regressions. Context rules and line transposition are
//! yew's own; selection transactions reuse sagitta src/edit/sel_actions.c
//! and caret conversion uses its src/text/coords.c padded form.

use edit
use term
use text

fn fixture_for(s: str, configured: bool) -> edit.Ed {
    var ed = if configured {
        let runtime = fs_read_bytes("runtime/init.fl") else List[byte]()
        assert(runtime.len != 0, "runtime readable")
        edit.ed_new_test(runtime, "")
    } else {
        var plain = edit.ed_new()
        edit.ed_open_scratch(mut plain)
        plain
    }
    let b = ed.wins[ed.win].buf
    let bytes = s.bytes()
    ed.bufs[b].ec.tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    ed.bufs[b].ec.undo = text.undo_new(ed.bufs[b].ec.tb)
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    edit.ed_layout(mut ed)
    ed
}

fn fixture(s: str) -> edit.Ed { fixture_for(s, true) }

fn at(mut ed: edit.Ed, pos: int) {
    let w = ed.win
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].pos = pos
    ed.wins[w].cs.curs[p].anchor = pos
}

fn pos(ed: edit.Ed) -> int {
    ed.wins[ed.win].cs.curs[ed.wins[ed.win].cs.primary].pos
}

fn press(mut ed: edit.Ed, code: int, mods: int) {
    var k = term.key_new()
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    k.code = code
    k.mods = mods
    if code >= 32 && code < 127 && mods == 0 { (mut k.text).push(code as byte) }
    edit.ed_handle_key(mut ed, k, 1000)
}

fn contents(ed: edit.Ed, expected: str) {
    let b = ed.wins[ed.win].buf
    let got = text.textbuf_bytes(ed.bufs[b].ec.tb)
    let want = expected.bytes()
    assert(got.len == want.len, "expected {expected}, got {got}")
    for i in 0..got.len { assert(got[i] == want[i], "byte {i}: expected {expected}, got {got}") }
}

fn decision(mut ed: edit.Ed, seed: str, p: int, ch: int, action: int) {
    let b = ed.wins[ed.win].buf
    let bytes = seed.bytes()
    ed.bufs[b].ec.tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    ed.bufs[b].pairs = edit.pairstate_new()
    let (got, _) = edit.pairs_decide(mut ed.bufs[b], true, p, ch)
    assert(got == action, "pair at {p} key {ch} in {seed}: {got}, wanted {action}")
}

fn backtick() {
    var ed = fixture("")
    decision(mut ed, "", 0, 96, edit.PAIR_CLOSE)
    let _ = edit.mode_enter(mut ed, edit.MODE_I)
    press(mut ed, 96, 0)
    press(mut ed, term.KEY_BACKSPACE, 0)
    contents(ed, "")
}

fn quote_balance() {
    var ed = fixture_for("", false)
    decision(mut ed, "\"", 1, 34, edit.PAIR_LITERAL)
    decision(mut ed, "\"a ", 3, 34, edit.PAIR_LITERAL)
    decision(mut ed, "'", 1, 39, edit.PAIR_LITERAL)
    decision(mut ed, "`a ", 3, 96, edit.PAIR_LITERAL)
    decision(mut ed, "\\\"", 2, 34, edit.PAIR_CLOSE)
    decision(mut ed, "\\", 1, 34, edit.PAIR_LITERAL)
    decision(mut ed, "\"\" ", 3, 34, edit.PAIR_CLOSE)
    decision(mut ed, "don't ", 6, 39, edit.PAIR_CLOSE)
}

fn right_context() {
    var ed = fixture_for("", false)
    for ch in [40, 91, 123, 34, 39, 96] {
        decision(mut ed, "text", 0, ch, edit.PAIR_LITERAL)
        decision(mut ed, ".text", 0, ch, edit.PAIR_CLOSE)
    }
    decision(mut ed, " text)", 0, 40, edit.PAIR_LITERAL)
    decision(mut ed, " text]", 0, 91, edit.PAIR_LITERAL)
    decision(mut ed, " text}}", 0, 123, edit.PAIR_LITERAL)
    decision(mut ed, " ()", 0, 40, edit.PAIR_CLOSE)
    decision(mut ed, "\n)", 0, 40, edit.PAIR_CLOSE)
    decision(mut ed, "don", 3, 39, edit.PAIR_LITERAL)
}

fn dedent() {
    var ed = fixture("    abc\n    def\n")
    let _ = edit.mode_enter(mut ed, edit.MODE_I)
    at(mut ed, 6)
    press(mut ed, term.KEY_TAB, term.MOD_SHIFT)
    contents(ed, "abc\n    def\n")
    assert(pos(ed) == 2 && ed.mode == edit.MODE_I, "retain caret and Insert")
    press(mut ed, 122, term.MOD_CTRL)
    contents(ed, "    abc\n    def\n")
    at(mut ed, 0)
    press(mut ed, term.KEY_DOWN, term.MOD_SHIFT)
    press(mut ed, term.KEY_DOWN, term.MOD_SHIFT)
    press(mut ed, term.KEY_TAB, term.MOD_SHIFT)
    contents(ed, "abc\ndef\n")
    assert(ed.mode == edit.MODE_H, "retain selection")
    press(mut ed, term.KEY_TAB, term.MOD_SHIFT)
    contents(ed, "abc\ndef\n")
}

fn undo_keys() {
    var ed = fixture("")
    let _ = edit.mode_enter(mut ed, edit.MODE_I)
    press(mut ed, 97, 0)
    press(mut ed, 98, 0)
    press(mut ed, 122, term.MOD_CTRL)
    contents(ed, "")
    assert(ed.mode == edit.MODE_I, "undo stays Insert")
    press(mut ed, 122, term.MOD_CTRL | term.MOD_SHIFT)
    contents(ed, "ab")
    press(mut ed, 122, term.MOD_CTRL)
    press(mut ed, 47, term.MOD_ALT)
    contents(ed, "ab")
}

fn move_lines() {
    var ed = fixture("aa\nbb\ncc")
    let _ = edit.mode_enter(mut ed, edit.MODE_I)
    at(mut ed, 4)
    press(mut ed, term.KEY_DOWN, term.MOD_ALT)
    contents(ed, "aa\ncc\nbb")
    assert(pos(ed) == 7 && ed.mode == edit.MODE_I, "move caret with line")
    press(mut ed, 122, term.MOD_CTRL)
    contents(ed, "aa\nbb\ncc")
    press(mut ed, 47, term.MOD_ALT)
    contents(ed, "aa\ncc\nbb")
    press(mut ed, term.KEY_UP, term.MOD_ALT)
    contents(ed, "aa\nbb\ncc")
    at(mut ed, 0)
    press(mut ed, term.KEY_UP, term.MOD_ALT)
    contents(ed, "aa\nbb\ncc")
}

fn move_selection() {
    var ed = fixture("aa\nbb\ncc\ndd")
    let _ = edit.mode_enter(mut ed, edit.MODE_I)
    press(mut ed, term.KEY_DOWN, term.MOD_SHIFT)
    press(mut ed, term.KEY_DOWN, term.MOD_SHIFT)
    invoke(mut ed, "ed.edit.lines.down")
    contents(ed, "cc\naa\nbb\ndd")
    assert(ed.mode == edit.MODE_H, "selected lines stay selected")
    invoke(mut ed, "ed.edit.lines.down")
    contents(ed, "cc\ndd\naa\nbb")
}

fn mouse_end() {
    for seed in ["}}", "x", "long}}", "漢é", "e\u{301}", "}}\n", "x\r\n", ""] {
        var ed = fixture_for(seed, false)
        let w = ed.win
        edit.win_click_to_cursor(mut ed, w, ed.wins[w].rect.x + 30, ed.wins[w].rect.y)
        let expected = if seed.ends_with("\r\n") {
            seed.len - 2
        } else if seed.ends_with("\n") {
            seed.len - 1
        } else {
            seed.len
        }
        assert(pos(ed) == expected, "click past {seed}: {pos(ed)}, wanted {expected}")
    }
}

fn invoke(mut ed: edit.Ed, name: str) {
    let id = edit.cmd_lookup(ed.reg, name)
    assert(id != 0, "registered {name}")
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    assert(edit.ed_cmd_invoke(mut ed, id, mut cx) == edit.CMD_OK, name)
}

fn move_multiple_cursors() {
    var ed = fixture("aa\nbb\ncc\ndd")
    let w = ed.win
    assert(text.cset_add(mut ed.wins[w].cs, text.cursor_at(6 as text.ByteOff)), "second cursor")
    invoke(mut ed, "ed.edit.lines.down")
    contents(ed, "bb\naa\ndd\ncc")
    text.cset_check(ed.wins[w].cs)
    assert(ed.wins[w].cs.curs.len == 2, "both cursors survive replacement")
    assert(
        ed.wins[w].cs.curs[0].pos == 3 && ed.wins[w].cs.curs[1].pos == 9,
        "each cursor follows its line",
    )
    invoke(mut ed, "ed.edit.undo")
    contents(ed, "aa\nbb\ncc\ndd")
    text.cset_check(ed.wins[w].cs)
    assert(ed.wins[w].cs.curs.len == 2, "one undo restores both cursors")
}

fn remembered_pair_moves() {
    var ed = fixture("\nnext")
    let _ = edit.mode_enter(mut ed, edit.MODE_I)
    press(mut ed, 40, 0)
    press(mut ed, term.KEY_DOWN, term.MOD_ALT)
    contents(ed, "next\n()")
    assert(pos(ed) == 6, "between moved pair")
    press(mut ed, 41, 0)
    contents(ed, "next\n()")
    assert(pos(ed) == 7, "remembered closer skips after moving")
}

fn record_replay_lines() {
    for name in ["ed.edit.lines.up", "ed.edit.lines.down", "ed.edit.lines.dedent"] {
        var ed = fixture_for("    aa\n    bb\ncc", false)
        at(mut ed, 8)
        assert(edit.record_start(mut ed, 97), "start recording")
        invoke(mut ed, name)
        assert(edit.record_stop(mut ed) == edit.CMD_OK, "stop recording")
        let b = ed.wins[ed.win].buf
        let expected = str_from_utf8(text.textbuf_bytes(ed.bufs[b].ec.tb)) else ""
        let value = text.reg_get(mut ed.regs, 97) else text.regval_new()
        let source = str_from_utf8(value.bytes) else ""
        assert(source.contains("line_"), "recorded named line command")
        invoke(mut ed, "ed.edit.undo")
        contents(ed, "    aa\n    bb\ncc")
        assert(edit.macro_replay(mut ed, 97, 1) == edit.CMD_OK, "replay line command")
        contents(ed, expected)
        invoke(mut ed, "ed.edit.undo")
        contents(ed, "    aa\n    bb\ncc")
    }
}

fn rectangle_lines() {
    var ed = fixture("    aa\n    bb\ncc")
    let _ = edit.mode_enter_highlight(mut ed, edit.MODE_I, false)
    let w = ed.win
    ed.wins[w].h.kind = edit.SEL_RECT
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].anchor = 2
    ed.wins[w].cs.curs[p].pos = 7
    invoke(mut ed, "ed.edit.lines.dedent")
    contents(ed, "aa\nbb\ncc")
    invoke(mut ed, "ed.edit.undo")
    contents(ed, "    aa\n    bb\ncc")
    invoke(mut ed, "ed.edit.lines.down")
    contents(ed, "cc\n    aa\n    bb")
    assert(ed.wins[w].h.kind == edit.SEL_RECT, "rectangle kind survives")
    assert(ed.wins[w].cs.curs[p].pos == 10, "inclusive zero-column rectangle head follows its line")
}

fn shifted_control_distinct() {
    let undo = edit.key_parse_seq("C-z", 1)
    let redo = edit.key_parse_seq("C-S-z", 1)
    let upper = edit.key_parse_seq("C-S-Z", 1)
    assert(undo.len == 1 && redo.len == 1 && upper.len == 1, "control keys parse")
    assert(undo[0] != redo[0] && redo[0] == upper[0], "shifted control letter is distinct")
    var k = term.key_new()
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    k.code = 122
    k.mods = term.MOD_CTRL | term.MOD_SHIFT
    assert(edit.keyid(k) == redo[0], "kitty control-shift key without text")
    (mut k.text).push(90 as byte)
    assert(edit.keyid(k) == redo[0], "kitty associated uppercase text retains control-shift")
    let shifted = edit.key_parse_seq("S-z", 1)
    let capital = edit.key_parse_seq("Z", 1)
    assert(shifted[0] == capital[0], "plain shifted text still folds")
    k.code = 47
    k.text = "?".bytes()
    let punctuation = edit.key_parse_seq("C-?", 1)
    assert(edit.keyid(k) == punctuation[0], "existing control punctuation still folds")
}

fn dedent_redraw() {
    var ed = fixture("    one\n    two\nend\n")
    let _ = edit.mode_enter(mut ed, edit.MODE_I)
    press(mut ed, term.KEY_DOWN, term.MOD_SHIFT)
    press(mut ed, term.KEY_DOWN, term.MOD_SHIFT)
    let w = ed.win
    edit.draw_document_rows(mut ed, w, 0, ed.wins[w].rect.h)
    assert(ed.overlay_primary_valid && ed.overlay_primary_pos == 16, "pre-edit selection cached")
    press(mut ed, term.KEY_TAB, term.MOD_SHIFT)
    contents(ed, "one\ntwo\nend\n")
    // A partial text repaint can resync the overlay signature before the
    // hardware cursor paints. Its OLD byte offsets must not survive it.
    edit.draw_document_rows(mut ed, w, 0, 2)
    edit.draw_overlay_sync(mut ed, w)
    edit.draw_cursor(mut ed, w)
    assert(
        ed.overlay_primary_valid && ed.overlay_primary_pos == pos(ed),
        "post-edit selection cached",
    )
}

fn binding_is(ed: edit.Ed, mode: int, sequence: str, name: str) {
    let km = edit.bind_keys(ed, mode)
    let seq = edit.key_parse_seq(sequence, 1)
    let (m, _, b) = edit.keymap_lookup(km, seq, seq.len)
    assert(
        m == edit.MATCH_FULL && km.binds[b].cmd == edit.cmd_lookup(ed.reg, name),
        "{sequence} remains {name}",
    )
}

fn mode_specific_alt() {
    let ed = fixture("")
    for mode in [edit.MODE_L, edit.MODE_W, edit.MODE_B] {
        binding_is(ed, mode, "A-<up>", "ed.git.hunk.prev")
        binding_is(ed, mode, "A-<down>", "ed.git.hunk.next")
    }
    for mode in [edit.MODE_L, edit.MODE_W, edit.MODE_B, edit.MODE_I] {
        let (ok, km) = edit.keymap_build(ed.reg, "H", edit.keys_highlight(mode))
        assert(ok, "H map builds")
        for key in ["A-<up>", "A-<down>"] {
            let seq = edit.key_parse_seq(key, 1)
            let (m, _, b) = edit.keymap_lookup(km, seq, seq.len)
            if mode == edit.MODE_W || mode == edit.MODE_I {
                assert(m == edit.MATCH_NONE, "H/W and H/I retain unbound vertical Alt keys")
            } else {
                let expected = if mode == edit.MODE_L {
                    if key == "A-<up>" then "ed.move.unit.prev_alt" else "ed.move.unit.next_alt"
                } else if key == "A-<up>" then "ed.sel.unit.expand" else "ed.sel.unit.contract"
                assert(
                    m == edit.MATCH_FULL && km.binds[b].cmd == edit.cmd_lookup(ed.reg, expected),
                    expected,
                )
            }
        }
    }
    binding_is(ed, edit.MODE_I, "A-<up>", "ed.edit.lines.up")
    binding_is(ed, edit.MODE_I, "A-<down>", "ed.shadow.accept_or_line")
}

fn shadow_line_routing() {
    var ed = fixture("aa\nbb\ncc")
    let _ = edit.mode_enter(mut ed, edit.MODE_I)
    at(mut ed, 3)
    assert(!edit.shadow_visible(ed, ed.win), "no shadow provider exists yet")
    let accept = edit.cmd_lookup(ed.reg, "ed.shadow.accept_line")
    ed.reg.entries[accept - 1].handler = edit.HANDLER_PROBE
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    assert(
        edit.shadow_line_dispatch(mut ed, cx, true) == edit.CMD_OK,
        "visible probe routes to acceptance",
    )
    assert(
        ed.reg.probe_calls == 1 && ed.reg.probe_invoked_id == accept,
        "existing accept command invoked",
    )
    contents(ed, "aa\nbb\ncc")
    assert(
        edit.shadow_line_dispatch(mut ed, cx, false) == edit.CMD_OK,
        "invisible routes to line move",
    )
    assert(ed.reg.probe_calls == 1, "line move did not accept")
    contents(ed, "aa\ncc\nbb")
}

fn run(i: int) {
    match i {
        0 => backtick(),
        1 => quote_balance(),
        2 => right_context(),
        3 => dedent(),
        4 => undo_keys(),
        5 => move_lines(),
        6 => move_selection(),
        7 => mouse_end(),
        8 => move_multiple_cursors(),
        9 => remembered_pair_moves(),
        10 => record_replay_lines(),
        11 => rectangle_lines(),
        12 => shifted_control_distinct(),
        13 => dedent_redraw(),
        14 => mode_specific_alt(),
        15 => shadow_line_routing(),
        _ => return,
    }
    print("editing_ergonomics: case {i}: PASS")
}

fn main() {
    let pick = env_get("YEW_EDITING_CASE") else ""
    if pick.len != 0 {
        run(pick.to_int() else -1)
    } else {
        for i in 0..16 { run(i) }
    }
}
