//! member: false
//! Sprint 31 deliverable 5, the `math` module: sagitta 9ace98c2
//! tests/unit/test_fl_std_math.c:1-216 (6 cases, registry order
//! tests/unit/registry.c:2027-2032), over flfix. Replaces the yw07b
//! placeholder smoke src/fl_math_native_test.lu.

use flfix

fn fl_math_keeps_the_type_it_was_given() {
    var f = flfix.open()
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.abs(-3)\n", "3")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.abs(-3.5))\n", "3.5")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.min(3, 1, 2)\n", "1")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.max(3, 1, 2)\n", "3")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.min(5)\n", "5")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.clamp(9, 0, 8)\n", "8")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.clamp(-1, 0, 8)\n", "0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.clamp(4, 0, 8)\n", "4")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.sign(-2.5)\n", "-1")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.sign(0)\n", "0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.sign(7)\n", "1")
    flfix.eq(
        mut f,
        "import math\nimport fmt\nreturn math.abs(\"a\")\n",
        "!type: math.abs: argument 1 must be number, found str",
    )
    flfix.close(mut f)
}

fn fl_math_rounds_toward_the_named_direction() {
    var f = flfix.open()
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.floor(1.7))\n", "1.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.floor(-1.2))\n", "-2.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.ceil(1.2))\n", "2.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.ceil(-1.7))\n", "-1.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.round(1.5))\n", "2.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.round(-1.5))\n", "-2.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.round(2.5))\n", "3.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.trunc(1.7))\n", "1.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.trunc(-1.7))\n", "-1.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.floor(3)\n", "3")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.round(3)\n", "3")
    flfix.close(mut f)
}

fn fl_math_converts_between_int_and_float() {
    var f = flfix.open()
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.int(3.9)\n", "3")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.int(-3.9)\n", "-3")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.int(4)\n", "4")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.float(3))\n", "3.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.float(3.5))\n", "3.5")
    flfix.eq(
        mut f,
        "import math\nimport fmt\nreturn math.int(math.nan)\n",
        "!type: math.int: nan has no integer value",
    )
    flfix.eq(
        mut f,
        "import math\nimport fmt\nreturn math.int(math.inf)\n",
        "!type: math.int: inf has no integer value",
    )
    flfix.close(mut f)
}

fn fl_math_transcendentals_follow_ieee() {
    var f = flfix.open()
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.sqrt(9))\n", "3.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.is_nan(math.sqrt(0 - 1))\n", "true")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.exp(0))\n", "1.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.log(1))\n", "0.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.log2(8))\n", "3.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.log10(1000))\n", "3.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.pow(2, 10))\n", "1024.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.sin(0))\n", "0.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.cos(0))\n", "1.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.tan(0))\n", "0.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.asin(0))\n", "0.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.acos(1))\n", "0.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.atan(0))\n", "0.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.atan2(0, 1))\n", "0.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn fmt.str(math.hypot(3, 4))\n", "5.0")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.is_nan(math.log(0 - 1))\n", "true")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.is_nan(math.asin(2))\n", "true")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.is_inf(math.log(0))\n", "true")
    flfix.close(mut f)
}

fn fl_math_classifies_the_edges() {
    var f = flfix.open()
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.is_nan(math.nan)\n", "true")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.is_nan(1.0)\n", "false")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.is_nan(1)\n", "false")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.is_inf(math.inf)\n", "true")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.is_inf(0 - math.inf)\n", "true")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.is_inf(1.0)\n", "false")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.pi > 3.14 and math.pi < 3.15\n", "true")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.e > 2.71 and math.e < 2.72\n", "true")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.int_max\n", "9223372036854775807")
    flfix.eq(mut f, "import math\nimport fmt\nreturn math.int_min\n", "-9223372036854775808")
    flfix.eq(mut f, "import math\nimport fmt\nmath.pi = 3\nreturn 1\n", "!type: object is frozen")
    flfix.close(mut f)
}

fn fl_math_random_is_deterministic() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        "import math\nimport fmt\nimport list\nmath.seed(1)\nlet a = [math.random(), math.random()]\nmath.seed(1)\nlet b = [math.random(), math.random()]\nreturn a[0] == b[0] and a[1] == b[1]\n",
        "true",
    )
    flfix.eq(
        mut f,
        "import math\nimport fmt\nmath.seed(1)\nreturn math.random() != math.random()\n",
        "true",
    )
    flfix.eq(
        mut f,
        "import math\nimport fmt\nmath.seed(1)\nlet a = math.random()\nmath.seed(2)\nreturn a != math.random()\n",
        "true",
    )
    flfix.eq(
        mut f,
        "import math\nimport fmt\nmath.seed(7)\nlet r = math.random()\nreturn r >= 0.0 and r < 1.0\n",
        "true",
    )
    // THE COMMITTED GOLDEN, DoD 12: seeded explicitly, since the default
    // sequence is only observable in a fresh process (test_fl_std_math.c:184-200).
    flfix.close(mut f)
    f = flfix.open()
    flfix.eq(
        mut f,
        "import math\nimport fmt\nimport list\nimport str\nmath.seed(1)\nlet r = []\nlet i = 0\nwhile i < 5 {{ list.push(r, fmt.float(math.random()))\n  i = i + 1 }}\nreturn str.join(r, \" \")\n",
        "0.28083505005035947 0.6711372530266764 0.7258461452833668 0.303529299965799 0.056176763098259475",
    )
    flfix.eq(
        mut f,
        "import math\nimport fmt\nmath.seed(7)\nlet ok = true\nlet i = 0\nwhile i < 100 {{\n  let r = math.random(3, 5)\n  if r < 3 or r > 5 {{ ok = false }}\n  i = i + 1\n}}\nreturn ok\n",
        "true",
    )
    flfix.close(mut f)
}

fn main() {
    // G29: YEW_MATH_CASE runs one case alone on the checked machine
    // (tools/check-test-cases.txt); unset, all six run in registry order.
    let only = (env_get("YEW_MATH_CASE") else "-1").to_int() else -1
    var ran = 0
    for n in 0..6 {
        if only >= 0 && n != only { continue }
        match n {
            0 => { fl_math_keeps_the_type_it_was_given() },
            1 => { fl_math_rounds_toward_the_named_direction() },
            2 => { fl_math_converts_between_int_and_float() },
            3 => { fl_math_transcendentals_follow_ieee() },
            4 => { fl_math_classifies_the_edges() },
            5 => { fl_math_random_is_deterministic() },
            _ => { assert(false, "unregistered fl_std_math case") },
        }
        print("fl_std_math case {n}: PASS")
        ran += 1
    }
    print("fl_std_math: {ran} of 6 cases run")
}
