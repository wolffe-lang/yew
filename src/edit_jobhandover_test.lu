//! member: false
//!
//! The port of sagitta `tests/unit/test_job_handover.c`'s Sprint 52 case,
//! `job_handover_inherits_stdio_and_reports_all_outcomes` (`:365-475`,
//! `registry.c:1277`, s52 §11): the one synchronous child inherits fd
//! 0/1/2 and reports exit, signal and exec failure without entering the
//! asynchronous table, and the asynchronous spawn refuses an inheriting
//! spec. (The file's other two cases, `:570` and `:731`, are Sprint
//! 57.18's `:!!` and `:Man` restores, not yw13's.)
//!
//! **The stdio leg** swaps C's own fd 0/1/2 for pipes with `dup2`; wolf's
//! std has none, so the port re-executes itself (`os_exe`) with the three
//! pipes as its stdio and the child runs the leg, writing its verdict to a
//! file; the parent reads the pipes exactly as C does after restoring its
//! fds. On the checked machine `os_exe` is wolf's own interpreter, not this
//! program, so that leg SKIPs there, by name.
//!
//! **The terminal legs** (`handover_assert_tty_case`, `:319-363`: a forked
//! child on a fresh pseudo-terminal's slave — `posix_openpt`, `setsid`,
//! `TIOCSCTTY`, `dup2` onto 0/1/2 — whose termios must come back exactly)
//! need a pseudo-terminal, which wolf's std does not open at the pin: both
//! SKIP by name (G60).

use edit
use std.fs
use std.process

fn argv_of(words: List[str]) -> List[str] {
    var v = List[str]()
    for w in words {
        (mut v).push(w)
    }
    v
}

fn spec_of(words: List[str]) -> edit.JobSpec {
    var spec = edit.job_spec_new()
    spec.argv = argv_of(words)
    spec.sink = edit.SINK_DISCARD
    spec.inherit_tty = true
    spec
}

fn say_skip(what: str) -> int {
    print("jobhandover_test: SKIP {what}")
    eprint("jobhandover_test: SKIP {what}")
    1
}

// The re-executed child: C's stdio leg (`:427-431`) with this process's
// own stdio already the parent's pipes; the verdict goes to `report`.
fn child_leg(report: str) {
    var ed = edit.ed_new()
    let stdio = spec_of(
        [
            "/bin/sh",
            "-c",
            "IFS= read -r line; printf 'out:%s' \"$line\"; printf 'err:%s' \"$line\" >&2",
        ],
    )
    let (ran, w, err) = edit.job_run_sync_spec(mut ed, stdio)
    let verdict = "ran={ran} state={w.state} exit={w.exit_code} jobs={ed.jobs.v.len} err={err}"
    fs.write_bytes(report, verdict.bytes()) else |_| { os_exit(9) }
    os_exit(0)
}

// Every byte until end of file (`handover_read_all`, `:26-43`).
fn read_all(mut f: fs.File) -> str {
    var out = ""
    var done = false
    while !done {
        let chunk = fs.read(mut f, 64) else |_| {
            done = true
            ""
        }
        out = "{out}{chunk}"
    }
    out
}

// C's stdio leg: `hello` on fd 0, `out:hello` on 1, `err:hello` on 2.
fn stdio_leg() -> int {
    let exe = os_exe() else |_| { return say_skip("the stdio leg: no executable path (os_exe)") }
    let base = exe.bytes()
    var slash = -1
    var i = 0
    while i < base.len {
        if base[i] as int == 47 {
            slash = i
        }
        i += 1
    }
    let name = exe[slash + 1..exe.len]
    if name == "wolf" || name == "_wolf" {
        return say_skip(
            "job_handover_inherits_stdio_and_reports_all_outcomes' stdio leg: on the checked machine os_exe is wolf's interpreter, not this program (no dup2 in wolf's std to swap fd 0/1/2 in place)",
        )
    }
    let tmp = env_get("TMPDIR") else "target/tests"
    let dir = if tmp.len == 0 then "target/tests" else tmp
    fs.create_dir_all(dir) else |_| {}
    let report = "{dir}/yew-jobhandover-{os_pid()}.report"
    fs.remove(report) else |_| {}
    var input = process.pipe() else |_| {
        assert(false, "pipe")
        return 0
    }
    var output = process.pipe() else |_| {
        assert(false, "pipe")
        return 0
    }
    var errors = process.pipe() else |_| {
        assert(false, "pipe")
        return 0
    }
    fs.write(mut input.write, "hello\n") else |_| { assert(false, "write hello") }
    fs.close(take input.write) else |_| {}
    var c = process.from_argv(argv_of([exe, "--yw13-handover-child", report]))
    process.set_stdin(mut c, input.read)
    process.set_stdout(mut c, output.write)
    process.set_stderr(mut c, errors.write)
    let child = process.start(c) else |_| {
        assert(false, "the child starts")
        return 0
    }
    fs.close(take input.read) else |_| {}
    fs.close(take output.write) else |_| {}
    fs.close(take errors.write) else |_| {}
    let out = read_all(mut output.read)
    let diag = read_all(mut errors.read)
    let status = process.wait_status(take child) else |_| {
        assert(false, "wait")
        0
    }
    let st = process.status_from(status)
    assert(process.is_exited(st), "the child exits")
    let code = process.exit_code(st) else 99
    assert(code == 0, "the child's verdict was written ({code})")
    let verdict = fs.read_text(report) else ""
    fs.remove(report) else |_| {}
    assert(
        verdict.starts_with("ran=true state={edit.JOB_EXITED} exit=0 jobs=0 "),
        "ran, exited 0, no asynchronous slot: {verdict}",
    )
    assert(out == "out:hello", "stdout inherited: `{out}`")
    assert(diag == "err:hello", "stderr inherited: `{diag}`")
    0
}

fn job_handover_inherits_stdio_and_reports_all_outcomes() -> int {
    var skips = stdio_leg()
    var ed = edit.ed_new()
    let (r1, w1, e1) = edit.job_run_sync_spec(mut ed, spec_of(["/definitely/not/yew-s52"]))
    assert(r1, "an exec failure is not a runner failure: {e1}")
    assert(w1.state == edit.JOB_EXECFAIL, "exec failed")
    assert(w1.exec_errno == 2, "ENOENT")
    assert(w1.exit_code == 127, "reported as 127")
    assert(ed.jobs.v.len == 0, "no asynchronous slot")
    let (r2, w2, _) = edit.job_run_sync_spec(mut ed, spec_of(["/bin/sh", "-c", "exit 23"]))
    assert(r2 && w2.state == edit.JOB_EXITED && w2.exit_code == 23, "exit 23")
    assert(ed.jobs.v.len == 0, "no asynchronous slot")
    var sig = spec_of(["/bin/sh", "-c", "kill -TERM $$"])
    let (r3, w3, _) = edit.job_run_sync_spec(mut ed, copy sig)
    assert(r3 && w3.state == edit.JOB_SIGNALED && w3.termsig == 15, "SIGTERM")
    assert(ed.jobs.v.len == 0, "no asynchronous slot")
    let (id, err) = edit.job_spawn(mut ed, mut sig)
    assert(id == 0, "the asynchronous spawn refuses an inheriting spec")
    assert(err.contains("synchronous runner"), "naming the synchronous runner: {err}")
    skips += say_skip(
        "job_handover_inherits_stdio_and_reports_all_outcomes' two terminal legs (handover_assert_tty_case, test_job_handover.c:319-363): a pseudo-terminal's slave as a forked child's controlling terminal needs posix_openpt, setsid and TIOCSCTTY, which wolf's std does not open at the pin (G60)",
    )
    skips
}

fn main() {
    // `env_args` answers the arguments after the program's name.
    let args = env_args()
    if args.len == 2 && args[0] == "--yw13-handover-child" {
        child_leg(args[1])
        return
    }
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let skips = job_handover_inherits_stdio_and_reports_all_outcomes()
    print("job_handover_inherits_stdio_and_reports_all_outcomes: PASS")
    print("jobhandover_test: 1 case run, {skips} SKIP by name")
}
