//! member: false
//!
//! The port of sagitta `tests/unit/test_replace.c` (577 lines), one test
//! per C test in registry order (`tests/unit/registry.c:1623-1633`). C's
//! fixture is `yew_ed_init` + `yew_ed_open_scratch` with the text
//! inserted through the edit context (`test_replace.c:34-43`); the port's
//! is `edit.ed_new` + `edit.ed_open_scratch` and the same insert through
//! the editor's seam. C applies a plan through `yew_ed_edit_ctx` and
//! undoes through it; the port applies through `edit.search_plan_apply`
//! (the seam) and undoes with the window's set lent to the context
//! (`edit.edit_take`/`edit_give`). Undo depth is asserted through the
//! undo tree's own one-step-reverts-all property, as C's tests do.

use edit
use search
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

// `rep_fixture` (`test_replace.c:34-43`).
fn fixture(t: List[byte]) -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    if t.len != 0 {
        assert(edit.ed_edit_insert(mut ed, ed.win, 0, t, 0, t.len), "fixture insert")
    }
    ed
}

fn buf(ed: edit.Ed) -> int {
    ed.wins[ed.win].buf
}

// `rep_read` (`test_replace.c:45-66`).
fn read(ed: edit.Ed) -> List[byte] {
    text.textbuf_bytes(ed.bufs[buf(ed)].ec.tb)
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn shown(b: List[byte]) -> str {
    str_from_utf8(b) else "<bytes>"
}

fn compile(pat: List[byte], flags: int) -> search.Re ! {invalid} {
    var o = edit.search_opts_new()
    if flags & search.SUB_ICASE != 0 {
        o.ignorecase = true
        o.smartcase = false
    }
    var err = search.re_err_new()
    edit.search_compile(pat, o, mut err)?
}

// `rep_run` (`test_replace.c:68-102`): one substitution over the whole
// buffer; the count.
fn run(mut ed: edit.Ed, pat: List[byte], tpl: List[byte], flags: int) -> int {
    let re = compile(pat, flags) else |_| {
        assert(false, "{shown(pat)} compiles")
        return 0
    }
    let nlines = text.textbuf_line_count(ed.bufs[buf(ed)].ec.tb)
    let (ok, plan, err) = search.repl_plan_build(
        re,
        ed.bufs[buf(ed)].ec.tb,
        0,
        if nlines == 0 then 0 else nlines - 1,
        tpl,
        flags,
    )
    assert(ok, "the plan builds ({err.msg})")
    edit.search_plan_apply(mut ed, ed.win, plan)
}

fn undo(mut ed: edit.Ed) -> bool {
    let w = ed.win
    let b = buf(ed)
    edit.edit_take(mut ed, w)
    let ok = text.undo(mut ed.bufs[b].ec)
    edit.edit_give(mut ed, w)
    edit.ed_finish_edit(mut ed, w)
    ok
}

struct RepRow {
    text: str,
    pat: str,
    tpl: str,
    flags: int,
    want: str,
    want_count: int,
}

fn row(t: str, pat: str, tpl: str, flags: int, want: str, want_count: int) -> RepRow {
    RepRow { text: t, pat: pat, tpl: tpl, flags: flags, want: want, want_count: want_count }
}

fn t_replace_rows() {
    let g = search.SUB_GLOBAL
    let ip = search.SUB_ICASE | search.SUB_PRESERVE
    let rows = [
        // basics and the g flag
        row("foo bar foo\n", "foo", "X", 0, "X bar foo\n", 1),
        row("foo bar foo\n", "foo", "X", g, "X bar X\n", 2),
        row("a\nb\na\n", "a", "Z", g, "Z\nb\nZ\n", 2),
        // Without g, one per LINE.
        row("aa\naa\n", "a", "b", 0, "ba\nba\n", 2),
        row("aa\naa\n", "a", "b", g, "bb\nbb\n", 4),
        row("hello world\n", " world", "", 0, "hello\n", 1),
        // template escapes
        row("abc\n", "b", "\\0\\0", 0, "abbc\n", 1),
        row("ab\n", "(a)(b)", "\\2\\1", 0, "ba\n", 1),
        row("xy\n", "x", "\\n", 0, "\ny\n", 1),
        row("xy\n", "x", "\\t", 0, "\ty\n", 1),
        row("xy\n", "x", "\\r", 0, "\ry\n", 1),
        row("xy\n", "x", "\\\\", 0, "\\y\n", 1),
        // `&` is LITERAL.
        row("cat\n", "cat", "&", 0, "&\n", 1),
        row("cat\n", "cat", "a&b", 0, "a&b\n", 1),
        row("cat\n", "cat", "\\0&\\0", 0, "cat&cat\n", 1),
        // case operators
        row("abc\n", "abc", "\\uabc", 0, "Abc\n", 1),
        row("ABC\n", "ABC", "\\lABC", 0, "aBC\n", 1),
        row("abc\n", "abc", "\\Uabc\\E!", 0, "ABC!\n", 1),
        row("ABC\n", "ABC", "\\LABC\\E!", 0, "abc!\n", 1),
        row("foo\n", "(foo)", "\\U\\1\\E-\\1", 0, "FOO-foo\n", 1),
        row("foo bar\n", "(foo) (bar)", "\\U\\1 \\2", 0, "FOO BAR\n", 1),
        row("foo\n", "(f)(oo)", "\\u\\1\\2", 0, "Foo\n", 1),
        row("ab cd\n", "(ab) (cd)", "\\u\\1-\\u\\2", 0, "Ab-Cd\n", 1),
        // anchors and zero width
        row("a\nb\n", "^", "> ", g, "> a\n> b\n", 2),
        row("a\nb\n", "$", ";", g, "a;\nb;\n", 2),
        row("ab\n", "x*", "-", g, "-a-b-\n", 3),
        row("a\nb", "^", "> ", g, "> a\n> b", 2),
        // CRLF: $ sits before the CR.
        row("a\r\nb\r\n", "$", "!", g, "a!\r\nb!\r\n", 2),
        // case flags
        row("Foo foo\n", "foo", "X", g, "Foo X\n", 1),
        row("Foo foo\n", "foo", "X", g | search.SUB_ICASE, "X X\n", 2),
        // p flag
        row("HELLO\n", "hello", "world", ip, "WORLD\n", 1),
        row("Hello\n", "hello", "world", ip, "World\n", 1),
        row("hello\n", "hello", "world", ip, "world\n", 1),
        row("hELLo\n", "hello", "world", ip, "world\n", 1),
        row("A\n", "a", "xy", ip, "Xy\n", 1),
        // length-changing, back to front
        row("aaa\n", "a", "LONGER", g, "LONGERLONGERLONGER\n", 3),
        row("abcabc\n", "abc", "z", g, "zz\n", 2),
        row("xAx\n", "A", "", g, "xx\n", 1),
        // unicode
        row("\u{6f22}\u{5b57}\n", "\u{6f22}", "X", 0, "X\u{5b57}\n", 1),
        row("caf\u{e9}\n", "\u{e9}", "e", 0, "cafe\n", 1),
        row("x\n", "x", "\u{6f22}", 0, "\u{6f22}\n", 1),
        // higher group references
        row("ab\n", "(a)(b)", "\\{{2}}\\{{1}}", 0, "ba\n", 1),
        row("ab\n", "(a)(b)", "\\{{1}}", 0, "a\n", 1),
    ]
    var i = 0
    for r in rows {
        var ed = fixture(bytes_of(r.text))
        let n = run(mut ed, bytes_of(r.pat), bytes_of(r.tpl), r.flags)
        let got = read(ed)
        assert(
            same(got, bytes_of(r.want)),
            "row {i} s/{r.pat}/{r.tpl}/ on [{r.text}]: got [{shown(got)}], want [{r.want}]",
        )
        assert(n == r.want_count, "row {i}: count {n}, want {r.want_count}")
        i += 1
    }
}

// DoD 6: however many matches, ONE undo puts it all back.
fn assert_one_undo(t: str, pat: str, tpl: str, flags: int, want_count: int) {
    var ed = fixture(bytes_of(t))
    let before = read(ed)
    let n = run(mut ed, bytes_of(pat), bytes_of(tpl), flags)
    assert(n == want_count, "s/{pat}/{tpl}/: count {n}")
    let after = read(ed)
    assert(!same(after, before), "s/{pat}/{tpl}/ changed something")
    assert(undo(mut ed), "one undo")
    assert(same(read(ed), before), "s/{pat}/{tpl}/: one undo restores")
}

fn t_replace_whole_run_is_one_undo_step() {
    let g = search.SUB_GLOBAL
    assert_one_undo("foo foo foo\n", "foo", "X", g, 3)
    assert_one_undo("a\nb\nc\n", "^", "> ", g, 3)
    assert_one_undo("aaa\n", "a", "LONGER", g, 3)
    assert_one_undo("abcabc\n", "abc", "z", g, 2)
    assert_one_undo("x\n", "x", "y", 0, 1)
    assert_one_undo("ab\n", "x*", "-", g, 3)
}

fn t_replace_ten_thousand_matches_is_one_undo_step() {
    var src = List[byte]()
    var i = 0
    while i < 10000 {
        for b in "foo\n".bytes() {
            (mut src).push(b)
        }
        i += 1
    }
    var ed = fixture(src)
    let before = read(ed)
    let n = run(mut ed, bytes_of("foo"), bytes_of("barbaz"), search.SUB_GLOBAL)
    assert(n == 10000, "ten thousand")
    assert(text.textbuf_len(ed.bufs[buf(ed)].ec.tb) == 70000, "the length")
    assert(undo(mut ed), "one undo")
    assert(same(read(ed), before), "all back")
}

// Sprint 58 F06 Q7: an empty first line and an unterminated last one.
fn t_replace_zero_width_empty_first_and_unterminated_last() {
    var ed = fixture(bytes_of("\nlast"))
    let n = run(mut ed, bytes_of("^"), bytes_of("> "), search.SUB_GLOBAL)
    assert(n == 2, "two")
    assert(same(read(ed), bytes_of("> \n> last")), "both lines")
    assert(undo(mut ed), "undo")
    assert(same(read(ed), bytes_of("\nlast")), "restored")
}

// DoD 8: every unknown escape is an error, named.
fn t_replace_rejects_unknown_escapes() {
    let bad = ["\\q", "a\\zb", "\\", "\\{{", "\\{{2", "\\{{}}"]
    for b in bad {
        let err = search.repl_check(bytes_of(b), 1)
        assert(!err.ok, "{b} refused")
        assert(err.msg.len != 0, "{b}: a message")
        assert(err.off <= b.len, "{b}: an offset inside")
    }
    let e1 = search.repl_check(bytes_of("\\3"), 1)
    assert(!e1.ok && e1.msg.len != 0, "a group the pattern lacks")
    let e2 = search.repl_check(bytes_of("\\3"), 4)
    assert(e2.ok, "fine when it has it")
}

// The zero-width rule as termination: the advance is one GRAPHEME.
fn t_replace_zero_width_terminates() {
    var ed = fixture(bytes_of("e\u{301}x\n"))
    let n = run(mut ed, bytes_of("q*"), bytes_of("-"), search.SUB_GLOBAL)
    assert(n == 3, "three, got {n}")
    assert(
        same(read(ed), bytes_of("-e\u{301}-x-\n")),
        "never inside the cluster: [{shown(read(ed))}]",
    )
}

// `confirm_case` (`test_replace.c:330-372`): the walker the key handler
// drives.
fn confirm_case(t: str, pat: str, tpl: str, keys: str, want: str) {
    var ed = fixture(bytes_of(t))
    let re = compile(bytes_of(pat), 0) else |_| {
        assert(false, "{pat} compiles")
        return
    }
    let nlines = text.textbuf_line_count(ed.bufs[buf(ed)].ec.tb)
    let (ok, plan, _) = search.repl_plan_build(
        re,
        ed.bufs[buf(ed)].ec.tb,
        0,
        nlines - 1,
        bytes_of(tpl),
        search.SUB_GLOBAL,
    )
    assert(ok, "plan")
    var p = plan
    var walk = search.repl_confirm_begin(mut p)
    for k in keys.bytes() {
        let _ = search.repl_confirm_answer(mut walk, mut p, k as int)
    }
    let _ = edit.search_plan_apply(mut ed, ed.win, p)
    let got = read(ed)
    assert(
        same(got, bytes_of(want)),
        "confirm [{keys}] on s/{pat}/{tpl}/: got [{shown(got)}], want [{want}]",
    )
}

fn t_replace_confirm_keys() {
    confirm_case("a a a\n", "a", "X", "yny", "X a X\n")
    confirm_case("a a a\n", "a", "X", "nnn", "a a a\n")
    confirm_case("a a a\n", "a", "X", "na", "a X X\n")
    confirm_case("a a a\n", "a", "X", "yl", "X X a\n")
    confirm_case("a a a\n", "a", "X", "yq", "X a a\n")
    confirm_case("a a a\n", "a", "X", "y\u{1b}", "X a a\n")
    confirm_case("a a a\n", "a", "X", "", "a a a\n")
}

fn t_replace_confirm_scroll_keys_are_not_answers() {
    var ed = fixture(bytes_of("a a\n"))
    let re = compile(bytes_of("a"), 0) else |_| {
        assert(false, "compiles")
        return
    }
    let (ok, plan, _) = search.repl_plan_build(
        re,
        ed.bufs[buf(ed)].ec.tb,
        0,
        0,
        bytes_of("X"),
        search.SUB_GLOBAL,
    )
    assert(ok, "plan")
    var p = plan
    var walk = search.repl_confirm_begin(mut p)
    assert(!search.repl_confirm_answer(mut walk, mut p, 5), "^E is not an answer")
    assert(!search.repl_confirm_answer(mut walk, mut p, 25), "^Y is not an answer")
    assert(search.repl_confirm_current(walk, p) == 0, "still on the first")
    assert(search.repl_confirm_pending(walk, p), "still pending")
    let _ = ed.win
}

// A confirm run ended with q is still exactly one undo step.
fn t_replace_confirm_run_ended_with_q_is_one_undo_step() {
    var ed = fixture(bytes_of("a a a a\n"))
    let before = read(ed)
    let re = compile(bytes_of("a"), 0) else |_| {
        assert(false, "compiles")
        return
    }
    let (ok, plan, _) = search.repl_plan_build(
        re,
        ed.bufs[buf(ed)].ec.tb,
        0,
        0,
        bytes_of("XY"),
        search.SUB_GLOBAL,
    )
    assert(ok, "plan")
    var p = plan
    var walk = search.repl_confirm_begin(mut p)
    let _ = search.repl_confirm_answer(mut walk, mut p, 121)
    let _ = search.repl_confirm_answer(mut walk, mut p, 121)
    let _ = search.repl_confirm_answer(mut walk, mut p, 113)
    assert(edit.search_plan_apply(mut ed, ed.win, p) == 2, "two applied")
    assert(undo(mut ed), "one undo")
    assert(same(read(ed), before), "all back")
}

// The range is honoured and `^` is measured against the buffer.
fn t_replace_range_does_not_move_the_anchors() {
    var ed = fixture(bytes_of("a\nb\nc\nd\n"))
    let a = compile(bytes_of("\\A"), 0) else |_| {
        assert(false, "compiles")
        return
    }
    let (ok1, p1, _) = search.repl_plan_build(
        a,
        ed.bufs[buf(ed)].ec.tb,
        1,
        2,
        bytes_of("X"),
        search.SUB_GLOBAL,
    )
    assert(ok1 && p1.v.len == 0, "\\A is the buffer's start, not the range's")
    let caret = compile(bytes_of("^"), 0) else |_| {
        assert(false, "compiles")
        return
    }
    let (ok2, p2, _) = search.repl_plan_build(
        caret,
        ed.bufs[buf(ed)].ec.tb,
        1,
        2,
        bytes_of("> "),
        search.SUB_GLOBAL,
    )
    assert(ok2 && p2.v.len == 2, "^ in the range's lines")
    let _ = edit.search_plan_apply(mut ed, ed.win, p2)
    assert(same(read(ed), bytes_of("a\n> b\n> c\nd\n")), "exactly the range")
}

fn t_replace_count_only_changes_nothing() {
    var ed = fixture(bytes_of("a a\nb a\n"))
    let re = compile(bytes_of("a"), 0) else |_| {
        assert(false, "compiles")
        return
    }
    let (ok, p, _) = search.repl_plan_build(
        re,
        ed.bufs[buf(ed)].ec.tb,
        0,
        1,
        bytes_of("X"),
        search.SUB_GLOBAL | search.SUB_COUNT_ONLY,
    )
    assert(ok, "plan")
    assert(p.v.len == 3, "three matches")
    assert(p.lines == 2, "on two lines")
    assert(text.textbuf_len(ed.bufs[buf(ed)].ec.tb) == 8, "nothing changed")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_replace_rows()
    t_replace_whole_run_is_one_undo_step()
    t_replace_ten_thousand_matches_is_one_undo_step()
    t_replace_zero_width_empty_first_and_unterminated_last()
    t_replace_rejects_unknown_escapes()
    t_replace_zero_width_terminates()
    t_replace_confirm_keys()
    t_replace_confirm_scroll_keys_are_not_answers()
    t_replace_confirm_run_ended_with_q_is_one_undo_step()
    t_replace_range_does_not_move_the_anchors()
    t_replace_count_only_changes_nothing()
    print("replace_test: 11 cases pass")
}
