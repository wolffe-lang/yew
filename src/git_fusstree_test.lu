//! member: false
//!
//! The port of sagitta `tests/unit/test_fusstree.c` (569 lines), one test
//! per C test in registry order: the dirty-first tree's construction rules.
//! C builds a `GitSnapshot` over literal strings with `memset`; here the
//! test's `add` appends each path to a fresh snapshot's pool, unsorted as
//! C's arrays are (the build sorts). C's `items.data[i].path` is the item's
//! node path (`git.fuss_item_path`).
//!
//! `YEW_PICK_CASE=N` runs case N alone (the checked machine's per-case run).

use git
use ws

fn b(s: str) -> List[byte] {
    var v = List[byte]()
    for x in s.bytes() {
        (mut v).push(x)
    }
    v
}

// The flags of one `ft_entry` (`test_fusstree.c:8-17`) a row sets.
struct Flags {
    kind: int,
    staged: bool,
    unstaged: bool,
    untracked: bool,
    incoming: bool,
    conflicted: bool,
    is_dir: bool,
}

fn fl() -> Flags {
    Flags {
        kind: git.GIT_E_ORDINARY,
        staged: false,
        unstaged: false,
        untracked: false,
        incoming: false,
        conflicted: false,
        is_dir: false,
    }
}

fn add(mut s: git.GitSnapshot, path: str, f: Flags) {
    var e = git.git_entry_new()
    e.kind = f.kind
    e.path_at = git.git_pool_add(mut s.pool, b(path), 0, path.len)
    e.path_len = path.len
    e.staged = f.staged
    e.unstaged = f.unstaged
    e.untracked = f.untracked
    e.incoming = f.incoming
    e.conflicted = f.conflicted
    e.is_dir = f.is_dir
    (mut s.entries).push(e)
}

fn add_ignored(mut s: git.GitSnapshot, path: str, is_dir: bool) {
    let at = git.git_pool_add(mut s.ignored.pool, b(path), 0, path.len)
    (mut s.ignored.rows).push(git.GitPathRow { at: at, len: path.len, is_dir: is_dir })
}

fn snap(gen: int) -> git.GitSnapshot {
    var s = git.git_snapshot_new()
    s.state = git.GIT_OK
    s.gen = gen
    s
}

fn opts(all: bool, hidden: bool) -> git.FussOpts {
    git.FussOpts { all_files: all, show_hidden: hidden }
}

// `ft_node` (`:80-90`): the node whose path is `path`, or -1.
fn node(t: git.FussTree, path: str) -> int {
    let p = b(path)
    var i = 1
    while i < t.nodes.len {
        if git.git_bytes_cmp(git.fuss_node_path(t, i), p) == 0 {
            return i
        }
        i += 1
    }
    -1
}

// `ft_item` (`:68-78`): the row whose path is `path`, or -1.
fn item(t: git.FussTree, path: str) -> int {
    let p = b(path)
    var i = 0
    while i < t.items.len {
        if git.fuss_item_path_eq(t, i, p, 0, p.len) {
            return i
        }
        i += 1
    }
    -1
}

fn item_is(t: git.FussTree, row: int, path: str) -> bool {
    row >= 0 && row < t.items.len && git.git_bytes_cmp(git.fuss_item_path(t, row), b(path)) == 0
}

// `ft_expand_all` (`:97-110`).
fn expand_all(mut t: git.FussTree) {
    var m = git.fuss_open_memory_new()
    var i = 1
    while i < t.nodes.len {
        if !t.nodes[i].is_file {
            let p = git.fuss_node_path(t, i)
            let _ = git.fuss_open_memory_set(mut m, p, 0, p.len, true)
        }
        i += 1
    }
    git.fuss_apply_expansion(mut t, m, git.fuss_open_memory_new())
}

// `ft_fill_fixture` (`:112-137`).
fn fixture(mut s: git.GitSnapshot) {
    var f = fl()
    f.staged = true
    add(mut s, "src/zeta.c", f)
    f = fl()
    f.unstaged = true
    add(mut s, "src/Alpha.c", f)
    f = fl()
    f.staged = true
    f.unstaged = true
    add(mut s, "src/mod/both.c", f)
    f = fl()
    f.kind = git.GIT_E_UNTRACKED
    f.untracked = true
    add(mut s, "README.md", f)
    f = fl()
    f.kind = git.GIT_E_UNMERGED
    f.staged = true
    f.unstaged = true
    f.conflicted = true
    add(mut s, "conflict.c", f)
    f = fl()
    f.incoming = true
    add(mut s, "incoming.c", f)
    f = fl()
    f.kind = git.GIT_E_IGNORED
    add(mut s, "ignored.log", f)
    f = fl()
    f.kind = git.GIT_E_UNTRACKED
    f.untracked = true
    f.is_dir = true
    add(mut s, "vendor/", f)
}

fn reversed_fixture(gen: int) -> git.GitSnapshot {
    var a = snap(gen)
    fixture(mut a)
    var r = snap(gen)
    var i = a.entries.len
    while i > 0 {
        i -= 1
        var e = copy a.entries[i]
        let p = git.git_snap_path(a, i)
        e.path_at = git.git_pool_add(mut r.pool, p, 0, p.len)
        (mut r.entries).push(e)
    }
    r
}

// `test_fuss_marker_order_and_conflict_override` (`:36-66`): all fifteen
// non-empty subsets, then the conflict override.
fn fuss_marker_order_and_conflict_override() {
    var t = git.fuss_tree_new()
    var s = snap(1)
    add(mut s, "x", fl())
    git.fuss_build(mut t, s, opts(true, true))
    var n = copy t.nodes[1]
    var mask = 1
    while mask < 16 {
        n.staged = mask % 2 == 1
        n.unstaged = mask / 2 % 2 == 1
        n.untracked = mask / 4 % 2 == 1
        n.incoming = mask / 8 % 2 == 1
        n.conflicted = false
        var expected = 0
        if n.staged {
            expected += 1
        }
        if n.unstaged {
            expected += 1
        }
        if n.untracked {
            expected += 1
        }
        if n.incoming {
            expected += 1
        }
        let (count, k0, k1, k2, k3) = git.fuss_marker_kinds(n)
        assert(count == expected, "marker count {mask}")
        var got = List[int]()
        for k in [k0, k1, k2, k3] {
            (mut got).push(k)
        }
        var at = 0
        if n.staged {
            assert(got[at] == git.FUSS_MARK_STAGED, "staged first {mask}")
            at += 1
        }
        if n.unstaged {
            assert(got[at] == git.FUSS_MARK_UNSTAGED, "unstaged second {mask}")
            at += 1
        }
        if n.untracked {
            assert(got[at] == git.FUSS_MARK_UNTRACKED, "untracked third {mask}")
            at += 1
        }
        if n.incoming {
            assert(got[at] == git.FUSS_MARK_INCOMING, "incoming last {mask}")
            at += 1
        }
        assert(at == expected, "order exhausted {mask}")
        mask += 1
    }
    n.conflicted = true
    let (c, k, _, _, _) = git.fuss_marker_kinds(n)
    assert(c == 1 && k == git.FUSS_MARK_CONFLICT, "conflict replaces every marker")
}

// `:139-202`.
fn fusstree_builds_every_status_flag() {
    var s = snap(17)
    fixture(mut s)
    var t = git.fuss_tree_new()
    git.fuss_build(mut t, s, opts(false, true))
    assert(t.snap_gen == 17, "generation")
    assert(t.nodes.len > 8, "nodes")
    assert(t.nodes[0].parent == 0, "root parent")
    assert(!t.nodes[0].is_file, "root is a directory")
    var n = node(t, "src/zeta.c")
    assert(n >= 0 && t.nodes[n].is_file && t.nodes[n].staged, "zeta staged")
    assert(
        !t.nodes[n].unstaged &&
            !t.nodes[n].untracked &&
            !t.nodes[n].incoming &&
            !t.nodes[n].conflicted,
        "zeta only staged",
    )
    n = node(t, "src/Alpha.c")
    assert(
        n >= 0 && !t.nodes[n].staged && t.nodes[n].unstaged && !t.nodes[n].untracked,
        "Alpha unstaged",
    )
    n = node(t, "src/mod/both.c")
    assert(n >= 0 && t.nodes[n].staged && t.nodes[n].unstaged, "both")
    n = node(t, "README.md")
    assert(
        n >= 0 && t.nodes[n].untracked && !t.nodes[n].staged && !t.nodes[n].unstaged,
        "README untracked",
    )
    n = node(t, "incoming.c")
    assert(n >= 0 && t.nodes[n].incoming, "incoming")
    n = node(t, "conflict.c")
    assert(
        n >= 0 && t.nodes[n].conflicted && t.nodes[n].staged && t.nodes[n].unstaged,
        "conflict keeps aggregates",
    )
    n = node(t, "ignored.log")
    assert(n >= 0 && t.nodes[n].ignored, "ignored")
}

// `:204-236`.
fn fusstree_directories_or_descendant_flags() {
    var s = snap(1)
    fixture(mut s)
    var t = git.fuss_tree_new()
    git.fuss_build(mut t, s, opts(false, true))
    let src = node(t, "src")
    let m = node(t, "src/mod")
    assert(src >= 0 && !t.nodes[src].is_file, "src dir")
    assert(t.nodes[src].staged && t.nodes[src].unstaged, "src ORs its subtree")
    assert(
        !t.nodes[src].untracked && !t.nodes[src].incoming && !t.nodes[src].conflicted,
        "src no more",
    )
    assert(!t.nodes[src].expanded, "src collapsed")
    assert(m >= 0 && !t.nodes[m].is_file && t.nodes[m].staged && t.nodes[m].unstaged, "mod ORs")
    assert(!t.nodes[m].untracked && !t.nodes[m].expanded, "mod collapsed")
}

// `:238-276`: two input permutations, one order.
fn fusstree_sorts_directories_before_files_deterministically() {
    let want = [
        "src",
        "src/mod",
        "src/mod/both.c",
        "src/Alpha.c",
        "src/zeta.c",
        "vendor",
        "conflict.c",
        "ignored.log",
        "incoming.c",
        "README.md",
    ]
    var sa = snap(2)
    fixture(mut sa)
    let sb = reversed_fixture(3)
    var ta = git.fuss_tree_new()
    var tb = git.fuss_tree_new()
    git.fuss_build(mut ta, sa, opts(false, true))
    git.fuss_build(mut tb, sb, opts(false, true))
    expand_all(mut ta)
    expand_all(mut tb)
    assert(ta.items.len == want.len, "a rows")
    assert(tb.items.len == want.len, "b rows")
    var i = 0
    while i < want.len {
        assert(item_is(ta, i, want[i]), "a row {i}")
        assert(item_is(tb, i, want[i]), "b row {i}")
        assert(ta.items[i].depth == tb.items[i].depth, "depth {i}")
        assert(ta.items[i].is_file == tb.items[i].is_file, "kind {i}")
        i += 1
    }
}

// `:278-302`.
fn fusstree_untracked_directory_starts_collapsed() {
    var s = snap(4)
    var f = fl()
    f.kind = git.GIT_E_UNTRACKED
    f.untracked = true
    f.is_dir = true
    add(mut s, "vendor/", f)
    var t = git.fuss_tree_new()
    git.fuss_build(mut t, s, opts(false, false))
    let n = node(t, "vendor")
    assert(t.items.len == 1, "one row")
    assert(
        n >= 0 && !t.nodes[n].is_file && t.nodes[n].untracked && t.nodes[n].untracked_dir,
        "untracked dir",
    )
    assert(!t.nodes[n].expanded && t.nodes[n].first_child == 0, "unexpanded, no children")
}

// `:304-330`.
fn fusstree_hidden_rows_obey_the_option() {
    var s = snap(5)
    var f = fl()
    f.unstaged = true
    add(mut s, ".secret", f)
    f = fl()
    f.kind = git.GIT_E_IGNORED
    add(mut s, "ignored.log", f)
    var t = git.fuss_tree_new()
    git.fuss_build(mut t, s, opts(false, false))
    assert(t.items.len == 0, "hidden: none")
    assert(item(t, ".secret") < 0 && item(t, "ignored.log") < 0, "hidden rows out")
    var u = git.fuss_tree_new()
    git.fuss_build(mut u, s, opts(false, true))
    assert(u.items.len == 2, "shown: both")
    assert(item(u, ".secret") >= 0 && item(u, "ignored.log") >= 0, "hidden rows in")
}

// `:332-357`.
fn fusstree_dirty_first_excludes_clean_until_all_files_is_enabled() {
    var s = snap(6)
    add(mut s, "clean.c", fl())
    var f = fl()
    f.unstaged = true
    add(mut s, "dirty.c", f)
    var t = git.fuss_tree_new()
    git.fuss_build(mut t, s, opts(false, false))
    assert(t.items.len == 1 && item(t, "clean.c") < 0 && item(t, "dirty.c") >= 0, "dirty first")
    assert(!t.all_files, "option recorded")
    git.fuss_build(mut t, s, opts(true, false))
    assert(t.items.len == 2 && item(t, "clean.c") >= 0 && item(t, "dirty.c") >= 0, "all files")
    assert(t.all_files, "option recorded")
}

// `:359-391`.
fn fusstree_all_files_preserves_ignored_row_style() {
    var s = snap(7)
    add_ignored(mut s, "nested/ignored.log", false)
    var files = ws.filelist_new()
    (mut files.paths).push("clean.c")
    (mut files.is_dir).push(false)
    (mut files.paths).push("nested/ignored.log")
    (mut files.is_dir).push(false)
    var t = git.fuss_tree_new()
    assert(git.fuss_merge_files(mut t, files, s, opts(true, true)), "merged")
    let row = node(t, "nested/ignored.log")
    let nested = node(t, "nested")
    assert(row >= 0 && t.nodes[row].ignored, "walked ignored file styled")
    assert(nested >= 0 && t.nodes[nested].ignored, "its directory ORs it")
}

// `:393-455`.
fn fusstree_nested_workspace_strips_and_filters_repo_paths() {
    var s = snap(71)
    var f = fl()
    f.kind = git.GIT_E_UNTRACKED
    f.untracked = true
    add(mut s, "wolf/starting/encode", f)
    f = fl()
    f.unstaged = true
    add(mut s, "wolf/starting/encode.lu", f)
    add(mut s, "wolf/sibling.txt", f)
    add(mut s, "wolf/start/prefix-collision.txt", f)
    f = fl()
    f.kind = git.GIT_E_UNTRACKED
    f.untracked = true
    f.is_dir = true
    add(mut s, "wolf/", f)
    add_ignored(mut s, "wolf/starting/.lu-cache/", true)
    var files = ws.filelist_new()
    for p in ["encode", "encode.lu", ".lu-cache/object"] {
        (mut files.paths).push(p)
        (mut files.is_dir).push(false)
    }
    var t = git.fuss_tree_new()
    assert(
        git.fuss_tree_scope_roots(
            mut t,
            "/tmp/repo with space",
            "/tmp/repo with space/wolf/starting",
        ),
        "in scope",
    )
    assert(git.fuss_merge_files(mut t, files, s, opts(true, true)), "merged")
    assert(node(t, "wolf") < 0, "repo-root dir filtered")
    assert(node(t, "sibling.txt") < 0, "sibling filtered")
    assert(node(t, "prefix-collision.txt") < 0, "prefix collision filtered")
    var n = node(t, "encode")
    assert(n >= 0 && t.nodes[n].untracked, "encode stripped and untracked")
    n = node(t, "encode.lu")
    assert(n >= 0 && t.nodes[n].unstaged, "encode.lu stripped")
    n = node(t, ".lu-cache/object")
    assert(n >= 0 && t.nodes[n].ignored, "scoped ignore")
    assert(
        !git.fuss_tree_scope_roots(mut t, "/tmp/repo", "/tmp/repository/wolf/starting"),
        "out of scope",
    )
    git.fuss_build(mut t, s, opts(true, true))
    assert(t.items.len == 0, "out of scope builds nothing")
}

// `:457-486`.
fn fusstree_items_hold_rebuild_safe_indices() {
    var s = snap(9)
    fixture(mut s)
    var t = git.fuss_tree_new()
    git.fuss_build(mut t, s, opts(false, true))
    var i = 0
    while i < t.items.len {
        assert(t.items[i].node > 0 && t.items[i].node < t.nodes.len, "index in range")
        i += 1
    }
    s.gen = 10
    git.fuss_build(mut t, s, opts(false, true))
    assert(t.snap_gen == 10, "rebuilt")
    i = 0
    while i < t.items.len {
        assert(t.items[i].node > 0 && t.items[i].node < t.nodes.len, "index in range after rebuild")
        assert(git.fuss_item_path(t, i).len == t.nodes[t.items[i].node].path_len, "path span whole")
        i += 1
    }
}

fn kids(paths: List[str], dirs: List[bool]) -> git.GitPaths {
    var p = git.git_paths_new()
    var i = 0
    while i < paths.len {
        let at = git.git_pool_add(mut p.pool, b(paths[i]), 0, paths[i].len)
        (mut p.rows).push(git.GitPathRow { at: at, len: paths[i].len, is_dir: dirs[i] })
        i += 1
    }
    p
}

// `:488-528`.
fn fusstree_untracked_expansion_splices_one_level_and_caches() {
    var s = snap(11)
    var f = fl()
    f.kind = git.GIT_E_UNTRACKED
    f.untracked = true
    f.is_dir = true
    add(mut s, "vendor/", f)
    let children = kids(["vendor/z.c", "vendor/sub/", "vendor/A.c"], [false, true, false])
    var t = git.fuss_tree_new()
    git.fuss_build(mut t, s, opts(false, false))
    let v = node(t, "vendor")
    assert(v >= 0, "vendor")
    assert(git.fuss_expand_untracked(mut t, v, children), "spliced")
    let w = node(t, "vendor")
    assert(w >= 0 && t.nodes[w].expanded && t.nodes[w].untracked_dir, "vendor open")
    assert(
        node(t, "vendor/sub") >= 0 && node(t, "vendor/A.c") >= 0 && node(t, "vendor/z.c") >= 0,
        "children",
    )
    assert(item_is(t, 1, "vendor/sub"), "dir first")
    assert(item_is(t, 2, "vendor/A.c"), "case-insensitive A")
    assert(item_is(t, 3, "vendor/z.c"), "z last")
    assert(!git.fuss_expand_untracked(mut t, v, children), "loaded once")
    assert(t.items.len == 4, "four rows")
}

// `:530-569`.
fn fusstree_untracked_expansion_cache_survives_refresh() {
    var s = snap(12)
    var f = fl()
    f.kind = git.GIT_E_UNTRACKED
    f.untracked = true
    f.is_dir = true
    add(mut s, "vendor/", f)
    let children = kids(["vendor/A.c"], [false])
    var t = git.fuss_tree_new()
    git.fuss_build(mut t, s, opts(false, false))
    let v = node(t, "vendor")
    assert(git.fuss_expand_untracked(mut t, v, children), "spliced")
    assert(git.fuss_nav_toggle(mut t, 0), "collapsed")
    s.gen += 1
    git.fuss_build(mut t, s, opts(false, false))
    let w = node(t, "vendor")
    assert(w >= 0 && t.nodes[w].untracked_loaded && !t.nodes[w].expanded, "cache kept, collapsed")
    assert(node(t, "vendor/A.c") >= 0, "child kept")
    assert(t.items.len == 1, "one row")
    assert(git.fuss_nav_toggle(mut t, 0), "opened")
    assert(t.items.len == 2 && item_is(t, 1, "vendor/A.c"), "child shown")
    let x = node(t, "vendor")
    assert(!git.fuss_expand_untracked(mut t, x, children), "already loaded")
}

fn main() {
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    var n = 0
    if chosen < 0 || chosen == 0 {
        fuss_marker_order_and_conflict_override()
        print("fuss_marker_order_and_conflict_override: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 1 {
        fusstree_builds_every_status_flag()
        print("fusstree_builds_every_status_flag: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 2 {
        fusstree_directories_or_descendant_flags()
        print("fusstree_directories_or_descendant_flags: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 3 {
        fusstree_sorts_directories_before_files_deterministically()
        print("fusstree_sorts_directories_before_files_deterministically: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 4 {
        fusstree_untracked_directory_starts_collapsed()
        print("fusstree_untracked_directory_starts_collapsed: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 5 {
        fusstree_hidden_rows_obey_the_option()
        print("fusstree_hidden_rows_obey_the_option: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 6 {
        fusstree_dirty_first_excludes_clean_until_all_files_is_enabled()
        print("fusstree_dirty_first_excludes_clean_until_all_files_is_enabled: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 7 {
        fusstree_all_files_preserves_ignored_row_style()
        print("fusstree_all_files_preserves_ignored_row_style: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 8 {
        fusstree_nested_workspace_strips_and_filters_repo_paths()
        print("fusstree_nested_workspace_strips_and_filters_repo_paths: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 9 {
        fusstree_items_hold_rebuild_safe_indices()
        print("fusstree_items_hold_rebuild_safe_indices: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 10 {
        fusstree_untracked_expansion_splices_one_level_and_caches()
        print("fusstree_untracked_expansion_splices_one_level_and_caches: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 11 {
        fusstree_untracked_expansion_cache_survives_refresh()
        print("fusstree_untracked_expansion_cache_survives_refresh: PASS")
        n += 1
    }
    print("git_fusstree_test: {n} cases run")
}
