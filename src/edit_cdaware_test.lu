//! member: false
//!
//! The port of sagitta `tests/unit/test_cdaware.c` (717 lines, Sprint
//! 57.32 — cd-aware completion, the consumers), one test per C test in
//! registry order (`tests/unit/registry.c:1168-1175`). The lexer's half
//! is `edit_shctx_test`'s cwd corpus; this file proves every consumer of
//! the directory follows it: the path source, `./` executables,
//! generators, the help layer and the caches keyed on a directory.
//!
//! Two cases need what 0.2.33 cannot run and SKIP loudly by name:
//! `cdaware_generator_runs_in_the_effective_directory` reads a spec
//! generator's output and `cdaware_follows_the_shell_session` runs the
//! persistent session — both jobs whose pipes are read while the loop
//! runs (R-yw04-1, G2). The prompt's two (`cdaware_empty_tab_names_the_
//! reason`, `cdaware_menu_carries_the_note`) drive `edit.cmdline`'s Tab,
//! merged from the prompt fork. A port-only case keeps the generator case's
//! half that needs no job: with the directory unknown nothing runs and
//! nothing is offered. It stats and lists; it runs inside the container
//! all the same (RULES §5).

use edit
use std.fs

fn b(s: str) -> List[byte] {
    edit.comp_bytes(s)
}

fn shown(t: List[byte]) -> str {
    str_from_utf8(t) else "<bytes>"
}

fn env_copy(name: str) -> (str, bool) {
    let v = env_get(name) else |_| { return ("", false) }
    (v, true)
}

fn env_back(name: str, v: str, had: bool) {
    if had {
        env_set(name, v) else |_| {}
    } else {
        env_unset(name) else |_| {}
    }
}

var fix_counter: int = 0

fn fresh_root(tag: str) -> str {
    var n = 0
    // # Safety: the test is one thread; the counter names fresh trees.
    unsafe {
        fix_counter += 1
        n = fix_counter
    }
    let root = "/tmp/yew-cdaware-{os_pid()}-{tag}-{n}"
    fs.remove_dir_all(root) else |_| {}
    fs.create_dir_all(root) else |_| { assert(false, "mkdir {root}") }
    root
}

fn find(items: List[edit.CompItem], t: str) -> bool {
    for it in items {
        if edit.comp_bytes_is(it.text, t) {
            return true
        }
    }
    false
}

fn put(path: str, text: str, mode: int) {
    fs.write_text(path, text) else |_| { assert(false, "write {path}") }
    fs.set_mode(path, mode) else |_| { assert(false, "chmod {path}") }
}

fn mkdir(path: str) {
    fs.create_dir_all(path) else |_| { assert(false, "mkdir {path}") }
}

// `test_cdaware_cache_rekeys_on_inserted_cd` (`test_cdaware.c:99-152`):
// insert `cd sub && ` before `ls s` with the menu open; head, pattern,
// row, position and argv[0] are unchanged, the directory is not.
fn t_cdaware_cache_rekeys_on_inserted_cd() {
    let root = fresh_root("rekey")
    mkdir("{root}/sub")
    put("{root}/sa-top", "", 384)
    put("{root}/sub/sb-inner", "", 384)
    var ed = edit.ed_new()
    ed.ws_dir = root
    var filter = edit.compfilter_new()
    var rows = List[edit.CompItem]()
    let before = b(":!ls s")
    let after = b(":!cd sub && ls s")
    let (ok1, q1) = edit.comp_query(mut ed, before, before.len)
    assert(ok1, "before queries")
    let _ = edit.comp_filter_run(mut ed, mut filter, q1, 0, mut rows)
    assert(find(rows, "sa-top") && !find(rows, "sb-inner"), "the prompt directory's rows")
    let (ok2, q2) = edit.comp_query(mut ed, after, after.len)
    assert(ok2 && edit.comp_bytes_is(q2.stem, "s"), "after: stem s")
    let _ = edit.comp_filter_run(mut ed, mut filter, q2, 0, mut rows)
    assert(find(rows, "sb-inner") && !find(rows, "sa-top"), "sub's rows after the cd")
    let (_, q3) = edit.comp_query(mut ed, before, before.len)
    let _ = edit.comp_filter_run(mut ed, mut filter, q3, 0, mut rows)
    assert(find(rows, "sa-top") && !find(rows, "sb-inner"), "back again")
    edit.comp_listing_invalidate(mut ed)
    fs.remove_dir_all(root) else |_| {}
}

/// C's `EdFix` (`test_cdaware.c:158-228`): the spec fixture's
/// environment (runtime, config, HOME), a scratch state directory, the
/// shared tree, an editor with a scratch buffer rooted there.
///   sa-top   sub/  sub/sb-inner  sub/run-me (x)  sub/inner/  run-top (x)
struct EdFix {
    root: str,
    saved: List[str],
    had: List[bool],
}

fn ed_fix_names() -> List[str] {
    var v = List[str]()
    for n in ["YEW_RUNTIME_DIR", "XDG_CONFIG_HOME", "HOME", "XDG_STATE_HOME"] {
        (mut v).push(n)
    }
    v
}

fn ed_fix_init(tag: str) -> (EdFix, edit.Ed) {
    let root = fresh_root(tag)
    var saved = List[str]()
    var had = List[bool]()
    for n in ed_fix_names() {
        let (v, h) = env_copy(n)
        (mut saved).push(v)
        (mut had).push(h)
    }
    let cwd = os_cwd() else ""
    mkdir("{root}/config/yew/completions")
    mkdir("{root}/home")
    mkdir("{root}/state")
    env_set("YEW_RUNTIME_DIR", "{cwd}/runtime") else |_| {}
    env_set("XDG_CONFIG_HOME", "{root}/config") else |_| {}
    env_set("HOME", "{root}/home") else |_| {}
    env_set("XDG_STATE_HOME", "{root}/state") else |_| {}
    mkdir("{root}/sub/inner")
    put("{root}/sa-top", "", 384)
    put("{root}/sub/sb-inner", "", 384)
    put("{root}/sub/run-me", "#!/bin/sh\n", 448)
    put("{root}/run-top", "#!/bin/sh\n", 448)
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.ws_dir = root
    (EdFix { root: root, saved: saved, had: had }, ed)
}

fn ed_fix_drop(f: EdFix, mut ed: edit.Ed) {
    edit.comp_listing_invalidate(mut ed)
    var i = 0
    for n in ed_fix_names() {
        env_back(n, f.saved[i], f.had[i])
        i += 1
    }
    assert(f.root.starts_with("/tmp/yew-"), "only a /tmp/yew-* tree is removed")
    fs.remove_dir_all(f.root) else |_| { assert(false, "remove {f.root}") }
}

// `test_cdaware_empty_tab_names_the_reason` (`test_cdaware.c:367-385`):
// a Tab that finds nothing says why (`rmdir`: row 8, so no help lookup
// makes the Tab wait).
fn t_cdaware_empty_tab_names_the_reason() {
    var (f, ed) = ed_fix_init("empty")
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    edit.cmdline_paste(mut ed, b("!cd $FOO && rmdir "))
    let cx = edit.cmdctx_new(ed.win, 0)
    let _ = edit.cmdline_complete_next_cmd(mut ed, cx)
    assert(ed.msg.text.contains("cd target unknown"), "the reason: {ed.msg.text}")
    assert(ed.cmdline.menu.items.len == 0, "no rows: {ed.cmdline.menu.items.len}")
    edit.cmdline_close(mut ed, false)
    ed_fix_drop(f, mut ed)
}

// `test_cdaware_menu_carries_the_note` (`test_cdaware.c:387-406`): the
// open menu carries the note to the pager; closing the prompt clears it.
fn t_cdaware_menu_carries_the_note() {
    var (f, ed) = ed_fix_init("note")
    put("{f.root}/sub/sc-other", "", 384)
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    edit.cmdline_paste(mut ed, b("!cd sub && ls s"))
    let cx = edit.cmdctx_new(ed.win, 0)
    let _ = edit.cmdline_complete_next_cmd(mut ed, cx)
    assert(ed.cmdline.menu.items.len == 2, "two rows: {ed.cmdline.menu.items.len}")
    assert(ed.cmdline.menu.where == "in sub/", "the note: `{ed.cmdline.menu.where}`")
    edit.cmdline_close(mut ed, false)
    assert(ed.cmdline.menu.where == "", "cleared at close: `{ed.cmdline.menu.where}`")
    ed_fix_drop(f, mut ed)
}

// `ed_rows` (`test_cdaware.c:230-247`): the SHELL rows for `line` through
// a fresh filter, as a Tab asks, with the filter's note.
fn ed_rows(mut ed: edit.Ed, line: str, mut rows: List[edit.CompItem]) -> (str, edit.CompFilter) {
    rows = List[edit.CompItem]()
    let lb = b(line)
    let (ok, q) = edit.comp_query(mut ed, lb, lb.len)
    assert(ok, "{line}: queries")
    assert(q.kind == edit.COMP_SHELL, "{line}: SHELL")
    var filter = edit.compfilter_new()
    let _ = edit.comp_filter_run(mut ed, mut filter, q, 0, mut rows)
    (copy filter.where, filter)
}

// `test_cdaware_paths_follow_the_effective_directory` (`test_cdaware.c:
// 271-365`).
fn t_cdaware_paths_follow_the_effective_directory() {
    var (f, ed) = ed_fix_init("paths")
    var rows = List[edit.CompItem]()
    let (w1, _) = ed_rows(mut ed, ":!cd sub && ls ", mut rows)
    assert(find(rows, "sb-inner") && find(rows, "inner/"), "sub's rows")
    assert(!find(rows, "sa-top"), "not the root's")
    assert(w1 == "in sub/", "the note: `{w1}`")
    // The subshell's cd is gone at its close.
    let (w2, _) = ed_rows(mut ed, ":!(cd sub); ls ", mut rows)
    assert(find(rows, "sa-top") && !find(rows, "sb-inner"), "after the subshell")
    assert(w2 == "", "no note: `{w2}`")
    // What the user typed stays relative to what they typed.
    let _ = ed_rows(mut ed, ":!cd sub && ls ../s", mut rows)
    assert(find(rows, "../sa-top") && find(rows, "../sub/"), "../ rows")
    let _ = ed_rows(mut ed, ":!cd sub/inner && cd .. && ls s", mut rows)
    assert(find(rows, "sb-inner"), "cd sub/inner && cd ..")
    let (w3, _) = ed_rows(mut ed, ":!cd sub/inner && ls ", mut rows)
    assert(w3 == "in sub/inner/", "the note: `{w3}`")
    let (w4, _) = ed_rows(mut ed, ":!cd .. && ls ", mut rows)
    assert(w4 == "in ../", "the note: `{w4}`")
    let (w5, _) = ed_rows(mut ed, ":!cd sub && cd .. && ls s", mut rows)
    assert(find(rows, "sa-top") && w5 == "", "back at the root: `{w5}`")
    // Unknown: nothing path-like, and the reason.
    let (w6, _) = ed_rows(mut ed, ":!cd $FOO && ls ", mut rows)
    assert(rows.len == 0, "unknown: nothing, {rows.len}")
    assert(w6 == "cd target unknown", "the reason: `{w6}`")
    let _ = ed_rows(mut ed, ":!cd sub || echo no; cat s", mut rows)
    assert(rows.len == 0, "a cd that may have failed: nothing, {rows.len}")
    // ... but an absolute path names the same file from anywhere.
    let _ = ed_rows(mut ed, ":!cd $FOO && ls {f.root}/sa", mut rows)
    assert(rows.len == 1, "an absolute path: one row, {rows.len}")
    // Not created yet: nothing, though the directory is known.
    let (w7, _) = ed_rows(mut ed, ":!mkdir new && cd new && ls ", mut rows)
    assert(rows.len == 0 && w7 == "in new/", "not created yet: `{w7}`, {rows.len}")
    // COMMAND position `./`: the executables of the effective dir.
    let _ = ed_rows(mut ed, ":!cd sub && ./", mut rows)
    assert(find(rows, "./run-me"), "./run-me")
    assert(!find(rows, "./sb-inner") && !find(rows, "./run-top"), "only sub's executables")
    let _ = ed_rows(mut ed, ":!./", mut rows)
    assert(find(rows, "./run-top") && !find(rows, "./run-me"), "the root's executables")
    // ~ is the job environment's HOME (the fixture's).
    put("{f.root}/home/in-home", "", 384)
    let _ = ed_rows(mut ed, ":!cd ~ && ls in", mut rows)
    assert(find(rows, "in-home"), "cd ~")
    // tar -C moves extraction, not where -f is read.
    let (w8, _) = ed_rows(mut ed, ":!tar -C sub -xf s", mut rows)
    assert(find(rows, "sa-top") && !find(rows, "sb-inner"), "tar -C")
    assert(w8 == "", "tar -C: no note: `{w8}`")
    ed_fix_drop(f, mut ed)
}

// `test_cdaware_make_and_git_follow_their_flag` (`test_cdaware.c:520-
// 575`): `make -C sub` and `cd sub && make` read sub/Makefile (the
// built-in generator, no job); git.fl's branch generator moves with -C
// and is not handed -C again. C pumps the generator after reading its
// key; at 0.2.33 the generator refuses by name (R-yw04-1) and nothing is
// ever in flight, which is what C's `pump_idle` asserts at its end.
fn t_cdaware_make_and_git_follow_their_flag() {
    var (f, ed) = ed_fix_init("make")
    put("{f.root}/Makefile", "top-target:\n\ttrue\n", 384)
    put("{f.root}/sub/Makefile", "inner-target:\n\ttrue\n", 384)
    var rows = List[edit.CompItem]()
    let _ = ed_rows(mut ed, ":!make ", mut rows)
    assert(find(rows, "top-target"), "make: the root's targets")
    let (w1, _) = ed_rows(mut ed, ":!make -C sub ", mut rows)
    assert(find(rows, "inner-target") && !find(rows, "top-target"), "make -C sub")
    assert(w1 == "in sub/", "make -C sub: the note `{w1}`")
    let _ = ed_rows(mut ed, ":!make --directory=sub ", mut rows)
    assert(find(rows, "inner-target"), "make --directory=sub")
    let _ = ed_rows(mut ed, ":!cd sub && make ", mut rows)
    assert(find(rows, "inner-target"), "cd sub && make")
    let _ = ed_rows(mut ed, ":!cd $X && make ", mut rows)
    assert(!find(rows, "top-target"), "unknown: not the root's targets")
    // After -C, a path operand is relative to it too.
    let _ = ed_rows(mut ed, ":!make -C sub -f sb", mut rows)
    assert(find(rows, "sb-inner"), "make -C sub -f sb")
    let (_, filter) = ed_rows(mut ed, ":!git -C sub checkout ", mut rows)
    assert(filter.has_gen_key, "git checkout has a generator key")
    let want = "\u{1e}{f.root}/sub"
    assert(filter.gen_key.contains(want), "run in sub: {filter.gen_key}")
    assert(!filter.gen_key.contains("\u{1f}-C"), "-C not passed again: {filter.gen_key}")
    assert(edit.compgen_inflight(ed.gen) == 0, "nothing in flight")
    ed_fix_drop(f, mut ed)
}

// `test_cdaware_changes_dir_schema_and_walk` (`test_cdaware.c:580-647`).
fn t_cdaware_changes_dir_schema_and_walk() {
    let bad = [
        "# t\n{{ completion: 1, command: \"t\",\n  flags: [ {{ short: \"C\", changes_dir: true }} ] }}\n",
        "# t\n{{ completion: 1, command: \"t\",\n  flags: [ {{ short: \"C\", arg: {{ kind: \"path\" }},\n             changes_dir: true }} ] }}\n",
        "# t\n{{ completion: 1, command: \"t\",\n  flags: [ {{ short: \"C\", arg: {{ kind: \"dir\" }},\n             changes_dir: 1 }} ] }}\n",
    ]
    let good = "# t\n{{ completion: 1, command: \"t\",\n  flags: [ {{ short: \"C\", long: \"dir\", arg: {{ kind: \"dir\" }},\n             changes_dir: true }},\n           {{ short: \"v\" }} ] }}\n"
    var reg = edit.compspecs_new()
    for text in bad {
        let (ok, _, err) = edit.compspec_load_text(mut reg, "completions/t.fl", b(text))
        assert(!ok, "refused")
        assert(err.contains("changes_dir"), "names changes_dir: {err}")
    }
    let (ok, spec, err) = edit.compspec_load_text(mut reg, "completions/t.fl", b(good))
    assert(ok, "loads: {err}")
    let line = b("t -C a -vCb --dir c --dir=d x")
    let (lok, ctx) = edit.shctx_at(line, line.len)
    assert(lok, "lexes")
    let (rok, pt) = edit.compspec_resolve(spec, ctx)
    assert(rok, "resolves")
    assert(pt.dir_at.len == 4, "four values: {pt.dir_at.len}")
    // -C a: the next word.
    assert(pt.dir_flag[0] == 1 && pt.dir_at[0] == 2 && pt.dir_off[0] == 0, "-C a")
    // -vCb: attached, inside a bundle.
    assert(pt.dir_at[1] == 3, "-vCb at 3")
    let v1 = ctx.argv[3]
    assert(shown(v1).len > pt.dir_off[1] && shown(v1)[pt.dir_off[1]..] == "b", "-vCb's b")
    // --dir c, --dir=d
    assert(pt.dir_at[2] == 5 && pt.dir_flag[2] == 4, "--dir c")
    assert(shown(ctx.argv[6])[pt.dir_off[3]..] == "d", "--dir=d's d")
    assert(!pt.dirs_overflow, "no overflow")
    // The shipped tar.fl never sets it.
    let saved = env_get("YEW_RUNTIME_DIR") else "\u{0}"
    let cwd = os_cwd() else ""
    env_set("YEW_RUNTIME_DIR", "{cwd}/runtime") else |_| {}
    var shipped = edit.compspecs_new()
    let tar = edit.compspec_get(mut shipped, "tar")
    assert(tar >= 0, "tar has a spec")
    for fl in shipped.pool[tar].nodes[0].flags {
        assert(!fl.changes_dir, "tar's -C is not changes_dir")
    }
    if saved == "\u{0}" {
        env_unset("YEW_RUNTIME_DIR") else |_| {}
    } else {
        env_set("YEW_RUNTIME_DIR", saved) else |_| {}
    }
}

// Port-only: `cdaware_generator_runs_in_the_effective_directory`'s last
// half (`test_cdaware.c:509-514`) — with the directory unknown a spec
// generator is never asked and nothing is offered — which needs no job.
fn t_port_cdaware_unknown_directory_runs_no_generator() {
    var (f, ed) = ed_fix_init("gen")
    mkdir("{f.root}/bin")
    put("{f.root}/bin/fixgen", "#!/bin/sh\necho \"cwd-$(basename \"$(pwd)\")\"\n", 448)
    let spec = "# test 1\n{{ completion: 1, command: \"fixcmd\",\n  generators: {{ g: {{ argv: [\"{f.root}/bin/fixgen\"], pass_flags: [\"-C\", \"-X\"] }} }},\n  flags: [ {{ short: \"C\", arg: {{ kind: \"dir\" }}, changes_dir: true }},\n           {{ long: \"dir\", arg: {{ kind: \"dir\" }}, changes_dir: true }},\n           {{ short: \"X\", arg: {{ kind: \"none\" }} }} ],\n  args: [ {{ kind: \"generator\", generator: \"g\" }} ] }}\n"
    put("{f.root}/config/yew/completions/fixcmd.fl", spec, 384)
    let before = edit.compgen_spawns(ed.gen)
    var rows = List[edit.CompItem]()
    let (_, f1) = ed_rows(mut ed, ":!cd $FOO && fixcmd ", mut rows)
    assert(!f1.has_gen_key, "no generator key with the directory unknown")
    let (_, f2) = ed_rows(mut ed, ":!fixcmd -C $FOO ", mut rows)
    assert(!f2.has_gen_key, "-C $FOO: no generator key")
    assert(rows.len == 0, "nothing offered: {rows.len}")
    assert(edit.compgen_spawns(ed.gen) == before, "nothing ran")
    // Known, the key is there and names where the command runs.
    let (_, f3) = ed_rows(mut ed, ":!fixcmd -C sub ", mut rows)
    assert(f3.has_gen_key, "a key once the directory is known")
    assert(f3.gen_key.contains("\u{1e}{f.root}/sub"), "run in sub: {f3.gen_key}")
    assert(!f3.gen_key.contains("\u{1f}-C"), "-C not passed again")
    ed_fix_drop(f, mut ed)
}

fn skip(name: str, why: str) -> int {
    print("cdaware_test: SKIP {name}: {why}")
    eprint("cdaware_test: SKIP {name}: {why}")
    1
}

fn main() {
    fs.create_dir_all("target/tests") else |_| {}
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let job = "a job whose pipe is read while the loop runs: needs os_signal_wait_fds (G2, wolf-lang#795), R-yw04-1"
    var skips = 0
    t_cdaware_cache_rekeys_on_inserted_cd()
    t_cdaware_paths_follow_the_effective_directory()
    t_cdaware_empty_tab_names_the_reason()
    t_cdaware_menu_carries_the_note()
    skips += skip(
        "cdaware_generator_runs_in_the_effective_directory",
        "the generator's output is " + job,
    )
    t_cdaware_make_and_git_follow_their_flag()
    t_cdaware_changes_dir_schema_and_walk()
    skips += skip("cdaware_follows_the_shell_session", "the persistent session is " + job)
    t_port_cdaware_unknown_directory_runs_no_generator()
    print("cdaware_test: {8 - skips} C cases pass, {skips} SKIP; 1 port case passes")
}
