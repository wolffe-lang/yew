//! member: false
//!
//! The port of sagitta `tests/unit/test_menu.c` (358 lines), one test per
//! C test in registry order (`tests/unit/registry.c:1007-1017`): the
//! ranked-list widget's selection model and scroll window (Sprint 18.5
//! §5, Sprint 57.17 §2-§3). C's `items_of` (`test_menu.c:13-27`) builds
//! rows scoring 100 - i; the port's `reset` stores them into `m.items`
//! as a host does (`edit.menu_reset`'s header) and resets.

use edit
use text

fn items_of(rows: str) -> List[edit.CompItem] {
    var v = List[edit.CompItem]()
    var i = 0
    for r in rows.split(" ") {
        var it = edit.compitem_text(edit.comp_bytes(r), edit.COMP_CMD)
        it.score = 100 - i
        (mut v).push(it)
        i += 1
    }
    v
}

fn reset(mut m: edit.Menu, rows: str) {
    let items = items_of(rows)
    let n = items.len
    m.items = items
    edit.menu_reset(mut m, n, text.Span { lo: 0, hi: 0 })
}

fn selected_is(m: edit.Menu, want: str) -> bool {
    let i = edit.menu_selected(m)
    i >= 0 && edit.comp_bytes_is(m.items[i].text, want)
}

fn spec(rows: int, wrap: bool) -> edit.MenuSpec {
    var s = edit.menuspec_default()
    s.max_rows = rows
    s.wrap = wrap
    s
}

// `test_menu_selection_survives_a_refilter_by_identity` (`:29-54`).
fn t_menu_selection_survives_a_refilter_by_identity() {
    var m = edit.menu_new(edit.menuspec_default())
    reset(mut m, "alpha beta gamma")
    assert(edit.menu_move(mut m, 1, false), "move 1")
    assert(edit.menu_move(mut m, 1, false), "move 2")
    assert(selected_is(m, "beta"), "beta chosen")
    assert(m.sel == 1, "at row 1")
    reset(mut m, "gamma alpha beta")
    assert(m.sel == 2, "beta found at its new row: {m.sel}")
    assert(selected_is(m, "beta"), "still beta")
    assert(m.explicit_sel, "still explicit")
    edit.menu_free(mut m)
}

// `test_menu_lost_selection_falls_to_nothing_not_to_row_zero` (`:56-78`).
fn t_menu_lost_selection_falls_to_nothing_not_to_row_zero() {
    var m = edit.menu_new(edit.menuspec_default())
    reset(mut m, "alpha beta")
    assert(edit.menu_move(mut m, 1, false), "move 1")
    assert(edit.menu_move(mut m, 1, false), "move 2")
    assert(selected_is(m, "beta"), "beta")
    reset(mut m, "alpha gamma")
    assert(m.sel == -1, "nothing selected")
    assert(!m.explicit_sel, "not explicit")
    assert(edit.menu_selected(m) == -1, "no selected row")
    edit.menu_free(mut m)
}

// `test_menu_filtering_alone_never_makes_a_selection_explicit` (`:80-97`).
fn t_menu_filtering_alone_never_makes_a_selection_explicit() {
    var m = edit.menu_new(edit.menuspec_default())
    reset(mut m, "alpha beta")
    assert(m.sel == -1, "ranking chooses nothing")
    assert(!m.explicit_sel, "not explicit")
    assert(edit.menu_selected(m) == -1, "no row")
    assert(edit.menu_move(mut m, 1, false), "a move")
    assert(m.explicit_sel, "explicit after a move")
    assert(m.sel == 0, "row 0")
    edit.menu_free(mut m)
}

// `test_menu_move_wraps_and_enters_from_either_end` (`:99-123`).
fn t_menu_move_wraps_and_enters_from_either_end() {
    var m = edit.menu_new(spec(5, true))
    reset(mut m, "a b c")
    assert(edit.menu_move(mut m, -1, false), "back")
    assert(m.sel == 2, "enters at the last row")
    assert(edit.menu_move(mut m, 1, false), "fwd")
    assert(m.sel == 0, "wrapped")
    assert(edit.menu_move(mut m, -1, false), "back")
    assert(m.sel == 2, "wrapped back")
    edit.menu_free(mut m)
    var n = edit.menu_new(spec(5, false))
    reset(mut n, "a b c")
    assert(edit.menu_move(mut n, 1, false), "fwd")
    assert(edit.menu_move(mut n, 5, false), "fwd 5")
    assert(n.sel == 2, "clamped, not wrapped")
    edit.menu_free(mut n)
}

// `test_menu_scrolls_to_keep_the_selection_visible` (`:125-143`).
fn t_menu_scrolls_to_keep_the_selection_visible() {
    var m = edit.menu_new(spec(3, false))
    reset(mut m, "r0 r1 r2 r3 r4 r5 r6 r7")
    assert(edit.menu_rows(m, 24) == 3, "three rows")
    assert(edit.menu_rows(m, 2) == 2, "clipped by the area")
    var i = 0
    while i < 8 {
        assert(edit.menu_move(mut m, 1, false), "move {i}")
        i += 1
    }
    assert(m.sel == 7, "reached the eighth row")
    edit.menu_free(mut m)
}

// `test_menu_page_moves_by_the_visible_row_count` (`:145-163`).
fn t_menu_page_moves_by_the_visible_row_count() {
    var m = edit.menu_new(spec(3, false))
    reset(mut m, "r0 r1 r2 r3 r4 r5 r6 r7")
    assert(edit.menu_move(mut m, 1, false), "enter")
    assert(m.sel == 0, "row 0")
    assert(edit.menu_move(mut m, 1, true), "page")
    assert(m.sel == 3, "row 3")
    assert(edit.menu_move(mut m, 1, true), "page")
    assert(m.sel == 6, "row 6")
    assert(edit.menu_move(mut m, -1, true), "page back")
    assert(m.sel == 3, "row 3 again")
    edit.menu_free(mut m)
}

// `test_menu_dismiss_and_empty_are_inert` (`:165-182`).
fn t_menu_dismiss_and_empty_are_inert() {
    var m = edit.menu_new(edit.menuspec_default())
    assert(!edit.menu_move(mut m, 1, false), "nothing to move through")
    assert(edit.menu_rows(m, 24) == 0, "no rows")
    assert(edit.menu_selected(m) == -1, "nothing selected")
    reset(mut m, "a")
    assert(edit.menu_move(mut m, 1, false), "a move")
    edit.menu_dismiss(mut m)
    assert(m.sel == -1, "dismissed: nothing selected")
    assert(!m.explicit_sel, "not explicit")
    assert(m.items.len == 0, "no items")
    edit.menu_free(mut m)
}

// `test_menu_pager_scrolls_and_keeps_an_honest_tail` (`:189-252`).
fn t_menu_pager_scrolls_and_keeps_an_honest_tail() {
    var m = edit.menu_new(spec(3, false))
    reset(mut m, "r0 r1 r2 r3 r4 r5 r6 r7")
    assert(edit.menu_rows(m, 24) == 3, "three rows")
    assert(edit.menu_candidate_rows(m, 24) == 2, "two candidates and a tail")
    assert(edit.menu_hidden(m, 24) == 6, "six hidden")
    assert(edit.menu_move(mut m, 1, false), "r0")
    assert(m.sel == 0 && m.top == 0, "r0 at top 0")
    assert(edit.menu_move(mut m, 1, false), "r1")
    assert(m.sel == 1 && m.top == 0, "r1 at top 0")
    assert(edit.menu_move(mut m, 1, false), "r2")
    assert(m.sel == 2 && m.top == 1, "r2 scrolls by one: top {m.top}")
    assert(edit.menu_hidden(m, 24) == 5, "five hidden")
    while m.sel < 7 {
        assert(edit.menu_move(mut m, 1, false), "down")
    }
    assert(m.sel == 7 && m.top == 5, "the bottom: top {m.top}")
    assert(edit.menu_candidate_rows(m, 24) == 3, "no tail at the end")
    assert(edit.menu_hidden(m, 24) == 0, "nothing hidden")
    assert(edit.menu_move(mut m, -1, false), "up")
    assert(edit.menu_move(mut m, -1, false), "up")
    assert(m.sel == 5 && m.top == 5, "inside the window: no scroll")
    assert(edit.menu_hidden(m, 24) == 0, "nothing hidden")
    assert(edit.menu_move(mut m, -1, false), "up")
    assert(m.sel == 4 && m.top == 4, "the window follows: top {m.top}")
    assert(edit.menu_candidate_rows(m, 24) == 2, "the tail is back")
    assert(edit.menu_hidden(m, 24) == 2, "two hidden")
    assert(edit.menu_selected(m) >= 0, "a real row")
    assert(selected_is(m, "r4"), "r4")
    assert(m.sel < m.top + edit.menu_candidate_rows(m, 24), "inside the candidate window")
    edit.menu_free(mut m)
}

// `test_menu_no_tail_when_everything_fits` (`:255-268`).
fn t_menu_no_tail_when_everything_fits() {
    var m = edit.menu_new(spec(5, false))
    reset(mut m, "a b c")
    assert(edit.menu_rows(m, 24) == 3, "three rows")
    assert(edit.menu_candidate_rows(m, 24) == 3, "three candidates")
    assert(edit.menu_hidden(m, 24) == 0, "no tail")
    edit.menu_free(mut m)
}

// `test_menu_focus_takes_the_arrows_and_gives_them_back` (`:274-330`).
fn t_menu_focus_takes_the_arrows_and_gives_them_back() {
    var m = edit.menu_new(edit.menuspec_default())
    assert(!edit.menu_focus(mut m), "nothing to focus")
    assert(!edit.menu_focused(m), "not focused")
    reset(mut m, "a b c")
    assert(!edit.menu_focused(m), "a list on screen is not focused")
    assert(edit.menu_focus(mut m), "focus")
    assert(edit.menu_focused(m), "focused")
    assert(m.sel == 0 && m.explicit_sel, "enters at the best match, explicit")
    edit.menu_blur(mut m)
    assert(!edit.menu_focused(m), "blurred")
    assert(m.explicit_sel && m.sel == 0, "the choice stands")
    assert(edit.menu_move(mut m, 1, false), "move")
    assert(m.sel == 1, "row 1")
    edit.menu_blur(mut m)
    assert(edit.menu_focus(mut m), "refocus")
    assert(m.sel == 1, "keeps the chosen row")
    edit.menu_unselect(mut m)
    assert(!edit.menu_focused(m), "unselected: not focused")
    assert(!m.explicit_sel && m.sel == -1, "no choice")
    assert(m.items.len == 3, "rows stay")
    assert(edit.menu_selected(m) == -1, "no selected row")
    assert(edit.menu_focus(mut m), "focus again")
    edit.menu_dismiss(mut m)
    assert(!edit.menu_focused(m) && !m.focus, "dismissed")
    edit.menu_free(mut m)
}

// `test_menu_focus_dies_with_a_lost_selection` (`:334-358`).
fn t_menu_focus_dies_with_a_lost_selection() {
    var m = edit.menu_new(edit.menuspec_default())
    reset(mut m, "alpha beta")
    assert(edit.menu_move(mut m, 1, false), "move")
    assert(edit.menu_move(mut m, 1, false), "move")
    assert(edit.menu_focus(mut m), "focus")
    assert(selected_is(m, "beta"), "beta")
    reset(mut m, "alpha gamma")
    assert(m.sel == -1 && !m.focus && !edit.menu_focused(m), "focus died with the row")
    reset(mut m, "alpha beta")
    assert(edit.menu_move(mut m, 1, false), "move")
    assert(edit.menu_focus(mut m), "focus")
    reset(mut m, "alpha beta")
    assert(edit.menu_focused(m), "a surviving selection keeps focus")
    assert(selected_is(m, "alpha"), "alpha")
    edit.menu_free(mut m)
}

fn main() {
    t_menu_selection_survives_a_refilter_by_identity()
    t_menu_lost_selection_falls_to_nothing_not_to_row_zero()
    t_menu_filtering_alone_never_makes_a_selection_explicit()
    t_menu_move_wraps_and_enters_from_either_end()
    t_menu_scrolls_to_keep_the_selection_visible()
    t_menu_page_moves_by_the_visible_row_count()
    t_menu_dismiss_and_empty_are_inert()
    t_menu_pager_scrolls_and_keeps_an_honest_tail()
    t_menu_no_tail_when_everything_fits()
    t_menu_focus_takes_the_arrows_and_gives_them_back()
    t_menu_focus_dies_with_a_lost_selection()
    print("menu_test: 11 cases pass")
}
