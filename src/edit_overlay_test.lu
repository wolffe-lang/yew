//! member: false
//!
//! The port of sagitta `tests/unit/test_overlay.c` (423 lines), one test
//! per C test in registry order (`tests/unit/registry.c:1634-1647`). C's
//! fixture is `nlines` lines of "aaaa\n" with "needle" planted on two,
//! inserted through the edit context, a 10-row window
//! (`test_overlay.c:22-46`); the port's is the same text through the
//! editor's seam with the window's rect and viewport placed. C passes the
//! program to `yew_overlay_refresh` and NULL clears; the port's refresh
//! reads the editor's program, so each case installs its own
//! (`edit.search_set_re`) and the NULL call is `edit.overlay_clear`.
//! The 1 us budget of `overlay_budget_exhaustion_yields_partial_spans`
//! is checked at the millisecond clock's resolution (G8).

use edit
use search
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

// `ov_fixture` (`test_overlay.c:22-46`).
fn fixture(nlines: int, plant_a: int, plant_b: int) -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    var src = List[byte]()
    var i = 0
    while i < nlines {
        let line = if i == plant_a || i == plant_b then "needle\n" else "aaaa\n"
        for b in line.bytes() {
            (mut src).push(b)
        }
        i += 1
    }
    assert(edit.ed_edit_insert(mut ed, ed.win, 0, src, 0, src.len), "fixture insert")
    let w = ed.win
    ed.wins[w].rect = edit.rect(0, 1, 80, 10)
    ed.wins[w].vp.rows = 10
    ed.wins[w].vp.cols = 80
    ed
}

// `ov_compile` (`test_overlay.c:48-59`): smartcase compile, installed.
fn install(mut ed: edit.Ed, pat: str) {
    var err = search.re_err_new()
    let re = edit.search_compile(bytes_of(pat), edit.search_opts_new(), mut err) else |_| {
        assert(false, "{pat} compiles")
        return
    }
    edit.search_set_re(mut ed, take re)
}

// `yew_re_compile` with no flags, installed.
fn install_plain(mut ed: edit.Ed, pat: str) {
    var err = search.re_err_new()
    let re = search.re_compile(bytes_of(pat), 0, mut err) else |_| {
        assert(false, "{pat} compiles")
        return
    }
    edit.search_set_re(mut ed, take re)
}

fn compiled(pat: str) -> search.Re ! {invalid} {
    var err = search.re_err_new()
    edit.search_compile(bytes_of(pat), edit.search_opts_new(), mut err)?
}

fn buf(ed: edit.Ed) -> int {
    ed.wins[ed.win].buf
}

fn len_of(ed: edit.Ed) -> int {
    text.textbuf_len(ed.bufs[buf(ed)].ec.tb)
}

fn set_cur(mut ed: edit.Ed, pos: int) {
    let w = ed.win
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].pos = pos
    ed.wins[w].cs.curs[p].anchor = pos
}

// DoD 5: line 2 is on screen, line 900 is not; the overlay finds exactly
// the one in scope.
fn t_overlay_scan_is_bounded_by_viewport_and_lookahead() {
    var ed = fixture(1000, 2, 900)
    let w = ed.win
    install(mut ed, "needle")
    edit.overlay_refresh(mut ed, w, 1, 0)
    assert(ed.wins[w].overlay.spans.len == 1, "one span, got {ed.wins[w].overlay.spans.len}")
    assert(ed.wins[w].overlay.spans[0].lo == 10, "line 2's")
    assert(ed.wins[w].overlay.scanned.hi < len_of(ed), "bounded")
}

fn t_overlay_lookahead_reaches_past_the_visible_lines() {
    var ed = fixture(1000, 20, 900)
    let w = ed.win
    install(mut ed, "needle")
    edit.overlay_refresh(mut ed, w, 1, 0)
    let visible_hi = text.textbuf_line_start(ed.bufs[buf(ed)].ec.tb, 11 as text.LineNo) as int
    assert(ed.wins[w].overlay.spans.len == 1, "one span")
    assert(ed.wins[w].overlay.spans[0].lo > visible_hi, "past the visible lines")
    assert(ed.wins[w].overlay.scanned.hi > visible_hi, "scanned past them")
}

fn t_overlay_scroll_inside_scanned_range_is_reused() {
    var ed = fixture(1000, 2, 900)
    let w = ed.win
    install(mut ed, "needle")
    edit.overlay_refresh(mut ed, w, 1, 0)
    let first = copy ed.wins[w].overlay.scanned
    let first_len = ed.wins[w].overlay.spans.len
    ed.wins[w].vp.top = 1
    edit.overlay_refresh(mut ed, w, 1, 0)
    assert(ed.wins[w].overlay.scanned.lo == first.lo, "scanned.lo reused")
    assert(ed.wins[w].overlay.scanned.hi == first.hi, "scanned.hi reused")
    assert(ed.wins[w].overlay.spans.len == first_len, "spans reused")
}

fn t_overlay_invalidates_on_pattern_and_buffer_generation() {
    var ed = fixture(100, 2, 3)
    let w = ed.win
    install(mut ed, "needle")
    edit.overlay_refresh(mut ed, w, 1, 0)
    assert(ed.wins[w].overlay.spans.len == 2, "two spans")
    assert(ed.wins[w].overlay.pat_gen == 1, "gen 1")
    edit.overlay_refresh(mut ed, w, 2, 0)
    assert(ed.wins[w].overlay.pat_gen == 2, "gen 2")
    let n = bytes_of("needle\n")
    assert(edit.ed_edit_insert(mut ed, w, 0, n, 0, n.len), "insert")
    edit.overlay_refresh(mut ed, w, 2, 0)
    assert(ed.wins[w].overlay.buf_gen == ed.bufs[buf(ed)].ec.tb.gen, "buffer generation")
    assert(ed.wins[w].overlay.spans.len == 3, "three spans")
}

fn t_overlay_budget_exhaustion_yields_partial_spans() {
    var ed = fixture(20000, 0, 1)
    let w = ed.win
    install(mut ed, "a")
    ed.wins[w].rect.h = 200
    edit.overlay_refresh(mut ed, w, 1, 1)
    assert(!ed.wins[w].overlay.complete, "cut short")
    assert(ed.wins[w].overlay.spans.len > 0, "not empty")
    let last = ed.wins[w].overlay.spans.len - 1
    assert(ed.wins[w].overlay.scanned.hi >= ed.wins[w].overlay.spans[last].lo, "scanned honestly")
    edit.overlay_refresh(mut ed, w, 1, 0)
    assert(ed.wins[w].overlay.complete, "the idle pass finishes")
}

fn t_overlay_spans_are_ascending_and_disjoint() {
    var ed = fixture(60, 1, 2)
    let w = ed.win
    install(mut ed, "a*")
    edit.overlay_refresh(mut ed, w, 1, 0)
    let len = len_of(ed)
    assert(ed.wins[w].overlay.spans.len > 0, "spans")
    var i = 0
    while i < ed.wins[w].overlay.spans.len {
        let s = copy ed.wins[w].overlay.spans[i]
        assert(s.lo <= s.hi, "ordered span")
        assert(s.hi <= len, "inside")
        if i > 0 {
            assert(ed.wins[w].overlay.spans[i - 1].hi <= s.lo, "disjoint")
        }
        i += 1
    }
}

fn t_overlay_cur_index_tracks_the_cursor() {
    var ed = fixture(20, 1, 3)
    let w = ed.win
    install(mut ed, "needle")
    edit.overlay_refresh(mut ed, w, 1, 0)
    assert(ed.wins[w].overlay.spans.len == 2, "two")
    assert(ed.wins[w].overlay.cur_index == -1, "off every match")
    set_cur(mut ed, ed.wins[w].overlay.spans[1].lo)
    edit.overlay_refresh(mut ed, w, 2, 0)
    assert(ed.wins[w].overlay.cur_index == 1, "on the second")
}

fn t_overlay_cur_index_updates_when_spans_are_reused() {
    var ed = fixture(20, 1, 3)
    let w = ed.win
    install(mut ed, "needle")
    set_cur(mut ed, 0)
    edit.overlay_refresh(mut ed, w, 1, 0)
    assert(ed.wins[w].overlay.spans.len == 2, "two")
    assert(ed.wins[w].overlay.complete, "complete")
    assert(ed.wins[w].overlay.cur_index == -1, "none")
    set_cur(mut ed, ed.wins[w].overlay.spans[0].lo)
    edit.overlay_refresh(mut ed, w, 1, 0)
    assert(ed.wins[w].overlay.cur_index == 0, "the first, reused")
    set_cur(mut ed, ed.wins[w].overlay.spans[1].lo)
    edit.overlay_refresh(mut ed, w, 1, 0)
    assert(ed.wins[w].overlay.cur_index == 1, "the second, reused")
    set_cur(mut ed, 0)
    edit.overlay_refresh(mut ed, w, 1, 0)
    assert(ed.wins[w].overlay.cur_index == -1, "none again")
}

fn t_overlay_null_pattern_clears() {
    var ed = fixture(20, 1, 3)
    let w = ed.win
    install(mut ed, "needle")
    edit.overlay_refresh(mut ed, w, 1, 0)
    assert(ed.wins[w].overlay.spans.len > 0, "spans")
    edit.overlay_clear(mut ed, w)
    assert(ed.wins[w].overlay.spans.len == 0, "cleared")
}

fn t_overlay_count_caps_at_ten_thousand() {
    var ed = fixture(20000, 0, 1)
    let w = ed.win
    let re = compiled("aaaa") else |_| {
        assert(false, "aaaa compiles")
        return
    }
    edit.overlay_count(mut ed.wins[w].overlay, re, ed.bufs[buf(ed)].ec.tb, 0)
    assert(ed.wins[w].overlay.count_total == edit.SEARCH_COUNT_MAX, "the cap")
    assert(ed.wins[w].overlay.count_capped, "capped")
}

fn t_overlay_count_is_exact_below_the_cap() {
    var ed = fixture(100, 5, 7)
    let w = ed.win
    let re = compiled("needle") else |_| {
        assert(false, "needle compiles")
        return
    }
    edit.overlay_count(mut ed.wins[w].overlay, re, ed.bufs[buf(ed)].ec.tb, 0)
    assert(ed.wins[w].overlay.count_total == 2, "two")
    assert(!ed.wins[w].overlay.count_capped, "exact")
}

fn t_overlay_interactive_count_is_exact_for_small_buffer() {
    var ed = fixture(1000, -1, -1)
    let w = ed.win
    let re = compiled("aaaa") else |_| {
        assert(false, "aaaa compiles")
        return
    }
    assert(len_of(ed) < edit.SEARCH_COUNT_BUDGET_BYTES, "below the byte ceiling")
    edit.overlay_count(mut ed.wins[w].overlay, re, ed.bufs[buf(ed)].ec.tb, 1)
    assert(ed.wins[w].overlay.count_total == 1000, "every match")
    assert(!ed.wins[w].overlay.count_capped, "exact")
}

fn t_overlay_interactive_count_is_byte_bounded() {
    var ed = fixture(60000, -1, -1)
    let w = ed.win
    let re = compiled("needle") else |_| {
        assert(false, "needle compiles")
        return
    }
    assert(len_of(ed) > edit.SEARCH_COUNT_BUDGET_BYTES, "past the byte ceiling")
    edit.overlay_count(mut ed.wins[w].overlay, re, ed.bufs[buf(ed)].ec.tb, 1000)
    assert(ed.wins[w].overlay.count_total == 0, "none in the window")
    assert(ed.wins[w].overlay.count_capped, "capped")
}

// DoD 9's structural half: refining the pattern damages only the lines
// whose highlight set changed.
fn t_overlay_damage_is_diffed_not_blanket() {
    var ed = fixture(40, 1, 3)
    let w = ed.win
    install(mut ed, "n")
    edit.overlay_refresh(mut ed, w, 1, 0)
    assert(ed.wins[w].overlay.spans.len == 2, "two wide")
    ed.doc_damage_lo = 0
    ed.doc_damage_hi = 0
    install_plain(mut ed, "needle")
    edit.overlay_refresh(mut ed, w, 2, 0)
    assert(ed.wins[w].overlay.spans.len == 2, "two narrow")
    assert(ed.doc_damage_lo == 1, "damage from 1, got {ed.doc_damage_lo}")
    assert(ed.doc_damage_hi == 4, "damage to 4, got {ed.doc_damage_hi}")
    ed.doc_damage_lo = 0
    ed.doc_damage_hi = 0
    install_plain(mut ed, "absent")
    edit.overlay_refresh(mut ed, w, 3, 0)
    assert(ed.wins[w].overlay.spans.len == 0, "none")
    assert(ed.doc_damage_lo == 1, "the old rows repaint, from 1")
    assert(ed.doc_damage_hi == 4, "to 4")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_overlay_scan_is_bounded_by_viewport_and_lookahead()
    t_overlay_lookahead_reaches_past_the_visible_lines()
    t_overlay_scroll_inside_scanned_range_is_reused()
    t_overlay_invalidates_on_pattern_and_buffer_generation()
    t_overlay_budget_exhaustion_yields_partial_spans()
    t_overlay_spans_are_ascending_and_disjoint()
    t_overlay_cur_index_tracks_the_cursor()
    t_overlay_cur_index_updates_when_spans_are_reused()
    t_overlay_null_pattern_clears()
    t_overlay_count_caps_at_ten_thousand()
    t_overlay_count_is_exact_below_the_cap()
    t_overlay_interactive_count_is_exact_for_small_buffer()
    t_overlay_interactive_count_is_byte_bounded()
    t_overlay_damage_is_diffed_not_blanket()
    print("overlay_test: 14 cases pass")
}
