//! member: false
//! Deliverable 6's gate (R-yw06-1 = A): fl.data (sagitta 9ace98c2
//! src/fl/data.c:1-372) against yw06's hand codec (ws.fl_parse, ws.fl_reemit,
//! ws.state_validate_v1) over tests/unit/fixtures/wsstate/v1/: the 22
//! canonical documents read and re-written byte-identical by both, the 4
//! noncanonical/ written to the same canonical bytes, the 20 invalid/
//! refused by both. fl.data's schema check is C's own route at the pin:
//! the value tree adapted to v1's literal tree (src/ws/state_fletch.c:
//! 129-196, state_value_to_lit) and validated as the hand codec validates.
//! The state path itself stays on the hand codec until yw09's swap.

use fl
use ws

const CANONICAL: str = "01-minimal.fl|02-one-tab.fl|03-all-defaults.fl|04-all-present.fl|05-group-ids-7-9-12.fl|06-orphan-path.fl|07-invalid-utf8-path.fl|08-control-bytes-path.fl|09-two-panes.fl|10-sixteen-leaves.fl|11-full-jumplist.fl|12-three-groups.fl|13-empty-group.fl|14-file-record-without-tab.fl|15-ratio-minimum.fl|16-ratio-maximum.fl|17-many-cursors.fl|18-maximal-512-tabs.fl|19-with-scratch-tab.fl|20-goal-eol.fl|21-cjk-path.fl|22-deep-pane-tree.fl"

const NONCANONICAL: str = "noncanonical/comments.fl|noncanonical/minimal-fields.fl|noncanonical/unknown-keys.fl|noncanonical/whitespace.fl"

const INVALID: str = "invalid/binary-junk.fl|invalid/depth-33.fl|invalid/empty-element.fl|invalid/empty.fl|invalid/integer-overflow.fl|invalid/lone-close.fl|invalid/missing-comma.fl|invalid/missing-key.fl|invalid/missing-value.fl|invalid/rejected-escape.fl|invalid/root-is-a-list.fl|invalid/root-is-nil.fl|invalid/trailing-bytes.fl|invalid/truncated-mid-record.fl|invalid/truncated-open-map.fl|invalid/two-documents.fl|invalid/unterminated-string.fl|invalid/version-99.fl|invalid/version-absent.fl|invalid/version-is-a-string.fl"

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

fn load(name: str) -> List[byte] {
    fs_read_bytes("tests/unit/fixtures/wsstate/v1/{name}") else {
        assert(false, "read fixture {name}")
        List[byte]()
    }
}

// YEW_DATA_FIXTURE: one fixture name (tools/check-test-cases.txt's @codec
// rows) or several joined by `|`; unset, every fixture.
fn selected(name: str) -> bool {
    let only = env_get("YEW_DATA_FIXTURE") else ""
    if only.len == 0 { return true }
    for want in only.split("|") { if want == name { return true } }
    false
}

// state_fletch.c:129-196: one value as a v1 literal node; none for a float
// or a runtime value, or a map key that is not a string.
fn lit_of(vm: fl.FlVm, mut doc: ws.FlDoc, v: fl.FlValue) -> int ! {none} {
    let id = doc.nodes.len
    var lit = ws.FlLit {
        kind: ws.FL_NIL,
        num: 0,
        text: ws.FlSpan { at: 0, len: 0 },
        items: List[int](),
        keys: List[ws.FlSpan](),
    }
    if v.t == fl.FL_NIL {
        (mut doc.nodes).push(lit)
        return id
    }
    if v.t == fl.FL_BOOL || v.t == fl.FL_INT {
        lit.kind = if v.t == fl.FL_BOOL then ws.FL_BOOL else ws.FL_INT
        lit.num = v.i
        (mut doc.nodes).push(lit)
        return id
    }
    if v.t == fl.FL_STR {
        let at = fl.fl_obj_index(vm, v)
        lit.kind = ws.FL_STR
        lit.text = ws.FlSpan { at: doc.bytes.len, len: vm.gc.slots[at].bytes.len }
        for b in vm.gc.slots[at].bytes { (mut doc.bytes).push(b) }
        (mut doc.nodes).push(lit)
        return id
    }
    if v.t == fl.FL_LIST {
        lit.kind = ws.FL_LIST
        (mut doc.nodes).push(lit)
        for i in 0..fl.fl_list_len(vm, v) {
            let item = fl.fl_list_get(vm, v, i)?
            let child = lit_of(vm, mut doc, item)?
            (mut doc.nodes[id].items).push(child)
        }
        return id
    }
    if v.t == fl.FL_MAP {
        lit.kind = ws.FL_MAP
        (mut doc.nodes).push(lit)
        var cursor = 0
        loop {
            let (next, key, val) = fl.fl_map_iter(vm, v, cursor) else break
            cursor = next
            if key.t != fl.FL_STR { return none }
            let at = fl.fl_obj_index(vm, key)
            let span = ws.FlSpan { at: doc.bytes.len, len: vm.gc.slots[at].bytes.len }
            for b in vm.gc.slots[at].bytes { (mut doc.bytes).push(b) }
            let child = lit_of(vm, mut doc, val)?
            (mut doc.nodes[id].keys).push(span)
            (mut doc.nodes[id].items).push(child)
        }
        return id
    }
    // The frozen workspace schema has no floats or runtime values.
    none
}

// fl.data's verdict on one document: (read cleanly, valid v1, the
// canonical rewrite). A refusal at read is a syntax refusal.
fn data_codec(raw: List[byte]) -> (bool, bool, List[byte]) {
    var vm = fl.fl_vm_new(take fl.fl_strings())
    var dc = fl.fl_diag_init()
    let v = fl.fl_data_read(mut vm, raw, mut dc)
    if dc.nerrors != 0 {
        assert(dc.entries.len > 0 && dc.entries[0].sp.line >= 1 && dc.entries[0].sp.col >= 1)
        return (false, false, List[byte]())
    }
    let root = fl.fl_temp_push(mut vm, v)
    let held = fl.fl_temp_get(vm, root)
    var doc = ws.fl_doc()
    var valid = false
    let top = lit_of(vm, mut doc, held) else -1
    if top >= 0 {
        doc.root = top
        valid = ws.state_validate_v1(doc)
    }
    var out = List[byte]()
    if valid { fl.fl_data_write(vm, mut out, held, 0) }
    (true, valid, out)
}

// The hand codec's verdict, the same three answers.
fn hand_codec(raw: List[byte]) -> (bool, bool, List[byte]) {
    let r = ws.fl_parse(raw, 0, raw.len)
    if !r.ok { return (false, false, List[byte]()) }
    if !ws.state_validate_v1(r.doc) { return (true, false, List[byte]()) }
    (true, true, ws.fl_reemit(r.doc))
}

fn t_canonical() -> int {
    var count = 0
    for name in CANONICAL.split("|") {
        count += 1
        if !selected(name) { continue }
        let raw = load(name)
        let (hok, hvalid, hand) = hand_codec(raw)
        let (dok, dvalid, data) = data_codec(raw)
        assert(hok && hvalid, "{name}: hand codec refused a canonical document")
        assert(dok && dvalid, "{name}: fl.data refused a canonical document")
        assert(same(raw, hand), "{name}: hand codec rewrite is not byte-identical")
        assert(same(raw, data), "{name}: fl.data rewrite is not byte-identical")
        let (again_ok, again_valid, again) = data_codec(data)
        assert(again_ok && again_valid && same(data, again), "{name}: fl.data not idempotent")
        print("fl_data {name}: PASS (both rewrite it byte-identical, {raw.len} bytes)")
    }
    count
}

fn t_noncanonical() -> int {
    var count = 0
    for name in NONCANONICAL.split("|") {
        count += 1
        if !selected(name) { continue }
        let raw = load(name)
        let (hok, hvalid, hand) = hand_codec(raw)
        let (dok, dvalid, data) = data_codec(raw)
        assert(hok && hvalid, "{name}: hand codec refused")
        assert(dok && dvalid, "{name}: fl.data refused")
        assert(same(hand, data), "{name}: the two canonical rewrites differ")
        let (again_ok, again_valid, again) = data_codec(data)
        assert(again_ok && again_valid && same(data, again), "{name}: fl.data not idempotent")
        print("fl_data {name}: PASS (both write the same {data.len} canonical bytes)")
    }
    count
}

fn t_invalid() -> (int, int) {
    var count = 0
    var syntax = 0
    for name in INVALID.split("|") {
        count += 1
        if !selected(name) { continue }
        let raw = load(name)
        let (hok, hvalid, _) = hand_codec(raw)
        let (dok, dvalid, _) = data_codec(raw)
        assert(!hvalid, "{name}: hand codec accepted an invalid document")
        assert(!dvalid, "{name}: fl.data accepted an invalid document")
        // Both refuse at the same stage: syntax, or the v1 schema after it.
        assert(hok == dok, "{name}: refused at read by one codec only")
        if !dok { syntax += 1 }
        let stage = if dok then "schema" else "syntax"
        print("fl_data {name}: PASS (refused by both at {stage})")
    }
    (count, syntax)
}

// Not a C case (C has no unit file for fl.data): data.h:20-25's four caps
// at their exact boundaries, each a fixture-like name for the selector.
fn data_errors(raw: List[byte]) -> (int, str) {
    var vm = fl.fl_vm_new(take fl.fl_strings())
    var dc = fl.fl_diag_init()
    let _ = fl.fl_data_read(mut vm, raw, mut dc)
    if dc.entries.len == 0 { return (dc.nerrors, "") }
    (dc.nerrors, copy dc.entries[0].msg)
}

fn nested(levels: int, inner: str) -> List[byte] {
    var out = List[byte]()
    for _ in 0..levels { (mut out).push(91 as byte) }
    for b in inner.bytes() { (mut out).push(b) }
    for _ in 0..levels { (mut out).push(93 as byte) }
    out
}

fn repeated(head: str, unit: str, n: int, tail: str) -> List[byte] {
    var out = List[byte]()
    for b in head.bytes() { (mut out).push(b) }
    for _ in 0..n { for b in unit.bytes() { (mut out).push(b) } }
    for b in tail.bytes() { (mut out).push(b) }
    out
}

fn want_ok(raw: List[byte], what: str) {
    let (n, msg) = data_errors(raw)
    assert(n == 0, "{what}: refused: {msg}")
}

fn want_err(raw: List[byte], what: str, msg: str) {
    let (n, got) = data_errors(raw)
    assert(n == 1 && got == msg, "{what}: {n} errors, first |{got}|, want |{msg}|")
}

fn t_caps() -> int {
    var count = 0
    count += 1
    if selected("caps/depth") {
        // The root is depth 1: a scalar inside 31 lists sits at 32.
        want_ok(nested(31, "1"), "31 lists around a scalar")
        want_err(
            nested(32, "1"),
            "32 lists around a scalar",
            "pure-literal data: nesting deeper than 32",
        )
        want_ok(nested(32, ""), "32 empty lists")
        want_err(nested(33, ""), "33 empty lists", "pure-literal data: nesting deeper than 32")
        print("fl_data caps/depth: PASS (32 levels read, 33 refused)")
    }
    count += 1
    if selected("caps/string") {
        want_ok(repeated("\"", "a", 4096, "\""), "a 4096-byte string")
        want_err(
            repeated("\"", "a", 4097, "\""),
            "a 4097-byte string",
            "pure-literal data: string exceeds the 4096-byte cap",
        )
        print("fl_data caps/string: PASS (4096 bytes read, 4097 refused)")
    }
    count += 1
    if selected("caps/bytes") {
        want_ok(repeated("1", " ", 8388607, ""), "an 8 MiB document")
        want_err(
            repeated("1", " ", 8388608, ""),
            "8 MiB and a byte",
            "pure-literal data: document exceeds 8 MiB",
        )
        print("fl_data caps/bytes: PASS (8 MiB read, one byte more refused)")
    }
    count += 1
    if selected("caps/nodes") {
        // The list is a node: 999,999 items make 1,000,000.
        want_ok(repeated("[", "0,", 999999, "]"), "1,000,000 nodes")
        want_err(
            repeated("[", "0,", 1000000, "]"),
            "1,000,001 nodes",
            "pure-literal data: node cap exceeded",
        )
        print("fl_data caps/nodes: PASS (1,000,000 nodes read, one more refused)")
    }
    count
}

fn main() {
    let c = t_canonical()
    let n = t_noncanonical()
    let (i, syntax) = t_invalid()
    let k = t_caps()
    assert(c == 22 && n == 4 && i == 20 && k == 4)
    let only = env_get("YEW_DATA_FIXTURE") else ""
    if only.len == 0 {
        assert(syntax == 15)
        print(
            "PASS fl_data 22 canonical / 4 noncanonical / 20 invalid (15 syntax, 5 schema) / 4 caps",
        )
    } else {
        print("PASS fl_data {only}")
    }
}
