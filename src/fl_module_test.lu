//! member: false
//! Sprint 31 deliverable 9's `import`: sagitta 9ace98c2
//! tests/unit/test_fl_module.c:1-327 (9 cases, registry order:
//! registry.c:1906, :2093-2100), over flfix.

use fl
use flfix

fn write_lib(mut f: flfix.FlFix) {
    flfix.write(
        mut f,
        "lib.fl",
        "let answer = 42\nlet _private = 7\nfn twice(x) {{ return x + x }}\n",
    )
}

fn fl_modules_list_natives_is_deterministic() {
    var f = flfix.open()
    var a = List[byte]()
    var b = List[byte]()
    let na = fl.fl_std_list_natives(mut a)
    let nb = fl.fl_std_list_natives(mut b)
    assert(na == nb && a.len == b.len)
    for i in 0..a.len { assert(a[i] == b[i]) }
    let text = str_from_utf8(a) else ""
    assert(text.starts_with("str.len\n"))
    var has_escape = false
    var i = 0
    while i + 10 <= text.len {
        if text[i..i + 10] == "re.escape\n" { has_escape = true }
        i += 1
    }
    assert(has_escape)
    assert(text.ends_with("ai.backend\n"))
    var lines = 0
    for x in a { if x as int == 10 { lines += 1 } }
    assert(lines == na)
    // 187 = the stdlib's 118 plus the editor API's 69 (test_fl_module.c:306-316).
    assert(na == 187)
    flfix.close(mut f)
}

fn fl_modules_bare_name_is_a_builtin_and_only_that() {
    var f = flfix.open()
    flfix.eq(mut f, "import fmt\nreturn fmt.str(1)\n", "1")
    flfix.eq(mut f, "import str\nreturn str.upper(\"a\")\n", "A")
    flfix.eq(
        mut f,
        "import nope\nreturn 1\n",
        "!import: there is no builtin module 'nope'; they are str, list, map, math, fmt, io, re, buf, win, cur, span, opt, ed, ai",
    )
    flfix.close(mut f)
}

fn fl_modules_a_quoted_path_resolves_beside_its_importer() {
    var f = flfix.open()
    write_lib(mut f)
    flfix.mkdir(mut f, "sub")
    flfix.write(mut f, "sub/uses.fl", "import \"../lib.fl\" as l\nlet v = l.answer\n")
    flfix.eq(mut f, "import \"lib.fl\" as l\nreturn l.answer\n", "42")
    flfix.eq(mut f, "import \"lib.fl\" as l\nreturn l.twice(4)\n", "8")
    flfix.eq(mut f, "import \"sub/uses.fl\" as u\nreturn u.v\n", "42")
    flfix.eq(
        mut f,
        "let n = 0\nif true {{ import \"lib.fl\" as l\nn = l.answer }}\nreturn n\n",
        "42",
    )
    flfix.close(mut f)
}

fn fl_modules_not_found_lists_every_path_tried() {
    var f = flfix.open()
    let xdg = env_get("XDG_CONFIG_HOME") else ""
    let home = env_get("HOME") else ""
    let cfg = if xdg.len != 0 then "{xdg}/yew" else "{home}/.config/yew"
    var runtime = env_get("YEW_RUNTIME_DIR") else ""
    if runtime.len == 0 { runtime = fl.FL_RUNTIME_PREFIX }
    let dir = flfix.tmpdir(mut f)
    let want = "!import: cannot find 'missing.fl'; tried:\n  {dir}/missing.fl\n  {cfg}/fl/missing.fl\n  {runtime}/missing.fl"
    flfix.eq(mut f, "import \"missing.fl\" as m\nreturn 1\n", want)
    flfix.close(mut f)
}

fn exports_id(f: flfix.FlFix, idx: int) -> int {
    let v = fl.fl_module_exports(f.vm, idx) else fl.fl_nil()
    assert(v.t == fl.FL_MAP)
    v.i
}

fn fl_modules_load_once_per_realpath() {
    var f = flfix.open()
    write_lib(mut f)
    flfix.eq(mut f, "import \"lib.fl\" as x\nimport \"./lib.fl\" as y\nreturn x == y\n", "true")
    flfix.mkdir(mut f, "sub")
    flfix.eq(
        mut f,
        "import \"lib.fl\" as x\nimport \"sub/../lib.fl\" as y\nreturn x == y\n",
        "true",
    )
    let before = f.vm.mods.len
    f.origin.kind = fl.FL_ORIGIN_PLUGIN
    f.origin.principal_id = 101
    flfix.eq(mut f, "import \"lib.fl\" as x\nreturn x.answer\n", "42")
    // C keeps the first owner's map pointer; a compacting heap keeps the
    // row instead and compares the two maps' identities together.
    let first_row = f.vm.mods.len - 1
    f.origin.principal_id = 102
    flfix.eq(mut f, "import \"lib.fl\" as x\nreturn x.answer\n", "42")
    assert(f.vm.mods.len == before + 2)
    assert(exports_id(f, first_row) != exports_id(f, f.vm.mods.len - 1))
    assert(f.vm.mods[f.vm.mods.len - 2].origin.principal_id == 101)
    assert(f.vm.mods[f.vm.mods.len - 1].origin.principal_id == 102)
    flfix.close(mut f)
}

fn fl_modules_export_every_top_level_name_but_the_private() {
    var f = flfix.open()
    write_lib(mut f)
    flfix.eq(mut f, "import \"lib.fl\" as l\nreturn l.answer\n", "42")
    flfix.eq(
        mut f,
        "import \"lib.fl\" as l\nreturn l._private\n",
        "!key: no field '_private' on map",
    )
    flfix.eq(mut f, "import \"lib.fl\" as l\nl.answer = 1\nreturn 1\n", "!type: object is frozen")
    flfix.close(mut f)
}

fn rooted(f: flfix.FlFix, idx: int) -> bool {
    let v = fl.fl_map_get(f.vm, f.vm.modules, fl.fl_int(idx)) else { return false }
    v.t == fl.FL_MAP
}

fn fl_modules_keep_their_own_globals() {
    var f = flfix.open()
    flfix.write(
        mut f,
        "own.fl",
        "import str\nlet secret = \"inside\"\nfn peek() {{ return str.upper(secret) }}\n",
    )
    flfix.eq(
        mut f,
        "let secret = \"outside\"\nimport \"own.fl\" as o\nreturn o.peek() + \"/\" + secret\n",
        "INSIDE/outside",
    )
    flfix.write(mut f, "nested.fl", "let answer = 1\n")
    flfix.write(mut f, "reload.fl", "import \"nested.fl\" as n\nlet answer = n.answer\n")
    f.origin.kind = fl.FL_ORIGIN_PLUGIN
    f.origin.principal_id = 73
    flfix.eq(mut f, "import \"reload.fl\" as r\nreturn r.answer\n", "1")
    let idx = f.vm.mods.len - 2
    let nested_idx = f.vm.mods.len - 1
    assert(rooted(f, idx) && rooted(f, nested_idx))
    fl.fl_module_drop_principal(mut f.vm, 73)
    assert(f.vm.mods[idx].state == fl.FL_MOD_DROPPED)
    assert(f.vm.mods[nested_idx].state == fl.FL_MOD_DROPPED)
    let _ = fl.fl_module_exports(f.vm, idx) else fl.fl_nil()
    assert(!rooted(f, idx) && !rooted(f, nested_idx))
    flfix.write(mut f, "nested.fl", "let answer = 2\n")
    flfix.eq(mut f, "import \"reload.fl\" as r\nreturn r.answer\n", "2")
    assert(f.vm.mods[idx].state == fl.FL_MOD_READY)
    assert(f.vm.mods[nested_idx].state == fl.FL_MOD_READY)
    assert(rooted(f, idx) && rooted(f, nested_idx))
    flfix.close(mut f)
}

fn fl_modules_a_cycle_names_the_whole_chain() {
    var f = flfix.open()
    let dir = flfix.tmpdir(mut f)
    flfix.write(mut f, "a.fl", "import \"b.fl\" as b\nlet from_a = 1\n")
    flfix.write(mut f, "b.fl", "import \"c.fl\" as c\nlet from_b = 2\n")
    flfix.write(mut f, "c.fl", "import \"a.fl\" as a\nlet from_c = 3\n")
    let want = "!import: import cycle:\n  {dir}/a.fl\n  -> {dir}/b.fl\n  -> {dir}/c.fl\n  -> {dir}/a.fl"
    flfix.eq(mut f, "import \"a.fl\" as a\nreturn 1\n", want)
    flfix.close(mut f)
}

fn fl_modules_deferred_surfaces_name_their_sprint() {
    var f = flfix.open()
    flfix.eq(mut f, "return bind\n", "<fn>")
    flfix.eq(mut f, "return unbind\n", "<fn>")
    flfix.eq(mut f, "return set\n", "<fn>")
    flfix.eq(mut f, "return record\n", "<fn>")
    flfix.eq(mut f, "return replay\n", "<fn>")
    flfix.eq(mut f, "return buf\n", "!name: undefined name 'buf'")
    flfix.eq(mut f, "import buf\nreturn buf.current()\n", "!handle: no editor is attached")
    flfix.eq(mut f, "return nope\n", "!name: undefined name 'nope'")
    flfix.eq(mut f, "import io\nreturn io.run\n", "!key: no field 'run' on map")
    flfix.eq(mut f, "import io\nreturn io.http\n", "!key: no field 'http' on map")
    flfix.close(mut f)
}

fn main() {
    fl_modules_list_natives_is_deterministic()
    fl_modules_bare_name_is_a_builtin_and_only_that()
    fl_modules_a_quoted_path_resolves_beside_its_importer()
    fl_modules_not_found_lists_every_path_tried()
    fl_modules_load_once_per_realpath()
    fl_modules_export_every_top_level_name_but_the_private()
    fl_modules_keep_their_own_globals()
    fl_modules_a_cycle_names_the_whole_chain()
    fl_modules_deferred_surfaces_name_their_sprint()
    print("PASS fl_module 9")
}
