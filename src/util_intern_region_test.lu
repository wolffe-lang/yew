//! member: false
//! The interner owns new glyph/identifier bytes after a scratch region ends.

use util

fn main() {
    var delta: int = 0
    region owner {
        var it = util.interner_new()
        for i in 0..4 {
            region scratch {
                assert(util.intern(mut it, "cluster-{i}") == i + 1)
            }
        }
        let before = region_bytes(owner)
        for i in 0..1000 {
            region scratch {
                let n = i % 4
                assert(util.intern(mut it, "cluster-{n}") == n + 1)
            }
        }
        delta = region_bytes(owner) - before
        for i in 0..4 {
            assert((util.intern_str(it, i + 1) else "") == "cluster-{i}")
        }
        assert(util.intern(mut it, "cluster-0") == 1)
        assert(util.intern(mut it, "cluster-1") == 2)
        assert(util.intern(mut it, "cluster-2") == 3)
        assert(util.intern(mut it, "cluster-3") == 4)
        assert(util.intern_count(it) == 4)
    }
    assert(delta == 0, "intern hits retained {delta} bytes")
    print("intern_region: bytes survive scratch; 1000 hits retain 0 bytes: PASS")
}
