//! member: false
//! Ports sagitta tests/unit/test_startup.c:1-139 at 9ace98c2: the three
//! `registry.c` startup-plan cases in order (s56.5 §1's table): resume,
//! files and an explicit workspace; a directory and a symlink launch
//! canonicalized; mixed and ambiguous directories refused.

use std.env as std_env
use std.fs
use edit
use util

struct StartFix { dir: str, link: str }

// `start_fix_make` (`test_startup.c:18-33`): a fresh canonical directory
// and a symlink to it beside it (`<dir>-link`).
fn start_fix_make() -> StartFix {
    assert(util.mkdirs("target/startup-fixtures", 448))
    var dir = ""
    loop {
        var suffix = ""
        for r in os_random(6) { suffix = "{suffix}{r % 10}" }
        dir = "target/startup-fixtures/yew-start-{suffix}"
        fs_create_dir_mode(dir, 448) else |e| match e {
            exists => { continue },
            _ => { assert(false, "mkdir fixture: {e}") },
        }
        break
    }
    dir = fs_realpath(dir) else {
        assert(false)
        return StartFix { dir: "", link: "" }
    }
    let link = "{dir}-link"
    fs.symlink(dir, link) else |_| { assert(false, "symlink") }
    StartFix { dir: dir, link: link }
}

// `start_fix_remove` (`test_startup.c:35-39`).
fn start_fix_remove(f: StartFix) {
    fs_remove(f.link) else { assert(false, "unlink {f.link}") }
    fs_remove_dir(f.dir) else { assert(false, "rmdir {f.dir}") }
}

fn same(a: List[str], b: List[str]) -> bool {
    if a.len != b.len { return false }
    var i = 0
    while i < a.len {
        if a[i] != b[i] { return false }
        i += 1
    }
    true
}

// `test_startup_plan_resolves_resume_files_and_explicit_workspace`
// (`test_startup.c:41-79`).
fn t_resolves_resume_files_and_explicit_workspace() {
    let f = start_fix_make()
    var files = List[str]()
    (mut files).push("alpha.txt")
    (mut files).push("elsewhere/beta.txt")
    let here = std_env.cwd() else "."
    let cwd = fs_realpath(here) else {
        assert(false)
        return
    }
    let (plan, err) = edit.start_plan_resolve(List[str](), "", false)
    assert(err.len == 0, err)
    assert(plan.kind == edit.START_RESUME)
    assert(plan.workspace == cwd)
    assert(plan.workspace_display == cwd)
    assert(plan.files.len == 0)
    assert(!plan.enter_fuss)

    let (plan2, err2) = edit.start_plan_resolve(files, "", false)
    assert(err2.len == 0, err2)
    assert(plan2.kind == edit.START_FILES)
    assert(same(plan2.files, files))
    assert(plan2.workspace == cwd)
    assert(plan2.workspace_display == cwd)
    assert(!plan2.enter_fuss)

    let (plan3, err3) = edit.start_plan_resolve(files, f.link, true)
    assert(err3.len == 0, err3)
    assert(plan3.kind == edit.START_FILES)
    assert(plan3.workspace == f.dir)
    assert(plan3.workspace_display == f.link)
    assert(same(plan3.files, files))
    start_fix_remove(f)
}

// `test_startup_plan_canonicalizes_directory_and_symlink_launches`
// (`test_startup.c:81-112`).
fn t_canonicalizes_directory_and_symlink_launches() {
    let f = start_fix_make()
    let dotted = "{f.dir}/."
    var paths = List[str]()
    (mut paths).push(dotted)
    let (plan, err) = edit.start_plan_resolve(paths, "", false)
    assert(err.len == 0, err)
    assert(plan.kind == edit.START_DIRECTORY)
    assert(plan.workspace == f.dir)
    assert(plan.workspace_display == dotted)
    assert(plan.files.len == 0)
    assert(plan.enter_fuss)

    var link = List[str]()
    (mut link).push(f.link)
    let (plan2, err2) = edit.start_plan_resolve(link, "", false)
    assert(err2.len == 0, err2)
    assert(plan2.kind == edit.START_DIRECTORY)
    assert(plan2.workspace == f.dir)
    assert(plan2.workspace_display == f.link)
    assert(plan2.enter_fuss)
    start_fix_remove(f)
}

// `test_startup_plan_rejects_mixed_and_ambiguous_directories`
// (`test_startup.c:114-139`).
fn t_rejects_mixed_and_ambiguous_directories() {
    let f = start_fix_make()
    var mixed = List[str]()
    (mut mixed).push("alpha.txt")
    (mut mixed).push(f.link)
    let (_, err) = edit.start_plan_resolve(mixed, "", false)
    assert(err.contains("directory argument cannot be combined"), err)

    var directory = List[str]()
    (mut directory).push(f.dir)
    let (_, err2) = edit.start_plan_resolve(directory, f.dir, true)
    assert(err2.contains("--workspace"), err2)
    let (_, err3) = edit.start_plan_resolve(List[str](), "/no/such/yew-workspace", true)
    assert(err3.contains("workspace is not a directory"), err3)
    start_fix_remove(f)
}

fn main() {
    t_resolves_resume_files_and_explicit_workspace()
    print("startup_plan_resolves_resume_files_and_explicit_workspace: PASS")
    t_canonicalizes_directory_and_symlink_launches()
    print("startup_plan_canonicalizes_directory_and_symlink_launches: PASS")
    t_rejects_mixed_and_ambiguous_directories()
    print("startup_plan_rejects_mixed_and_ambiguous_directories: PASS")
}
