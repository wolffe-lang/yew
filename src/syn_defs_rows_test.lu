//! member: false
//! Component rows for the definition format (sagitta src/syn/defs.c at
//! 9ace98c2), beside the one-for-one port in syn_defs_test.lu. Compiles
//! data to ordered tables; never executes Fletch.

use syn

fn compiled(source: str) -> syn.SynCompileResult {
    syn.syn_compile("syntax.fl", source.bytes())
}

fn basic_tables() {
    let c = compiled(
        "{{syntax:1, language:{{name:\"toy\",extensions:[\"toy\"]}}, contexts:{{main:{{rules:[{{match:\"[0-9]+\",attr:\"number\"}}]}}}}}}",
    )
    assert(c.diagnostics.nerrors == 0, "valid definition")
    assert(c.definition.contexts.len == 1 && c.definition.rules.len == 1, "flat compiled tables")
    assert(c.definition.rules[0].attr == 9, "semantic number id")
    assert(c.definition.rules[0].regex > 0, "compiled pattern index")
    assert(
        c.definition.name.len == 3 && c.definition.name[0] as int == 116,
        "byte-preserving language name",
    )
    assert(syn.syn_first_has(c.definition.rules[0].first, 48), "first-byte digit present")
    assert(
        !syn.syn_first_has(c.definition.rules[0].first, 120),
        "first-byte irrelevant letter absent",
    )
}

fn rejects_unknown_schema() {
    let c = compiled("{{syntax:2,language:{{name:\"toy\"}},contexts:{{main:{{rules:[]}}}}}}")
    assert(c.diagnostics.nerrors > 0, "unknown schema refused")
    assert(c.diagnostics.entries[0].msg.contains("unknown schema version 2"), "schema diagnostic")
}

fn unknown_key_suggestion() {
    let c = compiled(
        "{{syntax:1,language:{{name:\"toy\"}},contexts:{{main:{{rules:[{{matchh:\"x\"}}]}}}}}}",
    )
    assert(c.diagnostics.nerrors > 0, "unknown rule key")
    assert(
        c.diagnostics.entries[0].msg == "unknown key 'matchh' (did you mean 'match'?)",
        "pinned suggestion",
    )
}

fn include_order_and_default() {
    let c = compiled(
        "{{syntax:1,language:{{name:\"toy\"}},contexts:{{main:{{default:\"text\",rules:[{{match:\"a\",attr:\"keyword\"}},\"include:shared\",{{match:\"c\",attr:\"number\"}}]}},shared:{{default:\"comment\",rules:[{{match:\"b\"}}]}}}}}}",
    )
    assert(c.diagnostics.nerrors == 0, "valid include")
    let start = c.definition.contexts[0].first_rule
    assert(c.definition.contexts[0].nrules == 3, "include spliced in place")
    assert(c.definition.rules[start].attr == 1, "first local rule")
    assert(c.definition.rules[start + 1].attr == 0, "included rule uses include-site default")
    assert(c.definition.rules[start + 2].attr == 9, "last local rule")
}

fn include_cycle() {
    let c = compiled(
        "{{syntax:1,language:{{name:\"toy\"}},contexts:{{main:{{rules:[\"include:other\"]}},other:{{rules:[\"include:main\"]}}}}}}",
    )
    assert(c.diagnostics.nerrors > 0, "include cycle refused")
    assert(c.diagnostics.entries[0].msg.contains("include cycle reaches"), "cycle diagnostic")
}

fn captures_and_consume() {
    let c = compiled(
        "{{syntax:1,language:{{name:\"toy\"}},contexts:{{main:{{rules:[{{match:\"(a)(b)\",attr:\"text\",captures:{{1:\"keyword\",2:\"string\"}},consume:1}}]}}}}}}",
    )
    assert(c.diagnostics.nerrors == 0, "capture definition")
    assert(c.definition.rules[0].caps[1] as int == 1, "first capture")
    assert(c.definition.rules[0].caps[2] as int == 12, "second capture")
    assert(c.definition.rules[0].consume == 1, "consume group")
    let bad = compiled(
        "{{syntax:1,language:{{name:\"toy\"}},contexts:{{main:{{rules:[{{match:\"(a)\",consume:2}}]}}}}}}",
    )
    assert(bad.diagnostics.nerrors > 0, "nonexistent consume capture refused")
}

fn state_ops_and_eol() {
    let c = compiled(
        "{{syntax:1,language:{{name:\"toy\"}},contexts:{{main:{{rules:[{{match:\"a\",push:[\"outer\",\"inner\"]}}]}},outer:{{rules:[],at_eol:\"pop\"}},inner:{{rules:[{{match:\"b\",pop:2}}],at_eol:\"set:main\"}}}}}}",
    )
    assert(c.diagnostics.nerrors == 0, "valid state operations")
    assert(c.definition.rules[0].op == syn.SYN_OP_PUSH, "push op")
    assert(c.definition.rules[0].pushes.len == 2, "multi-push")
    assert(
        c.definition.rules[0].pushes[0] == 1 && c.definition.rules[0].pushes[1] == 2,
        "context targets",
    )
    assert(c.definition.contexts[1].eol_op == syn.SYN_OP_POP, "eol pop")
    assert(c.definition.contexts[2].eol_op == syn.SYN_OP_SET, "eol set")
}

fn aliases() {
    let c = compiled(
        "{{syntax:1,language:{{name:\"toy\"}},attrs:{{kw:\"keyword.control\"}},contexts:{{main:{{rules:[{{match:\"if\",attr:\"kw\"}}]}}}}}}",
    )
    assert(c.diagnostics.nerrors == 0, "attribute alias")
    assert(c.definition.rules[0].attr == 2, "alias semantic id")
}

fn no_empty_regex() {
    let c = compiled(
        "{{syntax:1,language:{{name:\"toy\"}},contexts:{{main:{{rules:[{{match:\"a*\"}}]}}}}}}",
    )
    assert(c.diagnostics.nerrors > 0, "empty regex rejected by data compiler")
    let aux = compiled(
        "{{syntax:1,language:{{name:\"toy\"}},contexts:{{main:{{rules:[{{aux:\"line_start\",set:\"next\"}}]}},next:{{rules:[],at_eol:\"set:main\"}}}}}}",
    )
    assert(aux.diagnostics.nerrors == 0, "sanctioned zero-width state transition")
    assert(
        aux.definition.rules[0].flags & syn.SYN_RULE_ZERO_TRANSITION != 0,
        "zero transition marked",
    )
}

fn aux_rule_fields() {
    let c = compiled(
        "{{syntax:1,language:{{name:\"toy\"}},contexts:{{main:{{rules:[{{match:\"([A-Z]+)\",set_aux:1,strip:true,value:true,push:\"body\"}}]}},body:{{default:\"string\",rules:[{{aux:\"line_eq\",pop:1}}]}}}}}}",
    )
    assert(c.diagnostics.nerrors == 0, "heredoc definition")
    assert(c.definition.rules[0].aux_group == 1, "delimiter capture")
    assert(c.definition.rules[0].flags & syn.SYN_RULE_STRIP != 0, "strip flag")
    assert(c.definition.rules[1].aux_match == syn.SYN_AUXM_LINE_EQ, "aux matcher")
}

fn main() {
    let selected = (env_get("YEW_SYN_DEFS_CASE") else "-1").to_int() else -1
    var i = 0
    while i < 10 {
        if selected == -1 || selected == i {
            match i {
                0 => basic_tables(),
                1 => rejects_unknown_schema(),
                2 => unknown_key_suggestion(),
                3 => include_order_and_default(),
                4 => include_cycle(),
                5 => captures_and_consume(),
                6 => state_ops_and_eol(),
                7 => aliases(),
                8 => no_empty_regex(),
                _ => aux_rule_fields(),
            }
            print("syn_defs_case_{i}: PASS")
        }
        i += 1
    }
}
