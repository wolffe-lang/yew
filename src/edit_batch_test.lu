//! member: false
//! The six tests/unit/test_batch.c cases at sagitta 9ace98c2, in registry
//! order (Sprint 37: `--batch` never touches the terminal). C's fixture
//! is `yew_ed_init` headless with the terminal poisoned
//! (test_batch.c:19-24). C's NULL grid and input buffers are the port's
//! `grid_ready`/`input_ready` flags (an `Ed` holds a placeholder grid from
//! `ed_new`), its `tty.rfd < 0` `!tty.opened`; the seeded-rejection case
//! sets those flags where C points the arrays at a fake cell or byte.
//!
//! **SKIP by name.** `batch_profiler_dumps_one_frame_per_executed_
//! statement` (test_batch.c:158-216) reads `YEW_PROF`'s report, the
//! profiler's (`util/prof`, Sprint 56), which docs/MAP.md gives yw15; the
//! port's batch has no dump before it, so the case says SKIP.

use edit
use term
use text

fn batch_fixture() -> edit.Ed {
    var ed = edit.ed_new()
    ed.headless = true
    term.tty_poison(mut ed.tty)
    ed
}

fn batch_selfcheck_pins_every_uninitialized_subsystem() {
    let ed = batch_fixture()
    assert(edit.batch_selfcheck_why(ed) == "")
    assert(!ed.grid_ready, "no grid")
    assert(!ed.input_ready, "no input buffer")
    assert(ed.tty.poisoned)
    assert(!ed.tty.opened, "no terminal descriptor")
    assert(ed.timers.len == 0)
    assert(!ed.tty_ready)
    assert(!ed.input_ready)
    assert(!ed.grid_ready)
    assert(!ed.render_ready)
}

fn batch_selfcheck_rejects_seeded_grid_input_tty_and_timer() {
    var ed = batch_fixture()
    ed.grid_ready = true
    assert(edit.batch_selfcheck_why(ed) == "grid initialized")
    ed.grid_ready = false
    ed.input_ready = true
    assert(edit.batch_selfcheck_why(ed) == "input initialized")
    ed.input_ready = false
    ed.tty.poisoned = false
    assert(edit.batch_selfcheck_why(ed) == "terminal not poisoned")
    ed.tty.poisoned = true
    ed.timers.len = 1
    assert(edit.batch_selfcheck_why(ed) == "timer installed")
    ed.timers.len = 0
}

fn batch_selfcheck_rejects_interactive_installed_binding() {
    var ed = batch_fixture()
    let row = edit.BindRow { seq: "x", cmd: "ed.search.open", iarg: 0, sarg: "", has_sarg: false }
    let (ok, interactive) = edit.keymap_build(ed.reg, "batch-negative", [row])
    assert(ok)
    let saved = copy ed.keys
    (mut ed.keymaps).push(interactive)
    ed.keys = [ed.keymaps.len - 1]
    assert(edit.batch_selfcheck_why(ed) == "interactive command bound")
    ed.keys = saved
}

fn batch_refusal_table_covers_every_interactive_command() {
    let ed = edit.ed_new()
    var interactive = 0
    var git_interactive = 0
    for i in 0..ed.reg.entries.len {
        if !ed.reg.entries[i].active || ed.reg.entries[i].flags & edit.CMD_INTERACTIVE == 0 { continue }
        let name = ed.reg.entries[i].name
        interactive += 1
        let cx = edit.cmdctx_new(-1, edit.SRC_TEST)
        let alt = edit.batch_command_alternative(name, cx)
        assert(alt.len != 0, "no batch alternative row for {name}")
        if name.starts_with("ed.git.") {
            git_interactive += 1
            assert(alt == "no batch alternative", name)
        }
    }
    assert(interactive >= 39, "interactive={interactive}")
    assert(git_interactive == 19, "git_interactive={git_interactive}")
}

fn batch_memory_buffer_is_byte_exact_named_and_initially_clean() {
    let bytes = [97 as byte, 13 as byte, 10 as byte, 128 as byte, 255 as byte, 122 as byte]
    var ed = batch_fixture()
    edit.ed_open_memory(mut ed, bytes, "[stdin]")
    let bi = edit.ed_doc(ed)
    assert(edit.buf_label(ed.bufs[bi]) == "[stdin]")
    assert(ed.bufs[bi].flags & edit.BUF_SCRATCH != 0)
    assert(!edit.buf_dirty(ed.bufs[bi]))
    assert(text.textbuf_len(ed.bufs[bi].ec.tb) == bytes.len)
    let got = text.textbuf_bytes(ed.bufs[bi].ec.tb)
    assert(got.len == bytes.len)
    for i in 0..bytes.len { assert(got[i] == bytes[i]) }
}

fn batch_profiler_dumps_one_frame_per_executed_statement() -> int {
    let what = "batch_profiler_dumps_one_frame_per_executed_statement: the profiler (util/prof, sagitta Sprint 56) is yw15's"
    print("batch_test: SKIP {what}")
    eprint("batch_test: SKIP {what}")
    1
}

fn main() {
    var skips = 0
    batch_selfcheck_pins_every_uninitialized_subsystem()
    batch_selfcheck_rejects_seeded_grid_input_tty_and_timer()
    batch_selfcheck_rejects_interactive_installed_binding()
    batch_refusal_table_covers_every_interactive_command()
    batch_memory_buffer_is_byte_exact_named_and_initially_clean()
    skips += batch_profiler_dumps_one_frame_per_executed_statement()
    print("batch_test: 6 cases run, {skips} SKIP by name (the profiler, yw15)")
}
