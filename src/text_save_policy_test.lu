//! member: false
//!
//! The port of sagitta `tests/unit/test_save_policy.c` (343 lines), one
//! test per C test in registry order (`tests/unit/registry.c:42-45`), each
//! C test's trailing static case run at its end as C runs it. The first
//! test's three `yew_opt_desc` rows (`edit/option.c:305-322`) are the
//! option table's (`edit.opt_table`), which sprint 36 landed (campaign 07,
//! yw09); they said SKIP before it and run now. C's `utimensat` is
//! `fs.set_times`, C's `realpath` the port's `text.file_realpath` (G4).

use edit
use std.fs
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

// C's `mkdtemp("/tmp/<prefix>-XXXXXX")`.
fn fresh_dir(prefix: str) -> str {
    var tries = 0
    while tries < 100 {
        var suffix = ""
        for r in os_random(6) {
            suffix = suffix + "{r % 10}"
        }
        let dir = "/tmp/{prefix}-{suffix}"
        fs_create_dir_mode(dir, 448) else |e| match e {
            exists => {
                tries += 1
                continue
            },
            denied => { assert(false, "mkdtemp denied") },
            invalid => { assert(false, "mkdtemp invalid") },
            not_found => { assert(false, "mkdtemp not found") },
            unsupported => { assert(false, "mkdtemp unsupported") },
            io => { assert(false, "mkdtemp io") },
        }
        return dir
    }
    assert(false, "mkdtemp exhausted")
    ""
}

// `policy_write`, `test_save_policy.c:21-35`: O_WRONLY|O_CREAT|O_TRUNC, 0600.
fn policy_write(path: str, data: List[byte]) {
    let fd = fs_open_perm(path, 1, 384) else {
        assert(false, "open {path}")
        return
    }
    if data.len != 0 {
        fs_write_chunk(fd, data) else {
            assert(false, "write {path}")
        }
    }
    fs_close(fd) else {
        assert(false, "close {path}")
    }
}

// `policy_assert_bytes`, `test_save_policy.c:37-49`.
fn assert_bytes(path: str, want: List[byte]) {
    let got = fs_read_bytes(path) else {
        assert(false, "read {path}")
        return
    }
    assert(same(got, want), "{path} holds the expected bytes")
}

fn remove_tree(path: str) {
    let w = fs_lstat(path) else {
        return
    }
    if w[0] == 1 {
        let entries = fs_read_dir(path) else {
            assert(false, "opendir {path}")
            return
        }
        for e in entries {
            remove_tree("{path}/{e}")
        }
        rmdir(path)
    } else {
        unlink(path)
    }
}

fn unlink(path: str) {
    fs_remove(path) else {
        assert(false, "unlink {path}")
    }
}

fn rmdir(path: str) {
    fs_remove_dir(path) else {
        assert(false, "rmdir {path}")
    }
}

// The `utimensat` step: atime kept as read, mtime one second later.
fn bump_mtime(path: str) {
    let info = fs.stat(path) else |_| {
        assert(false, "stat {path}")
        return
    }
    fs.set_times(path, fs.time_keep(), fs.time(info.mtime_s + 1, info.mtime_ns)) else |_| {
        assert(false, "utimensat {path}")
    }
}

fn reset_text(mut tb: text.TextBuf, s: str) {
    let len = text.textbuf_len(tb)
    text.textbuf_delete(mut tb, text.span(0, len))
    text.textbuf_insert_str(mut tb, text.byteoff(0), s)
}

fn backup_base(backup_dir: str, resolved: str) -> str {
    "{backup_dir}/{text.hex16(text.path_fnv64(resolved))}"
}

// `policy_atomic_result_reports_commit`, `test_save_policy.c:91-114`.
fn policy_atomic_result_reports_commit() {
    let dir = fresh_dir("yew-atomic-result")
    let path = "{dir}/state"
    var result = text.file_write_atomic_result(path, bytes_of("state\n"), 384)
    assert(result.error == text.SAVE_OK, "committed ok")
    assert(result.committed, "committed")
    assert_bytes(path, bytes_of("state\n"))
    let missing = "{dir}/missing/state"
    result = text.file_write_atomic_result(missing, bytes_of("state\n"), 384)
    assert(result.error == text.SAVE_IO, "missing dir is io")
    assert(!result.committed, "not committed")
    unlink(path)
    rmdir(dir)
}

// `yew_opt_desc` (option.c:501-512): the row named `name`, -1 for none.
fn opt_desc_at(table: List[edit.OptDesc], name: str) -> int {
    for i in 0..table.len { if table[i].name == name { return i } }
    -1
}

fn t_save_policy_defaults_match_option_table() {
    let opts = text.save_opts_default()
    assert(opts.strategy == text.SAVE_STRATEGY_AUTO, "strategy auto (file.h:74)")
    assert(opts.check_disk == text.SAVE_CHECK_MTIME, "check mtime (file.h:76)")
    assert(opts.check_disk_max == text.SAVE_CHECK_DISK_MAX_DEFAULT, "check max")
    assert(opts.check_disk_max == 8 * 1024 * 1024, "8 MiB (file.h:78)")
    assert(opts.backup_keep == text.SAVE_BACKUP_KEEP_DEFAULT, "keep")
    assert(opts.backup_keep == 1, "keep 1 (file.h:80)")
    assert(opts.backup_dir == "", "no backup dir (file.h:82)")
    let table = edit.opt_table()
    let check_max = opt_desc_at(table, "save.check_disk_max")
    assert(check_max >= 0, "save.check_disk_max is declared")
    assert(table[check_max].dflt.i == text.SAVE_CHECK_DISK_MAX_DEFAULT, "its default is file.h's")
    let keep = opt_desc_at(table, "save.backup_keep")
    assert(keep >= 0, "save.backup_keep is declared")
    assert(table[keep].dflt.i == text.SAVE_BACKUP_KEEP_DEFAULT, "its default is file.h's")
    let verify = opt_desc_at(table, "plug.verify_on_load")
    assert(verify >= 0, "plug.verify_on_load is declared")
    assert(table[verify].dflt.b, "it defaults on")
    assert(table[verify].module == edit.OPT_MODULE_PLUGINS, "the plugins module's")
    policy_atomic_result_reports_commit()
}

// `policy_content_accepts_bom_crlf_mtime_change`, `test_save_policy.c:146-178`.
fn policy_content_accepts_bom_crlf_mtime_change() {
    var disk = List[byte]()
    (mut disk).push(239 as byte)
    (mut disk).push(187 as byte)
    (mut disk).push(191 as byte)
    for b in bytes_of("old\r\n") {
        (mut disk).push(b)
    }
    let dir = fresh_dir("yew-save-content-crlf")
    let path = "{dir}/file.txt"
    policy_write(path, disk)
    var (rc, tb, meta) = text.file_load(path)
    assert(rc == text.LOAD_OK, "load")
    assert(meta.had_bom, "a BOM")
    assert(meta.eol == text.EOL_CRLF, "CRLF")
    bump_mtime(path)
    var opts = text.save_opts_default()
    opts.check_disk = text.SAVE_CHECK_CONTENT
    assert(text.file_save_opts(mut tb, mut meta, path, opts) == text.SAVE_OK, "save")
    assert_bytes(path, disk)
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    unlink(path)
    rmdir(dir)
}

fn t_save_policy_content_accepts_identical_mtime_change() {
    let dir = fresh_dir("yew-save-content")
    let path = "{dir}/file.txt"
    policy_write(path, bytes_of("old\n"))
    var (rc, tb, meta) = text.file_load(path)
    assert(rc == text.LOAD_OK, "load")
    bump_mtime(path)
    let len = text.textbuf_len(tb)
    text.textbuf_insert_str(mut tb, text.byteoff(len), "edit\n")
    var opts = text.save_opts_default()
    opts.check_disk = text.SAVE_CHECK_CONTENT
    assert(text.file_save_opts(mut tb, mut meta, path, opts) == text.SAVE_OK, "save")
    assert_bytes(path, bytes_of("old\nedit\n"))
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    unlink(path)
    rmdir(dir)
    policy_content_accepts_bom_crlf_mtime_change()
}

fn t_save_policy_content_rejects_different_bytes() {
    let dir = fresh_dir("yew-save-conflict")
    let path = "{dir}/file.txt"
    policy_write(path, bytes_of("old\n"))
    var (rc, tb, meta) = text.file_load(path)
    assert(rc == text.LOAD_OK, "load")
    policy_write(path, bytes_of("bad\n"))
    let len = text.textbuf_len(tb)
    text.textbuf_insert_str(mut tb, text.byteoff(len), "edit\n")
    var opts = text.save_opts_default()
    opts.check_disk = text.SAVE_CHECK_CONTENT
    assert(
        text.file_save_opts(mut tb, mut meta, path, opts) == text.SAVE_CHANGED_ON_DISK,
        "changed on disk",
    )
    assert_bytes(path, bytes_of("bad\n"))
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    unlink(path)
    rmdir(dir)
}

// `policy_backup_failure_commits_edit_state`, `test_save_policy.c:283-343`.
fn policy_backup_failure_commits_edit_state() {
    let dir = fresh_dir("yew-save-backup-fail")
    let path = "{dir}/file.txt"
    let backup_dir = "{dir}/backups"
    fs_create_dir_mode(backup_dir, 448) else {
        assert(false, "mkdir backups")
    }
    policy_write(path, bytes_of("old"))
    let resolved = text.file_realpath(path) else {
        assert(false, "realpath")
        return
    }
    var (rc, tb, meta) = text.file_load(path)
    assert(rc == text.LOAD_OK, "load")
    reset_text(mut tb, "new")
    var undo = text.undo_new(tb)
    undo.saved = 4294967295
    var ec = text.editctx_new(take tb)
    let (j, err) = text.journal_open(mut ec.journals, meta.realpath, mut meta)
    assert(err == text.JERR_OK && j.open, "journal open")
    ec.meta = meta
    ec.has_meta = true
    ec.undo = undo
    ec.has_undo = true
    ec.jrnl = j
    ec.has_jrnl = true
    var opts = text.save_opts_default()
    opts.strategy = text.SAVE_STRATEGY_INPLACE
    opts.backup_dir = backup_dir
    let backup = "{backup_base(backup_dir, resolved)}.bak"
    fs_create_dir_mode(backup, 448) else {
        assert(false, "mkdir the backup's path")
    }
    assert(text.edit_save_opts(mut ec, path, opts) == text.SAVE_BACKUP_FAILED, "backup failed")
    assert_bytes(path, bytes_of("new"))
    assert(ec.meta.size_on_disk == 3, "size on disk")
    assert(ec.meta.disk_snapshot_valid, "disk snapshot valid")
    assert(ec.undo.saved == ec.undo.cur, "saved is current")
    assert(!ec.has_jrnl, "journal closed")
    let pending = "{backup_base(backup_dir, resolved)}.pending.bak"
    assert_bytes(pending, bytes_of("old"))
    unlink(pending)
    rmdir(backup)
    text.filemeta_dispose(mut ec.meta, mut ec.tb)
    text.textbuf_free(mut ec.tb)
    unlink(path)
    rmdir(backup_dir)
    rmdir(dir)
}

fn t_save_policy_inplace_rotates_custom_backups() {
    let dir = fresh_dir("yew-save-rotate")
    let path = "{dir}/file.txt"
    let backup_dir = "{dir}/backups"
    policy_write(path, bytes_of("0"))
    let resolved = text.file_realpath(path) else {
        assert(false, "realpath")
        return
    }
    var (rc, tb, meta) = text.file_load(path)
    assert(rc == text.LOAD_OK, "load")
    var opts = text.save_opts_default()
    opts.strategy = text.SAVE_STRATEGY_INPLACE
    opts.backup_keep = 10
    opts.backup_dir = backup_dir
    var i = 1
    while i <= 10 {
        reset_text(mut tb, "{i}")
        assert(text.file_save_opts(mut tb, mut meta, path, opts) == text.SAVE_OK, "save {i}")
        i += 1
    }
    let base = backup_base(backup_dir, resolved)
    assert_bytes("{base}.bak", bytes_of("9"))
    i = 1
    while i < 10 {
        assert_bytes("{base}.{i}.bak", bytes_of("{9 - i}"))
        i += 1
    }
    let backup = "{base}.bak"
    let pending = "{base}.pending.bak"
    let recovery = "{backup}.recover.bak"
    policy_write(pending, bytes_of("stale pending"))
    policy_write(recovery, bytes_of("stale recovery"))
    reset_text(mut tb, "11")
    assert(text.file_save_opts(mut tb, mut meta, path, opts) == text.SAVE_OK, "save 11")
    assert_bytes(path, bytes_of("11"))
    assert_bytes(backup, bytes_of("10"))
    assert_bytes(pending, bytes_of("stale pending"))
    assert_bytes(recovery, bytes_of("stale recovery"))
    unlink(pending)
    unlink(recovery)
    unlink(backup)
    i = 1
    while i < 10 {
        unlink("{base}.{i}.bak")
        i += 1
    }
    text.filemeta_dispose(mut meta, mut tb)
    text.textbuf_free(mut tb)
    unlink(path)
    rmdir(backup_dir)
    rmdir(dir)
    policy_backup_failure_commits_edit_state()
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let state = fresh_dir("yew-save-policy-state")
    env_set("XDG_STATE_HOME", state) else {
        assert(false, "setenv XDG_STATE_HOME")
    }
    t_save_policy_defaults_match_option_table()
    t_save_policy_content_accepts_identical_mtime_change()
    t_save_policy_content_rejects_different_bytes()
    t_save_policy_inplace_rotates_custom_backups()
    remove_tree(state)
    print("save_policy_test: 4 cases pass")
}
