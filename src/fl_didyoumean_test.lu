//! member: false
//! Port sagitta9ace98c2 tests/unit/test_fl_didyoumean.c:61-214, all6 cases.

use fl

fn check(typo: str, names: List[str], want: str) {
    var s = fl.fl_suggest_new()
    for name in names {
        let at = name.find("@") else name.len
        let band = if at == name.len then 2 else (name[at + 1..].to_int() else 2)
        fl.fl_suggest_add(mut s, name[0..at].bytes(), band)
    }
    var out = List[byte]()
    let _ = fl.fl_suggest_render(mut s, typo.bytes(), mut out)
    let got = str_from_utf8(out) else "<invalid>"
    if got != want { eprint("typo {typo}: want |{want}| got |{got}|") }
    assert(got == want)
}

fn metric_costs() {
    assert(fl.fl_suggest_distance("abc".bytes(), "abc".bytes()) == 0)
    assert(fl.fl_suggest_distance("abc".bytes(), "abd".bytes()) == 2)
    assert(fl.fl_suggest_distance("abc".bytes(), "ab".bytes()) == 2)
    assert(fl.fl_suggest_distance("ab".bytes(), "abc".bytes()) == 2)
    assert(fl.fl_suggest_distance("lenght".bytes(), "length".bytes()) == 2)
    assert(fl.fl_suggest_distance("ab".bytes(), "ba".bytes()) == 2)
    assert(fl.fl_suggest_distance("Abc".bytes(), "abc".bytes()) == 1)
    assert(fl.fl_suggest_distance("ABC".bytes(), "abc".bytes()) == 3)
    assert(fl.fl_suggest_distance("a".repeat(66).bytes(), "a".bytes()) == 4294967295)
}

fn length_floor() {
    check("in", ["if"], "")
    check("in", ["is"], "")
    check("xy", ["ab"], "")
    check("abd", ["abc"], "did you mean 'abc'?")
    check("axd", ["abc"], "")
    check("abxy", ["abcd"], "did you mean 'abcd'?")
    check("axxy", ["abcd"], "")
}

fn real_typos() {
    check("lenght", ["length"], "did you mean 'length'?")
    check("recieve", ["receive"], "did you mean 'receive'?")
    check("tabwith", ["tabwidth"], "did you mean 'tabwidth'?")
    check("Tabwidth", ["tabwidth"], "did you mean 'tabwidth'?")
    check("slcie", ["slice"], "did you mean 'slice'?")
    check("uper", ["upper"], "did you mean 'upper'?")
    check("splt", ["split"], "did you mean 'split'?")
    check("stirng", ["string"], "did you mean 'string'?")
    check("conatins", ["contains"], "did you mean 'contains'?")
    check("startswith", ["starts_with"], "did you mean 'starts_with'?")
    check("upPer", ["upper"], "did you mean 'upper'?")
    check("REPLACE", ["replace"], "")
    check("wpper", ["upper"], "did you mean 'upper'?")
    check("length", ["length"], "")
    check("qqqqqq", ["length", "upper", "slice"], "")
}

fn orders_by_distance_then_scope() {
    check("totl", ["totals", "total"], "did you mean 'total'? (or 'totals')")
    check("xat", ["bat@2", "cat@0"], "did you mean 'cat'? (or 'bat')")
    check("xat", ["bat@2", "cat@0", "hat@3"], "did you mean 'cat'? (or 'bat', 'hat')")
    check("xat", ["hat", "cat", "bat"], "did you mean 'bat'? (or 'cat', 'hat')")
    check(
        "xat",
        ["bat", "cat", "eat", "fat", "hat", "mat", "oat"],
        "did you mean 'bat'? (or 'cat', 'eat')",
    )
}

fn ignores_out_of_scope_names() {
    var s = fl.fl_suggest_new()
    fl.fl_suggest_add(mut s, "total".bytes(), 2)
    var out = List[byte]()
    assert(fl.fl_suggest_render(mut s, "_helpr".bytes(), mut out) == 0)
    assert(out.len == 0)
}

fn bounds_the_candidate_set() {
    var s = fl.fl_suggest_new()
    for i in 0..600 {
        let digits = "{i}"
        let name = "n" + "0".repeat(4 - digits.len) + digits
        fl.fl_suggest_add(mut s, name.bytes(), 2)
    }
    assert(s.full && s.n == 512)
    var out = List[byte]()
    assert(fl.fl_suggest_render(mut s, "n0001x".bytes(), mut out) == 0)
    fl.fl_suggest_reset(mut s)
    for i in 0..600 {
        let digits = "{i}"
        let name = (if i == 0 then "z" else "n") + "0".repeat(3 - digits.len) + digits
        fl.fl_suggest_add(mut s, name.bytes(), 2)
    }
    assert(fl.fl_suggest_render(mut s, "z00x".bytes(), mut out) == 1)
}

fn main() {
    metric_costs()
    length_floor()
    real_typos()
    orders_by_distance_then_scope()
    ignores_out_of_scope_names()
    bounds_the_candidate_set()
    print("didyoumean:6 cases PASS")
}
