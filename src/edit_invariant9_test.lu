//! member: false
//!
//! The port of sagitta `tests/unit/test_invariant9.c` (938 lines) at
//! 9ace98c2, one test per C test in registry order
//! (`tests/unit/registry.c:2743-2755`): Sprint 27 §8's invariant-9 audit
//! — THE KEYBOARD NEVER REQUIRES THE MOUSE. Every row is performed twice,
//! once through the router and once with keys only and the mouse OFF, and
//! the two states are compared. The wheel is the one named difference: it
//! does not move the cursor, so that row compares the viewport.
//!
//! C's fixture (`i9_fixture`, `:50-68`) is the drag file's with
//! `/tmp/yew-i9-<i>.txt`. C's `yew_mouse_set_enabled` is a file static
//! the two halves flip around each other (`i9_keys_only` / `i9_mouse_on`);
//! the port's switch is the editor's own (`ed.mouse_on`), so the keys
//! half turns it off on ITS editor and the mouse half's editor starts on.
//! C's `yew_ed_invoke` is `edit.cmd_invoke` with `SRC_KEY`; a `Pane *` is
//! a pool index; `ed.tabs.active` / `scroll` are `ed.tab_active` /
//! `tab_scroll`; the context menu is `ed.ctx` (yw06-ctx).
//!
//! The per-case selector `YEW_I9_CASE=N` (the registry index within this
//! file, 0-based) runs one case, for the checked machine's step budget
//! (G29).

use edit
use term
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

// `i9_fixture` (`:50-68`).
fn fixture(extra: int) -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    var i = 0
    while i < extra {
        assert(edit.tab_open(mut ed, "/tmp/yew-i9-{i}.txt") >= 0, "open yew-i9-{i}")
        i += 1
    }
    edit.ed_layout(mut ed)
    ed.now_ms = 1000
    ed
}

// The keys half's editor: the same fixture with the mouse OFF — not "the
// keyboard also works" but "the keyboard works with no pointer at all"
// (`i9_keys_only`, `:143-146`).
fn keys_fixture(extra: int) -> edit.Ed {
    var ed = fixture(extra)
    edit.mouse_set_enabled(mut ed, false)
    ed
}

fn cursor_pos(ed: edit.Ed) -> int {
    let w = ed.win
    ed.wins[w].cs.curs[ed.wins[w].cs.primary].pos
}

fn set_cursor(mut ed: edit.Ed, pos: int) {
    let w = ed.win
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].pos = pos
    ed.wins[w].cs.curs[p].anchor = pos
}

fn insert_at(mut ed: edit.Ed, at: int, s: str) {
    let w = ed.win
    let line = bytes_of(s)
    assert(edit.ed_edit_insert(mut ed, w, at, line, 0, line.len), "insert")
    edit.ed_finish_edit(mut ed, w)
}

// `i9_fill` (`:70-84`).
fn fill(mut ed: edit.Ed, lines: int) {
    var i = 0
    while i < lines {
        let at = cursor_pos(ed)
        insert_at(mut ed, at, "line {i} of the file\n")
        i += 1
    }
}

fn follow(mut ed: edit.Ed) {
    let w = ed.win
    let tb = copy ed.bufs[ed.wins[w].buf].ec.tb
    edit.vp_follow(mut ed.wins[w], tb)
}

// `i9_run` (`:86-100`).
fn run(mut ed: edit.Ed, name: str, count: int) -> int {
    let id = edit.cmd_lookup(ed.reg, name)
    assert(id != 0, "{name} is registered")
    var cx = edit.cmdctx_new(ed.win, edit.SRC_KEY)
    cx.count = if count == 0 then 1 else count
    cx.count_given = count != 0
    edit.cmd_invoke(mut ed, id, mut cx)
}

// The same with a string argument (C's `sarg`).
fn run_sarg(mut ed: edit.Ed, name: str, sarg: str) -> int {
    let id = edit.cmd_lookup(ed.reg, name)
    assert(id != 0, "{name} is registered")
    var cx = edit.cmdctx_new(ed.win, edit.SRC_KEY)
    cx.sarg = sarg
    cx.has_sarg = true
    edit.cmd_invoke(mut ed, id, mut cx)
}

// `i9_run_iarg` (`:103-114`): the command's optional integer argument.
fn run_iarg(mut ed: edit.Ed, name: str, iarg: int) -> int {
    let id = edit.cmd_lookup(ed.reg, name)
    assert(id != 0, "{name} is registered")
    var cx = edit.cmdctx_new(ed.win, edit.SRC_KEY)
    cx.iarg = iarg
    edit.cmd_invoke(mut ed, id, mut cx)
}

// `i9_mouse` (`:116-127`).
fn mouse(button: int, kind: int, x: int, y: int) -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_MOUSE
    k.button = button
    k.ev = kind
    k.col = x
    k.row = y
    k
}

// `i9_key` (`:129-138`).
fn key(code: int) -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    k.code = code
    k
}

fn left(mut ed: edit.Ed, kind: int, x: int, y: int) {
    edit.mouse_event(mut ed, mouse(term.MB_LEFT, kind, x, y))
}

// `i9_paint_strip` (`:153-159`).
fn paint_strip(mut ed: edit.Ed) {
    if ed.layout_dirty {
        edit.ed_layout(mut ed)
    }
    edit.region_frame_begin(mut ed.regions)
    let r = copy ed.tab_strip_rect
    edit.tab_strip_draw(mut ed, r)
}

// `i9_slot_x` (`:161-171`).
fn slot_x(ed: edit.Ed, slot: int) -> int {
    var x = 0
    while x < 80 {
        if edit.strip_slot_at(ed, x, 0) == slot {
            return x
        }
        x += 1
    }
    assert(false, "slot {slot} is on screen")
    0
}

fn make_group(mut ed: edit.Ed) -> int {
    let g = edit.group_create(mut ed, "/src", "grp")
    edit.group_add_member(mut ed, g, 3)
    edit.group_add_member(mut ed, g, 4)
    edit.tab_switch(mut ed, 0)
    g
}

// ---- panes ------------------------------------------------------------------

// `test_invariant9_click_a_pane_equals_focus_right` (`:177-224`).
fn t_click_a_pane_equals_focus_right() {
    var m = fixture(0)
    // SPLIT_H puts the two panes SIDE BY SIDE; SPLIT_V stacks them.
    let m_right = edit.pane_split(mut m, m.pane_root, edit.SPLIT_H)
    assert(m_right >= 0, "split")
    edit.ed_layout(mut m)
    m.focus = m.panes[m.pane_root].a
    m.win = m.panes[m.focus].win
    edit.pane_tables_reset(mut m)
    let ma = m.panes[m.pane_root].a
    let _ = edit.pane_table_add_leaf(mut m, ma)
    let id = edit.pane_table_add_leaf(mut m, m_right)
    edit.region_frame_begin(mut m.regions)
    edit.region_add(mut m.regions, edit.REGION_PANE, copy m.panes[m_right].rect, id)
    let r = copy m.panes[m_right].rect
    left(mut m, term.KEY_PRESS, r.x + 2, r.y + 1)

    var k = keys_fixture(0)
    let k_right = edit.pane_split(mut k, k.pane_root, edit.SPLIT_H)
    assert(k_right >= 0, "split")
    edit.ed_layout(mut k)
    k.focus = k.panes[k.pane_root].a
    k.win = k.panes[k.focus].win
    assert(run(mut k, "ed.pane.focus_right", 0) == edit.CMD_OK, "focus_right")

    // The same leaf, by position in the tree.
    assert(m.focus == m_right, "the mouse focused the right pane")
    assert(k.focus == k_right, "the keys focused the right pane")
}

// `test_invariant9_drag_a_border_equals_grow` (`:226-276`).
fn t_drag_a_border_equals_grow() {
    var m = fixture(0)
    assert(edit.pane_split(mut m, m.pane_root, edit.SPLIT_H) >= 0, "split")
    edit.ed_layout(mut m)
    let border_x = m.panes[m.panes[m.pane_root].b].rect.x
    edit.pane_tables_reset(mut m)
    let root = m.pane_root
    let id = edit.pane_table_add_split(mut m, root)
    edit.region_frame_begin(mut m.regions)
    edit.region_add(mut m.regions, edit.REGION_PANE_BORDER, edit.rect(border_x - 1, 0, 1, 23), id)
    left(mut m, term.KEY_PRESS, border_x - 1, 5)
    left(mut m, term.KEY_REPEAT, border_x, 5)
    left(mut m, term.KEY_RELEASE, border_x, 5)
    edit.ed_layout(mut m)

    var k = keys_fixture(0)
    assert(edit.pane_split(mut k, k.pane_root, edit.SPLIT_H) >= 0, "split")
    k.focus = k.panes[k.pane_root].a
    k.win = k.panes[k.focus].win
    assert(run(mut k, "ed.pane.grow", 1) == edit.CMD_OK, "grow")
    edit.ed_layout(mut k)

    // One cell of drag equals one grow: the same boundary column.
    let mb = m.panes[m.panes[m.pane_root].b].rect.x
    let kb = k.panes[k.panes[k.pane_root].b].rect.x
    assert(mb == kb, "the same boundary: {mb} vs {kb}")
}

// ---- tabs and groups --------------------------------------------------------

// `test_invariant9_click_a_tab_equals_tab_goto` (`:282-312`).
fn t_click_a_tab_equals_tab_goto() {
    var m = fixture(4)
    edit.tab_switch(mut m, 0)
    paint_strip(mut m)
    let x = slot_x(m, 3)
    left(mut m, term.KEY_PRESS, x, 0)
    left(mut m, term.KEY_RELEASE, x, 0)

    var k = keys_fixture(4)
    edit.tab_switch(mut k, 0)
    // 1-based, as the user counts them.
    assert(run(mut k, "ed.tab.goto", 4) == edit.CMD_OK, "goto")

    assert(m.tab_active == 3, "the mouse reached tab 3")
    assert(k.tab_active == m.tab_active, "the keys reached the same")
}

// `test_invariant9_drag_a_tab_equals_tab_move` (`:314-357`).
fn t_drag_a_tab_equals_tab_move() {
    var m = fixture(4)
    edit.tab_switch(mut m, 0)
    paint_strip(mut m)
    let px = slot_x(m, 0)
    let tx = slot_x(m, 3)
    left(mut m, term.KEY_PRESS, px, 0)
    left(mut m, term.KEY_REPEAT, tx, 0)
    left(mut m, term.KEY_RELEASE, tx, 0)

    var k = keys_fixture(4)
    edit.tab_switch(mut k, 0)
    assert(run(mut k, "ed.tab.move", 4) == edit.CMD_OK, "move")

    // Compared as a whole ORDER, by position.
    assert(edit.tab_count(m) == edit.tab_count(k), "the same count")
    var i = 0
    while i < edit.tab_count(m) {
        assert(m.tabs[i].tab_id == k.tabs[i].tab_id, "position {i}")
        i += 1
    }
}

// `test_invariant9_drop_into_a_group_equals_group_add_tab` (`:359-427`).
fn t_drop_into_a_group_equals_group_add_tab() {
    var m = fixture(4)
    let g = make_group(mut m)
    edit.ed_layout(mut m)
    paint_strip(mut m)
    var gslot = -1
    var s = 0
    while s < edit.strip_slot_count(m) && gslot < 0 {
        let (ok, payload) = edit.strip_pre_payload(m, s)
        if ok && payload == -g {
            gslot = s
        }
        s += 1
    }
    assert(gslot >= 0, "the group is on row 1")
    let px = slot_x(m, 0)
    let gx = slot_x(m, gslot)
    left(mut m, term.KEY_PRESS, px, 0)
    left(mut m, term.KEY_REPEAT, gx, 0)
    let t = m.now_ms + edit.DRAG_DWELL_MS
    edit.mouse_tick(mut m, t)
    assert(edit.mouse_preview_group(m) == g, "the dwell opened it")
    paint_strip(mut m)
    left(mut m, term.KEY_RELEASE, 78, 1)

    var k = keys_fixture(4)
    let _ = make_group(mut k)
    assert(run_sarg(mut k, "ed.group.add_tab", "grp") == edit.CMD_OK, "add_tab")

    // Full membership AND ordinal snapshots.
    assert(edit.tab_count(m) == edit.tab_count(k), "the same count")
    var i = 0
    while i < edit.tab_count(m) {
        assert(m.tabs[i].tab_id == k.tabs[i].tab_id, "position {i}: id")
        assert(m.tabs[i].group_id == k.tabs[i].group_id, "position {i}: group")
        assert(m.tabs[i].group_ordinal == k.tabs[i].group_ordinal, "position {i}: ordinal")
        i += 1
    }
}

// `test_invariant9_click_a_group_entry_equals_group_enter` (`:429-469`).
fn t_click_a_group_entry_equals_group_enter() {
    var m = fixture(4)
    let g = make_group(mut m)
    edit.ed_layout(mut m)
    edit.region_frame_begin(mut m.regions)
    edit.region_add(mut m.regions, edit.REGION_TAB, edit.rect(0, 0, 8, 1), -g)
    left(mut m, term.KEY_PRESS, 2, 0)
    left(mut m, term.KEY_RELEASE, 2, 0)

    var k = keys_fixture(4)
    let _ = make_group(mut k)
    // ed.group.enter walks into the group beside the active tab.
    assert(run(mut k, "ed.group.enter", 0) == edit.CMD_OK, "enter")

    assert(edit.active_group_id(m) == g, "the mouse entered the group")
    assert(edit.active_group_id(k) == edit.active_group_id(m), "the keys entered it")
    assert(m.tab_active == k.tab_active, "the same tab")
}

// `test_invariant9_strip_chevrons_equal_tab_next_and_prev` (`:471-507`):
// not the same keystroke, the same REACH.
fn t_strip_chevrons_equal_tab_next_and_prev() {
    var m = fixture(8)
    edit.tab_switch(mut m, 0)
    edit.region_frame_begin(mut m.regions)
    edit.region_add(mut m.regions, edit.REGION_TAB_SCROLL, edit.rect(79, 0, 1, 1), 1)
    left(mut m, term.KEY_PRESS, 79, 0)
    assert(m.tab_scroll == 1, "the chevron scrolled one")

    var k = keys_fixture(8)
    edit.tab_switch(mut k, 0)
    k.tab_scroll = 0
    assert(run(mut k, "ed.tab.next", 0) == edit.CMD_OK, "next")
    assert(k.tab_active == 1, "the keys reached the next entry")
}

// ---- the wheel --------------------------------------------------------------

// `test_invariant9_wheel_equals_three_view_scrolls` (`:519-561`): the one
// named difference — the VIEWPORT ends in the same place.
fn t_wheel_equals_three_view_scrolls() {
    var m = fixture(0)
    fill(mut m, 100)
    set_cursor(mut m, 0)
    follow(mut m)
    edit.pane_tables_reset(mut m)
    let root = m.pane_root
    let leaf = edit.pane_table_add_leaf(mut m, root)
    edit.region_frame_begin(mut m.regions)
    edit.region_add(mut m.regions, edit.REGION_PANE, copy m.panes[m.pane_root].rect, leaf)
    let wy = m.panes[m.pane_root].rect.y + 2
    edit.mouse_event(mut m, mouse(term.MB_WHEEL_DOWN, term.KEY_PRESS, 10, wy))

    var k = keys_fixture(0)
    fill(mut k, 100)
    set_cursor(mut k, 0)
    follow(mut k)
    var i = 0
    while i < edit.WHEEL_ROWS {
        assert(run(mut k, "ed.view.scroll.down", 0) == edit.CMD_OK, "scroll {i}")
        i += 1
    }

    assert(m.wins[m.win].vp.top == edit.WHEEL_ROWS, "the wheel moved three rows")
    assert(k.wins[k.win].vp.top == m.wins[m.win].vp.top, "the keys moved the same")
}

// ---- selection --------------------------------------------------------------

fn selection(ed: edit.Ed) -> text.Span {
    let w = ed.win
    let b = ed.wins[w].buf
    edit.sel_span(ed.bufs[b].ec.tb, ed.wins[w].h.kind, copy ed.wins[w].cs.curs[ed.wins[w].cs.primary])
}

// `test_invariant9_double_click_equals_h_plus_word_unit` (`:567-658`).
fn t_double_click_equals_h_plus_word_unit() {
    var m = fixture(0)
    insert_at(mut m, 0, "alpha beta gamma\n")
    set_cursor(mut m, 0)
    edit.pane_tables_reset(mut m)
    let root = m.pane_root
    let leaf = edit.pane_table_add_leaf(mut m, root)
    edit.region_frame_begin(mut m.regions)
    edit.region_add(mut m.regions, edit.REGION_PANE, copy m.panes[m.pane_root].rect, leaf)
    // Inside `beta`.
    let x = m.wins[m.win].rect.x + 8
    let y = m.panes[m.pane_root].rect.y
    left(mut m, term.KEY_PRESS, x, y)
    left(mut m, term.KEY_RELEASE, x, y)
    // Recorded BEFORE the second click, which moves the caret to the
    // word's far edge.
    let clicked_at = cursor_pos(m)
    left(mut m, term.KEY_PRESS, x, y)
    left(mut m, term.KEY_RELEASE, x, y)
    let m_span = selection(m)

    // Keys only: W mode, home to the word's start, then H with the word
    // engine borrowed and end to its far edge (NOT ed.sel.unit.expand,
    // which walks Sprint 17's structural levels).
    var k = keys_fixture(0)
    insert_at(mut k, 0, "alpha beta gamma\n")
    set_cursor(mut k, clicked_at)
    assert(edit.mode_enter(mut k, edit.MODE_W) == edit.CMD_OK, "W")
    assert(run(mut k, "ed.move.unit.home", 0) == edit.CMD_OK, "home")
    assert(edit.mode_enter_highlight(mut k, edit.MODE_W, false) == edit.CMD_OK, "H")
    assert(run(mut k, "ed.move.unit.end", 0) == edit.CMD_OK, "end")
    let k_span = selection(k)

    assert(m_span.lo == k_span.lo, "lo: {m_span.lo} vs {k_span.lo}")
    assert(m_span.hi == k_span.hi, "hi: {m_span.hi} vs {k_span.hi}")
    // And both are in H mode with the same engine borrowed.
    assert(m.mode == edit.MODE_H, "the mouse is in H")
    assert(k.mode == edit.MODE_H, "the keys are in H")
    assert(m.wins[m.win].h.unit == k.wins[k.win].h.unit, "the same unit")
}

// ---- the context menu -------------------------------------------------------

// `test_invariant9_menu_and_its_rows_are_keyboard_reachable` (`:669-734`).
fn t_menu_and_its_rows_are_keyboard_reachable() {
    var m = fixture(4)
    edit.tab_switch(mut m, 2)
    let mt = m.tabs[2].tab_id
    edit.ed_layout(mut m)
    edit.region_frame_begin(mut m.regions)
    edit.region_add(mut m.regions, edit.REGION_TAB, edit.rect(20, 0, 10, 1), 2)
    edit.mouse_event(mut m, mouse(term.MB_RIGHT, term.KEY_PRESS, 22, 0))
    assert(edit.ctx_active(m.ctx), "the menu opened")
    assert(edit.ctx_target_id(m.ctx) == mt, "on the tab")
    edit.ctx_close(mut m.ctx)

    // Keys only: the same menu, on the same target. `iarg 1` is the
    // STRIP (s57.13 §5 gave 0/absent to the keyboard focus).
    var k = keys_fixture(4)
    edit.tab_switch(mut k, 2)
    let target = k.tabs[2].tab_id
    edit.ed_layout(mut k)
    assert(run_iarg(mut k, "ed.ui.context_menu", 1) == edit.CMD_OK, "context_menu 1")
    assert(edit.ctx_active(k.ctx), "the menu opened")
    assert(edit.ctx_kind(k.ctx) == edit.CTX_KIND_TAB, "the tab menu")
    assert(edit.ctx_target_id(k.ctx) == target, "on the tab")
    // Row 1 (Close Other Tabs) is enabled here, row 2 is the separator,
    // row 3 is Copy Path.
    assert(edit.mouse_menu_key(mut k, key(term.KEY_DOWN)), "down")
    assert(edit.ctx_cursor(k.ctx) == 1, "row 1")
    assert(edit.mouse_menu_key(mut k, key(term.KEY_DOWN)), "down")
    assert(edit.ctx_cursor(k.ctx) == 3, "row 3")
    assert(edit.mouse_menu_key(mut k, key(term.KEY_ENTER)), "enter")
    assert(!edit.ctx_active(k.ctx), "closed by the invoke")
    // The path landed in the clipboard register.
    let v = text.reg_get(mut k.regs, '+' as int) else {
        assert(false, "the + register is set")
        return
    }
    assert(v.bytes.len != 0, "the path")
}

// `test_invariant9_context_menu_takes_an_optional_strip_arg` (`:744-784`).
fn t_context_menu_takes_an_optional_strip_arg() {
    var k = keys_fixture(3)
    edit.tab_switch(mut k, 1)
    let target = k.tabs[1].tab_id
    edit.ed_layout(mut k)
    let id = edit.cmd_lookup(k.reg, "ed.ui.context_menu")
    assert(id != 0, "registered")
    assert(edit.cmd_entry(k.reg, id).arity == edit.ARITY_OPT_INT, "an optional int")

    // iarg 1: the strip.
    assert(run_iarg(mut k, "ed.ui.context_menu", 1) == edit.CMD_OK, "context_menu 1")
    assert(edit.ctx_active(k.ctx), "open")
    assert(edit.ctx_kind(k.ctx) == edit.CTX_KIND_TAB, "the tab menu")
    assert(edit.ctx_target_id(k.ctx) == target, "on the tab")
    edit.ctx_close(mut k.ctx)

    // Absent: the keyboard FOCUS, here the document.
    edit.pane_tables_reset(mut k)
    let root = k.pane_root
    assert(edit.pane_table_add_leaf(mut k, root) == 0, "leaf 0")
    assert(run(mut k, "ed.ui.context_menu", 0) == edit.CMD_OK, "context_menu")
    assert(edit.ctx_active(k.ctx), "open")
    assert(edit.ctx_kind(k.ctx) == edit.CTX_KIND_DOC, "the document menu")
    edit.ctx_close(mut k.ctx)
}

// `test_invariant9_every_new_command_is_registered` (`:788-875`): the
// audit's last column.
fn t_every_new_command_is_registered() {
    let ed = edit.ed_new()
    let names = "ed.tab.close_others ed.tab.copy_path ed.group.rename ed.group.dissolve ed.ui.context_menu ed.group.add_tab ed.mouse.enable ed.mouse.disable ed.sel.all ed.tab.split_left ed.tab.split_right ed.tab.split_down ed.view.number_cycle ed.file.save_as ed.git.copy_path ed.lsp.rename.apply ed.lsp.rename.diff ed.lsp.rename.cancel ed.group.pick.toggle ed.group.pick.confirm ed.shell.complete_forget ed.shell.reset ed.cmdline.ghost.accept_word ed.edit.kill.ws_word_prev ed.edit.kill.yank_pop ed.cmdline.ghost.accept_line ed.cmdline.last_arg ed.sel.extend.word_prev ed.sel.extend.word_next ed.sel.extend.line_home ed.sel.extend.line_end ed.cmdline.copy_or_cancel ed.cmdline.hist_search ed.cmdline.token_prev ed.cmdline.token_next ed.cmdline.toggle_sudo ed.cmdline.man_page ed.cmdline.edit_in_buffer"
    var n = 0
    for name in names.words() {
        assert(edit.cmd_lookup(ed.reg, name) != 0, "{name} is registered")
        n += 1
    }
    assert(n == 38, "C's 38 names: {n}")
}

// `test_invariant9_tab_menu_splits_are_keyboard_reachable` (`:888-938`):
// the drag-to-spawn CAPABILITY with no pointer, walked with End and Up.
fn t_tab_menu_splits_are_keyboard_reachable() {
    var k = keys_fixture(2)
    edit.tab_switch(mut k, 1)
    let target = k.tabs[1].tab_id
    let doc = edit.tab_buffer(k, 1)
    assert(doc >= 0, "the tab's buffer")
    edit.ed_layout(mut k)
    assert(edit.pane_leaf_count(k, k.pane_root) == 1, "one pane")

    assert(run_iarg(mut k, "ed.ui.context_menu", 1) == edit.CMD_OK, "context_menu 1")
    assert(edit.ctx_active(k.ctx), "open")
    assert(edit.ctx_kind(k.ctx) == edit.CTX_KIND_TAB, "the tab menu")
    assert(edit.ctx_target_id(k.ctx) == target, "on the tab")
    // End lands on the LAST usable row, `Open in Split Below`; one Up is
    // `Open in Split Left`.
    assert(edit.mouse_menu_key(mut k, key(term.KEY_END)), "end")
    assert(edit.mouse_menu_key(mut k, key(term.KEY_UP)), "up")
    assert(edit.mouse_menu_key(mut k, key(term.KEY_ENTER)), "enter")
    assert(!edit.ctx_active(k.ctx), "closed by the invoke")

    // A second pane, on the LEFT, showing the tab that was pointed at.
    assert(edit.pane_leaf_count(k, k.pane_root) == 2, "two panes")
    assert(!k.panes[k.pane_root].is_leaf, "a split")
    assert(k.panes[k.pane_root].dir == edit.SPLIT_H, "side by side")
    assert(k.focus == k.panes[k.pane_root].a, "the left one focused")
    assert(k.wins[k.panes[k.focus].win].buf == doc, "showing the tab")
    assert(edit.tab_count(k) == 3, "the strip still has three tabs")
    assert(edit.tab_index_of_id(k, target) == 1, "in place")

    // And the command by name is the same thing without the menu.
    edit.ed_layout(mut k)
    assert(run(mut k, "ed.tab.split_down", 0) == edit.CMD_OK, "split_down")
    assert(edit.pane_leaf_count(k, k.pane_root) == 3, "three panes")
}

fn want(chosen: int, n: int) -> bool {
    chosen < 0 || chosen == n
}

fn main() {
    let chosen = (env_get("YEW_I9_CASE") else "-1").to_int() else -1
    if want(chosen, 0) {
        t_click_a_pane_equals_focus_right()
        print("invariant9_click_a_pane_equals_focus_right: PASS")
    }
    if want(chosen, 1) {
        t_drag_a_border_equals_grow()
        print("invariant9_drag_a_border_equals_grow: PASS")
    }
    if want(chosen, 2) {
        t_click_a_tab_equals_tab_goto()
        print("invariant9_click_a_tab_equals_tab_goto: PASS")
    }
    if want(chosen, 3) {
        t_drag_a_tab_equals_tab_move()
        print("invariant9_drag_a_tab_equals_tab_move: PASS")
    }
    if want(chosen, 4) {
        t_drop_into_a_group_equals_group_add_tab()
        print("invariant9_drop_into_a_group_equals_group_add_tab: PASS")
    }
    if want(chosen, 5) {
        t_click_a_group_entry_equals_group_enter()
        print("invariant9_click_a_group_entry_equals_group_enter: PASS")
    }
    if want(chosen, 6) {
        t_strip_chevrons_equal_tab_next_and_prev()
        print("invariant9_strip_chevrons_equal_tab_next_and_prev: PASS")
    }
    if want(chosen, 7) {
        t_wheel_equals_three_view_scrolls()
        print("invariant9_wheel_equals_three_view_scrolls: PASS")
    }
    if want(chosen, 8) {
        t_double_click_equals_h_plus_word_unit()
        print("invariant9_double_click_equals_h_plus_word_unit: PASS")
    }
    if want(chosen, 9) {
        t_menu_and_its_rows_are_keyboard_reachable()
        print("invariant9_menu_and_its_rows_are_keyboard_reachable: PASS")
    }
    if want(chosen, 10) {
        t_context_menu_takes_an_optional_strip_arg()
        print("invariant9_context_menu_takes_an_optional_strip_arg: PASS")
    }
    if want(chosen, 11) {
        t_every_new_command_is_registered()
        print("invariant9_every_new_command_is_registered: PASS")
    }
    if want(chosen, 12) {
        t_tab_menu_splits_are_keyboard_reachable()
        print("invariant9_tab_menu_splits_are_keyboard_reachable: PASS")
    }
    print("invariant9_test: done")
}
