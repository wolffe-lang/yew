//! member: false
//!
//! The port of sagitta `tests/unit/test_mouse.c` (3,315 lines) at
//! 9ace98c2, one test per C test in registry order
//! (`tests/unit/registry.c:2596-2626`, then `:2756-2785`): the router's
//! three laws — THE PRESS CAPTURES ITS REGION (the tests mutate the region
//! table mid-gesture and assert the commit used the captured identity),
//! WHEELS ARE IMPULSES, ARMING IS NOT DRAGGING — the region table, the
//! wheel, the strip's chevrons and hover reveal (s57.15), the drag to a
//! pane's edge (s57.22), the context-menu routing (s57.13) and the
//! overlay rows.
//!
//! C's fixture (`ms_fixture`, `:52-66`) is `yew_ed_init` +
//! `yew_ed_open_scratch` + a 24x80 grid + `yew_ed_layout` with
//! `now_ms = 1000`; the port's is `edit.ed_new` + `edit.ed_open_scratch` +
//! `term.grid_new(24, 80)` + `edit.ed_layout`. A `Pane *` is a pool index
//! (-1 for NULL), a `Buffer *` a buffer index; C's `ed.tabs.scroll` /
//! `member_scroll` / `active` / `scroll_user` are `ed.tab_scroll`,
//! `tab_member_scroll`, `tab_active`, `tab_scroll_user`; the context menu
//! is the `Ed`'s value (`ed.ctx`, yw06-ctx) and the 1003 flag the
//! editor's own `ed.tty` (C's are file statics, so C's tests reset them
//! by hand between cases; a fresh port fixture starts disarmed).
//!
//! By owner: `mouse_menu_path_target_carries_the_captured_path` builds a
//! FUSS file menu (Sprint 52's tree and interner): RED BY NAME
//! naming yw13 (R-yw06-4 = A) — it accepts exactly the builder's named
//! refusal and fails on anything else. The floating panel half of
//! `mouse_context_at_names_every_region_kind` (`ed.win->panel`, Sprint 47)
//! is yw11's and SKIPPED loudly by name; the case's other assertions run.
//! FUSS's own rows reach `fussmode.h` (`test_mouse.c:33`) only through
//! `yew_fuss_active` in `mouse_context_at_falls_through_to_geometry`,
//! which C asserts FALSE: F mode cannot be entered before yw13, so the
//! port's cell resolves as C's does under the shim.
//!
//! The per-case selector `YEW_MOUSE_CASE=N` (the registry index, 0-based)
//! runs one case, for the checked machine's step budget (G29).

use edit
use term
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn say(line: str) {
    print(line)
    eprint(line)
}

// `ms_fixture` (`test_mouse.c:52-66`).
fn fixture() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    edit.ed_layout(mut ed)
    ed.now_ms = 1000
    ed
}

// `ms_ev` (`:68-79`).
fn ev(button: int, kind: int, x: int, y: int) -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_MOUSE
    k.button = button
    k.ev = kind
    k.col = x
    k.row = y
    k
}

// `ms_wheel` (`:81-87`).
fn wheel(button: int, x: int, y: int, mods: int) -> term.Key {
    var k = ev(button, term.KEY_PRESS, x, y)
    k.mods = mods
    k
}

fn esc_key() -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_KEY
    k.code = term.KEY_ESCAPE
    k
}

fn enter_key() -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_KEY
    k.code = term.KEY_ENTER
    k
}

// `ms_find_region` (`:89-108`): the first cell of `kind` inside `within`.
fn find_region(mut ed: edit.Ed, kind: int, within: edit.Rect) -> (bool, edit.Region) {
    var y = within.y
    while y < within.y + within.h {
        var x = within.x
        while x < within.x + within.w {
            let hit = edit.region_hit(mut ed.regions, x, y)
            if hit.kind == kind {
                return (true, hit)
            }
            x += 1
        }
        y += 1
    }
    (false, edit.Region { kind: edit.REGION_NONE, rect: edit.rect(0, 0, 0, 0), payload: 0 })
}

// `ms_frame_pane` (`:110-116`): a frame whose only region is the pane,
// registered with the rect the layout gave it.
fn frame_pane(mut ed: edit.Ed, leaf: int, payload: int) {
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.panes[leaf].rect, payload)
}

// The one-leaf table the older rows register by hand.
fn table_root(mut ed: edit.Ed) -> int {
    edit.pane_tables_reset(mut ed)
    let root = ed.pane_root
    edit.pane_table_add_leaf(mut ed, root)
}

// `ms_fill_lines` (`:118-131`): `n` lines inserted at the cursor.
fn fill_lines(mut ed: edit.Ed, n: int) {
    var i = 0
    while i < n {
        let w = ed.win
        let line = bytes_of("line {i} padding padding\n")
        let at = ed.wins[w].cs.curs[ed.wins[w].cs.primary].pos
        assert(edit.ed_edit_insert(mut ed, w, at, line, 0, line.len), "fill {i}")
        edit.ed_finish_edit(mut ed, w)
        i += 1
    }
}

fn cursor_pos(ed: edit.Ed) -> int {
    let w = ed.win
    ed.wins[w].cs.curs[ed.wins[w].cs.primary].pos
}

fn open_tabs(mut ed: edit.Ed, prefix: str, n: int) {
    var i = 0
    while i < n {
        assert(edit.tab_open(mut ed, "/tmp/{prefix}{i}.txt") >= 0, "open {prefix}{i}")
        i += 1
    }
}

fn motion_active(ed: edit.Ed) -> bool {
    term.tty_mouse_motion_active(ed.tty)
}

// ---- §1: the phase machine ---------------------------------------------------

// `test_mouse_press_arms_and_does_not_drag` (`:137-187`).
fn t_press_arms_and_does_not_drag() {
    var ed = fixture()
    let leaf = table_root(mut ed)
    frame_pane(mut ed, ed.pane_root, leaf)
    assert(ed.mouse.phase == edit.MP_IDLE, "idle")
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, 10, 5))
    assert(ed.mouse.phase == edit.MP_ARMED, "armed")
    assert(ed.mouse.held != 0, "held")
    assert(ed.mouse.press_x == 10 && ed.mouse.press_y == 5, "the press cell")
    // The region was CAPTURED, not merely hit-tested and thrown away.
    assert(ed.mouse.press_rgn.kind == edit.REGION_PANE, "captured")
    // Motion within the pressed cell is still a click, not a drag.
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_REPEAT, 10, 5))
    assert(ed.mouse.phase == edit.MP_ARMED, "still armed")
    // One cell away, and it becomes a drag.
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_REPEAT, 11, 5))
    assert(ed.mouse.phase == edit.MP_DRAG_SEL, "a selection drag")
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, 11, 5))
    assert(ed.mouse.phase == edit.MP_IDLE, "idle after release")
    assert(ed.mouse.held == 0, "released")
}

// `test_mouse_new_tab_control_invokes_the_named_command_once` (`:189-218`).
fn t_new_tab_control_invokes_the_named_command_once() {
    var ed = fixture()
    edit.region_frame_begin(mut ed.regions)
    let tr = copy ed.tab_strip_rect
    edit.tab_strip_draw(mut ed, tr)
    let (found, add) = find_region(mut ed, edit.REGION_TAB_NEW, tr)
    assert(found, "the + is drawn")
    let old_id = ed.tabs[0].tab_id
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, add.rect.x + 1, add.rect.y))
    assert(edit.tab_count(ed) == 1, "a press creates nothing")
    assert(ed.mouse.phase == edit.MP_ARMED, "armed")
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, add.rect.x + 1, add.rect.y))
    assert(edit.tab_count(ed) == 2, "the release opens one tab")
    assert(ed.tab_active == 1, "switched to it")
    assert(!ed.tabs[1].has_path, "untitled")
    assert(ed.tabs[1].tab_id > old_id, "a new id")
    assert(ed.mouse.phase == edit.MP_IDLE, "idle")
}

// `test_mouse_new_tab_control_cancels_off_region_and_drag` (`:220-260`).
fn t_new_tab_control_cancels_off_region_and_drag() {
    var ed = fixture()
    edit.region_frame_begin(mut ed.regions)
    let tr = copy ed.tab_strip_rect
    edit.tab_strip_draw(mut ed, tr)
    let (found, add) = find_region(mut ed, edit.REGION_TAB_NEW, tr)
    assert(found, "the + is drawn")
    let press = ev(term.MB_LEFT, term.KEY_PRESS, add.rect.x + 1, add.rect.y)
    var away = ev(term.MB_LEFT, term.KEY_RELEASE, add.rect.x + add.rect.w + 1, add.rect.y)
    edit.mouse_event(mut ed, press)
    edit.mouse_event(mut ed, away)
    assert(edit.tab_count(ed) == 1, "released off the region")
    edit.mouse_event(mut ed, press)
    away.ev = term.KEY_REPEAT
    edit.mouse_event(mut ed, away)
    assert(ed.mouse.phase == edit.MP_ARMED, "TAB_NEW has no drag")
    away.ev = term.KEY_RELEASE
    edit.mouse_event(mut ed, away)
    assert(edit.tab_count(ed) == 1, "slid away")
    assert(ed.mouse.phase == edit.MP_IDLE, "idle")
    // A repaint can move the tail action between press and release.
    // Landing on the newly placed action is not the same click.
    edit.mouse_event(mut ed, press)
    edit.region_frame_begin(mut ed.regions)
    edit.tab_strip_draw(mut ed, edit.rect(4, ed.tab_strip_rect.y, ed.tab_strip_rect.w - 4, 1))
    let release = ev(term.MB_LEFT, term.KEY_RELEASE, add.rect.x + 5, add.rect.y)
    assert(edit.region_hit(mut ed.regions, release.col, release.row).kind == edit.REGION_TAB_NEW, "moved +")
    edit.mouse_event(mut ed, release)
    assert(edit.tab_count(ed) == 1, "not the same click")
}

// `test_mouse_wheel_never_touches_the_phase_machine` (`:262-303`): s04's
// pinned pitfall, made executable — including mid-drag.
fn t_wheel_never_touches_the_phase_machine() {
    var ed = fixture()
    fill_lines(mut ed, 60)
    let leaf = table_root(mut ed)
    frame_pane(mut ed, ed.pane_root, leaf)
    var i = 0
    while i < 8 {
        let b = if i % 2 == 0 then term.MB_WHEEL_DOWN else term.MB_WHEEL_UP
        edit.mouse_event(mut ed, wheel(b, 10, 5, 0))
        assert(ed.mouse.phase == edit.MP_IDLE, "wheel {i}: idle")
        assert(ed.mouse.held == 0, "wheel {i}: nothing held")
        i += 1
    }
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, 10, 5))
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_REPEAT, 14, 5))
    assert(ed.mouse.phase == edit.MP_DRAG_SEL, "dragging")
    edit.mouse_event(mut ed, wheel(term.MB_WHEEL_DOWN, 10, 5, 0))
    assert(ed.mouse.phase == edit.MP_DRAG_SEL, "the drag survives the wheel")
    assert(ed.mouse.held != 0, "still held")
}

// `test_mouse_escape_and_focus_out_cancel_a_drag` (`:305-330`).
fn t_escape_and_focus_out_cancel_a_drag() {
    var ed = fixture()
    let leaf = table_root(mut ed)
    frame_pane(mut ed, ed.pane_root, leaf)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, 10, 5))
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_REPEAT, 14, 5))
    assert(edit.mouse_gesture_active(ed), "a gesture")
    edit.mouse_cancel(mut ed)
    assert(!edit.mouse_gesture_active(ed), "cancelled")
    assert(ed.mouse.phase == edit.MP_IDLE, "idle")
    // Cancelling an idle router is a no-op rather than a crash.
    edit.mouse_cancel(mut ed)
    assert(ed.mouse.phase == edit.MP_IDLE, "still idle")
}

// `test_mouse_release_without_press_is_inert` (`:332-352`).
fn t_release_without_press_is_inert() {
    var ed = fixture()
    let leaf = table_root(mut ed)
    frame_pane(mut ed, ed.pane_root, leaf)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, 10, 5))
    assert(ed.mouse.phase == edit.MP_IDLE, "idle")
    assert(ed.mouse.held == 0, "nothing held")
}

// ---- §2: the region table ------------------------------------------------------

// `test_mouse_click_a_pane_focuses_and_places_the_cursor` (`:358-389`).
fn t_click_a_pane_focuses_and_places_the_cursor() {
    var ed = fixture()
    fill_lines(mut ed, 20)
    let root = ed.pane_root
    let right = edit.pane_split(mut ed, root, edit.SPLIT_V)
    assert(right >= 0, "split")
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 23))
    edit.pane_tables_reset(mut ed)
    let other = if ed.focus == right then ed.panes[ed.pane_root].a else ed.focus
    let left_id = edit.pane_table_add_leaf(mut ed, other)
    let right_id = edit.pane_table_add_leaf(mut ed, right)
    assert(left_id >= 0 && right_id >= 0, "tabled")
    ed.focus = edit.pane_leaf_by_index(ed, left_id)
    ed.win = ed.panes[ed.focus].win
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.panes[right].rect, right_id)
    let r = copy ed.panes[right].rect
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, r.x + 2, r.y + 1))
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, r.x + 2, r.y + 1))
    assert(ed.focus == right, "the clicked pane is focused")
}

// `test_mouse_block_region_swallows_everything` (`:391-424`).
fn t_block_region_swallows_everything() {
    var ed = fixture()
    let leaf = table_root(mut ed)
    let before = ed.focus
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.panes[ed.pane_root].rect, leaf)
    edit.region_add(mut ed.regions, edit.REGION_BLOCK, copy ed.panes[ed.pane_root].rect, 0)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, 10, 5))
    assert(ed.mouse.press_rgn.kind == edit.REGION_BLOCK, "the block captured")
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_REPEAT, 20, 9))
    assert(ed.mouse.phase == edit.MP_ARMED, "no drag on a block")
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, 20, 9))
    assert(ed.focus == before, "nothing beneath reached")
    assert(ed.mouse.phase == edit.MP_IDLE, "idle")
}

// `test_mouse_right_click_in_a_pane_opens_the_document_menu`
// (`:426-458`): s57.13 supersedes s27 §9; the menu gesture is resolved
// before arming.
fn t_right_click_in_a_pane_opens_the_document_menu() {
    var ed = fixture()
    let leaf = table_root(mut ed)
    let before = ed.focus
    frame_pane(mut ed, ed.pane_root, leaf)
    edit.mouse_event(mut ed, ev(term.MB_RIGHT, term.KEY_PRESS, 10, 5))
    assert(edit.ctx_active(ed.ctx), "a menu")
    assert(edit.ctx_kind(ed.ctx) == edit.CTX_KIND_DOC, "the document menu")
    assert(ed.mouse.phase == edit.MP_IDLE, "never armed")
    assert(ed.mouse.held == 0, "nothing held")
    // Opening a menu on a pane does not FOCUS it.
    assert(ed.focus == before, "focus unchanged")
}

// `test_mouse_unlisted_regions_are_inert` (`:460-484`).
fn t_unlisted_regions_are_inert() {
    var ed = fixture()
    let before = ed.focus
    let dispatches = ed.dispatch_count
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_NONE, copy ed.panes[ed.pane_root].rect, 0)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, 10, 5))
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, 10, 5))
    edit.mouse_event(mut ed, wheel(term.MB_WHEEL_DOWN, 10, 5, 0))
    assert(ed.focus == before, "focus unchanged")
    assert(ed.dispatch_count == dispatches, "nothing dispatched")
    assert(ed.mouse.phase == edit.MP_IDLE, "idle")
}

// ---- §3: the wheel -----------------------------------------------------------------

// `test_mouse_wheel_scrolls_the_pane_under_the_pointer` (`:490-533`), DoD 5.
fn t_wheel_scrolls_the_pane_under_the_pointer() {
    var ed = fixture()
    fill_lines(mut ed, 80)
    let root = ed.pane_root
    let right = edit.pane_split(mut ed, root, edit.SPLIT_V)
    assert(right >= 0, "split")
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 23))
    let left = if ed.panes[ed.pane_root].a == right then ed.panes[ed.pane_root].b else ed.panes[ed.pane_root].a
    ed.focus = left
    ed.win = ed.panes[left].win
    assert(ed.panes[right].win >= 0, "the right pane has a window")
    edit.pane_tables_reset(mut ed)
    let _ = edit.pane_table_add_leaf(mut ed, left)
    let right_id = edit.pane_table_add_leaf(mut ed, right)
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.panes[right].rect, right_id)
    let cursor_before = cursor_pos(ed)
    let lw = ed.panes[left].win
    let rw = ed.panes[right].win
    let left_top_before = ed.wins[lw].vp.top
    let r = copy ed.panes[right].rect
    edit.mouse_event(mut ed, wheel(term.MB_WHEEL_DOWN, r.x + 2, r.y + 2, 0))
    assert(ed.wins[rw].vp.top == edit.WHEEL_ROWS, "the UNFOCUSED pane moved one notch: {ed.wins[rw].vp.top}")
    assert(ed.focus == left, "focus unchanged")
    assert(ed.wins[lw].vp.top == left_top_before, "the focused pane did not move")
    assert(cursor_pos(ed) == cursor_before, "the cursor did not move")
}

// `test_mouse_wheel_has_no_acceleration` (`:535-563`).
fn t_wheel_has_no_acceleration() {
    var ed = fixture()
    fill_lines(mut ed, 200)
    let leaf = table_root(mut ed)
    frame_pane(mut ed, ed.pane_root, leaf)
    var i = 1
    while i <= 10 {
        edit.mouse_event(mut ed, wheel(term.MB_WHEEL_DOWN, 10, 5, 0))
        assert(ed.wins[ed.win].vp.top == i * edit.WHEEL_ROWS, "notch {i}")
        i += 1
    }
    var k = 0
    while k < 20 {
        edit.mouse_event(mut ed, wheel(term.MB_WHEEL_UP, 10, 5, 0))
        k += 1
    }
    assert(ed.wins[ed.win].vp.top == 0, "stops at the top")
}

// `test_mouse_ctrl_wheel_is_unbound` (`:565-585`).
fn t_ctrl_wheel_is_unbound() {
    var ed = fixture()
    fill_lines(mut ed, 60)
    let leaf = table_root(mut ed)
    frame_pane(mut ed, ed.pane_root, leaf)
    edit.mouse_event(mut ed, wheel(term.MB_WHEEL_DOWN, 10, 5, term.MOD_CTRL))
    assert(ed.wins[ed.win].vp.top == 0, "Ctrl+wheel is the terminal's")
}

// `test_mouse_shift_wheel_scrolls_sideways_and_not_when_wrapped`
// (`:587-668`).
fn t_shift_wheel_scrolls_sideways_and_not_when_wrapped() {
    var ed = fixture()
    var wide = List[byte]()
    var n = 0
    while n < 399 {
        (mut wide).push('x' as int as byte)
        n += 1
    }
    let w = ed.win
    let at = cursor_pos(ed)
    assert(edit.ed_edit_insert(mut ed, w, at, wide, 0, wide.len), "wide line")
    edit.ed_finish_edit(mut ed, w)
    let leaf = table_root(mut ed)
    frame_pane(mut ed, ed.pane_root, leaf)
    ed.wins[w].vp.wrap = false
    let right = wheel(term.MB_WHEEL_DOWN, 10, 5, term.MOD_SHIFT)
    edit.mouse_event(mut ed, right)
    assert(ed.wins[w].vp.left == edit.WHEEL_COLS, "one notch right")
    edit.mouse_event(mut ed, right)
    assert(ed.wins[w].vp.left == 2 * edit.WHEEL_COLS, "two notches right")
    let back = wheel(term.MB_WHEEL_UP, 10, 5, term.MOD_SHIFT)
    edit.mouse_event(mut ed, back)
    assert(ed.wins[w].vp.left == edit.WHEEL_COLS, "one back")
    edit.mouse_event(mut ed, back)
    assert(ed.wins[w].vp.left == 0, "at column 0")
    edit.mouse_event(mut ed, back)
    assert(ed.wins[w].vp.left == 0, "never negative")
    // Wrapped, there is nowhere to go — and the no-op is SILENT.
    ed.wins[w].vp.wrap = true
    ed.wins[w].vp.left = 0
    edit.ed_msg_clear(mut ed)
    edit.mouse_event(mut ed, right)
    assert(ed.wins[w].vp.left == 0, "wrapped: no motion")
    assert(!ed.msg.active, "and no message")
}

// `test_mouse_wheel_over_the_strip_scrolls_the_strip` (`:670-701`).
fn t_wheel_over_the_strip_scrolls_the_strip() {
    var ed = fixture()
    open_tabs(mut ed, "yew-mouse-w", 8)
    ed.tab_scroll = 4
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_TAB, edit.rect(0, 0, 10, 1), 0)
    edit.mouse_event(mut ed, wheel(term.MB_WHEEL_UP, 2, 0, 0))
    // One ENTRY, not WHEEL_ROWS of them: the strip's unit is a tab.
    assert(ed.tab_scroll == 3, "one entry left: {ed.tab_scroll}")
    edit.mouse_event(mut ed, wheel(term.MB_WHEEL_DOWN, 2, 0, 0))
    assert(ed.tab_scroll == 4, "one entry right")
}

// ---- Sprint 57.15: the chevron scrolls, and hovering reveals ---------------------

// `hv_fixture` (`:2075-2093`): a real strip, painted by the renderer.
fn hv_fixture(extra_tabs: int, cols: int) -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(24, cols)
    ed.grid_ready = true
    var i = 0
    while i < extra_tabs {
        assert(edit.tab_open(mut ed, "/tmp/yew-hover-{i}.txt") >= 0, "open {i}")
        i += 1
    }
    edit.ed_layout(mut ed)
    ed.now_ms = 1000
    ed
}

// `hv_paint` (`:2095-2101`).
fn hv_paint(mut ed: edit.Ed) {
    if ed.layout_dirty {
        edit.ed_layout(mut ed)
    }
    edit.region_frame_begin(mut ed.regions)
    let tr = copy ed.tab_strip_rect
    edit.tab_strip_draw(mut ed, tr)
}

// `hv_chevron_x` (`:2103-2118`): the first cell on `row` carrying a
// chevron pointing `right`.
fn hv_chevron_x(mut ed: edit.Ed, row: int, right: bool, cols: int) -> (bool, int) {
    var x = 0
    while x < cols {
        let hit = edit.region_hit(mut ed.regions, x, row)
        if hit.kind == edit.REGION_TAB_SCROLL && (hit.payload > 0) == right {
            return (true, x)
        }
        x += 1
    }
    (false, 0)
}

// `hv_motion` (`:2120-2123`): no button held.
fn hv_motion(x: int, y: int) -> term.Key {
    ev(term.MB_NONE, term.KEY_REPEAT, x, y)
}

fn click_at(mut ed: edit.Ed, x: int, y: int) {
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, x, y))
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, x, y))
}

// `test_mouse_chevron_click_scrolls_and_stays` (`:2125-2158`): THE
// regression s57.15 exists for — the render used to walk the offset back.
fn t_chevron_click_scrolls_and_stays() {
    var ed = hv_fixture(9, 40)
    edit.tab_switch(mut ed, 0)
    hv_paint(mut ed)
    assert(ed.tab_scroll == 0, "at the start")
    let (have, first) = hv_chevron_x(mut ed, 0, true, 40)
    assert(have, "a right chevron")
    var chev = first
    var i = 1
    while i <= 3 {
        click_at(mut ed, chev, 0)
        assert(ed.tab_scroll == i, "click {i} scrolled")
        hv_paint(mut ed)
        assert(ed.tab_scroll == i, "click {i} survives the render")
        let (h2, c2) = hv_chevron_x(mut ed, 0, true, 40)
        assert(h2, "still a right chevron")
        chev = c2
        i += 1
    }
    assert(ed.tab_active == 0, "the active tab is off-screen and that is a view")
    let (hl, left) = hv_chevron_x(mut ed, 0, false, 40)
    assert(hl, "a left chevron once scrolled")
    click_at(mut ed, left, 0)
    assert(ed.tab_scroll == 2, "back one")
    hv_paint(mut ed)
    assert(ed.tab_scroll == 2, "and it stays")
    edit.tab_switch(mut ed, 0)
    hv_paint(mut ed)
    assert(ed.tab_scroll == 0, "a switch hands the strip back to the follow")
}

// `test_mouse_wheel_over_the_strip_survives_the_render` (`:2160-2178`).
fn t_wheel_over_the_strip_survives_the_render() {
    var ed = hv_fixture(9, 40)
    edit.tab_switch(mut ed, 0)
    hv_paint(mut ed)
    edit.mouse_event(mut ed, wheel(term.MB_WHEEL_DOWN, 2, 0, 0))
    assert(ed.tab_scroll == 1, "one entry")
    hv_paint(mut ed)
    assert(ed.tab_scroll == 1, "survives a render")
    hv_paint(mut ed)
    assert(ed.tab_scroll == 1, "and another")
}

// `test_mouse_chevron_click_on_row_two_stays_on_row_two` (`:2180-2216`).
fn t_chevron_click_on_row_two_stays_on_row_two() {
    var ed = hv_fixture(9, 40)
    let g = edit.group_create(mut ed, "/src", "")
    var i = 2
    while i <= 9 {
        edit.group_add_member(mut ed, g, i)
        i += 1
    }
    edit.tab_switch(mut ed, 2)
    hv_paint(mut ed)
    assert(edit.active_group_id(ed) == g, "inside the group")
    assert(ed.tab_strip_rect.h >= 2, "two rows")
    let (have, chev) = hv_chevron_x(mut ed, 1, true, 40)
    assert(have, "row 2 has a right chevron")
    let row1_before = ed.tab_scroll
    click_at(mut ed, chev, 1)
    assert(ed.tab_member_scroll == 1, "row 2 moved")
    assert(ed.tab_scroll == row1_before, "row 1 did not")
    hv_paint(mut ed)
    assert(ed.tab_member_scroll == 1, "survives the render")
    assert(ed.tab_member_scroll_user, "row 2's offset is the user's")
    assert(!ed.tab_scroll_user, "row 1's is not")
}

// `test_mouse_chevron_hover_reveals_one_entry_per_window` (`:2218-2265`):
// one entry per window while the pointer rests, never one per report.
fn t_chevron_hover_reveals_one_entry_per_window() {
    var ed = hv_fixture(9, 40)
    edit.tab_switch(mut ed, 0)
    hv_paint(mut ed)
    let (have, chev) = hv_chevron_x(mut ed, 0, true, 40)
    assert(have, "a right chevron")
    let t0 = ed.now_ms
    var i = 0
    while i < 1000 {
        edit.mouse_event(mut ed, hv_motion(chev, 0))
        i += 1
    }
    assert(ed.mouse.hover_chevron, "armed")
    assert(ed.tab_scroll == 0, "a thousand reports move nothing")
    assert(edit.mouse_deadline(ed, t0) == edit.HOVER_SCROLL_MS, "the first step is a window away")
    edit.mouse_tick(mut ed, t0 + edit.HOVER_SCROLL_MS - 1)
    assert(ed.tab_scroll == 0, "not yet")
    edit.mouse_tick(mut ed, t0 + edit.HOVER_SCROLL_MS)
    assert(ed.tab_scroll == 1, "one step")
    assert(ed.tab_scroll_user, "the offset is the user's")
    hv_paint(mut ed)
    assert(ed.tab_scroll == 1, "survives the render")
    edit.mouse_tick(mut ed, t0 + edit.HOVER_SCROLL_MS + 1)
    assert(ed.tab_scroll == 1, "not again within the window")
    edit.mouse_tick(mut ed, t0 + 2 * edit.HOVER_SCROLL_MS)
    assert(ed.tab_scroll == 2, "the second step")
    hv_paint(mut ed)
    assert(ed.tab_scroll == 2, "survives the render")
}

// `test_mouse_chevron_hover_stops_when_the_pointer_leaves` (`:2267-2293`).
fn t_chevron_hover_stops_when_the_pointer_leaves() {
    var ed = hv_fixture(9, 40)
    edit.tab_switch(mut ed, 0)
    hv_paint(mut ed)
    let (have, chev) = hv_chevron_x(mut ed, 0, true, 40)
    assert(have, "a right chevron")
    let t0 = ed.now_ms
    edit.mouse_event(mut ed, hv_motion(chev, 0))
    assert(ed.mouse.hover_chevron, "armed")
    edit.mouse_event(mut ed, hv_motion(1, 0))
    assert(!ed.mouse.hover_chevron, "left")
    assert(edit.mouse_deadline(ed, t0) == -1, "no deadline")
    edit.mouse_tick(mut ed, t0 + 10 * edit.HOVER_SCROLL_MS)
    assert(ed.tab_scroll == 0, "nothing scrolled")
}

// `test_mouse_chevron_hover_waits_for_the_menu_to_close` (`:2735-2774`):
// an OPEN MENU owns the hover.
fn t_chevron_hover_waits_for_the_menu_to_close() {
    var ed = hv_fixture(9, 40)
    edit.tab_switch(mut ed, 0)
    hv_paint(mut ed)
    let (have, chev) = hv_chevron_x(mut ed, 0, true, 40)
    assert(have, "a right chevron")
    let t0 = ed.now_ms
    let id0 = ed.tabs[0].tab_id
    assert(edit.mouse_open_tab_menu(mut ed, id0, 2, 0), "a tab menu")
    edit.mouse_event(mut ed, hv_motion(chev, 0))
    assert(!ed.mouse.hover_chevron, "the menu owns the hover")
    edit.mouse_tick(mut ed, t0 + 10 * edit.HOVER_SCROLL_MS)
    assert(ed.tab_scroll == 0, "nothing revealed")
    let _ = edit.mouse_menu_key(mut ed, esc_key())
    hv_paint(mut ed)
    let (have2, chev2) = hv_chevron_x(mut ed, 0, true, 40)
    assert(have2, "still a chevron")
    edit.mouse_event(mut ed, hv_motion(chev2, 0))
    assert(ed.mouse.hover_chevron, "the next report arms it again")
}

// `test_mouse_chevron_hover_stops_at_the_end_of_the_strip` (`:2295-2335`).
fn t_chevron_hover_stops_at_the_end_of_the_strip() {
    var ed = hv_fixture(9, 40)
    edit.tab_switch(mut ed, 0)
    hv_paint(mut ed)
    let (have, chev) = hv_chevron_x(mut ed, 0, true, 40)
    assert(have, "a right chevron")
    var t = ed.now_ms
    edit.mouse_event(mut ed, hv_motion(chev, 0))
    var step = 0
    while step < 20 {
        t += edit.HOVER_SCROLL_MS
        edit.mouse_tick(mut ed, t)
        hv_paint(mut ed)
        if !ed.mouse.hover_chevron {
            break
        }
        step += 1
    }
    assert(!ed.mouse.hover_chevron, "it stopped on its own")
    let (still, _) = hv_chevron_x(mut ed, 0, true, 40)
    assert(!still, "nothing left to reveal on the right")
    assert(edit.mouse_deadline(ed, t) == -1, "no deadline")
    let settled = ed.tab_scroll
    edit.mouse_tick(mut ed, t + 10 * edit.HOVER_SCROLL_MS)
    assert(ed.tab_scroll == settled, "a tick after the end changes nothing")
}

// `test_mouse_chevron_hover_tick_cancels_when_the_chevron_goes`
// (`:2337-2372`).
fn t_chevron_hover_tick_cancels_when_the_chevron_goes() {
    var ed = hv_fixture(9, 40)
    edit.tab_switch(mut ed, 0)
    hv_paint(mut ed)
    let (have, chev) = hv_chevron_x(mut ed, 0, true, 40)
    assert(have, "a right chevron")
    let t0 = ed.now_ms
    edit.mouse_event(mut ed, hv_motion(chev, 0))
    assert(ed.mouse.hover_chevron, "armed")
    var i = 9
    while i >= 2 {
        assert(edit.tab_close(mut ed, i), "close {i}")
        i -= 1
    }
    hv_paint(mut ed)
    let (still, _) = hv_chevron_x(mut ed, 0, true, 40)
    assert(!still, "the strip fits: no chevron")
    edit.mouse_tick(mut ed, t0 + edit.HOVER_SCROLL_MS)
    assert(!ed.mouse.hover_chevron, "the tick disarmed")
    assert(ed.tab_scroll == 0, "nothing scrolled")
    assert(edit.mouse_deadline(ed, t0) == -1, "no deadline")
}

// `hv_group_fixture` (`:2388-2404`): active INSIDE the group.
fn hv_group_fixture(extra_tabs: int, members: int, cols: int) -> (edit.Ed, int) {
    var ed = hv_fixture(extra_tabs, cols)
    let g = edit.group_create(mut ed, "/src", "grp")
    assert(g != 0, "a group")
    var i = 1
    while i <= members {
        edit.group_add_member(mut ed, g, i)
        i += 1
    }
    edit.tab_switch(mut ed, 1)
    edit.ed_layout(mut ed)
    (ed, g)
}

// `test_mouse_row2_chevron_hover_scrolls_row_2_and_not_row_1`
// (`:2406-2443`): the assertion is a PAIR.
fn t_row2_chevron_hover_scrolls_row_2_and_not_row_1() {
    let (e0, g) = hv_group_fixture(13, 7, 40)
    var ed = e0
    hv_paint(mut ed)
    assert(edit.active_group_id(ed) == g, "inside")
    assert(ed.tab_strip_rect.h == 2, "two rows")
    let (h1, _) = hv_chevron_x(mut ed, 0, true, 40)
    let (h2, chev) = hv_chevron_x(mut ed, 1, true, 40)
    assert(h1 && h2, "both rows overflow")
    let t0 = ed.now_ms
    edit.mouse_event(mut ed, hv_motion(chev, 1))
    assert(ed.mouse.hover_chevron, "armed")
    assert(ed.tab_scroll == 0 && ed.tab_member_scroll == 0, "nothing yet")
    edit.mouse_tick(mut ed, t0 + edit.HOVER_SCROLL_MS)
    assert(ed.tab_member_scroll == 1, "row 2 moved")
    assert(ed.tab_scroll == 0, "row 1 did not")
    assert(ed.tab_member_scroll_user, "row 2's offset is the user's")
    assert(!ed.tab_scroll_user, "row 1's is not")
    hv_paint(mut ed)
    assert(ed.tab_member_scroll == 1, "survives the render")
    assert(ed.tab_scroll == 0, "row 1 still")
}

// `hv_tab_x` (`:2445-2460`): the first cell on `row` carrying a tab.
fn hv_tab_x(mut ed: edit.Ed, row: int, cols: int) -> (bool, int, int) {
    var x = 0
    while x < cols {
        let hit = edit.region_hit(mut ed.regions, x, row)
        if hit.kind == edit.REGION_TAB {
            return (true, x, hit.payload)
        }
        x += 1
    }
    (false, 0, 0)
}

// `test_mouse_drag_autoscroll_moves_the_row_under_the_pointer`
// (`:2462-2510`).
fn t_drag_autoscroll_moves_the_row_under_the_pointer() {
    let (e0, _) = hv_group_fixture(13, 7, 40)
    var ed = e0
    hv_paint(mut ed)
    let (h2, chev) = hv_chevron_x(mut ed, 1, true, 40)
    assert(h2, "row 2's chevron")
    let (ht, tabx, _) = hv_tab_x(mut ed, 0, 40)
    assert(ht, "a row-1 entry")
    let t0 = ed.now_ms
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, tabx, 0))
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_REPEAT, chev, 1))
    assert(ed.mouse.phase == edit.MP_DRAG_TAB, "carrying a tab")
    assert(ed.tab_scroll == 0 && ed.tab_member_scroll == 0, "nothing yet")
    edit.mouse_tick(mut ed, t0 + edit.DRAG_SCROLL_MS)
    assert(ed.tab_member_scroll == 1, "row 2 moved")
    assert(ed.tab_scroll == 0, "row 1 did not")
}

// `test_mouse_motion_tracking_follows_the_chevrons_too` (`:2590-2648`).
fn t_motion_tracking_follows_the_chevrons_too() {
    var ed = hv_fixture(9, 40)
    edit.tab_switch(mut ed, 0)
    assert(!motion_active(ed), "disarmed at the start")
    hv_paint(mut ed)
    assert(edit.mouse_chevron_drawn(ed), "a chevron")
    assert(motion_active(ed), "armed with no menu")
    assert(!edit.ctx_active(ed.ctx), "no menu")
    let id0 = ed.tabs[0].tab_id
    assert(edit.mouse_open_tab_menu(mut ed, id0, 2, 0), "a menu on top")
    assert(motion_active(ed), "armed")
    let _ = edit.mouse_menu_key(mut ed, esc_key())
    assert(!edit.ctx_active(ed.ctx), "closed")
    assert(motion_active(ed), "the strip still wants motion")
    var i = 9
    while i >= 2 {
        assert(edit.tab_close(mut ed, i), "close {i}")
        i -= 1
    }
    hv_paint(mut ed)
    assert(!edit.mouse_chevron_drawn(ed), "the strip fits")
    assert(!motion_active(ed), "nobody wants it")
    let idn = ed.tabs[0].tab_id
    assert(edit.mouse_open_tab_menu(mut ed, idn, 2, 0), "a menu over a fitting strip")
    assert(motion_active(ed), "armed")
    let _ = edit.mouse_menu_key(mut ed, esc_key())
    assert(!motion_active(ed), "given back")
}

// `test_mouse_motion_reassert_after_a_restore` (`:2512-2588`).
fn t_motion_reassert_after_a_restore() {
    var ed = hv_fixture(9, 40)
    edit.tab_switch(mut ed, 0)
    hv_paint(mut ed)
    assert(edit.mouse_chevron_drawn(ed), "a chevron")
    assert(motion_active(ed), "armed")
    // What the SIGTSTP restore does to the flag.
    term.tty_mouse_motion(mut ed.tty, false)
    hv_paint(mut ed)
    assert(edit.mouse_chevron_drawn(ed), "still drawn")
    assert(!motion_active(ed), "THE BUG: the paint does not re-arm")
    edit.mouse_motion_reassert(mut ed)
    assert(motion_active(ed), "the reassert does")
    edit.mouse_motion_reassert(mut ed)
    assert(motion_active(ed), "idempotent")
    var i = 9
    while i >= 2 {
        assert(edit.tab_close(mut ed, i), "close {i}")
        i -= 1
    }
    hv_paint(mut ed)
    assert(!edit.mouse_chevron_drawn(ed), "fits")
    assert(!motion_active(ed), "down")
    edit.mouse_motion_reassert(mut ed)
    assert(!motion_active(ed), "and the reassert leaves it down")
    let id0 = ed.tabs[0].tab_id
    assert(edit.mouse_open_tab_menu(mut ed, id0, 2, 0), "a menu")
    assert(motion_active(ed), "armed for the menu")
    term.tty_mouse_motion(mut ed.tty, false)
    edit.mouse_motion_reassert(mut ed)
    assert(motion_active(ed), "a menu open across the restore is a want")
    let _ = edit.mouse_menu_key(mut ed, esc_key())
    assert(!edit.ctx_active(ed.ctx), "closed")
    assert(!motion_active(ed), "down")
}

// `test_mouse_motion_off_a_chevron_marks_no_damage` (`:2650-2685`).
fn t_motion_off_a_chevron_marks_no_damage() {
    var ed = hv_fixture(9, 40)
    edit.tab_switch(mut ed, 0)
    hv_paint(mut ed)
    let (have, chev) = hv_chevron_x(mut ed, 0, true, 40)
    assert(have, "a right chevron")
    ed.full_damage = false
    ed.overlay_dirty = false
    ed.layout_dirty = false
    var i = 0
    while i < 200 {
        edit.mouse_event(mut ed, hv_motion(1 + i % 20, i % 2))
        i += 1
    }
    assert(!ed.full_damage && !ed.overlay_dirty && !ed.layout_dirty, "no damage")
    i = 0
    while i < 200 {
        edit.mouse_event(mut ed, hv_motion(chev, 0))
        i += 1
    }
    assert(ed.mouse.hover_chevron, "parked: the clock is armed")
    assert(!ed.full_damage && !ed.overlay_dirty, "and still no paint")
}

// ---- the captured-identity law (DoD 4) ---------------------------------------------

// `test_mouse_press_captures_its_target_across_a_strip_change`
// (`:707-744`): THE law, made executable.
fn t_press_captures_its_target_across_a_strip_change() {
    var ed = fixture()
    open_tabs(mut ed, "yew-mouse-", 4)
    assert(edit.tab_count(ed) == 5, "five tabs")
    let target_id = ed.tabs[3].tab_id
    edit.tab_switch(mut ed, 0)
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_TAB, edit.rect(20, 0, 10, 1), 3)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, 22, 0))
    assert(ed.mouse.drag_tab_id == target_id, "the identity captured")
    // Frame B: the strip scrolled; those same cells are now tab 1.
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_TAB, edit.rect(20, 0, 10, 1), 1)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, 22, 0))
    assert(ed.tab_active == edit.tab_index_of_id(ed, target_id), "the tab AIMED at")
}

// `test_mouse_press_on_a_tab_closed_mid_gesture_is_inert` (`:746-780`).
fn t_press_on_a_tab_closed_mid_gesture_is_inert() {
    var ed = fixture()
    open_tabs(mut ed, "yew-mouse-c", 4)
    let target_id = ed.tabs[3].tab_id
    edit.tab_switch(mut ed, 0)
    let active_before = ed.tab_active
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_TAB, edit.rect(20, 0, 10, 1), 3)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, 22, 0))
    let idx = edit.tab_index_of_id(ed, target_id)
    assert(edit.tab_close(mut ed, idx), "closed under the gesture")
    edit.tab_switch(mut ed, active_before)
    assert(edit.tab_index_of_id(ed, target_id) == -1, "gone")
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, 22, 0))
    assert(ed.tab_active == active_before, "nothing happened")
}

// `test_mouse_press_on_a_group_entry_captures_the_gid` (`:782-821`).
fn t_press_on_a_group_entry_captures_the_gid() {
    var ed = fixture()
    open_tabs(mut ed, "yew-mouse-g", 3)
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 2)
    edit.group_add_member(mut ed, g, 3)
    edit.tab_switch(mut ed, 0)
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_TAB, edit.rect(0, 0, 8, 1), -g)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, 2, 0))
    assert(ed.mouse.drag_gid == g, "the gid captured")
    assert(ed.mouse.drag_tab_id == 0, "no tab")
    assert(edit.active_group_id(ed) == 0, "a press arms, it does not switch")
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_TAB, edit.rect(0, 0, 8, 1), 1)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, 2, 0))
    assert(edit.active_group_id(ed) == g, "the group entered")
}

// ---- §9 and Sprint 57.22: the drop on a pane ---------------------------------------

// `test_mouse_tab_dropped_on_a_pane_cancels` (`:837-889`): NARROWED by
// s57.22 — the INTERIOR still cancels.
fn t_tab_dropped_on_a_pane_cancels() {
    var ed = fixture()
    open_tabs(mut ed, "yew-mouse-d", 4)
    edit.tab_switch(mut ed, 0)
    edit.ed_layout(mut ed)
    let leaf = table_root(mut ed)
    edit.region_frame_begin(mut ed.regions)
    let tr = copy ed.tab_strip_rect
    edit.tab_strip_draw(mut ed, tr)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.panes[ed.pane_root].rect, leaf)
    let held = ed.tabs[0].tab_id
    var x = 0
    while x < 80 {
        if edit.strip_slot_at(ed, x, 0) == 0 {
            break
        }
        x += 1
    }
    assert(x < 80, "slot 0 is drawn")
    let y = ed.panes[ed.pane_root].rect.y + 5
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, x, 0))
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_REPEAT, 40, y))
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, 40, y))
    assert(edit.tab_index_of_id(ed, held) == 0, "not moved")
    assert(ed.mouse.phase == edit.MP_IDLE, "the gesture is over")
}

// `sp_fixture_sized` (`:2786-2805`): four real tabs plus the scratch, a
// FULL frame drawn so the regions come from the renderer.
fn sp_fixture_sized(rows: int, cols: int) -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(rows, cols)
    ed.grid_ready = true
    ed.now_ms = 1000
    var i = 0
    while i < 4 {
        assert(edit.tab_open(mut ed, "/tmp/yew-mouse-sp{i}.txt") >= 0, "open {i}")
        i += 1
    }
    edit.tab_switch(mut ed, 0)
    edit.ed_layout(mut ed)
    edit.draw_panes(mut ed)
    ed
}

fn sp_fixture() -> edit.Ed {
    sp_fixture_sized(24, 80)
}

// `sp_slot_x` (`:2812-2821`).
fn sp_slot_x(ed: edit.Ed, slot: int) -> int {
    var x = 0
    while x < ed.grid.cols {
        if edit.strip_slot_at(ed, x, ed.tab_strip_rect.y) == slot {
            return x
        }
        x += 1
    }
    assert(false, "slot {slot} is drawn")
    0
}

fn rect_eq(a: edit.Rect, b: edit.Rect) -> bool {
    a.x == b.x && a.y == b.y && a.w == b.w && a.h == b.h
}

// `sp_last_drawn_slot` (`:2828-2840`).
fn sp_last_drawn_slot(ed: edit.Ed) -> int {
    var best = -1
    var x = 0
    while x < ed.grid.cols {
        let slot = edit.strip_slot_at(ed, x, ed.tab_strip_rect.y)
        if slot > best {
            best = slot
        }
        x += 1
    }
    best
}

// `sp_drag` (`:2842-2856`): press on `slot`, through `via`, release at
// (x, y).
fn sp_drag(mut ed: edit.Ed, slot: int, via_x: int, via_y: int, x: int, y: int) {
    let px = sp_slot_x(ed, slot)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, px, ed.tab_strip_rect.y))
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_REPEAT, via_x, via_y))
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_REPEAT, x, y))
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, x, y))
}

// `test_mouse_tab_dropped_on_a_pane_edge_spawns_a_pane` (`:2858-2918`):
// each side asserts WHICH child the new leaf is and which buffer it holds.
fn t_tab_dropped_on_a_pane_edge_spawns_a_pane() {
    var side = 0
    while side <= 2 {
        var ed = sp_fixture()
        let r = copy ed.panes[ed.pane_root].rect
        let dragged = edit.tab_buffer(ed, 2)
        assert(dragged >= 0, "tab 2's buffer")
        assert(ed.wins[ed.win].buf != dragged, "not the shown one")
        var x = r.x
        var y = r.y + r.h / 2
        if side == 1 {
            x = r.x + r.w - 1
        } else if side == 2 {
            x = r.x + r.w / 2
            y = r.y + r.h - 1
        }
        sp_drag(mut ed, 2, x, y, x, y)
        assert(ed.mouse.phase == edit.MP_IDLE, "side {side}: idle")
        let root = ed.pane_root
        assert(edit.pane_leaf_count(ed, root) == 2, "side {side}: two leaves")
        assert(!ed.panes[root].is_leaf, "side {side}: the root split")
        let want_dir = if side == 2 then edit.SPLIT_V else edit.SPLIT_H
        assert(ed.panes[root].dir == want_dir, "side {side}: the direction")
        let nu = if side == 0 then ed.panes[root].a else ed.panes[root].b
        let old = if side == 0 then ed.panes[root].b else ed.panes[root].a
        assert(ed.wins[ed.panes[nu].win].buf == dragged, "side {side}: the new leaf shows the dragged tab")
        assert(ed.wins[ed.panes[old].win].buf != dragged, "side {side}: the old one does not")
        assert(ed.focus == nu, "side {side}: the new pane is focused")
        assert(ed.win == ed.panes[nu].win, "side {side}: and its window")
        assert(edit.tab_count(ed) == 5, "side {side}: the tab STAYS")
        assert(ed.tab_active == 0, "side {side}: active unchanged")
        assert(edit.tab_buffer(ed, 2) == dragged, "side {side}: tab 2 still its buffer")
        side += 1
    }
}

// `test_mouse_tab_spawn_does_not_also_reorder_the_strip` (`:2920-2952`).
fn t_tab_spawn_does_not_also_reorder_the_strip() {
    var ed = sp_fixture()
    var ids = List[int]()
    var i = 0
    while i < 5 {
        (mut ids).push(ed.tabs[i].tab_id)
        i += 1
    }
    let r = copy ed.panes[ed.pane_root].rect
    let last = sp_last_drawn_slot(ed)
    assert(last > 1, "a live reorder target")
    sp_drag(mut ed, 1, sp_slot_x(ed, last), ed.tab_strip_rect.y, r.x + r.w - 1, r.y + r.h / 2)
    let root = ed.pane_root
    assert(edit.pane_leaf_count(ed, root) == 2, "spawned")
    let b = ed.panes[root].b
    assert(ed.wins[ed.panes[b].win].buf == edit.tab_buffer(ed, 1), "tab 1's buffer")
    assert(edit.tab_count(ed) == 5, "five tabs")
    i = 0
    while i < 5 {
        assert(edit.tab_index_of_id(ed, ids[i]) == i, "tab {i} where it started")
        i += 1
    }
}

// `test_mouse_tab_dropped_on_an_edge_splits_the_leaf_under_it`
// (`:2954-2985`).
fn t_tab_dropped_on_an_edge_splits_the_leaf_under_it() {
    var ed = sp_fixture()
    let root0 = ed.pane_root
    let right = edit.pane_split(mut ed, root0, edit.SPLIT_H)
    assert(right >= 0, "split")
    let left = ed.panes[ed.pane_root].a
    edit.ed_layout(mut ed)
    edit.draw_panes(mut ed)
    let r = copy ed.panes[right].rect
    let dragged = edit.tab_buffer(ed, 3)
    assert(dragged >= 0, "tab 3's buffer")
    sp_drag(mut ed, 3, r.x + r.w / 2, r.y + r.h / 2, r.x + r.w - 1, r.y + r.h / 2)
    let root = ed.pane_root
    assert(edit.pane_leaf_count(ed, root) == 3, "three leaves")
    assert(ed.panes[root].a == left, "the left leaf untouched")
    assert(ed.panes[left].is_leaf, "still a leaf")
    assert(ed.panes[root].b == right, "the right node")
    assert(!ed.panes[right].is_leaf, "became the split")
    assert(ed.panes[right].dir == edit.SPLIT_H, "side by side")
    let nb = ed.panes[right].b
    assert(ed.wins[ed.panes[nb].win].buf == dragged, "the new leaf shows tab 3")
    assert(ed.focus == nb, "focused")
}

// `test_mouse_tab_dropped_just_inside_the_band_cancels` (`:2987-3006`).
fn t_tab_dropped_just_inside_the_band_cancels() {
    var ed = sp_fixture()
    let r = copy ed.panes[ed.pane_root].rect
    let depth = edit.pane_zone_depth(r.w)
    sp_drag(mut ed, 2, r.x + depth, r.y + r.h / 2, r.x + depth, r.y + r.h / 2)
    let root = ed.pane_root
    assert(edit.pane_leaf_count(ed, root) == 1, "no split")
    assert(ed.panes[root].is_leaf, "the root is a leaf")
    assert(ed.mouse.phase == edit.MP_IDLE, "idle")
}

// `test_mouse_tab_drag_cancelled_by_esc_spawns_nothing` (`:3008-3036`).
fn t_tab_drag_cancelled_by_esc_spawns_nothing() {
    var ed = sp_fixture()
    let r = copy ed.panes[ed.pane_root].rect
    let x = r.x + r.w - 1
    let y = r.y + r.h / 2
    let px = sp_slot_x(ed, 2)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, px, ed.tab_strip_rect.y))
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_REPEAT, x, y))
    assert(ed.mouse.phase == edit.MP_DRAG_TAB, "carrying")
    edit.mouse_cancel(mut ed)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, x, y))
    let root = ed.pane_root
    assert(edit.pane_leaf_count(ed, root) == 1, "no split")
    assert(ed.panes[root].is_leaf, "a leaf")
    assert(ed.mouse.phase == edit.MP_IDLE, "idle")
}

// `test_mouse_tab_count_change_mid_drag_spawns_nothing` (`:3038-3067`).
fn t_tab_count_change_mid_drag_spawns_nothing() {
    var ed = sp_fixture()
    let r = copy ed.panes[ed.pane_root].rect
    let x = r.x + r.w - 1
    let y = r.y + r.h / 2
    let px = sp_slot_x(ed, 2)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, px, ed.tab_strip_rect.y))
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_REPEAT, x, y))
    assert(ed.mouse.phase == edit.MP_DRAG_TAB, "carrying")
    assert(edit.tab_close(mut ed, 4), "a job closes a file")
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, x, y))
    let root = ed.pane_root
    assert(edit.pane_leaf_count(ed, root) == 1, "no split")
    assert(ed.panes[root].is_leaf, "a leaf")
}

// `test_mouse_tab_spawn_is_refused_at_the_leaf_cap` (`:3069-3110`).
fn t_tab_spawn_is_refused_at_the_leaf_cap() {
    var ed = sp_fixture_sized(100, 80)
    while edit.pane_leaf_count(ed, ed.pane_root) < edit.PANE_MAX_LEAVES {
        let leaves = edit.pane_collect_leaves(ed, ed.pane_root, edit.PANE_MAX_LEAVES * 2)
        var tallest = 0
        var i = 1
        while i < leaves.len {
            if ed.panes[leaves[i]].rect.h > ed.panes[leaves[tallest]].rect.h {
                tallest = i
            }
            i += 1
        }
        assert(edit.pane_split(mut ed, leaves[tallest], edit.SPLIT_V) >= 0, "split {leaves.len}")
        edit.ed_layout(mut ed)
    }
    edit.draw_panes(mut ed)
    let leaves = edit.pane_collect_leaves(ed, ed.pane_root, edit.PANE_MAX_LEAVES * 2)
    let r = copy ed.panes[leaves[0]].rect
    assert(r.w > 0, "a drawn leaf")
    let (zoned, _) = edit.pane_zone_at(ed, leaves[0], r.x, r.y + r.h / 2)
    assert(!zoned, "nothing is offered")
    sp_drag(mut ed, 2, r.x, r.y + r.h / 2, r.x, r.y + r.h / 2)
    assert(edit.pane_leaf_count(ed, ed.pane_root) == edit.PANE_MAX_LEAVES, "unchanged")
    assert(ed.mouse.phase == edit.MP_IDLE, "idle")
}

// `test_mouse_tab_spawn_is_refused_when_the_pane_is_too_small`
// (`:3112-3143`).
fn t_tab_spawn_is_refused_when_the_pane_is_too_small() {
    var ed = sp_fixture_sized(8, edit.PANE_MIN_W * 2)
    let root = ed.pane_root
    let r = copy ed.panes[root].rect
    assert(r.w < edit.PANE_MIN_W * 2 + 1, "too narrow")
    assert(r.h < edit.PANE_MIN_H * 2 + 1, "too short")
    var y = r.y
    while y < r.y + r.h {
        var x = r.x
        while x < r.x + r.w {
            let (zoned, _) = edit.pane_zone_at(ed, root, x, y)
            assert(!zoned, "no zone at {x},{y}")
            x += 1
        }
        y += 1
    }
    assert(edit.strip_slot_count(ed) > 0, "a slot")
    sp_drag(mut ed, 0, r.x, r.y + r.h - 1, r.x, r.y + r.h - 1)
    assert(edit.pane_leaf_count(ed, ed.pane_root) == 1, "no split")
    assert(ed.panes[ed.pane_root].is_leaf, "a leaf")
}

// `test_mouse_drag_affordance_shows_where_the_pane_lands` (`:3145-3209`):
// the affordance is the RELEASE'S OWN ANSWER, painted.
fn t_drag_affordance_shows_where_the_pane_lands() {
    var side = 0
    while side <= 2 {
        var ed = sp_fixture()
        let r = copy ed.panes[ed.pane_root].rect
        var x = r.x
        var y = r.y + r.h / 2
        if side == 1 {
            x = r.x + r.w - 1
        } else if side == 2 {
            x = r.x + r.w / 2
            y = r.y + r.h - 1
        }
        let px = sp_slot_x(ed, 2)
        edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, px, ed.tab_strip_rect.y))
        edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_REPEAT, x, y))
        edit.draw_panes(mut ed)
        let shown = edit.draw_spawn_zone_rect(ed)
        assert(shown.w > 0 && shown.h > 0, "side {side}: drawn")
        assert(shown.x >= r.x && shown.x + shown.w <= r.x + r.w, "side {side}: inside, across")
        assert(shown.y >= r.y && shown.y + shown.h <= r.y + r.h, "side {side}: inside, down")
        assert(edit.region_hit(mut ed.regions, shown.x, shown.y).kind == edit.REGION_PANE, "side {side}: NEVER REGISTERED")
        ed.now_ms += 5000
        edit.draw_panes(mut ed)
        assert(rect_eq(edit.draw_spawn_zone_rect(ed), shown), "side {side}: the clock changes nothing")
        edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, x, y))
        let root = ed.pane_root
        assert(edit.pane_leaf_count(ed, root) == 2, "side {side}: spawned")
        let nu = if side == 0 then ed.panes[root].a else ed.panes[root].b
        edit.ed_layout(mut ed)
        assert(rect_eq(ed.panes[nu].rect, shown), "side {side}: the highlight was the new pane")
        edit.draw_panes(mut ed)
        assert(edit.draw_spawn_zone_rect(ed).w == 0, "side {side}: gone with the gesture")
        side += 1
    }
}

// `test_mouse_drag_affordance_is_absent_without_a_zone` (`:3211-3258`).
fn t_drag_affordance_is_absent_without_a_zone() {
    var ed = sp_fixture()
    let r = copy ed.panes[ed.pane_root].rect
    let depth = edit.pane_zone_depth(r.w)
    let px = sp_slot_x(ed, 2)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, px, ed.tab_strip_rect.y))
    var at = ev(term.MB_LEFT, term.KEY_REPEAT, r.x + depth, r.y + r.h / 2)
    edit.mouse_event(mut ed, at)
    edit.draw_panes(mut ed)
    assert(edit.draw_spawn_zone_rect(ed).w == 0, "the interior: nothing")
    at.col = r.x + depth - 1
    edit.mouse_event(mut ed, at)
    edit.draw_panes(mut ed)
    assert(edit.draw_spawn_zone_rect(ed).w > 0, "one cell back out: the band")
    var small = sp_fixture_sized(8, edit.PANE_MIN_W * 2)
    let sr = copy small.panes[small.pane_root].rect
    let sx = sp_slot_x(small, 0)
    edit.mouse_event(mut small, ev(term.MB_LEFT, term.KEY_PRESS, sx, small.tab_strip_rect.y))
    edit.mouse_event(mut small, ev(term.MB_LEFT, term.KEY_REPEAT, sr.x, sr.y + sr.h - 1))
    edit.draw_panes(mut small)
    assert(edit.draw_spawn_zone_rect(small).w == 0, "too small: nothing anywhere")
}

// `test_mouse_group_drag_shows_no_spawn_affordance` (`:3260-3315`).
fn t_group_drag_shows_no_spawn_affordance() {
    var ed = sp_fixture()
    let g = edit.group_create(mut ed, "/tmp", "")
    assert(g != 0, "a group")
    edit.group_add_member(mut ed, g, 3)
    edit.group_add_member(mut ed, g, 4)
    edit.tab_switch(mut ed, 0)
    edit.ed_layout(mut ed)
    edit.draw_panes(mut ed)
    let r = copy ed.panes[ed.pane_root].rect
    var slot = -1
    var x = 0
    while x < ed.grid.cols {
        let s = edit.strip_slot_at(ed, x, ed.tab_strip_rect.y)
        if s >= 0 {
            let (ok, payload) = edit.strip_pre_payload(ed, s)
            if ok && payload < 0 {
                slot = s
                break
            }
        }
        x += 1
    }
    assert(slot >= 0, "the group's slot")
    let px = sp_slot_x(ed, slot)
    let ex = r.x + r.w - 1
    let ey = r.y + r.h / 2
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, px, ed.tab_strip_rect.y))
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_REPEAT, ex, ey))
    assert(ed.mouse.phase == edit.MP_DRAG_GROUP, "carrying a group")
    edit.draw_panes(mut ed)
    assert(edit.draw_spawn_zone_rect(ed).w == 0, "no affordance")
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, ex, ey))
    assert(edit.pane_leaf_count(ed, ed.pane_root) == 1, "no split")
}

// `test_mouse_hover_without_a_button_is_not_an_event` (`:891-956`).
fn t_hover_without_a_button_is_not_an_event() {
    var inp = term.input_new(term.caps_new())
    var key = term.key_new()
    let motion = bytes_of("\x1b[<35;10;5M")
    term.input_feed(mut inp, motion, 0, motion.len)
    assert(term.input_next(mut inp, 0, mut key), "decoded")
    assert(key.kind == term.EV_MOUSE, "a mouse event")
    assert(key.button == term.MB_NONE, "no button")
    assert(key.ev == term.KEY_REPEAT, "a motion")
    assert(key.col == 9 && key.row == 4, "0-based")
    assert(key.mods == 0, "no modifiers")
    let held = bytes_of("\x1b[<32;10;5M")
    term.input_feed(mut inp, held, 0, held.len)
    assert(term.input_next(mut inp, 0, mut key), "decoded")
    assert(key.kind == term.EV_MOUSE && key.button == term.MB_LEFT && key.ev == term.KEY_REPEAT, "a held motion")
    var ed = fixture()
    fill_lines(mut ed, 20)
    edit.ed_layout(mut ed)
    let leaf = table_root(mut ed)
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.panes[ed.pane_root].rect, leaf)
    ed.full_damage = false
    ed.layout_dirty = false
    let before = cursor_pos(ed)
    assert(!edit.ctx_active(ed.ctx), "no menu")
    let r = copy ed.panes[ed.pane_root].rect
    var hover = ev(term.MB_NONE, term.KEY_REPEAT, r.x + 5, r.y + 5)
    edit.mouse_event(mut ed, hover)
    hover.mods = term.MOD_CTRL
    edit.mouse_event(mut ed, hover)
    assert(ed.mouse.phase == edit.MP_IDLE, "no gesture")
    assert(cursor_pos(ed) == before, "no cursor motion")
    assert(!ed.full_damage && !ed.layout_dirty, "no damage")
    assert(!edit.ctx_active(ed.ctx), "still no menu")
}

// Whether `name` is a source file the dispatch scan reads: the program's
// `.lu` files, not its tests.
fn is_program_source(name: str) -> bool {
    name.ends_with(".lu") && !name.ends_with("_test.lu")
}

// `test_mouse_the_router_is_the_only_dispatch_site` (`:958-1053`): DoD 2,
// over the port's tree — the decoder (`term/input.lu`) produces mouse
// events, the router (`edit/mouse.lu`) consumes them, and the ONE legal
// mention elsewhere is the loop's hand-off.
fn t_the_router_is_the_only_dispatch_site() {
    let dirs = ["src", "src/edit", "src/term", "src/text", "src/search", "src/ws", "src/util", "src/unicode"]
    var handoffs = 0
    for d in dirs {
        let names = fs_read_dir(d) else {
            continue
        }
        for n in names {
            if !is_program_source(n) {
                continue
            }
            let path = "{d}/{n}"
            if path == "src/term/input.lu" || path == "src/edit/mouse.lu" {
                continue
            }
            let text_ = fs_read_text(path) else {
                continue
            }
            for line in text_.lines() {
                if !line.contains("EV_MOUSE") {
                    continue
                }
                assert(path == "src/edit/loop.lu", "a second dispatch route in {path}: {line}")
                assert(line.contains("key.kind == term.EV_MOUSE"), "the loop's hand-off: {line}")
                handoffs += 1
            }
        }
    }
    assert(handoffs == 1, "exactly one hand-off, found {handoffs}")
}

// `test_mouse_context_at_names_every_region_kind` (`:1281-1370`): ONE
// PURE FUNCTION, asked directly.
fn t_context_at_names_every_region_kind() {
    var ed = fixture()
    assert(edit.tab_open(mut ed, "/tmp/yew-mouse-ctx0.txt") >= 0, "open 0")
    assert(edit.tab_open(mut ed, "/tmp/yew-mouse-ctx1.txt") >= 0, "open 1")
    let tab_id = ed.tabs[1].tab_id
    let g = edit.group_create(mut ed, "/src", "")
    let leaf = table_root(mut ed)
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_PANE, edit.rect(0, 2, 40, 10), leaf)
    edit.region_add(mut ed.regions, edit.REGION_PANE_BORDER, edit.rect(40, 2, 1, 10), 0)
    edit.region_add(mut ed.regions, edit.REGION_TAB, edit.rect(0, 0, 8, 1), 1)
    edit.region_add(mut ed.regions, edit.REGION_TAB, edit.rect(8, 0, 8, 1), -g)
    edit.region_add(mut ed.regions, edit.REGION_TAB_SCROLL, edit.rect(16, 0, 2, 1), 1)
    edit.region_add(mut ed.regions, edit.REGION_TAB_NEW, edit.rect(18, 0, 3, 1), 0)
    edit.region_add(mut ed.regions, edit.REGION_FUSS_ROW, edit.rect(41, 2, 20, 1), 7)
    edit.region_add(mut ed.regions, edit.REGION_PICK_ROW, edit.rect(41, 3, 20, 1), 42)
    edit.region_add(mut ed.regions, edit.REGION_COMPL_ROW, edit.rect(41, 4, 20, 1), 5)
    edit.region_add(mut ed.regions, edit.REGION_GP_ROW, edit.rect(41, 5, 20, 1), 2)
    edit.region_add(mut ed.regions, edit.REGION_GP_NAME, edit.rect(41, 6, 20, 1), 0)
    edit.region_add(mut ed.regions, edit.REGION_BLOCK, edit.rect(41, 7, 20, 1), 0)
    let doc = edit.mouse_context_at(mut ed, 5, 5)
    assert(doc.kind == edit.CTX_KIND_DOC, "DOC")
    assert(doc.id == leaf, "the LEAF INDEX")
    assert(edit.mouse_context_at(mut ed, 40, 5).kind == edit.CTX_KIND_BORDER, "BORDER")
    let tab = edit.mouse_context_at(mut ed, 2, 0)
    assert(tab.kind == edit.CTX_KIND_TAB, "TAB")
    assert(tab.id == tab_id, "IDENTITY, not the payload index")
    let grp = edit.mouse_context_at(mut ed, 10, 0)
    assert(grp.kind == edit.CTX_KIND_GROUP, "GROUP")
    assert(grp.id == g, "the gid")
    assert(edit.mouse_context_at(mut ed, 17, 0).kind == edit.CTX_KIND_STRIP, "chevron: STRIP")
    assert(edit.mouse_context_at(mut ed, 19, 0).kind == edit.CTX_KIND_STRIP, "+: STRIP")
    // F mode is not up: an UNKNOWN row is the drawer.
    assert(edit.mouse_context_at(mut ed, 45, 2).kind == edit.CTX_KIND_FUSS_BLANK, "FUSS_BLANK")
    let pick = edit.mouse_context_at(mut ed, 45, 3)
    assert(pick.kind == edit.CTX_KIND_PICK_ROW, "PICK_ROW")
    assert(pick.payload == 42, "the item payload")
    assert(edit.mouse_context_at(mut ed, 45, 4).kind == edit.CTX_KIND_COMPL_ROW, "COMPL_ROW")
    assert(edit.mouse_context_at(mut ed, 45, 5).kind == edit.CTX_KIND_GP_ROW, "GP_ROW")
    assert(edit.mouse_context_at(mut ed, 45, 6).kind == edit.CTX_KIND_GP, "GP")
    assert(edit.mouse_context_at(mut ed, 45, 7).kind == edit.CTX_KIND_EDITOR, "an unowned BLOCK: EDITOR")
    // C's last four lines open the floating panel over the BLOCK
    // (`ed.win->panel`, Sprint 47): yw11's.
    say("SKIP: mouse_context_at_names_every_region_kind: the PANEL half (ed.win->panel, Sprint 47's floating panel): yw11")
}

// `test_mouse_context_at_falls_through_to_geometry` (`:1372-1410`).
fn t_context_at_falls_through_to_geometry() {
    var ed = fixture()
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_BLOCK, edit.rect(79, 23, 1, 1), 0)
    assert(ed.footer_rect.h != 0, "a footer")
    assert(edit.mouse_context_at(mut ed, ed.footer_rect.x, ed.footer_rect.y).kind == edit.CTX_KIND_FOOTER, "FOOTER")
    assert(ed.tab_strip_rect.h != 0, "a strip")
    assert(edit.mouse_context_at(mut ed, ed.tab_strip_rect.x, ed.tab_strip_rect.y).kind == edit.CTX_KIND_STRIP, "STRIP")
    assert(edit.mouse_context_at(mut ed, 40, 10).kind == edit.CTX_KIND_EDITOR, "EDITOR")
    // C asserts `!yew_fuss_active` here: F mode cannot be up before yw13,
    // so the drawer claims no cell.
    assert(edit.mouse_context_at(mut ed, 1, 10).kind == edit.CTX_KIND_EDITOR, "no drawer: EDITOR")
}

// `test_mouse_ctrl_left_opens_a_menu_and_never_arms` (`:1412-1455`).
fn t_ctrl_left_opens_a_menu_and_never_arms() {
    var ed = fixture()
    fill_lines(mut ed, 20)
    edit.ed_layout(mut ed)
    let leaf = table_root(mut ed)
    frame_pane(mut ed, ed.pane_root, leaf)
    let before = cursor_pos(ed)
    let r = copy ed.panes[ed.pane_root].rect
    var press = ev(term.MB_LEFT, term.KEY_PRESS, r.x + 4, r.y + 3)
    var motion = ev(term.MB_LEFT, term.KEY_REPEAT, r.x + 9, r.y + 5)
    press.mods = term.MOD_CTRL
    motion.mods = term.MOD_CTRL
    edit.mouse_event(mut ed, press)
    assert(edit.ctx_active(ed.ctx), "a menu")
    assert(edit.ctx_kind(ed.ctx) == edit.CTX_KIND_DOC, "the document's")
    assert(ed.mouse.phase == edit.MP_IDLE, "never armed")
    assert(ed.mouse.held == 0, "nothing held")
    edit.mouse_event(mut ed, motion)
    assert(ed.mouse.phase == edit.MP_IDLE, "no drag follows")
    assert(ed.mode == edit.MODE_L, "the mode untouched")
    assert(cursor_pos(ed) == before, "the cursor untouched")
}

// `test_mouse_right_press_on_an_open_menu_only_closes_it` (`:1457-1500`).
fn t_right_press_on_an_open_menu_only_closes_it() {
    var ed = fixture()
    let leaf = table_root(mut ed)
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.panes[ed.pane_root].rect, leaf)
    edit.region_add(mut ed.regions, edit.REGION_TAB, edit.rect(0, 0, 8, 1), 0)
    edit.mouse_event(mut ed, ev(term.MB_RIGHT, term.KEY_PRESS, 10, 5))
    assert(edit.ctx_active(ed.ctx), "a menu")
    let box = edit.ctx_box(ed.ctx)
    edit.mouse_menu_draw(mut ed)
    edit.mouse_event(mut ed, ev(term.MB_RIGHT, term.KEY_PRESS, box.x + 1, box.y + 1))
    assert(!edit.ctx_active(ed.ctx), "dismissed")
    assert(!motion_active(ed), "1003 down")
    edit.mouse_event(mut ed, ev(term.MB_RIGHT, term.KEY_PRESS, 10, 5))
    assert(edit.ctx_active(ed.ctx), "open")
    edit.mouse_event(mut ed, ev(term.MB_RIGHT, term.KEY_PRESS, 2, 0))
    assert(edit.ctx_active(ed.ctx), "closed AND reopened")
    assert(edit.ctx_kind(ed.ctx) == edit.CTX_KIND_TAB, "for what is there")
}

// `test_mouse_wheel_closes_the_menu_then_scrolls` (`:1502-1545`).
fn t_wheel_closes_the_menu_then_scrolls() {
    var ed = fixture()
    fill_lines(mut ed, 200)
    edit.ed_layout(mut ed)
    let leaf = table_root(mut ed)
    frame_pane(mut ed, ed.pane_root, leaf)
    let r = copy ed.panes[ed.pane_root].rect
    edit.mouse_event(mut ed, ev(term.MB_RIGHT, term.KEY_PRESS, r.x + 2, r.y + 2))
    assert(edit.ctx_active(ed.ctx), "a menu")
    assert(motion_active(ed), "1003 armed")
    let top_before = ed.wins[ed.win].vp.top
    edit.mouse_event(mut ed, wheel(term.MB_WHEEL_UP, r.x + 2, r.y + 6, 0))
    assert(!edit.ctx_active(ed.ctx), "closed")
    assert(!motion_active(ed), "1003 down")
    assert(top_before >= edit.WHEEL_ROWS, "room to scroll up: {top_before}")
    assert(ed.wins[ed.win].vp.top == top_before - edit.WHEEL_ROWS, "AND scrolled")
}

// `test_mouse_hover_repaints_only_when_the_row_changes` (`:1547-1606`).
fn t_hover_repaints_only_when_the_row_changes() {
    var ed = fixture()
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_TAB, edit.rect(0, 0, 8, 1), 0)
    assert(edit.tab_open(mut ed, "/tmp/yew-mouse-hover.txt") >= 0, "open")
    edit.mouse_event(mut ed, ev(term.MB_RIGHT, term.KEY_PRESS, 2, 0))
    assert(edit.ctx_active(ed.ctx), "a menu")
    edit.mouse_menu_draw(mut ed)
    let box = edit.ctx_box(ed.ctx)
    ed.full_damage = false
    ed.overlay_dirty = false
    var marks = 0
    var i = 0
    while i < 20 {
        edit.mouse_event(mut ed, ev(term.MB_NONE, term.KEY_REPEAT, box.x + 1 + i % 3, box.y + 1))
        if ed.overlay_dirty {
            marks += 1
            ed.overlay_dirty = false
        }
        i += 1
    }
    assert(marks == 0, "row 0 already has the highlight")
    assert(!ed.full_damage, "no full repaint")
    i = 0
    while i < 20 {
        edit.mouse_event(mut ed, ev(term.MB_NONE, term.KEY_REPEAT, box.x + 1, box.y + 2))
        if ed.overlay_dirty {
            marks += 1
            ed.overlay_dirty = false
        }
        i += 1
    }
    assert(marks == 1, "once for row 1: {marks}")
    assert(edit.ctx_cursor(ed.ctx) == 1, "the highlight moved")
    assert(!ed.full_damage, "a MENU repaint, not a pane one")
}

// `test_mouse_motion_tracking_mirrors_the_open_menu` (`:1608-1720`).
fn t_motion_tracking_mirrors_the_open_menu() {
    var ed = fixture()
    let leaf = table_root(mut ed)
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.panes[ed.pane_root].rect, leaf)
    term.tty_mouse_motion(mut ed.tty, false)
    assert(!motion_active(ed), "disarmed")
    // Opened by pointer, closed by Esc.
    edit.mouse_event(mut ed, ev(term.MB_RIGHT, term.KEY_PRESS, 10, 5))
    assert(motion_active(ed), "armed")
    assert(edit.mouse_menu_key(mut ed, esc_key()), "Esc taken")
    assert(!edit.ctx_active(ed.ctx), "closed")
    assert(!motion_active(ed), "down")
    // Closed by a left press outside the box.
    edit.mouse_event(mut ed, ev(term.MB_RIGHT, term.KEY_PRESS, 10, 5))
    assert(motion_active(ed), "armed")
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.panes[ed.pane_root].rect, leaf)
    edit.mouse_menu_draw(mut ed)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, 60, 5))
    assert(ed.mouse.phase == edit.MP_ARMED, "the pane press reached the phase machine")
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, 60, 5))
    assert(!edit.ctx_active(ed.ctx), "closed")
    assert(!motion_active(ed), "down")
    assert(ed.mouse.phase == edit.MP_IDLE, "idle")
    // Closed by `ed.mouse.disable`.
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.panes[ed.pane_root].rect, leaf)
    edit.mouse_event(mut ed, ev(term.MB_RIGHT, term.KEY_PRESS, 10, 5))
    assert(motion_active(ed), "armed")
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    cx.count = 1
    assert(edit.mouse_cmd_disable(mut ed, cx) == edit.CMD_OK, "disabled")
    assert(!edit.ctx_active(ed.ctx), "closed")
    assert(!motion_active(ed), "down")
    // A keyboard menu with the mouse off stays keyboard-only.
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_PANE, copy ed.panes[ed.pane_root].rect, leaf)
    cx.iarg = 0
    assert(edit.ui_cmd_context_menu(mut ed, cx) == edit.CMD_OK, "the keyboard menu")
    assert(edit.ctx_active(ed.ctx), "open")
    assert(!motion_active(ed), "and 1003 untouched")
    assert(edit.mouse_menu_key(mut ed, esc_key()), "Esc")
    assert(!edit.ctx_active(ed.ctx), "closed")
    assert(!motion_active(ed), "down")
    edit.mouse_set_enabled(mut ed, true)
}

// `test_mouse_pointer_menu_origin_tracks_the_click_cell` (`:1722-1748`).
fn t_pointer_menu_origin_tracks_the_click_cell() {
    var ed = fixture()
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_TAB, edit.rect(20, 0, 10, 1), 0)
    var press = ev(term.MB_LEFT, term.KEY_PRESS, 22, 0)
    press.mods = term.MOD_CTRL
    edit.mouse_event(mut ed, press)
    assert(edit.ctx_active(ed.ctx), "a menu")
    let box = edit.ctx_box(ed.ctx)
    assert(box.x == 22 && box.y == 0, "the click cell is the corner: {box.x},{box.y}")
    assert(edit.mouse_menu_key(mut ed, esc_key()), "Esc")
}

// `test_mouse_menu_targets_switch_enter_and_focus` (`:1750-1817`).
fn t_menu_targets_switch_enter_and_focus() {
    var ed = fixture()
    open_tabs(mut ed, "yew-mouse-t", 3)
    let target = ed.tabs[3].tab_id
    edit.tab_switch(mut ed, 0)
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_TAB, edit.rect(20, 0, 10, 1), 3)
    edit.mouse_event(mut ed, ev(term.MB_RIGHT, term.KEY_PRESS, 22, 0))
    assert(edit.ctx_active(ed.ctx), "a tab menu")
    // Row 0 is Close Tab.
    assert(edit.mouse_menu_key(mut ed, enter_key()), "Enter")
    assert(edit.tab_index_of_id(ed, target) == -1, "CTX_TGT_TAB: the captured tab closed")
    assert(!motion_active(ed), "1003 down")
    let g = edit.group_create(mut ed, "/src", "")
    edit.group_add_member(mut ed, g, 1)
    assert(edit.active_group_id(ed) == 0, "outside")
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_TAB, edit.rect(0, 0, 8, 1), -g)
    edit.mouse_event(mut ed, ev(term.MB_RIGHT, term.KEY_PRESS, 2, 0))
    assert(edit.ctx_kind(ed.ctx) == edit.CTX_KIND_GROUP, "a group menu")
    // Row 0 is Edit Group..., which opens the group picker.
    assert(edit.mouse_menu_key(mut ed, enter_key()), "Enter")
    assert(edit.active_group_id(ed) == g, "CTX_TGT_GROUP: entered first")
    if edit.gp_active(ed) {
        edit.gp_close(mut ed)
    }
}

// `test_mouse_menu_leaf_target_keeps_the_selection` (`:1819-1890`).
fn t_menu_leaf_target_keeps_the_selection() {
    var ed = fixture()
    fill_lines(mut ed, 8)
    edit.ed_layout(mut ed)
    let leaf = table_root(mut ed)
    frame_pane(mut ed, ed.pane_root, leaf)
    assert(edit.mode_enter_highlight(mut ed, edit.MODE_I, false) == edit.CMD_OK, "H")
    let w = ed.win
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].anchor = 0
    ed.wins[w].cs.curs[p].pos = 4
    let r = copy ed.panes[ed.pane_root].rect
    edit.mouse_event(mut ed, ev(term.MB_RIGHT, term.KEY_PRESS, r.x + 8, r.y + 5))
    assert(edit.ctx_active(ed.ctx), "a menu")
    var found = false
    var row = 0
    while row < edit.ctx_rows(ed.ctx) {
        if edit.ctx_row_label(ed.ctx, row) == "Copy" {
            assert(edit.ctx_row_enabled(ed.ctx, row), "Copy is enabled")
            edit.ctx_hover(mut ed.ctx, row)
            found = true
            break
        }
        row += 1
    }
    assert(found, "a Copy row")
    assert(edit.mouse_menu_key(mut ed, enter_key()), "Enter")
    assert(!edit.region_frozen(ed.regions), "thawed")
    let p2 = ed.wins[ed.win].cs.primary
    assert(ed.wins[ed.win].cs.curs[p2].anchor == 0, "the caret where the selection left it")
    let v = text.reg_get(mut ed.regs, '+' as int) else {
        assert(false, "the + register")
        return
    }
    assert(v.bytes.len == 4, "four bytes: {v.bytes.len}")
    assert(v.bytes[0] as int == 'l' as int && v.bytes[3] as int == 'e' as int, "line")
}

// `test_mouse_menu_path_target_carries_the_captured_path`
// (`:1964-2003`): a FUSS file row (Sprint 52), yw13's. RED by
// name: the builder's own refusal, exactly, and nothing opens.
fn t_menu_path_target_carries_the_captured_path() {
    var ed = fixture()
    let c = edit.ctxcontext_new(edit.CTX_KIND_FUSS_FILE, 1)
    edit.ctx_build(mut ed, c)
    assert(ed.msg.active && ed.msg.text.contains("not yet ported") && ed.msg.text.contains("(yw13)"), "the named refusal: {ed.msg.text}")
    say("RED mouse_menu_path_target_carries_the_captured_path: FUSS rows are yw13's (R-yw06-4 = A): {ed.msg.text}")
}

// `test_mouse_gp_rows_reach_the_group_picker` (`:1142-1182`).
fn t_gp_rows_reach_the_group_picker() {
    var ed = fixture()
    assert(edit.gp_show(mut ed, "/tmp"), "the group picker")
    assert(edit.gp_active(ed), "up")
    edit.region_frame_begin(mut ed.regions)
    edit.gp_draw(mut ed)
    var found = false
    var y = 0
    while y < 24 && !found {
        let hit = edit.region_hit(mut ed.regions, 20, y)
        if hit.kind == edit.REGION_GP_ROW {
            found = true
            edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, 20, y))
            assert(edit.gp_active(ed), "the press reached it, still up")
            edit.mouse_event(mut ed, wheel(term.MB_WHEEL_DOWN, 20, y, 0))
            assert(edit.gp_active(ed), "the wheel is claimed too")
        }
        y += 1
    }
    assert(found, "a GP_ROW")
    edit.gp_close(mut ed)
}

// `test_mouse_ctx_row_highlights_then_invokes` (`:1184-1240`).
fn t_ctx_row_highlights_then_invokes() {
    var ed = fixture()
    open_tabs(mut ed, "yew-mouse-x", 3)
    edit.tab_switch(mut ed, 1)
    let target = ed.tabs[1].tab_id
    edit.ed_layout(mut ed)
    assert(edit.mouse_open_tab_menu(mut ed, target, 0, 2), "a tab menu")
    edit.region_frame_begin(mut ed.regions)
    edit.mouse_menu_draw(mut ed)
    let box = edit.ctx_box(ed.ctx)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, box.x + 1, box.y + 4))
    assert(edit.ctx_cursor(ed.ctx) == 3, "row 3, Copy Path, highlighted")
    assert(edit.ctx_active(ed.ctx), "up")
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, box.x + 1, box.y + 1))
    assert(edit.ctx_active(ed.ctx), "released on row 0: nothing invoked")
    let box2 = edit.ctx_box(ed.ctx)
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_PRESS, box2.x + 1, box2.y + 4))
    edit.mouse_event(mut ed, ev(term.MB_LEFT, term.KEY_RELEASE, box2.x + 2, box2.y + 4))
    assert(!edit.ctx_active(ed.ctx), "the row ran")
    let v = text.reg_get(mut ed.regs, '+' as int) else {
        assert(false, "the + register")
        return
    }
    assert(v.bytes.len != 0, "the path copied")
}

fn want(chosen: int, n: int) -> bool {
    chosen < 0 || chosen == n
}

fn main() {
    let chosen = (env_get("YEW_MOUSE_CASE") else "-1").to_int() else -1
    var skips = 0
    var reds = 0
    if want(chosen, 0) {
        t_press_arms_and_does_not_drag()
        print("mouse_press_arms_and_does_not_drag: PASS")
    }
    if want(chosen, 1) {
        t_new_tab_control_invokes_the_named_command_once()
        print("mouse_new_tab_control_invokes_the_named_command_once: PASS")
    }
    if want(chosen, 2) {
        t_new_tab_control_cancels_off_region_and_drag()
        print("mouse_new_tab_control_cancels_off_region_and_drag: PASS")
    }
    if want(chosen, 3) {
