//! member: false
//!
//! git_status_dump — yw13's port half of the porcelain differential
//! (`notes/yw13-evidence/porcelain-diff/`): stdin, one `git status
//! --porcelain=v2 --branch -z` stream, through `git.git_parse_status`,
//! printed in exactly the line format `cdump.c` prints for sagitta's
//! parser. Paths are hex, so non-UTF-8 bytes compare exactly. A tool, not
//! a test: `run.sh` diffs the two dumps over real repositories.

use git
use std.fs

fn hex_into(mut out: List[byte], b: List[byte]) {
    let digits = "0123456789abcdef".bytes()
    for x in b {
        let v = x as int
        (mut out).push(digits[v / 16])
        (mut out).push(digits[v % 16])
    }
}

fn hex_or(b: List[byte], present: bool) -> str {
    if !present {
        return "-"
    }
    if b.len == 0 {
        return "="
    }
    var out = List[byte]()
    hex_into(mut out, b)
    str_from_utf8(out) else ""
}

fn bit(v: bool) -> str {
    if v then "1" else "0"
}

fn main() -> int {
    var input = fs.stdin()
    var buf = List[byte]()
    var done = false
    while !done {
        let chunk = fs.read_chunk(mut input, 65536) else |_| {
            done = true
            List[byte]()
        }
        for x in chunk {
            (mut buf).push(x)
        }
    }
    var snap = git.git_snapshot_new()
    var err = git.git_parse_err()
    let ok = git.git_parse_status(mut snap, buf, buf.len, mut err)
    print("ok {bit(ok)}")
    if !ok {
        print("err {err.off} {err.message}")
        return 0
    }
    print("state {snap.state}")
    print("branch {hex_or(git.git_snap_branch(snap), snap.has_branch)}")
    print("upstream {hex_or(git.git_snap_upstream(snap), snap.has_upstream)}")
    print("head {hex_or(git.git_snap_head(snap).bytes(), snap.has_head_oid)}")
    print("ab {snap.ahead} {snap.behind}")
    print(
        "flags detached={bit(snap.detached)} unborn={bit(snap.unborn)} conflicted={bit(snap.conflicted)}",
    )
    var i = 0
    while i < snap.entries.len {
        let e = copy snap.entries[i]
        let xy = str_from_utf8([e.x as byte, e.y as byte]) else "??"
        let path = hex_or(git.git_snap_path(snap, i), true)
        let orig = hex_or(git.git_snap_orig(snap, i), e.has_orig)
        let oid = git.git_snap_oid(snap, i)
        let flags = "{bit(e.is_dir)}{bit(e.submodule)}{bit(e.staged)}{bit(e.unstaged)}{bit(e.untracked)}{bit(e.conflicted)}"
        print(
            "entry {e.kind} {xy} {path} {orig} {e.score} {if oid.len == 0 then "-" else oid} {flags}",
        )
        i += 1
    }
    i = 0
    while i < snap.ignored.rows.len {
        let p = hex_or(git.git_paths_bytes(snap.ignored, i), true)
        print("ignored {p} {bit(snap.ignored.rows[i].is_dir)}")
        i += 1
    }
    0
}
