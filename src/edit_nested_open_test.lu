//! member: false
//! yw19 (yew#129): `:!yew PATH` opens in the running editor or is refused
//! by name, and the workspace state a resume reads and writes parses
//! whole. Not a port: sagitta's `test_shell_self.c` and `test_ws_save.c`
//! hold C's shape (`edit_shell_self_test.lu`, `edit_ws_save_test.lu`);
//! these cases hold what yw19 changed on top of it. One case per run under
//! `YEW_NESTED_CASE` (every case when unset). `$SHELL` is a path that does
//! not exist, so a line the editor hands to a shell becomes one job that
//! failed to start, and no process runs. The owner-lock cases start one
//! `sleep` child of their own, signal only it, and SKIP by name where the
//! machine cannot start one (the checked machine).

use std.process
use args
use edit
use term
use text
use util
use ws

struct Fix {
    root: str,
    work: str,
    saved_state: str,
    had_state: bool,
    saved_shell: str,
    had_shell: bool,
}

fn fixture() -> Fix {
    let saved_state = env_get("XDG_STATE_HOME") else ""
    let saved_shell = env_get("SHELL") else ""
    assert(util.mkdirs("target/nested-open-fixtures", 448))
    var root = ""
    loop {
        var suffix = ""
        for r in os_random(8) { suffix = "{suffix}{r % 10}" }
        root = "target/nested-open-fixtures/{suffix}"
        fs_create_dir_mode(root, 448) else |e| match e {
            exists => { continue },
            _ => { assert(false, "mkdir fixture: {e}") },
        }
        break
    }
    root = fs_realpath(root) else {
        assert(false)
        return Fix {
            root: "",
            work: "",
            saved_state: "",
            had_state: false,
            saved_shell: "",
            had_shell: false,
        }
    }
    let work = "{root}/work"
    assert(util.mkdirs(work, 448))
    env_set("XDG_STATE_HOME", "{root}/state") else { assert(false) }
    env_set("YEW_LOG", "{root}/yew.log") else { assert(false) }
    env_set("SHELL", "{root}/no-such-shell/sh") else { assert(false) }
    Fix {
        root: root,
        work: work,
        saved_state: saved_state,
        had_state: saved_state.len != 0,
        saved_shell: saved_shell,
        had_shell: saved_shell.len != 0,
    }
}

fn remove_tree(path: str) {
    let entries = fs_read_dir(path) else { return }
    for name in entries {
        let p = "{path}/{name}"
        fs_remove(p) else |_| {
            remove_tree(p)
            fs_remove_dir(p) else { assert(false, "remove dir {p}") }
        }
    }
}

fn finish(f: Fix) {
    if f.had_state {
        env_set("XDG_STATE_HOME", f.saved_state) else { assert(false) }
    } else {
        env_unset("XDG_STATE_HOME") else { assert(false) }
    }
    if f.had_shell {
        env_set("SHELL", f.saved_shell) else { assert(false) }
    } else {
        env_unset("SHELL") else { assert(false) }
    }
    env_unset("YEW_LOG") else { assert(false) }
    remove_tree(f.root)
    fs_remove_dir(f.root) else { assert(false) }
}

fn fresh(f: Fix) -> edit.Ed {
    var ed = edit.ed_new()
    assert(edit.ed_set_workspace_root(mut ed, f.work))
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(24, 80)
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    ed
}

fn file(f: Fix, name: str, body: str) -> str {
    let path = "{f.work}/{name}"
    assert(text.file_write_atomic(path, body.bytes(), 384) == text.SAVE_OK)
    path
}

fn active_path(ed: edit.Ed) -> str { ed.tabs[ed.tab_active].path }

// `:LINE` as the registry runs it: the `!` command's argument.
fn bang(mut ed: edit.Ed, line: str) -> int {
    var cx = edit.cmdctx_new(ed.win, edit.SRC_KEY)
    cx.sarg = line
    cx.has_sarg = true
    edit.shc_run(mut ed, cx)
}

fn log_has(sub: str) -> bool { util.log_capture_has(util.LOG_INFO, sub.bytes()) }

fn log_clear(f: Fix) {
    fs_write_bytes("{f.root}/yew.log", "".bytes()) else |e| { assert(false, "clear log: {e}") }
}

// A relative operand is the session's: after `:!cd sub` the shell would
// open `sub/x.lu`, and so does the editor.
fn t_self_open_follows_the_session_directory() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    assert(util.mkdirs("{f.work}/sub", 448))
    let want = file(f, "sub/x.lu", "// sub\n")
    ed.shsession.cwd = "{f.work}/sub"
    ed.shsession.has_cwd = true
    let (r, why) = edit.shell_try_self_open(mut ed, "yew x.lu")
    assert(r == edit.SHELL_SELF_OPENED, why)
    assert(active_path(ed) == want, active_path(ed))
    // With no directory reported, the workspace root, as C resolves it.
    ed.shsession.has_cwd = false
    let root_x = file(f, "x.lu", "// root\n")
    let (r2, _) = edit.shell_try_self_open(mut ed, "yew x.lu")
    assert(r2 == edit.SHELL_SELF_OPENED && active_path(ed) == root_x)
    // `shell.session fresh` keeps no directory: the root again.
    ed.shsession.has_cwd = true
    assert(
        edit.opt_set(
            mut ed,
            edit.OPT_SCOPE_DECLARED,
            "shell.session",
            edit.optv_enum("fresh"),
        ).len ==
            0,
    )
    let (r3, _) = edit.shell_try_self_open(mut ed, "yew x.lu")
    assert(r3 == edit.SHELL_SELF_OPENED && active_path(ed) == root_x)
    assert(ed.jobs.v.len == 0)
}

// Every `:!yew` line that would start an editor and that this editor
// cannot open is refused on the message line by name; nothing runs it.
fn refused(mut ed: edit.Ed, line: str, why: str) {
    let jobs = ed.jobs.v.len
    let tabs = ed.tabs.len
    let rc = bang(mut ed, line)
    assert(rc != edit.CMD_OK, "{line}: ran")
    assert(ed.jobs.v.len == jobs, "{line}: a job ran it")
    assert(ed.tabs.len == tabs, "{line}: a tab opened")
    assert(ed.msg.text.contains("not opened here"), "{line}: message {ed.msg.text}")
    assert(ed.msg.text.contains(why), "{line}: message {ed.msg.text} lacks {why}")
}

fn t_self_open_refuses_by_name() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    assert(util.mkdirs("{f.work}/adir", 448))
    let _ = file(f, "x.lu", "// x\n")
    refused(mut ed, "yew adir", "a directory")
    refused(mut ed, "yew $HOME/x.lu", "the shell would expand")
    refused(mut ed, "yew \"$F\"", "the shell would expand")
    refused(mut ed, "yew *.lu", "the shell would expand")
    refused(mut ed, "yew ~/x.lu", "the shell would expand")
    refused(mut ed, "yew --theme dark x.lu", "an option")
    refused(mut ed, "yew --workspace adir x.lu", "an option")
    refused(mut ed, "yew --clean", "an option")
}

// Several plain operands open here, the last one active, as `yew A B`
// starts an editor.
fn t_self_open_opens_every_plain_operand() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    let a = file(f, "a.lu", "// a\n")
    let b = file(f, "b b.lu", "// b\n")
    let before = ed.tabs.len
    assert(bang(mut ed, "yew a.lu 'b b.lu'") == edit.CMD_OK)
    assert(ed.tabs.len == before + 2)
    assert(edit.tab_find_by_path(ed, a) >= 0 && active_path(ed) == b)
    assert(ed.jobs.v.len == 0)
    // A directory among them refuses the whole line: nothing opens.
    assert(util.mkdirs("{f.work}/adir", 448))
    let c = file(f, "c.lu", "// c\n")
    refused(mut ed, "yew c.lu adir", "a directory")
    assert(edit.tab_find_by_path(ed, c) < 0)
}

// What is not an editor start still goes to the shell: a job of its own
// (the session's proxy, labelled with the line) where this machine can
// spawn one (natively: whose shell failed to start), and never a refusal
// or a tab.
fn t_self_open_leaves_other_lines_to_the_shell() {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    let _ = file(f, "note.txt", "note\n")
    let tabs = ed.tabs.len
    for line in [
        "yew --version",
        "yew --help",
        "yew -R x.lu",
        "yew fl run.fl",
        "yew --batch s.fl",
        "yew note.txt | sed -n 1p",
        "yew note.txt; echo done",
        "yew note.txt >out",
        "command yew note.txt",
        "./yew note.txt",
        "yew 'unterminated",
    ] {
        let rc = bang(mut ed, line)
        var ran = false
        for j in ed.jobs.v { if j.label == line { ran = true } }
        print("  {line}: rc {rc}, a job {ran}, tabs {tabs} -> {ed.tabs.len}, message {ed.msg.text}")
        assert(!ed.msg.text.contains("not opened here"), "{line}: refused")
        assert(ed.tabs.len == tabs, "{line}: opened a tab")
        assert(ran || rc != edit.CMD_OK, "{line}: neither a job nor a spawn's refusal")
    }
}

// The untitled tab a resume keeps is written with no path and skipped at
// restore by design (sagitta `state_emit.c:600-605`): not a dropped record.
// A record that names no file is still dropped, and said so.
fn t_untitled_record_is_not_dropped() {
    let f = fixture()
    defer finish(f)
    var a = fresh(f)
    let pa = file(f, "a.txt", "alpha\n")
    assert(edit.tab_open(mut a, pa) == 1)
    edit.tab_switch(mut a, 0)
    let doc = edit.state_emit_at(a, 0)
    log_clear(f)
    var b = fresh(f)
    assert(ws.ws_key(mut b.state.key, f.work) && ws.ws_ensure_dir(mut b.state.key))
    b.state.ready = true
    b.state.writer = true
    assert(edit.state_apply(mut b, doc) == edit.WS_RESTORED)
    assert(b.tabs.len == 2 && b.tabs[1].path == pa)
    assert(!log_has("dropped"), "the untitled record was logged as dropped")
    // A record whose path is "" names nothing: dropped, and logged.
    let text0 = str_from_utf8(doc) else ""
    let broken = text0.replace("path: \"{pa}\"", "path: \"\"")
    log_clear(f)
    var c = fresh(f)
    assert(ws.ws_key(mut c.state.key, f.work) && ws.ws_ensure_dir(mut c.state.key))
    c.state.ready = true
    c.state.writer = true
    let _ = edit.state_apply(mut c, copy broken.bytes())
    assert(log_has("workspace state: 1 tab record(s) dropped"))
}

// `active_tab` is a tab id: whatever is active, it names a written record.
fn ids_of(doc: List[byte]) -> (List[int], int) {
    let t = str_from_utf8(doc) else ""
    var ids = List[int]()
    var active = -1
    var inside = false
    for line in t.lines() {
        if line == "  tabs: [" { inside = true; continue }
        if inside && line == "  ]," { inside = false; continue }
        if inside && line.starts_with("      id: ") {
            (mut ids).push(line[10..line.len - 1].to_int() else -1)
        }
        if line.starts_with("  active_tab: ") {
            active = line[14..line.len - 1].to_int() else -1
        }
    }
    (ids, active)
}

fn names_a_record(doc: List[byte]) -> bool {
    let (ids, active) = ids_of(doc)
    for i in ids { if i == active { return true } }
    false
}

fn t_active_tab_names_a_written_record() {
    let f = fixture()
    defer finish(f)
    var a = fresh(f)
    var i = 0
    while i < 30 {
        assert(edit.tab_open(mut a, file(f, "t{i}.txt", "{i}\n")) > 0)
        i += 1
    }
    for at in [0, 1, 15, 30] {
        edit.tab_switch(mut a, at)
        assert(names_a_record(edit.state_emit_at(a, 0)), "active {at}")
    }
    // Closing tabs never leaves the active id behind.
    while a.tabs.len > 3 {
        let _ = edit.tab_close(mut a, 1)
        assert(names_a_record(edit.state_emit_at(a, 0)), "after a close, {a.tabs.len} tabs")
    }
    // Past the record cap (the tab cap keeps a live editor under it): the
    // active tab beyond the written records is never named.
    var big = fresh(f)
    while big.tabs.len < ws.STATE_MAX_TABS {
        assert(edit.tab_open(mut big, "{f.root}/cap-{big.tabs.len}.txt") >= 0)
    }
    (mut big.tabs).push(copy big.tabs[1])
    big.tabs[big.tabs.len - 1].tab_id = big.next_tab_id
    big.next_tab_id += 1
    big.tab_active = big.tabs.len - 1
    let (ids, active) = ids_of(edit.state_emit_at(big, 0))
    assert(ids.len == ws.STATE_MAX_TABS)
    assert(names_a_record(edit.state_emit_at(big, 0)), "active_tab {active} past {ids.len} records")
    // A document whose active_tab names no record restores its first tab.
    let doc = edit.state_emit_at(a, 0)
    let t = (str_from_utf8(doc) else "").replace("  active_tab: ", "  active_tab: 9999")
    var b = fresh(f)
    assert(ws.ws_key(mut b.state.key, f.work) && ws.ws_ensure_dir(mut b.state.key))
    b.state.ready = true
    b.state.writer = true
    assert(edit.state_apply(mut b, copy t.bytes()) == edit.WS_RESTORED)
    assert(b.tab_active == 1, "restored active {b.tab_active}")
}

// ---- the owner of a workspace's state --------------------------------------

fn key_only(mut ed: edit.Ed) {
    assert(ws.ws_key(mut ed.state.key, ed.ws_dir) && ws.ws_ensure_dir(mut ed.state.key))
}

fn put(path: str, body: str) {
    assert(text.file_write_atomic(path, body.bytes(), 384) == text.SAVE_OK)
}

// A child of this test that is no editor: `sleep`, its pid live.
fn sleeper(name: str) -> process.Child ! {none} {
    let ch = process.start(process.from_argv(["sleep", "60"])) else |e| {
        print("SKIP {name}: cannot start a child here ({e}); the native run covers it")
        return none
    }
    ch
}

fn stop_child(take ch: process.Child) {
    var c = ch
    process.kill(mut c) else |_| {}
    let _ = process.wait_status(take c) else 0
}

// A second session, while the first holds the owner lock, is a reader:
// the kernel's lock says so, even for one pid (two opens of a file
// conflict in one process). Once the first lets go, the next one owns.
fn t_a_held_owner_lock_makes_a_reader() {
    let f = fixture()
    defer finish(f)
    var a = fresh(f)
    edit.state_open(mut a)
    assert(a.state.ready && a.state.writer)
    var b = fresh(f)
    edit.state_open(mut b)
    let b_writer = b.state.writer
    edit.state_dispose(mut b)
    assert(!b_writer, "a second session took the state while the first held it")
    edit.state_dispose(mut a)
    var c = fresh(f)
    edit.state_open(mut c)
    assert(c.state.writer, "the owner lock outlived its session")
    edit.state_dispose(mut c)
}

// A lease and an owner record naming one pid are a session that took the
// owner lock and never let go of the lease (a power-off, `kill -9`): stale,
// though a later process (a reboot's, here `sleep`) holds that pid now.
fn t_a_stale_lease_naming_a_live_pid_is_taken_over() -> bool {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    key_only(mut ed)
    let ch = sleeper("nested_a_stale_lease_naming_a_live_pid_is_taken_over") else { return false }
    let pid = process.pid(ch) else -1
    let lease = ws.ws_lock_path(ed.state.key)
    put(lease, "{pid}\n")
    put("{lease}.owner", "{pid}\n")
    edit.state_open(mut ed)
    let writer = ed.state.writer
    let owner = ed.state.owner_pid
    edit.state_dispose(mut ed)
    stop_child(take ch)
    assert(writer, "pid {pid} (sleep, no editor) kept this session a reader (owner {owner})")
    true
}

// A lease with no owner record is a session from before the owner lock:
// its live pid owns, as C's lease says.
fn t_a_lease_from_before_the_owner_lock_still_owns() -> bool {
    let f = fixture()
    defer finish(f)
    var ed = fresh(f)
    key_only(mut ed)
    let ch = sleeper("nested_a_lease_from_before_the_owner_lock_still_owns") else { return false }
    let pid = process.pid(ch) else -1
    put(ws.ws_lock_path(ed.state.key), "{pid}\n")
    edit.state_open(mut ed)
    let writer = ed.state.writer
    let owner = ed.state.owner_pid
    edit.state_dispose(mut ed)
    stop_child(take ch)
    assert(!writer && owner == pid, "a live pid-only lease ({pid}) lost the state")
    true
}

fn words_of(line: str) -> List[str] {
    var out = List[str]()
    let b = line.bytes()
    var s = 0
    var i = 0
    while i <= b.len {
        if i == b.len || b[i] as int == 32 {
            if i > s { (mut out).push(line[s..i]) }
            s = i + 1
        }
        i += 1
    }
    out
}

// `shell_self_argv_class` (edit's reading, since `edit` does not depend
// on `args`) and `args_parse` (the editor's own) give each spelling one
// answer: the shell's, an editor with an option, or an editor with these
// files.
fn t_self_open_reads_words_as_the_command_line_does() {
    let lines = [
        "x.lu",
        "a b",
        "-",
        "-- x",
        "-- --clean",
        "x --clean",
        "--clean x",
        "--clean",
        "--config c x",
        "--config",
        "--config --clean x",
        "--theme t x",
        "--theme",
        "--no-workspace-config x",
        "--trust-workspace x",
        "--workspace w x",
        "--workspace",
        "--workspace w --workspace v x",
        "--version",
        "--help",
        "--help-cmds",
        "--clean --version",
        "--version --bogus",
        "--batch s",
        "--batch s x",
        "--batch",
        "--test x",
        "--quiet x",
        "--grant a:b x",
        "--grant",
        "--replay a x",
        "--selftest-bug",
        "--batch-strict",
        "--bogus x",
        "-x",
        "",
    ]
    for line in lines {
        let words = words_of(line)
        let (class, files) = edit.shell_self_argv_class(words)
        let (rc, a, _) = args.args_parse(words)
        let shell = rc >= 0 || a.version || a.help || a.help_cmds || a.batch_set || a.selftest_bug
        let option = a.clean ||
            a.config_path.len != 0 ||
            a.theme.len != 0 ||
            a.no_workspace_config ||
            a.trust_workspace ||
            a.workspace_set ||
            a.test ||
            a.quiet ||
            a.replay_reg != 0 ||
            a.grants.len != 0
        let want = if shell {
            edit.SELF_ARGV_SHELL
        } else if option {
            edit.SELF_ARGV_OPTION
        } else {
            edit.SELF_ARGV_FILES
        }
        assert(class == want, "'{line}': edit reads class {class}, args_parse {want}")
        if !shell {
            assert(
                files.len == a.files.len,
                "'{line}': {files.len} files, args_parse {a.files.len}",
            )
            var i = 0
            while i < files.len {
                assert(
                    files[i] == a.files[i],
                    "'{line}': file {i} is {files[i]}, args_parse {a.files[i]}",
                )
                i += 1
            }
        }
    }
}

fn main() {
    let chosen = (env_get("YEW_NESTED_CASE") else "-1").to_int() else -1
    if chosen < 0 || chosen == 0 {
        t_self_open_follows_the_session_directory()
        print("nested_self_open_follows_the_session_directory: PASS")
    }
    if chosen < 0 || chosen == 1 {
        t_self_open_refuses_by_name()
        print("nested_self_open_refuses_by_name: PASS")
    }
    if chosen < 0 || chosen == 2 {
        t_self_open_opens_every_plain_operand()
        print("nested_self_open_opens_every_plain_operand: PASS")
    }
    if chosen < 0 || chosen == 3 {
        t_self_open_leaves_other_lines_to_the_shell()
        print("nested_self_open_leaves_other_lines_to_the_shell: PASS")
    }
    if chosen < 0 || chosen == 4 {
        t_untitled_record_is_not_dropped()
        print("nested_untitled_record_is_not_dropped: PASS")
    }
    if chosen < 0 || chosen == 5 {
        t_active_tab_names_a_written_record()
        print("nested_active_tab_names_a_written_record: PASS")
    }
    if chosen < 0 || chosen == 6 {
        t_a_held_owner_lock_makes_a_reader()
        print("nested_a_held_owner_lock_makes_a_reader: PASS")
    }
    if chosen < 0 || chosen == 7 {
        if t_a_stale_lease_naming_a_live_pid_is_taken_over() {
            print("nested_a_stale_lease_naming_a_live_pid_is_taken_over: PASS")
        }
    }
    if chosen < 0 || chosen == 8 {
        if t_a_lease_from_before_the_owner_lock_still_owns() {
            print("nested_a_lease_from_before_the_owner_lock_still_owns: PASS")
        }
    }
    if chosen < 0 || chosen == 9 {
        t_self_open_reads_words_as_the_command_line_does()
        print("nested_self_open_reads_words_as_the_command_line_does: PASS")
    }
}
