//! member: false
//! yw09: validate reentrant parking with the REAL FlVm, not a stand-in.
//! One VM moves into the host for a synchronous command, then back out for
//! its callback. No region, deep copy, module variable or second VM executes.

use fl

struct ParkHost { vms: List[fl.FlVm], calls: int, active: bool }

fn unreachable_vm() -> fl.FlVm {
    assert(false, "lost active VM")
    var s = fl.fl_strings()
    fl.fl_vm_new(take s)
}

fn callback(mut h: ParkHost, value: fl.FlValue) -> fl.FlValue {
    var vm = (mut h.vms).pop() else unreachable_vm()
    let out = fl.fl_vm_call_host(mut vm, mut h, value, List[fl.FlValue]())
    (mut h.vms).push(vm)
    out
}

impl fl.FlHost for ParkHost {
    fn api(mut self, mut vm: fl.FlVm, kind: int, base: int, argc: int) -> fl.FlValue {
        let _ = argc
        self.calls += 1
        if kind == 13003 { fl.fl_gc_collect(mut vm); return fl.fl_int(7) }
        assert(kind == 13002 && self.vms.len == 0)
        let value = copy vm.stack[base]
        (mut self.vms).push(vm)
        let result = callback(mut self, value)
        vm = (mut self.vms).pop() else unreachable_vm()
        result
    }
    #[allow(w1002)]
    fn motion(mut self, mut vm: fl.FlVm, p: fl.FlValue) -> bool {
        let _ = self.calls
        let _ = p
        let _ = fl.fl_raise(mut vm, "motion", "no editor host")
        false
    }
    #[allow(w1002)]
    fn edit_begin(mut self, mut vm: fl.FlVm) -> bool {
        let _ = self.calls
        let _ = vm.sp
        true
    }
    #[allow(w1002)]
    fn edit_end(mut self, mut vm: fl.FlVm, ok: bool) -> bool {
        let _ = self.calls
        let _ = vm.sp
        let _ = ok
        true
    }
    #[allow(w1002)]
    fn run_begin(mut self, mut vm: fl.FlVm) -> bool {
        let _ = vm.sp
        assert(!self.active)
        self.active = true
        true
    }
    #[allow(w1002)]
    fn run_end(mut self, mut vm: fl.FlVm, ok: bool) -> bool {
        let _ = vm.sp
        let _ = ok
        self.active = false
        true
    }
    fn run_active(self) -> bool { self.active }
    // C's NULL hook ops (flhook.h:84): fl_call, nothing masked, no notice.
    fn hook_call(mut self, mut vm: fl.FlVm, f: fl.FlValue, args: List[fl.FlValue]) -> (
        bool,
        fl.FlValue,
    ) {
        fl.fl_hook_default_call(mut vm, mut self, f, args)
    }
    fn hook_masked(self, origin: int) -> bool {
        let _ = origin
        let _ = self.active
        false
    }
    #[allow(w1002)]
    fn hook_notice(
        mut self,
        mut vm: fl.FlVm,
        what: int,
        event: int,
        ledger_id: int,
        errs: int,
        err: fl.FlValue,
    ) {
        let _ = self.active
        let _ = vm.sp
        let _ = what
        let _ = event
        let _ = ledger_id
        let _ = errs
        let _ = err
    }
}

fn main() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    fl.fl_std_register(mut vm)
    let src = "import ed; return ed.msg(fn() {{ return ed.mode() }})"
    let file = fl.fl_diag_add_file(mut vm.dc, "parking.fl", src.bytes())
    let p = fl.fl_parse(src.bytes(), file, mut vm.dc, mut vm.strings)
    assert(!p.had_error)
    let entry = fl.fl_compile(mut vm, p, file, fl.fl_origin_new(fl.FL_ORIGIN_CLI, 0)) else {
        assert(false)
        return
    }
    var h = ParkHost { vms: List[fl.FlVm](), calls: 0, active: false }
    let result = fl.fl_vm_run_host(mut vm, mut h, entry)
    assert(!vm.raised && result.t == fl.FL_INT && result.i == 7)
    assert(h.calls == 2 && h.vms.len == 0 && !h.active)
    assert(vm.sp == 0 && vm.frames.len == 0 && vm.handlers.len == 0)
    print("real FlVm parking and callback GC: PASS")
}
