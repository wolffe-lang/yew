//! member: false
//! Direct primitive coverage beside the pending C script-fixture suite.
//! sagitta 9ace98c2 tests/unit/test_fl_std_map.c:24-160.

use fl

fn call(mut vm: fl.FlVm, kind: int, args: List[fl.FlValue]) -> fl.FlValue {
    vm.raised = false
    vm.sp = args.len
    for i in 0..args.len { vm.stack[i] = copy args[i] }
    let defs = fl.fl_map_defs()
    let name = "map.{defs[kind].name}"
    vm.cur_native = fl.fl_intern(mut vm.strings, name.bytes(), 0, name.len)
    fl.fl_std_map_dispatch(mut vm, kind, 0, args.len)
}

fn named(vm: fl.FlVm, value: fl.FlValue, want: str) -> bool {
    let at = fl.fl_obj_index(vm, value)
    (str_from_utf8(vm.gc.slots[at].bytes) else "") == want
}

fn err_is(mut vm: fl.FlVm, kind: str, msg: str) {
    assert(vm.raised)
    let k = fl.fl_str_text(mut vm, "kind")
    let m = fl.fl_str_text(mut vm, "msg")
    let kv = fl.fl_map_get(vm, vm.err, k) else fl.fl_nil()
    let mv = fl.fl_map_get(vm, vm.err, m) else fl.fl_nil()
    assert(named(vm, kv, kind) && named(vm, mv, msg))
}

fn t_live_len_and_clear() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let m = fl.fl_map_new(mut vm)
    for n in [0, 2, 3, 5] {
        for i in 0..n { assert(fl.fl_map_set(mut vm, m, fl.fl_int(i), fl.fl_int(i + 1))) }
        assert(call(mut vm, 0, [copy m]).i == n)
        let _ = call(mut vm, 5, [copy m])
        assert(call(mut vm, 0, [copy m]).i == 0)
        assert(call(mut vm, 3, [copy m, fl.fl_int(0)]).i == 0)
    }
    let _ = call(mut vm, 2, [copy m, fl.fl_int(1), fl.fl_int(7)])
    assert(call(mut vm, 1, [copy m, fl.fl_int(1)]).i == 7)
    fl.fl_freeze(mut vm, m)
    let _ = call(mut vm, 5, [copy m])
    err_is(mut vm, "type", "map.clear: the map is frozen")
}

fn t_key_reads_writes_errors() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let m = fl.fl_map_new(mut vm)
    assert(call(mut vm, 1, [copy m, fl.fl_int(1), fl.fl_int(9)]).i == 9)
    let _ = call(mut vm, 1, [copy m, fl.fl_int(1)])
    err_is(mut vm, "key", "map.get: no such key")
    let _ = call(mut vm, 2, [copy m, fl.fl_int(1), fl.fl_int(7)])
    assert(call(mut vm, 3, [copy m, fl.fl_int(1)]).i == 1)
    assert(call(mut vm, 4, [copy m, fl.fl_int(1)]).i == 7)
    let _ = call(mut vm, 4, [copy m, fl.fl_int(1)])
    err_is(mut vm, "key", "map.remove: no such key")
    let _ = call(mut vm, 2, [copy m, fl.fl_float(1.5), fl.fl_int(1)])
    err_is(mut vm, "key", "map key must be string, int, or bool, found float")
    let _ = call(mut vm, 0, [fl.fl_int(7)])
    err_is(mut vm, "type", "map.len: argument 1 must be map, found int")
}

fn t_ordered_collections() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let m = fl.fl_map_new(mut vm)
    for i in [2, 1, 3] { assert(fl.fl_map_set(mut vm, m, fl.fl_int(i), fl.fl_int(i * 10))) }
    let keys = call(mut vm, 6, [copy m])
    let vals = call(mut vm, 7, [copy m])
    let pairs = call(mut vm, 8, [copy m])
    let expected = [2, 1, 3]
    for i in 0..3 {
        assert((fl.fl_list_get(vm, keys, i) else fl.fl_nil()).i == expected[i])
        assert((fl.fl_list_get(vm, vals, i) else fl.fl_nil()).i == expected[i] * 10)
        let pair = fl.fl_list_get(vm, pairs, i) else fl.fl_nil()
        assert((fl.fl_list_get(vm, pair, 0) else fl.fl_nil()).i == expected[i])
        assert((fl.fl_list_get(vm, pair, 1) else fl.fl_nil()).i == expected[i] * 10)
    }
    assert(fl.fl_map_del(mut vm, m, fl.fl_int(2)))
    assert(fl.fl_map_set(mut vm, m, fl.fl_int(2), fl.fl_int(99)))
    let reordered = call(mut vm, 6, [copy m])
    assert((fl.fl_list_get(vm, reordered, 2) else fl.fl_nil()).i == 2)
}

fn t_merge_copy_freeze() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let a = fl.fl_map_new(mut vm)
    let b = fl.fl_map_new(mut vm)
    assert(fl.fl_map_set(mut vm, a, fl.fl_int(1), fl.fl_int(10)))
    assert(fl.fl_map_set(mut vm, a, fl.fl_int(2), fl.fl_int(20)))
    assert(fl.fl_map_set(mut vm, b, fl.fl_int(2), fl.fl_int(99)))
    assert(fl.fl_map_set(mut vm, b, fl.fl_int(3), fl.fl_int(30)))
    let merged = call(mut vm, 9, [copy a, copy b])
    assert((fl.fl_map_get(vm, merged, fl.fl_int(2)) else fl.fl_nil()).i == 99)
    let frozen = call(mut vm, 11, [copy a])
    assert(fl.fl_equal(vm, a, frozen))
    let c = call(mut vm, 10, [copy a])
    assert(!fl.fl_frozen(vm, c))
    let _ = call(mut vm, 2, [copy c, fl.fl_int(1), fl.fl_int(7)])
    assert((fl.fl_map_get(vm, a, fl.fl_int(1)) else fl.fl_nil()).i == 10)
    let _ = call(mut vm, 2, [copy a, fl.fl_int(1), fl.fl_int(7)])
    err_is(mut vm, "type", "map.set: the map is frozen")
    let _ = call(mut vm, 4, [copy a, fl.fl_int(1)])
    err_is(mut vm, "type", "map.remove: the map is frozen")
    assert(fl.fl_map_defs().len == 12)
}

fn main() {
    t_live_len_and_clear()
    t_key_reads_writes_errors()
    t_ordered_collections()
    t_merge_copy_freeze()
    print("stdmap direct: 4 checks, C script fixture pending")
}
