//! lsp.client — the client's pure half (Sprint 45): the server table, the
//! root, URIs, the capabilities, `initialize`'s parameters and the
//! lifecycle transitions.
//!
//! Ports sagitta `src/mod/lsp/client.c:1-787` (the table, roots, URIs,
//! `yew_lsp_caps_parse`, `yew_lsp_initialize_params`, the server's init,
//! initialized, crashed and restart-reset transitions) and `client.h` at
//! 9ace98c2. The half that takes the editor — the config read from
//! `init.fl`, the child, dispatch, the pump — is `edit.lsp_client`, since
//! it takes the `Ed` (`src/edit/lsp_client.lu`).

use util

/// `YEW_LSP_SPAWNING` (`client.h:17-23`).
pub const LSP_SPAWNING: int = 0

/// `YEW_LSP_INITIALIZING`.
pub const LSP_INITIALIZING: int = 1

/// `YEW_LSP_READY`.
pub const LSP_READY: int = 2

/// `YEW_LSP_SHUTTING_DOWN`.
pub const LSP_SHUTTING_DOWN: int = 3

/// `YEW_LSP_DEAD`.
pub const LSP_DEAD: int = 4

/// `YEW_LSPC_COMPLETION` (`client.h:25-38`).
pub const LSPC_COMPLETION: int = 1

/// `YEW_LSPC_HOVER`.
pub const LSPC_HOVER: int = 2

/// `YEW_LSPC_SIGNATURE`.
pub const LSPC_SIGNATURE: int = 4

/// `YEW_LSPC_DEFINITION`.
pub const LSPC_DEFINITION: int = 8

/// `YEW_LSPC_DECLARATION`.
pub const LSPC_DECLARATION: int = 16

/// `YEW_LSPC_TYPE_DEFINITION`.
pub const LSPC_TYPE_DEFINITION: int = 32

/// `YEW_LSPC_IMPLEMENTATION`.
pub const LSPC_IMPLEMENTATION: int = 64

/// `YEW_LSPC_REFERENCES`.
pub const LSPC_REFERENCES: int = 128

/// `YEW_LSPC_DOCUMENT_HIGHLIGHT`.
pub const LSPC_DOCUMENT_HIGHLIGHT: int = 256

/// `YEW_LSPC_DOCUMENT_SYMBOL`.
pub const LSPC_DOCUMENT_SYMBOL: int = 512

/// `YEW_LSPC_RENAME`.
pub const LSPC_RENAME: int = 1024

/// `YEW_LSPC_WORKSPACE_SYMBOL`.
pub const LSPC_WORKSPACE_SYMBOL: int = 2048

/// `YEW_POSENC_UTF8` (`sync.h:16-20`).
pub const POSENC_UTF8: int = 1

/// `YEW_POSENC_UTF16`.
pub const POSENC_UTF16: int = 2

/// `YEW_LSP_MAX_SERVERS` (`client.c:26-32`).
pub const LSP_MAX_SERVERS: int = 16

/// `YEW_LSP_MAX_ARGS`.
pub const LSP_MAX_ARGS: int = 14

/// `YEW_LSP_MAX_ROOTS`.
pub const LSP_MAX_ROOTS: int = 32

/// `YEW_LSP_MAX_INIT_TIMEOUT_MS`.
pub const LSP_MAX_INIT_TIMEOUT_MS: int = 600000

/// `YEW_LSP_RESTART_WINDOW_MS`.
pub const LSP_RESTART_WINDOW_MS: int = 300000

/// `YEW_LSP_STDERR_TAIL` (`client.c:33`).
pub const LSP_STDERR_TAIL: int = 8192

/// A server configuration (`LspServerCfg`, `client.h:40-48`); C's NULL
/// `init_options` is `has_init_options` false.
pub struct LspServerCfg {
    id: str,
    lang: str,
    cmd: str,
    args: List[str],
    roots: List[str],
    init_options: str,
    has_init_options: bool,
    init_timeout_ms: int,
}

fn cfg(lang: str, id: str, cmd: str, args: List[str], roots: List[str]) -> LspServerCfg {
    LspServerCfg {
        id: id,
        lang: lang,
        cmd: cmd,
        args: copy args,
        roots: copy roots,
        init_options: "",
        has_init_options: false,
        init_timeout_ms: RPC_INIT_TIMEOUT_MS,
    }
}

/// The compiled defaults (`default_cfgs`, `client.c:52-88`), in C's order.
pub fn lsp_default_cfgs() -> List[LspServerCfg] {
    let clangd_args = ["--background-index", "--clang-tidy", "--offset-encoding=utf-8"]
    let clangd_roots = ["compile_commands.json", ".clangd", "compile_flags.txt", ".git"]
    let no_args = List[str]()
    let py_roots = ["pyproject.toml", "setup.py", "setup.cfg", ".git"]
    let ts_roots = ["tsconfig.json", "package.json", ".git"]
    var out = List[LspServerCfg]()
    (mut out).push(cfg("c", "clangd", "clangd", clangd_args, clangd_roots))
    (mut out).push(cfg("cpp", "clangd", "clangd", clangd_args, clangd_roots))
    (mut out).push(cfg("objc", "clangd", "clangd", clangd_args, clangd_roots))
    (mut out).push(cfg("rust", "rust-analyzer", "rust-analyzer", no_args, ["Cargo.toml", ".git"]))
    (mut out).push(cfg("python", "pyright", "pyright-langserver", ["--stdio"], py_roots))
    (mut out).push(cfg("go", "gopls", "gopls", no_args, ["go.mod", ".git"]))
    (mut out).push(cfg("js", "tsserver", "typescript-language-server", ["--stdio"], ts_roots))
    (mut out).push(cfg("ts", "tsserver", "typescript-language-server", ["--stdio"], ts_roots))
    (mut out).push(cfg("jsx", "tsserver", "typescript-language-server", ["--stdio"], ts_roots))
    (mut out).push(cfg("tsx", "tsserver", "typescript-language-server", ["--stdio"], ts_roots))
    (mut out).push(cfg("fortran", "fortls", "fortls", no_args, [".fortls", ".git"]))
    (mut out).push(cfg("sh", "bashls", "bash-language-server", ["start"], [".git"]))
    (mut out).push(cfg("wolf", "wolf", "wolf", ["lsp"], ["wolf.pkg", ".git"]))
    out
}

/// C's `strncmp(lang, "fortran", 7) == 0` folding (`client.c:94-96`):
/// `fortran(fixed)` asks for the fortran row.
pub fn lsp_lang_key(lang: str) -> str {
    if lang.starts_with("fortran") then "fortran" else lang
}

/// `yew_lsp_default_cfg` (`client.c:90-102`).
pub fn lsp_default_cfg(lang: str) -> LspServerCfg ! {none} {
    let key = lsp_lang_key(lang)
    for c in lsp_default_cfgs() {
        if c.lang == key {
            return copy c
        }
    }
    none
}

// `path_dir` (`client.c:343-362`): the directory part; "." without a
// slash; "/" for a top-level name.
fn path_dir(path: str) -> str ! {none} {
    if path.len == 0 {
        return none
    }
    let slash = path.rfind("/") else {
        return "."
    }
    if slash == 0 {
        return "/"
    }
    path[0..slash]
}

// `under_root` (`client.c:364-371`).
fn under_root(dir: str, root: str) -> bool {
    if !dir.starts_with(root) {
        return false
    }
    let n = root.len
    dir.len == n || n == 1 && root == "/" || dir.bytes()[n] as int == 47
}

// `has_marker` (`client.c:373-389`): `stat(dir/name)` succeeds.
fn has_marker(dir: str, name: str) -> bool {
    let path = if dir.len == 0 || !dir.ends_with("/") then "{dir}/{name}" else "{dir}{name}"
    let _ = fs_stat(path) else {
        return false
    }
    true
}

/// `yew_lsp_resolve_root` (`client.c:391-433`): the nearest directory from
/// the buffer's up to the workspace root holding one of the config's
/// markers; the workspace root itself when none does, or when the buffer
/// lies outside it; `none` when the workspace root does not resolve.
pub fn lsp_resolve_root(c: LspServerCfg, buffer_path: str, workspace_root: str) -> str ! {none} {
    let root = fs_realpath(workspace_root) else {
        return none
    }
    let raw_dir = path_dir(buffer_path) else {
        return root
    }
    var dir = fs_realpath(raw_dir) else {
        return root
    }
    if !under_root(dir, root) {
        return root
    }
    loop {
        for marker in c.roots {
            if has_marker(dir, marker) {
                return dir
            }
        }
        if dir == root {
            break
        }
        let parent = path_dir(dir) else {
            break
        }
        if parent == dir {
            break
        }
        dir = parent
    }
    root
}

fn uri_safe(c: int) -> bool {
    c >= 65 && c <= 90 ||
        c >= 97 && c <= 122 ||
        c >= 48 && c <= 57 ||
        c == 45 ||
        c == 46 ||
        c == 95 ||
        c == 126 ||
        c == 47
}

/// `yew_lsp_uri_of_path` (`client.c:435-456`): `file://` and the path's
/// bytes, every byte outside `A-Za-z0-9-._~/` as `%XX` (upper-case).
pub fn lsp_uri_of_path(mut out: List[byte], path: List[byte], at: int, end: int) {
    let hex = "0123456789ABCDEF"
    util.buf_append_str(mut out, "file://")
    var i = at
    while i < end {
        let c = path[i] as int
        if uri_safe(c) {
            (mut out).push(path[i])
        } else {
            (mut out).push(37 as byte)
            (mut out).push(hex.bytes()[c >> 4])
            (mut out).push(hex.bytes()[c & 15])
        }
        i += 1
    }
}

/// `lsp_uri_of_path` of a `str` path, as a `str` (a URI is ASCII).
pub fn lsp_uri_text(path: str) -> str {
    var out = List[byte]()
    lsp_uri_of_path(mut out, path.bytes(), 0, path.len)
    str_from_utf8(out) else ""
}

fn hexval(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 65 && c <= 70 {
        return c - 65 + 10
    }
    if c >= 97 && c <= 102 {
        return c - 97 + 10
    }
    -1
}

/// `yew_lsp_path_of_uri` (`client.c:465-489`): only `file:///…`; every
/// `%XX` decoded, a short or non-hex escape refused. The bytes are pushed
/// onto `out`.
pub fn lsp_path_of_uri(mut out: List[byte], uri: List[byte], at: int, end: int) -> bool {
    let n = end - at
    let prefix = "file://"
    if n < 8 {
        return false
    }
    var k = 0
    while k < 7 {
        if uri[at + k] != prefix.bytes()[k] {
            return false
        }
        k += 1
    }
    if uri[at + 7] as int != 47 {
        return false
    }
    var i = at + 7
    while i < end {
        if uri[i] as int == 37 {
            if i + 2 >= end {
                return false
            }
            let hi = hexval(uri[i + 1] as int)
            let lo = hexval(uri[i + 2] as int)
            if hi < 0 || lo < 0 {
                return false
            }
            (mut out).push((hi * 16 + lo) as byte)
            i += 3
        } else {
            (mut out).push(uri[i])
            i += 1
        }
    }
    true
}

/// The negotiated capabilities (`LspCaps`, `client.h:50-58`).
pub struct LspCaps {
    bits: int,
    sync_kind: int,
    resolve_completion: bool,
    trigger_chars: str,
    sig_trigger: str,
    save_supported: bool,
    save_include_text: bool,
}

/// Zeroed capabilities.
pub fn lsp_caps_new() -> LspCaps {
    LspCaps {
        bits: 0,
        sync_kind: 0,
        resolve_completion: false,
        trigger_chars: "",
        sig_trigger: "",
        save_supported: false,
        save_include_text: false,
    }
}

// `capability` (`client.c:491-497`): present, not null, not false.
fn capability(j: Json, caps: int, name: str) -> bool {
    let v = json_field(j, caps, name)
    let k = json_kind(j, v)
    v >= 0 && k != JS_NULL && !(k == JS_BOOL && !json_bool(j, v, false))
}

// `append_string_array` (`client.c:499-517`): the strings joined into a
// buffer of `cap` bytes (one kept for C's NUL); an empty string, or one
// that no longer fits, skipped.
fn append_string_array(j: Json, arr: int, cap: int) -> str {
    if json_kind(j, arr) != JS_ARR {
        return ""
    }
    var out = List[byte]()
    var i = 0
    while i < json_size(j, arr) {
        let s = json_at(j, arr, i)
        if json_is_str(j, s) {
            let n = json_size(j, s)
            if n != 0 && n <= cap - 1 - out.len {
                util.buf_append(mut out, json_str(j, s))
            }
        }
        i += 1
    }
    str_from_utf8(out) else ""
}

/// What `yew_lsp_caps_parse` writes besides the capabilities.
pub struct LspNegotiated {
    caps: LspCaps,
    pos_enc: int,
    unknown_encoding: bool,
}

/// `yew_lsp_caps_parse` (`client.c:519-591`) over `initialize`'s result.
pub fn lsp_caps_parse(j: Json, result: int) -> LspNegotiated {
    var out = LspNegotiated { caps: lsp_caps_new(), pos_enc: POSENC_UTF16, unknown_encoding: false }
    let caps = json_field(j, result, "capabilities")
    if json_kind(j, caps) != JS_OBJ {
        return out
    }
    let fields = [
        ("completionProvider", LSPC_COMPLETION),
        ("hoverProvider", LSPC_HOVER),
        ("signatureHelpProvider", LSPC_SIGNATURE),
        ("definitionProvider", LSPC_DEFINITION),
        ("declarationProvider", LSPC_DECLARATION),
        ("typeDefinitionProvider", LSPC_TYPE_DEFINITION),
        ("implementationProvider", LSPC_IMPLEMENTATION),
        ("referencesProvider", LSPC_REFERENCES),
        ("documentHighlightProvider", LSPC_DOCUMENT_HIGHLIGHT),
        ("documentSymbolProvider", LSPC_DOCUMENT_SYMBOL),
        ("renameProvider", LSPC_RENAME),
        ("workspaceSymbolProvider", LSPC_WORKSPACE_SYMBOL),
    ]
    for (key, bit) in fields {
        if capability(j, caps, key) {
            out.caps.bits = out.caps.bits | bit
        }
    }
    let sync = json_field(j, caps, "textDocumentSync")
    if json_kind(j, sync) == JS_INT {
        let i = json_int(j, sync, 0)
        out.caps.sync_kind = if i >= 0 && i <= 2 then i else 0
    } else if json_kind(j, sync) == JS_OBJ {
        let change = json_int(j, json_field(j, sync, "change"), 0)
        let save = json_field(j, sync, "save")
        let sk = json_kind(j, save)
        out.caps.sync_kind = if change >= 0 && change <= 2 then change else 0
        out.caps.save_supported = save >= 0 &&
            sk != JS_NULL &&
            !(sk == JS_BOOL && !json_bool(j, save, false))
        if sk == JS_OBJ {
            out.caps.save_include_text = json_bool(j, json_field(j, save, "includeText"), false)
        }
    }
    let completion = json_field(j, caps, "completionProvider")
    if json_kind(j, completion) == JS_OBJ {
        out.caps.resolve_completion = json_bool(
            j,
            json_field(j, completion, "resolveProvider"),
            false,
        )
        out.caps.trigger_chars = append_string_array(
            j,
            json_field(j, completion, "triggerCharacters"),
            16,
        )
    }
    let sig = json_field(j, caps, "signatureHelpProvider")
    if json_kind(j, sig) == JS_OBJ {
        out.caps.sig_trigger = append_string_array(j, json_field(j, sig, "triggerCharacters"), 8)
    }
    let enc = json_field(j, caps, "positionEncoding")
    if enc < 0 {
        return out
    }
    if json_streq(j, enc, "utf-8") {
        out.pos_enc = POSENC_UTF8
    } else if !json_streq(j, enc, "utf-16") {
        out.unknown_encoding = true
    }
    out
}

/// `yew_lsp_has` (`client.c:593-596`) over a capability set.
pub fn lsp_caps_has(caps: LspCaps, cap: int) -> bool {
    caps.bits & cap != 0
}

/// `yew_lsp_initialize_params` (`client.c:598-707`): the client's
/// capabilities, key for key in C's order.
pub fn lsp_initialize_params(c: LspServerCfg, root: str, process_id: int) -> List[byte] {
    let uri = lsp_uri_text(root)
    let slash = root.rfind("/") else -1
    let name = if slash < 0 then root else root[slash + 1..]
    var w = jsonw_new()
    jsonw_obj(mut w)
    jsonw_key(mut w, "processId")
    jsonw_int(mut w, process_id)
    jsonw_key(mut w, "clientInfo")
    jsonw_obj(mut w)
    jsonw_key(mut w, "name")
    jsonw_cstr(mut w, "yew")
    jsonw_key(mut w, "version")
    jsonw_cstr(mut w, util.VERSION)
    jsonw_obj_end(mut w)
    jsonw_key(mut w, "rootUri")
    jsonw_cstr(mut w, uri)
    jsonw_key(mut w, "workspaceFolders")
    jsonw_arr(mut w)
    jsonw_obj(mut w)
    jsonw_key(mut w, "uri")
    jsonw_cstr(mut w, uri)
    jsonw_key(mut w, "name")
    jsonw_cstr(mut w, name)
    jsonw_obj_end(mut w)
    jsonw_arr_end(mut w)
    jsonw_key(mut w, "initializationOptions")
    if c.has_init_options {
        jsonw_raw(mut w, c.init_options.bytes())
    } else {
        jsonw_obj(mut w)
        jsonw_obj_end(mut w)
    }
    jsonw_key(mut w, "capabilities")
    jsonw_obj(mut w)
    jsonw_key(mut w, "general")
    jsonw_obj(mut w)
    jsonw_key(mut w, "positionEncodings")
    jsonw_arr(mut w)
    jsonw_cstr(mut w, "utf-8")
    jsonw_cstr(mut w, "utf-16")
    jsonw_arr_end(mut w)
    jsonw_obj_end(mut w)
    jsonw_key(mut w, "textDocument")
    jsonw_obj(mut w)
    jsonw_key(mut w, "synchronization")
    jsonw_obj(mut w)
    jsonw_key(mut w, "dynamicRegistration")
    jsonw_bool(mut w, false)
    jsonw_key(mut w, "willSave")
    jsonw_bool(mut w, false)
    jsonw_key(mut w, "willSaveWaitUntil")
    jsonw_bool(mut w, false)
    jsonw_key(mut w, "didSave")
    jsonw_bool(mut w, true)
    jsonw_obj_end(mut w)
    jsonw_key(mut w, "completion")
    jsonw_obj(mut w)
    jsonw_key(mut w, "contextSupport")
    jsonw_bool(mut w, true)
    jsonw_key(mut w, "completionItem")
    jsonw_obj(mut w)
    jsonw_key(mut w, "snippetSupport")
    jsonw_bool(mut w, false)
    jsonw_key(mut w, "documentationFormat")
    jsonw_arr(mut w)
    jsonw_cstr(mut w, "plaintext")
    jsonw_arr_end(mut w)
    jsonw_key(mut w, "insertReplaceSupport")
    jsonw_bool(mut w, false)
    jsonw_key(mut w, "resolveSupport")
    jsonw_obj(mut w)
    jsonw_key(mut w, "properties")
    jsonw_arr(mut w)
    jsonw_cstr(mut w, "documentation")
    jsonw_cstr(mut w, "detail")
    jsonw_arr_end(mut w)
    jsonw_obj_end(mut w)
    jsonw_obj_end(mut w)
    jsonw_key(mut w, "completionItemKind")
    jsonw_obj(mut w)
    jsonw_key(mut w, "valueSet")
    jsonw_arr(mut w)
    var k = 1
    while k <= 25 {
        jsonw_int(mut w, k)
        k += 1
    }
    jsonw_arr_end(mut w)
    jsonw_obj_end(mut w)
    jsonw_obj_end(mut w)
    jsonw_key(mut w, "hover")
    jsonw_obj(mut w)
    jsonw_key(mut w, "contentFormat")
    jsonw_arr(mut w)
    jsonw_cstr(mut w, "plaintext")
    jsonw_arr_end(mut w)
    jsonw_obj_end(mut w)
    jsonw_key(mut w, "signatureHelp")
    jsonw_obj(mut w)
    jsonw_key(mut w, "signatureInformation")
    jsonw_obj(mut w)
    jsonw_key(mut w, "documentationFormat")
    jsonw_arr(mut w)
    jsonw_cstr(mut w, "plaintext")
    jsonw_arr_end(mut w)
    jsonw_key(mut w, "parameterInformation")
    jsonw_obj(mut w)
    jsonw_key(mut w, "labelOffsetSupport")
    jsonw_bool(mut w, true)
    jsonw_obj_end(mut w)
    jsonw_obj_end(mut w)
    jsonw_obj_end(mut w)
    for nav in ["definition", "declaration", "typeDefinition", "implementation"] {
        jsonw_key(mut w, nav)
        jsonw_obj(mut w)
        jsonw_key(mut w, "linkSupport")
        jsonw_bool(mut w, false)
        jsonw_obj_end(mut w)
    }
    for simple in ["references", "documentHighlight"] {
        jsonw_key(mut w, simple)
        jsonw_obj(mut w)
        jsonw_obj_end(mut w)
    }
    jsonw_key(mut w, "documentSymbol")
    jsonw_obj(mut w)
    jsonw_key(mut w, "hierarchicalDocumentSymbolSupport")
    jsonw_bool(mut w, true)
    jsonw_obj_end(mut w)
    jsonw_key(mut w, "rename")
    jsonw_obj(mut w)
    jsonw_key(mut w, "prepareSupport")
    jsonw_bool(mut w, false)
    jsonw_obj_end(mut w)
    jsonw_key(mut w, "publishDiagnostics")
    jsonw_obj(mut w)
    jsonw_key(mut w, "relatedInformation")
    jsonw_bool(mut w, true)
    jsonw_key(mut w, "versionSupport")
    jsonw_bool(mut w, true)
    jsonw_key(mut w, "tagSupport")
    jsonw_obj(mut w)
    jsonw_key(mut w, "valueSet")
    jsonw_arr(mut w)
    jsonw_int(mut w, 1)
    jsonw_int(mut w, 2)
    jsonw_arr_end(mut w)
    jsonw_obj_end(mut w)
    jsonw_obj_end(mut w)
    jsonw_obj_end(mut w)
    jsonw_key(mut w, "workspace")
    jsonw_obj(mut w)
    jsonw_key(mut w, "applyEdit")
    jsonw_bool(mut w, false)
    jsonw_key(mut w, "configuration")
    jsonw_bool(mut w, true)
    jsonw_key(mut w, "workspaceFolders")
    jsonw_bool(mut w, true)
    jsonw_key(mut w, "workspaceEdit")
    jsonw_obj(mut w)
    jsonw_key(mut w, "documentChanges")
    jsonw_bool(mut w, true)
    jsonw_key(mut w, "failureHandling")
    jsonw_cstr(mut w, "abort")
    jsonw_key(mut w, "resourceOperations")
    jsonw_arr(mut w)
    jsonw_arr_end(mut w)
    jsonw_obj_end(mut w)
    jsonw_obj_end(mut w)
    jsonw_key(mut w, "window")
    jsonw_obj(mut w)
    jsonw_key(mut w, "showMessage")
    jsonw_obj(mut w)
    jsonw_obj_end(mut w)
    jsonw_key(mut w, "workDoneProgress")
    jsonw_bool(mut w, false)
    jsonw_obj_end(mut w)
    jsonw_obj_end(mut w)
    jsonw_obj_end(mut w)
    w.out
}

/// A server's lifecycle (`LspServer`, `client.h:63-89`, the fields the
/// pure transitions read and write). The editor's half keeps the rest:
/// the job, the connection, the documents.
pub struct LspLife {
    state: int,
    caps: LspCaps,
    pos_enc: int,
    restarts: int,
    first_restart_ms: int,
    next_try_ms: int,
    gave_up: bool,
}

/// `yew_lsp_server_init`'s lifecycle (`client.c:709-719`).
pub fn lsp_life_new() -> LspLife {
    LspLife {
        state: LSP_SPAWNING,
        caps: lsp_caps_new(),
        pos_enc: POSENC_UTF16,
        restarts: 0,
        first_restart_ms: 0,
        next_try_ms: 0,
        gave_up: false,
    }
}

/// What `yew_lsp_server_initialized` decides (`client.c:737-764`): READY,
/// or DEAD for a server without document synchronization; and the two
/// messages C sends the editor (`warn` for an unknown position encoding,
/// `error` for no sync), empty when none.
pub struct LspInitVerdict {
    ready: bool,
    warn: str,
    error: str,
    log_error: str,
}

/// `yew_lsp_server_initialized` (`client.c:737-764`).
pub fn lsp_life_initialized(mut life: LspLife, id: str, j: Json, result: int) -> LspInitVerdict {
    var v = LspInitVerdict { ready: false, warn: "", error: "", log_error: "" }
    if life.state != LSP_INITIALIZING || result < 0 {
        return v
    }
    let n = lsp_caps_parse(j, result)
    life.caps = n.caps
    life.pos_enc = n.pos_enc
    if n.unknown_encoding {
        v.warn = "{id} returned unknown positionEncoding; using utf-16"
    }
    if life.caps.sync_kind == 0 {
        v.log_error = "{id} does not support document synchronization; server is unusable"
        v.error = "{id} does not support document synchronization; LSP is off for this workspace"
        life.state = LSP_DEAD
        return v
    }
    life.state = LSP_READY
    v.ready = true
    v
}

/// `yew_lsp_server_crashed` (`client.c:766-797`): the restart count over
/// a five-minute window, the backoff (250 ms, 1 s, 4 s, 16 s) and the
/// message; the fifth crash gives up. Answers (restart again, message).
pub fn lsp_life_crashed(mut life: LspLife, id: str, now_ms: int, last_stderr: str) -> (bool, str) {
    if life.restarts == 0 || now_ms - life.first_restart_ms >= LSP_RESTART_WINDOW_MS {
        life.first_restart_ms = now_ms
        life.restarts = 0
    }
    life.restarts += 1
    life.state = LSP_DEAD
    if life.restarts >= 5 {
        life.gave_up = true
        let last = if last_stderr.len != 0 then last_stderr else "(no stderr output)"
        let msg = "{id} crashed 5 times in 5 minutes; LSP is off for this workspace.\nlast error: {last}\nrun :lsp.restart to try again, or :lsp.log to read the server's output."
        return (false, msg)
    }
    let delay = [250, 1000, 4000, 16000]
    life.next_try_ms = now_ms + delay[life.restarts - 1]
    if life.restarts == 2 {
        return (true, "{id} restarted")
    }
    if life.restarts > 2 {
        return (true, "{id} restarted ({life.restarts})")
    }
    (true, "")
}

/// `yew_lsp_server_restart_reset` (`client.c:799-805`).
pub fn lsp_life_restart_reset(mut life: LspLife) {
    life.restarts = 0
    life.first_restart_ms = 0
    life.next_try_ms = 0
    life.gave_up = false
}
