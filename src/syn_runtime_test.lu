//! member: false
//! The seven stage-one syntax definitions ship in `runtime/syntax/`, byte
//! for byte sagitta's at the pin (`tools/check-runtime` compares them), and
//! in the embedded runtime, which `edit.runtime_read` falls back to. Case 0
//! checks every embedded copy against its file; cases 1 to 7 compile each
//! embedded copy with no error and no warning, under its language's name.

use edit
use syn

fn modes() -> List[str] {
    ["c", "json", "markdown", "python", "sh", "toml", "wolf"]
}

fn embedded(name: str) -> List[byte] {
    let (ok, text) = edit.runtime_embedded("syntax/{name}.fl")
    assert(ok, "runtime/syntax/{name}.fl is embedded")
    var out = List[byte]()
    for b in text.bytes() { (mut out).push(b) }
    out
}

fn same_bytes(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len {
        if a[i] != b[i] { return false }
    }
    true
}

fn embedded_copies_are_the_files() {
    for name in modes() {
        let file = fs_read_bytes("runtime/syntax/{name}.fl") else {
            assert(false, "runtime/syntax/{name}.fl is readable")
            return
        }
        assert(same_bytes(embedded(name), file), "the embedded {name}.fl is the file")
    }
}

fn compiles_clean(name: str) {
    let c = syn.syn_compile("{name}.fl", embedded(name))
    assert(c.valid && c.diagnostics.nerrors == 0, "{name}.fl compiles")
    assert(c.diagnostics.nwarnings == 0, "{name}.fl compiles without warnings")
    assert(same_bytes(c.definition.name, name.bytes()), "{name}.fl names its language {name}")
}

fn main() {
    let selected = (env_get("YEW_SYN_RUNTIME_CASE") else "-1").to_int() else -1
    let names = modes()
    var i = 0
    while i < 8 {
        if selected == -1 || selected == i {
            if i == 0 { embedded_copies_are_the_files() } else { compiles_clean(names[i - 1]) }
            print("syn_runtime_case_{i}: PASS")
        }
        i += 1
    }
}
