//! member: false
//!
//! The port of sagitta `tests/unit/test_mark.c` (232 lines), one test per
//! C test in registry order (`tests/unit/registry.c:327-329`). The stale
//! handle's exit 4 runs in a re-executed child (`--bug N`), skipped loudly
//! on the checked machine; the collapse observer's log is the list
//! `marks_collapse_list` answers.

use std.fs
use std.process
use text

fn assert_adjust(op: int, at: int, len: int, pos: int, bias: int, expected: int) {
    var ms = text.marks_new()
    let id = text.mark_add(mut ms, text.byteoff(pos), bias)
    text.marks_adjust(mut ms, op, text.byteoff(at), len)
    assert(
        text.mark_pos(ms, id) as int == expected,
        "op {op} at {at} len {len} pos {pos} bias {bias}",
    )
}

fn t_mark_bias_table() {
    let ins = text.JOURNAL_INS
    let del = text.JOURNAL_DEL
    let l = text.BIAS_LEFT
    let r = text.BIAS_RIGHT
    assert_adjust(ins, 4, 3, 5, l, 8)
    assert_adjust(ins, 4, 3, 5, r, 8)
    assert_adjust(ins, 4, 3, 4, l, 4)
    assert_adjust(ins, 4, 3, 4, r, 7)
    assert_adjust(ins, 4, 3, 3, l, 3)
    assert_adjust(ins, 4, 3, 3, r, 3)
    assert_adjust(del, 4, 3, 8, l, 5)
    assert_adjust(del, 4, 3, 8, r, 5)
    assert_adjust(del, 4, 3, 5, l, 4)
    assert_adjust(del, 4, 3, 5, r, 4)
    assert_adjust(del, 4, 3, 3, l, 3)
    assert_adjust(del, 4, 3, 3, r, 3)
}

fn stale_scenario(deleting: bool) {
    var ms = text.marks_new()
    let stale = text.mark_add(mut ms, text.byteoff(9), text.BIAS_LEFT)
    text.mark_del(mut ms, stale)
    let _ = text.mark_add(mut ms, text.byteoff(12), text.BIAS_RIGHT)
    if deleting {
        text.mark_del(mut ms, stale)
    } else {
        let _ = text.mark_pos(ms, stale)
    }
    os_exit(0)
}

fn bug_child_exit(n: int) -> int {
    let exe = os_exe() else {
        return -1
    }
    var c = process.command(exe)
    process.push_arg(mut c, "--bug")
    process.push_arg(mut c, "{n}")
    let sink = fs.open_append("/dev/null") else |_| {
        return -1
    }
    process.set_stderr(mut c, sink)
    let child = process.start(c) else |_| {
        return -1
    }
    let status = process.wait_status(take child) else -1
    fs.close(take sink) else |_| {}
    status
}

fn t_mark_generational_handles() {
    var ms = text.marks_new()
    let stale = text.mark_add(mut ms, text.byteoff(9), text.BIAS_LEFT)
    text.mark_del(mut ms, stale)
    let fresh = text.mark_add(mut ms, text.byteoff(12), text.BIAS_RIGHT)
    assert(fresh.id == stale.id, "the slot is reused")
    assert(fresh.gen != stale.gen, "with a new generation")
    assert(text.mark_pos(ms, fresh) as int == 12, "fresh at 12")
    assert(bug_child_exit(0) == 4, "a stale read exits 4")
    assert(bug_child_exit(1) == 4, "a stale delete exits 4")
    let inside_a = text.mark_add(mut ms, text.byteoff(5), text.BIAS_LEFT)
    let inside_b = text.mark_add(mut ms, text.byteoff(7), text.BIAS_RIGHT)
    let edge = text.mark_add(mut ms, text.byteoff(4), text.BIAS_RIGHT)
    let hi_left = text.mark_add(mut ms, text.byteoff(8), text.BIAS_LEFT)
    let hi_right = text.mark_add(mut ms, text.byteoff(8), text.BIAS_RIGHT)
    let log = text.marks_collapse_list(ms, text.span(4, 8))
    assert(log.len == 4, "four collapses")
    assert(log[0].id.id == edge.id && log[0].rel == 0, "edge")
    assert(
        log[1].id.id == inside_a.id && log[1].id.gen == inside_a.gen && log[1].rel == 1,
        "inside a",
    )
    assert(log[2].id.id == inside_b.id && log[2].rel == 3, "inside b")
    assert(log[3].id.id == hi_left.id && log[3].rel == 4, "hi left")
    text.marks_adjust(mut ms, text.JOURNAL_DEL, text.byteoff(4), 4)
    assert(text.mark_pos(ms, inside_a) as int == 4, "a collapses")
    assert(text.mark_pos(ms, inside_b) as int == 4, "b collapses")
    assert(text.mark_pos(ms, edge) as int == 4, "edge stays")
    assert(text.mark_pos(ms, hi_left) as int == 4, "hi left moves")
    assert(text.mark_pos(ms, hi_right) as int == 4, "hi right moves")
    text.marks_adjust(mut ms, text.JOURNAL_INS, text.byteoff(4), 4)
    assert(text.mark_pos(ms, inside_a) as int == 4, "a stays left")
    assert(text.mark_pos(ms, inside_b) as int == 8, "b moves right")
    assert(text.mark_pos(ms, edge) as int == 8, "edge moves right")
    assert(text.mark_pos(ms, hi_left) as int == 4, "hi left stays")
    assert(text.mark_pos(ms, hi_right) as int == 8, "hi right moves")
    assert(text.mark_repair(mut ms, edge, text.byteoff(4)), "repair edge")
    assert(text.mark_repair(mut ms, inside_a, text.byteoff(5)), "repair a")
    assert(text.mark_repair(mut ms, inside_b, text.byteoff(7)), "repair b")
    assert(text.mark_repair(mut ms, hi_left, text.byteoff(8)), "repair hi left")
    assert(text.mark_pos(ms, edge) as int == 4, "edge 4")
    assert(text.mark_pos(ms, inside_a) as int == 5, "a 5")
    assert(text.mark_pos(ms, inside_b) as int == 7, "b 7")
    assert(text.mark_pos(ms, hi_left) as int == 8, "hi left 8")
    assert(text.mark_pos(ms, hi_right) as int == 8, "hi right 8")
    assert(!text.mark_repair(mut ms, stale, text.byteoff(99)), "a stale repair is refused")
    assert(text.mark_pos(ms, fresh) as int == 12, "fresh untouched")
}

// `mark_random`, `test_mark.c:162-171`: xorshift64*, the state and the
// output separate.
fn mark_random(s: wrapping[u64]) -> (wrapping[u64], wrapping[u64]) {
    var x = s
    x = x ^ x >> 12
    x = x ^ x << 25
    x = x ^ x >> 27
    (x, x * 2685821657736338717)
}

fn below(x: wrapping[u64], n: int) -> int {
    (x % n as wrapping[u64]) as int
}

struct OracleMark {
    id: text.MarkId,
    pos: int,
    bias: int,
}

fn oracle_adjust(mut marks: List[OracleMark], op: int, at: int, len: int) {
    var i = 0
    while i < marks.len {
        if op == text.JOURNAL_INS {
            if marks[i].pos > at || marks[i].pos == at && marks[i].bias == text.BIAS_RIGHT {
                marks[i].pos += len
            }
        } else if marks[i].pos < at {
            i += 1
            continue
        } else if marks[i].pos < at + len {
            marks[i].pos = at
        } else {
            marks[i].pos -= len
        }
        i += 1
    }
}

fn t_mark_random_oracle() {
    let mark_count = 10000
    let edit_count = 10000
    var oracle = List[OracleMark]()
    var ms = text.marks_new()
    var state: wrapping[u64] = 2611923443488327891
    var text_len = 100000
    var i = 0
    while i < mark_count {
        let (s1, v1) = mark_random(state)
        let (s2, v2) = mark_random(s1)
        state = s2
        let pos = below(v1, text_len + 1)
        let bias = if (v2 & 1) as int != 0 then text.BIAS_RIGHT else text.BIAS_LEFT
        let id = text.mark_add(mut ms, text.byteoff(pos), bias)
        (mut oracle).push(OracleMark { id: id, pos: pos, bias: bias })
        i += 1
    }
    i = 0
    while i < edit_count {
        var op = text.JOURNAL_INS
        var at = 0
        var len = 0
        let (s1, v1) = mark_random(state)
        state = s1
        if (v1 & 1) as int == 0 || text_len == 0 {
            let (s2, v2) = mark_random(state)
            let (s3, v3) = mark_random(s2)
            state = s3
            at = below(v2, text_len + 1)
            len = below(v3, 17)
            text_len += len
        } else {
            op = text.JOURNAL_DEL
            let (s2, v2) = mark_random(state)
            let (s3, v3) = mark_random(s2)
            state = s3
            at = below(v2, text_len)
            len = 1 + below(v3, text_len - at)
            if len > 16 {
                len = 16
            }
            text_len -= len
        }
        text.marks_adjust(mut ms, op, text.byteoff(at), len)
        oracle_adjust(mut oracle, op, at, len)
        var equal = true
        var j = 0
        while j < mark_count {
            if text.mark_pos(ms, oracle[j].id) as int != oracle[j].pos {
                equal = false
                break
            }
            j += 1
        }
        assert(equal, "edit {i} agrees with the oracle")
        i += 1
    }
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let args = env_args()
    if args.len == 2 && args[0] == "--bug" {
        stale_scenario(args[1] == "1")
        return
    }
    t_mark_bias_table()
    t_mark_generational_handles()
    t_mark_random_oracle()
    print("mark_test: 3 cases pass")
}
