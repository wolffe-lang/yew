//! member: false
//!
//! The port of sagitta `tests/unit/test_compfish.c` (1,065 lines), one
//! test per C test in registry order. C runs every oracle case against a
//! STUB fish (`$YEW_TEST_FISH`, a script recording its argv) through the
//! real prompt; the stub is a job whose pipe is read while the loop runs,
//! so those cases SKIP loudly by name — ruling R-yw04-1 (G2,
//! wolf-lang#795) — and `compfish_real_fish_demo_and_gate` runs real fish,
//! which C's own suite skips without one and the port's with the job. The
//! line fish sees, the query stem and the parse run. Port-only cases
//! stand beside them: a lookup queues under C's key, an answer stored as
//! an arrival stores it is ROWS or CLOSED, and the idle path disables the
//! oracle with one named log line, C's spawn-failure path.

use edit
use std.fs

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn escaped(word: List[byte]) -> List[byte] {
    var b = List[byte]()
    edit.compfish_escape(mut b, word)
    b
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

// `test_compfish.c:318-344`.
fn t_compfish_escapes_words_for_fish() {
    var ins = List[List[byte]]()
    var outs = List[List[byte]]()
    for row in [
        "plain-word_1.txt|plain-word_1.txt",
        "a b|a\\ b",
        "$HOME|\\$HOME",
        "*?~#|\\*\\?\\~\\#",
        "(){{}}[]|\\(\\)\\{{\\}}\\[\\]",
        "<>&;|\\<\\>\\&\\;",
        "\"'\\|\\\"\\'\\\\",
        "tab\there|tab\\there",
        "new\nline|new\\nline",
    ] {
        let bar = row.rfind("|") else 0
        (mut ins).push(bytes_of(row[0..bar]))
        (mut outs).push(bytes_of(row[bar + 1..]))
    }
    var bell = bytes_of("bell")
    (mut bell).push(7 as byte)
    (mut ins).push(bell)
    (mut outs).push(bytes_of("bell\\x07"))
    (mut ins).push(bytes_of("caf\u{E9}"))
    (mut outs).push(bytes_of("caf\u{E9}"))
    var pipe = bytes_of("<>&|;")
    (mut ins).push(pipe)
    (mut outs).push(bytes_of("\\<\\>\\&\\|\\;"))
    var i = 0
    while i < ins.len {
        assert(same(escaped(ins[i]), outs[i]), "escape row {i}")
        i += 1
    }
}

// `test_compfish.c:346-365`.
fn t_compfish_query_stem_is_empty_dash_or_the_flag() {
    for row in [
        "|",
        "bu|",
        "-|-",
        "-v|-",
        "--del|-",
        "--out=|--out=",
        "--out=x|--out=",
        "-o=x|-",
        ".g|.",
        "..|.",
    ] {
        let bar = row.find("|") else 0
        let got = edit.compfish_query_stem(bytes_of(row[0..bar]))
        assert(same(got, bytes_of(row[bar + 1..])), "query stem of `{row[0..bar]}`")
    }
}

// `test_compfish.c:367-397`.
fn t_compfish_parse_rows() {
    var out = bytes_of("a b.txt\nd$x\nsub/\n--del\tAn alias for --delete-during\n--odd\tbell")
    (mut out).push(7 as byte)
    for b in "here\n\na b.txt\nbad".bytes() {
        (mut out).push(b)
    }
    (mut out).push(1 as byte)
    for b in "name\tdropped\n--bare\t\n".bytes() {
        (mut out).push(b)
    }
    let rows = edit.compfish_parse(out)
    assert(rows.len == 6, "six rows, got {rows.len}")
    assert(rows[0].text == "a b.txt" && !rows[0].has_desc, "a b.txt")
    assert(rows[1].text == "d$x" && !rows[1].is_dir, "d$x")
    assert(rows[2].text == "sub" && rows[2].is_dir, "sub/ is a directory")
    assert(rows[3].text == "--del" && rows[3].desc == "An alias for --delete-during", "--del")
    assert(rows[4].desc == "bell\u{B7}here", "a control byte drawn as a dot")
    assert(rows[5].text == "--bare" && !rows[5].has_desc, "--bare")
}

// `test_compfish.c:399-413`.
fn t_compfish_parse_caps_at_5000_lines() {
    var b = List[byte]()
    var i = 0
    while i < 6000 {
        for x in "row{i}\n".bytes() {
            (mut b).push(x)
        }
        i += 1
    }
    let rows = edit.compfish_parse(b)
    assert(rows.len == edit.COMPFISH_MAX_LINES, "capped at 5000")
}

/// A context with a command `tool` and the caret's stem.
fn ctx_of(line: str) -> edit.ShCtx {
    let b = bytes_of(line)
    let (ok, ctx) = edit.shctx_at(b, b.len)
    assert(ok, "lexes")
    ctx
}

fn stub_env(root: str) -> str {
    let stub = "{root}/fish"
    fs.write_text(stub, "#!/bin/sh\nexit 0\n") else |_| {}
    fs.set_mode(stub, 493) else |_| {}
    stub
}

// Port-only: the line fish sees for a context, and a lookup that misses
// queues under C's key (FNV-1a over fish, cwd and the line).
fn t_port_compfish_lookup_queues_under_the_key() {
    let root = "/tmp/yew-compfish-{os_pid()}-1"
    fs.remove_dir_all(root) else |_| {}
    fs.create_dir_all(root) else |_| {}
    let stub = stub_env(root)
    env_set("YEW_TEST_FISH", stub) else |_| {}
    let (has, line) = edit.compfish_line(ctx_of("tool $(pwd)   'two  words' x"))
    assert(
        has && same(line, bytes_of("tool '' two\\ \\ words ")),
        "the rebuilt words: {str_from_utf8(line) else ""}",
    )
    var ed = edit.ed_new()
    ed.ws_dir = root
    let l1 = edit.compfish_lookup(mut ed, ctx_of("tool b"), 1000)
    assert(l1.state == edit.FISH_PENDING, "a miss is pending")
    assert(l1.key.starts_with("fish:") && l1.key.len == 21, "the key: {l1.key}")
    assert(
        edit.compfish_queued(ed.fish) == 1 && edit.compfish_awaiting(ed.fish, l1.key),
        "queued, awaiting",
    )
    let l2 = edit.compfish_lookup(mut ed, ctx_of("tool b"), 1001)
    assert(l2.key == l1.key && edit.compfish_queued(ed.fish) == 1, "one request a key")
    var rows = List[edit.FishRow]()
    (mut rows).push(edit.
        FishRow { text: "build", desc: "compile it", has_desc: true, is_dir: false })
    edit.compfish_store(mut ed.fish, l1.key, 1002, true, take rows)
    let l3 = edit.compfish_lookup(mut ed, ctx_of("tool b"), 1003)
    assert(
        l3.state == edit.FISH_ROWS && l3.rows.len == 1 && l3.rows[0].text == "build",
        "the gate open: rows",
    )
    edit.compfish_store(mut ed.fish, l1.key, 1004, false, take List[edit.FishRow]())
    let l4 = edit.compfish_lookup(mut ed, ctx_of("tool b"), 1005)
    assert(l4.state == edit.FISH_CLOSED, "the gate closed")
    let l5 = edit.compfish_lookup(mut ed, ctx_of("tool"), 1006)
    assert(l5.state == edit.FISH_OFF, "COMMAND position never asks")
    env_unset("YEW_TEST_FISH") else |_| {}
    fs.remove_dir_all(root) else |_| {}
}

// Port-only: the idle path refuses by name (R-yw04-1) the way C handles
// a spawn failure — the oracle disabled, one log line, the queue gone.
fn t_port_compfish_idle_refuses_by_name() {
    let root = "/tmp/yew-compfish-{os_pid()}-2"
    fs.remove_dir_all(root) else |_| {}
    fs.create_dir_all(root) else |_| {}
    let stub = stub_env(root)
    env_set("YEW_TEST_FISH", stub) else |_| {}
    var ed = edit.ed_new()
    ed.ws_dir = root
    let l1 = edit.compfish_lookup(mut ed, ctx_of("tool b"), 1000)
    assert(l1.state == edit.FISH_PENDING, "queued")
    assert(edit.compfish_idle_ready(ed.fish, 0), "ready")
    assert(edit.compfish_idle(mut ed, 0) == 0, "no job")
    assert(edit.compfish_spawns(ed.fish) == 1, "one attempt")
    assert(edit.compfish_disabled(ed.fish), "disabled for the session")
    assert(edit.compfish_queued(ed.fish) == 0, "the queue dropped")
    assert(!edit.compfish_enabled(mut ed), "the ladder falls through")
    let log = fs.read_text(env_get("YEW_LOG") else "") else ""
    assert(
        log.contains(
            "completion: fish oracle disabled: not yet ported: the fish completion job: needs os_signal_wait_fds (G2, wolf-lang#795)",
        ),
        "logged once: {log}",
    )
    env_unset("YEW_TEST_FISH") else |_| {}
    fs.remove_dir_all(root) else |_| {}
}

// `test_compfish.c:...`: the option defaults to auto (the options model
// is yw09's; the port's reader defaults an absent `shell.complete_fish`
// to auto, as C's descriptor does, `option.c:344`), the stub seam makes
// the oracle enabled, an empty seam is "no fish".
fn t_compfish_default_auto_and_empty_seam() {
    let root = "/tmp/yew-compfish-{os_pid()}-3"
    fs.remove_dir_all(root) else |_| {}
    fs.create_dir_all(root) else |_| {}
    let stub = stub_env(root)
    env_set("YEW_TEST_FISH", stub) else |_| {}
    var ed = edit.ed_new()
    assert((ed.opts.store["shell.complete_fish"] else "auto") == "auto", "the default is auto")
    assert(edit.compfish_enabled(mut ed), "enabled with a fish")
    env_set("YEW_TEST_FISH", "") else |_| {}
    edit.compfish_reset(mut ed.fish)
    let (has, _) = edit.compfish_path(mut ed.fish)
    assert(!has, "an empty seam is no fish")
    assert(!edit.compfish_enabled(mut ed), "not enabled")
    env_unset("YEW_TEST_FISH") else |_| {}
    fs.remove_dir_all(root) else |_| {}
}

fn skip(name: str, why: str) -> int {
    print("compfish_test: SKIP {name}: {why}")
    eprint("compfish_test: SKIP {name}: {why}")
    1
}

fn main() {
    fs.create_dir_all("target/tests") else |_| {}
    let log = "target/tests/edit-compfish-test.log"
    fs.remove(log) else |_| {}
    env_set("YEW_LOG", log) else |_| {}
    let job = "runs a stub fish as a job whose pipe is read while the loop runs: needs os_signal_wait_fds (G2, wolf-lang#795), R-yw04-1"
    var skips = 0
    t_compfish_escapes_words_for_fish()
    t_compfish_query_stem_is_empty_dash_or_the_flag()
    t_compfish_parse_rows()
    t_compfish_parse_caps_at_5000_lines()
    let route = "drives the prompt's completion engine (cmdcomp and its shell source) through Tab: merged with the comp and prompt forks"
    for name in [
        "compfish_gate_open_rows_answer",
        "compfish_gate_closed_falls_through_to_help",
        "compfish_directories_and_requoting",
        "compfish_hostile_line_is_one_argv_element",
        "compfish_passes_rebuilt_words_not_the_raw_line",
        "compfish_query_stem_reaches_fish",
        "compfish_cache_hit_within_five_seconds",
        "compfish_spawn_failure_disables_once",
        "compfish_failed_exit_disables_once",
    ] {
        skips += skip(name, job)
    }
    for name in [
        "compfish_spec_precedence_never_queries",
        "compfish_shape_rows_never_query",
        "compfish_off_never_queries",
    ] {
        skips += skip(name, route)
    }
    t_compfish_default_auto_and_empty_seam()
    for name in [
        "compfish_spawns_only_on_the_idle_turn",
        "compfish_counts_toward_the_four_jobs",
        "compfish_real_fish_demo_and_gate",
        "compfish_runs_in_the_effective_directory",
    ] {
        skips += skip(name, job)
    }
    t_port_compfish_lookup_queues_under_the_key()
    t_port_compfish_idle_refuses_by_name()
    print("compfish_test: {21 - skips} C cases pass, {skips} SKIP; 2 port cases pass")
}
