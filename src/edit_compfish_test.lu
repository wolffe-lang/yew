//! member: false
//!
//! The port of sagitta `tests/unit/test_compfish.c` (1,065 lines), one
//! test per C test in registry order. Every oracle case runs against C's
//! STUB fish (`$YEW_TEST_FISH`, a script recording its argv one file per
//! element and printing canned rows) through the real prompt: `:` opened,
//! the line pasted, Tab, then the idle turns and the job pumps until the
//! answer lands (`ask`, `settle`, `test_compfish.c:214-267`) — the stub a
//! job whose pipe is read while the loop runs (wolf 0.2.34's
//! `os_signal_wait_fds`). `compfish_real_fish_demo_and_gate` runs real
//! fish where one is on PATH and SKIPs loudly by name where not, as C's
//! does. The gate-closed case's help tool is C's `help_fixture`, here a
//! copy of this binary (`YEW_HELPFIX=1`, as `edit_comphelp_test`). Under
//! `wolf test` `os_exe()` is `wolf` (G23): the job cases SKIP by name
//! there and the native run covers them. One port-only case keeps the
//! lookup's key.

use edit
use std.fs
use std.signal

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn escaped(word: List[byte]) -> List[byte] {
    var b = List[byte]()
    edit.compfish_escape(mut b, word)
    b
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

// `test_compfish.c:318-344`.
fn t_compfish_escapes_words_for_fish() {
    var ins = List[List[byte]]()
    var outs = List[List[byte]]()
    for row in [
        "plain-word_1.txt|plain-word_1.txt",
        "a b|a\\ b",
        "$HOME|\\$HOME",
        "*?~#|\\*\\?\\~\\#",
        "(){{}}[]|\\(\\)\\{{\\}}\\[\\]",
        "<>&;|\\<\\>\\&\\;",
        "\"'\\|\\\"\\'\\\\",
        "tab\there|tab\\there",
        "new\nline|new\\nline",
    ] {
        let bar = row.rfind("|") else 0
        (mut ins).push(bytes_of(row[0..bar]))
        (mut outs).push(bytes_of(row[bar + 1..]))
    }
    var bell = bytes_of("bell")
    (mut bell).push(7 as byte)
    (mut ins).push(bell)
    (mut outs).push(bytes_of("bell\\x07"))
    (mut ins).push(bytes_of("caf\u{E9}"))
    (mut outs).push(bytes_of("caf\u{E9}"))
    var pipe = bytes_of("<>&|;")
    (mut ins).push(pipe)
    (mut outs).push(bytes_of("\\<\\>\\&\\|\\;"))
    var i = 0
    while i < ins.len {
        assert(same(escaped(ins[i]), outs[i]), "escape row {i}")
        i += 1
    }
}

// `test_compfish.c:346-365`.
fn t_compfish_query_stem_is_empty_dash_or_the_flag() {
    for row in [
        "|",
        "bu|",
        "-|-",
        "-v|-",
        "--del|-",
        "--out=|--out=",
        "--out=x|--out=",
        "-o=x|-",
        ".g|.",
        "..|.",
    ] {
        let bar = row.find("|") else 0
        let got = edit.compfish_query_stem(bytes_of(row[0..bar]))
        assert(same(got, bytes_of(row[bar + 1..])), "query stem of `{row[0..bar]}`")
    }
}

// `test_compfish.c:367-397`.
fn t_compfish_parse_rows() {
    var out = bytes_of("a b.txt\nd$x\nsub/\n--del\tAn alias for --delete-during\n--odd\tbell")
    (mut out).push(7 as byte)
    for b in "here\n\na b.txt\nbad".bytes() {
        (mut out).push(b)
    }
    (mut out).push(1 as byte)
    for b in "name\tdropped\n--bare\t\n".bytes() {
        (mut out).push(b)
    }
    let rows = edit.compfish_parse(out)
    assert(rows.len == 6, "six rows, got {rows.len}")
    assert(rows[0].text == "a b.txt" && !rows[0].has_desc, "a b.txt")
    assert(rows[1].text == "d$x" && !rows[1].is_dir, "d$x")
    assert(rows[2].text == "sub" && rows[2].is_dir, "sub/ is a directory")
    assert(rows[3].text == "--del" && rows[3].desc == "An alias for --delete-during", "--del")
    assert(rows[4].desc == "bell\u{B7}here", "a control byte drawn as a dot")
    assert(rows[5].text == "--bare" && !rows[5].has_desc, "--bare")
}

// `test_compfish.c:399-413`.
fn t_compfish_parse_caps_at_5000_lines() {
    var b = List[byte]()
    var i = 0
    while i < 6000 {
        for x in "row{i}\n".bytes() {
            (mut b).push(x)
        }
        i += 1
    }
    let rows = edit.compfish_parse(b)
    assert(rows.len == edit.COMPFISH_MAX_LINES, "capped at 5000")
}

/// A context with a command `tool` and the caret's stem.
fn ctx_of(line: str) -> edit.ShCtx {
    let b = bytes_of(line)
    let (ok, ctx) = edit.shctx_at(b, b.len)
    assert(ok, "lexes")
    ctx
}

fn stub_env(root: str) -> str {
    let stub = "{root}/fish"
    fs.write_text(stub, "#!/bin/sh\nexit 0\n") else |_| {}
    fs.set_mode(stub, 493) else |_| {}
    stub
}

// Port-only: the line fish sees for a context, and a lookup that misses
// queues under C's key (FNV-1a over fish, cwd and the line).
fn t_port_compfish_lookup_queues_under_the_key() {
    let root = "/tmp/yew-compfish-{os_pid()}-1"
    fs.remove_dir_all(root) else |_| {}
    fs.create_dir_all(root) else |_| {}
    let stub = stub_env(root)
    env_set("YEW_TEST_FISH", stub) else |_| {}
    let (has, line) = edit.compfish_line(ctx_of("tool $(pwd)   'two  words' x"))
    assert(
        has && same(line, bytes_of("tool '' two\\ \\ words ")),
        "the rebuilt words: {str_from_utf8(line) else ""}",
    )
    var ed = edit.ed_new()
    ed.ws_dir = root
    let l1 = edit.compfish_lookup(mut ed, ctx_of("tool b"), 1000)
    assert(l1.state == edit.FISH_PENDING, "a miss is pending")
    assert(l1.key.starts_with("fish:") && l1.key.len == 21, "the key: {l1.key}")
    assert(
        edit.compfish_queued(ed.fish) == 1 && edit.compfish_awaiting(ed.fish, l1.key),
        "queued, awaiting",
    )
    let l2 = edit.compfish_lookup(mut ed, ctx_of("tool b"), 1001)
    assert(l2.key == l1.key && edit.compfish_queued(ed.fish) == 1, "one request a key")
    var rows = List[edit.FishRow]()
    (mut rows).push(edit.
        FishRow { text: "build", desc: "compile it", has_desc: true, is_dir: false })
    edit.compfish_store(mut ed.fish, l1.key, 1002, true, take rows)
    let l3 = edit.compfish_lookup(mut ed, ctx_of("tool b"), 1003)
    assert(
        l3.state == edit.FISH_ROWS && l3.rows.len == 1 && l3.rows[0].text == "build",
        "the gate open: rows",
    )
    edit.compfish_store(mut ed.fish, l1.key, 1004, false, take List[edit.FishRow]())
    let l4 = edit.compfish_lookup(mut ed, ctx_of("tool b"), 1005)
    assert(l4.state == edit.FISH_CLOSED, "the gate closed")
    let l5 = edit.compfish_lookup(mut ed, ctx_of("tool"), 1006)
    assert(l5.state == edit.FISH_OFF, "COMMAND position never asks")
    env_unset("YEW_TEST_FISH") else |_| {}
    fs.remove_dir_all(root) else |_| {}
}

// `test_compfish.c:...`: the option defaults to auto (the options model
// is yw09's; the port's reader defaults an absent `shell.complete_fish`
// to auto, as C's descriptor does, `option.c:344`), the stub seam makes
// the oracle enabled, an empty seam is "no fish".
fn t_compfish_default_auto_and_empty_seam() {
    let root = "/tmp/yew-compfish-{os_pid()}-3"
    fs.remove_dir_all(root) else |_| {}
    fs.create_dir_all(root) else |_| {}
    let stub = stub_env(root)
    env_set("YEW_TEST_FISH", stub) else |_| {}
    var ed = edit.ed_new()
    assert((ed.opts.store["shell.complete_fish"] else "auto") == "auto", "the default is auto")
    assert(edit.compfish_enabled(mut ed), "enabled with a fish")
    env_set("YEW_TEST_FISH", "") else |_| {}
    edit.compfish_reset(mut ed.fish)
    let (has, _) = edit.compfish_path(mut ed.fish)
    assert(!has, "an empty seam is no fish")
    assert(!edit.compfish_enabled(mut ed), "not enabled")
    env_unset("YEW_TEST_FISH") else |_| {}
    fs.remove_dir_all(root) else |_| {}
}

// The stub (`test_compfish.c:51-80`): `$1..$7` are `-N --private -c
// QUERY -- LINE CMD`. Rows come from `<cmd>.rows` (or `<cmd>.flags` for a
// `-` query stem); no file, no output. `<cmd>.fail` exits 3 with nothing
// printed; `<cmd>.hold` waits.
fn stub_script() -> str {
    "#!/bin/sh\nPATH=/usr/bin:/bin\nd=$(dirname \"$0\")\nn=0\nfor a in \"$@\"; do n=$((n+1)); printf '%s' \"$a\" > \"$d/arg.$n\"; done\necho \"$n\" > \"$d/argc\"\necho call >> \"$d/calls\"\npwd > \"$d/cwd\"\nline=$6\ncmd=$7\ni=0\nwhile [ -e \"$d/$cmd.hold\" ] && [ $i -lt 3000 ]; do sleep 0.02; i=$((i+1)); done\nif [ -e \"$d/$cmd.fail\" ]; then exit 3; fi\ncase \"$line\" in\n  *' -') f=\"$d/$cmd.flags\" ;;\n  *) f=\"$d/$cmd.rows\" ;;\nesac\nif [ -e \"$f\" ]; then cat \"$f\"; fi\nexit 0\n"
}

/// C's `FishFix` (`test_compfish.c:82-136`) over `compspec_fix.h`: the
/// stub on `$YEW_TEST_FISH`, `$PATH` a bare `bin/` (no tool the help
/// layer could run unless a test installs one), the config, home and
/// state homes the fixture's, the runtime loaded, an editor rooted there.
struct FishFix {
    root: str,
    stubdir: str,
    stub: str,
    bin: str,
    config: str,
    names: List[str],
    saved: List[str],
    had: List[bool],
}

fn env_copy(name: str) -> (str, bool) {
    let v = env_get(name) else |_| { return ("", false) }
    (v, true)
}

fn env_back(name: str, v: str, had: bool) {
    if had {
        env_set(name, v) else |_| {}
    } else {
        env_unset(name) else |_| {}
    }
}

fn put(path: str, text: str, mode: int) {
    fs.write_text(path, text) else |_| { assert(false, "write {path}") }
    fs.set_mode(path, mode) else |_| { assert(false, "chmod {path}") }
}

fn fish_fix_init(tag: str) -> (FishFix, edit.Ed) {
    let root = "/tmp/yew-compspec-{os_pid()}-fish-{tag}"
    fs.remove_dir_all(root) else |_| {}
    for d in ["stub", "bin", "config/yew/completions", "home", "state"] {
        fs.create_dir_all("{root}/{d}") else |_| { assert(false, "mkdir {d}") }
    }
    var f = FishFix {
        root: root,
        stubdir: "{root}/stub",
        stub: "{root}/stub/fish",
        bin: "{root}/bin",
        config: "{root}/config",
        names: List[str](),
        saved: List[str](),
        had: List[bool](),
    }
    put(f.stub, stub_script(), 493)
    for n in [
        "YEW_TEST_FISH",
        "PATH",
        "YEW_RUNTIME_DIR",
        "XDG_CONFIG_HOME",
        "HOME",
        "XDG_STATE_HOME",
    ] {
        let (v, h) = env_copy(n)
        (mut f.names).push(n)
        (mut f.saved).push(v)
        (mut f.had).push(h)
    }
    let cwd = os_cwd() else ""
    env_set("YEW_TEST_FISH", f.stub) else |_| {}
    env_set("PATH", f.bin) else |_| {}
    env_set("YEW_RUNTIME_DIR", "{cwd}/runtime") else |_| {}
    env_set("XDG_CONFIG_HOME", f.config) else |_| {}
    env_set("HOME", "{root}/home") else |_| {}
    env_set("XDG_STATE_HOME", "{root}/state") else |_| {}
    let rt = fs_read_bytes("runtime/init.fl") else List[byte]()
    assert(rt.len != 0, "runtime/init.fl is readable from the repository root")
    var ed = edit.ed_new_test(rt, "")
    ed.ws_dir = root
    (f, ed)
}

fn fish_fix_drop(f: FishFix, mut ed: edit.Ed) {
    if ed.cmdline.active {
        edit.cmdline_close(mut ed, false)
    }
    edit.jobs_free(mut ed)
    var i = 0
    while i < f.names.len {
        env_back(f.names[i], f.saved[i], f.had[i])
        i += 1
    }
    assert(f.root.starts_with("/tmp/yew-"), "only /tmp/yew-*")
    fs.remove_dir_all(f.root) else |_| { assert(false, "remove {f.root}") }
}

// `stub_file` / `stub_unlink` (`test_compfish.c:138-155`).
fn stub_file(f: FishFix, cmd: str, what: str, text: str) {
    put("{f.stubdir}/{cmd}.{what}", text, 420)
}

fn stub_unlink(f: FishFix, cmd: str, what: str) {
    fs.remove("{f.stubdir}/{cmd}.{what}") else |_| { assert(false, "unlink {cmd}.{what}") }
}

// `stub_arg` (`test_compfish.c:157-175`): element `i` of the last call.
fn stub_arg(f: FishFix, i: int) -> (bool, str) {
    let path = "{f.stubdir}/arg.{i}"
    if !fs.exists(path) {
        return (false, "")
    }
    (true, fs.read_text(path) else "")
}

fn arg_is(f: FishFix, i: int, want: str) {
    let (has, got) = stub_arg(f, i)
    assert(has && got == want, "argv[{i}]: `{got}`, want `{want}`")
}

// `stub_calls` (`test_compfish.c:177-195`).
fn stub_calls(f: FishFix) -> int {
    let t = fs.read_text("{f.stubdir}/calls") else ""
    var n = 0
    for b in t.bytes() {
        if b as int == 10 {
            n += 1
        }
    }
    n
}

// `pump` (`test_compfish.c:197-212`).
fn pump(mut ed: edit.Ed, ms: int) {
    let fds = edit.job_wait_fds(ed)
    if fds.len != 0 {
        let _ = os_signal_wait_fds(fds, signal.child(), ms) else |_| { (-1, 0) }
    } else if ms > 0 {
        time_sleep_ms(ms)
    }
    edit.job_pump(mut ed)
    edit.job_reap(mut ed)
    edit.job_tick(mut ed, time_now_ms())
    let _ = edit.job_settle(mut ed)
}

// `settle` (`test_compfish.c:214-230`): idle turns and job pumps until
// nothing is queued or in flight.
fn settle(mut ed: edit.Ed) {
    let start = time_now_ms()
    while (
        edit.compfish_inflight(ed.fish) != 0 ||
            edit.comphelp_inflight(ed.help) != 0 ||
            edit.comp_shell_idle_ready(ed) ||
            edit.cmdline_comp_idle_pending(ed)
    ) &&
        time_now_ms() - start < 10000 {
        if ed.cmdline.active {
            let _ = edit.cmdline_comp_idle(mut ed)
        } else {
            let _ = edit.comp_shell_idle(mut ed)
        }
        pump(mut ed, 10)
    }
    assert(edit.compfish_inflight(ed.fish) == 0, "no fish in flight")
    assert(edit.comphelp_inflight(ed.help) == 0, "no help in flight")
}

fn prompt_text(ed: edit.Ed) -> str {
    str_from_utf8(edit.cmdline_text(ed)) else "?"
}

fn tab(mut ed: edit.Ed) {
    let cx = edit.cmdctx_new(ed.win, 0)
    let _ = edit.cmdline_complete_next_cmd(mut ed, cx)
}

// `ask` (`test_compfish.c:257-267`): open `:`, type `line`, Tab, let the
// oracle answer.
fn ask(mut ed: edit.Ed, line: str) {
    if ed.cmdline.active {
        edit.cmdline_close(mut ed, false)
    }
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    edit.cmdline_paste(mut ed, bytes_of(line))
    tab(mut ed)
    settle(mut ed)
}

// `complete_line` (`test_compfish.c:269-278`): ask, then — when the first
// Tab only waited — the Tab that completes from the answer.
fn complete_line(mut ed: edit.Ed, line: str) {
    ask(mut ed, line)
    if prompt_text(ed) == line {
        tab(mut ed)
    }
}

fn assert_prompt(ed: edit.Ed, want: str) {
    assert(prompt_text(ed) == want, "the prompt: `{prompt_text(ed)}`, want `{want}`")
}

// `menu_row` (`test_compfish.c:289-298`): the row's index, or -1.
fn menu_row(ed: edit.Ed, t: str) -> int {
    var i = 0
    while i < ed.cmdline.menu.items.len {
        if edit.comp_bytes_is(ed.cmdline.menu.items[i].text, t) {
            return i
        }
        i += 1
    }
    -1
}

fn log_path() -> str {
    env_get("YEW_LOG") else ""
}

// `yew_test_capture_log`: the log from here on.
fn capture_log() {
    fs.write_text(log_path(), "") else |_| {}
}

fn log_lines() -> int {
    let t = fs.read_text(log_path()) else ""
    var n = 0
    for b in t.bytes() {
        if b as int == 10 {
            n += 1
        }
    }
    n
}

// `test_compfish.c:435-457`: gate open, rows answer.
fn t_compfish_gate_open_rows_answer() {
    var (f, ed) = fish_fix_init("open")
    stub_file(f, "tool", "rows", "build\tcompile it\nbench\trun the benchmarks\n")
    ask(mut ed, "!tool b")
    assert_prompt(ed, "!tool b")
    assert(!ed.cmdline.filter.gen_pending, "answered")
    let r = menu_row(ed, "build")
    assert(r >= 0, "build")
    assert(ed.cmdline.menu.items[r].kind == edit.COMP_GEN, "a generator row")
    assert(ed.cmdline.menu.items[r].detail == "compile it", "its detail")
    assert(menu_row(ed, "bench") >= 0, "bench")
    edit.cmdline_paste(mut ed, bytes_of("u"))
    tab(mut ed)
    assert_prompt(ed, "!tool build ")
    assert(stub_calls(f) == 1, "fish asked once")
    fish_fix_drop(f, mut ed)
}

// `test_compfish.c:459-495`: gate closed, the help rung answers.
fn t_compfish_gate_closed_falls_through_to_help() {
    var (f, ed) = fish_fix_init("closed")
    let exe = os_exe() else ""
    let b = fs.read_bytes(exe) else List[byte]()
    assert(b.len > 4, "the help fixture")
    fs.write_bytes("{f.bin}/helped", b) else |_| { assert(false, "install") }
    fs.set_mode("{f.bin}/helped", 493) else |_| {}
    put(
        "{f.bin}/helped.help",
        "Usage: helped <COMMAND>\n\nCommands:\n  deploy  Ship it\n  doctor  Check it\n",
        420,
    )
    ask(mut ed, "!helped d")
    assert(stub_calls(f) == 1, "fish asked once")
    assert(edit.comphelp_spawns(ed.help) == 1, "then help")
    assert(!ed.cmdline.filter.gen_pending, "answered")
    let r = menu_row(ed, "deploy")
    assert(r >= 0, "deploy")
    assert(ed.cmdline.menu.items[r].kind == edit.COMP_SPEC, "a spec row from the help tree")
    fish_fix_drop(f, mut ed)
}

// `test_compfish.c:497-520`: a directory keeps its `/`, no space; raw
// names are re-quoted on insert.
fn t_compfish_directories_and_requoting() {
    var (f, ed) = fish_fix_init("dirs")
    stub_file(f, "tool", "rows", "a b.txt\nd$x\nsubdir/\n")
    ask(mut ed, "!tool su")
    let r = menu_row(ed, "subdir/")
    assert(r >= 0 && ed.cmdline.menu.items[r].is_dir, "subdir/ is a directory")
    tab(mut ed)
    assert_prompt(ed, "!tool subdir/")
    complete_line(mut ed, "!tool a")
    assert_prompt(ed, "!tool a\\ b.txt ")
    complete_line(mut ed, "!tool d")
    assert_prompt(ed, "!tool d\\$x ")
    fish_fix_drop(f, mut ed)
}

// §2's pitfall (`test_compfish.c:522-567`): the hostile word arrives
// inside ONE argv element, and the script is the fixed text.
fn t_compfish_hostile_line_is_one_argv_element() {
    var (f, ed) = fish_fix_init("hostile")
    ask(mut ed, "!tool \"x'; rm -rf ~; '\" ")
    arg_is(f, 6, "tool x\\'\\;\\ rm\\ -rf\\ \\~\\;\\ \\' ")
    arg_is(f, 4, edit.compfish_query())
    arg_is(f, 7, "tool")
    arg_is(f, 1, "-N")
    arg_is(f, 2, "--private")
    arg_is(f, 5, "--")
    let (has0, _) = stub_arg(f, 0)
    assert(!has0, "no element 0")
    let argc = fs.read_text("{f.stubdir}/argc") else ""
    assert(argc.starts_with("7\n"), "seven elements: `{argc}`")
    assert(!edit.compfish_query().contains("rm"), "the script never carries the line")
    fish_fix_drop(f, mut ed)
}

// `test_compfish.c:569-585`: the rebuilt words, not the raw text.
fn t_compfish_passes_rebuilt_words_not_the_raw_line() {
    var (f, ed) = fish_fix_init("rebuilt")
    ask(mut ed, "!tool $(pwd)   'two  words' x")
    arg_is(f, 6, "tool '' two\\ \\ words ")
    fish_fix_drop(f, mut ed)
}

// `test_compfish.c:587-612`: `""` serves every stem in a slot; `-` asks
// for flags.
fn t_compfish_query_stem_reaches_fish() {
    var (f, ed) = fish_fix_init("stem")
    stub_file(f, "tool", "flags", "--verbose\tsay more\n-q\tquiet\n")
    ask(mut ed, "!tool --ve")
    arg_is(f, 6, "tool -")
    assert(menu_row(ed, "--verbose") >= 0, "--verbose")
    tab(mut ed)
    assert_prompt(ed, "!tool --verbose ")
    ask(mut ed, "!tool zz")
    arg_is(f, 6, "tool ")
    ask(mut ed, "!tool --out=a")
    arg_is(f, 6, "tool --out=")
    fish_fix_drop(f, mut ed)
}

// `test_compfish.c:614-640`: fresh for 5000 ms; an aged answer is served
// and refreshed.
fn t_compfish_cache_hit_within_five_seconds() {
    var (f, ed) = fish_fix_init("cache")
    stub_file(f, "tool", "rows", "build\tcompile it\nbench\tmeasure\n")
    ask(mut ed, "!tool b")
    assert(stub_calls(f) == 1, "asked once")
    ask(mut ed, "!tool q")
    ask(mut ed, "!tool zz")
    assert(stub_calls(f) == 1, "the same slot asks once")
    assert(edit.compfish_spawns(ed.fish) == 1, "one spawn")
    edit.compfish_age(mut ed.fish, edit.COMPFISH_FRESH_MS + 1)
    edit.cmdline_close(mut ed, false)
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    edit.cmdline_paste(mut ed, bytes_of("!tool b"))
    assert(menu_row(ed, "build") >= 0, "served stale at once")
    assert(!ed.cmdline.filter.gen_pending, "no marker")
    settle(mut ed)
    assert(menu_row(ed, "build") >= 0, "still served")
    assert(stub_calls(f) == 2, "refreshed behind it")
    fish_fix_drop(f, mut ed)
}

// `test_compfish.c:642-664`: a missing fish disables the oracle once,
// with one log line; the help rung answers from then on.
fn t_compfish_spawn_failure_disables_once() {
    var (f, ed) = fish_fix_init("spawnfail")
    env_set("YEW_TEST_FISH", "{f.stubdir}/no-such-fish") else |_| {}
    edit.compfish_reset(mut ed.fish)
    capture_log()
    ask(mut ed, "!tool b")
    assert(edit.compfish_disabled(ed.fish), "disabled")
    assert(!ed.cmdline.filter.gen_pending, "no marker")
    assert(!edit.compfish_enabled(mut ed), "not enabled")
    ask(mut ed, "!tool c")
    ask(mut ed, "!other d")
    assert(edit.compfish_spawns(ed.fish) == 1, "one spawn")
    let log = fs.read_text(log_path()) else ""
    assert(log_lines() == 1, "one log line: `{log}`")
    assert(log.contains("fish oracle disabled"), "the line: `{log}`")
    fish_fix_drop(f, mut ed)
}

// `test_compfish.c:666-680`: a non-zero exit with nothing printed.
fn t_compfish_failed_exit_disables_once() {
    var (f, ed) = fish_fix_init("failexit")
    stub_file(f, "tool", "fail", "")
    capture_log()
    ask(mut ed, "!tool b")
    assert(edit.compfish_disabled(ed.fish), "disabled")
    ask(mut ed, "!tool c")
    assert(stub_calls(f) == 1, "asked once")
    let log = fs.read_text(log_path()) else ""
    assert(log_lines() == 1, "one log line: `{log}`")
    fish_fix_drop(f, mut ed)
}

// `test_compfish.c:682-700`: a spec'd command never asks fish.
fn t_compfish_spec_precedence_never_queries() {
    var (f, ed) = fish_fix_init("spec")
    stub_file(f, "wolf", "rows", "bogus\tfrom fish\n")
    for line in ["!wolf bu", "!git sta", "!echo x", "!cd s"] {
        ask(mut ed, line)
    }
    assert(stub_calls(f) == 0, "the stub never ran")
    assert(fs.exists(f.stubdir), "the stub dir")
    assert(!fs.exists("{f.stubdir}/argc"), "no argc")
    fish_fix_drop(f, mut ed)
}

// `test_compfish.c:702-716`: shape rows win.
fn t_compfish_shape_rows_never_query() {
    var (f, ed) = fish_fix_init("shape")
    for line in ["!tool ./zz", "!tool $ZZ_NO_SUCH_VAR", "!tool ~zz-no-such-user", "!tool zz/zz"] {
        ask(mut ed, line)
    }
    assert(stub_calls(f) == 0, "the stub never ran")
    fish_fix_drop(f, mut ed)
}

// `test_compfish.c:718-730`: `off` asks nothing.
fn t_compfish_off_never_queries() {
    var (f, ed) = fish_fix_init("off")
    ed.opts.store["shell.complete_fish"] = "off"
    stub_file(f, "tool", "rows", "build\tcompile it\n")
    ask(mut ed, "!tool b")
    assert(stub_calls(f) == 0, "the stub never ran")
    assert(menu_row(ed, "build") < 0, "no row from fish")
    fish_fix_drop(f, mut ed)
}

// `test_compfish.c:756-788`: nothing spawns on the keystroke path, Tab
// included; the idle turn spawns; one fish job at a time.
fn t_compfish_spawns_only_on_the_idle_turn() {
    var (f, ed) = fish_fix_init("idle")
    stub_file(f, "tool", "rows", "build\tcompile it\n")
    stub_file(f, "tool", "hold", "")
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    edit.cmdline_paste(mut ed, bytes_of("!tool bu"))
    assert(ed.jobs.v.len == 0, "nothing on a keystroke")
    tab(mut ed)
    assert(ed.jobs.v.len == 0 && edit.compfish_spawns(ed.fish) == 0, "nothing on a Tab")
    assert(ed.cmdline.filter.gen_pending, "pending")
    assert_prompt(ed, "!tool bu")
    assert(edit.cmdline_comp_idle_pending(ed), "idle work")
    assert(edit.loop_deadline(ed, time_now_ms()) == 0, "the loop does not sleep on it")
    assert(edit.cmdline_comp_idle(mut ed) == 1, "the idle turn spawns")
    assert(edit.compfish_inflight(ed.fish) == 1, "one in flight")
    edit.cmdline_paste(mut ed, bytes_of(" x "))
    assert(edit.cmdline_comp_idle(mut ed) == 0, "a second slot waits")
    assert(edit.compfish_inflight(ed.fish) == 1, "still one")
    assert(edit.compfish_queued(ed.fish) >= 1, "queued")
    stub_unlink(f, "tool", "hold")
    settle(mut ed)
    assert(edit.compfish_spawns(ed.fish) == 2, "both ran: {edit.compfish_spawns(ed.fish)}")
    edit.cmdline_close(mut ed, false)
    fish_fix_drop(f, mut ed)
}

// `test_compfish.c:790-810`: a fish job holds one of the four slots.
fn t_compfish_counts_toward_the_four_jobs() {
    var (f, ed) = fish_fix_init("four")
    stub_file(f, "tool", "hold", "")
    edit.cmdline_open(mut ed, edit.PROMPT_CMD, "")
    edit.cmdline_paste(mut ed, bytes_of("!tool "))
    assert(edit.cmdline_comp_idle(mut ed) == 1, "spawned")
    assert(edit.compfish_inflight(ed.fish) == 1, "one fish")
    assert(
        edit.compgen_inflight(ed.gen) +
            edit.comphelp_inflight(ed.help) +
            edit.compfish_inflight(ed.fish) ==
            1,
        "one of the four",
    )
    assert(!edit.compfish_idle_ready(ed.fish, 0), "no second fish")
    stub_unlink(f, "tool", "hold")
    settle(mut ed)
    edit.cmdline_close(mut ed, false)
    fish_fix_drop(f, mut ed)
}

// `real_fish_path` (`test_compfish.c:814-838`): the first `fish` on the
// real PATH.
fn real_fish_path() -> (bool, str) {
    let path = env_get("PATH") else |_| { return (false, "") }
    for dir in path.split(":") {
        if dir.len != 0 && dir.starts_with("/") && edit.job_exec_ok("{dir}/fish") {
            return (true, "{dir}/fish")
        }
    }
    (false, "")
}

// `run_fish` (`test_compfish.c:840-903`): `fish -N --private -c script --
// a1 a2` in `cwd`, stdin and stderr at /dev/null; its stdout.
fn run_fish(mut ed: edit.Ed, fish: str, cwd: str, script: str, a1: str, a2: str) -> str {
    var spec = edit.job_spec_new()
    for a in [fish, "-N", "--private", "-c", script, "--", a1, a2] {
        (mut spec.argv).push(a)
    }
    spec.cwd = cwd
    spec.has_cwd = true
    spec.sink = edit.SINK_COLLECT
    spec.internal = true
    let (id, err) = edit.job_spawn(mut ed, mut spec)
    assert(id != 0, "fish runs: {err}")
    let start = time_now_ms()
    loop {
        let i = edit.job_find(ed, id)
        assert(i >= 0, "the fish job")
        if ed.jobs.v[i].drained {
            let out = str_from_utf8(ed.jobs.v[i].collect) else ""
            edit.job_release(mut ed, id)
            return out
        }
        pump(mut ed, 20)
        assert(time_now_ms() - start < 20000, "fish answered in 20 s")
    }
    ""
}

fn fact(cond: bool, what: str) {
    if !cond {
        eprint("compfish_test: fish changed a measured fact: {what}")
    }
    assert(cond, "fish changed a measured fact: {what}")
}

// DoD 3 (`test_compfish.c:905-1032`): the fixture's completions answer,
// `nosuchtool ` is gated closed; first, §2's measured facts.
fn t_compfish_real_fish_demo_and_gate() -> bool {
    let (has_fish, fish) = real_fish_path()
    if !has_fish {
        print("compfish_test: SKIP compfish_real_fish_demo_and_gate: real-fish: fish not on PATH")
        eprint("compfish_test: SKIP compfish_real_fish_demo_and_gate: real-fish: fish not on PATH")
        return false
    }
    let no_prepend = "set -l r (complete -C -- $argv[1]); printf '%s\\n' $r"
    let rules_count = "set -p fish_complete_path $__fish_config_dir/completions; set -p fish_function_path $__fish_config_dir/functions; complete -C -- $argv[1] >/dev/null; complete -c $argv[2] | count"
    var (f, ed) = fish_fix_init("real")
    env_set("YEW_TEST_FISH", fish) else |_| {}
    edit.compfish_reset(mut ed.fish)
    fs.create_dir_all("{f.config}/fish/completions") else |_| {}
    fs.create_dir_all("{f.config}/fish/functions") else |_| {}
    put(
        "{f.config}/fish/completions/demo.fish",
        "complete -c demo -f -a '(__demo_items)'\ncomplete -c demo -l verbose -d 'Say more'\n",
        420,
    )
    put(
        "{f.config}/fish/functions/__demo_items.fish",
        "function __demo_items\n    printf '%s\\t%s\\n' alpha 'first item' beta 'second item'\nend\n",
        420,
    )
    put("{f.root}/a b.txt", "x", 420)
    put("{f.root}/d$x", "x", 420)
    fs.create_dir("{f.root}/somedir") else |_| {}
    let q = edit.compfish_query()
    let o0 = run_fish(mut ed, fish, f.root, q, "demo ", "demo")
    fact(o0 == "", "a completion file now loads for a command not on PATH")
    put("{f.bin}/demo", "#!/bin/sh\nexit 0\n", 493)
    let o1 = run_fish(mut ed, fish, f.root, no_prepend, "demo ", "demo")
    fact(!o1.contains("alpha"), "fish -N now loads ~/.config/fish/completions")
    let o2 = run_fish(mut ed, fish, f.root, q, "demo ", "demo")
    fact(
        o2.contains("alpha\tfirst item\n") && o2.contains("beta\tsecond item\n"),
        "the prepended completion/function dirs no longer answer",
    )
    let o4 = run_fish(mut ed, fish, f.root, no_prepend, "nosuchtool ", "nosuchtool")
    fact(
        o4.contains("a b.txt\n") && o4.contains("d$x\n"),
        "unknown commands no longer list the cwd's files raw",
    )
    fact(o4.contains("somedir/\n"), "directories no longer end in /")
    let o6 = run_fish(mut ed, fish, f.root, rules_count, "demo ", "demo")
    fact((o6.trim().to_int() else 0) > 0, "complete -c demo lists no rules after autoload")
    let o7 = run_fish(mut ed, fish, f.root, rules_count, "nosuchtool ", "nosuchtool")
    fact((o7.trim().to_int() else 0) == 0, "complete -c lists rules for an unknown command")
    let o8 = run_fish(mut ed, fish, f.root, q, "nosuchtool ", "nosuchtool")
    fact(o8 == "", "the gate no longer closes for an unknown command")
    ask(mut ed, "!demo ")
    let ra = menu_row(ed, "alpha")
    assert(ra >= 0, "alpha")
    assert(ed.cmdline.menu.items[ra].detail == "first item", "its detail")
    assert(menu_row(ed, "beta") >= 0, "beta")
    ask(mut ed, "!demo --verb")
    let rv = menu_row(ed, "--verbose")
    assert(rv >= 0 && ed.cmdline.menu.items[rv].detail == "Say more", "--verbose")
    let ctx = ctx_of("nosuchtool ")
    let _ = edit.compfish_lookup(mut ed, ctx, time_now_ms())
    settle(mut ed)
    let l = edit.compfish_lookup(mut ed, ctx, time_now_ms())
    assert(l.state == edit.FISH_CLOSED, "the gate closed")
    ask(mut ed, "!demo \"x'; touch PWNED; '\" '$(touch PWNED2)' `touch PWNED3` ")
    assert(!fs.exists("{f.root}/PWNED"), "PWNED")
    assert(!fs.exists("{f.root}/PWNED2"), "PWNED2")
    assert(!fs.exists("{f.root}/PWNED3"), "PWNED3")
    fish_fix_drop(f, mut ed)
    true
}

// 57.32 §3 (`test_compfish.c:1034-1065`): fish runs in the directory the
// command will run in, keyed on it; not asked when it is unknown.
fn t_compfish_runs_in_the_effective_directory() {
    var (f, ed) = fish_fix_init("cwd")
    fs.create_dir("{f.root}/sub") else |_| { assert(false, "mkdir sub") }
    stub_file(f, "tool", "rows", "build\tcompile it\n")
    ask(mut ed, "!cd sub && tool b")
    assert(menu_row(ed, "build") >= 0, "build")
    assert(ed.cmdline.menu.where == "in sub/", "the note: `{ed.cmdline.menu.where}`")
    let c1 = fs.read_text("{f.stubdir}/cwd") else ""
    assert(c1.len > 5 && c1.ends_with("/sub\n"), "ran in sub: `{c1}`")
    let calls = stub_calls(f)
    ask(mut ed, "!tool b")
    assert(stub_calls(f) == calls + 1, "another question")
    let c2 = fs.read_text("{f.stubdir}/cwd") else ""
    assert(c2.len > 5 && !c2.ends_with("/sub\n"), "ran at the root: `{c2}`")
    let calls2 = stub_calls(f)
    ask(mut ed, "!cd $X && tool b")
    ask(mut ed, "!mkdir new && cd new && tool b")
    assert(stub_calls(f) == calls2, "unknown: not asked")
    fish_fix_drop(f, mut ed)
}

fn skip(name: str, why: str) -> int {
    print("compfish_test: SKIP {name}: {why}")
    eprint("compfish_test: SKIP {name}: {why}")
    1
}

// C's `tests/helpers/help_fixture.c` (as `edit_comphelp_test`'s): run when
// a copy of this binary is a fixture tool (`YEW_HELPFIX=1`).
fn help_fixture_main() -> int {
    let me = os_exe() else "help_fixture"
    let args = env_args()
    let help = args.len >= 1 && args[args.len - 1] == "--help"
    var stdin_is = "data"
    let _ = fs_read_chunk(0, 16) else |e| match e {
        eof => {
            stdin_is = "eof"
            List[byte]()
        },
        io => {
            stdin_is = "err"
            List[byte]()
        },
    }
    var line = me
    for a in args {
        line += " {a}"
    }
    let prior = fs.read_text("{me}.log") else ""
    fs.write_text("{me}.log", "{prior}{line} stdin={stdin_is}\n") else |_| {}
    var waited = 0
    while fs.exists("{me}.hold") && waited < 3000 {
        time_sleep_ms(20)
        waited += 1
    }
    if !help {
        fs.write_text("{me}.ran", "") else |_| {}
        return 0
    }
    var path = me
    var i = 0
    while i < args.len - 1 {
        path += ".{args[i]}"
        i += 1
    }
    let out = fs.read_bytes("{path}.help") else List[byte]()
    fs_write_chunk(1, out) else |_| {}
    let err = fs.read_bytes("{path}.help2") else List[byte]()
    fs_write_chunk(2, err) else |_| {}
    2
}

fn main() {
    // The session's `--yew-env0` runs this binary (`unit_main.c:14-19`).
    if edit.shsession_env0_requested() {
        os_exit(edit.shsession_env0_main())
    }
    if (env_get("YEW_HELPFIX") else "") == "1" {
        os_exit(help_fixture_main())
    }
    fs.create_dir_all("target/tests") else |_| {}
    let log = "target/tests/edit-compfish-test.log"
    fs.remove(log) else |_| {}
    env_set("YEW_LOG", log) else |_| {}
    env_set("YEW_HELPFIX", "1") else |_| {}
    signal.listen(signal.child()) else |_| {}
    let exe = os_exe() else ""
    let under_wolf = exe.ends_with("/wolf") || exe == "wolf"
    let job = "the stub fish runs as a job and the help fixture is a copy of os_exe(), which is `wolf` under wolf test (G23): the native run covers it"
    var skips = 0
    t_compfish_escapes_words_for_fish()
    t_compfish_query_stem_is_empty_dash_or_the_flag()
    t_compfish_parse_rows()
    t_compfish_parse_caps_at_5000_lines()
    if under_wolf {
        for name in [
            "compfish_gate_open_rows_answer",
            "compfish_gate_closed_falls_through_to_help",
            "compfish_directories_and_requoting",
            "compfish_hostile_line_is_one_argv_element",
            "compfish_passes_rebuilt_words_not_the_raw_line",
            "compfish_query_stem_reaches_fish",
            "compfish_cache_hit_within_five_seconds",
            "compfish_spawn_failure_disables_once",
            "compfish_failed_exit_disables_once",
        ] {
            skips += skip(name, job)
        }
    } else {
        t_compfish_gate_open_rows_answer()
        t_compfish_gate_closed_falls_through_to_help()
        t_compfish_directories_and_requoting()
        t_compfish_hostile_line_is_one_argv_element()
        t_compfish_passes_rebuilt_words_not_the_raw_line()
        t_compfish_query_stem_reaches_fish()
        t_compfish_cache_hit_within_five_seconds()
        t_compfish_spawn_failure_disables_once()
        t_compfish_failed_exit_disables_once()
    }
    // Fish is never asked here, so these run on both machines.
    t_compfish_spec_precedence_never_queries()
    t_compfish_shape_rows_never_query()
    t_compfish_off_never_queries()
    t_compfish_default_auto_and_empty_seam()
    if under_wolf {
        for name in [
            "compfish_spawns_only_on_the_idle_turn",
            "compfish_counts_toward_the_four_jobs",
            "compfish_real_fish_demo_and_gate",
            "compfish_runs_in_the_effective_directory",
        ] {
            skips += skip(name, job)
        }
    } else {
        t_compfish_spawns_only_on_the_idle_turn()
        t_compfish_counts_toward_the_four_jobs()
        if !t_compfish_real_fish_demo_and_gate() {
            skips += 1
        }
        t_compfish_runs_in_the_effective_directory()
    }
    t_port_compfish_lookup_queues_under_the_key()
    print("compfish_test: {21 - skips} C cases pass, {skips} SKIP; 1 port case passes")
}
