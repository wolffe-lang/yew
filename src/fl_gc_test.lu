//! member: false
//! sagitta 9ace98c2 tests/unit/test_fl_gc.c: root drop discipline.
//! Moving collector adds remapping, generation, cycle and residency witnesses.

use fl

fn root_set(mut vm: fl.FlVm, kind: int, v: fl.FlValue) {
    match kind {
        0 => { vm.stack[0] = v; vm.sp = 1 },
        1 => { (mut vm.frames).push(fl.FlFrame { cl: v, ip: 0, base: 0, call_pc: 0, via_native: 0, edit_depth: 0 }) },
        2 => { (mut vm.open_upvals).push(v) },
        3 => { vm.globals = v },
        4 => { vm.modules = v },
        5 => { vm.builtins = v },
        6 => { vm.prelude = v },
        7 => { vm.err = v },
        8 => { (mut vm.host_roots).push(v) },
        9 => { fl.fl_gc_protect(mut vm, v) },
        _ => { (mut vm.compiling).push(v) },
    }
}

fn root_get(vm: fl.FlVm, kind: int) -> fl.FlValue {
    match kind {
        0 => copy vm.stack[0],
        1 => copy vm.frames[0].cl,
        2 => copy vm.open_upvals[0],
        3 => copy vm.globals,
        4 => copy vm.modules,
        5 => copy vm.builtins,
        6 => copy vm.prelude,
        7 => copy vm.err,
        8 => copy vm.host_roots[0],
        9 => fl.fl_temp_get(vm, 0),
        _ => copy vm.compiling[0],
    }
}

fn root_drop(mut vm: fl.FlVm, kind: int) {
    match kind {
        0 => { vm.sp = 0 },
        1 => { (mut vm.frames).reset() },
        2 => { (mut vm.open_upvals).reset() },
        3 => { vm.globals = fl.fl_nil() },
        4 => { vm.modules = fl.fl_nil() },
        5 => { vm.builtins = fl.fl_nil() },
        6 => { vm.prelude = fl.fl_nil() },
        7 => { vm.err = fl.fl_nil() },
        8 => { (mut vm.host_roots).reset() },
        9 => { fl.fl_gc_release(mut vm, 1) },
        _ => { (mut vm.compiling).reset() },
    }
}

fn t_roots() {
    for kind in 0..11 {
        region trial {
            var strings = fl.fl_strings()
            var vm = fl.fl_vm_new(take strings)
            let v = fl.fl_str_text(mut vm, "root witness")
            root_set(mut vm, kind, v)
            fl.fl_gc_collect(mut vm)
            assert(!fl.fl_valid(vm, v))
            let live = root_get(vm, kind)
            assert(fl.fl_valid(vm, live))
            assert(vm.gc.slots[fl.fl_obj_index(vm, live)].bytes[0] == 114 as byte)
            let before = vm.gc.used
            root_drop(mut vm, kind)
            fl.fl_gc_collect(mut vm)
            assert(!fl.fl_valid(vm, live))
            assert(vm.gc.used == before - 1)
            print("PASS fl_gc root {kind}")
        }
    }
}

fn t_cycle() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let a = fl.fl_list_new(mut vm)
    let b = fl.fl_map_new(mut vm)
    fl.fl_list_push(mut vm, a, b)
    assert(fl.fl_map_set(mut vm, b, fl.fl_int(0), a))
    fl.fl_gc_protect(mut vm, a)
    fl.fl_gc_collect(mut vm)
    let ar = fl.fl_temp_get(vm, 0)
    let br = copy vm.gc.slots[fl.fl_obj_index(vm, ar)].vals[0]
    let back = fl.fl_map_get(vm, br, fl.fl_int(0)) else fl.fl_nil()
    assert(back.i == ar.i)
    assert(vm.gc.used == 6)
    fl.fl_gc_release(mut vm, 1)
    fl.fl_gc_collect(mut vm)
    assert(vm.gc.used == 4)
    assert(vm.gc.bytes == 64 && vm.gc.next_gc == 262144)
    print("PASS fl_gc cycle")
}

fn t_children() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let closure = fl.fl_gc_alloc(mut vm, 8, 48)
    let fun = fl.fl_gc_alloc(mut vm, 7, 96)
    let up = fl.fl_gc_alloc(mut vm, 11, 48)
    let s = fl.fl_str_text(mut vm, "captured")
    let at = fl.fl_obj_index(vm, closure)
    vm.gc.slots[at].fn_value = fun
    (mut vm.gc.slots[at].vals).push(up)
    vm.gc.slots[at].globals = copy vm.globals
    let ui = fl.fl_obj_index(vm, up)
    vm.gc.slots[ui].closed = s
    fl.fl_gc_protect(mut vm, closure)
    fl.fl_gc_collect(mut vm)
    let cr = fl.fl_temp_get(vm, 0)
    let ci = fl.fl_obj_index(vm, cr)
    let ur = copy vm.gc.slots[ci].vals[0]
    let sr = copy vm.gc.slots[fl.fl_obj_index(vm, ur)].closed
    assert(vm.gc.slots[fl.fl_obj_index(vm, sr)].bytes.len == 8)
    assert(vm.gc.used == 8)
    fl.fl_gc_release(mut vm, 1)
    fl.fl_gc_collect(mut vm)
    assert(vm.gc.used == 4 && vm.gc.strings.len == 0)
    print("PASS fl_gc children and weak interns")
}

fn t_residency() {
    region heap {
        var strings = fl.fl_strings()
        var vm = fl.fl_vm_new(take strings)
        var after: int = 0
        for i in 0..100 {
            let list = fl.fl_list_new(mut vm)
            for n in 0..24 { fl.fl_list_push(mut vm, list, fl.fl_int(n)) }
            fl.fl_gc_protect(mut vm, list)
            fl.fl_gc_collect(mut vm)
            let live = fl.fl_temp_get(vm, 0)
            assert(vm.gc.slots[fl.fl_obj_index(vm, live)].vals.len == 24)
            fl.fl_gc_release(mut vm, 1)
            fl.fl_gc_collect(mut vm)
            assert(!fl.fl_valid(vm, live))
            if i == 20 { after = region_bytes(heap) }
        }
        let final_bytes = region_bytes(heap)
        print("residency after20={after} after100={final_bytes}")
        assert(final_bytes == after)
    }
    print("PASS fl_gc retained payload buffers")
}

fn witness(mut vm: fl.FlVm, tag: str) -> fl.FlValue {
    fl.fl_str_text(mut vm, "{tag}-witness-padded-out-past-the-interning-threshold")
}

fn has_string(vm: fl.FlVm, text: str) -> bool {
    for i in 0..vm.gc.used {
        let at = i * 2 + vm.gc.half
        if vm.gc.slots[at].t != 4 || vm.gc.slots[at].bytes.len != text.len { continue }
        var same = true
        for j in 0..text.len {
            if vm.gc.slots[at].bytes[j] != text.bytes()[j] { same = false; break }
        }
        if same { return true }
    }
    false
}

fn has_witness(vm: fl.FlVm, tag: str) -> bool {
    has_string(vm, "{tag}-witness-padded-out-past-the-interning-threshold")
}

fn fl_gc_root_value_stack() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let s = witness(mut vm, "stack")
    vm.stack[0] = s
    vm.sp = 1
    fl.fl_gc_collect(mut vm)
    assert(has_witness(vm, "stack"))
    assert(vm.gc.slots[fl.fl_obj_index(vm, vm.stack[0])].bytes[0] == 115 as byte)
    vm.sp = 0
    fl.fl_gc_collect(mut vm)
    assert(!has_witness(vm, "stack"))
    print("PASS fl_gc root_value_stack")
}

fn fl_gc_root_call_frames() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let f = fl.fl_gc_alloc(mut vm, 7, 96)
    let c = fl.fl_closure_new(mut vm, f)
    (mut vm.frames).push(fl.
        FlFrame { cl: c, ip: 0, base: 0, call_pc: 0, via_native: 0, edit_depth: 0 })
    fl.fl_gc_collect(mut vm)
    let ci = fl.fl_obj_index(vm, vm.frames[0].cl)
    assert(vm.gc.slots[ci].t == 8)
    assert(vm.gc.slots[fl.fl_obj_index(vm, vm.gc.slots[ci].fn_value)].t == 7)
    let before = vm.gc.used
    (mut vm.frames).reset()
    fl.fl_gc_collect(mut vm)
    assert(vm.gc.used == before - 2)
    print("PASS fl_gc root_call_frames")
}

fn fl_gc_root_open_upvalues() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let u = fl.fl_gc_alloc(mut vm, 11, 48)
    vm.gc.slots[fl.fl_obj_index(vm, u)].slot = 0
    (mut vm.open_upvals).push(u)
    fl.fl_gc_collect(mut vm)
    assert(fl.fl_valid(vm, vm.open_upvals[0]))
    let before = vm.gc.used
    (mut vm.open_upvals).reset()
    fl.fl_gc_collect(mut vm)
    assert(vm.gc.used == before - 1)
    print("PASS fl_gc root_open_upvalues")
}

fn fl_gc_root_globals_and_modules() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let k = fl.fl_str_text(mut vm, "k")
    fl.fl_gc_protect(mut vm, k)
    let g = witness(mut vm, "global")
    let m = witness(mut vm, "module")
    let globals = copy vm.globals
    let modules = copy vm.modules
    assert(fl.fl_map_set(mut vm, globals, k, g))
    assert(fl.fl_map_set(mut vm, modules, k, m))
    fl.fl_gc_release(mut vm, 1)
    fl.fl_gc_collect(mut vm)
    assert(has_witness(vm, "global") && has_witness(vm, "module"))
    let kr = fl.fl_str_text(mut vm, "k")
    let gr = copy vm.globals
    assert(fl.fl_map_del(mut vm, gr, kr))
    fl.fl_gc_collect(mut vm)
    assert(!has_witness(vm, "global") && has_witness(vm, "module"))
    let kr2 = fl.fl_str_text(mut vm, "k")
    let mr = copy vm.modules
    assert(fl.fl_map_del(mut vm, mr, kr2))
    fl.fl_gc_collect(mut vm)
    assert(!has_witness(vm, "module"))
    print("PASS fl_gc root_globals_and_modules")
}

fn fl_gc_root_builtins() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let k = fl.fl_str_text(mut vm, "bk")
    let b = witness(mut vm, "builtin")
    let builtins = copy vm.builtins
    assert(fl.fl_map_set(mut vm, builtins, k, b))
    fl.fl_gc_collect(mut vm)
    assert(has_witness(vm, "builtin"))
    let kr = fl.fl_str_text(mut vm, "bk")
    let br = copy vm.builtins
    assert(fl.fl_map_del(mut vm, br, kr))
    fl.fl_gc_collect(mut vm)
    assert(!has_witness(vm, "builtin"))
    print("PASS fl_gc root_builtins")
}

fn fl_gc_root_handle_table() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let _ = witness(mut vm, "handle")
    fl.fl_gc_collect(mut vm)
    assert(!has_witness(vm, "handle"))
    let h = witness(mut vm, "handle two")
    let slot = fl.fl_gc_host_root_add(mut vm, h)
    fl.fl_gc_collect(mut vm)
    assert(has_witness(vm, "handle two") && fl.fl_valid(vm, fl.fl_gc_host_root_get(vm, slot)))
    fl.fl_gc_host_root_set(mut vm, slot, fl.fl_nil())
    fl.fl_gc_collect(mut vm)
    assert(!has_witness(vm, "handle two"))
    let next = witness(mut vm, "handle three")
    fl.fl_gc_host_root_set(mut vm, slot, next)
    fl.fl_gc_collect(mut vm)
    assert(has_witness(vm, "handle three"))
    fl.fl_gc_host_root_remove(mut vm, slot)
    fl.fl_gc_collect(mut vm)
    assert(!has_witness(vm, "handle three"))
    fl.fl_gc_host_root_remove(mut vm, slot)
    print("PASS fl_gc root_handle_table")
}

fn fl_gc_root_temp_stack() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let a = witness(mut vm, "tempa")
    fl.fl_gc_protect(mut vm, a)
    let b = witness(mut vm, "tempb")
    fl.fl_gc_protect(mut vm, b)
    fl.fl_gc_collect(mut vm)
    assert(has_witness(vm, "tempa") && has_witness(vm, "tempb"))
    fl.fl_gc_release(mut vm, 1)
    fl.fl_gc_collect(mut vm)
    assert(has_witness(vm, "tempa") && !has_witness(vm, "tempb"))
    fl.fl_gc_release(mut vm, 1)
    fl.fl_gc_collect(mut vm)
    assert(!has_witness(vm, "tempa"))
    print("PASS fl_gc root_temp_stack")
}

fn fl_gc_root_compile_chain() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let f = fl.fl_gc_alloc(mut vm, 7, 96)
    (mut vm.compiling).push(f)
    fl.fl_gc_collect(mut vm)
    assert(fl.fl_valid(vm, vm.compiling[0]))
    let before = vm.gc.used
    (mut vm.compiling).reset()
    fl.fl_gc_collect(mut vm)
    assert(vm.gc.used == before - 1)
    print("PASS fl_gc root_compile_chain")
}

fn fl_gc_marks_the_in_flight_error() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    vm.err = witness(mut vm, "err")
    fl.fl_gc_collect(mut vm)
    assert(has_witness(vm, "err") && fl.fl_valid(vm, vm.err))
    vm.err = fl.fl_nil()
    fl.fl_gc_collect(mut vm)
    assert(!has_witness(vm, "err"))
    print("PASS fl_gc marks_the_in_flight_error")
}

fn fl_gc_collects_a_cycle() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let a = fl.fl_list_new(mut vm)
    let b = fl.fl_list_new(mut vm)
    fl.fl_gc_protect(mut vm, a)
    fl.fl_gc_protect(mut vm, b)
    fl.fl_list_push(mut vm, a, b)
    fl.fl_list_push(mut vm, b, a)
    fl.fl_gc_collect(mut vm)
    let ar = fl.fl_temp_get(vm, 0)
    let br = fl.fl_temp_get(vm, 1)
    assert((fl.fl_list_get(vm, ar, 0) else fl.fl_nil()).i == br.i)
    assert((fl.fl_list_get(vm, br, 0) else fl.fl_nil()).i == ar.i)
    let before = vm.gc.used
    fl.fl_gc_release(mut vm, 2)
    fl.fl_gc_collect(mut vm)
    assert(vm.gc.used == before - 2)
    print("PASS fl_gc collects_a_cycle")
}

fn fl_gc_intern_table_is_weak() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let first = fl.fl_str_text(mut vm, "interned")
    fl.fl_gc_protect(mut vm, first)
    let again = fl.fl_str_text(mut vm, "interned")
    assert(first.i == again.i)
    fl.fl_gc_collect(mut vm)
    assert(has_string(vm, "interned"))
    fl.fl_gc_release(mut vm, 1)
    let peak = vm.gc.strings.len
    fl.fl_gc_collect(mut vm)
    assert(!has_string(vm, "interned") && vm.gc.strings.len < peak)
    let fresh = fl.fl_str_text(mut vm, "interned")
    assert(fl.fl_valid(vm, fresh) && has_string(vm, "interned"))
    for i in 0..2000 { let _ = fl.fl_str_text(mut vm, "s{i}") }
    let many = vm.gc.strings.len
    assert(many >= 2000)
    fl.fl_gc_collect(mut vm)
    assert(vm.gc.strings.len < many / 4)
    print("PASS fl_gc intern_table_is_weak")
}

fn run_program(mut vm: fl.FlVm, text: str) -> fl.FlValue {
    var src = List[byte]()
    for b in text.bytes() { (mut src).push(b) }
    let p = fl.fl_parse(src, 0, mut vm.dc, mut vm.strings)
    assert(!p.had_error)
    let f = fl.fl_compile(mut vm, p, 0, fl.fl_origin_new(4, 0)) else fl.fl_nil()
    assert(f.t == 7)
    let out = fl.fl_vm_run(mut vm, f)
    assert(!vm.raised)
    out
}

fn fl_gc_stress_collects_at_every_instruction() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    vm.gc.stress = true
    let _ = run_program(mut vm, "let a = [1]\nlet b = [2]\nreturn 0\n")
    assert(vm.gc.collections > 1)
    print("PASS fl_gc stress_collects_at_every_instruction")
}

fn fl_gc_stress_frees_what_only_a_c_local_holds() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let kept = witness(mut vm, "kept")
    fl.fl_gc_protect(mut vm, kept)
    let dropped = witness(mut vm, "dropped")
    fl.fl_gc_collect(mut vm)
    assert(!fl.fl_valid(vm, dropped) && !has_witness(vm, "dropped"))
    assert(has_witness(vm, "kept"))
    let remapped = fl.fl_temp_get(vm, 0)
    assert(vm.gc.slots[fl.fl_obj_index(vm, remapped)].bytes[0] == 107 as byte)
    fl.fl_gc_release(mut vm, 1)
    print("PASS fl_gc stress_frees_what_only_a_c_local_holds")
}

fn fl_gc_stress_survives_the_whole_pipeline() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    vm.gc.stress = true
    let out = run_program(
        mut vm,
        "fn build(n) {{\n    let acc = []\n    let i = 0\n    while i < n {{\n        acc = acc + [{{idx: i, tag: \"row\"}}]\n        i = i + 1\n    }}\n    return acc\n}}\nlet rows = build(12)\nlet total = 0\nfor r in rows {{ total = total + r.idx }}\nreturn total\n",
    )
    assert(out.t == 2 && out.i == 66 && vm.gc.collections >= 20)
    print("PASS fl_gc stress_survives_the_whole_pipeline")
}

fn fl_gc_root_provider() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let a = witness(mut vm, "provider a")
    let b = witness(mut vm, "provider b")
    let ctx = fl.fl_gc_provider_context(mut vm)
    (mut vm.provider_contexts[ctx].values).push(a)
    (mut vm.provider_contexts[ctx].values).push(b)
    fl.fl_gc_root_provider(mut vm, 0, ctx)
    fl.fl_gc_collect(mut vm)
    assert(vm.provider_contexts[ctx].calls == 1)
    assert(has_witness(vm, "provider a") && has_witness(vm, "provider b"))
    assert(fl.fl_valid(vm, vm.provider_contexts[ctx].values[0]))
    let _ = (mut vm.provider_contexts[ctx].values).pop() else fl.fl_nil()
    fl.fl_gc_collect(mut vm)
    assert(vm.provider_contexts[ctx].calls == 2)
    assert(has_witness(vm, "provider a") && !has_witness(vm, "provider b"))
    fl.fl_gc_root_provider(mut vm, 0, ctx)
    fl.fl_gc_collect(mut vm)
    assert(vm.provider_contexts[ctx].calls == 3)
    let c = witness(mut vm, "provider c")
    let tail = fl.fl_gc_provider_context(mut vm)
    (mut vm.provider_contexts[tail].values).push(c)
    fl.fl_gc_root_provider(mut vm, 0, tail)
    fl.fl_gc_root_provider_remove(mut vm, 0, ctx)
    fl.fl_gc_collect(mut vm)
    assert(vm.provider_contexts[ctx].calls == 3 && vm.provider_contexts[tail].calls == 1)
    assert(!has_witness(vm, "provider a") && has_witness(vm, "provider c"))
    fl.fl_gc_root_provider_remove(mut vm, 0, ctx)
    fl.fl_gc_root_provider_remove(mut vm, 0, tail)
    fl.fl_gc_root_provider_remove(mut vm, 0, tail)
    fl.fl_gc_collect(mut vm)
    assert(vm.provider_contexts[tail].calls == 1 && !has_witness(vm, "provider c"))
    print("PASS fl_gc root_provider")
}

fn main() {
    fl_gc_root_builtins()
    fl_gc_root_value_stack()
    fl_gc_root_call_frames()
    fl_gc_root_open_upvalues()
    fl_gc_root_globals_and_modules()
    fl_gc_root_handle_table()
    fl_gc_root_provider()
    fl_gc_root_temp_stack()
    fl_gc_root_compile_chain()
    fl_gc_marks_the_in_flight_error()
    fl_gc_collects_a_cycle()
    fl_gc_intern_table_is_weak()
    fl_gc_stress_collects_at_every_instruction()
    fl_gc_stress_frees_what_only_a_c_local_holds()
    fl_gc_stress_survives_the_whole_pipeline()
    // Additional moving-collector invariants, beyond the fifteen pinned cases.
    t_roots()
    t_cycle()
    t_children()
    // G53: strict checked exercises logical invariants. The separate hard
    // native/release residency gate measures actual retained payload storage.
    let args = env_args()
    if args.len != 0 && args[0] == "--residency" { t_residency() }
}
