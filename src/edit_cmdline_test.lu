fn hint_case(mut f: Fixture, typed: str, want: str) {
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    type_text(mut f.ed, typed)
    assert(f.ed.cmdline.hint == want, "{typed}: hint '{f.ed.cmdline.hint}', want '{want}'")
    edit.cmdline_close(mut f.ed, false)
}

fn cmdline_hint_reports_what_the_parser_understands() {
    var f = fixture()
    document(mut f.ed, "one\ntwo\nthree\nfour\n")
    hint_case(mut f, "w", "w \u{2192} file.write \u{b7} <file>")
    hint_case(mut f, "redraw", "redraw")
    hint_case(mut f, "plug.enable", "plug.enable \u{b7} <plugin>")
    hint_case(mut f, "1,3d", "d \u{2192} edit.line.delete \u{b7} 3 lines")
    hint_case(mut f, "%d", "d \u{2192} edit.line.delete \u{b7} whole buffer")
    fixture_free(f)
}

fn cmdline_hint_says_nothing_it_does_not_know() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    assert(f.ed.cmdline.hint == "", "nothing typed, nothing said")
    type_text(mut f.ed, "zzzzz")
    assert(f.ed.cmdline.hint == "", "an unknown command, no hint")
    assert(!(f.ed.msg.active && f.ed.msg.sev == edit.MSG_ERROR), "no error line")
