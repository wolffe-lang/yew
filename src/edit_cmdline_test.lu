// A command another fork of yw04 ports, still refusing by name here.
fn unported(ed: edit.Ed, name: str) -> bool {
    let id = edit.cmd_lookup(ed.reg, name)
    id != 0 && ed.reg.entries[id - 1].impl_id == edit.IMPL_UNPORTED
}

fn cmdline_fuzzy_execute_keeps_arguments() {
    var f = fixture()
    if unported(f.ed, "ed.mark.set") {
        skip(
            "cmdline_fuzzy_execute_keeps_arguments",
            "ed.mark.set is the named marks' command (sagitta Sprint 21, yw04's search fork) and refuses by name until it lands",
        )
        fixture_free(f)
        return
    }
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    type_text(mut f.ed, "mkst a")
    ok(mut f.ed, C_ACCEPT, "Enter")
    assert(!f.ed.cmdline.active, "executed")
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    ok(mut f.ed, C_HIST_PREV, "Up")
    assert(
        text_of(f.ed) == "mark.set a",
        "the name rewritten, the argument kept: '{text_of(f.ed)}'",
    )
    edit.cmdline_close(mut f.ed, false)
    fixture_free(f)
}

