}

// Port case: `hint_session_dir` before any session. The halves of
// sagitta's `test_shsession_prompt_hint_names_the_directory`
// (`test_shsession.c:1095-1124`, run whole by `edit_shsession_test`)
// that hold before its `cd`: with the session at the workspace root, the
// bang body and the spelled-out `shell.run` name no directory.
fn t_port_cmdline_hint_without_a_session() {
    var f = fixture()
    assert(edit.shsession_cwd(f.ed) == edit.shell_ws_root(f.ed), "no session: the root")
    hint_case(mut f, "!ls", "")
    hint_case(mut f, "shell.run ls", "shell.run \u{b7} <text>")
    fixture_free(f)
}

// Port case: `:fl` through the prompt (the yw04 contract: `:fl` refuses
// naming yw08). C's `ed.fl.eval` (`option.c:1902-1907`) evaluates in the
// persistent runtime, s18's `:fl` slot that waited for Sprint 32
// (`s18-cmdline.md:37`): the refusal names that sprint and lane, not
// `option.c`'s.
fn t_port_cmdline_fl_refuses_naming_yw08() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    type_text(mut f.ed, "fl 1 + 1")
    let s = inv(mut f.ed, C_ACCEPT)
    let want = "not yet ported: ed.fl.eval: sagitta Sprint 32 (the REPL and errors) (yw08)"
    if f.ed.cmdline.err_msg != want || s != edit.CMD_ERR_DEFERRED {
        say(
            "cmdline_test: :fl: status {s}; error '{f.ed.cmdline.err_msg}'; message '{f.ed.msg.text}'",
        )
    }
    assert(s == edit.CMD_ERR_DEFERRED, ":fl is deferred")
    assert(f.ed.cmdline.active, "the prompt stays, as on any failure")
    assert(f.ed.cmdline.err_msg == want, ":fl names Sprint 32 and yw08 at the prompt")
    assert(f.ed.msg.text.contains(want), "and on the message row")
    fixture_free(f)
}

fn cmdline_menu_commands_are_registered_and_internal() {
    var f = fixture()
    for name in [
        "ed.cmdline.menu.next",
        "ed.cmdline.menu.prev",
        "ed.cmdline.menu.page_next",
        "ed.cmdline.menu.page_prev",
        "ed.cmdline.menu.accept",
        "ed.cmdline.menu.dismiss",
        "ed.cmdline.ghost.accept",
        "ed.cmdline.ghost.accept_word",
    ] {
        let id = edit.cmd_lookup(f.ed.reg, name)
        assert(id != 0, "{name} registered")
        assert(f.ed.reg.entries[id - 1].flags & edit.CMD_INTERNAL != 0, "{name} is internal")
    }
    fixture_free(f)
}

fn cmdline_one_fuzzy_match_executes() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
