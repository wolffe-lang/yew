//! member: false
//!
//! The port of sagitta `tests/unit/test_cmdline.c` (1,834 lines), one test
//! per C test in registry order (`tests/unit/registry.c`'s 44
//! `T(cmdline_*)`). C's fixture (`cmdline_fixture_init`,
//! `test_cmdline.c:62-75`): a scratch `XDG_STATE_HOME`, the scratch editor
//! with the runtime loaded; the port's is `edit.ed_new_test` over
//! `runtime/init.fl` with the state directory under `target/tests/`. C's
//! test commands are C functions (`yew_cmd_register_entry`); the port's
//! are `HANDLER_PROBE` rows whose behaviour `edit.probe` chooses by name
//! (`ed.ai.rename` opens the successor prompt; `ed.ui.grow` is a no-op).
//! C's `InputDoneState` callback is the `INPUT_DONE_TEST` kind, which
//! records into `CmdLine.input_*`. C's `comp_arena.head` checks have no
//! port counterpart (the rows are values in `Menu.items`, dropped with
//! the menu). The `:!` completion cases run over the shell fork's
//! executable and path sources (s57.18/s57.23).

use edit
use std.env as std_env
use std.fs
use term
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn say(line: str) {
    print(line)
    eprint(line)
}

fn skip(what: str, why: str) {
    say("cmdline_test: SKIP {what}: {why}")
}

fn family() -> str {
    "\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467}\u{200d}\u{1f466}"
}

fn runtime() -> List[byte] {
    let bytes = fs_read_bytes("runtime/init.fl") else List[byte]()
    assert(bytes.len != 0, "runtime/init.fl is readable from the repository root")
    bytes
}

struct Fixture {
    ed: edit.Ed,
    state: str,
    saved: str,
    had_saved: bool,
}

// `cmdline_fixture_init` (`test_cmdline.c:62-75`).
fn fixture() -> Fixture {
    let cwd = std_env.cwd() else "."
    let state = "{cwd}/target/tests/yew-cmdline-{std_env.pid()}"
    fs.remove_dir_all(state) else |_| {}
    fs.create_dir_all(state) else |_| {
        assert(false, "fixture state dir {state}")
    }
    let had = env_get("XDG_STATE_HOME") else "\u{0}"
    env_set("XDG_STATE_HOME", state) else |_| {
        assert(false, "set XDG_STATE_HOME")
    }
    Fixture {
        ed: edit.ed_new_test(runtime(), ""),
        state: state,
        saved: had,
        had_saved: had != "\u{0}",
    }
}

// `cmdline_fixture_free` (`test_cmdline.c:77-104`).
fn fixture_free(f: Fixture) {
    fs.remove_dir_all(f.state) else |_| {}
    if f.had_saved {
        env_set("XDG_STATE_HOME", f.saved) else |_| {}
    } else {
        env_unset("XDG_STATE_HOME") else |_| {}
    }
}

fn text_of(ed: edit.Ed) -> str {
    str_from_utf8(edit.cmdline_text(ed)) else "<not utf-8>"
}

fn doc_text(ed: edit.Ed) -> str {
    let b = ed.wins[ed.win].buf
    str_from_utf8(text.textbuf_bytes(ed.bufs[b].ec.tb)) else "<not utf-8>"
}

// `cmdline_document` (`test_cmdline.c:129-143`).
fn document(mut ed: edit.Ed, s: str) {
    let b = ed.wins[ed.win].buf
    let bytes = bytes_of(s)
    ed.bufs[b].ec.tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    ed.bufs[b].ec.undo = text.undo_new(ed.bufs[b].ec.tb)
    let p = ed.wins[ed.win].cs.primary
    ed.wins[ed.win].cs.curs[p].pos = 0
    ed.wins[ed.win].cs.curs[p].anchor = 0
    ed.wins[ed.win].cs.curs[p].goal_col = 0
}

// `cmdline_key` (`test_cmdline.c:145-157`).
fn key(code: int) -> term.Key {
    var k = term.key_new()
    k.code = code
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    if code < 128 {
        (mut k.text).push(code as byte)
    }
    k
}

fn press(mut ed: edit.Ed, code: int) {
    edit.ed_handle_key(mut ed, key(code), 1)
}

// `cmdline_type` (`test_cmdline.c:660-666`).
fn type_text(mut ed: edit.Ed, s: str) {
    for b in s.bytes() {
        press(mut ed, b as int)
    }
}

fn cx(ed: edit.Ed) -> edit.CmdCtx {
    edit.cmdctx_new(edit.cmdline_target(ed), edit.SRC_TEST)
}

// `cmdline_invoke` (`test_cmdline.c:159-167`): the handler, directly.
const C_ACCEPT: int = 0

const C_CANCEL: int = 1

const C_COMPLETE_NEXT: int = 2

const C_HIST_PREV: int = 3

const C_GHOST_ACCEPT: int = 4

const C_PAGE_NEXT: int = 5

const C_PAGE_PREV: int = 6

const C_SAVE_AS: int = 7

fn inv(mut ed: edit.Ed, which: int) -> int {
    let c = cx(ed)
    match which {
        0 => edit.cmdline_accept_cmd(mut ed, c),
        1 => edit.cmdline_cancel_cmd(mut ed, c),
        2 => edit.cmdline_complete_next_cmd(mut ed, c),
        3 => edit.cmdline_hist_prev_cmd(mut ed, c),
        4 => edit.cmdline_ghost_accept_cmd(mut ed, c),
        5 => edit.cmdline_menu_page_next_cmd(mut ed, c),
        6 => edit.cmdline_menu_page_prev_cmd(mut ed, c),
        _ => edit.fc_save_as(mut ed, c),
    }
}

fn ok(mut ed: edit.Ed, which: int, what: str) {
    let s = inv(mut ed, which)
    if s != edit.CMD_OK {
        say(
            "cmdline_test: {what}: status {s}; message '{ed.msg.text}'; line '{text_of(ed)}'; error '{ed.cmdline.err_msg}'",
        )
    }
    assert(s == edit.CMD_OK, "{what}: status {s}")
}

fn hist_add(mut ed: edit.Ed, s: str) {
    edit.hist_add_str(mut ed.cmdline.history, s)
}

fn walk_draft(ed: edit.Ed) -> str {
    str_from_utf8(ed.cmdline.walk.draft) else "<not utf-8>"
}

fn walk_term(ed: edit.Ed) -> str {
    str_from_utf8(ed.cmdline.walk.term) else "<not utf-8>"
}

fn caret(ed: edit.Ed) -> int {
    edit.cmdline_caret(ed)
}

fn register_probe(mut ed: edit.Ed, name: str, flags: int, policy: int) {
    let d = edit.CmdDesc {
        name: name,
        handler: edit.HANDLER_PROBE,
        impl_id: 0,
        arity: edit.ARITY_NONE,
        flags: flags,
        help: "Command-line test command",
        word: "",
        has_word: false,
    }
    let _ = edit.cmd_register_entry(mut ed.reg, d, "probe", "", "", false, policy, "", false)
}

// `grid_has_ascii` (`test_cmdline.c:180-203`).
fn grid_has(g: term.Grid, needle: str) -> bool {
    let n = needle.bytes()
    var row = 0
    while row < g.rows {
        var col = 0
        while col + n.len <= g.cols {
            var i = 0
            while i < n.len {
                let c = copy g.back[row * g.cols + col + i]
                if term.cell_byte(c, 0) != n[i] as int {
                    break
                }
                i += 1
            }
            if i == n.len {
                return true
            }
            col += 1
        }
        row += 1
    }
    false
}

// `grid_count_cluster` (`test_cmdline.c:205-226`).
fn grid_count(g: term.Grid, want: List[byte]) -> int {
    var count = 0
    var i = 0
    while i < g.rows * g.cols {
        var got = List[byte]()
        term.cell_bytes_into(mut got, g, g.back[i])
        if got.len == want.len {
            var same = true
            var k = 0
            while k < got.len {
                if got[k] != want[k] {
                    same = false
                }
                k += 1
            }
            if same {
                count += 1
            }
        }
        i += 1
    }
    count
}

// `cmdline_accept_successor_and_check_history` (`test_cmdline.c:228-262`).
fn accept_successor_and_check_history(mut f: Fixture, command: str) {
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, command)
    ok(mut f.ed, C_ACCEPT, "accept {command}")
    assert(f.ed.cmdline.active, "the successor prompt is open")
    assert(f.ed.cmdline.kind == edit.PROMPT_INPUT, "it is an input prompt")
    assert(f.ed.mode == edit.MODE_E, "still E")
    assert(text_of(f.ed) == "successor", "the successor's seed")
    edit.cmdline_close(mut f.ed, false)
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    ok(mut f.ed, C_HIST_PREV, "hist prev")
    assert(text_of(f.ed) == command, "history kept '{command}', got '{text_of(f.ed)}'")
    edit.cmdline_close(mut f.ed, false)
}

// ---------------------------------------------------------------------

fn cmdline_does_not_auto_pair_or_indent() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    var c = cx(f.ed)
    c.sarg = "("
    c.has_sarg = true
    let id = edit.cmd_lookup(f.ed.reg, "ed.edit.insert.text")
    assert(edit.ed_cmd_invoke(mut f.ed, id, mut c) == edit.CMD_OK, "insert (")
    assert(text_of(f.ed) == "(", "no closer paired")
    var d = cx(f.ed)
    let del = edit.cmd_lookup(f.ed.reg, "ed.edit.delete.grapheme_left")
    assert(edit.ed_cmd_invoke(mut f.ed, del, mut d) == edit.CMD_OK, "backspace")
    assert(text_of(f.ed) == "", "one grapheme, not a pair")
    edit.cmdline_close(mut f.ed, false)
    fixture_free(f)
}

fn cmdline_reuses_textbuf_and_grapheme_cursor() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, family())
    let tw = edit.cmdline_target(f.ed)
    assert(tw >= 0 && tw != f.ed.win, "a target window of its own")
    let b = f.ed.wins[tw].buf
    assert(text.textbuf_line_count(f.ed.bufs[b].ec.tb) == 1, "one line")
    assert(caret(f.ed) == family().len, "caret at the end")
    press(mut f.ed, term.KEY_LEFT)
    assert(caret(f.ed) == 0, "one grapheme left is the start")
    let p = f.ed.wins[tw].cs.primary
    assert(f.ed.wins[tw].cs.curs[p].pos == 0, "the window's cursor moved")
    fixture_free(f)
}

fn cmdline_sanitizes_seed_paste_and_register_newlines() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "a\r\n\nb\rc")
    assert(text_of(f.ed) == "a b c", "the seed's newline runs fold")
    edit.cmdline_paste(mut f.ed, bytes_of("x\r\ny\n\nz"))
    var value = text.regval_new()
    value.bytes = bytes_of("q\r\n\nr")
    text.reg_set_macro(mut f.ed.regs, 'a' as int, value, false)
    var c = cx(f.ed)
    c.sarg = "a"
    c.has_sarg = true
    assert(edit.cmdline_insert_register_cmd(mut f.ed, c) == edit.CMD_OK, "insert register a")
    assert(text_of(f.ed) == "a b cx y zq r", "pasted and inserted, folded: got '{text_of(f.ed)}'")
    let b = f.ed.wins[edit.cmdline_target(f.ed)].buf
    assert(text.textbuf_line_count(f.ed.bufs[b].ec.tb) == 1, "still one line")
    var nul = text.regval_new()
    var nb = bytes_of("n")
    (mut nb).push(0 as byte)
    (mut nb).push(120 as byte)
    nul.bytes = nb
    text.reg_set_macro(mut f.ed.regs, 'b' as int, nul, false)
    c.sarg = "b"
    assert(edit.cmdline_insert_register_cmd(mut f.ed, c) == edit.CMD_ERR_ARG, "a NUL refuses")
    assert(text_of(f.ed) == "a b cx y zq r", "nothing inserted")
    assert(f.ed.msg.text == "NUL byte is not valid in a command line", "the message")
    fixture_free(f)
}

fn cmdline_e_keymap_leaves_are_registered_editor_commands() {
    var f = fixture()
    let km = copy f.ed.keymaps[edit.MODE_N + 1 + edit.MODE_E]
    let (visited_ok, entries) = edit.keymap_list(km)
    assert(visited_ok, "the E keymap visits")
    for e in entries {
        assert(e.seq.len != 0, "a leaf has keys")
        assert(e.bind.cmd > 0 && e.bind.cmd <= f.ed.reg.entries.len, "a registered command")
        assert(f.ed.reg.entries[e.bind.cmd - 1].name.starts_with("ed."), "an ed.* name")
    }
    assert(entries.len == edit.keymap_binding_count(km), "every binding visited")
    assert(entries.len >= 20, "at least 20 E bindings")
    fixture_free(f)
}

fn cmdline_highlight_selection_seeds_range() {
    var f = fixture()
    let b = f.ed.wins[f.ed.win].buf
    text.textbuf_insert(mut f.ed.bufs[b].ec.tb, 0 as text.ByteOff, "alpha".bytes())
    let p = f.ed.wins[f.ed.win].cs.primary
    f.ed.wins[f.ed.win].cs.curs[p].anchor = 1
    f.ed.wins[f.ed.win].cs.curs[p].pos = 4
    assert(edit.mode_enter_highlight(mut f.ed, edit.MODE_L, false) == edit.CMD_OK, "H")
    assert(edit.mode_enter(mut f.ed, edit.MODE_E) == edit.CMD_OK, "E")
    assert(text_of(f.ed) == "'<,'>", "seeded with the selection's range")
    assert(caret(f.ed) == 5, "caret after the seed")
    assert(f.ed.cmdline.return_mode == edit.MODE_H, "returns to H")
    fixture_free(f)
}

fn cmdline_escape_restores_completion_stem_before_closing() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "f")
    ok(mut f.ed, C_COMPLETE_NEXT, "Tab")
    assert(f.ed.cmdline.menu.n_items > 1, "several candidates")
    assert(f.ed.cmdline.active, "open")
    ok(mut f.ed, C_CANCEL, "Esc")
    assert(text_of(f.ed) == "f", "the stem restored")
    assert(f.ed.cmdline.menu.n_items == 0, "the menu gone")
    assert(f.ed.cmdline.active, "still open")
    ok(mut f.ed, C_CANCEL, "Esc again")
    assert(!f.ed.cmdline.active, "closed")
    assert(f.ed.mode == edit.MODE_L, "back in L")
    fixture_free(f)
}

fn cmdline_accepts_registered_command_and_closes() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "redraw")
    ok(mut f.ed, C_ACCEPT, "accept redraw")
    assert(!f.ed.cmdline.active, "closed")
    assert(f.ed.mode == edit.MODE_L, "back in L")
    edit.cmdline_open_input(mut f.ed, "wolf name", edit.INPUT_DONE_TEST, 7)
    ok(mut f.ed, C_ACCEPT, "accept the input")
    assert(f.ed.cmdline.input_seen == 1, "the owner heard once")
    assert(f.ed.cmdline.input_accepted, "accepted")
    assert(f.ed.cmdline.input_closed, "after the close")
    assert((str_from_utf8(f.ed.cmdline.input_text) else "") == "wolf name", "the answer")
    f.ed.cmdline.input_seen = 0
    edit.cmdline_open_input(mut f.ed, "old", edit.INPUT_DONE_TEST, 7)
    edit.cmdline_open(mut f.ed, edit.PROMPT_INPUT, "picker")
    assert(f.ed.cmdline.input_seen == 1, "the displaced owner heard")
    assert(!f.ed.cmdline.input_accepted, "not accepted")
    assert(f.ed.cmdline.input_closed, "after its close")
    assert((str_from_utf8(f.ed.cmdline.input_text) else "") == "old", "its text")
    ok(mut f.ed, C_ACCEPT, "accept the picker")
    assert(f.ed.cmdline.input_seen == 1, "no second call")
    assert(!f.ed.cmdline.active, "closed")
    register_probe(mut f.ed, "ed.ai.rename", edit.CMD_PROMPTS, edit.RP_OPT)
    accept_successor_and_check_history(mut f, "ai.rename")
    f.ed.clean = true
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "ai.rename")
    assert(edit.hist_is_memory(f.ed.cmdline.history), "--clean keeps history in memory")
    edit.cmdline_close(mut f.ed, false)
    accept_successor_and_check_history(mut f, "ai.rename")
    fixture_free(f)
    var g = fixture()
    register_probe(mut g.ed, "ed.ai.rename", edit.CMD_PROMPTS, edit.RP_OPT)
    env_set("XDG_STATE_HOME", "/dev/null/yew-state") else |_| {}
    edit.cmdline_open(mut g.ed, edit.PROMPT_CMD, "ai.rename")
    assert(edit.hist_is_memory(g.ed.cmdline.history), "an unusable state home is memory")
    edit.cmdline_close(mut g.ed, false)
    accept_successor_and_check_history(mut g, "ai.rename")
    env_set("XDG_STATE_HOME", g.state) else |_| {}
    fixture_free(g)
}

fn cmdline_input_draws_the_full_multiline_message() {
    let disclosure = "First disclosure line\n012345678901234567890123456789\nabcdefghijabcdefghijabcdefghij\nABCDEFGHIJABCDEFGHIJABCDEFGHIJ\none two three four five six seven\nred orange yellow green blue violet\nalpha beta gamma delta epsilon zeta\nprivacy disclosure content row number one\nprivacy disclosure content row number two\nprivacy disclosure content row number three\nprivacy disclosure content row number four\nprivacy disclosure content row number five\nprivacy disclosure content row number six\nthis pushes the message past its inline storage\nand proves drawing reads the allocated full text\nChoice [y/N]:"
    let narrow = "discard zero\ndiscard one\ndiscard two\ndiscard three\ndiscard four\ndiscard five\n\u{6f22}\u{5b57}\u{6f22}\u{5b57}\u{6f22}\u{5b57}\u{6f22}\u{5b57}\nabcdefghijklmnopqrstuvwx\ne\u{301} tail\n{family()}\nChoice [n]:"
    var f = fixture()
    f.ed.grid = term.grid_new(24, 80)
    f.ed.footer_rect = edit.rect(0, 23, 80, 1)
    edit.cmdline_open_input(mut f.ed, "", edit.INPUT_DONE_NONE, 0)
    edit.ed_msg(mut f.ed, edit.MSG_INFO, disclosure)
    let r = copy f.ed.footer_rect
    edit.cmdline_draw(mut f.ed, r)
    assert(grid_has(f.ed.grid, "First disclosure line"), "the first line")
    assert(grid_has(f.ed.grid, "full text"), "the long tail")
    assert(grid_has(f.ed.grid, "Choice [y/N]:"), "the question")
    assert(term.cell_byte(f.ed.grid.back[23 * f.ed.grid.cols], 0) == ':' as int, "the prompt row")
    assert(term.grid_resize(mut f.ed.grid, 8, 12), "resize")
    f.ed.footer_rect = edit.rect(0, 7, 12, 1)
    edit.ed_msg(mut f.ed, edit.MSG_INFO, narrow)
    let r2 = copy f.ed.footer_rect
    edit.cmdline_draw(mut f.ed, r2)
    assert(!grid_has(f.ed.grid, "discard"), "the head dropped")
    assert(grid_count(f.ed.grid, bytes_of("\u{6f22}")) == 4, "four han")
    assert(grid_count(f.ed.grid, bytes_of("e\u{301}")) == 1, "one combined e")
    assert(grid_count(f.ed.grid, bytes_of(family())) == 1, "one family")
    assert(grid_has(f.ed.grid, "abcdefghijkl"), "the wrap's first row")
    assert(grid_has(f.ed.grid, "mnopqrstuvwx"), "the wrap's second row")
    assert(grid_has(f.ed.grid, "Choice [n]:"), "the question")
    fixture_free(f)
}

fn cmdline_range_executes_once_with_multiple_cursors() {
    var f = fixture()
    document(mut f.ed, "one\ntwo\nthree\n")
    assert(text.cset_add(mut f.ed.wins[f.ed.win].cs, text.Cursor { pos: 8, goal_col: 0, anchor: 8 }), "second cursor")
    assert(f.ed.wins[f.ed.win].cs.curs.len == 2, "two cursors")
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "1,2d")
    ok(mut f.ed, C_ACCEPT, "accept 1,2d")
    assert(doc_text(f.ed) == "three\n", "the range deleted once: '{doc_text(f.ed)}'")
    fixture_free(f)
}

fn cmdline_bang_quit_bypasses_durability_failure() {
    var f = fixture()
    document(mut f.ed, "dirty")
    f.ed.durability_failed = true
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "q!")
    ok(mut f.ed, C_ACCEPT, "accept q!")
    assert(f.ed.quit, "quits")
    fixture_free(f)
}

fn cmdline_parse_error_preserves_text_and_points_at_token() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "definitely_missing")
    assert(inv(mut f.ed, C_ACCEPT) == edit.CMD_ERR_ARG, "refused")
    assert(f.ed.cmdline.active, "open")
    assert(text_of(f.ed) == "definitely_missing", "the text kept")
    assert(caret(f.ed) == f.ed.cmdline.err_lo, "caret at the token")
    assert(f.ed.cmdline.err_hi > f.ed.cmdline.err_lo, "a token")
    assert(f.ed.cmdline.err_msg == "unknown command 'definitely_missing' (try Tab)", "the message")
    assert(f.ed.msg.active && f.ed.msg.text.starts_with("E: "), "on the message line")
    fixture_free(f)
}

struct ErrRow {
    line: str,
    message: str,
    lo: int,
    hi: int,
}

fn er(line: str, message: str, lo: int, hi: int) -> ErrRow {
    ErrRow { line: line, message: message, lo: lo, hi: hi }
}

fn cmdline_catalogue_errors_preserve_live_prompt() {
    var rows = List[ErrRow]()
    (mut rows).push(er("not_a_command", "unknown command 'not_a_command' (try Tab)", 0, 13))
    (mut rows).push(er("file.w", "ambiguous: file.write, file.write_quit", 0, 6))
    (mut rows).push(er("file.open", ":file.open requires 1 argument", 0, 9))
    (mut rows).push(er("quit extra", ":quit takes no arguments", 5, 10))
    (mut rows).push(er("1quit", ":quit takes no range", 0, 1))
    (mut rows).push(er("ui.grow", ":ui.grow requires a range", 0, 7))
    (mut rows).push(er("5,3d", "backwards range (5,3)", 0, 3))
    (mut rows).push(er("900d", "line 900 past end of buffer (412 lines)", 0, 3))
    (mut rows).push(er("w \"abc", "unterminated \"", 2, 3))
    (mut rows).push(er("w \"\\q\"", "unknown escape '\\q'", 3, 5))
    (mut rows).push(er("w %z", "unknown expansion '%z'", 2, 4))
    (mut rows).push(er("w %", "buffer has no file name", 2, 3))
    (mut rows).push(er("w %s", "%s needs a selection", 2, 4))
    (mut rows).push(er("!", "ed.shell.run needs a command", 0, 1))
    (mut rows).push(er("mode.enter I", "unknown command 'mode.enter' (try Tab)", 0, 10))
    var f = fixture()
    var doc = ""
    var i = 0
    while i < 411 {
        doc += "\n"
        i += 1
    }
    document(mut f.ed, doc)
    register_probe(mut f.ed, "ed.ui.grow", 0, edit.RP_REQUIRED)
    for r in rows {
        edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, r.line)
        let s = inv(mut f.ed, C_ACCEPT)
        assert(s == edit.CMD_ERR_ARG, "{r.line}: refused (status {s})")
        assert(f.ed.cmdline.active, "{r.line}: open")
        assert(text_of(f.ed) == r.line, "{r.line}: the text kept")
        assert(caret(f.ed) == r.lo, "{r.line}: caret {caret(f.ed)}, want {r.lo}")
        assert(f.ed.cmdline.err_lo == r.lo, "{r.line}: tok_lo {f.ed.cmdline.err_lo}")
        assert(f.ed.cmdline.err_hi == r.hi, "{r.line}: tok_hi {f.ed.cmdline.err_hi}")
        assert(f.ed.cmdline.err_msg == r.message, "{r.line}: '{f.ed.cmdline.err_msg}'")
        assert(f.ed.msg.active && f.ed.msg.text == "E: {r.message}", "{r.line}: the message line")
        edit.cmdline_close(mut f.ed, false)
    }
    fixture_free(f)
}

fn cmdline_menu_filters_live_while_typing() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    assert(f.ed.cmdline.menu.n_items == 0, "a bare : lists nothing")
    type_text(mut f.ed, "fil")
    assert(f.ed.cmdline.menu.n_items > 1, "the live menu")
    assert(f.ed.cmdline.menu.sel == -1, "nothing chosen")
    assert(!f.ed.cmdline.menu.explicit_sel, "not explicit")
    type_text(mut f.ed, "e.wri")
    assert(f.ed.cmdline.menu.n_items >= 1, "narrows")
    type_text(mut f.ed, "zzzz")
    assert(f.ed.cmdline.menu.n_items == 0, "closes")
    assert(!(f.ed.msg.active && f.ed.msg.sev == edit.MSG_ERROR), "silently")
    fixture_free(f)
}

fn cmdline_enter_executes_while_filtering() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    type_text(mut f.ed, "redraw")
    assert(f.ed.cmdline.menu.n_items != 0, "a live menu")
    assert(!f.ed.cmdline.menu.explicit_sel, "nothing chosen")
    ok(mut f.ed, C_ACCEPT, "accept")
    assert(!f.ed.cmdline.active, "executed and closed")
    assert(f.ed.mode == edit.MODE_L, "back in L")
    fixture_free(f)
}

fn cmdline_enter_accepts_a_chosen_row_without_executing() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    type_text(mut f.ed, "fil")
    assert(f.ed.cmdline.menu.n_items > 1, "several")
    ok(mut f.ed, C_COMPLETE_NEXT, "Tab: the LCP")
    assert(!f.ed.cmdline.menu.explicit_sel, "nothing chosen yet")
    ok(mut f.ed, C_COMPLETE_NEXT, "Tab: a choice")
    assert(f.ed.cmdline.menu.explicit_sel, "chosen")
    ok(mut f.ed, C_ACCEPT, "Enter")
    assert(f.ed.cmdline.active, "not executed")
    assert(f.ed.cmdline.menu.n_items == 0, "the menu gone")
