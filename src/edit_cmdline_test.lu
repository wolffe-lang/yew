// `bang_tab_expect` (`test_cmdline.c:1761-1781`).
fn bang_tab_expect(seed: str, want: str) -> bool {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, seed)
    ok(mut f.ed, C_COMPLETE_NEXT, "Tab")
    assert(text_of(f.ed) == want, "bang tab: `{seed}` -> `{text_of(f.ed)}`, want `{want}`")
    edit.cmdline_close(mut f.ed, false)
    fixture_free(f)
    true
}

fn cmdline_bang_tab_inserts_shell_quoted_words() {
    let cwd = std_env.cwd() else "."
    let dir = "{cwd}/target/tests/yew-shq-{std_env.pid()}"
    fs.remove_dir_all(dir) else |_| {}
    fs.create_dir_all("{dir}/sub") else |_| {
        assert(false, "dirs")
    }
    fs.write_text("{dir}/a$b c", "") else |_| {
        assert(false, "file")
    }
    if bang_tab_expect("!cat {dir}/a", "!cat {dir}/a\\$b\\ c ") {
        let _ = bang_tab_expect("!cat \"{dir}/a", "!cat \"{dir}/a\\$b c\" ")
        let _ = bang_tab_expect("!cat '{dir}/a", "!cat '{dir}/a$b c' ")
        let _ = bang_tab_expect("!ls {dir}/s", "!ls {dir}/sub/")
        let _ = bang_tab_expect("!cd \"{dir}/s", "!cd \"{dir}/sub/")
        env_set("YEW_S5723_CLI", "1") else |_| {}
        let _ = bang_tab_expect("!echo $YEW_S5723_CL", "!echo $YEW_S5723_CLI ")
        let _ = bang_tab_expect("!echo ${{YEW_S5723_CL", "!echo ${{YEW_S5723_CLI}} ")
        let _ = bang_tab_expect("!echo \"${{YEW_S5723_CL", "!echo \"${{YEW_S5723_CLI}}\" ")
        env_unset("YEW_S5723_CLI") else |_| {}
    }
    fs.remove_dir_all(dir) else |_| {}
}

fn cmdline_bang_tab_in_a_comment_is_a_tab() {
    let _ = bang_tab_expect("!ls # no", "!ls # no\t")
}

fn cmdline_menu_page_moves_by_a_page() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    type_text(mut f.ed, "e")
    assert(f.ed.cmdline.menu.n_items > 5, "more than a page")
    ok(mut f.ed, C_PAGE_NEXT, "PgDn enters")
    assert(f.ed.cmdline.menu.sel == 0, "row 0")
    assert(f.ed.cmdline.menu.explicit_sel, "explicit")
    ok(mut f.ed, C_PAGE_NEXT, "PgDn")
    assert(f.ed.cmdline.menu.sel == 5, "row 5: {f.ed.cmdline.menu.sel}")
    ok(mut f.ed, C_PAGE_PREV, "PgUp")
    assert(f.ed.cmdline.menu.sel == 0, "row 0")
    fixture_free(f)
}

// `cmdline_mouse` (`test_cmdline.c:924-934`).
fn mouse(button: int, ev: int, col: int, row: int) -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_MOUSE
    k.ev = ev
    k.button = button
    k.col = col
    k.row = row
    k
}

// `cmdline_fake_menu_regions` (`test_cmdline.c:936-946`).
fn fake_menu_regions(mut ed: edit.Ed, rows: int) {
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(mut ed.regions, edit.REGION_BLOCK, edit.rect(0, 10, 80, rows), 0)
    var i = 0
    while i < rows {
        edit.region_add(mut ed.regions, edit.REGION_MENU_ROW, edit.rect(0, 10 + i, 80, 1), i)
        i += 1
    }
}

fn cmdline_click_selects_then_accepts_the_same_row() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    type_text(mut f.ed, "fil")
    assert(f.ed.cmdline.menu.n_items > 2, "rows")
    fake_menu_regions(mut f.ed, 5)
    assert(!edit.mouse_claimed_by_menu(mut f.ed, term.key_new()), "a key event is not the menu's")
    let p = mouse(term.MB_LEFT, term.KEY_PRESS, 4, 12)
    edit.mouse_event(mut f.ed, p)
    assert(f.ed.cmdline.menu.sel == 2, "row 2 chosen")
    assert(f.ed.cmdline.menu.explicit_sel, "explicit")
    assert(f.ed.cmdline.active, "open")
    edit.mouse_event(mut f.ed, p)
    assert(f.ed.cmdline.menu.n_items == 0, "accepted, the menu closed")
    assert(f.ed.cmdline.active, "still open")
    assert(text_of(f.ed).starts_with("file."), "the row in the line")
    fixture_free(f)
}

fn cmdline_click_and_keyboard_reach_the_same_state() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    type_text(mut f.ed, "fil")
    fake_menu_regions(mut f.ed, 5)
    edit.mouse_event(mut f.ed, mouse(term.MB_LEFT, term.KEY_PRESS, 4, 10))
    assert(f.ed.cmdline.menu.sel == 0, "row 0 by click")
    let clicked = text_of(f.ed)
    fixture_free(f)
    var g = fixture()
    edit.cmdline_open(mut g.ed, edit.PROMPT_CMD, "")
    type_text(mut g.ed, "fil")
    ok(mut g.ed, C_COMPLETE_NEXT, "Tab")
    ok(mut g.ed, C_COMPLETE_NEXT, "Tab")
    assert(g.ed.cmdline.menu.sel == 0, "row 0 by keys")
    assert(text_of(g.ed) == clicked, "the same line")
    fixture_free(g)
}

fn cmdline_wheel_scrolls_without_choosing() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    type_text(mut f.ed, "e")
    assert(f.ed.cmdline.menu.n_items > 8, "a long list")
    fake_menu_regions(mut f.ed, 5)
    f.ed.footer_rect = edit.rect(0, 23, 80, 1)
    edit.mouse_event(mut f.ed, mouse(term.MB_WHEEL_DOWN, term.KEY_PRESS, 4, 12))
    assert(f.ed.cmdline.menu.top == 3, "scrolled three: {f.ed.cmdline.menu.top}")
    assert(f.ed.cmdline.menu.sel == -1, "nothing chosen")
    assert(!f.ed.cmdline.menu.explicit_sel, "not explicit")
    edit.mouse_event(mut f.ed, mouse(term.MB_WHEEL_UP, term.KEY_PRESS, 4, 12))
    assert(f.ed.cmdline.menu.top == 0, "back to the top")
    fixture_free(f)
}

fn cmdline_click_on_a_menu_gap_is_swallowed() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    type_text(mut f.ed, "fil")
    edit.region_frame_begin(mut f.ed.regions)
    edit.region_add(mut f.ed.regions, edit.REGION_BLOCK, edit.rect(0, 10, 80, 5), 0)
    let p = mouse(term.MB_LEFT, term.KEY_PRESS, 4, 12)
    assert(edit.mouse_claimed_by_menu(mut f.ed, p), "claimed")
    edit.mouse_event(mut f.ed, p)
    assert(f.ed.cmdline.menu.sel == -1, "no row chosen")
    fixture_free(f)
}

fn cmdline_ghost_is_never_in_the_buffer() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    type_text(mut f.ed, "redr")
    assert(f.ed.cmdline.menu.n_items != 0, "a suggestion")
    assert(text_of(f.ed) == "redr", "the buffer holds what was typed")
    ok(mut f.ed, C_HIST_PREV, "Up")
    assert(f.ed.cmdline.walk.on, "a walk")
    assert(walk_draft(f.ed) == "redr", "its draft")
    assert(walk_term(f.ed) == "redr", "its term")
    fixture_free(f)
}

fn cmdline_ghost_accept_matches_a_menu_accept() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    type_text(mut f.ed, "redr")
    ok(mut f.ed, C_GHOST_ACCEPT, "Right")
    let ghosted = text_of(f.ed)
    assert(ghosted == "redraw ", "the ghost and its space: '{ghosted}'")
    fixture_free(f)
    var g = fixture()
    edit.cmdline_open(mut g.ed, edit.PROMPT_CMD, "")
    type_text(mut g.ed, "redr")
    ok(mut g.ed, C_COMPLETE_NEXT, "Tab")
    assert(text_of(g.ed) == ghosted, "byte-identical")
    fixture_free(g)
}

fn cmdline_ghost_accept_is_a_motion_when_nothing_is_suggested() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    type_text(mut f.ed, "quit")
    assert(caret(f.ed) == 4, "at the end")
    press(mut f.ed, term.KEY_LEFT)
    assert(caret(f.ed) == 3, "left")
    press(mut f.ed, term.KEY_RIGHT)
    assert(caret(f.ed) == 4, "right is a motion")
    assert(text_of(f.ed) == "quit", "nothing inserted")
    fixture_free(f)
}

fn cmdline_printable_edit_resets_history_walk_to_new_draft() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "wr")
    hist_add(mut f.ed, "write")
    ok(mut f.ed, C_HIST_PREV, "Up")
    assert(f.ed.cmdline.walk.on, "a walk")
    assert(f.ed.cmdline.walk.seen.len == 1, "one seen")
    assert(walk_term(f.ed) == "wr", "the term")
    press(mut f.ed, '!' as int)
    assert(text_of(f.ed) == "write!", "typed")
    assert(!f.ed.cmdline.walk.on, "the walk ended")
    assert(f.ed.cmdline.walk.term.len == 0, "its term dropped")
    ok(mut f.ed, C_HIST_PREV, "Up")
    assert(f.ed.cmdline.walk.on, "a new walk")
    assert(walk_draft(f.ed) == "write!", "from the line as it is")
    assert(walk_term(f.ed) == "write!", "its term")
    assert(f.ed.cmdline.walk.seen.len == 0, "nothing seen")
    fixture_free(f)
}

fn cmdline_save_as_seeds_the_write_line_with_the_current_path() {
    var f = fixture()
    let path = "{f.state}/named.txt"
    let b = f.ed.wins[f.ed.win].buf
    f.ed.bufs[b].path = path
    f.ed.bufs[b].has_path = true
    assert(!f.ed.cmdline.active, "closed")
    ok(mut f.ed, C_SAVE_AS, "save as")
    assert(f.ed.cmdline.active, "open")
    assert(f.ed.cmdline.kind == edit.PROMPT_CMD, "the : prompt")
    assert(f.ed.mode == edit.MODE_E, "E")
    assert(text_of(f.ed) == "w {path}", "seeded")
    assert(!edit.buf_dirty(f.ed.bufs[b]), "nothing written")
    edit.cmdline_close(mut f.ed, false)
    fixture_free(f)
}

fn cmdline_save_as_on_a_pathless_buffer_seeds_the_bare_verb() {
    var f = fixture()
    let b = f.ed.wins[f.ed.win].buf
    assert(!f.ed.bufs[b].has_path, "no path")
    ok(mut f.ed, C_SAVE_AS, "save as")
    assert(f.ed.cmdline.active, "open")
    assert(text_of(f.ed) == "w ", "the bare verb")
    edit.cmdline_close(mut f.ed, false)
    fixture_free(f)
}

fn cmdline_save_as_refuses_without_a_window() {
    var f = fixture()
    let c = edit.cmdctx_new(-1, edit.SRC_TEST)
    assert(edit.fc_save_as(mut f.ed, c) == edit.CMD_ERR_STATE, "no window")
    assert(!f.ed.cmdline.active, "no prompt")
    fixture_free(f)
}

