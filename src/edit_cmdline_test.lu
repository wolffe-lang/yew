// `cmdline_enter_table` (`test_cmdline.c:1354-1363`).
fn enter_table(mut f: Fixture) {
    var i = 0
    while i < 3 && !edit.menu_focused(f.ed.cmdline.menu) {
        press(mut f.ed, term.KEY_TAB)
        i += 1
    }
    assert(edit.menu_focused(f.ed.cmdline.menu), "in the table")
}

fn cmdline_up_is_history_with_the_live_menu_open() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    hist_add(mut f.ed, "file.open notes")
    hist_add(mut f.ed, "redraw")
    type_text(mut f.ed, "fil")
    assert(f.ed.cmdline.menu.n_items > 1, "a live menu")
    assert(!f.ed.cmdline.menu.explicit_sel, "nothing chosen")
    press(mut f.ed, term.KEY_UP)
    assert(!edit.menu_focused(f.ed.cmdline.menu), "not the table")
    assert(text_of(f.ed) == "file.open notes", "the newest entry holding fil")
    assert(f.ed.cmdline.menu.n_items == 0, "the table closed")
    press(mut f.ed, term.KEY_DOWN)
    assert(text_of(f.ed) == "fil", "the draft back")
    assert(f.ed.cmdline.menu.n_items > 1, "its live table back")
    assert(!edit.menu_focused(f.ed.cmdline.menu), "not focused")
    fixture_free(f)
}

fn cmdline_up_off_the_top_row_walks_history_from_the_typed_text() {
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    hist_add(mut f.ed, "file.zzz")
    type_text(mut f.ed, "fil")
    assert(f.ed.cmdline.menu.n_items > 2, "rows")
    press(mut f.ed, term.KEY_TAB)
    var typed = text_of(f.ed)
    if edit.menu_focused(f.ed.cmdline.menu) {
        typed = "fil"
    }
    enter_table(mut f)
    assert(f.ed.cmdline.menu.sel == 0, "row 0")
    let row0 = text_of(f.ed)
    assert(row0 != typed, "the row is in the line")
    press(mut f.ed, term.KEY_DOWN)
    assert(f.ed.cmdline.menu.sel == 1, "row 1")
    assert(edit.menu_focused(f.ed.cmdline.menu), "still in the table")
    let row1 = str_from_utf8(f.ed.cmdline.menu.items[1].text) else ""
    assert(text_of(f.ed) == row1, "row 1 in the line")
    press(mut f.ed, term.KEY_UP)
    assert(f.ed.cmdline.menu.sel == 0, "row 0 again")
    assert(text_of(f.ed) == row0, "row 0 in the line")
    press(mut f.ed, term.KEY_UP)
    assert(!edit.menu_focused(f.ed.cmdline.menu), "out of the table")
    assert(f.ed.cmdline.menu.n_items == 0, "closed")
    assert(walk_term(f.ed) == typed, "the walk's term is what was typed: '{walk_term(f.ed)}'")
    assert(text_of(f.ed) == "file.zzz", "history from the typed text")
    press(mut f.ed, term.KEY_DOWN)
    assert(text_of(f.ed) == typed, "the typed text back")
    fixture_free(f)
}

fn cmdline_bang_completions_use_the_same_pager() {
    let cwd = std_env.cwd() else "."
    let root = "{cwd}/target/tests/yew-cmdbang-{std_env.pid()}"
    let bin = "{root}/bin"
    fs.remove_dir_all(root) else |_| {}
    fs.create_dir_all(bin) else |_| {
        assert(false, "bin dir")
    }
    let names = ["s5718c-alpha", "s5718c-beta", "s5718c-gamma"]
    for n in names {
        fs.write_text("{bin}/{n}", "") else |_| {
            assert(false, "exec {n}")
        }
        fs.set_mode("{bin}/{n}", 448) else |_| {
            assert(false, "chmod {n}")
        }
    }
    let saved = env_get("PATH") else ""
    env_set("PATH", bin) else |_| {}
    var f = fixture()
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    hist_add(mut f.ed, "redraw")
    type_text(mut f.ed, "!s5718c")
    assert(f.ed.cmdline.menu.n_items == 3, "the three executables")
    assert(f.ed.cmdline.menu.items[0].kind == edit.COMP_EXEC, "exec rows")
    let before = text_of(f.ed)
    press(mut f.ed, term.KEY_UP)
    assert(!edit.menu_focused(f.ed.cmdline.menu), "Up is history")
    assert(f.ed.cmdline.menu.sel == -1, "nothing chosen")
    assert(f.ed.cmdline.walk.on && f.ed.cmdline.walk.seen.len == 0, "the walk stays put")
    press(mut f.ed, term.KEY_DOWN)
    assert(f.ed.cmdline.menu.sel == -1, "nothing chosen")
    assert(f.ed.cmdline.menu.n_items == 3, "the rows kept")
    assert(text_of(f.ed) == before, "the prompt as it was")
    ok(mut f.ed, C_COMPLETE_NEXT, "Tab")
    assert(text_of(f.ed).starts_with("!s5718c-"), "the row in the body")
    edit.cmdline_close(mut f.ed, false)
    edit.cmdline_open(mut f.ed, edit.PROMPT_CMD, "")
    f.ed.ws_dir = root
    type_text(mut f.ed, "!s5718c-alpha b")
    assert(f.ed.cmdline.menu.n_items != 0, "path rows")
    assert(f.ed.cmdline.menu.items[0].kind == edit.COMP_PATH, "a path")
    assert((str_from_utf8(f.ed.cmdline.menu.items[0].text) else "") == "bin/", "bin/")
    fixture_free(f)
    env_set("PATH", saved) else |_| {}
    fs.remove_dir_all(root) else |_| {}
}

fn cmdline_enter_on_a_pager_row_accepts_without_executing() {
    var f = fixture()
