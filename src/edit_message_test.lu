//! member: false
//!
//! The port of sagitta `tests/unit/test_message.c` (310 lines), one test
//! per C test in registry order (`tests/unit/registry.c:808-813`). C's
//! fixture is a zeroed `Ed` in L mode with its timers (`message_ed_init`,
//! `test_message.c:16-21`); the port's is `edit.ed_new` with the damage
//! flags C's `memset` leaves false cleared. C formats with `printf`; the
//! port's callers pass the finished text.
//!
//! **The bell.** C points `ed.tty.wfd` at a pipe and reads the bell back
//! (`test_message.c:72-89`); the port's terminal is the process's stdout,
//! so the case re-runs this test as a child with stdout on a scratch file
//! and reads that back — and holds the stronger fact that the warning
//! wrote nothing at all. On the checked machine `os_exe()` is `wolf`,
//! which cannot re-run the file (G23): the case says SKIP there, loudly,
//! and runs on the native lane.
//!
//! The tail of `message_draw_retains_chip_and_caps_overlay`
//! (`test_message.c:290-301`) draws the macro recorder's REC chip beside
//! the message; it said SKIP until the recorder (yw09, Sprints 35 and 38)
//! gave `ed.rec` its state, and runs now.

use edit
use std.fs
use std.process
use term
use text
use unicode

const BELL_PATH: str = "target/tests/edit-message-test.bell"

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn str_of(b: List[byte]) -> str {
    str_from_utf8(b) else ""
}

// `message_ed_init` (`test_message.c:16-21`).
fn message_ed() -> edit.Ed {
    var ed = edit.ed_new()
    ed.mode = edit.MODE_L
    ed.full_damage = false
    ed.footer_dirty = false
    ed.layout_dirty = false
    ed
}

fn int_max() -> int {
    let max: int = 9223372036854775807
    max
}

fn t_message_expiry_and_replacement_rules() {
    var ed = message_ed()
    edit.ed_msg_at(mut ed, edit.MSG_INFO, 1000, "info 7")
    assert(ed.msg.active, "info is shown")
    assert(ed.msg.text == "info 7", "the text")
    assert(ed.msg.expiry != edit.TIMER_NONE, "info expires")
    assert(edit.timers_deadline(ed.timers, 1000) == 4000, "info lasts 4 s")
    edit.ed_timers_fire(mut ed, 4999)
    assert(ed.msg.active, "still shown at 4.999 s")
    edit.ed_timers_fire(mut ed, 5000)
    assert(!ed.msg.active, "gone at 5 s")
    assert(ed.msg.expiry == edit.TIMER_NONE, "no timer left")
    assert(!ed.full_damage, "a one-row message is no full repaint")

    ed.full_damage = false
    edit.ed_msg_at(mut ed, edit.MSG_WARN, 2000, "careful")
    assert(ed.msg.sev == edit.MSG_WARN, "a warning")
    assert(edit.timers_deadline(ed.timers, 2000) == 8000, "a warning lasts 8 s")
    edit.ed_timers_fire(mut ed, 9999)
    assert(ed.msg.active, "still shown at 9.999 s")
    edit.ed_timers_fire(mut ed, 10000)
    assert(!ed.msg.active, "gone at 10 s")

    edit.ed_msg_at(mut ed, edit.MSG_ERROR, 3000, "disk error")
    assert(ed.msg.active, "the error shows")
    assert(ed.msg.sev == edit.MSG_ERROR, "an error")
    assert(ed.msg.expiry == edit.TIMER_NONE, "an error never expires")
    assert(edit.timers_deadline(ed.timers, 3000) == -1, "no deadline")
    edit.ed_timers_fire(mut ed, int_max())
    assert(ed.msg.active, "the error outlives every clock")

    edit.ed_msg_at(mut ed, edit.MSG_INFO, 4000, "wrote file")
    assert(ed.msg.sev == edit.MSG_ERROR, "info does not displace an error")
    assert(ed.msg.text == "disk error", "the error text stays")
    edit.ed_msg_at(mut ed, edit.MSG_WARN, 4000, "warning replaces error")
    assert(ed.msg.sev == edit.MSG_WARN, "a warning does")
    assert(ed.msg.text == "warning replaces error", "the warning text")
    assert(edit.timers_deadline(ed.timers, 4000) == 8000, "and it expires")

    edit.ed_msg_clear(mut ed)
    assert(!ed.msg.active, "cleared")
    assert(edit.timers_deadline(ed.timers, 4000) == -1, "its timer cancelled")
}

fn child_bell() -> int {
    var ed = message_ed()
    ed.tty_ready = true
    ed.errorbells = true
    edit.ed_msg_at(mut ed, edit.MSG_WARN, 1000, "warning")
    edit.ed_msg_at(mut ed, edit.MSG_ERROR, 1000, "error")
    0
}

fn t_message_errorbells_write_only_for_errors() -> int {
    let exe = os_exe() else {
        assert(false, "errorbells requires its own executable")
        return 0
    }
    fs.remove(BELL_PATH) else |_| {}
    var c = process.command(exe)
    process.push_arg(mut c, "--bell")
    let sink = fs.create_with_mode(BELL_PATH, 0o600) else |_| {
        assert(false, "open the stdout capture")
        return 0
    }
    process.set_stdout(mut c, sink)
    let child = process.start(c) else |_| {
        assert(false, "spawn the child")
        return 0
    }
    let status = process.wait_status(take child) else -1
    fs.close(take sink) else |_| {}
    assert(status == 0, "the child exits 0, got {status}")
    let got = fs.read_bytes(BELL_PATH) else List[byte]()
    assert(got.len == 1, "one byte written (the warning rings nothing), got {got.len}")
    assert(got[0] as int == 7, "the byte is BEL")
    0
}

fn t_message_prompt_and_expand_lifetime() {
    var ed = message_ed()
    ed.prompt = edit.PROMPT_QUIT_DIRTY
    edit.ed_msg_at(mut ed, edit.MSG_ERROR, 100, "save? [w] [d]")
    assert(ed.msg.active, "the prompt shows")
    assert(ed.msg.prompt, "it is a prompt")
    assert(ed.msg.expiry == edit.TIMER_NONE, "a prompt never expires")
    edit.ed_timers_fire(mut ed, int_max())
    assert(ed.msg.active, "the prompt outlives every clock")

    ed.prompt = edit.PROMPT_NONE
    edit.ed_msg_at(mut ed, edit.MSG_WARN, 200, "background warning")
    assert(ed.msg.active, "still shown")
    assert(ed.msg.prompt, "still the prompt")
    assert(ed.msg.text == "save? [w] [d]", "a background message does not displace it")

    assert(!edit.ed_msg_expand(mut ed), "nothing to expand")
    ed.msg.truncated = true
    ed.full_damage = false
    assert(edit.ed_msg_expand(mut ed), "a truncated message expands")
    assert(ed.msg.expanded, "expanded")
    assert(ed.full_damage, "the overlay is a full repaint")
    assert(!edit.ed_msg_expand(mut ed), "once")
    ed.full_damage = false
    assert(edit.ed_msg_dismiss_overlay(mut ed), "the overlay dismisses")
    assert(!ed.msg.expanded, "collapsed")
    assert(ed.full_damage, "a full repaint")
    assert(!edit.ed_msg_dismiss_overlay(mut ed), "once")

    edit.ed_msg_clear(mut ed)
    assert(!ed.msg.prompt, "cleared: no prompt")
    assert(!ed.msg.expanded, "cleared: not expanded")

    var long = List[byte]()
    var i = 0
    while i < 699 {
        (mut long).push(120 as byte)
        i += 1
    }
    let long_message = str_of(long)
    edit.ed_msg_at(mut ed, edit.MSG_WARN, 300, long_message)
    assert(ed.msg.text.len == 699, "the whole message is kept")
    assert(ed.msg.text == long_message, "byte for byte")
}

fn clip(s: str, cells: int) -> (List[byte], bool) {
    edit.message_clip(bytes_of(s), cells)
}

fn width1(b: List[byte]) -> int {
    unicode.str_width(b, 0, b.len, 1)
}

fn t_message_unicode_cell_truncation() {
    let cjk = "A\u{6f22}B"
    let combining = "e\u{301}x"
    let family = "\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467}\u{200d}\u{1f466}x"

    let (o1, c1) = clip("abcdefg", 6)
    assert(c1, "cut")
    assert(o1.len == 8, "five bytes and the ellipsis")
    assert(str_of(o1) == "abcde\u{2026}", "abcde…")
    assert(width1(o1) == 6, "six cells")

    let (o2, c2) = clip(cjk, 4)
    assert(!c2, "A漢B fits four cells")
    assert(o2.len == cjk.len, "all of it")
    assert(str_of(o2) == cjk, "unchanged")
    let (o3, c3) = clip(cjk, 3)
    assert(c3, "three cells cut it")
    assert(str_of(o3) == "A\u{2026}", "the wide glyph is not split")
    assert(width1(o3) == 2, "two cells")

    let (o4, c4) = clip(combining, 1)
    assert(c4, "one cell cuts")
    assert(str_of(o4) == "\u{2026}", "only the ellipsis")
    assert(width1(o4) == 1, "one cell")
    let (o5, c5) = clip(combining, 2)
    assert(!c5, "two cells fit")
    assert(str_of(o5) == combining, "the combining mark rides its base")

    let (o6, c6) = clip(family, 2)
    assert(c6, "the family and x need three cells")
    assert(str_of(o6) == "\u{2026}", "the ZWJ family is not split")
    assert(width1(o6) == 1, "one cell")

    let (o7, c7) = clip("x", 0)
    assert(c7, "zero cells cut")
    assert(o7.len == 0, "nothing at all")
}

fn t_message_severity_and_prompt_styles() {
    var ed = message_ed()
    ed.msg.sev = edit.MSG_INFO
    let info = edit.message_style(ed)
    assert(info.attrs == 0, "info is plain")

    ed.msg.sev = edit.MSG_WARN
    let warn = edit.message_style(ed)
    assert(warn.attrs & term.ATTR_BOLD != 0, "a warning is bold")
    assert(warn.row_fg.tag == term.COLOR_INDEXED, "an indexed warning colour")
    assert(warn.row_fg.r != info.row_fg.r || warn.row_fg.tag != info.row_fg.tag, "unlike info")

    ed.msg.sev = edit.MSG_ERROR
    let error = edit.message_style(ed)
    assert(error.attrs & term.ATTR_BOLD != 0, "an error is bold")
    assert(error.row_fg.tag == term.COLOR_INDEXED, "an indexed error colour")
    assert(error.row_fg.r != warn.row_fg.r, "unlike the warning")

    ed.msg.prompt = true
    let prompt = edit.message_style(ed)
    assert(prompt.attrs & term.ATTR_BOLD != 0, "a prompt is bold")
    assert(prompt.row_fg.tag == term.COLOR_INDEXED, "an indexed prompt colour")
    assert(prompt.row_fg.r != error.row_fg.r, "unlike the error")
    assert(prompt.row_fg.r != warn.row_fg.r, "unlike the warning")
    assert(prompt.row_bg.tag == info.row_bg.tag, "the row background is info's")
    assert(prompt.row_bg.r == info.row_bg.r, "the same colour")
}

fn cell_at(ed: edit.Ed, row: int, col: int) -> term.Cell {
    term.grid_back(ed.grid, row, col)
}

fn byte0(ed: edit.Ed, row: int, col: int) -> int {
    term.cell_byte(cell_at(ed, row, col), 0)
}

fn t_message_draw_retains_chip_and_caps_overlay() {
    var ed = message_ed()
    ed.grid = term.grid_new(6, 12)
    var ec = text.editctx_new(take text.textbuf_from_str("x\n"))
    ec.undo = text.undo_new(ec.tb)
    ec.has_undo = true
    text.undo_mark_saved(mut ec.undo, ec.tb)
    ec.meta = text.filemeta_new()
    ec.meta.eol = text.EOL_LF
    (mut ed.bufs).push(edit.Buffer {
        id: 1,
        ec: ec,
        resident: true,
        path: "",
        has_path: false,
        name: "",
        has_name: false,
        flags: 0,
        tabwidth: 0,
        recovery_pending: false,
        pairs: edit.pairstate_new(),
        named: edit.named_marks_new(),
        macro_reg: 0,
    })
    var w = edit.win_new(1, 0)
    edit.vp_init(mut w)
    w.vp.rows = 5
    w.vp.cols = 12
    (mut ed.wins).push(w)
    ed.win = 0
    ed.prev_unit = edit.MODE_L
    ed.footer_rect = edit.rect(0, 5, 12, 1)

    edit.ed_msg_at(mut ed, edit.MSG_WARN, 0, "abcdefghijklmnopqrstuvwxyz")
    edit.message_draw(mut ed, 0)
    assert(ed.msg.truncated, "the message is truncated")
    assert(byte0(ed, 5, 0) == 32, "the chip's space")
    assert(byte0(ed, 5, 1) == 76, "the chip's L")
    assert(byte0(ed, 5, 2) == 32, "the chip's space")
    assert(byte0(ed, 5, 3) == 97, "the message starts after the chip")
    assert(byte0(ed, 5, 10) == 104, "h")
    assert(byte0(ed, 5, 11) == 226, "the ellipsis")
    assert(cell_at(ed, 5, 3).fg.tag == term.COLOR_INDEXED, "the warning colour")
    assert(cell_at(ed, 5, 3).attrs & term.ATTR_BOLD != 0, "bold")

    assert(edit.ed_msg_expand(mut ed), "it expands")
    edit.message_draw(mut ed, 0)
    assert(byte0(ed, 3, 3) == 97, "row 3 begins with a")
    assert(byte0(ed, 4, 3) == 106, "row 4 begins with j")
    assert(byte0(ed, 5, 3) == 115, "row 5 begins with s")
    assert(byte0(ed, 5, 1) == 76, "the chip stays on the footer row")
    assert(cell_at(ed, 5, 0).bg.tag == term.COLOR_RGB, "in the mode's own colour")

    ed.rec.active = true
    ed.rec.reg = 'a' as int
    edit.message_draw(mut ed, 0)
    assert(byte0(ed, 5, 3) == 226, "the REC dot")
    assert(byte0(ed, 5, 4) == 82, "R")
    assert(byte0(ed, 5, 5) == 69, "E")
    assert(byte0(ed, 5, 6) == 67, "C")
    assert(byte0(ed, 5, 7) == 32, "the space")
    assert(byte0(ed, 5, 8) == 97, "the register")
    assert(cell_at(ed, 5, 3).attrs & term.ATTR_BLINK == 0, "never blinks")
    edit.ed_msg_clear(mut ed)
}

fn main() {
    fs.create_dir_all("target/tests") else |_| {}
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let args = env_args()
    if args.len == 1 && args[0] == "--bell" {
        os_exit(child_bell())
    }
    var skips = 0
    t_message_expiry_and_replacement_rules()
    skips += t_message_errorbells_write_only_for_errors()
    t_message_prompt_and_expand_lifetime()
    t_message_unicode_cell_truncation()
    t_message_severity_and_prompt_styles()
    t_message_draw_retains_chip_and_caps_overlay()
    print(
        "message_test: 6 cases run, {skips} SKIP by name (the bell on the checked machine)",
    )
}
