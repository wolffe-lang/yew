//! member: false
//!
//! The port of sagitta `tests/unit/test_undo_tree.c` (375 lines), one test
//! per C test in registry order (`tests/unit/registry.c:448-458`). C's
//! `TreeFixture` holds a buffer, a one-cursor set and an undo tree behind an
//! `EditCtx` with no marks (`test_undo_tree.c:30-43`); the port's `EditCtx`
//! owns them, and C's injected `TreeClock` is the tree's fake clock
//! (`undo.fake_mono`, `undo.fake_wall`).

use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

// `tree_fixture_init`, `test_undo_tree.c:30-43`: marks NULL, window 1.
fn fixture() -> text.EditCtx {
    let tb = text.textbuf_new()
    let undo = text.undo_new(tb)
    var ec = text.editctx_new(take tb)
    ec.cset = text.cset_init(text.Cursor { pos: 0, goal_col: 0, anchor: 0 })
    ec.has_cset = true
    ec.undo = undo
    ec.has_undo = true
    ec.win_id = 1
    text.undo_set_clock(mut ec.undo, 1000, 100)
    ec
}

// `tree_append`, `test_undo_tree.c:52-61`.
fn append(mut f: text.EditCtx, b: byte) -> int {
    f.undo.fake_mono += text.UNDO_BURST_MS
    f.undo.fake_wall += 1
    text.undo_begin(mut f, text.TXN_PASTE)
    var one = List[byte]()
    (mut one).push(b)
    let at = text.textbuf_len(f.tb)
    let _ = text.edit_insert(mut f, text.byteoff(at), one)
    text.undo_end(mut f)
    text.undo_current(f.undo)
}

// `tree_assert_text`, `test_undo_tree.c:63-85`: length, then the bytes.
fn assert_text(f: text.EditCtx, want: str) {
    assert(text.textbuf_len(f.tb) == want.len, "length of {want}")
    assert(same(text.textbuf_bytes(f.tb), bytes_of(want)), "text is {want}")
}

// `tree_node`, `test_undo_tree.c:87-92`.
fn node(ut: text.UndoTree, id: int) -> text.UndoNode {
    assert(id != 0, "a node id")
    assert(id <= ut.nodes.len, "a live id")
    copy ut.nodes[id - 1]
}

fn t_undo_tree_preserves_abandoned_branch() {
    var f = fixture()
    let a = append(mut f, 65 as byte)
    assert(text.undo(mut f), "undo")
    let b = append(mut f, 66 as byte)
    assert(a != b, "two nodes")
    assert(f.undo.nodes.len == 3, "root and two")
    let children = text.undo_children(f.undo, f.undo.root)
    assert(children.len == 2, "two children")
    assert(children[0] == a, "first child")
    assert(children[1] == b, "second child")
    assert(text.undo_to(mut f, a), "to a")
    assert_text(f, "A")
    assert(text.undo_to(mut f, b), "to b")
    assert_text(f, "B")
    assert(node(f.undo, a).flags & text.TXN_DEAD == 0, "a is live")
}

fn t_undo_tree_reopen_rejects_non_tail_branch_leaf() {
    var f = fixture()
    let a = append(mut f, 65 as byte)
    assert(text.undo(mut f), "undo")
    let b = append(mut f, 66 as byte)
    assert(text.undo_to(mut f, a), "to a")
    assert(!text.undo_reopen(mut f, text.TXN_PASTE), "non-tail leaf refused")
    assert(f.undo.depth == 0, "depth 0")
    assert(f.undo.open == 0, "none open")
    assert(!f.undo.reopened, "not reopened")
    assert_text(f, "A")
    let c = append(mut f, 67 as byte)
    assert_text(f, "AC")
    assert(node(f.undo, c).parent == a, "c under a")
    let children = text.undo_children(f.undo, f.undo.root)
    assert(children.len == 2, "two children")
    assert(children[0] == a, "first child")
    assert(children[1] == b, "second child")
    assert(text.undo(mut f), "undo")
    assert_text(f, "A")
    assert(text.undo_to(mut f, b), "to b")
    assert_text(f, "B")
}

fn t_undo_tree_reopen_abort_preserves_original_node() {
    var f = fixture()
    let id = append(mut f, 65 as byte)
    let ops_len = f.undo.ops.len
    let repairs_len = f.undo.repairs.len
    let cursors_len = f.undo.cursors.len
    let blobs_len = f.undo.blobs.len
    let node_ops = node(f.undo, id).n_ops
    assert(text.undo_reopen(mut f, text.TXN_PASTE), "reopen")
    let _ = text.edit_insert(mut f, text.byteoff(1), bytes_of("B"))
    assert_text(f, "AB")
    text.undo_abort(mut f)
    assert_text(f, "A")
    assert(text.undo_current(f.undo) == id, "still the node")
    assert(f.undo.depth == 0, "depth 0")
    assert(f.undo.open == 0, "none open")
    assert(!f.undo.reopened, "not reopened")
    assert(f.undo.nodes.len == 2, "no new node")
    assert(node(f.undo, id).n_ops == node_ops, "ops kept")
    assert(f.undo.ops.len == ops_len, "op store kept")
    assert(f.undo.repairs.len == repairs_len, "repair store kept")
    assert(f.undo.cursors.len == cursors_len, "cursor store kept")
    assert(f.undo.blobs.len == blobs_len, "blob store kept")
    assert(text.undo(mut f), "undo")
    assert_text(f, "")
    assert(text.redo(mut f), "redo")
    assert_text(f, "A")
}

fn t_undo_tree_reopen_commit_reuses_cursor_snapshot_storage() {
    var f = fixture()
    let id = append(mut f, 65 as byte)
    assert(f.undo.cursors.len == 2, "before and after")
    var i = 0
    while i < 100 {
        assert(text.undo_reopen(mut f, text.TXN_PASTE), "reopen")
        let at = text.textbuf_len(f.tb)
        let _ = text.edit_insert(mut f, text.byteoff(at), bytes_of("x"))
        text.undo_end(mut f)
        assert(text.undo_current(f.undo) == id, "same node")
        assert(f.undo.cursors.len == 2, "storage reused")
        let n = node(f.undo, id)
        assert(n.cur_before == 0, "before at 0")
        assert(n.cur_after == 1, "after at 1")
        i += 1
    }
    assert(node(f.undo, id).n_ops == 101, "101 ops")
    assert(text.undo(mut f), "undo")
    assert_text(f, "")
    assert(text.redo(mut f), "redo")
    assert(text.textbuf_len(f.tb) == 101, "101 bytes")
}

fn t_undo_tree_redo_child_tracks_most_recent_traversal() {
    var f = fixture()
    let a = append(mut f, 65 as byte)
    assert(text.undo(mut f), "undo")
    let b = append(mut f, 66 as byte)
    assert(node(f.undo, f.undo.root).redo_child == b, "redo child b")
    assert(text.undo(mut f), "undo")
    assert(text.undo_to(mut f, a), "to a")
    assert(node(f.undo, f.undo.root).redo_child == a, "redo child a")
    assert(text.undo(mut f), "undo")
    assert(text.redo(mut f), "redo")
    assert(text.undo_current(f.undo) == a, "at a")
    assert_text(f, "A")
}

fn t_undo_tree_branch_cycle_rotates_live_siblings() {
    var f = fixture()
    let a = append(mut f, 65 as byte)
    assert(text.undo(mut f), "undo")
    let b = append(mut f, 66 as byte)
    assert(text.undo(mut f), "undo")
    assert(text.undo_branch_cycle(mut f.undo, 1) == a, "cycle to a")
    assert(node(f.undo, f.undo.root).redo_child == a, "redo child a")
    assert(text.undo_branch_cycle(mut f.undo, 1) == b, "cycle to b")
    assert(text.undo_branch_cycle(mut f.undo, -1) == a, "back to a")
    assert(text.undo_current(f.undo) == f.undo.root, "still at root")
}

fn t_undo_tree_state_navigation_crosses_branches_by_id() {
    var f = fixture()
    let a = append(mut f, 65 as byte)
    assert(text.undo(mut f), "undo")
    let b = append(mut f, 66 as byte)
    assert(text.undo_to(mut f, a), "to a")
    assert(text.undo_state(mut f, 1), "state +1")
    assert(text.undo_current(f.undo) == b, "at b")
    assert_text(f, "B")
    assert(text.undo_state(mut f, -1), "state -1")
    assert(text.undo_current(f.undo) == a, "at a")
    assert_text(f, "A")
    let moved = text.undo_state(mut f, -1)
    assert(!moved || text.undo_current(f.undo) == f.undo.root, "root or refused")
}

fn t_undo_tree_wall_clock_is_clamped_monotone() {
    var f = fixture()
    f.undo.fake_wall = 500
    let a = append(mut f, 65 as byte)
    f.undo.fake_wall = 100
    let b = append(mut f, 66 as byte)
    assert(node(f.undo, a).t_wall >= 501, "a at 501")
    assert(node(f.undo, b).t_wall == node(f.undo, a).t_wall, "b clamped to a")
    let root = f.undo.root
    assert(text.undo_to(mut f, root), "to root")
    let b_wall = node(f.undo, b).t_wall
    assert(text.undo_time(mut f, b_wall), "to the time")
    assert(text.undo_current(f.undo) == b, "at b")
    assert_text(f, "AB")
}

fn t_undo_tree_lca_moves_between_deep_branches() {
    var f = fixture()
    var trunk = List[int]()
    var branch_a = List[int]()
    var branch_b = List[int]()
    var i = 0
    while i < 5 {
        (mut trunk).push(append(mut f, (48 + i) as byte))
        i += 1
    }
    assert(text.undo_to(mut f, trunk[1]), "to trunk 1")
    i = 0
    while i < 3 {
        (mut branch_a).push(append(mut f, (97 + i) as byte))
        i += 1
    }
    assert(text.undo_to(mut f, trunk[1]), "to trunk 1 again")
    i = 0
    while i < 3 {
        (mut branch_b).push(append(mut f, (120 + i) as byte))
        i += 1
    }
    assert(node(f.undo, branch_a[2]).depth == 5, "a leaf depth")
    assert(node(f.undo, branch_b[2]).depth == 5, "b leaf depth")
    assert(text.undo_to(mut f, branch_a[2]), "to a leaf")
    assert_text(f, "01abc")
    assert(text.undo_to(mut f, branch_b[2]), "to b leaf")
    assert_text(f, "01xyz")
    assert(text.undo_current(f.undo) == branch_b[2], "at b leaf")
    assert(node(f.undo, branch_b[0]).parent == trunk[1], "b under trunk 1")
    assert(node(f.undo, branch_a[0]).parent == trunk[1], "a under trunk 1")
}

fn t_undo_tree_save_point_tracks_current_state() {
    var f = fixture()
    let _ = append(mut f, 65 as byte)
    text.undo_mark_saved(mut f.undo, f.tb)
    let saved = text.undo_current(f.undo)
    assert(text.undo_at_save_point(f.undo), "at the save point")
    assert(f.undo.saved == saved, "saved id")
    assert(node(f.undo, saved).flags & text.TXN_SAVED != 0, "flagged saved")
    let _ = append(mut f, 66 as byte)
    assert(!text.undo_at_save_point(f.undo), "moved off")
    assert(text.undo(mut f), "undo")
    assert(text.undo_at_save_point(f.undo), "back on")
    assert(text.undo_current(f.undo) == saved, "at saved")
}

fn t_undo_tree_query_reports_path_and_byte_totals() {
    var f = fixture()
    text.undo_begin(mut f, text.TXN_PASTE)
    let _ = text.edit_insert(mut f, text.byteoff(0), bytes_of("abcd"))
    let _ = text.edit_delete(mut f, text.span(1, 3))
    text.undo_end(mut f)
    let info = text.undo_list(f.undo)
    assert(info.len == 2, "two nodes")
    assert(info[0].on_current_path, "root on path")
    assert(info[1].on_current_path, "node on path")
    assert(info[1].is_current, "node current")
    assert(info[1].bytes_ins == 4, "four inserted")
    assert(info[1].bytes_del == 2, "two deleted")
    assert(info[1].n_children == 0, "a leaf")
    let desc = text.undo_describe(f.undo, info[1].id, f.undo.fake_wall + 180)
    assert(desc.contains("+4"), "names +4")
    assert(desc.contains("-2") || desc.contains("\u{2212}2"), "names -2")
}

fn main() {
    t_undo_tree_preserves_abandoned_branch()
    t_undo_tree_reopen_rejects_non_tail_branch_leaf()
    t_undo_tree_reopen_abort_preserves_original_node()
    t_undo_tree_reopen_commit_reuses_cursor_snapshot_storage()
    t_undo_tree_redo_child_tracks_most_recent_traversal()
    t_undo_tree_branch_cycle_rotates_live_siblings()
    t_undo_tree_state_navigation_crosses_branches_by_id()
    t_undo_tree_wall_clock_is_clamped_monotone()
    t_undo_tree_lca_moves_between_deep_branches()
    t_undo_tree_save_point_tracks_current_state()
    t_undo_tree_query_reports_path_and_byte_totals()
    print("undo_tree_test: 11 cases pass")
}
