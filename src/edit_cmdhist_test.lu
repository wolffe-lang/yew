//! member: false
//!
//! The port of sagitta `tests/unit/test_cmdhist.c` (332 lines), one test
//! per C test in registry order (`tests/unit/registry.c:1018-1024`).
//!
//! C's fixture makes a `mkdtemp` directory under `/tmp` and points
//! `XDG_STATE_HOME` at it (`test_cmdhist.c:31-40`); the port makes its
//! scratch root under the run's own state directory (the container's, or
//! `target/test-state`), never the host's `~/.local/state`, and restores
//! the variable after. `yew_test_capture_log` is `YEW_LOG` pointed at a
//! scratch file and read back. C's `YewHistView {h, NULL}` is
//! `VIEW_HIST` with the history and an empty snapshot beside it.

use edit
use std.fs

fn bytes_of(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() {
        (mut out).push(b)
    }
    out
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn is_text(got: List[byte], want: str) -> bool {
    same(got, bytes_of(want))
}

fn at_is(h: edit.CmdHist, i: int, want: str) -> bool {
    let got = edit.hist_at(h, i) else {
        return false
    }
    is_text(got, want)
}

struct Fixture {
    root: str,
    saved_state: str,
    had_state: bool,
}

fn scratch_base() -> str {
    let state = env_get("XDG_STATE_HOME") else ""
    if state.len != 0 {
        return state
    }
    "target/test-state"
}

// `hist_fixture_init` (`test_cmdhist.c:31-40`).
fn fixture_init() -> Fixture {
    let saved = env_get("XDG_STATE_HOME") else ""
    let had = (env_get("XDG_STATE_HOME") else "#unset") != "#unset"
    let base = scratch_base()
    fs.create_dir_all(base) else |_| {}
    var n = 0
    var root = ""
    loop {
        root = "{base}/yew-hist-{time_unix_ms()}-{n}"
        fs.create_dir(root) else |e| match e {
            exists => {
                n += 1
                continue
            },
            not_found => { assert(false, "scratch root {root}: not found") },
            denied => { assert(false, "scratch root {root}: denied") },
            io => { assert(false, "scratch root {root}: io") },
        }
        break
    }
    env_set("XDG_STATE_HOME", root) else |_| {}
    Fixture { root: root, saved_state: saved, had_state: had }
}

// `hist_fixture_free` (`test_cmdhist.c:42-66`): the history files (and
// any lock file) removed, then the directories, which must be empty.
fn fixture_free(f: Fixture) {
    for name in ["cmd", "cmd.lock", "search", "search.lock", "shell", "shell.lock"] {
        let path = "{f.root}/yew/history/{name}"
        if fs.is_file(path) {
            fs.remove(path) else |_| {
                assert(false, "unlink {path}")
            }
        }
    }
    fs.remove_dir("{f.root}/yew/history") else |_| {
        assert(false, "rmdir {f.root}/yew/history")
    }
    fs.remove_dir("{f.root}/yew") else |_| {
        assert(false, "rmdir {f.root}/yew")
    }
    fs.remove_dir(f.root) else |_| {
        assert(false, "rmdir {f.root}")
    }
    if f.had_state {
        env_set("XDG_STATE_HOME", f.saved_state) else |_| {}
    } else {
        env_unset("XDG_STATE_HOME") else |_| {}
    }
}

// `write_exact` (`test_cmdhist.c:68-80`): append these bytes.
fn write_exact(path: str, bytes: List[byte]) {
    if !fs.exists(path) {
        let made = fs.create_with_mode(path, 0o600) else |_| {
            assert(false, "create {path}")
            return
        }
        fs.close(take made) else |_| {}
    }
    var f = fs.open_append(path) else |_| {
        assert(false, "open {path}")
        return
    }
    fs.write_chunk(mut f, bytes) else |_| {
        assert(false, "write {path}")
    }
    fs.close(take f) else |_| {}
}

fn capture_log(root: str) -> str {
    let log = "{root}.log"
    fs_write_bytes(log, List[byte]()) else |_| {}
    env_set("YEW_LOG", log) else |_| {}
    log
}

fn log_contains(log: str, level: str, needle: str) -> bool {
    let bytes = fs_read_bytes(log) else |_| List[byte]()
    let text = str_from_utf8(bytes) else ""
    for line in text.lines() {
        if line.contains(" {level}: ") && line.contains(needle) {
            return true
        }
    }
    false
}

fn release_log(log: str) {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    fs.remove(log) else |_| {}
}

fn t_cmdhist_memory_rules() {
    var h = edit.hist_open_memory()
    assert(edit.hist_is_memory(h), "memory")
    edit.hist_add_str(mut h, "alpha")
    edit.hist_add_str(mut h, "beta")
    edit.hist_add_str(mut h, "alpha")
    assert(edit.hist_len(h) == 2, "dedupe moves to the end")
    assert(at_is(h, 0, "beta"), "beta first")
    assert(at_is(h, 1, "alpha"), "alpha last")
    edit.hist_add_str(mut h, "alpha")
    assert(edit.hist_len(h) == 2, "the last repeated is no change")
    edit.hist_add_str(mut h, " hidden")
    edit.hist_add_str(mut h, "")
    assert(edit.hist_len(h) == 2, "a leading space and an empty line are not kept")

    var long_line = List[byte]()
    var i = 0
    while i < edit.HIST_LINE_MAX + 127 {
        (mut long_line).push(120 as byte)
        i += 1
    }
    edit.hist_add(mut h, long_line)
    let got = edit.hist_at(h, 2) else List[byte]()
    assert(got.len == edit.HIST_LINE_MAX, "a long line is capped")

    i = 0
    while i < edit.HIST_MAX + 5 {
        edit.hist_add_str(mut h, "value-{fmt_pad4(i)}")
        i += 1
    }
    assert(edit.hist_len(h) == edit.HIST_MAX, "the cap")
    assert(at_is(h, 0, "value-0005"), "the oldest after the cap")
    assert(at_is(h, edit.HIST_MAX - 1, "value-1004"), "the newest")
    edit.hist_flush(mut h)
}

fn fmt_pad4(n: int) -> str {
    if n < 10 {
        return "000{n}"
    }
    if n < 100 {
        return "00{n}"
    }
    if n < 1000 {
        return "0{n}"
    }
    "{n}"
}

fn t_cmdhist_frozen_stem_navigation() {
    var h = edit.hist_open_memory()
    var cur = edit.histcur_new()
    edit.hist_add_str(mut h, "write old")
    edit.hist_add_str(mut h, "other")
    edit.hist_add_str(mut h, "write new")
    edit.hist_cur_reset(mut cur, bytes_of("wr"))
    let a = edit.hist_prev(h, mut cur) else List[byte]()
    assert(is_text(a, "write new"), "prev 1")
    assert(cur.has_stem && is_text(cur.stem, "wr"), "the stem is frozen")
    let b = edit.hist_prev(h, mut cur) else List[byte]()
    assert(is_text(b, "write old"), "prev 2")
    var past = true
    let _ = edit.hist_prev(h, mut cur) else {
        past = false
        List[byte]()
    }
    assert(!past, "past the oldest")
    let c = edit.hist_next(h, mut cur) else List[byte]()
    assert(is_text(c, "write new"), "next 1")
    let d = edit.hist_next(h, mut cur) else List[byte]()
    assert(is_text(d, "wr"), "next back at the draft")
    assert(cur.idx == -1, "at rest")
    var more = true
    let _ = edit.hist_next(h, mut cur) else {
        more = false
        List[byte]()
    }
    assert(!more, "nothing newer than the draft")

    edit.hist_cur_reset(mut cur, bytes_of("other draft"))
    var found = true
    let _ = edit.hist_prev(h, mut cur) else {
        found = false
        List[byte]()
    }
    assert(!found, "no entry starts with the draft")
    assert(is_text(cur.stem, "other draft"), "stem")
    assert(is_text(cur.draft, "other draft"), "draft")
    edit.hist_cur_dispose(mut cur)
}

fn older(mut w: edit.HistWalk, h: edit.CmdHist, s: edit.HistSuggest, v: int) -> str {
    let e = edit.hist_walk_older(mut w, h, s, v) else {
        return "<none>"
    }
    str_from_utf8(e) else "<bytes>"
}

fn newer(mut w: edit.HistWalk, h: edit.CmdHist, s: edit.HistSuggest, v: int) -> (str, bool) {
    let (e, at_draft) = edit.hist_walk_newer(mut w, h, s, v) else {
        return ("<none>", false)
    }
    if at_draft {
        return ("<draft>", true)
    }
    (str_from_utf8(e) else "<bytes>", false)
}

fn current(w: edit.HistWalk, h: edit.CmdHist, s: edit.HistSuggest, v: int) -> str {
    let e = edit.hist_walk_current(w, h, s, v) else {
        return "<none>"
    }
    str_from_utf8(e) else "<bytes>"
}

// Sprint 57.30 §2: the smart walk — substring, newest first, a frozen
// term, duplicates skipped, Down past the newest back at the draft.
fn t_cmdhist_smart_walk_substring_and_draft() {
    var h = edit.hist_open_memory()
    let s = edit.hist_suggest_new()
    let v = edit.VIEW_HIST
    var w = edit.hist_walk_new()
    edit.hist_add_str(mut h, "set wrap")
    edit.hist_add_str(mut h, "write old")
    edit.hist_add_str(mut h, "other")
    edit.hist_add_str(mut h, "rewrite")
    assert(edit.hist_view_len(h, s, v) == 4, "view len")
    let first = edit.hist_view_at(h, s, v, 0) else List[byte]()
    assert(is_text(first, "rewrite"), "index 0 is the newest")
    var past = true
    let _ = edit.hist_view_at(h, s, v, 4) else {
        past = false
        List[byte]()
    }
    assert(!past, "past the end")

    edit.hist_walk_begin(mut w, bytes_of("wr"), bytes_of("wr"))
    assert(current(w, h, s, v) == "<none>", "nothing walked yet")
    let (n0, d0) = newer(mut w, h, s, v)
    assert(n0 == "<none>" && !d0, "nothing newer")
    assert(older(mut w, h, s, v) == "rewrite", "a substring, not a prefix")
    assert(older(mut w, h, s, v) == "write old", "older 2")
    assert(older(mut w, h, s, v) == "set wrap", "older 3")
    assert(current(w, h, s, v) == "set wrap", "current")
    assert(older(mut w, h, s, v) == "<none>", "past the oldest it stays put")
    assert(current(w, h, s, v) == "set wrap", "still there")
    assert(is_text(w.term, "wr"), "the term is frozen")
    let (n1, _) = newer(mut w, h, s, v)
    assert(n1 == "write old", "newer 1")
    let (n2, _) = newer(mut w, h, s, v)
    assert(n2 == "rewrite", "newer 2")
    let (n3, d3) = newer(mut w, h, s, v)
    assert(n3 == "<draft>" && d3, "back at the draft")
    assert(is_text(w.draft, "wr"), "the draft")
    assert(current(w, h, s, v) == "<none>", "at the draft")

    edit.hist_walk_begin(mut w, List[byte](), List[byte]())
    assert(older(mut w, h, s, v) == "rewrite", "an empty term walks everything")
    assert(older(mut w, h, s, v) == "other", "everything")
    edit.hist_walk_begin(mut w, bytes_of("WR"), bytes_of("WR"))
    assert(older(mut w, h, s, v) == "<none>", "case-sensitive")
    edit.hist_walk_end(mut w)
    assert(!w.on, "ended")
    edit.hist_walk_end(mut w)
}

// An entry equal to one this walk already showed is skipped; the view
// is built by hand (`test_cmdhist.c:162-197`).
fn t_cmdhist_smart_walk_skips_duplicates() {
    let h = edit.hist_open_memory()
    var s = edit.hist_suggest_new()
    s.pool = bytes_of("git log\x00ls\x00git log\x00git status\x00")
    s.off = [0, 8, 11, 19]
    let v = edit.VIEW_SUGGEST
    var w = edit.hist_walk_new()
    edit.hist_walk_begin(mut w, bytes_of("!g"), bytes_of("g"))
    assert(older(mut w, h, s, v) == "git log", "first")
    assert(older(mut w, h, s, v) == "git status", "ls does not match; the second git log was shown")
    assert(w.seen.len == 2, "two seen")
    assert(w.seen[1] == 3, "the fourth entry")
    assert(older(mut w, h, s, v) == "<none>", "no more")
    let (n, d) = newer(mut w, h, s, v)
    assert(n == "git log" && !d, "newer")
    edit.hist_walk_end(mut w)

    let at = edit.hist_find(bytes_of("abcabc"), bytes_of("ca")) else 99
    assert(at == 2, "find ca")
    let miss = edit.hist_find(bytes_of("abc"), bytes_of("abcd")) else -1
    assert(miss == -1, "a term longer than the text")
    let upper = edit.hist_find(bytes_of("abc"), bytes_of("C")) else -1
    assert(upper == -1, "case-sensitive")
    let empty = edit.hist_find(bytes_of("abc"), List[byte]()) else 99
    assert(empty == 0, "an empty term at 0")
    let tail = edit.hist_find(bytes_of("xxab"), bytes_of("ab")) else 99
    assert(tail == 2, "at the tail")
}

fn t_cmdhist_escape_corruption_and_xdg() {
    var odd = List[byte]()
    for c in [97, 92, 10, 9, 13, 255, 122] {
        (mut odd).push(c as byte)
    }
    let corrupt = bytes_of("bad\\q\nshort\\xG0\nincomplete\\")
    let f = fixture_init()
    var h = edit.hist_open_memory()
    edit.hist_add_str(mut h, "never-written")
    edit.hist_flush(mut h)
    assert(!fs.exists("{f.root}/yew"), "an in-memory history writes nothing")

    h = edit.hist_open("cmd")
    assert(!edit.hist_is_memory(h), "a persistent history")
    edit.hist_add(mut h, odd)
    edit.hist_add_str(mut h, "plain")
    edit.hist_flush(mut h)

    h = edit.hist_open("cmd")
    assert(edit.hist_len(h) == 2, "two entries read back")
    let back = edit.hist_at(h, 0) else List[byte]()
    assert(same(back, odd), "the odd bytes round-trip")
    assert(at_is(h, 1, "plain"), "plain")

    write_exact("{f.root}/yew/history/cmd", corrupt)
    let log = capture_log(f.root)
    h = edit.hist_open("cmd")
    assert(edit.hist_len(h) == 2, "the corrupt lines are dropped")
    assert(log_contains(log, "warn", "dropping corrupt history entry"), "corrupt warned")
    assert(log_contains(log, "warn", "dropping incomplete history entry"), "incomplete warned")
    release_log(log)
    fixture_free(f)
}

fn t_cmdhist_concurrent_handles_preserve_appends() {
    let f = fixture_init()
    var first = edit.hist_open("search")
    var second = edit.hist_open("search")
    edit.hist_add_str(mut first, "from-first")
    edit.hist_add_str(mut second, "from-second")
    edit.hist_flush(mut first)
    edit.hist_flush(mut second)
    let check = edit.hist_open("search")
    assert(edit.hist_len(check) == 2, "both appends kept")
    assert(at_is(check, 0, "from-first"), "first")
    assert(at_is(check, 1, "from-second"), "second")
    fixture_free(f)
}

fn t_cmdhist_flush_read_failure_preserves_state() {
    let f = fixture_init()
    var h = edit.hist_open("shell")
    edit.hist_add_str(mut h, "preserve")
    let path = "{f.root}/yew/history/shell"
    fs.remove(path) else |_| {
        assert(false, "unlink the history")
    }
    fs.create_dir_mode(path, 0o700) else |_| {
        assert(false, "a directory in its place")
    }
    let log = capture_log(f.root)
    edit.hist_flush(mut h)
    assert(fs.is_dir(path), "still a directory")
    assert(edit.hist_len(h) == 1, "the state is kept")
    assert(at_is(h, 0, "preserve"), "preserve")
    assert(log_contains(log, "warn", "cannot read command history"), "warned")
    release_log(log)
    fs.remove_dir(path) else |_| {
        assert(false, "rmdir the stand-in")
    }
    fixture_free(f)
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_cmdhist_memory_rules()
    t_cmdhist_frozen_stem_navigation()
    t_cmdhist_smart_walk_substring_and_draft()
    t_cmdhist_smart_walk_skips_duplicates()
    t_cmdhist_escape_corruption_and_xdg()
    t_cmdhist_concurrent_handles_preserve_appends()
    t_cmdhist_flush_read_failure_preserves_state()
    print("cmdhist_test: 7 cases run, 0 SKIP")
}
