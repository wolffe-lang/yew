//! member: false
//! The nine tests/unit/test_fl_cmds.c cases at sagitta 9ace98c2, in
//! registry order: the commands the Fletch rows name, invoked directly as
//! C's `invoke` does (test_fl_cmds.c:22-40). C's primary buffer (the
//! embedded `ed->buffer`, `ws.bufs[0]`) is the port's buffer index 0; a
//! closed buffer's slot is retired in place (id 0), so C's
//! `yew_ws_buf_by_id(ed, id) == NULL` is `ed_buf_index(ed, id) < 0` and
//! `ws.nbufs` counts the live slots.
//!
//! One assertion is named, not run: test_fl_cmds.c:177-178 and :183-184
//! read `ed.buffer.syn.entry.len`, the syntax engine's per-line state
//! (Sprint 40, yw10), which the port does not have before that lane.

use edit
use fl
use std.fs
use text

fn cmd_fixture() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed
}

// invoke (test_fl_cmds.c:22-40): a NULL sarg is no string argument; a
// span of 0..0 is no range.
fn invoke(
    mut ed: edit.Ed,
    wi: int,
    name: str,
    iarg: int,
    sarg: List[byte],
    has_sarg: bool,
    lo: int,
    hi: int,
    bang: bool,
) -> int {
    let id = edit.cmd_lookup(ed.reg, name)
    assert(id != 0, "no command {name}")
    var cx = edit.cmdctx_new(wi, edit.SRC_TEST)
    cx.count = 1
    cx.iarg = iarg
    cx.has_sarg = has_sarg
    cx.has_sbytes = has_sarg
    cx.sbytes = copy sarg
    cx.sarg = str_from_utf8(sarg) else ""
    cx.range.given = lo != 0 || hi != 0
    cx.range.tok_lo = lo
    cx.range.tok_hi = hi
    cx.bang = bang
    edit.ed_cmd_invoke(mut ed, id, mut cx)
}

fn run(mut ed: edit.Ed, wi: int, name: str) -> int {
    invoke(mut ed, wi, name, 0, List[byte](), false, 0, 0, false)
}

fn run_str(mut ed: edit.Ed, wi: int, name: str, s: str) -> int {
    invoke(mut ed, wi, name, 0, s.bytes(), true, 0, 0, false)
}

fn tmp_dir() -> str { env_get("TMPDIR") else "/tmp" }

fn suffix() -> str {
    var out = ""
    for b in os_random(6) { out += "{b}" }
    out
}

// temp_file (test_fl_cmds.c:42-53): "alpha\nbeta\n" in a fresh file.
fn temp_file() -> str {
    let path = "{tmp_dir()}/yew-fl-cmds-{suffix()}"
    fs.write_bytes(path, "alpha\nbeta\n".bytes()) else |_| { assert(false) }
    path
}

fn live_buffers(ed: edit.Ed) -> int {
    var n = 0
    for b in ed.bufs { if b.id != 0 { n += 1 } }
    n
}

fn tb_len(ed: edit.Ed, bi: int) -> int { text.textbuf_len(ed.bufs[bi].ec.tb) }

fn fl_cmd_buf_open_preserves_model_and_reuses_stable_buffer() {
    var ed = cmd_fixture()
    let path = temp_file()
    let primary_id = ed.bufs[0].id
    let w = ed.win
    assert(run_str(mut ed, w, "ed.buf.open", path) == edit.CMD_OK)
    let opened = edit.ed_doc(ed)
    assert(opened != 0)
    assert(ed.bufs[0].id == primary_id)
    assert(live_buffers(ed) == 2)
    assert(tb_len(ed, opened) == 11)
    let w2 = ed.win
    assert(run_str(mut ed, w2, "ed.buf.open", path) == edit.CMD_OK)
    assert(edit.ed_doc(ed) == opened)
    assert(live_buffers(ed) == 2)
    fs.remove(path) else |_| { assert(false) }
}

fn fl_cmd_buf_close_retargets_every_view_and_kills_handles() {
    var ed = cmd_fixture()
    let path = temp_file()
    let w = ed.win
    assert(run_str(mut ed, w, "ed.buf.open", path) == edit.CMD_OK)
    let opened = edit.ed_doc(ed)
    let opened_id = ed.bufs[opened].id
    let bh = edit.fl_h_buf_make(mut ed, opened)
    let sh = edit.fl_h_span_make(mut ed, opened, 0, 5)
    let root = ed.pane_root
    edit.layout_compute(mut ed, root, edit.rect(0, 0, 80, 24))
    let leaf = ed.pane_root
    assert(edit.pane_split(mut ed, leaf, edit.SPLIT_H) >= 0)
    let w2 = ed.win
    assert(run(mut ed, w2, "ed.buf.close") == edit.CMD_OK)
    assert(!fl.fl_h_alive(ed.handles, bh))
    assert(!fl.fl_h_alive(ed.handles, sh))
    assert(edit.ed_buf_index(ed, opened_id) < 0)
    let leaves = edit.pane_collect_leaves(ed, ed.pane_root, edit.PANE_MAX_LEAVES)
    assert(leaves.len == 2)
    for l in leaves { assert(ed.wins[ed.panes[l].win].buf == 0) }
    fs.remove(path) else |_| { assert(false) }
}

fn fl_cmd_buf_close_dirty_requires_force_and_reports_io() {
    let state = "{tmp_dir()}/yew-fl-state-{suffix()}"
    fs.create_dir_all(state) else |_| { assert(false) }
    var had_state = true
    let old_state = env_get("XDG_STATE_HOME") else { had_state = false; "" }
    env_set("XDG_STATE_HOME", state) else |_| { assert(false) }
    var ed = cmd_fixture()
    let path = temp_file()
    fs.remove(path) else |_| { assert(false) }
    let w = ed.win
    assert(run_str(mut ed, w, "ed.buf.open", path) == edit.CMD_OK)
    let opened = edit.ed_doc(ed)
    let id = ed.bufs[opened].id
    let w2 = ed.win
    assert(run_str(mut ed, w2, "ed.edit.insert.at", "x") == edit.CMD_OK)
    assert(edit.buf_dirty(ed.bufs[opened]))
    let w3 = ed.win
    assert(run(mut ed, w3, "ed.buf.close") == edit.CMD_ERR_IO)
    assert(edit.ed_buf_index(ed, id) >= 0)
    assert(ed.bufs[opened].ec.has_jrnl)
    // yew_journal_discard; the answer is whether the meta pin clears.
    let _ = text.journal_discard(mut ed.journals, mut ed.bufs[opened].ec.jrnl)
    ed.bufs[opened].ec.has_jrnl = false
    let w4 = ed.win
    assert(invoke(mut ed, w4, "ed.buf.close", 0, List[byte](), false, 0, 0, true) == edit.CMD_OK)
    if had_state {
        env_set("XDG_STATE_HOME", old_state) else |_| { assert(false) }
    } else {
        env_unset("XDG_STATE_HOME") else |_| { assert(false) }
    }
    fs.remove_dir("{state}/yew/journal") else |_| { assert(false, "the journal directory is empty") }
    fs.remove_dir("{state}/yew") else |_| { assert(false) }
    fs.remove_dir(state) else |_| { assert(false) }
}

fn fl_cmd_buf_close_primary_retires_id_without_alias() {
    var ed = cmd_fixture()
    let old_id = ed.bufs[0].id
    let old = edit.fl_h_buf_make(mut ed, 0)
    let w = ed.win
    assert(run(mut ed, w, "ed.buf.close") == edit.CMD_OK)
    assert(!fl.fl_h_alive(ed.handles, old))
    assert(ed.bufs[0].id > old_id)
    assert(tb_len(ed, 0) == 0)
    // test_fl_cmds.c:177-178: syn.entry (Sprint 40) is yw10's.
    assert(edit.ed_buf_index(ed, old_id) < 0)
    assert(edit.ed_buf_index(ed, ed.bufs[0].id) == 0)
    let w2 = ed.win
    assert(run_str(mut ed, w2, "ed.edit.insert.at", "x\n") == edit.CMD_OK)
    // test_fl_cmds.c:183-184: syn.entry again, yw10's.
}

fn fl_cmd_edit_rows_preserve_binary_and_unit_semantics() {
    var ed = cmd_fixture()
    let binary = [65 as byte, 0 as byte, 66 as byte]
    let w = ed.win
    assert(invoke(mut ed, w, "ed.edit.insert.at", 0, binary, true, 0, 0, false) == edit.CMD_OK)
    assert(tb_len(ed, 0) == 3)
    assert(invoke(mut ed, w, "ed.edit.replace.span", 0, "xy".bytes(), true, 1, 2, false) == edit.CMD_OK)
    assert(tb_len(ed, 0) == 4)
    assert(invoke(mut ed, w, "ed.cursor.set", 1, List[byte](), false, 0, 0, false) == edit.CMD_OK)
    assert(edit.ed_cursor_pos(ed) == 1)
    assert(run_str(mut ed, w, "ed.mode.enter", "C") == edit.CMD_OK)
    assert(run(mut ed, w, "ed.edit.delete.unit") == edit.CMD_OK)
    assert(tb_len(ed, 0) == 3)
    assert(invoke(mut ed, w, "ed.edit.delete.span", 0, List[byte](), false, 1, 3, false) == edit.CMD_OK)
    assert(tb_len(ed, 0) == 1)
}

fn fl_cmd_close_refuses_an_enlisted_buffer() {
    var ed = cmd_fixture()
    assert(edit.fl_runtime_init(mut ed))
    var vm = (mut ed.flrt.vms).pop() else { assert(false); return }
    assert(edit.fl_txn_run_begin(mut vm, mut ed))
    let w = ed.win
    assert(edit.fl_txn_enlist(mut vm, mut ed, w))
    assert(invoke(mut ed, w, "ed.buf.close", 0, List[byte](), false, 0, 0, true) == edit.CMD_ERR_STATE)
    assert(edit.ed_buf_index(ed, ed.bufs[0].id) == 0)
    assert(edit.fl_txn_run_end(mut ed, true))
    (mut ed.flrt.vms).push(vm)
}

fn fl_cmd_pane_close_targets_the_supplied_window() {
    var ed = cmd_fixture()
    let root = ed.pane_root
    edit.layout_compute(mut ed, root, edit.rect(0, 0, 80, 24))
    let split = ed.pane_root
    assert(edit.pane_split(mut ed, split, edit.SPLIT_H) >= 0)
    let first = ed.panes[ed.panes[split].a].win
    let second = ed.panes[ed.panes[split].b].win
    let first_id = ed.wins[first].id
    ed.focus = ed.panes[split].b
    ed.win = second
    ed.tabs[ed.tab_active].focus = ed.focus
    assert(run(mut ed, first, "ed.pane.close") == edit.CMD_OK)
    assert(edit.ed_win_by_id(ed, first_id) < 0)
    assert(ed.win == second)
    assert(ed.focus == ed.pane_root)
}

fn fl_cmd_path_commands_reject_embedded_nul() {
    var ed = cmd_fixture()
    let path = [97 as byte, 0 as byte, 98 as byte]
    let w = ed.win
    assert(invoke(mut ed, w, "ed.buf.open", 0, path, true, 0, 0, false) == edit.CMD_ERR_ARG)
    assert(invoke(mut ed, w, "ed.file.write", 0, path, true, 0, 0, false) == edit.CMD_ERR_ARG)
}

fn fl_cmd_save_targets_a_nonfocused_buffer() {
    var ed = cmd_fixture()
    let first_path = temp_file()
    let second_path = temp_file()
    let w = ed.win
    assert(run_str(mut ed, w, "ed.buf.open", first_path) == edit.CMD_OK)
    let root = ed.pane_root
    edit.layout_compute(mut ed, root, edit.rect(0, 0, 80, 24))
    let split = ed.pane_root
    assert(edit.pane_split(mut ed, split, edit.SPLIT_H) >= 0)
    let first = ed.panes[ed.panes[split].a].win
    let second = ed.panes[ed.panes[split].b].win
    ed.focus = ed.panes[split].b
    ed.win = second
    ed.tabs[ed.tab_active].focus = ed.focus
    assert(run_str(mut ed, second, "ed.buf.open", second_path) == edit.CMD_OK)
    let fb = ed.wins[first].buf
    text.textbuf_insert(mut ed.bufs[fb].ec.tb, 0 as text.ByteOff, "X".bytes())
    assert(run(mut ed, first, "ed.file.save") == edit.CMD_OK)
    assert(ed.win == second)
    assert(ed.wins[second].buf != ed.wins[first].buf)
    let got = fs.read_bytes(first_path) else { assert(false); return }
    assert(got.len == 12)
    let want = "Xalpha\nbeta\n".bytes()
    for i in 0..12 { assert(got[i] == want[i]) }
    fs.remove(second_path) else |_| { assert(false) }
    fs.remove(first_path) else |_| { assert(false) }
}

fn main() {
    fl_cmd_buf_open_preserves_model_and_reuses_stable_buffer()
    print("fl_cmd_buf_open_preserves_model_and_reuses_stable_buffer: PASS")
    fl_cmd_buf_close_retargets_every_view_and_kills_handles()
    print("fl_cmd_buf_close_retargets_every_view_and_kills_handles: PASS")
    fl_cmd_buf_close_dirty_requires_force_and_reports_io()
    print("fl_cmd_buf_close_dirty_requires_force_and_reports_io: PASS")
    fl_cmd_buf_close_primary_retires_id_without_alias()
    print("fl_cmd_buf_close_primary_retires_id_without_alias: PASS")
    fl_cmd_edit_rows_preserve_binary_and_unit_semantics()
    print("fl_cmd_edit_rows_preserve_binary_and_unit_semantics: PASS")
    fl_cmd_close_refuses_an_enlisted_buffer()
    print("fl_cmd_close_refuses_an_enlisted_buffer: PASS")
    fl_cmd_pane_close_targets_the_supplied_window()
    print("fl_cmd_pane_close_targets_the_supplied_window: PASS")
    fl_cmd_path_commands_reject_embedded_nul()
    print("fl_cmd_path_commands_reject_embedded_nul: PASS")
    fl_cmd_save_targets_a_nonfocused_buffer()
    print("fl_cmd_save_targets_a_nonfocused_buffer: PASS")
    print("fl_cmds: 9 pinned cases PASS; syn.entry rows are yw10's")
}
