//! member: false
//!
//! The port of sagitta `tests/unit/test_fussjump.c` (467 lines), one test
//! per C test in registry order (`tests/unit/registry.c`, the FUSS block's
//! thirteen `fussjump_*`): F mode's type-to-jump over the visible rows'
//! paths (bare filename characters search, actions use Alt chords) and
//! F mode's dispatch table. C's `FussJump` is the jump half of the port's
//! `FussMode` (`edit.fuss_state_new()`); C's `PickItem` labels are the
//! rows' path bytes; C's `u32 *sel` is the selection the call answers.
//! C's degenerate-input case passes NULL pointers the port's values cannot
//! be; its non-NULL half (an empty item list leaves the selection) runs.
//!
//! The dispatch-table case drives F's keymap on an editor whose git spawns
//! go to the test hook (`git_test_spawn_set`): C's `Ed ed = {0}` has no git
//! context and no FussMode at all, so its Alt verbs reach no child and
//! open nothing; the port's verbs run against F mode's state (a value of
//! every `Ed`), so the case puts F's keymap back after each one.
//!
//! `YEW_PICK_CASE=N` runs case N alone (the checked machine's per-case run).

use edit
use git
use term

fn b(s: str) -> List[byte] {
    var v = List[byte]()
    for x in s.bytes() {
        (mut v).push(x)
    }
    v
}

fn s_of(v: List[byte]) -> str {
    str_from_utf8(v) else ""
}

// `fj_items` (`test_fussjump.c:12-19`).
fn items() -> List[List[byte]] {
    var v = List[List[byte]]()
    for l in ["alpha.c", "README", "README.md", "src", "src/main.c", "sigma.c"] {
        (mut v).push(b(l))
    }
    v
}

// `fj_char` (`:21-30`).
fn ch(c: int) -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    k.code = c
    (mut k.text).push(c as byte)
    k
}

// `fj_special` (`:32-39`).
fn special(code: int) -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    k.code = code
    k
}

// `fj_alt` (`:41-48`): the letter's code with Alt and no text.
fn alt(c: int) -> term.Key {
    var k = special(c)
    k.mods = term.MOD_ALT
    k
}

fn fussjump_arm_starts_an_empty_five_hundred_ms_window() {
    var f = edit.fuss_state_new()
    edit.fuss_jump_init(mut f)
    assert(!edit.fuss_jump_armed(f), "not armed")
    assert(edit.fuss_jump_pattern(f).len == 0, "empty")
    edit.fuss_jump_arm(mut f, 1000)
    assert(edit.fuss_jump_armed(f), "armed")
    assert(edit.fuss_jump_pattern(f).len == 0, "still empty")
    assert(!edit.fuss_jump_tick(mut f, 1499), "1499 is inside the window")
    assert(edit.fuss_jump_armed(f), "still armed")
}

fn fussjump_letters_append_inside_the_window() {
    var f = edit.fuss_state_new()
    edit.fuss_jump_init(mut f)
    assert(!edit.fuss_jump_armed(f), "not armed")
    let (c1, s1) = edit.fuss_jump_key(mut f, ch('s' as int), 1000, items(), 0)
    assert(c1, "s consumed")
    assert(s1 == 3, "s jumps to src ({s1})")
    let (c2, s2) = edit.fuss_jump_key(mut f, ch('r' as int), 1100, items(), s1)
    assert(c2, "r consumed")
    assert(s_of(edit.fuss_jump_pattern(f)) == "sr", "the pattern is sr")
    assert(s2 == 3, "sr stays on src ({s2})")
    assert(edit.fuss_jump_armed(f), "armed")
}

fn fussjump_letter_after_the_window_replaces_the_pattern() {
    var f = edit.fuss_state_new()
    edit.fuss_jump_init(mut f)
    let (c1, s1) = edit.fuss_jump_key(mut f, ch('a' as int), 1000, items(), 0)
    assert(c1, "a consumed")
    let (c2, _) = edit.fuss_jump_key(mut f, ch('s' as int), 1500, items(), s1)
    assert(c2, "s consumed")
    assert(s_of(edit.fuss_jump_pattern(f)) == "s", "the window closed: s alone")
    assert(edit.fuss_jump_armed(f), "armed")
}

fn fussjump_tick_self_clears_without_another_key() {
    var f = edit.fuss_state_new()
    edit.fuss_jump_init(mut f)
    let (c, _) = edit.fuss_jump_key(mut f, ch('s' as int), 1000, items(), 0)
    assert(c, "s consumed")
    assert(!edit.fuss_jump_tick(mut f, 1499), "1499: still open")
    assert(edit.fuss_jump_tick(mut f, 1500), "1500: the window closes")
    assert(!edit.fuss_jump_armed(f), "disarmed")
    assert(edit.fuss_jump_pattern(f).len == 0, "empty")
    assert(!edit.fuss_jump_tick(mut f, 9999), "nothing left to clear")
}

fn fussjump_escape_and_enter_disarm_and_are_released() {
    var f = edit.fuss_state_new()
    edit.fuss_jump_init(mut f)
    edit.fuss_jump_arm(mut f, 1000)
    let (c1, _) = edit.fuss_jump_key(mut f, special(term.KEY_ESCAPE), 1001, items(), 0)
    assert(!c1, "Escape is released to dispatch")
    assert(!edit.fuss_jump_armed(f), "Escape disarms")
    edit.fuss_jump_arm(mut f, 2000)
    let (c2, _) = edit.fuss_jump_key(mut f, special(term.KEY_ENTER), 2001, items(), 0)
    assert(!c2, "Enter is released to dispatch")
    assert(!edit.fuss_jump_armed(f), "Enter disarms")
}

fn fussjump_nonprintable_disarms_then_returns_to_dispatch() {
    var f = edit.fuss_state_new()
    edit.fuss_jump_init(mut f)
    edit.fuss_jump_arm(mut f, 1000)
    let (c1, s1) = edit.fuss_jump_key(mut f, special(term.KEY_DOWN), 1001, items(), 2)
    assert(!c1, "Down is released")
    assert(!edit.fuss_jump_armed(f), "Down disarms")
    assert(s1 == 2, "the selection stays")
    edit.fuss_jump_arm(mut f, 1500)
    let (c2, s2) = edit.fuss_jump_key(mut f, ch(32), 1501, items(), s1)
    assert(!c2, "Space is released (it toggles the directory)")
    assert(!edit.fuss_jump_armed(f), "Space disarms")
    assert(s2 == 2, "the selection stays")
    edit.fuss_jump_arm(mut f, 2000)
    var k = ch('n' as int)
    k.mods = term.MOD_CTRL
    let (c3, s3) = edit.fuss_jump_key(mut f, k, 2001, items(), s2)
    assert(!c3, "C-n is released")
    assert(!edit.fuss_jump_armed(f), "C-n disarms")
    assert(s3 == 2, "the selection stays")
}

fn fussjump_backspace_shortens_and_rejumps() {
    var f = edit.fuss_state_new()
    edit.fuss_jump_init(mut f)
    let (_, s1) = edit.fuss_jump_key(mut f, ch('s' as int), 1000, items(), 0)
    let (_, s2) = edit.fuss_jump_key(mut f, ch('i' as int), 1050, items(), s1)
    assert(s2 == 5, "si jumps to sigma.c ({s2})")
    let (c, s3) = edit.fuss_jump_key(mut f, special(term.KEY_BACKSPACE), 1100, items(), s2)
    assert(c, "Backspace consumed")
    assert(edit.fuss_jump_armed(f), "still armed")
    assert(s_of(edit.fuss_jump_pattern(f)) == "s", "shortened to s")
    assert(s3 == 3, "s rejumps to src ({s3})")
}

fn fussjump_exact_match_under_cursor_does_not_move() {
    var f = edit.fuss_state_new()
    edit.fuss_jump_init(mut f)
    var sel = 1
    var i = 0
    for c in "README".bytes() {
        let (ok, s) = edit.fuss_jump_key(mut f, ch(c as int), 1000 + i * 20, items(), sel)
        assert(ok, "consumed")
        sel = s
        i += 1
    }
    assert(sel == 1, "README under the cursor stays ({sel})")
}

fn fussjump_bare_filename_characters_start_search() {
    var i = 0
    for c in "aZ0._-/qjk".bytes() {
        var f = edit.fuss_state_new()
        edit.fuss_jump_init(mut f)
        let (ok, _) = edit.fuss_jump_key(mut f, ch(c as int), 1000 + i, items(), 0)
        assert(ok, "{c} consumed")
        assert(edit.fuss_jump_armed(f), "{c} arms")
        assert(edit.fuss_jump_pattern(f).len == 1, "{c}: one byte")
        i += 1
    }
}

fn fussjump_candidates_are_exactly_visible_tree_rows() {
    var snap = git.git_snapshot_new()
    for p in ["src/hidden-target.lu", "visible.lu"] {
        var e = git.git_entry_new()
        e.path_at = git.git_pool_add(mut snap.pool, b(p), 0, p.len)
        e.path_len = p.len
        e.unstaged = true
        (mut snap.entries).push(e)
    }
    snap.gen = 1
    var tree = git.fuss_tree_new()
    git.fuss_build(mut tree, snap, git.FussOpts { all_files: false, show_hidden: false })
    assert(tree.items.len == 2, "two rows ({tree.items.len})")
    assert(s_of(git.fuss_item_path(tree, 0)) == "src", "src first, collapsed")
    var labels = List[List[byte]]()
    var i = 0
    while i < tree.items.len {
        (mut labels).push(git.fuss_item_path(tree, i))
        i += 1
    }
    var f = edit.fuss_state_new()
    edit.fuss_jump_init(mut f)
    var sel = 0
    i = 0
    for c in "hidden".bytes() {
        let (ok, s) = edit.fuss_jump_key(mut f, ch(c as int), 1000 + i, labels, sel)
        assert(ok, "consumed")
        sel = s
        i += 1
    }
    assert(sel == 0, "the hidden file is not a candidate: src stays ({sel})")
    assert(edit.fuss_jump_tick(mut f, 1000 + i - 1 + edit.TYPEJUMP_RESET_MS), "the window closes")
    assert(git.fuss_nav_toggle(mut tree, 0), "src opens")
    assert(tree.items.len == 3, "three rows ({tree.items.len})")
    labels = List[List[byte]]()
    i = 0
    while i < tree.items.len {
        (mut labels).push(git.fuss_item_path(tree, i))
        i += 1
    }
    sel = 0
    i = 0
    for c in "hidden".bytes() {
        let (ok, s) = edit.fuss_jump_key(mut f, ch(c as int), 2000 + i, labels, sel)
        assert(ok, "consumed")
        sel = s
        i += 1
    }
    assert(sel == 1, "now visible, it is the jump ({sel})")
    assert(s_of(git.fuss_item_path(tree, sel)) == "src/hidden-target.lu", "the target")
}

struct Row {
    seq: str,
    cmd: str,
}

fn row(seq: str, cmd: str) -> Row {
    Row { seq: seq, cmd: cmd }
}

fn dispatch_rows() -> List[Row] {
    [
        row("<up>", "ed.git.nav.prev"),
        row("<down>", "ed.git.nav.next"),
        row("<left>", "ed.git.nav.parent"),
        row("<right>", "ed.git.nav.enter"),
        row("<space>", "ed.git.view"),
        row("C-w s", "ed.git.open_split_h"),
        row("C-w v", "ed.git.open_split_v"),
        row("C-<up>", "ed.git.nav.row_prev"),
        row("C-<down>", "ed.git.nav.row_next"),
        row("A-a", "ed.git.stage"),
        row("A-u", "ed.git.unstage"),
        row("A-S", "ed.git.stage.all"),
        row("A-U", "ed.git.unstage.all"),
        row("A-m", "ed.git.commit"),
        row("A-M", "ed.git.commit.amend"),
        row("A-p", "ed.git.push"),
        row("A-l", "ed.git.pull"),
        row("A-f", "ed.git.fetch"),
        row("A-d", "ed.git.diff"),
        row("A-D", "ed.git.diff.view"),
        row("A-s", "ed.git.status"),
        row("A-w", "ed.git.blame"),
        row("A-h", "ed.git.history"),
        row("A-L", "ed.git.reflog"),
        row("A-c", "ed.git.view"),
        row("A-b", "ed.git.branch.switch"),
        row("A-n", "ed.git.branch.create"),
        row("A-R", "ed.git.branch.delete"),
        row("A-G", "ed.git.merge"),
        row("A-O", "ed.git.reset"),
        row("A-I", "ed.git.rebase.interactive"),
        row("A-y", "ed.git.cherry_pick"),
        row("A-v", "ed.git.revert"),
        row("A-z", "ed.git.stash.push"),
        row("A-Z", "ed.git.stash.pop"),
        row("A-t", "ed.git.tag"),
        row("A-x", "ed.git.discard"),
        row("A-r", "ed.git.file.delete"),
        row("A-N", "ed.git.file.rename"),
        row("<cr>", "ed.git.open"),
        row("A-g", "ed.group.from_dir"),
        row("A-T", "ed.git.tree.all"),
        row("A-.", "ed.git.tree.hidden"),
        row("C-r", "ed.git.refresh"),
        row("A-q", "ed.git.mode.leave"),
        row("<esc>", "ed.git.mode.leave"),
    ]
}

fn fussjump_f_mode_dispatch_table_is_complete() {
    var ed = edit.ed_new()
    edit.git_test_spawn_set(mut ed, true)
    edit.dispatch_set_mode(mut ed, edit.MODE_F)
    assert(ed.keys[0] == edit.km_mode(edit.MODE_F), "F's keymap is the base layer")
    assert(ed.chord.n == 0, "no chord")
    assert(ed.chord.layer == -1, "no chord layer")
    var i = 0
    for r in dispatch_rows() {
        let keys = edit.key_parse_seq(r.seq, 2)
        assert(keys.len == 1 || keys.len == 2, "{r.seq}: parses")
        let km = copy ed.keymaps[ed.keys[0]]
        let (m, _, bi) = edit.keymap_lookup(km, keys, keys.len)
        assert(m == edit.MATCH_FULL, "{r.seq}: bound")
        let cmd = km.binds[bi].cmd
        assert(cmd > 0 && cmd <= ed.reg.entries.len, "{r.seq}: a command")
        let e = copy ed.reg.entries[cmd - 1]
        assert(e.name == r.cmd, "{r.seq}: want {r.cmd}, got {e.name}")
        if e.name == "ed.group.from_dir" {
            assert(e.flags & edit.CMD_RECORDABLE == 0, "{e.name}: not recordable")
            assert(e.flags & edit.CMD_PROMPTS != 0, "{e.name}: prompts")
            assert(!e.has_word, "{e.name}: no recorder word")
        } else {
            assert(e.flags & edit.CMD_RECORDABLE != 0, "{e.name}: recordable")
            assert(e.has_word && e.word.len != 0, "{e.name}: a recorder word")
        }
        assert(e.help.len != 0, "{e.name}: help")
        assert(ed.chord.n == 0, "{r.seq}: no chord")
        assert(ed.chord.layer == -1, "{r.seq}: no chord layer")
        if r.seq.starts_with("A-") {
            let letter = r.seq.bytes()[2] as int
            ed.last_cmd = 0
            edit.dispatch_key(mut ed, alt(letter), 1000 + i)
            assert(ed.last_cmd == cmd, "{r.seq}: dispatched {r.cmd}")
            assert(ed.chord.n == 0, "{r.seq}: no chord after")
            // C's zeroed `Ed` has no FussMode (`yew_ed_init` allocates it,
            // `ed.c:759`), so its verbs refuse at `fuss_require` and leave
            // the keymap alone; the port's state is a value of every `Ed`,
            // so a prompting verb opens its prompt, a picker its picker,
            // `A-q` leaves F. Each is put back before the next row.
            if ed.cmdline.active {
                edit.cmdline_close(mut ed, false)
            }
            if edit.picker_active(ed) {
                edit.picker_close(mut ed, false)
            }
            edit.dispatch_set_mode(mut ed, edit.MODE_F)
        }
        i += 1
    }
    for seq in ["C-S-/", "C-?", "C-_"] {
        let keys = edit.key_parse_seq(seq, 1)
        assert(keys.len == 1, "{seq}: one key")
        let km = copy ed.keymaps[ed.keys[0]]
        let (m, _, bi) = edit.keymap_lookup(km, keys, 1)
        assert(m == edit.MATCH_FULL, "{seq}: bound")
        let e = copy ed.reg.entries[km.binds[bi].cmd - 1]
        assert(e.name == "ed.git.actions", "{seq}: the actions palette")
        assert(e.flags & edit.CMD_RECORDABLE == 0, "{seq}: not recordable")
        assert(e.flags & edit.CMD_PROMPTS != 0, "{seq}: prompts")
    }
    for c in "auSUmMplfdswhLcbnRGOIyvzZtxrNT.gq/?jk".bytes() {
        let keys = edit.key_parse_seq(s_of([c]), 1)
        assert(keys.len == 1, "{c}: one key")
        let km = copy ed.keymaps[ed.keys[0]]
        let (m, _, _) = edit.keymap_lookup(km, keys, 1)
        assert(m == edit.MATCH_NONE, "bare {c} is the jump's, unbound")
    }
    let cg = edit.key_parse_seq("C-g", 1)
    assert(cg.len == 1, "C-g parses")
    let km = copy ed.keymaps[ed.keys[0]]
    let (m, _, _) = edit.keymap_lookup(km, cg, 1)
    assert(m == edit.MATCH_NONE, "C-g unbound in F")
}

fn fussjump_bare_former_verbs_start_search() {
    var i = 0
    for c in "auSUmMplfdswhLcbnRGOIyvzZtxrNT.gq".bytes() {
        var f = edit.fuss_state_new()
        edit.fuss_jump_init(mut f)
        let (ok, _) = edit.fuss_jump_key(mut f, ch(c as int), 1000 + i, items(), 0)
        assert(ok, "{c} consumed")
        assert(edit.fuss_jump_armed(f), "{c} arms")
        i += 1
    }
}

// C's NULL jump, key and pattern have no port value; the non-NULL half: an
// empty candidate list consumes the letter and leaves the selection.
fn fussjump_degenerate_inputs_do_not_mutate_selection() {
    var f = edit.fuss_state_new()
    edit.fuss_jump_init(mut f)
    let (ok, sel) = edit.fuss_jump_key(mut f, ch('a' as int), 0, List[List[byte]](), 4)
    assert(ok, "consumed with no candidates")
    assert(sel == 4, "the selection stays ({sel})")
    var g = edit.fuss_state_new()
    edit.fuss_jump_init(mut g)
    assert(!edit.fuss_jump_tick(mut g, 0), "nothing to clear")
    assert(!edit.fuss_jump_armed(g), "not armed")
    assert(edit.fuss_jump_pattern(g).len == 0, "empty")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    let names = [
        "fussjump_arm_starts_an_empty_five_hundred_ms_window",
        "fussjump_letters_append_inside_the_window",
        "fussjump_letter_after_the_window_replaces_the_pattern",
        "fussjump_tick_self_clears_without_another_key",
        "fussjump_escape_and_enter_disarm_and_are_released",
        "fussjump_nonprintable_disarms_then_returns_to_dispatch",
        "fussjump_backspace_shortens_and_rejumps",
        "fussjump_exact_match_under_cursor_does_not_move",
        "fussjump_bare_filename_characters_start_search",
        "fussjump_candidates_are_exactly_visible_tree_rows",
        "fussjump_f_mode_dispatch_table_is_complete",
        "fussjump_bare_former_verbs_start_search",
        "fussjump_degenerate_inputs_do_not_mutate_selection",
    ]
    var ran = 0
    var n = 0
    while n < names.len {
        if chosen >= 0 && chosen != n {
            n += 1
            continue
        }
        match n {
            0 => fussjump_arm_starts_an_empty_five_hundred_ms_window(),
            1 => fussjump_letters_append_inside_the_window(),
            2 => fussjump_letter_after_the_window_replaces_the_pattern(),
            3 => fussjump_tick_self_clears_without_another_key(),
            4 => fussjump_escape_and_enter_disarm_and_are_released(),
            5 => fussjump_nonprintable_disarms_then_returns_to_dispatch(),
            6 => fussjump_backspace_shortens_and_rejumps(),
            7 => fussjump_exact_match_under_cursor_does_not_move(),
            8 => fussjump_bare_filename_characters_start_search(),
            9 => fussjump_candidates_are_exactly_visible_tree_rows(),
            10 => fussjump_f_mode_dispatch_table_is_complete(),
            11 => fussjump_bare_former_verbs_start_search(),
            _ => fussjump_degenerate_inputs_do_not_mutate_selection(),
        }
        print("{names[n]}: PASS")
        ran += 1
        n += 1
    }
    print("edit_fussjump_test: {ran} cases run")
}
