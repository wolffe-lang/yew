// `Win` has none to draw.
fn t_draw_git_diff_rows_distinguish_fillers_and_preserve_intraline() {
    let why = "SKIP: draw_git_diff_rows_distinguish_fillers_and_preserve_intraline: the git diff rows are sagitta Sprint 52 (FUSS and git) (yw13)"
    print(why)
    eprint(why)
}

// `test_draw_selection_then_secondary_cursor_preserves_glyphs`
// (`:121-203`).
fn t_draw_selection_then_secondary_cursor_preserves_glyphs() {
    var ed = edit.ed_new()
    ed.grid = term.grid_new(3, 12)
    let text_bytes = bytes_of("a\u{6F22}b\n\ty\n")
    (mut ed.
        bufs).push(buffer_around(take text.textbuf_from_bytes(text_bytes, 0, text_bytes.len), 8))
    var w = edit.win_new(1, 0)
    w.h.kind = edit.SEL_CHAR
    w.rect = edit.rect(0, 0, 12, 2)
    w.cs = text.cset_init(text.Cursor { pos: 4, goal_col: 0, anchor: 0 })
    assert(text.cset_add(mut w.cs, text.Cursor { pos: 7, goal_col: 0, anchor: 7 }), "the secondary")
    edit.vp_init(mut w)
    w.vp.rows = 2
    w.vp.cols = 12
    (mut ed.wins).push(w)
    ed.win = 0
    ed.mode = edit.MODE_H
    ed.render.tier = term.TIER_16
    edit.draw_document_rows(mut ed, 0, 0, 2)
    let han = cell(ed, 1)
    let tail = cell(ed, 2)
    let painted = cell(ed, 12 + 8)
    assert(han.w == 2, "the ideograph is two cells")
    assert(
        term.cell_byte(han, 0) == text_bytes[1] as int &&
            term.cell_byte(han, 1) == text_bytes[2] as int &&
            term.cell_byte(han, 2) == text_bytes[3] as int,
        "its bytes",
    )
    assert(tail.w == 0, "its tail")
    assert(han.bg.tag == term.COLOR_RGB, "selected: an RGB background")
    assert(term.color_equal(han.bg, tail.bg), "the tail shares it")
    assert(term.cell_byte(painted, 0) == 121, "y under the secondary")
    assert(painted.attrs & term.ATTR_REVERSE != 0, "the secondary is reverse")
    edit.draw_cursor(mut ed, 0)
    assert(
        ed.grid.cur_row == 0 && ed.grid.cur_col == 3 && ed.grid.cur_vis,
        "the hardware cursor at 0,3",
    )
    assert(ed.grid.cur_shape == term.CURSOR_BLOCK, "a block")
    assert(cell(ed, 3).bg.tag == term.COLOR_DEFAULT, "b's cell is not selected")
    term.grid_flip(mut ed.grid)
    ed.wins[0].cs.curs[1].pos = 6
    ed.wins[0].cs.curs[1].anchor = 6
    edit.draw_cursor(mut ed, 0)
    assert(cell(ed, 12 + 8).attrs & term.ATTR_REVERSE == 0, "the old secondary cell clean")
    assert(cell(ed, 12).attrs & term.ATTR_REVERSE != 0, "the tab cell reverse")
    ed.mode = edit.MODE_L
    edit.draw_document_rows(mut ed, 0, 0, 2)
    term.grid_flip(mut ed.grid)
    ed.mode = edit.MODE_I
    edit.draw_cursor(mut ed, 0)
    assert(ed.grid.cur_shape == term.CURSOR_BAR, "a bar in I")
    assert(ed.grid.dmg_lo == ed.grid.rows && ed.grid.dmg_hi == 0, "no document damage in I")
    ed.mode = edit.MODE_L
    ed.wins[0].cs.curs[0].pos = 1
    ed.wins[0].cs.curs[0].anchor = 1
    edit.draw_cursor(mut ed, 0)
    assert(ed.grid.cur_shape == term.CURSOR_BLOCK, "a block in L")
    assert(ed.grid.dmg_lo == ed.grid.rows && ed.grid.dmg_hi == 0, "no document damage in L")
}

// `test_draw_rect_selected_cells_equal_deleted_span_cells` (`:205-307`):
// every rectangle with corners on row 0 and row 2 (41 x 41), the cells
// drawn selected on row 1 are exactly the cells its delete removes.
fn t_draw_rect_selected_cells_equal_deleted_span_cells() {
    let src = bytes_of(
        "0123456789012345678901234567890123456789\na\u{6F22}\tb\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}c\n0123456789012345678901234567890123456789\n",
    )
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    edit.ed_theme_set(mut ed, "quiver-dark")
    let (has_sel, selection) = edit.theme_ui(ed.theme, "sel", edit.theme_rendition_of(ed.render))
    assert(has_sel, "the theme has a selection surface")
    let w = ed.win
    let b = ed.wins[w].buf
    ed.bufs[b].tabwidth = 4
    ed.wins[w].rect = edit.rect(0, 0, 12, 3)
    ed.wins[w].vp.rows = 3
    ed.wins[w].vp.cols = 12
    ed.wins[w].gutter_width = 0
    ed.grid = term.grid_new(4, 12)
    ed.grid_ready = true
    var edge0 = 0
    while edge0 < 41 {
        var edge1 = 0
        while edge1 < 41 {
            var ec = text.editctx_new(take text.textbuf_from_bytes(src, 0, src.len))
            ec.undo = text.undo_new(ec.tb)
            ec.has_undo = true
            ec.marks = text.marks_new()
            ec.has_marks = true
            ed.bufs[b].ec = ec
            ed.mode = edit.MODE_H
            ed.wins[w].h.kind = edit.SEL_RECT
            ed.wins[w].cs = text.cset_init(text.
                Cursor { pos: 74 + edge1, goal_col: 0, anchor: edge0 })
            let c = copy ed.wins[w].cs.curs[0]
            let spans = edit.sel_rect_spans(ed.bufs[b].ec.tb, edit.SEL_RECT, 4, c)
            assert(spans.len == 3, "three rows at {edge0},{edge1}")
            let target = copy spans[1]
            var line = text.textbuf_line_span(ed.bufs[b].ec.tb, 1 as text.LineNo)
            if line.hi > line.lo {
                line.hi -= 1
            }
            let dlo = text.off_to_ccol(ed.bufs[b].ec.tb, line, target.lo as text.ByteOff, 4) as int
            let dhi = text.off_to_ccol(ed.bufs[b].ec.tb, line, target.hi as text.ByteOff, 4) as int
            edit.draw_document_rows(mut ed, w, 0, 3)
            var col = 0
            while col < ed.wins[w].rect.w {
                let cl = term.grid_back(ed.grid, 1, col)
                let highlighted = term.color_equal(cl.bg, selection.bg)
                let deleted = col >= dlo && col < dhi
                assert(
                    highlighted == deleted,
                    "col {col} at {edge0},{edge1}: drawn {highlighted}, deleted {deleted}",
                )
                col += 1
            }
            let before = text.textbuf_bytes(ed.bufs[b].ec.tb)
            var expected = List[byte]()
            var at = 0
            for sp in spans {
                assert(sp.lo >= at && sp.hi <= before.len, "ordered spans")
                var i = at
                while i < sp.lo {
                    (mut expected).push(before[i])
                    i += 1
                }
                at = sp.hi
            }
            var i = at
            while i < before.len {
                (mut expected).push(before[i])
                i += 1
            }
            var cx = edit.cmdctx_new(w, edit.SRC_TEST)
            edit.ed_undo_begin(mut ed, w, text.TXN_TYPE)
            assert(edit.sc_delete(mut ed, cx) == edit.CMD_OK, "delete at {edge0},{edge1}")
            edit.ed_undo_end(mut ed, w)
            let after = text.textbuf_bytes(ed.bufs[b].ec.tb)
            assert(after.len == expected.len, "the length at {edge0},{edge1}")
            var k = 0
            while k < after.len {
                assert(after[k] as int == expected[k] as int, "byte {k} at {edge0},{edge1}")
                k += 1
            }
            let _ = cx.win
            edge1 += 1
        }
        edge0 += 1
    }
}

// `test_draw_primary_is_only_hardware_cursor_target_in_raw_frame`
// (`:309-353`).
fn t_draw_primary_is_only_hardware_cursor_target_in_raw_frame() {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    let w = ed.win
    let b = ed.wins[w].buf
    text.textbuf_insert(mut ed.bufs[b].ec.tb, 0 as text.ByteOff, bytes_of("abc\ndef\n"))
    ed.wins[w].rect = edit.rect(0, 0, 8, 2)
    ed.wins[w].vp.rows = 2
    ed.wins[w].vp.cols = 8
    ed.grid = term.grid_new(3, 8)
    ed.grid_ready = true
    assert(text.cset_add(mut ed.wins[w].cs, text.Cursor { pos: 5, goal_col: 0, anchor: 5 }), "the secondary")
    ed.render = term.render_new(term.caps_new(), term.env_of(Map[str, str]()))
    ed.render.tier = term.TIER_16
    ed.mode = edit.MODE_L
    edit.draw_document_rows(mut ed, w, 0, 2)
    edit.draw_cursor(mut ed, w)
    assert(
        term.grid_back(ed.grid, 0, 0).attrs & term.ATTR_REVERSE == 0,
        "the primary's cell is not reverse",
    )
    assert(term.grid_back(ed.grid, 1, 1).attrs & term.ATTR_REVERSE != 0, "the secondary's is")
    assert(ed.grid.cur_row == 0 && ed.grid.cur_col == 0, "the hardware cursor at the primary")
    assert(ed.grid.cur_shape == term.CURSOR_BLOCK, "a block")
    var frame = List[byte]()
    assert(term.render_frame(mut ed.render, ed.grid, mut frame) != 0, "a frame")
    assert(count_bytes(frame, "\u{1B}[?25h") == 1, "the cursor shown once")
    assert(count_bytes(frame, "\u{1B}[2 q") == 1, "the block shape once")
    let tail = bytes_of("\u{1B}[H\u{1B}[?25h")
    assert(frame.len >= tail.len, "long enough")
    var k = 0
    while k < tail.len {
        assert(
            frame[frame.len - tail.len + k] as int == tail[k] as int,
            "the frame ends on the primary's CUP",
        )
        k += 1
    }
}

fn main() {
    t_draw_git_diff_rows_distinguish_fillers_and_preserve_intraline()
    t_draw_selection_then_secondary_cursor_preserves_glyphs()
    t_draw_rect_selected_cells_equal_deleted_span_cells()
    t_draw_primary_is_only_hardware_cursor_target_in_raw_frame()
    print("draw_test: 3 cases pass, 1 SKIP by name (the git diff rows, yw13)")
}
