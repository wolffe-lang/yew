//! member: false
//!
//! The port of sagitta `tests/unit/test_draw.c` (353 lines), one test per
//! C test in registry order: the document rows' overlays and the hardware
//! cursor (`ui/draw.c`, Sprint 15/17, the file s22 §7 grows the borders
//! in). C's fixtures build an `Ed` by hand or with `yew_ed_init` +
//! `yew_ed_open_scratch` and point its window at a buffer; the port's push
//! a buffer and a window into `edit.ed_new`'s (the viewport test's shape)
//! or open the scratch. `yew_ed_init` gives C its configured theme (the
//! harness's `YEW_RUNTIME_DIR` runs `init.fl`), so the theme-reading case
//! selects `quiver-dark` as `init.fl` does. The first case's git diff rows
//! are Sprint 52's drawing (yw13): SKIP by name, loudly, on both streams.

use edit
use term
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn buffer_around(take tb: text.TextBuf, tabwidth: int) -> edit.Buffer {
    var ec = text.editctx_new(take tb)
    ec.undo = text.undo_new(ec.tb)
    ec.has_undo = true
    text.undo_mark_saved(mut ec.undo, ec.tb)
    ec.meta = text.filemeta_new()
    edit.Buffer {
        id: 1,
        ec: ec,
        resident: true,
        path: "",
        has_path: false,
        name: "",
        has_name: false,
        flags: 0,
        tabwidth: tabwidth,
        recovery_pending: false,
        pairs: edit.pairstate_new(),
        named: edit.named_marks_new(),
    }
}

fn cell(ed: edit.Ed, i: int) -> term.Cell {
    term.grid_back(ed.grid, i / ed.grid.cols, i % ed.grid.cols)
}

fn count_bytes(out: List[byte], needle: str) -> int {
    let n = needle.bytes()
    var count = 0
    var i = 0
    while n.len != 0 && i + n.len <= out.len {
        var same = true
        var k = 0
        while k < n.len {
            if out[i + k] as int != n[k] as int {
                same = false
                break
            }
            k += 1
        }
        if same {
            count += 1
        }
        i += 1
    }
    count
}

