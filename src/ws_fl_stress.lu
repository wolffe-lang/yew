//! member: false
//! Bounded pure-codec stress companion to sagitta 9ace98c2 s25 §9 and
//! src/ws/fl_parse.c:98-105,166-270,479-525. Not an editor fuzzer.

use ws

fn next(mut seed: wrapping[u64]) -> int {
    seed = seed * 6364136223846793005 + 1442695040888963407
    (seed >> 32 & 2147483647) as int
}

fn eq(a: List[byte], b: List[byte]) -> bool {
    ws.fl_span_equal(a, ws.FlSpan { at: 0, len: a.len }, b, ws.FlSpan { at: 0, len: b.len })
}

fn t_caps() {
    region byte_cap {
        var source = List[byte]()
        (mut source).push(48 as byte)
        for _ in 1..ws.FL_MAX_BYTES { (mut source).push(32 as byte) }
        assert(ws.fl_parse(source, 0, source.len).ok)
        (mut source).push(32 as byte)
        let r = ws.fl_parse(source, 0, source.len)
        assert(!r.ok && r.err.msg == "document exceeds 8 MiB")
    }
    print("caps: byte boundary 8388608/8388609 ok")
    region node_cap {
        var source = List[byte]()
        (mut source).push(91 as byte)
        for _ in 1..ws.FL_MAX_NODES { (mut source).push(48 as byte); (mut source).push(44 as byte) }
        (mut source).push(93 as byte)
        let r = ws.fl_parse(source, 0, source.len)
        assert(r.ok && r.doc.nodes.len == ws.FL_MAX_NODES)
        source[source.len - 1] = 48 as byte
        (mut source).push(44 as byte)
        (mut source).push(93 as byte)
        let bad = ws.fl_parse(source, 0, source.len)
        assert(!bad.ok && bad.err.msg == "node cap exceeded")
    }
    print("caps: node boundary 1000000/1000001 ok")
}

fn t_large_map() {
    var e = ws.fl_emit()
    ws.fl_map_open(mut e, false, "".bytes())
    for i in 0..20000 { ws.fl_int(mut e, true, "k{i}".bytes(), i) }
    for i in 0..20000 { ws.fl_int(mut e, true, "k{i}".bytes(), i + 1) }
    ws.fl_map_close(mut e)
    let bytes = ws.fl_emit_finish(take e)
    let r = ws.fl_parse(bytes, 0, bytes.len)
    assert(r.ok && ws.fl_len(r.doc, r.doc.root) == 20000)
    for i in 0..20000 {
        let node = ws.fl_at(r.doc, r.doc.root, i) else -1
        assert(ws.fl_int_or(r.doc, node, -1) == i + 1)
    }
    print("caps: 20000 distinct byte keys, 20000 overwrite-in-place duplicates ok")
}

fn reserved_key(doc: ws.FlDoc) -> bool {
    for node in doc.nodes {
        if node.kind == ws.FL_MAP {
            for key in node.keys {
                for word in "and|as|break|catch|continue|edit|else|false|fn|for|if|import|in|let|macro|nil|not|or|return|true|try|while".
                    split("|") {
                    if ws.fl_span_equal(doc.bytes, key, word.bytes(), ws.FlSpan { at: 0, len: word.len }) { return true }
                }
            }
        }
    }
    false
}

fn fuzz(initial: int, count: int) {
    var seed: wrapping[u64] = initial as wrapping[u64]
    var accepted = 0
    var pinned_nonfixpoints = 0
    for trial in 0..count {
        region case_scratch {
            var source = List[byte]()
            if trial % 1000 == 999 {
                for b in "{{\"if\": 1,}}".bytes() { (mut source).push(b) }
            } else if trial % 4 == 0 {
                let n = next(mut seed) % 257
                for _ in 0..n { (mut source).push((next(mut seed) % 256) as byte) }
            } else if trial % 4 == 1 {
                for b in "{{version: 1, options: {{future: [nil, true, -1, \"bytes\\xFF\\0\",],}}, tabs: [],}}".
                    bytes() { (mut source).push(b) }
                let changes = 1 + next(mut seed) % 5
                for _ in 0..changes {
                    let at = next(mut seed) % source.len
                    source[at] = (next(mut seed) % 256) as byte
                }
            } else {
                var e = ws.fl_emit()
                ws.fl_map_open(mut e, false, "".bytes())
                ws.fl_int(mut e, true, "version".bytes(), 1)
                ws.fl_list_open(mut e, true, "data".bytes())
                let n = next(mut seed) % 17
                for _ in 0..n {
                    var bytes = List[byte]()
                    let size = next(mut seed) % 33
                    for _ in 0..size { (mut bytes).push((next(mut seed) % 256) as byte) }
                    ws.fl_str(mut e, false, "".bytes(), bytes)
                }
                ws.fl_list_close(mut e)
                ws.fl_map_close(mut e)
                source = ws.fl_emit_finish(take e)
            }
            let r = ws.fl_parse(source, 0, source.len)
            if r.ok {
                accepted += 1
                let out = ws.fl_reemit(r.doc)
                let again = ws.fl_parse(out, 0, out.len)
                if !again.ok {
                    assert(
                        reserved_key(r.doc),
                        "seed {initial} case {trial}: unexpected nonfixpoint",
                    )
                    pinned_nonfixpoints += 1
                } else {
                    assert(
                        eq(out, ws.fl_reemit(again.doc)),
                        "seed {initial} case {trial}: fixpoint",
                    )
                }
            } else {
                assert(r.err.line >= 1 && r.err.col >= 1)
            }
        }
        if trial % 10000 == 9999 {
            print("fuzz: seed {initial} cases {trial + 1}, accepted {accepted}")
        }
    }
    print(
        "fuzz: seed {initial} completed {count}, accepted {accepted}, pinned-C reserved-key nonfixpoints {pinned_nonfixpoints}",
    )
}

fn main() -> int {
    let args = env_args()
    if args.len == 1 && args[0] == "--caps" {
        t_caps()
        t_large_map()
        return 0
    }
    if args.len == 3 && args[0] == "--fuzz" {
        let seed = args[1].to_int() else -1
        let count = args[2].to_int() else -1
        if seed >= 0 && count >= 0 { fuzz(seed, count); return 0 }
    }
    eprint("usage: codec-stress --caps | --fuzz SEED CASES")
    2
}
