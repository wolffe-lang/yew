//! member: false
//!
//! The port of sagitta's jump and symbol-picker cases at 9ace98c2:
//! `tests/unit/test_lsp_nav.c:157-236` (the location jump hydrates its
//! target and converts against IT; a failed hydration pushes nothing) and
//! `test_lsp_symbols.c:321-429` (the local index's picker, then leaf and
//! breadcrumb filtered as separate candidates). The parsers' cases of
//! both files are `src/lsp_features_test.lu`'s.
//!
//! The local index is Sprint 44's over yw10's syntax engine (R-yw11b-1):
//! its half of the symbols case holds the port's named refusal, and the
//! picker's half runs whole.
//!
//! The per-case selector `YEW_LSP_NAV_CASE=N` (0-based, 3 cases).

use edit
use lsp
use std.fs
use term
use text

struct Tally {
    n: int,
}

// A failed check says what it was before the trap (a native trap prints
// only its site).
fn ok(mut t: Tally, cond: bool, what: str) {
    t.n += 1
    if !cond {
        eprint("assertion failed: {what}")
    }
    assert(cond, what)
}

fn pb(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn scratch_dir() -> str {
    let tmp = env_get("TMPDIR") else "target/tests"
    let base = if tmp.len == 0 then "target/tests" else tmp
    fs.create_dir_all(base) else |_| {}
    base
}

// `set_open_in_here` (`test_lsp_nav.c:169-180`).
fn set_open_in_here(mut ed: edit.Ed) {
    let err = edit.opt_set(mut ed, edit.OPT_SCOPE_DECLARED, "lsp.open_in", edit.optv_str("here"))
    if err.len != 0 {
        print("set_open_in_here: {err}")
    }
    assert(err.len == 0, "lsp.open_in here: {err}")
}

// test_lsp_nav.c:182-213
fn lsp_location_jump_hydrates_target_and_converts_target_utf16(mut t: Tally) {
    let path = "{scratch_dir()}/yew-lsp-nav-{os_pid()}"
    fs_write_bytes(path, pb("x\u{1F332}y\n")) else |_| {
        assert(false, "write {path}")
    }
    var ed = edit.ed_new()
    edit.ed_open_memory(mut ed, pb("abcdef\n"), "origin.c")
    set_open_in_here(mut ed)
    let w = ed.win
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].pos = 2
    ed.wins[w].cs.curs[p].anchor = 2
    let loc = lsp.LspLoc { path: path, line: 0, chr: 3, end_line: 0, end_chr: 3 }
    ok(mut t, edit.lsp_location_jump(mut ed, w, loc, lsp.POSENC_UTF16), "jumped")
    let target = edit.ed_doc(ed)
    ok(mut t, target >= 0 && ed.bufs[target].resident, "the target hydrated")
    ok(mut t, ed.bufs[target].path == path, "the target's path")
    let q = ed.wins[ed.win].cs.primary
    ok(
        mut t,
        ed.wins[ed.win].cs.curs[q].pos == 5,
        "UTF-16 3 is byte 5 of the TARGET: {ed.wins[ed.win].cs.curs[q].pos}",
    )
    ok(mut t, ed.wins[ed.win].cs.curs[q].anchor == 5, "the anchor too")
    ok(mut t, text.jumplist_len(ed.wins[ed.win].jumps) == 1, "one jump pushed")
    fs.remove(path) else |_| {}
}

// test_lsp_nav.c:215-236
fn lsp_location_jump_does_not_push_when_target_hydration_fails(mut t: Tally) {
    let path = "{scratch_dir()}/yew-lsp-nav-dir-{os_pid()}"
    fs.create_dir_all(path) else |_| {}
    var ed = edit.ed_new()
    edit.ed_open_memory(mut ed, pb("origin\n"), "origin.c")
    set_open_in_here(mut ed)
    let w = ed.win
    let loc = lsp.LspLoc { path: path, line: 0, chr: 0, end_line: 0, end_chr: 0 }
    ok(mut t, !edit.lsp_location_jump(mut ed, w, loc, lsp.POSENC_UTF16), "refused")
    ok(mut t, text.jumplist_len(ed.wins[ed.win].jumps) == 0, "nothing pushed")
    let doc = edit.ed_doc(ed)
    ok(mut t, ed.bufs[doc].has_name && ed.bufs[doc].name == "origin.c", "still at the origin")
    fs.remove_dir_all(path) else |_| {}
}

fn type_key(mut ed: edit.Ed, ch: int) -> bool {
    var k = term.key_new()
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    k.code = ch
    (mut k.text).push(ch as byte)
    edit.picker_key(mut ed, k)
}

fn local_symbol(name: str, breadcrumb: str, buf_id: int, kind: int) -> lsp.LspSymbol {
    lsp.LspSymbol {
        name: name,
        breadcrumb: breadcrumb,
        path: "symbols-local.txt",
        buf_id: buf_id,
        line: 0,
        chr: 0,
        kind: kind,
    }
}

// test_lsp_symbols.c:321-429
fn lsp_symbols_local_index_opens_and_accepts_current_buffer(mut t: Tally) {
    var ed = edit.ed_new()
    edit.ed_open_memory(mut ed, pb("alpha_symbol beta_symbol\ngamma_symbol\n"), "symbols-local.txt")
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    let w = ed.win
    // The index half (R-yw11b-1): refused by name, nothing opened.
    ok(mut t, !edit.lsp_symbol_index_open(mut ed, w), "the index refuses")
    ok(
        mut t,
        ed.msg.text == "not yet ported: the symbol index: sagitta Sprint 44 (yw10)",
        "by name: {ed.msg.text}",
    )
    ok(mut t, !edit.picker_active(ed), "no picker")
    // The picker half: leaf and breadcrumb are separate candidates, so
    // `put` takes no 'p' from a leaf and 'ut' from its container.
    let id = ed.bufs[ed.wins[w].buf].id
    var symbols = List[lsp.LspSymbol]()
    (mut symbols).push(local_symbol("put", "put", id, lsp.COMPLK_FUNC))
    (mut symbols).push(
        local_symbol(
            "put_something_else",
            "Grid \u{203A} put_something_else",
            id,
            lsp.COMPLK_FIELD,
        ),
    )
    (mut symbols).push(local_symbol("p", "ut \u{203A} p", id, lsp.COMPLK_WORD))
    edit.lsp_symbol_picker_open(mut ed, w, symbols, lsp.POSENC_UTF8)
    ok(mut t, type_key(mut ed, 112), "p")
    ok(mut t, type_key(mut ed, 117), "u")
    ok(mut t, type_key(mut ed, 116), "t")
    ok(mut t, edit.picker_shown(ed) == 2, "two shown: {edit.picker_shown(ed)}")
    ok(mut t, edit.picker_selected(ed) == 0, "the first selected")
    edit.picker_close(mut ed, false)
    edit.lsp_pickers_free(mut ed)
}

fn run_case(mut t: Tally, i: int) {
    match i {
        0 => lsp_location_jump_hydrates_target_and_converts_target_utf16(mut t),
        1 => lsp_location_jump_does_not_push_when_target_hydration_fails(mut t),
        2 => lsp_symbols_local_index_opens_and_accepts_current_buffer(mut t),
        _ => {},
    }
}

const CASES: int = 3

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    var t = Tally { n: 0 }
    let pick = env_get("YEW_LSP_NAV_CASE") else ""
    if pick.len != 0 {
        let i = pick.to_int() else -1
        // One past the last case runs nothing and prints nothing
        // (`tools/check-test-cases`).
        if i >= 0 && i < CASES {
            run_case(mut t, i)
            print("edit_lsp_nav_test: case {i}: PASS, {t.n} assertions")
        }
        return
    }
    var i = 0
    while i < CASES {
        run_case(mut t, i)
        i += 1
    }
    print("edit_lsp_nav_test: {CASES} cases pass, {t.n} assertions")
}
