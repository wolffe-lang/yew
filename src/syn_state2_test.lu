//! member: false
//! Ports sagitta tests/unit/test_syn_state2.c at 9ace98c2, one case per C
//! test in its order: the packed 84-byte qualified state, canonical tails,
//! cross-definition identity and the randomized transition round trip.

use syn

// The C test's LCG over u32, kept in an int and masked to 32 bits.
fn lcg(rng: int) -> int {
    rng * 1664525 + 1013904223 & 4294967295
}

// test_syn_state2_layout: sizeof(SynFrame) == 4, sizeof(SynState) == 84.
fn layout() {
    var state = syn.syn_state_root(0, 0)
    assert(syn.SYN_STATE_BYTES == 84 && syn.syn_state_bytes(state) == 84, "84-byte state")
    syn.syn_state_set_frame(mut state, 1, 513, 7, 9)
    assert(
        state.tuple[4] as int == 1 &&
            state.tuple[5] as int == 2 &&
            state.tuple[6] as int == 7 &&
            state.tuple[7] as int == 9,
        "a frame is four bytes: u16 context, u8 definition, u8 flags",
    )
    syn.syn_state_set_frame(mut state, 1, 0, 0, 0)
    assert(state.tuple[8] as int == 0, "the next frame starts four bytes later")
}

// test_syn_state_unused_tails_are_canonicalized
fn unused_tails_are_canonicalized() {
    var tab = syn.syn_state_tab_new(0)
    var clean = syn.syn_state_root(9, 2)
    syn.syn_state_set_aux(mut clean, 0, 42)
    syn.syn_state_set_flags(mut clean, syn.SYN_F_EMBED_PEND)
    var dirty = copy clean
    for i in 1..syn.SYN_DEPTH_MAX {
        syn.syn_state_set_frame(mut dirty, i, 100 + i, i % syn.SYN_DEF_MAX, 255)
    }
    for i in 1..syn.SYN_DEF_MAX { syn.syn_state_set_aux(mut dirty, i, 2779054080 + i) }
    let clean_id = syn.syn_state_intern(mut tab, clean)
    let dirty_id = syn.syn_state_intern(mut tab, dirty)
    assert(dirty_id == clean_id, "dirty tails intern as the clean tuple")
    let stored = syn.syn_state_get(tab, clean_id) else {
        assert(false, "stored tuple")
        return
    }
    for i in 1..syn.SYN_DEPTH_MAX {
        assert(
            syn.syn_state_ctx(stored, i) == 0 &&
                syn.syn_state_def(stored, i) == 0 &&
                syn.syn_state_frame_flags(stored, i) == 0,
            "stored frame tail is zero",
        )
    }
    for i in 1..syn.SYN_DEF_MAX {
        assert(syn.syn_state_aux(stored, i) == 0, "stored aux tail is zero")
    }
}

// test_syn_state_cross_definition_identity
fn cross_definition_identity() {
    var tab = syn.syn_state_tab_new(5)
    let a = syn.syn_state_root(5, 1)
    var b = copy a
    syn.syn_state_set_frame(mut b, 0, 5, 2, 0)
    let aid = syn.syn_state_intern(mut tab, a)
    let bid = syn.syn_state_intern(mut tab, b)
    assert(aid > syn.SYN_STATE_ROOT && bid > syn.SYN_STATE_ROOT, "new ids")
    assert(aid != bid, "the qualifying definition is identity")
    assert(syn.syn_state_intern(mut tab, a) == aid, "stable a")
    assert(syn.syn_state_intern(mut tab, b) == bid, "stable b")
}

// The randomized transition round trip, `iterations` times from the C seed.
fn roundtrip(iterations: int) {
    var tab = syn.syn_state_tab_new(0)
    var rng = 608135816
    for _ in 0..iterations {
        let base = syn.syn_state_root(0, 0)
        var returned = copy base
        let base_id = syn.syn_state_intern(mut tab, base)
        rng = lcg(rng)
        let steps = 4 + rng % 29
        for _ in 0..steps {
            let old_ctx = syn.syn_state_ctx(returned, syn.syn_state_depth(returned) - 1)
            rng = lcg(rng)
            let kind = rng & 3
            if kind == 0 {
                syn.syn_state_push(mut returned, rng >> 16 & 65535)
                syn.syn_state_pop(mut returned, 1)
            } else if kind == 1 {
                // A logical embed exit leaves its vacated frames and aux dirty.
                let depth = syn.syn_state_depth(returned)
                let ndef = syn.syn_state_ndef(returned)
                let def = syn.syn_state_def(returned, depth - 1)
                syn.syn_state_set_frame(mut returned, depth, rng & 65535, def, syn.SYN_FR_BRIDGE)
                syn.syn_state_set_frame(mut returned, depth + 1, rng >> 16 & 65535, ndef, 0)
                syn.syn_state_set_aux(mut returned, ndef, rng ^ 2779077210)
                syn.syn_state_set_depths(mut returned, depth + 2, ndef + 1)
                syn.syn_state_set_depths(mut returned, depth, ndef)
            } else if kind == 2 {
                syn.syn_state_set(mut returned, rng >> 16 & 65535)
                syn.syn_state_set(mut returned, old_ctx)
            } else {
                let ndef = syn.syn_state_ndef(returned)
                syn.syn_state_set_depths(mut returned, syn.SYN_DEPTH_MAX, ndef)
                for i in 1..syn.SYN_DEPTH_MAX {
                    syn.syn_state_set_frame(mut returned, i, rng + i & 65535, 0, 0)
                }
                syn.syn_state_push(mut returned, rng & 65535)
                syn.syn_state_pop(mut returned, 1)
                syn.syn_state_set_depths(mut returned, 1, ndef)
            }
        }
        assert(syn.syn_state_depth(returned) == syn.syn_state_depth(base), "depth restored")
        assert(syn.syn_state_ndef(returned) == syn.syn_state_ndef(base), "ndef restored")
        assert(syn.syn_state_lost(returned) == syn.syn_state_lost(base), "debt restored")
        assert(
            syn.syn_state_ctx(returned, 0) == syn.syn_state_ctx(base, 0) &&
                syn.syn_state_def(returned, 0) == syn.syn_state_def(base, 0) &&
                syn.syn_state_frame_flags(returned, 0) == syn.syn_state_frame_flags(base, 0),
            "active frame restored",
        )
        assert(syn.syn_state_intern(mut tab, returned) == base_id, "dirty tails intern canonically")
        var active_mutant = copy returned
        syn.syn_state_set_frame(mut active_mutant, 0, 1, syn.syn_state_def(returned, 0), 0)
        assert(
            syn.syn_state_intern(mut tab, active_mutant) != base_id,
            "the active frame is identity",
        )
    }
}

// test_syn_state_canonical_roundtrip_randomized_10000
fn canonical_roundtrip_randomized_10000() {
    roundtrip(10000)
}

// Checked twin of canonical_roundtrip_randomized_10000: the same seed and
// transitions for 250 iterations, half the largest count the checked
// machine was measured to fit.
fn canonical_roundtrip_checked() {
    roundtrip(250)
}

fn main() {
    let selected = (env_get("YEW_SYN_STATE2_CASE") else "-1").to_int() else -1
    for i in 0..5 {
        if selected == -1 || selected == i {
            match i {
                0 => layout(),
                1 => unused_tails_are_canonicalized(),
                2 => cross_definition_identity(),
                3 => canonical_roundtrip_randomized_10000(),
                _ => canonical_roundtrip_checked(),
            }
            print("syn_state2_case_{i}: PASS")
        }
    }
}
