//! member: false
//!
//! The port of sagitta `tests/unit/test_gutter_sign.c` (125 lines), one
//! test per C test in registry order (`tests/unit/registry.c:3058-3061`).
//! C's fixture is `yew_ed_init` + `yew_ed_open_memory` over "a\nb\nc\n"
//! with a 4x12 grid and the window placed by hand (`test_gutter_sign.c:
//! 19-30`); the port's is `edit.ed_new` + `edit.ed_open_memory`, the same
//! grid and placement. C captures the log through its test sink; the port
//! has no module state for a sink, so `YEW_LOG` names a scratch file read
//! back (`util_log_test.lu`'s shape). C's warn-once mask is process state
//! and so is the port's: the order of the cases is C's, so the shadow
//! kind first warns in the second case, as in C.

use edit
use std.fs
use term

const LOG_PATH: str = "target/tests/edit-gutter-sign-test.log"

fn sign_diag() -> edit.GutterSign {
    edit.gutter_sign("d", "shadow.index", term.ATTR_BOLD)
}

fn sign_git() -> edit.GutterSign {
    edit.gutter_sign("g", "shadow.index", term.ATTR_DIM)
}

fn sign_shadow() -> edit.GutterSign {
    edit.gutter_sign("s", "shadow.index", term.ATTR_UNDERLINE)
}

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

// `gutter_sign_fixture` (`test_gutter_sign.c:19-30`).
fn fixture() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_memory(mut ed, bytes_of("a\nb\nc\n"), "gutter-sign")
    ed.grid = term.grid_new(4, 12)
    ed.grid_ready = true
    let w = ed.win
    ed.wins[w].rect = edit.rect(6, 0, 6, 4)
    ed.wins[w].gutter_width = 6
    ed.wins[w].vp.rows = 4
    ed.wins[w].vp.cols = 6
    ed
}

// `gutter_byte` (`test_gutter_sign.c:32-35`).
fn gutter_byte(ed: edit.Ed, row: int, col: int) -> int {
    term.cell_byte(term.grid_back(ed.grid, row, col), 0)
}

fn draw(mut ed: edit.Ed, lo: int, hi: int) {
    let w = ed.win
    edit.gutter_draw(mut ed, w, lo, hi)
}

fn log_lines() -> List[str] {
    let text = fs.read_text(LOG_PATH) else ""
    var out = List[str]()
    for line in text.lines() {
        if line.len != 0 {
            (mut out).push(line)
        }
    }
    out
}

fn t_gutter_sign_kind_cells_and_priority_cover_all_combinations() {
    var mask = 1
    while mask < 8 {
        var ed = fixture()
        let w = ed.win
        if mask & 1 != 0 {
            edit.gutter_sign_set(mut ed.wins[w], 0, edit.SIGN_DIAG, sign_diag())
        }
        if mask & 2 != 0 {
            edit.gutter_sign_set(mut ed.wins[w], 0, edit.SIGN_GIT, sign_git())
        }
        if mask & 4 != 0 {
            edit.gutter_sign_set(mut ed.wins[w], 0, edit.SIGN_SHADOW, sign_shadow())
        }
        draw(mut ed, 0, 1)
        let first = if mask & 1 != 0 then 100 else if mask & 2 != 0 then 103 else 0
        let second = if mask & 3 == 3 then 103 else if mask & 4 != 0 then 115 else 0
        assert(gutter_byte(ed, 0, 0) == first, "mask {mask}: the first sign cell")
        assert(gutter_byte(ed, 0, 1) == second, "mask {mask}: the second sign cell")
        mask += 1
    }
}

fn t_gutter_sign_rejects_wide_glyph_once_and_uses_ascii() {
    var ed = fixture()
    let w = ed.win
    let bad = edit.gutter_sign("\u{6f22}", "shadow.ai", term.ATTR_DIM)
    fs.remove(LOG_PATH) else |_| {}
    env_set("YEW_LOG", LOG_PATH) else |_| {}
    edit.gutter_sign_set(mut ed.wins[w], 0, edit.SIGN_SHADOW, bad)
    edit.gutter_sign_set(mut ed.wins[w], 1, edit.SIGN_SHADOW, bad)
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let lines = log_lines()
    assert(lines.len == 1, "one warning, got {lines.len}")
    assert(
        lines[0].contains(" warn: ") && lines[0].contains("ASCII fallback"),
        "the warning names the fallback",
    )
    draw(mut ed, 0, 2)
    assert(gutter_byte(ed, 0, 1) == 115, "line 0 falls back to s")
    assert(gutter_byte(ed, 1, 1) == 115, "line 1 falls back to s")
}

fn t_gutter_sign_uses_severity_ascii_fallbacks() {
    var ed = fixture()
    let w = ed.win
    var roles = List[str]()
    (mut roles).push("diag.error")
    (mut roles).push("diag.warn")
    (mut roles).push("diag.info")
    (mut roles).push("diag.hint")
    var fallbacks = List[int]()
    (mut fallbacks).push(69)
    (mut fallbacks).push(87)
    (mut fallbacks).push(105)
    (mut fallbacks).push(104)
    var i = 0
    while i < 4 {
        edit.gutter_sign_set(
            mut ed.wins[w],
            i,
            edit.SIGN_DIAG,
            edit.gutter_sign("\u{6f22}", roles[i], term.ATTR_DIM),
        )
        i += 1
    }
    draw(mut ed, 0, 4)
    i = 0
    while i < 4 {
        assert(gutter_byte(ed, i, 0) == fallbacks[i], "{roles[i]} falls back to its letter")
        i += 1
    }
}

fn t_gutter_sign_clear_is_scrolled_range_exact() {
    var ed = fixture()
    let w = ed.win
    var line = 0
    while line < 4 {
        edit.gutter_sign_set(mut ed.wins[w], line, edit.SIGN_SHADOW, sign_shadow())
        line += 1
    }
    edit.gutter_signs_clear(mut ed.wins[w], 1, 3)
    draw(mut ed, 0, 4)
    assert(gutter_byte(ed, 0, 1) == 115, "line 0 keeps its sign")
    assert(gutter_byte(ed, 1, 1) == 0, "line 1 cleared")
    assert(gutter_byte(ed, 2, 1) == 0, "line 2 cleared")
    assert(gutter_byte(ed, 3, 1) == 115, "line 3 keeps its sign")
    assert(edit.gutter_signs_len(ed.wins[w]) == 2, "two entries left")
}

fn main() {
    fs.create_dir_all("target/tests") else |_| {}
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_gutter_sign_kind_cells_and_priority_cover_all_combinations()
    t_gutter_sign_rejects_wide_glyph_once_and_uses_ascii()
    t_gutter_sign_uses_severity_ascii_fallbacks()
    t_gutter_sign_clear_is_scrolled_range_exact()
    print("gutter_sign_test: 4 cases pass")
}
