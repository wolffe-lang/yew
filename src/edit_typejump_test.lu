//! member: false
//!
//! The port of sagitta `tests/unit/test_typejump.c` (303 lines), one test
//! per C test in registry order (`tests/unit/registry.c:2535-2545`): DoD
//! 12's four rows at their boundaries — append inside the 500 ms window,
//! replace from its deadline on (`[t, t+500)`), an exact match under the
//! cursor staying put and the same pattern moving from elsewhere, a
//! non-printable key clearing and not consumed, a modified key not a
//! letter, the hint expiring with no key — then no match, the degenerate
//! inputs and the bounded pattern. The clock is passed in throughout.
//!
//! C's `u32 *sel` in/out is passed and answered (`edit.typejump_key`'s
//! pair); C's NULL rows (`test_typejump.c:279-285`) have no wolf shape,
//! so the empty list and the zero count are their halves.
//!
//! `YEW_PICK_CASE=N` runs case N alone (the checked machine's per-case
//! run, G29).

use edit
use term

// `tj_char` (`test_typejump.c:29-38`).
fn tj_char(c: int) -> term.Key {
    var k = term.key_new()
    k.code = c
    (mut k.text).push(c as byte)
    k
}

// `tj_special` (`test_typejump.c:40-47`).
fn tj_special(code: int) -> term.Key {
    var k = term.key_new()
    k.code = code
    k
}

// `tj_items` (`test_typejump.c:49-56`).
fn tj_items() -> List[edit.PickItem] {
    var items = List[edit.PickItem]()
    (mut items).push(edit.pick_item("alpha.c", 1, 0))
    (mut items).push(edit.pick_item("beta.c", 2, 0))
    (mut items).push(edit.pick_item("README", 3, 0))
    (mut items).push(edit.pick_item("README.md", 4, 0))
    (mut items).push(edit.pick_item("gamma.c", 5, 0))
    (mut items).push(edit.pick_item("sigma.c", 6, 0))
    items
}

fn pat_is(tj: edit.TypeJump, want: str) -> bool {
    if tj.len != want.len {
        return false
    }
    var i = 0
    while i < want.len {
        if tj.pat[i] as int != want.bytes()[i] as int {
            return false
        }
        i += 1
    }
    true
}

// `test_typejump_appends_inside_the_window` (`:62-80`).
fn typejump_appends_inside_the_window() {
    let items = tj_items()
    var tj = edit.typejump_new()
    let (a, s1) = edit.typejump_key(mut tj, tj_char(98), 1000, items, 6, 0)
    assert(a && s1 == 1, "beta.c: {s1}")
    let (b, s2) = edit.typejump_key(mut tj, tj_char(101), 1100, items, 6, s1)
    assert(b && s2 == 1, "be still beta.c: {s2}")
    assert(tj.len == 2 && pat_is(tj, "be"), "the pattern is be")
}

// `test_typejump_replaces_after_the_window` (`:86-103`).
fn typejump_replaces_after_the_window() {
    let items = tj_items()
    var tj = edit.typejump_new()
    let (a, s1) = edit.typejump_key(mut tj, tj_char(115), 1000, items, 6, 0)
    assert(a && tj.len == 1, "s")
    let (b, s2) = edit.typejump_key(mut tj, tj_char(103), 1500, items, 6, s1)
    assert(b, "consumed")
    assert(tj.len == 1 && pat_is(tj, "g"), "replaced at the deadline")
    assert(s2 == 4, "gamma.c: {s2}")
}

// `test_typejump_window_boundary_is_exact` (`:107-121`).
fn typejump_window_boundary_is_exact() {
    let items = tj_items()
    var tj = edit.typejump_new()
    let (a, s1) = edit.typejump_key(mut tj, tj_char(115), 1000, items, 6, 0)
    let (b, s2) = edit.typejump_key(mut tj, tj_char(105), 1499, items, 6, s1)
    assert(a && b, "consumed")
    assert(tj.len == 2 && pat_is(tj, "si"), "appended one ms inside")
    assert(s2 == 5, "sigma.c: {s2}")
}

// `test_typejump_exact_match_under_the_cursor_stays_put` (`:136-153`).
fn typejump_exact_match_under_the_cursor_stays_put() {
    let items = tj_items()
    var tj = edit.typejump_new()
    var sel = 2
    var now = 1000
    for c in "README".bytes() {
        let (ok, s) = edit.typejump_key(mut tj, tj_char(c as int), now, items, 6, sel)
        assert(ok, "consumed")
        sel = s
        now += 50
    }
    assert(sel == 2, "still on README: {sel}")
}

// `test_typejump_moves_when_the_cursor_is_elsewhere` (`:157-174`).
fn typejump_moves_when_the_cursor_is_elsewhere() {
    let items = tj_items()
    var tj = edit.typejump_new()
    var sel = 0
    var now = 1000
    for c in "README".bytes() {
        let (ok, s) = edit.typejump_key(mut tj, tj_char(c as int), now, items, 6, sel)
        assert(ok, "consumed")
        sel = s
        now += 50
    }
    assert(sel == 2, "the exact match: {sel}")
}

// `test_typejump_non_printable_clears_and_is_not_consumed` (`:180-202`).
fn typejump_non_printable_clears_and_is_not_consumed() {
    let items = tj_items()
    var tj = edit.typejump_new()
    let (a, s1) = edit.typejump_key(mut tj, tj_char(98), 1000, items, 6, 0)
    assert(a && tj.len == 1, "b")
    let (b, s2) = edit.typejump_key(mut tj, tj_special(term.KEY_DOWN), 1050, items, 6, s1)
    assert(!b, "an arrow is the host's")
    assert(tj.len == 0, "and ends the sequence")
    let (c, s3) = edit.typejump_key(mut tj, tj_char(103), 1060, items, 6, s2)
    assert(c && tj.len == 1, "a new pattern")
    assert(s3 == 4, "gamma.c: {s3}")
}

// `test_typejump_ignores_modified_keys` (`:208-223`).
fn typejump_ignores_modified_keys() {
    let items = tj_items()
    var tj = edit.typejump_new()
    var k = tj_char(110)
    k.mods = term.MOD_CTRL
    let (a, s) = edit.typejump_key(mut tj, k, 1000, items, 6, 0)
    assert(!a, "a binding, not a letter")
    assert(tj.len == 0 && s == 0, "nothing moved")
}

// `test_typejump_hint_expires_without_a_key` (`:235-250`).
fn typejump_hint_expires_without_a_key() {
    let items = tj_items()
    var tj = edit.typejump_new()
    assert(!edit.typejump_active(tj, 1000), "nothing yet")
    let (a, _) = edit.typejump_key(mut tj, tj_char(98), 1000, items, 6, 0)
    assert(a, "consumed")
    assert(edit.typejump_active(tj, 1000), "active")
    assert(edit.typejump_active(tj, 1499), "still active")
    assert(!edit.typejump_active(tj, 1500), "gone at the deadline")
    assert(!edit.typejump_active(tj, 9999), "gone after")
}

// `test_typejump_no_match_leaves_the_selection` (`:258-270`).
fn typejump_no_match_leaves_the_selection() {
    let items = tj_items()
    var tj = edit.typejump_new()
    let (a, s1) = edit.typejump_key(mut tj, tj_char(122), 1000, items, 6, 3)
    let (b, s2) = edit.typejump_key(mut tj, tj_char(113), 1050, items, 6, s1)
    assert(a && b, "consumed")
    assert(s2 == 3, "left alone: {s2}")
}

// `test_typejump_degenerate_inputs` (`:272-286`): the NULL rows have no
// wolf shape (the header).
fn typejump_degenerate_inputs() {
    let items = tj_items()
    var tj = edit.typejump_new()
    edit.typejump_clear(mut tj)
    let (a, _) = edit.typejump_key(mut tj, tj_char(97), 0, List[edit.PickItem](), 0, 0)
    assert(!a, "no items")
    let (b, _) = edit.typejump_key(mut tj, tj_char(97), 0, items, 0, 0)
    assert(!b, "a zero count")
    assert(!edit.typejump_active(edit.typejump_new(), 0), "a fresh jump is idle")
}

// `test_typejump_long_pattern_is_bounded` (`:289-303`).
fn typejump_long_pattern_is_bounded() {
    let items = tj_items()
    var tj = edit.typejump_new()
    var sel = 0
    var i = 0
    while i < 200 {
        let (ok, s) = edit.typejump_key(mut tj, tj_char(97), 1000 + i, items, 6, sel)
        assert(ok, "consumed")
        sel = s
        i += 1
    }
    assert(tj.len < edit.TYPEJUMP_PAT_MAX, "bounded: {tj.len}")
}

fn main() {
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    var n = 0
    if chosen < 0 || chosen == 0 {
        typejump_appends_inside_the_window()
        print("typejump_appends_inside_the_window: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 1 {
        typejump_replaces_after_the_window()
        print("typejump_replaces_after_the_window: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 2 {
        typejump_window_boundary_is_exact()
        print("typejump_window_boundary_is_exact: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 3 {
        typejump_exact_match_under_the_cursor_stays_put()
        print("typejump_exact_match_under_the_cursor_stays_put: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 4 {
        typejump_moves_when_the_cursor_is_elsewhere()
        print("typejump_moves_when_the_cursor_is_elsewhere: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 5 {
        typejump_non_printable_clears_and_is_not_consumed()
        print("typejump_non_printable_clears_and_is_not_consumed: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 6 {
        typejump_ignores_modified_keys()
        print("typejump_ignores_modified_keys: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 7 {
        typejump_hint_expires_without_a_key()
        print("typejump_hint_expires_without_a_key: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 8 {
        typejump_no_match_leaves_the_selection()
        print("typejump_no_match_leaves_the_selection: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 9 {
        typejump_degenerate_inputs()
        print("typejump_degenerate_inputs: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 10 {
        typejump_long_pattern_is_bounded()
        print("typejump_long_pattern_is_bounded: PASS")
        n += 1
    }
    print("typejump_test: {n} cases pass")
}
