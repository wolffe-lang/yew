//! member: false
//!
//! The port of sagitta `tests/unit/test_lsp_uri.c` (77 lines),
//! `test_lsp_caps.c` (160) and `test_lsp_life.c:47-203` (the five cases
//! over the pure lifecycle, the root and the server table) at 9ace98c2,
//! in registry order (`tests/unit/registry.c:1442-1448`, then the life
//! cases' own order). The root fixture lives under `target/tests/`, not
//! C's `/tmp`.

use lsp
use std.fs

struct Tally {
    n: int,
}

fn ok(mut t: Tally, cond: bool, what: str) {
    t.n += 1
    assert(cond, what)
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn text_of(b: List[byte]) -> str {
    str_from_utf8(b) else "<not utf-8>"
}

fn parse(text: str) -> lsp.Json {
    var err = lsp.json_err_new()
    let j = lsp.json_parse(text.bytes(), 0, text.len, mut err) else {
        assert(false, "parse {text}: {err.msg}")
        return lsp.json_new()
    }
    j
}

fn round_trip(mut t: Tally, path: List[byte]) {
    var uri = List[byte]()
    lsp.lsp_uri_of_path(mut uri, path, 0, path.len)
    var decoded = List[byte]()
    ok(mut t, lsp.lsp_path_of_uri(mut decoded, uri, 0, uri.len), "decode {text_of(uri)}")
    ok(mut t, same(decoded, path), "round trip of {text_of(path)}")
}

fn pb(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

// test_lsp_uri.c:22-39
fn lsp_uri_round_trips_path_bytes(mut t: Tally) {
    let paths = [
        "/",
        "/tmp/a",
        "/tmp/a b",
        "/tmp/a#b",
        "/tmp/a?b",
        "/tmp/a%b",
        "/tmp/a+b",
        "/tmp/a:b",
        "/tmp/a;b",
        "/tmp/a=b",
        "/tmp/a@b",
        "/tmp/a&b",
        "/tmp/a'b",
        "/tmp/a(b",
        "/tmp/a)b",
        "/tmp/a,b",
        "/tmp/a!b",
        "/tmp/a$b",
        "/tmp/a*b",
        "/tmp/a\nb",
        "/tmp/~ok",
        "/tmp/-._",
        "/tmp/café",
        "/tmp/🌲",
        "/tmp/two/slashes",
    ]
    for p in paths {
        round_trip(mut t, pb(p))
    }
    var invalid = pb("/tmp/")
    (mut invalid).push(255 as byte)
    (mut invalid).push(120 as byte)
    round_trip(mut t, invalid)
}

// test_lsp_uri.c:41-59
fn lsp_uri_encoding_is_canonical(mut t: Tally) {
    var path = pb("/a b/#?%\né")
    (mut path).push(255 as byte)
    var uri = List[byte]()
    lsp.lsp_uri_of_path(mut uri, path, 0, path.len)
    ok(mut t, text_of(uri) == "file:///a%20b/%23%3F%25%0A%C3%A9%FF", "canonical: {text_of(uri)}")
    var decoded = List[byte]()
    let enc = pb("file:///a%2fb%2Fc")
    ok(mut t, lsp.lsp_path_of_uri(mut decoded, enc, 0, enc.len), "both hex cases decode")
    ok(mut t, text_of(decoded) == "/a/b/c", "to /a/b/c: {text_of(decoded)}")
}

// test_lsp_uri.c:61-77
fn lsp_uri_refuses_non_file_and_bad_escapes(mut t: Tally) {
    for bad in [
        "untitled:/x",
        "jdt://x",
        "http:///x",
        "file://host/x",
        "file:///x%",
        "file:///x%0",
        "file:///x%GG",
        "file://",
    ] {
        var out = List[byte]()
        let b = pb(bad)
        ok(mut t, !lsp.lsp_path_of_uri(mut out, b, 0, b.len), "{bad} is refused")
    }
}

// test_lsp_caps.c:19-78
fn lsp_caps_accept_boolean_object_and_reject_false_null_absent(mut t: Tally) {
    let caps = [
        ("completionProvider", lsp.LSPC_COMPLETION),
        ("hoverProvider", lsp.LSPC_HOVER),
        ("signatureHelpProvider", lsp.LSPC_SIGNATURE),
        ("definitionProvider", lsp.LSPC_DEFINITION),
        ("declarationProvider", lsp.LSPC_DECLARATION),
        ("typeDefinitionProvider", lsp.LSPC_TYPE_DEFINITION),
        ("implementationProvider", lsp.LSPC_IMPLEMENTATION),
        ("referencesProvider", lsp.LSPC_REFERENCES),
        ("documentHighlightProvider", lsp.LSPC_DOCUMENT_HIGHLIGHT),
        ("documentSymbolProvider", lsp.LSPC_DOCUMENT_SYMBOL),
        ("renameProvider", lsp.LSPC_RENAME),
        ("workspaceSymbolProvider", lsp.LSPC_WORKSPACE_SYMBOL),
    ]
    let shapes = [("true", true), ("{{}}", true), ("false", false), ("null", false)]
    for (key, bit) in caps {
        for (value, supported) in shapes {
            let j = parse("{{\"capabilities\":{{\"textDocumentSync\":2,\"{key}\":{value}}}}}")
            let n = lsp.lsp_caps_parse(j, j.root)
            ok(mut t, lsp.lsp_caps_has(n.caps, bit) == supported, "{key}: {value}")
        }
        let j = parse("{{\"capabilities\":{{\"textDocumentSync\":2}}}}")
        let n = lsp.lsp_caps_parse(j, j.root)
        ok(mut t, !lsp.lsp_caps_has(n.caps, bit), "{key} absent")
    }
}

// test_lsp_caps.c:80-104
fn lsp_caps_parse_sync_details_and_triggers(mut t: Tally) {
    let j = parse(
        "{{\"capabilities\":{{\"textDocumentSync\":{{\"change\":1,\"save\":{{\"includeText\":true}}}},\"completionProvider\":{{\"resolveProvider\":true,\"triggerCharacters\":[\".\",\":\"]}},\"signatureHelpProvider\":{{\"triggerCharacters\":[\"(\",\",\"]}},\"positionEncoding\":\"utf-8\"}}}}",
    )
    let n = lsp.lsp_caps_parse(j, j.root)
    ok(mut t, n.caps.sync_kind == 1, "full sync")
    ok(mut t, n.caps.save_include_text, "save includes text")
    ok(mut t, n.caps.resolve_completion, "completion resolves")
    ok(mut t, n.caps.trigger_chars == ".:", "trigger chars: {n.caps.trigger_chars}")
    ok(mut t, n.caps.sig_trigger == "(,", "signature triggers: {n.caps.sig_trigger}")
    ok(mut t, n.pos_enc == lsp.POSENC_UTF8, "utf-8")
    ok(mut t, !n.unknown_encoding, "a known encoding")
}

// test_lsp_caps.c:106-131
fn lsp_caps_position_encoding_fallbacks_to_utf16(mut t: Tally) {
    let cases = [
        ("", false),
        (",\"positionEncoding\":\"utf-16\"", false),
        (",\"positionEncoding\":\"utf-32\"", true),
        (",\"positionEncoding\":17", true),
    ]
    for (member, unknown) in cases {
        let j = parse("{{\"capabilities\":{{\"textDocumentSync\":2{member}}}}}")
        let n = lsp.lsp_caps_parse(j, j.root)
        ok(mut t, n.pos_enc == lsp.POSENC_UTF16, "{member}: utf-16")
        ok(mut t, n.unknown_encoding == unknown, "{member}: unknown {unknown}")
    }
}

// test_lsp_caps.c:133-160
fn lsp_initialize_advertises_conservative_client(mut t: Tally) {
    let cfg = lsp.lsp_default_cfg("c") else {
        ok(mut t, false, "the c row")
        return
    }
    let params = lsp.lsp_initialize_params(cfg, "/work/tree", 4711)
    var err = lsp.json_err_new()
    let j = lsp.json_parse(params, 0, params.len, mut err) else {
        ok(mut t, false, "the parameters parse: {err.msg}")
        return
    }
    let root = j.root
    ok(mut t, lsp.json_int(j, lsp.json_field(j, root, "processId"), 0) == 4711, "the pid")
    let encodings = lsp.json_path(j, root, "capabilities.general.positionEncodings")
    ok(mut t, lsp.json_streq(j, lsp.json_at(j, encodings, 0), "utf-8"), "utf-8 first")
    ok(
        mut t,
        !lsp.json_bool(
            j,
            lsp.json_path(
                j,
                root,
                "capabilities.textDocument.completion.completionItem.snippetSupport",
            ),
            true,
        ),
        "no snippets",
    )
    ok(
        mut t,
        !lsp.json_bool(j, lsp.json_path(j, root, "capabilities.workspace.applyEdit"), true),
        "no applyEdit",
    )
    ok(
        mut t,
        lsp.json_bool(
            j,
            lsp.json_path(j, root, "capabilities.textDocument.publishDiagnostics.versionSupport"),
            false,
        ),
        "versioned diagnostics",
    )
}

// test_lsp_life.c:47-75
fn lsp_lifecycle_requires_sync_and_negotiates_ready(mut t: Tally) {
    var life = lsp.lsp_life_new()
    ok(mut t, life.state == lsp.LSP_SPAWNING, "a new server is spawning")
    life.state = lsp.LSP_INITIALIZING
    let a = parse(
        "{{\"capabilities\":{{\"textDocumentSync\":2,\"positionEncoding\":\"utf-8\",\"hoverProvider\":true}}}}",
    )
    let v = lsp.lsp_life_initialized(mut life, "clangd", a, a.root)
    ok(mut t, v.ready, "sync and utf-8: ready")
    ok(mut t, life.state == lsp.LSP_READY, "READY")
    ok(mut t, life.pos_enc == lsp.POSENC_UTF8, "utf-8 negotiated")
    ok(mut t, lsp.lsp_caps_has(life.caps, lsp.LSPC_HOVER), "hover")
    var go = lsp.lsp_life_new()
    go.state = lsp.LSP_INITIALIZING
    let b = parse("{{\"capabilities\":{{\"hoverProvider\":true}}}}")
    let w = lsp.lsp_life_initialized(mut go, "gopls", b, b.root)
    ok(mut t, !w.ready, "no sync: not ready")
    ok(mut t, go.state == lsp.LSP_DEAD, "DEAD")
    ok(
        mut t,
        w.error == "gopls does not support document synchronization; LSP is off for this workspace",
        "the message: {w.error}",
    )
}

// test_lsp_life.c:77-122
fn lsp_lifecycle_backoff_and_giveup_messages(mut t: Tally) {
    let delay = [250, 1000, 4000, 16000]
    let messages = ["", "clangd restarted", "clangd restarted (3)", "clangd restarted (4)"]
    var life = lsp.lsp_life_new()
    var now = 1000
    var i = 0
    while i < 4 {
        let (again, msg) = lsp.lsp_life_crashed(mut life, "clangd", now, "clangd failed")
        ok(mut t, again, "crash {i} restarts")
        ok(mut t, life.next_try_ms == now + delay[i], "crash {i}'s backoff")
        ok(mut t, msg == messages[i], "crash {i}'s message: {msg}")
        now += 100
        i += 1
    }
    let (again, msg) = lsp.lsp_life_crashed(
        mut life,
        "clangd",
        now,
        "fatal: no compile_commands.json",
    )
    ok(mut t, !again, "the fifth crash gives up")
    ok(mut t, life.gave_up, "gave up")
    ok(mut t, msg.contains("crashed 5 times in 5 minutes"), "the give-up message")
    ok(mut t, msg.contains("fatal: no compile_commands.json"), "the last error")
    ok(mut t, msg.contains(":lsp.restart"), "the way back")
    lsp.lsp_life_restart_reset(mut life)
    ok(mut t, life.restarts == 0, "restarts reset")
    ok(mut t, !life.gave_up, "and the give-up")
}

// test_lsp_life.c:124-140
fn lsp_lifecycle_restart_window_resets(mut t: Tally) {
    var life = lsp.lsp_life_new()
    let (a, _) = lsp.lsp_life_crashed(mut life, "gopls", 1, "one")
    ok(mut t, a, "the first crash restarts")
    ok(mut t, life.restarts == 1, "one restart")
    let (b, _) = lsp.lsp_life_crashed(mut life, "gopls", 300001, "two")
    ok(mut t, b, "a crash past the window restarts")
    ok(mut t, life.restarts == 1, "the window reset the count")
    ok(mut t, life.next_try_ms == 300251, "with the first backoff")
}

// test_lsp_life.c:142-171
fn lsp_root_resolution_uses_nearest_marker(mut t: Tally) {
    let base = "target/tests/yew-lsp-root-{os_pid()}"
    fs.create_dir_all("{base}/project/src") else |_| {}
    let tmp = fs_realpath(base) else {
        ok(mut t, false, "the fixture resolves")
        return
    }
    fs.write_text("{tmp}/project/.clangd", "") else |_| {}
    let cfg = lsp.lsp_default_cfg("c") else {
        ok(mut t, false, "the c row")
        return
    }
    let root = lsp.lsp_resolve_root(cfg, "{tmp}/project/src/main.c", tmp) else {
        ok(mut t, false, "a root resolves")
        return
    }
    ok(mut t, root == "{tmp}/project", "the nearest marker's directory: {root}")
    fs.remove("{tmp}/project/.clangd") else |_| {}
    fs.remove_dir("{tmp}/project/src") else |_| {}
    fs.remove_dir("{tmp}/project") else |_| {}
    fs.remove_dir(tmp) else |_| {}
}

// test_lsp_life.c:173-188
fn lsp_default_server_table_is_complete(mut t: Tally) {
    for lang in [
        "c",
        "cpp",
        "objc",
        "rust",
        "python",
        "go",
        "js",
        "ts",
        "jsx",
        "tsx",
        "fortran",
        "sh",
        "wolf",
    ] {
        let cfg = lsp.lsp_default_cfg(lang) else {
            ok(mut t, false, "{lang} has a row")
            continue
        }
        ok(mut t, cfg.cmd.len != 0, "{lang} has a command")
        ok(mut t, cfg.roots.len != 0, "{lang} has root markers")
        ok(mut t, cfg.init_timeout_ms == lsp.RPC_INIT_TIMEOUT_MS, "{lang}'s timeout")
    }
    let fletch = lsp.lsp_default_cfg("fletch") else lsp.lsp_default_cfgs()[0]
    ok(mut t, fletch.lang == "c", "no fletch row")
    let unknown = lsp.lsp_default_cfg("unknown") else lsp.lsp_default_cfgs()[0]
    ok(mut t, unknown.lang == "c", "no unknown row")
    let wolf = lsp.lsp_default_cfg("wolf") else lsp.lsp_default_cfgs()[0]
    ok(
        mut t,
        wolf.cmd == "wolf" && wolf.args.len == 1 && wolf.args[0] == "lsp",
        "wolf lsp (client.c:89)",
    )
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    var t = Tally { n: 0 }
    lsp_uri_round_trips_path_bytes(mut t)
    lsp_uri_encoding_is_canonical(mut t)
    lsp_uri_refuses_non_file_and_bad_escapes(mut t)
    lsp_caps_accept_boolean_object_and_reject_false_null_absent(mut t)
    lsp_caps_parse_sync_details_and_triggers(mut t)
    lsp_caps_position_encoding_fallbacks_to_utf16(mut t)
    lsp_initialize_advertises_conservative_client(mut t)
    lsp_lifecycle_requires_sync_and_negotiates_ready(mut t)
    lsp_lifecycle_backoff_and_giveup_messages(mut t)
    lsp_lifecycle_restart_window_resets(mut t)
    lsp_root_resolution_uses_nearest_marker(mut t)
    lsp_default_server_table_is_complete(mut t)
    print("lsp_client_test: 12 cases pass, {t.n} assertions")
}
