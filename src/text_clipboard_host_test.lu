//! member: false
//! Port-only regression for G31 (yew#22).
//! sagitta src/text/clipboard.c:206-212 limits auto pbcopy to Apple arm64.
//! A forced `pb` override remains valid on every host (:240-241).

use text

fn main() {
    let dir = "target/tests/yew-clipboard-host-{os_pid()}"
    fs_create_dir_all(dir) else { assert(false); return }
    defer fs_remove_dir(dir) else |_| {}
    let file = fs_open_perm("{dir}/pbcopy", 4, 0o700) else { assert(false); return }
    fs_write_chunk(file, "#!/bin/sh\nexit 0\n".bytes()) else { assert(false) }
    fs_close(file) else { assert(false) }
    defer fs_remove("{dir}/pbcopy") else |_| {}
    // This standalone test owns its process environment.
    env_set("PATH", dir) else { assert(false) }
    for name in ["DISPLAY", "WAYLAND_DISPLAY", "SSH_TTY", "SSH_CONNECTION"] {
        env_unset(name) else { assert(false) }
    }
    env_set("YEW_CLIPBOARD", "auto") else { assert(false) }
    env_set("YEW_OSC52", "off") else { assert(false) }
    var clip = text.clip_new()
    let expected = if os_name() == "macos" && os_arch() == "aarch64" then text.CLIP_PB else text.CLIP_NONE
    assert(text.clip_detect_read(mut clip) == expected, "auto host selection")
    text.clip_reset(mut clip)
    env_set("YEW_CLIPBOARD", "pb") else { assert(false) }
    assert(text.clip_detect_read(mut clip) == text.CLIP_PB, "forced pb is host-independent")
    print("text_clipboard_host: {os_name()}/{os_arch()}, auto={expected}, forced=pb: PASS")
}
