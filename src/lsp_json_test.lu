//! member: false
//!
//! The port of sagitta `tests/unit/test_json.c` (230 lines),
//! `test_json_num.c` (111) and `test_jsonw.c` (225) at 9ace98c2, one test
//! per C test in registry order (`tests/unit/registry.c:1311-1323`). The
//! writer fixture is C's, copied verbatim (`tests/fixtures/lsp/
//! writer-corpus.json`). The structure-bug test re-executes this binary
//! (C forks): each misuse is a child that must exit 4 (`EXIT_BUG`).
//!
//! The per-case selector `YEW_LSP_JSON_CASE=N` (the registry index within this
//! file, 0-based; 13 cases) runs one case and prints its `NAME: PASS`
//! line, for the checked machine's step budget (G29,
//! tools/check-test-cases.txt).

use lsp
use std.fs
use std.process
use util

struct Tally {
    n: int,
}

fn ok(mut t: Tally, cond: bool, what: str) {
    t.n += 1
    assert(cond, what)
}

fn pb(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn parse_text(text: str, mut err: lsp.JsonErr) -> (lsp.Json, bool) {
    let doc = lsp.json_parse(text.bytes(), 0, text.len, mut err) else {
        return (lsp.json_new(), false)
    }
    (doc, true)
}

fn parse_bytes(b: List[byte], mut err: lsp.JsonErr) -> (lsp.Json, bool) {
    let doc = lsp.json_parse(b, 0, b.len, mut err) else {
        return (lsp.json_new(), false)
    }
    (doc, true)
}

fn assert_bad(mut t: Tally, text: str, prefix: str) {
    var err = lsp.json_err_new()
    let (_, good) = parse_text(text, mut err)
    ok(mut t, !good, "{text} is refused")
    ok(mut t, err.msg.starts_with(prefix), "{text}: '{err.msg}' starts with '{prefix}'")
    ok(mut t, err.line >= 1, "{text}: a line")
    ok(mut t, err.col >= 1, "{text}: a column")
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn text_of(b: List[byte]) -> str {
    str_from_utf8(b) else "<not utf-8>"
}

// test_json.c:27-71
fn json_parse_values_and_accessors(mut t: Tally) {
    let doc = "{{\"z\":null,\"a\":[true,false,7,3.5,\"x\\u0000y\"],\"nested\":{{\"line\":12}}}}"
    var err = lsp.json_err_new()
    let (j, good) = parse_text(doc, mut err)
    ok(mut t, good, "the document parses: {err.msg}")
    let root = j.root
    ok(mut t, lsp.json_kind(j, root) == lsp.JS_OBJ, "the root is an object")
    ok(mut t, lsp.json_size(j, root) == 3, "three members")
    let array = lsp.json_field(j, root, "a")
    ok(mut t, array >= 0, "member a")
    ok(mut t, lsp.json_size(j, array) == 5, "five elements")
    ok(mut t, lsp.json_bool(j, lsp.json_at(j, array, 0), false), "a[0] is true")
    ok(mut t, !lsp.json_bool(j, lsp.json_at(j, array, 1), true), "a[1] is false")
    ok(mut t, lsp.json_int(j, lsp.json_at(j, array, 2), -1) == 7, "a[2] is 7")
    ok(mut t, lsp.json_real(j, lsp.json_at(j, array, 3), 0.0) == 3.5, "a[3] is 3.5")
    let string = lsp.json_at(j, array, 4)
    let bytes = lsp.json_str(j, string)
    ok(mut t, lsp.json_size(j, string) == 3, "a[4] is three bytes")
    ok(mut t, same(bytes, [120 as byte, 0 as byte, 121 as byte]), "a[4] is x NUL y")
    ok(mut t, lsp.json_int(j, lsp.json_path(j, root, "nested.line"), -1) == 12, "nested.line")
    ok(mut t, lsp.json_path(j, root, "nested.missing") < 0, "nested.missing")
    ok(mut t, lsp.json_field(j, array, "a") < 0, "get on an array")
    ok(mut t, lsp.json_at(j, root, 0) < 0, "at on an object")
    ok(mut t, lsp.json_size(j, lsp.json_at(j, array, 2)) == 0, "len of an int")
    ok(mut t, lsp.json_int(j, string, 91) == 91, "int of a string")
    ok(mut t, lsp.json_real(j, string, 9.25) == 9.25, "real of a string")
    ok(mut t, lsp.json_bool(j, string, true), "bool of a string")
    ok(mut t, !lsp.json_is_str(j, root), "str of an object")
    ok(mut t, lsp.json_str(j, root).len == 0, "its length is 0")
    ok(mut t, !lsp.json_streq(j, root, "x"), "streq on an object")
    ok(mut t, !lsp.json_streq(j, string, "x"), "streq on a longer string")
}

// test_json.c:73-112
fn json_parse_escapes_and_surrogates(mut t: Tally) {
    let expected = [
        34 as byte,
        92 as byte,
        47 as byte,
        8 as byte,
        12 as byte,
        10 as byte,
        13 as byte,
        9 as byte,
        226 as byte,
        130 as byte,
        172 as byte,
        240 as byte,
        157 as byte,
        132 as byte,
        158 as byte,
    ]
    var err = lsp.json_err_new()
    let (j, good) = parse_text("\"\\\"\\\\\\/\\b\\f\\n\\r\\t\\u20ac\\uD834\\uDD1E\"", mut err)
    ok(mut t, good, "the escapes parse: {err.msg}")
    ok(mut t, lsp.json_kind(j, j.root) == lsp.JS_STR, "a string")
    ok(mut t, lsp.json_size(j, j.root) == expected.len, "its length")
    ok(mut t, same(lsp.json_str(j, j.root), expected), "its bytes")
    let (k, good2) = parse_text("\"\\uDCff\"", mut err)
    ok(mut t, good2, "the raw byte parses")
    ok(mut t, lsp.json_flags(k, k.root) & lsp.JSF_RAW_BYTE != 0, "flagged raw")
    ok(mut t, lsp.json_size(k, k.root) == 1, "one byte")
    ok(mut t, lsp.json_str(k, k.root)[0] as int == 255, "0xff")
    assert_bad(mut t, "\"\\uD800\"", "lone high surrogate U+D800")
    assert_bad(mut t, "\"\\uD800\\u0041\"", "lone high surrogate U+D800")
    assert_bad(mut t, "\"\\uDC00\"", "lone low surrogate U+DC00")
    assert_bad(mut t, "\"\\uDD00\"", "lone low surrogate U+DD00")
    assert_bad(mut t, "\"\\u12x4\"", "non-hex digit in Unicode escape")
    assert_bad(mut t, "\"\\q\"", "unknown escape '\\q'")
}

// test_json.c:114-133
fn json_parse_strict_rejections(mut t: Tally) {
    for bad in ["01", "+1", ".5", "1.", "1.e3", "-"] {
        assert_bad(mut t, bad, "malformed number")
    }
    assert_bad(mut t, "", "empty document")
    assert_bad(mut t, "[1,]", "trailing comma in array")
    assert_bad(mut t, "{{\"a\":1,}}", "trailing comma in object")
    assert_bad(mut t, "{{'a':1}}", "expected string")
    assert_bad(mut t, "{{a:1}}", "expected string")
    assert_bad(mut t, "/*x*/null", "expected JSON value")
    var ctl = pb("\"a")
    (mut ctl).push(1 as byte)
    util.buf_append_str(mut ctl, "b\"")
    var err = lsp.json_err_new()
    let (_, good) = parse_bytes(ctl, mut err)
    ok(mut t, !good && err.msg.starts_with("control byte in string"), "a control byte: {err.msg}")
    assert_bad(mut t, "true false", "trailing bytes after JSON value")
    assert_bad(mut t, "Infinity", "number out of range")
    assert_bad(mut t, "NaN", "number out of range")
}

fn nest(open: str, close: str, n: int) -> List[byte] {
    var doc = List[byte]()
    var i = 0
    while i < n {
        util.buf_append_str(mut doc, open)
        i += 1
    }
    (mut doc).push(48 as byte)
    i = 0
    while i < n {
        util.buf_append_str(mut doc, close)
        i += 1
    }
    doc
}

// test_json.c:135-193
fn json_parse_duplicate_keys_and_depth(mut t: Tally) {
    var err = lsp.json_err_new()
    let (j, good) = parse_text("{{\"a\":1,\"b\":2,\"a\":3}}", mut err)
    ok(mut t, good, "duplicate keys parse")
    ok(mut t, lsp.json_size(j, j.root) == 2, "two members")
    ok(mut t, lsp.json_flags(j, j.root) & lsp.JSF_DUP_KEY != 0, "flagged duplicate")
    ok(mut t, text_of(lsp.json_member_key(j, j.root, 0)) == "a", "a first")
    ok(mut t, text_of(lsp.json_member_key(j, j.root, 1)) == "b", "b second")
    ok(mut t, lsp.json_int(j, lsp.json_member_val(j, j.root, 0), -1) == 3, "a is the last value")
    let (_, d127) = parse_bytes(nest("[", "]", 127), mut err)
    ok(mut t, d127, "127 arrays deep parse")
    let (_, d128) = parse_bytes(nest("[", "]", 128), mut err)
    ok(mut t, !d128, "128 arrays deep refuse")
    ok(mut t, err.msg == "nesting deeper than 128", "the depth message: {err.msg}")
    ok(mut t, err.line == 1 && err.col > 1, "on line 1 past column 1")
    let (_, o127) = parse_bytes(nest("{{\"a\":", "}}", 127), mut err)
    ok(mut t, o127, "127 objects deep parse")
    let (_, o128) = parse_bytes(nest("{{\"a\":", "}}", 128), mut err)
    ok(mut t, !o128, "128 objects deep refuse")
    ok(mut t, err.msg == "nesting deeper than 128", "the object depth message")
}

// test_json.c:195-230
fn json_parse_size_and_node_limits(mut t: Tally) {
    var err = lsp.json_err_new()
    var huge = List[byte]()
    (mut huge).reserve(lsp.JSON_MAX_BYTES + 1)
    var i = 0
    while i <= lsp.JSON_MAX_BYTES {
        (mut huge).push(32 as byte)
        i += 1
    }
    let (_, big) = parse_bytes(huge, mut err)
    ok(mut t, !big, "64 MiB + 1 refuses")
    ok(mut t, err.msg == "document exceeds 64 MiB", "the size message: {err.msg}")
    var doc = List[byte]()
    (mut doc).reserve(lsp.JSON_MAX_NODES * 2 + 1)
    (mut doc).push(91 as byte)
    i = 0
    while i < lsp.JSON_MAX_NODES {
        (mut doc).push(48 as byte)
        if i + 1 < lsp.JSON_MAX_NODES {
            (mut doc).push(44 as byte)
        }
        i += 1
    }
    (mut doc).push(93 as byte)
    let (_, many) = parse_bytes(doc, mut err)
    ok(mut t, !many, "4 Mi + 1 nodes refuse")
    ok(mut t, err.msg == "too many JSON nodes", "the node message: {err.msg}")
    ok(mut t, err.line == 1, "on line 1")
    ok(mut t, err.col > 1, "past column 1")
}

// test_json_num.c:8-91: (text, kind, lossy, integer, real).
fn num_case(mut t: Tally, text: str, kind: int, lossy: bool, integer: int, real: f64) {
    var err = lsp.json_err_new()
    let (j, good) = parse_text(text, mut err)
    ok(mut t, good, "{text} parses: {err.msg}")
    ok(mut t, lsp.json_kind(j, j.root) == kind, "{text}: kind {lsp.json_kind(j, j.root)}")
    ok(
        mut t,
        (lsp.json_flags(j, j.root) & lsp.JSF_LOSSY_NUM != 0) == lossy,
        "{text}: lossy {lossy}",
    )
    if kind == lsp.JS_INT {
        ok(mut t, lsp.json_int(j, j.root, 0) == integer, "{text}: {lsp.json_int(j, j.root, 0)}")
    } else {
        ok(mut t, lsp.json_real(j, j.root, 1.5) == real, "{text}: {lsp.json_real(j, j.root, 1.5)}")
    }
}

fn json_number_policy(mut t: Tally) {
    let i = lsp.JS_INT
    let r = lsp.JS_REAL
    num_case(mut t, "0", i, false, 0, 0.0)
    num_case(mut t, "-0", i, false, 0, 0.0)
    num_case(mut t, "1", i, false, 1, 0.0)
    num_case(mut t, "-1", i, false, -1, 0.0)
    num_case(mut t, "42", i, false, 42, 0.0)
    num_case(mut t, "9223372036854775807", i, false, 9223372036854775807, 0.0)
    num_case(mut t, "-9223372036854775808", i, false, -9223372036854775807 - 1, 0.0)
    num_case(mut t, "9223372036854775808", r, true, 0, 9223372036854775808.0)
    num_case(mut t, "-9223372036854775809", r, true, 0, -9223372036854775808.0)
    num_case(mut t, "18446744073709551615", r, true, 0, 18446744073709551616.0)
    num_case(mut t, "3.14", r, false, 0, 3.14)
    num_case(mut t, "1.0", r, false, 0, 1.0)
    num_case(mut t, "1E+2", r, false, 0, 100.0)
    num_case(mut t, "1e-2", r, false, 0, 0.01)
    num_case(mut t, "1e308", r, false, 0, 1e308)
    num_case(mut t, "5e-324", r, false, 0, 5e-324)
    num_case(mut t, "1e-400", r, true, 0, 0.0)
    num_case(mut t, "2.2250738585072014e-308", r, false, 0, 2.2250738585072014e-308)
    num_case(mut t, "10e0", r, false, 0, 10.0)
    num_case(mut t, "6.022e23", r, false, 0, 6.022e23)
    num_case(mut t, "-2.5e3", r, false, 0, -2500.0)
    num_case(mut t, "1000000000000000000", i, false, 1000000000000000000, 0.0)
    num_case(mut t, "-1000000000000000000", i, false, -1000000000000000000, 0.0)
    num_case(mut t, "2147483647", i, false, 2147483647, 0.0)
    num_case(mut t, "-2147483648", i, false, -2147483648, 0.0)
    num_case(mut t, "0.000001", r, false, 0, 0.000001)
    num_case(mut t, "1e20", r, false, 0, 1e20)
    num_case(mut t, "-1e20", r, false, 0, -1e20)
    num_case(mut t, "7.5e-10", r, false, 0, 7.5e-10)
    num_case(mut t, "9007199254740991", i, false, 9007199254740991, 0.0)
    num_case(mut t, "9007199254740992", i, false, 9007199254740992, 0.0)
    num_case(mut t, "123456789", i, false, 123456789, 0.0)
    num_case(mut t, "-123456789", i, false, -123456789, 0.0)
    num_case(mut t, "0e0", r, false, 0, 0.0)
    num_case(mut t, "-0.0", r, false, 0, -0.0)
    num_case(mut t, "1.2345678901234567", r, false, 0, 1.2345678901234567)
    num_case(mut t, "4e-200", r, false, 0, 4e-200)
    num_case(mut t, "8e200", r, false, 0, 8e200)
    num_case(mut t, "99.99", r, false, 0, 99.99)
    num_case(mut t, "-17.125", r, false, 0, -17.125)
    num_case(mut t, "314159265358979323846", r, true, 0, 3.1415926535897933e20)
}

// test_json_num.c:93-111
fn json_number_rejections(mut t: Tally) {
    for bad in [
        "01",
        "+1",
        ".5",
        "1.",
        "1.e3",
        "-",
        "--1",
        "00",
        "1e",
        "1e+",
        "1e-",
        "-01",
        "2..0",
        "1e309",
        "-1e309",
    ] {
        var err = lsp.json_err_new()
        let (_, good) = parse_text(bad, mut err)
        ok(mut t, !good, "{bad} is refused")
        if bad.contains("309") {
            ok(mut t, err.msg == "number out of range", "{bad}: {err.msg}")
        } else {
            ok(
                mut t,
                err.msg.contains("number") ||
                    err.msg.contains("JSON value") ||
                    err.msg.contains("trailing bytes"),
                "{bad}: {err.msg}",
            )
        }
    }
}

fn assert_out(mut t: Tally, out: List[byte], expected: str) {
    ok(mut t, out.len == expected.len, "length {out.len}, want {expected.len}: {text_of(out)}")
    ok(mut t, same(out, pb(expected)), "bytes: {text_of(out)}")
}

// test_jsonw.c:19-44
fn json_writer_scalars_and_escapes(mut t: Tally) {
    let input = [
        34 as byte,
        92 as byte,
        47 as byte,
        8 as byte,
        12 as byte,
        10 as byte,
        13 as byte,
        9 as byte,
        0 as byte,
        1 as byte,
        31 as byte,
        65 as byte,
        226 as byte,
        130 as byte,
        172 as byte,
        255 as byte,
    ]
    var w = lsp.jsonw_new()
    lsp.jsonw_arr(mut w)
    lsp.jsonw_str(mut w, input)
    lsp.jsonw_int(mut w, -9223372036854775807 - 1)
    lsp.jsonw_real(mut w, 3.5)
    lsp.jsonw_bool(mut w, true)
    lsp.jsonw_bool(mut w, false)
    lsp.jsonw_null(mut w)
    lsp.jsonw_raw(mut w, pb("{{\"raw\":1}}"))
    lsp.jsonw_arr_end(mut w)
    assert_out(
        mut t,
        w.out,
        "[\"\\\"\\\\/\\b\\f\\n\\r\\t\\u0000\\u0001\\u001fA€\\uDCff\",-9223372036854775808,3.5,true,false,null,{{\"raw\":1}}]",
    )
}

// test_jsonw.c:46-78
fn json_writer_order_and_nested_shape(mut t: Tally) {
    let keys = ["k7", "k1", "k9", "k0", "k11", "k3", "k8", "k2", "k10", "k6", "k4", "k5"]
    var w = lsp.jsonw_new()
    lsp.jsonw_obj(mut w)
    var i = 0
    while i < keys.len {
        lsp.jsonw_key(mut w, keys[i])
        if i == 0 {
            lsp.jsonw_obj(mut w)
            lsp.jsonw_key(mut w, "inside")
            lsp.jsonw_arr(mut w)
            lsp.jsonw_cstr(mut w, "x")
            lsp.jsonw_arr_end(mut w)
            lsp.jsonw_obj_end(mut w)
        } else {
            lsp.jsonw_int(mut w, i)
        }
        i += 1
    }
    lsp.jsonw_obj_end(mut w)
    assert_out(
        mut t,
        w.out,
        "{{\"k7\":{{\"inside\":[\"x\"]}},\"k1\":1,\"k9\":2,\"k0\":3,\"k11\":4,\"k3\":5,\"k8\":6,\"k2\":7,\"k10\":8,\"k6\":9,\"k4\":10,\"k5\":11}}",
    )
}

// test_jsonw.c:80-102
fn json_writer_raw_byte_roundtrip(mut t: Tally) {
    var w = lsp.jsonw_new()
    lsp.jsonw_str(mut w, [255 as byte])
    assert_out(mut t, w.out, "\"\\uDCff\"")
    var err = lsp.json_err_new()
    let (j, good) = parse_bytes(w.out, mut err)
    ok(mut t, good, "the raw byte reparses")
    ok(mut t, lsp.json_kind(j, j.root) == lsp.JS_STR, "a string")
    ok(mut t, lsp.json_flags(j, j.root) & lsp.JSF_RAW_BYTE != 0, "flagged raw")
    ok(mut t, lsp.json_size(j, j.root) == 1, "one byte")
    ok(mut t, lsp.json_str(j, j.root)[0] as int == 255, "0xff")
}

// test_jsonw.c:104-140
fn json_writer_tree_roundtrip(mut t: Tally) {
    let corpus = [
        "null",
        "true",
        "false",
        "0",
        "-7",
        "3.25",
        "\"text\"",
        "[]",
        "{{}}",
        "[1,2,3]",
        "{{\"a\":1}}",
        "{{\"b\":2,\"a\":1}}",
        "[null,true,false]",
        "{{\"nested\":{{\"x\":[1,2]}}}}",
        "\"\\u20ac\"",
        "\"a\\u0000b\"",
        "9223372036854775808",
        "1e-400",
        "{{\"escaped\":\"\\n\\t\\\"\"}}",
        "[{{}},[],{{\"z\":0}}]",
    ]
    for text in corpus {
        var err = lsp.json_err_new()
        let (a, good) = parse_text(text, mut err)
        ok(mut t, good, "{text} parses")
        var w = lsp.jsonw_new()
        lsp.jsonw_value(mut w, a, a.root)
        let (b, good2) = parse_bytes(w.out, mut err)
        ok(mut t, good2, "{text} reparses from {text_of(w.out)}")
        ok(mut t, lsp.json_eq(a, a.root, b, b.root), "{text} round-trips")
    }
}

// test_jsonw.c:142-180
fn json_writer_fixture_determinism(mut t: Tally) {
    var fixture = fs.read_bytes("tests/fixtures/lsp/writer-corpus.json") else |_| {
        ok(mut t, false, "the writer fixture reads")
        return
    }
    if fixture.len != 0 && fixture[fixture.len - 1] as int == 10 {
        let _ = (mut fixture).pop()
    }
    var err = lsp.json_err_new()
    let (root, good) = parse_bytes(fixture, mut err)
    ok(mut t, good, "the fixture parses: {err.msg}")
    var first = lsp.jsonw_new()
    lsp.jsonw_value(mut first, root, root.root)
    var second = lsp.jsonw_new()
    lsp.jsonw_value(mut second, root, root.root)
    ok(mut t, first.out.len == fixture.len, "the first emission is the fixture's length")
    ok(mut t, same(first.out, fixture), "the first emission is the fixture: {text_of(first.out)}")
    ok(mut t, same(second.out, first.out), "the second emission is the first")
}

// test_jsonw.c:182-225: each misuse in a child, exit 4.
fn writer_bug_exit(action: int) -> int {
    let exe = os_exe() else {
        assert(false, "the structure-bug test needs its own executable")
        return -1
    }
    var c = process.command(exe)
    process.push_arg(mut c, "--writer-bug")
    process.push_arg(mut c, "{action}")
    fs.create_dir_all("target/tests") else |_| {}
    let err_path = "target/tests/lsp-json-writer-bug.err"
    fs.remove(err_path) else |_| {}
    let sink = fs.create_with_mode(err_path, 0o600) else |_| {
        assert(false, "open the stderr capture")
        return -1
    }
    process.set_stderr(mut c, sink)
    let child = process.start(c) else |_| {
        assert(false, "spawn the child")
        return -1
    }
    let status = process.wait_status(take child) else -1
    fs.close(take sink) else |_| {}
    status
}

fn writer_bug_child(action: str) {
    var w = lsp.jsonw_new()
    lsp.jsonw_obj(mut w)
    if action == "0" {
        lsp.jsonw_arr_end(mut w)
    } else if action == "1" {
        lsp.jsonw_int(mut w, 1)
    } else {
        lsp.jsonw_key(mut w, "missing")
        lsp.jsonw_obj_end(mut w)
    }
    os_exit(0)
}

fn json_writer_structure_bugs(mut t: Tally) {
    ok(mut t, writer_bug_exit(0) == util.EXIT_BUG, "an array end in an object is a bug")
    ok(mut t, writer_bug_exit(1) == util.EXIT_BUG, "an object value without a key is a bug")
    ok(mut t, writer_bug_exit(2) == util.EXIT_BUG, "an object key without a value is a bug")
}

fn want(chosen: int, n: int) -> bool {
    chosen < 0 || chosen == n
}

fn main() {
    let args = env_args()
    if args.len == 2 && args[0] == "--writer-bug" {
        env_set("YEW_LOG", "/dev/null") else |_| {}
        writer_bug_child(args[1])
    }
    env_set("YEW_LOG", "/dev/null") else |_| {}
    let chosen = (env_get("YEW_LSP_JSON_CASE") else "-1").to_int() else -1
    var t = Tally { n: 0 }
    if want(chosen, 0) {
        json_parse_values_and_accessors(mut t)
        print("json_parse_values_and_accessors: PASS")
    }
    if want(chosen, 1) {
        json_parse_escapes_and_surrogates(mut t)
        print("json_parse_escapes_and_surrogates: PASS")
    }
    if want(chosen, 2) {
        json_parse_strict_rejections(mut t)
        print("json_parse_strict_rejections: PASS")
    }
    if want(chosen, 3) {
        json_parse_duplicate_keys_and_depth(mut t)
        print("json_parse_duplicate_keys_and_depth: PASS")
    }
    if want(chosen, 4) {
        json_parse_size_and_node_limits(mut t)
        print("json_parse_size_and_node_limits: PASS")
    }
    if want(chosen, 5) {
        json_number_policy(mut t)
        print("json_number_policy: PASS")
    }
    if want(chosen, 6) {
        json_number_rejections(mut t)
        print("json_number_rejections: PASS")
    }
    if want(chosen, 7) {
        json_writer_scalars_and_escapes(mut t)
        print("json_writer_scalars_and_escapes: PASS")
    }
    if want(chosen, 8) {
        json_writer_order_and_nested_shape(mut t)
        print("json_writer_order_and_nested_shape: PASS")
    }
    if want(chosen, 9) {
        json_writer_raw_byte_roundtrip(mut t)
        print("json_writer_raw_byte_roundtrip: PASS")
    }
    if want(chosen, 10) {
        json_writer_tree_roundtrip(mut t)
        print("json_writer_tree_roundtrip: PASS")
    }
    if want(chosen, 11) {
        json_writer_fixture_determinism(mut t)
        print("json_writer_fixture_determinism: PASS")
    }
    if want(chosen, 12) {
        json_writer_structure_bugs(mut t)
        print("json_writer_structure_bugs: PASS")
    }
    if chosen < 0 {
        print("lsp_json_test: 13 cases pass, {t.n} assertions")
    }
}
