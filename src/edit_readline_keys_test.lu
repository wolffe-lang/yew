// `test_readline_kill_then_yank_round_trips` (`:316-328`).
fn readline_kill_then_yank_round_trips() {
    var ed = fixture_str(words())
    at(mut ed, 10)
    ok(mut ed, "ed.edit.kill.word_prev")
    expect(ed, "alpha  gamma\ndelta epsilon")
    ok(mut ed, "ed.edit.kill.yank")
    expect(ed, words())
    assert(pos(ed, 0) == 10, "cursor after the yank")
}

// `test_readline_yank_reaches_every_cursor` (`:331-344`).
fn readline_yank_reaches_every_cursor() {
    var ed = fixture_str(words())
    at(mut ed, 10)
    add(mut ed, 22)
    ok(mut ed, "ed.edit.kill.word_prev")
    expect_kill(ed, "betadelta")
    ok(mut ed, "ed.edit.kill.yank")
    expect(ed, "alpha betadelta gamma\nbetadelta epsilon")
    assert(pos(ed, 0) == 15, "cursor 0 after its copy")
}

