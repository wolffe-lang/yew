//! member: false
//!
//! The port of sagitta `tests/unit/test_readline_keys.c` (965 lines), one
//! test per C test in registry order (`tests/unit/registry.c:174-206`).
//! Every case drives a REGISTERED command through THE invoke against the
//! loaded runtime (`runtime/init.fl`), so the transaction wrapping, the
//! multi-cursor fan-out and the yank-stack write are the ones a keystroke
//! gets; the binding cases drive real keys through `edit.ed_handle_key`.
//! C's fixture (`rl_fixture`, `test_readline_keys.c:19-48`): the
//! runtime-configured scratch editor with the buffer's text and undo tree
//! replaced, tab width 4, LF, clipboard sync off, an 8×80 window, the
//! cursor at 0, in I mode. C's register snapshot copies the `Registers`
//! struct's bytes; the port's renders the value (`{regs}` interpolates
//! every field, the clipboard's queue included).

use edit
use term
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn raw(xs: List[int]) -> List[byte] {
    var v = List[byte]()
    for x in xs {
        (mut v).push(x as byte)
    }
    v
}

fn runtime() -> List[byte] {
    let bytes = fs_read_bytes("runtime/init.fl") else List[byte]()
    assert(bytes.len != 0, "runtime/init.fl is readable from the repository root")
    bytes
}

// `rl_fixture` (`test_readline_keys.c:19-48`).
fn fixture(bytes: List[byte]) -> edit.Ed {
    var ed = edit.ed_new_test(runtime(), "")
    let w = ed.win
    let b = ed.wins[w].buf
    ed.bufs[b].ec.tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    ed.bufs[b].ec.undo = text.undo_new(ed.bufs[b].ec.tb)
    ed.bufs[b].tabwidth = 4
    ed.bufs[b].ec.meta.eol = text.EOL_LF
    ed.bufs[b].ec.meta.dominant_eol = text.EOL_LF
    ed.bufs[b].ec.meta.lf_count = 1
    ed.regs.clipboard_sync = text.CLIP_SYNC_OFF
    ed.wins[w].vp.rows = 8
    ed.wins[w].vp.cols = 80
    ed.wins[w].rect.h = 8
    ed.wins[w].rect.w = 80
    at(mut ed, 0)
    assert(edit.mode_enter(mut ed, edit.MODE_I) == edit.CMD_OK, "fixture: enter I")
    ed
}

fn fixture_str(s: str) -> edit.Ed {
    fixture(bytes_of(s))
}

fn buf(ed: edit.Ed) -> int {
    ed.wins[ed.win].buf
}

// `rl_at` (`test_readline_keys.c:55-63`).
fn at(mut ed: edit.Ed, off: int) {
    let w = ed.win
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].pos = off
    ed.wins[w].cs.curs[p].anchor = off
    ed.wins[w].cs.curs[p].goal_col = 0
}

// `rl_add` (`test_readline_keys.c:65-71`).
fn add(mut ed: edit.Ed, off: int) {
    let w = ed.win
    let b = ed.wins[w].buf
    assert(text.cset_add(mut ed.wins[w].cs, text.Cursor { pos: off, goal_col: 0, anchor: off }), "add {off}")
    text.cset_normalize(ed.bufs[b].ec.tb, mut ed.wins[w].cs)
}

fn pos(ed: edit.Ed, i: int) -> int {
    let w = ed.win
    assert(i < ed.wins[w].cs.curs.len, "cursor {i} exists")
    ed.wins[w].cs.curs[i].pos
}

fn ncurs(ed: edit.Ed) -> int {
    ed.wins[ed.win].cs.curs.len
}

// `rl_invoke` (`test_readline_keys.c:79-91`).
fn invoke(mut ed: edit.Ed, name: str) -> int {
    let id = edit.cmd_lookup(ed.reg, name)
    assert(id != 0, "{name} is registered")
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    edit.ed_cmd_invoke(mut ed, id, mut cx)
}

fn ok(mut ed: edit.Ed, name: str) {
    let status = invoke(mut ed, name)
    assert(status == edit.CMD_OK, "{name}: status {status}")
}

fn expect_bytes(ed: edit.Ed, want: List[byte]) {
    let got = text.textbuf_bytes(ed.bufs[buf(ed)].ec.tb)
    assert(got.len == want.len, "buffer: {got.len} bytes, want {want.len}")
    var i = 0
    while i < got.len {
        assert(got[i] == want[i], "buffer: byte {i} differs")
        i += 1
    }
}

// `rl_expect` (`test_readline_keys.c:115-123`).
fn expect(ed: edit.Ed, want: str) {
    expect_bytes(ed, bytes_of(want))
}

// `rl_expect_kill` (`test_readline_keys.c:126-134`): the newest yank-stack
// entry.
fn expect_kill(ed: edit.Ed, want: str) {
    let got = text.yank_at(ed.yank, 0) else {
        assert(false, "the yank stack has an entry")
        return
    }
    let w = bytes_of(want)
    assert(got.len == w.len, "kill: {got.len} bytes, want {w.len}")
    var i = 0
    while i < got.len {
        assert(got[i] == w[i], "kill: byte {i} differs")
        i += 1
    }
}

fn len_of(ed: edit.Ed) -> int {
    text.textbuf_len(ed.bufs[buf(ed)].ec.tb)
}

// "alpha beta gamma\ndelta epsilon"
//  0     6    11     16 17    23
fn words() -> str {
    "alpha beta gamma\ndelta epsilon"
}

// `rl_chord` (`test_readline_keys.c:597-605`): a modified chord carries
// no text.
fn chord(code: int, mods: int) -> term.Key {
    var key = term.key_new()
    key.code = code
    key.kind = term.EV_KEY
    key.ev = term.KEY_PRESS
    key.mods = mods
    key
}

fn ch(c: str) -> int {
    c.bytes()[0] as int
}

// `rl_send` (`test_readline_keys.c:607-611`).
fn send(mut ed: edit.Ed, key: term.Key) {
    edit.ed_handle_key(mut ed, key, 0)
    assert(ed.last_status == edit.CMD_OK, "key {key.code}/{key.mods}: status {ed.last_status}")
}

// `rl_key_runs` (`test_readline_keys.c:613-618`).
fn key_runs(mut ed: edit.Ed, key: term.Key, name: str) {
    send(mut ed, key)
    assert(ed.last_cmd == edit.cmd_lookup(ed.reg, name), "key {key.code}/{key.mods} runs {name}")
}

fn snap_yank(ed: edit.Ed) -> str {
    var s = "{ed.yank.len} {ed.yank.bytes}"
    var k = 0
    while k < ed.yank.len {
        let e = text.yank_at(ed.yank, k) else List[byte]()
        s = "{s} [{e}]"
        k += 1
    }
    s
}

// ---------------------------------------------------------------- kills

// `test_readline_kill_word_prev_reaches_every_cursor` (`:142-156`).
fn readline_kill_word_prev_reaches_every_cursor() {
    var ed = fixture_str(words())
    at(mut ed, 10)
    add(mut ed, 22)
    ok(mut ed, "ed.edit.kill.word_prev")
    expect(ed, "alpha  gamma\n epsilon")
    expect_kill(ed, "betadelta")
    assert(ncurs(ed) == 2, "two cursors")
    assert(pos(ed, 0) == 6, "cursor 0 at 6")
    assert(pos(ed, 1) == 13, "cursor 1 at 13")
}

// `test_readline_kills_leave_registers_and_clipboard_untouched`
// (`:747-800`).
fn readline_kills_leave_registers_and_clipboard_untouched() {
    var ed = fixture_str("keep me\nalpha beta gamma\ndelta\n")
    assert(edit.mode_enter(mut ed, edit.MODE_L) == edit.CMD_OK, "L")
    ed.regs.clipboard_sync = text.CLIP_SYNC_ALL
    var seeded = text.regval_new()
    seeded.bytes = bytes_of("named")
    text.reg_yank(mut ed.regs, ch("a"), seeded)
    text.clip_reset(mut ed.regs.clip)
    assert(!text.clip_pending(ed.regs.clip), "no clipboard write pending")
    // The control: a register DELETE under sync = all queues a write.
    var gone = text.regval_new()
    gone.bytes = bytes_of("gone")
    text.reg_delete(mut ed.regs, 0, gone)
    assert(text.clip_pending(ed.regs.clip), "the control queued a clipboard write")
    text.clip_reset(mut ed.regs.clip)
    assert(!text.clip_pending(ed.regs.clip), "reset")
    at(mut ed, 0)
    send(mut ed, chord(ch("d"), 0))
    send(mut ed, chord(ch("d"), 0))
    expect(ed, "alpha beta gamma\ndelta\n")
    let before = "{ed.regs}"
    assert(edit.mode_enter(mut ed, edit.MODE_I) == edit.CMD_OK, "I")
    at(mut ed, 11)
    send(mut ed, chord(ch("k"), term.MOD_CTRL))
    send(mut ed, chord(ch("w"), term.MOD_CTRL))
    send(mut ed, chord(term.KEY_LEFT, 0))
    send(mut ed, chord(ch("d"), term.MOD_ALT))
    send(mut ed, chord(ch("u"), term.MOD_CTRL))
    // C-k C-w joined; the Left split; A-d C-u joined.
    assert(ed.yank.len == 2, "two yank entries, got {ed.yank.len}")
    let older = text.yank_at(ed.yank, 1) else List[byte]()
    let want = bytes_of("beta gamma")
    assert(older.len == want.len, "the older entry is 'beta gamma'")
    var i = 0
    while i < want.len {
        assert(older[i] == want[i], "older entry byte {i}")
        i += 1
    }
    send(mut ed, chord(ch("y"), term.MOD_CTRL))
    let after = "{ed.regs}"
    assert(before == after, "every register byte-identical")
    assert(!text.clip_pending(ed.regs.clip), "no clipboard write pending")
    assert(!text.clip_busy(ed.regs.clip), "no clipboard writer busy")
    let unnamed = text.reg_get(mut ed.regs, ch("\"")) else text.regval_new()
    let g = bytes_of("gone")
    assert(unnamed.bytes.len == 4, "the unnamed register holds the control's value")
    i = 0
    while i < 4 {
        assert(unnamed.bytes[i] == g[i], "unnamed byte {i}")
        i += 1
    }
    text.clip_reset(mut ed.regs.clip)
}

// `test_readline_register_writes_leave_the_yank_stack` (`:804-838`).
fn readline_register_writes_leave_the_yank_stack() {
    var ed = fixture_str("one two\nthree\nfour\n")
    at(mut ed, 7)
    send(mut ed, chord(ch("w"), term.MOD_CTRL))
    expect_kill(ed, "two")
    let before = snap_yank(ed)
    send(mut ed, chord(term.KEY_ESCAPE, 0))
    send(mut ed, chord(term.KEY_ESCAPE, 0))
    assert(ed.mode == edit.MODE_L, "back in L")
    at(mut ed, 9)
    send(mut ed, chord(ch("d"), 0))
    send(mut ed, chord(ch("d"), 0))
    expect(ed, "one \nfour\n")
    let w = ed.win
    ed.wins[w].cs.curs[0].anchor = 0
    ed.wins[w].cs.curs[0].pos = 3
    let _ = invoke(mut ed, "ed.sel.yank")
    assert(snap_yank(ed) == before, "the yank stack is as it was")
}

// `test_readline_consecutive_kill_keys_join` (`:841-860`).
fn readline_consecutive_kill_keys_join() {
    var ed = fixture_str(words())
    at(mut ed, 16)
    send(mut ed, chord(ch("w"), term.MOD_CTRL))
    send(mut ed, chord(term.KEY_BACKSPACE, term.MOD_ALT))
    expect_kill(ed, "beta gamma")
    assert(ed.yank.len == 1, "one entry")
    send(mut ed, chord(term.KEY_LEFT, 0))
    send(mut ed, chord(ch("k"), term.MOD_CTRL))
    assert(ed.yank.len == 2, "two entries")
    expect_kill(ed, " ")
    send(mut ed, chord(ch("k"), term.MOD_CTRL))
    expect_kill(ed, " \n")
    expect(ed, "alphadelta epsilon")
}

// `test_readline_insert_alt_del_and_alt_y` (`:863-889`).
fn readline_insert_alt_del_and_alt_y() {
    var ed = fixture_str(words())
    at(mut ed, 6)
    key_runs(mut ed, chord(term.KEY_DELETE, term.MOD_ALT), "ed.edit.kill.word_next")
    expect(ed, "alpha gamma\ndelta epsilon")
    expect_kill(ed, "beta ")
    send(mut ed, chord(term.KEY_RIGHT, 0))
    send(mut ed, chord(ch("d"), term.MOD_ALT))
    expect(ed, "alpha gdelta epsilon")
    expect_kill(ed, "amma\n")
    key_runs(mut ed, chord(ch("y"), term.MOD_CTRL), "ed.edit.kill.yank")
    expect(ed, "alpha gamma\ndelta epsilon")
    key_runs(mut ed, chord(ch("y"), term.MOD_ALT), "ed.edit.kill.yank_pop")
    expect(ed, "alpha gbeta delta epsilon")
    send(mut ed, chord(ch("y"), term.MOD_ALT))
    expect(ed, "alpha gamma\ndelta epsilon")
    ok(mut ed, "ed.edit.undo")
    expect(ed, "alpha gbeta delta epsilon")
}

// `test_readline_multicursor_yank_pop` (`:893-917`).
fn readline_multicursor_yank_pop() {
    var ed = fixture_str("ab\ncd\n")
    text.yank_kill(mut ed.yank, bytes_of("OLD"), text.KILL_FORWARD, 0, 0)
    text.yank_kill(mut ed.yank, bytes_of("new"), text.KILL_FORWARD, 0, 0)
    assert(ed.yank.len == 2, "two entries")
    at(mut ed, 1)
    add(mut ed, 4)
    send(mut ed, chord(ch("y"), term.MOD_CTRL))
    expect(ed, "anewb\ncnewd\n")
    send(mut ed, chord(ch("y"), term.MOD_ALT))
    expect(ed, "aOLDb\ncOLDd\n")
    assert(pos(ed, 0) == 4, "cursor 0 at 4")
    assert(pos(ed, 1) == 10, "cursor 1 at 10")
    send(mut ed, chord(ch("y"), term.MOD_ALT))
    expect(ed, "anewb\ncnewd\n")
    ok(mut ed, "ed.edit.undo")
    expect(ed, "aOLDb\ncOLDd\n")
}

// `test_readline_kill_word_prev_at_buffer_start_is_a_no_op` (`:160-170`).
fn readline_kill_word_prev_at_buffer_start_is_a_no_op() {
    var ed = fixture_str(words())
    at(mut ed, 0)
    ok(mut ed, "ed.edit.kill.word_prev")
    expect(ed, words())
    assert(pos(ed, 0) == 0, "cursor stays")
}

// `test_readline_kill_word_next_takes_the_word_and_its_gap` (`:173-184`).
fn readline_kill_word_next_takes_the_word_and_its_gap() {
    var ed = fixture_str(words())
    at(mut ed, 6)
    ok(mut ed, "ed.edit.kill.word_next")
    expect(ed, "alpha gamma\ndelta epsilon")
    expect_kill(ed, "beta ")
    assert(pos(ed, 0) == 6, "cursor stays at 6")
}

// `test_readline_kill_to_home_stops_at_the_line_start` (`:186-210`).
fn readline_kill_to_home_stops_at_the_line_start() {
    var ed = fixture_str(words())
    at(mut ed, 22)
    ok(mut ed, "ed.edit.kill.to_home")
    expect(ed, "alpha beta gamma\n epsilon")
    expect_kill(ed, "delta")
    assert(pos(ed, 0) == 17, "cursor at the line start")
    ok(mut ed, "ed.edit.kill.to_home")
    expect(ed, "alpha beta gamma\n epsilon")
    expect_kill(ed, "delta")
}

// `test_readline_kill_to_home_merges_carets_sharing_a_line` (`:217-230`).
fn readline_kill_to_home_merges_carets_sharing_a_line() {
    var ed = fixture_str(words())
    at(mut ed, 5)
    add(mut ed, 10)
    ok(mut ed, "ed.edit.kill.to_home")
    expect(ed, " gamma\ndelta epsilon")
    expect_kill(ed, "alpha beta")
    assert(ncurs(ed) == 1, "the carets merged")
    assert(pos(ed, 0) == 0, "cursor at 0")
}

// `test_readline_kill_to_end_stops_at_the_line_end` (`:232-243`).
fn readline_kill_to_end_stops_at_the_line_end() {
    var ed = fixture_str(words())
    at(mut ed, 11)
    ok(mut ed, "ed.edit.kill.to_end")
    expect(ed, "alpha beta \ndelta epsilon")
    expect_kill(ed, "gamma")
    assert(pos(ed, 0) == 11, "cursor stays")
}

// `test_readline_kill_to_end_takes_the_line_ending_and_empty_lines`
// (`:251-269`).
fn readline_kill_to_end_takes_the_line_ending_and_empty_lines() {
    var ed = fixture_str("one\n\ntwo")
    at(mut ed, 4)
    ok(mut ed, "ed.edit.kill.to_end")
    expect(ed, "one\ntwo")
    expect_kill(ed, "\n")
    at(mut ed, 3)
    ok(mut ed, "ed.edit.kill.to_end")
    expect(ed, "onetwo")
    at(mut ed, 6)
    ok(mut ed, "ed.edit.kill.to_end")
    expect(ed, "onetwo")
}

// `test_readline_kill_to_end_takes_a_whole_crlf` (`:273-287`).
fn readline_kill_to_end_takes_a_whole_crlf() {
    var ed = fixture_str("one\r\ntwo\r\n")
    let b = buf(ed)
    ed.bufs[b].ec.meta.eol = text.EOL_CRLF
    ed.bufs[b].ec.meta.dominant_eol = text.EOL_CRLF
    at(mut ed, 3)
    ok(mut ed, "ed.edit.kill.to_end")
    expect(ed, "onetwo\r\n")
    expect_kill(ed, "\r\n")
}

// `test_readline_kills_take_whole_graphemes` (`:291-308`).
fn readline_kills_take_whole_graphemes() {
    // "ab 日本 café" with the é as e + U+0301.
    var ed = fixture(
        raw([97, 98, 32, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 32, 99, 97, 102, 101, 0xcc, 0x81]),
    )
    at(mut ed, 9)
    ok(mut ed, "ed.edit.kill.word_prev")
    expect_bytes(ed, raw([97, 98, 32, 0xe6, 0x97, 0xa5, 32, 99, 97, 102, 101, 0xcc, 0x81]))
    let got = text.yank_at(ed.yank, 0) else List[byte]()
    let want = raw([0xe6, 0x9c, 0xac])
    assert(
        got.len == 3 && got[0] == want[0] && got[1] == want[1] && got[2] == want[2],
        "the second ideograph was killed",
    )
    at(mut ed, len_of(ed))
    ok(mut ed, "ed.edit.transpose.chars")
    expect_bytes(ed, raw([97, 98, 32, 0xe6, 0x97, 0xa5, 32, 99, 97, 101, 0xcc, 0x81, 102]))
}

