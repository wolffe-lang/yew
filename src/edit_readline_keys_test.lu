// `test_readline_kill_does_not_swallow_the_typing_before_it` (`:405-430`).
fn readline_kill_does_not_swallow_the_typing_before_it() {
    var ed = fixture_str(words())
    at(mut ed, 30)
    let id = edit.cmd_lookup(ed.reg, "ed.edit.insert.text")
    assert(id != 0, "insert.text is registered")
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    cx.sarg = " zeta"
    cx.has_sarg = true
    assert(edit.ed_cmd_invoke(mut ed, id, mut cx) == edit.CMD_OK, "type")
    expect(ed, "alpha beta gamma\ndelta epsilon zeta")
    ok(mut ed, "ed.edit.kill.to_home")
    expect(ed, "alpha beta gamma\n")
    ok(mut ed, "ed.edit.undo")
    expect(ed, "alpha beta gamma\ndelta epsilon zeta")
}

// -------------------------------------------------------------- transpose

// `test_readline_transpose_chars_swaps_around_the_caret` (`:434-445`).
fn readline_transpose_chars_swaps_around_the_caret() {
    var ed = fixture_str("abcd\nxy")
    at(mut ed, 2)
    ok(mut ed, "ed.edit.transpose.chars")
    expect(ed, "acbd\nxy")
    assert(pos(ed, 0) == 3, "cursor past the pair")
}

// `test_readline_transpose_chars_at_line_end_and_line_start` (`:453-469`).
fn readline_transpose_chars_at_line_end_and_line_start() {
    var ed = fixture_str("abcd\nxy")
    at(mut ed, 4)
    ok(mut ed, "ed.edit.transpose.chars")
    expect(ed, "abdc\nxy")
    assert(pos(ed, 0) == 4, "cursor stays at the line end")
    at(mut ed, 5)
    ok(mut ed, "ed.edit.transpose.chars")
    expect(ed, "abdc\nxy")
    assert(pos(ed, 0) == 5, "cursor stays at the line start")
}

// `test_readline_transpose_chars_on_an_empty_line_is_a_no_op` (`:472-482`).
fn readline_transpose_chars_on_an_empty_line_is_a_no_op() {
    var ed = fixture_str("ab\n\ncd")
    at(mut ed, 3)
    ok(mut ed, "ed.edit.transpose.chars")
    expect(ed, "ab\n\ncd")
}

// `test_readline_transpose_chars_reaches_every_cursor` (`:484-498`).
fn readline_transpose_chars_reaches_every_cursor() {
    var ed = fixture_str("abcd\nwxyz")
    at(mut ed, 2)
    add(mut ed, 7)
    ok(mut ed, "ed.edit.transpose.chars")
    expect(ed, "acbd\nwyxz")
    assert(pos(ed, 0) == 3, "cursor 0 at 3")
    assert(pos(ed, 1) == 8, "cursor 1 at 8")
}

// `test_readline_transpose_words_drags_one_word_past_the_next`
// (`:501-511`).
fn readline_transpose_words_drags_one_word_past_the_next() {
    var ed = fixture_str(words())
    at(mut ed, 6)
    ok(mut ed, "ed.edit.transpose.words")
    expect(ed, "beta alpha gamma\ndelta epsilon")
    assert(pos(ed, 0) == 10, "cursor after the pair")
}

// `test_readline_transpose_words_needs_a_word_on_each_side` (`:514-523`).
fn readline_transpose_words_needs_a_word_on_each_side() {
    var ed = fixture_str(words())
    at(mut ed, 0)
    ok(mut ed, "ed.edit.transpose.words")
    expect(ed, words())
}

// ------------------------------------------------------------- word case

// `test_readline_word_case_runs_from_the_caret_and_steps_past`
// (`:531-556`).
fn readline_word_case_runs_from_the_caret_and_steps_past() {
    var ed = fixture_str("alpha BETA gamma")
    at(mut ed, 0)
    ok(mut ed, "ed.edit.case.upper_word")
    expect(ed, "ALPHA BETA gamma")
    assert(pos(ed, 0) == 5, "past ALPHA")
    at(mut ed, 6)
    ok(mut ed, "ed.edit.case.lower_word")
    expect(ed, "ALPHA beta gamma")
    assert(pos(ed, 0) == 10, "past beta")
    at(mut ed, 11)
    ok(mut ed, "ed.edit.case.cap_word")
    expect(ed, "ALPHA beta Gamma")
    assert(pos(ed, 0) == 16, "past Gamma")
    at(mut ed, 13)
    ok(mut ed, "ed.edit.case.upper_word")
    expect(ed, "ALPHA beta GaMMA")
}

// `test_readline_word_case_skips_blanks_to_the_next_word` (`:559-575`).
fn readline_word_case_skips_blanks_to_the_next_word() {
    var ed = fixture_str("alpha   beta")
    at(mut ed, 5)
    ok(mut ed, "ed.edit.case.upper_word")
    expect(ed, "alpha   BETA")
    assert(pos(ed, 0) == 12, "past BETA")
    ok(mut ed, "ed.edit.case.upper_word")
    expect(ed, "alpha   BETA")
}

// `test_readline_word_case_reaches_every_cursor` (`:577-590`).
fn readline_word_case_reaches_every_cursor() {
    var ed = fixture_str(words())
    at(mut ed, 6)
    add(mut ed, 17)
    ok(mut ed, "ed.edit.case.upper_word")
    expect(ed, "alpha BETA gamma\nDELTA epsilon")
    assert(pos(ed, 0) == 10, "cursor 0 at 10")
    assert(pos(ed, 1) == 22, "cursor 1 at 22")
}

// ------------------------------------------------------------- the keys

// `test_readline_insert_keys_reach_their_commands` (`:620-667`).
fn readline_insert_keys_reach_their_commands() {
    var ed = fixture_str(words())
    assert(ed.mode == edit.MODE_I, "in I")
    at(mut ed, 10)
    key_runs(mut ed, chord(ch("w"), term.MOD_CTRL), "ed.edit.kill.word_prev")
    at(mut ed, 6)
    key_runs(mut ed, chord(term.KEY_BACKSPACE, term.MOD_ALT), "ed.edit.kill.word_prev")
    key_runs(mut ed, chord(ch("d"), term.MOD_ALT), "ed.edit.kill.word_next")
    key_runs(mut ed, chord(ch("u"), term.MOD_CTRL), "ed.edit.kill.to_home")
    key_runs(mut ed, chord(ch("k"), term.MOD_CTRL), "ed.edit.kill.to_end")
    key_runs(mut ed, chord(ch("y"), term.MOD_CTRL), "ed.edit.kill.yank")
    key_runs(mut ed, chord(ch("d"), term.MOD_CTRL), "ed.edit.delete.grapheme")
    key_runs(mut ed, chord(ch("t"), term.MOD_CTRL), "ed.edit.transpose.chars")
    key_runs(mut ed, chord(ch("t"), term.MOD_ALT), "ed.edit.transpose.words")
    key_runs(mut ed, chord(ch("u"), term.MOD_ALT), "ed.edit.case.upper_word")
    key_runs(mut ed, chord(ch("l"), term.MOD_ALT), "ed.edit.case.lower_word")
    key_runs(mut ed, chord(ch("c"), term.MOD_ALT), "ed.edit.case.cap_word")
    key_runs(mut ed, chord(ch("p"), term.MOD_CTRL), "ed.move.line.up")
    key_runs(mut ed, chord(ch("n"), term.MOD_CTRL), "ed.move.line.down")
    key_runs(mut ed, chord(ch("_"), term.MOD_CTRL), "ed.edit.undo")
    key_runs(mut ed, chord(ch("/"), term.MOD_CTRL), "ed.edit.undo")
    assert(ed.mode == edit.MODE_I, "still in I")
}

// `test_readline_ctrl_w_kills_a_word_through_the_key` (`:670-682`).
fn readline_ctrl_w_kills_a_word_through_the_key() {
    var ed = fixture_str(words())
    at(mut ed, 10)
    send(mut ed, chord(ch("w"), term.MOD_CTRL))
    expect(ed, "alpha  gamma\ndelta epsilon")
    expect_kill(ed, "beta")
    send(mut ed, chord(ch("y"), term.MOD_CTRL))
    expect(ed, words())
}

// `test_readline_ctrl_d_on_an_empty_line_does_not_quit` (`:690-710`).
fn readline_ctrl_d_on_an_empty_line_does_not_quit() {
    var ed = fixture_str("one\n\ntwo")
    at(mut ed, 4)
    send(mut ed, chord(ch("d"), term.MOD_CTRL))
    assert(!ed.quit, "C-d does not quit")
    assert(ed.mode == edit.MODE_I, "still in I")
    expect(ed, "one\ntwo")
    at(mut ed, len_of(ed))
    send(mut ed, chord(ch("d"), term.MOD_CTRL))
    assert(!ed.quit, "C-d at the end does not quit")
    expect(ed, "one\ntwo")
}

// `test_readline_signature_help_moved_to_alt_k` (`:713-723`): the command
// is yw11's and refuses by name; the key reaches it.
fn readline_signature_help_moved_to_alt_k() {
    var ed = fixture_str(words())
    edit.ed_handle_key(mut ed, chord(ch("k"), term.MOD_ALT), 0)
    assert(
        ed.last_cmd == edit.cmd_lookup(ed.reg, "ed.lsp.signature"),
        "A-k reaches ed.lsp.signature",
    )
}

