//! member: false
//!
//! The port of sagitta `tests/unit/test_register.c` (349 lines), one test
//! per C test in registry order (`tests/unit/registry.c:207-218`). C binds
//! the undo tree and file metadata to the register file
//! (`yew_reg_bind_context`); the port's bound read is `reg_get_in(mut r,
//! name, ec)` over the context that owns them, so the `%` test hands its
//! metadata to the context after the edits (C's context had none). C's
//! pointer identity `reg_get('*') == reg_get('+')` is `reg_slot`.

use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn value_of(kind: int, bytes: List[byte]) -> text.RegVal {
    var v = text.regval_new()
    v.kind = kind
    v.bytes = copy bytes
    v
}

fn value(kind: int, s: str) -> text.RegVal {
    value_of(kind, bytes_of(s))
}

fn assert_value(v: text.RegVal, kind: int, want: List[byte], what: str) {
    assert(v.kind == kind, "{what}: kind {v.kind}, want {kind}")
    assert(same(v.bytes, want), "{what}: bytes")
}

fn held(mut r: text.Registers, name: int) -> text.RegVal {
    let v = text.reg_get(mut r, name) else {
        assert(false, "register {name} exists")
        return text.regval_new()
    }
    v
}

fn bound(mut r: text.Registers, name: int, ec: text.EditCtx) -> text.RegVal {
    let v = text.reg_get_in(mut r, name, ec) else {
        assert(false, "register {name} exists")
        return text.regval_new()
    }
    v
}

fn exists(mut r: text.Registers, name: int) -> bool {
    let _ = text.reg_get(mut r, name) else {
        return false
    }
    true
}

fn with_nul(s: str) -> List[byte] {
    var v = bytes_of(s)
    (mut v).push(0 as byte)
    v
}

fn register_defaults_and_empty_deferred_slots() {
    var r = text.reg_new()
    assert(r.ring_depth == 32, "ring depth 32")
    assert(r.ring_bytes_max == 8388608, "ring cap 8 MiB")
    assert(r.clipboard_sync == text.CLIP_SYNC_YANK, "sync yank")
    assert(held(mut r, '/' as int).bytes.len == 0, "/ empty")
    assert(held(mut r, ':' as int).bytes.len == 0, ": empty")
    assert(held(mut r, '#' as int).bytes.len == 0, "# empty")
    assert(!exists(mut r, '_' as int), "_ is no register")
    assert(!exists(mut r, '?' as int), "? is no register")
    assert(text.reg_slot('*' as int) == text.reg_slot('+' as int), "* is +")
    text.reg_set_cmdline(mut r, bytes_of("write"))
    assert_value(held(mut r, ':' as int), text.REG_CHARWISE, bytes_of("write"), ":")
    text.reg_free(mut r)
}

fn register_computes_last_insert_and_current_path_on_read() {
    var inserted = List[byte]()
    (mut inserted).push('a' as int as byte)
    (mut inserted).push(0 as byte)
    (mut inserted).push('b' as int as byte)
    let path = "/tmp/yew-current-path"
    var r = text.reg_new()
    let tb = text.textbuf_new()
    let undo = text.undo_new(tb)
    var ec = text.editctx_new(take tb)
    ec.cset = text.cset_init(text.cursor_at(text.byteoff(0)))
    ec.has_cset = true
    ec.undo = undo
    ec.has_undo = true
    ec.win_id = 1
    assert(text.edit_insert(mut ec, text.byteoff(0), inserted), "insert")
    assert(text.edit_delete(mut ec, text.span(2, 3)), "delete")
    var meta = text.filemeta_new()
    meta.realpath = path
    meta.has_realpath = true
    ec.meta = meta
    ec.has_meta = true
    assert_value(bound(mut r, '.' as int, ec), text.REG_CHARWISE, inserted, ".")
    assert_value(bound(mut r, '%' as int, ec), text.REG_CHARWISE, bytes_of(path), "%")
    assert(held(mut r, '.' as int).bytes.len == 0, "unbound . is empty")
    assert(held(mut r, '%' as int).bytes.len == 0, "unbound % is empty")
    text.reg_free(mut r)
}

fn register_last_insert_reflects_backspace_in_type_run() {
    var r = text.reg_new()
    let tb = text.textbuf_from_str("--")
    let undo = text.undo_new(tb)
    var ec = text.editctx_new(take tb)
    ec.undo = undo
    ec.has_undo = true
    ec.win_id = 1
    text.undo_begin(mut ec, text.TXN_TYPE)
    assert(text.edit_insert_str(mut ec, text.byteoff(1), "abc"), "abc")
    assert(text.edit_delete(mut ec, text.span(2, 3)), "backspace")
    assert(text.edit_insert_str(mut ec, text.byteoff(2), "X"), "X")
    assert(text.edit_delete(mut ec, text.span(0, 2)), "delete")
    text.undo_end(mut ec)
    assert_value(bound(mut r, '.' as int, ec), text.REG_CHARWISE, bytes_of("Xc"), ".")
    text.reg_free(mut r)
}

fn register_yank_routes_named_unnamed_zero_and_ring() {
    var r = text.reg_new()
    r.clipboard_sync = text.CLIP_SYNC_OFF
    let v = value_of(text.REG_CHARWISE, with_nul("yank"))
    text.reg_yank(mut r, 'b' as int, v)
    assert_value(held(mut r, 'b' as int), text.REG_CHARWISE, with_nul("yank"), "b")
    assert_value(held(mut r, '"' as int), text.REG_CHARWISE, with_nul("yank"), "unnamed")
    assert_value(held(mut r, '0' as int), text.REG_CHARWISE, with_nul("yank"), "0")
    assert(r.ring_len == 1, "one ring entry")
    assert_value(r.ring[r.ring_head], text.REG_CHARWISE, with_nul("yank"), "ring head")
    assert(held(mut r, '1' as int).bytes.len == 0, "1 empty")
    assert(held(mut r, '-' as int).bytes.len == 0, "- empty")
    text.reg_free(mut r)
}

fn register_delete_shift_boundary() {
    var r = text.reg_new()
    let small = value(text.REG_CHARWISE, "x")
    let lf = value(text.REG_CHARWISE, "x\ny")
    let line = value(text.REG_LINEWISE, "line")
    text.reg_delete(mut r, 0, small)
    assert_value(r.small_del, text.REG_CHARWISE, bytes_of("x"), "-")
    assert(r.numbered[1].bytes.len == 0, "1 empty")
    text.reg_delete(mut r, 0, lf)
    assert_value(r.numbered[1], text.REG_CHARWISE, bytes_of("x\ny"), "1 holds the newline")
    text.reg_delete(mut r, 0, line)
    assert_value(r.numbered[1], text.REG_LINEWISE, bytes_of("line"), "1 linewise")
    assert_value(r.numbered[2], text.REG_CHARWISE, bytes_of("x\ny"), "2 shifted")
    assert_value(r.unnamed, text.REG_LINEWISE, bytes_of("line"), "unnamed")
    assert(r.numbered[0].bytes.len == 0, "0 empty")
    assert(r.ring_len == 3, "three ring entries")
    text.reg_free(mut r)
}

fn register_blockwise_short_delete_uses_small_delete() {
    var r = text.reg_new()
    r.clipboard_sync = text.CLIP_SYNC_OFF
    var block = value(text.REG_BLOCKWISE, "abc")
    block.width = 8
    block.ragged = true
    (mut block.rows).push(text.span(0, 1))
    (mut block.rows).push(text.span(1, 2))
    (mut block.rows).push(text.span(2, 3))
    text.reg_delete(mut r, 0, block)
    assert_value(r.small_del, text.REG_BLOCKWISE, bytes_of("abc"), "-")
    assert(r.small_del.rows.len == 3, "three rows")
    assert(r.numbered[1].bytes.len == 0, "1 empty")
    text.reg_free(mut r)
}

fn register_reserved_histories_ignore_explicit_names() {
    var r = text.reg_new()
    r.clipboard_sync = text.CLIP_SYNC_OFF
    let keep_zero = value(text.REG_CHARWISE, "zero")
    let keep_one = value(text.REG_CHARWISE, "one")
    let replacement = value(text.REG_CHARWISE, "replacement")
    r.numbered[0] = copy keep_zero
    r.numbered[1] = copy keep_one
    text.reg_delete(mut r, '0' as int, replacement)
    assert_value(r.numbered[0], text.REG_CHARWISE, bytes_of("zero"), "0 kept")
    text.reg_yank(mut r, '1' as int, replacement)
    assert_value(r.numbered[1], text.REG_CHARWISE, bytes_of("one"), "1 kept")
    assert_value(r.numbered[0], text.REG_CHARWISE, bytes_of("replacement"), "0 is the yank")
    text.reg_free(mut r)
}

fn register_delete_shifts_nine_and_discards_oldest() {
    var r = text.reg_new()
    var v = value(text.REG_LINEWISE, "")
    var i = 1
    while i <= 10 {
        var b = List[byte]()
        (mut b).push(('a' as int + i - 1) as byte)
        v.bytes = b
        text.reg_delete(mut r, 0, v)
        i += 1
    }
    assert(r.numbered[1].bytes[0] as int == 'j' as int, "1 is j")
    assert(r.numbered[2].bytes[0] as int == 'i' as int, "2 is i")
    assert(r.numbered[9].bytes[0] as int == 'b' as int, "9 is b")
    text.reg_free(mut r)
}

fn register_blackhole_is_total_discard() {
    var r = text.reg_new()
    r.clipboard_sync = text.CLIP_SYNC_OFF
    let keep = value(text.REG_CHARWISE, "keep")
    let drop = value(text.REG_LINEWISE, "drop\n")
    text.reg_yank(mut r, 0, keep)
    text.reg_delete(mut r, '_' as int, drop)
    assert_value(r.unnamed, text.REG_CHARWISE, bytes_of("keep"), "unnamed")
    assert_value(r.numbered[0], text.REG_CHARWISE, bytes_of("keep"), "0")
    assert(r.numbered[1].bytes.len == 0, "1 empty")
    assert(r.small_del.bytes.len == 0, "- empty")
    assert(r.ring_len == 1, "one ring entry")
    text.reg_yank(mut r, '_' as int, drop)
    assert(r.ring_len == 1, "still one")
    text.reg_free(mut r)
}

fn register_uppercase_routes_append_but_unnamed_is_new_value() {
    var r = text.reg_new()
    r.clipboard_sync = text.CLIP_SYNC_OFF
    let one = value(text.REG_CHARWISE, "one")
    let two = value(text.REG_CHARWISE, "two")
    text.reg_yank(mut r, 'a' as int, one)
    text.reg_yank(mut r, 'A' as int, two)
    assert_value(r.named[0], text.REG_CHARWISE, bytes_of("onetwo"), "a appended")
    assert_value(r.unnamed, text.REG_CHARWISE, bytes_of("two"), "unnamed is new")
    assert_value(r.numbered[0], text.REG_CHARWISE, bytes_of("two"), "0 is new")
    assert(r.ring_len == 2, "two ring entries")
    text.reg_free(mut r)
}

fn register_line_capture_synthesizes_only_missing_eol() {
    let tb = text.textbuf_from_str("abc")
    var meta = text.filemeta_new()
    meta.eol = text.EOL_CRLF
    meta.dominant_eol = text.EOL_CRLF
    let line = text.regval_from_span(tb, text.span(0, 3), text.REG_LINEWISE, meta, true)
    let chars = text.regval_from_span(tb, text.span(0, 3), text.REG_CHARWISE, meta, true)
    assert_value(line, text.REG_LINEWISE, bytes_of("abc\r\n"), "line gets CRLF")
    assert_value(chars, text.REG_CHARWISE, bytes_of("abc"), "chars unchanged")
}

fn register_accepts_explicit_blockwise_values() {
    var r = text.reg_new()
    var block = value(text.REG_BLOCKWISE, "ab\nZ")
    block.width = 2
    block.ragged = true
    (mut block.rows).push(text.span(0, 2))
    (mut block.rows).push(text.span(3, 4))
    text.reg_set_macro(mut r, 'a' as int, block, false)
    let stored = held(mut r, 'a' as int)
    assert_value(stored, text.REG_BLOCKWISE, bytes_of("ab\nZ"), "a")
    assert(stored.width == 2, "width 2")
    assert(stored.ragged, "ragged")
    assert(stored.rows.len == 2, "two rows")
    assert(stored.rows[0].lo == 0 && stored.rows[0].hi == 2, "row 0")
    assert(stored.rows[1].lo == 3 && stored.rows[1].hi == 4, "row 1")
    text.reg_free(mut r)
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    register_defaults_and_empty_deferred_slots()
    register_computes_last_insert_and_current_path_on_read()
    register_last_insert_reflects_backspace_in_type_run()
    register_yank_routes_named_unnamed_zero_and_ring()
    register_delete_shift_boundary()
    register_blockwise_short_delete_uses_small_delete()
    register_reserved_histories_ignore_explicit_names()
    register_delete_shifts_nine_and_discards_oldest()
    register_blackhole_is_total_discard()
    register_uppercase_routes_append_but_unnamed_is_new_value()
    register_line_capture_synthesizes_only_missing_eol()
    register_accepts_explicit_blockwise_values()
    print("register_test: 12 cases pass")
}
