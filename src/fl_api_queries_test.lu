//! member: false
//! yw09 query-seam regressions, independently expected from sagitta
//! 9ace98c2 src/fl/flapi.c:198-995. These do not replace its attached
//! test_fl_api_complete / marshal suites. No oracle fixture is changed.

use edit
use fl
use search
use text

struct Fixture { vm: fl.FlVm, ed: edit.Ed, seen: Map[int, bool] }

fn fixture(bytes: List[byte]) -> Fixture {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.bufs[0].ec.tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    ed.bufs[0].ec.undo = text.undo_new(ed.bufs[0].ec.tb)
    text.undo_mark_saved(mut ed.bufs[0].ec.undo, ed.bufs[0].ec.tb)
    Fixture { vm: vm, ed: ed, seen: Map[int, bool]() }
}

fn call(mut f: Fixture, kind: int, args: List[fl.FlValue]) -> fl.FlValue {
    let desc = fl.fl_api_desc(kind) else { assert(false); return fl.fl_nil() }
    f.vm.cur_native = fl.fl_intern(mut f.vm.strings, desc.fl_name.bytes(), 0, desc.fl_name.len)
    f.vm.sp = args.len
    for i in 0..args.len { f.vm.stack[i] = copy args[i] }
    f.seen[kind] = true
    edit.fl_api_query(mut f.vm, mut f.ed, kind, 0, args.len) else {
        assert(false, "query owner missing {kind}")
        fl.fl_nil()
    }
}

fn q(mut f: Fixture, kind: int, args: List[fl.FlValue]) -> fl.FlValue {
    f.vm.raised = false
    f.vm.err = fl.fl_nil()
    call(mut f, kind, args)
}

fn bytes_eq(vm: fl.FlVm, value: fl.FlValue, want: List[byte]) {
    assert(value.t == fl.FL_STR)
    let at = fl.fl_obj_index(vm, value)
    assert(vm.gc.slots[at].bytes.len == want.len)
    for i in 0..want.len { assert(vm.gc.slots[at].bytes[i] == want[i]) }
}

fn field(mut vm: fl.FlVm, value: fl.FlValue, name: str) -> fl.FlValue {
    let key = fl.fl_str_text(mut vm, name)
    fl.fl_map_get(vm, value, key) else { assert(false, "missing field {name}"); fl.fl_nil() }
}

fn err(mut f: Fixture, kind: str, msg: str) {
    assert(f.vm.raised)
    let error = copy f.vm.err
    let k = field(mut f.vm, error, "kind")
    bytes_eq(f.vm, k, kind.bytes())
    let m = field(mut f.vm, error, "msg")
    bytes_eq(f.vm, m, msg.bytes())
}

fn keys(vm: fl.FlVm, value: fl.FlValue) -> str {
    var out = ""
    var cursor = 0
    loop {
        let (next, key, _) = fl.fl_map_iter(vm, value, cursor) else { break }
        cursor = next
        assert(key.t == fl.FL_STR)
        if out.len != 0 { out += "," }
        out += str_from_utf8(vm.gc.slots[fl.fl_obj_index(vm, key)].bytes) else "?"
    }
    out
}

fn repr(mut vm: fl.FlVm, value: fl.FlValue) -> str {
    var out = List[byte]()
    assert(fl.fl_fmt_repr(mut vm, mut out, value))
    str_from_utf8(out) else { assert(false); "" }
}

fn t_binary_buffer_and_ranges() {
    var f = fixture([128 as byte, 97 as byte, 13 as byte, 10 as byte, 98 as byte, 0 as byte])
    let b = q(mut f, 8000, [])
    assert(!f.vm.raised && b.t == fl.FL_BUF)
    let all = q(mut f, 8001, [])
    assert(fl.fl_list_len(f.vm, all) == 1)
    assert((fl.fl_list_get(f.vm, all, 0) else fl.fl_nil()).i == b.i)
    assert(q(mut f, 8005, [copy b]).t == fl.FL_NIL)
    let label = q(mut f, 8006, [copy b])
    bytes_eq(f.vm, label, "[No Name]".bytes())
    assert(q(mut f, 8007, [copy b]).t == fl.FL_NIL)
    let id = f.ed.bufs[0].id
    f.ed.buf_languages[id] = "fletch"
    let lang = q(mut f, 8007, [copy b])
    bytes_eq(f.vm, lang, "fletch".bytes())
    assert(q(mut f, 8008, [copy b]).i == 6 && q(mut f, 8009, [copy b]).i == 2)
    let whole = q(mut f, 8010, [copy b])
    bytes_eq(f.vm, whole, [128 as byte, 97 as byte, 13 as byte, 10 as byte, 98 as byte, 0 as byte])
    let first = q(mut f, 8011, [copy b, fl.fl_int(1)])
    bytes_eq(f.vm, first, [128 as byte, 97 as byte])
    let second = q(mut f, 8011, [copy b, fl.fl_int(2)])
    bytes_eq(f.vm, second, [98 as byte, 0 as byte])
    let line = q(mut f, 8013, [copy b, fl.fl_int(1)])
    let line_text = q(mut f, 8010, [copy b, line])
    bytes_eq(f.vm, line_text, [128 as byte, 97 as byte, 13 as byte, 10 as byte])
    let span = q(mut f, 8012, [copy b, fl.fl_int(1), fl.fl_int(5)])
    assert(
        q(mut f, 11000, [copy span]).i == 1 &&
            q(mut f, 11001, [copy span]).i == 5 &&
            q(mut f, 11002, [copy span]).i == 4,
    )
    let span_text = q(mut f, 11003, [copy span])
    bytes_eq(f.vm, span_text, "a\r\nb".bytes())
    let lines = q(mut f, 11004, [copy span])
    assert(fl.fl_list_len(f.vm, lines) == 2)
    let one = fl.fl_list_get(f.vm, lines, 0) else fl.fl_nil()
    bytes_eq(f.vm, one, "a".bytes())
    let two = fl.fl_list_get(f.vm, lines, 1) else fl.fl_nil()
    bytes_eq(f.vm, two, "b".bytes())
    assert(q(mut f, 11011, [copy span]).i == 1)
    let mark = q(mut f, 8023, [copy b, fl.fl_int(6)])
    assert(q(mut f, 11002, [mark]).i == 0)
    assert(
        q(mut f, 8018, [copy b]).i == 0 &&
            q(mut f, 8019, [copy b]).i == 0 &&
            q(mut f, 8020, [copy b]).i == 0,
    )
    f.ed.bufs[0].flags = edit.BUF_READONLY
    assert(q(mut f, 8019, [copy b]).i == 1)
    let _ = q(mut f, 8011, [copy b, fl.fl_int(0)])
    err(mut f, "range", "line 0 is outside the buffer")
    let _ = q(mut f, 8012, [copy b, fl.fl_int(4), fl.fl_int(3)])
    err(mut f, "range", "invalid byte span")
    let _ = q(mut f, 8023, [copy b, fl.fl_int(7)])
    err(mut f, "range", "mark offset is outside the buffer")
    for k in [
        8000,
        8001,
        8005,
        8006,
        8007,
        8008,
        8009,
        8010,
        8011,
        8012,
        8013,
        8018,
        8019,
        8020,
        8023,
        11000,
        11001,
        11002,
        11003,
        11004,
        11011,
    ] { assert(f.seen[k] else false) }
    f.ed.bufs[0].flags = 0
    edit.ed_undo_begin(mut f.ed, 0, text.TXN_MACRO)
    assert(edit.ed_edit_insert(mut f.ed, 0, 0, "z".bytes(), 0, 1))
    edit.ed_undo_end(mut f.ed, 0)
    assert(q(mut f, 8018, [copy b]).i == 1 && q(mut f, 8020, [copy b]).i == 1)
}

fn t_handles_canonical_and_cross_buffer_errors() {
    var f = fixture("abc".bytes())
    let b = q(mut f, 8000, [])
    let s = q(mut f, 8012, [copy b, fl.fl_int(0), fl.fl_int(2)])
    let count = f.ed.handles.live
    for _ in 0..100 {
        assert(q(mut f, 8000, []).i == b.i)
        assert(q(mut f, 8012, [copy b, fl.fl_int(0), fl.fl_int(2)]).i == s.i)
    }
    assert(f.ed.handles.live == count)
    edit.ed_open_memory(mut f.ed, "other".bytes(), "other")
    let other = q(mut f, 8000, [])
    let _ = q(mut f, 8010, [copy other, copy s])
    err(mut f, "range", "span belongs to another buffer")
    assert(edit.fl_h_free(mut f.ed, s))
    assert(q(mut f, 11011, [copy s]).i == 0 && !f.vm.raised)
    let _ = q(mut f, 11003, [copy s])
    err(mut f, "handle", "this span handle is closed")
    // A closed buffer keeps its physical slot with id 0 (the stable-id form of
    // C removing it from the workspace array). buf.list skips the slot rather
    // than listing nil, and the live order is the surviving slots in order.
    let both = q(mut f, 8001, [])
    assert(fl.fl_list_len(f.vm, both) == 2)
    f.ed.bufs[0].id = 0
    let live = q(mut f, 8001, [])
    assert(!f.vm.raised && fl.fl_list_len(f.vm, live) == 1)
    let only = fl.fl_list_get(f.vm, live, 0) else fl.fl_nil()
    assert(only.t == fl.FL_BUF && only.i == other.i)
    let only_name = q(mut f, 8006, [only])
    bytes_eq(f.vm, only_name, "other".bytes())
    f.ed.bufs[1].id = 0
    let none = q(mut f, 8001, [])
    assert(!f.vm.raised && fl.fl_list_len(f.vm, none) == 0)
}

fn t_cursor_and_viewport() {
    var f = fixture("éz\nword\n".bytes())
    let b = q(mut f, 8000, [])
    let w = q(mut f, 9000, [])
    assert(q(mut f, 9002, [copy w]).i == b.i)
    let windows = q(mut f, 9001, [])
    assert(fl.fl_list_len(f.vm, windows) == 1)
    let cursors = q(mut f, 9003, [copy w])
    assert(fl.fl_list_len(f.vm, cursors) == 1)
    let c = fl.fl_list_get(f.vm, cursors, 0) else fl.fl_nil()
    f.ed.wins[0].cs.curs[0].pos = 2
    f.ed.wins[0].cs.curs[0].anchor = 0
    assert(q(mut f, 10000, [copy c]).i == 2 && q(mut f, 10001, [copy c]).i == 1)
    assert(q(mut f, 10002, [copy c]).i == 1 && q(mut f, 10003, [copy c]).i == 0)
    let span = q(mut f, 10004, [copy c])
    let selected = q(mut f, 9004, [copy w])
    assert(span.i == selected.i)
    let value = q(mut f, 11003, [copy span])
    bytes_eq(f.vm, value, "é".bytes())
    assert(q(mut f, 10010, [copy c]).i == 1 && q(mut f, 10011, [copy c]).i == 1)
    let line = q(mut f, 10008, [copy c])
    let line_value = q(mut f, 11003, [line])
    bytes_eq(f.vm, line_value, "éz\n".bytes())
    f.ed.wins[0].cs.curs[0].pos = 5
    f.ed.wins[0].cs.curs[0].anchor = 5
    let word = q(mut f, 10007, [copy c])
    let word_value = q(mut f, 11003, [word])
    bytes_eq(f.vm, word_value, "word".bytes())
    assert(q(mut f, 10004, [copy c]).t == fl.FL_NIL && q(mut f, 9004, [copy w]).t == fl.FL_NIL)
    f.ed.wins[0].vp.top = 1
    f.ed.wins[0].vp.rows = 20
    f.ed.wins[0].vp.cols = 72
    let vp = q(mut f, 9008, [copy w])
    assert(field(mut f.vm, vp, "top").i == 2)
    assert(field(mut f.vm, vp, "rows").i == 20 && field(mut f.vm, vp, "cols").i == 72)
    assert(edit.fl_h_free(mut f.ed, c))
    let saved = fl.fl_raise(mut f.vm, "user", "preserve")
    let _ = saved
    let before = copy f.vm.err
    f.vm.raised = false
    let valid = call(mut f, 10011, [copy c])
    assert(valid.i == 0 && !f.vm.raised && f.vm.err.i == before.i)
    f.vm.raised = true
    let valid_again = call(mut f, 10011, [copy c])
    assert(valid_again.i == 0 && f.vm.raised && f.vm.err.i == before.i)
    for k in [
        9000,
        9001,
        9002,
        9003,
        9004,
        9008,
        10000,
        10001,
        10002,
        10003,
        10004,
        10007,
        10008,
        10010,
        10011,
    ] { assert(f.seen[k] else false) }
}

fn t_regex_search_and_empty_progress() {
    var f = fixture("aba".bytes())
    let b = q(mut f, 8000, [])
    var error = search.re_err_new()
    let re = search.re_compile_str("a", 0, mut error) else { assert(false); return }
    let rh = edit.fl_h_re_make(mut f.ed, take re)
    let first = q(mut f, 8016, [copy b, copy rh])
    assert(q(mut f, 11000, [first]).i == 0)
    let last = q(mut f, 8016, [copy b, copy rh, fl.fl_int(1)])
    assert(q(mut f, 11000, [last]).i == 2)
    assert(q(mut f, 8016, [copy b, copy rh, fl.fl_int(3)]).t == fl.FL_NIL)
    let all = q(mut f, 8017, [copy b, copy rh])
    assert(fl.fl_list_len(f.vm, all) == 2)
    let _ = q(mut f, 8016, [copy b, copy rh, fl.fl_int(-1)])
    err(mut f, "range", "find offset is outside the buffer")
    let empty_re = search.re_empty()
    let empty = edit.fl_h_re_make(mut f.ed, take empty_re)
    let every = q(mut f, 8017, [copy b, empty])
    assert(fl.fl_list_len(f.vm, every) == 4)
    for i in 0..4 {
        let span = fl.fl_list_get(f.vm, every, i) else fl.fl_nil()
        assert(q(mut f, 11000, [copy span]).i == i && q(mut f, 11002, [copy span]).i == 0)
    }
    // Pinned q_buf_find_all advances by hi when hi > the previous search
    // start. An end-only empty match therefore appears twice, unlike stdre.
    let end_re = search.re_compile_str("$", 0, mut error) else { assert(false); return }
    let end_handle = edit.fl_h_re_make(mut f.ed, take end_re)
    let ends = q(mut f, 8017, [copy b, end_handle])
    assert(fl.fl_list_len(f.vm, ends) == 2)
    let a = fl.fl_list_get(f.vm, ends, 0) else fl.fl_nil()
    let z = fl.fl_list_get(f.vm, ends, 1) else fl.fl_nil()
    assert(a.i == z.i && q(mut f, 11000, [a]).i == 3)
}

fn t_workspace_order_and_gc_roots() {
    var f = fixture("x".bytes())
    f.ed.panes[f.ed.pane_root].rect = edit.rect(2, 3, 40, 12)
    let clone = edit.ed_win_clone(mut f.ed, 0)
    let leaf = edit.pane_new_leaf(mut f.ed, clone)
    let bid = f.ed.bufs[0].id
    (mut f.ed.tabs).push(edit.tab_value(2, bid, leaf, "/tmp/second", "second"))
    let group = edit.group_create(mut f.ed, "/tmp/project", "project")
    edit.group_add_member(mut f.ed, group, 0)
    edit.group_add_member(mut f.ed, group, 1)
    let value = q(mut f, 13007, [])
    let held = fl.fl_temp_push(mut f.vm, value)
    fl.fl_gc_collect(mut f.vm)
    let kept = fl.fl_temp_get(f.vm, held)
    assert(keys(f.vm, kept) == "active_tab,tabs,groups")
    assert(field(mut f.vm, kept, "active_tab").i == 1)
    let tabs = field(mut f.vm, kept, "tabs")
    assert(fl.fl_list_len(f.vm, tabs) == 2)
    let first = fl.fl_list_get(f.vm, tabs, 0) else fl.fl_nil()
    let second = fl.fl_list_get(f.vm, tabs, 1) else fl.fl_nil()
    assert(keys(f.vm, first) == "id,path,active,group_id,group,ordinal,panes")
    assert(field(mut f.vm, first, "id").i == 1 && field(mut f.vm, second, "id").i == 2)
    assert(field(mut f.vm, first, "path").t == fl.FL_NIL)
    let path = field(mut f.vm, second, "path")
    bytes_eq(f.vm, path, "/tmp/second".bytes())
    let panes = field(mut f.vm, first, "panes")
    let pane = fl.fl_list_get(f.vm, panes, 0) else fl.fl_nil()
    assert(keys(f.vm, pane) == "x,y,w,h")
    assert(field(mut f.vm, pane, "x").i == 2 && field(mut f.vm, pane, "w").i == 40)
    let groups = field(mut f.vm, kept, "groups")
    assert(fl.fl_list_len(f.vm, groups) == 1)
    let g = fl.fl_list_get(f.vm, groups, 0) else fl.fl_nil()
    assert(field(mut f.vm, g, "members").i == 2)
    assert(keys(f.vm, g) == "id,name,dir,members")
    let before = repr(mut f.vm, kept)
    let next = q(mut f, 13007, [])
    assert(repr(mut f.vm, next) == before)
    fl.fl_temp_pop(mut f.vm, 1)
    let windows = q(mut f, 9001, [])
    assert(fl.fl_list_len(f.vm, windows) == 2)
}

fn t_editor_mode_and_named_registers() {
    var f = fixture("".bytes())
    let mode = q(mut f, 13003, [])
    bytes_eq(f.vm, mode, "L".bytes())
    f.ed.mode = edit.MODE_I
    let insert_mode = q(mut f, 13003, [])
    bytes_eq(f.vm, insert_mode, "I".bytes())
    f.ed.mode = edit.MODE_N
    let _ = q(mut f, 13003, [])
    err(mut f, "handle", "editor mode is invalid")
    let name = fl.fl_str_text(mut f.vm, "a")
    assert(q(mut f, 13005, [copy name]).t == fl.FL_NIL)
    f.ed.regs.named[0].bytes = [97 as byte, 0 as byte, 128 as byte]
    let value = q(mut f, 13005, [copy name])
    bytes_eq(f.vm, value, [97 as byte, 0 as byte, 128 as byte])
    let upper = fl.fl_str_text(mut f.vm, "A")
    let upper_value = q(mut f, 13005, [upper])
    bytes_eq(f.vm, upper_value, [97 as byte, 0 as byte, 128 as byte])
    let invalid = fl.fl_str_text(mut f.vm, "0")
    let _ = q(mut f, 13005, [invalid])
    err(mut f, "type", "ed.register expects one letter a-z/A-Z")
    let unowned = edit.fl_api_query(mut f.vm, mut f.ed, 13002, 0, 0) else fl.fl_int(99)
    assert(unowned.i == 99)
}

fn t_deferred_and_absent_views() {
    var f = fixture("".bytes())
    let b = q(mut f, 8000, [])
    assert(q(mut f, 8009, [copy b]).i == 1)
    f.ed.bufs[0].resident = false
    assert(q(mut f, 8008, [copy b]).i == 0 && q(mut f, 8009, [copy b]).i == 0)
    let _ = q(mut f, 8011, [copy b, fl.fl_int(1)])
    err(mut f, "range", "line 1 is outside the buffer")
    let _ = q(mut f, 8010, [copy b])
    err(mut f, "range", "buffer span is outside the text")
    f.ed.bufs[0].resident = true
    let wrong = fl.fl_str_text(mut f.vm, "one")
    let _ = q(mut f, 8011, [copy b, wrong])
    err(mut f, "type", "buf.line: argument 2 must be int, found str")
    (mut f.ed.tabs).reset()
    let only = q(mut f, 9001, [])
    assert(fl.fl_list_len(f.vm, only) == 1)
    f.ed.win = -1
    let absent = q(mut f, 9001, [])
    assert(fl.fl_list_len(f.vm, absent) == 0)
    let _ = q(mut f, 9000, [])
    err(mut f, "handle", "no current window")
    f.ed = edit.ed_new()
    let _ = q(mut f, 8000, [])
    err(mut f, "handle", "no current buffer")
}

fn main() {
    t_binary_buffer_and_ranges()
    t_handles_canonical_and_cross_buffer_errors()
    t_cursor_and_viewport()
    t_regex_search_and_empty_progress()
    t_workspace_order_and_gc_roots()
    t_editor_mode_and_named_registers()
    t_deferred_and_absent_views()
    print("editor query seam: seven regression groups PASS")
}
