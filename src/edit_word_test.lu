//! member: false
//!
//! The port of sagitta `tests/unit/test_word.c` (158 lines), one test per
//! C test in registry order (`tests/unit/registry.c:815-817`). C calls
//! `yew_unit_word.next` (the `UnitOps` table); the port calls the W arm
//! of the unit `match`, `edit.unit_next(edit.UNIT_WORD, …)`, with C's
//! `{tb, NULL, NULL}` context (`edit.unitctx_text()`, no window).

use edit
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn ints(xs: str) -> List[int] {
    var out = List[int]()
    for w in xs.words() {
        let n = w.to_int() else -1
        assert(n >= 0, "a stop")
        (mut out).push(n)
    }
    out
}

// `assert_motion_case` (`test_word.c:18-36`): `next` from each stop lands
// on the following stop, a grapheme boundary.
fn assert_motion_case(bytes: List[byte], stops: List[int], alt: bool, what: str) {
    var tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    let u = edit.unitctx_text()
    let w = edit.win_detached()
    assert(stops.len >= 2, "{what}: two stops")
    assert(stops[0] == 0, "{what}: starts at 0")
    assert(stops[stops.len - 1] == bytes.len, "{what}: ends at the length")
    var i = 1
    while i < stops.len {
        let next = edit.unit_next(edit.UNIT_WORD, mut tb, u, w, stops[i - 1], alt)
        assert(next == stops[i], "{what}: next from {stops[i - 1]} is {next}, want {stops[i]}")
        assert(text.is_grapheme_boundary(tb, next as text.ByteOff), "{what}: {next} is a boundary")
        i += 1
    }
}

fn assert_case(s: str, stops: str, what: str) {
    assert_motion_case(bytes_of(s), ints(stops), false, what)
}

// `test_word_motion_reference_rows` (`test_word.c:38-83`).
fn t_word_motion_reference_rows() {
    assert_case("foo.bar()", "0 3 4 7 8 9", "punct")
    assert_case("a  b", "0 3 4", "spaces")
    assert_case("\n\n", "0 1 2", "blank")
    assert_case("\u{6F22}\u{5B57}\u{30C6}\u{30B9}\u{30C8}", "0 3 6 15", "cjk")
    assert_case("\u{6F22}\u{5B57}", "0 3 6", "han")
    assert_case("\u{30C6}\u{30B9}\u{30C8}", "0 9", "katakana")
    assert_case("\u{C548}\u{B155}\u{D558}\u{C138}\u{C694}", "0 15", "hangul")
    assert_case(
        "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}x",
        "0 25 26",
        "family",
    )
    assert_case("\u{1F1E6}\u{1F1FA}\u{1F1E6}\u{1F1FA}", "0 8 16", "flags")
    assert_case("don't", "0 5", "apostrophe")
    assert_case("well-known", "0 4 5 10", "hyphen")
    assert_case("1,000.50", "0 8", "number")
    var invalid = List[byte]()
    (mut invalid).push(255 as byte)
    (mut invalid).push(65 as byte)
    assert_motion_case(invalid, ints("0 1 2"), false, "invalid")
}

// `test_word_motion_word_variant` (`test_word.c:85-112`).
fn t_word_motion_word_variant() {
    let s = "foo.bar  baz-qux\nzap"
    assert_motion_case(bytes_of(s), ints("0 9 17 20"), true, "WORD")
    var tb = text.textbuf_from_str(s)
    let u = edit.unitctx_text()
    let w = edit.win_detached()
    let sp = edit.unit_span(edit.UNIT_WORD, mut tb, u, 3, true)
    assert(sp.lo == 0 && sp.hi == 7, "WORD span at 3 is [{sp.lo}, {sp.hi}), want [0, 7)")
    var at = edit.unit_prev(edit.UNIT_WORD, mut tb, u, w, 20, true)
    assert(at == 17, "WORD prev from 20 is {at}, want 17")
    at = edit.unit_prev(edit.UNIT_WORD, mut tb, u, w, at, true)
    assert(at == 9, "WORD prev is {at}, want 9")
    at = edit.unit_prev(edit.UNIT_WORD, mut tb, u, w, at, true)
    assert(at == 0, "WORD prev is {at}, want 0")
}

// `assert_subwords` (`test_word.c:114-138`): forward from each stop, then
// back from each stop.
fn assert_subwords(s: str, stops_text: str) {
    var tb = text.textbuf_from_str(s)
    let u = edit.unitctx_text()
    let stops = ints(stops_text)
    assert(stops.len >= 2, "{s}: two stops")
    assert(stops[0] == 0 && stops[stops.len - 1] == s.len, "{s}: stops span the text")
    var i = 1
    while i < stops.len {
        let next = edit.word_sub_next(tb, u, stops[i - 1])
        assert(next == stops[i], "{s}: sub_next from {stops[i - 1]} is {next}, want {stops[i]}")
        assert(text.is_grapheme_boundary(tb, next as text.ByteOff), "{s}: {next} is a boundary")
        i += 1
    }
    i = stops.len - 1
    while i > 0 {
        let prev = edit.word_sub_prev(mut tb, u, stops[i])
        assert(prev == stops[i - 1], "{s}: sub_prev from {stops[i]} is {prev}, want {stops[i - 1]}")
        assert(text.is_grapheme_boundary(tb, prev as text.ByteOff), "{s}: {prev} is a boundary")
        i -= 1
    }
}

// `test_word_subword_reference_rows` (`test_word.c:140-158`).
fn t_word_subword_reference_rows() {
    assert_subwords("fooBarBaz", "0 3 6 9")
    assert_subwords("HTTPServer", "0 4 10")
    assert_subwords("snake_case_x", "0 6 11 12")
    assert_subwords("kebab-case", "0 6 10")
    assert_subwords("v2Model3", "0 2 8")
    assert_subwords("__init__", "0 2 8")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_word_motion_reference_rows()
    t_word_motion_word_variant()
    t_word_subword_reference_rows()
    print("word_test: 3 cases pass")
}
