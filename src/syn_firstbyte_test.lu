//! member: false
//! Ports sagitta tests/unit/test_syn_firstbyte.c at 9ace98c2, one case per
//! C test in its order. The ini case reads tests/fixtures/syn/ini.fl, the
//! pin's runtime/syntax/ini.fl byte for byte. A probe whose byte is already
//! in the mask cannot fail the check, so the loops skip it; the verdicts
//! are the C test's.

use search
use syn
use text

fn bytes(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() { (mut out).push(b) }
    out
}

fn compiled(source: List[byte]) -> syn.SynDefinition {
    var c = syn.syn_compile("first.fl", source)
    assert(c.diagnostics.nerrors == 0, "the definition compiles")
    assert(c.diagnostics.nwarnings == 0, "the definition compiles without warnings")
    take c.definition
}

// A match of the rule's regex at offset 0 of `b` followed by one tail.
fn observed(def: syn.SynDefinition, rule: int, b: int) -> bool {
    let tails = ["", "a", "0", " ", "true", "=value", "]", "\"text\""]
    let backing = text.textbuf_new()
    var m = search.re_match_new()
    for t in 0..tails.len {
        var sample = List[byte]()
        (mut sample).push(b as byte)
        for c in tails[t].bytes() { (mut sample).push(c) }
        let hit = search.re_match_at(
            def.regexes[def.rules[rule].regex],
            backing,
            sample,
            search.re_input_bytes(sample.len),
            0 as text.ByteOff,
            mut m,
        )
        if hit then return true
    }
    false
}

// test_syn_firstbyte_ini_includes_every_observed_leading_byte
fn ini_includes_every_observed_leading_byte() {
    let source = fs_read_bytes("tests/fixtures/syn/ini.fl") else {
        assert(false, "ini fixture readable")
        return
    }
    let def = compiled(source)
    for rule in 0..def.rules.len {
        if def.rules[rule].regex > 0 {
            for b in 0..256 {
                if !syn.syn_first_has(def.rules[rule].first, b) {
                    assert(!observed(def, rule, b), "every observed leading byte is in the mask")
                }
            }
        }
    }
    let (ok, _, _) = syn.syn_firstbyte_check(def)
    assert(ok, "the shared self-check passes")
}

// test_syn_firstbyte_toy_definition_passes_the_shared_selfcheck
fn toy_definition_passes_the_shared_selfcheck() {
    var def = syn.syn_definition_new("toy")
    var main = syn.syn_context_new(0)
    main.nrules = 7
    var string = syn.syn_context_new(12)
    string.first_rule = 7
    string.nrules = 2
    var block = syn.syn_context_new(16)
    block.first_rule = 9
    block.nrules = 1
    var comment = syn.syn_context_new(16)
    comment.first_rule = 10
    (mut def.contexts).push(main)
    (mut def.contexts).push(string)
    (mut def.contexts).push(block)
    (mut def.contexts).push(comment)
    let patterns = [
        "//",
        "/\\*",
        "\"",
        "\\b(if|else|while|return)\\b",
        "[0-9]+",
        "\\b(true|false)\\b",
        "[+*/=-]+",
        "\\\\.",
        "\"",
        "\\*/",
    ]
    let firsts = ["/", "/", "\"", "iewr", "0123456789", "tf", "+*/=-", "\\", "\"", "*"]
    for i in 0..patterns.len {
        var err = search.re_err_new()
        let re = search.re_compile_str(patterns[i], 0, mut err) else {
            assert(false, "toy regex: {err.msg}")
            return
        }
        var r = syn.syn_rule_new(def.regexes.len, 0)
        r.first = syn.syn_first_new(false)
        for c in firsts[i].bytes() { syn.syn_first_add(mut r.first, c as int) }
        (mut def.regexes).push(re)
        (mut def.rules).push(r)
    }
    let (ok, bad_rule, bad_byte) = syn.syn_firstbyte_check(def)
    assert(ok, "the toy passes the shared self-check")
    assert(bad_rule == -1, "no bad rule reported")
    assert(bad_byte == -1, "no bad byte reported")
}

// test_syn_firstbyte_literal_class_utf8_and_icase_sets_are_safe
fn literal_class_utf8_and_icase_sets_are_safe() {
    let def = compiled(
        bytes(
            "{{ syntax: 1, language: {{ name: \"firsts\" }}, contexts: {{\n  main: {{ rules: [\n    {{ match: \"x\", icase: true }},\n    {{ match: \"[0-2]\" }},\n    {{ match: \"é\" }},\n    {{ match: \"^z\" }}\n  ] }}\n}} }}",
        ),
    )
    assert(def.rules.len == 4, "four rules")
    assert(syn.syn_first_has(def.rules[0].first, 120), "x")
    assert(syn.syn_first_has(def.rules[0].first, 88), "X under icase")
    assert(syn.syn_first_has(def.rules[1].first, 48), "0")
    assert(syn.syn_first_has(def.rules[1].first, 49), "1")
    assert(syn.syn_first_has(def.rules[1].first, 50), "2")
    assert(syn.syn_first_has(def.rules[2].first, 195), "the UTF-8 lead byte")
    for b in 0..256 { assert(syn.syn_first_has(def.rules[3].first, b), "an anchor keeps every byte") }
    let (ok, _, _) = syn.syn_firstbyte_check(def)
    assert(ok, "the shared self-check passes")
}

// test_syn_firstbyte_deliberate_narrowing_is_detected
fn deliberate_narrowing_is_detected() {
    var def = compiled(
        bytes("{{ syntax: 1, language: {{ name: \"narrow\" }}, contexts: {{\n  main: {{ rules: [{{ match: \"x\" }}] }}\n}} }}"),
    )
    assert(syn.syn_first_has(def.rules[0].first, 120), "x")
    let at = 120 >> 3
    def.rules[0].first[at] = (def.rules[0].first[at] as int & !(1 << (120 & 7))) as byte
    let (ok, bad_rule, bad_byte) = syn.syn_firstbyte_check(def)
    assert(!ok, "a narrowed mask is detected")
    assert(bad_rule == 0, "the narrowed rule")
    assert(bad_byte == 120, "the narrowed byte")
}

fn main() {
    let selected = (env_get("YEW_SYN_FIRSTBYTE_CASE") else "-1").to_int() else -1
    for i in 0..4 {
        if selected == -1 || selected == i {
            match i {
                0 => ini_includes_every_observed_leading_byte(),
                1 => toy_definition_passes_the_shared_selfcheck(),
                2 => literal_class_utf8_and_icase_sets_are_safe(),
                _ => deliberate_narrowing_is_detected(),
            }
            print("syn_firstbyte_case_{i}: PASS")
        }
    }
}
