//! member: false
//!
//! The port of sagitta `tests/unit/test_region.c` (147 lines), one test
//! per C test in registry order: the clickable-region registry (Sprint 22
//! §6) — last added wins, cleared at frame BEGIN, the empty query
//! counted, the fixed capacity, zero-area rects refused, the TAB payload
//! sign convention. C's registry is a file static; the port's is a value
//! (`edit.Regions`), so each test holds its own.

use edit

fn r(x: int, y: int, w: int, h: int) -> edit.Rect {
    edit.rect(x, y, w, h)
}

// `test_region_hit_finds_the_registered_rect` (`:16-38`): a half-open
// rect, Span's convention.
fn t_region_hit_finds_the_registered_rect() {
    var rs = edit.regions_new()
    edit.region_frame_begin(mut rs)
    edit.region_add(mut rs, edit.REGION_PANE, r(10, 5, 20, 8), 3)
    assert(edit.region_count(rs) == 1, "one region")
    let got = edit.region_hit(mut rs, 10, 5)
    assert(got.kind == edit.REGION_PANE && got.payload == 3, "the near corner")
    assert(edit.region_hit(mut rs, 29, 12).kind == edit.REGION_PANE, "the far corner is inside")
    assert(edit.region_hit(mut rs, 30, 12).kind == edit.REGION_NONE, "one past x")
    assert(edit.region_hit(mut rs, 29, 13).kind == edit.REGION_NONE, "one past y")
    assert(edit.region_hit(mut rs, 9, 5).kind == edit.REGION_NONE, "one before x")
}

// `test_region_last_added_wins_on_overlap` (`:41-55`).
fn t_region_last_added_wins_on_overlap() {
    var rs = edit.regions_new()
    edit.region_frame_begin(mut rs)
    edit.region_add(mut rs, edit.REGION_PANE, r(0, 0, 80, 24), 1)
    edit.region_add(mut rs, edit.REGION_BLOCK, r(10, 10, 20, 4), 0)
    assert(edit.region_hit(mut rs, 15, 11).kind == edit.REGION_BLOCK, "the overlay answers")
    let got = edit.region_hit(mut rs, 5, 5)
    assert(got.kind == edit.REGION_PANE && got.payload == 1, "outside it the pane does")
}

// `test_region_frame_begin_clears_the_table` (`:62-78`).
fn t_region_frame_begin_clears_the_table() {
    var rs = edit.regions_new()
    edit.region_frame_begin(mut rs)
    edit.region_add(mut rs, edit.REGION_PANE, r(0, 0, 80, 24), 7)
    assert(edit.region_hit(mut rs, 1, 1).kind == edit.REGION_PANE, "registered")
    edit.region_frame_begin(mut rs)
    assert(edit.region_count(rs) == 0, "cleared")
    let got = edit.region_hit(mut rs, 1, 1)
    assert(got.kind == edit.REGION_NONE && got.payload == 0, "a frame that drew nothing answers nothing")
}

// `test_region_empty_query_is_counted` (`:80-95`).
fn t_region_empty_query_is_counted() {
    var rs = edit.regions_new()
    edit.region_frame_begin(mut rs)
    let before = edit.region_empty_queries(rs)
    let _ = edit.region_hit(mut rs, 0, 0)
    assert(edit.region_empty_queries(rs) == before + 1, "counted")
    edit.region_add(mut rs, edit.REGION_PANE, r(0, 0, 4, 4), 0)
    let _ = edit.region_hit(mut rs, 0, 0)
    assert(edit.region_empty_queries(rs) == before + 1, "a populated table does not count")
}

// `test_region_capacity_drops_without_growing` (`:97-110`).
fn t_region_capacity_drops_without_growing() {
    var rs = edit.regions_new()
    edit.region_frame_begin(mut rs)
    var i = 0
    while i < edit.REGION_MAX + 50 {
        edit.region_add(mut rs, edit.REGION_PANE, r(0, i % 24, 1, 1), i)
        i += 1
    }
    assert(edit.region_count(rs) == edit.REGION_MAX, "capped")
    assert(edit.region_hit(mut rs, 0, 0).kind == edit.REGION_PANE, "still answers")
}

// `test_region_zero_area_is_not_registered` (`:112-119`).
fn t_region_zero_area_is_not_registered() {
    var rs = edit.regions_new()
    edit.region_frame_begin(mut rs)
    edit.region_add(mut rs, edit.REGION_PANE, r(5, 5, 0, 10), 1)
    edit.region_add(mut rs, edit.REGION_PANE, r(5, 5, 10, 0), 2)
    assert(edit.region_count(rs) == 0, "neither registered")
}

// `test_region_tab_payload_sign_convention` (`:125-140`).
fn t_region_tab_payload_sign_convention() {
    var rs = edit.regions_new()
    edit.region_frame_begin(mut rs)
    edit.region_add(mut rs, edit.REGION_TAB, r(0, 0, 10, 1), 2)
    edit.region_add(mut rs, edit.REGION_TAB, r(10, 0, 10, 1), -5)
    let a = edit.region_hit(mut rs, 1, 0)
    assert(a.payload >= 0 && a.payload == 2, "a tab index")
    let b = edit.region_hit(mut rs, 11, 0)
    assert(b.payload < 0 && 0 - b.payload == 5, "a group id, negated")
}

fn main() {
    t_region_hit_finds_the_registered_rect()
    t_region_last_added_wins_on_overlap()
    t_region_frame_begin_clears_the_table()
    t_region_empty_query_is_counted()
    t_region_capacity_drops_without_growing()
    t_region_zero_area_is_not_registered()
    t_region_tab_payload_sign_convention()
    print("region_test: 7 cases pass")
}
