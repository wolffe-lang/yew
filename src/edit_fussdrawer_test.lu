//! member: false
//!
//! The port of sagitta `tests/unit/test_fussdrawer.c` (1,287 lines), one
//! test per C test in registry order (the FUSS block's twenty-seven
//! `fussdrawer_*`): the drawer's locked layout table, its cells and
//! regions, the editor chrome it shifts, the live view F mode must leave
//! exactly as it found it, the selection's local damage, the actions
//! palette's effective keys, mouse selection and the wheel, the commit's
//! owner closing under it, and `ed.git.copy_path`.
//!
//! Fixtures are directories under `$TMPDIR` (`fussdrawer_fix_make`), never
//! repositories: C's workspace is not a git checkout, and its editor's git
//! children are never pumped; the port's editors route their git spawns to
//! the test hook (`git_test_spawn_set`) so no child runs at all. C's
//! `UINT16_MAX` "no edge column" is the port's -1. C's `ed->interner` path
//! ids are F mode's own interner (`fuss_path_of_id`).
//!
//! C's entry ticks once (`yew_fuss_tick(ed, ed->now_ms + 20)`): the
//! workspace walk's 2 ms step (`fussmode.c:1088`) lists a fixture's few
//! files in that one step natively. The checked machine is slower than
//! the budget, so `walk_done` ticks until the walk has finished: the same
//! files and the same tree, a step count the case never asserts.
//!
//! `YEW_PICK_CASE=N` runs case N alone (the checked machine's per-case run).

use edit
use git
use std.fs
use term
use text

fn b(s: str) -> List[byte] {
    var v = List[byte]()
    for x in s.bytes() {
        (mut v).push(x)
    }
    v
}

fn s_of(v: List[byte]) -> str {
    str_from_utf8(v) else ""
}

// `FussDrawerFix` / `fussdrawer_fix_make` (`test_fussdrawer.c:30-57`): a
// resolved directory holding `plain.txt`.
struct Fix {
    root: str,
    file: str,
}

fn tmp_base() -> str {
    let tmp = env_get("TMPDIR") else "target/tests"
    if tmp.len == 0 then "target/tests" else tmp
}

fn fix_make(tag: str) -> Fix {
    let made = "{tmp_base()}/yew-fussdrawer-{os_pid()}-{tag}"
    fs.remove_dir_all(made) else |_| {}
    fs.create_dir_all(made) else |_| { assert(false, "mkdir {made}") }
    let root = text.file_realpath(made) else {
        assert(false, "realpath {made}")
        made
    }
    let fix = Fix { root: root, file: "{root}/plain.txt" }
    fs.write_bytes(fix.file, b("not a git repository\n")) else |_| {
        assert(false, "write plain.txt")
    }
    fix
}

// `fussdrawer_fix_drop` (`:59-63`).
fn fix_drop(fix: Fix) {
    fs.remove(fix.file) else |_| { assert(false, "unlink plain.txt") }
    fs.remove_dir_all(fix.root) else |_| { assert(false, "rmdir root") }
}

// An editor over one scratch buffer, its git spawns hooked, the `theme`
// option's default theme active (`option.c:327`: quiver-dark, whose
// `git.drawer` roles C's assertions read; the port's `ed_new` has no
// theme until one is set, as `edit_draw_test` sets it).
fn editor() -> edit.Ed {
    var ed = edit.ed_new()
    edit.git_test_spawn_set(mut ed, true)
    edit.ed_open_scratch(mut ed)
    edit.ed_theme_set(mut ed, "quiver-dark")
    ed
}

// C's one tick, repeated until the walk's last step (the header).
fn walk_done(mut ed: edit.Ed) {
    edit.fuss_tick(mut ed, ed.now_ms + 20)
    var guard = 0
    while ed.fuss.has_walk && guard < 100000 {
        edit.fuss_tick(mut ed, ed.now_ms + 20)
        guard += 1
    }
    assert(!ed.fuss.has_walk, "the walk finishes")
}

// `fussdrawer_enter_non_git` (`:65-72`).
fn enter_non_git(fix: Fix) -> edit.Ed {
    var ed = editor()
    ed.ws_dir = fix.root
    assert(edit.mode_enter(mut ed, edit.MODE_F) == edit.CMD_OK, "F mode")
    walk_done(mut ed)
    ed
}

// `fussdrawer_grid_size` / `fussdrawer_grid` (`:74-84`).
fn grid_size(mut ed: edit.Ed, rows: int, cols: int) {
    ed.grid = term.grid_new(rows, cols)
    ed.grid_ready = true
    edit.ed_layout(mut ed)
}

fn grid(mut ed: edit.Ed) {
    grid_size(mut ed, 24, 80)
}

fn mouse_key(col: int, row: int, button: int, ev: int) -> term.Key {
    var k = term.key_new()
    k.kind = term.EV_MOUSE
    k.button = button
    k.col = col
    k.row = row
    k.ev = ev
    k
}

// `fussdrawer_click` (`:86-98`): a press and its release.
fn click(mut ed: edit.Ed, col: int, row: int) {
    edit.mouse_event(mut ed, mouse_key(col, row, term.MB_LEFT, term.KEY_PRESS))
    edit.mouse_event(mut ed, mouse_key(col, row, term.MB_LEFT, term.KEY_RELEASE))
}

// `fussfeel_press` (`:1005-1016`): a press alone.
fn press(mut ed: edit.Ed, col: int, row: int) {
    edit.mouse_event(mut ed, mouse_key(col, row, term.MB_LEFT, term.KEY_PRESS))
}

fn cx_of(ed: edit.Ed) -> edit.CmdCtx {
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    cx.count = 1
    cx
}

// `fussdrawer_row_contains` (`:130-165`): the back grid's row as text,
// a blank cell one space, continuation cells skipped.
fn row_contains(ed: edit.Ed, row: int, needle: str) -> bool {
    if row < 0 || row >= ed.grid.rows {
        return false
    }
    var text = List[byte]()
    var col = 0
    while col < ed.grid.cols {
        let c = term.grid_back(ed.grid, row, col)
        if c.w != 0 {
            var cell = List[byte]()
            term.cell_bytes_into(mut cell, ed.grid, c)
            if cell.len == 0 {
                (mut text).push(32 as byte)
            } else {
                for x in cell {
                    (mut text).push(x)
                }
            }
        }
        col += 1
    }
    s_of(text).contains(needle)
}

// `fussdrawer_cell_is` (`:167-186`).
fn cell_is(ed: edit.Ed, row: int, col: int, want: str) -> bool {
    if row < 0 || row >= ed.grid.rows || col < 0 || col >= ed.grid.cols {
        return false
    }
    var cell = List[byte]()
    term.cell_bytes_into(mut cell, ed.grid, term.grid_back(ed.grid, row, col))
    s_of(cell) == want
}

fn cursor(ed: edit.Ed) -> int {
    let w = ed.win
    ed.wins[w].cs.curs[ed.wins[w].cs.primary].pos
}

fn vp_same(a: edit.Viewport, c: edit.Viewport) -> bool {
    a.top == c.top &&
        a.top_sub == c.top_sub &&
        a.left == c.left &&
        a.rows == c.rows &&
        a.cols == c.cols &&
        a.scrolloff == c.scrolloff &&
        a.sidescrolloff == c.sidescrolloff &&
        a.wrap == c.wrap
}

fn realpath_of_win(ed: edit.Ed) -> str {
    let bi = ed.wins[ed.win].buf
    ed.bufs[bi].ec.meta.realpath
}

fn fussdrawer_relative_time_uses_editor_anchor() {
    var ed = editor()
    assert(edit.fuss_relative_time(ed, 1) == "", "unanchored: nothing")
    ed.now_ms = 1000
    edit.git_clock_anchor(mut ed, 1000, 1700000000)
    assert(edit.fuss_relative_time(ed, 1699999970) == "now", "30 s: now")
    assert(edit.fuss_relative_time(ed, 1699999940) == "1 minute ago", "60 s")
    assert(edit.fuss_relative_time(ed, 1698790400) == "2 weeks ago", "two weeks")
    ed.now_ms = 4000
    assert(
        edit.fuss_relative_time(ed, 1699999940) == "1 minute ago",
        "the anchor advances by the editor's clock",
    )
    assert(edit.fuss_relative_time(ed, 1800000000) == "now", "a future stamp is now")
}

struct LayoutRow {
    content: int,
    natural: int,
    width: int,
    tree_width: int,
    edge_col: int,
    fullscreen: bool,
}

fn lr(
    content: int,
    natural: int,
    width: int,
    tree_width: int,
    edge_col: int,
    fullscreen: bool,
) -> LayoutRow {
    LayoutRow {
        content: content,
        natural: natural,
        width: width,
        tree_width: tree_width,
        edge_col: edge_col,
        fullscreen: fullscreen,
    }
}

fn fussdrawer_layout_follows_the_locked_table() {
    let rows = [
        lr(0, 0, 0, 0, -1, true),
        lr(20, 12, 20, 20, -1, true),
        lr(40, 18, 40, 40, -1, true),
        lr(64, 18, 24, 23, 23, false),
        lr(80, 34, 34, 33, 33, false),
        lr(80, 41, 80, 80, -1, true),
        lr(120, 20, 30, 29, 29, false),
        lr(120, 70, 70, 69, 69, false),
        lr(120, 81, 120, 120, -1, true),
        lr(240, 30, 60, 59, 59, false),
        lr(240, 190, 190, 189, 189, false),
        lr(240, 201, 240, 240, -1, true),
        lr(65535, 65535, 65535, 65535, -1, true),
    ]
    for r in rows {
        let l = edit.fuss_drawer_layout(r.content, r.natural)
        assert(l.width == r.width, "{r.content}/{r.natural}: width {l.width}")
        assert(l.tree_width == r.tree_width, "{r.content}/{r.natural}: tree {l.tree_width}")
        assert(l.edge_col == r.edge_col, "{r.content}/{r.natural}: edge {l.edge_col}")
        assert(l.fullscreen == r.fullscreen, "{r.content}/{r.natural}: fullscreen")
    }
}

fn fussdrawer_natural_width_uses_only_visible_rows() {
    var snap = git.git_snapshot_new()
    var e = git.git_entry_new()
    e.path_at = git.git_pool_add(mut snap.pool, b("src/mod/file.c"), 0, 14)
    e.path_len = 14
    e.unstaged = true
    (mut snap.entries).push(e)
    snap.gen = 1
    var tree = git.fuss_tree_new()
    var open = git.fuss_open_memory_new()
    git.fuss_build(mut tree, snap, git.FussOpts { all_files: true, show_hidden: false })
    assert(edit.fuss_tree_natural_width(tree) == 10, "src collapsed: 10")
    assert(git.fuss_open_memory_set(mut open, b("src"), 0, 3, true), "open src")
    git.fuss_apply_expansion(mut tree, open, git.fuss_open_memory_new())
    assert(edit.fuss_tree_natural_width(tree) == 12, "src open: 12")
    assert(git.fuss_open_memory_set(mut open, b("src/mod"), 0, 7, true), "open src/mod")
    git.fuss_apply_expansion(mut tree, open, git.fuss_open_memory_new())
    assert(edit.fuss_tree_natural_width(tree) == 17, "src/mod open: 17")
    assert(git.fuss_open_memory_set(mut open, b("src/mod"), 0, 7, false), "close src/mod")
    git.fuss_apply_expansion(mut tree, open, git.fuss_open_memory_new())
    assert(edit.fuss_tree_natural_width(tree) == 12, "closed again: 12")
    tree.items[0].depth = 65535
    assert(edit.fuss_tree_natural_width(tree) == 65535, "saturates")
}

fn fussdrawer_compact_row_and_edge_own_distinct_cells() {
    let fix = fix_make("compact")
    var ed = enter_non_git(fix)
    grid(mut ed)
    edit.region_frame_begin(mut ed.regions)
    edit.fuss_draw(mut ed)
    let layout = edit.fuss_drawer_layout(80, 14)
    assert(!layout.fullscreen, "a drawer, not fullscreen")
    assert(row_contains(ed, 1, "   plain.txt"), "the file row")
    for glyph in ["\u{251c}", "\u{2514}", "\u{25b6}", "\u{25bc}", "|--", "`--"] {
        assert(!row_contains(ed, 1, glyph), "no tree glyph {glyph}")
    }
    assert(cell_is(ed, 1, layout.edge_col, "\u{2502}"), "the edge on the row")
    assert(cell_is(ed, 0, layout.edge_col, "\u{2502}"), "the edge on the header")
    assert(cell_is(ed, 23, layout.edge_col, "\u{2502}"), "the edge to the bottom")
    let (has, surface) = edit.theme_ui(ed.theme, "git.drawer", edit.theme_rendition_of(ed.render))
    assert(has, "the drawer surface role")
    assert(
        term.color_equal(term.grid_back(ed.grid, 23, 0).bg, surface.bg),
        "the bottom-left cell is the surface",
    )
    assert(
        term.grid_back(ed.grid, 1, layout.edge_col).attrs & term.ATTR_BOLD != 0,
        "the edge is bold",
    )
    let row = edit.region_hit(mut ed.regions, layout.edge_col - 1, 1)
    assert(row.kind == edit.REGION_FUSS_ROW, "the row owns the cell before the edge")
    for y in [1, 0, 12, 23] {
        let edge = edit.region_hit(mut ed.regions, layout.edge_col, y)
        assert(edge.kind == edit.REGION_NONE, "the edge owns no region at row {y}")
    }
    fix_drop(fix)
}

fn fussdrawer_offcanvas_layout_shifts_editor_chrome() {
    let fix = fix_make("offcanvas")
    var ed = editor()
    assert(edit.tab_open(mut ed, fix.file) >= 0, "the file's tab")
    ed.ws_dir = fix.root
    assert(edit.mode_enter(mut ed, edit.MODE_F) == edit.CMD_OK, "F mode")
    walk_done(mut ed)
    grid(mut ed)
    var backdrop = edit.fuss_backdrop_rect(ed)
    let drawer = edit.fuss_drawer_rect(ed)
    assert(drawer.x == 0 && drawer.y == 0 && drawer.w == 24 && drawer.h == 24, "the drawer 24x24")
    let st = copy ed.tab_strip_rect
    assert(st.x == 24 && st.y == 0 && st.w == 56 && st.h == 1, "the strip shifted")
    var pr = copy ed.panes[ed.pane_root].rect
    assert(pr.x == 24 && pr.y == 1 && pr.w == 56 && pr.h == 21, "the panes shifted")
    let fr = copy ed.footer_rect
    assert(fr.x == 24 && fr.y == 22 && fr.w == 56 && fr.h == 2, "the two footer rows shifted")
    assert(
        backdrop.x == 24 && backdrop.y == 1 && backdrop.w == 56 && backdrop.h == 21,
        "the backdrop",
    )

    assert(edit.mode_enter(mut ed, edit.MODE_L) == edit.CMD_OK, "L mode")
    edit.ed_layout(mut ed)
    assert(ed.tab_strip_rect.x == 0 && ed.tab_strip_rect.w == 80, "the strip back")
    pr = copy ed.panes[ed.pane_root].rect
    assert(pr.x == 0 && pr.w == 80, "the panes back")
    assert(ed.footer_rect.x == 0 && ed.footer_rect.w == 80, "the footer back")

    let group = edit.group_create(mut ed, fix.root, "work")
    assert(group != 0, "a group")
    edit.group_add_member(mut ed, group, 0)
    edit.group_add_member(mut ed, group, 1)
    assert(edit.mode_enter(mut ed, edit.MODE_F) == edit.CMD_OK, "F again")
    edit.ed_layout(mut ed)
    backdrop = edit.fuss_backdrop_rect(ed)
    let st2 = copy ed.tab_strip_rect
    assert(st2.x == 24 && st2.y == 0 && st2.w == 56 && st2.h == 2, "the two-row strip shifted")
    pr = copy ed.panes[ed.pane_root].rect
    assert(pr.x == 24 && pr.y == 2 && pr.w == 56 && pr.h == 20, "the panes under it")
    assert(
        backdrop.x == 24 && backdrop.y == 2 && backdrop.w == 56 && backdrop.h == 20,
        "the backdrop under it",
    )
    fix_drop(fix)
}

fn fussdrawer_header_preserves_divergence_in_compact_width() {
    let fix = fix_make("divergence")
    var ed = enter_non_git(fix)
    grid(mut ed)
    let s = ed.git.live
    ed.git.snap[s].gen = 1
    ed.git.snap[s].taken_ms = edit.now_ms()
    ed.git.snap[s].state = git.GIT_OK
    let tb = b("trunk")
    ed.git.snap[s].branch_at = git.git_pool_add(mut ed.git.snap[s].pool, tb, 0, tb.len)
    ed.git.snap[s].branch_len = tb.len
    ed.git.snap[s].has_branch = true
    let ub = b("origin/trunk")
    ed.git.snap[s].upstream_at = git.git_pool_add(mut ed.git.snap[s].pool, ub, 0, ub.len)
    ed.git.snap[s].upstream_len = ub.len
    ed.git.snap[s].has_upstream = true
    ed.git.snap[s].ahead = 1
    ed.git.snap[s].behind = 1
    edit.region_frame_begin(mut ed.regions)
    edit.fuss_draw(mut ed)
    assert(row_contains(ed, 0, "\u{2191}1 \u{2193}1"), "the divergence survives the compact header")
    fix_drop(fix)
}

fn fussdrawer_entry_leave_preserves_live_pane_identity() {
    let fix = fix_make("identity")
    var ed = editor()
    ed.ws_dir = fix.root
    grid(mut ed)
    let root = ed.pane_root
    let focus = ed.focus
    let win = ed.win
    let tab = ed.tab_active
    let viewport = copy ed.wins[ed.win].vp
    let at = cursor(ed)
    let ratio = ed.panes[root].ratio
    var i = 0
    while i < 100 {
        assert(edit.mode_enter(mut ed, edit.MODE_F) == edit.CMD_OK, "{i}: F")
        edit.ed_layout(mut ed)
        assert(ed.pane_root == root && ed.focus == focus && ed.win == win, "{i}: the panes kept")
        assert(ed.tab_active == tab, "{i}: the tab kept")
        assert(ed.panes[root].ratio == ratio, "{i}: the ratio kept")
        assert(cursor(ed) == at, "{i}: the cursor kept")
        assert(edit.mode_enter(mut ed, edit.MODE_L) == edit.CMD_OK, "{i}: L")
        edit.ed_layout(mut ed)
        assert(ed.pane_root == root && ed.focus == focus && ed.win == win, "{i}: the panes back")
        assert(ed.tab_active == tab, "{i}: the tab back")
        assert(ed.panes[root].ratio == ratio, "{i}: the ratio back")
        assert(cursor(ed) == at, "{i}: the cursor back")
        assert(vp_same(ed.wins[ed.win].vp, viewport), "{i}: the viewport back exactly")
        i += 1
    }
    fix_drop(fix)
}

fn fussdrawer_non_git_tree_publishes_and_opens_a_file() {
    let fix = fix_make("open")
    var ed = enter_non_git(fix)
    assert(edit.fuss_cmd_open(mut ed, cx_of(ed)) == edit.CMD_OK, "open")
    assert(ed.mode == edit.MODE_L, "L after open")
    assert(ed.win >= 0 && ed.wins[ed.win].buf >= 0, "a window and a buffer")
    assert(realpath_of_win(ed) == fix.file, "the file: {realpath_of_win(ed)}")
    fix_drop(fix)
}

fn fussdrawer_failed_split_is_atomic_and_keeps_f_mode() {
    let fix = fix_make("split")
    var ed = enter_non_git(fix)
    let root = ed.pane_root
    let focus = ed.focus
    ed.panes[focus].rect.w = edit.PANE_MIN_W
    assert(edit.fuss_cmd_open_split_h(mut ed, cx_of(ed)) == edit.CMD_ERR_STATE, "no room")
    assert(edit.fuss_active(ed), "F still up")
    assert(ed.mode == edit.MODE_F, "F mode")
    assert(ed.pane_root == root && ed.focus == focus, "the tree untouched")
    assert(ed.panes[root].is_leaf, "one leaf")
    fix_drop(fix)
}

fn fussdrawer_preview_preserves_the_live_view_exactly() {
    let fix = fix_make("preview")
    var ed = editor()
    edit.ed_open_memory(mut ed, b("live editor text\nsecond line\n"), "live.txt")
    ed.ws_dir = fix.root
    grid(mut ed)
    ed.wins[ed.win].vp.left = 3
    // Kept valid under the ordinary sidescroll margin.
    let w = ed.win
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].pos = 8
    ed.wins[w].cs.curs[p].anchor = 8
    let buffer = ed.wins[ed.win].buf
    let viewport = copy ed.wins[ed.win].vp
    let at = cursor(ed)
    assert(edit.mode_enter(mut ed, edit.MODE_F) == edit.CMD_OK, "F")
    walk_done(mut ed)
    edit.ed_layout(mut ed)
    assert(edit.fuss_cmd_view(mut ed, cx_of(ed)) == edit.CMD_OK, "view")
    assert(ed.wins[ed.win].panel.open, "the preview panel")
    assert(ed.wins[ed.win].panel.rect.x >= edit.fuss_drawer_rect(ed).w, "right of the drawer")
    assert(ed.wins[ed.win].buf == buffer, "the live buffer kept")
    assert(cursor(ed) == at, "the cursor kept")
    let vp = copy ed.wins[ed.win].vp
    assert(vp.cols < viewport.cols, "narrowed")
    assert(vp.top == viewport.top && vp.top_sub == viewport.top_sub, "the top kept")
    assert(vp.left == viewport.left, "the left kept ({vp.left})")
    assert(vp.wrap == viewport.wrap, "the wrap kept")
    assert(edit.mode_enter(mut ed, edit.MODE_L) == edit.CMD_OK, "L")
    edit.ed_layout(mut ed)
    assert(!ed.wins[ed.win].panel.open, "the panel closed")
    assert(ed.wins[ed.win].buf == buffer, "the live buffer")
    assert(cursor(ed) == at, "the cursor")
    assert(vp_same(ed.wins[ed.win].vp, viewport), "the viewport exactly")
    fix_drop(fix)
}

fn fussdrawer_fullscreen_preview_centers_in_content_not_pane() {
    let fix = fix_make("center")
    var ed = enter_non_git(fix)
    grid_size(mut ed, 24, 40)
    assert(edit.fuss_drawer_layout(40, 0).fullscreen, "40 columns: fullscreen")
    assert(edit.fuss_cmd_view(mut ed, cx_of(ed)) == edit.CMD_OK, "view")
    assert(ed.wins[ed.win].panel.open, "the panel")
    let content = edit.fuss_backdrop_rect(ed)
    let inset = edit.rect(content.x + 2, content.y + 2, content.w - 4, content.h - 4)
    let panel = copy ed.wins[ed.win].panel.rect
    assert(panel.x >= inset.x && panel.y >= inset.y, "inside the inset")
    assert(panel.x + panel.w <= inset.x + inset.w, "inside on the right")
    assert(panel.y + panel.h <= inset.y + inset.h, "inside at the bottom")
    assert(panel.x == inset.x + (inset.w - panel.w) / 2, "centred across")
    assert(panel.y == inset.y + (inset.h - panel.h) / 2, "centred down")
    assert(panel.x < ed.wins[ed.win].rect.x, "the content, not the pane")
    fix_drop(fix)
}

fn fussdrawer_selection_damage_stays_local() {
    let fix = fix_make("damage")
    var ed = enter_non_git(fix)
    ed.full_damage = false
    ed.layout_dirty = false
    ed.footer_dirty = false
    assert(edit.fuss_cmd_nav_row_next(mut ed, cx_of(ed)) == edit.CMD_OK, "next row")
    assert(!ed.full_damage, "no full repaint")
    assert(!ed.layout_dirty, "no layout")
    assert(ed.footer_dirty, "the footer")
    assert(edit.fuss_draw_dirty(ed), "the drawer")
    fix_drop(fix)
}

fn fussdrawer_typejump_selection_damage_stays_local() {
    let fix = fix_make("jumpdamage")
    var ed = enter_non_git(fix)
    assert(edit.fuss_cmd_jump_arm(mut ed, cx_of(ed)) == edit.CMD_OK, "arm")
    ed.full_damage = false
    ed.layout_dirty = false
    ed.footer_dirty = false
    var k = term.key_new()
    k.code = 'p' as int
    (mut k.text).push('p' as int as byte)
    assert(edit.fuss_key(mut ed, k, edit.now_ms()), "p jumps")
    assert(!ed.full_damage, "no full repaint")
    assert(!ed.layout_dirty, "no layout")
    assert(ed.footer_dirty, "the footer")
    assert(edit.fuss_draw_dirty(ed), "the drawer")
    fix_drop(fix)
}

fn fussdrawer_typejump_ignores_printable_outside_f_mode() {
    let fix = fix_make("insert")
    var ed = enter_non_git(fix)
    assert(edit.fuss_active(ed), "F up")
    var k = term.key_new()
    k.code = 'm' as int
    (mut k.text).push('m' as int as byte)
    // The commit's Insert input leaves the drawer active; its text must
    // reach normal dispatch.
    ed.mode = edit.MODE_I
    assert(!edit.fuss_key(mut ed, k, edit.now_ms()), "Insert's text is not the jump's")
    fix_drop(fix)
}

fn fussdrawer_actions_list_uses_only_effective_reachable_keys() {
    let fix = fix_make("actions")
    var ed = enter_non_git(fix)
    grid(mut ed)
    assert(edit.fuss_cmd_actions(mut ed, cx_of(ed)) == edit.CMD_OK, "the palette")
    assert(edit.picker_active(ed), "up")
    let baseline = edit.picker_total(ed)
    assert(baseline > 30, "more than thirty actions ({baseline})")
    edit.picker_close(mut ed, false)
    let (built, km) = edit.keymap_build(
        ed.reg,
        "test config",
        [edit.bindrow("A-a", "ed.nop"), edit.bindrow("j", "ed.git.status")],
    )
    assert(built, "the override keymap")
    ed.keymaps[edit.km_bind(edit.MODE_F)] = km
    assert(edit.fuss_cmd_actions(mut ed, cx_of(ed)) == edit.CMD_OK, "the palette again")
    assert(edit.picker_active(ed), "up again")
    // A-a's non-FUSS override shadows the stage row; bare j is the jump's
    // and unreachable: neither is advertised.
    assert(edit.picker_total(ed) == baseline - 1, "one row fewer ({edit.picker_total(ed)})")
    var k = term.key_new()
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    k.code = '/' as int
    (mut k.text).push('/' as int as byte)
    assert(edit.picker_key(mut ed, k), "/ opens the filter")
    for c in "A-q".bytes() {
        var f = term.key_new()
        f.kind = term.EV_KEY
        f.ev = term.KEY_PRESS
        f.code = c as int
        (mut f.text).push(c)
        assert(edit.picker_key(mut ed, f), "typed")
    }
    assert(edit.picker_shown(ed) == 1, "one row shown ({edit.picker_shown(ed)})")
    let before = ed.dispatch_count
    assert(edit.picker_accept(mut ed), "accepted")
    assert(!edit.picker_active(ed), "closed")
    assert(ed.mode == edit.MODE_L, "A-q left F")
    assert(ed.reg.entries[ed.last_cmd - 1].name == "ed.git.mode.leave", "the leave command ran")
    assert(ed.dispatch_count == before + 1, "one dispatch")
    fix_drop(fix)
}

fn fussdrawer_selected_row_keeps_the_final_component() {
    let fix = fix_make("final")
    let name = "aaaa-prefix-that-must-clip-final-component.c"
    let path = "{fix.root}/{name}"
    fs.write_bytes(path, b("long name\n")) else |_| { assert(false, "write") }
    var ed = enter_non_git(fix)
    grid(mut ed)
    edit.region_frame_begin(mut ed.regions)
    edit.fuss_draw(mut ed)
    assert(row_contains(ed, 1, "final-component.c"), "the final component survives the clip")
    fs.remove(path) else |_| { assert(false, "unlink") }
    fix_drop(fix)
}

fn fussdrawer_directory_tree_starts_collapsed() {
    var snap = git.git_snapshot_new()
    for p in ["one/two/three.c", "one/peer.c"] {
        var e = git.git_entry_new()
        e.path_at = git.git_pool_add(mut snap.pool, b(p), 0, p.len)
        e.path_len = p.len
        (mut snap.entries).push(e)
    }
    snap.gen = 1
    var tree = git.fuss_tree_new()
    git.fuss_build(mut tree, snap, git.FussOpts { all_files: true, show_hidden: false })
    assert(tree.items.len == 1, "one row ({tree.items.len})")
    assert(s_of(git.fuss_item_path(tree, 0)) == "one", "one")
    assert(!tree.nodes[tree.items[0].node].expanded, "collapsed")
}

fn fussdrawer_mouse_double_click_uses_open_destination() {
    let fix = fix_make("double")
    var ed = enter_non_git(fix)
    grid(mut ed)
    edit.region_frame_begin(mut ed.regions)
    edit.fuss_draw(mut ed)
    ed.now_ms = 1000
    click(mut ed, 1, 1)
    ed.now_ms = 1100
    edit.region_frame_begin(mut ed.regions)
    edit.region_add(
        mut ed.regions,
        edit.REGION_FUSS_ROW,
        edit.rect(0, 1, 20, 1),
        ed.mouse.last_click_payload + 1,
    )
    click(mut ed, 1, 1)
    assert(ed.mouse.click_n == 1, "another row's id restarts the count ({ed.mouse.click_n})")
    assert(edit.fuss_active(ed), "still F")
    edit.region_frame_begin(mut ed.regions)
    edit.fuss_draw(mut ed)
    ed.now_ms = 1200
    click(mut ed, 1, 1)
    assert(ed.mouse.click_n == 1, "the real row again: one ({ed.mouse.click_n})")
    ed.now_ms = 1300
    click(mut ed, 1, 1)
    assert(ed.mode == edit.MODE_L, "the double click opened")
    assert(!edit.fuss_active(ed), "F down")
    assert(realpath_of_win(ed) == fix.file, "the file: {realpath_of_win(ed)}")
    fix_drop(fix)
}

fn fussdrawer_preview_owner_tab_can_close() {
    let fix = fix_make("ownertab")
    var ed = editor()
    let owner = edit.tab_open(mut ed, fix.file)
    assert(owner >= 0, "the owner tab")
    edit.tab_switch(mut ed, owner)
    ed.ws_dir = fix.root
    assert(edit.mode_enter(mut ed, edit.MODE_F) == edit.CMD_OK, "F")
    walk_done(mut ed)
    assert(edit.fuss_cmd_view(mut ed, cx_of(ed)) == edit.CMD_OK, "view")
    assert(edit.tab_close(mut ed, owner), "the owner closes")
    assert(edit.fuss_active(ed), "F still up")
    assert(edit.mode_enter(mut ed, edit.MODE_L) == edit.CMD_OK, "L")
    fix_drop(fix)
}

// A staged `plain.txt` published into the live snapshot, `#` comments.
fn stage_plain(mut ed: edit.Ed) {
    let s = ed.git.live
    var e = git.git_entry_new()
    e.kind = git.GIT_E_ORDINARY
    let pb = b("plain.txt")
    e.path_at = git.git_pool_add(mut ed.git.snap[s].pool, pb, 0, pb.len)
    e.path_len = pb.len
    e.staged = true
    ed.git.snap[s].state = git.GIT_OK
    let cb = b("#")
    ed.git.snap[s].comment_at = git.git_pool_add(mut ed.git.snap[s].pool, cb, 0, 1)
    ed.git.snap[s].comment_len = 1
    (mut ed.git.snap[s].entries).reset()
    (mut ed.git.snap[s].entries).push(e)
    ed.git.snap[s].gen += 1
}

fn fussdrawer_commit_owner_tab_close_cancels_cleanly() {
    let fix = fix_make("committab")
    var ed = editor()
    let owner = edit.tab_open(mut ed, fix.file)
    assert(owner >= 0, "the owner tab")
    edit.tab_switch(mut ed, owner)
    ed.ws_dir = fix.root
    assert(edit.mode_enter(mut ed, edit.MODE_F) == edit.CMD_OK, "F")
    stage_plain(mut ed)
    assert(edit.fuss_cmd_commit(mut ed, cx_of(ed)) == edit.CMD_OK, "commit")
    assert(ed.mode == edit.MODE_I, "Insert in the commit scratch")
    assert(edit.tab_close(mut ed, owner), "the owner closes")
    assert(ed.mode == edit.MODE_F, "back to F")
    assert(edit.fuss_active(ed), "F up")
    assert(edit.ws_scratch_find(ed, "*commit*") < 0, "the scratch dropped")
    assert(edit.mode_enter(mut ed, edit.MODE_L) == edit.CMD_OK, "L")
    fix_drop(fix)
}

fn fussdrawer_commit_owner_pane_close_cancels_cleanly() {
    let fix = fix_make("commitpane")
    var ed = editor()
    ed.panes[ed.focus].rect = edit.rect(0, 0, 80, 24)
    var cx = cx_of(ed)
    assert(edit.pane_cmd_split_v(mut ed, cx) == edit.CMD_OK, "split")
    ed.ws_dir = fix.root
    assert(edit.mode_enter(mut ed, edit.MODE_F) == edit.CMD_OK, "F")
    stage_plain(mut ed)
    cx = cx_of(ed)
    assert(edit.fuss_cmd_commit(mut ed, cx) == edit.CMD_OK, "commit")
    assert(ed.mode == edit.MODE_I, "Insert")
    let commit_win_id = ed.wins[ed.win].id
    cx = cx_of(ed)
    assert(edit.pane_cmd_close(mut ed, cx) == edit.CMD_OK, "the commit pane closes")
    assert(edit.pane_leaf_count(ed, ed.pane_root) == 1, "one pane")
    assert(ed.win >= 0, "a window")
    assert(ed.wins[ed.win].id != commit_win_id, "not the commit's")
    assert(ed.mode == edit.MODE_F, "back to F")
    assert(edit.fuss_active(ed), "F up")
    assert(edit.ws_scratch_find(ed, "*commit*") < 0, "the scratch dropped")
    // A fresh commit is not poisoned by stale deferred state.
    cx = cx_of(ed)
    assert(edit.fuss_cmd_commit(mut ed, cx) == edit.CMD_OK, "commit again")
    assert(ed.mode == edit.MODE_I, "Insert again")
    assert(edit.ws_scratch_find(ed, "*commit*") >= 0, "the scratch")
    let (handled, status) = edit.fuss_commit_close(mut ed, ed.wins[ed.win].buf)
    assert(status == edit.CMD_OK, "closed")
    assert(handled, "handled")
    assert(ed.mode == edit.MODE_F, "F")
    assert(edit.ws_scratch_find(ed, "*commit*") < 0, "dropped")
    assert(edit.mode_enter(mut ed, edit.MODE_L) == edit.CMD_OK, "L")
    fix_drop(fix)
}

// `FussFeelFix` / `fussfeel_make` (`:942-981`): three rows.
fn feel_make(tag: str) -> Fix {
    let made = "{tmp_base()}/yew-fussfeel-{os_pid()}-{tag}"
    fs.remove_dir_all(made) else |_| {}
    fs.create_dir_all(made) else |_| { assert(false, "mkdir {made}") }
    let root = text.file_realpath(made) else {
        assert(false, "realpath {made}")
        made
    }
    for n in ["aaa.txt", "bbb.txt", "ccc.txt"] {
        fs.write_bytes("{root}/{n}", b("not a git repository\n")) else |_| {
            assert(false, "write {n}")
        }
    }
    Fix { root: root, file: "{root}/aaa.txt" }
}

fn feel_drop(fix: Fix) {
    for n in ["aaa.txt", "bbb.txt", "ccc.txt"] {
        fs.remove("{fix.root}/{n}") else |_| { assert(false, "unlink {n}") }
    }
    fs.remove_dir_all(fix.root) else |_| { assert(false, "rmdir") }
}

// `fussfeel_selected` (`:994-1003`): through the keyboard route's seam.
fn selected(mut ed: edit.Ed) -> str {
    let (ok, id, _, _) = edit.fuss_selected_anchor(mut ed)
    if !ok {
        return ""
    }
    let (has, p) = edit.fuss_path_of_id(ed, id)
    if has then s_of(p) else ""
}

fn feel_editor(fix: Fix) -> edit.Ed {
    var ed = editor()
    ed.ws_dir = fix.root
    assert(edit.mode_enter(mut ed, edit.MODE_F) == edit.CMD_OK, "F")
    walk_done(mut ed)
    grid(mut ed)
    edit.region_frame_begin(mut ed.regions)
    edit.fuss_draw(mut ed)
    ed.now_ms = 1000
    ed
}

fn fussdrawer_single_click_selects_the_row() {
    let fix = feel_make("click")
    var ed = feel_editor(fix)
    assert(selected(mut ed) == "aaa.txt", "aaa first")
    // Row 0 is the header.
    press(mut ed, 1, 3)
    assert(selected(mut ed) == "ccc.txt", "the click selects ccc")
    assert(edit.fuss_active(ed), "selecting is not opening")
    assert(ed.mouse.click_n == 1, "one click")
    press(mut ed, 1, 2)
    assert(selected(mut ed) == "bbb.txt", "then bbb")
    assert(edit.fuss_active(ed), "still F")
    feel_drop(fix)
}

fn fussdrawer_wheel_scrolls_the_tree() {
    let fix = feel_make("wheel")
    var ed = feel_editor(fix)
    assert(selected(mut ed) == "aaa.txt", "aaa first")
    // Over the BLANK part of the drawer.
    edit.mouse_event(mut ed, mouse_key(1, 15, term.MB_WHEEL_DOWN, term.KEY_PRESS))
    assert(selected(mut ed) == "ccc.txt", "a notch is three rows, clamped to the last")
    assert(ed.mouse.phase == edit.MP_IDLE, "the wheel never arms a gesture")
    edit.mouse_event(mut ed, mouse_key(1, 2, term.MB_WHEEL_UP, term.KEY_PRESS))
    assert(selected(mut ed) == "aaa.txt", "back up")
    edit.mouse_event(mut ed, mouse_key(1, 2, term.MB_WHEEL_UP, term.KEY_PRESS))
    assert(selected(mut ed) == "aaa.txt", "clamped, not wrapped")
    feel_drop(fix)
}

// `fuss_clip_mute` / `fuss_clip_restore` (`:1128-1151`): the `+` register
// kept, its external half a no-op.
fn clip_mute() -> (bool, str) {
    var present = true
    let old = env_get("YEW_CLIPBOARD") else {
        present = false
        ""
    }
    env_set("YEW_CLIPBOARD", "none") else |_| { assert(false, "setenv") }
    (present, old)
}

fn clip_restore(saved: (bool, str)) {
    let (had, old) = saved
    if had {
        env_set("YEW_CLIPBOARD", old) else |_| { assert(false, "setenv") }
    } else {
        env_unset("YEW_CLIPBOARD") else |_| { assert(false, "unsetenv") }
    }
}

// `fuss_assert_plus_register` (`:1153-1163`): CHARWISE, exactly `want`.
fn plus_is(mut ed: edit.Ed, want: str) {
    let v = text.reg_get(mut ed.regs, '+' as int) else {
        assert(false, "a + register")
        return
    }
    assert(v.kind == text.REG_CHARWISE, "charwise")
    assert(s_of(v.bytes) == want, "+ holds {want}: {s_of(v.bytes)}")
}

fn plus_empty(mut ed: edit.Ed) -> bool {
    let v = text.reg_get(mut ed.regs, '+' as int) else { return true }
    v.bytes.len == 0
}

fn fussdrawer_copy_path_yanks_the_selected_row() {
    let env = clip_mute()
    let fix = fix_make("copy")
    var ed = enter_non_git(fix)
    assert(edit.fuss_cmd_copy_path(mut ed, cx_of(ed)) == edit.CMD_OK, "copied")
    plus_is(mut ed, "plain.txt")
    fix_drop(fix)
    clip_restore(env)
}

fn fussdrawer_copy_path_prefers_the_captured_path() {
    let env = clip_mute()
    let fix = fix_make("captured")
    var ed = enter_non_git(fix)
    var cx = cx_of(ed)
    cx.sarg = "sub/deep.txt"
    cx.has_sarg = true
    assert(edit.fuss_cmd_copy_path(mut ed, cx) == edit.CMD_OK, "copied")
    plus_is(mut ed, "sub/deep.txt")
    fix_drop(fix)
    clip_restore(env)
}

fn fussdrawer_copy_path_refuses_an_unsafe_argument() {
    let env = clip_mute()
    let fix = fix_make("unsafe")
    var ed = enter_non_git(fix)
    for bad in ["/etc/passwd", "../outside.txt", "sub/../../escape.txt"] {
        var cx = cx_of(ed)
        cx.sarg = bad
        cx.has_sarg = true
        assert(edit.fuss_cmd_copy_path(mut ed, cx) == edit.CMD_ERR_ARG, "{bad} refused")
        // NOTHING was copied: not the bad path, not the selected row.
        assert(plus_empty(mut ed), "{bad}: + empty")
    }
    fix_drop(fix)
    clip_restore(env)
}

fn fussdrawer_copy_path_refuses_outside_fuss() {
    let env = clip_mute()
    var ed = editor()
    // The drawer's state outlives F mode; the refusal is the missing
    // selected row.
    assert(!edit.fuss_active(ed), "F down")
    assert(edit.fuss_cmd_copy_path(mut ed, cx_of(ed)) == edit.CMD_ERR_ARG, "refused")
    assert(plus_empty(mut ed), "+ empty")
    clip_restore(env)
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    fs.create_dir_all("target/tests") else |_| {}
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    let names = [
        "fussdrawer_relative_time_uses_editor_anchor",
        "fussdrawer_layout_follows_the_locked_table",
        "fussdrawer_natural_width_uses_only_visible_rows",
        "fussdrawer_compact_row_and_edge_own_distinct_cells",
        "fussdrawer_offcanvas_layout_shifts_editor_chrome",
        "fussdrawer_header_preserves_divergence_in_compact_width",
        "fussdrawer_entry_leave_preserves_live_pane_identity",
        "fussdrawer_non_git_tree_publishes_and_opens_a_file",
        "fussdrawer_failed_split_is_atomic_and_keeps_f_mode",
        "fussdrawer_preview_preserves_the_live_view_exactly",
        "fussdrawer_fullscreen_preview_centers_in_content_not_pane",
        "fussdrawer_selection_damage_stays_local",
        "fussdrawer_typejump_selection_damage_stays_local",
        "fussdrawer_typejump_ignores_printable_outside_f_mode",
        "fussdrawer_actions_list_uses_only_effective_reachable_keys",
        "fussdrawer_selected_row_keeps_the_final_component",
        "fussdrawer_directory_tree_starts_collapsed",
        "fussdrawer_mouse_double_click_uses_open_destination",
        "fussdrawer_preview_owner_tab_can_close",
        "fussdrawer_commit_owner_tab_close_cancels_cleanly",
        "fussdrawer_commit_owner_pane_close_cancels_cleanly",
        "fussdrawer_single_click_selects_the_row",
        "fussdrawer_wheel_scrolls_the_tree",
        "fussdrawer_copy_path_yanks_the_selected_row",
        "fussdrawer_copy_path_prefers_the_captured_path",
        "fussdrawer_copy_path_refuses_an_unsafe_argument",
        "fussdrawer_copy_path_refuses_outside_fuss",
    ]
    var ran = 0
    var n = 0
    while n < names.len {
        if chosen >= 0 && chosen != n {
            n += 1
            continue
        }
        match n {
            0 => fussdrawer_relative_time_uses_editor_anchor(),
            1 => fussdrawer_layout_follows_the_locked_table(),
            2 => fussdrawer_natural_width_uses_only_visible_rows(),
            3 => fussdrawer_compact_row_and_edge_own_distinct_cells(),
            4 => fussdrawer_offcanvas_layout_shifts_editor_chrome(),
            5 => fussdrawer_header_preserves_divergence_in_compact_width(),
            6 => fussdrawer_entry_leave_preserves_live_pane_identity(),
            7 => fussdrawer_non_git_tree_publishes_and_opens_a_file(),
            8 => fussdrawer_failed_split_is_atomic_and_keeps_f_mode(),
            9 => fussdrawer_preview_preserves_the_live_view_exactly(),
            10 => fussdrawer_fullscreen_preview_centers_in_content_not_pane(),
            11 => fussdrawer_selection_damage_stays_local(),
            12 => fussdrawer_typejump_selection_damage_stays_local(),
            13 => fussdrawer_typejump_ignores_printable_outside_f_mode(),
            14 => fussdrawer_actions_list_uses_only_effective_reachable_keys(),
            15 => fussdrawer_selected_row_keeps_the_final_component(),
            16 => fussdrawer_directory_tree_starts_collapsed(),
            17 => fussdrawer_mouse_double_click_uses_open_destination(),
            18 => fussdrawer_preview_owner_tab_can_close(),
            19 => fussdrawer_commit_owner_tab_close_cancels_cleanly(),
            20 => fussdrawer_commit_owner_pane_close_cancels_cleanly(),
            21 => fussdrawer_single_click_selects_the_row(),
            22 => fussdrawer_wheel_scrolls_the_tree(),
            23 => fussdrawer_copy_path_yanks_the_selected_row(),
            24 => fussdrawer_copy_path_prefers_the_captured_path(),
            25 => fussdrawer_copy_path_refuses_an_unsafe_argument(),
            _ => fussdrawer_copy_path_refuses_outside_fuss(),
        }
        print("{names[n]}: PASS")
        ran += 1
        n += 1
    }
    print("edit_fussdrawer_test: {ran} cases run")
}
