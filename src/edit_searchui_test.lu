//! member: false
//!
//! The port of sagitta `tests/unit/test_searchui.c` (638 lines), one test
//! per C test in registry order (`tests/unit/registry.c:1648-1668`). C's
//! fixtures are `yew_ed_init` + `yew_ed_open_scratch` and the text
//! inserted through the edit context, the window placed by hand
//! (`test_searchui.c:19-74`); the port's are `edit.ed_new` +
//! `edit.ed_open_scratch` and the same insert through the editor's seam,
//! the window's rect and viewport placed. C's tests assign
//! `ed.search.re` and `ed.search.pat` directly; the port installs them
//! through `edit.search_set_re` and `edit.search_set_pattern`. C's
//! `yew_re_last_compile_walk()` is the error record's `walked`.

use edit
use search
use term
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn place(mut ed: edit.Ed) {
    let w = ed.win
    ed.wins[w].rect = edit.rect(0, 1, 80, 10)
    ed.wins[w].vp.rows = 10
    ed.wins[w].vp.cols = 80
}

fn insert(mut ed: edit.Ed, at: int, bytes: List[byte]) {
    assert(edit.ed_edit_insert(mut ed, ed.win, at, bytes, 0, bytes.len), "fixture insert")
}

// `su_fixture` (`test_searchui.c:19-38`): 40 lines, "line N needle" on 5
// and 30.
fn fixture() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    var src = ""
    var i = 0
    while i < 40 {
        src = if i == 5 || i == 30 then "{src}line {i} needle\n" else "{src}line {i}\n"
        i += 1
    }
    insert(mut ed, 0, bytes_of(src))
    place(mut ed)
    ed
}

// `su_search` (`test_searchui.c:42-50`): seed the state as the prompt
// would.
fn su_search(mut ed: edit.Ed, pat: str, reverse: bool) {
    text.reg_set_search(mut ed.regs, bytes_of(pat))
    edit.search_drop_re(mut ed)
    ed.search.reverse = reverse
    ed.search.has_pat = false
}

// `su_large_fixture` (`test_searchui.c:52-71`).
fn large_fixture(len: int, needle_at: int) -> edit.Ed {
    assert(needle_at <= len && len - needle_at >= 6, "large fixture bounds")
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    var src = List[byte]()
    var i = 0
    while i < len {
        (mut src).push(120 as byte)
        i += 1
    }
    let n = bytes_of("needle")
    i = 0
    while i < 6 {
        src[needle_at + i] = n[i]
        i += 1
    }
    insert(mut ed, 0, src)
    place(mut ed)
    ed
}

fn finish_preview(mut ed: edit.Ed) {
    var turns = 0
    while edit.search_preview_queued(ed) {
        assert(turns < 64, "the preview finishes")
        turns += 1
        edit.search_preview_tick(mut ed)
    }
}

fn cur(ed: edit.Ed) -> int {
    edit.ed_cursor_pos(ed)
}

fn set_cur(mut ed: edit.Ed, pos: int) {
    let w = ed.win
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].pos = pos
    ed.wins[w].cs.curs[p].anchor = pos
}

fn len_of(ed: edit.Ed) -> int {
    text.textbuf_len(ed.bufs[ed.wins[ed.win].buf].ec.tb)
}

fn compiles(pat: List[byte], o: edit.SearchOpts, mut err: search.ReErr) -> bool {
    let _ = edit.search_compile(pat, o, mut err) else |_| {
        return false
    }
    true
}

fn install(mut ed: edit.Ed, pat: str) {
    var err = search.re_err_new()
    let re = edit.search_compile(bytes_of(pat), ed.search_opts, mut err) else |_| {
        assert(false, "{pat} compiles")
        return
    }
    edit.search_set_re(mut ed, take re)
}

// DoD 3, structurally: cancel restores the cursor, its goal column and
// the viewport's top line.
fn t_searchui_cancel_restores_cursor_goal_and_viewport() {
    var ed = fixture()
    let w = ed.win
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].pos = 20
    ed.wins[w].cs.curs[p].goal_col = 7
    ed.wins[w].vp.top = 2
    let saved = copy ed.wins[w].cs.curs[p]
    edit.search_open(mut ed, w, false)
    assert(ed.search.active, "active")
    ed.wins[w].cs.curs[p].pos = 300
    ed.wins[w].cs.curs[p].goal_col = 0
    ed.wins[w].vp.top = 28
    edit.search_cancel(mut ed, w)
    let c = copy ed.wins[w].cs.curs[p]
    assert(c.pos == saved.pos, "pos restored")
    assert(c.goal_col == saved.goal_col, "goal restored")
    assert(c.anchor == saved.anchor, "anchor restored")
    assert(ed.wins[w].vp.top == 2, "top restored")
    assert(!ed.search.active, "inactive")
    assert(ed.wins[w].overlay.spans.len == 0, "highlight gone")
}

fn t_searchui_accept_commits_pattern_to_register() {
    var ed = fixture()
    let w = ed.win
    edit.search_open(mut ed, w, false)
    edit.search_set_pattern(mut ed, bytes_of("needle"))
    edit.search_accept(mut ed, w)
    let slash = text.reg_get(mut ed.regs, 47) else |_| {
        assert(false, "register / set")
        return
    }
    assert(slash.bytes.len == 6, "six bytes")
    assert((str_from_utf8(slash.bytes) else "") == "needle", "needle")
    assert(text.jumplist_len(ed.wins[w].jumps) == 1, "accept is a jump")
}

fn t_searchui_accept_retires_deferred_count() {
    var ed = fixture()
    let w = ed.win
    edit.search_open(mut ed, w, false)
    install(mut ed, "needle")
    edit.search_set_pattern(mut ed, bytes_of("needle"))
    edit.search_schedule_count(mut ed, w)
    assert(ed.search.count_timer != edit.TIMER_NONE, "timer armed")
    assert(ed.search.count_win_id == ed.wins[w].id, "window id")
    edit.search_accept(mut ed, w)
    assert(ed.search.count_timer == edit.TIMER_NONE, "timer retired")
    assert(ed.search.count_win_id == 0, "window retired")
    assert(ed.wins[w].overlay.count_total == 2, "counted in Enter's frame")
    assert(!ed.wins[w].overlay.count_capped, "exact")
}

fn t_searchui_step_finds_successive_matches() {
    var ed = fixture()
    let w = ed.win
    su_search(mut ed, "needle", false)
    set_cur(mut ed, 0)
    assert(edit.search_step(mut ed, w, true, 1), "first")
    let first = cur(ed)
    assert(edit.search_step(mut ed, w, true, 1), "second")
    let second = cur(ed)
    assert(second > first, "moved on")
    assert(edit.search_step(mut ed, w, false, 1), "N")
    assert(cur(ed) == first, "N comes back")
}

// `n` repeats in the SEARCH's direction.
fn t_searchui_n_is_relative_to_the_search_direction() {
    var ed = fixture()
    let w = ed.win
    su_search(mut ed, "needle", true)
    set_cur(mut ed, len_of(ed))
    let start = cur(ed)
    assert(edit.search_step(mut ed, w, true, 1), "n after ?")
    assert(cur(ed) < start, "went backwards")
    set_cur(mut ed, 0)
    assert(edit.search_step(mut ed, w, false, 1), "N after ?")
    assert(cur(ed) > 0, "went forwards")
}

fn t_searchui_count_repeats_the_step() {
    var ed = fixture()
    let w = ed.win
    su_search(mut ed, "line", false)
    set_cur(mut ed, 0)
    assert(edit.search_step(mut ed, w, true, 1), "one")
    let one = cur(ed)
    set_cur(mut ed, 0)
    su_search(mut ed, "line", false)
    assert(edit.search_step(mut ed, w, true, 3), "three")
    finish_preview(mut ed)
    assert(cur(ed) > one, "further")
}

fn t_searchui_wrap_continues_from_the_other_end() {
    var ed = fixture()
    let w = ed.win
    su_search(mut ed, "needle", false)
    set_cur(mut ed, len_of(ed) - 1)
    ed.search_opts.wrapscan = true
    assert(edit.search_step(mut ed, w, true, 1), "wrapped step")
    finish_preview(mut ed)
    assert(ed.search.wrapped, "wrapped")
    let b = ed.wins[w].buf
    assert(
        text.textbuf_line_of(ed.bufs[b].ec.tb, cur(ed) as text.ByteOff) as int == 5,
        "the first match",
    )
}

fn t_searchui_wrapscan_off_stops_at_the_end() {
    var ed = fixture()
    let w = ed.win
    su_search(mut ed, "needle", false)
    set_cur(mut ed, len_of(ed) - 1)
    let before = cur(ed)
    ed.search_opts.wrapscan = false
    assert(!edit.search_step(mut ed, w, true, 1), "no wrap")
    assert(cur(ed) == before, "did not move")
}

fn t_searchui_no_pattern_reports_rather_than_moving() {
    var ed = fixture()
    let w = ed.win
    let before = cur(ed)
    assert(!edit.search_step(mut ed, w, true, 1), "no pattern")
    assert(cur(ed) == before, "did not move")
}

// `*` quotes through the engine's own quoter.
fn t_searchui_word_search_quotes_metacharacters() {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    insert(mut ed, 0, bytes_of("axb\na.b\naxb\n"))
    place(mut ed)
    let w = ed.win
    set_cur(mut ed, 4)
    assert(edit.search_word(mut ed, w, true), "word search")
    assert(ed.search.count_timer != edit.TIMER_NONE, "count armed")
    assert(ed.search.count_win_id == ed.wins[w].id, "window id")
    edit.ed_timers_fire(mut ed, ed.now_ms + 16)
    assert(ed.wins[w].overlay.count_total == 1, "one match, got {ed.wins[w].overlay.count_total}")
    let slash = text.reg_get(mut ed.regs, 47) else |_| {
        assert(false, "register /")
        return
    }
    let pat = str_from_utf8(slash.bytes) else ""
    assert(pat.contains("\\"), "escaped")
    assert(pat.contains("\\."), "the dot escaped")
    assert(pat.starts_with("\\b"), "\\b-wrapped")
}

// A pattern that will not compile keeps the last good one.
fn t_searchui_bad_pattern_keeps_the_last_good_program() {
    var ed = fixture()
    let o = edit.search_opts_new()
    install(mut ed, "needle")
    ed.search.active = true
    let good_gen = ed.search.pat_gen
    var err = search.re_err_new()
    assert(!compiles(bytes_of("[a-"), o, mut err), "[a- refused")
    assert(err.msg.len != 0, "a message")
    assert(err.off <= 3, "the caret inside what was typed")
    assert(
        edit.search_has_re(ed) && ed.search.pat_gen == good_gen,
        "the last good program on record",
    )
}

fn t_searchui_literal_preview_continues_in_bounded_slices() {
    let chunk = 1048576
    let hit = chunk + 32
    var ed = large_fixture(chunk + 128, hit)
    let w = ed.win
    su_search(mut ed, "needle", false)
    set_cur(mut ed, 0)
    assert(edit.search_step(mut ed, w, true, 1), "step")
    assert(cur(ed) == 0, "not yet moved")
    assert(edit.search_preview_queued(ed), "queued")
    assert(ed.search.preview_win_id == ed.wins[w].id, "window id")
    assert(ed.search.preview_pending, "pending")
    assert(ed.msg.active, "searching message")
    finish_preview(mut ed)
    assert(cur(ed) == hit, "found")
    assert(!edit.search_preview_queued(ed), "not queued")
    assert(ed.search.preview_win_id == 0, "window retired")
    assert(!ed.search.preview_pending, "not pending")
    assert(!ed.msg.active, "message cleared")
}

fn t_searchui_preview_continuations_have_no_timer_delay() {
    let chunk = 1048576
    let hit = chunk * 6 + 32
    let len = hit + 96
    var ed = large_fixture(len, hit)
    let w = ed.win
    su_search(mut ed, "needle", false)
    set_cur(mut ed, 0)
    let started = ed.now_ms
    var turns = 0
    assert(edit.search_step(mut ed, w, true, 1), "step")
    assert(edit.search_preview_queued(ed), "queued")
    while edit.search_preview_queued(ed) {
        assert(turns < 8, "bounded turns")
        turns += 1
        assert(edit.loop_deadline(ed, ed.now_ms) == 0, "an immediate deadline")
        edit.search_preview_tick(mut ed)
        assert(ed.now_ms == started, "no clock")
    }
    assert(turns == 6, "six idle turns, got {turns}")
    assert(cur(ed) == hit, "found")
}

fn t_searchui_accept_resumes_pending_preview() {
    let chunk = 1048576
    let hit = chunk + 32
    var ed = large_fixture(chunk + 128, hit)
    let w = ed.win
    edit.search_open(mut ed, w, false)
    su_search(mut ed, "needle", false)
    set_cur(mut ed, 0)
    assert(edit.search_step(mut ed, w, true, 1), "step")
    assert(edit.search_preview_queued(ed), "queued")
    assert(ed.search.preview_pending, "pending")
    edit.search_preview_preempt(mut ed)
    assert(!edit.search_preview_queued(ed), "preempted")
    assert(ed.search.preview_pending, "still pending")
    edit.search_accept(mut ed, w)
    assert(edit.search_preview_queued(ed), "re-queued by accept")
    assert(ed.search.preview_win_id == ed.wins[w].id, "window id")
    assert(ed.search.preview_pending, "pending")
    edit.search_preview_tick(mut ed)
    assert(cur(ed) == hit, "found")
    assert(!edit.search_preview_queued(ed), "done")
    assert(!ed.search.preview_pending, "not pending")
}

fn t_searchui_literal_preview_finds_across_a_slice_edge() {
    let chunk = 1048576
    let hit = chunk - 2
    var ed = large_fixture(chunk + 64, hit)
    let w = ed.win
    su_search(mut ed, "needle", false)
    set_cur(mut ed, 0)
    assert(edit.search_step(mut ed, w, true, 1), "step")
    assert(cur(ed) == hit, "across the edge")
    assert(!edit.search_preview_queued(ed), "not queued")
}

fn t_searchui_backward_literal_finds_across_slice_edges() {
    let chunk = 1048576
    let back_window = 262144
    let hit = 128 + back_window - 2
    var ed = large_fixture(chunk + 128, hit)
    var w = ed.win
    su_search(mut ed, "needle", true)
    set_cur(mut ed, chunk + 128)
    assert(edit.search_step(mut ed, w, true, 1), "step back")
    assert(cur(ed) == hit, "across both edges")
    assert(!edit.search_preview_queued(ed), "not queued")
    var ed2 = large_fixture(chunk + 128, chunk - 2)
    w = ed2.win
    su_search(mut ed2, "needle", true)
    set_cur(mut ed2, chunk)
    assert(edit.search_step(mut ed2, w, true, 1), "step back at the edge")
    assert(cur(ed2) == chunk - 2, "a match starting before the edge")
    assert(!edit.search_preview_queued(ed2), "not queued")
}

fn t_searchui_counted_literal_continues_without_blocking() {
    let chunk = 1048576
    let late = chunk + 32
    var ed = large_fixture(chunk + 128, late)
    let w = ed.win
    insert(mut ed, 12, bytes_of("needle"))
    su_search(mut ed, "needle", false)
    set_cur(mut ed, 0)
    assert(edit.search_step(mut ed, w, true, 2), "step 2")
    assert(cur(ed) == 12, "the first")
    assert(ed.search.preview_pending, "pending")
    assert(edit.search_preview_queued(ed), "queued")
    finish_preview(mut ed)
    assert(cur(ed) == late + 6, "the second, got {cur(ed)}")
    assert(!ed.search.preview_pending, "done")
}

fn t_searchui_empty_input_retires_count_state() {
    var ed = fixture()
    let w = ed.win
    edit.search_open(mut ed, w, false)
    install(mut ed, "needle")
    edit.search_schedule_count(mut ed, w)
    ed.wins[w].overlay.count_total = 2
    ed.wins[w].overlay.count_capped = true
    edit.search_input(mut ed, w)
    assert(ed.search.count_timer == edit.TIMER_NONE, "timer retired")
    assert(ed.search.count_win_id == 0, "window retired")
    assert(ed.wins[w].overlay.count_total == 0, "count cleared")
    assert(!ed.wins[w].overlay.count_capped, "cap cleared")
}

fn t_searchui_new_literal_cancels_a_pending_preview() {
    let chunk = 1048576
    var ed = large_fixture(chunk + 128, chunk + 32)
    let w = ed.win
    insert(mut ed, 12, bytes_of("early"))
    su_search(mut ed, "needle", false)
    set_cur(mut ed, 0)
    assert(edit.search_step(mut ed, w, true, 1), "step")
    assert(edit.search_preview_queued(ed), "queued")
    su_search(mut ed, "early", false)
    assert(edit.search_step(mut ed, w, true, 1), "early step")
    assert(cur(ed) == 12, "early found")
    assert(!edit.search_preview_queued(ed), "the old preview gone")
    edit.search_preview_tick(mut ed)
    assert(cur(ed) == 12, "nothing stale moved it")
}

fn t_searchui_later_key_cancels_a_pending_preview() {
    let chunk = 1048576
    var ed = large_fixture(chunk + 128, chunk + 32)
    let w = ed.win
    su_search(mut ed, "needle", false)
    set_cur(mut ed, 0)
    assert(edit.search_step(mut ed, w, true, 1), "step")
    assert(edit.search_preview_queued(ed), "queued")
    var escape = term.key_new()
    escape.kind = term.EV_KEY
    escape.ev = term.KEY_PRESS
    escape.code = term.KEY_ESCAPE
    edit.ed_handle_key(mut ed, escape, ed.now_ms)
    assert(!edit.search_preview_queued(ed), "cancelled")
    assert(!ed.search.preview_pending, "not pending")
    assert(!ed.msg.active, "message gone")
    edit.search_preview_tick(mut ed)
    assert(cur(ed) == 0, "did not move")
}

// Invariant 4, from fuzz_re_compile's watchdog: a byte at a time through
// the prompt's own compile, each keystroke bounded by the pattern.
fn t_searchui_stacked_empty_repeats_compile_per_keystroke() {
    var ed = fixture()
    let o = edit.search_opts_new()
    var pats = List[List[byte]]()
    var a = List[byte]()
    (mut a).push(160 as byte)
    for x in "{{0}}{{110}}{{1000}}{{1,1000}}???".bytes() {
        (mut a).push(x)
    }
    var b = List[byte]()
    (mut b).push(129 as byte)
    for x in ",}}{{1,}}{{01,}}{{0}}{{110}}{{100}}{{110}}{{1000}}".bytes() {
        (mut b).push(x)
    }
    (mut pats).push(a)
    (mut pats).push(b)
    for p in pats {
        var typed = 1
        while typed <= p.len {
            var prefix = List[byte]()
            var i = 0
            while i < typed {
                (mut prefix).push(p[i])
                i += 1
            }
            var err = search.re_err_new()
            let _ = compiles(prefix, o, mut err)
            assert(err.walked <= 256, "walk {err.walked} at {typed}")
            typed += 1
        }
        var err = search.re_err_new()
        assert(compiles(p, o, mut err), "the whole pattern compiles")
    }
    let _ = ed.win
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_searchui_cancel_restores_cursor_goal_and_viewport()
    t_searchui_accept_commits_pattern_to_register()
    t_searchui_accept_retires_deferred_count()
    t_searchui_step_finds_successive_matches()
    t_searchui_n_is_relative_to_the_search_direction()
    t_searchui_count_repeats_the_step()
    t_searchui_wrap_continues_from_the_other_end()
    t_searchui_wrapscan_off_stops_at_the_end()
    t_searchui_no_pattern_reports_rather_than_moving()
    t_searchui_word_search_quotes_metacharacters()
    t_searchui_bad_pattern_keeps_the_last_good_program()
    t_searchui_stacked_empty_repeats_compile_per_keystroke()
    t_searchui_literal_preview_continues_in_bounded_slices()
    t_searchui_preview_continuations_have_no_timer_delay()
    t_searchui_accept_resumes_pending_preview()
    t_searchui_literal_preview_finds_across_a_slice_edge()
    t_searchui_backward_literal_finds_across_slice_edges()
    t_searchui_counted_literal_continues_without_blocking()
    t_searchui_empty_input_retires_count_state()
    t_searchui_new_literal_cancels_a_pending_preview()
    t_searchui_later_key_cancels_a_pending_preview()
    print("searchui_test: 21 cases pass")
}
