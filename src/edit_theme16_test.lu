//! member: false
//! Indexed syntax, unchanged UI roles, requested/active theme identity, and
//! the existing one-shot capability-probe seam. YEW_PICK_CASE selects 0..7.

use edit
use std.fs
use syn
use term

const FULL_ATTR_MASK: int = 18014398509481983 // The low 54 bits.

const EXPECTED: str = "7 13 13 14 13 11 11 11 11 11 11 10 10 14 14 10 2 6 11 14 14 14 14 7 9 7 9 14 13 11 13 14 7 7 7 9 11 15 14 7 15 10 13 2 10 9 9 11 9 13 14 11 14 8"

fn shipped(name: str) -> edit.Theme {
    let (found, src) = edit.runtime_embedded("themes/{name}.fl")
    assert(found, "embedded {name}")
    let bytes = src.bytes()
    let (ok, t, why) = edit.theme_compile(bytes)
    assert(ok, "{name}: {why}")
    t
}

fn same(a: edit.ThemeEnt, b: edit.ThemeEnt) -> bool {
    term.color_equal(a.fg, b.fg) && term.color_equal(a.bg, b.bg) && a.attrs == b.attrs
}

fn palette() {
    let t = shipped("quiver-16")
    let old = shipped("quiver-dark")
    let names = syn.syn_attr_names().words()
    let expected = EXPECTED.words()
    assert(t.name == "quiver-16" && t.has_name)
    assert(t.explicit_attrs == FULL_ATTR_MASK && names.len == 54 && expected.len == 54)
    for i in 0..54 {
        let index = expected[i].to_int() else -1
        assert(edit.theme_attr_id(names[i]) == i)
        for r in 0..edit.THEME_RENDITIONS {
            let e = edit.theme_attr(t, r, i)
            let before = edit.theme_attr(old, r, i)
            assert(e.attrs == before.attrs, "preserved flags {names[i]} rendition {r}")
            if r <= edit.THEME_16 {
                assert(
                    e.fg.tag == term.COLOR_INDEXED && e.fg.r == index,
                    "explicit pen {names[i]} rendition {r}",
                )
                assert(e.attrs & term.ATTR_DIM == 0, "no dim workaround {names[i]}")
                assert(e.bg.tag == term.COLOR_DEFAULT, "document background inherited")
            } else {
                assert(e.fg.tag == term.COLOR_DEFAULT && e.bg.tag == term.COLOR_DEFAULT)
            }
        }
        let e = edit.theme_attr(t, edit.THEME_16, i)
        print("STYLE {names[i]} {e.fg.tag} {e.fg.r} {e.attrs}")
    }
}

fn ui_unchanged() {
    let t = shipped("quiver-16")
    let old = shipped("quiver-dark")
    assert(t.ui.len == old.ui.len)
    for i in 0..t.ui.len {
        let role = t.ui[i].name
        assert(role == old.ui[i].name)
        for r in 0..edit.THEME_RENDITIONS {
            let (found, e) = edit.theme_ui(t, role, r)
            let (was_found, before) = edit.theme_ui(old, role, r)
            assert(found && was_found)
            if role != "fg" && role != "bg" {
                assert(same(e, before), "unchanged UI {role} rendition {r}")
            } else if r == edit.THEME_16 {
                assert(same(e, before), "unchanged sixteen-colour UI base {role}")
            }
        }
    }
    let (_, fg) = edit.theme_ui(t, "fg", edit.THEME_TRUECOLOR)
    let (_, bg) = edit.theme_ui(t, "bg", edit.THEME_TRUECOLOR)
    assert(fg.fg.tag == term.COLOR_INDEXED && fg.fg.r == 7)
    assert(bg.bg.tag == term.COLOR_INDEXED && bg.bg.r == 0)
}

fn resolved(vars: Map[str, str], probe_color: bool) -> str {
    var caps = term.caps_new()
    caps.truecolor = probe_color
    let r = term.render_new(caps, term.env_of(vars))
    edit.theme_resolve_name("auto", edit.theme_rendition_of(r))
}

fn selector_matrix() {
    var vars = Map[str, str]()
    vars["TERM"] = "linux"
    assert(resolved(vars, false) == "quiver-16")
    assert(resolved(vars, true) == "quiver-dark", "real capability beats TERM")
    vars["YEW_COLORS"] = "16"
    assert(resolved(vars, true) == "quiver-16", "override beats real capability")
    vars["YEW_COLORS"] = "truecolor"
    assert(resolved(vars, false) == "quiver-dark")
    vars["YEW_COLORS"] = "256"
    assert(resolved(vars, false) == "quiver-dark")
    vars["YEW_COLORS"] = "invalid"
    assert(resolved(vars, true) == "quiver-dark")
    vars["TERM"] = "xterm-256color"
    assert(resolved(vars, false) == "quiver-dark")
    vars["YEW_COLORS"] = "16"
    vars["NO_COLOR"] = ""
    assert(resolved(vars, true) == "quiver-dark", "empty NO_COLOR suppresses colour")
    vars["NO_COLOR"] = "1"
    assert(resolved(vars, false) == "quiver-dark")
    vars["TERM"] = "dumb"
    assert(resolved(vars, true) == "quiver-dark", "plain rendition stays plain")
    for r in 0..edit.THEME_RENDITIONS {
        for name in ["quiver-dark", "quiver-light", "quiver-16", "my-custom"] {
            assert(edit.theme_resolve_name(name, r) == name)
        }
    }
}

fn fixture() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    var vars = Map[str, str]()
    vars["TERM"] = "linux"
    ed.render = term.render_new(term.caps_new(), term.env_of(vars))
    ed.render_ready = true
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    ed
}

fn requested_active_atomic() {
    var ed = fixture()
    assert(ed.opts.theme == "auto" && edit.opt_global_str(ed, "theme") == "auto")
    edit.ed_theme_set(mut ed, "auto")
    assert(ed.theme.name == "quiver-16")
    assert(ed.opts.theme == "auto" && edit.opt_global_str(ed, "theme") == "auto")
    assert(ed.grid.blank.fg.tag == term.COLOR_INDEXED && ed.grid.blank.fg.r == 7)
    assert(ed.grid.blank.bg.tag == term.COLOR_INDEXED && ed.grid.blank.bg.r == 0)
    let why = edit.opt_set(mut ed, edit.OPT_SCOPE_DECLARED, "theme", edit.optv_str("../invalid"))
    assert(why.len != 0 && ed.theme.name == "quiver-16")
    assert(ed.opts.theme == "auto" && edit.opt_global_str(ed, "theme") == "auto")
    edit.ed_theme_set(mut ed, "quiver-dark")
    assert(ed.theme.name == "quiver-dark" && ed.opts.theme == "quiver-dark")
    edit.ed_theme_set(mut ed, "quiver-light")
    assert(ed.theme.name == "quiver-light" && ed.opts.theme == "quiver-light")
    edit.ed_theme_set(mut ed, "auto")
    assert(ed.theme.name == "quiver-16" && ed.opts.theme == "auto")
    let policy = edit.opt_get(ed, -1, -1, "theme_auto") else edit.optv_bool(true)
    assert(!policy.b, "unrelated background policy untouched")
}

fn probe_env() {
    env_set("TERM", "linux") else { assert(false, "set TERM") }
    env_unset("YEW_COLORS") else {}
    env_unset("NO_COLOR") else {}
}

fn probe_noop() {
    probe_env()
    var ed = fixture()
    edit.ed_theme_set(mut ed, "auto")
    ed.theme.explicit_attrs = -123
    term.probe_arm(mut ed.tty, 0, term.ProbeConfig { enabled: false, timeout_ms: 1 }, false)
    edit.loop_seed_probe(mut ed)
    assert(ed.probe_seeded)
    assert(
        ed.theme.name == "quiver-16" && ed.theme.explicit_attrs == -123,
        "same resolved identity does not compile again",
    )
    edit.loop_seed_probe(mut ed)
    assert(ed.theme.explicit_attrs == -123, "one-shot seam stays one-shot")
}

fn probe_upgrade() {
    probe_env()
    var ed = fixture()
    edit.ed_theme_set(mut ed, "auto")
    assert(ed.theme.name == "quiver-16")
    term.probe_arm(mut ed.tty, 0, term.ProbeConfig { enabled: false, timeout_ms: 1 }, true)
    edit.loop_seed_probe(mut ed)
    assert(ed.theme.name == "quiver-dark" && ed.opts.theme == "auto")
    assert(edit.opt_global_str(ed, "theme") == "auto")
    assert(edit.theme_rendition_of(ed.render) == edit.THEME_TRUECOLOR)
}

fn literal(name: str, attrs: str) -> str {
    "{{theme: 1, name: \"{name}\", kind: \"dark\", palette: {{}}, " +
        "ui: {{ul: {{error: {{idx: 9}}, warn: {{idx: 11}}, info: {{idx: 14}}}}}}, attrs: " +
        attrs +
        "}}"
}

fn known_parent_unknown_rejected() {
    let src = literal("inherit", "{{keyword: {{fg: {{idx: 13}}}}}}")
    let bytes = src.bytes()
    let (ok, t, why) = edit.theme_compile(bytes)
    assert(ok, why)
    let child = edit.theme_attr(t, edit.THEME_16, edit.theme_attr_id("keyword.control"))
    assert(child.fg.tag == term.COLOR_INDEXED && child.fg.r == 13)
    let unknown = literal("unknown", "{{not_registered: {{fg: {{idx: 13}}}}}}")
    let unknown_bytes = unknown.bytes()
    let (bad, _, _) = edit.theme_compile(unknown_bytes)
    assert(!bad, "unknown attrs still rejected")
}

fn xdg_reload() {
    let base = env_get("TMPDIR") else "target"
    let root = "{base}/theme16-xdg"
    let dir = "{root}/yew/themes"
    fs.create_dir_all(dir) else { assert(false, "create theme fixture") }
    let (old, present) = term.env_getv("XDG_CONFIG_HOME")
    env_set("XDG_CONFIG_HOME", root) else { assert(false, "set XDG root") }
    fs.write_text("{dir}/auto.fl", "this must not be loaded") else { assert(false) }
    let first = literal("quiver-16", "{{boolean: {{fg: {{idx: 9}}, bold: true}}}}")
    fs.write_text("{dir}/quiver-16.fl", first) else { assert(false) }
    var ed = fixture()
    edit.ed_theme_set(mut ed, "auto")
    let boolean = edit.theme_attr_id("boolean")
    assert(
        ed.theme.name == "quiver-16" && edit.theme_attr(ed.theme, edit.THEME_16, boolean).fg.r == 9,
    )
    let second = literal("quiver-16", "{{boolean: {{fg: {{idx: 10}}, bold: true}}}}")
    fs.write_text("{dir}/quiver-16.fl", second) else { assert(false) }
    edit.ed_theme_set(mut ed, "auto")
    assert(
        edit.theme_attr(ed.theme, edit.THEME_16, boolean).fg.r == 10,
        "explicit same requested theme rereads XDG override",
    )
    fs.write_text("{dir}/quiver-16.fl", "not a theme") else { assert(false) }
    let why = edit.opt_set(mut ed, edit.OPT_SCOPE_DECLARED, "theme", edit.optv_str("auto"))
    assert(why.len != 0 && ed.opts.theme == "auto" && edit.opt_global_str(ed, "theme") == "auto")
    assert(edit.theme_attr(ed.theme, edit.THEME_16, boolean).fg.r == 10, "failed reload is atomic")
    if present {
        env_set("XDG_CONFIG_HOME", old) else { assert(false) }
    } else {
        env_unset("XDG_CONFIG_HOME") else {}
    }
}

fn main() {
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    if chosen < 0 || chosen == 0 { palette(); print("theme16-palette: PASS") }
    if chosen < 0 || chosen == 1 { ui_unchanged(); print("theme16-ui-unchanged: PASS") }
    if chosen < 0 || chosen == 2 { selector_matrix(); print("theme16-selector-matrix: PASS") }
    if chosen < 0 || chosen == 3 {
        requested_active_atomic()
        print("theme16-request-active-atomic: PASS")
    }
    if chosen < 0 || chosen == 4 { probe_noop(); print("theme16-probe-noop: PASS") }
    if chosen < 0 || chosen == 5 { probe_upgrade(); print("theme16-probe-upgrade: PASS") }
    if chosen < 0 || chosen == 6 {
        known_parent_unknown_rejected()
        print("theme16-registered-parent: PASS")
    }
    if chosen < 0 || chosen == 7 { xdg_reload(); print("theme16-xdg-reload: PASS") }
    assert(chosen <= 8, "unknown theme16 case")
}
