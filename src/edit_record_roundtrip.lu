        "ed.edit.insert.after" => "insert-mode transaction is not mode-closed",
        "ed.edit.line.open_below" => "insert-mode transaction is not mode-closed",
        "ed.edit.line.open_above" => "insert-mode transaction is not mode-closed",
        "ed.edit.delete.grapheme_left" => "redundant delete alias",
        "ed.edit.delete.grapheme" => "redundant delete alias",
        "ed.edit.line.delete" => "line register semantics need a seeded paste command",
