        "ed.move.buf.home" => "redundant motion alias",
        "ed.move.line.up" => "redundant motion alias",
        "ed.move.line.down" => "redundant motion alias",
        "ed.move.line.first_nonblank" => "redundant motion alias",
        "ed.move.line.last_nonblank" => "redundant motion alias",
        "ed.move.line.half_page_up" => "viewport geometry is outside E0",
        "ed.move.line.half_page_down" => "viewport geometry is outside E0",
        "ed.move.unit.home" => "redundant motion alias",
        "ed.move.unit.end" => "redundant motion alias",
        "ed.move.unit.home_alt" => "redundant motion alias",
        "ed.move.unit.end_alt" => "redundant motion alias",
        "ed.move.block.match_prev" => "delimiter precondition is fixture-specific",
        "ed.move.block.match_next" => "delimiter precondition is fixture-specific",
        "ed.move.word.sub_prev" => "redundant motion alias",
        "ed.move.word.sub_next" => "redundant motion alias",
        "ed.move.char.prev" => "redundant motion alias",
        "ed.move.char.next" => "redundant motion alias",
        "ed.move.char.left" => "redundant motion alias",
        "ed.move.char.right" => "redundant motion alias",
