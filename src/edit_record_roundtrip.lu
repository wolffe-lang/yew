//! member: false
//! The round-trip law's runner (Sprint 35, R-yw09-1 A): sagitta 9ace98c2
//! tests/roundtrip/runner.c (1,235 lines) and gen.c (590) as one port-side
//! driver. C's runner links the editor in-process and takes no binary, so
//! the port runs C's generator — the same xorshift64 stream, command
//! table, highlight scenarios, payloads and count rolls — at C's 2,000
//! seeds over its six fixtures, its four fixed fixtures, the count-folding
//! sentinel and the recorder corpus, and prints C's report line byte for
//! byte. P1 replay reaches the recorded state, P2 one undo restores E0,
//! P3 emission is deterministic, P4 the source parses to one AST twice,
//! P5 S;S composes. Run from the pinned oracle tree, as C's `make
//! test-roundtrip` runs from sagitta's: `runtime/init.fl` and
//! `tests/corpus/recorder/*.rec` are read relative to it.
//!
//! The port's shapes. C's session storage is each event's own byte list;
//! a prefix view is a copy truncated to the prefix. C's
//! `yew_reg_bind_context` has no counterpart (the port binds `.` and `%`
//! on the read, `text.reg_get_in`), and neither editor of a comparison
//! reads them through a context, so the raw slots compare as C's.

use edit
use fl
use term
use text
use util

// gen.c:9-16.
const RT_GEN_MOTION: int = 0

const RT_GEN_INSERT: int = 1

const RT_GEN_DELETE: int = 2

const RT_GEN_MODE: int = 3

const RT_GEN_SELECTION: int = 4

const RT_GEN_YANK: int = 5

struct RtGenCmd { name: str, kind: int }

// gen.c:30-61: intentionally small, not silently permissive.
fn gen_cmds() -> List[RtGenCmd] {
    [
        RtGenCmd { name: "ed.move.unit.next", kind: RT_GEN_MOTION },
        RtGenCmd { name: "ed.move.unit.prev", kind: RT_GEN_MOTION },
        RtGenCmd { name: "ed.move.unit.up", kind: RT_GEN_MOTION },
        RtGenCmd { name: "ed.move.unit.down", kind: RT_GEN_MOTION },
        RtGenCmd { name: "ed.move.unit.next_alt", kind: RT_GEN_MOTION },
        RtGenCmd { name: "ed.move.unit.prev_alt", kind: RT_GEN_MOTION },
        RtGenCmd { name: "ed.move.buf.end", kind: RT_GEN_MOTION },
        RtGenCmd { name: "ed.move.line.home", kind: RT_GEN_MOTION },
        RtGenCmd { name: "ed.move.line.home_toggle", kind: RT_GEN_MOTION },
        RtGenCmd { name: "ed.move.word.prev", kind: RT_GEN_MOTION },
        RtGenCmd { name: "ed.move.word.next", kind: RT_GEN_MOTION },
        RtGenCmd { name: "ed.move.line.end", kind: RT_GEN_MOTION },
        RtGenCmd { name: "ed.edit.insert.text", kind: RT_GEN_INSERT },
        RtGenCmd { name: "ed.edit.insert.at", kind: RT_GEN_INSERT },
        RtGenCmd { name: "ed.edit.delete.unit", kind: RT_GEN_DELETE },
        RtGenCmd { name: "ed.edit.delete.span", kind: RT_GEN_DELETE },
        RtGenCmd { name: "ed.edit.replace.span", kind: RT_GEN_INSERT },
        RtGenCmd { name: "ed.mode.enter", kind: RT_GEN_MODE },
        RtGenCmd { name: "ed.mode.escape", kind: RT_GEN_SELECTION },
        RtGenCmd { name: "ed.sel.expand", kind: RT_GEN_SELECTION },
        RtGenCmd { name: "ed.sel.extend.left", kind: RT_GEN_SELECTION },
        RtGenCmd { name: "ed.sel.extend.right", kind: RT_GEN_SELECTION },
        RtGenCmd { name: "ed.sel.extend.up", kind: RT_GEN_SELECTION },
        RtGenCmd { name: "ed.sel.extend.down", kind: RT_GEN_SELECTION },
        RtGenCmd { name: "ed.sel.extend.word_prev", kind: RT_GEN_SELECTION },
        RtGenCmd { name: "ed.sel.extend.word_next", kind: RT_GEN_SELECTION },
        RtGenCmd { name: "ed.sel.extend.line_home", kind: RT_GEN_SELECTION },
        RtGenCmd { name: "ed.sel.extend.line_end", kind: RT_GEN_SELECTION },
        RtGenCmd { name: "ed.sel.all", kind: RT_GEN_SELECTION },
        RtGenCmd { name: "ed.sel.yank", kind: RT_GEN_YANK },
    ]
}

// RtEvent (gen.h:10-18): the string argument is the event's own bytes.
struct RtEvent {
    cmd: int,
    count: int,
    count_given: bool,
    iarg: int,
    range_given: bool,
    sarg: List[byte],
}

// RtSession (gen.h:22-31).
struct RtSession {
    events: List[RtEvent],
    seed: wrapping[u64],
    fixture: int,
    generated_len: int,
    start_mode: int,
}

fn rt_session_new() -> RtSession {
    RtSession {
        events: List[RtEvent](),
        seed: 0,
        fixture: 0,
        generated_len: 0,
        start_mode: edit.MODE_L,
    }
}

// The registry the generator resolves names against: C's static one.
// The last failure's property and detail are bytes the world owns, reset
// and refilled, so a session's region can write them ([mem.region.outer-write]).
struct RtWorld { reg: edit.CmdReg, quiet: bool, property: List[byte], detail: List[byte] }

fn set_bytes(mut out: List[byte], s: str) {
    (mut out).reset()
    for b in s.bytes() { (mut out).push(b) }
}

// xorshift64 (gen.c:63-74).
fn xorshift64(mut state: wrapping[u64]) -> wrapping[u64] {
    var x = state
    if x == 0 { x = 11400714819323198485 }
    x = x ^ x << 13
    x = x ^ x >> 7
    x = x ^ x << 17
    state = x
    x
}

// rnd (gen.c:76-79).
fn rnd(mut state: wrapping[u64], n: int) -> int {
    if n == 0 { return 0 }
    (xorshift64(mut state) % n as wrapping[u64]) as int
}

fn rt_event(cmd: int) -> RtEvent {
    RtEvent {
        cmd: cmd,
        count: 1,
        count_given: false,
        iarg: 0,
        range_given: false,
        sarg: List[byte](),
    }
}

fn cmd_id(w: RtWorld, name: str) -> int { edit.cmd_lookup(w.reg, name) }

// choose_cmd (gen.c:117-136).
fn choose_cmd(mut state: wrapping[u64]) -> RtGenCmd {
    let cmds = gen_cmds()
    let roll = rnd(mut state, 100)
    let want = if roll < 45 {
        RT_GEN_MOTION
    } else if roll < 65 {
        RT_GEN_INSERT
    } else if roll < 77 {
        RT_GEN_DELETE
    } else if roll < 87 {
        RT_GEN_SELECTION
    } else if roll < 95 {
        RT_GEN_YANK
    } else {
        RT_GEN_MODE
    }
    let start = rnd(mut state, cmds.len)
    for i in 0..cmds.len {
        let c = copy cmds[(start + i) % cmds.len]
        if c.kind == want { return c }
    }
    copy cmds[0]
}

// append_named (gen.c:138-155).
fn append_named(w: RtWorld, mut s: RtSession, name: str, sarg: List[byte]) -> bool {
    var ev = rt_event(cmd_id(w, name))
    ev.sarg = copy sarg
    if ev.cmd == 0 { return false }
    (mut s.events).push(ev)
    true
}

// rt_session_init_count_folding (gen.c:157-187).
fn rt_session_count_folding(w: RtWorld, length: int) -> RtSession ! {none} {
    var s = rt_session_new()
    if length < 3 { return none }
    s.seed = 5999154533053582932
    s.fixture = 2
    s.generated_len = length
    s.start_mode = edit.MODE_L
    let x = copy "x".bytes()
    if !append_named(w, mut s, "ed.move.buf.end", List[byte]()) ||
        !append_named(w, mut s, "ed.move.buf.end", List[byte]()) ||
        !append_named(w, mut s, "ed.edit.insert.text", x) {
        return none
    }
    for i in 3..length {
        let name = if i & 1 == 0 then "ed.move.unit.next" else "ed.move.unit.prev"
        if !append_named(w, mut s, name, List[byte]()) { return none }
    }
    s
}

// is_shift_extend (gen.c:189-195).
fn is_shift_extend(gc: RtGenCmd) -> bool { gc.name.starts_with("ed.sel.extend.") }

fn highlight_scenario_len(gc: RtGenCmd) -> int { if is_shift_extend(gc) then 2 else 4 }

// append_highlight_scenario (gen.c:202-216).
fn append_highlight_scenario(w: RtWorld, mut s: RtSession, gc: RtGenCmd) -> bool {
    let none_arg = List[byte]()
    if is_shift_extend(gc) {
        return append_named(w, mut s, gc.name, none_arg) &&
            append_named(w, mut s, "ed.mode.escape", none_arg)
    }
    let h = copy "H".bytes()
    append_named(w, mut s, "ed.mode.enter", h) &&
        append_named(w, mut s, "ed.move.unit.next", none_arg) &&
        append_named(
            w,
            mut s,
            if gc.kind == RT_GEN_YANK then "ed.sel.yank" else gc.name,
            none_arg,
        ) &&
        append_named(w, mut s, "ed.mode.escape", none_arg)
}

// gen.c:221-235: ASCII, CJK, a ZWJ sequence, a combining mark, invalid.
fn payload(p: int) -> List[byte] {
    match p {
        0 => [120 as byte],
        1 => [231 as byte, 140 as byte, 171 as byte],
        2 =>
            [
                240 as byte,
                159 as byte,
                145 as byte,
                169 as byte,
                226 as byte,
                128 as byte,
                141 as byte,
                240 as byte,
                159 as byte,
                146 as byte,
                187 as byte,
            ],
        3 => [101 as byte, 204 as byte, 129 as byte],
        _ => [128 as byte],
    }
}

fn mode_letter(i: int) -> List[byte] {
    match i {
        0 => [76 as byte],
        1 => [87 as byte],
        _ => [66 as byte],
    }
}

// append_generated (gen.c:218-282).
fn append_generated(w: RtWorld, mut s: RtSession, mut state: wrapping[u64], gc: RtGenCmd) -> bool {
    var ev = rt_event(cmd_id(w, gc.name))
    if ev.cmd == 0 { return false }
    let flags = w.reg.entries[ev.cmd - 1].flags
    if gc.kind == RT_GEN_INSERT {
        let p = rnd(mut state, 5)
        ev.sarg = payload(p)
        if gc.name == "ed.edit.insert.at" { ev.iarg = 0 }
        if gc.name == "ed.edit.replace.span" { ev.range_given = true }
    } else if gc.name == "ed.edit.delete.span" {
        // The empty span is valid for every fixture (gen.c:258-263).
        ev.range_given = true
    } else if gc.kind == RT_GEN_MODE {
        ev.sarg = mode_letter(rnd(mut state, 3))
    } else if flags & (edit.CMD_REPEATABLE | edit.CMD_TAKES_COUNT) != 0 {
        let count_roll = rnd(mut state, 100)
        if count_roll >= 60 {
            ev.count_given = true
            ev.count = if count_roll < 90 then 2 + rnd(mut state, 8) else 10 + rnd(mut state, 90)
        }
    }
    (mut s.events).push(ev)
    true
}

// rt_session_generate (gen.c:284-348).
fn rt_session_generate(
    w: RtWorld,
    seed: wrapping[u64],
    fixture: int,
    forced_len: int,
) -> RtSession ! {none} {
    var s = rt_session_new()
    let mult: wrapping[u64] = 15111065706836454659
    var state: wrapping[u64] = seed ^ mult * (fixture + 1) as wrapping[u64]
    let target = if forced_len == 0 then 1 + rnd(mut state, 200) else forced_len
    var has_text_insert = false
    s.seed = seed
    s.fixture = fixture % 6
    s.generated_len = target
    s.start_mode = edit.MODE_L + rnd(mut state, 3)
    let cmds = gen_cmds()
    while s.events.len + (if has_text_insert then 1 else 2) < target {
        let chosen = choose_cmd(mut state)
        let reserve = if has_text_insert then 1 else 2
        let available = target - s.events.len - reserve
        let selecting = chosen.kind == RT_GEN_SELECTION || chosen.kind == RT_GEN_YANK
        if selecting && available >= highlight_scenario_len(chosen) {
            if !append_highlight_scenario(w, mut s, chosen) { return none }
        } else {
            let one = if selecting then copy cmds[0] else copy chosen
            if !append_generated(w, mut s, mut state, one) { return none }
            if one.name == "ed.edit.insert.text" { has_text_insert = true }
        }
    }
    // P2 needs an actual edit even when the session chose motions.
    if !has_text_insert {
        let insert = RtGenCmd { name: "ed.edit.insert.text", kind: RT_GEN_INSERT }
        if !append_generated(w, mut s, mut state, insert) { return none }
    }
    // P5 composes S with itself: restore the starting unit (gen.c:327-346).
    if s.events.len < target {
        var restore = rt_event(cmd_id(w, "ed.mode.enter"))
        restore.sarg = mode_letter(s.start_mode - edit.MODE_L)
        (mut s.events).push(restore)
    }
    if s.events.len != target { return none }
    s
}

