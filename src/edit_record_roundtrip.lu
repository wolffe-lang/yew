fn is_generated(name: str) -> bool {
    for c in gen_cmds() { if c.name == name { return true } }
    false
}

// rt_generator_coverage (gen.c:553-590): the word bijection over every
// recordable command, and each one generated or denied with a reason.
fn rt_generator_coverage(reg: edit.CmdReg, verbose: bool) -> bool {
    var ok = true
    for i in 0..reg.entries.len {
        if !reg.entries[i].active || reg.entries[i].flags & edit.CMD_RECORDABLE == 0 { continue }
        let name = reg.entries[i].name
        let id = edit.cmd_lookup(reg, name)
        let back = if reg.entries[i].has_word then edit.cmd_by_word(reg, reg.entries[i].word) else 0
        if id == 0 || back != id {
            let word = if reg.entries[i].has_word then reg.entries[i].word else "<null>"
            eprint("roundtrip: word bijection failed: {name} -> {word}")
            ok = false
        }
        if is_generated(name) {
            if verbose { print("generate {name}") }
            continue
        }
        let reason = deny_reason(name)
        if reason.len == 0 {
            eprint("roundtrip: uncovered command: {name}")
            ok = false
        } else if verbose {
            print("deny {name}: {reason}")
        }
    }
    ok
}

// ---- the runner -------------------------------------------------------------

fn fail_session(mut w: RtWorld, property: str, detail: str) -> bool {
    set_bytes(mut w.property, property)
    set_bytes(mut w.detail, detail)
    false
}

fn bytes_equal(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

// first_byte_difference (runner.c:101-110): -1 is C's SIZE_MAX.
fn first_byte_difference(a: List[byte], b: List[byte]) -> int {
    let n = if a.len < b.len then a.len else b.len
    for i in 0..n { if a[i] != b[i] { return i } }
    if a.len == b.len then -1 else n
}

// fixture_make (runner.c:112-146).
fn fixture_make(fixture: int) -> List[byte] {
    var out = List[byte]()
    match fixture % 6 {
        0 => {},
        1 => util.buf_append_str(mut out, "alpha beta gamma\n"),
        2 => {
            for i in 0..10000 {
                var digits = "{i}"
                while digits.len < 5 { digits = "0{digits}" }
                util.buf_append_str(mut out, "line-{digits} payload\n")
            }
        },
        3 => util.buf_append_str(mut out, "one\r\ntwo\r\nthree\r\n"),
        4 => util.buf_append_str(mut out, "no final newline"),
        _ => {
            for b in [0, 128, 97, 10, 255, 122, 13, 10] { (mut out).push(b as byte) }
        },
    }
    out
}

// editor_open (runner.c:148-168): the fixture inserted outside the undo
// tree, a fresh tree over it, the caret at 0, the starting unit entered.
fn editor_open(fixture: List[byte], mode: int) -> edit.Ed ! {none} {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    if fixture.len != 0 { text.textbuf_insert(mut ed.bufs[0].ec.tb, text.byteoff(0), fixture) }
    let fresh = text.undo_new(ed.bufs[0].ec.tb)
    ed.bufs[0].ec.undo = fresh
    let w = ed.win
    if w < 0 || ed.wins[w].cs.curs.len == 0 { return none }
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].pos = 0
    ed.wins[w].cs.curs[p].anchor = 0
    ed.wins[w].cs.curs[p].goal_col = 0
    if edit.mode_enter(mut ed, mode) != edit.CMD_OK { return none }
    ed
}

// load_runtime_keymap (runner.c:170-198): runtime/init.fl inside one bind
// batch, relative to the working directory.
fn load_runtime_keymap(mut ed: edit.Ed) -> bool {
    let source = fs_read_bytes("runtime/init.fl") else { return false }
    edit.bind_batch_begin(mut ed)
    let ok = edit.fl_runtime_eval(mut ed, source) == edit.CMD_OK
    edit.bind_batch_end(mut ed)
    ok
}

fn rt_text_key(ch: int) -> term.Key {
    var key = term.key_new()
    key.code = ch
    key.kind = term.EV_KEY
    key.ev = term.KEY_PRESS
    (mut key.text).push(ch as byte)
    key
}

fn rt_named_key(code: int) -> term.Key {
    var key = term.key_new()
    key.code = code
    key.kind = term.EV_KEY
    key.ev = term.KEY_PRESS
    key
}

fn dispatch_ok(mut ed: edit.Ed, key: term.Key, now_ms: int) -> bool {
    edit.dispatch_key(mut ed, key, now_ms)
    ed.last_status == edit.CMD_OK
}

// invoke_event (runner.c:228-242).
fn invoke_event(mut ed: edit.Ed, ev: RtEvent) -> bool {
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    cx.count = ev.count
    cx.count_given = ev.count_given
    cx.iarg = ev.iarg
    cx.range.given = ev.range_given
    cx.range.tok_lo = 0
    cx.range.tok_hi = 0
    if ev.sarg.len != 0 {
        cx.has_sarg = true
        cx.has_sbytes = true
        cx.sbytes = copy ev.sarg
        cx.sarg = str_from_utf8(ev.sarg) else ""
    }
    edit.ed_cmd_invoke(mut ed, ev.cmd, mut cx) == edit.CMD_OK
}

// run_events (runner.c:244-260).
fn run_events(w: RtWorld, mut ed: edit.Ed, s: RtSession) -> bool {
    for i in 0..s.events.len {
        if !invoke_event(mut ed, s.events[i]) {
            if !w.quiet {
                let id = s.events[i].cmd
                let name = if id > 0 && id <= w.reg.entries.len {
                    w.reg.entries[id - 1].name
                } else {
                    "<unknown>"
                }
                eprint("roundtrip: event {i} failed: {name}")
            }
            return false
        }
    }
    true
}

// regval_equal (runner.c:262-276).
fn regval_equal(a: text.RegVal, b: text.RegVal) -> bool {
    if a.kind != b.kind ||
        a.ragged != b.ragged ||
        a.width != b.width ||
        !bytes_equal(a.bytes, b.bytes) ||
        a.rows.len != b.rows.len {
        return false
    }
    for i in 0..a.rows.len {
        if a.rows[i].lo != b.rows[i].lo || a.rows[i].hi != b.rows[i].hi { return false }
    }
    true
}

// registers_equal (runner.c:278-305): the raw slots, the ring's first
// `ring_len` entries as C indexes them.
fn registers_equal(a: text.Registers, b: text.Registers) -> bool {
    for i in 0..26 { if !regval_equal(a.named[i], b.named[i]) { return false } }
    for i in 0..10 { if !regval_equal(a.numbered[i], b.numbered[i]) { return false } }
    if !regval_equal(a.unnamed, b.unnamed) ||
        !regval_equal(a.small_del, b.small_del) ||
        !regval_equal(a.last_insert, b.last_insert) ||
        !regval_equal(a.search, b.search) ||
        !regval_equal(a.cmdline, b.cmdline) ||
        !regval_equal(a.file, b.file) ||
        !regval_equal(a.alt_file, b.alt_file) ||
        !regval_equal(a.system, b.system) ||
        a.ring_len != b.ring_len {
        return false
    }
    for i in 0..a.ring_len { if !regval_equal(a.ring[i], b.ring[i]) { return false } }
    true
}

// cursors_equal (runner.c:307-322).
fn cursors_equal(a: edit.Ed, b: edit.Ed) -> bool {
    let ca = a.wins[a.win].cs
    let cb = b.wins[b.win].cs
    if ca.primary != cb.primary || ca.curs.len != cb.curs.len { return false }
    for i in 0..ca.curs.len {
        if ca.curs[i].pos != cb.curs[i].pos ||
            ca.curs[i].anchor != cb.curs[i].anchor ||
            ca.curs[i].goal_col != cb.curs[i].goal_col {
            return false
        }
    }
    true
}

// editors_equal (runner.c:324-353): "" when equal, else why.
fn editors_differ(a: edit.Ed, b: edit.Ed) -> str {
    let ab = text.textbuf_bytes(a.bufs[0].ec.tb)
    let bb = text.textbuf_bytes(b.bufs[0].ec.tb)
    if !bytes_equal(ab, bb) { return "buffer bytes differ" }
    if !cursors_equal(a, b) { return "cursor set differs" }
    if !registers_equal(a.regs, b.regs) { return "register file differs" }
    if a.mode != b.mode || a.prev_unit != b.prev_unit { return "mode differs" }
    ""
}

// install_macro (runner.c:355-365).
fn install_macro(mut ed: edit.Ed, source: List[byte]) {
    var value = text.regval_new()
    value.kind = text.REG_CHARWISE
    value.bytes = copy source
    text.reg_set_macro(mut ed.regs, 'a' as int, value, false)
}

// parse_dump (runner.c:386-412): a clean parse's AST dump, none on any
// diagnostic.
fn parse_dump(w: RtWorld, source: List[byte]) -> List[byte] ! {none} {
    var dc = fl.fl_diag_init()
    var strings = fl.fl_strings()
    let file = fl.fl_diag_add_file(mut dc, "roundtrip.fl", source)
    let p = fl.fl_parse(source, file, mut dc, mut strings)
    if p.had_error || dc.entries.len != 0 {
        if !w.quiet {
            let first = if dc.entries.len == 0 then "" else dc.entries[0].msg
            eprint("roundtrip: parse diagnostic: {first}")
        }
        return none
    }
    var dump = List[byte]()
    fl.fl_ast_dump(mut dump, p, strings)
    dump
}

fn stored_macro(mut ed: edit.Ed) -> List[byte] ! {none} {
    let v = text.reg_get(mut ed.regs, 'a' as int)?
    copy v.bytes
}

fn one_undo(mut ed: edit.Ed) -> bool {
    let w = ed.win
    let b = ed.wins[w].buf
    edit.edit_take(mut ed, w)
    let ok = text.undo(mut ed.bufs[b].ec)
    edit.edit_give(mut ed, w)
    ok
}

fn stderr_bytes(b: List[byte]) {
    fs_write_chunk(2, b) else |_| {}
    fs_write_chunk(2, [10 as byte]) else |_| {}
}

// property_session (runner.c:414-549): P3, P4, P1, P2, P5 in C's order.
fn property_session(mut w: RtWorld, s: RtSession) -> bool {
    let fixture = fixture_make(s.fixture)
    var why = "unknown divergence"
    let ok = property_body(mut w, s, fixture, mut why)
    if !w.quiet && !ok && why.len != 0 { eprint("roundtrip: context: {why}") }
    ok
}

fn property_body(mut w: RtWorld, s: RtSession, fixture: List[byte], mut why: str) -> bool {
    var recorded = editor_open(fixture, s.start_mode) else { return false }
    if !edit.record_start(mut recorded, 'a' as int) ||
        !run_events(w, mut recorded, s) ||
        edit.record_stop(mut recorded) != edit.CMD_OK {
        return false
    }
    let emitted_a = stored_macro(mut recorded) else { return false }
    // P3: emission is a pure deterministic rendering of the retained Rec.
    let emitted_b = edit.record_emit(recorded.reg, recorded.rec)
    if !bytes_equal(emitted_a, emitted_b) {
        return fail_session(mut w, "P3", "second emission differs")
    }
    // P4: the source parses cleanly and two independent AST dumps agree.
    let dump_a = parse_dump(w, emitted_a) else {
        let _ = fail_session(mut w, "P4", "emitted Fletch does not parse")
        if !w.quiet { stderr_bytes(emitted_a) }
        return false
    }
    let dump_b = parse_dump(w, emitted_a) else {
        return fail_session(mut w, "P4", "second parse does not parse")
    }
    if !bytes_equal(dump_a, dump_b) {
        return fail_session(mut w, "P4", "AST dump is not deterministic")
    }
    // P1: replay from the same E0 reaches the same observable state.
    var replayed = editor_open(fixture, s.start_mode) else { return false }
    install_macro(mut replayed, emitted_a)
    if edit.macro_replay(mut replayed, 'a' as int, 1) != edit.CMD_OK { return false }
    let d1 = editors_differ(recorded, replayed)
    if d1.len != 0 {
        why = d1
        return fail_session(mut w, "P1", d1)
    }
    // P2: replay is one outer transaction, so one undo restores E0.
    if !one_undo(mut replayed) ||
        !bytes_equal(text.textbuf_bytes(replayed.bufs[0].ec.tb), fixture) {
        let _ = fail_session(mut w, "P2", "one undo did not restore E0 bytes")
        if !w.quiet { stderr_bytes(emitted_a) }
        return false
    }
    // P5: no hidden state across a second mode-closed invocation.
    var direct_twice = editor_open(fixture, s.start_mode) else { return false }
    if !edit.record_start(mut direct_twice, 'a' as int) ||
        !run_events(w, mut direct_twice, s) ||
        edit.record_stop(mut direct_twice) != edit.CMD_OK ||
        !run_events(w, mut direct_twice, s) {
        return false
    }
    var replayed_twice = editor_open(fixture, s.start_mode) else { return false }
    install_macro(mut replayed_twice, emitted_a)
    if edit.macro_replay(mut replayed_twice, 'a' as int, 2) != edit.CMD_OK { return false }
    let d5 = editors_differ(direct_twice, replayed_twice)
    if d5.len != 0 {
        why = d5
        return fail_session(mut w, "P5", d5)
    }
    true
}

// run_edit_store_noop_fixture (runner.c:551-643): recorder output is
// editable Fletch; two edits with no net effect leave the stored source
// and its AST unchanged through the real edit/store path.
fn run_edit_store_noop_fixture(w: RtWorld) -> bool {
    let ok = edit_store_noop(w)
    if !ok { eprint("roundtrip: record-edit-store no-op fixture failed") }
    ok
}

fn edit_store_noop(w: RtWorld) -> bool {
    let s = rt_session_generate(w, 5999154575767196239, 1, 32) else { return false }
    let fixture = fixture_make(1)
    var ed = editor_open(fixture, s.start_mode) else { return false }
    if !edit.record_start(mut ed, 'a' as int) ||
        !run_events(w, mut ed, s) ||
        edit.record_stop(mut ed) != edit.CMD_OK {
        return false
    }
    let before = stored_macro(mut ed) else { return false }
    if before.len == 0 { return false }
    let ast_before = parse_dump(w, before) else { return false }
    if edit.macro_edit(mut ed, 'a' as int) != edit.CMD_OK { return false }
    let wi = ed.win
    if wi < 0 { return false }
    let bi = ed.wins[wi].buf
    if ed.bufs[bi].macro_reg != 'a' as int { return false }
    let end = text.textbuf_len(ed.bufs[bi].ec.tb)
    let probe = [35 as byte]
    edit.ed_undo_begin(mut ed, wi, text.TXN_TYPE)
    if !edit.ed_edit_insert(mut ed, wi, end, probe, 0, 1) {
        edit.ed_undo_abort(mut ed, wi)
        return false
    }
    edit.ed_undo_end(mut ed, wi)
    edit.ed_finish_edit(mut ed, wi)
    edit.ed_undo_begin(mut ed, wi, text.TXN_ERASE)
    if !edit.ed_edit_delete(mut ed, wi, end, end + 1) {
        edit.ed_undo_abort(mut ed, wi)
        return false
    }
    edit.ed_undo_end(mut ed, wi)
    edit.ed_finish_edit(mut ed, wi)
    if text.undo_at_save_point(ed.bufs[bi].ec.undo) || edit.macro_store(mut ed, bi) != edit.CMD_OK {
        return false
    }
    let after = stored_macro(mut ed) else { return false }
    if !bytes_equal(before, after) { return false }
    let ast_after = parse_dump(w, after) else { return false }
    bytes_equal(ast_before, ast_after)
}

// run_cross_keymap_fixture (runner.c:645-718): recorded through the
// shipped keymap, replayed after every key it used is rebound to ed.nop.
fn run_cross_keymap_fixture(w: RtWorld) -> bool {
    var why = "unknown divergence"
    let ok = cross_keymap(w, mut why)
    if !ok { eprint("roundtrip: cross-keymap fixture failed: {why}") }
    ok
}

fn cross_keymap(w: RtWorld, mut why: str) -> bool {
    let fixture = List[byte]()
    var recorded = editor_open(fixture, edit.MODE_L) else { return false }
    if !load_runtime_keymap(mut recorded) ||
        !edit.record_start(mut recorded, 'a' as int) ||
        !dispatch_ok(mut recorded, rt_text_key('i' as int), 1) ||
        !dispatch_ok(mut recorded, rt_text_key('x' as int), 2) ||
        !dispatch_ok(mut recorded, rt_named_key(term.KEY_ESCAPE), 3) ||
        edit.record_stop(mut recorded) != edit.CMD_OK {
        return false
    }
    let source = stored_macro(mut recorded) else { return false }
    if source.len == 0 { return false }
    var replayed = editor_open(fixture, edit.MODE_L) else { return false }
    if !load_runtime_keymap(mut replayed) { return false }
    let nop = edit.cmd_lookup(replayed.reg, "ed.nop")
    let label = copy "audit:cross-keymap".bytes()
    let rebound = fl.fl_origin_register(mut replayed.origins, fl.FL_ORIGIN_WORKSPACE, label, 0)
    if nop == 0 || rebound == 0 { return false }
    edit.bind_batch_begin(mut replayed)
    if edit.bind_add(mut replayed, rebound, edit.MODE_L, "i", nop, 0, "", false, fl.fl_nil()) ==
        0 ||
        edit.bind_add(mut replayed, rebound, edit.MODE_I, "x", nop, 0, "", false, fl.fl_nil()) ==
            0 ||
        edit.bind_add(
            mut replayed,
            rebound,
            edit.MODE_I,
            "<esc>",
            nop,
            0,
            "",
            false,
            fl.fl_nil(),
        ) ==
            0 {
        edit.bind_batch_end(mut replayed)
        return false
    }
    edit.bind_batch_end(mut replayed)
    install_macro(mut replayed, source)
    if edit.macro_replay(mut replayed, 'a' as int, 1) != edit.CMD_OK { return false }
    let d = editors_differ(recorded, replayed)
    if d.len != 0 {
        why = d
        return false
    }
    true
}

// run_third_command_rollback_fixture (runner.c:720-753): an unresolved
// third call rolls the first two back.
fn run_third_command_rollback_fixture() -> bool {
    let ok = third_command_rollback()
    if !ok { eprint("roundtrip: third-command rollback fixture failed") }
    ok
}

fn third_command_rollback() -> bool {
    let source = copy "@[ i\"first\" ]\n@[ i\"second\" ]\nmissing_function()\n".bytes()
    var ed = editor_open(List[byte](), edit.MODE_L) else { return false }
    if edit.flapi_reg_write(mut ed, 'a' as int, source, false) != edit.CMD_OK { return false }
    if edit.macro_replay(mut ed, 'a' as int, 1) != edit.CMD_ERR_STATE { return false }
    text.textbuf_len(ed.bufs[0].ec.tb) == 0
}

// corrupt_takes_count_fold (runner.c:755-774): the planted fault folds
// `buf_end buf_end i"x"` into `2buf_end i"x"`.
fn corrupt_takes_count_fold(source: List[byte]) -> List[byte] ! {none} {
    let needle = "buf_end buf_end i\"x\"".bytes()
    let pair_len = "buf_end buf_end".len
    let folded = "2buf_end".bytes()
    var i = 0
    while i + needle.len <= source.len {
        var hit = true
        for j in 0..needle.len {
            if source[i + j] != needle[j] {
                hit = false
                break
            }
        }
        if hit {
            var out = List[byte]()
            for j in 0..i { (mut out).push(source[j]) }
            for b in folded { (mut out).push(b) }
            for j in i + pair_len..source.len { (mut out).push(source[j]) }
            return out
        }
        i += 1
    }
    none
}

fn view_of(s: RtSession, prefix: int) -> RtSession {
    var v = RtSession {
        events: List[RtEvent](),
        seed: s.seed,
        fixture: s.fixture,
        generated_len: s.generated_len,
        start_mode: s.start_mode,
    }
    for i in 0..prefix { (mut v.events).push(copy s.events[i]) }
    v
}

// p1_diverges (runner.c:776-844): (differs, first byte, emitted source).
fn p1_diverges(w: RtWorld, s: RtSession, prefix: int, corrupt: bool) -> (bool, int, List[byte]) {
    var emitted = List[byte]()
    if prefix > s.events.len { return (false, -1, emitted) }
    let fixture = fixture_make(s.fixture)
    let view = view_of(s, prefix)
    var direct = editor_open(fixture, s.start_mode) else { return (false, -1, emitted) }
    if !edit.record_start(mut direct, 'a' as int) ||
        !run_events(w, mut direct, view) ||
        edit.record_stop(mut direct) != edit.CMD_OK {
        return (false, -1, emitted)
    }
    let source = stored_macro(mut direct) else { return (false, -1, emitted) }
    var bad = copy source
    if corrupt {
        bad = corrupt_takes_count_fold(source) else { return (false, -1, emitted) }
    }
    emitted = copy bad
    var replay = editor_open(fixture, s.start_mode) else { return (false, -1, emitted) }
    install_macro(mut replay, bad)
    if edit.macro_replay(mut replay, 'a' as int, 1) != edit.CMD_OK { return (false, -1, emitted) }
    if corrupt { install_macro(mut direct, bad) }
    let differs = editors_differ(direct, replay).len != 0
    var at = -1
    if differs {
        at = first_byte_difference(
            text.textbuf_bytes(direct.bufs[0].ec.tb),
            text.textbuf_bytes(replay.bufs[0].ec.tb),
        )
    }
    (differs, at, emitted)
}

// property_prefix_fails (runner.c:846-872).
fn property_prefix_fails(
    mut w: RtWorld,
    s: RtSession,
    prefix: int,
    property: str,
    corrupt: bool,
) -> (bool, int, List[byte]) {
    if corrupt || property == "P1" { return p1_diverges(w, s, prefix, corrupt) }
    if prefix > s.events.len { return (false, -1, List[byte]()) }
    let view = view_of(s, prefix)
    (mut w.property).reset()
    (mut w.detail).reset()
    w.quiet = true
    let pb = copy property.bytes()
    let failed = !property_session(mut w, view) && bytes_equal(w.property, pb)
    w.quiet = false
    if !failed { return (false, -1, List[byte]()) }
    // P1 itself succeeded; the call renders the prefix's source.
    let (_, at, src) = p1_diverges(w, s, prefix, false)
    (true, at, src)
}

// write_failure_artifact (runner.c:874-897).
fn write_failure_artifact(s: RtSession, prefix: int, fault: str) -> str {
    var dir = env_get("YEW_RT_TMP") else ""
    if dir.len == 0 { dir = "build/tmp" }
    fs_create_dir(dir) else |_| {}
    let path = "{dir}/fail-{s.seed}.rec"
    var body = List[byte]()
    util.buf_append_str(
        mut body,
        "seed={s.seed} fixture={s.fixture} length={s.generated_len} prefix={prefix} fault={fault}\n",
    )
    fs_write_bytes(path, body) else |_| { return "<artifact write failed>" }
    path
}

// report_failure (runner.c:899-956): the shortest failing prefix, its
// artifact and the source it emitted.
fn report_failure(mut w: RtWorld, s: RtSession, corrupt: bool) {
    let last_property = str_from_utf8(w.property) else ""
    let last_detail = str_from_utf8(w.detail) else ""
    let property = if corrupt then "SELFTEST/P1" else last_property
    let detail = if corrupt then "TAKES_COUNT run was illegally folded" else last_detail
    let want = if corrupt then "P1" else property
    var prefix = 1
    var byte_at = -1
    var source = List[byte]()
    var found = false
    while prefix <= s.events.len {
        let (failed, at, src) = property_prefix_fails(mut w, s, prefix, want, corrupt)
        if failed {
            byte_at = at
            source = src
            found = true
            break
        }
        prefix += 1
    }
    if !found {
        prefix = s.events.len
        let (_, at, src) = property_prefix_fails(mut w, s, prefix, want, corrupt)
        byte_at = at
        source = src
    }
    let path = write_failure_artifact(s, prefix, if corrupt then "fold-takes-count" else "none")
    let op_at = if corrupt then 0 else if prefix == 0 then 0 else prefix - 1
    var op = "<unknown>"
    if prefix != 0 {
        let id = s.events[op_at].cmd
        if id > 0 && id <= w.reg.entries.len { op = w.reg.entries[id - 1].name }
    }
    let first = if byte_at < 0 then "unavailable 0" else "{byte_at}"
    eprint("roundtrip: FAIL seed={s.seed} fixture={s.fixture} property={property}")
    eprint("  diverged at event {op_at} of {prefix}; shrunk from {s.events.len}")
    eprint("  op: {op}")
    eprint("  first differing byte: {first}")
    eprint("  detail: {detail}")
    eprint("  minimized session: {path}")
    eprint("  emitted source:")
    stderr_bytes(source)
}

// run_one (runner.c:958-970).
fn run_one(mut w: RtWorld, seed: wrapping[u64], fixture: int, len: int) -> bool {
    let s = rt_session_generate(w, seed, fixture, len) else { return false }
    let ok = property_session(mut w, s)
    if !ok && s.events.len != 0 { report_failure(mut w, s, false) }
    ok
}

// run_count_folding_sentinel (runner.c:972-985): two uncounted TAKES_COUNT
// operations stay two.
fn run_count_folding_sentinel(mut w: RtWorld) -> bool {
    let s = rt_session_count_folding(w, 3) else { return false }
    property_session(mut w, s)
}

// The corpus line `seed=%llu fixture=%u length=%u prefix=%u` (runner.c:
// 1062-1063): (fields parsed, seed, fixture, length, prefix).
fn corpus_fields(src: List[byte]) -> (int, wrapping[u64], int, int, int) {
    let keys = ["seed=", "fixture=", "length=", "prefix="]
    var vals = List[wrapping[u64]]()
    var at = 0
    for k in keys {
        let kb = k.bytes()
        if at + kb.len > src.len { break }
        var ok = true
        for j in 0..kb.len {
            if src[at + j] != kb[j] {
                ok = false
                break
            }
        }
        if !ok { break }
        at += kb.len
        var v: wrapping[u64] = 0
        var digits = 0
        while at < src.len && src[at] >= 48 as byte && src[at] <= 57 as byte {
            v = v * 10 + (src[at] as int - 48) as wrapping[u64]
            at += 1
            digits += 1
        }
        if digits == 0 { break }
        (mut vals).push(v)
        // fscanf's literal space matches any run of white space.
        while at < src.len &&
            (
                src[at] == 32 as byte ||
                    src[at] == 10 as byte ||
                    src[at] == 9 as byte ||
                    src[at] == 13 as byte
            ) { at += 1 }
    }
    let n = vals.len
    let seed = if n > 0 then vals[0] else 0
    let fixture = if n > 1 then vals[1] as int else 0
    let len = if n > 2 then vals[2] as int else 0
    let prefix = if n > 3 then vals[3] as int else 0
    (n, seed, fixture, len, prefix)
}

fn rt_name_less(a: str, b: str) -> bool {
    let x = a.bytes()
    let y = b.bytes()
    let n = if x.len < y.len then x.len else y.len
    for i in 0..n { if x[i] != y[i] { return x[i] < y[i] } }
    x.len < y.len
}

// run_corpus (runner.c:1010-1099): every `*.rec` in name order, run whole
// or at its prefix; 20 at least.
fn run_corpus(mut w: RtWorld) -> (bool, int) {
    let dir = "tests/corpus/recorder"
    let entries = fs_read_dir(dir) else |_| {
        eprint("roundtrip: open corpus {dir}: cannot read")
        return (false, 0)
    }
    var names = List[str]()
    for n in entries { if n.len > 4 && n.ends_with(".rec") { (mut names).push(n) } }
    util.sort_stable(mut names, rt_name_less)
    for name in names {
        var ok = true
        region file {
            ok = run_corpus_file(mut w, dir, name)
        }
        if !ok { return (false, 0) }
    }
    if names.len < 20 {
        eprint("roundtrip: corpus has {names.len} files; need >=20")
        return (false, names.len)
    }
    (true, names.len)
}

// One corpus file (runner.c:1046-1088): run whole, or at its prefix.
fn run_corpus_file(mut w: RtWorld, dir: str, name: str) -> bool {
    {
        let path = "{dir}/{name}"
        let src = fs_read_bytes(path) else {
            eprint("roundtrip: missing corpus {path}")
            return false
        }
        let (parsed, seed, fixture, len, prefix) = corpus_fields(src)
        if parsed < 3 {
            eprint("roundtrip: invalid corpus {path}")
            return false
        }
        if prefix == 0 { return run_one(mut w, seed, fixture, len) }
        let s = rt_session_generate(w, seed, fixture, len) else { return false }
        if prefix > s.events.len { return false }
        let view = view_of(s, prefix)
        property_session(mut w, view)
    }
}

// strtoul/strtoull over the whole string: base 10, or C's base 0 (0x hex,
// a leading 0 octal). (ok, value).
fn parse_unsigned(s: str, base0: bool) -> (bool, wrapping[u64]) {
    let b = s.bytes()
    var at = 0
    var base = 10
    if base0 && b.len > 1 && b[0] == 48 as byte && (b[1] == 120 as byte || b[1] == 88 as byte) {
        base = 16
        at = 2
    } else if base0 && b.len > 1 && b[0] == 48 as byte {
        base = 8
        at = 1
    }
    if at >= b.len { return (base == 8 || b.len == 1, 0) }
    var v: wrapping[u64] = 0
    while at < b.len {
        let c = b[at] as int
        var d = -1
        if c >= 48 && c <= 57 {
            d = c - 48
        } else if c >= 97 && c <= 102 {
            d = c - 87
        } else if c >= 65 && c <= 70 {
            d = c - 55
        }
        if d < 0 || d >= base { return (false, 0) }
        v = v * base as wrapping[u64] + d as wrapping[u64]
        at += 1
    }
    (true, v)
}

// env_seeds (runner.c:1101-1116).
fn env_seeds() -> int {
    let s = env_get("YEW_RT_SEEDS") else ""
    if s.len == 0 { return 2000 }
    let (ok, n) = parse_unsigned(s, false)
    if !ok || n > 4294967295 {
        eprint("roundtrip: invalid YEW_RT_SEEDS={s}")
        os_exit(2)
    }
    n as int
}

// env_base_seed (runner.c:1118-1133).
fn env_base_seed() -> wrapping[u64] {
    let s = env_get("YEW_RT_BASE_SEED") else ""
    if s.len == 0 { return 0 }
    let (ok, n) = parse_unsigned(s, true)
    if !ok {
        eprint("roundtrip: invalid YEW_RT_BASE_SEED={s}")
        os_exit(2)
    }
    n
}

// has_count_folding_prefix (runner.c:1135-1155).
fn has_count_folding_prefix(w: RtWorld, s: RtSession) -> bool {
    if s.events.len < 3 { return false }
    let end = edit.cmd_lookup(w.reg, "ed.move.buf.end")
    let ins = edit.cmd_lookup(w.reg, "ed.edit.insert.text")
    s.events[0].cmd == end &&
        s.events[1].cmd == end &&
        !s.events[0].count_given &&
        !s.events[1].count_given &&
        s.events[2].cmd == ins &&
        !s.events[2].count_given &&
        s.events[2].sarg.len == 1 &&
        s.events[2].sarg[0] == 120 as byte
}

// run_selftest (runner.c:1157-1173): the planted fold must shrink to the
// three-event prefix and name ed.move.buf.end.
fn run_selftest(mut w: RtWorld) -> int {
    let s = rt_session_count_folding(w, 96) else { return 2 }
    if !has_count_folding_prefix(w, s) || s.events.len != 96 { return 2 }
    report_failure(mut w, s, true)
    1
}

fn main() -> int {
    let args = env_args()
    var coverage = (env_get("YEW_RT_COVERAGE") else "#unset") != "#unset"
    if args.len == 1 && args[0] == "--coverage" {
        coverage = true
    } else if args.len != 0 {
        eprint("usage: roundtrip_runner [--coverage]")
        return 2
    }
    let probe = edit.ed_new()
    var w = RtWorld {
        reg: copy probe.reg,
        quiet: false,
        property: List[byte](),
        detail: List[byte](),
    }
    if !rt_generator_coverage(w.reg, coverage) { return 1 }
    if (env_get("YEW_RT_SELFTEST") else "#unset") != "#unset" { return run_selftest(mut w) }
    if !run_count_folding_sentinel(mut w) { return 1 }
    if !run_edit_store_noop_fixture(w) { return 1 }
    if !run_cross_keymap_fixture(w) { return 1 }
    if !run_third_command_rollback_fixture() { return 1 }
    let seeds = env_seeds()
    let base = env_base_seed()
    // One region per seed: four editors a session, the 10,000-line
    // fixture among them, freed before the next (C frees each with
    // yew_ed_free, runner.c:536-547).
    for i in 0..seeds {
        var ok = false
        region seed {
            ok = run_one(mut w, base + i as wrapping[u64], i % 6, 0)
        }
        if !ok { return 1 }
    }
    let (ok, corpus) = run_corpus(mut w)
    if !ok { return 1 }
    print(
        "roundtrip: ok seeds={seeds} base={base} fixtures=6 corpus={corpus} count-sentinel=1 edit-store-noop=1 cross-keymap=1 third-command-rollback=1 P1-P5",
    )
    0
}
