//! member: false
//!
//! The port of sagitta `tests/unit/test_select.c` (221 lines), one test
//! per C test in registry order. C's fixture is a `Buffer` with tab width
//! 4 and a `Win` over it; the port's selection geometry takes the text,
//! the selection kind and the tab width explicitly (`edit.select`), so
//! the fixture is the `TextBuf` alone.

use edit
use text

fn tb_of(s: str) -> text.TextBuf {
    text.textbuf_from_str(s)
}

fn selection(anchor: int, pos: int) -> text.Cursor {
    text.Cursor { pos: pos, goal_col: 0, anchor: anchor }
}

fn assert_span(sp: text.Span, lo: int, hi: int, what: str) {
    assert(sp.lo == lo && sp.hi == hi, "{what}: span [{sp.lo}, {sp.hi}), want [{lo}, {hi})")
}

const TABW: int = 4

// `test_select_char_span_is_half_open_and_direction_independent`.
fn t_select_char_span_is_half_open_and_direction_independent() {
    let tb = tb_of("a\u{301}\u{6F22}z")
    assert_span(edit.sel_span(tb, edit.SEL_CHAR, selection(0, 6)), 0, 6, "forward")
    assert_span(edit.sel_span(tb, edit.SEL_CHAR, selection(6, 0)), 0, 6, "backward")
    assert_span(edit.sel_span(tb, edit.SEL_CHAR, selection(3, 3)), 3, 3, "caret")
}

// `test_select_line_span_includes_crlf_lf_and_final_line_bytes`.
fn t_select_line_span_includes_crlf_lf_and_final_line_bytes() {
    let tb = tb_of("aa\r\nb\nlast")
    assert_span(edit.sel_span(tb, edit.SEL_LINE, selection(1, 4)), 0, 6, "first two")
    assert_span(edit.sel_span(tb, edit.SEL_LINE, selection(1, 8)), 0, 10, "through final")
    assert_span(edit.sel_span(tb, edit.SEL_LINE, selection(7, 9)), 6, 10, "final only")
}

// `test_select_rows_counts_both_endpoint_lines_in_either_direction`.
fn t_select_rows_counts_both_endpoint_lines_in_either_direction() {
    let tb = tb_of("a\nb\nc\n")
    assert(edit.sel_rows(tb, selection(0, 4)) == 3, "forward rows")
    assert(edit.sel_rows(tb, selection(4, 0)) == 3, "backward rows")
}

fn rect_row(tb: text.TextBuf, c: text.Cursor, line: int) -> (bool, text.Span, int, int) {
    edit.sel_rect_row(tb, edit.SEL_RECT, edit.sel_tabwidth(TABW), c, line)
}

// `test_select_rect_widens_cjk_and_tab_left_edges_and_clips_short_lines`.
fn t_select_rect_widens_cjk_and_tab_left_edges_and_clips_short_lines() {
    let tb = tb_of("  top\na\u{6F22}bc\na\tbcde\nx\n  end\n")
    let c = selection(2, 27)
    let (ok1, row1, c0, c1) = rect_row(tb, c, 1)
    assert(ok1, "row 1 covered")
    assert_span(row1, 7, 12, "row 1")
    assert(c0 == 2 && c1 == 5, "columns {c0}..{c1}, want 2..5")
    let (ok2, row2, _, _) = rect_row(tb, c, 2)
    assert(ok2, "row 2 covered")
    assert_span(row2, 14, 16, "row 2")
    let (ok3, row3, _, _) = rect_row(tb, c, 3)
    assert(ok3, "row 3 covered")
    assert_span(row3, 21, 21, "row 3")
    let spans = edit.sel_rect_spans(tb, edit.SEL_RECT, edit.sel_tabwidth(TABW), c)
    assert(spans.len == 5, "five rows")
    assert_span(spans[1], 7, 12, "spans[1]")
    assert_span(spans[2], 14, 16, "spans[2]")
    assert_span(spans[3], 21, 21, "spans[3]")
}

// `test_select_rect_widens_cjk_emoji_and_tab_right_edges`.
fn t_select_rect_widens_cjk_emoji_and_tab_right_edges() {
    let tb = tb_of("a x\na\u{6F22}z\na\u{1F600}z\na\tz\na y\n")
    let c = selection(0, 23)
    let (ok1, row1, c0, c1) = rect_row(tb, c, 1)
    assert(ok1, "row 1 covered")
    assert_span(row1, 4, 8, "row 1")
    assert(c0 == 0 && c1 == 2, "columns {c0}..{c1}, want 0..2")
    let (ok2, row2, _, _) = rect_row(tb, c, 2)
    assert(ok2, "row 2 covered")
    assert_span(row2, 10, 15, "row 2")
    let (ok3, row3, _, _) = rect_row(tb, c, 3)
    assert(ok3, "row 3 covered")
    assert_span(row3, 17, 19, "row 3")
}

// `test_select_rect_zero_width_carets_land_on_whole_cluster_boundaries`.
fn t_select_rect_zero_width_carets_land_on_whole_cluster_boundaries() {
    let tb = tb_of("  x\na\u{6F22}z\na\tz\nx\n  y\n")
    let c = selection(2, 18)
    let (ok1, row1, c0, c1) = rect_row(tb, c, 1)
    assert(ok1, "row 1 covered")
    assert_span(row1, 5, 5, "row 1")
    assert(c0 == 2 && c1 == 2, "columns {c0}..{c1}, want 2..2")
    let (ok2, row2, _, _) = rect_row(tb, c, 2)
    assert(ok2, "row 2 covered")
    assert_span(row2, 11, 11, "row 2")
    let (ok3, row3, _, _) = rect_row(tb, c, 3)
    assert(ok3, "row 3 covered")
    assert_span(row3, 15, 15, "row 3")
}

// `test_select_rect_row_rejects_lines_outside_selection`.
fn t_select_rect_row_rejects_lines_outside_selection() {
    let tb = tb_of("aa\nbb\ncc")
    let c = selection(3, 4)
    let (ok0, _, _, _) = rect_row(tb, c, 0)
    assert(!ok0, "line 0 is outside")
    let (ok2, _, _, _) = rect_row(tb, c, 2)
    assert(!ok2, "line 2 is outside")
}

// `test_select_rect_spans_exclude_crlf_and_reach_final_unterminated_line`.
fn t_select_rect_spans_exclude_crlf_and_reach_final_unterminated_line() {
    let tb = tb_of(" ab\r\nx\r\nyz")
    let spans = edit.sel_rect_spans(tb, edit.SEL_RECT, edit.sel_tabwidth(TABW), selection(1, 10))
    assert(spans.len == 3, "three rows")
    assert_span(spans[0], 1, 2, "spans[0]")
    assert_span(spans[1], 6, 6, "spans[1]")
    assert_span(spans[2], 9, 10, "spans[2]")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_select_char_span_is_half_open_and_direction_independent()
    t_select_line_span_includes_crlf_lf_and_final_line_bytes()
    t_select_rows_counts_both_endpoint_lines_in_either_direction()
    t_select_rect_widens_cjk_and_tab_left_edges_and_clips_short_lines()
    t_select_rect_widens_cjk_emoji_and_tab_right_edges()
    t_select_rect_zero_width_carets_land_on_whole_cluster_boundaries()
    t_select_rect_row_rejects_lines_outside_selection()
    t_select_rect_spans_exclude_crlf_and_reach_final_unterminated_line()
    print("select_test: 8 cases pass")
}
