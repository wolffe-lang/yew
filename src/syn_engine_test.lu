//! member: false
//! Line-state interpreter laws from sagitta test_syn_line.c and the
//! qualified embedding laws of test_syn_embed.c at 9ace98c2. The toy is
//! table data; production code has no hard-coded language tokens.
use search
use syn

fn bytes(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() { (mut out).push(b) }
    out
}

fn rule(mut def: syn.SynDefinition, ctx: int, pattern: str, attr: int, op: int, target: int) {
    var err = search.re_err_new()
    let re = search.re_compile_str(pattern, 0, mut err) else {
        assert(false, "toy regex: {err.msg}")
        return
    }
    var r = syn.syn_rule_new(def.regexes.len, attr)
    r.op = op; r.target = target
    if op == syn.SYN_OP_POP { r.nop = 1 }
    let first = search.re_first_bytes(re)
    r.first = syn.syn_first_new(false)
    var i = 0
    while i < 256 { if first[i] { syn.syn_first_add(mut r.first, i) }; i += 1 }
    syn.syn_first_union(mut def.contexts[ctx].first, r.first)
    (mut def.regexes).push(re)
    (mut def.rules).push(r)
    (mut def.patterns).push(bytes(pattern))
}

fn toy() -> syn.SynDefinition {
    var def = syn.syn_definition_new("toy")
    var main = syn.syn_context_new(0); main.nrules = 7
    var string = syn.syn_context_new(12); string.first_rule = 7; string.nrules = 2
    string.eol_op = syn.SYN_OP_POP; string.eol_nop = 1
    var block = syn.syn_context_new(16); block.first_rule = 9; block.nrules = 1
    var comment = syn.syn_context_new(16); comment.first_rule = 10
    comment.eol_op = syn.SYN_OP_POP; comment.eol_nop = 1
    (mut def.contexts).push(main); (mut def.contexts).push(string)
    (mut def.contexts).push(block); (mut def.contexts).push(comment)
    for name in "main string comment_block comment_line".words() { (mut def.context_names).push(bytes(name)) }
    rule(mut def, 0, "//", 16, syn.SYN_OP_PUSH, 3)
    rule(mut def, 0, "/\\*", 16, syn.SYN_OP_PUSH, 2)
    rule(mut def, 0, "\"", 12, syn.SYN_OP_PUSH, 1)
    rule(mut def, 0, "\\b(if|else|while|return)\\b", 2, syn.SYN_OP_STAY, 0)
    rule(mut def, 0, "[0-9]+", 9, syn.SYN_OP_STAY, 0)
    rule(mut def, 0, "\\b(true|false)\\b", 10, syn.SYN_OP_STAY, 0)
    rule(mut def, 0, "[+*/=-]+", 31, syn.SYN_OP_STAY, 0)
    rule(mut def, 1, "\\\\.", 13, syn.SYN_OP_STAY, 0)
    rule(mut def, 1, "\"", 12, syn.SYN_OP_POP, 0)
    rule(mut def, 2, "\\*/", 16, syn.SYN_OP_POP, 0)
    def
}

fn basic_line() {
    var pool = syn.syn_pool_new()
    let index = syn.syn_pool_add(mut pool, take toy(), 1)
    var engine = syn.syn_engine_new(pool, index)
    var out = syn.syn_spans_new(16)
    syn.syn_line(mut engine, mut pool, 1, "if x=42".bytes(), 7, mut out, false)
    assert(out.stop == 0 && out.exit_state == 1, "ordinary line keeps ROOT")
    assert(out.n == 4, "semantic runs")
    assert(syn.syn_span_attr(out, 0) == 2 && syn.syn_span_len(out, 0) == 2, "control keyword")
    assert(syn.syn_span_attr(out, 1) == 0 && syn.syn_span_len(out, 1) == 2, "default run")
    assert(syn.syn_span_attr(out, 2) == 31, "operator")
    assert(syn.syn_span_attr(out, 3) == 9, "number")
    assert(engine.line_calls == 1, "actual interpreter calls counted")
}

fn block_carry() {
    var pool = syn.syn_pool_new()
    let index = syn.syn_pool_add(mut pool, take toy(), 1)
    var engine = syn.syn_engine_new(pool, index)
    var out = syn.syn_spans_new(16)
    syn.syn_line(mut engine, mut pool, 1, "/*a".bytes(), 3, mut out, false)
    let held = out.exit_state
    assert(held != 1 && syn.syn_span_attr(out, 0) == 16, "block opens")
    syn.syn_line(mut engine, mut pool, held, "b*/ if".bytes(), 6, mut out, false)
    assert(out.exit_state == 1, "block closes back to ROOT")
    assert(syn.syn_span_attr(out, 0) == 16 && syn.syn_span_len(out, 0) == 3, "carry body and closer")
    assert(syn.syn_span_attr(out, out.n - 1) == 2, "host keyword after closer")
}

fn eol_pop() {
    var pool = syn.syn_pool_new()
    let index = syn.syn_pool_add(mut pool, take toy(), 1)
    var engine = syn.syn_engine_new(pool, index)
    var out = syn.syn_spans_new(16)
    syn.syn_line(mut engine, mut pool, 1, "\"unterminated".bytes(), 13, mut out, false)
    assert(out.exit_state == 1, "string EOL pop")
    assert(syn.syn_span_attr(out, 0) == 12, "string styled before EOL")
    syn.syn_line(mut engine, mut pool, 1, "// comment".bytes(), 10, mut out, false)
    assert(out.exit_state == 1, "line-comment EOL pop")
}

fn span_stop_keeps_state() {
    var pool = syn.syn_pool_new()
    let index = syn.syn_pool_add(mut pool, take toy(), 1)
    var engine = syn.syn_engine_new(pool, index)
    var out = syn.syn_spans_new(1)
    syn.syn_line(mut engine, mut pool, 1, "if \"x".bytes(), 5, mut out, false)
    assert(out.stop == syn.SYN_STOP_SPANS, "output cap reported")
    assert(out.exit_state == 1, "grammar/EOL still run after output fills")
    assert(syn.syn_span_flags(out, 0) & syn.SYN_SPAN_TRUNCATED != 0, "honest truncation")
}

fn byte_cap_first_line() {
    var def = toy()
    def.rules[0].flags = syn.SYN_RULE_FIRST_LINE
    var pool = syn.syn_pool_new()
    let index = syn.syn_pool_add(mut pool, take def, 1)
    var engine = syn.syn_engine_new(pool, index)
    var out = syn.syn_spans_new(8)
    // Oversize callers need not materialize the whole inert line.
    syn.syn_line(mut engine, mut pool, 1, "".bytes(), 65537, mut out, false)
    assert(out.stop == syn.SYN_STOP_BYTES, "byte cap")
    let entry = out.exit_state
    let state = syn.syn_state_get(engine.states, entry) else syn.syn_state_root(0, 0)
    assert(syn.syn_state_flags(state) & syn.SYN_F_PAST_FIRST != 0, "physical first line still consumed")
    assert(syn.syn_span_len(out, 0) == 65535 && syn.syn_span_len(out, 1) == 2, "whole inert line represented")
    syn.syn_line(mut engine, mut pool, entry, "//x".bytes(), 3, mut out, false)
    assert(syn.syn_span_attr(out, 0) != 16, "first-line-only opener cannot run on line two")
}

fn zero_width_progress() {
    var def = syn.syn_definition_new("zero")
    var ctx = syn.syn_context_new(0); ctx.nrules = 1; ctx.first = syn.syn_first_new(true)
    (mut def.contexts).push(ctx); (mut def.context_names).push(bytes("main"))
    rule(mut def, 0, "a*", 9, syn.SYN_OP_STAY, 0)
    def.rules[0].first = syn.syn_first_new(true)
    var pool = syn.syn_pool_new()
    let index = syn.syn_pool_add(mut pool, take def, 1)
    var engine = syn.syn_engine_new(pool, index)
    var out = syn.syn_spans_new(16)
    syn.syn_line(mut engine, mut pool, 1, "éx".bytes(), 3, mut out, false)
    assert(out.stop == 0 && out.exit_state == 1, "empty matches terminate")
    assert(engine.last_attempts > 0 && engine.last_attempts <= 3, "forced UTF-8 progress")
    assert(syn.syn_span_len(out, 0) == 3 && syn.syn_span_attr(out, 0) == 0, "skipped bytes use context default")
}

fn compiled(source: str) -> syn.SynDefinition {
    var c = syn.syn_compile("embedded.fl", source.bytes())
    assert(c.valid, "embedding test definition compiles")
    c.definition
}

fn pending_guest_and_trace() {
    let host = "{{syntax:1,language:{{name:\"host\"}},contexts:{{main:{{rules:[{{match:\"<\",attr:\"punct\",push:\"bridge\",embed:{{lang:\"guest\",end:\"inline\",fallback:\"code\"}}}}]}},bridge:{{default:\"code\",rules:[{{match:\">\",attr:\"punct\",pop:1,end:true}}]}}}}}}"
    let guest = "{{syntax:1,language:{{name:\"guest\"}},contexts:{{main:{{rules:[{{match:\"[0-9]+\",attr:\"number\"}}]}}}}}}"
    var pool = syn.syn_pool_new()
    syn.syn_pool_name(mut pool, 2, "guest".bytes())
    let root = syn.syn_pool_add(mut pool, take compiled(host), 1)
    var engine = syn.syn_engine_new(pool, root)
    var out = syn.syn_spans_new(16)
    syn.syn_line(mut engine, mut pool, 1, "<123>".bytes(), 5, mut out, false)
    assert(engine.pending_lang == 2, "matching never loads a guest synchronously")
    assert(syn.syn_span_attr(out, 1) == 41, "not-resident guest has explicit fallback")
    let added = syn.syn_pool_add(mut pool, take compiled(guest), 2)
    assert(syn.syn_engine_install(mut engine, pool, added), "loader installs resident out of matching")
    syn.syn_line(mut engine, mut pool, 1, "<123>".bytes(), 5, mut out, true)
    assert(out.n == 3 && syn.syn_span_attr(out, 1) == 9, "resident guest actually interprets its rules")
    assert(out.exit_state == 1, "host delimiter balances guest and bridge")
    var at = syn.syn_state_root(0, 0)
    assert(syn.syn_engine_trace_at(mut at, engine, 4), "trace available")
    assert(syn.syn_state_ndef(at) == 2, "closing delimiter begins in guest")
    assert(syn.syn_engine_trace_at(mut at, engine, 5), "end trace")
    assert(syn.syn_state_ndef(at) == 1, "closing delimiter leaves guest")
}

fn empty_physical_line() {
    var pool = syn.syn_pool_new()
    let index = syn.syn_pool_add(mut pool, take toy(), 1)
    var engine = syn.syn_engine_new(pool, index)
    var out = syn.syn_spans_new(4)
    syn.syn_line(mut engine, mut pool, 1, "".bytes(), 0, mut out, true)
    assert(out.n == 0 && out.exit_state == 1 && out.stop == 0, "empty line valid")
    var at = syn.syn_state_root(0, 0)
    assert(syn.syn_engine_trace_at(mut at, engine, 0), "empty line has its entering state")
}

fn main() {
    let selected = (env_get("YEW_SYN_ENGINE_CASE") else "-1").to_int() else -1
    var i = 0
    while i < 8 {
        if selected == -1 || selected == i {
            match i {
                0 => basic_line(), 1 => block_carry(), 2 => eol_pop(),
                3 => span_stop_keeps_state(), 4 => byte_cap_first_line(),
                5 => zero_width_progress(), 6 => pending_guest_and_trace(),
                _ => empty_physical_line(),
            }
            print("syn_engine_case_{i}: PASS")
        }
        i += 1
    }
}
