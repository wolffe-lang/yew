//! member: false
//!
//! The port of sagitta `tests/unit/test_gitignore.c` (570 lines), one
//! test per C test in registry order (`tests/unit/registry.c:2302-2327`):
//! the supported rows of §4's table, the UNSUPPORTED rows pinned to the
//! documented divergence (`gitignore.h:29-56`), §4.1's pruning both ways,
//! and the loader. C's `GiSet *` is an index into the test's `ws.Gi`
//! (`ws.GI_NONE` its NULL); C's NULL `text`, NULL `dir` and NULL `rel`
//! arguments (`test_gitignore.c:561-567`) have no wolf shape — a `str`
//! and a `List[byte]` are never null — so those rows are their empty
//! halves. C's `mkdtemp` directories `/tmp/yew-gi-XXXXXX` are
//! `/tmp/yew-gi-NNNNNN` here.
//!
//! `YEW_PICK_CASE=N` runs case N alone (the checked machine's per-case
//! run, G29).

use ws

fn b(s: str) -> List[byte] {
    var v = List[byte]()
    for x in s.bytes() {
        (mut v).push(x)
    }
    v
}

// `gi_rules` (`test_gitignore.c:50-53`).
fn rules(mut g: ws.Gi, text: str) -> int {
    ws.gi_compile(mut g, "", b(text), ws.GI_NONE)
}

fn fresh_dir(prefix: str) -> str {
    var tries = 0
    while tries < 100 {
        var suffix = ""
        for r in os_random(6) {
            suffix = suffix + "{r % 10}"
        }
        let dir = "/tmp/{prefix}-{suffix}"
        fs_create_dir_mode(dir, 448) else |e| match e {
            exists => {
                tries += 1
                continue
            },
            denied => { assert(false, "mkdtemp denied") },
            invalid => { assert(false, "mkdtemp invalid") },
            not_found => { assert(false, "mkdtemp not found") },
            unsupported => { assert(false, "mkdtemp unsupported") },
            io => { assert(false, "mkdtemp io") },
        }
        return dir
    }
    assert(false, "mkdtemp exhausted")
    ""
}

// `test_gitignore_blank_lines_and_comments` (`:59-77`).
fn gitignore_blank_lines_and_comments() {
    var g = ws.gi_new()
    let s = rules(mut g, "\n# a comment\n   \n*.o\n\t# indented comment\n")
    assert(ws.gi_match(g, s, "a.o", false), "a.o")
    assert(!ws.gi_match(g, s, "a.c", false), "a.c")
    assert(!ws.gi_match(g, s, "a comment", false), "the comment text")
    assert(!ws.gi_match(g, s, "# a comment", false), "the comment line")
}

// `test_gitignore_escaped_hash_is_a_literal` (`:81-91`).
fn gitignore_escaped_hash_is_a_literal() {
    var g = ws.gi_new()
    let s = rules(mut g, "\\#notacomment\n")
    assert(ws.gi_match(g, s, "#notacomment", false), "#notacomment")
    assert(!ws.gi_match(g, s, "notacomment", false), "notacomment")
}

// `test_gitignore_trailing_whitespace_is_stripped_unless_escaped`
// (`:95-110`).
fn gitignore_trailing_whitespace_is_stripped_unless_escaped() {
    var g = ws.gi_new()
    let s = rules(mut g, "plain.txt   \n")
    assert(ws.gi_match(g, s, "plain.txt", false), "plain.txt")
    var h = ws.gi_new()
    let t = rules(mut h, "spaced\\ \n")
    assert(ws.gi_match(h, t, "spaced ", false), "spaced with its space")
    assert(!ws.gi_match(h, t, "spaced", false), "spaced without")
}

// `test_gitignore_leading_slash_anchors` (`:113-124`).
fn gitignore_leading_slash_anchors() {
    var g = ws.gi_new()
    let s = rules(mut g, "/build\n")
    assert(ws.gi_match(g, s, "build", true), "build")
    assert(!ws.gi_match(g, s, "src/build", true), "anchored")
}

// `test_gitignore_unanchored_matches_any_component` (`:127-139`).
fn gitignore_unanchored_matches_any_component() {
    var g = ws.gi_new()
    let s = rules(mut g, "build\n")
    assert(ws.gi_match(g, s, "build", true), "build")
    assert(ws.gi_match(g, s, "src/build", true), "src/build")
    assert(ws.gi_match(g, s, "a/b/c/build", true), "a/b/c/build")
    assert(!ws.gi_match(g, s, "rebuild", true), "rebuild")
}

// `test_gitignore_trailing_slash_is_directory_only` (`:142-153`).
fn gitignore_trailing_slash_is_directory_only() {
    var g = ws.gi_new()
    let s = rules(mut g, "logs/\n")
    assert(ws.gi_match(g, s, "logs", true), "the directory")
    assert(!ws.gi_match(g, s, "logs", false), "a file named logs")
}

// `test_gitignore_star_does_not_cross_a_slash` (`:156-167`).
fn gitignore_star_does_not_cross_a_slash() {
    var g = ws.gi_new()
    let s = rules(mut g, "/src/*.c\n")
    assert(ws.gi_match(g, s, "src/main.c", false), "src/main.c")
    assert(!ws.gi_match(g, s, "src/ui/draw.c", false), "one level deeper")
}

// `test_gitignore_question_matches_one_byte` (`:170-186`).
fn gitignore_question_matches_one_byte() {
    var g = ws.gi_new()
    let s = rules(mut g, "/a?.txt\n")
    assert(ws.gi_match(g, s, "ab.txt", false), "ab.txt")
    assert(!ws.gi_match(g, s, "a.txt", false), "a.txt")
    assert(!ws.gi_match(g, s, "abc.txt", false), "abc.txt")
    var h = ws.gi_new()
    let t = rules(mut h, "/a?b\n")
    assert(!ws.gi_match(h, t, "a/b", false), "? is not a separator")
}

// `test_gitignore_bracket_sets` (`:188-218`).
fn gitignore_bracket_sets() {
    var g = ws.gi_new()
    let s = rules(mut g, "/f[abc].txt\n")
    assert(ws.gi_match(g, s, "fa.txt", false), "fa")
    assert(ws.gi_match(g, s, "fc.txt", false), "fc")
    assert(!ws.gi_match(g, s, "fd.txt", false), "fd")
    var h = ws.gi_new()
    let t = rules(mut h, "/f[a-z].txt\n")
    assert(ws.gi_match(h, t, "fm.txt", false), "fm")
    assert(!ws.gi_match(h, t, "fM.txt", false), "fM")
    var i = ws.gi_new()
    let u = rules(mut i, "/f[!a-z].txt\n")
    assert(ws.gi_match(i, u, "fM.txt", false), "! fM")
    assert(!ws.gi_match(i, u, "fm.txt", false), "! fm")
    var j = ws.gi_new()
    let v = rules(mut j, "/f[^a-z].txt\n")
    assert(ws.gi_match(j, v, "f0.txt", false), "^ f0")
    assert(!ws.gi_match(j, v, "fq.txt", false), "^ fq")
}

// `test_gitignore_double_star` (`:221-250`).
fn gitignore_double_star() {
    var g = ws.gi_new()
    let s = rules(mut g, "**/target\n")
    assert(ws.gi_match(g, s, "target", true), "target")
    assert(ws.gi_match(g, s, "a/target", true), "a/target")
    assert(ws.gi_match(g, s, "a/b/target", true), "a/b/target")
    var h = ws.gi_new()
    let t = rules(mut h, "/logs/**\n")
    assert(ws.gi_match(h, t, "logs/a.txt", false), "logs/a.txt")
    assert(ws.gi_match(h, t, "logs/a/b/c.txt", false), "logs/a/b/c.txt")
    assert(!ws.gi_match(h, t, "other/a.txt", false), "other/a.txt")
    var i = ws.gi_new()
    let u = rules(mut i, "/a/**/b\n")
    assert(ws.gi_match(i, u, "a/b", false), "a/b")
    assert(ws.gi_match(i, u, "a/x/b", false), "a/x/b")
    assert(ws.gi_match(i, u, "a/x/y/z/b", false), "a/x/y/z/b")
    assert(!ws.gi_match(i, u, "a/x/c", false), "a/x/c")
}

// `test_gitignore_negation_last_match_wins` (`:253-272`).
fn gitignore_negation_last_match_wins() {
    var g = ws.gi_new()
    let s = rules(mut g, "*.log\n!keep.log\n")
    assert(ws.gi_match(g, s, "a.log", false), "a.log")
    assert(!ws.gi_match(g, s, "keep.log", false), "keep.log")
    var h = ws.gi_new()
    let t = rules(mut h, "!keep.log\n*.log\n")
    assert(ws.gi_match(h, t, "a.log", false), "reversed a.log")
    assert(ws.gi_match(h, t, "keep.log", false), "reversed keep.log")
}

// `test_gitignore_nested_sets_deepest_wins` (`:276-291`).
fn gitignore_nested_sets_deepest_wins() {
    var g = ws.gi_new()
    let root = ws.gi_compile(mut g, "", b("*.log\n"), ws.GI_NONE)
    let nested = ws.gi_compile(mut g, "sub", b("!important.log\n"), root)
    assert(ws.gi_match(g, nested, "a.log", false), "a.log")
    assert(ws.gi_match(g, nested, "sub/other.log", false), "sub/other.log")
    assert(!ws.gi_match(g, nested, "sub/important.log", false), "re-included")
}

// `test_gitignore_nested_anchoring_is_relative_to_its_directory`
// (`:294-308`).
fn gitignore_nested_anchoring_is_relative_to_its_directory() {
    var g = ws.gi_new()
    let root = ws.gi_compile(mut g, "", b("\n"), ws.GI_NONE)
    let nested = ws.gi_compile(mut g, "sub", b("/build\n"), root)
    assert(ws.gi_match(g, nested, "sub/build", true), "sub/build")
    assert(!ws.gi_match(g, nested, "build", true), "not the root's")
    assert(!ws.gi_match(g, nested, "sub/x/build", true), "not deeper")
}

// `test_gitignore_crlf_lines` (`:311-321`).
fn gitignore_crlf_lines() {
    var g = ws.gi_new()
    let s = rules(mut g, "*.o\r\nbuild/\r\n")
    assert(ws.gi_match(g, s, "a.o", false), "a.o")
    assert(ws.gi_match(g, s, "build", true), "build")
}

// `test_gitignore_posix_classes_are_not_supported` (`:342-360`).
fn gitignore_posix_classes_are_not_supported() {
    var g = ws.gi_new()
    let s = rules(mut g, "/f[[:alpha:]].txt\n")
    assert(!ws.gi_match(g, s, "fz.txt", false), "fz")
    assert(!ws.gi_match(g, s, "fa.txt", false), "fa")
    assert(!ws.gi_match(g, s, "fp.txt", false), "fp")
    assert(ws.gi_match(g, s, "fa].txt", false), "fa]")
    assert(ws.gi_match(g, s, "f:].txt", false), "f:]")
    assert(ws.gi_match(g, s, "f[].txt", false), "f[]")
    assert(!ws.gi_match(g, s, "fz].txt", false), "fz]")
}

// `test_gitignore_matching_is_case_sensitive` (`:368-380`).
fn gitignore_matching_is_case_sensitive() {
    var g = ws.gi_new()
    let s = rules(mut g, "*.log\n")
    assert(ws.gi_match(g, s, "a.log", false), "a.log")
    assert(!ws.gi_match(g, s, "a.LOG", false), "a.LOG")
    assert(!ws.gi_match(g, s, "A.Log", false), "A.Log")
}

// `test_gitignore_has_no_index_awareness` (`:390-401`).
fn gitignore_has_no_index_awareness() {
    var g = ws.gi_new()
    let s = rules(mut g, "config.h\n")
    assert(ws.gi_match(g, s, "config.h", false), "config.h")
}

// `test_gitignore_unterminated_bracket_is_a_literal` (`:405-415`).
fn gitignore_unterminated_bracket_is_a_literal() {
    var g = ws.gi_new()
    let s = rules(mut g, "/a[bc.txt\n")
    assert(ws.gi_match(g, s, "a[bc.txt", false), "a[bc.txt")
    assert(!ws.gi_match(g, s, "ab.txt", false), "ab.txt")
}

// `test_gitignore_prunable_when_nothing_could_re_include` (`:426-436`).
fn gitignore_prunable_when_nothing_could_re_include() {
    var g = ws.gi_new()
    let s = rules(mut g, "node_modules/\n*.o\n")
    assert(ws.gi_match(g, s, "node_modules", true), "ignored")
    assert(ws.gi_prunable(g, s, "node_modules"), "prunable")
}

// `test_gitignore_not_prunable_when_a_negation_reaches_inside`
// (`:447-457`).
fn gitignore_not_prunable_when_a_negation_reaches_inside() {
    var g = ws.gi_new()
    let s = rules(mut g, "node_modules/\n!node_modules/keep.js\n")
    assert(ws.gi_match(g, s, "node_modules", true), "ignored")
    assert(!ws.gi_prunable(g, s, "node_modules"), "not prunable")
}

// `test_gitignore_unanchored_negation_blocks_pruning` (`:461-471`).
fn gitignore_unanchored_negation_blocks_pruning() {
    var g = ws.gi_new()
    let s = rules(mut g, "build/\n!keep.txt\n")
    assert(ws.gi_match(g, s, "build", true), "ignored")
    assert(!ws.gi_prunable(g, s, "build"), "not prunable")
}

// `test_gitignore_wildcard_negation_blocks_pruning` (`:474-483`).
fn gitignore_wildcard_negation_blocks_pruning() {
    var g = ws.gi_new()
    let s = rules(mut g, "vendor/\n!*.md\n")
    assert(!ws.gi_prunable(g, s, "vendor"), "not prunable")
}

// `test_gitignore_unignored_directory_is_not_prunable` (`:487-496`).
fn gitignore_unignored_directory_is_not_prunable() {
    var g = ws.gi_new()
    let s = rules(mut g, "node_modules/\n")
    assert(!ws.gi_prunable(g, s, "src"), "src")
}

// `test_gitignore_load_reads_a_file` (`:502-528`).
fn gitignore_load_reads_a_file() {
    var g = ws.gi_new()
    let dir = fresh_dir("yew-gi")
    let path = "{dir}/.gitignore"
    fs_write_bytes(path, b("*.tmp\nbuild/\n")) else |_| {
        assert(false, "write {path}")
    }
    let s = ws.gi_load(mut g, dir, ws.GI_NONE)
    assert(s != ws.GI_NONE, "a set")
    assert(ws.gi_match(g, s, "x.tmp", false), "x.tmp")
    assert(ws.gi_match(g, s, "build", true), "build")
    assert(!ws.gi_match(g, s, "x.c", false), "x.c")
    fs_remove(path) else |_| {}
    fs_remove_dir(dir) else |_| {}
}

// `test_gitignore_absent_file_returns_the_parent` (`:534-552`).
fn gitignore_absent_file_returns_the_parent() {
    var g = ws.gi_new()
    let dir = fresh_dir("yew-gi")
    let parent = rules(mut g, "*.o\n")
    let s = ws.gi_load(mut g, dir, parent)
    assert(s == parent, "the parent back")
    assert(ws.gi_compile(mut g, "", b("# nothing\n"), parent) == parent, "a comment-only file")
    fs_remove_dir(dir) else |_| {}
}

// `test_gitignore_degenerate_inputs` (`:555-570`): the NULL rows have no
// wolf shape (the header); an empty directory name, an empty text, the
// GI_NONE set and the empty path are their halves here.
fn gitignore_degenerate_inputs() {
    var g = ws.gi_new()
    assert(ws.gi_load(mut g, "/tmp/yew-gi-does-not-exist-xyz", ws.GI_NONE) == ws.GI_NONE, "no dir")
    assert(ws.gi_compile(mut g, "", List[byte](), ws.GI_NONE) == ws.GI_NONE, "no text")
    assert(!ws.gi_match(g, ws.GI_NONE, "a.txt", false), "no set")
    assert(!ws.gi_prunable(g, ws.GI_NONE, "a"), "no set prunes nothing")
    let s = rules(mut g, "*.o\n")
    assert(!ws.gi_match(g, s, "", false), "the empty path")
    assert(!ws.gi_prunable(g, s, ""), "the empty path prunes nothing")
}

fn main() {
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    var n = 0
    if chosen < 0 || chosen == 0 {
        gitignore_blank_lines_and_comments()
        print("gitignore_blank_lines_and_comments: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 1 {
        gitignore_escaped_hash_is_a_literal()
        print("gitignore_escaped_hash_is_a_literal: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 2 {
        gitignore_trailing_whitespace_is_stripped_unless_escaped()
        print("gitignore_trailing_whitespace_is_stripped_unless_escaped: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 3 {
        gitignore_leading_slash_anchors()
        print("gitignore_leading_slash_anchors: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 4 {
        gitignore_unanchored_matches_any_component()
        print("gitignore_unanchored_matches_any_component: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 5 {
        gitignore_trailing_slash_is_directory_only()
        print("gitignore_trailing_slash_is_directory_only: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 6 {
        gitignore_star_does_not_cross_a_slash()
        print("gitignore_star_does_not_cross_a_slash: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 7 {
        gitignore_question_matches_one_byte()
        print("gitignore_question_matches_one_byte: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 8 {
        gitignore_bracket_sets()
        print("gitignore_bracket_sets: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 9 {
        gitignore_double_star()
        print("gitignore_double_star: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 10 {
        gitignore_negation_last_match_wins()
        print("gitignore_negation_last_match_wins: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 11 {
        gitignore_nested_sets_deepest_wins()
        print("gitignore_nested_sets_deepest_wins: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 12 {
        gitignore_nested_anchoring_is_relative_to_its_directory()
        print("gitignore_nested_anchoring_is_relative_to_its_directory: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 13 {
        gitignore_crlf_lines()
        print("gitignore_crlf_lines: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 14 {
        gitignore_posix_classes_are_not_supported()
        print("gitignore_posix_classes_are_not_supported: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 15 {
        gitignore_matching_is_case_sensitive()
        print("gitignore_matching_is_case_sensitive: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 16 {
        gitignore_has_no_index_awareness()
        print("gitignore_has_no_index_awareness: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 17 {
        gitignore_unterminated_bracket_is_a_literal()
        print("gitignore_unterminated_bracket_is_a_literal: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 18 {
        gitignore_prunable_when_nothing_could_re_include()
        print("gitignore_prunable_when_nothing_could_re_include: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 19 {
        gitignore_not_prunable_when_a_negation_reaches_inside()
        print("gitignore_not_prunable_when_a_negation_reaches_inside: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 20 {
        gitignore_unanchored_negation_blocks_pruning()
        print("gitignore_unanchored_negation_blocks_pruning: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 21 {
        gitignore_wildcard_negation_blocks_pruning()
        print("gitignore_wildcard_negation_blocks_pruning: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 22 {
        gitignore_unignored_directory_is_not_prunable()
        print("gitignore_unignored_directory_is_not_prunable: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 23 {
        gitignore_load_reads_a_file()
        print("gitignore_load_reads_a_file: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 24 {
        gitignore_absent_file_returns_the_parent()
        print("gitignore_absent_file_returns_the_parent: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 25 {
        gitignore_degenerate_inputs()
        print("gitignore_degenerate_inputs: PASS")
        n += 1
    }
    print("gitignore_test: {n} cases pass")
}
