//! member: false
//! The eight tests/unit/test_trust.c cases at sagitta 9ace98c2, in
//! registry order (Sprint 36: the workspace trust database). C's fixture
//! is a mkdtemp tree under /tmp (tf_make, test_trust.c:23-37); the port's
//! is a fresh /tmp/yew-trust-PID-N tree, removed the same way.

use edit
use std.fs

struct TrustFix { root: str, dbpath: str, work: str, config: str }

var fix_counter: int = 0

// tf_make (test_trust.c:23-37).
fn tf_make() -> TrustFix {
    var n = 0
    // # Safety: the test is one thread; the counter names fresh trees.
    unsafe {
        fix_counter += 1
        n = fix_counter
    }
    let root = "/tmp/yew-trust-{os_pid()}-{n}"
    fs.remove_dir_all(root) else |_| {}
    fs.create_dir_all(root) else |_| { assert(false, "mkdir root") }
    let f = TrustFix {
        root: root,
        dbpath: "{root}/trust.fl",
        work: "{root}/work",
        config: "{root}/work/.yew.fl",
    }
    fs.create_dir(f.work) else |_| { assert(false, "mkdir work") }
    tf_write(f.config, "set({{tabwidth: 8}})\n")
    f
}

// tf_remove (test_trust.c:39-47).
fn tf_remove(f: TrustFix) {
    assert(f.root.starts_with("/tmp/yew-trust-"), "only a /tmp/yew-trust-* tree is removed")
    fs.remove_dir_all(f.root) else |_| {}
}

fn tf_write(path: str, text: str) {
    fs.write_text(path, text) else |_| { assert(false, "write {path}") }
}

fn tf_read(path: str) -> str {
    fs.read_text(path) else |_| {
        assert(false, "read {path}")
        ""
    }
}

// tf_trust (test_trust.c:76-84).
fn tf_trust(mut db: edit.TrustDb, work: str, now: int, mut probe: edit.TrustProbe) {
    assert(edit.trust_check(mut db, work, true, false, mut probe) == edit.TRUST_PROMPT_NEW)
    assert(edit.trust_answer(mut db, probe, edit.TRUST_ALWAYS, now))
    assert(edit.trust_check(mut db, work, true, false, mut probe) == edit.TRUST_GRANTED)
}

fn trust_content_hash_invalidation_ignores_mtime() {
    let f = tf_make()
    var db = edit.trust_db_new()
    var probe = edit.trust_probe_new()
    tf_trust(mut db, f.work, 1000, mut probe)
    let t = fs.time(1234, 0)
    fs.set_times(f.config, t, t) else |_| { assert(false, "utimensat") }
    assert(edit.trust_check(mut db, f.work, true, false, mut probe) == edit.TRUST_GRANTED)
    tf_write(f.config, "set({{tabwidth: 4}})\n")
    assert(edit.trust_check(mut db, f.work, true, false, mut probe) == edit.TRUST_PROMPT_CHANGED)
    assert(edit.trust_decision_reason(edit.TRUST_PROMPT_CHANGED) == "the config changed since you trusted it")
    tf_remove(f)
}

fn trust_realpath_move_and_symlink_do_not_carry_grant() {
    let f = tf_make()
    let link = "{f.root}/link"
    let moved = "{f.root}/moved"
    fs.symlink(f.work, link) else |_| { assert(false, "symlink") }
    var db = edit.trust_db_new()
    var probe = edit.trust_probe_new()
    tf_trust(mut db, link, 1000, mut probe)
    assert(edit.trust_check(mut db, f.work, true, false, mut probe) == edit.TRUST_GRANTED)
    fs_rename(f.work, moved) else { assert(false, "rename") }
    assert(edit.trust_check(mut db, moved, true, false, mut probe) == edit.TRUST_PROMPT_NEW)
    tf_remove(f)
}

fn trust_same_path_new_inode_reprompts() {
    let f = tf_make()
    var db = edit.trust_db_new()
    var probe = edit.trust_probe_new()
    tf_trust(mut db, f.work, 1000, mut probe)
    let old = "{f.root}/old"
    fs_rename(f.work, old) else { assert(false, "rename") }
    fs.create_dir(f.work) else |_| { assert(false, "mkdir work") }
    tf_write(f.config, "set({{tabwidth: 8}})\n")
    assert(edit.trust_check(mut db, f.work, true, false, mut probe) == edit.TRUST_PROMPT_REPLACED)
    tf_remove(f)
}

fn trust_deleted_config_retains_entry() {
    let f = tf_make()
    var db = edit.trust_db_new()
    var probe = edit.trust_probe_new()
    tf_trust(mut db, f.work, 1000, mut probe)
    fs.remove(f.config) else |_| { assert(false, "unlink") }
    assert(edit.trust_check(mut db, f.work, true, false, mut probe) == edit.TRUST_NO_CONFIG)
    tf_write(f.config, "set({{tabwidth: 8}})\n")
    assert(edit.trust_check(mut db, f.work, true, false, mut probe) == edit.TRUST_GRANTED)
    tf_remove(f)
}

fn trust_write_prunes_only_old_missing_dirs() {
    let f = tf_make()
    tf_write(
        f.dbpath,
        "{{schema: 1, dirs: {{\n  \"/definitely/missing/old\": {{state: \"denied\", at: 1}},\n  \"/definitely/missing/new\": {{state: \"denied\", at: 199999}},\n  \"{f.work}\": {{state: \"denied\", at: 1}},\n}}}}\n",
    )
    var db = edit.trust_db_new()
    assert(edit.trust_db_load_path(mut db, f.dbpath))
    let w = edit.trust_db_write_path_result(mut db, f.dbpath, 200000, 1)
    assert(w.ok)
    assert(w.committed)
    let out = tf_read(f.dbpath)
    assert(!out.contains("/definitely/missing/old"))
    assert(out.contains("/definitely/missing/new"))
    assert(out.contains(f.work))
    tf_remove(f)
}

fn trust_bare_string_upgrades_and_output_sorts() {
    let f = tf_make()
    let real = fs_realpath(f.work) else {
        assert(false, "realpath")
        ""
    }
    tf_write(
        f.dbpath,
        "{{schema: 1, future: {{keep: true}}, dirs: {{\n  \"/z-last\": \"denied\",\n  \"{real}\": \"trusted\",\n  \"/a-first\": \"denied\",\n}}}}\n",
    )
    var db = edit.trust_db_new()
    var probe = edit.trust_probe_new()
    assert(edit.trust_db_load_path(mut db, f.dbpath))
    assert(edit.trust_check(mut db, f.work, true, false, mut probe) == edit.TRUST_GRANTED)
    assert(edit.trust_db_write_path(mut db, f.dbpath, 2000, 365))
    let out = tf_read(f.dbpath)
    let a = out.find("/a-first") else -1
    let z = out.find("/z-last") else -1
    assert(a >= 0)
    assert(z >= 0)
    assert(a < z)
    assert(out.contains("future: {{"))
    assert(out.contains("hash: \""))
    assert(out.contains("dev:"))
    assert(out.contains("ino:"))
    tf_remove(f)
}

fn trust_truncated_load_does_not_clobber_live_db() {
    let f = tf_make()
    tf_write(f.dbpath, "{{schema: 1, marker: \"survives\", dirs: {{}}}}\n")
    var db = edit.trust_db_new()
    assert(edit.trust_db_load_path(mut db, f.dbpath))
    tf_write(f.dbpath, "{{schema: 1, dirs: {{")
    assert(!edit.trust_db_load_path(mut db, f.dbpath))
    assert(tf_read(f.dbpath) == "{{schema: 1, dirs: {{")
    assert(edit.trust_db_write_path(mut db, f.dbpath, 1000, 365))
    assert(tf_read(f.dbpath).contains("marker: \"survives\""))
    tf_remove(f)
}

fn trust_no_tty_never_requests_prompt() {
    let f = tf_make()
    var db = edit.trust_db_new()
    var probe = edit.trust_probe_new()
    assert(edit.trust_check(mut db, f.work, false, false, mut probe) == edit.TRUST_SKIP_NO_TTY)
    assert(edit.trust_check(mut db, f.work, false, true, mut probe) == edit.TRUST_GRANTED)
    tf_remove(f)
}

fn main() {
    trust_content_hash_invalidation_ignores_mtime()
    trust_realpath_move_and_symlink_do_not_carry_grant()
    trust_same_path_new_inode_reprompts()
    trust_deleted_config_retains_entry()
    trust_write_prunes_only_old_missing_dirs()
    trust_bare_string_upgrades_and_output_sorts()
    trust_truncated_load_does_not_clobber_live_db()
    trust_no_tty_never_requests_prompt()
    print("edit_trust: 8 cases pass")
}
