//! member: false
//! R-yw09-6's witness, the port's half: `ed.fl.eval` reached through
//! `ed.run` from a frame that is not the user config. sagitta 9ace98c2
//! compiles the nested source with runtime_origin() (fleval.c:30-33,
//! 263-302: CONFIG, every capability) and command_caps (flapi.c:1911-1933)
//! has no row for ed.fl.eval, so fl_cap_origin (origin.c:207-228) answers
//! CONFIG inside the nested chunk: a capability the frame lacks is
//! granted, and a registration is owned by the user config.
//!
//! R-yw09-6 is decided A: the nested chunk runs under the calling
//! chunk's principal (`fl_cap_origin`), a deliberate divergence from C.
//! Each case prints the line notes/yw09-evidence/nested-eval/witness.c
//! prints for C, so a diff of the two outputs shows exactly B and D
//! flipped; the asserts hold the port to A.

use edit
use fl

fn live_buffers(ed: edit.Ed) -> int {
    var n = 0
    for b in ed.bufs { if b.id != 0 { n += 1 } }
    n
}

fn narrow() -> fl.FlOrigin { fl.fl_origin_new(fl.FL_ORIGIN_WORKSPACE, 0) }

// One observation, as witness.c's run(): ok, the buffer and hook counts,
// the last hook's origin, the error's first line.
fn run(mut ed: edit.Ed, tag: str, source: str) -> (bool, int, int) {
    let _ = edit.fl_runtime_init(mut ed)
    let nbufs = live_buffers(ed)
    let nhooks = ed.flrt.vms[0].hooks.rows.len
    ed.flrt.vms[0].root_origin = narrow()
    let (status, result) = edit.fl_eval_source(mut ed, source.bytes(), "<witness>", narrow(), false)
    ed.flrt.vms[0].root_origin = fl.fl_origin_new(fl.FL_ORIGIN_CONFIG, fl.FL_CAP_ALL)
    let ok = status == edit.CMD_OK
    let after = live_buffers(ed)
    let hooks = ed.flrt.vms[0].hooks.rows.len
    let okn = if ok then 1 else 0
    var line = "{tag}: ok={okn} buffers {nbufs}->{after} hooks {nhooks}->{hooks}"
    var origin = -1
    if hooks > nhooks {
        origin = ed.flrt.vms[0].hooks.rows[hooks - 1].origin
        line = "{line} last-hook-origin={origin}"
        if origin >= 0 && origin < ed.origins.v.len {
            let kind = ed.origins.v[origin].kind
            let caps = ed.origins.v[origin].caps
            line = "{line} kind={kind} caps={caps}"
        }
    }
    if !ok {
        var trace = List[byte]()
        fl.fl_trace_render(mut ed.flrt.vms[0], result, mut trace)
        var first = List[byte]()
        for b in trace {
            if b == 10 as byte { break }
            (mut first).push(b)
        }
        let text = str_from_utf8(first) else "?"
        line = "{line} error={text}"
    }
    print(line)
    (ok, after - nbufs, origin)
}

fn main() {
    let tmp = env_get("TMPDIR") else "/tmp"
    let a = "{tmp}/yw09-nested-eval-a.txt"
    let b = "{tmp}/yw09-nested-eval-b.txt"
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    let wk = fl.FL_ORIGIN_WORKSPACE
    print("restricted frame: kind={wk} (FL_ORIGIN_WORKSPACE) caps=0")
    let (a_ok, a_bufs, _) = run(
        mut ed,
        "A direct ed.buf.open",
        "import ed\ned.run(\"ed.buf.open\", {{\"sarg\": \"{a}\"}})\n",
    )
    assert(!a_ok && a_bufs == 0)
    let (b_ok, b_bufs, _) = run(
        mut ed,
        "B nested ed.buf.open",
        "import ed\ned.run(\"ed.fl.eval\", {{\"sarg\": \"import ed\\ned.run(\\\"ed.buf.open\\\", {{\\\"sarg\\\": \\\"{b}\\\"}})\"}})\n",
    )
    // R-yw09-6 (A): the nested chunk lacks fs.read as its caller does
    // (C: granted, one buffer opened).
    assert(!b_ok && b_bufs == 0)
    let (c_ok, _, c_origin) = run(
        mut ed,
        "C direct on(ed.idle)",
        "on(\"ed.idle\", fn() {{ nil }})\n",
    )
    assert(c_ok && c_origin != fl.FL_ORIGIN_ID_CONFIG)
    let (d_ok, _, d_origin) = run(
        mut ed,
        "D nested on(ed.idle)",
        "import ed\ned.run(\"ed.fl.eval\", {{\"sarg\": \"on(\\\"ed.idle\\\", fn() {{ nil }})\"}})\n",
    )
    // R-yw09-6 (A): the nested registration belongs to the caller, as
    // C's direct one does (C: owned by the user config).
    assert(d_ok && d_origin != fl.FL_ORIGIN_ID_CONFIG && d_origin == c_origin)
    print("nested eval: 4 observations, B and D flipped from C (R-yw09-6 A)")
}
