//! member: false
//!
//! The port of sagitta `tests/unit/test_osc52.c` (195 lines), one test per
//! C test in registry order (`tests/unit/registry.c:688-691`). The log
//! capture is a `YEW_LOG` scratch file.

use std.fs
use term

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn count(out: List[byte], needle: List[byte]) -> int {
    var n = 0
    var i = 0
    while i + needle.len <= out.len {
        var j = 0
        while j < needle.len && out[i + j] == needle[j] {
            j += 1
        }
        if j == needle.len {
            n += 1
        }
        i += 1
    }
    n
}

fn env_of(m: Map[str, str]) -> term.Env {
    term.env_of(m)
}

fn t_osc52_plain_targets_and_limit() {
    let targets = ["c", "p", "cp"]
    let expected = ["\x1b]52;c;Zm9v\x1b\\", "\x1b]52;p;Zm9v\x1b\\", "\x1b]52;cp;Zm9v\x1b\\"]
    var i = 0
    while i < 3 {
        var out = List[byte]()
        assert(
            term.osc52_build(mut out, bytes_of("foo"), targets[i], term.OSC52_PLAIN, 4),
            "builds {targets[i]}",
        )
        assert(same(out, bytes_of(expected[i])), "plain {targets[i]}")
        i += 1
    }
    var empty = List[byte]()
    assert(
        term.osc52_build(mut empty, List[byte](), "c", term.OSC52_PLAIN, 0),
        "empty payload builds",
    )
    assert(same(empty, bytes_of("\x1b]52;c;\x1b\\")), "empty sequence")
    var sentinel = bytes_of("sentinel")
    assert(
        !term.osc52_build(mut sentinel, bytes_of("foo"), "c", term.OSC52_PLAIN, 3),
        "over the cap is refused",
    )
    assert(same(sentinel, bytes_of("sentinel")), "out untouched")
    assert(
        !term.osc52_build(mut sentinel, bytes_of("foo"), "c", term.OSC52_OFF, 100),
        "off is refused",
    )
    assert(sentinel.len == 8, "still untouched")
}

fn t_osc52_tmux_escape_doubling_golden() {
    var payload = List[byte]()
    (mut payload).push(27 as byte)
    (mut payload).push(88 as byte)
    var out = List[byte]()
    assert(term.osc52_build(mut out, payload, "c", term.OSC52_TMUX, 100), "tmux builds")
    assert(same(out, bytes_of("\x1bPtmux;\x1b\x1b]52;c;G1g=\x1b\x1b\\\x1b\\")), "tmux golden")
    assert(count(out, bytes_of("\x1b\x1b")) == 2, "two doubled escapes")
}

fn t_osc52_screen_chunking_golden() {
    var payload = List[byte]()
    var i = 0
    while i < 1350 {
        (mut payload).push(0 as byte)
        i += 1
    }
    var out = List[byte]()
    assert(term.osc52_build(mut out, payload, "cp", term.OSC52_SCREEN, 1800), "screen builds")
    assert(out.len == 1822, "1822 bytes, got {out.len}")
    assert(count(out, bytes_of("\x1bP")) == 3, "three DCS")
    assert(count(out, bytes_of("\x1b]52;")) == 1, "one OSC head")
    let sizes = [768, 768, 264]
    var offset = 0
    i = 0
    while i < 3 {
        if i == 0 {
            assert(same(out[offset..offset + 10], bytes_of("\x1bP\x1b]52;cp;")), "first head")
            offset += 10
        } else {
            assert(same(out[offset..offset + 2], bytes_of("\x1bP")), "DCS")
            offset += 2
        }
        var j = 0
        while j < sizes[i] {
            assert(out[offset + j] as int == 65, "A")
            j += 1
        }
        offset += sizes[i]
        if i == 2 {
            assert(same(out[offset..offset + 4], bytes_of("\x1b\\\x1b\\")), "double ST at the end")
            offset += 4
        } else {
            assert(same(out[offset..offset + 2], bytes_of("\x1b\\")), "ST")
            offset += 2
        }
        i += 1
    }
    assert(offset == out.len, "consumed whole")
}

fn log_contains(path: str, needle: str) -> bool {
    let text = fs.read_text(path) else ""
    text.contains(needle)
}

fn log_lines(path: str) -> int {
    let text = fs.read_text(path) else ""
    text.lines().len
}

fn t_osc52_environment_selection(log_path: str) {
    var off = Map[str, str]()
    off["YEW_OSC52"] = "off"
    assert(term.osc52_mode(env_of(off)) == term.OSC52_OFF, "forced off")
    var plain = Map[str, str]()
    plain["YEW_OSC52"] = "plain"
    plain["TMUX"] = "/tmp/tmux"
    assert(term.osc52_mode(env_of(plain)) == term.OSC52_PLAIN, "forced plain beats TMUX")
    var tmux = Map[str, str]()
    tmux["TMUX"] = "/tmp/tmux"
    assert(term.osc52_mode(env_of(tmux)) == term.OSC52_TMUX, "TMUX")
    var sty = Map[str, str]()
    sty["STY"] = "123.session"
    assert(term.osc52_mode(env_of(sty)) == term.OSC52_SCREEN, "STY")
    var screen = Map[str, str]()
    screen["TERM"] = "screen-256color"
    assert(term.osc52_mode(env_of(screen)) == term.OSC52_SCREEN, "TERM screen")
    var none = Map[str, str]()
    assert(term.osc52_mode(env_of(none)) == term.OSC52_PLAIN, "default plain")
    var tl = Map[str, str]()
    tl["YEW_CLIPBOARD_TARGET"] = "cp"
    tl["YEW_OSC52_MAX"] = "4096"
    assert(term.osc52_target(env_of(tl)) == "cp", "target cp")
    assert(term.osc52_max(env_of(tl)) == 4096, "max 4096")
    var out = List[byte]()
    assert(term.osc52_build_env(mut out, bytes_of("f"), env_of(tl)), "env build")
    assert(same(out, bytes_of("\x1b]52;cp;Zg==\x1b\\")), "env golden")
    fs.remove(log_path) else |_| {}
    var invalid = Map[str, str]()
    invalid["YEW_OSC52"] = "wat"
    invalid["YEW_CLIPBOARD_TARGET"] = "x"
    invalid["YEW_OSC52_MAX"] = "12x"
    assert(term.osc52_mode(env_of(invalid)) == term.OSC52_PLAIN, "invalid mode falls to plain")
    assert(term.osc52_target(env_of(invalid)) == "c", "invalid target falls to c")
    assert(
        term.osc52_max(env_of(invalid)) == term.OSC52_DEFAULT_MAX,
        "invalid max falls to default",
    )
    assert(log_lines(log_path) >= 3, "three warnings logged")
    assert(log_contains(log_path, "invalid YEW_OSC52"), "the mode warning")
}

fn main() {
    let log_path = "target/tests/term-osc52-test.log"
    fs.create_dir_all("target/tests") else |_| {}
    env_set("YEW_LOG", log_path) else |_| {}
    env_set("YEW_LOG_LEVEL", "debug") else |_| {}
    t_osc52_plain_targets_and_limit()
    t_osc52_tmux_escape_doubling_golden()
    t_osc52_screen_chunking_golden()
    t_osc52_environment_selection(log_path)
    fs.remove(log_path) else |_| {}
    print("osc52_test: 4 cases pass")
}
