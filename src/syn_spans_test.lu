//! member: false
//! Ports semantic ids and emit_span/emit_truncated_line from sagitta
//! src/syn/{attr.h,defs.c,engine.c} at 9ace98c2. Span payloads stay 8 bytes.
use syn

fn semantic_ids() {
    var n = 0
    for name in syn.syn_attr_names().words() {
        assert((syn.syn_attr_id(name) else -1) == n, "semantic id order")
        assert((syn.syn_attr_name(n) else "") == name, "semantic name roundtrip")
        n += 1
    }
    assert(n == 54, "closed semantic vocabulary")
    assert((syn.syn_attr_id("not.an.attr") else -1) == -1, "unknown attr is absent")
    assert((syn.syn_attr_name(54) else "absent") == "absent", "past-end attr absent")
    assert(syn.syn_attr_parent(2) == 1, "keyword.control parent")
    assert(syn.syn_attr_parent(6) == 5, "type.builtin parent")
    assert(syn.syn_attr_parent(10) == 7, "boolean parent")
    assert(syn.syn_attr_parent(49) == 1, "motion.unit parent")
    assert(syn.syn_attr_parent(52) == 19, "motion.cmd parent")
}

fn coalesce() {
    var out = syn.syn_spans_new(8)
    syn.syn_spans_emit(mut out, 0, 2, 1, 0)
    syn.syn_spans_emit(mut out, 2, 3, 1, 0)
    assert(out.n == 1, "adjacent equal attr spans coalesce")
    assert(syn.syn_span_start(out, 0) == 0, "start retained")
    assert(syn.syn_span_len(out, 0) == 5, "coalesced length")
    syn.syn_spans_emit(mut out, 5, 1, 1, 1)
    assert(out.n == 2, "flags prevent coalescing")
    syn.syn_spans_emit(mut out, 7, 1, 1, 1)
    assert(out.n == 3, "nonadjacent spans do not coalesce")
    assert(syn.syn_spans_storage_bytes(out) == 64, "eight bytes per reserved span")
}

fn split_u16() {
    var out = syn.syn_spans_new(4)
    syn.syn_spans_emit(mut out, 0, 65536, 12, 0)
    assert(out.n == 2, "u16 length splits long run")
    assert(syn.syn_span_len(out, 0) == 65535, "first maximum run")
    assert(syn.syn_span_start(out, 1) == 65535, "second starts at first end")
    assert(syn.syn_span_len(out, 1) == 1, "second remainder")
    syn.syn_spans_clear(mut out, 1)
    syn.syn_spans_emit(mut out, 0, 60000, 12, 0)
    syn.syn_spans_emit(mut out, 60000, 10000, 12, 0)
    assert(out.n == 2, "do not invent partial coalescing across u16 cap")
    assert(syn.syn_span_len(out, 0) == 60000, "C's first run unchanged")
    assert(syn.syn_span_len(out, 1) == 10000, "C's second run unchanged")
}

fn capacity_stop() {
    var out = syn.syn_spans_new(2)
    syn.syn_spans_emit(mut out, 0, 1, 1, 0)
    syn.syn_spans_emit(mut out, 1, 1, 2, 0)
    syn.syn_spans_emit(mut out, 2, 1, 3, 0)
    assert(out.n == 2, "span cap enforced")
    assert(out.stop == syn.SYN_STOP_SPANS, "stop reason observable")
    assert(syn.syn_span_flags(out, 1) == syn.SYN_SPAN_TRUNCATED, "last span marked truncated")
    out.stop = syn.SYN_STOP_STEPS
    syn.syn_spans_emit(mut out, 3, 1, 3, 0)
    assert(out.stop == syn.SYN_STOP_STEPS, "earlier stop reason preserved")
}

fn truncated_line() {
    var out = syn.syn_spans_new(4)
    syn.syn_spans_emit_truncated(mut out, 70000)
    assert(out.n == 2, "truncated plain text still covers long line")
    assert(syn.syn_span_attr(out, 0) == 0, "truncated line is text")
    assert(syn.syn_span_attr(out, 1) == 0, "truncated remainder is text")
    assert(syn.syn_span_flags(out, 0) == 1, "first fragment marked")
    assert(syn.syn_span_flags(out, 1) == 1, "second fragment marked")
    assert(syn.syn_span_len(out, 1) == 4465, "last fragment covers remainder")
}

fn zero_and_reset() {
    var out = syn.syn_spans_new(0)
    syn.syn_spans_emit(mut out, 0, 1, 1, 0)
    assert(out.n == 0, "zero output capacity")
    assert(out.stop == syn.SYN_STOP_SPANS, "zero capacity reports spans stop")
    var reused = syn.syn_spans_new(2)
    syn.syn_spans_emit(mut reused, 0, 0, 1, 0)
    assert(reused.n == 0, "zero-length match emits no span")
    syn.syn_spans_emit(mut reused, 4294967294, 1, 53, 255)
    assert(syn.syn_span_start(reused, 0) == 4294967294, "u32 high bits retained")
    assert(syn.syn_span_attr(reused, 0) == 53, "closed vocabulary last id")
    syn.syn_spans_clear(mut reused, 17)
    assert(reused.n == 0 && reused.stop == 0 && reused.exit_state == 17, "reusable out reset")
    assert(syn.syn_spans_storage_bytes(reused) == 16, "reset keeps storage")
}

fn main() {
    let selected = (env_get("YEW_SYN_SPAN_CASE") else "-1").to_int() else -1
    var i = 0
    while i < 6 {
        if selected == -1 || selected == i {
            match i {
                0 => semantic_ids(),
                1 => coalesce(),
                2 => split_u16(),
                3 => capacity_stop(),
                4 => truncated_line(),
                _ => zero_and_reset(),
            }
            print("syn_span_case_{i}: PASS")
        }
        i += 1
    }
}
