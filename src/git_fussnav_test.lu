//! member: false
//!
//! The port of sagitta `tests/unit/test_fussnav.c` (194 lines), one test
//! per C test in registry order: fuss's depth navigation over the flat
//! list. C's 12-item, 4-depth fixture is items with depths only (no
//! nodes), exactly as C builds it with `memset`.
//!
//! `YEW_PICK_CASE=N` runs case N alone (the checked machine's per-case run).

use git

fn b(s: str) -> List[byte] {
    var v = List[byte]()
    for x in s.bytes() {
        (mut v).push(x)
    }
    v
}

// `fn_depth_fixture` (`test_fussnav.c:8-22`).
fn depth_fixture() -> git.FussTree {
    var t = git.fuss_tree_new()
    for d in [0, 1, 1, 2, 3, 2, 1, 0, 1, 2, 0, 0] {
        (mut t.items).push(git.FussItem { node: 0, depth: d, is_file: false })
    }
    t
}

// `fn_entry` (`:24-36`): a directory is untracked, a file unstaged.
fn add(mut s: git.GitSnapshot, path: str, dir: bool) {
    var e = git.git_entry_new()
    e.kind = if dir then git.GIT_E_UNTRACKED else git.GIT_E_ORDINARY
    e.path_at = git.git_pool_add(mut s.pool, b(path), 0, path.len)
    e.path_len = path.len
    e.is_dir = dir
    e.untracked = dir
    e.unstaged = !dir
    (mut s.entries).push(e)
}

// `fn_row` (`:49-59`).
fn row(t: git.FussTree, path: str) -> int {
    let p = b(path)
    var i = 0
    while i < t.items.len {
        if git.fuss_item_path_eq(t, i, p, 0, p.len) {
            return i
        }
        i += 1
    }
    -1
}

fn none() -> git.FussOpts {
    git.FussOpts { all_files: false, show_hidden: false }
}

// `:61-70`.
fn fussnav_next_visits_the_next_row_at_the_same_depth() {
    let want = [7, 2, 6, 5, 4, 9, 8, 10, 1, 3, 11, 0]
    let t = depth_fixture()
    var i = 0
    while i < want.len {
        assert(git.fuss_nav_step(t, i, 1) == want[i], "next from {i}")
        i += 1
    }
}

// `:72-81`.
fn fussnav_prev_visits_the_previous_row_at_the_same_depth() {
    let want = [11, 8, 1, 9, 4, 3, 2, 0, 6, 5, 7, 10]
    let t = depth_fixture()
    var i = 0
    while i < want.len {
        assert(git.fuss_nav_step(t, i, -1) == want[i], "prev from {i}")
        i += 1
    }
}

// `:83-90`.
fn fussnav_only_item_at_depth_stays_selected() {
    let t = depth_fixture()
    assert(git.fuss_nav_step(t, 4, 1) == 4, "only at depth 3, next")
    assert(git.fuss_nav_step(t, 4, -1) == 4, "only at depth 3, prev")
}

// `:92-103`.
fn fussnav_raw_rows_ignore_depth_and_clamp() {
    let t = depth_fixture()
    assert(git.fuss_nav_raw(t, 0, 1) == 1, "0 down")
    assert(git.fuss_nav_raw(t, 1, 1) == 2, "1 down")
    assert(git.fuss_nav_raw(t, 11, 1) == 11, "clamp bottom")
    assert(git.fuss_nav_raw(t, 11, -1) == 10, "11 up")
    assert(git.fuss_nav_raw(t, 1, -1) == 0, "1 up")
    assert(git.fuss_nav_raw(t, 0, -1) == 0, "clamp top")
}

// `:105-122`.
fn fussnav_parent_finds_the_nearest_earlier_shallower_row() {
    let want = [0, 0, 0, 2, 3, 2, 0, 7, 7, 8, 10, 11]
    let t = depth_fixture()
    var i = 0
    while i < want.len {
        assert(git.fuss_nav_parent(t, i) == want[i], "parent of {i}")
        i += 1
    }
}

// `:124-152`.
fn fussnav_enter_expands_then_descends() {
    var s = git.git_snapshot_new()
    s.gen = 1
    add(mut s, "a/deep/leaf.c", false)
    add(mut s, "root.c", false)
    var t = git.fuss_tree_new()
    git.fuss_build(mut t, s, none())
    let a = row(t, "a")
    assert(a >= 0, "a")
    assert(row(t, "a/deep") == -1, "a collapsed")
    assert(git.fuss_nav_toggle(mut t, a), "open a")
    let deep = row(t, "a/deep")
    assert(deep > a, "deep shown")
    assert(row(t, "a/deep/leaf.c") == -1, "deep collapsed")
    assert(git.fuss_nav_enter(mut t, deep) == deep + 1, "enter descends")
    assert(git.fuss_item_path_eq(t, deep + 1, b("a/deep/leaf.c"), 0, 13), "leaf next")
    assert(t.nodes[t.items[deep].node].expanded, "deep expanded")
}

// `:154-179`.
fn fussnav_enter_on_file_or_childless_directory_stays() {
    var s = git.git_snapshot_new()
    s.gen = 1
    add(mut s, "file.c", false)
    add(mut s, "empty/", true)
    var t = git.fuss_tree_new()
    git.fuss_build(mut t, s, none())
    let file = row(t, "file.c")
    let empty = row(t, "empty")
    assert(file >= 0 && empty >= 0, "rows")
    assert(git.fuss_nav_enter(mut t, file) == file, "file stays")
    assert(git.fuss_nav_enter(mut t, empty) == empty, "childless dir stays")
    assert(!git.fuss_nav_toggle(mut t, file), "file does not toggle")
    assert(!git.fuss_nav_toggle(mut t, empty), "unloaded untracked dir does not toggle")
    assert(row(t, "empty") == empty, "unchanged")
}

// `:181-194`.
fn fussnav_empty_tree_is_total() {
    var t = git.fuss_tree_new()
    assert(git.fuss_nav_step(t, 0, 1) == -1, "step")
    assert(git.fuss_nav_step(t, 0, -1) == -1, "step back")
    assert(git.fuss_nav_raw(t, 0, 1) == -1, "raw")
    assert(git.fuss_nav_raw(t, 0, -1) == -1, "raw back")
    assert(git.fuss_nav_parent(t, 0) == -1, "parent")
    assert(git.fuss_nav_enter(mut t, 0) == -1, "enter")
    assert(!git.fuss_nav_toggle(mut t, 0), "toggle")
}

fn main() {
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    var n = 0
    if chosen < 0 || chosen == 0 {
        fussnav_next_visits_the_next_row_at_the_same_depth()
        print("fussnav_next_visits_the_next_row_at_the_same_depth: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 1 {
        fussnav_prev_visits_the_previous_row_at_the_same_depth()
        print("fussnav_prev_visits_the_previous_row_at_the_same_depth: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 2 {
        fussnav_only_item_at_depth_stays_selected()
        print("fussnav_only_item_at_depth_stays_selected: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 3 {
        fussnav_raw_rows_ignore_depth_and_clamp()
        print("fussnav_raw_rows_ignore_depth_and_clamp: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 4 {
        fussnav_parent_finds_the_nearest_earlier_shallower_row()
        print("fussnav_parent_finds_the_nearest_earlier_shallower_row: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 5 {
        fussnav_enter_expands_then_descends()
        print("fussnav_enter_expands_then_descends: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 6 {
        fussnav_enter_on_file_or_childless_directory_stays()
        print("fussnav_enter_on_file_or_childless_directory_stays: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 7 {
        fussnav_empty_tree_is_total()
        print("fussnav_empty_tree_is_total: PASS")
        n += 1
    }
    print("git_fussnav_test: {n} cases run")
}
