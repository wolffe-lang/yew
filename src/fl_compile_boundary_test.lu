//! member: false
//! sagitta 9ace98c2 compile.c:1379-1424 versus flcli.c:346-369:
//! incomplete is a caller policy, not a second compiler rejection.

use fl

fn main() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let source = "let done = 7\nif true {{"
    var bytes = List[byte]()
    for b in source.bytes() { (mut bytes).push(b) }
    let p = fl.fl_parse(bytes, 0, mut vm.dc, mut vm.strings)
    assert(p.incomplete && !p.had_error)
    let fun = fl.fl_compile(mut vm, p, 0, fl.fl_origin_new(4, 0)) else fl.fl_nil()
    assert(fun.t == 7 && vm.dc.nerrors == 0)
    print("PASS fl_compile caller_owns_incomplete_policy")
}
