//! member: false
//!
//! The port of sagitta `tests/unit/test_sel_actions.c` (974 lines), one
//! test per C test in registry order (`tests/unit/registry.c:827-856`).
//! C's fixture is the runtime-configured scratch editor with the buffer's
//! text and undo tree replaced, tab width 4, LF, clipboard sync off, in H
//! over the line unit; the port's is `edit.ed_new_test` with the same.
//! `invoke_change` is C's direct handler call wrapped in the transaction
//! the dispatcher would open; `invoke_registered` is THE invoke. The
//! paste cases read the system clipboard through a fake `cmd:` reader
//! (C's `fakeclip`); the port's subprocess clipboard READER is yw02's
//! named gap at wolf 0.2.33 (`text.clipboard`'s `reader_gap`: no timed
//! wait on a pipe; `os_signal_wait_fds`, wolf-lang#795, is 0.2.34), a
//! hard error by name — so those halves SKIP loudly, and the half that
//! needs no reader (`YEW_CLIPBOARD=none`) runs.

use edit
use std.fs
use term
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn raw(xs: List[int]) -> List[byte] {
    var v = List[byte]()
    for x in xs {
        (mut v).push(x as byte)
    }
    v
}

fn say(line: str) {
    print(line)
    eprint(line)
}

fn runtime() -> List[byte] {
    let bytes = fs_read_bytes("runtime/init.fl") else List[byte]()
    assert(bytes.len != 0, "runtime/init.fl is readable from the repository root")
    bytes
}

// `fixture_init` (`test_sel_actions.c:19-34`).
fn fixture(bytes: List[byte]) -> edit.Ed {
    var ed = edit.ed_new_test(runtime(), "")
    let w = ed.win
    let b = ed.wins[w].buf
    ed.bufs[b].ec.tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
    ed.bufs[b].ec.undo = text.undo_new(ed.bufs[b].ec.tb)
    ed.bufs[b].tabwidth = 4
    ed.bufs[b].ec.meta.eol = text.EOL_LF
    ed.bufs[b].ec.meta.dominant_eol = text.EOL_LF
    ed.regs.clipboard_sync = text.CLIP_SYNC_OFF
    assert(edit.mode_enter_highlight(mut ed, edit.MODE_L, false) == edit.CMD_OK, "H over L")
    ed
}

fn fixture_str(s: str) -> edit.Ed {
    fixture(bytes_of(s))
}

fn sel(lo: int, hi: int) -> text.Cursor {
    text.Cursor { pos: hi, goal_col: 0, anchor: lo }
}

// `set_selection` (`test_sel_actions.c:48-55`).
fn set_selection(mut ed: edit.Ed, kind: int, lo: int, hi: int) {
    let w = ed.win
    let b = ed.wins[w].buf
    ed.wins[w].h.kind = kind
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p] = sel(lo, hi)
    text.cset_normalize(ed.bufs[b].ec.tb, mut ed.wins[w].cs)
}

// `add_selection` (`test_sel_actions.c:57-61`).
fn add_selection(mut ed: edit.Ed, lo: int, hi: int) {
    let w = ed.win
    let b = ed.wins[w].buf
    assert(text.cset_add(mut ed.wins[w].cs, sel(lo, hi)), "add {lo}..{hi}")
    text.cset_normalize(ed.bufs[b].ec.tb, mut ed.wins[w].cs)
}

fn buf(ed: edit.Ed) -> int {
    ed.wins[ed.win].buf
}

fn assert_bytes(ed: edit.Ed, want: List[byte], what: str) {
    let got = text.textbuf_bytes(ed.bufs[buf(ed)].ec.tb)
    assert(got.len == want.len, "{what}: {got.len} bytes, want {want.len}")
    var i = 0
    while i < got.len {
        assert(got[i] == want[i], "{what}: byte {i} differs")
        i += 1
    }
}

fn assert_text(ed: edit.Ed, want: str, what: str) {
    assert_bytes(ed, bytes_of(want), what)
}

fn cx_of(ed: edit.Ed, arg: str, has: bool) -> edit.CmdCtx {
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    cx.sarg = arg
    cx.has_sarg = has
    cx
}

// The handlers `invoke_change` calls (`CmdFn`).
const H_CASE_UPPER: int = 0

const H_CASE_LOWER: int = 1

const H_CASE_TOGGLE: int = 2

const H_INDENT: int = 3

const H_DEDENT: int = 4

const H_JOIN: int = 5

const H_REPLACE_CHAR: int = 6

const H_SHIFT_LEFT: int = 7

const H_SHIFT_RIGHT: int = 8

const H_RECT_INSERT: int = 9

const H_RECT_APPEND: int = 10

fn call(mut ed: edit.Ed, which: int, cx: edit.CmdCtx) -> int {
    match which {
        0 => edit.sc_case_upper(mut ed, cx),
        1 => edit.sc_case_lower(mut ed, cx),
        2 => edit.sc_case_toggle(mut ed, cx),
        3 => edit.sc_indent(mut ed, cx),
        4 => edit.sc_dedent(mut ed, cx),
        5 => edit.sc_join(mut ed, cx),
        6 => edit.sc_replace_char(mut ed, cx),
        7 => edit.sc_shift_left(mut ed, cx),
        8 => edit.sc_shift_right(mut ed, cx),
        9 => edit.sc_rect_insert(mut ed, cx),
        _ => edit.sc_rect_append(mut ed, cx),
    }
}

// `invoke_change` (`test_sel_actions.c:91-111`).
fn invoke_change(mut ed: edit.Ed, which: int, arg: str, has: bool) -> int {
    let w = ed.win
    let cx = cx_of(ed, arg, has)
    edit.ed_undo_begin(
        mut ed,
        w,
        if ed.wins[w].cs.curs.len > 1 then text.TXN_MULTI else text.TXN_TYPE,
    )
    let status = call(mut ed, which, cx)
    if status == edit.CMD_OK {
        edit.ed_undo_end(mut ed, w)
    } else {
        edit.ed_undo_abort(mut ed, w)
    }
    status
}

// `invoke_registered` (`test_sel_actions.c:113-127`).
fn invoke_registered(mut ed: edit.Ed, name: str, arg: str, has: bool) -> int {
    let id = edit.cmd_lookup(ed.reg, name)
    assert(id != 0, "{name} is registered")
    var cx = cx_of(ed, arg, has)
    edit.ed_cmd_invoke(mut ed, id, mut cx)
}

fn reg(mut ed: edit.Ed, name: int) -> text.RegVal {
    text.reg_get(mut ed.regs, name) else text.regval_new()
}

fn reg_is(v: text.RegVal, want: str, what: str) {
    let w = want.bytes()
    assert(v.bytes.len >= w.len, "{what}: {v.bytes.len} bytes")
    var i = 0
    while i < w.len {
        assert(v.bytes[i] == w[i], "{what}: byte {i} differs")
        i += 1
    }
}

fn last_reason(ed: edit.Ed) -> int {
    let u = ed.bufs[buf(ed)].ec.undo
    u.nodes[u.nodes.len - 1].reason
}

fn skip(what: str) -> int {
    say(
        "sel_actions_test: SKIP {what}: the subprocess clipboard reader (yw02 [reg] gap: no timed pipe wait at wolf 0.2.33; os_signal_wait_fds, wolf-lang#795, is 0.2.34)",
    )
    1
}

fn restore_clipboard_env(mut ed: edit.Ed, saved: str, had: bool) {
    text.clip_shutdown(mut ed.regs.clip)
    if had {
        env_set("YEW_CLIPBOARD", saved) else |_| {}
    } else {
        env_unset("YEW_CLIPBOARD") else |_| {}
    }
    text.clip_reset(mut ed.regs.clip)
}

// `test_sel_actions_yank_uses_char_line_and_block_register_types`.
fn t_sel_actions_yank_uses_char_line_and_block_register_types() {
    var ed = fixture_str("ab\ncd\nef")
    set_selection(mut ed, edit.SEL_CHAR, 0, 2)
    let cx = cx_of(ed, "", false)
    assert(edit.sc_yank(mut ed, cx) == edit.CMD_OK, "yank")
    let r1 = reg(mut ed, '"' as int)
    assert(r1.kind == text.REG_CHARWISE && r1.bytes.len == 2, "charwise ab")
    reg_is(r1, "ab", "charwise")
    set_selection(mut ed, edit.SEL_LINE, 3, 4)
    assert(edit.sc_yank(mut ed, cx) == edit.CMD_OK, "yank line")
    let r2 = reg(mut ed, '"' as int)
    assert(r2.kind == text.REG_LINEWISE, "linewise")
    reg_is(r2, "cd\n", "linewise")
    set_selection(mut ed, edit.SEL_RECT, 1, 8)
    assert(edit.sc_yank(mut ed, cx) == edit.CMD_OK, "yank rect")
    let r3 = reg(mut ed, '"' as int)
    assert(r3.kind == text.REG_BLOCKWISE && r3.rows.len == 3 && r3.width == 1, "blockwise 3x1")
    reg_is(r3, "bdf", "blockwise")
}

// `test_sel_actions_yank_pads_short_rect_rows_by_cell_width`.
fn t_sel_actions_yank_pads_short_rect_rows_by_cell_width() {
    var ed = fixture_str("a\nbb\n")
    set_selection(mut ed, edit.SEL_RECT, 0, 4)
    let cx = cx_of(ed, "", false)
    assert(edit.sc_yank(mut ed, cx) == edit.CMD_OK, "yank")
    let r = reg(mut ed, '"' as int)
    assert(r.kind == text.REG_BLOCKWISE && !r.ragged && r.width == 2, "a 2-wide block")
    assert(r.bytes.len == 4, "four bytes")
    reg_is(r, "a bb", "padded")
    assert(r.rows.len == 2, "two rows")
    assert(
        r.rows[0].lo == 0 && r.rows[0].hi == 2 && r.rows[1].lo == 2 && r.rows[1].hi == 4,
        "rows 0..2 2..4",
    )
}

// `test_sel_actions_clip_copy_and_cut_use_explicit_system_register`.
fn t_sel_actions_clip_copy_and_cut_use_explicit_system_register() {
    let (saved, had) = term.env_getv("YEW_CLIPBOARD")
    env_set("YEW_CLIPBOARD", "none") else |_| {}
    var ed = fixture_str("ab cd")
    ed.regs.clipboard_sync = text.CLIP_SYNC_OFF
    set_selection(mut ed, edit.SEL_CHAR, 0, 2)
    assert(invoke_registered(mut ed, "ed.clip.copy", "", false) == edit.CMD_OK, "copy")
    assert_text(ed, "ab cd", "unchanged")
    assert(ed.mode == edit.MODE_H, "still H")
    let plus = reg(mut ed, '+' as int)
    assert(plus.bytes.len == 2, "+ holds 2 bytes")
    reg_is(plus, "ab", "+")
    reg_is(reg(mut ed, '"' as int), "ab", "\"")
    reg_is(reg(mut ed, '0' as int), "ab", "0")
    set_selection(mut ed, edit.SEL_CHAR, 3, 5)
    assert(invoke_registered(mut ed, "ed.clip.cut", "", false) == edit.CMD_OK, "cut")
    assert_text(ed, "ab ", "cut")
    let plus2 = reg(mut ed, '+' as int)
    assert(plus2.bytes.len == 2, "+ holds the cut")
    reg_is(plus2, "cd", "+ cut")
    assert(ed.mode == edit.MODE_L, "L after the cut")
    assert(last_reason(ed) == text.TXN_CUT, "a CUT node")
    assert(ed.damage_batch_finalizations == 1, "one batch")
    restore_clipboard_env(mut ed, saved, had)
}

