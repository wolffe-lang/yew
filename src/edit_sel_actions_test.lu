// `test_sel_actions_clip_paste_failure_and_empty_are_atomic`: the empty
// reader's half SKIPs; the no-clipboard half runs.
fn t_sel_actions_clip_paste_failure_and_empty_are_atomic() -> int {
    let (saved, had) = term.env_getv("YEW_CLIPBOARD")
    var ed = fixture_str("abcd")
    set_selection(mut ed, edit.SEL_CHAR, 1, 3)
    env_set("YEW_CLIPBOARD", "none") else |_| {}
    text.clip_reset(mut ed.regs.clip)
    assert(
        invoke_registered(mut ed, "ed.clip.paste", "", false) == edit.CMD_ERR_STATE,
        "no clipboard refuses",
    )
    assert_text(ed, "abcd", "unchanged")
    assert(ed.mode == edit.MODE_H, "still H")
    let w = ed.win
    assert(
        ed.wins[w].cs.curs[0].anchor == 1 && ed.wins[w].cs.curs[0].pos == 3,
        "the selection stands",
    )
    restore_clipboard_env(mut ed, saved, had)
    skip("sel_actions_clip_paste_failure_and_empty_are_atomic's empty-reader half")
}

// `test_sel_actions_aggregate_delete_is_one_edit_and_one_register`.
fn t_sel_actions_aggregate_delete_is_one_edit_and_one_register() {
    var ed = fixture_str("ab cd ef")
    set_selection(mut ed, edit.SEL_CHAR, 0, 2)
    add_selection(mut ed, 6, 8)
    assert(invoke_registered(mut ed, "ed.sel.delete", "", false) == edit.CMD_OK, "delete")
    assert_text(ed, " cd ", "both deleted")
    let r = reg(mut ed, '"' as int)
    assert(r.kind == text.REG_CHARWISE && r.bytes.len == 4, "one register value")
    reg_is(r, "abef", "the register")
    assert(ed.wins[ed.win].cs.curs.len == 2, "two cursors")
    assert(ed.mode == edit.MODE_L, "L")
    assert(
        text.undo_current(ed.bufs[buf(ed)].ec.undo) == ed.bufs[buf(ed)].ec.undo.root + 1,
        "one step",
    )
}

// `test_sel_actions_delete_line_includes_its_eol`.
fn t_sel_actions_delete_line_includes_its_eol() {
    var ed = fixture_str("aa\nbb\ncc\n")
    set_selection(mut ed, edit.SEL_LINE, 3, 4)
    assert(invoke_registered(mut ed, "ed.sel.delete", "", false) == edit.CMD_OK, "delete")
    assert_text(ed, "aa\ncc\n", "the line and its EOL")
    let r = reg(mut ed, '"' as int)
    assert(r.kind == text.REG_LINEWISE, "linewise")
    reg_is(r, "bb\n", "the register")
    assert(ed.wins[ed.win].cs.curs[0].pos == 3, "at 3")
    assert(ed.mode == edit.MODE_L, "L")
}

// `test_sel_actions_delete_rect_removes_raw_invalid_byte`.
fn t_sel_actions_delete_rect_removes_raw_invalid_byte() {
    var b = List[int]()
    for x in [97, 255, 122, 10, 98, 99, 122, 10] {
        (mut b).push(x)
    }
    var ed = fixture(raw(b))
    set_selection(mut ed, edit.SEL_RECT, 1, 6)
    assert(invoke_registered(mut ed, "ed.sel.delete", "", false) == edit.CMD_OK, "delete")
    assert_text(ed, "az\nbz\n", "a column out")
    let r = reg(mut ed, '"' as int)
    assert(r.kind == text.REG_BLOCKWISE && r.rows.len == 2, "two rows")
    assert(r.rows[0].hi - r.rows[0].lo == 1, "a one-byte row")
    assert(r.bytes[r.rows[0].lo] as int == 255, "the raw byte kept")
    assert(ed.mode == edit.MODE_L, "L")
}

// `test_sel_actions_unicode_case_maps_expand_and_preserve_raw_bytes`.
fn t_sel_actions_unicode_case_maps_expand_and_preserve_raw_bytes() {
    var b = List[int]()
    for x in [97, 195, 159, 33, 255, 122] {
        (mut b).push(x)
    }
    var ed = fixture(raw(b))
    set_selection(mut ed, edit.SEL_CHAR, 0, 5)
    assert(invoke_change(mut ed, H_CASE_UPPER, "", false) == edit.CMD_OK, "upper")
    var want = List[int]()
    for x in [65, 83, 83, 33, 255, 122] {
        (mut want).push(x)
    }
    assert_bytes(ed, raw(want), "ß uppers to SS, the raw byte stays")
    assert(ed.wins[ed.win].cs.curs[0].pos == 0, "at 0")
    ed = fixture_str("\u{130}X")
    set_selection(mut ed, edit.SEL_CHAR, 0, 2)
    assert(invoke_change(mut ed, H_CASE_LOWER, "", false) == edit.CMD_OK, "lower")
    assert_text(ed, "i\u{307}X", "İ lowers to i + U+0307")
    ed = fixture_str("aB")
    set_selection(mut ed, edit.SEL_CHAR, 0, 2)
    assert(invoke_change(mut ed, H_CASE_TOGGLE, "", false) == edit.CMD_OK, "toggle")
    assert_text(ed, "Ab", "toggled")
}

// `test_sel_actions_change_captures_then_enters_insert_at_start`.
fn t_sel_actions_change_captures_then_enters_insert_at_start() {
    var ed = fixture_str("alpha beta")
    set_selection(mut ed, edit.SEL_CHAR, 0, 5)
    assert(invoke_registered(mut ed, "ed.sel.change", "", false) == edit.CMD_OK, "change")
    assert_text(ed, " beta", "deleted")
    let r = reg(mut ed, '"' as int)
    assert(r.kind == text.REG_CHARWISE, "charwise")
    reg_is(r, "alpha", "the register")
    assert(ed.mode == edit.MODE_I, "I")
    assert(ed.wins[ed.win].cs.curs[0].pos == 0, "at 0")
}

// `test_sel_actions_change_line_opens_insert_at_line_start`.
fn t_sel_actions_change_line_opens_insert_at_line_start() {
    var ed = fixture_str("aa\nbb\ncc\n")
    set_selection(mut ed, edit.SEL_LINE, 3, 4)
    assert(invoke_registered(mut ed, "ed.sel.change", "", false) == edit.CMD_OK, "change")
    assert_text(ed, "aa\ncc\n", "the line out")
    let r = reg(mut ed, '"' as int)
    assert(r.kind == text.REG_LINEWISE, "linewise")
    reg_is(r, "bb\n", "the register")
    assert(
        ed.wins[ed.win].cs.curs.len == 1 && ed.wins[ed.win].cs.curs[0].pos == 3,
        "one caret at 3",
    )
    assert(ed.mode == edit.MODE_I, "I")
}

// `test_sel_actions_change_rect_creates_one_caret_per_row`.
fn t_sel_actions_change_rect_creates_one_caret_per_row() {
    var ed = fixture_str("abc\nabc\n")
    set_selection(mut ed, edit.SEL_RECT, 1, 6)
    assert(invoke_registered(mut ed, "ed.sel.change", "", false) == edit.CMD_OK, "change")
    assert_text(ed, "ac\nac\n", "a column out")
    let w = ed.win
    assert(ed.wins[w].cs.curs.len == 2, "two carets")
    assert(ed.wins[w].cs.curs[0].pos == 1 && ed.wins[w].cs.curs[0].anchor == 1, "c0 at 1")
    assert(ed.wins[w].cs.curs[1].pos == 4 && ed.wins[w].cs.curs[1].anchor == 4, "c1 at 4")
    assert(ed.mode == edit.MODE_I, "I")
}

fn case_case(start: str, kind: int, lo: int, hi: int, which: int, want: str, what: str) {
    var ed = fixture_str(start)
    set_selection(mut ed, kind, lo, hi)
    assert(invoke_change(mut ed, which, "", false) == edit.CMD_OK, what)
    assert_text(ed, want, what)
}

// `test_sel_actions_case_commands_cover_whole_line_selections`.
fn t_sel_actions_case_commands_cover_whole_line_selections() {
    case_case("a\u{DF}\nz\n", edit.SEL_LINE, 0, 1, H_CASE_UPPER, "ASS\nz\n", "upper")
    case_case("AB\nz\n", edit.SEL_LINE, 0, 1, H_CASE_LOWER, "ab\nz\n", "lower")
    case_case("aB\nz\n", edit.SEL_LINE, 0, 1, H_CASE_TOGGLE, "Ab\nz\n", "toggle")
}

// `test_sel_actions_case_commands_transform_each_rect_row`.
fn t_sel_actions_case_commands_transform_each_rect_row() {
    case_case("abq\nabq\n", edit.SEL_RECT, 0, 6, H_CASE_UPPER, "ABq\nABq\n", "upper")
    case_case("ABq\nABq\n", edit.SEL_RECT, 0, 6, H_CASE_LOWER, "abq\nabq\n", "lower")
    case_case("aBq\naBq\n", edit.SEL_RECT, 0, 6, H_CASE_TOGGLE, "Abq\nAbq\n", "toggle")
}

// `test_sel_actions_indent_dedent_mixed_whitespace_and_noop`.
fn t_sel_actions_indent_dedent_mixed_whitespace_and_noop() {
    var ed = fixture_str("one\n\ttwo\n  three\n")
    set_selection(mut ed, edit.SEL_CHAR, 0, 15)
    assert(invoke_change(mut ed, H_INDENT, "", false) == edit.CMD_OK, "indent")
    assert_text(ed, "    one\n\t\ttwo\n      three\n", "indented")
    assert(invoke_change(mut ed, H_DEDENT, "", false) == edit.CMD_OK, "dedent")
    // The collapsed selection covers one line; only its indent is removed.
    assert_text(ed, "one\n\t\ttwo\n      three\n", "dedented")
}

// `test_sel_actions_indent_and_dedent_cover_lines_for_line_and_rect`.
fn t_sel_actions_indent_and_dedent_cover_lines_for_line_and_rect() {
    case_case("a\nb\n", edit.SEL_LINE, 0, 2, H_INDENT, "    a\n    b\n", "line indent")
    case_case("    a\n    b\n", edit.SEL_LINE, 0, 6, H_DEDENT, "a\nb\n", "line dedent")
    case_case("a\nb\n", edit.SEL_RECT, 0, 2, H_INDENT, "    a\n    b\n", "rect indent")
    case_case("    a\n    b\n", edit.SEL_RECT, 0, 6, H_DEDENT, "a\nb\n", "rect dedent")
}

// `test_sel_actions_join_collapses_space_without_space_before_punctuation`.
fn t_sel_actions_join_collapses_space_without_space_before_punctuation() {
    var ed = fixture_str("one  \n  two\n , three\nnext")
    set_selection(mut ed, edit.SEL_CHAR, 1, 17)
    assert(invoke_change(mut ed, H_JOIN, "", false) == edit.CMD_OK, "join")
    assert_text(ed, "one two, three\nnext", "joined")
    assert(ed.wins[ed.win].cs.curs[0].pos == 0, "at 0")
}

// `test_sel_actions_join_uses_covered_lines_for_line_and_rect`.
fn t_sel_actions_join_uses_covered_lines_for_line_and_rect() {
    case_case("one\n  two\n", edit.SEL_LINE, 0, 6, H_JOIN, "one two\n", "line join")
    case_case("one\n  two\n", edit.SEL_RECT, 0, 6, H_JOIN, "one two\n", "rect join")
}

// `test_sel_actions_replace_char_counts_graphemes_for_char_and_rect`.
fn t_sel_actions_replace_char_counts_graphemes_for_char_and_rect() {
    var ed = fixture_str("a\u{301}\u{6F22}z\nabc\n")
    set_selection(mut ed, edit.SEL_CHAR, 0, 6)
    assert(invoke_change(mut ed, H_REPLACE_CHAR, "*", true) == edit.CMD_OK, "replace")
    assert_text(ed, "**z\nabc\n", "two clusters, two stars")
    ed = fixture_str("abc\nabc\n")
    set_selection(mut ed, edit.SEL_RECT, 1, 6)
    assert(invoke_change(mut ed, H_REPLACE_CHAR, "*", true) == edit.CMD_OK, "replace rect")
    assert_text(ed, "a*c\na*c\n", "one star a row")
}

// `test_sel_actions_replace_char_covers_complete_line_selection`.
fn t_sel_actions_replace_char_covers_complete_line_selection() {
    var ed = fixture_str("ab\nz\n")
    set_selection(mut ed, edit.SEL_LINE, 0, 1)
    assert(invoke_change(mut ed, H_REPLACE_CHAR, "*", true) == edit.CMD_OK, "replace")
    assert_text(ed, "***z\n", "the line and its newline")
    assert(ed.mode == edit.MODE_L, "L")
}

// `test_sel_actions_shift_char_line_and_rect_are_byte_exact`.
fn t_sel_actions_shift_char_line_and_rect_are_byte_exact() {
    case_case("abcd", edit.SEL_CHAR, 1, 3, H_SHIFT_LEFT, "bcad", "char left")
    case_case("aa\nbb\ncc\n", edit.SEL_LINE, 3, 4, H_SHIFT_RIGHT, "aa\ncc\nbb\n", "line right")
    case_case("abcd\nabcd\n", edit.SEL_RECT, 1, 7, H_SHIFT_RIGHT, "acbd\nacbd\n", "rect right")
}

// `test_sel_actions_shift_inverse_directions_are_byte_exact`.
fn t_sel_actions_shift_inverse_directions_are_byte_exact() {
    case_case("abcd", edit.SEL_CHAR, 1, 3, H_SHIFT_RIGHT, "adbc", "char right")
    case_case("aa\nbb\ncc\n", edit.SEL_LINE, 3, 4, H_SHIFT_LEFT, "bb\naa\ncc\n", "line left")
    case_case("abcd\nabcd\n", edit.SEL_RECT, 1, 7, H_SHIFT_LEFT, "bacd\nbacd\n", "rect left")
}

// `test_sel_actions_rect_insert_and_append_pad_and_lift_rows`.
fn t_sel_actions_rect_insert_and_append_pad_and_lift_rows() {
    var ed = fixture_str("abcd\n\nwxyz\n")
    set_selection(mut ed, edit.SEL_RECT, 1, 9)
    assert(invoke_change(mut ed, H_RECT_INSERT, "", false) == edit.CMD_OK, "insert")
    assert_text(ed, "abcd\n \nwxyz\n", "the short row padded")
    assert(ed.mode == edit.MODE_I, "I")
    let w = ed.win
    assert(ed.wins[w].cs.curs.len == 3, "three carets")
    assert(
        ed.wins[w].cs.curs[0].pos == 1 &&
            ed.wins[w].cs.curs[1].pos == 6 &&
            ed.wins[w].cs.curs[2].pos == 8,
        "at 1 6 8",
    )
    ed = fixture_str("abcd\n\nwxyz\n")
    set_selection(mut ed, edit.SEL_RECT, 1, 9)
    assert(invoke_change(mut ed, H_RECT_APPEND, "", false) == edit.CMD_OK, "append")
    assert_text(ed, "abcd\n   \nwxyz\n", "padded to the right edge")
    assert(ed.mode == edit.MODE_I, "I")
    assert(ed.wins[ed.win].cs.curs.len == 3, "three carets")
}

// `test_sel_actions_rect_insert_typing_is_one_multi_undo_transaction`.
fn t_sel_actions_rect_insert_typing_is_one_multi_undo_transaction() {
    var ed = fixture_str("abcd\n\nwxyz\n")
    set_selection(mut ed, edit.SEL_RECT, 1, 9)
    assert(
        invoke_registered(mut ed, "ed.edit.rect.insert", "", false) == edit.CMD_OK,
        "rect insert",
    )
    assert(ed.insert_txn, "the run is open")
    assert(ed.bufs[buf(ed)].ec.undo.pending_reason == text.TXN_MULTI, "a MULTI run")
    assert(ed.wins[ed.win].cs.curs.len == 3, "three carets")
    var key = term.key_new()
    key.kind = term.EV_KEY
    key.ev = term.KEY_PRESS
    key.code = 'X' as int
    (mut key.text).push(88 as byte)
    edit.ed_handle_key(mut ed, key, 10)
    assert_text(ed, "aXbcd\n X\nwXxyz\n", "typed at every caret")
    var esc = term.key_new()
    esc.kind = term.EV_KEY
    esc.ev = term.KEY_PRESS
    esc.code = term.KEY_ESCAPE
    edit.ed_handle_key(mut ed, esc, 11)
    assert(!ed.insert_txn, "closed")
    assert(ed.bufs[buf(ed)].ec.undo.nodes.len == 2, "one node")
    let w = ed.win
    let b = buf(ed)
    edit.edit_take(mut ed, w)
    assert(text.undo(mut ed.bufs[b].ec), "undo")
    edit.edit_give(mut ed, w)
    assert_text(ed, "abcd\n\nwxyz\n", "one undo")
    assert(ed.wins[w].cs.curs.len == 1, "one cursor back")
    assert(
        ed.wins[w].cs.curs[0].anchor == 1 && ed.wins[w].cs.curs[0].pos == 9,
        "the rectangle's cursor",
    )
}

// `test_sel_actions_rect_append_uses_effective_wide_and_tab_edges`.
fn t_sel_actions_rect_append_uses_effective_wide_and_tab_edges() {
    var ed = fixture_str("abq\nx\u{6F22}z\nabq\n")
    set_selection(mut ed, edit.SEL_RECT, 0, 12)
    assert(invoke_change(mut ed, H_RECT_APPEND, "", false) == edit.CMD_OK, "append")
    var w = ed.win
    assert(ed.wins[w].cs.curs.len == 3, "three carets")
    assert(
        ed.wins[w].cs.curs[0].pos == 2 &&
            ed.wins[w].cs.curs[1].pos == 8 &&
            ed.wins[w].cs.curs[2].pos == 12,
        "at 2 8 12",
    )
    ed = fixture_str("abq\nx\tz\nabq\n")
    set_selection(mut ed, edit.SEL_RECT, 0, 10)
    assert(invoke_change(mut ed, H_RECT_APPEND, "", false) == edit.CMD_OK, "append over a tab")
    w = ed.win
    assert(ed.wins[w].cs.curs.len == 3, "three carets")
    assert(
        ed.wins[w].cs.curs[0].pos == 2 &&
            ed.wins[w].cs.curs[1].pos == 6 &&
            ed.wins[w].cs.curs[2].pos == 10,
        "at 2 6 10",
    )
}

// `test_sel_actions_delete_hands_the_journal_to_the_buffer`.
fn t_sel_actions_delete_hands_the_journal_to_the_buffer() {
    let saved = env_get("XDG_STATE_HOME") else ""
    let cwd = os_cwd() else "."
    let root_dir = "{cwd}/target/tests/sel-journal"
    fs_remove_dir_all(root_dir) else |_| {}
    fs_create_dir_all(root_dir) else {}
    let source = "{root_dir}/source.txt"
    fs.write_bytes(source, bytes_of("alpha\nbeta\n")) else |_| {
        assert(false, "write the source")
    }
    env_set("XDG_STATE_HOME", root_dir) else |_| {}
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    let idx = edit.tab_open(mut ed, source)
    assert(idx >= 0 && edit.tab_hydrate(mut ed, idx) == 0, "the file opens")
    edit.tab_switch(mut ed, idx)
    assert(!ed.bufs[buf(ed)].ec.has_jrnl, "no journal before the first edit")
    assert(edit.mode_enter_highlight(mut ed, edit.MODE_L, false) == edit.CMD_OK, "H")
    let w = ed.win
    ed.wins[w].h.kind = edit.SEL_CHAR
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p] = sel(0, 5)
    text.cset_normalize(ed.bufs[buf(ed)].ec.tb, mut ed.wins[w].cs)
    assert(invoke_registered(mut ed, "ed.sel.delete", "", false) == edit.CMD_OK, "delete")
    assert(ed.bufs[buf(ed)].ec.has_jrnl, "the journal is the buffer's")
    assert(!ed.durability_failed, "durable")
    assert(edit.ed_file_save(mut ed, false) == edit.CMD_OK, "save")
    assert(!ed.bufs[buf(ed)].ec.has_jrnl, "the save retired it")
    if saved.len == 0 {
        env_unset("XDG_STATE_HOME") else |_| {}
    } else {
        env_set("XDG_STATE_HOME", saved) else |_| {}
    }
    fs_remove_dir_all(root_dir) else |_| {}
}

// `test_sel_actions_select_all_spans_the_buffer_in_char_highlight`.
fn t_sel_actions_select_all_spans_the_buffer_in_char_highlight() {
    let body = "aa\nbb\ncc\n"
    var ed = fixture_str(body)
    assert(edit.mode_enter(mut ed, edit.MODE_L) == edit.CMD_OK, "L")
    let w = ed.win
    assert(text.cset_add(mut ed.wins[w].cs, text.Cursor { pos: 4, goal_col: 0, anchor: 4 }), "add 4")
    assert(ed.wins[w].cs.curs.len == 2, "two")
    assert(invoke_registered(mut ed, "ed.sel.all", "", false) == edit.CMD_OK, "select all")
    assert(ed.mode == edit.MODE_H && ed.wins[w].h.kind == edit.SEL_CHAR, "H, by character")
    assert(ed.wins[w].cs.curs.len == 1, "one selection")
    assert(
        ed.wins[w].cs.curs[0].anchor == 0 && ed.wins[w].cs.curs[0].pos == body.len,
        "the whole buffer",
    )
    assert(invoke_registered(mut ed, "ed.sel.yank", "", false) == edit.CMD_OK, "yank")
    let r = reg(mut ed, '"' as int)
    assert(r.kind == text.REG_CHARWISE && r.bytes.len == body.len, "the whole buffer yanked")
    reg_is(r, body, "byte for byte")
}

// `test_sel_actions_select_all_on_an_empty_buffer_is_an_empty_span`.
fn t_sel_actions_select_all_on_an_empty_buffer_is_an_empty_span() {
    var ed = fixture_str("")
    assert(edit.mode_enter(mut ed, edit.MODE_L) == edit.CMD_OK, "L")
    assert(invoke_registered(mut ed, "ed.sel.all", "", false) == edit.CMD_OK, "select all")
    assert(ed.mode == edit.MODE_H, "H")
    let w = ed.win
    assert(ed.wins[w].cs.curs[0].anchor == 0 && ed.wins[w].cs.curs[0].pos == 0, "an empty span")
}

// `test_sel_actions_select_all_is_bound_to_g_a_in_line_mode`.
fn t_sel_actions_select_all_is_bound_to_g_a_in_line_mode() {
    var ed = fixture_str("alpha")
    assert(edit.mode_enter(mut ed, edit.MODE_L) == edit.CMD_OK, "L")
    var g = term.key_new()
    g.kind = term.EV_KEY
    g.ev = term.KEY_PRESS
    g.code = 'g' as int
    (mut g.text).push(103 as byte)
    var a = term.key_new()
    a.kind = term.EV_KEY
    a.ev = term.KEY_PRESS
    a.code = 'a' as int
    (mut a.text).push(97 as byte)
    edit.dispatch_key(mut ed, g, 0)
    edit.dispatch_key(mut ed, a, 1)
    assert(ed.last_status == edit.CMD_OK, "g a ok")
    assert(ed.mode == edit.MODE_H, "H")
    let w = ed.win
    assert(ed.wins[w].cs.curs[0].anchor == 0 && ed.wins[w].cs.curs[0].pos == 5, "the whole buffer")
}

