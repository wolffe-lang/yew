//! member: false
//!
//! The port of sagitta `tests/unit/test_fuzzy.c` (424 lines), one test
//! per C test in registry order (`tests/unit/registry.c:941-954`): the
//! fuss parity corpus (38 rows, transcribed from the Fortran by sagitta,
//! `test_fuzzy.c:1-13`), the table rows, the sentinel, the positions and
//! their caps, ASCII-only folding and the ranking order. C's NULL
//! pattern, NULL text and NULL candidate rows (`test_fuzzy.c:378-392`)
//! have no wolf shape — a `List[byte]` is never null — so only their
//! non-NULL halves are asserted.

use ws

fn b(s: str) -> List[byte] {
    var v = List[byte]()
    for x in s.bytes() {
        (mut v).push(x)
    }
    v
}

fn score(pat: str, text: str) -> int {
    ws.fz_score_str(pat, text)
}

fn check_case(pat: str, text: str, fuss: int) {
    let want = if fuss == 0 then ws.FZ_NO_MATCH else fuss
    let got = score(pat, text)
    assert(got == want, "fz_score({pat}, {text}) = {got}, want {want}")
}

fn rank(pat: str, texts: List[str], path_mode: bool) -> List[ws.FzRanked] {
    var ts = List[List[byte]]()
    for t in texts {
        (mut ts).push(b(t))
    }
    ws.fz_rank(pat.bytes(), 0, pat.len, ts, path_mode)
}

fn strs(xs: str) -> List[str] {
    var out = List[str]()
    for w in xs.split("|") {
        (mut out).push(w)
    }
    out
}

// `test_fuzzy_parity_corpus` (`test_fuzzy.c:47-99`).
fn t_fuzzy_parity_corpus() {
    var n = 0
    check_case("", "file.write", 1)
    check_case("file.write", "file.write", 10000)
    check_case("FILE.WRITE", "file.write", 10000)
    check_case("file", "file.write", 5000)
    check_case("fw", "file.write", 536)
    check_case("fwq", "file.write_quit", 776)
    check_case("fw", "file.write_quit", 531)
    check_case("w", "file.write", 240)
    check_case("wq", "file.write_quit", 480)
    check_case("q", "quit", 5000)
    check_case("qf", "quit_force", 536)
    check_case("pane", "pane.split_h", 5000)
    check_case("psh", "pane.split_h", 779)
    check_case("ph", "pane.split_h", 528)
    check_case("sr", "search.replace", 384)
    check_case("srep", "search.replace", 680)
    check_case("xyz", "file.write", 0)
    check_case("filewrite", "file.write", 2389)
    n += 18
    check_case("src", "src", 10000)
    check_case("src", "src/file.c", 5000)
    check_case("sf", "src/file.c", 537)
    check_case("sfc", "src/file.c", 783)
    check_case("uit", "src/ui/tabs.c", 686)
    check_case("tabs", "src/ui/tabs.c", 987)
    check_case("tabs.c", "src/ui/tabs.c", 1887)
    check_case("utc", "src/ui/tabs.c", 731)
    check_case("cmd", "src/ui/cmdline.c", 379)
    check_case("cmdline", "src/ui/cmdline.c", 1679)
    check_case("ui/cmd", "src/ui/cmdline.c", 1884)
    check_case("README", "README.md", 5000)
    check_case("readme", "README.md", 5000)
    check_case("mk", "Makefile", 391)
    check_case("make", "Makefile", 5000)
    n += 15
    check_case("abc", "axbxc_abc", 489)
    check_case("abc", "abc_axbxc", 5000)
    check_case("az", "a_very_long_name_ending_in_z", 496)
    check_case("ae", "abcde", 392)
    check_case("ac", "abc", 396)
    n += 5
    assert(n >= 30, "parity corpus: at least 30 rows")
}

// `test_fuzzy_table_rows` (`test_fuzzy.c:101-136`).
fn t_fuzzy_table_rows() {
    check_case("", "anything", 1)
    check_case("abc", "abc", 10000)
    check_case("AbC", "aBc", 10000)
    check_case("ab", "abc", 5000)
    check_case("AB", "abc", 5000)
    check_case("b", "ab", 98)
    check_case("b", "a_b", 247)
    check_case("ab", "xab", 297)
    check_case("abc", "xabc", 546)
    check_case("ac", "abc", 396)
    check_case("z", "abc", 0)
    check_case("abcd", "abc", 0)
    assert(score("ac", "abc") > score("bc", "abc"), "start-of-text bonus")
    assert(score("b", "a_b") > score("b", "axb"), "word-boundary bonus")
    assert(score("b", "ab") > score("b", "abcdef"), "length penalty")
}

// `test_fuzzy_no_match_sentinel_is_distinct_from_score_zero`
// (`test_fuzzy.c:145-163`).
fn t_fuzzy_no_match_sentinel_is_distinct_from_score_zero() {
    var text = List[byte]()
    var i = 0
    while i < 99 {
        (mut text).push(97 as byte)
        i += 1
    }
    (mut text).push(122 as byte)
    let matched = ws.fz_score(b("z"), 0, 1, text, 0, 100)
    let missing = ws.fz_score(b("q"), 0, 1, text, 0, 100)
    assert(matched == 0, "a real match scoring 0: {matched}")
    assert(missing == ws.FZ_NO_MATCH, "no match is the sentinel")
    assert(matched != missing, "the sentinel is distinct")
}

fn score_m(pat: str, text: str, mut m: ws.FzMatch) -> int {
    ws.fz_score_m(pat.bytes(), 0, pat.len, text.bytes(), 0, text.len, mut m)
}

// `test_fuzzy_positions_and_cap` (`test_fuzzy.c:165-208`).
fn t_fuzzy_positions_and_cap() {
    var m = ws.fzmatch_none()
    assert(score_m("sfc", "src/file.c", mut m) != ws.FZ_NO_MATCH, "sfc matches")
    assert(m.pos.len == 3, "sfc: three positions")
    assert(m.pos[0] == 0 && m.pos[1] == 4 && m.pos[2] == 9, "sfc: 0 4 9")
    assert(score_m("fi", "file.c", mut m) == 5000, "fi prefix")
    assert(m.pos.len == 2 && m.pos[0] == 0 && m.pos[1] == 1, "prefix positions filled")
    assert(score_m("abc", "abc", mut m) == 10000, "exact")
    assert(m.pos.len == 3, "exact positions filled")
    assert(score_m("zz", "abc", mut m) == ws.FZ_NO_MATCH, "no match")
    assert(m.pos.len == 0, "no stale positions")
    var pat = List[byte]()
    var text = List[byte]()
    (mut text).push(98 as byte)
    var i = 0
    while i < 70 {
        (mut pat).push(97 as byte)
        (mut text).push(97 as byte)
        i += 1
    }
    assert(ws.fz_score_m(pat, 0, 70, text, 0, 71, mut m) != ws.FZ_NO_MATCH, "70 a's match")
    assert(m.pos.len == ws.FZ_MAX_POS, "the 64-position cap: {m.pos.len}")
    i = 1
    while i < m.pos.len {
        assert(m.pos[i] > m.pos[i - 1], "positions ascend")
        i += 1
    }
}

// `test_fuzzy_ascii_fold_only` (`test_fuzzy.c:210-228`).
fn t_fuzzy_ascii_fold_only() {
    let cyr_upper = "\u{0424}"
    let cyr_lower = "\u{0444}"
    let cjk = "\u{65E5}\u{672C}"
    assert(score(cyr_lower, cyr_lower) == 10000, "non-ASCII matches itself")
    assert(score(cjk, cjk) == 10000, "CJK matches itself")
    assert(score(cyr_lower, cyr_upper) == ws.FZ_NO_MATCH, "no Unicode folding")
    assert(score("A", "a") == 10000, "ASCII folds")
}

// `test_fuzzy_rank_basename_tier` (`test_fuzzy.c:230-252`).
fn t_fuzzy_rank_basename_tier() {
    var out = rank("src", strs("src/file.c|src"), true)
    assert(out.len == 2, "two match")
    assert(out[0].idx == 1, "`src` selects the directory")
    assert(out[0].score >= ws.FZ_BASENAME_TIER, "tiered")
    assert(out[1].score < ws.FZ_BASENAME_TIER, "untiered")
    out = rank("tabs", strs("tabs/other/deep.c|src/ui/tabs.c"), true)
    assert(out.len == 2, "two match")
    assert(out[0].idx == 1, "basename tabs.c first")
    assert(out[0].score >= ws.FZ_BASENAME_TIER, "tiered")
}

// `test_fuzzy_rank_path_mode_off_scores_the_whole_label`
// (`test_fuzzy.c:254-279`).
fn t_fuzzy_rank_path_mode_off_scores_the_whole_label() {
    var out = rank("write", strs("file.write|write"), false)
    assert(out.len == 2, "two match")
    assert(out[0].idx == 1, "write exact first")
    assert(out[0].score >= ws.FZ_BASENAME_TIER, "tiered")
    assert(out[1].score < ws.FZ_BASENAME_TIER, "file.write untiered")
    out = rank("write", strs("file.write|write"), true)
    assert(out.len == 2, "two match, path mode")
    assert(out[0].idx == 1, "write first, path mode")
    assert(out[1].score < ws.FZ_BASENAME_TIER, "no '/' changes nothing")
}

// `test_fuzzy_rank_path_mode_changes_ranking_only_for_paths`
// (`test_fuzzy.c:281-293`).
fn t_fuzzy_rank_path_mode_changes_ranking_only_for_paths() {
    var out = rank("write", strs("src/write.c"), true)
    assert(out.len == 1 && out[0].score >= ws.FZ_BASENAME_TIER, "path mode tiers the basename")
    out = rank("write", strs("src/write.c"), false)
    assert(out.len == 1 && out[0].score < ws.FZ_BASENAME_TIER, "label mode scores it whole")
}

// `test_fuzzy_rank_excludes_and_breaks_ties_deterministically`
// (`test_fuzzy.c:295-323`).
fn t_fuzzy_rank_excludes_and_breaks_ties_deterministically() {
    let forward = strs("bbb|aaa|zzz_no|aab")
    let reverse = strs("aab|zzz_no|aaa|bbb")
    let a = rank("a", forward, false)
    assert(a.len == 2, "non-matching excluded: {a.len}")
    for r in a {
        assert(forward[r.idx] != "zzz_no", "zzz_no excluded")
    }
    let bb = rank("a", reverse, false)
    assert(bb.len == a.len, "same count permuted")
    var i = 0
    while i < a.len {
        assert(forward[a[i].idx] == reverse[bb[i].idx], "same order permuted")
        i += 1
    }
    assert(forward[a[0].idx] == "aaa", "aaa first")
    assert(forward[a[1].idx] == "aab", "aab second")
}

// `test_fuzzy_rank_positions_are_relative_to_the_full_text`
// (`test_fuzzy.c:325-338`).
fn t_fuzzy_rank_positions_are_relative_to_the_full_text() {
    let out = rank("tabs", strs("src/ui/tabs.c"), true)
    assert(out.len == 1, "one")
    assert(out[0].m.pos.len == 4, "four positions")
    assert(out[0].m.pos[0] == 7, "shifted past src/ui/")
    assert(out[0].m.pos[3] == 10, "last position")
}

// `test_fuzzy_rank_directory_basename_ignores_trailing_slash`
// (`test_fuzzy.c:340-357`).
fn t_fuzzy_rank_directory_basename_ignores_trailing_slash() {
    let entries = strs("archive_old.c|archive/")
    let out = rank("archive", entries, true)
    assert(out.len == 2, "both match")
    assert(entries[out[0].idx] == "archive/", "the directory first")
    assert(out[0].score >= ws.FZ_BASENAME_TIER, "tiered")
}

// `test_fuzzy_rank_empty_pattern_preserves_source_order`
// (`test_fuzzy.c:359-372`).
fn t_fuzzy_rank_empty_pattern_preserves_source_order() {
    let out = rank("", strs("zebra|apple|mango"), false)
    assert(out.len == 3, "all three")
    var i = 0
    while i < out.len {
        assert(out[i].idx == i, "source order at {i}")
        i += 1
    }
}

// `test_fuzzy_handles_degenerate_input` (`test_fuzzy.c:374-393`): the
// NULL rows have no wolf shape (module header).
fn t_fuzzy_handles_degenerate_input() {
    assert(score("", "") == 1, "empty against empty")
    assert(score("a", "") == ws.FZ_NO_MATCH, "pattern against empty")
    let none = List[List[byte]]()
    assert(ws.fz_rank(b("a"), 0, 1, none, false).len == 0, "no candidates")
    let out = rank("a", strs("|abc"), false)
    assert(out.len == 1 && out[0].idx == 1, "an empty candidate is skipped by not matching")
}

// `test_fuzzy_positions_past_64k_are_dropped_not_truncated`
// (`test_fuzzy.c:404-424`).
fn t_fuzzy_positions_past_64k_are_dropped_not_truncated() {
    let long_len = 70000
    var text = List[byte]()
    var i = 0
    while i < long_len {
        (mut text).push(120 as byte)
        i += 1
    }
    text[10] = 97 as byte
    text[long_len - 1] = 98 as byte
    var m = ws.fzmatch_none()
    var s = ws.fz_score_m(b("ab"), 0, 2, text, 0, long_len, mut m)
    assert(s != ws.FZ_NO_MATCH, "a far match is a match")
    assert(m.pos.len == 1 && m.pos[0] == 10, "the far byte is unrecorded")
    text[70] = 98 as byte
    s = ws.fz_score_m(b("ab"), 0, 2, text, 0, long_len, mut m)
    assert(s != ws.FZ_NO_MATCH, "near match")
    assert(m.pos.len == 2 && m.pos[1] == 70, "both recorded when near")
}

fn main() {
    t_fuzzy_parity_corpus()
    t_fuzzy_table_rows()
    t_fuzzy_no_match_sentinel_is_distinct_from_score_zero()
    t_fuzzy_positions_and_cap()
    t_fuzzy_ascii_fold_only()
    t_fuzzy_rank_basename_tier()
    t_fuzzy_rank_path_mode_off_scores_the_whole_label()
    t_fuzzy_rank_path_mode_changes_ranking_only_for_paths()
    t_fuzzy_rank_excludes_and_breaks_ties_deterministically()
    t_fuzzy_rank_positions_are_relative_to_the_full_text()
    t_fuzzy_rank_directory_basename_ignores_trailing_slash()
    t_fuzzy_rank_empty_pattern_preserves_source_order()
    t_fuzzy_handles_degenerate_input()
    t_fuzzy_positions_past_64k_are_dropped_not_truncated()
    print("fuzzy_test: 14 cases pass")
}
