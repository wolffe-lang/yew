//! member: false
//! Selection visibility contracts. Fixtures follow edit_draw_test.lu and
//! edit_lsp_diag_test.lu; these are intentional UI changes, not oracle edits.

use edit
use lsp
use term
use text

fn fixture_bytes(
    body: List[byte],
    pos: int,
    anchor: int,
    tier: int,
    mono: bool,
    themed: bool,
) -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_memory(mut ed, body, "selection.txt")
    ed.grid = term.grid_new(4, 12)
    ed.grid_ready = true
    ed.render.tier = tier
    ed.render.no_color = mono
    if themed {
        edit.ed_theme_set(mut ed, "quiver-dark")
    }
    let w = ed.win
    ed.wins[w].rect = edit.rect(0, 0, 12, 3)
    edit.vp_init(mut ed.wins[w])
    ed.wins[w].vp.rows = 3
    ed.wins[w].vp.cols = 12
    ed.wins[w].gutter_width = 0
    ed.wins[w].h.kind = edit.SEL_CHAR
    ed.wins[w].cs = text.cset_init(text.Cursor { pos: pos, goal_col: 0, anchor: anchor })
    ed.mode = edit.MODE_H
    ed
}

fn fixture(body: str, pos: int, anchor: int, tier: int, mono: bool, themed: bool) -> edit.Ed {
    fixture_bytes(body.bytes(), pos, anchor, tier, mono, themed)
}

fn draw(mut ed: edit.Ed) {
    let w = ed.win
    edit.draw_document_rows(mut ed, w, 0, 3)
}

fn reverse(c: term.Cell) -> bool {
    c.attrs & term.ATTR_REVERSE != 0
}

fn check(name: str, ok: bool) -> int {
    if ok {
        print("PASS {name}")
        return 0
    }
    print("FAIL {name}")
    1
}

fn missing_mono() -> bool {
    var ed = fixture("alpha\n", 5, 0, term.TIER_TRUECOLOR, true, false)
    draw(mut ed)
    reverse(term.grid_back(ed.grid, 0, 0))
}

fn sixteen() -> bool {
    var ed = fixture("alpha\n", 5, 0, term.TIER_16, false, true)
    draw(mut ed)
    var x = 0
    while x < 5 {
        if !reverse(term.grid_back(ed.grid, 0, x)) { return false }
        x += 1
    }
    !reverse(term.grid_back(ed.grid, 0, 5))
}

fn equal_style() -> bool {
    var ed = fixture("alpha\n", 5, 0, term.TIER_TRUECOLOR, false, true)
    var i = 0
    while i < ed.theme.ui.len {
        if ed.theme.ui[i].name == "sel" {
            ed.theme.ui[i].tab[edit.THEME_TRUECOLOR].bg = copy ed.grid.blank.bg
            ed.theme.ui[i].tab[edit.THEME_TRUECOLOR].fg = term.color_default()
            ed.theme.ui[i].tab[edit.THEME_TRUECOLOR].attrs = 0
        }
        i += 1
    }
    draw(mut ed)
    reverse(term.grid_back(ed.grid, 0, 0))
}

fn mono_invalid_byte() -> bool {
    var bytes = List[byte]()
    (mut bytes).push(255 as byte)
    (mut bytes).push(97 as byte)
    (mut bytes).push(10 as byte)
    var ed = fixture_bytes(bytes, 1, 0, term.TIER_TRUECOLOR, true, true)
    ed.mode = edit.MODE_L
    draw(mut ed)
    let before = term.grid_back(ed.grid, 0, 0)
    ed.mode = edit.MODE_H
    draw(mut ed)
    let after = term.grid_back(ed.grid, 0, 0)
    var x = 0
    while x < 4 {
        let c = term.grid_back(ed.grid, 0, x)
        if c.attrs & term.ATTR_UNDERLINE == 0 || c.attrs & term.ATTR_INVALID_BYTE == 0 {
            return false
        }
        x += 1
    }
    before.lo == after.lo &&
        before.hi == after.hi &&
        term.grid_back(ed.grid, 0, 4).attrs & term.ATTR_UNDERLINE == 0 &&
        text.textbuf_byte_at(ed.bufs[ed.wins[ed.win].buf].ec.tb, 0) == 255
}

fn mono_reversed_text() -> bool {
    var ed = fixture("alpha\n", 5, 0, term.TIER_TRUECOLOR, true, true)
    ed.theme.tab[edit.THEME_MONO * edit.ATTR_COUNT + edit.ATTR_TEXT].attrs = term.ATTR_REVERSE
    var i = 0
    while i < ed.theme.ui.len {
        if ed.theme.ui[i].name == "sel" {
            ed.theme.ui[i].tab[edit.THEME_MONO].attrs = 0
        }
        i += 1
    }
    ed.mode = edit.MODE_L
    draw(mut ed)
    let before = term.grid_back(ed.grid, 0, 0)
    ed.mode = edit.MODE_H
    draw(mut ed)
    let after = term.grid_back(ed.grid, 0, 0)
    reverse(before) &&
        after.attrs & term.ATTR_UNDERLINE != 0 &&
        before.lo == after.lo &&
        before.hi == after.hi
}

fn empty_boundary() -> bool {
    var ed = fixture("alpha\n", 6, 6, term.TIER_16, false, true)
    ed.mode = edit.MODE_I
    draw(mut ed)
    let before = term.grid_back(ed.grid, 1, 0)
    ed.mode = edit.MODE_H
    draw(mut ed)
    let after = term.grid_back(ed.grid, 1, 0)
    let w = ed.win
    let span = edit.sel_span(ed.bufs[ed.wins[w].buf].ec.tb, edit.SEL_CHAR, ed.wins[w].cs.curs[0])
    // A cleared grid cell stores no glyph bytes; the renderer emits a space.
    // The boundary must change style, not rewrite that encoding to byte 32.
    print(
        "boundary glyph={term.cell_byte(before, 0)}->{term.cell_byte(after, 0)} attrs={before.attrs}->{after.attrs} span={span.lo}..{span.hi}",
    )
    span.lo == 6 &&
        span.hi == 6 &&
        before.lo == after.lo &&
        before.hi == after.hi &&
        before.w == after.w &&
        before.flags == after.flags &&
        !term.cell_eq(before, after)
}

fn wide_pair() -> bool {
    var ed = fixture("a\u{6f22}b\n", 4, 1, term.TIER_16, false, true)
    draw(mut ed)
    let lead = term.grid_back(ed.grid, 0, 1)
    let tail = term.grid_back(ed.grid, 0, 2)
    lead.w == 2 &&
        tail.w == 0 &&
        reverse(lead) &&
        reverse(tail) &&
        lead.attrs == tail.attrs &&
        term.color_equal(lead.bg, tail.bg) &&
        !reverse(term.grid_back(ed.grid, 0, 0)) &&
        !reverse(term.grid_back(ed.grid, 0, 3))
}

fn overlap_order() -> bool {
    var ed = fixture("alpha\n", 5, 0, term.TIER_TRUECOLOR, false, true)
    let w = ed.win
    let b = ed.wins[w].buf
    (mut ed.wins[w].overlay.spans).push(text.span(0, 5))
    ed.wins[w].overlay.cur_index = 0
    var i = 0
    while i < ed.theme.ui.len {
        if ed.theme.ui[i].name == "diag.error" {
            ed.theme.ui[i].tab[edit.THEME_TRUECOLOR].bg = term.color_rgb(1, 2, 3)
        }
        i += 1
    }
    let json = "[{{\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":5}}}},\"severity\":1,\"message\":\"overlap\"}}]"
    var err = lsp.json_err_new()
    let j = lsp.json_parse(json.bytes(), 0, json.len, mut err) else {
        assert(false, "diagnostic fixture: {err.msg}")
        return false
    }
    edit.diag_replace(mut ed, b, 1, j, j.root, 1)
    let (has, style) = edit.theme_ui(ed.theme, "sel", edit.THEME_TRUECOLOR)
    if !has { return false }
    draw(mut ed)
    let c = term.grid_back(ed.grid, 0, 0)
    term.color_equal(c.bg, style.bg) &&
        term.cell_byte(c, 0) == 97 &&
        c.attrs & (term.ATTR_UNDERLINE | term.ATTR_UNDERCURL) != 0
}

fn shift_setup() -> bool {
    let on = term.input_enable_blob(false, false)
    let off = term.input_disable_blob()
    let mouse = on.find("\x1b[?1006h") else -1
    let shift = on.find("\x1b[>1s") else -1
    let stop = off.find("\x1b[>0s") else -1
    let disable = off.find("\x1b[?1002l") else -1
    mouse >= 0 &&
        shift > mouse &&
        stop >= 0 &&
        disable > stop &&
        !term.input_enable_blob(false, true).contains("\x1b[>1s") &&
        term.restore_blob(false).contains("\x1b[>0s") &&
        term.restore_blob(true).contains("\x1b[>0s")
}

fn main() -> int {
    var failures = 0
    failures += check("selection-16-floor", sixteen())
    failures += check("selection-mono-missing-role", missing_mono())
    failures += check("selection-equal-style-floor", equal_style())
    failures += check("selection-mono-invalid-byte", mono_invalid_byte())
    failures += check("selection-mono-reversed-text", mono_reversed_text())
    failures += check("selection-empty-boundary", empty_boundary())
    failures += check("selection-whole-wide-pair", wide_pair())
    failures += check("selection-after-search-and-diagnostic", overlap_order())
    failures += check("shift-capture-setup-restore", shift_setup())
    if failures == 0 then 0 else 1
}
