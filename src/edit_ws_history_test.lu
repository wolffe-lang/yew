//! member: false
//! Ports sagitta tests/unit/test_ws_history.c:142-490 at 9ace98c2.
//! Twelve registry.c:2237-2248 cases, checking files after every write.
//! hist_open_scoped was ported by yw04; the prompt's call site is yw06.

use edit
use util

struct Fix { root: str, work: str, saved: str, had: bool }

fn fixture() -> Fix {
    let saved = env_get("XDG_STATE_HOME") else ""
    let had = saved.len != 0
    assert(util.mkdirs("target/ws-history-fixtures", 448))
    var root = ""
    loop {
        var suffix = ""
        for r in os_random(8) { suffix = "{suffix}{r % 10}" }
        root = "target/ws-history-fixtures/{suffix}"
        fs_create_dir_mode(root, 448) else |e| match e {
            exists => { continue },
            _ => { assert(false, "mkdir fixture: {e}") },
        }
        break
    }
    root = fs_realpath(root) else {
        assert(false)
        return Fix { root: "", work: "", saved: "", had: false }
    }
    let work = "{root}/work"
    assert(util.mkdirs(work, 448))
    env_set("XDG_STATE_HOME", "{root}/state") else { assert(false) }
    Fix { root: root, work: work, saved: saved, had: had }
}

fn remove_tree(path: str) {
    let entries = fs_read_dir(path) else { return }
    for name in entries {
        let p = "{path}/{name}"
        fs_remove(p) else |_| {
            remove_tree(p)
            fs_remove_dir(p) else { assert(false, "remove dir {p}") }
        }
    }
}

fn finish(f: Fix) {
    if f.had {
        env_set("XDG_STATE_HOME", f.saved) else { assert(false) }
    } else {
        env_unset("XDG_STATE_HOME") else { assert(false) }
    }
    remove_tree(f.root)
    fs_remove_dir(f.root) else { assert(false) }
}

fn at(h: edit.CmdHist, i: int) -> str {
    let bytes = edit.hist_at(h, i) else { assert(false); return "" }
    str_from_utf8(bytes) else { assert(false); return "" }
}

fn has(h: edit.CmdHist, line: str) -> bool {
    for i in 0..edit.hist_len(h) { if at(h, i) == line { return true } }
    false
}

fn contents(path: str) -> str {
    let bytes = fs_read_bytes(path) else { return "" }
    str_from_utf8(bytes) else ""
}

fn lines(path: str) -> int {
    let bytes = fs_read_bytes(path) else { return -1 }
    var n = 0
    for b in bytes { if b as int == 10 { n += 1 } }
    n
}

fn append(wsdir: str, local: bool, line: str) {
    var h = edit.hist_open_scoped("cmd", wsdir, local)
    edit.hist_add_str(mut h, line)
    edit.hist_flush(mut h)
}

fn t_ws_history_workspace_scope_writes_locally() {
    let f = fixture()
    defer finish(f)
    let a = "{f.root}/wsA", b = "{f.root}/wsB"
    assert(util.mkdirs(a, 448) && util.mkdirs(b, 448))
    let global = "{f.root}/state/yew/history/cmd"
    let local = "{a}/history/cmd"
    var h = edit.hist_open_scoped("cmd", a, true)
    assert(!edit.hist_is_memory(h))
    assert((edit.hist_path_of(h) else "") == local)
    edit.hist_add_str(mut h, "w local-one")
    edit.hist_add_str(mut h, "w local-two")
    edit.hist_flush(mut h)
    assert(lines(local) == 2 && contents(local).contains("local-one"))
    assert(lines(global) == -1)
}

fn t_ws_history_global_scope_writes_globally() {
    let f = fixture()
    defer finish(f)
    let a = "{f.root}/wsA", b = "{f.root}/wsB"
    assert(util.mkdirs(a, 448) && util.mkdirs(b, 448))
    let global = "{f.root}/state/yew/history/cmd"
    let local = "{a}/history/cmd"
    var h = edit.hist_open_scoped("cmd", a, false)
    assert((edit.hist_path_of(h) else "") == global)
    edit.hist_add_str(mut h, "w global-one")
    edit.hist_flush(mut h)
    assert(lines(global) == 1 && contents(global).contains("global-one"))
    assert(lines(local) == -1)
}

fn t_ws_history_reads_merge_both_files() {
    let f = fixture()
    defer finish(f)
    let a = "{f.root}/wsA", b = "{f.root}/wsB"
    assert(util.mkdirs(a, 448) && util.mkdirs(b, 448))
    let global = "{f.root}/state/yew/history/cmd"
    append(a, false, "w from-global")
    var h = edit.hist_open_scoped("cmd", a, true)
    edit.hist_add_str(mut h, "w from-workspace")
    assert(has(h, "w from-global") && has(h, "w from-workspace"))
    edit.hist_flush(mut h)
    h = edit.hist_open_scoped("cmd", a, true)
    assert(edit.hist_len(h) == 2 && has(h, "w from-global") && has(h, "w from-workspace"))
}

fn t_ws_history_local_entries_are_newest() {
    let f = fixture()
    defer finish(f)
    let a = "{f.root}/wsA", b = "{f.root}/wsB"
    assert(util.mkdirs(a, 448) && util.mkdirs(b, 448))
    append(a, false, "w g1")
    append(a, false, "w g2")
    append(a, true, "w L1")
    let h = edit.hist_open_scoped("cmd", a, true)
    assert(edit.hist_len(h) == 3 && at(h, 0) == "w g1" && at(h, 1) == "w g2" && at(h, 2) == "w L1")
}

fn t_ws_history_duplicate_is_deduped_to_the_local_position() {
    let f = fixture()
    defer finish(f)
    let a = "{f.root}/wsA", b = "{f.root}/wsB"
    assert(util.mkdirs(a, 448) && util.mkdirs(b, 448))
    let global = "{f.root}/state/yew/history/cmd"
    append(a, false, "w shared")
    append(a, false, "w only-global")
    append(a, true, "w shared")
    let h = edit.hist_open_scoped("cmd", a, true)
    assert(edit.hist_len(h) == 2 && at(h, 0) == "w only-global" && at(h, 1) == "w shared")
}

fn t_ws_history_merge_never_migrates_into_the_workspace_file() {
    let f = fixture()
    defer finish(f)
    let a = "{f.root}/wsA", b = "{f.root}/wsB"
    assert(util.mkdirs(a, 448) && util.mkdirs(b, 448))
    let global = "{f.root}/state/yew/history/cmd"
    let local = "{a}/history/cmd"
    append(a, false, "w g1")
    append(a, false, "w g2")
    var h = edit.hist_open_scoped("cmd", a, true)
    assert(edit.hist_len(h) == 2)
    edit.hist_add_str(mut h, "w L1")
    assert(edit.hist_len(h) == 3)
    edit.hist_flush(mut h)
    assert(lines(local) == 1 && contents(local).contains("L1"))
    assert(!contents(local).contains("g1") && !contents(local).contains("g2"))
    assert(lines(global) == 2 && !contents(global).contains("L1"))
}

fn t_ws_history_flush_compacts_only_the_scope_file() {
    let f = fixture()
    defer finish(f)
    let a = "{f.root}/wsA", b = "{f.root}/wsB"
    assert(util.mkdirs(a, 448) && util.mkdirs(b, 448))
    let global = "{f.root}/state/yew/history/cmd"
    let local = "{a}/history/cmd"
    append(a, false, "w g1")
    var h = edit.hist_open_scoped("cmd", a, true)
    edit.hist_add_str(mut h, "w L1")
    edit.hist_add_str(mut h, "w L2")
    edit.hist_flush(mut h)
    edit.hist_flush(mut h)
    assert(lines(local) == 2 && !contents(local).contains("g1"))
    assert(lines(global) == 1)
}

fn t_ws_history_workspaces_are_isolated_from_each_other() {
    let f = fixture()
    defer finish(f)
    let a = "{f.root}/wsA", b = "{f.root}/wsB"
    assert(util.mkdirs(a, 448) && util.mkdirs(b, 448))
    append(a, true, "w in-A")
    var h = edit.hist_open_scoped("cmd", b, true)
    assert(!has(h, "w in-A"))
    edit.hist_add_str(mut h, "w in-B")
    edit.hist_flush(mut h)
    h = edit.hist_open_scoped("cmd", a, true)
    assert(has(h, "w in-A") && !has(h, "w in-B"))
}

fn t_ws_history_global_scope_crosses_workspaces() {
    let f = fixture()
    defer finish(f)
    let a = "{f.root}/wsA", b = "{f.root}/wsB"
    assert(util.mkdirs(a, 448) && util.mkdirs(b, 448))
    append(a, false, "w everywhere")
    let h = edit.hist_open_scoped("cmd", b, false)
    assert(has(h, "w everywhere"))
}

fn t_ws_history_null_workspace_is_the_global_history() {
    let f = fixture()
    defer finish(f)
    let a = "{f.root}/wsA", b = "{f.root}/wsB"
    assert(util.mkdirs(a, 448) && util.mkdirs(b, 448))
    let global = "{f.root}/state/yew/history/cmd"
    var h = edit.hist_open_scoped("cmd", "", true)
    assert((edit.hist_path_of(h) else "") == global)
    edit.hist_add_str(mut h, "w somewhere")
    edit.hist_flush(mut h)
    assert(lines(global) == 1)
}

fn t_ws_history_kinds_do_not_share_a_file() {
    let f = fixture()
    defer finish(f)
    let a = "{f.root}/wsA", b = "{f.root}/wsB"
    assert(util.mkdirs(a, 448) && util.mkdirs(b, 448))
    let local = "{a}/history/cmd"
    append(a, true, "w a-command")
    var h = edit.hist_open_scoped("search", a, true)
    assert(!has(h, "w a-command"))
    edit.hist_add_str(mut h, "w a-pattern")
    edit.hist_flush(mut h)
    assert(lines("{a}/history/search") == 1 && contents("{a}/history/search").contains("a-pattern"))
    assert(!contents(local).contains("a-pattern"))
}

fn t_ws_history_memory_history_writes_nothing() {
    let f = fixture()
    defer finish(f)
    let a = "{f.root}/wsA", b = "{f.root}/wsB"
    assert(util.mkdirs(a, 448) && util.mkdirs(b, 448))
    let local = "{a}/history/cmd"
    var h = edit.hist_open_memory()
    assert(edit.hist_is_memory(h) && (edit.hist_path_of(h) else "") == "")
    edit.hist_add_str(mut h, "w remembered")
    assert(has(h, "w remembered"))
    edit.hist_flush(mut h)
    assert(lines(local) == -1)
}

fn main() {
    t_ws_history_workspace_scope_writes_locally()
    print("ws_history_workspace_scope_writes_locally: PASS")
    t_ws_history_global_scope_writes_globally()
    print("ws_history_global_scope_writes_globally: PASS")
    t_ws_history_reads_merge_both_files()
    print("ws_history_reads_merge_both_files: PASS")
    t_ws_history_local_entries_are_newest()
    print("ws_history_local_entries_are_newest: PASS")
    t_ws_history_duplicate_is_deduped_to_the_local_position()
    print("ws_history_duplicate_is_deduped_to_the_local_position: PASS")
    t_ws_history_merge_never_migrates_into_the_workspace_file()
    print("ws_history_merge_never_migrates_into_the_workspace_file: PASS")
    t_ws_history_flush_compacts_only_the_scope_file()
    print("ws_history_flush_compacts_only_the_scope_file: PASS")
    t_ws_history_workspaces_are_isolated_from_each_other()
    print("ws_history_workspaces_are_isolated_from_each_other: PASS")
    t_ws_history_global_scope_crosses_workspaces()
    print("ws_history_global_scope_crosses_workspaces: PASS")
    t_ws_history_null_workspace_is_the_global_history()
    print("ws_history_null_workspace_is_the_global_history: PASS")
    t_ws_history_kinds_do_not_share_a_file()
    print("ws_history_kinds_do_not_share_a_file: PASS")
    t_ws_history_memory_history_writes_nothing()
    print("ws_history_memory_history_writes_nothing: PASS")
}
