//! member: false
//! Ports sagitta tests/unit/test_syn_embed.c at 9ace98c2, one case per C
//! test in its order: embed descriptors compile to an opener and a bridge,
//! and malformed embeds are refused with the reference's exact messages.
//! test_syn_embed_warm_cache_preserves_rule_and_bridge_descriptors is not
//! ported: stage one has no on-disk definition cache.

use fl
use syn

fn compile(source: str) -> syn.SynCompileResult {
    syn.syn_compile("embed.fl", source.bytes())
}

fn same(bytes: List[byte], s: str) -> bool {
    if bytes.len != s.len then return false
    var i = 0
    for b in s.bytes() {
        if bytes[i] != b then return false
        i += 1
    }
    true
}

fn aux(c: syn.SynCompileResult, id: int) -> List[byte] {
    if id <= 0 || id >= c.definition.strings.items.len then return List[byte]()
    copy c.definition.strings.items[id]
}

fn has_error(c: syn.SynCompileResult, want: str) -> bool {
    for d in c.diagnostics.entries {
        if d.level == fl.FL_DIAG_ERROR && d.msg == want then return true
    }
    false
}

// expect_embed_error: no definition, at least one error, this one exactly.
fn expect_embed_error(source: str, message: str) {
    let c = compile(source)
    assert(!c.valid, "the malformed embed compiles to no definition")
    assert(c.diagnostics.nerrors > 0, "at least one error")
    assert(has_error(c, message), "the reference's message: {message}")
}

fn attr(name: str) -> int {
    syn.syn_attr_id(name) else -1
}

// test_syn_embed_all_keys_compile_to_opener_and_bridge
fn all_keys_compile_to_opener_and_bridge() {
    let c = compile(
        "{{syntax:1,language:{{name:\"embed-ok\"}},contexts:{{\nmain:{{rules:[\n {{match:\"(js)\",push:\"bridge\",embed:{{lang:\"@1\",ctx:\"tag\",end:\"inline\",defer:true,fallback:\"code\"}}}},\n {{match:\"script\",push:\"bridge\",embed:{{lang:\"javascript\",ctx:\"tag\",end:\"inline\",fallback:\"code\"}}}},\n {{match:\"self\",push:\"selfbridge\",embed:{{lang:\"@self\",end:\"line\"}}}}]}},\nbridge:{{default:\"comment\",rules:[{{match:\"close\",pop:1,end:true}}]}},\nselfbridge:{{default:\"string\",at_eol:\"pop\",rules:[]}}\n}}}}",
    )
    assert(c.valid, "every embed key compiles")
    assert(c.diagnostics.nerrors == 0, "no errors")
    let dynamic = copy c.definition.rules[0].embed
    assert(c.definition.rules[0].op == syn.SYN_OP_EMBED, "a dynamic opener is an embed op")
    assert(c.definition.rules[0].target == 1, "it targets the bridge")
    assert(dynamic.lang_kind == syn.SYN_EMBED_LANG_CAPTURE, "@1 selects by capture")
    assert(dynamic.lang_group == 1, "capture group one")
    assert(dynamic.end_kind == syn.SYN_EMBED_END_INLINE, "inline end")
    assert(dynamic.flags & syn.SYN_EMBED_DEFER != 0, "deferred")
    assert(dynamic.fallback == attr("code"), "code fallback")
    assert(same(aux(c, dynamic.ctx), "tag"), "guest context name")
    let literal = copy c.definition.rules[1].embed
    assert(c.definition.rules[1].op == syn.SYN_OP_EMBED, "a literal opener is an embed op")
    assert(literal.lang_kind == syn.SYN_EMBED_LANG_LITERAL, "a literal language")
    assert(same(aux(c, literal.lang), "javascript"), "the literal's name")
    assert(literal.flags == 0, "not deferred")
    let self_embed = copy c.definition.rules[2].embed
    assert(self_embed.lang_kind == syn.SYN_EMBED_LANG_SELF, "@self")
    assert(self_embed.end_kind == syn.SYN_EMBED_END_LINE, "line end")
    assert(self_embed.fallback == attr("string"), "the bridge default is the fallback")
    assert(self_embed.ctx == 0, "no guest context")
    let bridge = copy c.definition.contexts[1]
    assert(bridge.flags & syn.SYN_CTX_EMBED_BRIDGE != 0, "the target is a bridge")
    assert(bridge.embed.lang_kind == syn.SYN_EMBED_LANG_NONE, "a bridge selects no language itself")
    assert(same(aux(c, bridge.embed.ctx), "tag"), "the bridge keeps the guest context")
    assert(bridge.embed.end_kind == syn.SYN_EMBED_END_INLINE, "the bridge keeps the end")
    assert(bridge.embed.fallback == attr("code"), "the bridge keeps the fallback")
    assert(c.definition.rules[3].end_boundary, "the closer is an end rule")
    assert(
        c.definition.contexts[2].flags & syn.SYN_CTX_EMBED_BRIDGE != 0,
        "the @self target is a bridge",
    )
}

// test_syn_embed_requires_lang_end_and_string_push
fn requires_lang_end_and_string_push() {
    expect_embed_error(
        "{{syntax:1,language:{{name:\"x\"}},contexts:{{main:{{rules:[{{match:\"x\",embed:{{lang:\"js\",end:\"line\"}}}}]}}}}}}",
        "embed requires exactly one string 'push' bridge target",
    )
    expect_embed_error(
        "{{syntax:1,language:{{name:\"x\"}},contexts:{{main:{{rules:[{{match:\"x\",push:[\"b\"],embed:{{lang:\"js\",end:\"line\"}}}}]}},b:{{at_eol:\"pop\",rules:[]}}}}}}",
        "embed bridge 'push' must be one context name, not a list",
    )
    expect_embed_error(
        "{{syntax:1,language:{{name:\"x\"}},contexts:{{main:{{rules:[{{match:\"x\",push:\"b\",embed:{{end:\"line\"}}}}]}},b:{{at_eol:\"pop\",rules:[]}}}}}}",
        "embed.lang must be a string",
    )
    expect_embed_error(
        "{{syntax:1,language:{{name:\"x\"}},contexts:{{main:{{rules:[{{match:\"x\",push:\"b\",embed:{{lang:\"js\"}}}}]}},b:{{at_eol:\"pop\",rules:[]}}}}}}",
        "embed.end must be a string",
    )
}

// test_syn_embed_rejects_incompatible_state_operations
fn rejects_incompatible_state_operations() {
    expect_embed_error(
        "{{syntax:1,language:{{name:\"x\"}},contexts:{{main:{{rules:[{{match:\"x\",push:\"b\",pop:1,embed:{{lang:\"js\",end:\"line\"}}}}]}},b:{{at_eol:\"pop\",rules:[]}}}}}}",
        "embed is a state op; a rule performs exactly one",
    )
}

// test_syn_embed_validates_capture_end_and_field_types
fn validates_capture_end_and_field_types() {
    expect_embed_error(
        "{{syntax:1,language:{{name:\"x\"}},contexts:{{main:{{rules:[{{match:\"(x)\",push:\"b\",embed:{{lang:\"@2\",end:\"line\"}}}}]}},b:{{at_eol:\"pop\",rules:[]}}}}}}",
        "embed.lang: @2 but the pattern has 1 capture groups",
    )
    expect_embed_error(
        "{{syntax:1,language:{{name:\"x\"}},contexts:{{main:{{rules:[{{match:\"x\",push:\"b\",embed:{{lang:\"js\",end:true}}}}]}},b:{{at_eol:\"pop\",rules:[]}}}}}}",
        "embed.end must be a string",
    )
    expect_embed_error(
        "{{syntax:1,language:{{name:\"x\"}},contexts:{{main:{{rules:[{{match:\"x\",push:\"b\",embed:{{lang:\"js\",end:\"line\",defer:\"yes\"}}}}]}},b:{{at_eol:\"pop\",rules:[]}}}}}}",
        "embed.defer must be a boolean",
    )
    expect_embed_error(
        "{{syntax:1,language:{{name:\"x\"}},contexts:{{main:{{rules:[{{match:\"x\",push:\"b\",embed:{{lang:\"js\",ctx:false,end:\"line\"}}}}]}},b:{{at_eol:\"pop\",rules:[]}}}}}}",
        "embed.ctx must be a string",
    )
    expect_embed_error(
        "{{syntax:1,language:{{name:\"x\"}},contexts:{{main:{{rules:[{{match:\"x\",push:\"b\",embed:{{lang:\"js\",end:\"line\",fallback:\"wat\"}}}}]}},b:{{at_eol:\"pop\",rules:[]}}}}}}",
        "unknown attr 'wat' (did you mean 'tag'?)",
    )
    expect_embed_error(
        "{{syntax:1,language:{{name:\"x\"}},contexts:{{main:{{rules:[{{match:\"x\",push:\"b\",embed:{{lang:\"js\",end:\"line\",interleave:true}}}}]}},b:{{at_eol:\"pop\",rules:[]}}}}}}",
        "embed.interleave is deferred until after 1.0",
    )
}

// test_syn_embed_end_is_scoped_to_bridge_context
fn end_is_scoped_to_bridge_context() {
    expect_embed_error(
        "{{syntax:1,language:{{name:\"x\"}},contexts:{{main:{{rules:[{{match:\"x\",pop:1,end:true}}]}}}}}}",
        "'end' marks a rule that returns from an embedded language",
    )
    expect_embed_error(
        "{{syntax:1,language:{{name:\"x\"}},contexts:{{main:{{rules:[{{match:\"x\",push:\"b\",embed:{{lang:\"js\",end:\"inline\"}}}}]}},b:{{rules:[{{match:\"y\"}}]}}}}}}",
        "context 'b' embeds a language it can never leave",
    )
}

// test_syn_embed_bridge_policy_must_be_compatible
fn bridge_policy_must_be_compatible() {
    expect_embed_error(
        "{{syntax:1,language:{{name:\"x\"}},contexts:{{main:{{rules:[{{match:\"a\",push:\"b\",embed:{{lang:\"js\",end:\"line\"}}}},{{match:\"z\",push:\"b\",embed:{{lang:\"css\",end:\"inline\"}}}}]}},b:{{at_eol:\"pop\",rules:[]}}}}}}",
        "context 'b' has incompatible embed bridge descriptors",
    )
}

// test_syn_embed_context_source_key_remains_invalid
fn context_source_key_remains_invalid() {
    expect_embed_error(
        "{{syntax:1,language:{{name:\"x\"}},contexts:{{main:{{embed:{{lang:\"js\",end:\"line\"}},rules:[]}}}}}}",
        "'embed' is only valid on a rule",
    )
}

fn main() {
    let selected = (env_get("YEW_SYN_EMBED_CASE") else "-1").to_int() else -1
    for i in 0..7 {
        if selected == -1 || selected == i {
            match i {
                0 => all_keys_compile_to_opener_and_bridge(),
                1 => requires_lang_end_and_string_push(),
                2 => rejects_incompatible_state_operations(),
                3 => validates_capture_end_and_field_types(),
                4 => end_is_scoped_to_bridge_context(),
                5 => bridge_policy_must_be_compatible(),
                _ => context_source_key_remains_invalid(),
            }
            print("syn_embed_case_{i}: PASS")
        }
    }
}
