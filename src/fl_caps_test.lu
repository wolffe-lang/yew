//! member: false
//! Sprint 31 deliverable 7, spec §13's capability model: sagitta 9ace98c2
//! tests/unit/test_fl_caps.c:1-205 (5 cases, registry order,
//! tests/unit/registry.c:2088-2092), over flfix. C reads the cached
//! module's `exports` pointer; the port's exports map is vm.modules'
//! value under the module's row index (fl.module), and two instances are
//! distinct objects when their current references differ.

use fl
use flfix

fn exports_of(f: flfix.FlFix, idx: int) -> fl.FlValue {
    let modules = copy f.vm.modules
    fl.fl_map_get(f.vm, modules, fl.fl_int(idx)) else {
        assert(false, "caps test: no exports for module {idx}")
        fl.fl_nil()
    }
}

fn fl_caps_a_plugin_gains_nothing_from_a_helper() {
    var f = flfix.open()
    let dir = flfix.tmpdir(mut f)
    flfix.write(mut f, "a.txt", "hi\n")
    flfix.write(mut f, "helper.fl", "import io\nfn peek(p) {{ return io.read(p) }}\n")
    let src = "import \"helper.fl\" as h\nreturn h.peek(\"{dir}/a.txt\")\n"
    let before = f.vm.mods.len
    flfix.set_origin(mut f, fl.FL_ORIGIN_CONFIG, fl.FL_CAP_FS_READ)
    flfix.eq(mut f, src, "hi\n")
    let config_row = f.vm.mods.len - 1
    flfix.set_origin(mut f, fl.FL_ORIGIN_PLUGIN, 0)
    flfix.eq(mut f, src, "!capability: fs.read denied to {dir}/helper.fl")
    // Both read after the second run: the collector moves objects, so a
    // reference held across a run is not compared.
    let as_config = exports_of(f, config_row)
    let as_plugin = exports_of(f, f.vm.mods.len - 1)
    // Twice, because the key is (realpath, origin.kind), and the two
    // instances are DISTINCT objects.
    assert(f.vm.mods.len - before == 2)
    assert(as_config.t == fl.FL_MAP && as_plugin.t == fl.FL_MAP && as_config.i != as_plugin.i)
    flfix.close(mut f)
}

fn fl_caps_builtin_frames_are_transparent() {
    var f = flfix.open()
    let dir = flfix.tmpdir(mut f)
    flfix.write(mut f, "a.txt", "hi\n")
    let src = "import io\nimport list\nreturn list.map([\"{dir}/a.txt\"], fn(p) {{ return io.read(p) }})[0]\n"
    flfix.set_origin(mut f, fl.FL_ORIGIN_CONFIG, fl.FL_CAP_FS_READ)
    flfix.eq(mut f, src, "hi\n")
    flfix.set_origin(mut f, fl.FL_ORIGIN_PLUGIN, 0)
    // The callback's own origin, this file, and not `list`'s.
    flfix.eq(mut f, src, "!capability: fs.read denied to {dir}/init.fl")
    flfix.close(mut f)
}

fn cap_check(mut f: flfix.FlFix, need: int) -> bool {
    let ok = fl.fl_cap_check(mut f.vm, need)
    f.vm.raised = false
    ok
}

fn fl_caps_each_bit_is_granted_and_denied() {
    var f = flfix.open()
    let dir = flfix.tmpdir(mut f)
    flfix.write(mut f, "a.txt", "hi\n")
    var src = "import io\nreturn io.read(\"{dir}/a.txt\")\n"
    flfix.set_origin(mut f, fl.FL_ORIGIN_CONFIG, fl.FL_CAP_FS_READ)
    flfix.eq(mut f, src, "hi\n")
    flfix.set_origin(mut f, fl.FL_ORIGIN_CONFIG, 0)
    flfix.eq(mut f, src, "!capability: fs.read denied to {dir}/init.fl")
    src = "import io\nio.write(\"{dir}/w.txt\", \"x\")\nreturn 1\n"
    flfix.set_origin(mut f, fl.FL_ORIGIN_CONFIG, fl.FL_CAP_FS_WRITE)
    flfix.eq(mut f, src, "1")
    flfix.set_origin(mut f, fl.FL_ORIGIN_CONFIG, fl.FL_CAP_FS_READ)
    flfix.eq(mut f, src, "!capability: fs.write denied to {dir}/init.fl")
    // shell and net have no 1.0 surface: with no Fletch frame on the
    // stack, fl_cap_origin falls back to root_origin (§13.1).
    f.vm.root_origin.kind = fl.FL_ORIGIN_PLUGIN
    f.vm.root_origin.path_id = 0
    f.vm.root_origin.caps = fl.FL_CAP_SHELL
    assert(cap_check(mut f, fl.FL_CAP_SHELL))
    assert(!cap_check(mut f, fl.FL_CAP_NET))
    f.vm.root_origin.caps = fl.FL_CAP_NET
    assert(cap_check(mut f, fl.FL_CAP_NET))
    assert(!cap_check(mut f, fl.FL_CAP_SHELL))
    // Both at once, because a check for two bits must want both.
    f.vm.root_origin.caps = fl.FL_CAP_SHELL | fl.FL_CAP_NET
    assert(cap_check(mut f, fl.FL_CAP_SHELL | fl.FL_CAP_NET))
    f.vm.root_origin.caps = fl.FL_CAP_SHELL
    assert(!cap_check(mut f, fl.FL_CAP_SHELL | fl.FL_CAP_NET))
    flfix.close(mut f)
}

fn fl_caps_a_denial_is_catchable() {
    var f = flfix.open()
    let dir = flfix.tmpdir(mut f)
    let src = "import io\ntry {{ io.read(\"{dir}/nope\") }}\ncatch e {{ return e.kind }}\nreturn \"ran\"\n"
    flfix.set_origin(mut f, fl.FL_ORIGIN_PLUGIN, 0)
    flfix.eq(mut f, src, "capability")
    flfix.close(mut f)
}

fn fl_caps_a_denial_names_the_origin() {
    var f = flfix.open()
    let dir = flfix.tmpdir(mut f)
    let src = "import io\nreturn io.read(\"{dir}/a\")\n"
    // The PATH when there is one.
    flfix.set_origin(mut f, fl.FL_ORIGIN_PLUGIN, 0)
    flfix.eq(mut f, src, "!capability: fs.read denied to {dir}/init.fl")
    flfix.close(mut f)
    // And the kind of origin when there is not.
    var g = flfix.open()
    flfix.set_origin(mut g, fl.FL_ORIGIN_WORKSPACE, 0)
    flfix.eq(
        mut g,
        "import io\nreturn io.read(\"/nope\")\n",
        "!capability: fs.read denied to the workspace config",
    )
    flfix.close(mut g)
}

fn main() {
    fl_caps_a_plugin_gains_nothing_from_a_helper()
    fl_caps_builtin_frames_are_transparent()
    fl_caps_each_bit_is_granted_and_denied()
    fl_caps_a_denial_is_catchable()
    fl_caps_a_denial_names_the_origin()
    print("PASS fl_caps 5")
}
