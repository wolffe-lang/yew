//! member: false
//! Ports sagitta tests/unit/test_syn_wolf.c at 9ace98c2, one case per C
//! test in its order. The definition is tests/fixtures/syn/wolf.fl and the
//! keyword contract tests/fixtures/syn/wolf/lexical-contract.txt, the pin's
//! runtime/syntax/wolf.fl and tests/syn/wolf/lexical-contract.txt byte for
//! byte; wolf is not a stage-one mode, so every case compiles the file.

use syn

// Canonical bytes from wolf-lang ab23a23f2b190d6f9b45271149b5ac7032b8133e,
// SHA-256 ca543483de3e53fa455e51c24dcfb59fca5141435a59f680d2710ba051326359.
const WOLF_KEYWORDS: str = "as\nasm\nassume\nborrow\nbreak\ncomptime\nconst\ncontinue\ncopy\ndefer\ndistinct\ndyn\nelse\nenum\nerrdefer\nexport\nextern\nfalse\nfn\nfor\nfreeze\nhandle\nif\nimpl\nimport\nin\nlet\nloop\nmatch\nmove\nmut\nproc\npub\nregion\nreturn\nscope\nselect\nshared\nspawn\nstruct\ntake\ntrait\ntrue\ntype\nunsafe\nuse\nvar\nweak\nwhen\nwhile\n"

struct Wolf { pool: syn.SynPool, engine: syn.SynEngine }

fn bytes(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() { (mut out).push(b) }
    out
}

fn wolf() -> Wolf {
    let source = fs_read_bytes("tests/fixtures/syn/wolf.fl") else {
        assert(false, "wolf fixture readable")
        return Wolf { pool: syn.syn_pool_new(), engine: syn.syn_engine_new(syn.syn_pool_new(), 0) }
    }
    var c = syn.syn_compile("wolf.fl", source)
    assert(c.diagnostics.nerrors == 0, "wolf.fl compiles")
    var pool = syn.syn_pool_new()
    let root = syn.syn_pool_add(mut pool, take c.definition, 1)
    let engine = syn.syn_engine_new(pool, root)
    Wolf { pool: pool, engine: engine }
}

fn attr_at(out: syn.SynSpans, off: int) -> int {
    for i in 0..out.n {
        let lo = syn.syn_span_start(out, i)
        if off >= lo && off < lo + syn.syn_span_len(out, i) then return syn.syn_span_attr(out, i)
    }
    255
}

fn find(line: List[byte], needle: List[byte]) -> int {
    var at = 0
    while at + needle.len <= line.len {
        var i = 0
        while i < needle.len && line[at + i] == needle[i] { i += 1 }
        if i == needle.len then return at
        at += 1
    }
    -1
}

// wolf_line: one line from `entry`, which must not stop early.
fn wolf_line(mut w: Wolf, entry: int, line: List[byte], mut out: syn.SynSpans) -> int {
    syn.syn_line(mut w.engine, mut w.pool, entry, line, line.len, mut out, false)
    assert(out.stop == syn.SYN_STOP_OK, "the line is not capped")
    out.exit_state
}

// wolf_attr_of: the attribute `within` bytes into `needle` on `line`.
fn attr_of(mut w: Wolf, line: str, needle: str, within: int) -> int {
    let text = bytes(line)
    let found = find(text, bytes(needle))
    assert(found >= 0, "the needle is on the line")
    var out = syn.syn_spans_new(256)
    let _ = wolf_line(mut w, syn.SYN_STATE_ROOT, text, mut out)
    attr_at(out, found + within)
}

// test_syn_wolf_keyword_contract_is_exact_and_closed
fn keyword_contract_is_exact_and_closed() {
    var w = wolf()
    let actual = fs_read_bytes("tests/fixtures/syn/wolf/lexical-contract.txt") else {
        assert(false, "contract readable")
        return
    }
    let expected = bytes(WOLF_KEYWORDS)
    assert(actual.len == expected.len, "contract length")
    for i in 0..expected.len { assert(actual[i] == expected[i], "contract bytes") }
    var lines = 0
    for i in 0..expected.len {
        if expected[i] as int == 10 { lines += 1 }
    }
    assert(lines == 50, "fifty keywords")
    for word in WOLF_KEYWORDS.lines() {
        if word.len != 0 {
            assert(word.len < 16, "a short token")
            let attr = attr_of(mut w, word, word, 0)
            assert(attr == 10 || attr == 2 || attr == 3 || attr == 4, "a keyword renders as a keyword class")
        }
    }
    for word in ["c", "rc", "pool", "from", "timeout", "noalias", "pkg", "self", "out", "inout", "lateout", "reg"] {
        assert(attr_of(mut w, word, word, 0) == 23, "a contextual word alone is a variable")
    }
}

// test_syn_wolf_strings_formats_and_raw_fences_balance
fn strings_formats_and_raw_fences_balance() {
    var w = wolf()
    let ordinary = "fn\"ordinary {{value:>{{width}}}}\""
    let general = "path\"raw {{value}}\""
    let nested = "\"{{map[{{key: 1}}].value:0>8}} {{{{literal}}}}\""
    assert(attr_of(mut w, ordinary, "fn", 0) == 4, "fn is storage")
    assert(attr_of(mut w, ordinary, "{{value", 0) == 14, "interpolation")
    assert(attr_of(mut w, ordinary, ":>", 0) == 15, "format spec")
    assert(attr_of(mut w, ordinary, "{{width", 0) == 14, "nested interpolation")
    assert(attr_of(mut w, general, "path", 0) == 5, "a string prefix is a type")
    assert(attr_of(mut w, general, "{{value", 0) == 15, "a general string does not interpolate")
    assert(attr_of(mut w, nested, ": 1", 0) == 31, "a map colon is an operator")
    assert(attr_of(mut w, nested, ":0>", 0) == 15, "format spec after a nested index")
    assert(attr_of(mut w, nested, "{{{{", 0) == 13, "a doubled brace is an escape")
    let root = syn.syn_state_get(w.engine.states, syn.SYN_STATE_ROOT) else {
        assert(false, "root state exists")
        return
    }
    for hashes in 0..17 {
        var line = bytes("r")
        for _ in 0..hashes { (mut line).push(35 as byte) }
        (mut line).push(34 as byte)
        for b in "raw {{body}}".bytes() { (mut line).push(b) }
        (mut line).push(34 as byte)
        for _ in 0..hashes { (mut line).push(35 as byte) }
        var out = syn.syn_spans_new(64)
        let id = wolf_line(mut w, syn.SYN_STATE_ROOT, line, mut out)
        let exit = syn.syn_state_get(w.engine.states, id) else {
            assert(false, "exit state exists")
            return
        }
        assert(syn.syn_state_depth(exit) == 1, "the fence closes")
        assert(syn.syn_state_lost(exit) == 0, "no lost frames")
        assert(syn.syn_state_ctx(exit, 0) == syn.syn_state_ctx(root, 0), "back in the root context")
        assert(syn.syn_state_def(exit, 0) == syn.syn_state_def(root, 0), "back in the root definition")
        assert(attr_at(out, 2 + hashes) == 15, "a raw body is special")
    }
}

// test_syn_wolf_numbers_comments_and_declarations_are_pinned
fn numbers_comments_and_declarations_are_pinned() {
    var w = wolf()
    let numbers = "1. 1..10 1.e5 1.0 9e-3 0xff 0o7 0b1 1_000"
    let decl = "#[test] fn run() {{ let value = true }}"
    assert(attr_of(mut w, numbers, "1.", 0) == 9, "number")
    assert(attr_of(mut w, numbers, "1.", 1) == 34, "a trailing dot is a delimiter")
    assert(attr_of(mut w, numbers, "1..10", 1) == 31, "range operator")
    assert(attr_of(mut w, numbers, "1.e5", 1) == 22, "a method after a dot")
    assert(attr_of(mut w, numbers, "1.0", 0) == 9, "float")
    assert(attr_of(mut w, numbers, "9e-3", 0) == 9, "exponent")
    assert(attr_of(mut w, numbers, "0xff", 0) == 9, "hex")
    assert(attr_of(mut w, "/// doc", "///", 0) == 17, "outer doc comment")
    assert(attr_of(mut w, "//! doc", "//!", 0) == 17, "inner doc comment")
    assert(attr_of(mut w, "//// ordinary", "////", 0) == 16, "four slashes are ordinary")
    assert(attr_of(mut w, decl, "#[", 0) == 29, "attribute")
    assert(attr_of(mut w, decl, "run", 0) == 19, "function name")
    assert(attr_of(mut w, decl, "value", 0) == 23, "binding")
}

// test_syn_wolf_refresh_pins_shebang_and_builtin_types
fn refresh_pins_shebang_and_builtin_types() {
    // The C case loads the checked-in file by path; so does every case here.
    var w = wolf()
    assert(attr_of(mut w, "#!/usr/bin/env wolf", "#!", 0) == 16, "a first-line shebang is trivia")
    var out = syn.syn_spans_new(64)
    let state = wolf_line(mut w, syn.SYN_STATE_ROOT, bytes("let a = 1"), mut out)
    let _ = wolf_line(mut w, state, bytes("#! not trivia here"), mut out)
    assert(attr_at(out, 0) != 16, "a later #! is not trivia")
    for word in ["bool", "byte", "f32", "f64", "i8", "i16", "i32", "i64", "int", "str", "u8", "u16", "u32", "u64", "uint", "wrapping"] {
        assert(attr_of(mut w, word, word, 0) == 6, "a builtin type")
    }
    assert(attr_of(mut w, "f640", "f640", 0) == 23, "whole words only")
    assert(attr_of(mut w, "str\"raw\"", "str", 0) == 5, "a string prefix keeps its reading")
    assert(attr_of(mut w, "os_random(32)", "os_random", 0) == 19, "a generic call")
    assert(attr_of(mut w, "s.chars()", ".chars", 0) == 22, "a generic method")
}

// test_syn_wolf_contextual_words_are_position_bounded
fn contextual_words_are_position_bounded() {
    var w = wolf()
    let lines = [
        "import c \"x.h\"",
        "region rc Arena",
        "region pool Arena",
        "assume noalias x",
        "pub(pkg) fn f() {{}}",
        "fn f(self: T) {{}}",
        "select {{ value from q }}",
        "select {{ timeout after }}",
        "asm {{ out(reg) x }}",
        "asm {{ inout(reg) x }}",
        "asm {{ lateout(reg) x }}",
        "asm {{ out(reg) x }}",
        "in",
    ]
    let words = ["c", "rc", "pool", "noalias", "pkg", "self", "from", "timeout", "out", "inout", "lateout", "reg", "in"]
    let attrs = [1, 5, 5, 1, 1, 25, 1, 1, 3, 3, 3, 5, 3]
    for i in 0..lines.len {
        assert(attr_of(mut w, lines[i], words[i], 0) == attrs[i], "a contextual word in its position")
    }
}

// test_syn_wolf_unsafe_c_ignores_lexical_braces_for_depth
fn unsafe_c_ignores_lexical_braces_for_depth() {
    var w = wolf()
    let lines = [
        "unsafe c {{",
        "if (ready) {{",
        "call(\"}} in string\"); /* {{ and }} in comment */",
        "char brace = '}}'; // }} in line comment",
        "}}",
        "}}",
    ]
    var out = syn.syn_spans_new(8)
    let main_after_first = wolf_line(mut w, syn.SYN_STATE_ROOT, bytes("plain"), mut out)
    var state = syn.SYN_STATE_ROOT
    var outer = -1
    for i in 0..lines.len {
        var spans = syn.syn_spans_new(128)
        state = wolf_line(mut w, state, bytes(lines[i]), mut spans)
        if i == 0 { outer = state }
        if i == 2 || i == 3 { assert(state != outer, "a brace in a string or comment does not close") }
        if i == 4 { assert(state == outer, "the inner block closes") }
    }
    assert(state == main_after_first, "the unsafe block closes back to main")
}

fn main() {
    let selected = (env_get("YEW_SYN_WOLF_CASE") else "-1").to_int() else -1
    for i in 0..6 {
        if selected == -1 || selected == i {
            match i {
                0 => keyword_contract_is_exact_and_closed(),
                1 => strings_formats_and_raw_fences_balance(),
                2 => numbers_comments_and_declarations_are_pinned(),
                3 => refresh_pins_shebang_and_builtin_types(),
                4 => contextual_words_are_position_bounded(),
                _ => unsafe_c_ignores_lexical_braces_for_depth(),
            }
            print("syn_wolf_case_{i}: PASS")
        }
    }
}
