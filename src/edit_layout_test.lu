//! member: false
//!
//! The port of sagitta `tests/unit/test_layout.c` (1,490 lines), one test
//! per C test in registry order: the pane tree, the layout arithmetic,
//! focus and resize (Sprint 22 §1-§5), the commands through the registry,
//! and Sprint 57.22's `split_side` and edge zones. C's fixture is
//! `yew_ed_init` + `yew_ed_open_scratch` (`ly_fixture`, `test_layout.c:
//! 23-37`); the port's is `edit.ed_new` + `edit.ed_open_scratch`. A C
//! `Pane *` is a pool index here (-1 for NULL), so `ed.pane_root->b->a` is
//! `kid(ed, kid(ed, ed.pane_root, 'b'), 'a')`, spelt `b_of`/`a_of`.
//! Port-only: `port_layout_ratio_is_single_precision` pins the rounding
//! site to C's `float` at a boundary where double precision differs.

use edit
use term
use text
use util

fn fixture() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    assert(ed.pane_root >= 0, "a root")
    assert(ed.panes[ed.pane_root].is_leaf, "the root is a leaf")
    assert(ed.focus == ed.pane_root, "focus on the root")
    ed
}

fn area(w: int, h: int) -> edit.Rect {
    edit.rect(0, 0, w, h)
}

fn lay(mut ed: edit.Ed, w: int, h: int) {
    edit.layout_compute(mut ed, ed.pane_root, area(w, h))
}

fn a_of(ed: edit.Ed, p: int) -> int {
    ed.panes[p].a
}

fn b_of(ed: edit.Ed, p: int) -> int {
    ed.panes[p].b
}

fn rect_of(ed: edit.Ed, p: int) -> edit.Rect {
    copy ed.panes[p].rect
}

fn rect_eq(a: edit.Rect, b: edit.Rect) -> bool {
    a.x == b.x && a.y == b.y && a.w == b.w && a.h == b.h
}

fn rect_is(ed: edit.Ed, p: int, x: int, y: int, w: int, h: int) -> bool {
    rect_eq(rect_of(ed, p), edit.rect(x, y, w, h))
}

// `ly_invoke` (`test_layout.c:715-730`): count 0 means none given.
fn invoke(mut ed: edit.Ed, name: str, count: int) -> int {
    let id = edit.cmd_lookup(ed.reg, name)
    assert(id != 0, "{name} is registered")
    var cx = edit.cmdctx_new(ed.win, edit.SRC_TEST)
    cx.count = if count == 0 then 1 else count
    cx.count_given = count != 0
    edit.ed_cmd_invoke(mut ed, id, mut cx)
}

// `test_layout_root_leaf_takes_the_whole_area` (`:49-60`).
fn t_layout_root_leaf_takes_the_whole_area() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    assert(rect_is(ed, ed.pane_root, 0, 0, 80, 24), "the whole area")
    assert(edit.pane_leaf_count(ed, ed.pane_root) == 1, "one leaf")
}

// `test_layout_h_split_gives_the_border_column_to_the_split` (`:62-89`).
fn t_layout_h_split_gives_the_border_column_to_the_split() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    let b = edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H)
    assert(b >= 0, "split")
    lay(mut ed, 80, 24)
    let r = ed.pane_root
    assert(rect_is(ed, a_of(ed, r), 0, 0, 40, 24), "a is 40 wide")
    assert(rect_is(ed, b_of(ed, r), 41, 0, 39, 24), "b starts past the border")
    assert(
        ed.panes[a_of(ed, r)].rect.w + ed.panes[b_of(ed, r)].rect.w + 1 == 80,
        "every column once",
    )
}

// `test_layout_v_split_gives_the_border_row_to_the_split` (`:92-104`).
fn t_layout_v_split_gives_the_border_row_to_the_split() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    assert(edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_V) >= 0, "split")
    lay(mut ed, 80, 24)
    let r = ed.pane_root
    assert(rect_is(ed, a_of(ed, r), 0, 0, 80, 12), "a is 12 rows")
    assert(rect_is(ed, b_of(ed, r), 0, 13, 80, 11), "b below the border row")
}

// `test_layout_odd_widths_round_at_one_site` (`:112-139`).
fn t_layout_odd_widths_round_at_one_site() {
    for w in [80, 81, 120, 121] {
        var ed = fixture()
        lay(mut ed, w, 24)
        assert(edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H) >= 0, "split at {w}")
        lay(mut ed, w, 24)
        let a = rect_of(ed, a_of(ed, ed.pane_root))
        let b = rect_of(ed, b_of(ed, ed.pane_root))
        assert(a.w + b.w + 1 == w, "every column once at {w}")
        assert(b.x == a.x + a.w + 1, "b just past the border at {w}")
    }
}

// `test_layout_is_deterministic` (`:141-163`).
fn t_layout_is_deterministic() {
    var ed = fixture()
    lay(mut ed, 81, 25)
    let b = edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H)
    lay(mut ed, 81, 25)
    assert(edit.pane_split(mut ed, b, edit.SPLIT_V) >= 0, "nested")
    lay(mut ed, 81, 25)
    let s0 = rect_of(ed, ed.pane_root)
    let s1 = rect_of(ed, a_of(ed, ed.pane_root))
    let s2 = rect_of(ed, b_of(ed, ed.pane_root))
    lay(mut ed, 81, 25)
    assert(rect_eq(s0, rect_of(ed, ed.pane_root)), "root identical")
    assert(rect_eq(s1, rect_of(ed, a_of(ed, ed.pane_root))), "a identical")
    assert(rect_eq(s2, rect_of(ed, b_of(ed, ed.pane_root))), "b identical")
}

// `test_layout_shrink_then_grow_restores_rects` (`:171-198`).
fn t_layout_shrink_then_grow_restores_rects() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    let b = edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H)
    lay(mut ed, 80, 24)
    assert(edit.pane_split(mut ed, b, edit.SPLIT_V) >= 0, "nested")
    lay(mut ed, 80, 24)
    let r = ed.pane_root
    let x0 = rect_of(ed, a_of(ed, r))
    let x1 = rect_of(ed, a_of(ed, b_of(ed, r)))
    let x2 = rect_of(ed, b_of(ed, b_of(ed, r)))
    lay(mut ed, 40, 12)
    lay(mut ed, 80, 24)
    assert(rect_eq(x0, rect_of(ed, a_of(ed, r))), "a restored")
    assert(rect_eq(x1, rect_of(ed, a_of(ed, b_of(ed, r)))), "b.a restored")
    assert(rect_eq(x2, rect_of(ed, b_of(ed, b_of(ed, r)))), "b.b restored")
}

// `test_layout_collapses_rather_than_destroying_on_shrink` (`:200-220`).
fn t_layout_collapses_rather_than_destroying_on_shrink() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    assert(edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H) >= 0, "split")
    lay(mut ed, 20, 24)
    let b = b_of(ed, ed.pane_root)
    assert(ed.panes[b].rect.w == 0, "b collapsed")
    assert(edit.pane_leaf_count(ed, ed.pane_root) == 2, "both nodes kept")
    assert(ed.panes[b].win >= 0, "with its window")
    lay(mut ed, 80, 24)
    assert(ed.panes[b_of(ed, ed.pane_root)].rect.w >= edit.PANE_MIN_W, "b back")
}

// `test_layout_split_refuses_below_minimum` (`:222-237`).
fn t_layout_split_refuses_below_minimum() {
    var ed = fixture()
    lay(mut ed, edit.PANE_MIN_W * 2, 24)
    assert(edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H) < 0, "one short refuses")
    lay(mut ed, edit.PANE_MIN_W * 2 + 1, 24)
    assert(edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H) >= 0, "exactly enough")
}

// `test_layout_split_refuses_vertically_below_minimum` (`:239-251`).
fn t_layout_split_refuses_vertically_below_minimum() {
    var ed = fixture()
    lay(mut ed, 80, edit.PANE_MIN_H * 2)
    assert(edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_V) < 0, "one short refuses")
    lay(mut ed, 80, edit.PANE_MIN_H * 2 + 1)
    assert(edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_V) >= 0, "exactly enough")
}

// `test_layout_split_refuses_past_the_leaf_cap` (`:253-295`): breadth
// first, alternating axes.
fn t_layout_split_refuses_past_the_leaf_cap() {
    var ed = fixture()
    edit.layout_compute(mut ed, ed.pane_root, area(400, 100))
    var leaves = List[int]()
    (mut leaves).push(ed.pane_root)
    var round = 0
    while round < 4 {
        let have = leaves.len
        var i = 0
        while i < have {
            let dir = if round % 2 != 0 then edit.SPLIT_V else edit.SPLIT_H
            let nu = edit.pane_split(mut ed, leaves[i], dir)
            assert(nu >= 0, "split round {round} leaf {i}")
            leaves[i] = ed.panes[leaves[i]].a
            (mut leaves).push(nu)
            edit.layout_compute(mut ed, ed.pane_root, area(400, 100))
            i += 1
        }
        round += 1
    }
    assert(edit.pane_leaf_count(ed, ed.pane_root) == edit.PANE_MAX_LEAVES, "at the cap")
    assert(ed.panes[leaves[0]].rect.w >= edit.PANE_MIN_W * 2 + 1, "room to spare")
    assert(edit.pane_split(mut ed, leaves[0], edit.SPLIT_H) < 0, "the cap refuses")
}

// `test_layout_tree_invariants_survive_split_and_close` (`:297-324`).
fn t_layout_tree_invariants_survive_split_and_close() {
    var ed = fixture()
    lay(mut ed, 120, 40)
    let b = edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H)
    assert(b >= 0, "split")
    lay(mut ed, 120, 40)
    let c = edit.pane_split(mut ed, b, edit.SPLIT_V)
    assert(c >= 0, "nested")
    let r = ed.pane_root
    assert(ed.panes[a_of(ed, r)].parent == r, "a's parent")
    assert(ed.panes[b_of(ed, r)].parent == r, "b's parent")
    assert(ed.panes[a_of(ed, b_of(ed, r))].parent == b_of(ed, r), "b.a's parent")
    assert(ed.panes[b_of(ed, b_of(ed, r))].parent == b_of(ed, r), "b.b's parent")
    assert(edit.pane_leaf_count(ed, r) == 3, "three leaves")
    assert(edit.pane_close(mut ed, c), "close")
    assert(edit.pane_leaf_count(ed, r) == 2, "two leaves")
    assert(ed.panes[b_of(ed, r)].is_leaf, "b collapsed into a leaf")
    assert(ed.panes[b_of(ed, r)].parent == r, "its parent")
}

// `test_layout_root_leaf_refuses_to_close` (`:326-335`).
fn t_layout_root_leaf_refuses_to_close() {
    var ed = fixture()
    assert(!edit.pane_close(mut ed, ed.pane_root), "the root refuses")
    assert(edit.pane_leaf_count(ed, ed.pane_root) == 1, "one leaf")
}

// `test_layout_leaf_at_agrees_with_every_rect` (`:342-386`).
fn t_layout_leaf_at_agrees_with_every_rect() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    let b = edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H)
    lay(mut ed, 80, 24)
    assert(edit.pane_split(mut ed, b, edit.SPLIT_V) >= 0, "nested")
    lay(mut ed, 80, 24)
    var covered = 0
    var borders = 0
    var y = 0
    while y < 24 {
        var x = 0
        while x < 80 {
            let leaf = edit.pane_leaf_at(ed, ed.pane_root, x, y)
            if leaf < 0 {
                borders += 1
            } else {
                let r = rect_of(ed, leaf)
                assert(ed.panes[leaf].is_leaf, "a leaf")
                assert(
                    x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h,
                    "inside its rect at {x},{y}",
                )
                covered += 1
            }
            x += 1
        }
        y += 1
    }
    assert(borders == 24 + ed.panes[b_of(ed, ed.pane_root)].rect.w, "the border cells: {borders}")
    assert(covered + borders == 80 * 24, "every cell")
    assert(edit.pane_leaf_at(ed, ed.pane_root, 80, 0) < 0, "off the right")
    assert(edit.pane_leaf_at(ed, ed.pane_root, 0, 24) < 0, "off the bottom")
}

// `test_layout_draw_and_hit_share_every_clickable_cell_at_audit_sizes`
// (`:388-497`).
fn t_layout_draw_and_hit_share_every_clickable_cell_at_audit_sizes() {
    for size in [(80, 24), (81, 24), (121, 24), (200, 50)] {
        let (cols, rows) = size
        var ed = fixture()
        ed.grid = term.grid_new(rows, cols)
        ed.grid_ready = true
        edit.ed_layout(mut ed)
        let right = edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H)
        assert(right >= 0, "split at {cols}")
        edit.ed_layout(mut ed)
        assert(edit.pane_split(mut ed, right, edit.SPLIT_V) >= 0, "nested at {cols}")
        edit.ed_layout(mut ed)
        term.grid_flip(mut ed.grid)
        edit.draw_panes(mut ed)
        var pane_cells = 0
        var border_cells = 0
        var strip_cells = 0
        var y = 0
        while y < rows {
            var x = 0
            while x < cols {
                let hit = edit.region_hit(mut ed.regions, x, y)
                if hit.kind != edit.REGION_NONE {
                    let hr = copy hit.rect
                    assert(
                        x >= hr.x && x < hr.x + hr.w && y >= hr.y && y < hr.y + hr.h,
                        "in its rect",
                    )
                    assert(ed.grid.dmg[y].lo <= x && x < ed.grid.dmg[y].hi, "repainted at {x},{y}")
                    if hit.kind == edit.REGION_PANE {
                        let leaf = edit.pane_leaf_by_index(ed, hit.payload)
                        assert(leaf >= 0 && ed.panes[leaf].is_leaf, "a leaf")
                        assert(rect_eq(hr, rect_of(ed, leaf)), "the leaf's rect")
                        pane_cells += 1
                    } else if hit.kind == edit.REGION_PANE_BORDER {
                        let split = edit.pane_split_by_index(ed, hit.payload)
                        assert(split >= 0 && !ed.panes[split].is_leaf, "a split")
                        let sr = rect_of(ed, split)
                        let ar = rect_of(ed, a_of(ed, split))
                        let want = if ed.panes[split].dir == edit.SPLIT_H {
                            edit.rect(ar.x + ar.w, sr.y, 1, sr.h)
                        } else {
                            edit.rect(sr.x, ar.y + ar.h, sr.w, 1)
                        }
                        assert(rect_eq(hr, want), "the border's rect")
                        border_cells += 1
                    } else if hit.kind == edit.REGION_TAB ||
                        hit.kind == edit.REGION_TAB_SCROLL ||
                        hit.kind == edit.REGION_TAB_NEW {
                        let t = copy ed.tab_strip_rect
                        assert(hr.y >= t.y && hr.y + hr.h <= t.y + t.h, "in the strip's rows")
                        assert(hr.x >= t.x && hr.x + hr.w <= t.x + t.w, "in the strip's columns")
                        strip_cells += 1
                    } else {
                        assert(false, "an unexpected region kind {hit.kind}")
                    }
                }
                x += 1
            }
            y += 1
        }
        assert(pane_cells != 0, "pane cells at {cols}")
        assert(border_cells != 0, "border cells at {cols}")
        assert(strip_cells != 0, "strip cells at {cols}")
    }
}

// `test_layout_focus_on_a_four_pane_grid` (`:499-537`).
fn t_layout_focus_on_a_four_pane_grid() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    let right = edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H)
    lay(mut ed, 80, 24)
    assert(edit.pane_split(mut ed, a_of(ed, ed.pane_root), edit.SPLIT_V) >= 0, "left split")
    lay(mut ed, 80, 24)
    assert(edit.pane_split(mut ed, right, edit.SPLIT_V) >= 0, "right split")
    lay(mut ed, 80, 24)
    let r = ed.pane_root
    let tl = a_of(ed, a_of(ed, r))
    let bl = b_of(ed, a_of(ed, r))
    let tr = a_of(ed, b_of(ed, r))
    let br = b_of(ed, b_of(ed, r))
    assert(edit.pane_dir(ed, r, tl, edit.DIR_RIGHT) == tr, "tl right")
    assert(edit.pane_dir(ed, r, tr, edit.DIR_LEFT) == tl, "tr left")
    assert(edit.pane_dir(ed, r, tl, edit.DIR_DOWN) == bl, "tl down")
    assert(edit.pane_dir(ed, r, bl, edit.DIR_UP) == tl, "bl up")
    assert(edit.pane_dir(ed, r, br, edit.DIR_LEFT) == bl, "br left")
    assert(edit.pane_dir(ed, r, br, edit.DIR_UP) == tr, "br up")
    assert(edit.pane_dir(ed, r, tl, edit.DIR_LEFT) < 0, "no wrap left")
    assert(edit.pane_dir(ed, r, tl, edit.DIR_UP) < 0, "no wrap up")
    assert(edit.pane_dir(ed, r, br, edit.DIR_RIGHT) < 0, "no wrap right")
    assert(edit.pane_dir(ed, r, br, edit.DIR_DOWN) < 0, "no wrap down")
}

// `test_layout_focus_on_a_three_pane_t` (`:539-567`).
fn t_layout_focus_on_a_three_pane_t() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    let right = edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H)
    lay(mut ed, 80, 24)
    assert(edit.pane_split(mut ed, right, edit.SPLIT_V) >= 0, "right split")
    lay(mut ed, 80, 24)
    let r = ed.pane_root
    let left = a_of(ed, r)
    let tr = a_of(ed, b_of(ed, r))
    let br = b_of(ed, b_of(ed, r))
    assert(edit.pane_dir(ed, r, left, edit.DIR_RIGHT) == tr, "the tie to the top")
    assert(edit.pane_dir(ed, r, tr, edit.DIR_LEFT) == left, "tr left")
    assert(edit.pane_dir(ed, r, br, edit.DIR_LEFT) == left, "br left")
    assert(edit.pane_dir(ed, r, tr, edit.DIR_DOWN) == br, "tr down")
    assert(edit.pane_dir(ed, r, br, edit.DIR_UP) == tr, "br up")
}

// `test_layout_focus_next_cycles_in_tree_order` (`:569-597`).
fn t_layout_focus_next_cycles_in_tree_order() {
    var ed = fixture()
    lay(mut ed, 120, 24)
    let b = edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H)
    lay(mut ed, 120, 24)
    assert(edit.pane_split(mut ed, b, edit.SPLIT_H) >= 0, "nested")
    lay(mut ed, 120, 24)
    let r = ed.pane_root
    let first = a_of(ed, r)
    let second = a_of(ed, b_of(ed, r))
    let third = b_of(ed, b_of(ed, r))
    assert(edit.pane_next(ed, r, first) == second, "1 -> 2")
    assert(edit.pane_next(ed, r, second) == third, "2 -> 3")
    assert(edit.pane_next(ed, r, third) == first, "3 -> 1")
    assert(edit.pane_prev(ed, r, first) == third, "1 <- 3")
    assert(edit.pane_prev(ed, r, third) == second, "3 <- 2")
    assert(edit.pane_prev(ed, r, second) == first, "2 <- 1")
}

// `test_layout_resize_moves_by_cells_and_clamps` (`:599-628`).
fn t_layout_resize_moves_by_cells_and_clamps() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    assert(edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H) >= 0, "split")
    lay(mut ed, 80, 24)
    let split = ed.pane_root
    let before = ed.panes[a_of(ed, split)].rect.w
    assert(edit.pane_resize(mut ed, split, 2), "+2")
    lay(mut ed, 80, 24)
    assert(ed.panes[a_of(ed, split)].rect.w == before + 2, "moved 2")
    assert(edit.pane_resize(mut ed, split, -5), "-5")
    lay(mut ed, 80, 24)
    assert(ed.panes[a_of(ed, split)].rect.w == before - 3, "moved back 5")
    let kept = ed.panes[split].ratio
    assert(!edit.pane_resize(mut ed, split, -1000), "past the minimum refuses")
    assert(ed.panes[split].ratio == kept, "the ratio untouched")
}

// `test_layout_ancestor_split_walks_to_the_matching_axis` (`:630-650`).
fn t_layout_ancestor_split_walks_to_the_matching_axis() {
    var ed = fixture()
    lay(mut ed, 120, 40)
    let b = edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H)
    lay(mut ed, 120, 40)
    let deep = edit.pane_split(mut ed, b, edit.SPLIT_V)
    lay(mut ed, 120, 40)
    assert(edit.pane_ancestor_split(ed, deep, edit.SPLIT_V) == b, "the inner V")
    assert(edit.pane_ancestor_split(ed, deep, edit.SPLIT_H) == ed.pane_root, "the root H")
    var solo = fixture()
    assert(edit.pane_ancestor_split(solo, solo.pane_root, edit.SPLIT_H) < 0, "a lone leaf has none")
}

// `test_layout_tree_walk_visits_every_node` (`:660-676`).
fn t_layout_tree_walk_visits_every_node() {
    var ed = fixture()
    lay(mut ed, 120, 40)
    let b = edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H)
    lay(mut ed, 120, 40)
    assert(edit.pane_split(mut ed, b, edit.SPLIT_V) >= 0, "nested")
    let nodes = edit.pane_tree_nodes(ed, ed.pane_root)
    assert(nodes.len == 5, "3 leaves + 2 splits: {nodes.len}")
}

// `test_layout_keeps_inactive_linked_viewport_detached_from_cursor`
// (`:678-713`).
fn t_layout_keeps_inactive_linked_viewport_detached_from_cursor() {
    var ed = fixture()
    var t = ""
    var i = 0
    while i < 80 {
        let n = if i < 10 then "00{i}" else "0{i}"
        t = t + "row-{n}\n"
        i += 1
    }
    let b = ed.wins[ed.win].buf
    text.textbuf_insert(mut ed.bufs[b].ec.tb, 0 as text.ByteOff, t.bytes())
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    edit.ed_layout(mut ed)
    let right = edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H)
    assert(right >= 0, "split")
    ed.focus = a_of(ed, ed.pane_root)
    ed.win = ed.panes[ed.focus].win
    ed.wins[ed.panes[a_of(ed, ed.pane_root)].win].scroll_link = 7
    let rw = ed.panes[right].win
    ed.wins[rw].scroll_link = 7
    ed.wins[rw].vp.top = 20
    edit.ed_layout(mut ed)
    assert(ed.wins[rw].vp.top == 20, "the peer's view stays at 20: {ed.wins[rw].vp.top}")
    let rb = ed.wins[rw].buf
    let line = text.textbuf_line_of(
        ed.bufs[rb].ec.tb,
        ed.wins[rw].cs.curs[0].pos as text.ByteOff,
    ) as int
    assert(line == 0, "its cursor stays on line 0")
}

// `test_layout_split_command_focuses_the_new_pane` (`:732-747`).
fn t_layout_split_command_focuses_the_new_pane() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    assert(invoke(mut ed, "ed.pane.split_h", 0) == edit.CMD_OK, "split_h")
    assert(edit.pane_leaf_count(ed, ed.pane_root) == 2, "two leaves")
    assert(ed.focus == b_of(ed, ed.pane_root), "the new pane takes focus")
    assert(ed.win == ed.panes[ed.focus].win, "the window follows")
    let wa = ed.panes[a_of(ed, ed.pane_root)].win
    let wb = ed.panes[b_of(ed, ed.pane_root)].win
    assert(ed.wins[wa].buf == ed.wins[wb].buf, "one buffer, two views")
}

// `test_layout_split_command_refuses_with_a_message` (`:749-758`).
fn t_layout_split_command_refuses_with_a_message() {
    var ed = fixture()
    lay(mut ed, 10, 24)
    assert(invoke(mut ed, "ed.pane.split_h", 0) != edit.CMD_OK, "refused")
    assert(edit.pane_leaf_count(ed, ed.pane_root) == 1, "one leaf")
}

// `test_layout_close_command_moves_focus_to_a_live_leaf` (`:762-780`).
fn t_layout_close_command_moves_focus_to_a_live_leaf() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    assert(invoke(mut ed, "ed.pane.split_h", 0) == edit.CMD_OK, "split_h")
    lay(mut ed, 80, 24)
    assert(invoke(mut ed, "ed.pane.close", 0) == edit.CMD_OK, "close")
    assert(edit.pane_leaf_count(ed, ed.pane_root) == 1, "one leaf")
    assert(ed.focus >= 0 && ed.panes[ed.focus].is_leaf, "focus on a leaf")
    assert(ed.focus == ed.pane_root, "the root")
    assert(ed.win == ed.panes[ed.focus].win, "the window follows")
    assert(invoke(mut ed, "ed.pane.close", 0) != edit.CMD_OK, "the last pane refuses")
}

// `test_layout_focus_commands_move_and_stop_at_edges` (`:782-805`).
fn t_layout_focus_commands_move_and_stop_at_edges() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    assert(invoke(mut ed, "ed.pane.split_h", 0) == edit.CMD_OK, "split_h")
    lay(mut ed, 80, 24)
    assert(ed.focus == b_of(ed, ed.pane_root), "on b")
    assert(invoke(mut ed, "ed.pane.focus_left", 0) == edit.CMD_OK, "left")
    assert(ed.focus == a_of(ed, ed.pane_root), "on a")
    assert(invoke(mut ed, "ed.pane.focus_left", 0) == edit.CMD_OK, "left again")
    assert(ed.focus == a_of(ed, ed.pane_root), "still a: no wrap")
    assert(invoke(mut ed, "ed.pane.focus_right", 0) == edit.CMD_OK, "right")
    assert(ed.focus == b_of(ed, ed.pane_root), "back on b")
}

// `test_layout_grow_widens_the_focused_pane_on_either_side` (`:807-840`).
fn t_layout_grow_widens_the_focused_pane_on_either_side() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    assert(invoke(mut ed, "ed.pane.split_h", 0) == edit.CMD_OK, "split_h")
    lay(mut ed, 80, 24)
    let b0 = ed.panes[b_of(ed, ed.pane_root)].rect.w
    assert(invoke(mut ed, "ed.pane.grow", 0) == edit.CMD_OK, "grow b")
    lay(mut ed, 80, 24)
    assert(ed.panes[b_of(ed, ed.pane_root)].rect.w == b0 + 2, "b grew 2")
    assert(invoke(mut ed, "ed.pane.focus_left", 0) == edit.CMD_OK, "left")
    let a0 = ed.panes[a_of(ed, ed.pane_root)].rect.w
    assert(invoke(mut ed, "ed.pane.grow", 0) == edit.CMD_OK, "grow a")
    lay(mut ed, 80, 24)
    assert(ed.panes[a_of(ed, ed.pane_root)].rect.w == a0 + 2, "a grew 2")
    let a1 = ed.panes[a_of(ed, ed.pane_root)].rect.w
    assert(invoke(mut ed, "ed.pane.shrink", 5) == edit.CMD_OK, "shrink 5")
    lay(mut ed, 80, 24)
    assert(ed.panes[a_of(ed, ed.pane_root)].rect.w == a1 - 5, "a shrank 5")
}

// `test_layout_drag_moves_by_delta_and_esc_restores` (`:842-882`).
fn t_layout_drag_moves_by_delta_and_esc_restores() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    assert(invoke(mut ed, "ed.pane.split_h", 0) == edit.CMD_OK, "split_h")
    lay(mut ed, 80, 24)
    let before = ed.panes[a_of(ed, ed.pane_root)].rect.w
    edit.pane_drag_begin(mut ed, ed.pane_root, before, 5)
    assert(ed.drag.active, "a drag")
    edit.pane_drag_motion(mut ed, before + 3, 5)
    lay(mut ed, 80, 24)
    assert(ed.panes[a_of(ed, ed.pane_root)].rect.w == before + 3, "moved 3")
    edit.pane_drag_end(mut ed)
    assert(!ed.drag.active, "ended")
    let entry = ed.panes[ed.pane_root].ratio
    let b2 = ed.panes[a_of(ed, ed.pane_root)].rect.w
    edit.pane_drag_begin(mut ed, ed.pane_root, b2, 5)
    edit.pane_drag_motion(mut ed, b2 + 6, 5)
    lay(mut ed, 80, 24)
    assert(ed.panes[a_of(ed, ed.pane_root)].rect.w != b2, "moved")
    edit.pane_drag_cancel(mut ed)
    lay(mut ed, 80, 24)
    assert(ed.panes[ed.pane_root].ratio == entry, "the entry ratio back")
    assert(ed.panes[a_of(ed, ed.pane_root)].rect.w == b2, "the border back")
}

// `test_layout_close_repairs_focus_on_the_freed_sibling` (`:884-911`).
fn t_layout_close_repairs_focus_on_the_freed_sibling() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    let right = edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H)
    assert(right >= 0, "split")
    lay(mut ed, 80, 24)
    let left = a_of(ed, ed.pane_root)
    ed.focus = right
    assert(edit.pane_close(mut ed, left), "close the left")
    assert(ed.focus >= 0, "focus kept")
    assert(ed.focus == ed.pane_root, "on the root")
    assert(ed.panes[ed.focus].is_leaf && ed.panes[ed.focus].live, "a live leaf")
    assert(edit.pane_leaf_count(ed, ed.pane_root) == 1, "one leaf")
}

// `test_layout_split_side_places_the_new_leaf_first` (`:923-944`).
fn t_layout_split_side_places_the_new_leaf_first() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    let old_win = ed.panes[ed.pane_root].win
    let nu = edit.pane_split_side(mut ed, ed.pane_root, edit.SPLIT_H, true)
    assert(nu >= 0, "split")
    assert(a_of(ed, ed.pane_root) == nu, "new is a")
    assert(ed.panes[b_of(ed, ed.pane_root)].win == old_win, "old is b")
    assert(ed.panes[nu].win != old_win, "the clone")
    lay(mut ed, 80, 24)
    assert(rect_is(ed, nu, 0, 0, 40, 24), "the left half")
    assert(rect_is(ed, b_of(ed, ed.pane_root), 41, 0, 39, 24), "the right half")
}

// `test_layout_split_side_places_the_new_leaf_above` (`:946-969`).
fn t_layout_split_side_places_the_new_leaf_above() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    let old_win = ed.panes[ed.pane_root].win
    let nu = edit.pane_split_side(mut ed, ed.pane_root, edit.SPLIT_V, true)
    assert(nu >= 0, "split")
    assert(a_of(ed, ed.pane_root) == nu, "new is a")
    assert(ed.panes[b_of(ed, ed.pane_root)].win == old_win, "old is b")
    lay(mut ed, 80, 24)
    assert(rect_is(ed, nu, 0, 0, 80, 12), "the top")
    assert(rect_is(ed, b_of(ed, ed.pane_root), 0, 13, 80, 11), "the bottom")
}

// `test_layout_split_side_last_matches_plain_split` (`:971-1001`).
fn t_layout_split_side_last_matches_plain_split() {
    var a = fixture()
    lay(mut a, 80, 24)
    let via_plain = edit.pane_split(mut a, a.pane_root, edit.SPLIT_H)
    assert(via_plain >= 0, "plain")
    lay(mut a, 80, 24)
    var b = fixture()
    lay(mut b, 80, 24)
    let via_side = edit.pane_split_side(mut b, b.pane_root, edit.SPLIT_H, false)
    assert(via_side >= 0, "side")
    lay(mut b, 80, 24)
    assert(via_plain == b_of(a, a.pane_root), "plain is b")
    assert(via_side == b_of(b, b.pane_root), "side is b")
    assert(rect_eq(rect_of(a, a_of(a, a.pane_root)), rect_of(b, a_of(b, b.pane_root))), "a rects")
    assert(rect_eq(rect_of(a, b_of(a, a.pane_root)), rect_of(b, b_of(b, b.pane_root))), "b rects")
    assert(a.panes[a.pane_root].dir == b.panes[b.pane_root].dir, "dirs")
    assert(a.panes[a.pane_root].ratio == b.panes[b.pane_root].ratio, "ratios")
    assert(a.panes[a_of(a, a.pane_root)].ratio == b.panes[a_of(b, b.pane_root)].ratio, "a ratios")
    assert(a.panes[b_of(a, a.pane_root)].ratio == b.panes[b_of(b, b.pane_root)].ratio, "b ratios")
}

// `test_layout_split_side_state_token_follows_the_old_window`
// (`:1011-1038`).
fn t_layout_split_side_state_token_follows_the_old_window() {
    for first in [false, true] {
        var ed = fixture()
        lay(mut ed, 80, 24)
        ed.panes[ed.pane_root].state_token = 24301
        let nu = edit.pane_split_side(mut ed, ed.pane_root, edit.SPLIT_H, first)
        assert(nu >= 0, "split")
        let old = if first then b_of(ed, ed.pane_root) else a_of(ed, ed.pane_root)
        assert(old != nu, "two leaves")
        assert(ed.panes[old].state_token == 24301, "the old window keeps it")
        assert(ed.panes[nu].state_token == 0, "the clone has none")
        assert(ed.panes[ed.pane_root].state_token == 0, "the split has none")
    }
}

// The roomiest-leaf split loop of the two cap tests (`:1040-1088`).
fn split_to_cap(mut ed: edit.Ed, new_first: bool) {
    edit.layout_compute(mut ed, ed.pane_root, area(200, 200))
    while edit.pane_leaf_count(ed, ed.pane_root) < edit.PANE_MAX_LEAVES {
        let leaves = edit.pane_collect_leaves(ed, ed.pane_root, edit.PANE_MAX_LEAVES)
        assert(leaves.len > 0, "leaves")
        var tallest = 0
        var i = 1
        while i < leaves.len {
            if ed.panes[leaves[i]].rect.h > ed.panes[leaves[tallest]].rect.h {
                tallest = i
            }
            i += 1
        }
        assert(edit.pane_split_side(mut ed, leaves[tallest], edit.SPLIT_V, new_first) >= 0, "split")
        edit.layout_compute(mut ed, ed.pane_root, area(200, 200))
    }
}

// `test_layout_split_side_refuses_at_the_leaf_cap` (`:1040-1088`).
fn t_layout_split_side_refuses_at_the_leaf_cap() {
    var ed = fixture()
    split_to_cap(mut ed, true)
    let n = edit.pane_leaf_count(ed, ed.pane_root)
    assert(n == edit.PANE_MAX_LEAVES, "at the cap")
    let leaves = edit.pane_collect_leaves(ed, ed.pane_root, edit.PANE_MAX_LEAVES)
    assert(leaves.len == edit.PANE_MAX_LEAVES, "all collected")
    assert(ed.panes[leaves[0]].rect.w >= edit.PANE_MIN_W * 2 + 1, "room to spare")
    assert(edit.pane_split_side(mut ed, leaves[0], edit.SPLIT_H, true) < 0, "first refused")
    assert(edit.pane_split_side(mut ed, leaves[0], edit.SPLIT_H, false) < 0, "last refused")
    assert(edit.pane_leaf_count(ed, ed.pane_root) == n, "the tree as it was")
}

// `test_layout_split_side_refuses_when_the_leaf_is_too_small`
// (`:1090-1117`).
fn t_layout_split_side_refuses_when_the_leaf_is_too_small() {
    var ed = fixture()
    lay(mut ed, edit.PANE_MIN_W * 2, edit.PANE_MIN_H * 2)
    assert(edit.pane_split_side(mut ed, ed.pane_root, edit.SPLIT_H, true) < 0, "too narrow")
    assert(edit.pane_split_side(mut ed, ed.pane_root, edit.SPLIT_V, true) < 0, "too short")
    assert(ed.panes[ed.pane_root].is_leaf, "still a leaf")
    assert(edit.pane_leaf_count(ed, ed.pane_root) == 1, "one leaf")
    lay(mut ed, edit.PANE_MIN_W * 2 + 1, edit.PANE_MIN_H * 2 + 1)
    assert(edit.pane_split_side(mut ed, ed.pane_root, edit.SPLIT_H, true) >= 0, "exactly enough")
}

// `test_layout_split_side_refuses_a_non_leaf` (`:1119-1137`): C's NULL
// editor has no port shape (the editor is a value); NULL is -1.
fn t_layout_split_side_refuses_a_non_leaf() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    assert(edit.pane_split_side(mut ed, -1, edit.SPLIT_H, true) < 0, "no leaf")
    assert(edit.pane_split_side(mut ed, ed.pane_root, edit.SPLIT_H, true) >= 0, "a leaf splits")
    assert(edit.pane_split_side(mut ed, ed.pane_root, edit.SPLIT_H, true) < 0, "a split refuses")
}

// `test_layout_zone_depth_clamps_at_both_ends` (`:1146-1162`).
fn t_layout_zone_depth_clamps_at_both_ends() {
    assert(edit.pane_zone_depth(0) == 3, "0")
    assert(edit.pane_zone_depth(14) == 3, "14")
    assert(edit.pane_zone_depth(15) == 3, "15")
    assert(edit.pane_zone_depth(16) == 3, "16")
    assert(edit.pane_zone_depth(19) == 3, "19")
    assert(edit.pane_zone_depth(20) == 4, "20")
    assert(edit.pane_zone_depth(59) == 11, "59")
    assert(edit.pane_zone_depth(60) == 12, "60")
    assert(edit.pane_zone_depth(64) == 12, "64")
    assert(edit.pane_zone_depth(1000) == 12, "1000")
}

fn zone(ed: edit.Ed, leaf: int, x: int, y: int) -> (bool, edit.PaneZoneHit) {
    edit.pane_zone_at(ed, leaf, x, y)
}

// `test_layout_zone_bands_are_the_edge_cells` (`:1169-1228`).
fn t_layout_zone_bands_are_the_edge_cells() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    let dw = edit.pane_zone_depth(80)
    let dh = edit.pane_zone_depth(24)
    let r = ed.pane_root
    let (ok1, h1) = zone(ed, r, dw - 1, 12)
    assert(
        ok1 && h1.zone == edit.ZONE_LEFT && h1.dir == edit.SPLIT_H && h1.new_first,
        "left's last cell",
    )
    assert(rect_eq(h1.band, edit.rect(0, 0, dw, 24)), "the left band")
    let (ok2, h2) = zone(ed, r, 0, 12)
    assert(ok2 && h2.zone == edit.ZONE_LEFT, "left's first cell")
    let (ok3, _) = zone(ed, r, dw, 12)
    assert(!ok3, "past the left band")
    let (ok4, h4) = zone(ed, r, 80 - dw, 12)
    assert(
        ok4 && h4.zone == edit.ZONE_RIGHT && h4.dir == edit.SPLIT_H && !h4.new_first,
        "right's first cell",
    )
    assert(rect_eq(h4.band, edit.rect(80 - dw, 0, dw, 24)), "the right band")
    let (ok5, h5) = zone(ed, r, 79, 12)
    assert(ok5 && h5.zone == edit.ZONE_RIGHT, "right's last cell")
    let (ok6, _) = zone(ed, r, 80 - dw - 1, 12)
    assert(!ok6, "before the right band")
    let (ok7, h7) = zone(ed, r, 40, 24 - dh)
    assert(
        ok7 && h7.zone == edit.ZONE_BOTTOM && h7.dir == edit.SPLIT_V && !h7.new_first,
        "bottom's first row",
    )
    assert(rect_eq(h7.band, edit.rect(0, 24 - dh, 80, dh)), "the bottom band")
    let (ok8, h8) = zone(ed, r, 40, 23)
    assert(ok8 && h8.zone == edit.ZONE_BOTTOM, "bottom's last row")
    let (ok9, _) = zone(ed, r, 40, 24 - dh - 1)
    assert(!ok9, "above the bottom band")
    let (ok10, h10) = zone(ed, r, 40, 12)
    assert(!ok10 && h10.zone == edit.ZONE_NONE, "the interior")
    let (ok11, _) = zone(ed, r, 80, 12)
    assert(!ok11, "off the right")
    let (ok12, _) = zone(ed, r, 40, 24)
    assert(!ok12, "off the bottom")
}

// `test_layout_zone_corner_belongs_to_the_side_band` (`:1230-1243`).
fn t_layout_zone_corner_belongs_to_the_side_band() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    let (ok1, h1) = zone(ed, ed.pane_root, 0, 23)
    assert(ok1 && h1.zone == edit.ZONE_LEFT, "bottom-left is left")
    let (ok2, h2) = zone(ed, ed.pane_root, 79, 23)
    assert(ok2 && h2.zone == edit.ZONE_RIGHT, "bottom-right is right")
}

// `test_layout_zone_preview_is_where_the_split_lands` (`:1252-1284`).
fn t_layout_zone_preview_is_where_the_split_lands() {
    for probe in [(1, 12, edit.ZONE_LEFT), (78, 12, edit.ZONE_RIGHT), (40, 23, edit.ZONE_BOTTOM)] {
        let (x, y, want) = probe
        var ed = fixture()
        lay(mut ed, 80, 24)
        let (ok, hit) = zone(ed, ed.pane_root, x, y)
        assert(ok && hit.zone == want, "the zone at {x},{y}")
        let nu = edit.pane_split_side(mut ed, ed.pane_root, hit.dir, hit.new_first)
        assert(nu >= 0, "split")
        lay(mut ed, 80, 24)
        assert(rect_eq(rect_of(ed, nu), hit.preview), "lands on the preview at {x},{y}")
    }
}

// `test_layout_zone_refuses_when_the_leaf_is_too_small` (`:1286-1320`).
fn t_layout_zone_refuses_when_the_leaf_is_too_small() {
    var ed = fixture()
    lay(mut ed, edit.PANE_MIN_W * 2, edit.PANE_MIN_H * 2)
    var y = 0
    while y < edit.PANE_MIN_H * 2 {
        var x = 0
        while x < edit.PANE_MIN_W * 2 {
            let (ok, _) = zone(ed, ed.pane_root, x, y)
            assert(!ok, "no zone at {x},{y}")
            x += 1
        }
        y += 1
    }
    lay(mut ed, edit.PANE_MIN_W * 2 + 1, edit.PANE_MIN_H * 2 + 1)
    let (ok1, h1) = zone(ed, ed.pane_root, 0, 0)
    assert(ok1 && h1.zone == edit.ZONE_LEFT, "left back")
    let (ok2, h2) = zone(ed, ed.pane_root, edit.PANE_MIN_W * 2, 0)
    assert(ok2 && h2.zone == edit.ZONE_RIGHT, "right back")
    let (ok3, h3) = zone(ed, ed.pane_root, edit.PANE_MIN_W, edit.PANE_MIN_H * 2)
    assert(ok3 && h3.zone == edit.ZONE_BOTTOM, "bottom back")
}

// `test_layout_zone_follows_the_axis_that_fits` (`:1322-1347`).
fn t_layout_zone_follows_the_axis_that_fits() {
    var ed = fixture()
    lay(mut ed, edit.PANE_MIN_W * 2, 24)
    let (ok1, _) = zone(ed, ed.pane_root, 0, 12)
    assert(!ok1, "no left band")
    let (ok2, _) = zone(ed, ed.pane_root, edit.PANE_MIN_W * 2 - 1, 12)
    assert(!ok2, "no right band")
    let (ok3, h3) = zone(ed, ed.pane_root, 0, 23)
    assert(ok3 && h3.zone == edit.ZONE_BOTTOM, "the corner is the bottom's")
    lay(mut ed, 80, edit.PANE_MIN_H * 2)
    let (ok4, h4) = zone(ed, ed.pane_root, 0, 5)
    assert(ok4 && h4.zone == edit.ZONE_LEFT, "left fits")
    let (ok5, _) = zone(ed, ed.pane_root, 40, 5)
    assert(!ok5, "no bottom band")
}

// `test_layout_zone_side_bands_never_touch` (`:1356-1388`).
fn t_layout_zone_side_bands_never_touch() {
    var ed = fixture()
    var w = 1
    while w <= 200 {
        let fits = w >= edit.PANE_MIN_W * 2 + 1
        let depth = edit.pane_zone_depth(w)
        lay(mut ed, w, 24)
        let (ok_lo, lo) = zone(ed, ed.pane_root, 0, 12)
        let (ok_hi, hi) = zone(ed, ed.pane_root, w - 1, 12)
        assert(ok_lo == fits, "left offered iff it fits at {w}")
        assert(ok_hi == fits, "right offered iff it fits at {w}")
        if fits {
            assert(lo.zone == edit.ZONE_LEFT && hi.zone == edit.ZONE_RIGHT, "the two sides at {w}")
            assert(depth * 2 < w, "interior left at {w}")
            assert(lo.band.x + lo.band.w <= hi.band.x, "disjoint at {w}")
        }
        w += 1
    }
}

// `test_layout_zone_refuses_at_the_leaf_cap` (`:1390-1435`).
fn t_layout_zone_refuses_at_the_leaf_cap() {
    var ed = fixture()
    split_to_cap(mut ed, false)
    let leaves = edit.pane_collect_leaves(ed, ed.pane_root, edit.PANE_MAX_LEAVES)
    assert(leaves.len == edit.PANE_MAX_LEAVES, "at the cap")
    assert(ed.panes[leaves[0]].rect.w >= edit.PANE_MIN_W * 2 + 1, "room to spare")
    for l in leaves {
        let r = rect_of(ed, l)
        var y = r.y
        while y < r.y + r.h {
            var x = r.x
            while x < r.x + r.w {
                let (ok, _) = zone(ed, l, x, y)
                assert(!ok, "no zone at the cap")
                x += 1
            }
            y += 1
        }
    }
}

// `test_layout_zone_bands_are_per_leaf` (`:1437-1463`).
fn t_layout_zone_bands_are_per_leaf() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    let right = edit.pane_split_side(mut ed, ed.pane_root, edit.SPLIT_H, false)
    assert(right >= 0, "split")
    lay(mut ed, 80, 24)
    let rx = ed.panes[right].rect.x
    assert(rx > 0, "mid-screen")
    let (ok1, h1) = zone(ed, right, rx, 12)
    assert(ok1 && h1.zone == edit.ZONE_LEFT && h1.band.x == rx, "its own left band")
    let (ok2, _) = zone(ed, right, rx - 1, 12)
    assert(!ok2, "the border is not its")
    let (ok3, h3) = zone(ed, a_of(ed, ed.pane_root), rx - 2, 12)
    assert(ok3 && h3.zone == edit.ZONE_RIGHT, "the left leaf's right band")
}

// `test_layout_zone_refuses_a_non_leaf` (`:1465-1490`): the NULL editor
// and the NULL out-parameter have no port shape.
fn t_layout_zone_refuses_a_non_leaf() {
    var ed = fixture()
    lay(mut ed, 80, 24)
    let (ok1, _) = zone(ed, -1, 1, 1)
    assert(!ok1, "no leaf")
    let (ok2, _) = zone(ed, ed.pane_root, 1, 1)
    assert(ok2, "a leaf has its zone")
    assert(edit.pane_split_side(mut ed, ed.pane_root, edit.SPLIT_H, false) >= 0, "split")
    let (ok3, _) = zone(ed, ed.pane_root, 1, 1)
    assert(!ok3, "a split has none")
}

// Port-only: `split_cells` rounds in C's `float`. A ratio stored by a
// resize — `(float)want / (float)usable` — then laid out at another span
// is where single and double precision part company: 21 of 36 usable
// cells stored, then a 55-column split (54 usable), C's float product
// rounds to 31 where double precision says 32. The expected cell is C's
// own (`notes/yw05-evidence/panes/float-ratio.txt`: the oracle's compiler
// over the same two expressions, and eleven more such boundaries).
fn t_port_layout_ratio_is_single_precision() {
    let ratio = util.f32_div_bits(21, 36)
    let cells = edit.split_cells(55, ratio, 0, 0)
    let wd: f64 = 21.0
    let ud: f64 = 36.0
    let dbl = (54.0 * (wd / ud) + 0.5) as int
    assert(dbl == 32, "double precision says 32: {dbl}")
    assert(cells == 31, "C's float answer is 31: {cells}")
    // And through the resize itself: a 37-cell split moved to 21 cells,
    // laid out at 55.
    var ed = fixture()
    lay(mut ed, 37, 24)
    assert(edit.pane_split(mut ed, ed.pane_root, edit.SPLIT_H) >= 0, "split")
    lay(mut ed, 37, 24)
    let now = ed.panes[a_of(ed, ed.pane_root)].rect.w
    assert(edit.pane_resize(mut ed, ed.pane_root, 21 - now), "resize to 21")
    lay(mut ed, 55, 24)
    assert(
        ed.panes[a_of(ed, ed.pane_root)].rect.w == 31,
        "laid out at 55: {ed.panes[a_of(ed, ed.pane_root)].rect.w}",
    )
}

