//! member: false
//!
//! The port of sagitta `tests/unit/test_hmode.c` (489 lines), one test per
//! C test in registry order (`tests/unit/registry.c:738-750`). C's
//! fixture (`h_editor`) is `yew_ed_init` + `yew_ed_open_scratch` +
//! `yew_test_load_runtime` with the text inserted into the scratch
//! buffer; the port's is `edit.ed_new_test` over `runtime/init.fl` read
//! from the repository root. C calls a handler directly with a zeroed
//! `CmdCtx` naming the window (count 0, which no handler here reads); the
//! port builds the context with `cmdctx_new` and calls the same handler
//! (`edit.ec_*`). C compares `h.unit` with a `UnitOps` pointer; the port's
//! unit is the engine's kind (`edit.UNIT_*`).

use edit
use term
use text

fn runtime() -> List[byte] {
    let bytes = fs_read_bytes("runtime/init.fl") else List[byte]()
    assert(bytes.len != 0, "runtime/init.fl is readable from the repository root")
    bytes
}

fn h_editor(seed: str) -> edit.Ed {
    edit.ed_new_test(runtime(), seed)
}

// `h_key` (`test_hmode.c:9-21`).
fn h_key(code: int) -> term.Key {
    var key = term.key_new()
    key.code = code
    key.kind = term.EV_KEY
    key.ev = term.KEY_PRESS
    if code < 128 {
        (mut key.text).push(code as byte)
    }
    key
}

fn h_mod_key(code: int, mods: int) -> term.Key {
    var key = h_key(code)
    key.mods = mods
    key
}

// `h_place` (`test_hmode.c:39-51`).
fn h_place(mut ed: edit.Ed, pos: int, anchor: int) {
    let w = ed.win
    let p = ed.wins[w].cs.primary
    let b = ed.wins[w].buf
    ed.wins[w].cs.curs[p].pos = pos
    ed.wins[w].cs.curs[p].anchor = anchor
    let line = text.textbuf_line_span(ed.bufs[b].ec.tb, text.textbuf_line_of(ed.bufs[b].ec.tb, pos as text.ByteOff))
    ed.wins[w].cs.curs[p].goal_col = text.off_to_ccol(ed.bufs[b].ec.tb, line, pos as text.ByteOff, edit.VP_TABWIDTH) as int
}

fn h_assert_text(ed: edit.Ed, want: str) {
    let b = ed.wins[ed.win].buf
    let got = text.textbuf_bytes(ed.bufs[b].ec.tb)
    let wb = want.bytes()
    assert(got.len == wb.len, "text length {got.len}, want {wb.len}")
    var i = 0
    while i < got.len {
        assert(got[i] == wb[i], "text byte {i} differs")
        i += 1
    }
}

fn cx_of(ed: edit.Ed) -> edit.CmdCtx {
    edit.cmdctx_new(ed.win, edit.SRC_KEY)
}

fn pos0(ed: edit.Ed) -> int {
    ed.wins[ed.win].cs.curs[0].pos
}

fn anchor0(ed: edit.Ed) -> int {
    ed.wins[ed.win].cs.curs[0].anchor
}

fn ok(status: int, what: str) {
    assert(status == edit.CMD_OK, "{what}: status {status}")
}

// `test_hmode_borrows_l_w_b_and_i_char_units`.
fn t_hmode_borrows_l_w_b_and_i_char_units() {
    var ed = h_editor("one two\nthree\n")
    var sources = List[int]()
    (mut sources).push(edit.MODE_L)
    (mut sources).push(edit.MODE_W)
    (mut sources).push(edit.MODE_B)
    (mut sources).push(edit.MODE_I)
    var units = List[int]()
    (mut units).push(edit.UNIT_LINE)
    (mut units).push(edit.UNIT_WORD)
    (mut units).push(edit.UNIT_BLOCK)
    (mut units).push(edit.UNIT_CHAR)
    var i = 0
    while i < sources.len {
        ok(edit.mode_enter(mut ed, sources[i]), "enter source")
        ok(edit.mode_enter(mut ed, edit.MODE_H), "enter H")
        assert(ed.mode == edit.MODE_H, "in H")
        let w = ed.win
        assert(ed.wins[w].h.from == sources[i], "from {sources[i]}")
        assert(ed.wins[w].h.unit == units[i], "unit {units[i]}")
        assert(ed.wins[w].h.kind == edit.SEL_CHAR, "character selection")
        assert(!ed.wins[w].h.sticky, "not sticky")
        i += 1
    }
}

// `test_hmode_sticky_entry_parses_unit_in_one_string_argument`.
fn t_hmode_sticky_entry_parses_unit_in_one_string_argument() {
    var ed = h_editor("text")
    var args = List[str]()
    (mut args).push("H L")
    (mut args).push("H W")
    (mut args).push("H B")
    (mut args).push("H C")
    var froms = List[int]()
    (mut froms).push(edit.MODE_L)
    (mut froms).push(edit.MODE_W)
    (mut froms).push(edit.MODE_B)
    (mut froms).push(edit.MODE_I)
    var units = List[int]()
    (mut units).push(edit.UNIT_LINE)
    (mut units).push(edit.UNIT_WORD)
    (mut units).push(edit.UNIT_BLOCK)
    (mut units).push(edit.UNIT_CHAR)
    var cx = cx_of(ed)
    cx.has_sarg = true
    var i = 0
    while i < args.len {
        cx.sarg = args[i]
        ok(edit.ec_mode_enter(mut ed, cx), "mode enter {args[i]}")
        let w = ed.win
        assert(ed.wins[w].h.from == froms[i], "{args[i]}: from")
        assert(ed.wins[w].h.unit == units[i], "{args[i]}: unit")
        assert(ed.wins[w].h.sticky, "{args[i]}: sticky")
        i += 1
    }
    cx.sarg = "H X"
    assert(edit.ec_mode_enter(mut ed, cx) == edit.CMD_ERR_ARG, "H X is an argument error")
}

// `test_hmode_char_motion_kind_prefix_swap_and_escape_preserve_contract`.
fn t_hmode_char_motion_kind_prefix_swap_and_escape_preserve_contract() {
    var ed = h_editor("abcdef")
    h_place(mut ed, 1, 1)
    var cx = cx_of(ed)
    cx.sarg = "H C"
    cx.has_sarg = true
    ok(edit.ec_mode_enter(mut ed, cx), "H C")
    ok(edit.ec_move_unit_next(mut ed, cx), "unit next")
    assert(pos0(ed) == 2 && anchor0(ed) == 1, "extended to 2 from 1")
    edit.ed_handle_key(mut ed, h_key('v' as int), 10)
    edit.ed_handle_key(mut ed, h_key('r' as int), 11)
    assert(ed.wins[ed.win].h.kind == edit.SEL_RECT, "v r: rectangular")
    ok(edit.ec_sel_swap_ends(mut ed, cx), "swap ends")
    assert(pos0(ed) == 1 && anchor0(ed) == 2, "ends swapped")
    let w = ed.win
    assert(text.cset_add(mut ed.wins[w].cs, text.Cursor { pos: 4, goal_col: 4, anchor: 4 }), "add 4")
    assert(text.cset_add(mut ed.wins[w].cs, text.Cursor { pos: 5, goal_col: 5, anchor: 5 }), "add 5")
    assert(ed.wins[w].cs.curs.len == 3, "three cursors")
    ok(edit.mode_escape(mut ed), "escape")
    assert(ed.mode == edit.MODE_L, "back in L")
    assert(ed.wins[w].cs.curs.len == 1, "one cursor")
    assert(anchor0(ed) == pos0(ed), "collapsed")
}

// `test_hmode_word_arrows_mirror_word_layer_and_keep_anchor`.
fn t_hmode_word_arrows_mirror_word_layer_and_keep_anchor() {
    var ed = h_editor("one two\nthree four")
    h_place(mut ed, 4, 4)
    ok(edit.mode_enter(mut ed, edit.MODE_W), "W")
    ok(edit.mode_enter(mut ed, edit.MODE_H), "H")
    edit.ed_handle_key(mut ed, h_key(term.KEY_DOWN), 10)
    let b = ed.wins[ed.win].buf
    assert(text.textbuf_line_of(ed.bufs[b].ec.tb, pos0(ed) as text.ByteOff) as int == 1, "down to line 1")
    assert(anchor0(ed) == 4, "anchor kept")
    edit.ed_handle_key(mut ed, h_key(term.KEY_LEFT), 11)
    assert(anchor0(ed) == 4, "anchor kept after left")
    assert(pos0(ed) == 8, "left lands on 8, at {pos0(ed)}")
}

// `test_hmode_modified_motions_keep_collapsed_and_selected_anchors`.
fn t_hmode_modified_motions_keep_collapsed_and_selected_anchors() {
    var ed = h_editor("camelCase word\n")
    h_place(mut ed, 0, 0)
    ok(edit.mode_enter(mut ed, edit.MODE_W), "W")
    ok(edit.mode_enter(mut ed, edit.MODE_H), "H")
    var cx = cx_of(ed)
    ok(edit.ec_move_word_sub_next(mut ed, cx), "sub next")
    assert(pos0(ed) > 0, "moved")
    assert(anchor0(ed) == 0, "anchor 0")
    ok(edit.ec_move_word_sub_prev(mut ed, cx), "sub prev")
    assert(anchor0(ed) == 0, "anchor still 0")

    ed = h_editor("abcdef\n")
    h_place(mut ed, 2, 2)
    ok(edit.mode_enter_highlight(mut ed, edit.MODE_I, false), "H over char")
    cx = cx_of(ed)
    ok(edit.ec_move_line_end(mut ed, cx), "line end")
    assert(pos0(ed) == 6 && anchor0(ed) == 2, "line end 6, anchor 2")
    ok(edit.ec_move_line_home(mut ed, cx), "line home")
    assert(pos0(ed) == 0 && anchor0(ed) == 2, "line home 0, anchor 2")

    ed = h_editor("(abc)")
    h_place(mut ed, 0, 0)
    ok(edit.mode_enter_highlight(mut ed, edit.MODE_B, false), "H over block")
    cx = cx_of(ed)
    ok(edit.ec_move_block_match_next(mut ed, cx), "match next")
    assert(pos0(ed) == 4 && anchor0(ed) == 0, "match 4, anchor 0")
}

// `test_hmode_lifts_lines_matches_and_ends`.
fn t_hmode_lifts_lines_matches_and_ends() {
    var ed = h_editor("aa\nb\nccc")
    h_place(mut ed, 6, 1)
    ok(edit.mode_enter(mut ed, edit.MODE_H), "H")
    var cx = cx_of(ed)
    ok(edit.ec_cursor_lift_lines(mut ed, cx), "lift lines")
    assert(ed.mode == edit.MODE_L, "L after the lift")
    let w = ed.win
    assert(ed.wins[w].cs.curs.len == 3, "three cursors")
    assert(ed.wins[w].cs.curs[0].pos == 1, "cursor 0 at 1")
    assert(ed.wins[w].cs.curs[1].pos == 4, "cursor 1 at 4")
    assert(ed.wins[w].cs.curs[2].pos == 6, "cursor 2 at 6")

    ed = h_editor("ab ab ab")
    h_place(mut ed, 8, 0)
    ok(edit.mode_enter(mut ed, edit.MODE_H), "H")
    cx = cx_of(ed)
    cx.sarg = "ab"
    cx.has_sarg = true
    ok(edit.ec_cursor_lift_matches(mut ed, cx), "lift matches")
    let w2 = ed.win
    assert(ed.wins[w2].cs.curs.len == 3, "three matches")
    assert(ed.wins[w2].cs.curs[0].pos == 0, "match 0")
    assert(ed.wins[w2].cs.curs[1].pos == 3, "match 3")
    assert(ed.wins[w2].cs.curs[2].pos == 6, "match 6")

    ed = h_editor("abcdef")
    h_place(mut ed, 4, 1)
    ok(edit.mode_enter(mut ed, edit.MODE_H), "H")
    cx = cx_of(ed)
    ok(edit.ec_cursor_lift_ends(mut ed, cx), "lift ends")
    let w3 = ed.win
    assert(ed.wins[w3].cs.curs.len == 2, "two ends")
    assert(ed.wins[w3].cs.curs[0].pos == 1, "end 1")
    assert(ed.wins[w3].cs.curs[1].pos == 4, "end 4")
}

// `test_hmode_lift_ends_preserves_nonzero_primary_active_end`.
fn t_hmode_lift_ends_preserves_nonzero_primary_active_end() {
    var ed = h_editor("0123456789")
    h_place(mut ed, 8, 6)
    ok(edit.mode_enter(mut ed, edit.MODE_H), "H")
    let w = ed.win
    assert(text.cset_add(mut ed.wins[w].cs, text.Cursor { pos: 3, goal_col: 3, anchor: 1 }), "add lower")
    assert(ed.wins[w].cs.primary == 1, "primary is the upper selection")
    let cx = cx_of(ed)
    ok(edit.ec_cursor_lift_ends(mut ed, cx), "lift ends")
    assert(ed.wins[w].cs.curs.len == 4, "four carets")
    assert(ed.wins[w].cs.primary == 3, "primary {ed.wins[w].cs.primary}, want 3")
    assert(ed.wins[w].cs.curs[ed.wins[w].cs.primary].pos == 8, "primary at its active end")
}

// `test_hmode_selection_kind_damages_secondary_selection_rows`.
fn t_hmode_selection_kind_damages_secondary_selection_rows() {
    var ed = h_editor("aa\nbb\ncc\ndd\nee\n")
    let w = ed.win
    ed.wins[w].rect = edit.rect(0, 0, 40, 5)
    ed.wins[w].vp.rows = 5
    ed.wins[w].vp.cols = 40
    h_place(mut ed, 2, 0)
    ok(edit.mode_enter(mut ed, edit.MODE_H), "H")
    assert(text.cset_add(mut ed.wins[w].cs, text.Cursor { pos: 14, goal_col: 0, anchor: 12 }), "add secondary")
    ed.full_damage = false
    ed.doc_damage_lo = ed.wins[w].rect.h
    ed.doc_damage_hi = 0
    var cx = cx_of(ed)
    cx.sarg = "l"
    cx.has_sarg = true
    ok(edit.ec_sel_kind(mut ed, cx), "sel kind l")
    assert(!ed.full_damage, "no full damage")
    assert(ed.doc_damage_lo == 0 && ed.doc_damage_hi == 5, "rows 0..5, got {ed.doc_damage_lo}..{ed.doc_damage_hi}")
}

// `test_hmode_keyboard_entry_is_reachable_from_each_source_mode`.
fn t_hmode_keyboard_entry_is_reachable_from_each_source_mode() {
    var ed = h_editor("one two\n")
    ok(edit.mode_enter(mut ed, edit.MODE_W), "W")
    edit.ed_handle_key(mut ed, h_key('h' as int), 10)
    assert(ed.mode == edit.MODE_H, "h from W enters H")
    assert(ed.wins[ed.win].h.from == edit.MODE_W, "from W")
    ok(edit.mode_escape(mut ed), "escape")
    ok(edit.mode_enter(mut ed, edit.MODE_B), "B")
    edit.ed_handle_key(mut ed, h_key('h' as int), 11)
    assert(ed.mode == edit.MODE_H, "h from B enters H")
    assert(ed.wins[ed.win].h.from == edit.MODE_B, "from B")
    ok(edit.mode_escape(mut ed), "escape")
    ok(edit.mode_enter(mut ed, edit.MODE_I), "I")
    edit.ed_handle_key(mut ed, h_mod_key('h' as int, term.MOD_ALT), 12)
    assert(ed.mode == edit.MODE_H, "M-h from I enters H")
    assert(ed.wins[ed.win].h.from == edit.MODE_I, "from I")
    assert(ed.wins[ed.win].h.unit == edit.UNIT_CHAR, "by character")
}

// `test_hmode_replace_captures_exactly_one_text_key_and_escape_cancels`.
fn t_hmode_replace_captures_exactly_one_text_key_and_escape_cancels() {
    var ed = h_editor("abc")
    h_place(mut ed, 2, 1)
    ok(edit.mode_enter_highlight(mut ed, edit.MODE_I, false), "H over char")
    edit.ed_handle_key(mut ed, h_key('r' as int), 10)
    assert(ed.capture_cmd != 0, "r captures")
    assert(ed.dispatch_count == 0, "nothing dispatched yet")
    h_assert_text(ed, "abc")
    edit.ed_handle_key(mut ed, h_key('Z' as int), 11)
    assert(ed.capture_cmd == 0, "capture done")
    assert(ed.dispatch_count == 1, "one dispatch")
    assert(ed.last_status == edit.CMD_OK, "replaced")
    assert(ed.mode == edit.MODE_L, "back in L")
    h_assert_text(ed, "aZc")

    h_place(mut ed, 2, 1)
    ok(edit.mode_enter_highlight(mut ed, edit.MODE_I, false), "H again")
    edit.ed_handle_key(mut ed, h_key('r' as int), 12)
    assert(ed.capture_cmd != 0, "r captures again")
    edit.ed_handle_key(mut ed, h_key(term.KEY_ESCAPE), 13)
    assert(ed.capture_cmd == 0, "escape cancels the capture")
    assert(ed.mode == edit.MODE_H, "still H")
    assert(ed.dispatch_count == 1, "no second dispatch")
    h_assert_text(ed, "aZc")
}

// `test_hmode_keyboard_extension_damages_only_old_new_selection_union`.
fn t_hmode_keyboard_extension_damages_only_old_new_selection_union() {
    var ed = h_editor("zero\none\ntwo\nthree\nfour\nfive\nsix\nseven\n")
    let w = ed.win
    ed.wins[w].rect = edit.rect(0, 0, 40, 8)
    ed.wins[w].vp.rows = 8
    ed.wins[w].vp.cols = 40
    h_place(mut ed, 9, 9)
    ok(edit.mode_enter(mut ed, edit.MODE_L), "L")
    ok(edit.mode_enter(mut ed, edit.MODE_H), "H")
    ed.full_damage = false
    ed.doc_damage_lo = ed.wins[w].rect.h
    ed.doc_damage_hi = 0
    let dispatched = ed.dispatch_count
    edit.ed_handle_key(mut ed, h_key(term.KEY_DOWN), 20)
    assert(ed.dispatch_count == dispatched + 1, "one dispatch")
    assert(ed.last_status == edit.CMD_OK, "down ok")
    assert(!ed.full_damage, "no full damage")
    assert(ed.doc_damage_lo == 2 && ed.doc_damage_hi == 4, "rows 2..4, got {ed.doc_damage_lo}..{ed.doc_damage_hi}")
    edit.ed_handle_key(mut ed, h_key(term.KEY_DOWN), 21)
    assert(ed.dispatch_count == dispatched + 2, "two dispatches")
    assert(ed.last_status == edit.CMD_OK, "down ok")
    assert(!ed.full_damage, "no full damage")
    assert(ed.doc_damage_lo == 2 && ed.doc_damage_hi == 5, "rows 2..5, got {ed.doc_damage_lo}..{ed.doc_damage_hi}")
    assert(ed.doc_damage_hi < ed.wins[w].rect.h, "short of the window")
}

// `test_hmode_shift_arrows_start_character_selection_from_every_edit_mode`.
fn t_hmode_shift_arrows_start_character_selection_from_every_edit_mode() {
    var sources = List[int]()
    (mut sources).push(edit.MODE_L)
    (mut sources).push(edit.MODE_W)
    (mut sources).push(edit.MODE_B)
    (mut sources).push(edit.MODE_I)
    for source in sources {
        var ed = h_editor("a\u{E9}\u{754C}\n")
        h_place(mut ed, 1, 1)
        ok(edit.mode_enter(mut ed, source), "enter {source}")
        edit.ed_handle_key(mut ed, h_mod_key(term.KEY_RIGHT, term.MOD_SHIFT), 10)
        let w = ed.win
        let p = ed.wins[w].cs.primary
        assert(ed.mode == edit.MODE_H, "{source}: S-right enters H")
        assert(ed.wins[w].h.from == edit.MODE_I, "{source}: from I")
        assert(ed.wins[w].h.unit == edit.UNIT_CHAR, "{source}: by character")
        assert(ed.wins[w].h.kind == edit.SEL_CHAR, "{source}: character selection")
        assert(ed.wins[w].cs.curs[p].anchor == 1 && ed.wins[w].cs.curs[p].pos == 3, "{source}: 1..3")
        edit.ed_handle_key(mut ed, h_mod_key(term.KEY_RIGHT, term.MOD_SHIFT), 11)
        let p2 = ed.wins[w].cs.primary
        assert(ed.wins[w].cs.curs[p2].anchor == 1 && ed.wins[w].cs.curs[p2].pos == 6, "{source}: 1..6")
        edit.ed_handle_key(mut ed, h_mod_key(term.KEY_LEFT, term.MOD_SHIFT), 12)
        let p3 = ed.wins[w].cs.primary
        assert(ed.wins[w].cs.curs[p3].anchor == 1 && ed.wins[w].cs.curs[p3].pos == 3, "{source}: back to 1..3")
    }
}

// `test_hmode_shift_vertical_keeps_anchor_and_goal_column`.
fn t_hmode_shift_vertical_keeps_anchor_and_goal_column() {
    var ed = h_editor("abcd\nx\nwxyz\n")
    h_place(mut ed, 3, 3)
    ok(edit.mode_enter(mut ed, edit.MODE_L), "L")
    edit.ed_handle_key(mut ed, h_mod_key(term.KEY_DOWN, term.MOD_SHIFT), 10)
    let w = ed.win
    let p = ed.wins[w].cs.primary
    assert(ed.mode == edit.MODE_H, "S-down enters H")
    assert(ed.wins[w].cs.curs[p].anchor == 3, "anchor 3")
    assert(ed.wins[w].cs.curs[p].pos == 6, "pos 6, at {ed.wins[w].cs.curs[p].pos}")
    assert(ed.wins[w].cs.curs[p].goal_col == 3, "goal 3, at {ed.wins[w].cs.curs[p].goal_col}")
    edit.ed_handle_key(mut ed, h_mod_key(term.KEY_DOWN, term.MOD_SHIFT), 11)
    let p2 = ed.wins[w].cs.primary
    assert(ed.wins[w].cs.curs[p2].anchor == 3 && ed.wins[w].cs.curs[p2].pos == 10, "down again: 10")
    assert(ed.wins[w].cs.curs[p2].goal_col == 3, "goal still 3")
    edit.ed_handle_key(mut ed, h_mod_key(term.KEY_UP, term.MOD_SHIFT), 12)
    let p3 = ed.wins[w].cs.primary
    assert(ed.wins[w].cs.curs[p3].anchor == 3 && ed.wins[w].cs.curs[p3].pos == 6, "up: 6")
    assert(ed.wins[w].cs.curs[p3].goal_col == 3, "goal 3 after up")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_hmode_borrows_l_w_b_and_i_char_units()
    t_hmode_sticky_entry_parses_unit_in_one_string_argument()
    t_hmode_char_motion_kind_prefix_swap_and_escape_preserve_contract()
    t_hmode_word_arrows_mirror_word_layer_and_keep_anchor()
    t_hmode_modified_motions_keep_collapsed_and_selected_anchors()
    t_hmode_lifts_lines_matches_and_ends()
    t_hmode_lift_ends_preserves_nonzero_primary_active_end()
    t_hmode_selection_kind_damages_secondary_selection_rows()
    t_hmode_keyboard_entry_is_reachable_from_each_source_mode()
    t_hmode_replace_captures_exactly_one_text_key_and_escape_cancels()
    t_hmode_keyboard_extension_damages_only_old_new_selection_union()
    t_hmode_shift_arrows_start_character_selection_from_every_edit_mode()
    t_hmode_shift_vertical_keeps_anchor_and_goal_column()
    print("hmode_test: 13 cases pass")
}
