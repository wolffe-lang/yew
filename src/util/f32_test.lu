//! `util.f32`'s proof (no sagitta test: the unit is the port's, the
//! checked machine having no `f32`). Two oracles: C's own answers at the
//! spans where single and double precision disagree
//! (`notes/yw05-evidence/panes/float-ratio.txt`, gcc in the lane's
//! container), and wolf's `f32` on the native tier over a grid and a
//! random sample. This file uses `f32`, so the checked lane runs it
//! natively (G29, `[native]`); every other test keeps the checked machine.

// `2^k` exactly, as an f32 (wolf 0.2.34 casts no float to the other
// width, so the comparison stays in f32).
fn pow2(k: int) -> f32 {
    var v: f32 = 1.0
    var i = 0
    if k >= 0 {
        while i < k {
            v = v * 2.0
            i += 1
        }
    } else {
        while i < 0 - k {
            v = v / 2.0
            i += 1
        }
    }
    v
}

// The value of binary32 bits `r` (normal, positive), exactly, as an f32.
fn value_of(r: int) -> f32 {
    if r == 0 {
        return 0.0
    }
    let biased = r >> 23 & 255
    let mant = r & 8388607 | 8388608
    let m: f32 = mant as f32
    m * pow2(biased - 127 - 23)
}

// wolf's f32: `(float)a / (float)b`.
fn wolf_div(a: int, b: int) -> f32 {
    let af: f32 = a as f32
    let bf: f32 = b as f32
    af / bf
}

// wolf's f32: `(i32)((float)u * ((float)a / (float)b) + 0.5f)`.
fn wolf_cells(u: int, a: int, b: int) -> int {
    let uf: f32 = u as f32
    let af: f32 = a as f32
    let bf: f32 = b as f32
    let r: f32 = af / bf
    (uf * r + 0.5) as int
}

fn t_f32_half_is_c_half() {
    let half: f32 = 0.5
    assert(value_of(F32_HALF) == half, "0.5f")
    assert(f32_div_bits(1, 2) == F32_HALF, "1/2 is 0.5f")
    assert(f32_div_bits(7, 14) == F32_HALF, "7/14 is 0.5f")
    assert(f32_scale_round_bits(9, F32_HALF) == 5, "(int)(9 * 0.5f + 0.5f) is 5")
    assert(f32_scale_round_bits(0, F32_HALF) == 0, "a zero span")
}

// C's answers where float and double part (the panes fork's search,
// gcc): ratio = (float)want / (float)u1, cells = (i32)((float)usable *
// ratio + 0.5f); the double answer beside each is the one a port in f64
// would give.
fn t_f32_c_rows() {
    let rows = [
        [28, 15, 238, 127, 128],
        [34, 13, 153, 59, 58],
        [36, 21, 54, 31, 32],
        [36, 23, 90, 58, 57],
        [38, 21, 57, 31, 32],
        [40, 13, 180, 58, 59],
        [40, 14, 90, 32, 31],
        [40, 21, 60, 31, 32],
        [40, 23, 100, 58, 57],
        [40, 26, 90, 58, 59],
        [40, 28, 45, 32, 31],
        [44, 13, 154, 45, 46],
    ]
    for row in rows {
        let r = f32_div_bits(row[1], row[0])
        let got = f32_scale_round_bits(row[2], r)
        assert(
            got == row[3],
            "u1={row[0]} want={row[1]} usable={row[2]}: C's float says {row[3]}, got {got}",
        )
        assert(got != row[4], "the row parts from double precision")
    }
}

// Every ratio a resize can store below 300 cells, at forty spans each,
// against wolf's own f32.
fn t_f32_grid_matches_wolf_f32() {
    let spans = [
        1,
        2,
        3,
        7,
        12,
        13,
        25,
        31,
        45,
        54,
        57,
        60,
        79,
        80,
        90,
        100,
        119,
        120,
        153,
        154,
        159,
        180,
        199,
        200,
        238,
        239,
        255,
        256,
        319,
        320,
        399,
        511,
        512,
        639,
        1000,
        1023,
        1919,
        2047,
        4096,
        9999,
    ]
    var n = 0
    var b = 1
    while b < 300 {
        var a = 0
        while a <= b {
            let r = f32_div_bits(a, b)
            assert(value_of(r) == wolf_div(a, b), "{a}/{b}: bits {r}")
            for u in spans {
                let want = wolf_cells(u, a, b)
                let got = f32_scale_round_bits(u, r)
                assert(got == want, "u={u} a={a} b={b}: wolf f32 {want}, got {got}")
                n += 1
            }
            a += 1
        }
        b += 1
    }
    assert(n > 1000000, "the grid ran ({n})")
}

// A 31-bit linear congruential draw (no shift or product overflows).
fn lcg(x: int) -> int {
    (x * 1103515245 + 12345) % 2147483648
}

// A random sample over the whole operand range (below 2^24).
fn t_f32_random_matches_wolf_f32() {
    var x = 20261022
    var i = 0
    while i < 200000 {
        x = lcg(x)
        let b = 1 + (x >> 7) % 16777215
        x = lcg(x)
        let a = (x >> 7) % (b + 1)
        x = lcg(x)
        let u = (x >> 7) % 16777216
        let r = f32_div_bits(a, b)
        assert(value_of(r) == wolf_div(a, b), "{a}/{b}")
        assert(f32_scale_round_bits(u, r) == wolf_cells(u, a, b), "u={u} a={a} b={b}")
        i += 1
    }
}

fn main() {
    t_f32_half_is_c_half()
    t_f32_c_rows()
    t_f32_grid_matches_wolf_f32()
    t_f32_random_matches_wolf_f32()
    print("f32_test: 4 cases pass")
}
