//! member: false
//!
//! The port of sagitta `tests/unit/test_log.c` (117 lines): `test_log_
//! capture`, `test_log_levels`, `test_log_bug_prehook`. C captures through
//! a test sink installed by `yew_test_capture_log`; the port has no module
//! state, so the sink is `YEW_LOG` pointing at a scratch file read back.
//! C's third test installs a prehook writing `prehook\n` before the
//! report; the port's `bug` has no prehook (the terminal is restored by
//! the guard sibling when the editor dies, `term.tty`, ruling #93 R1), so
//! the port's test pins what remains: exit 4 and the report's first line.

use std.fs
use std.process
use util

const LOG_PATH: str = "target/tests/util-log-test.log"

fn reset_log() {
    fs.remove(LOG_PATH) else |_| {}
    env_set("YEW_LOG", LOG_PATH) else |_| {}
}

fn log_lines() -> List[str] {
    let text = fs.read_text(LOG_PATH) else ""
    var out = List[str]()
    for line in text.lines() {
        if line.len != 0 {
            (mut out).push(line)
        }
    }
    out
}

fn contains(lines: List[str], level: str, text: str) -> bool {
    for line in lines {
        if line.contains(" {level}: ") && line.contains(text) {
            return true
        }
    }
    false
}

fn t_log_capture() {
    reset_log()
    env_set("YEW_LOG_LEVEL", "debug") else |_| {}
    util.log_at(util.LOG_DEBUG, "debug number 1")
    util.log_at(util.LOG_INFO, "info number 2")
    util.log_at(util.LOG_WARN, "warn number 3")
    util.log_at(util.LOG_ERROR, "error number 4")
    let lines = log_lines()
    assert(lines.len == 4, "four lines, got {lines.len}")
    assert(contains(lines, "debug", "number 1"), "debug line")
    assert(contains(lines, "info", "info number"), "info line")
    assert(contains(lines, "warn", "number 3"), "warn line")
    assert(contains(lines, "error", "error number 4"), "error line")
    assert(!contains(lines, "info", "number 4"), "the level is the line's own")
}

fn t_log_levels() {
    reset_log()
    env_set("YEW_LOG_LEVEL", "error") else |_| {}
    util.log_at(util.LOG_INFO, "filtered info")
    util.log_at(util.LOG_ERROR, "visible error")
    let lines = log_lines()
    assert(lines.len == 1, "one line, got {lines.len}")
    assert(contains(lines, "error", "visible"), "the error is logged")
    assert(!contains(lines, "info", "filtered"), "the info is dropped")
}

fn t_log_bug_report() {
    let exe = os_exe() else {
        print("log_test: SKIP bug report: no os_exe()")
        return
    }
    if !self_reexecutes(exe) {
        print(
            "log_test: SKIP the bug report scenario: os_exe() does not re-run this test here (the checked machine)",
        )
        eprint(
            "log_test: SKIP the bug report scenario: os_exe() does not re-run this test here (the checked machine)",
        )
        return
    }
    let err_path = "target/tests/util-log-test.err"
    fs.remove(err_path) else |_| {}
    var c = process.command(exe)
    process.push_arg(mut c, "--bug")
    let sink = fs.create_with_mode(err_path, 0o600) else |_| {
        assert(false, "open the stderr capture")
        return
    }
    process.set_stderr(mut c, sink)
    let child = process.start(c) else |_| {
        assert(false, "spawn the child")
        return
    }
    let status = process.wait_status(take child) else -1
    fs.close(take sink) else |_| {}
    assert(status == util.EXIT_BUG, "the bug exits {util.EXIT_BUG}, got {status}")
    let err = fs.read_text(err_path) else ""
    let report = "yew: internal error at prehook-test: ordered"
    assert(err.starts_with(report), "stderr begins with the report, got {err}")
}

fn self_reexecutes(exe: str) -> bool {
    var c = process.command(exe)
    process.push_arg(mut c, "--self-check")
    let sink = fs.open_append("/dev/null") else |_| {
        return false
    }
    process.set_stderr(mut c, sink)
    process.set_stdout(mut c, sink)
    let child = process.start(c) else |_| {
        return false
    }
    let status = process.wait_status(take child) else -1
    fs.close(take sink) else |_| {}
    status == 7
}

fn main() {
    fs.create_dir_all("target/tests") else |_| {}
    let args = env_args()
    if args.len == 1 && args[0] == "--self-check" {
        os_exit(7)
    }
    if args.len == 1 && args[0] == "--bug" {
        env_set("YEW_LOG", "/dev/null") else |_| {}
        util.bug("prehook-test", "ordered")
    }
    t_log_capture()
    t_log_levels()
    t_log_bug_report()
    print("log_test: 3 cases pass")
}
