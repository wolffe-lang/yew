//! util.strmap — a string-keyed map that iterates in INSERTION order.
//!
//! Ports sagitta `src/util/strmap.c` (214 lines) and `strmap.h` at
//! 9ace98c2. The C design (`s00-repo-and-foundations.md` §7): entries
//! live in an append-only array, a hash table stores indices into it,
//! and iteration walks the array — so no hash order ever reaches an
//! output (deterministic rendering, invariant 5; workspace
//! serialization; Fletch's insertion-ordered maps). A put on an existing
//! key replaces the value and keeps the original slot order
//! (`strmap.c:74-82`). There is no delete (`s00` §7: the sprint that
//! needs it adds tombstones without disturbing the order).
//!
//! In wolf the append-only array is two `List`s (`keys`, `vals`) and the
//! slot table is a `Map[str, int]` from key to array index. wolf's `Map`
//! answers insertion order on both machines (`std.map`'s header) but
//! promises only that `keys`, `values` and `pairs` agree — so the port
//! keeps sagitta's explicit array rather than lean on a promise the
//! library does not make. FNV-1a (`strmap.c:12-22`) is the host map's
//! business here; the port carries no hash.
//!
//! `strmap_resident_bytes` and `strmap_insert_cost` (`strmap.c:136-173`,
//! `memacct.h`) have no port: wolf has no per-structure resident-byte
//! model, only a region's ledger (`region_bytes`). Their consumer is the
//! symbol index's resident-memory cap (sagitta Sprint 57.33, yw11), and
//! the gap is listed in docs/MAP.md.

/// A string-keyed map in insertion order. `keys[i]` and `vals[i]` are
/// the i-th entry put; `index` maps a key to its `i`.
pub struct Strmap[V] {
    keys: List[str],
    vals: List[V],
    index: Map[str, int],
}

/// An empty map (`strmap_init`).
pub fn strmap_new[V]() -> Strmap[V] {
    Strmap { keys: List[str](), vals: List[V](), index: Map[str, int]() }
}

/// Puts `value` under `key`. A new key is appended and the row is
/// `none` (C: NULL); an existing key keeps its slot, takes the new
/// value, and the previous value is answered (`strmap.c:66-109`).
pub fn strmap_put[V](mut m: Strmap[V], key: str, value: V) -> V ! {none} {
    let at = m.index[key] else {
        (mut m.keys).push(copy key)
        (mut m.vals).push(value)
        m.index[copy key] = m.keys.len - 1
        return none
    }
    let previous = m.vals[at]
    m.vals[at] = value
    previous
}

/// The value under `key`, or `none` (C: NULL) (`strmap.c:111-119`).
pub fn strmap_get[V](m: Strmap[V], key: str) -> V ! {none} {
    let at = m.index[key]?
    copy m.vals[at]
}

/// Whether `key` is present (`strmap.c:121-126`).
pub fn strmap_has[V](m: Strmap[V], key: str) -> bool {
    m.index.has(key)
}

/// The number of entries (`strmap.c:175-178`).
pub fn strmap_len[V](m: Strmap[V]) -> int {
    m.keys.len
}

/// The i-th key in put order, for `0 <= i < strmap_len(m)`: the
/// iterator (`StrmapIter`, `strmap.c:192-214`) is an index here, and a
/// caller walks `0..strmap_len(m)`.
pub fn strmap_key_at[V](m: Strmap[V], i: int) -> str {
    m.keys[i]
}

/// The i-th value in put order. A `read` parameter is lent, never
/// given ([mem.tier0.mode.read], wolf-lang#366), so a getter answers a
/// `copy`: C handed out the `void *` itself.
pub fn strmap_value_at[V](m: Strmap[V], i: int) -> V {
    copy m.vals[i]
}
