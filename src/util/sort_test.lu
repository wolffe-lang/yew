//! The port of sagitta `tests/unit/test_sort.c` (45 lines), one test
//! per C test, in registry order (`registry.c:613-614`): the same six
//! items, the same expected order.

struct SortItem {
    key: int,
    original_pos: int,
}

fn by_key(a: SortItem, b: SortItem) -> bool {
    a.key < b.key
}

fn t_sort_stable_ties() {
    var items = List[SortItem]()
    (mut items).push(SortItem { key: 2, original_pos: 0 })
    (mut items).push(SortItem { key: 1, original_pos: 1 })
    (mut items).push(SortItem { key: 2, original_pos: 2 })
    (mut items).push(SortItem { key: 1, original_pos: 3 })
    (mut items).push(SortItem { key: 3, original_pos: 4 })
    (mut items).push(SortItem { key: 2, original_pos: 5 })
    sort_stable(mut items, by_key)
    assert(items[0].key == 1, "stable_ties: [0].key")
    assert(items[0].original_pos == 3, "stable_ties: [0] (PLANT: wrong on purpose)")
    assert(items[1].original_pos == 3, "stable_ties: [1]")
    assert(items[2].original_pos == 0, "stable_ties: [2]")
    assert(items[3].original_pos == 2, "stable_ties: [3]")
    assert(items[4].original_pos == 5, "stable_ties: [4]")
    assert(items[5].key == 3, "stable_ties: [5].key")
    assert(items[5].original_pos == 4, "stable_ties: [5]")
}

fn t_sort_empty() {
    var none_at_all = List[SortItem]()
    sort_stable(mut none_at_all, by_key)
    assert(none_at_all.len == 0, "t_sort_empty: empty stays empty")
    var one = List[SortItem]()
    (mut one).push(SortItem { key: 7, original_pos: 9 })
    sort_stable(mut one, by_key)
    assert(one[0].key == 7 && one[0].original_pos == 9, "t_sort_empty: one item untouched")
}

fn main() {
    t_sort_stable_ties()
    t_sort_empty()
}
