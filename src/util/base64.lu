//! util.base64 — RFC 4648 base64 encoding, for the OSC 52 clipboard.
//!
//! Ports sagitta `src/util/base64.c` (51 lines) and `base64.h` (9) at
//! 9ace98c2. No decoder: yew never decodes a clipboard reply (an
//! unsolicited OSC 52 reply is quarantined by the input decoder). The
//! encoder answers a fresh `List[byte]` where C writes into a
//! caller-sized buffer.

const ALPHABET: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

/// The encoded length of `n` input bytes (`yew_base64_len`): four per
/// three, padded.
pub fn base64_len(n: int) -> int {
    let groups = n / 3
    groups * 4 + (if n % 3 != 0 then 4 else 0)
}

fn sym(index: int) -> byte {
    ALPHABET.bytes()[index]
}

/// Encode `input[at..end]` (`yew_base64_encode`).
pub fn base64_encode(input: List[byte], at: int, end: int) -> List[byte] {
    var out = List[byte]()
    var src = at
    while end - src >= 3 {
        let bits = input[src] as int << 16 | input[src + 1] as int << 8 | input[src + 2] as int
        (mut out).push(sym(bits >> 18 & 63))
        (mut out).push(sym(bits >> 12 & 63))
        (mut out).push(sym(bits >> 6 & 63))
        (mut out).push(sym(bits & 63))
        src += 3
    }
    if end - src == 1 {
        let bits = input[src] as int << 16
        (mut out).push(sym(bits >> 18 & 63))
        (mut out).push(sym(bits >> 12 & 63))
        (mut out).push(61 as byte)
        (mut out).push(61 as byte)
    } else if end - src == 2 {
        let bits = input[src] as int << 16 | input[src + 1] as int << 8
        (mut out).push(sym(bits >> 18 & 63))
        (mut out).push(sym(bits >> 12 & 63))
        (mut out).push(sym(bits >> 6 & 63))
        (mut out).push(61 as byte)
    }
    out
}
