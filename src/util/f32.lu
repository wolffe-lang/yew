//! util.f32 — C's single-precision arithmetic for the pane ratio, in
//! integers.
//!
//! sagitta keeps a split's ratio as a C `float` (`layout.h:62`) and rounds
//! in single precision at two sites: `split_cells` (`layout.c:116-136`,
//! `(i32)((float)usable * ratio + 0.5f)`) and `yew_pane_resize`
//! (`layout.c:582-609`, `(float)want / (float)usable`). Rounding there in
//! double precision moves a border by a cell at some spans
//! (`notes/yw05-evidence/panes/float-ratio.txt`), so the port must round
//! as `float` does. wolf's `f32` does, natively — but the checked machine
//! refuses `f32` ("f64 is the supported float"), and every editor case
//! lays out a tree, so an `f32` ratio would take every editor test off the
//! checked machine. The ratio is therefore held as C's float BITS (IEEE
//! 754 binary32, in an `int`) and the two operations are computed exactly
//! in integers: each result is the infinitely precise value rounded once
//! to 24 significant bits, nearest, ties to even — what IEEE 754 asks of
//! `float` division, multiplication and addition. The operands are the
//! layout's: non-negative cell counts below 2^24 (exact in a `float`) and
//! ratios in [0, 1]. `f32_test` checks both against wolf's own `f32`
//! natively and against C's answers.

/// `0.5f`'s bits: every new split's ratio (`layout.c:69`, `yew_pane_split`).
pub const F32_HALF: int = 1056964608

fn bitlen(v: int) -> int {
    var n = 0
    var x = v
    while x > 0 {
        x = x >> 1
        n += 1
    }
    n
}

// `m * 2^e` (m > 0) rounded to 24 significant bits, nearest, ties to
// even: answers (mant, exp) with the same value convention, mant below
// 2^24 (exact when m already fits).
fn round24(m: int, e: int) -> (int, int) {
    let k = bitlen(m) - 24
    if k <= 0 {
        return (m, e)
    }
    let q = m >> k
    let rem = m - (q << k)
    let half = 1 << k - 1
    var r = q
    if rem > half || rem == half && q & 1 == 1 {
        r = q + 1
    }
    if r == 1 << 24 {
        return (r >> 1, e + k + 1)
    }
    (r, e + k)
}

// The binary32 bits of `mant * 2^exp` (mant > 0, below 2^24, the value
// in the normal range: the layout's ratios are at least 2^-24).
fn pack(mant: int, exp: int) -> int {
    var m = mant
    var e = exp
    while m < 1 << 23 {
        m = m << 1
        e -= 1
    }
    let biased = e + 23 + 127
    biased << 23 | m - (1 << 23)
}

/// `(float)a / (float)b` as binary32 bits, for 0 <= a and 0 < b, both
/// below 2^24 (`yew_pane_resize`'s `(float)want / (float)usable`).
pub fn f32_div_bits(a: int, b: int) -> int {
    if a <= 0 || b <= 0 {
        return 0
    }
    // Enough quotient bits (25 or more) that a sticky bit below them
    // decides every rounding exactly.
    let s = 25 + bitlen(b) - bitlen(a)
    let num = a << s
    let q = num / b
    let rem = num - q * b
    let sticky = if rem != 0 then 1 else 0
    let (m, e) = round24(q * 2 + sticky, 0 - s - 1)
    pack(m, e)
}

/// `(i32)((float)u * r + 0.5f)` for `r`'s binary32 bits and 0 <= u below
/// 2^24 (`split_cells`): the product rounded to a float, the sum rounded
/// to a float, then truncated toward zero.
pub fn f32_scale_round_bits(u: int, r: int) -> int {
    if u <= 0 || r <= 0 {
        return 0
    }
    let biased = r >> 23 & 255
    let mant = r & 8388607 | 8388608
    // The product, exact (below 2^48), then once to a float.
    let (pm, pe) = round24(u * mant, biased - 127 - 23)
    // + 0.5f (= 1 * 2^-1), exact at the smaller exponent, then once to a
    // float.
    let t0 = if pe < -1 then pe else -1
    let sum = (pm << pe - t0) + (1 << -1 - t0)
    let (sm, se) = round24(sum, t0)
    if se >= 0 {
        return sm << se
    }
    sm >> 0 - se
}
