//! util.rss — the opt-in resident-memory checkpoints: sagitta
//! `src/util/rss.c` (113 lines) and `rss.h` at 9ace98c2, Linux's half.
//! MAP §2 gives `rss` to yw15 with the profiler; yw06 pulls it forward
//! because its contract records `mem.workspace50` (`budgets.txt:62`),
//! which sagitta's `perf_mem` reads from nothing but the editor's own
//! `rss checkpoint=paint current_bytes=N peak_bytes=N` log line
//! (`perf_mem.c:188-296`), so no external RSS stands in for it.
//!
//! `rss_bytes` is `yew_rss_bytes` (`rss.c:63-100`): the precise rollup
//! (`/proc/self/smaps_rollup`'s `Rss:`), else — where C reads
//! `/proc/self/statm`'s pages times `sysconf(_SC_PAGESIZE)`, which wolf
//! cannot ask — `/proc/self/status`'s `VmRSS`, the same resident count in
//! kB. `rss_peak_bytes` is `yew_rss_peak_bytes` (`rss.c:44-61`): C's
//! `getrusage(RUSAGE_SELF).ru_maxrss` has no wolf surface, so the port
//! reads the same high-water mark the kernel keeps as `VmHWM` (kB). Off
//! Linux both answer 0 (C's macOS `ru_maxrss` is G12's: no resident-byte
//! surface), and a checkpoint with a zero is not written — `perf_mem`
//! rejects a zero as malformed, so the row reads UNSUPPORTED instead.

// One `/proc` file whole: procfs reports size 0, so it is read in chunks
// to the end, never by its stat.
fn proc_text(path: str) -> str {
    let fd = fs_open(path) else {
        return ""
    }
    var all = List[byte]()
    loop {
        let chunk = fs_read_chunk(fd, 4096) else |_| {
            break
        }
        for b in chunk {
            (mut all).push(b)
        }
    }
    fs_close(fd) else |_| {}
    str_from_utf8(all) else ""
}

// The number before ` kB` on the line that starts with `key`, in bytes;
// 0 when absent.
fn kib_field(text: str, key: str) -> int {
    for line in text.lines() {
        if !line.starts_with(key) {
            continue
        }
        for w in line[key.len..].words() {
            let n = w.to_int() else {
                return 0
            }
            return n * 1024
        }
    }
    0
}

/// `yew_rss_bytes` (`rss.c:63-100`): the current resident bytes, 0 when
/// the host cannot say.
pub fn rss_bytes() -> int {
    let precise = kib_field(proc_text("/proc/self/smaps_rollup"), "Rss:")
    if precise != 0 {
        return precise
    }
    kib_field(proc_text("/proc/self/status"), "VmRSS:")
}

/// `yew_rss_peak_bytes` (`rss.c:44-61`): the resident high-water mark.
pub fn rss_peak_bytes() -> int {
    kib_field(proc_text("/proc/self/status"), "VmHWM:")
}

/// `yew_rss_checkpoint` (`rss.c:102-113`): under `YEW_PROF=1`, one INFO
/// log line naming the checkpoint with the current and peak bytes.
pub fn rss_checkpoint(name: str) {
    if name.len == 0 || (env_get("YEW_PROF") else "") != "1" {
        return
    }
    let current = rss_bytes()
    let peak = rss_peak_bytes()
    if current == 0 || peak == 0 {
        return
    }
    log_at(LOG_INFO, "rss checkpoint={name} current_bytes={current} peak_bytes={peak}")
}
