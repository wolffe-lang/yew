//! The port of sagitta `tests/unit/test_arena.c` (72 lines), one test
//! per C test, in registry order (`tests/unit/registry.c:600-602`).
//!
//! An `Arena` has no type in wolf: regions are the allocator
//! (`region name { }` makes one that dies at `}`), so each C test ports
//! as the region behaviour it stood for. Alignment (`t_arena_align`)
//! is the runtime's and not observable from wolf; what the test can
//! witness is that a region's allocations die wholesale at its end
//! (`arena_free_all`) and that a copied string is its own value
//! (`t_arena_strdup`). `t_arena_alloc_cost_predicts_resident_growth` ports
//! as the ledger relation `region_bytes` keeps: growing, never shrinking,
//! inside a region (its units are per tier, so only relations are
//! asserted — AN_AGENTS_GUIDE §Memory).

fn t_arena_align() {
    // C: a 1-byte allocation then an alignas(16) struct lands 16-aligned,
    // and arena_free_all leaves no block. Here: a region's bytes are
    // charged while it lives and the values it held are gone at `}`.
    var inside = 0
    region arena {
        var xs = List[int]()
        (mut xs).push(1)
        inside = region_bytes(arena)
    }
    assert(inside > 0, "t_arena_align: a region charges its allocations")
}

fn t_arena_strdup() {
    // C: t_arena_strdup and arena_strndup answer copies, not the source.
    let source = "arena-owned"
    let whole = copy source
    let prefix = "prefix-tail"[0..6]
    assert(whole == "arena-owned", "t_arena_strdup: whole")
    assert(prefix == "prefix", "t_arena_strdup: strndup prefix")
    assert(whole != prefix, "t_arena_strdup: distinct values")
}

fn t_arena_alloc_cost_predicts_resident_growth() {
    // C: 4000 allocations of varying size and alignment; the predicted
    // cost equals the measured growth each time. Here: the ledger never
    // decreases across 4000 pushes and a 3 MiB allocation grows it.
    region arena {
        var xs = List[int]()
        var before = region_bytes(arena)
        var i = 0
        while i < 4000 {
            (mut xs).push(i * 37 % 900)
            let now = region_bytes(arena)
            assert(now >= before, "arena_alloc_cost: the ledger never shrinks")
            before = now
            i += 1
        }
        // C allocates 3 MiB in one call to prove a block larger than the
        // next block size gets its own; a wolf test runs under a step
        // budget, so 64 KiB of pushes stands for it: the ledger grows by
        // at least what was pushed.
        var big = List[byte]()
        var k = 0
        while k < 64 * 1024 {
            (mut big).push(0 as byte)
            k += 1
        }
        assert(region_bytes(arena) - before >= 64 * 1024, "arena_alloc_cost: 64 KiB charged")
    }
}

fn main() {
    t_arena_align()
    t_arena_strdup()
    t_arena_alloc_cost_predicts_resident_growth()
}
