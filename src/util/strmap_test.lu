//! The port of sagitta `tests/unit/test_strmap.c` (99 lines), one test
//! per C test, in registry order (`registry.c:605-607`).
//! `t_strmap_insert_cost_predicts_resident_growth` has no port: the
//! resident-byte model it tests has none (`util.strmap`'s header); the
//! replace-copies-no-key half of it is kept.

use std.fmt

const ENTRY_COUNT: int = 10000

fn key_of(i: int) -> str {
    "key-{fmt.pad_left_with("{i}", 5, "0")}"
}

fn fill_map(mut m: Strmap[int]) {
    var i = 0
    while i < ENTRY_COUNT {
        let previous = strmap_put(mut m, key_of(i), i) else -1
        assert(previous == -1, "fill_map: a new key answers none")
        i += 1
    }
}

fn t_strmap_order() {
    var m: Strmap[int] = strmap_new()
    fill_map(mut m)
    assert(strmap_len(m) == ENTRY_COUNT, "t_strmap_order: len")
    var i = 0
    while i < ENTRY_COUNT {
        assert(strmap_key_at(m, i) == key_of(i), "t_strmap_order: key {i} in put order")
        assert(strmap_value_at(m, i) == i, "t_strmap_order: value {i}")
        i += 1
    }
}

fn t_strmap_replace_keeps_order() {
    var m: Strmap[int] = strmap_new()
    fill_map(mut m)
    assert((strmap_get(m, key_of(42)) else -1) == 42, "replace: get before")
    let previous = strmap_put(mut m, key_of(42), 999999) else -1
    assert(previous == 42, "replace: the previous value is answered")
    assert(strmap_len(m) == ENTRY_COUNT, "replace: len unchanged")
    assert(strmap_key_at(m, 42) == key_of(42), "replace: slot 42 keeps its key")
    assert((strmap_get(m, key_of(42)) else -1) == 999999, "replace: get after")
    assert(strmap_has(m, key_of(42)), "replace: has")
    assert(!strmap_has(m, "absent"), "replace: has absent")
    assert((strmap_get(m, "absent") else -7) == -7, "replace: get absent is none")
}

fn t_strmap_insert_cost_predicts_resident_growth() {
    // The half that ports: replacing a value copies no key and adds no
    // entry.
    var m: Strmap[int] = strmap_new()
    var i = 0
    while i < 5000 {
        let key = "resident-key-{i}"
        let first = strmap_put(mut m, key, i) else -1
        assert(first == -1, "insert_cost: new key")
        let again = strmap_put(mut m, key, 0) else -1
        assert(again == i, "insert_cost: replace answers the old value")
        assert(strmap_len(m) == i + 1, "insert_cost: replace adds no entry")
        i += 1
    }
}

fn main() {
    t_strmap_order()
    t_strmap_replace_keeps_order()
    t_strmap_insert_cost_predicts_resident_growth()
}
