//! util.secret — does an environment NAME say it holds a secret?
//!
//! Ports sagitta `src/util/secret.c` (57 lines) and `secret.h` at
//! 9ace98c2 (Sprint 57.23 §4): the shell completer's value preview
//! redacts a variable whose name carries one of the AI redactor's
//! fragments (`secret.c:7-14`), ASCII case-folded so the answer never
//! depends on the locale (`secret.c:20-37`). Campaign 04 needs it first
//! (yw04); the redactor itself is yw12's.

/// The fragment table (`secret.c:11-14`), upper-case ASCII.
pub fn secret_fragments() -> List[str] {
    var out = List[str]()
    for f in "SECRET TOKEN PASSWORD PASSWD PRIVATE_KEY API_KEY APIKEY CREDENTIAL".words() {
        (mut out).push(f)
    }
    out
}

fn secret_upper(c: int) -> int {
    if c >= 97 && c <= 122 then c - 32 else c
}

/// `contains_folded` (`secret.c:22-37`).
fn secret_contains_folded(hay: str, needle: str) -> bool {
    let n = needle.len
    var at = 0
    while at < hay.len {
        var i = 0
        while i < n {
            if at + i >= hay.len ||
                secret_upper(hay.bytes()[at + i] as int) != needle.bytes()[i] as int {
                break
            }
            i += 1
        }
        if i == n {
            return true
        }
        at += 1
    }
    false
}

/// `yew_secret_name` (`secret.c:39-50`).
pub fn secret_name(name: str) -> bool {
    for f in secret_fragments() {
        if secret_contains_folded(name, f) {
            return true
        }
    }
    false
}
