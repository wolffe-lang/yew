//! util.secret — does an environment NAME say it holds a secret?
//!
//! Ports sagitta `src/util/secret.c` (57 lines) and `secret.h` (28) at
//! 9ace98c2 (Sprint 57.23 §4): a case-insensitive substring match of the
//! name against the redactor's eight fragments. ASCII folding only
//! (`secret.c:17-37`): environment names are bytes, and a locale would
//! make the answer depend on `LC_CTYPE`. Pulled forward from campaign 10
//! (yw12) by yw04: the history suggestions refuse a `NAME=value` whose
//! name is a secret (`cmdhist.c:717-764`) and the shell completer's value
//! preview redacts by it.

// The fragments, upper case, in C's order (`secret.c:11-14`): `API_?KEY`
// is expanded to both spellings.
fn fragment(i: int) -> str {
    match i {
        0 => "SECRET",
        1 => "TOKEN",
        2 => "PASSWORD",
        3 => "PASSWD",
        4 => "PRIVATE_KEY",
        5 => "API_KEY",
        6 => "APIKEY",
        _ => "CREDENTIAL",
    }
}

/// The number of fragments (`yew_secret_fragments`' `*n`).
pub const SECRET_FRAGMENTS: int = 8

/// The fragment table itself, for the drift test (`yew_secret_fragments`,
/// `secret.c:52-57`). Upper case ASCII.
pub fn secret_fragments() -> List[str] {
    var out = List[str]()
    var i = 0
    while i < SECRET_FRAGMENTS {
        (mut out).push(fragment(i))
        i += 1
    }
    out
}

fn upper_ascii(c: int) -> int {
    if c >= 97 && c <= 122 then c - 32 else c
}

// `contains_folded` (`secret.c:22-37`) over `name[at..end)`.
fn contains_folded(name: List[byte], at: int, end: int, needle: str) -> bool {
    let n = needle.len
    var h = at
    while h < end {
        var i = 0
        while i < n {
            if h + i >= end || upper_ascii(name[h + i] as int) != needle.bytes()[i] as int {
                break
            }
            i += 1
        }
        if i == n {
            return true
        }
        h += 1
    }
    false
}

/// `yew_secret_name` (`secret.c:39-50`): does `name[at..end)` contain a
/// fragment, ASCII case folded?
pub fn secret_name(name: List[byte], at: int, end: int) -> bool {
    var i = 0
    while i < SECRET_FRAGMENTS {
        if contains_folded(name, at, end, fragment(i)) {
            return true
        }
        i += 1
    }
    false
}
