//! The port of sagitta `tests/unit/test_intern.c` (76 lines), one test
//! per C test, in registry order (`registry.c:608-610`).
//! `t_intern_insert_cost_predicts_resident_growth` ports as the half the
//! port can witness: a second intern of the same string adds nothing.

fn t_intern_roundtrip() {
    var it = interner_new()
    let alpha = intern(mut it, "alpha")
    let beta = intern(mut it, "beta")
    assert((intern_str(it, alpha) else "") == "alpha", "roundtrip: alpha")
    assert((intern_str(it, beta) else "") == "beta", "roundtrip: beta")
    assert((intern_str(it, 0) else "<none>") == "<none>", "roundtrip: id 0 is none")
    assert((intern_str(it, 99) else "<none>") == "<none>", "roundtrip: unknown id is none")
    assert(intern_len(it, alpha) == 5, "roundtrip: len")
    assert(intern_len(it, 0) == 0, "roundtrip: len of none is 0")
}

fn t_intern_id_stability() {
    var it = interner_new()
    let alpha = intern(mut it, "alpha")
    let beta = intern(mut it, "beta")
    assert(alpha == 1, "id_stability: first id is 1")
    assert(beta == 2, "id_stability: second id is 2")
    assert(intern(mut it, "alpha") == alpha, "id_stability: re-intern answers the same id")
    assert(intern_count(it) == 2, "id_stability: count")
}

fn t_intern_insert_cost_predicts_resident_growth() {
    var it = interner_new()
    var i = 0
    while i < 5000 {
        let name = "interned_{i}"
        let id = intern(mut it, name)
        let count = intern_count(it)
        assert(intern(mut it, name) == id, "insert_cost: same id")
        assert(intern_count(it) == count, "insert_cost: a second intern adds nothing")
        i += 1
    }
    assert(intern_count(it) == 5000, "insert_cost: 5000 strings")
}

fn main() {
    t_intern_roundtrip()
    t_intern_id_stability()
    t_intern_insert_cost_predicts_resident_growth()
}
