//! The port of sagitta `tests/unit/test_buf.c` (31 lines), one test per
//! C test, in registry order (`registry.c:611-612`). `bytebuf_printf`
//! is interpolation here (`util.buf`'s header).

/// Element-wise equality: `==` on a `List` is refused this edition.
fn same_bytes(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn t_bytebuf() {
    var b = List[byte]()
    buf_append_str(mut b, "{"value"}:{42}")
    assert(b.len == 8, "t_bytebuf: len")
    assert((buf_to_str(b) else "") == "value:42", "t_bytebuf: bytes")
    (mut b).clear()
    assert(b.len == 0, "t_bytebuf: free resets")
}

fn t_bytebuf_binary() {
    var b = List[byte]()
    var expected = List[byte]()
    (mut expected).push(120 as byte)
    (mut expected).push(0 as byte)
    (mut expected).push(255 as byte)
    buf_push_u8(mut b, 120)
    buf_append(mut b, expected[1..3])
    assert(b.len == 3, "t_bytebuf_binary: len")
    assert(same_bytes(b, expected), "t_bytebuf_binary: bytes")
    buf_append(mut b, List[byte]())
    assert(b.len == 3, "t_bytebuf_binary: an empty append adds nothing")
}

fn main() {
    t_bytebuf()
    t_bytebuf_binary()
}
