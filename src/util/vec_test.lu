//! The port of sagitta `tests/unit/test_vec.c` (31 lines), one test per
//! C test, in registry order (`registry.c:603-604`). `VEC_DECL(VecU32,
//! u32)` is wolf's `List[int]`; growth past three reallocations and
//! `_free` resetting the fields are the language's, witnessed here as
//! the values surviving 1024 pushes and `clear` leaving an empty list.

fn t_vec_growth() {
    var vec = List[int]()
    var i = 0
    while i < 1024 {
        (mut vec).push(i * 3)
        i += 1
    }
    assert(vec.len == 1024, "t_vec_growth: len")
    assert(vec[0] == 0, "t_vec_growth: first")
    assert(vec[511] == 1533, "t_vec_growth: middle")
    assert(vec[1023] == 3069, "t_vec_growth: last")
}

fn t_vec_free_resets() {
    var vec = List[int]()
    (mut vec).push(7)
    (mut vec).clear()
    assert(vec.len == 0, "t_vec_free_resets: len 0")
    assert(vec.is_empty(), "t_vec_free_resets: empty")
}

fn main() {
    t_vec_growth()
    t_vec_free_resets()
}
