//! util.intern — a string interner answering stable `int` ids in
//! first-intern order.
//!
//! Ports sagitta `src/util/intern.c` (124 lines) and `intern.h` at
//! 9ace98c2. Id 0 is reserved as "invalid" (`intern.c:16-18`); the first
//! string interned is id 1, and an id is the index of its string in the
//! table. Ids are deterministic because the table is append-only and the
//! lookup is by content (`s00` §7). Future consumers: grapheme intern ids
//! in `Cell` (sagitta Sprint 5, yw01) and Fletch identifiers (Sprint 29,
//! yw07).
//!
//! The C interner copies each string into a caller-supplied `Arena` and
//! keeps a parallel `lens` table because an interned string may hold a
//! NUL (`intern.h:17-30`: Fletch's `\0` escape). A wolf `str` carries
//! its length and may hold any scalar, so there is one table and no
//! arena; the copy is the `str` itself. `interner_resident_bytes` and
//! `interner_insert_cost` (`intern.c:93-124`) have no port, as
//! `util.strmap` says.

/// The interner: `strings[id]` is the string with that id; `strings[0]`
/// is the reserved invalid slot and never answered. C's table is keyed by
/// the bytes (`yew_intern(interner, str, len)`, `intern.c:21-50`); the
/// port's `index` takes a `str`, so a lookup from bytes (a grid cell's
/// cluster, `grid.c:93`) goes through `by_hash`, a hash of the bytes to
/// the newest id with that hash, `same_hash[id]` the next older one (-1
/// none): a cluster already interned is found without building a `str`,
/// which in the editor's loop is held to the session's end (G33,
/// yw05-hot).
pub struct Interner {
    strings: List[str],
    index: Map[str, int],
    by_hash: Map[int, int],
    same_hash: List[int],
}

/// An empty interner with id 0 reserved (`interner_init`).
pub fn interner_new() -> Interner {
    var strings = List[str]()
    (mut strings).push("")
    var same = List[int]()
    (mut same).push(-1)
    Interner { strings: strings, index: Map[str, int](), by_hash: Map[int, int](), same_hash: same }
}

// The bytes' hash for `by_hash` (the port's own; C's map hashes inside
// `strmap`).
fn bytes_hash(b: List[byte], at: int, end: int) -> int {
    var h = 0
    var i = at
    while i < end {
        h = (h * 257 + b[i] as int + 1) % 2147483629
        i += 1
    }
    h
}

fn str_hash(s: str) -> int {
    var h = 0
    var i = 0
    while i < s.len {
        h = (h * 257 + s.bytes()[i] as int + 1) % 2147483629
        i += 1
    }
    h
}

/// The id of `s`, interning it on first sight (`intern.c:21-50`).
pub fn intern(mut it: Interner, s: str) -> int {
    let found = it.index[s] else {
        let id = it.strings.len
        (mut it.strings).push(s)
        it.index[s] = id
        let h = str_hash(s)
        let older = it.by_hash[h] else -1
        (mut it.same_hash).push(older)
        it.by_hash[h] = id
        return id
    }
    found
}

/// The id of bytes `b[at..end)` (`yew_intern(interner, str, len)`,
/// `intern.c:21-50`), interning them on first sight; 0 when they are new
/// and not UTF-8 (a `str` must be). A string already interned is found by
/// its bytes: no `str` is built.
pub fn intern_bytes(mut it: Interner, b: List[byte], at: int, end: int) -> int {
    var id = it.by_hash[bytes_hash(b, at, end)] else -1
    while id > 0 {
        if it.strings[id].len == end - at {
            var same = true
            var k = 0
            while k < end - at {
                if it.strings[id].bytes()[k] != b[at + k] {
                    same = false
                    break
                }
                k += 1
            }
            if same {
                return id
            }
        }
        id = it.same_hash[id]
    }
    let text = str_from_utf8(b[at..end]) else {
        return 0
    }
    intern(mut it, text)
}

/// The string with id `id`, or `none` for 0 and for an id never
/// answered (C: NULL) (`intern.c:57-62`).
pub fn intern_str(it: Interner, id: int) -> str ! {none} {
    if id <= 0 || id >= it.strings.len {
        return none
    }
    it.strings[id]
}

/// The byte length of the string with id `id`; 0 for an unknown id,
/// matching `intern_str`'s `none` (`intern.c:64-69`).
pub fn intern_len(it: Interner, id: int) -> int {
    let s = intern_str(it, id) else {
        return 0
    }
    s.len
}

/// How many strings have been interned (`intern.c:71-74`).
pub fn intern_count(it: Interner) -> int {
    it.strings.len - 1
}
