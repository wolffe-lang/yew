//! The port of sagitta `tests/unit/test_base64.c` (124 lines), one test per
//! C test in registry order (`tests/unit/registry.c:109-111`). The decoder
//! and the xorshift generator are the test's own, as in C.

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn b64_value(c: int) -> int {
    if c >= 65 && c <= 90 {
        return c - 65
    }
    if c >= 97 && c <= 122 {
        return c - 97 + 26
    }
    if c >= 48 && c <= 57 {
        return c - 48 + 52
    }
    if c == 43 {
        return 62
    }
    if c == 47 {
        return 63
    }
    -1
}

fn b64_decode(input: List[byte]) -> List[byte] {
    var out = List[byte]()
    var src = 0
    while src < input.len {
        let a = b64_value(input[src] as int)
        let b = b64_value(input[src + 1] as int)
        let c = if input[src + 2] as int == 61 then 0 else b64_value(input[src + 2] as int)
        let d = if input[src + 3] as int == 61 then 0 else b64_value(input[src + 3] as int)
        let bits = a << 18 | b << 12 | c << 6 | d
        (mut out).push((bits >> 16 & 255) as byte)
        if input[src + 2] as int != 61 {
            (mut out).push((bits >> 8 & 255) as byte)
        }
        if input[src + 3] as int != 61 {
            (mut out).push((bits & 255) as byte)
        }
        src += 4
    }
    out
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn t_base64_rfc4648_vectors() {
    let inputs = ["", "f", "fo", "foo", "foob", "foobar"]
    let encoded = ["", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmFy"]
    var i = 0
    while i < inputs.len {
        let input = bytes_of(inputs[i])
        assert(base64_len(input.len) == encoded[i].len, "length of vector {i}")
        assert(same(base64_encode(input, 0, input.len), bytes_of(encoded[i])), "vector {i}")
        i += 1
    }
}

fn t_base64_lengths_and_alphabet() {
    var input = List[byte]()
    var i = 0
    while i < 1024 {
        (mut input).push(165 as byte)
        i += 1
    }
    var n = 0
    while n <= 1024 {
        let encoded_len = base64_len(n)
        assert(encoded_len == 4 * ((n + 2) / 3), "length formula at {n}")
        let encoded = base64_encode(input, 0, n)
        assert(encoded.len == encoded_len, "encoded length at {n}")
        for b in encoded {
            let c = b as int
            assert(b64_value(c) >= 0 || c == 61, "alphabet only")
            assert(c != 10 && c != 13, "no line breaks")
        }
        n += 1
    }
}

fn rng_next(s: wrapping[u64]) -> wrapping[u64] {
    var x = s
    x = x ^ x << 13
    x = x ^ x >> 7
    x = x ^ x << 17
    x
}

fn t_base64_binary_roundtrip_fuzz() {
    var state: wrapping[u64] = 6491895034832636815
    var iteration = 0
    while iteration < 10000 {
        state = rng_next(state)
        let n = (state & 4095) as int % 1025
        var input = List[byte]()
        var i = 0
        while i < n {
            state = rng_next(state)
            (mut input).push((state & 255) as int as byte)
            i += 1
        }
        let encoded = base64_encode(input, 0, n)
        assert(encoded.len == base64_len(n), "fuzz length")
        let decoded = b64_decode(encoded)
        assert(same(decoded, input), "fuzz round-trip at iteration {iteration}")
        iteration += 1
    }
}

fn main() {
    t_base64_rfc4648_vectors()
    t_base64_lengths_and_alphabet()
    t_base64_binary_roundtrip_fuzz()
    print("base64_test: 3 cases pass")
}
