//! util.buf — the byte buffer.
//!
//! Ports sagitta `src/util/buf.c` (89 lines) and `buf.h` at 9ace98c2.
//! `Bytebuf` is wolf's `List[byte]`: geometric growth, `len`, and a
//! `push` are the language's (`buf.c:22-38` reserve/grow has no port).
//! The substrate for the render escape stream (Sprint 5, yw01) and
//! Fletch chunk emission (Sprint 30, yw07).
//!
//! `bytebuf_printf` (`buf.c:58-89`) has no varargs twin: wolf has no
//! formatted-print surface but string interpolation, so a caller writes
//! `buf_append_str(mut b, "{name}:{n}")`, which is what every C call
//! site of it spells once ported. The `%` vocabulary a site relied on
//! (`%zu`, `%02x`, `%s`) is `std.fmt`'s (`fmt.to_hex`, `fmt.pad_left`).

/// Appends every byte of `data` (`bytebuf_append`, `buf.c:40-49`). An
/// empty `data` appends nothing.
pub fn buf_append(mut b: List[byte], data: List[byte]) {
    for x in data {
        (mut b).push(x)
    }
}

/// Appends the bytes of `s` (`bytebuf_printf("%s")`'s common case).
pub fn buf_append_str(mut b: List[byte], s: str) {
    for x in s.bytes() {
        (mut b).push(x)
    }
}

/// Appends one byte (`bytebuf_push_u8`, `buf.c:51-56`).
pub fn buf_push_u8(mut b: List[byte], byte_value: int) {
    (mut b).push(byte_value as byte)
}

/// The buffer's bytes as a `str`, or `utf8` when they are not UTF-8:
/// the read-back a `%s` consumer of a C `Bytebuf` had.
pub fn buf_to_str(b: List[byte]) -> str ! {utf8} {
    str_from_utf8(b)?
}
