//! util.log — the structured log to `$XDG_STATE_HOME/yew/log`, and the
//! internal-error report.
//!
//! Ports sagitta `src/util/log.c` (264 lines) and `log.h` (31) at
//! 9ace98c2 (`s00-repo-and-foundations.md` §4): four levels, the threshold
//! from `YEW_LOG_LEVEL` (`debug`, `info`, `warn`, `error`; default `info`),
//! one line per message — `<UTC time>Z <level>: <message>` — appended to
//! `$YEW_LOG`, else `$XDG_STATE_HOME/yew/log`, else `$HOME/.local/state/
//! yew/log`, and nothing when none of the three is set. Never descriptors
//! 0–2: a log line on the terminal would stain a raw screen (s03 §1).
//!
//! The wolf shapes. C keeps a custom sink and a mirror as function
//! pointers in module state (`log.c:15-19`); a module `var` may hold no
//! function value (`[mem.static.2-3]`), so the port keeps NO module state:
//! the path is resolved from the environment at every write, exactly as
//! `default_write` does (`log.c:124-156`), and a test that wants to capture
//! the log sets `YEW_LOG` to a scratch file and reads it back — which is
//! what the PTY harness does too (`YEW_LOG_LEVEL=debug`, the state dir).
//! The mirror sink (batch's WARN+ echo, `log.c:189-197`, batch.c:199-210)
//! is one scalar mode (`log_set_batch_mirror`), not a function value; the
//! batch assertion host's record of the log (`t.log`) reads the log file
//! back (`log_capture_has`). `yew_bug`'s prehook (`log.c:199-202`, the terminal
//! restore before the report) has no function-value home either: the
//! terminal owner restores before invoking this utility. The Fletch VM
//! uses one kind-id hook with the prompt's saved mode and guard handles
//! (yw08); the runtime restore registration remains the fallback for
//! exits that run no program code. This utility does not walk VM values.

use std.fs
use std.time

/// The levels (`YewLogLevel`, `log.h:8-13`).
pub const LOG_DEBUG: int = 0

/// Information.
pub const LOG_INFO: int = 1

/// A warning.
pub const LOG_WARN: int = 2

/// An error.
pub const LOG_ERROR: int = 3

// The batch mirror (batch_log_write, batch.c:199-210): 0 off, 1 WARN and
// above to stderr as `yew: MESSAGE`, 2 (`--quiet`) ERROR only.
var batch_mirror: int = 0

/// Install or remove batch's stderr mirror (`yew_log_set_mirror`):
/// `on`, and `quiet` keeping only errors.
pub fn log_set_batch_mirror(on: bool, quiet: bool) {
    // # Safety: one thread; batch sets this before the editor exists.
    unsafe { batch_mirror = if !on then 0 else if quiet then 2 else 1 }
}

fn mirror_wants(level: int) -> bool {
    var mode = 0
    // # Safety: one thread reads the scalar the batch driver set.
    unsafe { mode = batch_mirror }
    if mode == 0 || level < LOG_WARN { return false }
    !(mode == 2 && level < LOG_ERROR)
}

fn mirror_bytes(message: List[byte]) {
    var err = fs.stderr()
    fs.write_chunk(mut err, "yew: ".bytes()) else |_| {}
    fs.write_chunk(mut err, message) else |_| {}
    fs.write_chunk(mut err, "\n".bytes()) else |_| {}
}

/// Whether a line at `level` containing `sub` was logged this run (the
/// assertion host's record, batch_test.c:481-497), read back from the log
/// file; false when no log file is configured.
pub fn log_capture_has(level: int, sub: List[byte]) -> bool {
    let path = log_path() else { return false }
    let text = fs.read_bytes(path) else |_| { return false }
    let tag = " {level_name(level)}: "
    let tb = copy tag.bytes()
    var start = 0
    while start < text.len {
        var end = start
        while end < text.len && text[end] != 10 as byte { end += 1 }
        let at = find_bytes(text, start, end, tb)
        if at >= 0 && find_bytes(text, at + tb.len, end, sub) >= 0 { return true }
        start = end + 1
    }
    false
}

fn find_bytes(hay: List[byte], lo: int, hi: int, needle: List[byte]) -> int {
    if needle.len == 0 { return lo }
    var i = lo
    while i + needle.len <= hi {
        var k = 0
        while k < needle.len && hay[i + k] == needle[k] { k += 1 }
        if k == needle.len { return i }
        i += 1
    }
    -1
}

fn level_name(level: int) -> str {
    if level == LOG_DEBUG {
        return "debug"
    }
    if level == LOG_INFO {
        return "info"
    }
    if level == LOG_WARN {
        return "warn"
    }
    "error"
}

/// The threshold `YEW_LOG_LEVEL` names (`configured_level`, `log.c:30-46`):
/// an unknown word is `info`.
pub fn configured_level() -> int {
    let value = env_get("YEW_LOG_LEVEL") else {
        return LOG_INFO
    }
    if value == "debug" {
        return LOG_DEBUG
    }
    if value == "warn" {
        return LOG_WARN
    }
    if value == "error" {
        return LOG_ERROR
    }
    LOG_INFO
}

/// The log file's path (`default_log_path`, `log.c:81-110`): `YEW_LOG`,
/// else `$XDG_STATE_HOME/yew/log`, else `$HOME/.local/state/yew/log`;
/// `none` when the environment names no usable root.
pub fn log_path() -> str ! {none} {
    let override = env_get("YEW_LOG") else ""
    if override.len != 0 {
        return override
    }
    let state = env_get("XDG_STATE_HOME") else ""
    if state.len != 0 {
        return "{state}/yew/log"
    }
    let home = env_get("HOME") else ""
    if home.len == 0 {
        return none
    }
    "{home}/.local/state/yew/log"
}

fn parent_dir(path: str) -> str ! {none} {
    let cut = path.rfind("/") else {
        return none
    }
    if cut == 0 {
        return none
    }
    path[0..cut]
}

// `YYYY-MM-DDTHH:MM:SSZ` in UTC (`log.c:140-146`): `std.time`'s ISO 8601
// with the milliseconds dropped.
fn timestamp() -> str {
    let iso = time.to_iso8601(time.unix_ms())
    if iso.len >= 19 {
        let head = iso.get(0..19) else iso
        return "{head}Z"
    }
    iso
}

fn open_log_append(path: str) -> fs.File ! {none} {
    let dir = parent_dir(path) else ""
    if dir.len != 0 && !fs.exists(dir) {
        fs.create_dir_all(dir) else |_| { return none }
    }
    if !fs.exists(path) {
        let made = fs.create_with_mode(path, 0o600) else |_| { return none }
        fs.close(take made) else |_| {}
    }
    fs.open_append(path) else |_| { return none }
}

fn append_line(path: str, line: str) {
    var f = open_log_append(path) else { return }
    fs.write(mut f, line) else |_| {}
    fs.close(take f) else |_| {}
}

fn log_bug_bytes(where: str, detail: List[byte]) {
    if LOG_ERROR < configured_level() { return }
    let path = log_path() else { return }
    var f = open_log_append(path) else { return }
    fs.write(
        mut f,
        "{timestamp()} {level_name(LOG_ERROR)}: yew: internal error at {where}: ",
    ) else |_| {}
    fs.write_chunk(mut f, detail) else |_| {}
    fs.write(mut f, "\n") else |_| {}
    fs.close(take f) else |_| {}
}

/// Log `message` at `level` (`yew_log`, `log.c:204-229`): dropped below the
/// configured threshold; otherwise one line appended to the log file.
pub fn log_at(level: int, message: str) {
    if level < configured_level() {
        return
    }
    if mirror_wants(level) {
        let b = copy message.bytes()
        mirror_bytes(b)
    }
    let path = log_path() else {
        return
    }
    append_line(path, "{timestamp()} {level_name(level)}: {message}\n")
}

/// Log already-formatted bytes without UTF-8 conversion (sagitta 9ace98c2
/// log.c:124-176,204-229). The C sink writes strlen(message): stop at its
/// first NUL, retain arbitrary other bytes and the whole dynamically-sized
/// message. This utility never mirrors to terminal descriptors.
pub fn log_at_bytes(level: int, message: List[byte]) {
    if level < configured_level() { return }
    if mirror_wants(level) {
        var n: int = 0
        while n < message.len && message[n] != 0 as byte { n += 1 }
        if n == message.len { mirror_bytes(message) } else { mirror_bytes(message[0..n]) }
    }
    let path = log_path() else { return }
    var f = open_log_append(path) else { return }
    fs.write(mut f, "{timestamp()} {level_name(level)}: ") else |_| {}
    var n: int = 0
    while n < message.len && message[n] != 0 as byte { n += 1 }
    if n == message.len {
        fs.write_chunk(mut f, message) else |_| {}
    } else {
        fs.write_chunk(mut f, message[0..n]) else |_| {}
    }
    fs.write(mut f, "\n") else |_| {}
    fs.close(take f) else |_| {}
}

/// `log_at(LOG_DEBUG, message)`.
pub fn log_debug(message: str) {
    log_at(LOG_DEBUG, message)
}

/// `log_at(LOG_INFO, message)`.
pub fn log_info(message: str) {
    log_at(LOG_INFO, message)
}

/// `log_at(LOG_WARN, message)`.
pub fn log_warn(message: str) {
    log_at(LOG_WARN, message)
}

/// `log_at(LOG_ERROR, message)`.
pub fn log_error(message: str) {
    log_at(LOG_ERROR, message)
}

/// The internal-error report (`yew_bug`, `log.c:231-263`, `YEW_BUG`):
/// the message and the please-report line logged at ERROR and written to
/// stderr, then exit 4 (`EXIT_BUG`). `where` is the C `file:line`; the
/// port names the unit and the condition. Never returns.
pub fn bug(where: str, detail: str) {
    bug_bytes(where, detail.bytes())
}

/// Emit an already-prepared byte report and exit 4. The byte output is
/// streamed without reconstructing the report. Ordinary log formatting
/// may allocate AFTER the caller has completed its report buffer.
pub fn bug_bytes(where: str, detail: List[byte]) {
    log_bug_bytes(where, detail)
    log_at(LOG_ERROR, "yew: please report this internal error")
    var err = fs.stderr()
    fs.write_chunk(mut err, "yew: internal error at ".bytes()) else |_| {}
    fs.write_chunk(mut err, where.bytes()) else |_| {}
    fs.write_chunk(mut err, ": ".bytes()) else |_| {}
    fs.write_chunk(mut err, detail) else |_| {}
    fs.write_chunk(mut err, "\nyew: please report this internal error\n".bytes()) else |_| {}
    os_exit(EXIT_BUG)
}
