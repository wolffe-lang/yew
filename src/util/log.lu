//! util.log — the structured log to `$XDG_STATE_HOME/yew/log`, and the
//! internal-error report.
//!
//! Ports sagitta `src/util/log.c` (264 lines) and `log.h` (31) at
//! 9ace98c2 (`s00-repo-and-foundations.md` §4): four levels, the threshold
//! from `YEW_LOG_LEVEL` (`debug`, `info`, `warn`, `error`; default `info`),
//! one line per message — `<UTC time>Z <level>: <message>` — appended to
//! `$YEW_LOG`, else `$XDG_STATE_HOME/yew/log`, else `$HOME/.local/state/
//! yew/log`, and nothing when none of the three is set. Never descriptors
//! 0–2: a log line on the terminal would stain a raw screen (s03 §1).
//!
//! The wolf shapes. C keeps a custom sink and a mirror as function
//! pointers in module state (`log.c:15-19`); a module `var` may hold no
//! function value (`[mem.static.2-3]`), so the port keeps NO module state:
//! the path is resolved from the environment at every write, exactly as
//! `default_write` does (`log.c:124-156`), and a test that wants to capture
//! the log sets `YEW_LOG` to a scratch file and reads it back — which is
//! what the PTY harness does too (`YEW_LOG_LEVEL=debug`, the state dir).
//! The mirror sink (batch's WARN+ echo, `log.c:189-197`) lands with
//! campaign 07 (yw09). `yew_bug`'s prehook (`log.c:199-202`, the terminal
//! restore before the report) has no function-value home either: the
//! report is written and the guard sibling restores the terminal on the
//! exit that follows (`term.tty`), one ordering divergence from C stated
//! there; the runtime's own restore at exit (ruling #93 R1 C, 0.2.34)
//! puts the restore first again.

use std.fs
use std.time

/// The levels (`YewLogLevel`, `log.h:8-13`).
pub const LOG_DEBUG: int = 0

/// Information.
pub const LOG_INFO: int = 1

/// A warning.
pub const LOG_WARN: int = 2

/// An error.
pub const LOG_ERROR: int = 3

fn level_name(level: int) -> str {
    if level == LOG_DEBUG {
        return "debug"
    }
    if level == LOG_INFO {
        return "info"
    }
    if level == LOG_WARN {
        return "warn"
    }
    "error"
}

/// The threshold `YEW_LOG_LEVEL` names (`configured_level`, `log.c:30-46`):
/// an unknown word is `info`.
pub fn configured_level() -> int {
    let value = env_get("YEW_LOG_LEVEL") else {
        return LOG_INFO
    }
    if value == "debug" {
        return LOG_DEBUG
    }
    if value == "warn" {
        return LOG_WARN
    }
    if value == "error" {
        return LOG_ERROR
    }
    LOG_INFO
}

/// The log file's path (`default_log_path`, `log.c:81-110`): `YEW_LOG`,
/// else `$XDG_STATE_HOME/yew/log`, else `$HOME/.local/state/yew/log`;
/// `none` when the environment names no usable root.
pub fn log_path() -> str ! {none} {
    let override = env_get("YEW_LOG") else ""
    if override.len != 0 {
        return override
    }
    let state = env_get("XDG_STATE_HOME") else ""
    if state.len != 0 {
        return "{state}/yew/log"
    }
    let home = env_get("HOME") else ""
    if home.len == 0 {
        return none
    }
    "{home}/.local/state/yew/log"
}

fn parent_dir(path: str) -> str ! {none} {
    let cut = path.rfind("/") else {
        return none
    }
    if cut == 0 {
        return none
    }
    path[0..cut]
}

// `YYYY-MM-DDTHH:MM:SSZ` in UTC (`log.c:140-146`): `std.time`'s ISO 8601
// with the milliseconds dropped.
fn timestamp() -> str {
    let iso = time.to_iso8601(time.unix_ms())
    if iso.len >= 19 {
        let head = iso.get(0..19) else iso
        return "{head}Z"
    }
    iso
}

fn append_line(path: str, line: str) {
    let dir = parent_dir(path) else ""
    if dir.len != 0 && !fs.exists(dir) {
        fs.create_dir_all(dir) else |_| {
            return
        }
    }
    if !fs.exists(path) {
        let made = fs.create_with_mode(path, 0o600) else |_| {
            return
        }
        fs.close(take made) else |_| {}
    }
    var f = fs.open_append(path) else |_| {
        return
    }
    fs.write(mut f, line) else |_| {}
    fs.close(take f) else |_| {}
}

/// Log `message` at `level` (`yew_log`, `log.c:204-229`): dropped below the
/// configured threshold; otherwise one line appended to the log file.
pub fn log_at(level: int, message: str) {
    if level < configured_level() {
        return
    }
    let path = log_path() else {
        return
    }
    append_line(path, "{timestamp()} {level_name(level)}: {message}\n")
}

/// `log_at(LOG_DEBUG, message)`.
pub fn log_debug(message: str) {
    log_at(LOG_DEBUG, message)
}

/// `log_at(LOG_INFO, message)`.
pub fn log_info(message: str) {
    log_at(LOG_INFO, message)
}

/// `log_at(LOG_WARN, message)`.
pub fn log_warn(message: str) {
    log_at(LOG_WARN, message)
}

/// `log_at(LOG_ERROR, message)`.
pub fn log_error(message: str) {
    log_at(LOG_ERROR, message)
}

/// The internal-error report (`yew_bug`, `log.c:231-263`, `YEW_BUG`):
/// the message and the please-report line logged at ERROR and written to
/// stderr, then exit 4 (`EXIT_BUG`). `where` is the C `file:line`; the
/// port names the unit and the condition. Never returns.
pub fn bug(where: str, detail: str) {
    let message = "yew: internal error at {where}: {detail}"
    let report = "yew: please report this internal error"
    log_at(LOG_ERROR, message)
    log_at(LOG_ERROR, report)
    eprint(message)
    eprint(report)
    os_exit(EXIT_BUG)
}
