//! util.xdg — the XDG base directories yew keeps its state, data, config
//! and cache under.
//!
//! Ports sagitta `src/util/xdg.c` (127 lines) and `xdg.h` (19) at
//! 9ace98c2. Each answers `$XDG_<KIND>_HOME/yew`, else `$HOME/<default>/
//! yew`, else `none` (C: NULL — the caller degrades to an in-memory
//! feature). `mkdirs` makes every component with one mode.

use std.fs

fn xdg_dir(variable: str, default_suffix: str) -> str ! {none} {
    let root = env_get(variable) else ""
    if root.len != 0 {
        return "{root}/yew"
    }
    let home = env_get("HOME") else ""
    if home.len == 0 {
        return none
    }
    "{home}/{default_suffix}/yew"
}

/// `$XDG_STATE_HOME/yew`, or `~/.local/state/yew` (`yew_xdg_state_dir`).
pub fn xdg_state_dir() -> str ! {none} {
    xdg_dir("XDG_STATE_HOME", ".local/state")?
}

/// `$XDG_DATA_HOME/yew`, or `~/.local/share/yew` (`yew_xdg_data_dir`).
pub fn xdg_data_dir() -> str ! {none} {
    xdg_dir("XDG_DATA_HOME", ".local/share")?
}

/// `$XDG_CONFIG_HOME/yew`, or `~/.config/yew` (`yew_xdg_config_dir`).
pub fn xdg_config_dir() -> str ! {none} {
    xdg_dir("XDG_CONFIG_HOME", ".config")?
}

/// `$XDG_CACHE_HOME/yew`, or `~/.cache/yew` (`yew_xdg_cache_dir`).
pub fn xdg_cache_dir() -> str ! {none} {
    xdg_dir("XDG_CACHE_HOME", ".cache")?
}

fn mkdir_one(path: str, mode: int) -> bool {
    fs.create_dir_mode(path, mode) else |e| match e {
        exists => { return fs.is_dir(path) },
        not_found => { return false },
        denied => { return false },
        invalid => { return false },
        unsupported => {
            fs.create_dir(path) else |_| {
                return fs.is_dir(path)
            }
            return true
        },
        io => { return false },
    }
    true
}

/// Make `path` and every missing parent with `mode` (`yew_mkdirs`,
/// `xdg.c:106-127`); false on the first failure.
pub fn mkdirs(path: str, mode: int) -> bool {
    if path.len == 0 {
        return false
    }
    let bytes = path.bytes()
    var i = 1
    while i < bytes.len {
        if bytes[i] as int == 47 {
            let prefix = path[0..i]
            if !mkdir_one(prefix, mode) {
                return false
            }
        }
        i += 1
    }
    mkdir_one(path, mode)
}
