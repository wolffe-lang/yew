//! util.base — the exit-code contract and the version string.
//!
//! Ports sagitta `src/util/base.h:23-31` (the `YEW_EXIT_*` enum and
//! `YEW_VERSION`) at 9ace98c2. The allocation wrappers of `base.c`
//! (`yew_xmalloc` and kin, `base.h:52-96`) have no port: wolf's regions
//! are the allocator and an allocation failure is a trap, never a NULL;
//! `yew_pipe_cloexec` (`base.h:34-45`) is `std.process.pipe`'s job and
//! lands with campaign 04 (yw04). `yew_memzero` (`base.h:98-105`) lands
//! with the secret handling it serves (campaign 10, yw12).
//!
//! The exit codes are sagitta's contract (`s00-repo-and-foundations.md`
//! §5): 0 success, 1 error (bad flags, an unported surface, an editor
//! error), 2 a `--batch` script failure, 3 an I/O error, 4 an internal
//! bug reported in a structured way, never a bare crash.

/// Success.
pub const EXIT_OK: int = 0

/// An error: bad flags, an unported surface, an editor error.
pub const EXIT_ERR: int = 1

/// A `--batch` script failure (sagitta Sprint 37, yw09).
pub const EXIT_BATCH: int = 2

/// An I/O error: an unreadable file, an unwritable state directory.
pub const EXIT_IO: int = 3

/// An internal bug: a structured report, never a bare crash.
pub const EXIT_BUG: int = 4

/// The version C yew prints as the first line of `--version`
/// (`base.h:31`). One definition; sagitta's Sprint 60 audits it.
pub const VERSION: str = "1.0.0-dev"

/// The modules line C yew prints second (`s00` §6): the full build's
/// set in `KNOWN_MODS` order. The port is always the full build; a
/// `MODULES=""` build is a shape the port does not have (docs/MAP.md).
pub const MODULES_LINE: str = "modules: lsp ai fuss plugins"
