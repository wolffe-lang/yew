//! member: false
//!
//! The port of sagitta `tests/unit/test_args.c` (468 lines), one test per
//! C test in registry order (`tests/unit/registry.c:512-531`). C's argv
//! carries `"yew"` first; the port's vector is `env_args()`'s shape,
//! without it.

use args
use util

fn parse(argv: List[str]) -> (int, args.Args, str) {
    args.args_parse(argv)
}

fn t_args_parse_version() {
    let (rc, a, err) = parse(["--version"])
    assert(rc == util.EXIT_OK, "--version exits 0")
    assert(a.version && !a.help && !a.help_cmds, "version only")
    assert(err.len == 0, "no error")
}

fn t_args_parse_help_cmds() {
    let (rc, a, err) = parse(["--help-cmds"])
    assert(rc == util.EXIT_OK, "--help-cmds exits 0")
    assert(a.help_cmds && !a.help && !a.version, "help-cmds only")
    assert(err.len == 0, "no error")
}

fn t_args_parse_help() {
    let (rc, a, _) = parse(["--help", "file.txt"])
    assert(rc == util.EXIT_OK, "--help exits 0")
    assert(a.help, "help")
    assert(a.files.len == 1 && a.files[0] == "file.txt", "the file is kept")
}

fn t_args_parse_unknown() {
    let (rc, _, err) = parse(["--no-such-flag"])
    assert(rc == util.EXIT_ERR, "unknown exits 1")
    assert(err == "yew: error: unknown option '--no-such-flag'\n", "message")
}

fn t_args_parse_file() {
    let (rc, a, _) = parse(["one.txt", "two.txt"])
    assert(rc == -1, "proceed")
    assert(a.files.len == 2 && a.files[0] == "one.txt" && a.files[1] == "two.txt", "two files")
}

fn t_args_parse_batch() {
    let (rc, a, _) = parse(["--batch", "edit.fl", "one.txt"])
    assert(rc == -1, "proceed")
    assert(a.batch_script == "edit.fl", "script")
    assert(a.files.len == 1 && a.files[0] == "one.txt", "file")
    let (rc2, b, err2) = parse(["--batch", "--replay", "Q", "edit.fl", "one.txt"])
    assert(rc2 == -1, "proceed with replay")
    assert(b.replay_reg == 81, "register Q")
    assert(b.batch_script == "edit.fl" && b.files.len == 1 && b.files[0] == "one.txt", "script and file")
    assert(err2.len == 0, "no error")
}

fn t_args_parse_batch_missing() {
    let (rc, _, err) = parse(["--batch"])
    assert(rc == util.EXIT_ERR, "exit 1")
    assert(err == "yew: error: option '--batch' requires an argument\n", "message")
}

fn t_args_parse_end_options() {
    let (rc, a, _) = parse(["--clean", "--", "--version"])
    assert(rc == -1, "proceed")
    assert(a.clean && !a.version, "clean, and --version is a file")
    assert(a.files.len == 1 && a.files[0] == "--version", "the file")
}

fn t_args_parse_config_controls() {
    let (rc, a, err) = parse(["--config", "mine.fl", "--theme", "quiver-light", "--no-workspace-config", "--trust-workspace"])
    assert(rc == -1, "proceed")
    assert(a.config_path == "mine.fl" && a.theme == "quiver-light", "config and theme")
    assert(a.no_workspace_config && a.trust_workspace, "the two flags")
    assert(err.len == 0, "no error")
}

fn t_args_parse_config_missing() {
    let (rc, _, err) = parse(["--config"])
    assert(rc == util.EXIT_ERR, "exit 1")
    assert(err == "yew: error: option '--config' requires an argument\n", "message")
}

fn t_args_parse_workspace() {
    let (rc, a, err) = parse(["--workspace", "project", "one.c", "two.c"])
    assert(rc == -1, "proceed")
    assert(a.workspace_dir == "project", "workspace")
    assert(a.files.len == 2 && a.files[0] == "one.c" && a.files[1] == "two.c", "files")
    assert(err.len == 0, "no error")
}

fn t_args_parse_workspace_errors() {
    let (rc1, _, e1) = parse(["--workspace"])
    assert(rc1 == util.EXIT_ERR && e1 == "yew: error: option '--workspace' requires an argument\n", "missing")
    let (rc2, _, e2) = parse(["--workspace", "a", "--workspace", "b"])
    assert(rc2 == util.EXIT_ERR && e2 == "yew: error: option '--workspace' specified twice\n", "duplicate")
    let (rc3, _, e3) = parse(["--workspace", "a", "--batch", "run.fl"])
    assert(rc3 == util.EXIT_ERR && e3 == "yew: error: option '--workspace' cannot be used with --batch\n", "with batch")
}

fn t_args_parse_batch_full_model() {
    let (rc, a, err) = parse([
        "--clean",
        "--config",
        "user.fl",
        "--no-workspace-config",
        "--trust-workspace",
        "--quiet",
        "--test",
        "--batch",
        "tools/fmt.fl",
        "one.c",
        "-",
        "two.c",
        "--",
        "--write",
        "value with spaces",
        "",
    ])
    assert(rc == -1, "proceed")
    assert(a.clean && a.config_path == "user.fl" && a.no_workspace_config && a.trust_workspace && a.quiet && a.test, "flags")
    assert(a.batch_script == "tools/fmt.fl", "script")
    assert(a.files.len == 3 && a.files[0] == "one.c" && a.files[1] == "-" && a.files[2] == "two.c", "files")
    assert(a.batch_args.len == 3 && a.batch_args[0] == "--write" && a.batch_args[1] == "value with spaces" && a.batch_args[2] == "", "batch args")
    assert(a.grants.len == 0, "no grants")
    assert(err.len == 0, "no error")
}

fn t_args_parse_batch_runner_order() {
    let (rc, a, err) = parse(["--batch", "--test", "--clean", "--quiet", "case.fl"])
    assert(rc == -1, "proceed")
    assert(a.batch_script == "case.fl" && a.test && a.clean && a.quiet, "options before the script")
    assert(a.files.len == 0, "no files")
    assert(a.batch_args.len == 0 && !a.batch_args_seen, "no batch args at all")
    assert(err.len == 0, "no error")
}

fn t_args_parse_batch_empty_arg_tail() {
    let (rc, a, err) = parse(["--batch", "case.fl", "--"])
    assert(rc == -1, "proceed")
    assert(a.batch_script == "case.fl" && a.files.len == 0, "script, no files")
    assert(a.batch_args.len == 0 && a.batch_args_seen, "an empty tail was seen")
    assert(err.len == 0, "no error")
}

fn t_args_parse_batch_grants() {
    let (rc, a, err) = parse(["--grant", "fmt:fs", "--batch", "--grant", "lint:shell", "run.fl"])
    assert(rc == -1, "proceed")
    assert(a.batch_script == "run.fl", "script")
    assert(a.grants.len == 2, "two grants")
    assert(a.grants[0].text == "fmt:fs" && a.grants[0].name_len == 3, "first grant")
    assert(a.grants[0].text[a.grants[0].name_len + 1..a.grants[0].text.len] == "fs", "first cap")
    assert(a.grants[1].text == "lint:shell" && a.grants[1].name_len == 4, "second grant")
    assert(a.grants[1].text[a.grants[1].name_len + 1..a.grants[1].text.len] == "shell", "second cap")
    assert(err.len == 0, "no error")
}

fn t_args_parse_batch_only_options_require_batch() {
    let (r1, a1, e1) = parse(["--test"])
    assert(r1 == util.EXIT_ERR && e1 == "yew: error: option '--test' requires --batch\n" && a1.grants.len == 0, "--test")
    let (r2, a2, e2) = parse(["--quiet"])
    assert(r2 == util.EXIT_ERR && e2 == "yew: error: option '--quiet' requires --batch\n" && a2.grants.len == 0, "--quiet")
    let (r3, a3, e3) = parse(["--grant", "plug:net"])
    assert(r3 == util.EXIT_ERR && e3 == "yew: error: option '--grant' requires --batch\n" && a3.grants.len == 0, "--grant")
    let (r4, a4, e4) = parse(["--replay", "a"])
    assert(r4 == util.EXIT_ERR && e4 == "yew: error: option '--replay' requires --batch\n" && a4.grants.len == 0, "--replay")
}

fn t_args_parse_batch_grant_errors() {
    let values = ["plug", ":fs", "plug:", "a:b:c", "plug:fs.read", "Plug:fs", "plug:unknown", "plugin-name-that-is-longer-than-thirty-two:fs"]
    for v in values {
        let (rc, a, err) = parse(["--batch", "run.fl", "--grant", v])
        assert(rc == util.EXIT_ERR, "invalid grant {v} exits 1")
        assert(err.contains("invalid --grant value") && err.contains("expected NAME:CAP"), "message for {v}")
        assert(a.grants.len == 0, "no grants kept")
    }
}

fn t_args_parse_batch_misuse() {
    let (r1, _, e1) = parse(["--batch", "--batch", "run.fl"])
    assert(r1 == util.EXIT_ERR && e1 == "yew: error: option '--batch' specified twice\n", "duplicate batch")
    let (r2, _, e2) = parse(["--batch", "run.fl", "--grant"])
    assert(r2 == util.EXIT_ERR && e2 == "yew: error: option '--grant' requires an argument\n", "missing grant")
    let (r3, _, e3) = parse(["--batch", "--test", "--"])
    assert(r3 == util.EXIT_ERR && e3 == "yew: error: option '--batch' requires an argument\n", "missing script")
    let (r4, _, e4) = parse(["--batch", "--replay"])
    assert(r4 == util.EXIT_ERR && e4 == "yew: error: option '--replay' requires an argument\n", "replay missing")
    let (r5, _, e5) = parse(["--batch", "--replay", "qq", "run.fl"])
    assert(r5 == util.EXIT_ERR && e5 == "yew: error: invalid --replay register 'qq' (expected one letter a-z/A-Z)\n", "replay invalid")
    let (r6, _, e6) = parse(["--batch", "--replay", "a", "--replay", "b", "run.fl"])
    assert(r6 == util.EXIT_ERR && e6 == "yew: error: option '--replay' specified twice\n", "replay duplicate")
    let (r7, _, e7) = parse(["--batch-strict"])
    assert(r7 == util.EXIT_ERR && e7 == "yew: error: option '--batch-strict' is not available in yew 1.0\n", "strict")
}

fn t_args_parse_batch_stops_options_at_first_file() {
    let (rc, a, err) = parse(["--batch", "run.fl", "one", "--quiet", "--", "tail"])
    assert(rc == -1, "proceed")
    assert(!a.quiet, "--quiet after the first file is a file")
    assert(a.files.len == 2 && a.files[0] == "one" && a.files[1] == "--quiet", "files")
    assert(a.batch_args.len == 1 && a.batch_args[0] == "tail", "tail")
    assert(err.len == 0, "no error")
}

fn main() {
    t_args_parse_version()
    t_args_parse_help_cmds()
    t_args_parse_help()
    t_args_parse_unknown()
    t_args_parse_file()
    t_args_parse_batch()
    t_args_parse_batch_missing()
    t_args_parse_end_options()
    t_args_parse_config_controls()
    t_args_parse_config_missing()
    t_args_parse_workspace()
    t_args_parse_workspace_errors()
    t_args_parse_batch_full_model()
    t_args_parse_batch_runner_order()
    t_args_parse_batch_empty_arg_tail()
    t_args_parse_batch_grants()
    t_args_parse_batch_only_options_require_batch()
    t_args_parse_batch_grant_errors()
    t_args_parse_batch_misuse()
    t_args_parse_batch_stops_options_at_first_file()
    print("args_test: 20 cases pass")
}
