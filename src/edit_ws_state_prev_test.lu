//! member: false
//! yew#129: the workspace state's previous generations. A writing session
//! copies the state file it finds when it opens to `state.fl.prev`, after
//! moving the older copies down to `.prev.2` and `.prev.3`, so a save that
//! lost tabs can be undone by hand from the copy. Port-only rows: sagitta
//! keeps no copy (`src/ws/state_save.c:56-325`). The fixture is
//! `edit_ws_save_test.lu`'s: a scratch state home and workspace under
//! target/. Each case runs alone with `YEW_STATE_PREV_CASE=N`; all run in
//! order without it.

use edit
use term
use text
use util
use ws

struct Fix { root: str, work: str, saved: str, had: bool }

fn fixture() -> Fix {
    let saved = env_get("XDG_STATE_HOME") else ""
    let had = saved.len != 0
    assert(util.mkdirs("target/ws-prev-fixtures", 448))
    var root = ""
    loop {
        var suffix = ""
        for r in os_random(8) { suffix = "{suffix}{r % 10}" }
        root = "target/ws-prev-fixtures/{suffix}"
        fs_create_dir_mode(root, 448) else |e| match e {
            exists => { continue },
            _ => { assert(false, "mkdir fixture: {e}") },
        }
        break
    }
    root = fs_realpath(root) else {
        assert(false)
        return Fix { root: "", work: "", saved: "", had: false }
    }
    let work = "{root}/work"
    assert(util.mkdirs(work, 448))
    env_set("XDG_STATE_HOME", "{root}/state") else { assert(false) }
    Fix { root: root, work: work, saved: saved, had: had }
}

fn remove_tree(path: str) {
    let entries = fs_read_dir(path) else { return }
    for name in entries {
        let p = "{path}/{name}"
        fs_remove(p) else |_| {
            remove_tree(p)
            fs_remove_dir(p) else { assert(false, "remove dir {p}") }
        }
    }
}

fn finish(f: Fix) {
    if f.had {
        env_set("XDG_STATE_HOME", f.saved) else { assert(false) }
    } else {
        env_unset("XDG_STATE_HOME") else { assert(false) }
    }
    remove_tree(f.root)
    fs_remove_dir(f.root) else { assert(false) }
}

fn fresh(f: Fix) -> edit.Ed {
    var ed = edit.ed_new()
    ed.ws_dir = f.work
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(24, 80)
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    ed
}

fn exists(path: str) -> bool { let _ = fs_stat(path) else { return false }; true }

fn read_all(path: str) -> List[byte] { fs_read_bytes(path) else List[byte]() }

fn same(a: List[byte], b: List[byte]) -> bool { edit.comp_bytes_eq(a, b) }

// One writing session that opens `n` file tabs beside the scratch tab and
// saves; answers the state file's bytes after the save.
fn session(f: Fix, n: int) -> List[byte] {
    var ed = fresh(f)
    edit.state_open(mut ed)
    assert(ed.state.ready && ed.state.writer, "the session writes")
    for i in 0..n {
        let path = "{f.work}/f{i}.txt"
        assert(text.file_write_atomic(path, "{i}\n".bytes(), 384) == text.SAVE_OK)
        assert(edit.tab_open(mut ed, path) >= 0, "tab {i} opens")
    }
    assert(edit.state_save(mut ed), "saved")
    let path = ws.ws_state_path(ed.state.key)
    edit.state_dispose(mut ed)
    read_all(path)
}

fn state_path(f: Fix) -> str {
    var ed = fresh(f)
    assert(ws.ws_key(mut ed.state.key, ed.ws_dir), "the workspace has a key")
    ws.ws_state_path(ed.state.key)
}

// The copy is taken when a writing session opens, before it saves, and
// later saves of that session leave it alone: a save that lost tabs (here
// 22 down to the scratch tab alone, twice) leaves the 22 in the copy.
fn open_keeps_the_found_state() {
    let f = fixture()
    defer finish(f)
    let found = session(f, 22)
    let path = state_path(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    assert(ed.state.writer, "the second session writes")
    assert(exists("{path}.prev"), "the copy exists before any save")
    assert(same(read_all("{path}.prev"), found), "the copy is the state the session found")
    assert(edit.state_save(mut ed), "the first save")
    assert(edit.state_save(mut ed), "the second save")
    assert(!same(read_all(path), found), "the state file now holds the smaller state")
    assert(same(read_all("{path}.prev"), found), "the copy still holds the 22 tabs")
    edit.state_dispose(mut ed)
}

// Three generations, oldest dropped: after four sessions saving 2, 3, 4
// and 5 file tabs, the fifth session's open leaves the last state in
// `.prev`, the one before in `.prev.2`, the one before that in `.prev.3`,
// and the first in no copy.
fn three_generations() {
    let f = fixture()
    defer finish(f)
    var states = List[List[byte]]()
    for n in 2..6 {
        (mut states).push(session(f, n))
    }
    let path = state_path(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    assert(same(read_all("{path}.prev"), states[3]), "the last session's state is .prev")
    assert(same(read_all("{path}.prev.2"), states[2]), "the one before is .prev.2")
    assert(same(read_all("{path}.prev.3"), states[1]), "the one before that is .prev.3")
    assert(!exists("{path}.prev.4"), "no fourth copy")
    assert(same(read_all(path), states[3]), "the state file itself is untouched")
    edit.state_dispose(mut ed)
}

// A workspace with no state yet keeps no copy.
fn first_session_keeps_nothing() {
    let f = fixture()
    defer finish(f)
    let path = state_path(f)
    var ed = fresh(f)
    edit.state_open(mut ed)
    assert(ed.state.writer, "the first session writes")
    assert(!exists("{path}.prev"), "a first session keeps no copy")
    edit.state_dispose(mut ed)
}

// A session that cannot claim the workspace keeps no copy: the lease names
// pid 1, alive and not this editor, so this session is a reader.
fn reader_keeps_nothing() {
    let f = fixture()
    defer finish(f)
    let _ = session(f, 3)
    let path = state_path(f)
    var ed = fresh(f)
    assert(ws.ws_key(mut ed.state.key, ed.ws_dir), "the workspace has a key")
    assert(
        text.file_write_atomic(ws.ws_lock_path(ed.state.key), "1\n".bytes(), 384) == text.SAVE_OK,
    )
    edit.state_open(mut ed)
    assert(ed.state.ready && !ed.state.writer, "this session reads")
    assert(!exists("{path}.prev"), "a reader keeps no copy")
    edit.state_dispose(mut ed)
}

fn run(i: int) {
    match i {
        0 => open_keeps_the_found_state(),
        1 => three_generations(),
        2 => first_session_keeps_nothing(),
        3 => reader_keeps_nothing(),
        _ => return,
    }
    print("state_prev: case {i}: PASS")
}

fn main() {
    let pick = env_get("YEW_STATE_PREV_CASE") else ""
    if pick.len != 0 {
        run(pick.to_int() else -1)
    } else {
        for i in 0..4 {
            run(i)
        }
    }
}
