fn t_case_151() {
    var f = flfix.open()
    case(
        mut f,
        151,
        "let ok = true\n  let i = 0\n  while i < 200 {{\n    let p = \"x\" + str.repeat(\"y\", i % 40) + \"z\"\n    if re.test(p, p, \"l\") == false {{ ok = false }}\n    if re.test(\"no\", p) == true {{ ok = false }}\n    i = i + 1\n  }}\n  return ok",
        "74727565",
    )
    flfix.close(mut f)
}

fn t_case_152() {
    var f = flfix.open()
    case(
        mut f,
        152,
        "let pats = []\n  let i = 0\n  while i < 130 {{\n    list.push(pats, \"(a)\" + str.repeat(\"b\", i) + \"c\")\n    i = i + 1\n  }}\n  let out = []\n  for p in pats {{ list.push(out, re.find(\"a\" + str.repeat(\"b\", 3) + \"c\", p) != nil) }}\n  for p in pats {{ list.push(out, re.test(\"zz\", p)) }}\n  return list.len(list.filter(out, fn(x) {{ return x }}))",
        "31",
    )
    flfix.close(mut f)
}

