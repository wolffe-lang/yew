//! member: false
//!
//! The port of sagitta `tests/unit/test_jumplist.c` (426 lines), one test
//! per C test in registry order (`tests/unit/registry.c:2573-2590`). C's
//! fixture is `yew_ed_init` + `yew_ed_open_scratch` and ten lines of
//! "aaaa\n" inserted through the edit context, the change list then
//! re-initialized (`test_jumplist.c:22-37`); the port's is `edit.ed_new`
//! + `edit.ed_open_scratch` and the same inserts through the editor's
//! seam (`edit.ed_edit_insert`), the context's change list replaced by a
//! fresh one. C's `yew_ws_scratch_new` + `yew_ed_show_buffer` is
//! `edit.ed_open_memory`; C's `yew_ws_scratch_drop` frees the buffer and
//! its marks, which the port (no buffer is ever removed before yw06's
//! workspace) does by emptying the buffer's mark set, the state the walk
//! reads. C's second window over one buffer is a second `Win` in
//! `ed.wins`. The peer-window half of
//! `changelist_is_fed_by_the_edit_chokepoint` splits a pane
//! (`yew_pane_split`, Sprint 22): SKIP by name, yw05.

use edit
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

// `jl_fixture` (`test_jumplist.c:22-37`).
fn fixture() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    let line = bytes_of("aaaa\n")
    var i = 0
    while i < 10 {
        assert(edit.ed_edit_insert(mut ed, ed.win, i * 5, line, 0, line.len), "fixture insert {i}")
        i += 1
    }
    let b = ed.wins[ed.win].buf
    ed.bufs[b].ec.changes = text.changelist_new()
    ed
}

fn w0(ed: edit.Ed) -> int {
    ed.win
}

fn buf0(ed: edit.Ed) -> int {
    ed.wins[ed.win].buf
}

// `jl_pos` (`test_jumplist.c:39-47`).
fn jl_pos(ed: edit.Ed, jl: text.JumpList, index: int) -> int {
    let je = text.jumplist_at(jl, index) else |_| {
        assert(false, "no entry {index}")
        return 0
    }
    text.mark_pos(ed.bufs[buf0(ed)].ec.marks, je.mark) as int
}

fn set_cursor(mut ed: edit.Ed, pos: int) {
    let w = ed.win
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].pos = pos
    ed.wins[w].cs.curs[p].anchor = pos
}

fn cursor(ed: edit.Ed) -> int {
    edit.ed_cursor_pos(ed)
}

fn t_jumplist_push_appends_in_order() {
    var ed = fixture()
    let w = w0(ed)
    edit.jump_push(mut ed, w, 0, 100)
    edit.jump_push(mut ed, w, 10, 200)
    edit.jump_push(mut ed, w, 20, 300)
    assert(text.jumplist_len(ed.wins[w].jumps) == 3, "three entries")
    assert(jl_pos(ed, ed.wins[w].jumps, 0) == 0, "entry 0")
    assert(jl_pos(ed, ed.wins[w].jumps, 1) == 10, "entry 1")
    assert(jl_pos(ed, ed.wins[w].jumps, 2) == 20, "entry 2")
    // Not walking: cur sits one past the newest.
    assert(ed.wins[w].jumps.cur == 3, "cur at now")
}

// Rule 2.
fn t_jumplist_push_same_position_is_noop() {
    var ed = fixture()
    let w = w0(ed)
    edit.jump_push(mut ed, w, 10, 100)
    edit.jump_push(mut ed, w, 10, 200)
    assert(text.jumplist_len(ed.wins[w].jumps) == 1, "one entry")
}

// Rule 1: same line replaces, and the newer column wins.
fn t_jumplist_push_same_line_replaces_keeping_new_column() {
    var ed = fixture()
    let w = w0(ed)
    edit.jump_push(mut ed, w, 0, 100)
    edit.jump_push(mut ed, w, 10, 200)
    edit.jump_push(mut ed, w, 13, 300)
    assert(text.jumplist_len(ed.wins[w].jumps) == 2, "two entries")
    assert(jl_pos(ed, ed.wins[w].jumps, 1) == 13, "the newer column")
}

// Rule 3: the first step back records where we stood.
fn t_jumplist_first_back_pushes_current_position() {
    var ed = fixture()
    let w = w0(ed)
    edit.jump_push(mut ed, w, 0, 100)
    edit.jump_push(mut ed, w, 10, 200)
    set_cursor(mut ed, 40)
    assert(edit.jump_back(mut ed, w, 1), "back")
    assert(cursor(ed) == 10, "at 10")
    assert(text.jumplist_len(ed.wins[w].jumps) == 3, "40 recorded on the way out")
    assert(edit.jump_fwd(mut ed, w, 1), "forward")
    assert(cursor(ed) == 40, "home at 40")
}

fn t_jumplist_back_and_forward_walk_by_count() {
    var ed = fixture()
    let w = w0(ed)
    edit.jump_push(mut ed, w, 0, 100)
    edit.jump_push(mut ed, w, 10, 200)
    edit.jump_push(mut ed, w, 20, 300)
    set_cursor(mut ed, 45)
    assert(edit.jump_back(mut ed, w, 2), "back 2")
    assert(cursor(ed) == 10, "at 10")
    assert(edit.jump_fwd(mut ed, w, 2), "forward 2")
    assert(cursor(ed) == 45, "at 45")
}

// Rule 4: browser history, not rotation.
fn t_jumplist_push_after_walk_truncates_forward_tail() {
    var ed = fixture()
    let w = w0(ed)
    edit.jump_push(mut ed, w, 0, 100)
    edit.jump_push(mut ed, w, 10, 200)
    edit.jump_push(mut ed, w, 20, 300)
    set_cursor(mut ed, 45)
    assert(edit.jump_back(mut ed, w, 2), "back 2")
    edit.jump_push(mut ed, w, 30, 400)
    // 0, 10 survive; 20 and 45 were ahead of the walk position.
    assert(text.jumplist_len(ed.wins[w].jumps) == 3, "three entries")
    assert(jl_pos(ed, ed.wins[w].jumps, 2) == 30, "30 newest")
    assert(!edit.jump_fwd(mut ed, w, 1), "no forward tail")
}

fn t_jumplist_walk_past_the_ends_reports_and_does_not_move() {
    var ed = fixture()
    let w = w0(ed)
    assert(!edit.jump_back(mut ed, w, 1), "empty: no back")
    assert(!edit.jump_fwd(mut ed, w, 1), "empty: no forward")
    edit.jump_push(mut ed, w, 10, 100)
    set_cursor(mut ed, 40)
    assert(edit.jump_back(mut ed, w, 1), "back")
    assert(cursor(ed) == 10, "at 10")
    assert(!edit.jump_back(mut ed, w, 1), "already at the oldest")
    assert(cursor(ed) == 10, "still at 10")
}

fn t_jumplist_ring_wraps_at_exactly_100() {
    var ed = fixture()
    let w = w0(ed)
    var i = 0
    while i < 120 {
        edit.jump_push(mut ed, w, i % 10 * 5, i)
        i += 1
    }
    assert(text.jumplist_len(ed.wins[w].jumps) == text.JUMPLIST_MAX, "full at 100")
    // The oldest 20 fell off: entry 0 is push #20, on line 0.
    assert(jl_pos(ed, ed.wins[w].jumps, 0) == 0, "entry 0 is push 20")
    assert(
        jl_pos(ed, ed.wins[w].jumps, text.JUMPLIST_MAX - 1) == 119 % 10 * 5,
        "newest is push 119",
    )
}

// An edit ABOVE a recorded position carries it along.
fn t_jumplist_entries_follow_edits_above_them() {
    var ed = fixture()
    let w = w0(ed)
    edit.jump_push(mut ed, w, 25, 100)
    let z = bytes_of("zzzz\n")
    assert(edit.ed_edit_insert(mut ed, w, 0, z, 0, z.len), "insert above")
    assert(jl_pos(ed, ed.wins[w].jumps, 0) == 30, "moved by 5")
}

// Rule 5: a dead entry is dropped, not stepped onto.
fn t_jumplist_dead_marks_are_skipped_and_dropped() {
    var ed = fixture()
    let w = w0(ed)
    let first = buf0(ed)
    edit.jump_push(mut ed, w, 0, 100)
    edit.ed_open_memory(mut ed, List[byte](), "*other*")
    let scratch = buf0(ed)
    assert(scratch != first, "the scratch buffer is shown")
    edit.jump_push(mut ed, w, 0, 200)
    assert(text.jumplist_len(ed.wins[w].jumps) == 2, "two entries")
    let je = text.jumplist_at(ed.wins[w].jumps, 1) else text.jump_entry_zero()
    assert(je.buf_id == ed.bufs[scratch].id, "entry 1 is the scratch buffer's")
    edit.ed_show_buffer(mut ed, first)
    // C's `yew_ws_scratch_drop`: the buffer and its marks are gone.
    ed.bufs[scratch].ec.marks = text.marks_new()
    set_cursor(mut ed, 40)
    assert(edit.jump_back(mut ed, w, 1), "back past the dead entry")
    assert(cursor(ed) == 0, "landed on the survivor")
    assert(text.jumplist_len(ed.wins[w].jumps) == 2, "dead dropped, 40 recorded")
}

fn changes_len(ed: edit.Ed) -> int {
    ed.bufs[buf0(ed)].ec.changes.ring.len
}

// DoD 10 pins the 499/501 boundary.
fn t_changelist_coalesces_within_the_time_window() {
    var ed = fixture()
    let b = buf0(ed)
    edit.change_record(mut ed, b, 0, 1000)
    edit.change_record(mut ed, b, 10, 1499)
    assert(changes_len(ed) == 1, "499 ms coalesces")
    edit.change_record(mut ed, b, 20, 2000)
    assert(changes_len(ed) == 2, "501 ms does not")
}

fn t_changelist_does_not_coalesce_past_the_window() {
    var ed = fixture()
    let b = buf0(ed)
    edit.change_record(mut ed, b, 0, 1000)
    edit.change_record(mut ed, b, 10, 1501)
    assert(changes_len(ed) == 2, "501 ms is two")
}

fn t_changelist_coalesces_on_the_same_line_regardless_of_time() {
    var ed = fixture()
    let b = buf0(ed)
    edit.change_record(mut ed, b, 15, 1000)
    edit.change_record(mut ed, b, 18, 9999999)
    assert(changes_len(ed) == 1, "same line, hours apart")
    edit.change_record(mut ed, b, 30, 19999999)
    assert(changes_len(ed) == 2, "another line, far apart")
}

fn t_changelist_walks_older_and_newer() {
    var ed = fixture()
    let w = w0(ed)
    let b = buf0(ed)
    edit.change_record(mut ed, b, 0, 1000)
    edit.change_record(mut ed, b, 20, 5000)
    edit.change_record(mut ed, b, 40, 9000)
    set_cursor(mut ed, 45)
    assert(edit.change_older(mut ed, w, 1), "older")
    assert(cursor(ed) == 40, "at 40")
    assert(edit.change_older(mut ed, w, 1), "older again")
    assert(cursor(ed) == 20, "at 20")
    assert(edit.change_newer(mut ed, w, 1), "newer")
    assert(cursor(ed) == 40, "back at 40")
}

// The edit choke point feeds the change list: nothing calls
// `change_record` here.
fn t_changelist_is_fed_by_the_edit_chokepoint() {
    var ed = fixture()
    let w = w0(ed)
    let x = bytes_of("x")
    let y = bytes_of("y")
    ed.now_ms = 1000
    assert(edit.ed_edit_insert(mut ed, w, 0, x, 0, 1), "insert x")
    assert(changes_len(ed) == 1, "one change")
    ed.now_ms = 90000
    assert(edit.ed_edit_insert(mut ed, w, 30, y, 0, 1), "insert y")
    assert(changes_len(ed) == 2, "a far-away edit, long after")
    print(
        "SKIP: changelist_is_fed_by_the_edit_chokepoint: the peer-window half splits a pane (yew_pane_split, sagitta Sprint 22, yw05)",
    )
}

// Two views of one buffer keep separate jump lists and share one change
// list.
fn t_jumplist_is_per_window_changelist_is_per_buffer() {
    var ed = fixture()
    let w = w0(ed)
    let b = buf0(ed)
    (mut ed.wins).push(edit.win_new(99, b))
    let other = ed.wins.len - 1
    edit.jump_push(mut ed, w, 0, 100)
    edit.jump_push(mut ed, w, 10, 200)
    edit.jump_push(mut ed, other, 20, 300)
    assert(text.jumplist_len(ed.wins[w].jumps) == 2, "the first window's two")
    assert(text.jumplist_len(ed.wins[other].jumps) == 1, "the other window's one")
    edit.change_record(mut ed, ed.wins[other].buf, 35, 1000)
    assert(ed.bufs[ed.wins[w].buf].ec.changes.ring.len == 1, "one change list through either")
    assert(ed.wins[w].buf == ed.wins[other].buf, "one buffer")
}

// DoD 11's other half: the serializer round-trips in memory.
fn t_jumplist_serializer_round_trips_in_memory() {
    var ed = fixture()
    let w = w0(ed)
    edit.jump_push(mut ed, w, 0, 100)
    edit.jump_push(mut ed, w, 12, 200)
    edit.jump_push(mut ed, w, 27, 300)
    let out = edit.jumplist_serialize(ed.wins[w].jumps, ed)
    assert(out.len > 0, "bytes")
    let (ok, back) = edit.jumplist_deserialize(out)
    assert(ok, "deserialized")
    assert(text.jumplist_len(back) == 3, "three back")
    let e0 = text.jumplist_at(back, 0) else text.jump_entry_zero()
    let e1 = text.jumplist_at(back, 1) else text.jump_entry_zero()
    let e2 = text.jumplist_at(back, 2) else text.jump_entry_zero()
    assert(e0.line_hint == 0, "line 0")
    assert(e1.line_hint == 2, "line 2")
    assert(e2.line_hint == 5, "line 5")
    assert(e2.stamp_ms == 300, "stamp 300")
    // A walk position is never "mid-walk" after a load.
    assert(back.cur == back.len, "standing at now")
}

fn t_jumplist_deserialize_rejects_a_foreign_blob() {
    let (ok, back) = edit.jumplist_deserialize(bytes_of("nope\n"))
    assert(!ok, "refused")
    assert(text.jumplist_len(back) == 0, "empty")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_jumplist_push_appends_in_order()
    t_jumplist_push_same_position_is_noop()
    t_jumplist_push_same_line_replaces_keeping_new_column()
    t_jumplist_first_back_pushes_current_position()
    t_jumplist_back_and_forward_walk_by_count()
    t_jumplist_push_after_walk_truncates_forward_tail()
    t_jumplist_walk_past_the_ends_reports_and_does_not_move()
    t_jumplist_ring_wraps_at_exactly_100()
    t_jumplist_entries_follow_edits_above_them()
    t_jumplist_dead_marks_are_skipped_and_dropped()
    t_changelist_coalesces_within_the_time_window()
    t_changelist_does_not_coalesce_past_the_window()
    t_changelist_coalesces_on_the_same_line_regardless_of_time()
    t_changelist_walks_older_and_newer()
    t_changelist_is_fed_by_the_edit_chokepoint()
    t_jumplist_is_per_window_changelist_is_per_buffer()
    t_jumplist_serializer_round_trips_in_memory()
    t_jumplist_deserialize_rejects_a_foreign_blob()
    print("jumplist_test: 18 cases run, 1 SKIP by name (the peer-window half, yw05)")
}
