//! member: false
//! Ports sagitta tests/unit/test_ws_key.c:36-357 at 9ace98c2, the eleven
//! registry.c:1824-1834 cases in order. Plus clean-before-I/O and 0700.

use edit
use text
use util
use ws

struct Fix { root: str, work: str, saved: str, had: bool }

fn fixture() -> Fix {
    let saved = env_get("XDG_STATE_HOME") else ""
    let had = saved.len != 0
    assert(util.mkdirs("target/ws-key-fixtures", 448))
    var root = ""
    loop {
        var suffix = ""
        for r in os_random(8) { suffix = "{suffix}{r % 10}" }
        root = "target/ws-key-fixtures/{suffix}"
        fs_create_dir_mode(root, 448) else |e| match e {
            exists => { continue },
            _ => { assert(false, "mkdir fixture: {e}") },
        }
        break
    }
    root = fs_realpath(root) else {
        assert(false)
        return Fix { root: "", work: "", saved: "", had: false }
    }
    let work = "{root}/work"
    assert(util.mkdirs(work, 448))
    env_set("XDG_STATE_HOME", "{root}/state") else { assert(false) }
    Fix { root: root, work: work, saved: saved, had: had }
}

fn remove_tree(path: str) {
    let entries = fs_read_dir(path) else { return }
    for name in entries {
        let p = "{path}/{name}"
        fs_remove(p) else |_| {
            remove_tree(p)
            fs_remove_dir(p) else { assert(false, "remove dir {p}") }
        }
    }
}

fn finish(f: Fix) {
    if f.had {
        env_set("XDG_STATE_HOME", f.saved) else { assert(false) }
    } else {
        env_unset("XDG_STATE_HOME") else { assert(false) }
    }
    remove_tree(f.root)
    fs_remove_dir(f.root) else { assert(false) }
}

fn plant(f: Fix, hash: wrapping[u64], probe: int, owner: str) {
    let hex = text.hex16(hash)
    let suffix = if probe == 0 then hex else "{hex}-{probe}"
    let dir = "{f.root}/state/yew/workspaces/{suffix}"
    assert(util.mkdirs(dir, 448))
    let line = "{owner}\n"
    assert(text.file_write_atomic("{dir}/path", line.bytes(), 384) == text.SAVE_OK)
}

fn t_ws_key_hash_matches_the_published_vectors() {
    assert(text.hex16(ws.fnv1a64("".bytes())) == "cbf29ce484222325")
    assert(text.hex16(ws.fnv1a64("a".bytes())) == "af63dc4c8601ec8c")
    assert(text.hex16(ws.fnv1a64("foobar".bytes())) == "85944171f73967e8")
    let bad = [195 as byte, 40 as byte, 0 as byte, 255 as byte]
    assert(ws.fnv1a64(bad) != 0)
    assert(ws.fnv1a64(bad) != ws.fnv1a64(bad[0..2]))
}

fn t_ws_key_is_stable_across_calls() {
    let f = fixture()
    defer finish(f)
    var a = ws.ws_key_empty(), b = ws.ws_key_empty()
    assert(ws.ws_key(mut a, f.work))
    assert(ws.ws_key(mut b, f.work))
    assert(a.hash == b.hash && a.dir == b.dir && a.realpath == b.realpath && !a.stateless)
    assert(ws.ws_key(mut b, "{f.work}/./"))
    assert(a.hash == b.hash && a.dir == b.dir)
}

fn t_ws_key_paths_hang_off_the_state_dir() {
    let f = fixture()
    defer finish(f)
    var k = ws.ws_key_empty()
    assert(ws.ws_key(mut k, f.work))
    assert(ws.ws_state_path(k) == "{k.dir}state.fl")
    assert(ws.ws_undo_dir(k) == "{k.dir}undo/")
    assert(ws.ws_lock_path(k) == "{k.dir}lock")
    assert(!ws.ws_state_path(k).contains(f.work))
}

fn t_ws_key_writes_the_path_record() {
    let f = fixture()
    defer finish(f)
    var k = ws.ws_key_empty()
    assert(ws.ws_key(mut k, f.work))
    assert(ws.ws_ensure_dir(mut k))
    let bytes = fs_read_bytes("{k.dir}path") else { assert(false); return }
    let line = str_from_utf8(bytes) else { assert(false); return }
    assert(line == "{k.realpath}\n")
    let stat = fs_stat(k.dir) else { assert(false); return }
    assert(stat[4] & 511 == 448, "workspace mode 0700")
}

fn t_ws_key_walks_past_a_collision() {
    let f = fixture()
    defer finish(f)
    var k = ws.ws_key_empty()
    assert(ws.ws_key(mut k, f.work))
    plant(f, k.hash, 0, "/some/other/workspace")
    assert(ws.ws_key(mut k, f.work))
    assert(k.probe == 1 && !k.stateless && k.dir.contains("-1/"))
    plant(f, k.hash, 1, k.realpath)
    assert(ws.ws_key(mut k, f.work) && k.probe == 1)
}

fn t_ws_key_takes_the_first_free_probe() {
    let f = fixture()
    defer finish(f)
    var k = ws.ws_key_empty()
    assert(ws.ws_key(mut k, f.work))
    for i in 0..4 { plant(f, k.hash, i, "/not/us") }
    assert(ws.ws_key(mut k, f.work) && k.probe == 4)
}

fn t_ws_key_exhausted_probes_run_stateless() {
    let f = fixture()
    defer finish(f)
    var k = ws.ws_key_empty()
    assert(ws.ws_key(mut k, f.work))
    for i in 0..16 { plant(f, k.hash, i, "/not/us") }
    assert(!ws.ws_key(mut k, f.work) && k.stateless)
    assert(ws.ws_state_path(k) == "" && !ws.ws_ensure_dir(mut k))
}

fn t_ws_key_empty_path_record_is_free() {
    let f = fixture()
    defer finish(f)
    var k = ws.ws_key_empty()
    assert(ws.ws_key(mut k, f.work))
    assert(util.mkdirs(k.dir, 448))
    assert(text.file_write_atomic("{k.dir}path", "".bytes(), 384) == text.SAVE_OK)
    assert(ws.ws_key(mut k, f.work) && k.probe == 0)
}

fn t_ws_key_without_a_state_home_is_stateless() {
    let f = fixture()
    defer finish(f)
    let home = env_get("HOME") else ""
    env_unset("XDG_STATE_HOME") else { assert(false) }
    env_unset("HOME") else { assert(false) }
    var k = ws.ws_key_empty()
    assert(!ws.ws_key(mut k, f.work) && k.stateless)
    if home.len != 0 { env_set("HOME", home) else { assert(false) } }
}

fn t_ws_key_refuses_an_unresolvable_path() {
    let f = fixture()
    defer finish(f)
    var k = ws.ws_key_empty()
    assert(!ws.ws_key(mut k, "{f.work}/not-there") && k.stateless)
    assert(!ws.ws_key(mut k, ""))
}

fn t_ws_key_root_override_requires_and_canonicalizes_a_directory() {
    let f = fixture()
    defer finish(f)
    var ed = edit.ed_new()
    assert(edit.ed_set_workspace_root(mut ed, "{f.work}/./"))
    assert(edit.ws_root(ed) == f.work)
    assert(text.file_write_atomic("{f.work}/file", "".bytes(), 384) == text.SAVE_OK)
    assert(!edit.ed_set_workspace_root(mut ed, "{f.work}/file"))
    assert(!edit.ed_set_workspace_root(mut ed, "{f.work}/absent"))
    assert(edit.ws_root(ed) == f.work)
}

fn main() {
    let args = env_args()
    let only = if args.len > 0 then (args[0].to_int() else -1) else -1
    let names = "ws_key_hash_matches_the_published_vectors|ws_key_is_stable_across_calls|ws_key_paths_hang_off_the_state_dir|ws_key_writes_the_path_record|ws_key_walks_past_a_collision|ws_key_takes_the_first_free_probe|ws_key_exhausted_probes_run_stateless|ws_key_empty_path_record_is_free|ws_key_without_a_state_home_is_stateless|ws_key_refuses_an_unresolvable_path|ws_key_root_override_requires_and_canonicalizes_a_directory".
        split("|")
    for i in 0..11 {
        if only >= 0 && only != i { continue }
        match i {
            0 => t_ws_key_hash_matches_the_published_vectors(),
            1 => t_ws_key_is_stable_across_calls(),
            2 => t_ws_key_paths_hang_off_the_state_dir(),
            3 => t_ws_key_writes_the_path_record(),
            4 => t_ws_key_walks_past_a_collision(),
            5 => t_ws_key_takes_the_first_free_probe(),
            6 => t_ws_key_exhausted_probes_run_stateless(),
            7 => t_ws_key_empty_path_record_is_free(),
            8 => t_ws_key_without_a_state_home_is_stateless(),
            9 => t_ws_key_refuses_an_unresolvable_path(),
            _ => t_ws_key_root_override_requires_and_canonicalizes_a_directory(),
        }
        print("{names[i]}: PASS")
    }
    var clean = ws.ws_key_empty()
    assert(!ws.ws_key_session(mut clean, "never-resolve-clean", true))
    assert(clean.stateless && clean.realpath == "" && clean.dir == "")
    print("ws_key clean-before-I/O: PASS")
}
