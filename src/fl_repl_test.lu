//! member: false
//! Ports sagitta 9ace98c2 tests/unit/test_fl_repl.c:1-428, all ten
//! cases in tests/unit/registry.c:1874-1883 order.

use fl
use flfix
use flcli

fn verdict(mut f: flfix.FlFix, src: str) -> int {
    fl.fl_repl_classify(mut f.vm.strings, src.bytes())
}

fn fl_repl_classifies_the_s29_matrix() {
    var f = flfix.open()
    assert(verdict(mut f, "1 + 1\n") == fl.FL_REPL_RUN)
    assert(verdict(mut f, "let x = 1\n") == fl.FL_REPL_RUN)
    assert(verdict(mut f, "fn f(x) {{ return x }}\n") == fl.FL_REPL_RUN)
    assert(verdict(mut f, "fn f(\n") == fl.FL_REPL_CONTINUE)
    assert(verdict(mut f, "fn f((\n") == fl.FL_REPL_CONTINUE)
    assert(verdict(mut f, "fn f(x) {{\n") == fl.FL_REPL_CONTINUE)
    assert(verdict(mut f, "[1, 2\n") == fl.FL_REPL_CONTINUE)
    assert(verdict(mut f, "1 +\n") == fl.FL_REPL_CONTINUE)
    assert(verdict(mut f, "1 +\n1\n") == fl.FL_REPL_RUN)
    assert(verdict(mut f, "fn f()}}\n") == fl.FL_REPL_ERROR)
    assert(verdict(mut f, "return )\n") == fl.FL_REPL_ERROR)
    assert(verdict(mut f, "let 5 = 1\n") == fl.FL_REPL_ERROR)
    flfix.close(mut f)
}

fn fl_repl_accumulates_a_nested_entry() {
    var f = flfix.open()
    let lines = [
        "fn outer(n) {{",
        "    let t = 0",
        "    for x in [1, 2, 3] {{",
        "        if x > n {{",
        "            t = t + x",
        "        }} else {{",
        "            t = t - x",
        "        }}",
        "    }}",
        "    return t",
        "}}",
        "outer(1)",
    ]
    var acc = ""
    for i in 0..lines.len {
        acc = "{acc}{lines[i]}\n"
        let v = verdict(mut f, acc)
        if i + 2 < lines.len { assert(v == fl.FL_REPL_CONTINUE, "entry line {i}") }
    }
    assert(verdict(mut f, acc) == fl.FL_REPL_RUN)
    flfix.close(mut f)
}

fn fl_repl_classifies_without_emitting() {
    var f = flfix.open()
    f.ndiag = 0
    let before = f.ndiag
    let files_before = f.vm.dc.files.len
    let entries_before = f.vm.dc.entries.len
    let _ = verdict(mut f, "fn f(\n")
    let _ = verdict(mut f, "fn f(x) {{\n")
    let _ = verdict(mut f, "return )\n")
    let _ = verdict(mut f, "let 5 = 1\n")
    assert(f.ndiag == before)
    assert(f.vm.dc.files.len == files_before)
    assert(f.vm.dc.entries.len == entries_before)
    flfix.close(mut f)
}

fn cmd(mut f: flfix.FlFix, mut r: flcli.FlRepl, line: str) -> (str, bool) {
    var out = List[byte]()
    let (recognized, quit) = flcli.repl_command(mut r, mut f.vm, line.bytes(), mut out)
    if !recognized { return ("<not a command>", quit) }
    (str_from_utf8(out) else "<invalid utf8>", quit)
}

fn fl_repl_recognises_only_a_leading_colon() {
    var f = flfix.open()
    var r = flcli.repl_new()
    let (a, _) = cmd(mut f, mut r, "1 + 1\n")
    assert(a == "<not a command>")
    let (b, _) = cmd(mut f, mut r, "let x = 1\n")
    assert(b == "<not a command>")
    let (c, _) = cmd(mut f, mut r, "   :caps\n")
    assert(c.contains("origin:"))
    flfix.close(mut f)
}

fn fl_repl_quits_and_helps() {
    var f = flfix.open()
    var r = flcli.repl_new()
    let (_, q) = cmd(mut f, mut r, ":quit\n")
    assert(q)
    let (_, q2) = cmd(mut f, mut r, ":q\n")
    assert(q2)
    let (help, q3) = cmd(mut f, mut r, ":help\n")
    assert(!q3)
    for name in [
        ":help",
        ":quit",
        ":load",
        ":reload",
        ":globals",
        ":disasm",
        ":caps",
        "no stepping debugger",
        "fletch-spec.md",
    ] { assert(help.contains(name)) }
    let (slice, _) = cmd(mut f, mut r, ":help str.slice\n")
    assert(slice.contains("(s, lo, [hi]) -> s"))
    let (repr, _) = cmd(mut f, mut r, ":help fmt.repr\n")
    assert(repr.contains("(v, [indent]) -> str"))
    let (missing, _) = cmd(mut f, mut r, ":help nope.nope\n")
    assert(missing.contains("no builtin called"))
    flfix.close(mut f)
}

fn fl_repl_suggests_over_the_command_names() {
    var f = flfix.open()
    var r = flcli.repl_new()
    let (a, _) = cmd(mut f, mut r, ":gloabls\n")
    assert(a.contains("unknown command ':gloabls'"))
    assert(a.contains("did you mean 'globals'?"))
    let (b, _) = cmd(mut f, mut r, ":relaod\n")
    assert(b.contains("did you mean 'reload'?"))
    let (c, _) = cmd(mut f, mut r, ":zzzzzzz\n")
    assert(c.contains("unknown command"))
    assert(!c.contains("did you mean"))
    assert(!c.contains("; \n"))
    flfix.close(mut f)
}

fn fl_repl_shows_globals_and_caps() {
    var f = flfix.open()
    var r = flcli.repl_new()
    let (a, _) = cmd(mut f, mut r, ":globals\n")
    assert(a.contains("(none yet)"))
    let _ = flfix.run_bytes(mut f, "import str\nlet total = 41\nlet name = \"a\"\n")
    let (b, _) = cmd(mut f, mut r, ":globals\n")
    assert(b.contains("total = 41"))
    assert(b.contains("name = \"a\""))
    assert(!b.contains("str ="))
    let (c, _) = cmd(mut f, mut r, ":caps\n")
    assert(c.contains("origin:"))
    assert(c.contains("(none)"))
    flfix.set_origin(mut f, fl.FL_ORIGIN_REPL, fl.FL_CAP_FS_READ | fl.FL_CAP_NET)
    f.vm.root_origin = copy f.origin
    let (d, _) = cmd(mut f, mut r, ":caps\n")
    assert(d.contains("fs.read"))
    assert(d.contains("net"))
    assert(!d.contains("fs.write"))
    flfix.close(mut f)
}

fn fl_repl_disassembles_and_loads() {
    var f = flfix.open()
    var r = flcli.repl_new()
    let (a, _) = cmd(mut f, mut r, ":disasm\n")
    assert(a.contains("needs a name"))
    let (b, _) = cmd(mut f, mut r, ":disasm nope\n")
    assert(b.contains("no function called 'nope'"))
    let _ = flfix.run_bytes(mut f, "fn twice(x) {{ return x + x }}\n")
    let (c, _) = cmd(mut f, mut r, ":disasm twice\n")
    assert(c.contains("ADD"))
    assert(c.contains("RETURN"))
    let path = flfix.tmpdir(mut f)
    flfix.write(mut f, "cfg.fl", "let tabwidth = 4\n")
    let (d, _) = cmd(mut f, mut r, ":load {path}/cfg.fl\n")
    assert(d.contains("loaded"))
    let (e, _) = cmd(mut f, mut r, ":globals\n")
    assert(e.contains("tabwidth = 4"))
    flfix.write(mut f, "cfg.fl", "let tabwidth = 8\n")
    let (g, _) = cmd(mut f, mut r, ":reload\n")
    assert(g.contains("loaded"))
    let (h, _) = cmd(mut f, mut r, ":globals\n")
    assert(h.contains("tabwidth = 8"))
    let (missing, _) = cmd(mut f, mut r, ":load /definitely/not/here.fl\n")
    assert(missing.contains("cannot read"))
    flfix.close(mut f)
    var fresh = flfix.open()
    var fresh_r = flcli.repl_new()
    let (reload, _) = cmd(mut fresh, mut fresh_r, ":reload\n")
    assert(reload.contains("nothing has been"))
    flfix.close(mut fresh)
}

fn fl_repl_prints_repr_and_nothing_for_nil() {
    var f = flfix.open()
    var out = List[byte]()
    flcli.print_result_into(mut f.vm, fl.fl_nil(), mut out)
    assert(out.len == 0)
    let s = fl.fl_str_text(mut f.vm, "a\nb")
    flcli.print_result_into(mut f.vm, s, mut out)
    assert(out.len == 7)
    assert((str_from_utf8(out) else "") == "\"a\\nb\"\n")
    (mut out).reset()
    flcli.print_result_into(mut f.vm, fl.fl_int(42), mut out)
    assert((str_from_utf8(out) else "") == "42\n")
    flfix.close(mut f)
}

fn fl_repl_bounds_what_it_prints() {
    var f = flfix.open()
    var out = List[byte]()
    let l = fl.fl_list_new(mut f.vm)
    fl.fl_gc_protect(mut f.vm, l)
    fl.fl_list_push(mut f.vm, l, l)
    flcli.print_result_into(mut f.vm, l, mut out)
    assert((str_from_utf8(out) else "") == "[[...]]\n")
    fl.fl_gc_release(mut f.vm, 1)
    (mut out).reset()
    let deep = fl.fl_list_new(mut f.vm)
    var cur = copy deep
    fl.fl_gc_protect(mut f.vm, deep)
    for _ in 0..20 {
        let next = fl.fl_list_new(mut f.vm)
        fl.fl_list_push(mut f.vm, cur, next)
        cur = next
    }
    flcli.print_result_into(mut f.vm, deep, mut out)
    fl.fl_gc_release(mut f.vm, 1)
    assert(out.len < 64)
    assert((str_from_utf8(out) else "").contains("[...]"))
    (mut out).reset()
    var big = List[byte]()
    for _ in 0..5000 { (mut big).push(120 as byte) }
    let s = fl.fl_str_new(mut f.vm, big)
    flcli.print_result_into(mut f.vm, s, mut out)
    assert(out.len < 2200)
    assert((str_from_utf8(out) else "").contains("more bytes)"))
    flfix.close(mut f)
}

fn main() {
    let which = (env_get("YEW_FL_REPL_CASE") else "-1").to_int() else -2
    if which == -1 || which == 0 {
        fl_repl_recognises_only_a_leading_colon()
        print("fl_repl_recognises_only_a_leading_colon: PASS")
    }
    if which == -1 || which == 1 {
        fl_repl_quits_and_helps()
        print("fl_repl_quits_and_helps: PASS")
    }
    if which == -1 || which == 2 {
        fl_repl_suggests_over_the_command_names()
        print("fl_repl_suggests_over_the_command_names: PASS")
    }
    if which == -1 || which == 3 {
        fl_repl_shows_globals_and_caps()
        print("fl_repl_shows_globals_and_caps: PASS")
    }
    if which == -1 || which == 4 {
        fl_repl_disassembles_and_loads()
        print("fl_repl_disassembles_and_loads: PASS")
    }
    if which == -1 || which == 5 {
        fl_repl_classifies_the_s29_matrix()
        print("fl_repl_classifies_the_s29_matrix: PASS")
    }
    if which == -1 || which == 6 {
        fl_repl_accumulates_a_nested_entry()
        print("fl_repl_accumulates_a_nested_entry: PASS")
    }
    if which == -1 || which == 7 {
        fl_repl_classifies_without_emitting()
        print("fl_repl_classifies_without_emitting: PASS")
    }
    if which == -1 || which == 8 {
        fl_repl_prints_repr_and_nothing_for_nil()
        print("fl_repl_prints_repr_and_nothing_for_nil: PASS")
    }
    if which == -1 || which == 9 {
        fl_repl_bounds_what_it_prints()
        print("fl_repl_bounds_what_it_prints: PASS")
    }
    if which == -1 { print("PASS fl_repl 10") }
}
