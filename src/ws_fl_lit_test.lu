//! member: false
//! sagitta 9ace98c2 src/ws/fl_parse.c:166-525, fl_emit.c:108-237;
//! tests/unit/test_state_corpus.c:730-803,925-1093,1135-1167.
//! Additional byte-key/extrema/cap probes guard the hand-codec interim.

use ws

fn equal(a: List[byte], b: List[byte]) -> bool {
    ws.fl_span_equal(a, ws.FlSpan { at: 0, len: a.len }, b, ws.FlSpan { at: 0, len: b.len })
}

fn valid(s: str) -> ws.FlDoc {
    let r = ws.fl_parse(s.bytes(), 0, s.len)
    assert(r.ok, "{r.err.line}:{r.err.col}: {r.err.msg}")
    copy r.doc
}

fn rejects(s: str) {
    let r = ws.fl_parse(s.bytes(), 0, s.len)
    assert(!r.ok && r.err.line >= 1 && r.err.col >= 1, "should reject: {s}")
}

fn t_all_bytes() {
    var bytes = List[byte]()
    for i in 0..256 { (mut bytes).push(i as byte) }
    var e = ws.fl_emit()
    ws.fl_map_open(mut e, false, "".bytes())
    ws.fl_str(mut e, true, bytes, bytes)
    ws.fl_nil(mut e, true, "".bytes())
    ws.fl_str(mut e, true, "empty".bytes(), "".bytes())
    ws.fl_map_close(mut e)
    let out = ws.fl_emit_finish(take e)
    let r = ws.fl_parse(out, 0, out.len)
    assert(r.ok, r.err.msg)
    let node = ws.fl_get(r.doc, r.doc.root, bytes) else -1
    let value = ws.fl_string_bytes(r.doc, node) else List[byte]()
    assert(equal(value, bytes))
    let nil = ws.fl_get(r.doc, r.doc.root, "".bytes()) else -1
    assert(r.doc.nodes[nil].kind == ws.FL_NIL)
    let empty = ws.fl_get(r.doc, r.doc.root, "empty".bytes()) else -1
    assert((ws.fl_string_span(r.doc, empty) else ws.FlSpan { at: -1, len: -1 }).len == 0)
    let twice = ws.fl_reemit(r.doc)
    assert(equal(out, twice))
}

fn t_scalars_and_keys() {
    let d = valid(
        "{{ a: 1, b: 2, a: 3, \"UPPER\": 4, \"dot.key\": 5, \"\": nil, \"a\\0b\": true, }}",
    )
    assert(ws.fl_len(d, d.root) == 6)
    assert(ws.fl_int_or(d, ws.fl_get(d, d.root, "a".bytes()) else -1, 0) == 3)
    let out = ws.fl_reemit(d)
    assert(
        equal(
            out,
            "{{\n  a: 3,\n  b: 2,\n  \"UPPER\": 4,\n  \"dot.key\": 5,\n  \"\": nil,\n  \"a\\0b\": true,\n}}\n".
                bytes(),
        ),
    )
    let scalar = valid("-9223372036854775807")
    assert(ws.fl_int_or(scalar, scalar.root, 0) == -9223372036854775807)
    assert(equal(ws.fl_reemit(scalar), "-9223372036854775807\n".bytes()))
    for s in "9223372036854775807|0|-0|00012|-0012|true|false|nil|\"\\xFF\\x00\"".split("|") {
        let doc = valid(s)
        let out = ws.fl_reemit(doc)
        let twice = ws.fl_parse(out, 0, out.len)
        assert(twice.ok && equal(out, ws.fl_reemit(twice.doc)))
    }
    assert(ws.fl_len(d, -1) == 0 && ws.fl_int_or(d, -1, 9) == 9 && ws.fl_bool_or(d, -1, true))
    assert((ws.fl_get(d, -1, "x".bytes()) else -1) == -1)
    assert((ws.fl_at(d, d.root, 999) else -1) == -1)
}

fn t_syntax() {
    for s in "| |# only|+1|1.0|1e2|0x10|1_0|-|9223372036854775808|-9223372036854775809|18446744073709551616000000|[1 2]|[,]|{{:1}}|{{a:}}|{{a 1}}|[|{{|\"abc|\"\\q\"|\"\\xQ0\"|\"\\u{{41}}\"|nil true|nil,|truex".
        split("|") { rejects(s) }
    let d = valid("# before\r\n {{a: [1, # middle\n 2], b: true}} # end")
    assert(ws.fl_len(d, d.root) == 2)
    let r = ws.fl_parse("\n?".bytes(), 0, 2)
    assert(!r.ok && r.err.off == 1 && r.err.line == 2 && r.err.col == 1)
    let empty = ws.fl_parse("".bytes(), 0, 0)
    assert(!empty.ok && empty.err.off == 0 && empty.err.line == 1 && empty.err.col == 1)
    let bounds = ws.fl_parse("x".bytes(), -1, 9)
    assert(!bounds.ok)
}

fn t_caps() {
    var input = List[byte]()
    (mut input).push(34 as byte)
    for _ in 0..4096 { (mut input).push(97 as byte) }
    (mut input).push(34 as byte)
    assert(ws.fl_parse(input, 0, input.len).ok)
    input[input.len - 1] = 97 as byte
    (mut input).push(34 as byte)
    assert(!ws.fl_parse(input, 0, input.len).ok)
    var nested = List[byte]()
    for _ in 0..32 { (mut nested).push(91 as byte) }
    for _ in 0..32 { (mut nested).push(93 as byte) }
    assert(ws.fl_parse(nested, 0, nested.len).ok)
    nested[32] = 91 as byte
    (mut nested).push(93 as byte)
    (mut nested).push(93 as byte)
    assert(!ws.fl_parse(nested, 0, nested.len).ok)
}

fn t_duplicate_parent_scopes() {
    let d = valid("{{a: 1, nested: {{a: 2, a: 3,}}, a: 4,}}")
    let nested = ws.fl_get(d, d.root, "nested".bytes()) else -1
    assert(ws.fl_int_or(d, ws.fl_get(d, d.root, "a".bytes()) else -1, 0) == 4)
    assert(ws.fl_int_or(d, ws.fl_get(d, nested, "a".bytes()) else -1, 0) == 3)
    assert(ws.fl_len(d, d.root) == 2 && ws.fl_len(d, nested) == 1)
}

fn t_shipping_reader_edges() {
    rejects("-9223372036854775808")
    var e = ws.fl_emit()
    ws.fl_int(mut e, false, "".bytes(), -9223372036854775807 - 1)
    assert(equal(ws.fl_emit_finish(take e), "-9223372036854775808\n".bytes()))
    for word in "and|as|break|catch|continue|edit|else|false|fn|for|if|import|in|let|macro|nil|not|or|return|true|try|while".
        split("|") {
        let quoted = valid("{{\"{word}\":1,}}")
        let emitted = ws.fl_reemit(quoted)
        let r = ws.fl_parse(emitted, 0, emitted.len)
        assert(!r.ok, "shipping C rejects its bare reserved-key output: {word}")
        let bare = "{{{word}:1,}}"
        let r2 = ws.fl_parse(bare.bytes(), 0, bare.len)
        assert(!r2.ok && r2.err.line == 1 && r2.err.col == 2)
    }
}

fn main() {
    t_all_bytes()
    t_scalars_and_keys()
    t_syntax()
    t_caps()
    t_duplicate_parent_scopes()
    t_shipping_reader_edges()
    print("ws_fl_lit: byte values/keys, extrema, syntax, string/depth caps ok")
}
