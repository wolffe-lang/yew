//! member: false
//! The five tests/unit/test_fl_motion.c cases at sagitta 9ace98c2, in
//! registry order. C's fixture (test_fl_motion.c:10-73) is a headless VM
//! (flfix: no editor host, so nothing enlists) beside an editor with its
//! scratch buffer, and a record tap that copies each recordable dispatch:
//! the port's tap is a kind (R-yw07-10), `edit.TAP_LOG`, whose copies land
//! in `ed.reg.tap_log`. A program is a motion object built as C builds its
//! `FlMotionProg` from literal ops (motion_tab.c's dispatcher is the unit).

use edit
use fl
use text

// C's FL_MOTION_F_ALT and FL_MOTION_F_COUNT_GIVEN (fl/ast.h).
const ALT: int = 1
const GIVEN: int = 2

// mf_open's VM: flfix's, headless (no editor host: nothing enlists).
fn mf_vm() -> fl.FlVm {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    fl.fl_std_register(mut vm)
    vm
}

// mf_open's editor: the scratch buffer and the logging tap installed.
fn mf_ed() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    (mut ed.reg.tap_log).reset()
    edit.cmd_set_record_tap(mut ed.reg, edit.TAP_LOG)
    ed
}

fn op(kind: int, ch: int, flags: int, count: int, arg: int) -> fl.FlMotionOp {
    fl.FlMotionOp { kind: kind, ch: ch, flags: flags, count: count, arg: arg }
}

// motion_prog (test_fl_motion.c:66-73): the ops as one motion object.
fn motion_prog(mut vm: fl.FlVm, ops: List[fl.FlMotionOp]) -> fl.FlValue {
    let motion = fl.fl_gc_alloc(mut vm, fl.FL_MOTION_PROG, 32)
    let at = fl.fl_obj_index(vm, motion)
    for o in ops { (mut vm.gc.slots[at].ops).push(o) }
    motion
}

fn intern(mut vm: fl.FlVm, bytes: List[byte]) -> int {
    fl.fl_intern(mut vm.strings, bytes, 0, bytes.len)
}

fn word(ed: edit.Ed, i: int) -> str {
    let e = edit.cmd_entry(ed.reg, ed.reg.tap_log[i].id)
    assert(e.has_word, "a tapped command has a word")
    copy e.word
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

fn error_field(mut vm: fl.FlVm, key: str) -> str {
    if vm.err.t != fl.FL_MAP { return "" }
    let k = fl.fl_str_text(mut vm, key)
    let got = fl.fl_map_get(vm, vm.err, k) else { return "" }
    if got.t != fl.FL_STR { return "" }
    str_from_utf8(vm.gc.slots[fl.fl_obj_index(vm, got)].bytes) else ""
}

fn fl_motion_units_arrows_words_and_counts_use_cmdwords() {
    var vm = mf_vm()
    var ed = mf_ed()
    let home = intern(mut vm, "line_home".bytes())
    let prog = motion_prog(
        mut vm,
        [
            op(fl.FL_MK_UNIT, 108, 0, 1, 0),
            op(fl.FL_MK_UNIT, 119, 0, 1, 0),
            op(fl.FL_MK_UNIT, 98, 0, 1, 0),
            op(fl.FL_MK_UNIT, 99, 0, 1, 0),
            op(fl.FL_MK_ARROW, 62, GIVEN, 4, 0),
            op(fl.FL_MK_ARROW, 118, ALT, 1, 0),
            op(fl.FL_MK_WORD, 0, GIVEN, 1, home),
        ],
    )
    let wi = ed.win
    assert(edit.fl_motion_exec(mut vm, mut ed, wi, prog))
    let log = copy ed.reg.tap_log
    assert(log.len == 7, "seven taps, got {log.len}")
    assert(word(ed, 0) == "mode")
    assert(same(log[0].sarg, "L".bytes()))
    assert(same(log[1].sarg, "W".bytes()))
    assert(same(log[2].sarg, "B".bytes()))
    assert(same(log[3].sarg, "C".bytes()))
    assert(word(ed, 4) == "unit_next")
    assert(log[4].count == 4 && log[4].count_given)
    assert(word(ed, 5) == "unit_down_alt")
    assert(log[5].count == 1 && !log[5].count_given)
    assert(word(ed, 6) == "line_home")
    assert(log[6].count_given)
    assert(log[6].source == edit.SRC_FLETCH)
}

fn fl_motion_highlight_extent_escapes_before_following_word() {
    var vm = mf_vm()
    var ed = mf_ed()
    let prog = motion_prog(
        mut vm,
        [
            op(fl.FL_MK_HIGHLIGHT, 0, 0, 1, 1),
            op(fl.FL_MK_ARROW, 62, 0, 1, 0),
            op(fl.FL_MK_ARROW, 60, 0, 1, 0),
        ],
    )
    let wi = ed.win
    assert(edit.fl_motion_exec(mut vm, mut ed, wi, prog))
    assert(ed.reg.tap_log.len == 4, "four taps, got {ed.reg.tap_log.len}")
    assert(word(ed, 0) == "mode")
    assert(same(ed.reg.tap_log[0].sarg, "H".bytes()))
    assert(word(ed, 1) == "unit_next")
    assert(word(ed, 2) == "escape")
    assert(word(ed, 3) == "unit_prev")
}

fn fl_motion_insert_is_one_binary_safe_command() {
    var vm = mf_vm()
    var ed = mf_ed()
    let bytes = [97 as byte, 0 as byte, 98 as byte]
    let arg = intern(mut vm, bytes)
    let prog = motion_prog(mut vm, [op(fl.FL_MK_INSERT, 0, 0, 1, arg)])
    let wi = ed.win
    assert(edit.fl_motion_exec(mut vm, mut ed, wi, prog))
    assert(ed.reg.tap_log.len == 1, "one tap, got {ed.reg.tap_log.len}")
    assert(word(ed, 0) == "insert")
    assert(ed.reg.tap_log[0].sarg.len == 3)
    assert(same(ed.reg.tap_log[0].sarg, bytes))
    let bi = edit.ed_doc(ed)
    assert(same(text.textbuf_bytes(ed.bufs[bi].ec.tb), bytes))
}

fn fl_motion_del_and_esc_route_through_registry() {
    var vm = mf_vm()
    var ed = mf_ed()
    let prog = motion_prog(mut vm, [op(fl.FL_MK_DEL, 0, 0, 1, 0), op(fl.FL_MK_ESC, 0, 0, 1, 0)])
    let wi = ed.win
    assert(edit.fl_motion_exec(mut vm, mut ed, wi, prog))
    assert(ed.reg.tap_log.len == 2, "two taps, got {ed.reg.tap_log.len}")
    assert(word(ed, 0) == "delete_unit")
    assert(word(ed, 1) == "escape")
}

fn fl_motion_unknown_word_raises_name() {
    var vm = mf_vm()
    var ed = mf_ed()
    let arg = intern(mut vm, "no_such_word".bytes())
    let prog = motion_prog(mut vm, [op(fl.FL_MK_WORD, 0, 0, 1, arg)])
    let wi = ed.win
    assert(!edit.fl_motion_exec(mut vm, mut ed, wi, prog))
    assert(error_field(mut vm, "kind") == "name")
    assert(error_field(mut vm, "msg") == "no command has word 'no_such_word'")
    assert(ed.reg.tap_log.len == 0)
}

fn main() {
    fl_motion_units_arrows_words_and_counts_use_cmdwords()
    print("fl_motion_units_arrows_words_and_counts_use_cmdwords: PASS")
    fl_motion_highlight_extent_escapes_before_following_word()
    print("fl_motion_highlight_extent_escapes_before_following_word: PASS")
    fl_motion_insert_is_one_binary_safe_command()
    print("fl_motion_insert_is_one_binary_safe_command: PASS")
    fl_motion_del_and_esc_route_through_registry()
    print("fl_motion_del_and_esc_route_through_registry: PASS")
    fl_motion_unknown_word_raises_name()
    print("fl_motion_unknown_word_raises_name: PASS")
    print("fl_motion: 5 pinned cases PASS")
}
