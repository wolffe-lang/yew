//! member: false
//!
//! The port of sagitta `tests/unit/test_wordbreak.c` (104 lines), its one
//! test (`tests/unit/registry.c:814`): every row of Unicode 16.0.0's
//! `WordBreakTest.txt` (`ucd/16.0.0/`, read from the repository root as
//! C reads it) built into a buffer and every `÷`/`×` mark checked against
//! the UAX #29 oracle `edit.word_boundary`; 1,826 rows and 8,030 marks.

use edit
use std.fs
use text
use unicode

// `WB_EXPECTED_ROWS`, `WB_EXPECTED_MARKS` (`test_wordbreak.c:10-16`).
const EXPECTED_ROWS: int = 1826

const EXPECTED_MARKS: int = 8030

const BYTE_CAP: int = 512

const MARK_CAP: int = 256

fn hex_value(token: str) -> int {
    var value: int = 0
    if token.len == 0 {
        return -1
    }
    for b in token.bytes() {
        let c = b as int
        var digit = -1
        if c >= 48 && c <= 57 {
            digit = c - 48
        } else if c >= 65 && c <= 70 {
            digit = c - 55
        } else if c >= 97 && c <= 102 {
            digit = c - 87
        }
        if digit < 0 {
            return -1
        }
        value = value * 16 + digit
    }
    value
}

// `test_wordbreak_unicode_16_corpus` (`test_wordbreak.c:31-104`).
fn t_wordbreak_unicode_16_corpus() {
    let corpus = fs.read_text("ucd/16.0.0/WordBreakTest.txt") else ""
    assert(corpus.len > 0, "WordBreakTest.txt is readable from the repository root")
    var rows = 0
    var marks_total = 0
    for raw in corpus.lines() {
        var line = raw
        let hash = line.find("#") else -1
        if hash >= 0 {
            line = line[0..hash]
        }
        let tokens = line.words()
        if tokens.len == 0 {
            continue
        }
        region row {
            var bytes = List[byte]()
            var mark_pos = List[int]()
            var mark_break = List[bool]()
            var cp_count = 0
            var expect_marker = true
            for token in tokens {
                if expect_marker {
                    var is_break = false
                    if token == "\u{F7}" {
                        is_break = true
                    } else {
                        assert(token == "\u{D7}", "row {rows}: a mark is ÷ or ×, not '{token}'")
                    }
                    assert(mark_pos.len < MARK_CAP, "row {rows}: too many marks")
                    (mut mark_pos).push(bytes.len)
                    (mut mark_break).push(is_break)
                } else {
                    let value = hex_value(token)
                    assert(value >= 0 && value <= 1114111, "row {rows}: a codepoint, not '{token}'")
                    let encoded = unicode.utf8_encode_into(mut bytes, value)
                    assert(encoded > 0, "row {rows}: U+{token} encodes")
                    assert(bytes.len <= BYTE_CAP, "row {rows}: the row fits")
                    cp_count += 1
                }
                expect_marker = !expect_marker
            }
            assert(!expect_marker, "row {rows}: ends with a mark")
            assert(mark_pos.len == cp_count + 1, "row {rows}: a mark between every codepoint")
            let tb = text.textbuf_from_bytes(bytes, 0, bytes.len)
            var i = 0
            while i < mark_pos.len {
                assert(
                    edit.word_boundary(tb, mark_pos[i]) == mark_break[i],
                    "WordBreakTest row {rows + 1} mark {i} at byte {mark_pos[i]}: want break={mark_break[i]}",
                )
                i += 1
            }
            marks_total += mark_pos.len
        }
        rows += 1
    }
    assert(rows == EXPECTED_ROWS, "{rows} rows, sagitta's {EXPECTED_ROWS}")
    assert(marks_total == EXPECTED_MARKS, "{marks_total} marks, sagitta's {EXPECTED_MARKS}")
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_wordbreak_unicode_16_corpus()
    print("wordbreak_test: 1 case passes")
}
