//! member: false
//!
//! The port of sagitta `tests/unit/test_job.c` (1,531 lines), one test per
//! C test in registry order (`tests/unit/registry.c:1248-1300`, `:1579`;
//! `job_handover_inherits_stdio_and_reports_all_outcomes` is
//! `test_job_handover.c`'s, Sprint 52's, yw13). The tests play the loop as
//! C's do (`run_to_completion`, `run_until_released`,
//! `test_job.c:72-160`): wait on the jobs' descriptors with a deadline,
//! pump, reap, tick, settle. C's callback and stream owners are the job
//! layer's test witnesses (`CB_TEST`, `STREAM_TEST`), by key. Port-only
//! cases keep yw04's proofs of the synchronous route (the handover's
//! environment, exec failure against exit 127 against a signal, 500
//! cycles without a leak).
//!
//! Children, process groups and signals: it runs inside the container
//! (RULES §5). The checked machine answers `os_fork` `unsupported`, so the
//! one case whose stdin needs the forked writer SKIPs there, loudly.

use edit
use std.env as std_env
use std.fs
use std.signal
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn raw(xs: List[int]) -> List[byte] {
    var v = List[byte]()
    for x in xs {
        (mut v).push(x as byte)
    }
    v
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn argv_of(xs: List[str]) -> List[str] {
    var v = List[str]()
    for x in xs {
        (mut v).push(x)
    }
    v
}

/// An editor over `text` with its workspace root a fresh directory.
fn fixture(text: List[byte], tag: str) -> (edit.Ed, str) {
    let base = "/tmp/yew-job-{os_pid()}-{tag}"
    fs.remove_dir_all(base) else |_| {}
    fs.create_dir_all(base) else |_| { assert(false, "mkdir {base}") }
    var ed = edit.ed_new()
    edit.ed_open_memory(mut ed, text, "job-env")
    ed.ws_dir = base
    (ed, base)
}

// `job_fixture` (`test_job.c:26-30`): an editor over its scratch buffer.
fn job_fixture() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed
}

// One turn of the loop over the jobs (`test_job.c:72-101`): wait up to
// `ms` on their descriptors, pump, reap, tick, settle.
fn turn(mut ed: edit.Ed, ms: int) {
    let fds = edit.job_wait_fds(ed)
    if fds.len != 0 {
        let _ = os_signal_wait_fds(fds, signal.child(), ms) else |_| { (-1, 0) }
    } else {
        time_sleep_ms(5)
    }
    edit.job_pump(mut ed)
    edit.job_reap(mut ed)
    edit.job_tick(mut ed, time_now_ms())
    let _ = edit.job_settle(mut ed)
}

// `run_to_completion` (`test_job.c:72-101`): until the job is DRAINED —
// reaped AND its pipes at EOF AND its completion delivered.
fn run_to_completion(mut ed: edit.Ed, id: int) -> bool {
    let start = time_now_ms()
    loop {
        let i = edit.job_find(ed, id)
        if i < 0 {
            return false
        }
        if ed.jobs.v[i].drained {
            return true
        }
        turn(mut ed, 20)
        if time_now_ms() - start > 10000 {
            return false
        }
    }
    false
}

// `run_until_released` (`test_job.c:128-150`).
fn run_until_released(mut ed: edit.Ed, id: int) -> bool {
    let start = time_now_ms()
    while edit.job_find(ed, id) >= 0 {
        turn(mut ed, 20)
        if time_now_ms() - start > 10000 {
            return false
        }
    }
    true
}

// `release_finished` (`test_job.c:103-118`).
fn release_finished(mut ed: edit.Ed) {
    var i = 0
    while i < ed.jobs.v.len {
        if ed.jobs.v[i].state == edit.JOB_RUNNING {
            i += 1
            continue
        }
        edit.job_release(mut ed, i)
    }
}

// `assert_job_child_reaped` (`test_job.c:120-126`): this fixture reaped
// its own child — the job holds no handle, and the one it held answers
// `io` (C's ECHILD).
fn assert_job_child_reaped(ed: edit.Ed, id: int, slot: int) {
    let i = edit.job_find(ed, id)
    assert(i >= 0, "job {id} is in the table")
    assert(ed.jobs.v[i].pid > 0, "job {id} had a process")
    assert(ed.jobs.v[i].reaped && ed.jobs.v[i].child == -1, "job {id} is reaped")
    let gone = os_wait_status(slot) else -999
    assert(gone == -999, "the reaped handle answers io (ECHILD)")
}

fn slot_of(ed: edit.Ed, id: int) -> int {
    let i = edit.job_find(ed, id)
    if i < 0 then -1 else ed.jobs.v[i].child
}

fn spawn_argv(mut ed: edit.Ed, argv: List[str]) -> (int, str) {
    var spec = edit.job_spec_new()
    spec.argv = copy argv
    spec.sink = edit.SINK_COLLECT
    edit.job_spawn(mut ed, mut spec)
}

// Whether a process of group `pgid` still exists (C's `kill(-pgid, 0)`):
// 1 yes, 0 no, -1 where the host has no /proc to ask.
fn group_alive(pgid: int) -> int {
    let rows = fs_read_dir_entries("/proc") else |_| { return -1 }
    for row in rows {
        // A row is the entry's kind byte, then its name.
        if row.len < 2 {
            continue
        }
        let raw_name = row[1..row.len]
        var digits = true
        for b in raw_name {
            if b as int < 48 || b as int > 57 {
                digits = false
            }
        }
        if !digits {
            continue
        }
        let name = str_from_utf8(raw_name) else |_| { continue }
        let stat = fs.read_text("/proc/{name}/stat") else |_| { continue }
        let close = stat.rfind(")") else -1
        if close < 0 {
            continue
        }
        let rest = stat[close + 2..].words()
        if rest.len >= 3 && rest[2] == "{pgid}" {
            // A zombie is gone for C's claim once it is reaped; still a
            // member until then.
            return 1
        }
    }
    0
}

// `group_gone_within` (`test_job.c:1335-1349`).
fn group_gone_within(pgid: int, budget_ms: int) -> bool {
    let start = time_now_ms()
    loop {
        let a = group_alive(pgid)
        if a <= 0 {
            return true
        }
        if time_now_ms() - start > budget_ms {
            return false
        }
        time_sleep_ms(5)
    }
    false
}

fn assert_text(ed: edit.Ed, bi: int, want: List[byte], what: str) {
    let got = text.textbuf_bytes(ed.bufs[bi].ec.tb)
    assert(same(got, want), "{what}: the buffer's bytes")
}

fn note(what: str) {
    print("job_test: note: {what}")
}

// `test_job.c:578-597`. The append and its line count; the syntax
// engine's entry count and the symbol index's pending flag are yw10's and
// yw11's (neither exists yet), said by name.
fn t_job_buffer_append_updates_syntax() {
    var ed = job_fixture()
    let bi = ed.wins[ed.win].buf
    var spec = edit.job_spec_new()
    spec.proxy = edit.PROXY_SESSION
    spec.display = "append"
    spec.has_display = true
    // A proxy entry stands for C's stack `YewJob` with `buf` set: no
    // process, the buffer seam only.
    let (id, err) = edit.job_spawn(mut ed, mut spec)
    assert(id != 0, "a proxy entry: {err}")
    let i = edit.job_find(ed, id)
    ed.jobs.v[i].buf = bi
    edit.job_buffer_append(mut ed, i, bytes_of("one\ntwo\n"), false)
    assert(text.textbuf_line_count(ed.bufs[bi].ec.tb) == 3, "three lines")
    note(
        "job_buffer_append_updates_syntax: the syntax entry count (yw10) and the symbol index's pending flag (yw11) are not asserted: neither exists yet",
    )
}

// `test_job.c:245-296`.
fn t_job_output_dismiss_and_quit_restore_dirty_origin() {
    var ed = job_fixture()
    env_set("SHELL", "/bin/sh") else |_| {}
    let origin = ed.wins[ed.win].buf
    let w = ed.win
    edit.ed_undo_begin(mut ed, w, text.TXN_TYPE)
    assert(edit.ed_edit_insert(mut ed, w, 0, bytes_of("dirty"), 0, 5), "insert")
    edit.ed_undo_end(mut ed, w)
    edit.ed_finish_edit(mut ed, w)
    assert(edit.buf_dirty(ed.bufs[origin]), "the origin is dirty")
    let (id, err) = edit.shell_run(mut ed, "printf output", true)
    assert(id != 0 && err.len == 0, "the job runs: {err}")
    let output = ed.wins[ed.win].buf
    assert(output != origin, "its output is focused")
    let i = edit.job_find(ed, id)
    assert(ed.jobs.v[i].origin_buf_id == ed.bufs[origin].id, "the origin is recorded")
    // Running output can be hidden and keeps streaming into the same buffer.
    assert(edit.shell_dismiss_output(mut ed), "dismissed")
    assert(ed.wins[ed.win].buf == origin, "back to the origin")
    assert(ed.jobs.v[edit.job_find(ed, id)].buf == output, "the buffer is kept")
    assert(run_to_completion(mut ed, id), "completes")
    // The retained, completed output obeys the same return contract.
    edit.ed_show_buffer(mut ed, output)
    assert(edit.shell_dismiss_output(mut ed), "dismissed again")
    assert(ed.wins[ed.win].buf == origin, "back again")
    assert(ed.jobs.v[edit.job_find(ed, id)].buf == output, "still kept")
    edit.ed_show_buffer(mut ed, output)
    var cx = edit.cmdctx_new(ed.win, 0)
    assert(edit.fc_quit(mut ed, cx) == edit.CMD_OK, ":q hides it")
    assert(!ed.quit, "no quit")
    assert(ed.wins[ed.win].buf == origin, "the origin again")
    assert(ed.prompt == edit.PROMPT_NONE, "no prompt")
    assert(ed.msg.text.contains(":jobs to reopen"), "C's line: {ed.msg.text}")
    // A second q reaches the real document and cannot evade its guard.
    cx = edit.cmdctx_new(ed.win, 0)
    assert(edit.fc_quit(mut ed, cx) == edit.CMD_OK, ":q")
    assert(!ed.quit, "still no quit")
    assert(ed.prompt == edit.PROMPT_QUIT_DIRTY, "the dirty prompt")
    cx.bang = true
    assert(edit.fc_quit(mut ed, cx) == edit.CMD_OK, ":q!")
    assert(ed.quit, "quits")
    edit.jobs_free(mut ed)
}

// `test_job.c:1479-1531`.
fn t_job_escape_dismisses_output_like_quit() {
    var ed = job_fixture()
    env_set("SHELL", "/bin/sh") else |_| {}
    let origin = ed.wins[ed.win].buf
    let (id, err) = edit.shell_run(mut ed, "printf output", true)
    assert(id != 0, "runs: {err}")
    let output = ed.wins[ed.win].buf
    assert(output != origin, "focused")
    assert(run_to_completion(mut ed, id), "completes")
    // Escape from a unit mode retires the view and keeps the mode.
    assert(edit.mode_enter(mut ed, edit.MODE_B) == edit.CMD_OK, "B")
    assert(edit.mode_escape(mut ed) == edit.CMD_OK, "escape")
    assert(ed.wins[ed.win].buf == origin, "retired")
    assert(ed.mode == edit.MODE_B, "the mode is kept")
    assert(ed.jobs.v[edit.job_find(ed, id)].buf == output, "the job is retained")
    // With no output showing, Escape is the ordinary mode escape.
    assert(edit.mode_escape(mut ed) == edit.CMD_OK, "escape")
    assert(ed.mode == edit.MODE_L, "L")
    // A prompt is more recent than the view, so it wins the first press.
    edit.ed_show_buffer(mut ed, output)
    edit.ed_prompt(mut ed, edit.PROMPT_QUIT_DIRTY)
    assert(edit.mode_escape(mut ed) == edit.CMD_OK, "escape")
    assert(ed.prompt == edit.PROMPT_NONE, "the prompt went")
    assert(ed.wins[ed.win].buf == output, "the view stays")
    assert(edit.mode_escape(mut ed) == edit.CMD_OK, "escape")
    assert(ed.wins[ed.win].buf == origin, "the next press retires it")
    edit.jobs_free(mut ed)
}

// `test_job.c:610-646`.
fn t_job_echo_lifecycle() {
    var ed = job_fixture()
    let (id, err) = spawn_argv(mut ed, argv_of(["/bin/echo", "hi"]))
    assert(id != 0 && err.len == 0, "spawned: {err}")
    assert(run_to_completion(mut ed, id), "completes")
    let i = edit.job_find(ed, id)
    let j = copy ed.jobs.v[i]
    assert(j.state == edit.JOB_EXITED && j.exit_code == 0, "exit 0")
    assert(j.bytes_out == 3, "three bytes out")
    assert(same(j.collect, bytes_of("hi\n")), "hi")
    // Every parent-side descriptor is closed by completion.
    assert(j.out_fd == -1 && j.err_fd == -1 && j.in_fd == -1, "the pipes are closed")
    let before = fd_count()
    edit.jobs_free(mut ed)
    assert(fd_count() <= before, "teardown strands no descriptor")
}

// `test_job.c:648-680`.
fn t_job_internal_ids_do_not_advance_public_ids() {
    var ed = job_fixture()
    var spec = edit.job_spec_new()
    spec.argv = argv_of(["/bin/true"])
    spec.sink = edit.SINK_DISCARD
    spec.internal = true
    let (ia, _) = edit.job_spawn(mut ed, mut spec)
    let (ib, _) = edit.job_spawn(mut ed, mut spec)
    spec.internal = false
    let (pa, _) = edit.job_spawn(mut ed, mut spec)
    let (pb, _) = edit.job_spawn(mut ed, mut spec)
    assert(
        ia == edit.JOB_INTERNAL_ID_TOP && ib == edit.JOB_INTERNAL_ID_TOP - 1,
        "internal ids count down",
    )
    assert(pa == 1 && pb == 2, "public ids count up")
    assert(edit.job_find(ed, ia) >= 0 && edit.job_find(ed, pa) >= 0, "both are found")
    edit.jobs_free(mut ed)
}

// `test_job.c:682-738`.
fn t_job_argv_resolves_path_and_preserves_explicit_paths() {
    var ed = job_fixture()
    let dir = "/tmp/yew-job-path-{os_pid()}"
    fs.remove_dir_all(dir) else |_| {}
    fs.create_dir_all(dir) else |_| { assert(false, "mkdir") }
    let probe = "{dir}/yew-path-probe"
    fs.write_text(probe, "#!/bin/sh\nprintf path\n") else |_| { assert(false, "write") }
    fs.set_mode(probe, 448) else |_| { assert(false, "chmod") }
    let saved = env_get("PATH") else ""
    let had = std_env.has("PATH")
    env_set("PATH", dir) else |_| {}
    let (id, _) = spawn_argv(mut ed, argv_of(["yew-path-probe"]))
    var path_ok = id != 0 && run_to_completion(mut ed, id)
    if path_ok {
        let j = copy ed.jobs.v[edit.job_find(ed, id)]
        path_ok = j.state == edit.JOB_EXITED &&
            j.exit_code == 0 &&
            same(j.collect, bytes_of("path"))
    }
    let (id2, _) = spawn_argv(mut ed, argv_of(["/bin/sh", "-c", "printf explicit"]))
    var explicit_ok = id2 != 0 && run_to_completion(mut ed, id2)
    if explicit_ok {
        let j = copy ed.jobs.v[edit.job_find(ed, id2)]
        explicit_ok = j.state == edit.JOB_EXITED &&
            j.exit_code == 0 &&
            same(j.collect, bytes_of("explicit"))
    }
    if had {
        env_set("PATH", saved) else |_| {}
    } else {
        env_unset("PATH") else |_| {}
    }
    fs.remove_dir_all(dir) else |_| {}
    edit.jobs_free(mut ed)
    assert(path_ok, "a bare name resolves through the child's PATH")
    assert(explicit_ok, "an explicit path is kept")
}

// `test_job.c:740-760`.
fn t_job_exec_failure_is_not_exit_127() {
    var ed = job_fixture()
    let (id, err) = spawn_argv(mut ed, argv_of(["/nonexistent/definitely-not-here"]))
    assert(id != 0, "spawned: {err}")
    assert(run_to_completion(mut ed, id), "completes")
    let j = copy ed.jobs.v[edit.job_find(ed, id)]
    assert(j.state == edit.JOB_EXECFAIL, "an exec failure")
    assert(j.exec_errno == 2, "ENOENT")
    edit.jobs_free(mut ed)
}

// `test_job.c:762-784`.
fn t_job_exit_127_is_not_exec_failure() {
    var ed = job_fixture()
    let (id, _) = spawn_argv(mut ed, argv_of(["/bin/sh", "-c", "exit 127"]))
    assert(id != 0 && run_to_completion(mut ed, id), "completes")
    let j = copy ed.jobs.v[edit.job_find(ed, id)]
    assert(
        j.state == edit.JOB_EXITED && j.exit_code == 127 && j.exec_errno == 0,
        "a real 127 stays EXITED",
    )
    edit.jobs_free(mut ed)
}

// `test_job.c:786-806`.
fn t_job_exit_code_and_stderr() {
    var ed = job_fixture()
    let (id, _) = spawn_argv(mut ed, argv_of(["/bin/sh", "-c", "echo oops >&2; exit 3"]))
    assert(run_to_completion(mut ed, id), "completes")
    let j = copy ed.jobs.v[edit.job_find(ed, id)]
    assert(j.state == edit.JOB_EXITED && j.exit_code == 3, "exit 3")
    assert(j.bytes_err == 5 && j.bytes_out == 0, "five bytes of stderr")
    edit.jobs_free(mut ed)
}

// `test_job.c:808-829`.
fn t_job_killed_by_signal() {
    var ed = job_fixture()
    let (id, _) = spawn_argv(mut ed, argv_of(["/bin/sh", "-c", "sleep 30"]))
    assert(id != 0, "spawned")
    assert(edit.job_signal(mut ed, id, signal.kill()), "signalled")
    assert(run_to_completion(mut ed, id), "completes")
    let j = copy ed.jobs.v[edit.job_find(ed, id)]
    let kill_no = signal.number(signal.kill()) else 9
    assert(j.state == edit.JOB_SIGNALED && j.termsig == kill_no, "killed by SIGKILL")
    edit.jobs_free(mut ed)
}

// `test_job.c:831-856`.
fn t_job_signal_reaches_the_whole_group() {
    var ed = job_fixture()
    let (id, _) = spawn_argv(mut ed, argv_of(["/bin/sh", "-c", "sleep 30 | cat"]))
    assert(id != 0, "spawned")
    let pgid = ed.jobs.v[edit.job_find(ed, id)].pgid
    assert(pgid > 0, "its own group")
    // The probe answers yes for a live group, so its later no is real.
    assert(group_alive(pgid) != 0, "the group is seen alive first")
    assert(edit.job_signal(mut ed, id, signal.kill()), "signalled")
    assert(run_to_completion(mut ed, id), "completes")
    let alive = group_alive(pgid)
    if alive < 0 {
        note(
            "job_signal_reaches_the_whole_group: no /proc on this host; the group's end is not asked",
        )
    } else {
        assert(group_gone_within(pgid, 5000), "nothing from that group survives")
    }
    edit.jobs_free(mut ed)
}

// `test_job.c:858-882`.
fn t_job_max_refuses_rather_than_queues() {
    var ed = job_fixture()
    var i = 0
    while i < edit.JOB_MAX {
        let (id, err) = spawn_argv(mut ed, argv_of(["/bin/sh", "-c", "sleep 30"]))
        assert(id != 0, "job {i}: {err}")
        i += 1
    }
    let (id, err) = spawn_argv(mut ed, argv_of(["/bin/sh", "-c", "sleep 30"]))
    assert(id == 0, "refused, never queued")
    assert(err == "too many jobs (32); finish or kill one first", "C's line: {err}")
    i = 0
    while i < edit.JOB_MAX {
        let _ = edit.job_signal(mut ed, i + 1, signal.kill())
        i += 1
    }
    edit.jobs_free(mut ed)
}

// `test_job.c:884-915`.
fn t_job_stdin_region_is_piped() {
    var ed = job_fixture()
    let tb = text.textbuf_from_str("beta\nalpha\ngamma\n")
    var spec = edit.job_spec_new()
    spec.argv = argv_of(["/bin/sh", "-c", "sort"])
    spec.sink = edit.SINK_COLLECT
    spec.in_bytes = text.textbuf_copy_range(tb, 0, 17)
    spec.has_in = true
    let (id, err) = edit.job_spawn(mut ed, mut spec)
    assert(id != 0, "spawned: {err}")
    assert(run_to_completion(mut ed, id), "completes")
    let j = copy ed.jobs.v[edit.job_find(ed, id)]
    assert(j.state == edit.JOB_EXITED, "exited")
    // sort emits nothing until stdin EOF: the write end closes at the end.
    assert(same(j.collect, bytes_of("alpha\nbeta\ngamma\n")), "sorted")
    edit.jobs_free(mut ed)
}

// `test_job.c:917-948`.
fn t_job_stdin_bytes_are_binary_exact_and_wiped() {
    var ed = job_fixture()
    var spec = edit.job_spec_new()
    spec.argv = argv_of(["/bin/cat"])
    spec.sink = edit.SINK_COLLECT
    spec.in_bytes = raw([97, 0, 255, 10, 122])
    spec.has_in = true
    let (id, err) = edit.job_spawn(mut ed, mut spec)
    assert(id != 0 && err.len == 0, "spawned: {err}")
    assert(run_to_completion(mut ed, id), "completes")
    let j = copy ed.jobs.v[edit.job_find(ed, id)]
    assert(j.state == edit.JOB_EXITED, "exited")
    assert(same(j.collect, raw([97, 0, 255, 10, 122])), "binary exact")
    for b in spec.in_bytes {
        assert(b as int == 0, "the lent bytes are wiped")
    }
    edit.jobs_free(mut ed)
}

// `test_job.c:950-984`: 128 KiB, past what a fresh pipe takes, so the
// forked writer serves it (G30's half); the checked machine answers
// os_fork `unsupported` and the case SKIPs there.
fn t_job_stdin_bytes_are_wiped_when_child_closes_early() -> int {
    signal.ignore(signal.broken_pipe()) else |_| {}
    var ed = job_fixture()
    var input = List[byte]()
    var i = 0
    while i < 131072 {
        (mut input).push(165 as byte)
        i += 1
    }
    var spec = edit.job_spec_new()
    spec.argv = argv_of(["/bin/true"])
    spec.sink = edit.SINK_COLLECT
    spec.in_bytes = input
    spec.has_in = true
    let (id, err) = edit.job_spawn(mut ed, mut spec)
    if id == 0 && err.contains("os_fork is unsupported") {
        let why = "the forked stdin writer: os_fork is unsupported on this machine (the checked machine, ruling #95 R4 C)"
        print("job_test: SKIP job_stdin_bytes_are_wiped_when_child_closes_early: {why}")
        eprint("job_test: SKIP job_stdin_bytes_are_wiped_when_child_closes_early: {why}")
        return 1
    }
    assert(id != 0, "spawned: {err}")
    assert(run_to_completion(mut ed, id), "completes")
    var wiped = true
    for b in spec.in_bytes {
        wiped = wiped && b as int == 0
    }
    assert(wiped, "wiped though the child closed its stdin early")
    edit.jobs_free(mut ed)
    0
}

// `test_job.c:1062-1098`: a streaming protocol sees an incomplete UTF-8
// prefix at once.
fn t_job_stream_bypasses_safe_prefix() {
    var ed = job_fixture()
    edit.job_stream_witness_new(mut ed, "w", false, -1)
    var spec = edit.job_spec_new()
    spec.argv = argv_of(["/bin/sh", "-c", "printf '\\360\\237\\230'; exec sleep 30"])
    spec.sink = edit.SINK_STREAM
    spec.stream = edit.STREAM_TEST
    spec.cb_key = "w"
    let (id, err) = edit.job_spawn(mut ed, mut spec)
    assert(id != 0, "spawned: {err}")
    let start = time_now_ms()
    while ed.jobs.stream_witness[0].out.len < 3 && time_now_ms() - start < 2000 {
        let fds = edit.job_wait_fds(ed)
        let _ = os_signal_wait_fds(fds, signal.child(), 20) else |_| { (-1, 0) }
        edit.job_pump(mut ed)
    }
    assert(same(ed.jobs.stream_witness[0].out, raw([240, 159, 152])), "the three bytes at once")
    assert(ed.jobs.stream_witness[0].out_finish == 0, "not finished")
    assert(edit.job_signal(mut ed, id, signal.kill()), "signalled")
    assert(run_to_completion(mut ed, id), "completes")
    assert(
        ed.jobs.stream_witness[0].out_finish == 1 && ed.jobs.stream_witness[0].err_finish == 1,
        "both finished once",
    )
    assert(ed.jobs.stream_witness[0].destroys == 1, "destroyed once")
    edit.jobs_free(mut ed)
    assert(ed.jobs.stream_witness[0].destroys == 1, "teardown destroys nothing twice")
}

// `test_job.c:1100-1146`.
fn t_job_stream_routes_stderr_and_owns_lifecycle() {
    var ed = job_fixture()
    let now = time_now_ms()
    edit.job_stream_witness_new(mut ed, "w", false, now + 500)
    var spec = edit.job_spec_new()
    spec.argv = argv_of(["/bin/sh", "-c", "cat; printf 'yew-http-status: 201\\n' >&2"])
    spec.sink = edit.SINK_STREAM
    spec.in_bytes = bytes_of("secret config\n")
    spec.has_in = true
    spec.cb_key = "w"
    let (z, e0) = edit.job_spawn(mut ed, mut spec)
    assert(z == 0 && e0 == "stream job has no transport", "no transport: {e0}")
    assert(ed.jobs.stream_witness[0].destroys == 0, "nothing destroyed")
    spec.stream = edit.STREAM_TEST
    let (id, err) = edit.job_spawn(mut ed, mut spec)
    assert(id != 0, "spawned: {err}")
    let d = edit.job_deadline(ed, now)
    assert(d >= 0 && d <= 500, "the owner's deadline: {d}")
    edit.job_tick(mut ed, now)
    assert(ed.jobs.stream_witness[0].ticks == 1, "one tick")
    assert(run_to_completion(mut ed, id), "completes")
    let i = edit.job_find(ed, id)
    assert(same(ed.jobs.stream_witness[0].out, bytes_of("secret config\n")), "stdout to the owner")
    assert(
        same(ed.jobs.stream_witness[0].err, bytes_of("yew-http-status: 201\n")),
        "stderr to the owner",
    )
    assert(same(ed.jobs.v[i].stream_err, ed.jobs.stream_witness[0].err), "the transcript kept")
    assert(
        ed.jobs.stream_witness[0].out_finish == 1 && ed.jobs.stream_witness[0].err_finish == 1,
        "finished",
    )
    assert(ed.jobs.stream_witness[0].destroys == 1, "destroyed")
    for b in spec.in_bytes {
        assert(b as int == 0, "the stdin bytes are wiped")
    }
    edit.jobs_free(mut ed)
    assert(ed.jobs.stream_witness[0].destroys == 1, "once")
}

// `test_job.c:1236-1263`.
fn t_job_stream_callback_failure_terminates_job() {
    var ed = job_fixture()
    edit.job_stream_witness_new(mut ed, "w", true, -1)
    var spec = edit.job_spec_new()
    spec.argv = argv_of(["/bin/sh", "-c", "trap 'sleep 30 & exit 0' TERM; printf x; sleep 30"])
    spec.sink = edit.SINK_STREAM
    spec.stream = edit.STREAM_TEST
    spec.cb_key = "w"
    let (id, err) = edit.job_spawn(mut ed, mut spec)
    assert(id != 0, "spawned: {err}")
    assert(run_to_completion(mut ed, id), "completes")
    let j = copy ed.jobs.v[edit.job_find(ed, id)]
    assert(j.stream_failed, "the owner's refusal is recorded")
    assert(j.state == edit.JOB_SIGNALED || j.state == edit.JOB_EXITED, "the job ended")
    assert(ed.jobs.stream_witness[0].destroys == 1, "destroyed")
    edit.jobs_free(mut ed)
}

// `test_job.c:1191-1234`.
fn t_job_stream_read_budget_is_bounded() {
    var ed = job_fixture()
    edit.job_stream_witness_new(mut ed, "w", false, -1)
    var spec = edit.job_spec_new()
    spec.argv = argv_of(["/bin/sh", "-c", "while :; do printf '0123456789abcdef'; done"])
    spec.sink = edit.SINK_STREAM
    spec.stream = edit.STREAM_TEST
    spec.cb_key = "w"
    let (id, err) = edit.job_spawn(mut ed, mut spec)
    assert(id != 0, "spawned: {err}")
    let out_fd = ed.jobs.v[edit.job_find(ed, id)].out_fd
    let start = time_now_ms()
    var ready = false
    while !ready && time_now_ms() - start < 2000 {
        let fds = edit.job_wait_fds(ed)
        let (k, _) = os_signal_wait_fds(fds, signal.child(), 20) else |_| { (-1, 0) }
        if k >= 0 && fds[k] == out_fd {
            ready = true
            edit.job_pump(mut ed)
        }
    }
    assert(ready, "stdout became ready")
    let n = ed.jobs.stream_witness[0].out.len
    assert(n != 0 && n <= edit.JOB_READ_BUDGET, "one pump reads at most the budget: {n}")
    assert(edit.job_signal(mut ed, id, signal.kill()), "signalled")
    assert(run_to_completion(mut ed, id), "completes")
    assert(ed.jobs.stream_witness[0].destroys == 1, "destroyed")
    edit.jobs_free(mut ed)
}

// `test_job.c:1266-1301` (DoD 8): 500 spawn/reap/release cycles, the
// descriptor count unchanged.
fn t_job_no_fd_or_zombie_leak_across_many_spawns() {
    var ed = job_fixture()
    let argv = argv_of(["/bin/echo", "x"])
    let (id0, _) = spawn_argv(mut ed, argv)
    let s0 = slot_of(ed, id0)
    assert(run_to_completion(mut ed, id0), "warm-up")
    assert_job_child_reaped(ed, id0, s0)
    release_finished(mut ed)
    let before = fd_count()
    var i = 0
    while i < 500 {
        let (id, err) = spawn_argv(mut ed, argv)
        assert(id != 0, "cycle {i}: {err}")
        let s = slot_of(ed, id)
        assert(run_to_completion(mut ed, id), "cycle {i} completes")
        assert_job_child_reaped(ed, id, s)
        release_finished(mut ed)
        i += 1
    }
    let after = fd_count()
    assert(after == before, "descriptors: {before} before, {after} after")
    edit.jobs_free(mut ed)
}

// `test_job.c:1303-1321`.
fn t_job_running_count_tracks_state() {
    var ed = job_fixture()
    assert(edit.job_running_count(ed) == 0, "none")
    let (id, _) = spawn_argv(mut ed, argv_of(["/bin/sh", "-c", "sleep 30"]))
    assert(edit.job_running_count(ed) == 1, "one")
    let _ = edit.job_signal(mut ed, id, signal.kill())
    assert(run_to_completion(mut ed, id), "completes")
    assert(edit.job_running_count(ed) == 0, "the badge clears at zero")
    edit.jobs_free(mut ed)
}

// `test_job.c:1351-1375`.
fn t_job_timeout_escalates_to_kill() {
    var ed = job_fixture()
    var spec = edit.job_spec_new()
    spec.argv = argv_of(["/bin/sh", "-c", "trap '' TERM; sleep 30"])
    spec.sink = edit.SINK_COLLECT
    spec.timeout_ms = 150
    let (id, err) = edit.job_spawn(mut ed, mut spec)
    assert(id != 0, "spawned: {err}")
    assert(group_alive(ed.jobs.v[edit.job_find(ed, id)].pgid) != 0, "the group is seen alive first")
    assert(run_to_completion(mut ed, id), "completes")
    let j = copy ed.jobs.v[edit.job_find(ed, id)]
    assert(j.state == edit.JOB_TIMEOUT, "a timeout")
    if group_alive(j.pgid) < 0 {
        note("job_timeout_escalates_to_kill: no /proc on this host; the group's end is not asked")
    } else {
        assert(group_gone_within(j.pgid, 5000), "the escalation ends the group")
    }
    edit.jobs_free(mut ed)
}

// `test_job.c:1377-1390`.
fn t_job_shell_resolution_prefers_env() {
    let saved = env_get("SHELL") else ""
    let had = std_env.has("SHELL")
    env_set("SHELL", "/bin/sh") else |_| {}
    assert(edit.job_shell() == "/bin/sh", "$SHELL wins")
    env_set("SHELL", "") else |_| {}
    assert(edit.job_shell().starts_with("/"), "an empty $SHELL falls through")
    if had {
        env_set("SHELL", saved) else |_| {}
    } else {
        env_unset("SHELL") else |_| {}
    }
}

// `test_job.c:298-333`.
fn t_job_callback_waits_for_reap_and_both_eofs_then_releases() {
    var ed = job_fixture()
    edit.job_witness_new(mut ed, "w")
    var spec = edit.job_spec_new()
    spec.argv = argv_of(
        ["/bin/sh", "-c", "printf early; (sleep 0.2; printf late; printf err >&2) & exit 7"],
    )
    spec.sink = edit.SINK_CALLBACK
    spec.callback = edit.CB_TEST
    spec.cb_key = "w"
    let (id, err) = edit.job_spawn(mut ed, mut spec)
    assert(id != 0, "spawned: {err}")
    assert(run_until_released(mut ed, id), "released")
    assert(edit.job_find(ed, id) < 0, "gone from the table")
    let w = copy ed.jobs.witness[0]
    assert(
        w.completes == 1 && w.destroys == 1 && w.destroyed_after_complete,
        "complete then destroy, once each",
    )
    assert(w.reaped && w.pipes_eof, "after the reap AND both EOFs")
    assert(w.state == edit.JOB_EXITED && w.exit_code == 7, "exit 7")
    assert(same(w.out, bytes_of("earlylate")), "stdout: both writers")
    assert(same(w.err, bytes_of("err")), "stderr apart")
    edit.jobs_free(mut ed)
    assert(ed.jobs.witness[0].destroys == 1, "teardown destroys nothing twice")
}

// `test_job.c:335-376`.
fn t_job_callback_collect_max_and_destroy_on_teardown() {
    var ed = job_fixture()
    edit.job_witness_new(mut ed, "capped")
    edit.job_witness_new(mut ed, "teardown")
    var spec = edit.job_spec_new()
    spec.argv = argv_of(["/bin/sh", "-c", "printf 12345"])
    spec.sink = edit.SINK_CALLBACK
    spec.collect_max = 4
    spec.callback = edit.CB_TEST
    spec.cb_key = "capped"
    let (id, err) = edit.job_spawn(mut ed, mut spec)
    assert(id != 0, "spawned: {err}")
    assert(run_until_released(mut ed, id), "released")
    assert(ed.jobs.witness[0].collect_capped, "capped")
    assert(ed.jobs.witness[0].completes == 1 && ed.jobs.witness[0].destroys == 1, "once each")
    var spec2 = edit.job_spec_new()
    spec2.argv = argv_of(["/bin/sh", "-c", "sleep 30"])
    spec2.sink = edit.SINK_CALLBACK
    spec2.callback = edit.CB_TEST
    spec2.cb_key = "teardown"
    let (id2, _) = edit.job_spawn(mut ed, mut spec2)
    assert(id2 != 0, "spawned")
    edit.jobs_free(mut ed)
    assert(ed.jobs.witness[1].completes == 0, "teardown completes nothing")
    assert(ed.jobs.witness[1].destroys == 1, "teardown destroys once")
}

// `test_job.c:378-436`.
fn t_job_environment_overrides_are_copied_and_name_exact() {
    let names = [
        "YEW_JOB_ENV_KEEP",
        "YEW_JOB_ENV_SET",
        "YEW_JOB_ENV_EXACT",
        "YEW_JOB_ENV_EXACTLY",
        "YEW_JOB_ENV_PREFIX_ONE",
    ]
    let vals = ["parent", "parent", "gone", "keep", "gone"]
    var had = List[bool]()
    var saved = List[str]()
    var i = 0
    while i < names.len {
        (mut had).push(std_env.has(names[i]))
        (mut saved).push(env_get(names[i]) else "")
        env_set(names[i], vals[i]) else |_| {}
        i += 1
    }
    var ed = job_fixture()
    edit.job_witness_new(mut ed, "w")
    var spec = edit.job_spec_new()
    spec.argv = argv_of(
        [
            "/bin/sh",
            "-c",
            "printf '%s|%s|%s|%s|%s|%s' \"$YEW_JOB_ENV_KEEP\" \"$YEW_JOB_ENV_SET\" \"${{YEW_JOB_ENV_EXACT-unset}}\" \"${{YEW_JOB_ENV_EXACTLY-unset}}\" \"${{YEW_JOB_ENV_PREFIX_ONE-unset}}\" \"$YEW_JOB_ENV_NEW\"",
        ],
    )
    spec.sink = edit.SINK_CALLBACK
    (mut spec.env_set).push("YEW_JOB_ENV_SET=child")
    (mut spec.env_set).push("YEW_JOB_ENV_NEW=new")
    (mut spec.env_unset).push("YEW_JOB_ENV_EXACT")
    (mut spec.env_unset_prefix).push("YEW_JOB_ENV_PREFIX_")
    spec.callback = edit.CB_TEST
    spec.cb_key = "w"
    let (id, err) = edit.job_spawn(mut ed, mut spec)
    assert(id != 0, "spawned: {err}")
    assert((env_get("YEW_JOB_ENV_SET") else "") == "parent", "the parent's SET untouched")
    assert((env_get("YEW_JOB_ENV_EXACT") else "") == "gone", "the parent's EXACT untouched")
    assert((env_get("YEW_JOB_ENV_PREFIX_ONE") else "") == "gone", "the parent's PREFIX untouched")
    assert(run_until_released(mut ed, id), "released")
    let w = copy ed.jobs.witness[0]
    assert(
        same(w.out, bytes_of("parent|child|unset|keep|unset|new")),
        "the child's view: {str_from_utf8(w.out) else "?"}",
    )
    assert(w.err.len == 0, "no stderr")
    edit.jobs_free(mut ed)
    i = 0
    while i < names.len {
        if had[i] {
            env_set(names[i], saved[i]) else |_| {}
        } else {
            env_unset(names[i]) else |_| {}
        }
        i += 1
    }
}

// `test_job.c:438-508`.
fn t_job_standard_environment_is_exact_and_parent_unchanged() {
    let names = [
        "YEW_FILE",
        "YEW_LINE",
        "YEW_COL",
        "YEW_WORKSPACE",
        "YEW_JOB",
        "PAGER",
        "GIT_PAGER",
        "COLUMNS",
        "LINES",
    ]
    let hostile = [
        "parent-file",
        "800",
        "900",
        "parent-workspace",
        "parent-job",
        "parent-pager",
        "parent-git-pager",
        "132",
        "43",
    ]
    var had = List[bool]()
    var saved = List[str]()
    var i = 0
    while i < names.len {
        (mut had).push(std_env.has(names[i]))
        (mut saved).push(env_get(names[i]) else "")
        env_set(names[i], hostile[i]) else |_| {}
        i += 1
    }
    let text = raw(
        [
            97,
            240,
            159,
            145,
            168,
            226,
            128,
            141,
            240,
            159,
            145,
            169,
            226,
            128,
            141,
            240,
            159,
            145,
            167,
            226,
            128,
            141,
            240,
            159,
            145,
            166,
            122,
            10,
        ],
    )
    var ed = edit.ed_new()
    edit.ed_open_memory(mut ed, text, "job-env")
    let w = ed.win
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].pos = 26
    ed.wins[w].cs.curs[p].anchor = 26
    edit.job_witness_new(mut ed, "w")
    var spec = edit.job_spec_new()
    spec.argv = argv_of(
        [
            "/bin/sh",
            "-c",
            "printf '%s|%s|%s|%s|%s|%s|%s|%s|%s' \"$YEW_FILE\" \"$YEW_LINE\" \"$YEW_COL\" \"$YEW_WORKSPACE\" \"$YEW_JOB\" \"$PAGER\" \"$GIT_PAGER\" \"${{COLUMNS-unset}}\" \"${{LINES-unset}}\"",
        ],
    )
    spec.sink = edit.SINK_CALLBACK
    spec.callback = edit.CB_TEST
    spec.cb_key = "w"
    let (id, err) = edit.job_spawn(mut ed, mut spec)
    assert(id != 0, "spawned: {err}")
    i = 0
    while i < names.len {
        assert(
            (env_get(names[i]) else "") == hostile[i],
            "the parent's {names[i]} untouched at the spawn",
        )
        i += 1
    }
    assert(run_until_released(mut ed, id), "released")
    // At byte 26 the cursor follows `a` and the 25-byte ZWJ family:
    // YEW_COL is their 1-based grapheme column, 3.
    let want = "|1|3|{edit.shell_ws_root(ed)}|1|cat|cat|unset|unset"
    let got = str_from_utf8(ed.jobs.witness[0].out) else "?"
    assert(got == want, "the child's environment: `{got}` want `{want}`")
    assert(ed.jobs.witness[0].err.len == 0, "no stderr")
    i = 0
    while i < names.len {
        assert((env_get(names[i]) else "") == hostile[i], "the parent's {names[i]} untouched after")
        i += 1
    }
    edit.jobs_free(mut ed)
    i = 0
    while i < names.len {
        if had[i] {
            env_set(names[i], saved[i]) else |_| {}
        } else {
            env_unset(names[i]) else |_| {}
        }
        i += 1
    }
}

// `test_job.c:510-561`: a filter that exits non-zero leaves the text, the
// undo tree and the journal exactly as they were.
fn t_filter_nonzero_preserves_text_undo_and_journal() {
    let dir = "/tmp/yew-filter-rollback-{os_pid()}"
    fs.remove_dir_all(dir) else |_| {}
    fs.create_dir_all(dir) else |_| { assert(false, "mkdir") }
    let path = "{dir}/doc.txt"
    let initial = raw([107, 101, 101, 112, 32, 255, 32, 98, 121, 116, 101, 115, 10])
    fs_write_bytes(path, initial) else |_| { assert(false, "write") }
    env_set("XDG_STATE_HOME", dir) else |_| {}
    env_set("SHELL", "/bin/sh") else |_| {}
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    let idx = edit.tab_open(mut ed, path)
    assert(idx >= 0 && edit.tab_hydrate(mut ed, idx) == 0, "the file loads")
    edit.tab_switch(mut ed, idx)
    let b = ed.wins[ed.win].buf
    assert(!ed.bufs[b].ec.has_jrnl, "no journal before")
    let text_gen = ed.bufs[b].ec.tb.gen
    let undo_gen = ed.bufs[b].ec.undo.gen
    let undo_cur = ed.bufs[b].ec.undo.cur
    let nodes = ed.bufs[b].ec.undo.nodes.len
    let ops = ed.bufs[b].ec.undo.ops.len
    let r = edit.shell_filter(mut ed, ed.win, 0, initial.len, "printf changed; exit 9")
    assert(r == edit.FILT_NONZERO, "non-zero: {r}")
    assert_text(ed, b, initial, "the text")
    assert(ed.bufs[b].ec.tb.gen == text_gen, "the text generation")
    assert(
        ed.bufs[b].ec.undo.gen == undo_gen && ed.bufs[b].ec.undo.cur == undo_cur,
        "the undo tree",
    )
    assert(ed.bufs[b].ec.undo.depth == 0, "no open transaction")
    assert(
        ed.bufs[b].ec.undo.nodes.len == nodes && ed.bufs[b].ec.undo.ops.len == ops,
        "no node, no op",
    )
    assert(!ed.bufs[b].ec.has_jrnl, "no journal after")
    edit.jobs_free(mut ed)
    fs.remove_dir_all(dir) else |_| {}
}

// `test_job.c:1392-1477` (DoD 8): 200 spawn/kill cycles at varying
// timings — before exec, mid-write, after exit — the descriptor count
// unchanged, and one more job runs normally after.
fn t_job_torture_spawn_kill_cycles() {
    var ed = job_fixture()
    let (w0, _) = spawn_argv(mut ed, argv_of(["/bin/sh", "-c", "printf x"]))
    let s0 = slot_of(ed, w0)
    assert(run_to_completion(mut ed, w0), "warm-up")
    assert_job_child_reaped(ed, w0, s0)
    release_finished(mut ed)
    let before = fd_count()
    var seed: wrapping[u64] = 11400714819323198485
    var cycle = 0
    while cycle < 200 {
        seed = seed * 6364136223846793005 + 1442695040888963407
        let shape = ((seed >> 33) % 4) as int
        let cmd = match shape {
            0 => "printf 'quick\\n'",
            1 => "sleep 30",
            2 => "sleep 30 | cat",
            _ => "printf 'a\\n'; sleep 30",
        }
        let (id, err) = spawn_argv(mut ed, argv_of(["/bin/sh", "-c", cmd]))
        assert(id != 0, "cycle {cycle}: {err}")
        let s = slot_of(ed, id)
        if shape != 0 {
            if seed & 65536 != 0 {
                let fds = edit.job_wait_fds(ed)
                if fds.len != 0 {
                    let _ = os_signal_wait_fds(fds, signal.child(), 1) else |_| { (-1, 0) }
                }
                edit.job_pump(mut ed)
            }
            let _ = edit.job_signal(mut ed, id, signal.kill())
        }
        assert(run_to_completion(mut ed, id), "cycle {cycle} completes")
        assert_job_child_reaped(ed, id, s)
        release_finished(mut ed)
        cycle += 1
    }
    let after = fd_count()
    assert(after == before, "descriptors: {before} before, {after} after")
    let (id, _) = spawn_argv(mut ed, argv_of(["/bin/sh", "-c", "printf 'still here\\n'"]))
    let s = slot_of(ed, id)
    assert(run_to_completion(mut ed, id), "still usable")
    assert_job_child_reaped(ed, id, s)
    assert(ed.jobs.v[0].bytes_out == 11, "the last job's bytes")
    edit.jobs_free(mut ed)
}

// Port-only: C's `standard_environment_is_exact_and_parent_unchanged`
// (`test_job.c:441-508`) through the synchronous child — hostile parent
// rows replaced, COLUMNS and LINES gone, YEW_COL the grapheme column (3
// after `a` and a 25-byte ZWJ family), the parent's environment
// untouched after; a terminal-owning child keeps the user's pagers.
fn t_port_job_standard_environment_in_the_handover_child() {
    let text = raw(
        [
            97,
            240,
            159,
            145,
            168,
            226,
            128,
            141,
            240,
            159,
            145,
            169,
            226,
            128,
            141,
            240,
            159,
            145,
            167,
            226,
            128,
            141,
            240,
            159,
            145,
            166,
            122,
            10,
        ],
    )
    var names = List[str]()
    var hostile = List[str]()
    for row in [
        "YEW_FILE=parent-file",
        "YEW_LINE=800",
        "YEW_COL=900",
        "YEW_WORKSPACE=parent-workspace",
        "YEW_JOB=parent-job",
        "PAGER=parent-pager",
        "GIT_PAGER=parent-git-pager",
        "COLUMNS=132",
        "LINES=43",
    ] {
        (mut names).push(std_env.entry_key(row))
        (mut hostile).push(std_env.entry_value(row))
    }
    var saved = List[str]()
    var had = List[bool]()
    var i = 0
    while i < names.len {
        (mut had).push(std_env.has(names[i]))
        (mut saved).push(env_get(names[i]) else "")
        env_set(names[i], hostile[i]) else |_| {}
        i += 1
    }
    var (ed, base) = fixture(text, "env")
    let w = ed.win
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].pos = 26
    ed.wins[w].cs.curs[p].anchor = 26
    let out = "{base}/env.out"
    var argv = List[str]()
    for a in [
        "/bin/sh",
        "-c",
        "printf '%s|%s|%s|%s|%s|%s|%s|%s|%s' \"$YEW_FILE\" \"$YEW_LINE\" \"$YEW_COL\" \"$YEW_WORKSPACE\" \"$YEW_JOB\" \"$PAGER\" \"$GIT_PAGER\" \"${{COLUMNS-unset}}\" \"${{LINES-unset}}\" > \"$1\"",
        "sh",
        out,
    ] {
        (mut argv).push(a)
    }
    let (ok, wait, err) = edit.job_run_sync(mut ed, argv, "")
    assert(ok && wait.state == edit.JOB_EXITED && wait.exit_code == 0, "ran: {err}")
    let got = fs.read_text(out) else ""
    let want = "|1|3|{base}|1|parent-pager|parent-git-pager|unset|unset"
    assert(got == want, "the child's environment: `{got}` want `{want}`")
    i = 0
    while i < names.len {
        let now = env_get(names[i]) else ""
        assert(now == hostile[i], "the parent's {names[i]} is untouched")
        i += 1
    }
    var cat = false
    for row in edit.job_env(mut ed, false) {
        if row == "PAGER=cat" {
            cat = true
        }
    }
    assert(cat, "a captured job's environment forces PAGER=cat")
    i = 0
    while i < names.len {
        if had[i] {
            env_set(names[i], saved[i]) else |_| {}
        } else {
            env_unset(names[i]) else |_| {}
        }
        i += 1
    }
    fs.remove_dir_all(base) else |_| {}
}

// Port-only: s19 DoD 3 through the synchronous route (C's
// `exec_failure_is_not_exit_127` and `exit_127_is_not_exec_failure`,
// `test_job.c:740-784`), and a signal death (`killed_by_signal`).
fn t_port_job_exec_failure_exit_127_and_signal_are_distinct() {
    var (ed, base) = fixture(bytes_of("x\n"), "exec")
    var missing = List[str]()
    (mut missing).push("{base}/no-such-program")
    let (ok1, w1, e1) = edit.job_run_sync(mut ed, missing, "")
    assert(ok1, "an exec failure is not a parent failure: {e1}")
    assert(w1.state == edit.JOB_EXECFAIL && w1.exec_errno == 2, "exec failed with ENOENT")
    var exit127 = List[str]()
    for a in ["/bin/sh", "-c", "exit 127"] {
        (mut exit127).push(a)
    }
    let (ok2, w2, _) = edit.job_run_sync(mut ed, exit127, "")
    assert(ok2 && w2.state == edit.JOB_EXITED && w2.exit_code == 127, "exit 127 is an exit")
    var kill = List[str]()
    for a in ["/bin/sh", "-c", "kill -KILL $$"] {
        (mut kill).push(a)
    }
    let (ok3, w3, _) = edit.job_run_sync(mut ed, kill, "")
    assert(ok3 && w3.state == edit.JOB_SIGNALED && w3.termsig == 9, "a signal death")
    fs.remove_dir_all(base) else |_| {}
}

fn fd_count() -> int {
    let rows = fs_read_dir_entries("/dev/fd") else |_| { return -1 }
    rows.len
}

// The children this process has not reaped (Linux's per-thread
// `children` file); -1 where the host has none (macOS).
fn unreaped_children() -> int {
    let pid = os_pid()
    let text = fs.read_text("/proc/{pid}/task/{pid}/children") else |_| { return -1 }
    text.words().len
}

// Port-only: C's `job_no_fd_or_zombie_leak_across_many_spawns`
// (`test_job.c:1167-1205`, DoD 8) through the synchronous route — 500
// spawn/wait cycles after a warm-up, the open descriptor count unchanged
// and no child left unreaped after any of them.
fn t_port_job_sync_route_leaks_no_fd_or_zombie() {
    var (ed, base) = fixture(bytes_of("x\n"), "leak")
    var argv = List[str]()
    for a in ["/bin/sh", "-c", "exit 0"] {
        (mut argv).push(a)
    }
    let (ok0, _, e0) = edit.job_run_sync(mut ed, argv, "")
    assert(ok0, "warm-up: {e0}")
    let before = fd_count()
    assert(before > 0, "the descriptor table is readable")
    var i = 0
    while i < 500 {
        let (ok, w, err) = edit.job_run_sync(mut ed, argv, "")
        assert(ok && w.state == edit.JOB_EXITED && w.exit_code == 0, "cycle {i}: {err}")
        let left = unreaped_children()
        assert(left <= 0, "cycle {i}: {left} children unreaped")
        i += 1
    }
    let after = fd_count()
    assert(after == before, "descriptors: {before} before, {after} after")
    if unreaped_children() < 0 {
        print(
            "job_test: note: no per-thread children file on this host; the reap rests on wait_status",
        )
    }
    fs.remove_dir_all(base) else |_| {}
}

fn main() {
    // The session's `--yew-env0` runs this binary (`unit_main.c:14-19`).
    if edit.shsession_env0_requested() {
        os_exit(edit.shsession_env0_main())
    }
    fs.create_dir_all("target/tests") else |_| {}
    env_set("YEW_LOG", "/dev/null") else |_| {}
    signal.listen(signal.child()) else |_| {}
    var skips = 0
    t_job_buffer_append_updates_syntax()
    t_job_output_dismiss_and_quit_restore_dirty_origin()
    t_job_escape_dismisses_output_like_quit()
    t_job_echo_lifecycle()
    t_job_internal_ids_do_not_advance_public_ids()
    t_job_argv_resolves_path_and_preserves_explicit_paths()
    t_job_exec_failure_is_not_exit_127()
    t_job_exit_127_is_not_exec_failure()
    t_job_exit_code_and_stderr()
    t_job_killed_by_signal()
    t_job_signal_reaches_the_whole_group()
    t_job_max_refuses_rather_than_queues()
    t_job_stdin_region_is_piped()
    t_job_stdin_bytes_are_binary_exact_and_wiped()
    skips += t_job_stdin_bytes_are_wiped_when_child_closes_early()
    t_job_stream_bypasses_safe_prefix()
    t_job_stream_routes_stderr_and_owns_lifecycle()
    t_job_stream_callback_failure_terminates_job()
    t_job_stream_read_budget_is_bounded()
    t_job_no_fd_or_zombie_leak_across_many_spawns()
    t_job_running_count_tracks_state()
    t_job_timeout_escalates_to_kill()
    t_job_shell_resolution_prefers_env()
    t_job_callback_waits_for_reap_and_both_eofs_then_releases()
    t_job_callback_collect_max_and_destroy_on_teardown()
    t_job_environment_overrides_are_copied_and_name_exact()
    t_job_standard_environment_is_exact_and_parent_unchanged()
    t_filter_nonzero_preserves_text_undo_and_journal()
    t_job_torture_spawn_kill_cycles()
    t_port_job_standard_environment_in_the_handover_child()
    t_port_job_exec_failure_exit_127_and_signal_are_distinct()
    t_port_job_sync_route_leaks_no_fd_or_zombie()
    print("job_test: {29 - skips} C cases pass, {skips} SKIP; 3 port cases pass")
}
