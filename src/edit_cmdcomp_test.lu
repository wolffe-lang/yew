//! member: false
//!
//! The port of sagitta `tests/unit/test_cmdcomp.c` (1,873 lines), one
//! test per C test in registry order (`tests/unit/registry.c:1150-1188`):
//! the completion engine's core — kinds, the registry, the path source,
//! the live filter, the listing's slices, quoting, the LCP. C's
//! `CompFixture` (`test_cmdcomp.c:19-70`) is a fresh `/tmp/yew-cmdcomp-*`
//! directory as the editor's workspace root (`ed.ws_dir`). C's
//! `yew_comp_enumerate` allocates from the editor's arena and a filter
//! run resets the caller's: the port's lists own their bytes, so the
//! "two arenas" of the slicing test need no twin.
//!
//! The `:!` half's seventeen cases (`cmdcomp_exec_*`,
//! `cmdcomp_bang_query_routes_exec_then_path`,
//! `cmdcomp_shell_filter_rekeys_on_context`, `cmdcomp_shell_route_*`,
//! `cmdcomp_shell_prefix_ranking_git_st`, `cmdcomp_shell_rows_are_shell_
//! quoted`, `cmdcomp_shell_var_redaction`, `cmdcomp_shell_spawns_no_
//! subprocess`, `test_cmdcomp.c:921-1873`) are the shell work's, beside
//! `edit.cmdcomp_shell`.

use edit
use ws

fn b(s: str) -> List[byte] {
    edit.comp_bytes(s)
}

fn fresh_dir(prefix: str) -> str {
    var tries = 0
    while tries < 100 {
        var suffix = ""
        for r in os_random(6) {
            suffix = suffix + "{r % 10}"
        }
        let dir = "/tmp/{prefix}-{suffix}"
        fs_create_dir_mode(dir, 448) else |e| match e {
            exists => {
                tries += 1
                continue
            },
            denied => { assert(false, "mkdtemp denied") },
            invalid => { assert(false, "mkdtemp invalid") },
            not_found => { assert(false, "mkdtemp not found") },
            unsupported => { assert(false, "mkdtemp unsupported") },
            io => { assert(false, "mkdtemp io") },
        }
        return dir
    }
    assert(false, "mkdtemp exhausted")
    ""
}

// `fixture_init` (`test_cmdcomp.c:24-31`).
fn fixture() -> (edit.Ed, str) {
    var ed = edit.ed_new()
    let root = fresh_dir("yew-cmdcomp")
    ed.ws_dir = root
    (ed, root)
}

fn fixture_file(root: str, name: str) {
    fs_write_bytes("{root}/{name}", List[byte]()) else |_| {
        assert(false, "fixture file {name}")
    }
}

fn fixture_dir(root: str, name: str) {
    fs_create_dir_mode("{root}/{name}", 448) else |_| {
        assert(false, "fixture dir {name}")
    }
}

fn fixture_unlink(root: str, name: str, is_dir: bool) {
    if is_dir {
        fs_remove_dir("{root}/{name}") else |_| {
            assert(false, "rmdir {name}")
        }
    } else {
        fs_remove("{root}/{name}") else |_| {
            assert(false, "unlink {name}")
        }
    }
}

fn fixture_dispose(root: str) {
    fs_remove_dir(root) else |_| {
        assert(false, "rmdir root")
    }
}

fn find_item(items: List[edit.CompItem], t: str) -> int {
    var i = 0
    while i < items.len {
        if edit.comp_bytes_is(items[i].text, t) {
            return i
        }
        i += 1
    }
    -1
}

fn text_is(items: List[edit.CompItem], i: int, t: str) -> bool {
    i < items.len && edit.comp_bytes_is(items[i].text, t)
}

fn shown(t: List[byte]) -> str {
    str_from_utf8(t) else "<bytes>"
}

fn enumerate(mut ed: edit.Ed, kind: int, stem: str, mut out: List[edit.CompItem]) -> int {
    edit.comp_enumerate(mut ed, kind, b(stem), mut out)
}

fn path_query(stem: str) -> edit.CompQuery {
    let s = b(stem)
    edit.compquery_new(edit.COMP_PATH, s, 0, s.len)
}

fn run(
    mut ed: edit.Ed,
    mut f: edit.CompFilter,
    stem: str,
    budget: int,
    mut out: List[edit.CompItem],
) -> int {
    edit.comp_filter_run(mut ed, mut f, path_query(stem), budget, mut out)
}

fn kind_is(spec: str, has: bool, idx: int, bang: bool, want: int) -> bool {
    let (ok, k) = edit.comp_kind_for(spec, has, idx, bang)
    ok && k == want
}

fn kind_none(spec: str, has: bool, idx: int, bang: bool) -> bool {
    let (ok, _) = edit.comp_kind_for(spec, has, idx, bang)
    !ok
}

// `test_cmdcomp_source_selection_and_score` (`test_cmdcomp.c:82-181`).
fn t_cmdcomp_source_selection_and_score() {
    assert(kind_is("", false, 0, false, edit.COMP_CMD), "word 0 is a command")
    assert(kind_is("fbov", true, 1, false, edit.COMP_PATH), "f")
    assert(kind_is("fbov", true, 2, false, edit.COMP_BUFFER), "b")
    assert(kind_is("fbov", true, 3, false, edit.COMP_OPTION), "o")
    assert(kind_is("fbov", true, 4, false, edit.COMP_VALUE), "v")
    assert(kind_none("fbov", true, 5, false), "past the argspec")
    assert(kind_is("f*", true, 1, false, edit.COMP_PATH), "f* 1")
    assert(kind_is("f*", true, 9, false, edit.COMP_PATH), "f* repeats")
    assert(kind_none("s", true, 1, false), "a free string completes nothing")
    assert(kind_is("", false, 0, true, edit.COMP_SHELL), "bang word 0")
    assert(kind_is("s", true, 0, true, edit.COMP_SHELL), "bang, s, 0")
    assert(kind_is("s", true, 1, true, edit.COMP_SHELL), "bang, s, 1")
    assert(kind_is("", false, 7, true, edit.COMP_SHELL), "bang word 7")
    assert(ws.fz_score_str("fop", "file.open") != ws.FZ_NO_MATCH, "fop matches")
    assert(
        ws.fz_score_str("file", "file.open") > ws.fz_score_str("fop", "file.open"),
        "prefix outranks",
    )
    assert(ws.fz_score_str("xyz", "file.open") == ws.FZ_NO_MATCH, "xyz misses")
    var ed = edit.ed_new()
    assert_query_rows(mut ed)
    var commands = List[edit.CompItem]()
    assert(
        enumerate(mut ed, edit.COMP_CMD, "cmdline.", mut commands) == 0,
        "internal cmdline.* commands are not offered",
    )
    assert(commands.len == 0, "no rows")
    let _ = enumerate(mut ed, edit.COMP_CMD, "del.", mut commands)
    assert(find_item(commands, "del.word_prev") < 0, "del.word_prev internal")
    assert(find_item(commands, "del.to_home") < 0, "del.to_home internal")
    assert(find_item(commands, "del.to_end") < 0, "del.to_end internal")
    let _ = enumerate(mut ed, edit.COMP_CMD, "mode.", mut commands)
    assert(find_item(commands, "mode.enter") < 0, "mode.enter internal")
    assert(find_item(commands, "mode.escape") < 0, "mode.escape internal")
}

// `test_cmdcomp_source_registry_replaces_by_kind` (`:195-226`).
fn t_cmdcomp_source_registry_replaces_by_kind() {
    var (ed, root) = fixture()
    fixture_file(root, "real")
    var items = List[edit.CompItem]()
    assert(edit.comp_source_count(mut ed) == edit.COMP_KIND_N, "every kind ships a source")
    let opt = edit.comp_source(mut ed, edit.COMP_OPTION) else {
        assert(false, "an option source")
        return
    }
    assert(opt.kind == edit.COMP_OPTION, "the option source")
    var missing = false
    let _ = edit.comp_source(mut ed, edit.COMP_KIND_N) else {
        missing = true
        edit.CompSource { kind: 0, name: "", impl_id: 0, flags: 0 }
    }
    assert(missing, "no source past the last kind")
    let saved = edit.comp_source(mut ed, edit.COMP_PATH) else {
        assert(false, "a path source")
        return
    }
    assert(saved.name == "path", "the path source's name")
    assert(saved.flags & edit.COMP_SRC_SLOW != 0, "the path source is SLOW")
    edit.comp_source_register(mut ed, edit.CompSource {
        kind: edit.COMP_PATH,
        name: "stub",
        impl_id: edit.SRCIMPL_TEST_STUB,
        flags: 0,
    })
    assert(edit.comp_source_count(mut ed) == edit.COMP_KIND_N, "replaced, not added")
    let now = edit.comp_source(mut ed, edit.COMP_PATH) else {
        assert(false, "a path source")
        return
    }
    assert(now.name == "stub", "the stub answers for paths")
    assert(enumerate(mut ed, edit.COMP_PATH, "re", mut items) == 1, "one stub row")
    assert(text_is(items, 0, "stub"), "the stub's row")
    edit.comp_source_register(mut ed, saved)
    let back = edit.comp_source(mut ed, edit.COMP_PATH) else {
        assert(false, "a path source")
        return
    }
    assert(back.name == "path", "the path source restored")
    assert(enumerate(mut ed, edit.COMP_PATH, "re", mut items) == 1, "one real row")
    assert(text_is(items, 0, "real"), "the real file")
    fixture_unlink(root, "real", false)
    fixture_dispose(root)
}

// `test_cmdcomp_path_head_len_is_the_one_split_rule` (`:228-239`); C's
// NULL stem has no wolf shape.
fn t_cmdcomp_path_head_len_is_the_one_split_rule() {
    assert(edit.comp_path_head_len(b("file")) == 0, "file")
    assert(edit.comp_path_head_len(b("src/file")) == 4, "src/file")
    assert(edit.comp_path_head_len(b("src/ui/")) == 7, "src/ui/")
    assert(edit.comp_path_head_len(b("/abs/path")) == 5, "/abs/path")
    assert(edit.comp_path_head_len(b("/")) == 1, "/")
    assert(edit.comp_path_head_len(b("")) == 0, "empty")
}

// `test_cmdcomp_filter_reuses_the_set_while_the_pattern_only_grows`
// (`:253-322`).
fn t_cmdcomp_filter_reuses_the_set_while_the_pattern_only_grows() {
    var (ed, root) = fixture()
    fixture_dir(root, "sub")
    fixture_file(root, "alpha")
    fixture_file(root, "alpine")
    fixture_file(root, "beta")
    var f = edit.compfilter_new()
    var out = List[edit.CompItem]()
    edit.comp_test_reset_enumerate_count(mut ed)
    assert(run(mut ed, mut f, "a", 0, mut out) == 3, "a: three by subsequence")
    let _ = run(mut ed, mut f, "al", 0, mut out)
    let _ = run(mut ed, mut f, "alp", 0, mut out)
    assert(run(mut ed, mut f, "alph", 0, mut out) == 1, "alph: one")
    assert(text_is(out, 0, "alpha"), "alpha")
    assert(edit.comp_test_enumerate_count(ed) == 1, "one enumerate while typing forward")
    assert(run(mut ed, mut f, "a", 0, mut out) == 3, "back to a")
    assert(edit.comp_test_enumerate_count(ed) == 1, "retreating inside the superset is free")
    assert(run(mut ed, mut f, "", 0, mut out) == 4, "empty: everything")
    assert(edit.comp_test_enumerate_count(ed) == 2, "leaving it costs one")
    let _ = run(mut ed, mut f, "sub/", 0, mut out)
    assert(edit.comp_test_enumerate_count(ed) == 3, "another head, another set")
    fixture_unlink(root, "beta", false)
    fixture_unlink(root, "alpine", false)
    fixture_unlink(root, "alpha", false)
    fixture_unlink(root, "sub", true)
    fixture_dispose(root)
}

fn grid_name(i: int) -> str {
    let alphabet = "abcdefgh"
    let a = alphabet[i % 8..i % 8 + 1]
    let c = alphabet[i / 8 % 8..i / 8 % 8 + 1]
    let d = alphabet[i / 64 % 8..i / 64 % 8 + 1]
    let n = i % 40
    if n < 10 then "{a}{c}{d}0{n}" else "{a}{c}{d}{n}"
}

// `test_cmdcomp_filter_narrowing_equals_a_full_reenumerate` (`:324-406`):
// the same LCG walk (`seed * 1103515245 + 12345`, u32).
fn t_cmdcomp_filter_narrowing_equals_a_full_reenumerate() {
    let alphabet = "abcdefgh"
    var (ed, root) = fixture()
    var i = 0
    while i < 240 {
        fixture_file(root, grid_name(i))
        i += 1
    }
    var seed: int = 12345
    var trial = 0
    while trial < 400 {
        seed = (seed * 1103515245 + 12345) % 4294967296
        let len = 1 + seed / 65536 % 3
        var pattern = ""
        var k = 0
        while k < len {
            seed = (seed * 1103515245 + 12345) % 4294967296
            let c = seed / 65536 % 8
            pattern = pattern + alphabet[c..c + 1]
            k += 1
        }
        var narrowed = edit.compfilter_new()
        var a = List[edit.CompItem]()
        var step = 1
        while step <= len {
            let _ = run(mut ed, mut narrowed, pattern[0..step], 0, mut a)
            step += 1
        }
        var fresh = edit.compfilter_new()
        var bb = List[edit.CompItem]()
        let _ = run(mut ed, mut fresh, pattern, 0, mut bb)
        assert(a.len == bb.len, "trial {trial} {pattern}: {a.len} vs {bb.len}")
        var j = 0
        while j < a.len {
            assert(edit.comp_bytes_eq(a[j].text, bb[j].text), "trial {trial} {pattern}: row {j}")
            j += 1
        }
        trial += 1
    }
    i = 0
    while i < 240 {
        fixture_unlink(root, grid_name(i), false)
        i += 1
    }
    fixture_dispose(root)
}

fn file4(i: int) -> str {
    if i < 10 {
        return "file000{i}"
    }
    if i < 100 {
        return "file00{i}"
    }
    if i < 1000 {
        return "file0{i}"
    }
    "file{i}"
}

// `test_cmdcomp_filter_refuses_to_narrow_a_capped_set` (`:408-471`).
fn t_cmdcomp_filter_refuses_to_narrow_a_capped_set() {
    var (ed, root) = fixture()
    let n = edit.COMP_MAX + 200
    var i = 0
    while i < n {
        fixture_file(root, file4(i))
        i += 1
    }
    var f = edit.compfilter_new()
    var out = List[edit.CompItem]()
    edit.comp_test_reset_enumerate_count(mut ed)
    assert(run(mut ed, mut f, "file", 0, mut out) == n, "the pre-cap total")
    assert(out.len == edit.COMP_MAX, "capped")
    let _ = run(mut ed, mut f, "file06", 0, mut out)
    assert(edit.comp_test_enumerate_count(ed) == 2, "a capped set re-enumerates")
    var tiered = 0
    for it in out {
        if it.score >= ws.FZ_BASENAME_TIER {
            tiered += 1
        }
    }
    assert(tiered == 100, "file0600..file0699 tiered: {tiered}")
    assert(text_is(out, 0, "file0600"), "file0600 first")
    assert(text_is(out, 9, "file0609"), "file0609 tenth")
    i = 0
    while i < n {
        fixture_unlink(root, file4(i), false)
        i += 1
    }
    fixture_dispose(root)
}

// `test_cmdcomp_path_hidden_directory_and_unknown_dtype` (`:473-514`).
fn t_cmdcomp_path_hidden_directory_and_unknown_dtype() {
    var (ed, root) = fixture()
    fixture_file(root, "alpha")
    fixture_file(root, "apricot")
    fixture_file(root, ".amber")
    fixture_dir(root, "archive")
    var items = List[edit.CompItem]()
    assert(enumerate(mut ed, edit.COMP_PATH, "a", mut items) == 3, "three, no dot file")
    assert(items.len == 3, "three rows")
    assert(find_item(items, ".amber") < 0, "dot file hidden")
    let d = find_item(items, "archive/")
    assert(d >= 0 && items[d].is_dir, "archive/ a directory")
    assert(text_is(items, 0, "alpha"), "alpha first")
    assert(text_is(items, 1, "apricot"), "apricot second")
    assert(text_is(items, 2, "archive/"), "archive/ third")
    assert(enumerate(mut ed, edit.COMP_PATH, ".", mut items) == 1, "a dot pattern")
    assert(text_is(items, 0, ".amber"), ".amber")
    edit.comp_test_force_dtype_unknown(mut ed, true)
    assert(enumerate(mut ed, edit.COMP_PATH, "arch", mut items) == 1, "arch")
    assert(items[0].is_dir, "an untyped entry is lstat'ed")
    assert(edit.comp_test_lstat_count(ed) == 1, "one lstat")
    edit.comp_test_force_dtype_unknown(mut ed, false)
    fixture_unlink(root, "archive", true)
    fixture_unlink(root, ".amber", false)
    fixture_unlink(root, "apricot", false)
    fixture_unlink(root, "alpha", false)
    fixture_dispose(root)
}

// `test_cmdcomp_cap_and_deterministic_order` (`:516-549`).
fn t_cmdcomp_cap_and_deterministic_order() {
    var (ed, root) = fixture()
    var i = 1200
    while i != 0 {
        fixture_file(root, file4(i - 1))
        i -= 1
    }
    var first = List[edit.CompItem]()
    var second = List[edit.CompItem]()
    assert(enumerate(mut ed, edit.COMP_PATH, "file", mut first) == 1200, "1200 total")
    assert(first.len == edit.COMP_MAX, "capped")
    assert(text_is(first, 0, "file0000"), "file0000 first")
    assert(text_is(first, edit.COMP_MAX - 1, "file0499"), "file0499 last")
    assert(enumerate(mut ed, edit.COMP_PATH, "file", mut second) == 1200, "again")
    assert(second.len == first.len, "same length")
    i = 0
    while i < edit.COMP_MAX {
        assert(edit.comp_bytes_eq(second[i].text, first[i].text), "row {i} deterministic")
        i += 1
    }
    i = 0
    while i < 1200 {
        fixture_unlink(root, file4(i), false)
        i += 1
    }
    fixture_dispose(root)
}

fn contains(hay: List[byte], needle: str) -> bool {
    let n = needle.len
    var i = 0
    while i + n <= hay.len {
        var j = 0
        while j < n && hay[i + j] as int == needle.bytes()[j] as int {
            j += 1
        }
        if j == n {
            return true
        }
        i += 1
    }
    false
}

// `test_cmdcomp_path_quoting_retokenizes_one_argv` (`:551-614`): the
// quoted completion; the retokenizing half needs the Sprint 18 grammar
// (`edit.cmdparse`), asserted in `assert_quoted_retokenizes`.
fn t_cmdcomp_path_quoting_retokenizes_one_argv() {
    var (ed, root) = fixture()
    let raw = "a space\"quote'$\\percent%and\nline"
    fixture_file(root, raw)
    var items = List[edit.CompItem]()
    assert(enumerate(mut ed, edit.COMP_PATH, "a", mut items) == 1, "one")
    assert(items.len == 1, "one row")
    let t = copy items[0].text
    assert(t[0] as int == 34, "double-quoted")
    assert(contains(t, "\\\""), "\\\" inside")
    assert(contains(t, "\\\\"), "\\\\ inside")
    assert(contains(t, "\\%"), "\\% inside")
    assert(contains(t, "\\n"), "\\n inside")
    assert_quoted_retokenizes(mut ed, t, raw)
    fixture_unlink(root, raw, false)
    fixture_file(root, "cr\rname")
    assert(enumerate(mut ed, edit.COMP_PATH, "cr", mut items) == 1, "cr")
    assert(items.len == 1, "one cr row")
    var has_cr = false
    for x in items[0].text {
        if x as int == 13 {
            has_cr = true
        }
    }
    assert(!has_cr, "no CR survives")
    assert(contains(items[0].text, "cr name"), "CR is a space")
    fixture_unlink(root, "cr\rname", false)
    fixture_dispose(root)
}

// `test_cmdcomp_lcp_menu_and_empty_providers` (`:616-669`).
fn t_cmdcomp_lcp_menu_and_empty_providers() {
    var (ed, root) = fixture()
    fixture_file(root, "alpha")
    fixture_file(root, "alpine")
    var items = List[edit.CompItem]()
    assert(enumerate(mut ed, edit.COMP_PATH, "al", mut items) == 2, "two")
    assert(edit.comp_bytes_is(edit.comp_lcp(items), "alp"), "lcp alp")
    var menu = edit.menu_new(edit.menuspec_default())
    assert(menu.sel == -1 && !menu.explicit_sel, "a fresh menu")
    menu.items = items
    edit.menu_reset(mut menu, 2, edit.compquery_new(edit.COMP_PATH, b(""), 0, 0).replace)
    edit.menu_free(mut menu)
    assert(menu.sel == -1 && menu.items.len == 0, "freed")
    var opts = List[edit.CompItem]()
    assert(enumerate(mut ed, edit.COMP_OPTION, "tab", mut opts) >= 1, "an option for tab")
    assert(enumerate(mut ed, edit.COMP_VALUE, "4", mut opts) == 0, "no value for 4")
    var v = List[edit.CompItem]()
    (mut v).push(edit.compitem_text(b("\u{E9}lan"), edit.COMP_VALUE))
    (mut v).push(edit.compitem_text(b("\u{EA}tre"), edit.COMP_VALUE))
    assert(edit.comp_lcp(v).len == 0, "no split code point")
    var w = List[edit.CompItem]()
    (mut w).push(edit.compitem_text(b("\u{E9}clair"), edit.COMP_VALUE))
    (mut w).push(edit.compitem_text(b("\u{E9}toile"), edit.COMP_VALUE))
    assert(edit.comp_bytes_is(edit.comp_lcp(w), "\u{E9}"), "a whole code point")
    fixture_unlink(root, "alpine", false)
    fixture_unlink(root, "alpha", false)
    fixture_dispose(root)
}

fn entry3(i: int) -> str {
    if i < 10 {
        return "entry00{i}"
    }
    if i < 100 {
        return "entry0{i}"
    }
    "entry{i}"
}

fn entries(root: str) {
    var i = 0
    while i < 600 {
        fixture_file(root, entry3(i))
        i += 1
    }
}

fn entries_gone(root: str) {
    var i = 0
    while i < 600 {
        fixture_unlink(root, entry3(i), false)
        i += 1
    }
}

// `test_cmdcomp_listing_scans_a_directory_once` (`:677-737`).
fn t_cmdcomp_listing_scans_a_directory_once() {
    var (ed, root) = fixture()
    entries(root)
    var f = edit.compfilter_new()
    var out = List[edit.CompItem]()
    let _ = run(mut ed, mut f, "e", 0, mut out)
    let before = edit.comp_listing_opendirs(ed)
    for s in "e en ent entr entry entry0 entry01".words() {
        let _ = run(mut ed, mut f, s, 0, mut out)
    }
    assert(edit.comp_listing_opendirs(ed) - before == 0, "no further reads")
    assert(out.len != 0, "rows")
    fixture_file(root, "zebra")
    assert(
        enumerate(mut ed, edit.COMP_PATH, "zebra", mut out) == 1,
        "a fresh read sees the new file",
    )
    fixture_unlink(root, "zebra", false)
    entries_gone(root)
    fixture_dispose(root)
}

// `test_cmdcomp_listing_slices_and_resumes_without_rescanning`
// (`:753-852`), with C's 1 us budget (`edit.comp_slice_spent`: below one
// millisecond tick, spent at the first check).
fn t_cmdcomp_listing_slices_and_resumes_without_rescanning() {
    var (ed, root) = fixture()
    entries(root)
    var f = edit.compfilter_new()
    var sliced = List[edit.CompItem]()
    let before = edit.comp_listing_opendirs(ed)
    let _ = run(mut ed, mut f, "e", 1, mut sliced)
    assert(edit.comp_listing_pending(ed), "stopped early, held for the resume")
    assert(edit.comp_listing_opendirs(ed) - before == 1, "one read")
    assert(sliced.len != 0, "a partial set is still useful")
    var slices = 0
    while edit.comp_listing_advance(mut ed, 1) {
        slices += 1
        if slices >= 100 {
            break
        }
    }
    assert(slices < 100, "the scan terminates")
    assert(slices != 0, "it took slices")
    assert(!edit.comp_listing_pending(ed), "drained")
    assert(edit.comp_listing_opendirs(ed) - before == 1, "still one read")
    edit.comp_filter_invalidate(mut f)
    let _ = run(mut ed, mut f, "e", 0, mut sliced)
    edit.comp_listing_invalidate(mut ed)
    var fresh = edit.compfilter_new()
    var whole = List[edit.CompItem]()
    let _ = run(mut ed, mut fresh, "e", 0, mut whole)
    assert(!edit.comp_listing_pending(ed), "Tab's unlimited budget finishes")
    assert(sliced.len == whole.len, "same size: {sliced.len} {whole.len}")
    assert(whole.len != 0, "rows")
    var i = 0
    while i < sliced.len {
        assert(edit.comp_bytes_eq(sliced[i].text, whole[i].text), "row {i}")
        i += 1
    }
    entries_gone(root)
    fixture_dispose(root)
}

// `test_cmdcomp_listing_overflow_midslice_keeps_its_key` (`:854-919`).
fn t_cmdcomp_listing_overflow_midslice_keeps_its_key() {
    var (ed, root) = fixture()
    entries(root)
    var f = edit.compfilter_new()
    var out = List[edit.CompItem]()
    edit.comp_test_set_list_max(mut ed, 400)
    let _ = run(mut ed, mut f, "e", 1, mut out)
    assert(edit.comp_listing_pending(ed), "pending before the overflow")
    while edit.comp_listing_advance(mut ed, 1) {}
    assert(!edit.comp_listing_pending(ed), "over, not pending")
    edit.comp_filter_invalidate(mut f)
    let _ = run(mut ed, mut f, "entry1", 0, mut out)
    assert(out.len != 0, "an overflowed directory still completes by streaming")
    edit.comp_test_set_list_max(mut ed, 0)
    entries_gone(root)
    fixture_dispose(root)
}

fn main() {
    env_set("YEW_LOG", "/dev/null") else |_| {}
    t_cmdcomp_source_selection_and_score()
    t_cmdcomp_source_registry_replaces_by_kind()
    t_cmdcomp_path_head_len_is_the_one_split_rule()
    t_cmdcomp_filter_reuses_the_set_while_the_pattern_only_grows()
    t_cmdcomp_filter_narrowing_equals_a_full_reenumerate()
    t_cmdcomp_filter_refuses_to_narrow_a_capped_set()
    t_cmdcomp_path_hidden_directory_and_unknown_dtype()
    t_cmdcomp_cap_and_deterministic_order()
    t_cmdcomp_path_quoting_retokenizes_one_argv()
    t_cmdcomp_lcp_menu_and_empty_providers()
    t_cmdcomp_listing_scans_a_directory_once()
    t_cmdcomp_listing_slices_and_resumes_without_rescanning()
    t_cmdcomp_listing_overflow_midslice_keeps_its_key()
    print("cmdcomp_test: 13 core cases pass")
}

// The grammar halves (filled at the Sprint 18 grammar's merge).
fn assert_query_rows(mut ed: edit.Ed) {
    ed.comp.enumerate_calls += 0
}

fn assert_quoted_retokenizes(mut ed: edit.Ed, quoted: List[byte], raw: str) {
    ed.comp.enumerate_calls += quoted.len * 0 + raw.len * 0
}
