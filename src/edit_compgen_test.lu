//! member: false
//!
//! The port of sagitta `tests/unit/test_compgen.c` (797 lines), one test
//! per C test in registry order. The three built-in cases run; the nine
//! that drive a subprocess generator through the job layer (its pipes
//! read while the loop runs, its timeout, its eviction, its arrival into
//! an open prompt) SKIP loudly by name — ruling R-yw04-1: at wolf 0.2.33
//! there is no wait over N descriptors (G2, wolf-lang#795). Two port-only
//! cases stand beside them: the spawn refuses BY NAME the way C's spawn
//! failure is reported (§5.6), and the output parser `gen_complete` runs
//! keeps C's rules (the rows `test_compgen_lines_become_rows` asserts).

use edit
use std.fs

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

struct Fix {
    root: str,
    home: str,
    old_home: str,
    had_home: bool,
}

fn env_copy(name: str) -> (str, bool) {
    let v = env_get(name) else |_| { return ("", false) }
    (v, true)
}

fn fix_init(tag: str) -> Fix {
    let (old, had) = env_copy("HOME")
    let root = "/tmp/yew-compgen-{os_pid()}-{tag}"
    fs.remove_dir_all(root) else |_| {}
    fs.create_dir_all("{root}/home/.ssh") else |_| { assert(false, "mkdir") }
    env_set("HOME", "{root}/home") else |_| {}
    Fix { root: root, home: "{root}/home", old_home: old, had_home: had }
}

fn fix_drop(f: Fix) {
    if f.had_home {
        env_set("HOME", f.old_home) else |_| {}
    } else {
        env_unset("HOME") else |_| {}
    }
    assert(f.root.starts_with("/tmp/yew-"), "only /tmp/yew-*")
    fs.remove_dir_all(f.root) else |_| { assert(false, "remove {f.root}") }
}

fn row_named(rows: List[edit.GenItem], text: str) -> int {
    var i = 0
    while i < rows.len {
        if rows[i].text == text {
            return i
        }
        i += 1
    }
    -1
}

// DoD 7 and §5's hosts pitfall (`test_compgen.c:127-185`).
fn t_compgen_hosts_reads_the_fixture_home_only() {
    let f = fix_init("hosts")
    fs.write_text(
        "{f.home}/.ssh/config",
        "# comment\nHost a b\n  User me\nHost *.corp\nHost !x\nhost=lower\n",
    ) else |_| {}
    fs.write_text(
        "{f.home}/.ssh/known_hosts",
        "kh1,10.0.0.1 ssh-ed25519 AAAA\n|1|HASHED= ssh-ed25519 AAAA\n[kh2]:2222 ssh-rsa AAAA\n@cert-authority *.example ssh-rsa AAAA\na ssh-ed25519 AAAA\n",
    ) else |_| {}
    var rows = List[edit.GenItem]()
    assert(edit.compgen_builtin("hosts", "", "", false, mut rows), "hosts is a built-in")
    assert(rows.len == 6, "six hosts, got {rows.len}")
    assert(rows[0].text == "a" && rows[0].detail == "ssh config", "a")
    assert(rows[1].text == "b", "b")
    assert(rows[2].text == "lower", "lower")
    assert(rows[3].text == "kh1" && rows[3].detail == "known host", "kh1")
    assert(rows[4].text == "10.0.0.1", "10.0.0.1")
    assert(rows[5].text == "kh2", "kh2")
    assert(row_named(rows, "*.corp") < 0, "no pattern")
    assert(row_named(rows, "!x") < 0, "no negation")
    var from_config = 0
    for r in rows {
        if r.detail == "ssh config" && r.text != "lower" {
            from_config += 1
        }
    }
    assert(from_config == 2, "a and b only from the config")
    env_unset("HOME") else |_| {}
    var none = List[edit.GenItem]()
    assert(edit.compgen_builtin("hosts", "", "", false, mut none), "still a built-in")
    assert(none.len == 0, "no HOME, no hosts")
    fix_drop(f)
}

// DoD 6: make_targets PARSES the Makefile (`test_compgen.c:192-261`).
fn t_compgen_make_targets_never_executes_the_makefile() {
    let f = fix_init("make")
    let sentinel = "{f.root}/sentinel"
    fs.write_text(
        "{f.root}/Makefile",
        "X := $(shell touch sentinel)\nY ::= y\nZ = z\nW ?= w\n.PHONY: all build\nall: build\nbuild test: dep\n\t$(CC) -o $@ $^\na b : \\\n\tnot-a-target: x\ninstall:\n%.o: %.c\n$(OUT): in\ndist/yew.tar: all\ndefine RECIPE\nhidden: x\nendef\ncheck-x:: y\nall: again\n",
    ) else |_| {}
    var rows = List[edit.GenItem]()
    assert(edit.compgen_builtin("make_targets", f.root, "", false, mut rows), "make_targets")
    var want = List[str]()
    for w in ["all", "build", "test", "a", "b", "install", "dist/yew.tar", "check-x"] {
        (mut want).push(w)
    }
    assert(rows.len == want.len, "{want.len} targets, got {rows.len}")
    var i = 0
    while i < want.len {
        assert(rows[i].text == want[i], "target {i}: {rows[i].text}")
        assert(rows[i].detail == "make target", "detail")
        i += 1
    }
    assert(!fs.exists(sentinel), "nothing evaluated the Makefile")
    fs.write_text("{f.root}/GNUmakefile", "gnu-only:\n") else |_| {}
    var gnu = List[edit.GenItem]()
    assert(edit.compgen_builtin("make_targets", f.root, "", false, mut gnu), "make_targets")
    assert(gnu.len == 1 && gnu[0].text == "gnu-only", "GNUmakefile wins")
    fs.write_text("{f.root}/other.mk", "from-other:\n") else |_| {}
    var other = List[edit.GenItem]()
    assert(edit.compgen_builtin("make_targets", f.root, "other.mk", true, mut other), "make -f")
    assert(other.len == 1 && other[0].text == "from-other", "that file")
    assert(!fs.exists(sentinel), "still nothing evaluated")
    fix_drop(f)
}

// `test_compgen.c:264-278`.
fn t_compgen_signals_with_and_without_sig() {
    var rows = List[edit.GenItem]()
    assert(edit.compgen_builtin("signals", "", "", false, mut rows), "signals")
    assert(rows.len == 22, "22 rows")
    assert(row_named(rows, "KILL") >= 0, "KILL")
    assert(row_named(rows, "SIGWINCH") >= 0, "SIGWINCH")
    assert(rows[row_named(rows, "TERM")].detail == "terminate", "TERM terminates")
    var more = List[edit.GenItem]()
    assert(!edit.compgen_builtin("nope", "", "", false, mut more), "not a built-in")
}

// Port-only: the rows `gen_complete` parses out of a finished job
// (`compgen.c:622-693`), on the bytes `test_compgen_lines_become_rows`'
// script prints (its environment and cwd lines are the job's, R-yw04-1).
fn t_port_compgen_parse_rules() {
    var data = List[byte]()
    for b in "zeta\tlast letter  \n\nalpha  \nb".bytes() {
        (mut data).push(b)
    }
    (mut data).push(27 as byte)
    for b in "[2Jx\tde".bytes() {
        (mut data).push(b)
    }
    (mut data).push(1 as byte)
    for b in "sc\n   \n".bytes() {
        (mut data).push(b)
    }
    let rows = edit.compgen_parse(data, false)
    assert(rows.len == 3, "three rows, got {rows.len}")
    assert(rows[0].text == "zeta" && rows[0].has_detail && rows[0].detail == "last letter", "zeta")
    assert(rows[1].text == "alpha" && !rows[1].has_detail, "alpha has no detail")
    assert(rows[2].text == "b\u{B7}[2Jx", "control bytes drawn as a dot: {rows[2].text}")
    assert(rows[2].detail == "de\u{B7}sc", "in the detail too")
    let ps = edit.compgen_parse(bytes_of("  42 /usr/bin/vim\n7 bash\n"), true)
    assert(ps.len == 2 && ps[0].text == "42" && ps[0].detail == "vim", "ps columns: the basename")
    assert(ps[1].text == "7" && ps[1].detail == "bash", "ps")
}

// Port-only: a spec generator's spawn refuses by name (R-yw04-1), cached
// as C caches a spawn failure (§5.6): empty, fresh for cache_ms, logged.
fn t_port_compgen_spawn_refuses_by_name() {
    var g = edit.compgen_new()
    var argv = List[str]()
    (mut argv).push("/bin/echo")
    let key = edit.GenKey {
        name: "test:echo",
        argv: argv,
        cwd: "/tmp",
        has_cwd: true,
        cache_ms: 2000,
        ps_columns: false,
    }
    var rows = List[edit.GenItem]()
    let (ok, pending) = edit.compgen_rows(mut g, key, 1000, 0, mut rows)
    assert(ok, "answered")
    assert(!pending, "nothing in flight: the spawn refused")
    assert(rows.len == 0, "the empty answer")
    assert(edit.compgen_spawns(g) == 1, "one spawn attempted")
    let (ok2, _) = edit.compgen_rows(mut g, key, 1500, 0, mut rows)
    assert(ok2 && edit.compgen_spawns(g) == 1, "the cached empty answer, no respawn")
    let (_, _) = edit.compgen_rows(mut g, key, 4000, 0, mut rows)
    assert(edit.compgen_spawns(g) == 2, "stale: asked again")
    let log = fs.read_text(env_get("YEW_LOG") else "") else ""
    assert(
        log.contains(
            "completion generator test:echo: not yet ported: the completion generator job: needs os_signal_wait_fds (G2, wolf-lang#795)",
        ),
        "the refusal is in the log: {log}",
    )
    assert(
        edit.compgen_key_string(key) == "test:echo\u{1F}/bin/echo\u{1E}/tmp",
        "the key's identity",
    )
}

fn skip(name: str) -> int {
    let why = "a subprocess generator reads its pipe while the loop runs: needs os_signal_wait_fds (G2, wolf-lang#795), R-yw04-1"
    print("compgen_test: SKIP {name}: {why}")
    eprint("compgen_test: SKIP {name}: {why}")
    1
}

fn main() {
    // The session's `--yew-env0` runs this binary (`unit_main.c:14-19`).
    if edit.shsession_env0_requested() {
        os_exit(edit.shsession_env0_main())
    }
    fs.create_dir_all("target/tests") else |_| {}
    let log = "target/tests/edit-compgen-test.log"
    fs.remove(log) else |_| {}
    env_set("YEW_LOG", log) else |_| {}
    var skips = 0
    t_compgen_hosts_reads_the_fixture_home_only()
    t_compgen_make_targets_never_executes_the_makefile()
    t_compgen_signals_with_and_without_sig()
    skips += skip("compgen_lines_become_rows")
    skips += skip("compgen_timeout_kills_and_caches_empty")
    skips += skip("compgen_failure_caches_an_empty_answer")
    skips += skip("compgen_output_is_capped")
    skips += skip("compgen_fifty_keystrokes_stay_within_the_caps")
    skips += skip("compgen_never_costs_the_user_a_job_slot")
    skips += skip("compgen_arrival_refilters_but_never_edits")
    skips += skip("compgen_arrival_after_prompt_close")
    skips += skip("compgen_arrival_for_a_stale_context_is_only_cached")
    t_port_compgen_parse_rules()
    t_port_compgen_spawn_refuses_by_name()
    print("compgen_test: {12 - skips} C cases pass, {skips} SKIP; 2 port cases pass")
}
