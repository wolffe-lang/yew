//! member: false
//!
//! The port of sagitta `tests/unit/test_picker.c` (568 lines), one test
//! per C test in registry order (`tests/unit/registry.c:2501-2513`): THE
//! law first — a reorder under the selection, the held payload followed
//! and Enter opening it — then the fall to row 0, movement, the Ctrl
//! chords, the counts, the empty list, Escape, the swallowed key, the
//! filter line as the s18 widget (opened lazily), a same-length change
//! refiltering (with C's 8 MiB borrowed search part sliced across idle
//! ticks), the split accept, the tiny terminal, and the draw.
//!
//! The port's shapes. C's test callbacks (`pk_items`, `pk_accept`,
//! `pk_preview`, `pk_search_part`, `test_picker.c:42-85`) are the probe
//! host (`edit.PICK_HOST_PROBE`): its accept and preview record into
//! `ed.picker`, its search part is `ed.picker.probe_text`. C's globals
//! (`g_accepted`, `g_accept_how`, ...) are those records. C's fixture is a
//! fresh editor per case on a 24x80 grid (`pk_make`, `:87-99`).
//!
//! What C's own key route does, the port does (the C witness W3,
//! `notes/yw06-evidence/pick/witness/c-witness.log`): the two Backspaces
//! of `picker_same_length_filter_change_refilters` are swallowed — C's
//! `yew_cmdline_key` takes printable text only — so the line reads
//! `abba`, matches nothing, and the case's `with_ab != with_ba` holds as
//! it holds in C.
//!
//! `YEW_PICK_CASE=N` runs case N alone (the checked machine's per-case
//! run, G29).

use edit
use term

// `pk_make` (`test_picker.c:87-99`).
fn pk_make() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    ed.grid = term.grid_new(24, 80)
    ed.grid_ready = true
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 80, 24))
    ed
}

fn item(label: str, payload: int) -> edit.PickItem {
    edit.pick_item(label, payload, 0)
}

// `pk_open` (`test_picker.c:108-121`).
fn pk_open(mut ed: edit.Ed, take items: List[edit.PickItem], path_mode: bool) {
    var spec = edit.picker_spec(edit.PICK_HOST_PROBE, "Test", take items)
    spec.path_mode = path_mode
    edit.picker_open(mut ed, spec)
}

// `pk_type` (`test_picker.c:124-133`).
fn pk_type(mut ed: edit.Ed, c: int) {
    var k = term.key_new()
    k.code = c
    (mut k.text).push(c as byte)
    assert(edit.picker_key(mut ed, k), "typed key {c} consumed")
}

// `pk_press` (`test_picker.c:135-142`).
fn pk_press(mut ed: edit.Ed, code: int) {
    var k = term.key_new()
    k.code = code
    assert(edit.picker_key(mut ed, k), "key {code} consumed")
}

fn ctrl(c: int) -> term.Key {
    var k = term.key_new()
    k.code = c
    k.mods = term.MOD_CTRL
    k
}

// `test_picker_selection_survives_a_refilter` (`:157-186`).
fn picker_selection_survives_a_refilter() {
    var ed = pk_make()
    var items = List[edit.PickItem]()
    (mut items).push(item("alpha.c", 100))
    (mut items).push(item("beta.c", 200))
    (mut items).push(item("gamma_b.c", 300))
    (mut items).push(item("delta_b.c", 400))
    pk_open(mut ed, take items, true)
    assert(edit.picker_shown(ed) == 4, "four shown")
    pk_press(mut ed, term.KEY_DOWN)
    assert(edit.picker_selected(ed) == 200, "beta.c at row 1")
    pk_type(mut ed, 98)
    assert(edit.picker_shown(ed) >= 1, "something shown")
    assert(edit.picker_selected(ed) == 200, "the SAME item: {edit.picker_selected(ed)}")
    pk_press(mut ed, term.KEY_ENTER)
    assert(ed.picker.probe_accepted == 200, "Enter opened it: {ed.picker.probe_accepted}")
}

// `test_picker_selection_falls_to_row_zero_when_filtered_out`
// (`:193-215`).
fn picker_selection_falls_to_row_zero_when_filtered_out() {
    var ed = pk_make()
    var items = List[edit.PickItem]()
    (mut items).push(item("alpha.c", 100))
    (mut items).push(item("zulu.c", 200))
    (mut items).push(item("alpine.c", 300))
    pk_open(mut ed, take items, true)
    pk_press(mut ed, term.KEY_DOWN)
    assert(edit.picker_selected(ed) == 200, "zulu.c")
    pk_type(mut ed, 97)
    pk_type(mut ed, 108)
    pk_type(mut ed, 112)
    assert(edit.picker_shown(ed) > 0, "something shown")
    assert(edit.picker_selected(ed) != 200, "never the vanished item")
}

// `test_picker_movement_keys` (`:221-246`).
fn picker_movement_keys() {
    var ed = pk_make()
    var items = List[edit.PickItem]()
    (mut items).push(item("a", 1))
    (mut items).push(item("b", 2))
    (mut items).push(item("c", 3))
    (mut items).push(item("d", 4))
    (mut items).push(item("e", 5))
    pk_open(mut ed, take items, false)
    assert(edit.picker_selected(ed) == 1, "row 0")
    pk_press(mut ed, term.KEY_DOWN)
    assert(edit.picker_selected(ed) == 2, "down")
    pk_press(mut ed, term.KEY_END)
    assert(edit.picker_selected(ed) == 5, "end")
    pk_press(mut ed, term.KEY_HOME)
    assert(edit.picker_selected(ed) == 1, "home")
    pk_press(mut ed, term.KEY_UP)
    assert(edit.picker_selected(ed) == 1, "clamped at the top")
    pk_press(mut ed, term.KEY_END)
    pk_press(mut ed, term.KEY_DOWN)
    assert(edit.picker_selected(ed) == 5, "clamped at the bottom")
}

// `test_picker_ctrl_chords_move` (`:249-268`).
fn picker_ctrl_chords_move() {
    var ed = pk_make()
    var items = List[edit.PickItem]()
    (mut items).push(item("a", 1))
    (mut items).push(item("b", 2))
    (mut items).push(item("c", 3))
    pk_open(mut ed, take items, false)
    assert(edit.picker_key(mut ed, ctrl(110)), "C-n consumed")
    assert(edit.picker_selected(ed) == 2, "C-n moves down")
    assert(edit.picker_key(mut ed, ctrl(112)), "C-p consumed")
    assert(edit.picker_selected(ed) == 1, "C-p moves up")
}

// `test_picker_counts_shown_and_total` (`:275-294`).
fn picker_counts_shown_and_total() {
    var ed = pk_make()
    var items = List[edit.PickItem]()
    (mut items).push(item("alpha.c", 1))
    (mut items).push(item("beta.c", 2))
    (mut items).push(item("gamma.h", 3))
    pk_open(mut ed, take items, true)
    assert(edit.picker_shown(ed) == 3, "three shown")
    assert(edit.picker_total(ed) == 3, "three total")
    pk_type(mut ed, 104)
    assert(edit.picker_total(ed) == 3, "the total never changes")
    assert(edit.picker_shown(ed) < 3, "fewer shown: {edit.picker_shown(ed)}")
}

// `test_picker_empty_list_is_safe` (`:297-311`).
fn picker_empty_list_is_safe() {
    var ed = pk_make()
    let none = List[edit.PickItem]()
    pk_open(mut ed, take none, false)
    assert(edit.picker_shown(ed) == 0, "nothing shown")
    assert(edit.picker_selected(ed) == 0, "nothing selected")
    pk_press(mut ed, term.KEY_DOWN)
    pk_press(mut ed, term.KEY_ENTER)
    assert(ed.picker.probe_accepted == -1, "accept never called")
    assert(edit.picker_active(ed), "still up")
}

// `test_picker_escape_cancels` (`:314-326`).
fn picker_escape_cancels() {
    var ed = pk_make()
    var items = List[edit.PickItem]()
    (mut items).push(item("a", 7))
    pk_open(mut ed, take items, false)
    assert(edit.picker_active(ed), "up")
    pk_press(mut ed, term.KEY_ESCAPE)
    assert(!edit.picker_active(ed), "down")
    assert(ed.picker.probe_accepted == -1, "nothing accepted")
}

// `test_picker_swallows_unhandled_keys` (`:334-350`).
fn picker_swallows_unhandled_keys() {
    var ed = pk_make()
    var items = List[edit.PickItem]()
    (mut items).push(item("a", 7))
    pk_open(mut ed, take items, false)
    var k = term.key_new()
    k.code = term.KEY_F1
    assert(edit.picker_key(mut ed, k), "consumed while open")
    edit.picker_close(mut ed, false)
    assert(!edit.picker_key(mut ed, k), "a closed picker claims nothing")
}

// `test_picker_filter_line_is_the_cmdline` (`:362-394`).
fn picker_filter_line_is_the_cmdline() {
    var ed = pk_make()
    var items = List[edit.PickItem]()
    (mut items).push(item("alpha", 1))
    assert(!ed.cmdline.active, "no line yet")
    let first = copy items
    pk_open(mut ed, take first, false)
    edit.picker_draw(mut ed, edit.rect(0, 0, 80, 24))
    assert(ed.cmdline.active, "a draw brings it up")
    edit.picker_close(mut ed, false)
    pk_open(mut ed, take items, false)
    assert(!ed.cmdline.active, "not at open")
    pk_type(mut ed, 97)
    assert(ed.cmdline.active, "a key brings it up")
    let t = edit.cmdline_text(ed)
    assert(t.len == 1 && t[0] as int == 97, "the text comes back out")
    edit.picker_close(mut ed, false)
    assert(!ed.cmdline.active, "closed with the picker")
}

// `test_picker_same_length_filter_change_refilters` (`:402-468`).
fn picker_same_length_filter_change_refilters() {
    var ed = pk_make()
    var items = List[edit.PickItem]()
    (mut items).push(item("ab_first", 1))
    (mut items).push(item("ba_second", 2))
    pk_open(mut ed, take items, false)
    pk_type(mut ed, 97)
    pk_type(mut ed, 98)
    let with_ab = edit.picker_selected(ed)
    pk_press(mut ed, term.KEY_BACKSPACE)
    pk_press(mut ed, term.KEY_BACKSPACE)
    pk_type(mut ed, 98)
    pk_type(mut ed, 97)
    let with_ba = edit.picker_selected(ed)
    assert(with_ab != with_ba, "re-ranked: {with_ab} then {with_ba}")
    // A borrowed custom source scanned past the former 1 KiB bound, one
    // large candidate yielding to the idle tick.
    var big = pk_make()
    big.picker.probe_text = pk_large_text()
    var custom = List[edit.PickItem]()
    (mut custom).push(item("large macro", 9))
    var spec = edit.picker_spec(edit.PICK_HOST_PROBE, "Large", take custom)
    spec.has_accept = false
    spec.has_search_part = true
    edit.picker_open(mut big, spec)
    for c in "needle".bytes() {
        pk_type(mut big, c as int)
    }
    assert(edit.picker_scanning(big), "scanning")
    var ticks = 0
    while edit.picker_scanning(big) && ticks < 10000 {
        let _ = edit.picker_tick(mut big)
        ticks += 1
    }
    assert(ticks != 0, "it yielded")
    assert(!edit.picker_scanning(big), "finished")
    assert(edit.picker_shown(big) == 1, "found: {edit.picker_shown(big)}")
    assert(edit.picker_selected(big) == 9, "selected")
}

// C's 8 MiB of `x` ending in `needle` (`:434-440`, a `memset` and a
// `memcpy`), built a byte at a time on purpose: the checked machine
// copies a held text on reads its step budget does not count, so the
// builtin `repeat` let this case run there for upwards of 16 minutes at
// 2-4 GB; a pushed byte is a counted step, and the budget refuses the
// case in seconds (`notes/yw06-evidence/pick/units/README.txt`). The
// native lane runs it whole.
fn pk_large_text() -> str {
    let size = 8 * 1024 * 1024
    let needle = "needle"
    var b = List[byte]()
    var i = 0
    while i < size - needle.len {
        (mut b).push(120 as byte)
        i += 1
    }
    for x in needle.bytes() {
        (mut b).push(x)
    }
    str_from_utf8(b) else ""
}

// `test_picker_accept_in_split_reports_how` (`:471-488`).
fn picker_accept_in_split_reports_how() {
    var ed = pk_make()
    var items = List[edit.PickItem]()
    (mut items).push(item("a", 42))
    pk_open(mut ed, take items, false)
    assert(edit.picker_key(mut ed, ctrl(118)), "C-v consumed")
    assert(ed.picker.probe_accepted == 42, "accepted")
    assert(ed.picker.probe_how == edit.PICK_ACCEPT_VSPLIT, "how: {ed.picker.probe_how}")
    assert(edit.pane_leaf_count(ed, ed.pane_root) == 2, "the split really happened")
}

// `test_picker_refuses_a_tiny_terminal` (`:494-513`).
fn picker_refuses_a_tiny_terminal() {
    var ed = pk_make()
    ed.grid = term.grid_new(4, 20)
    var items = List[edit.PickItem]()
    (mut items).push(item("a", 1))
    let spec = edit.picker_spec(edit.PICK_HOST_PROBE, "Tiny", take items)
    edit.picker_open(mut ed, spec)
    assert(!edit.picker_active(ed), "refused")
    assert(ed.msg.active, "said so")
}

// `test_picker_draw_fits_the_grid` (`:516-568`).
fn picker_draw_fits_the_grid() {
    var ed = pk_make()
    ed.grid = term.grid_new(24, 200)
    edit.layout_compute(mut ed, ed.pane_root, edit.rect(0, 0, 200, 24))
    var items = List[edit.PickItem]()
    (mut items).push(edit.PickItem {
        label: "src/ui/tabs.c",
        detail: "src/ui",
        has_detail: true,
        payload: 1,
        flags: edit.PICK_MODIFIED,
    })
    (mut items).push(edit.PickItem {
        label: "src/ui/tabs.h",
        detail: "src/ui",
        has_detail: true,
        payload: 2,
        flags: 0,
    })
    (mut items).push(edit.
        PickItem { label: "日本語.c", detail: "cjk", has_detail: true, payload: 3, flags: 0 })
    // Ordinary pickers keep the centred 80-column cap.
    let first = copy items
    pk_open(mut ed, take first, true)
    edit.region_frame_begin(mut ed.regions)
    edit.picker_draw(mut ed, edit.rect(0, 0, 200, 24))
    assert(edit.region_hit(mut ed.regions, 21, 2).kind == edit.REGION_NONE, "outside the box")
    assert(edit.region_hit(mut ed.regions, 61, 2).kind == edit.REGION_BLOCK, "inside the box")
    edit.picker_close(mut ed, false)
    // A preview picker takes the wider bounded layout and the preview a
    // real slot beside the list.
    var spec = edit.picker_spec(edit.PICK_HOST_PROBE, "Preview", take items)
    spec.has_preview = true
    spec.path_mode = true
    ed.picker.probe_preview_calls = 0
    ed.picker.probe_preview_rect = edit.rect(0, 0, 0, 0)
    edit.picker_open(mut ed, spec)
    edit.region_frame_begin(mut ed.regions)
    edit.picker_draw(mut ed, edit.rect(0, 0, 200, 24))
    assert(ed.picker.probe_preview_calls == 1, "one preview: {ed.picker.probe_preview_calls}")
    assert(ed.picker.probe_preview_rect.w == 78, "slot width {ed.picker.probe_preview_rect.w}")
    assert(ed.picker.probe_preview_rect.h == 16, "slot height {ed.picker.probe_preview_rect.h}")
    assert(edit.region_hit(mut ed.regions, 21, 2).kind == edit.REGION_BLOCK, "the wider box")
    // A narrow box: no preview slot, the detail column dropped.
    edit.picker_draw(mut ed, edit.rect(0, 0, 30, 12))
    assert(ed.picker.probe_preview_calls == 1, "no preview in a narrow box")
}

fn main() {
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    var n = 0
    if chosen < 0 || chosen == 0 {
        picker_selection_survives_a_refilter()
        print("picker_selection_survives_a_refilter: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 1 {
        picker_selection_falls_to_row_zero_when_filtered_out()
        print("picker_selection_falls_to_row_zero_when_filtered_out: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 2 {
        picker_movement_keys()
        print("picker_movement_keys: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 3 {
        picker_ctrl_chords_move()
        print("picker_ctrl_chords_move: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 4 {
        picker_counts_shown_and_total()
        print("picker_counts_shown_and_total: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 5 {
        picker_empty_list_is_safe()
        print("picker_empty_list_is_safe: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 6 {
        picker_escape_cancels()
        print("picker_escape_cancels: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 7 {
        picker_swallows_unhandled_keys()
        print("picker_swallows_unhandled_keys: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 8 {
        picker_filter_line_is_the_cmdline()
        print("picker_filter_line_is_the_cmdline: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 9 {
        picker_same_length_filter_change_refilters()
        print("picker_same_length_filter_change_refilters: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 10 {
        picker_accept_in_split_reports_how()
        print("picker_accept_in_split_reports_how: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 11 {
        picker_refuses_a_tiny_terminal()
        print("picker_refuses_a_tiny_terminal: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 12 {
        picker_draw_fits_the_grid()
        print("picker_draw_fits_the_grid: PASS")
        n += 1
    }
    print("picker_test: {n} cases pass")
}
