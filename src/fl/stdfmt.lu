//! fl.stdfmt — Sprint 31's `fmt` module, sagitta 9ace98c2 src/fl/stdfmt.c:1-1276:
//! std.h:120-149's three renderers (stdfmt.c:298-640), the §6 directive
//! grammar (:711-966), the seven natives (:969-1260) and FMT_DEFS
//! (:1264-1272). A TEMPLATE IS DATA, NEVER A FORMAT: fmt.f ends in a string
//! or a raise. fmt.repr's text re-reads through fl_parse_literal or it raises.
//! Floats go through fl.float (R-yw07-4); G51 / wolf-std#103 (NaN sign) stays
//! open there. No native here reenters the VM, so no object moves while one
//! runs (collection waits for an instruction boundary). Raise text is C's
//! fl_raise (vm.c:206-233): each `%.*s` operand stops at its first NUL and
//! the message keeps vsnprintf's 1023 bytes.

use unicode
use util

// stdfmt.c:61-71: the result cap shared with str, the pad cap, the depth
// backstop and the 17 digits that always round-trip a double.
const FMT_MAX: int = 67108864

const FMT_MAX_WIDTH: int = 1048576

const FMT_MAX_DEPTH: int = 64

const FMT_MAX_PREC: int = 17

// ---------------------------------------------------------------- //
// Small emitters (stdfmt.c:85-247)                                 //
// ---------------------------------------------------------------- //

// C's `%.*s`: an operand stops at its first NUL byte.
fn fmt_put_upto_nul(mut out: List[byte], b: List[byte], lo: int, hi: int) {
    var i = lo
    while i < hi {
        if b[i] as int == 0 { return }
        (mut out).push(b[i])
        i += 1
    }
}

// vm.c:216-229: vsnprintf into a 1 KiB buffer keeps 1023 bytes.
fn fmt_raise_msg(mut vm: FlVm, kind: str, msg: List[byte]) -> FlValue {
    if msg.len <= 1023 { return fl_raise_bytes(mut vm, kind, msg) }
    var cut = List[byte]()
    (mut cut).reserve(1023)
    for i in 0..1023 { (mut cut).push(msg[i]) }
    fl_raise_bytes(mut vm, kind, cut)
}

fn fmt_truncate(mut b: List[byte], n: int) {
    while b.len > n { let _ = (mut b).pop() else 0 as byte }
}

// stdfmt.c:94-99.
fn fmt_hex2(mut out: List[byte], c: int) {
    util.buf_append_str(mut out, "\\x")
    (mut out).push("0123456789abcdef".bytes()[c / 16])
    (mut out).push("0123456789abcdef".bytes()[c % 16])
}

// stdfmt.c:100-114's me(): the qualified name of the native running now.
fn fmt_me(vm: FlVm) -> str {
    if vm.cur_native <= 0 || vm.cur_native >= vm.strings.items.len { return "fmt" }
    str_from_utf8(vm.strings.items[vm.cur_native]) else "fmt"
}

// stdfmt.c:134-161: digits from the remainder's magnitude, so INT64_MIN
// needs no negation (wolf's % takes the dividend's sign).
fn fmt_radix(mut out: List[byte], v: int, radix: int, upper: bool) {
    let digits = if upper {
        "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    } else {
        "0123456789abcdefghijklmnopqrstuvwxyz"
    }
    var tmp = List[byte]()
    var m = v
    loop {
        var d = m % radix
        if d < 0 { d = -d }
        (mut tmp).push(digits.bytes()[d])
        m = m / radix
        if m == 0 { break }
    }
    if v < 0 { (mut out).push(45 as byte) }
    var n = tmp.len
    while n > 0 {
        n -= 1
        (mut out).push(tmp[n])
    }
}

// stdfmt.c:163-187, the two libc sites: the precision clamped to 0..17
// (fl.float clamps again, as C does).
fn fmt_conv(mut out: List[byte], v: f64, prec: int, sci: bool) {
    let text = if sci then float_exp(v, prec) else float_fixed(v, prec)
    util.buf_append_str(mut out, text)
}

// stdfmt.c:238-275: `"` `\` `\n` `\t` `\r` `\0`, bytes below 0x20 and 0x7F
// as lowercase \xNN, every other byte verbatim (invariant 2).
fn fmt_quoted(mut out: List[byte], s: List[byte]) {
    (mut out).push(34 as byte)
    for x in s {
        let c = x as int
        if c == 34 {
            util.buf_append_str(mut out, "\\\"")
        } else if c == 92 {
            util.buf_append_str(mut out, "\\\\")
        } else if c == 10 {
            util.buf_append_str(mut out, "\\n")
        } else if c == 9 {
            util.buf_append_str(mut out, "\\t")
        } else if c == 13 {
            util.buf_append_str(mut out, "\\r")
        } else if c == 0 {
            util.buf_append_str(mut out, "\\0")
        } else if c < 32 || c == 127 {
            fmt_hex2(mut out, c)
        } else {
            (mut out).push(x)
        }
    }
    (mut out).push(34 as byte)
}

// stdfmt.c:277-296: bare only when it lexes back as an IDENT.
fn fmt_bare_key(s: List[byte]) -> bool {
    if s.len == 0 { return false }
    for i in 0..s.len {
        let c = s[i] as int
        let alpha = c >= 97 && c <= 122 || c >= 65 && c <= 90 || c == 95
        if !alpha && !(i > 0 && c >= 48 && c <= 57) { return false }
    }
    !fl_kw_reserved(s)
}

// ---------------------------------------------------------------- //
// str / repr (stdfmt.c:249-640)                                    //
// ---------------------------------------------------------------- //

// stdfmt.c:298-320's Rw: quoting and refusing are separate axes; `open`
// holds the slot of every container between the root and here, and
// membership IS the cycle test.
struct FmtRw {
    quote: bool,
    refuse: bool,
    max_depth: int,
    indent: int,
    path: List[byte],
    open: List[int],
}

// stdfmt.c:324-333.
fn fmt_rw_newline(w: FmtRw, mut out: List[byte], depth: int) {
    if w.indent == 0 { return }
    (mut out).push(10 as byte)
    var i = 0
    while i < depth * w.indent {
        (mut out).push(32 as byte)
        i += 1
    }
}

// stdfmt.c:335-341.
fn fmt_rw_cycle(mut vm: FlVm, w: FmtRw) -> bool {
    var msg = List[byte]()
    util.buf_append_str(mut msg, "fmt.repr: cycle at ")
    fmt_put_upto_nul(mut msg, w.path, 0, w.path.len)
    let _ = fmt_raise_msg(mut vm, "type", msg)
    false
}

// stdfmt.c:342-364: (ok, dup); ok is false only having raised the limit.
fn fmt_rw_enter(mut vm: FlVm, mut w: FmtRw, at: int) -> (bool, bool) {
    for o in w.open { if o == at { return (true, true) } }
    if w.open.len >= w.max_depth {
        if w.refuse {
            let _ = fl_raise(mut vm, "limit", "fmt.repr: nested deeper than {w.max_depth}")
            return (false, false)
        }
        // display gives up quietly rather than lying
        return (true, true)
    }
    (mut w.open).push(at)
    (true, false)
}

fn fmt_rw_leave(mut w: FmtRw) { let _ = (mut w.open).pop() else 0 }

// stdfmt.c:366-405.
fn fmt_rw_list(mut vm: FlVm, mut w: FmtRw, mut out: List[byte], v: FlValue) -> bool {
    let at = fl_obj_index(vm, v)
    let (ok, dup) = fmt_rw_enter(mut vm, mut w, at)
    if !ok { return false }
    if dup {
        if w.refuse { return fmt_rw_cycle(mut vm, w) }
        util.buf_append_str(mut out, "[...]")
        return true
    }
    let depth = w.open.len
    let n = vm.gc.slots[at].vals.len
    (mut out).push(91 as byte)
    for i in 0..n {
        let mark = w.path.len
        util.buf_append_str(mut w.path, "[{i}]")
        fmt_rw_newline(w, mut out, depth)
        let item = copy vm.gc.slots[at].vals[i]
        if !fmt_rw_value(mut vm, mut w, mut out, item) { return false }
        // A comma after EVERY element in the pretty form; the single-line
        // form drops the last one.
        if w.indent != 0 || i + 1 < n { (mut out).push(44 as byte) }
        if w.indent == 0 && i + 1 < n { (mut out).push(32 as byte) }
        fmt_truncate(mut w.path, mark)
    }
    fmt_rw_newline(w, mut out, depth - 1)
    (mut out).push(93 as byte)
    fmt_rw_leave(mut w)
    true
}

// stdfmt.c:407-446: §12's pl_entry spells IDENT, STRING and unsigned INT.
fn fmt_rw_key(mut vm: FlVm, w: FmtRw, mut out: List[byte], k: FlValue) -> bool {
    if k.t == FL_STR {
        let at = fl_obj_index(vm, k)
        if fmt_bare_key(vm.gc.slots[at].bytes) {
            util.buf_append(mut out, vm.gc.slots[at].bytes)
        } else {
            fmt_quoted(mut out, vm.gc.slots[at].bytes)
        }
        return true
    }
    if k.t == FL_INT {
        if w.refuse && k.i < 0 {
            let _ = fl_raise(
                mut vm,
                "type",
                "fmt.repr: map key {k.i} is negative, which pure-literal syntax cannot spell",
            )
            return false
        }
        fmt_radix(mut out, k.i, 10, false)
        return true
    }
    if k.t == FL_BOOL {
        let word = if k.i != 0 then "true" else "false"
        if w.refuse {
            let _ = fl_raise(
                mut vm,
                "type",
                "fmt.repr: map key {word} is a bool, which pure-literal syntax cannot spell",
            )
            return false
        }
        util.buf_append_str(mut out, word)
        return true
    }
    // fl_hashable already closed the key set to these three.
    (mut out).push(63 as byte)
    true
}

// stdfmt.c:448-505.
fn fmt_rw_map(mut vm: FlVm, mut w: FmtRw, mut out: List[byte], v: FlValue) -> bool {
    let at = fl_obj_index(vm, v)
    let (ok, dup) = fmt_rw_enter(mut vm, mut w, at)
    if !ok { return false }
    if dup {
        if w.refuse { return fmt_rw_cycle(mut vm, w) }
        util.buf_append_str(mut out, "{{...}}")
        return true
    }
    let depth = w.open.len
    let live = fl_map_count(vm, v)
    (mut out).push(123 as byte)
    var cursor = 0
    var seen = 0
    loop {
        let (next, k, val) = fl_map_iter(vm, v, cursor) else break
        cursor = next
        let mark = w.path.len
        if k.t == FL_STR {
            (mut w.path).push(46 as byte)
            util.buf_append(mut w.path, vm.gc.slots[fl_obj_index(vm, k)].bytes)
        } else if k.t == FL_INT {
            util.buf_append_str(mut w.path, "[{k.i}]")
        } else {
            util.buf_append_str(mut w.path, if k.i != 0 then "[true]" else "[false]")
        }
        fmt_rw_newline(w, mut out, depth)
        if !fmt_rw_key(mut vm, w, mut out, k) { return false }
        util.buf_append_str(mut out, ": ")
        if !fmt_rw_value(mut vm, mut w, mut out, val) { return false }
        seen += 1
        if w.indent != 0 || seen < live { (mut out).push(44 as byte) }
        if w.indent == 0 && seen < live { (mut out).push(32 as byte) }
        fmt_truncate(mut w.path, mark)
    }
    fmt_rw_newline(w, mut out, depth - 1)
    (mut out).push(125 as byte)
    fmt_rw_leave(mut w)
    true
}

// stdfmt.c:507-529: functions, natives and the reserved handles.
fn fmt_rw_uncodeable(mut vm: FlVm, w: FmtRw, mut out: List[byte], v: FlValue) -> bool {
    let nm = fl_type_name(v.t)
    if w.refuse {
        let _ = fl_raise(mut vm, "type", "fmt.repr: a {nm} has no pure-literal form")
        return false
    }
    (mut out).push(60 as byte)
    util.buf_append_str(mut out, nm)
    if v.t == FL_CLOSURE || v.t == FL_NATIVE {
        let at = fl_obj_index(vm, v)
        var id = vm.gc.slots[at].name_id
        if v.t == FL_CLOSURE {
            let f = copy vm.gc.slots[at].fn_value
            id = vm.gc.slots[fl_obj_index(vm, f)].name_id
        }
        if id > 0 && id < vm.strings.items.len {
            (mut out).push(32 as byte)
            fmt_put_upto_nul(mut out, vm.strings.items[id], 0, vm.strings.items[id].len)
        }
    }
    (mut out).push(62 as byte)
    true
}

// stdfmt.c:531-595.
fn fmt_rw_value(mut vm: FlVm, mut w: FmtRw, mut out: List[byte], v: FlValue) -> bool {
    if v.t == FL_NIL {
        util.buf_append_str(mut out, "nil")
        return true
    }
    if v.t == FL_BOOL {
        util.buf_append_str(mut out, if v.i != 0 then "true" else "false")
        return true
    }
    if v.t == FL_INT {
        // INT64_MIN has no literal: §1.4 folds the sign after the magnitude.
        if w.refuse && v.i == -9223372036854775807 - 1 {
            let _ = fl_raise(
                mut vm,
                "type",
                "fmt.repr: -9223372036854775808 has no integer literal; its magnitude is one past the i64 maximum",
            )
            return false
        }
        fmt_radix(mut out, v.i, 10, false)
        return true
    }
    if v.t == FL_FLOAT {
        let x = v.f
        if x != x || x > 1.7976931348623157e308 || x < -1.7976931348623157e308 {
            let word = if x != x then "nan" else if x > 0.0 then "inf" else "-inf"
            if w.refuse {
                let _ = fl_raise(mut vm, "type", "fmt.repr: {word} has no float literal")
                return false
            }
            util.buf_append_str(mut out, word)
            return true
        }
        util.buf_append_str(mut out, float_shortest(x))
        return true
    }
    if v.t == FL_STR {
        // Bare only at the ROOT of a display.
        let at = fl_obj_index(vm, v)
        if !w.quote && w.open.len == 0 {
            util.buf_append(mut out, vm.gc.slots[at].bytes)
        } else {
            fmt_quoted(mut out, vm.gc.slots[at].bytes)
        }
        return true
    }
    if v.t == FL_LIST { return fmt_rw_list(mut vm, mut w, mut out, v) }
    if v.t == FL_MAP { return fmt_rw_map(mut vm, mut w, mut out, v) }
    fmt_rw_uncodeable(mut vm, w, mut out, v)
}

// stdfmt.c:597-619's render_at/render: `out` belongs to the caller either way.
fn fmt_render(
    mut vm: FlVm,
    mut out: List[byte],
    v: FlValue,
    quote: bool,
    refuse: bool,
    indent: int,
    max_depth: int,
) -> bool {
    var w = FmtRw {
        quote: quote,
        refuse: refuse,
        max_depth: max_depth,
        indent: indent,
        path: List[byte](),
        open: List[int](),
    }
    fmt_rw_value(mut vm, mut w, mut out, v)
}

/// std.h:120-131, stdfmt.c:621-624: display (fmt.str, io.print), best-effort;
/// it never raises.
pub fn fl_fmt_display(mut vm: FlVm, mut out: List[byte], v: FlValue) -> bool {
    fmt_render(mut vm, mut out, v, false, false, 0, FMT_MAX_DEPTH)
}

/// std.h:133-141, stdfmt.c:626-629: pure-literal source; false having raised
/// on a value §12 cannot spell.
pub fn fl_fmt_repr(mut vm: FlVm, mut out: List[byte], v: FlValue) -> bool {
    fmt_render(mut vm, mut out, v, true, true, 0, FMT_MAX_DEPTH)
}

/// std.h:143-149, stdfmt.c:631-640: repr's quoting with display's elision;
/// a max_depth of 0 means the 64 backstop.
pub fn fl_fmt_repl(mut vm: FlVm, mut out: List[byte], v: FlValue, max_depth: int) -> bool {
    fmt_render(
        mut vm,
        mut out,
        v,
        true,
        false,
        0,
        if max_depth == 0 then FMT_MAX_DEPTH else max_depth,
    )
}

// ---------------------------------------------------------------- //
// Padding (stdfmt.c:642-709)                                       //
// ---------------------------------------------------------------- //

// stdfmt.c:644-653: display cells, a tab one cell (FMT_TABW, :73-81).
fn fmt_cells(b: List[byte]) -> int { unicode.str_width(b, 0, b.len, 1) }

// stdfmt.c:655-677: whole fills, then spaces for the remainder.
fn fmt_pad_with(mut out: List[byte], fill: List[byte], gap_in: int) {
    var fw = if fill.len == 0 then 1 else unicode.cluster_width(fill, 0, fill.len)
    if fw < 1 { fw = 1 }
    var gap = gap_in
    while gap >= fw {
        if fill.len == 0 { (mut out).push(32 as byte) } else { util.buf_append(mut out, fill) }
        gap -= fw
    }
    while gap > 0 {
        (mut out).push(32 as byte)
        gap -= 1
    }
}

// stdfmt.c:679-705: the odd cell of a centred field goes RIGHT.
fn fmt_align_into(mut out: List[byte], body: List[byte], width: int, align: int, fill: List[byte]) {
    let gap = width - fmt_cells(body)
    if gap <= 0 {
        util.buf_append(mut out, body)
        return
    }
    if align == 62 {
        fmt_pad_with(mut out, fill, gap)
        util.buf_append(mut out, body)
    } else if align == 94 {
        fmt_pad_with(mut out, fill, gap / 2)
        util.buf_append(mut out, body)
        fmt_pad_with(mut out, fill, gap - gap / 2)
    } else {
        util.buf_append(mut out, body)
        fmt_pad_with(mut out, fill, gap)
    }
}

// ---------------------------------------------------------------- //
// The directive grammar, §6 (stdfmt.c:707-966)                     //
// ---------------------------------------------------------------- //

// stdfmt.c:711-722's Spec; the fill is the first cluster's bytes.
struct FmtSpec {
    fill: List[byte],
    align: int,
    sign: int,
    zero: bool,
    has_width: bool,
    width: int,
    has_prec: bool,
    prec: int,
    ty: int,
}

// stdfmt.c:724-730: the directive quoted to 24 bytes.
fn fmt_bad_directive(mut vm: FlVm, d: List[byte], lo: int, n_in: int, at: int) -> FlValue {
    let n = if n_in > 24 then 24 else n_in
    var msg = List[byte]()
    util.buf_append_str(mut msg, "fmt.f: bad directive \"")
    fmt_put_upto_nul(mut msg, d, lo, lo + n)
    util.buf_append_str(mut msg, "\" at byte {at}")
    fmt_raise_msg(mut vm, "type", msg)
}

fn fmt_is_align(c: int) -> bool { c == 60 || c == 62 || c == 94 }

// s d x X o b f e % ?
fn fmt_is_type(c: int) -> bool {
    c == 115 ||
        c == 100 ||
        c == 120 ||
        c == 88 ||
        c == 111 ||
        c == 98 ||
        c == 102 ||
        c == 101 ||
        c == 37 ||
        c == 63
}

fn fmt_is_digit(b: byte) -> bool { b as int >= 48 && b as int <= 57 }

// stdfmt.c:743-760: (read anything, value capped one past the width cap, end).
fn fmt_read_num(s: List[byte], n: int, start: int) -> (bool, int, int) {
    var i = start
    var v: int = 0
    while i < n && fmt_is_digit(s[i]) {
        v = v * 10 + (s[i] as int - 48)
        if v > FMT_MAX_WIDTH { v = FMT_MAX_WIDTH + 1 }
        i += 1
    }
    (i != start, v, i)
}

// stdfmt.c:762-816: spec = [[fill] align] [sign] ["0"] [width] ["." prec] [type],
// over t[lo..hi); the directive t[dlo..dlo+dn) is what a raise quotes.
fn fmt_parse_spec(
    mut vm: FlVm,
    t: List[byte],
    lo: int,
    hi: int,
    dlo: int,
    dn: int,
    at: int,
) -> FmtSpec ! {raised} {
    var sp = FmtSpec {
        fill: List[byte](),
        align: 0,
        sign: 0,
        zero: false,
        has_width: false,
        width: 0,
        has_prec: false,
        prec: 0,
        ty: 0,
    }
    var i = lo
    if hi > lo {
        // Looking PAST the first cluster tells `{:^^5}` from `{:^5}`.
        let c1 = unicode.gb_next_bytes(t, hi, lo)
        if c1 < hi && fmt_is_align(t[c1] as int) {
            for j in lo..c1 { (mut sp.fill).push(t[j]) }
            sp.align = t[c1] as int
            i = c1 + 1
        } else if fmt_is_align(t[lo] as int) {
            sp.align = t[lo] as int
            i = lo + 1
        }
    }
    if i < hi && (t[i] as int == 43 || t[i] as int == 32) {
        sp.sign = t[i] as int
        i += 1
    }
    if i < hi && t[i] as int == 48 {
        sp.zero = true
        i += 1
    }
    if i < hi && fmt_is_digit(t[i]) {
        let (got, v, next) = fmt_read_num(t, hi, i)
        if !got {
            let _ = fmt_bad_directive(mut vm, t, dlo, dn, at)
            return raised
        }
        i = next
        sp.has_width = true
        sp.width = v
        if v > FMT_MAX_WIDTH {
            let _ = fl_raise(
                mut vm,
                "limit",
                "fmt.f: field width at byte {at} exceeds {FMT_MAX_WIDTH} cells",
            )
            return raised
        }
    }
    if i < hi && t[i] as int == 46 {
        i += 1
        let (got, v, next) = fmt_read_num(t, hi, i)
        if !got {
            let _ = fmt_bad_directive(mut vm, t, dlo, dn, at)
            return raised
        }
        i = next
        sp.has_prec = true
        sp.prec = v
        if v > FMT_MAX_PREC {
            let _ = fmt_bad_directive(mut vm, t, dlo, dn, at)
            return raised
        }
    }
    if i < hi && fmt_is_type(t[i] as int) {
        sp.ty = t[i] as int
        i += 1
    }
    if i != hi {
        let _ = fmt_bad_directive(mut vm, t, dlo, dn, at)
        return raised
    }
    sp
}

// stdfmt.c:818-822: d x X o b f e %.
fn fmt_numeric(t: int) -> bool {
    t == 100 || t == 120 || t == 88 || t == 111 || t == 98 || t == 102 || t == 101 || t == 37
}

// "fmt.f: {:<t>} at byte N " — the directive letter C formats with %c.
fn fmt_directive_msg(t: int, at: int) -> List[byte] {
    var msg = List[byte]()
    util.buf_append_str(mut msg, "fmt.f: {{:")
    (mut msg).push(t as byte)
    util.buf_append_str(mut msg, "}} at byte {at} ")
    msg
}

// stdfmt.c:824-848: `d` takes a float only when it is integral. C's
// `f == (double)(i64)f` within ±2^63 is integrality on [-2^63, 2^63).
fn fmt_want_int(mut vm: FlVm, v: FlValue, t: int, at: int) -> int ! {raised} {
    if v.t == FL_INT { return v.i }
    if t == 100 && v.t == FL_FLOAT {
        let f = v.f
        if f >= -9223372036854775808.0 && f < 9223372036854775808.0 && f as int as f64 == f {
            return f as int
        }
        let _ = fl_raise(mut vm, "type", "fmt.f: {{:d}} at byte {at} needs an integral value")
        return raised
    }
    var msg = fmt_directive_msg(t, at)
    util.buf_append_str(mut msg, "needs an int, found {fl_type_name(v.t)}")
    let _ = fmt_raise_msg(mut vm, "type", msg)
    raised
}

// stdfmt.c:850-966: one value under `sp` into `out`.
fn fmt_one(mut vm: FlVm, mut out: List[byte], v: FlValue, sp: FmtSpec, at: int) -> bool {
    let ty = if sp.ty == 0 then 115 else sp.ty
    // "Numeric" is about the VALUE too: `{:5}` on an int right-aligns.
    let num = fmt_numeric(ty) || sp.ty == 0 && (v.t == FL_INT || v.t == FL_FLOAT)
    var body = List[byte]()
    if ty == 115 {
        if !fmt_render(mut vm, mut body, v, false, false, 0, FMT_MAX_DEPTH) { return false }
    } else if ty == 63 {
        if !fmt_render(mut vm, mut body, v, true, true, 0, FMT_MAX_DEPTH) { return false }
    } else if ty == 100 || ty == 120 || ty == 88 || ty == 111 || ty == 98 {
        let radix = if ty == 100 then 10 else if ty == 111 then 8 else if ty == 98 then 2 else 16
        let iv = fmt_want_int(mut vm, v, ty, at) else { return false }
        fmt_radix(mut body, iv, radix, ty == 88)
    } else {
        var d = 0.0
        if v.t == FL_INT {
            d = v.i as f64
        } else if v.t == FL_FLOAT {
            d = v.f
        } else {
            var msg = fmt_directive_msg(ty, at)
            util.buf_append_str(mut msg, "needs a number, found {fl_type_name(v.t)}")
            let _ = fmt_raise_msg(mut vm, "type", msg)
            return false
        }
        let prec = if sp.has_prec then sp.prec else 6
        if ty == 37 { d *= 100.0 }
        fmt_conv(mut body, d, prec, ty == 101)
        if ty == 37 { (mut body).push(37 as byte) }
    }
    // `+`/` ` apply to numbers only, and only without their own sign.
    let neg = body.len > 0 && body[0] as int == 45
    if sp.sign != 0 && num && !neg {
        var signed = List[byte]()
        (mut signed).reserve(body.len + 1)
        (mut signed).push(sp.sign as byte)
        util.buf_append(mut signed, body)
        body = signed
    }
    var align = sp.align
    if align == 0 { align = if num then 62 else 60 }
    if !sp.has_width {
        util.buf_append(mut out, body)
        return true
    }
    // The zero flag pads AFTER the sign; an explicit align wins over it.
    if sp.zero && sp.align == 0 && num {
        let gap = sp.width - fmt_cells(body)
        let first = if body.len > 0 then body[0] as int else -1
        let skip = if first == 45 || first == 43 || first == 32 then 1 else 0
        if gap > 0 {
            for j in 0..skip { (mut out).push(body[j]) }
            fmt_pad_with(mut out, "0".bytes(), gap)
            for j in skip..body.len { (mut out).push(body[j]) }
        } else {
            util.buf_append(mut out, body)
        }
    } else {
        fmt_align_into(mut out, body, sp.width, align, sp.fill)
    }
    true
}

// ---------------------------------------------------------------- //
// fmt.f (stdfmt.c:968-1095)                                        //
// ---------------------------------------------------------------- //

// "…names \"<name>\"…": the name C quotes with %.*s.
fn fmt_named_msg(head: str, t: List[byte], lo: int, hi: int, tail: str) -> List[byte] {
    var msg = List[byte]()
    util.buf_append_str(mut msg, head)
    fmt_put_upto_nul(mut msg, t, lo, hi)
    util.buf_append_str(mut msg, tail)
    msg
}

// stdfmt.c:969-1026: automatic, explicit or named; argument 0 is argv[1].
fn fmt_resolve(
    mut vm: FlVm,
    base: int,
    argc: int,
    t: List[byte],
    lo: int,
    hi: int,
    mut autoix: int,
    at: int,
) -> FlValue ! {raised} {
    let nmn = hi - lo
    var digits = nmn > 0
    for j in lo..hi {
        if !fmt_is_digit(t[j]) {
            digits = false
            break
        }
    }
    if nmn == 0 || digits {
        var ix = 0
        if nmn == 0 {
            ix = autoix
            autoix += 1
        } else {
            let (got, v, k) = fmt_read_num(t, hi, lo)
            if !got || k != hi {
                let _ = fmt_bad_directive(mut vm, t, lo, nmn, at)
                return raised
            }
            ix = v
        }
        if ix + 1 >= argc {
            let _ = fl_raise(
                mut vm,
                "index",
                "fmt.f: directive at byte {at} wants argument {ix}, {argc - 1} given",
            )
            return raised
        }
        return copy vm.stack[base + ix + 1]
    }
    // A named directive reads argument 0, which must be a map.
    if argc < 2 {
        let msg = fmt_named_msg(
            "fmt.f: directive at byte {at} names \"",
            t,
            lo,
            hi,
            "\" but no map was given",
        )
        let _ = fmt_raise_msg(mut vm, "index", msg)
        return raised
    }
    let m = copy vm.stack[base + 1]
    if m.t != FL_MAP {
        let tail = "\", so argument 1 must be map, found {fl_type_name(m.t)}"
        let msg = fmt_named_msg("fmt.f: directive at byte {at} names \"", t, lo, hi, tail)
        let _ = fmt_raise_msg(mut vm, "type", msg)
        return raised
    }
    let key = fl_str_new(mut vm, t[lo..hi])
    let got = fl_map_get(vm, m, key) else {
        let msg = fmt_named_msg("fmt.f: no key \"", t, lo, hi, "\" in argument 1")
        let _ = fmt_raise_msg(mut vm, "index", msg)
        return raised
    }
    got
}

// stdfmt.c:1028-1095 (totality, :11-18): never reads outside the template,
// never loops without consuming a byte, and ends in a string or a raise.
fn fmt_f(mut vm: FlVm, base: int, argc: int) -> FlValue {
    let tv = fl_arg_str(mut vm, base, 0) else { return fl_nil() }
    let t = copy vm.gc.slots[fl_obj_index(vm, tv)].bytes
    let n = t.len
    var o = List[byte]()
    var i = 0
    var autoix = 0
    while i < n {
        let c = t[i] as int
        let start = i
        if c != 123 && c != 125 {
            (mut o).push(t[i])
            i += 1
            if o.len > FMT_MAX { return fl_raise(mut vm, "limit", "fmt.f: result exceeds 64 MiB") }
            continue
        }
        if i + 1 < n && t[i + 1] as int == c {
            (mut o).push(t[i])
            i += 2
            continue
        }
        if c == 125 { return fmt_bad_directive(mut vm, t, i, 1, i) }
        var close = i + 1
        while close < n && t[close] as int != 125 { close += 1 }
        if close == n { return fmt_bad_directive(mut vm, t, start, n - start, start) }
        var colon = i + 1
        while colon < close && t[colon] as int != 58 { colon += 1 }
        let v = fmt_resolve(mut vm, base, argc, t, i + 1, colon, mut autoix, start) else {
            return fl_nil()
        }
        let lo = if colon < close then colon + 1 else colon
        let sp = fmt_parse_spec(mut vm, t, lo, close, start, close - start + 1, start) else {
            return fl_nil()
        }
        if !fmt_one(mut vm, mut o, v, sp, start) { return fl_nil() }
        if o.len > FMT_MAX { return fl_raise(mut vm, "limit", "fmt.f: result exceeds 64 MiB") }
        i = close + 1
    }
    fl_str_new(mut vm, o)
}

// ---------------------------------------------------------------- //
// The scalar entry points (stdfmt.c:1097-1260)                     //
// ---------------------------------------------------------------- //

// stdfmt.c:116-133's take()/over() at a native's end.
fn fmt_take(mut vm: FlVm, b: List[byte], who: str) -> FlValue {
    if b.len > FMT_MAX { return fl_raise(mut vm, "limit", "{who}: result exceeds 64 MiB") }
    fl_str_new(mut vm, b)
}

// stdfmt.c:1101-1115.
fn fmt_str(mut vm: FlVm, base: int) -> FlValue {
    let v = copy vm.stack[base]
    var b = List[byte]()
    if !fmt_render(mut vm, mut b, v, false, false, 0, FMT_MAX_DEPTH) { return fl_nil() }
    fmt_take(mut vm, b, "fmt.str")
}

// stdfmt.c:1117-1139.
fn fmt_repr(mut vm: FlVm, base: int, argc: int) -> FlValue {
    var indent = 0
    if argc >= 2 {
        indent = fl_arg_int(mut vm, base, 1) else { return fl_nil() }
        if indent < 0 || indent > 16 {
            return fl_raise(mut vm, "type", "fmt.repr: indent must be 0..16, found {indent}")
        }
    }
    let v = copy vm.stack[base]
    var b = List[byte]()
    if !fmt_render(mut vm, mut b, v, true, true, indent, FMT_MAX_DEPTH) { return fl_nil() }
    fmt_take(mut vm, b, "fmt.repr")
}

// stdfmt.c:1141-1175's f_int body after its argument reads; me() names the
// native the user called, so fmt.hex's limits read "fmt.hex: ...".
fn fmt_int_body(mut vm: FlVm, v: int, radix: int, width: int) -> FlValue {
    if radix < 2 || radix > 36 {
        let who = fmt_me(vm)
        return fl_raise(mut vm, "type", "{who}: base must be 2..36, found {radix}")
    }
    if width < 0 || width > FMT_MAX_WIDTH {
        let who = fmt_me(vm)
        return fl_raise(mut vm, "limit", "{who}: width must be 0..{FMT_MAX_WIDTH}, found {width}")
    }
    var b = List[byte]()
    fmt_radix(mut b, v, radix, false)
    if b.len < width {
        var pad = List[byte]()
        let skip = if b[0] as int == 45 then 1 else 0
        for j in 0..skip { (mut pad).push(b[j]) }
        fmt_pad_with(mut pad, "0".bytes(), width - b.len)
        for j in skip..b.len { (mut pad).push(b[j]) }
        b = pad
    }
    fl_str_new(mut vm, b)
}

// stdfmt.c:1141-1175.
fn fmt_int(mut vm: FlVm, base: int, argc: int) -> FlValue {
    let v = fl_arg_int(mut vm, base, 0) else { return fl_nil() }
    var radix = 10
    var width = 0
    if argc >= 2 { radix = fl_arg_int(mut vm, base, 1) else { return fl_nil() } }
    if argc >= 3 { width = fl_arg_int(mut vm, base, 2) else { return fl_nil() } }
    fmt_int_body(mut vm, v, radix, width)
}

// stdfmt.c:1177-1190: routed through fmt.int's body; the width is read
// BEFORE the value, as C's f_hex reads it before f_int reads argument 1.
fn fmt_hex(mut vm: FlVm, base: int, argc: int) -> FlValue {
    var width = 0
    if argc >= 2 { width = fl_arg_int(mut vm, base, 1) else { return fl_nil() } }
    let v = fl_arg_int(mut vm, base, 0) else { return fl_nil() }
    fmt_int_body(mut vm, v, 16, width)
}

// stdfmt.c:1192-1215.
fn fmt_float(mut vm: FlVm, base: int, argc: int) -> FlValue {
    let d = fl_arg_num(mut vm, base, 0) else { return fl_nil() }
    var prec = 0
    if argc >= 2 {
        prec = fl_arg_int(mut vm, base, 1) else { return fl_nil() }
        if prec < 0 || prec > FMT_MAX_PREC {
            return fl_raise(
                mut vm,
                "type",
                "fmt.float: prec must be 0..{FMT_MAX_PREC}, found {prec}",
            )
        }
    }
    var b = List[byte]()
    if argc >= 2 {
        fmt_conv(mut b, d, prec, false)
    } else {
        util.buf_append_str(mut b, float_shortest(d))
    }
    fl_str_new(mut vm, b)
}

// stdfmt.c:1217-1260.
fn fmt_pad(mut vm: FlVm, base: int, argc: int) -> FlValue {
    let s = fl_arg_str(mut vm, base, 0) else { return fl_nil() }
    let width = fl_arg_int(mut vm, base, 1) else { return fl_nil() }
    var al = fl_nil()
    var fill = fl_nil()
    if argc >= 3 { al = fl_arg_str(mut vm, base, 2) else { return fl_nil() } }
    if argc >= 4 { fill = fl_arg_str(mut vm, base, 3) else { return fl_nil() } }
    if width < 0 || width > FMT_MAX_WIDTH {
        return fl_raise(mut vm, "limit", "fmt.pad: width must be 0..{FMT_MAX_WIDTH}, found {width}")
    }
    var align = 60
    if argc >= 3 {
        let a = fl_obj_index(vm, al)
        if vm.gc.slots[a].bytes.len != 1 || !fmt_is_align(vm.gc.slots[a].bytes[0] as int) {
            return fl_raise(mut vm, "type", "fmt.pad: align must be \"<\", \">\" or \"^\"")
        }
        align = vm.gc.slots[a].bytes[0] as int
    }
    var fb = List[byte]()
    if argc >= 4 {
        let f = fl_obj_index(vm, fill)
        let n = vm.gc.slots[f].bytes.len
        // A fill of more than one cluster has no single width to tile with.
        if n > 0 && unicode.gb_next_bytes(vm.gc.slots[f].bytes, n, 0) != n {
            return fl_raise(mut vm, "type", "fmt.pad: fill must be one grapheme cluster")
        }
        fb = copy vm.gc.slots[f].bytes
    }
    var o = List[byte]()
    let at = fl_obj_index(vm, s)
    fmt_align_into(mut o, vm.gc.slots[at].bytes, width, align, fb)
    fmt_take(mut vm, o, "fmt.pad")
}

/// Dispatch a LOCAL fmt-table index; global native ids are 5000 + local.
/// CALL has already checked arity and set cur_native.
pub fn fl_std_fmt_dispatch(mut vm: FlVm, local: int, base: int, argc: int) -> FlValue {
    match local {
        0 => fmt_f(mut vm, base, argc),
        1 => fmt_str(mut vm, base),
        2 => fmt_repr(mut vm, base, argc),
        3 => fmt_int(mut vm, base, argc),
        4 => fmt_float(mut vm, base, argc),
        5 => fmt_hex(mut vm, base, argc),
        6 => fmt_pad(mut vm, base, argc),
        _ => {
            assert(false)
            fl_nil()
        },
    }
}

/// Pinned FMT_DEFS order, arities and signatures (stdfmt.c:1264-1272).
pub fn fl_fmt_defs() -> List[FlNativeDef] {
    [
        fl_native_def("f", 5000, 1, 255, 0, "(template, ...) -> str"),
        fl_native_def("str", 5001, 1, 1, 0, "(v) -> str"),
        fl_native_def("repr", 5002, 1, 2, 0, "(v, [indent]) -> str"),
        fl_native_def("int", 5003, 1, 3, 0, "(i, [base], [width]) -> str"),
        fl_native_def("float", 5004, 1, 2, 0, "(f, [prec]) -> str"),
        fl_native_def("hex", 5005, 1, 2, 0, "(i, [width]) -> str"),
        fl_native_def("pad", 5006, 2, 4, 0, "(s, width, [align], [fill]) -> str"),
    ]
}
