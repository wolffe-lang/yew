//! fl.vm — sagitta 9ace98c2 src/fl/vm.h:19-362, vm.c:119-240.
//! Scalar frame coordinates; rooted heap references are refreshed after GC.

/// Rooted closure and scalar call coordinates; call_pc belongs to caller.
pub struct FlFrame {
    cl: FlValue,
    ip: int,
    base: int,
    call_pc: int,
    via_native: int,
    edit_depth: int,
}

/// Catch target and stack/frame/edit depths captured by TRY_PUSH.
pub struct FlHandler { pc: int, sp: int, frame: int, edit_depth: int }

/// Single-owner interpreter state and all collector roots.
pub struct FlVm {
    gc: FlGc,
    strings: FlStrings,
    dc: DiagCtx,
    stack: List[FlValue],
    sp: int,
    frames: List[FlFrame],
    handlers: List[FlHandler],
    open_upvals: List[FlValue],
    globals: FlValue,
    modules: FlValue,
    builtins: FlValue,
    prelude: FlValue,
    host_roots: List[FlValue],
    temp: List[FlValue],
    compiling: List[FlValue],
    raised: bool,
    err: FlValue,
    err_caret: str,
    root_origin: FlOrigin,
    cur_native: int,
    host_kind: int,
    edit_depth: int,
    steps: int,
    step_limit: int,
    tracing: bool,
    trace: List[byte],
}

/// Create a headless VM, consuming its identifier interner.
pub fn fl_vm_new(take strings: FlStrings) -> FlVm {
    var vm = FlVm {
        gc: fl_gc_init(),
        strings: strings,
        dc: fl_diag_init(),
        stack: List[FlValue](),
        sp: 0,
        frames: List[FlFrame](),
        handlers: List[FlHandler](),
        open_upvals: List[FlValue](),
        globals: fl_nil(),
        modules: fl_nil(),
        builtins: fl_nil(),
        prelude: fl_nil(),
        host_roots: List[FlValue](),
        temp: List[FlValue](),
        compiling: List[FlValue](),
        raised: false,
        err: fl_nil(),
        err_caret: "",
        root_origin: fl_origin_new(0, 0),
        cur_native: 0,
        host_kind: 0,
        edit_depth: 0,
        steps: 0,
        step_limit: 0,
        tracing: false,
        trace: List[byte](),
    }
    vm.gc.stress = (env_get("YEW_FL_GC_STRESS") else "__unset") != "__unset" ||
        (env_get("FL_GC_STRESS") else "__unset") != "__unset"
    (mut vm.stack).reserve(16384)
    for _ in 0..16384 { (mut vm.stack).push(fl_nil()) }
    (mut vm.frames).reserve(256)
    (mut vm.handlers).reserve(64)
    (mut vm.temp).reserve(32)
    vm.globals = fl_map_new(mut vm)
    vm.modules = fl_map_new(mut vm)
    vm.builtins = fl_map_new(mut vm)
    vm.prelude = fl_map_new(mut vm)
    vm
}

/// Build kind/msg error map, set raised, and return nil.
pub fn fl_raise(mut vm: FlVm, kind: str, msg: str) -> FlValue {
    let m = fl_map_new(mut vm)
    let k = fl_str_text(mut vm, "kind")
    let v = fl_str_text(mut vm, kind)
    assert(fl_map_set(mut vm, m, k, v))
    let mk = fl_str_text(mut vm, "msg")
    let mv = fl_str_text(mut vm, msg)
    assert(fl_map_set(mut vm, m, mk, mv))
    vm.err = m
    vm.raised = true
    fl_nil()
}

/// Set the instruction budget and restart the step counter.
pub fn fl_vm_set_step_limit(mut vm: FlVm, steps: int) { vm.step_limit = steps; vm.steps = 0 }
