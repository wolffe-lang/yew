//! fl.diag — source spans and structural diagnostic capture.
//! Ports sagitta 9ace98c2 src/fl/diag.h:34-121, diag.c:12-207.
//! The context owns source/path bytes; diagnostics never write a terminal.
//! Consumers choose their sink by reading entries (no mutable callback ABI).

use std.fs as fs
use util

/// Half-open source span: one-based line and byte column.
pub struct FlSpan { file_id: int, line: int, col: int, len: int }

/// A registered source. Unlike C's borrow this is context-owned.
pub struct FlDiagFile { path: str, src: List[byte] }

/// Structural message; rendered carets can be requested independently.
pub struct FlDiagnostic { level: int, sp: FlSpan, msg: str }

/// Per-compilation sink and counters; muting is reset by each parse.
pub struct DiagCtx {
    files: List[FlDiagFile],
    entries: List[FlDiagnostic],
    nerrors: int,
    nwarnings: int,
    muted: bool,
    // `yew fl`'s sink (flcli.c:240-254): each diagnostic is also written
    // to stderr, rendered, the moment it is emitted. A value, never a
    // callback; every other consumer reads `entries`.
    echo: bool,
}

/// Error level, as C.
pub const FL_DIAG_ERROR: int = 0

/// Warning level, as C.
pub const FL_DIAG_WARNING: int = 1

/// Note level, as C.
pub const FL_DIAG_NOTE: int = 2

/// Empty diagnostic context.
pub fn fl_diag_init() -> DiagCtx {
    DiagCtx {
        files: List[FlDiagFile](),
        entries: List[FlDiagnostic](),
        nerrors: 0,
        nwarnings: 0,
        muted: false,
        echo: false,
    }
}

/// Register owned path and source, returning a stable file id.
pub fn fl_diag_add_file(mut dc: DiagCtx, path: str, src: List[byte]) -> int {
    let id = dc.files.len
    // G52, compiler lent-bytes witness: copy of an inline bytes() view into a
    // struct field is refused natively; materialize only at this ownership
    // boundary, never at each lexical read (front/lent-bytes/main.lu).
    var owned = List[byte]()
    (mut owned).reserve(src.len)
    for b in src { (mut owned).push(b) }
    (mut dc.files).push(FlDiagFile { path: copy path, src: owned })
    id
}

/// Capture one diagnostic, respecting the parser's mute flag.
pub fn fl_diag_emit(mut dc: DiagCtx, level: int, sp: FlSpan, msg0: str) {
    if dc.muted { return }
    // diag.c:165-176 formats into `char msg[512]`: a message is cut at
    // 511 bytes (on a UTF-8 boundary here, since a message is text).
    var cut = if msg0.len > 511 then 511 else msg0.len
    while cut > 0 && cut < msg0.len && msg0.bytes()[cut] as int & 192 == 128 { cut -= 1 }
    let msg = if cut == msg0.len then copy msg0 else copy msg0[0..cut]
    if level == FL_DIAG_ERROR { dc.nerrors += 1 }
    if level == FL_DIAG_WARNING { dc.nwarnings += 1 }
    if dc.echo {
        var out = List[byte]()
        fl_diag_render(mut out, dc, level, sp, msg)
        var err = fs.stderr()
        fs.write_chunk(mut err, out) else |_| {}
    }
    (mut dc.entries).push(FlDiagnostic { level: level, sp: sp, msg: msg })
}

/// Error count, including the final cap message.
pub fn fl_diag_errors(dc: DiagCtx) -> int { dc.nerrors }

fn diag_level_word(level: int) -> str {
    if level == FL_DIAG_WARNING { return "warning" }
    if level == FL_DIAG_NOTE { return "note" }
    "error"
}

/// Exact C caret block: tabs preserved, CRLF's CR omitted, EOF has a caret.
pub fn fl_diag_render(mut out: List[byte], dc: DiagCtx, level: int, sp: FlSpan, msg: str) {
    let word = diag_level_word(level)
    if sp.file_id < 0 || sp.file_id >= dc.files.len {
        util.buf_append_str(mut out, "{word}: {msg}\n")
        return
    }
    let path = dc.files[sp.file_id].path
    util.buf_append_str(mut out, "{path}:{sp.line}:{sp.col}: {word}: {msg}\n")
    let bytes = dc.files[sp.file_id].src
    var at = 0
    var line = 1
    while line < sp.line && at < bytes.len {
        if bytes[at] == 10 as byte { line += 1 }
        at += 1
    }
    if line != sp.line { return }
    var end = at
    while end < bytes.len && bytes[end] != 10 as byte { end += 1 }
    if end > at && bytes[end - 1] == 13 as byte { end -= 1 }
    var i = at
    while i < end { (mut out).push(bytes[i]); i += 1 }
    (mut out).push(10 as byte)
    i = 0
    while i + 1 < sp.col && at + i < end {
        (mut out).push(if bytes[at + i] == 9 as byte then 9 as byte else 32 as byte)
        i += 1
    }
    (mut out).push(94 as byte)
    i = 1
    while i < sp.len { (mut out).push(126 as byte); i += 1 }
    (mut out).push(10 as byte)
}
