//! fl.suggest — sagitta 9ace98c2 src/fl/suggest.c:12-200 and suggest.h.
//! Only caller-supplied names: no interner/global registry access. OSA costs
//! are scaled by two; ties are distance, scope band, then raw bytes.

use util

/// Local scope has the highest tie-break priority.
pub const FL_SCOPE_LOCAL: int = 0

/// Enclosing-function scope priority.
pub const FL_SCOPE_UPVAL: int = 1

/// Module-global scope priority.
pub const FL_SCOPE_GLOBAL: int = 2

/// Builtin module scope priority.
pub const FL_SCOPE_BUILTIN: int = 3

/// One owned byte name with its caller-supplied scope and computed distance.
pub struct FlCand { name: List[byte], band: int, dist: int }

/// Bounded candidate list, prefix-filtered only after overflow was attempted.
pub struct FlSuggest { items: List[FlCand], n: int, full: bool }

/// Empty candidate set. Its names are owned, never borrowed across calls.
pub fn fl_suggest_new() -> FlSuggest {
    FlSuggest { items: List[FlCand](), n: 0, full: false }
}

/// Reset the candidate set; retain its vector storage.
pub fn fl_suggest_reset(mut s: FlSuggest) {
    (mut s.items).reset()
    s.n = 0
    s.full = false
}

/// Add a nonempty candidate up to512; an attempted513th sets full.
pub fn fl_suggest_add(mut s: FlSuggest, name: List[byte], band: int) {
    if name.len == 0 { return }
    if s.n >= 512 { s.full = true; return }
    var owned = List[byte]()
    for b in name { (mut owned).push(b) }
    (mut s.items).push(FlCand { name: owned, band: band, dist: 0 })
    s.n += 1
}

fn suggest_lower(b: byte) -> int {
    let n = b as int
    if n >= 65 && n <= 90 then n + 32 else n
}

fn suggest_osa(a: List[byte], b: List[byte], cutoff: int) -> int {
    region rows {
        var prev2 = List[int]()
        var prev = List[int]()
        var cur = List[int]()
        for j in 0..=b.len {
            (mut prev2).push(0)
            (mut prev).push(j * 2)
            (mut cur).push(0)
        }
        for i in 1..=a.len {
            cur[0] = i * 2
            var rowmin = cur[0]
            for j in 1..=b.len {
                let ca = a[i - 1]
                let cb = b[j - 1]
                let sub = if ca == cb {
                    0
                } else if suggest_lower(ca) == suggest_lower(cb) {
                    1
                } else {
                    2
                }
                var best = prev[j - 1] + sub
                if prev[j] + 2 < best { best = prev[j] + 2 }
                if cur[j - 1] + 2 < best { best = cur[j - 1] + 2 }
                if i > 1 &&
                    j > 1 &&
                    suggest_lower(ca) == suggest_lower(b[j - 2]) &&
                    suggest_lower(a[i - 2]) == suggest_lower(cb) &&
                    prev2[j - 2] + 2 < best {
                    best = prev2[j - 2] + 2
                }
                cur[j] = best
                if best < rowmin { rowmin = best }
            }
            if rowmin > cutoff { return 4294967295 }
            for j in 0..=b.len { prev2[j] = prev[j]; prev[j] = cur[j] }
        }
        if a.len == 0 then b.len * 2 else prev[b.len]
    }
}

/// Scaled OSA distance; U32_MAX for either input longer than64 bytes.
pub fn fl_suggest_distance(a: List[byte], b: List[byte]) -> int {
    if a.len > 64 || b.len > 64 { return 4294967295 }
    suggest_osa(a, b, 4294967295)
}

fn suggest_same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

fn suggest_compare(a: FlCand, b: FlCand) -> int {
    if a.dist != b.dist { return if a.dist < b.dist then -1 else 1 }
    if a.band != b.band { return if a.band < b.band then -1 else 1 }
    let n = if a.name.len < b.name.len then a.name.len else b.name.len
    for i in 0..n {
        if a.name[i] != b.name[i] { return if a.name[i] < b.name[i] then -1 else 1 }
    }
    if a.name.len < b.name.len then -1 else if a.name.len > b.name.len then 1 else 0
}

fn suggest_less(a: FlCand, b: FlCand) -> bool { suggest_compare(a, b) < 0 }

fn suggest_put(mut out: List[byte], text: str) {
    for b in text.bytes() { (mut out).push(b) }
}

/// Append C's exact suggestion phrase, or nothing; answer how many names.
pub fn fl_suggest_render(mut s: FlSuggest, typo: List[byte], mut out: List[byte]) -> int {
    if typo.len == 0 || typo.len > 64 { return 0 }
    if s.full {
        var w = 0
        for i in 0..s.n {
            if suggest_lower(s.items[i].name[0]) == suggest_lower(typo[0]) {
                s.items[w] = copy s.items[i]
                w += 1
            }
        }
        s.n = w
        if w >= 512 { return 0 }
    }
    var kept = List[FlCand]()
    for i in 0..s.n {
        let len = s.items[i].name.len
        let lim = if len <= 2 then 0 else if len == 3 then 2 else 4
        if lim == 0 || len > 64 || suggest_same(s.items[i].name, typo) { continue }
        let d = suggest_osa(typo, s.items[i].name, lim)
        if d > lim { continue }
        s.items[i].dist = d
        (mut kept).push(copy s.items[i])
    }
    if kept.len == 0 { return 0 }
    util.sort_stable(mut kept, suggest_less)
    let shown = if kept.len < 3 then kept.len else 3
    suggest_put(mut out, "did you mean '")
    for b in kept[0].name { (mut out).push(b) }
    suggest_put(mut out, "'?")
    if shown > 1 {
        suggest_put(mut out, " (or ")
        for i in 1..shown {
            if i > 1 { suggest_put(mut out, ", ") }
            suggest_put(mut out, "'")
            for b in kept[i].name { (mut out).push(b) }
            suggest_put(mut out, "'")
        }
        suggest_put(mut out, ")")
    }
    // Keep C's post-render prefix arrangement, without changing s.n.
    for i in 0..kept.len { s.items[i] = copy kept[i] }
    shown
}
