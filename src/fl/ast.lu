/// Each row's scalar payload (a,b,c,d,e,i,f,flags):
/// LET name/init; ASSIGN target/value; FN and FN_EXPR name/params/count/body;
/// MACRO name/body; IMPORT path/name, flags=is_string; IF cond/then/else;
/// WHILE cond/body; FOR var/var2/iter/body; RETURN value; EDIT body;
/// TRY body/handler/var; EXPR_STMT expr; BLOCK/LIST/MOTION_BLOCK edges/count;
/// MAP keys/vals/count; BINOP op/left/right; UNOP op/operand;
/// CALL callee/args/count; INDEX obj/index; FIELD obj/name; IDENT name;
/// LIT a=FL_L_* i=int/bool/string-id f=float;
/// MOTION kind/ch/payload/inner/ninner, i=count, flags=alt|count_given<<1.
pub struct FlNode {
    kind: int,
    sp: FlSpan,
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    i: int,
    f: f64,
    flags: int,
}

/// Program root is -1; literal entry sets root only, leaving stmts empty.
/// FlStrings ids address a separately owned table, stable across parses.
pub struct FlProgram {
    nodes: List[FlNode],
    edges: List[int],
    stmts: List[int],
    root: int,
    incomplete: bool,
    had_error: bool,
}

/// An empty tree, not a parsed nil.
pub fn fl_program() -> FlProgram {
    FlProgram {
        nodes: List[FlNode](),
        edges: List[int](),
        stmts: List[int](),
        root: -1,
        incomplete: false,
        had_error: false,
    }
}

/// Zero scalar payload; callers explicitly set optional child slots to -1.
pub fn fl_node(kind: int, sp: FlSpan) -> FlNode {
    FlNode { kind: kind, sp: sp, a: 0, b: 0, c: 0, d: 0, e: 0, i: 0, f: 0.0, flags: 0 }
}

/// Byte-string interner; id 0 is invalid, even for the empty string.
/// Unlike util.Interner this preserves arbitrary bytes, including \xFF.
/// util/intern.c's strmap is an open-addressing table keyed by the bytes;
/// here `idx` is that table (0 empty, else an id), linear-probed, grown in
/// place past 70% load, with each id's FNV-1a hash kept in `hashes` so a
/// probe compares bytes only on an equal hash. Ids are first-seen order.
pub struct FlStrings {
    items: List[List[byte]],
    hashes: List[int],
    idx: List[int],
}

/// New interner with a reserved invalid slot.
pub fn fl_strings() -> FlStrings {
    var out = FlStrings { items: List[List[byte]](), hashes: List[int](), idx: List[int]() }
    (mut out.items).push(List[byte]())
    (mut out.hashes).push(0)
    out
}

fn fl_strings_slot(strings: FlStrings, id: int) -> int {
    let mask = strings.idx.len - 1
    var j = strings.hashes[id] & mask
    while strings.idx[j] != 0 { j = j + 1 & mask }
    j
}

/// Intern bytes in first-seen order, without Unicode conversion.
pub fn fl_intern(mut strings: FlStrings, bytes: List[byte], at: int, end: int) -> int {
    var h: wrapping[u32] = 2166136261
    var j = at
    while j < end {
        h = (h ^ bytes[j] as int as wrapping[u32]) * 16777619
        j += 1
    }
    let hash = h as int
    let n = end - at
    if strings.idx.len != 0 {
        let mask = strings.idx.len - 1
        var slot = hash & mask
        loop {
            let id = strings.idx[slot]
            if id == 0 { break }
            if strings.hashes[id] == hash && strings.items[id].len == n {
                var same = true
                var k = 0
                while same && k < n {
                    same = strings.items[id][k] == bytes[at + k]
                    k += 1
                }
                if same { return id }
            }
            slot = slot + 1 & mask
        }
    }
    let id = strings.items.len
    (mut strings.items).push(copy bytes[at..end])
    (mut strings.hashes).push(hash)
    if (id + 1) * 10 > strings.idx.len * 7 {
        // Grow in place and reinsert every id: the table's own storage is
        // reused rather than replaced (G33).
        let cap = if strings.idx.len == 0 then 64 else strings.idx.len * 2
        while strings.idx.len < cap { (mut strings.idx).push(0) }
        for k in 0..cap { strings.idx[k] = 0 }
        for k in 1..strings.items.len {
            let at_slot = fl_strings_slot(strings, k)
            strings.idx[at_slot] = k
        }
    } else {
        let at_slot = fl_strings_slot(strings, id)
        strings.idx[at_slot] = id
    }
    id
}

/// Owned copy; lend strings.items[id] directly on read-only hot paths.
pub fn fl_string(strings: FlStrings, id: int) -> List[byte] {
    if id <= 0 || id >= strings.items.len { return List[byte]() }
    copy strings.items[id]
}
