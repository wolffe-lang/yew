//! fl.ast — indexed, caller-region-owned syntax trees.
//! Ports sagitta 9ace98c2 src/fl/ast.h:23-128. No VM values live here.
//! Scalar FlNode payload is 104 B (13 eight-byte words), versus C's 48 B union.
//! Child/parameter ranges are frozen once into edges; -1 is no child.
//! Field schema is documented below, and tags retain the C enum order.

/// Pinned C FL_A_LET discriminant.
pub const FL_A_LET: int = 0

