//! fl.stdmath — sagitta9ace98c2 src/fl/stdmath.c:26-417.
//! Public std.math.float operations; errors and integer shape follow the pin.
//! The sole additional module state is C's process-global xorshift64* seed.

use std.math.float as mf

var fl_math_rng_state: wrapping[u64] = 0x2545F4914F6CDD1D

fn math_unsigned(n: int) -> wrapping[u64] {
    if n >= 0 { return n as wrapping[u64] }
    let zero: wrapping[u64] = 0
    zero - (-(n + 1) as wrapping[u64] + 1)
}

fn math_signed(n: wrapping[u64]) -> int {
    let high: wrapping[u64] = 9223372036854775807
    if n <= high { return n as int }
    let all: wrapping[u64] = 18446744073709551615
    -((all - n) as int) - 1
}

fn math_rng(seed: int, reseed: bool) -> wrapping[u64] {
    // # Safety: invariant8, single-threaded core. Exactly C's process-global
    // PRNG, never clock-seeded and never shared with a worker/thread.
    unsafe {
        if reseed {
            fl_math_rng_state = if seed == 0 then 0x9E3779B97F4A7C15 else math_unsigned(seed)
            return 0
        }
        var x = fl_math_rng_state
        let a: wrapping[u64] = 12
        let b: wrapping[u64] = 25
        let c: wrapping[u64] = 27
        x = x ^ x >> a
        x = x ^ x << b
        x = x ^ x >> c
        fl_math_rng_state = x
        x * 0x2545F4914F6CDD1D
    }
}

fn math_minmax(mut vm: FlVm, base: int, argc: int, want_max: bool) -> FlValue {
    var all_int = true
    var best = 0.0
    var besti: int = 0
    for i in 0..argc {
        let v = copy vm.stack[base + i]
        if v.t != 2 { all_int = false }
        let x = fl_arg_num(mut vm, base, i) else { return fl_nil() }
        if i == 0 || (if want_max then x > best else x < best) {
            best = x
            // C's float->integer intermediate is never used unless all_int;
            // avoid an undefined conversion for NaN/Inf without changing output.
            if v.t == 2 { besti = v.i }
        }
    }
    if all_int then fl_int(besti) else fl_float(best)
}

fn math_random(mut vm: FlVm, base: int, argc: int) -> FlValue {
    if argc == 0 {
        let shift: wrapping[u64] = 11
        let bits = math_rng(0, false) >> shift
        return fl_float(bits as int as f64 * (1.0 / 9007199254740992.0))
    }
    if argc != 2 {
        return fl_raise(mut vm, "arity", "math.random expects 0 or 2 arguments, got {argc}")
    }
    let lo = fl_arg_int(mut vm, base, 0) else { return fl_nil() }
    let hi = fl_arg_int(mut vm, base, 1) else { return fl_nil() }
    if lo > hi { return fl_raise(mut vm, "type", "math.random: lo must not exceed hi") }
    let span = math_unsigned(hi) - math_unsigned(lo) + 1
    let random = math_rng(0, false)
    fl_int(
        if span == 0 then math_signed(random) else math_signed(math_unsigned(lo) + random % span),
    )
}

/// Dispatch local math table id; CALL already validated ordinary arity.
pub fn fl_std_math_dispatch(mut vm: FlVm, kind: int, base: int, argc: int) -> FlValue {
    if kind == 28 { return math_random(mut vm, base, argc) }
    if kind == 27 {
        let seed = fl_arg_int(mut vm, base, 0) else { return fl_nil() }
        let _ = math_rng(seed, true)
        return fl_nil()
    }
    if kind == 1 || kind == 2 { return math_minmax(mut vm, base, argc, kind == 2) }
    if kind == 0 && vm.stack[base].t == 2 {
        let n = vm.stack[base].i
        return fl_int(if n == -9223372036854775807 - 1 then n else if n < 0 then -n else n)
    }
    if kind >= 5 && kind <= 9 && vm.stack[base].t == 2 { return copy vm.stack[base] }
    let x = fl_arg_num(mut vm, base, 0) else { return fl_nil() }
    match kind {
        0 => fl_float(mf.abs(x)),
        3 => {
            let lo = fl_arg_num(mut vm, base, 1) else { return fl_nil() }
            let hi = fl_arg_num(mut vm, base, 2) else { return fl_nil() }
            if lo > hi { return fl_raise(mut vm, "type", "math.clamp: lo must not exceed hi") }
            copy vm.stack[base + (if x < lo then 1 else if x > hi then 2 else 0)]
        },
        4 => fl_int(if x != x then 0 else if x > 0.0 then 1 else if x < 0.0 then -1 else 0),
        5 => fl_float(mf.floor(x)),
        6 => fl_float(mf.ceil(x)),
        7 => fl_float(mf.round(x)),
        8 => fl_float(mf.trunc(x)),
        9 => {
            if x != x || x >= 9223372036854775808.0 || x < -9223372036854775808.0 {
                let rendered = float_general(x, 6)
                return fl_raise(mut vm, "type", "math.int: {rendered} has no integer value")
            }
            fl_int(x as int)
        },
        10 => fl_float(x),
        11 => fl_float(mf.sqrt(x)),
        12 => fl_float(mf.exp(x)),
        13 => fl_float(mf.ln(x)),
        14 => fl_float(mf.log2(x)),
        15 => fl_float(mf.log10(x)),
        16 => {
            let y = fl_arg_num(mut vm, base, 1) else { return fl_nil() }
            fl_float(mf.powf(x, y))
        },
        17 => fl_float(mf.sin(x)),
        18 => fl_float(mf.cos(x)),
        19 => fl_float(mf.tan(x)),
        20 => fl_float(mf.asin(x)),
        21 => fl_float(mf.acos(x)),
        22 => fl_float(mf.atan(x)),
        23 => {
            let y = fl_arg_num(mut vm, base, 1) else { return fl_nil() }
            fl_float(mf.atan2(x, y))
        },
        24 => {
            let y = fl_arg_num(mut vm, base, 1) else { return fl_nil() }
            fl_float(mf.hypot(x, y))
        },
        25 => fl_bool(mf.is_nan(x)),
        26 => fl_bool(mf.is_inf(x)),
        _ => { assert(false); fl_nil() },
    }
}

/// Register C's six constant fields after math's natives, before freezing.
pub fn fl_math_constants(mut vm: FlVm, module: FlValue) {
    let names = ["pi", "e", "inf", "nan", "int_max", "int_min"]
    for i in 0..6 {
        let key = fl_str_text(mut vm, names[i])
        let value = match i {
            0 => fl_float(3.14159265358979323846),
            1 => fl_float(2.71828182845904523536),
            2 => fl_float(mf.inf()),
            3 => fl_float(mf.nan()),
            4 => fl_int(9223372036854775807),
            _ => fl_int(-9223372036854775807 - 1),
        }
        assert(fl_map_set(mut vm, module, key, value))
    }
}

/// Pinned MATH_DEFS registration order and signatures (stdmath.c:359-389).
pub fn fl_math_defs() -> List[FlNativeDef] {
    var defs = List[FlNativeDef]()
    (mut defs).push(fl_native_def("abs", 4000, 1, 1, 0, "(n) -> n"))
    (mut defs).push(fl_native_def("min", 4001, 1, 255, 0, "(a, b, ...) -> n"))
    (mut defs).push(fl_native_def("max", 4002, 1, 255, 0, "(a, b, ...) -> n"))
    (mut defs).push(fl_native_def("clamp", 4003, 3, 3, 0, "(x, lo, hi) -> n"))
    (mut defs).push(fl_native_def("sign", 4004, 1, 1, 0, "(n) -> int"))
    (mut defs).push(fl_native_def("floor", 4005, 1, 1, 0, "(n) -> n"))
    (mut defs).push(fl_native_def("ceil", 4006, 1, 1, 0, "(n) -> n"))
    (mut defs).push(fl_native_def("round", 4007, 1, 1, 0, "(n) -> n"))
    (mut defs).push(fl_native_def("trunc", 4008, 1, 1, 0, "(n) -> n"))
    (mut defs).push(fl_native_def("int", 4009, 1, 1, 0, "(n) -> int"))
    (mut defs).push(fl_native_def("float", 4010, 1, 1, 0, "(n) -> float"))
    (mut defs).push(fl_native_def("sqrt", 4011, 1, 1, 0, "(n) -> float"))
    (mut defs).push(fl_native_def("exp", 4012, 1, 1, 0, "(n) -> float"))
    (mut defs).push(fl_native_def("log", 4013, 1, 1, 0, "(n) -> float"))
    (mut defs).push(fl_native_def("log2", 4014, 1, 1, 0, "(n) -> float"))
    (mut defs).push(fl_native_def("log10", 4015, 1, 1, 0, "(n) -> float"))
    (mut defs).push(fl_native_def("pow", 4016, 2, 2, 0, "(a, b) -> float"))
    (mut defs).push(fl_native_def("sin", 4017, 1, 1, 0, "(n) -> float"))
    (mut defs).push(fl_native_def("cos", 4018, 1, 1, 0, "(n) -> float"))
    (mut defs).push(fl_native_def("tan", 4019, 1, 1, 0, "(n) -> float"))
    (mut defs).push(fl_native_def("asin", 4020, 1, 1, 0, "(n) -> float"))
    (mut defs).push(fl_native_def("acos", 4021, 1, 1, 0, "(n) -> float"))
    (mut defs).push(fl_native_def("atan", 4022, 1, 1, 0, "(n) -> float"))
    (mut defs).push(fl_native_def("atan2", 4023, 2, 2, 0, "(y, x) -> float"))
    (mut defs).push(fl_native_def("hypot", 4024, 2, 2, 0, "(x, y) -> float"))
    (mut defs).push(fl_native_def("is_nan", 4025, 1, 1, 0, "(n) -> bool"))
    (mut defs).push(fl_native_def("is_inf", 4026, 1, 1, 0, "(n) -> bool"))
    (mut defs).push(fl_native_def("seed", 4027, 1, 1, 0, "(n) -> nil"))
    (mut defs).push(fl_native_def("random", 4028, 0, 2, 0, "([lo, hi]) -> float|int"))
    defs
}
