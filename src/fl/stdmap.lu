//! fl.stdmap — insertion-ordered map natives.
//! Ports sagitta 9ace98c2 src/fl/stdmap.c:21-274.
//! Arguments are VM-stack roots. No native here reenters the VM; allocation
//! only marks GC pending, and collection remains at instruction boundaries.

fn stdmap_key(mut vm: FlVm, key: FlValue) -> bool {
    if fl_hashable(key) { return true }
    let word = fl_type_name(key.t)
    let _ = fl_raise(mut vm, "key", "map key must be string, int, or bool, found {word}")
    false
}

fn stdmap_writable(mut vm: FlVm, map: FlValue, what: str) -> bool {
    if !fl_frozen(vm, map) { return true }
    let _ = fl_raise(mut vm, "type", "{what}: the map is frozen")
    false
}

fn stdmap_collect(mut vm: FlVm, map: FlValue, want: int) -> FlValue {
    let list = fl_list_new(mut vm)
    let root = fl_temp_push(mut vm, list)
    var cursor = 0
    loop {
        let (next, key, value) = fl_map_iter(vm, map, cursor) else break
        cursor = next
        if want != 2 {
            fl_list_push(mut vm, list, if want == 0 then key else value)
        } else {
            let pair = fl_list_new(mut vm)
            let _ = fl_temp_push(mut vm, pair)
            fl_list_push(mut vm, pair, key)
            fl_list_push(mut vm, pair, value)
            fl_list_push(mut vm, list, pair)
            fl_temp_pop(mut vm, 1)
        }
    }
    let result = fl_temp_get(vm, root)
    fl_temp_pop(mut vm, 1)
    result
}

fn stdmap_copy_into(mut vm: FlVm, destination: FlValue, source: FlValue) {
    var cursor = 0
    loop {
        let (next, key, value) = fl_map_iter(vm, source, cursor) else break
        cursor = next
        assert(fl_map_set(mut vm, destination, key, value))
    }
}

/// Dispatch a LOCAL map-table index; global native ids are 3000 + kind.
pub fn fl_std_map_dispatch(mut vm: FlVm, kind: int, base: int, argc: int) -> FlValue {
    assert(kind >= 0 && kind < 12)
    let map = fl_arg_map(mut vm, base, 0) else { return fl_nil() }
    if kind == 0 { return fl_int(fl_map_count(vm, map)) }
    if kind >= 1 && kind <= 4 {
        let key = copy vm.stack[base + 1]
        if !stdmap_key(mut vm, key) { return fl_nil() }
        if kind == 2 || kind == 4 {
            if !stdmap_writable(mut vm, map, if kind == 2 then "map.set" else "map.remove") {
                return fl_nil()
            }
        }
        if kind == 2 {
            let value = copy vm.stack[base + 2]
            assert(fl_map_set(mut vm, map, key, value))
            return fl_nil()
        }
        let value = fl_map_get(vm, map, key) else {
            if kind == 3 { return fl_bool(false) }
            if kind == 1 && argc >= 3 { return copy vm.stack[base + 2] }
            return fl_raise(
                mut vm,
                "key",
                if kind == 1 then "map.get: no such key" else "map.remove: no such key",
            )
        }
        if kind == 3 { return fl_bool(true) }
        if kind == 4 { assert(fl_map_del(mut vm, map, key)) }
        return value
    }
    if kind == 5 {
        if !stdmap_writable(mut vm, map, "map.clear") { return fl_nil() }
        fl_map_clear(mut vm, map)
        return fl_nil()
    }
    if kind >= 6 && kind <= 8 { return stdmap_collect(mut vm, map, kind - 6) }
    if kind == 9 || kind == 10 {
        var other = fl_nil()
        if kind == 9 { other = fl_arg_map(mut vm, base, 1) else { return fl_nil() } }
        let result = fl_map_new(mut vm)
        let root = fl_temp_push(mut vm, result)
        stdmap_copy_into(mut vm, result, map)
        if kind == 9 { stdmap_copy_into(mut vm, result, other) }
        let out = fl_temp_get(vm, root)
        fl_temp_pop(mut vm, 1)
        return out
    }
    fl_freeze(mut vm, map)
    map
}

/// Pinned MAP_DEFS order, signatures and arities (stdmap.c:256-269).
pub fn fl_map_defs() -> List[FlNativeDef] {
    [
        fl_native_def("len", 3000, 1, 1, 0, "(m) -> int"),
        fl_native_def("get", 3001, 2, 3, 0, "(m, k, [default]) -> v"),
        fl_native_def("set", 3002, 3, 3, 0, "(m, k, v) -> nil"),
        fl_native_def("has", 3003, 2, 2, 0, "(m, k) -> bool"),
        fl_native_def("remove", 3004, 2, 2, 0, "(m, k) -> v"),
        fl_native_def("clear", 3005, 1, 1, 0, "(m) -> nil"),
        fl_native_def("keys", 3006, 1, 1, 0, "(m) -> list"),
        fl_native_def("values", 3007, 1, 1, 0, "(m) -> list"),
        fl_native_def("entries", 3008, 1, 1, 0, "(m) -> list"),
        fl_native_def("merge", 3009, 2, 2, 0, "(a, b) -> map"),
        fl_native_def("copy", 3010, 1, 1, 0, "(m) -> map"),
        fl_native_def("freeze", 3011, 1, 1, 0, "(m) -> map"),
    ]
}
