//! fl.float — libc conversion seam for sagitta 9ace98c2 src/fl/lex.c:335-349,
//! stdstr.c:884-914, stdfmt.c:169-236, dump.c:271-275, data.c:281-299.
//! Public wolf-std APIs only: no conversion-library implementation read.
//! G51 / wolf-std#103 OPEN: std float APIs canonicalize NaN sign/payload; signed-NaN
//! formatting is NOT byte-identical to Linux libc. R4 host comparison and
//! an upstream preserving bit surface are pending; this is not an acceptance.
//! Decimal fixed/exp/parse are measured against libc by the R4 corpus.
//! General format follows C11 7.21.6.1; hexadecimal rounding follows IEEE
//! 754 roundTiesToEven, including the subnormal grid. No host libc binding.

use std.fmt.decimal as decimal
use std.math.float as floats

fn float_digit(b: byte) -> int {
    let c = b as int
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 65 && c <= 70 { return c - 65 + 10 }
    if c >= 97 && c <= 102 { return c - 97 + 10 }
    -1
}

fn float_word(text: str, at: int, word: str) -> bool {
    if at + word.len > text.len { return false }
    for i in 0..word.len {
        var c = text.bytes()[at + i] as int
        if c >= 65 && c <= 90 { c += 32 }
        if c != word.bytes()[i] as int { return false }
    }
    true
}

fn float_dec(b: byte) -> bool { b >= 48 as byte && b <= 57 as byte }

fn float_space(b: byte) -> bool {
    b == 32 as byte || b >= 9 as byte && b <= 13 as byte
}

fn float_exponent(text: str, start: int) -> (int, int) {
    var pos = start
    var neg = false
    if pos < text.len && (text.bytes()[pos] == 43 as byte || text.bytes()[pos] == 45 as byte) {
        neg = text.bytes()[pos] == 45 as byte
        pos += 1
    }
    let begin = pos
    var exp: int = 0
    while pos < text.len && float_dec(text.bytes()[pos]) {
        if exp < 100000 { exp = exp * 10 + text.bytes()[pos] as int - 48 }
        pos += 1
    }
    if pos == begin { return (0, start) }
    (if neg then -exp else exp, pos)
}

fn float_bit(digits: List[int], bit: int) -> int {
    if bit < 0 || bit >= digits.len * 4 { return 0 }
    digits[bit / 4] >> 3 - bit % 4 & 1
}

fn float_hex_value(digits: List[int], frac: int, exponent: int) -> f64 {
    let end = digits.len * 4
    var leading = 0
    while leading < end && float_bit(digits, leading) == 0 { leading += 1 }
    if leading == end { return 0.0 }
    let high = end - leading - 1 + exponent - 4 * frac
    if high > 1023 { return floats.inf() }
    if high < -1075 { return 0.0 }
    let grid = if high >= -1022 then high - 52 else -1074
    let keep = high - grid + 1
    var q: int = 0
    for b in 0..keep { q = q * 2 + float_bit(digits, leading + b) }
    let guard = float_bit(digits, leading + keep)
    var sticky = false
    for b in leading + keep + 1..end {
        if float_bit(digits, b) != 0 { sticky = true }
    }
    if guard != 0 && (sticky || q & 1 != 0) { q += 1 }
    var value = q as f64
    if grid < 0 {
        for _ in 0..-grid { value /= 2.0 }
    } else {
        for _ in 0..grid { value *= 2.0 }
    }
    value
}

/// strtod's value and end offset. No conversion returns (0,0), even after
/// leading whitespace/sign. Callers decide whether trailing text is legal.
pub fn float_scan(text: str) -> (f64, int) {
    var pos = 0
    while pos < text.len && float_space(text.bytes()[pos]) { pos += 1 }
    var neg = false
    if pos < text.len && (text.bytes()[pos] == 43 as byte || text.bytes()[pos] == 45 as byte) {
        neg = text.bytes()[pos] == 45 as byte
        pos += 1
    }
    let start = pos
    if pos + 3 <= text.len {
        if float_word(text, pos, "inf") {
            pos += 3
            if float_word(text, pos, "inity") { pos += 5 }
            return (if neg then floats.neg_inf() else floats.inf(), pos)
        }
        if float_word(text, pos, "nan") {
            pos += 3
            if pos < text.len && text.bytes()[pos] == 40 as byte {
                var tail = pos + 1
                while tail < text.len {
                    let b = text.bytes()[tail] as int
                    if b >= 48 && b <= 57 || b >= 65 && b <= 90 || b >= 97 && b <= 122 || b == 95 {
                        tail += 1
                    } else {
                        break
                    }
                }
                if tail < text.len && text.bytes()[tail] == 41 as byte { pos = tail + 1 }
            }
            let value = floats.nan()
            return (if neg then -value else value, pos)
        }
    }
    if pos + 2 < text.len &&
        text.bytes()[pos] == 48 as byte &&
        (text.bytes()[pos + 1] == 120 as byte || text.bytes()[pos + 1] == 88 as byte) {
        var digits = List[int]()
        var at = pos + 2
        var frac = 0
        var point = false
        while at < text.len {
            let d = float_digit(text.bytes()[at])
            if d >= 0 {
                (mut digits).push(d)
                if point { frac += 1 }
                at += 1
            } else if !point && text.bytes()[at] == 46 as byte {
                point = true
                at += 1
            } else {
                break
            }
        }
        if digits.len > 0 {
            var exp = 0
            if at < text.len &&
                (text.bytes()[at] == 112 as byte || text.bytes()[at] == 80 as byte) {
                let (e, after) = float_exponent(text, at + 1)
                if after > at + 1 { exp = e; at = after }
            }
            let value = float_hex_value(digits, frac, exp)
            return (if neg then -value else value, at)
        }
    }
    var count = 0
    while pos < text.len && float_dec(text.bytes()[pos]) { pos += 1; count += 1 }
    if pos < text.len && text.bytes()[pos] == 46 as byte {
        pos += 1
        while pos < text.len && float_dec(text.bytes()[pos]) { pos += 1; count += 1 }
    }
    if count == 0 { return (0.0, 0) }
    if pos < text.len && (text.bytes()[pos] == 101 as byte || text.bytes()[pos] == 69 as byte) {
        let (_, after) = float_exponent(text, pos + 1)
        if after > pos + 1 { pos = after }
    }
    let magnitude = decimal.parse_float(text[start..pos]) else |e| match e {
        overflow => floats.inf(),
        parse => { return (0.0, 0) },
    }
    (if neg then -magnitude else magnitude, pos)
}

/// Lexer form: prefix conversion, as lex.c's NULL endptr, NOT full-consume.
pub fn float_parse(text: str) -> f64 ! {parse} {
    let (value, end) = float_scan(text)
    if end == 0 { return parse }
    value
}

fn float_trim_fraction(text: str) -> str {
    if !text.contains(".") { return text }
    var end = text.len
    while end > 0 && text.bytes()[end - 1] == 48 as byte { end -= 1 }
    if end > 0 && text.bytes()[end - 1] == 46 as byte { end -= 1 }
    text[0..end]
}

/// C %g chooses exponent form using the exponent AFTER significant rounding.
pub fn float_general(value: f64, precision: int) -> str {
    let p = if precision < 1 then 1 else precision
    let scientific = decimal.to_str_exp(value, p - 1)
    let at = scientific.find("e") else { return scientific }
    let exp = scientific[at + 1..].to_int() else 0
    if exp < -4 || exp >= p {
        return float_trim_fraction(scientific[0..at]) + scientific[at..]
    }
    float_trim_fraction(decimal.to_str_fixed(value, p - 1 - exp))
}

/// C fixed conversion, with precision clamped to 0..17 as stdfmt.c.
pub fn float_fixed(value: f64, precision: int) -> str {
    decimal.to_str_fixed(
        value,
        if precision < 0 then 0 else if precision > 17 then 17 else precision,
    )
}

/// C exponent conversion, with precision clamped to 0..17 as stdfmt.c.
pub fn float_exp(value: f64, precision: int) -> str {
    decimal.to_str_exp(value, if precision < 0 then 0 else if precision > 17 then 17 else precision)
}

/// C first roundtripping 15/16/17-digit spelling, retaining float .0.
pub fn float_shortest(value: f64) -> str {
    var text = ""
    for p in 15..=17 {
        text = float_general(value, p)
        let parsed = float_parse(text) else 0.0
        if parsed == value { break }
    }
    let at = text.find("e") else text.len
    if text[0..at].contains(".") { return text }
    text[0..at] + ".0" + text[at..]
}
