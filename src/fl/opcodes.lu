//! fl.opcodes — sagitta 9ace98c2 src/fl/opcodes.def and opcodes.c:19-254.
//! One metadata table; constants preserve the pinned byte values.

use util

/// Number of pinned opcodes (below the reserved 0xF0 ceiling).
pub const FL_OP_COUNT: int = 60

/// Variable stack effect sentinel.
pub const FL_EFF_VAR: int = -128

/// Name, operand encoding, and net stack effect.
pub struct FlOpcode { name: str, operands: str, effect: int }

/// Pinned CONST opcode.
pub const FL_OP_CONST: int = 0

/// Pinned NIL opcode.
pub const FL_OP_NIL: int = 1

/// Pinned TRUE opcode.
pub const FL_OP_TRUE: int = 2

/// Pinned FALSE opcode.
pub const FL_OP_FALSE: int = 3

/// Pinned INT8 opcode.
pub const FL_OP_INT8: int = 4

/// Pinned NIL_N opcode.
pub const FL_OP_NIL_N: int = 5

/// Pinned POP opcode.
pub const FL_OP_POP: int = 6

/// Pinned POPN opcode.
pub const FL_OP_POPN: int = 7

/// Pinned DUP opcode.
pub const FL_OP_DUP: int = 8

/// Pinned GET_LOCAL opcode.
pub const FL_OP_GET_LOCAL: int = 9

/// Pinned SET_LOCAL opcode.
pub const FL_OP_SET_LOCAL: int = 10

