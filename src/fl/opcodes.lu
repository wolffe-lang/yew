/// Metadata for an opcode; unknown bytes decode as BAD_OP with no operands.
pub fn fl_opcode(op: int) -> FlOpcode {
    match op {
        0 => FlOpcode { name: "CONST", operands: "w", effect: 1 },
        1 => FlOpcode { name: "NIL", operands: "", effect: 1 },
        2 => FlOpcode { name: "TRUE", operands: "", effect: 1 },
        3 => FlOpcode { name: "FALSE", operands: "", effect: 1 },
        4 => FlOpcode { name: "INT8", operands: "s", effect: 1 },
        5 => FlOpcode { name: "NIL_N", operands: "b", effect: FL_EFF_VAR },
        6 => FlOpcode { name: "POP", operands: "", effect: -1 },
        7 => FlOpcode { name: "POPN", operands: "b", effect: FL_EFF_VAR },
        8 => FlOpcode { name: "DUP", operands: "", effect: 1 },
        9 => FlOpcode { name: "GET_LOCAL", operands: "b", effect: 1 },
        10 => FlOpcode { name: "SET_LOCAL", operands: "b", effect: -1 },
        11 => FlOpcode { name: "GET_UPVAL", operands: "b", effect: 1 },
        12 => FlOpcode { name: "SET_UPVAL", operands: "b", effect: -1 },
        13 => FlOpcode { name: "CLOSE_UPVALS", operands: "b", effect: FL_EFF_VAR },
        14 => FlOpcode { name: "GET_GLOBAL", operands: "w", effect: 1 },
        15 => FlOpcode { name: "SET_GLOBAL", operands: "w", effect: -1 },
        16 => FlOpcode { name: "DEF_GLOBAL", operands: "w", effect: -1 },
        17 => FlOpcode { name: "ADD", operands: "", effect: -1 },
        18 => FlOpcode { name: "SUB", operands: "", effect: -1 },
        19 => FlOpcode { name: "MUL", operands: "", effect: -1 },
        20 => FlOpcode { name: "DIV", operands: "", effect: -1 },
        21 => FlOpcode { name: "MOD", operands: "", effect: -1 },
        22 => FlOpcode { name: "NEG", operands: "", effect: 0 },
        23 => FlOpcode { name: "NOT", operands: "", effect: 0 },
        24 => FlOpcode { name: "EQ", operands: "", effect: -1 },
        25 => FlOpcode { name: "NE", operands: "", effect: -1 },
        26 => FlOpcode { name: "LT", operands: "", effect: -1 },
        27 => FlOpcode { name: "LE", operands: "", effect: -1 },
        28 => FlOpcode { name: "GT", operands: "", effect: -1 },
        29 => FlOpcode { name: "GE", operands: "", effect: -1 },
        30 => FlOpcode { name: "JUMP", operands: "w", effect: 0 },
        31 => FlOpcode { name: "JUMP_BACK", operands: "w", effect: 0 },
        32 => FlOpcode { name: "JUMP_IF_FALSE", operands: "w", effect: -1 },
        33 => FlOpcode { name: "JUMP_IF_TRUE", operands: "w", effect: -1 },
        34 => FlOpcode { name: "OR_JUMP", operands: "w", effect: 0 },
        35 => FlOpcode { name: "AND_JUMP", operands: "w", effect: 0 },
        36 => FlOpcode { name: "CALL", operands: "b", effect: FL_EFF_VAR },
        37 => FlOpcode { name: "RETURN", operands: "", effect: FL_EFF_VAR },
        38 => FlOpcode { name: "RETURN_NIL", operands: "", effect: FL_EFF_VAR },
        39 => FlOpcode { name: "CLOSURE", operands: "w", effect: 1 },
        40 => FlOpcode { name: "LIST", operands: "w", effect: FL_EFF_VAR },
        41 => FlOpcode { name: "MAP", operands: "w", effect: FL_EFF_VAR },
        42 => FlOpcode { name: "INDEX_GET", operands: "", effect: -1 },
        43 => FlOpcode { name: "INDEX_SET", operands: "", effect: -3 },
        44 => FlOpcode { name: "FIELD_GET", operands: "w", effect: 0 },
        45 => FlOpcode { name: "FIELD_SET", operands: "w", effect: -2 },
        46 => FlOpcode { name: "ITER_NEW", operands: "", effect: 2 },
        47 => FlOpcode { name: "ITER_NEXT1", operands: "bw", effect: 1 },
        48 => FlOpcode { name: "ITER_NEXT2", operands: "bw", effect: 2 },
        49 => FlOpcode { name: "MOTION", operands: "w", effect: 1 },
        50 => FlOpcode { name: "IMPORT", operands: "wb", effect: 1 },
        51 => FlOpcode { name: "EDIT_BEGIN", operands: "", effect: 0 },
        52 => FlOpcode { name: "EDIT_END", operands: "", effect: 0 },
        53 => FlOpcode { name: "THROW", operands: "", effect: -1 },
        54 => FlOpcode { name: "TRY_PUSH", operands: "w", effect: 0 },
        55 => FlOpcode { name: "TRY_POP", operands: "", effect: 0 },
        56 => FlOpcode { name: "HALT", operands: "", effect: 0 },
        57 => FlOpcode { name: "LIST_APPEND", operands: "b", effect: -1 },
        58 => FlOpcode { name: "NOT_NIL", operands: "", effect: 0 },
        59 => FlOpcode { name: "TRACE_LINE", operands: "w", effect: 0 },
        _ => FlOpcode { name: "BAD_OP", operands: "", effect: 0 },
    }
}

/// Opcode name, or BAD_OP.
pub fn fl_op_name(op: int) -> str { fl_opcode(op).name }

/// Fixed operand shapes (b unsigned byte, s signed byte, w little-endian u16).
pub fn fl_op_operands(op: int) -> str { fl_opcode(op).operands }

/// Net effect, or FL_EFF_VAR.
pub fn fl_op_effect(op: int) -> int { fl_opcode(op).effect }

/// Read the source location at or before an instruction PC.
pub fn fl_line_at(vm: FlVm, fun: FlValue, pc: int) -> (int, int) {
    let at = fl_obj_index(vm, fun)
    var lo: int = 0
    var hi = vm.gc.slots[at].lines.len
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if vm.gc.slots[at].lines[mid].pc <= pc { lo = mid + 1 } else { hi = mid }
    }
    if lo == 0 { return (0, 0) }
    (vm.gc.slots[at].lines[lo - 1].line, vm.gc.slots[at].lines[lo - 1].col)
}

/// Total encoded length, including closure capture pairs.
pub fn fl_op_length(vm: FlVm, fun: FlValue, pc: int) -> int {
    let at = fl_obj_index(vm, fun)
    if pc >= vm.gc.slots[at].code.len { return 1 }
    let op = vm.gc.slots[at].code[pc] as int
    var n: int = 1
    for b in fl_op_operands(op).bytes() { n += if b == 119 as byte then 2 else 1 }
    if op == 39 {
        let k = vm.gc.slots[at].code[pc + 1] as int | vm.gc.slots[at].code[pc + 2] as int << 8
        if k < vm.gc.slots[at].vals.len && vm.gc.slots[at].vals[k].t == 7 {
            let f = copy vm.gc.slots[at].vals[k]
            n += vm.gc.slots[fl_obj_index(vm, f)].nup * 2
        }
    }
    n
}

fn fl_disasm_annotate(vm: FlVm, fun: FlValue, op: int, k: int, mut out: List[byte]) {
    let at = fl_obj_index(vm, fun)
    if k >= vm.gc.slots[at].vals.len { return }
    let c = copy vm.gc.slots[at].vals[k]
    if op == 14 || op == 15 || op == 16 || op == 44 || op == 45 || op == 50 {
        if c.t == 2 && c.i > 0 && c.i < vm.strings.items.len {
            util.buf_append_str(mut out, " ; ")
            for b in vm.strings.items[c.i] { (mut out).push(b) }
        }
        return
    }
    if op != 0 { return }
    util.buf_append_str(mut out, " ; ")
    match c.t {
        0 => util.buf_append_str(mut out, "nil"),
        1 => util.buf_append_str(mut out, if c.i != 0 then "true" else "false"),
        2 => util.buf_append_str(mut out, "{c.i}"),
        3 => util.buf_append_str(mut out, float_general(c.f, 17)),
        4 => {
            let si = fl_obj_index(vm, c)
            (mut out).push(34 as byte)
            var i: int = 0
            while i < vm.gc.slots[si].bytes.len && i < 24 {
                let b = vm.gc.slots[si].bytes[i]
                if b == 34 as byte || b == 92 as byte {
                    (mut out).push(92 as byte)
                    (mut out).push(b)
                } else if b < 32 as byte {
                    util.buf_append_str(mut out, "\\x")
                    (mut out).push("0123456789ABCDEF".bytes()[b as int / 16])
                    (mut out).push("0123456789ABCDEF".bytes()[b as int % 16])
                } else {
                    (mut out).push(b)
                }
                i += 1
            }
            if vm.gc.slots[si].bytes.len > 24 { util.buf_append_str(mut out, "...") }
            (mut out).push(34 as byte)
        },
        _ => util.buf_append_str(mut out, fl_type_name(c.t)),
    }
}

/// Append one instruction's exact pinned C disassembly.
pub fn fl_disasm_op(vm: FlVm, fun: FlValue, pc: int, mut out: List[byte]) {
    let at = fl_obj_index(vm, fun)
    if pc >= vm.gc.slots[at].code.len { return }
    let op = vm.gc.slots[at].code[pc] as int
    let (line, col) = fl_line_at(vm, fun, pc)
    let pcs = "{pc}"
    for _ in pcs.len..4 { (mut out).push(48 as byte) }
    util.buf_append_str(mut out, "{pc}  {line}:{col}  ")
    let name = fl_op_name(op)
    util.buf_append_str(mut out, name)
    for _ in name.len..13 { (mut out).push(32 as byte) }
    var p = pc + 1
    var first: int = -1
    for shape in fl_op_operands(op).bytes() {
        var v = vm.gc.slots[at].code[p] as int
        p += 1
        if shape == 119 as byte { v = v | vm.gc.slots[at].code[p] as int << 8; p += 1 }
        if first < 0 { first = v }
        let shown = if shape == 115 as byte && v >= 128 then v - 256 else v
        util.buf_append_str(mut out, " {shown}")
    }
    if first >= 0 { fl_disasm_annotate(vm, fun, op, first, mut out) }
    if op == 39 &&
        first >= 0 &&
        first < vm.gc.slots[at].vals.len &&
        vm.gc.slots[at].vals[first].t == 7 {
        let fnval = copy vm.gc.slots[at].vals[first]
        let nup = vm.gc.slots[fl_obj_index(vm, fnval)].nup
        for _ in 0..nup {
            let where = if vm.gc.slots[at].code[p] != 0 as byte then "local" else "upval"
            let ix = vm.gc.slots[at].code[p + 1] as int
            util.buf_append_str(mut out, " ({where} {ix})")
            p += 2
        }
    }
    (mut out).push(10 as byte)
}

/// Append every instruction in bytecode order, without nested-function headings.
pub fn fl_disasm_chunk(vm: FlVm, fun: FlValue, mut out: List[byte]) {
    let at = fl_obj_index(vm, fun)
    var pc: int = 0
    while pc < vm.gc.slots[at].code.len {
        let n = fl_op_length(vm, fun, pc)
        fl_disasm_op(vm, fun, pc, mut out)
        pc += n
    }
}
