//! fl.origin_registry — sagitta 9ace98c2 src/fl/origin.c:28-200 and
//! origin.h:100-161. The editor owns this value; fl never imports edit.
//! A missing editor is an absent registry, distinct from config principal 0.
//! Labels preserve bytes and C's NUL boundary; kind is never a registry id.

/// The stable user-config principal, independent of its diagnostic path.
pub const FL_ORIGIN_ID_CONFIG: int = 0

/// No editor registry, deliberately different from config principal zero.
pub const FL_ORIGIN_ID_NONE: int = 4294967295

/// One origin's owned diagnostic label and current grants.
pub struct FlOriginRec { kind: int, caps: int, label: List[byte] }

/// Editor-owned registration order and idempotent teardown masks.
pub struct FlOriginReg { present: bool, v: List[FlOriginRec], masked: List[int] }

/// The NULL-editor state, used only when no host registry exists.
pub fn fl_origin_reg_none() -> FlOriginReg {
    FlOriginReg { present: false, v: List[FlOriginRec](), masked: List[int]() }
}

/// Reserve config zero before any source loads, even when no user config exists.
pub fn fl_origin_reg_new() -> FlOriginReg {
    var r = fl_origin_reg_none()
    r.present = true
    let _ = fl_origin_register(mut r, FL_ORIGIN_CONFIG, "the user config".bytes(), FL_CAP_ALL)
    r
}

fn origin_label_bytes(label: List[byte]) -> List[byte] {
    // G52 (wolf-lang#942): materialise a lent bytes() argument at ownership.
    var out = List[byte]()
    for b in label { if b == 0 as byte { break }; (mut out).push(b) }
    out
}

fn origin_label_equal(a: List[byte], b: List[byte]) -> bool {
    var n = 0
    while n < b.len && b[n] != 0 as byte { n += 1 }
    if a.len != n { return false }
    for i in 0..n { if a[i] != b[i] { return false } }
    true
}

/// Intern (kind, label) and refresh its caps. Null-registry calls answer NONE.
/// C's NULL label is supplied as "an unnamed origin" by its optional-label caller.
pub fn fl_origin_register(mut r: FlOriginReg, kind: int, label: List[byte], caps: int) -> int {
    if !r.present { return FL_ORIGIN_ID_NONE }
    for i in 0..r.v.len {
        if r.v[i].kind == kind && origin_label_equal(r.v[i].label, label) {
            r.v[i].caps = caps
            return i
        }
    }
    let owned = origin_label_bytes(label)
    (mut r.v).push(FlOriginRec { kind: kind, caps: caps, label: owned })
    r.v.len - 1
}

/// Diagnostic bytes for a registered principal, or C's unknown-origin label.
pub fn fl_origin_label(r: FlOriginReg, id: int) -> List[byte] {
    if !r.present || id < 0 || id >= r.v.len {
        return origin_label_bytes("an unknown origin".bytes())
    }
    copy r.v[id].label
}

/// Grants for a registered principal; an absent principal has no grants.
pub fn fl_origin_caps(r: FlOriginReg, id: int) -> int {
    if !r.present || id < 0 || id >= r.v.len { return 0 }
    r.v[id].caps
}

/// Use the defining module's stable principal, or derive one from its label.
/// A CONFIG origin always uses zero even when --config changed its path.
pub fn fl_origin_of_frame(mut r: FlOriginReg, vm: FlVm) -> int {
    if !r.present { return FL_ORIGIN_ID_NONE }
    let o = fl_cap_origin(vm)
    if o.principal_id != 0 { return o.principal_id }
    if o.kind == FL_ORIGIN_CONFIG { return FL_ORIGIN_ID_CONFIG }
    let name = fl_origin_name(vm, o)
    fl_origin_register(mut r, o.kind, name, o.caps)
}

/// Whether this principal is being torn down; missing registries mask nothing.
pub fn fl_origin_masked(r: FlOriginReg, id: int) -> bool {
    if !r.present { return false }
    for value in r.masked { if value == id { return true } }
    false
}

/// Add one teardown mask; repeated masking is a no-op.
pub fn fl_origin_mask(mut r: FlOriginReg, id: int) {
    if !r.present || fl_origin_masked(r, id) { return }
    (mut r.masked).push(id)
}

/// Remove one mask by swapping in its last slot, as origin.c:177-181.
pub fn fl_origin_unmask(mut r: FlOriginReg, id: int) {
    if !r.present { return }
    for i in 0..r.masked.len {
        if r.masked[i] == id {
            r.masked[i] = r.masked[r.masked.len - 1]
            let _ = (mut r.masked).pop() else 0
            return
        }
    }
}
