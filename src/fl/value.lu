//! fl.value — sagitta 9ace98c2 src/fl/value.h:23-349, value.c:19-339.
//! R2 scalar representation: 24 B, no NaN boxing. Heap identity includes a
//! generation; every object access validates it. Strings are verbatim bytes.

/// Pinned C FL_NIL discriminant.
pub const FL_NIL: int = 0

/// Pinned C FL_BOOL discriminant.
pub const FL_BOOL: int = 1

/// Pinned C FL_INT discriminant.
pub const FL_INT: int = 2

/// Pinned C FL_FLOAT discriminant.
pub const FL_FLOAT: int = 3

/// Pinned C FL_STR discriminant.
pub const FL_STR: int = 4

/// Pinned C FL_LIST discriminant.
pub const FL_LIST: int = 5

/// Pinned C FL_MAP discriminant.
pub const FL_MAP: int = 6

/// Pinned C FL_FN discriminant.
pub const FL_FN: int = 7

/// Pinned C FL_CLOSURE discriminant.
pub const FL_CLOSURE: int = 8

/// Pinned C FL_NATIVE discriminant.
pub const FL_NATIVE: int = 9

/// Pinned C FL_MOTION_PROG discriminant.
pub const FL_MOTION_PROG: int = 10

/// Pinned C FL_UPVAL discriminant.
pub const FL_UPVAL: int = 11

/// Pinned C FL_BUF discriminant.
pub const FL_BUF: int = 12

/// Pinned C FL_CURSOR discriminant.
pub const FL_CURSOR: int = 13

/// Pinned C FL_SPAN discriminant.
pub const FL_SPAN: int = 14

/// Pinned C FL_WIN discriminant.
pub const FL_WIN: int = 15

/// Pinned C FL_REGEX discriminant.
pub const FL_REGEX: int = 16

/// Pinned C FL_TYPE_COUNT discriminant.
pub const FL_TYPE_COUNT: int = 17

/// Scalar tag/int/f64 value; objects encode physical slot and generation.
pub struct FlValue { t: int, i: int, f: f64 }

/// Dense insertion-order map row, including a retained dead-row marker.
pub struct FlMapEnt { k: FlValue, v: FlValue, hash: int, dead: bool }

/// Instruction-start source location, including byte column.
pub struct FlLineRun { pc: int, line: int, col: int }

/// Preassembled motion operation at the compiler/host boundary.
pub struct FlMotionOp { kind: int, ch: int, flags: int, count: int, arg: int }

/// Fixed physical slot. Reset payload lengths, never replace their buffers.
/// vals = list elements / function constants / closure upvalues.
pub struct FlObj {
    t: int,
    marked: bool,
    flags: int,
    aux: int,
    generation: int,
    bytes: List[byte],
    vals: List[FlValue],
    ents: List[FlMapEnt],
    idx: List[int],
    cap: int,
    icap: int,
    ndead: int,
    mods: int,
    code: List[byte],
    lines: List[FlLineRun],
    ops: List[FlMotionOp],
    name_id: int,
    arity: int,
    nup: int,
    fnkind: int,
    max_stack: int,
    file_id: int,
    origin: FlOrigin,
    fn_value: FlValue,
    globals: FlValue,
    closed: FlValue,
    recv: FlValue,
    slot: int,
    native_kind: int,
    min_ar: int,
    max_ar: int,
    has_recv: int,
    caps: int,
}

/// Construct nil.
pub fn fl_nil() -> FlValue { FlValue { t: 0, i: 0, f: 0.0 } }

/// Construct a boolean.
pub fn fl_bool(b: bool) -> FlValue { FlValue { t: 1, i: if b then 1 else 0, f: 0.0 } }

/// Construct a signed 64-bit integer.
pub fn fl_int(i: int) -> FlValue { FlValue { t: 2, i: i, f: 0.0 } }

/// Construct an IEEE binary64 value.
pub fn fl_float(f: f64) -> FlValue { FlValue { t: 3, i: 0, f: f } }

/// Whether the value carries a traced heap reference, not a scalar handle.
pub fn fl_is_obj(v: FlValue) -> bool { v.t >= 4 && v.t <= 11 }

/// Only nil and false are falsey.
pub fn fl_truthy(v: FlValue) -> bool { v.t != 0 && (v.t != 1 || v.i != 0) }

/// Only string, integer, and boolean values are valid map keys.
pub fn fl_hashable(v: FlValue) -> bool { v.t == 4 || v.t == 2 || v.t == 1 }

/// Return the pinned diagnostic type name, or ? for an invalid tag.
pub fn fl_type_name(t: int) -> str {
    match t {
        0 => "nil",
        1 => "bool",
        2 => "int",
        3 => "float",
        4 => "str",
        5 => "list",
        6 => "map",
        7..=9 => "fn",
        10 => "motion",
        11 => "upval",
        12 => "buf",
        13 => "cursor",
        14 => "span",
        15 => "win",
        16 => "regex",
        _ => "?",
    }
}

/// FNV-1a over verbatim bytes, with wrapping 32-bit arithmetic.
pub fn fl_hash_bytes(b: List[byte]) -> int {
    var h: wrapping[u32] = 2166136261
    for x in b { h = (h ^ x as int as wrapping[u32]) * 16777619 }
    h as int
}

/// Check that an object reference names its original slot generation.
pub fn fl_valid(vm: FlVm, v: FlValue) -> bool {
    if !fl_is_obj(v) { return true }
    if v.i < 0 { return false }
    let at = v.i % 4294967296
    at < vm.gc.slots.len &&
        vm.gc.slots[at].t == v.t &&
        vm.gc.slots[at].generation == v.i / 4294967296
}

/// Decode an object reference; traps on a stale generation or non-object.
pub fn fl_obj_index(vm: FlVm, v: FlValue) -> int {
    assert(fl_is_obj(v) && fl_valid(vm, v))
    v.i % 4294967296
}

/// Construct a reference to an occupied physical slot.
pub fn fl_reference(vm: FlVm, at: int) -> FlValue {
    FlValue { t: vm.gc.slots[at].t, i: vm.gc.slots[at].generation * 4294967296 + at, f: 0.0 }
}

/// Compare string length, cached hash, then bytes; validates both references.
pub fn fl_str_eq(vm: FlVm, a: FlValue, b: FlValue) -> bool {
    let x = fl_obj_index(vm, a)
    let y = fl_obj_index(vm, b)
    if x == y { return true }
    if vm.gc.slots[x].aux != vm.gc.slots[y].aux ||
        vm.gc.slots[x].bytes.len != vm.gc.slots[y].bytes.len {
        return false
    }
    for i in 0..vm.gc.slots[x].bytes.len {
        if vm.gc.slots[x].bytes[i] != vm.gc.slots[y].bytes[i] { return false }
    }
    true
}

/// Numeric int/float equality, string content, otherwise scalar/identity equality.
pub fn fl_equal(vm: FlVm, a: FlValue, b: FlValue) -> bool {
    if a.t == 2 && b.t == 3 { return a.i as f64 == b.f }
    if a.t == 3 && b.t == 2 { return a.f == b.i as f64 }
    if a.t != b.t { return false }
    match a.t {
        0 => true,
        3 => a.f == b.f,
        4 => fl_str_eq(vm, a, b),
        _ => a.i == b.i,
    }
}

/// Hash an allowed map key; traps on an unhashable key.
pub fn fl_hash_value(vm: FlVm, v: FlValue) -> int {
    assert(fl_hashable(v))
    if v.t == 4 { return vm.gc.slots[fl_obj_index(vm, v)].aux }
    if v.t == 1 { return if v.i != 0 then 2654435769 else 2246822507 }
    var h: wrapping[u32] = 2166136261
    // C's supported LP64 targets are little-endian; signed shifts preserve
    // the original two's-complement byte pattern even for INT64_MIN.
    for j in 0..8 { h = (h ^ (v.i >> j * 8 & 255) as wrapping[u32]) * 16777619 }
    h as int
}

fn fl_map_probe(vm: FlVm, at: int, k: FlValue, hash: int) -> (int, bool) {
    if vm.gc.slots[at].icap == 0 { return (0, false) }
    let mask = vm.gc.slots[at].icap - 1
    var i = hash & mask
    loop {
        let slot = vm.gc.slots[at].idx[i]
        if slot == 0 { return (i, false) }
        let e = copy vm.gc.slots[at].ents[slot - 1]
        if !e.dead && e.hash == hash && fl_equal(vm, e.k, k) { return (i, true) }
        i = i + 1 & mask
    }
}

/// Find a map key; none means absent or unhashable.
pub fn fl_map_get(vm: FlVm, m: FlValue, k: FlValue) -> FlValue ! {none} {
    if !fl_hashable(k) { return none }
    let at = fl_obj_index(vm, m)
    let (p, found) = fl_map_probe(vm, at, k, fl_hash_value(vm, k))
    if !found { return none }
    copy vm.gc.slots[at].ents[vm.gc.slots[at].idx[p] - 1].v
}

fn fl_map_reindex(mut vm: FlVm, at: int) {
    let cap = vm.gc.slots[at].icap
    for i in 0..cap { vm.gc.slots[at].idx[i] = 0 }
    if cap == 0 { return }
    for i in 0..vm.gc.slots[at].ents.len {
        if vm.gc.slots[at].ents[i].dead { continue }
        var p = vm.gc.slots[at].ents[i].hash & cap - 1
        while vm.gc.slots[at].idx[p] != 0 { p = p + 1 & cap - 1 }
        vm.gc.slots[at].idx[p] = i + 1
    }
}

/// Remove dead rows in place without reordering live entries.
pub fn fl_map_compact(mut vm: FlVm, m: FlValue) {
    let at = fl_obj_index(vm, m)
    var w: int = 0
    let n = vm.gc.slots[at].ents.len
    for i in 0..n {
        if !vm.gc.slots[at].ents[i].dead {
            if w != i { vm.gc.slots[at].ents[w] = copy vm.gc.slots[at].ents[i] }
            w += 1
        }
    }
    while vm.gc.slots[at].ents.len > w {
        let _ = (mut vm.gc.slots[at].ents).pop() else FlMapEnt {
            k: fl_nil(),
            v: fl_nil(),
            hash: 0,
            dead: true,
        }
    }
    vm.gc.slots[at].ndead = 0
    fl_map_reindex(mut vm, at)
}

/// Delete a key; false means absent or unhashable.
pub fn fl_map_del(mut vm: FlVm, m: FlValue, k: FlValue) -> bool {
    if !fl_hashable(k) { return false }
    let at = fl_obj_index(vm, m)
    let (p, found) = fl_map_probe(vm, at, k, fl_hash_value(vm, k))
    if !found { return false }
    let row = vm.gc.slots[at].idx[p] - 1
    vm.gc.slots[at].ents[row].dead = true
    vm.gc.slots[at].ndead += 1
    vm.gc.slots[at].mods += 1
    fl_map_reindex(mut vm, at)
    if vm.gc.slots[at].ndead > vm.gc.slots[at].ents.len / 2 { fl_map_compact(mut vm, m) }
    true
}

/// Empty a map in one pass, preserving buffers and advancing mods once.
pub fn fl_map_clear(mut vm: FlVm, m: FlValue) {
    let at = fl_obj_index(vm, m)
    (mut vm.gc.slots[at].ents).reset()
    vm.gc.slots[at].ndead = 0
    vm.gc.slots[at].mods += 1
    fl_map_reindex(mut vm, at)
}

/// Count live map entries.
pub fn fl_map_count(vm: FlVm, m: FlValue) -> int {
    let at = fl_obj_index(vm, m)
    vm.gc.slots[at].ents.len - vm.gc.slots[at].ndead
}

/// Read the next live insertion-order row; none means exhausted.
pub fn fl_map_iter(vm: FlVm, m: FlValue, cursor: int) -> (int, FlValue, FlValue) ! {none} {
    let at = fl_obj_index(vm, m)
    var i = cursor
    while i < vm.gc.slots[at].ents.len {
        let e = copy vm.gc.slots[at].ents[i]
        i += 1
        if !e.dead { return (i, e.k, e.v) }
    }
    none
}

/// Length in bytes; traps for a non-string or stale reference.
pub fn fl_str_len(vm: FlVm, s: FlValue) -> int {
    assert(s.t == 4)
    vm.gc.slots[fl_obj_index(vm, s)].bytes.len
}

/// List element count; traps for a non-list or stale reference.
pub fn fl_list_len(vm: FlVm, list: FlValue) -> int {
    assert(list.t == 5)
    vm.gc.slots[fl_obj_index(vm, list)].vals.len
}

/// Read a list slot; none means out of bounds (negative indices not adjusted).
pub fn fl_list_get(vm: FlVm, list: FlValue, i: int) -> FlValue ! {none} {
    let at = fl_obj_index(vm, list)
    if i < 0 || i >= vm.gc.slots[at].vals.len { return none }
    copy vm.gc.slots[at].vals[i]
}

/// Replace an existing list element without changing the structural counter.
pub fn fl_list_set(mut vm: FlVm, list: FlValue, i: int, v: FlValue) -> bool {
    let at = fl_obj_index(vm, list)
    if i < 0 || i >= vm.gc.slots[at].vals.len { return false }
    vm.gc.slots[at].vals[i] = v
    true
}

/// Remove a list element, preserving order; none means out of bounds.
pub fn fl_list_remove(mut vm: FlVm, list: FlValue, i: int) -> FlValue ! {none} {
    let at = fl_obj_index(vm, list)
    if i < 0 || i >= vm.gc.slots[at].vals.len { return none }
    let v = copy vm.gc.slots[at].vals[i]
    for j in i..vm.gc.slots[at].vals.len - 1 {
        vm.gc.slots[at].vals[j] = copy vm.gc.slots[at].vals[j + 1]
    }
    let _ = (mut vm.gc.slots[at].vals).pop() else fl_nil()
    vm.gc.slots[at].mods += 1
    v
}

/// Empty a list, retain its payload allocation, and increment mods once.
pub fn fl_list_clear(mut vm: FlVm, list: FlValue) {
    let at = fl_obj_index(vm, list)
    (mut vm.gc.slots[at].vals).reset()
    vm.gc.slots[at].mods += 1
}

/// Set the shallow frozen-object flag used by module exports.
pub fn fl_freeze(mut vm: FlVm, value: FlValue) {
    let at = fl_obj_index(vm, value)
    vm.gc.slots[at].flags = vm.gc.slots[at].flags | 2
}

/// Whether the object is frozen (immediates are not mutable objects).
pub fn fl_frozen(vm: FlVm, value: FlValue) -> bool {
    fl_is_obj(value) && vm.gc.slots[fl_obj_index(vm, value)].flags & 2 != 0
}
