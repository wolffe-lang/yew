//! fl.origin — the headless origin/capability surface pulled forward by R6.
//! Sagitta 9ace98c2 src/fl/origin.h:50-99 and origin.c:230-257.
//! Registry ownership stays yw09/yw14; kind is NOT a registry id.

/// Builtins are transparent to defining-module capability checks.
pub const FL_ORIGIN_BUILTIN: int = 0

/// User configuration origin.
pub const FL_ORIGIN_CONFIG: int = 1

/// Workspace configuration origin.
pub const FL_ORIGIN_WORKSPACE: int = 2

/// Plugin origin, independently granted capabilities.
pub const FL_ORIGIN_PLUGIN: int = 3

/// Noninteractive command-line origin.
pub const FL_ORIGIN_CLI: int = 4

/// Interactive language prompt origin.
pub const FL_ORIGIN_REPL: int = 5

/// Read filesystem capability.
pub const FL_CAP_FS_READ: int = 1

/// Write filesystem capability.
pub const FL_CAP_FS_WRITE: int = 2

/// Shell capability, no independent stdlib surface.
pub const FL_CAP_SHELL: int = 4

/// Network capability, no independent stdlib surface.
pub const FL_CAP_NET: int = 8

/// Clipboard capability added at the pinned editor API.
pub const FL_CAP_CLIPBOARD: int = 16

/// All five capabilities, as pinned origin.h rather than s31's old four.
pub const FL_CAP_ALL: int = 31

/// Defining module authority and stable principal, never inferred from cwd.
pub struct FlOrigin {
    kind: int,
    path_id: int,
    caps: int,
    principal_id: int,
}

/// An origin without an associated module path or registry principal.
pub fn fl_origin_new(kind: int, caps: int) -> FlOrigin {
    FlOrigin { kind: kind, path_id: 0, caps: caps, principal_id: 0 }
}

/// Pinned diagnostic name for one capability, generic for composite/unknown.
pub fn fl_cap_name(cap: int) -> str {
    match cap {
        1 => "fs.read",
        2 => "fs.write",
        4 => "shell",
        8 => "net",
        16 => "clipboard",
        _ => "capability",
    }
}

/// Pinned fallback label when the defining origin has no interned path.
pub fn fl_origin_kind_name(kind: int) -> str {
    match kind {
        0 => "a builtin",
        1 => "the user config",
        2 => "the workspace config",
        3 => "a plugin",
        4 => "the command line",
        5 => "the REPL",
        _ => "an unknown origin",
    }
}
