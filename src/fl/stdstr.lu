//! fl.stdstr — byte-preserving, grapheme-indexed string natives.
//! Ports sagitta 9ace98c2 src/fl/stdstr.c:35-975; Unicode algorithms are
//! shared with unicode, never duplicated. No operation reenters the VM.

use unicode
use util

const STDSTR_MAX: int = 67108864

fn stdstr_big(mut vm: FlVm, n: int, who: str) -> bool {
    if n <= STDSTR_MAX { return false }
    let _ = fl_raise(mut vm, "limit", "{who}: result exceeds 64 MiB")
    true
}

fn stdstr_append(mut out: List[byte], bytes: List[byte], lo: int, hi: int) {
    var i = lo
    while i < hi { (mut out).push(bytes[i]); i += 1 }
}

fn stdstr_slice(mut vm: FlVm, v: FlValue, lo: int, hi: int) -> FlValue {
    let slot = fl_obj_index(vm, v)
    var out = List[byte]()
    stdstr_append(mut out, vm.gc.slots[slot].bytes, lo, hi)
    fl_str_new(mut vm, out)
}

fn stdstr_cluster(bytes: List[byte], index: int, count: int) -> int ! {none} {
    let want = if index < 0 then count + index else index
    if want < 0 || want > count { return none }
    var at = 0
    for _ in 0..want { at = unicode.gb_next_bytes(bytes, bytes.len, at) }
    at
}

fn stdstr_boundary(bytes: List[byte], at: int) -> bool {
    if at == 0 || at == bytes.len { return true }
    if at < 0 || at > bytes.len || !unicode.utf8_is_boundary(bytes, 0, bytes.len, at) {
        return false
    }
    let prev = unicode.gb_prev_bytes(bytes, bytes.len, at)
    unicode.gb_next_bytes(bytes, bytes.len, prev) == at
}

fn stdstr_byteoff(mut vm: FlVm, value: FlValue, index: int, who: str) -> int ! {arg} {
    let slot = fl_obj_index(vm, value)
    let len = vm.gc.slots[slot].bytes.len
    let at = if index < 0 then len + index else index
    if at < 0 || at > len {
        let _ = fl_raise(mut vm, "index", "{who}: byte offset {index} out of range")
        return arg
    }
    if !stdstr_boundary(vm.gc.slots[slot].bytes, at) {
        let _ = fl_raise(mut vm, "index", "{who}: offset {at} splits a grapheme cluster")
        return arg
    }
    at
}

fn stdstr_match(bytes: List[byte], at: int, needle: List[byte]) -> bool {
    if at < 0 || at > bytes.len || needle.len > bytes.len - at { return false }
    for i in 0..needle.len { if bytes[at + i] != needle[i] { return false } }
    true
}

fn stdstr_find(bytes: List[byte], needle: List[byte], from: int) -> int {
    if needle.len == 0 { return from }
    var i = from
    while i <= bytes.len - needle.len { if stdstr_match(bytes, i, needle) { return i }; i += 1 }
    -1
}

fn stdstr_cmp(a: List[byte], b: List[byte]) -> int {
    let n = if a.len < b.len then a.len else b.len
    for i in 0..n { if a[i] < b[i] { return -1 }; if a[i] > b[i] { return 1 } }
    if a.len < b.len then -1 else if a.len > b.len then 1 else 0
}

fn stdstr_ws(cp: int) -> bool {
    cp >= 9 && cp <= 13 ||
        cp == 32 ||
        cp == 133 ||
        cp == 8232 ||
        cp == 8233 ||
        unicode.cat_rec(cp) & unicode.CAT_ZS != 0
}

/// One shared implementation for str.split_lines and io.read_lines.
/// Split on LF, drop exactly one final CR per line, keep final empty line.
pub fn fl_split_lines(mut vm: FlVm, bytes: List[byte]) -> FlValue {
    let list = fl_list_new(mut vm)
    let root = fl_temp_push(mut vm, list)
    var at = 0
    while at <= bytes.len {
        var nl = at
        while nl < bytes.len && bytes[nl] != 10 as byte { nl += 1 }
        var end = nl
        if end > at && bytes[end - 1] == 13 as byte { end -= 1 }
        var piece = List[byte]()
        stdstr_append(mut piece, bytes, at, end)
        let value = fl_str_new(mut vm, piece)
        fl_list_push(mut vm, list, value)
        if nl >= bytes.len { break }
        at = nl + 1
    }
    let result = fl_temp_get(vm, root)
    fl_temp_pop(mut vm, 1)
    result
}

fn stdstr_list_input(mut vm: FlVm, kind: int, base: int) -> FlValue {
    let list = fl_arg_list(mut vm, base, 0) else { return fl_nil() }
    var sep = fl_nil()
    if kind == 19 { sep = fl_arg_str(mut vm, base, 1) else { return fl_nil() } }
    var out = List[byte]()
    let len = fl_list_len(vm, list)
    for i in 0..len {
        let value = fl_list_get(vm, list, i) else fl_nil()
        if kind == 26 {
            if value.t != FL_INT || value.i < 0 || value.i > 255 {
                return fl_raise(mut vm, "index", "str.from_bytes: item {i} is not a byte")
            }
            (mut out).push(value.i as byte)
        } else {
            if value.t != FL_STR {
                let word = fl_type_name(value.t)
                return fl_raise(mut vm, "type", "str.join: item {i} must be str, found {word}")
            }
            if i != 0 {
                let at = fl_obj_index(vm, sep)
                util.buf_append(mut out, vm.gc.slots[at].bytes)
            }
            let at = fl_obj_index(vm, value)
            util.buf_append(mut out, vm.gc.slots[at].bytes)
            if stdstr_big(mut vm, out.len, "str.join") { return fl_nil() }
        }
    }
    fl_str_new(mut vm, out)
}

fn stdstr_split(mut vm: FlVm, base: int, argc: int, value: FlValue) -> FlValue {
    let sep = fl_arg_str(mut vm, base, 1) else { return fl_nil() }
    var limit = 0
    if argc >= 3 { limit = fl_arg_int(mut vm, base, 2) else { return fl_nil() } }
    if limit < 0 { return fl_raise(mut vm, "limit", "str.split: limit must not be negative") }
    let s = fl_obj_index(vm, value)
    let d = fl_obj_index(vm, sep)
    let len = vm.gc.slots[s].bytes.len
    let sep_len = vm.gc.slots[d].bytes.len
    let list = fl_list_new(mut vm)
    let root = fl_temp_push(mut vm, list)
    var at = 0
    if sep_len == 0 {
        while at < len {
            let end = if limit > 0 && fl_list_len(vm, list) == limit - 1 {
                len
            } else {
                unicode.gb_next_bytes(vm.gc.slots[s].bytes, len, at)
            }
            let v = stdstr_slice(mut vm, value, at, end)
            fl_list_push(mut vm, list, v)
            at = end
        }
    } else {
        loop {
            if limit > 0 && fl_list_len(vm, list) == limit - 1 { break }
            let hit = stdstr_find(vm.gc.slots[s].bytes, vm.gc.slots[d].bytes, at)
            if hit < 0 { break }
            let v = stdstr_slice(mut vm, value, at, hit)
            fl_list_push(mut vm, list, v)
            at = hit + sep_len
        }
        let v = stdstr_slice(mut vm, value, at, len)
        fl_list_push(mut vm, list, v)
    }
    let result = fl_temp_get(vm, root)
    fl_temp_pop(mut vm, 1)
    result
}

/// Dispatch a LOCAL string-table index; ids are 1000+kind.
pub fn fl_std_str_dispatch(mut vm: FlVm, kind: int, base: int, argc: int) -> FlValue {
    assert(kind >= 0 && kind < 30)
    if kind == 19 || kind == 26 { return stdstr_list_input(mut vm, kind, base) }
    let value = fl_arg_str(mut vm, base, 0) else { return fl_nil() }
    let s = fl_obj_index(vm, value)
    let len = vm.gc.slots[s].bytes.len
    if kind == 0 { return fl_int(unicode.gb_count_bytes(vm.gc.slots[s].bytes, len)) }
    if kind == 1 { return fl_int(len) }
    if kind == 2 { return fl_bool(len == 0) }
    if kind >= 3 && kind <= 5 {
        let low = fl_arg_int(mut vm, base, 1) else { return fl_nil() }
        let count = if kind == 5 then len else unicode.gb_count_bytes(vm.gc.slots[s].bytes, len)
        var high = count
        if kind != 3 && argc >= 3 { high = fl_arg_int(mut vm, base, 2) else { return fl_nil() } }
        var lo = 0
        var hi = 0
        if kind == 5 {
            lo = stdstr_byteoff(mut vm, value, low, "str.slice_bytes") else { return fl_nil() }
            hi = stdstr_byteoff(mut vm, value, high, "str.slice_bytes") else { return fl_nil() }
        } else {
            let who = if kind == 3 then "str.at" else "str.slice"
            lo = stdstr_cluster(vm.gc.slots[s].bytes, low, count) else {
                return fl_raise(mut vm, "index", "{who}: index {low} out of range")
            }
            if kind == 3 {
                if lo == len {
                    return fl_raise(mut vm, "index", "str.at: index {low} out of range")
                }
                hi = unicode.gb_next_bytes(vm.gc.slots[s].bytes, len, lo)
            } else {
                hi = stdstr_cluster(vm.gc.slots[s].bytes, high, count) else {
                    return fl_raise(mut vm, "index", "str.slice: index {high} out of range")
                }
            }
        }
        return stdstr_slice(mut vm, value, lo, if hi < lo then lo else hi)
    }
    if kind >= 6 && kind <= 11 || kind == 29 {
        let needle = fl_arg_str(mut vm, base, 1) else { return fl_nil() }
        let d = fl_obj_index(vm, needle)
        let ndlen = vm.gc.slots[d].bytes.len
        if kind == 10 || kind == 11 {
            return fl_bool(
                stdstr_match(
                    vm.gc.slots[s].bytes,
                    if kind == 10 then 0 else len - ndlen,
                    vm.gc.slots[d].bytes,
                ),
            )
        }
        if kind == 29 { return fl_int(stdstr_cmp(vm.gc.slots[s].bytes, vm.gc.slots[d].bytes)) }
        var from = 0
        if (kind == 6 || kind == 7) && argc >= 3 {
            from = fl_arg_int(mut vm, base, 2) else { return fl_nil() }
        }
        var start = 0
        if kind == 6 {
            let count = unicode.gb_count_bytes(vm.gc.slots[s].bytes, len)
            start = stdstr_cluster(vm.gc.slots[s].bytes, from, count) else {
                return fl_raise(mut vm, "index", "str.find: index {from} out of range")
            }
        }
        if kind == 7 {
            start = stdstr_byteoff(mut vm, value, from, "str.find_bytes") else { return fl_nil() }
        }
        var hit = stdstr_find(vm.gc.slots[s].bytes, vm.gc.slots[d].bytes, start)
        if kind == 8 {
            var next = hit
            while next >= 0 && next < len {
                next = stdstr_find(vm.gc.slots[s].bytes, vm.gc.slots[d].bytes, next + 1)
                if next >= 0 { hit = next }
            }
        }
        if kind == 9 { return fl_bool(hit >= 0) }
        if kind == 7 || hit < 0 { return fl_int(hit) }
        var off = 0
        var ci = 0
        while off < hit { off = unicode.gb_next_bytes(vm.gc.slots[s].bytes, len, off); ci += 1 }
        return fl_int(ci)
    }
    if kind == 12 || kind == 13 {
        var out = List[byte]()
        var at = 0
        while at < len {
            let (cp, adv) = unicode.utf8_decode(vm.gc.slots[s].bytes, at, len)
            let _ = unicode.case_map_utf8(
                cp,
                if kind == 12 then unicode.CASE_UPPER else unicode.CASE_LOWER,
                mut out,
            )
            at += if adv == 0 then 1 else adv
        }
        return fl_str_new(mut vm, out)
    }
    if kind >= 14 && kind <= 16 {
        var lo = 0
        var hi = len
        if kind != 16 {
            while lo < hi {
                let (cp, adv) = unicode.utf8_decode(vm.gc.slots[s].bytes, lo, hi)
                if adv == 0 || !stdstr_ws(cp) { break }
                lo += adv
            }
        }
        if kind != 15 {
            while hi > lo {
                let prev = unicode.gb_prev_bytes(vm.gc.slots[s].bytes, len, hi)
                if prev >= hi { break }
                let (cp, _) = unicode.utf8_decode(vm.gc.slots[s].bytes, prev, hi)
                if !stdstr_ws(cp) { break }
                hi = prev
            }
        }
        return stdstr_slice(mut vm, value, lo, hi)
    }
    if kind == 17 { return stdstr_split(mut vm, base, argc, value) }
    if kind == 18 {
        // Own the argument snapshot before mutating the VM's slot vector.
        let bytes = copy vm.gc.slots[s].bytes
        return fl_split_lines(mut vm, bytes)
    }
    if kind == 20 {
        let from = fl_arg_str(mut vm, base, 1) else { return fl_nil() }
        let to = fl_arg_str(mut vm, base, 2) else { return fl_nil() }
        var limit = 0
        if argc >= 4 { limit = fl_arg_int(mut vm, base, 3) else { return fl_nil() } }
        let f = fl_obj_index(vm, from)
        let t = fl_obj_index(vm, to)
        if vm.gc.slots[f].bytes.len == 0 { return value }
        var out = List[byte]()
        var at = 0
        var done = 0
        while at < len {
            let hit = if limit > 0 && done >= limit {
                -1
            } else {
                stdstr_find(vm.gc.slots[s].bytes, vm.gc.slots[f].bytes, at)
            }
            if hit < 0 { break }
            stdstr_append(mut out, vm.gc.slots[s].bytes, at, hit)
            util.buf_append(mut out, vm.gc.slots[t].bytes)
            at = hit + vm.gc.slots[f].bytes.len
            done += 1
            if stdstr_big(mut vm, out.len, "str.replace") { return fl_nil() }
        }
        stdstr_append(mut out, vm.gc.slots[s].bytes, at, len)
        return fl_str_new(mut vm, out)
    }
    if kind == 21 {
        let times = fl_arg_int(mut vm, base, 1) else { return fl_nil() }
        if times < 0 { return fl_raise(mut vm, "type", "str.repeat: n must not be negative") }
        if len > 0 && times > STDSTR_MAX / len {
            return fl_raise(mut vm, "limit", "str.repeat: result exceeds 64 MiB")
        }
        var out = List[byte]()
        if len > 0 { for _ in 0..times { util.buf_append(mut out, vm.gc.slots[s].bytes) } }
        return fl_str_new(mut vm, out)
    }
    if kind == 22 || kind == 23 {
        let want = fl_arg_int(mut vm, base, 1) else { return fl_nil() }
        var fill = fl_nil()
        if argc >= 3 { fill = fl_arg_str(mut vm, base, 2) else { return fl_nil() } }
        let have = unicode.str_width(vm.gc.slots[s].bytes, 0, len, 8)
        var width = 1
        if argc >= 3 {
            let f = fl_obj_index(vm, fill)
            width = unicode.str_width(vm.gc.slots[f].bytes, 0, vm.gc.slots[f].bytes.len, 8)
        }
        if width <= 0 || want <= have { return value }
        if stdstr_big(mut vm, want, "str.pad") { return fl_nil() }
        var out = List[byte]()
        if kind == 23 { util.buf_append(mut out, vm.gc.slots[s].bytes) }
        for _ in 0..(want - have) / width {
            if argc < 3 {
                (mut out).push(32 as byte)
            } else {
                let f = fl_obj_index(vm, fill)
                util.buf_append(mut out, vm.gc.slots[f].bytes)
            }
        }
        if kind == 22 { util.buf_append(mut out, vm.gc.slots[s].bytes) }
        return fl_str_new(mut vm, out)
    }
    if kind == 24 {
        var tabw = 8
        if argc >= 2 { tabw = fl_arg_int(mut vm, base, 1) else { return fl_nil() } }
        if tabw < 0 || tabw > 256 {
            return fl_raise(mut vm, "type", "str.width: tabw out of range")
        }
        return fl_int(unicode.str_width(vm.gc.slots[s].bytes, 0, len, tabw))
    }
    if kind == 25 {
        if stdstr_big(mut vm, len, "str.bytes") { return fl_nil() }
        let list = fl_list_new(mut vm)
        let root = fl_temp_push(mut vm, list)
        for i in 0..len {
            let v = fl_int(vm.gc.slots[s].bytes[i] as int)
            fl_list_push(mut vm, list, v)
        }
        let result = fl_temp_get(vm, root)
        fl_temp_pop(mut vm, 1)
        return result
    }
    if kind == 27 {
        var radix = 10
        if argc >= 2 { radix = fl_arg_int(mut vm, base, 1) else { return fl_nil() } }
        if radix < 2 || radix > 36 {
            return fl_raise(mut vm, "type", "str.to_int: base must be 2..36")
        }
        var i = 0
        while i < len &&
            (vm.gc.slots[s].bytes[i] == 32 as byte || vm.gc.slots[s].bytes[i] == 9 as byte) {
            i += 1
        }
        var neg = false
        if i < len &&
            (vm.gc.slots[s].bytes[i] == 43 as byte || vm.gc.slots[s].bytes[i] == 45 as byte) {
            neg = vm.gc.slots[s].bytes[i] == 45 as byte
            i += 1
        }
        var acc: wrapping[u64] = 0
        var any = false
        while i < len {
            let c = vm.gc.slots[s].bytes[i] as int
            let digit = if c >= 48 && c <= 57 {
                c - 48
            } else if c >= 97 && c <= 122 {
                c - 87
            } else if c >= 65 && c <= 90 {
                c - 55
            } else {
                -1
            }
            if digit < 0 || digit >= radix { break }
            acc = acc * radix as wrapping[u64] + digit as wrapping[u64]
            any = true
            i += 1
        }
        if !any || i != len { return fl_nil() }
        if neg { acc = 0 - acc }
        let low = (acc & 9223372036854775807) as int
        return fl_int(if acc >> 63 != 0 then -9223372036854775807 - 1 + low else low)
    }
    // strtod's end pointer checks NUL, not the interner's byte length.
    if len == 0 || len >= 64 { return fl_nil() }
    var end = 0
    while end < len && vm.gc.slots[s].bytes[end] != 0 as byte { end += 1 }
    let text = str_from_utf8(vm.gc.slots[s].bytes[0..end]) else { return fl_nil() }
    let (number, consumed) = float_scan(text)
    if consumed != end { return fl_nil() }
    fl_float(number)
}

/// Pinned STR_DEFS order, signatures and arities (stdstr.c:938-970).
pub fn fl_str_defs() -> List[FlNativeDef] {
    [
        fl_native_def("len", 1000, 1, 1, 0, "(s) -> int"),
        fl_native_def("len_bytes", 1001, 1, 1, 0, "(s) -> int"),
        fl_native_def("is_empty", 1002, 1, 1, 0, "(s) -> bool"),
        fl_native_def("at", 1003, 2, 2, 0, "(s, i) -> s"),
        fl_native_def("slice", 1004, 2, 3, 0, "(s, lo, [hi]) -> s"),
        fl_native_def("slice_bytes", 1005, 2, 3, 0, "(s, lo, [hi]) -> s"),
        fl_native_def("find", 1006, 2, 3, 0, "(s, needle, [from]) -> int"),
        fl_native_def("find_bytes", 1007, 2, 3, 0, "(s, needle, [from]) -> int"),
        fl_native_def("rfind", 1008, 2, 2, 0, "(s, needle) -> int"),
        fl_native_def("contains", 1009, 2, 2, 0, "(s, needle) -> bool"),
        fl_native_def("starts_with", 1010, 2, 2, 0, "(s, p) -> bool"),
        fl_native_def("ends_with", 1011, 2, 2, 0, "(s, p) -> bool"),
        fl_native_def("upper", 1012, 1, 1, 0, "(s) -> s"),
        fl_native_def("lower", 1013, 1, 1, 0, "(s) -> s"),
        fl_native_def("trim", 1014, 1, 1, 0, "(s) -> s"),
        fl_native_def("trim_start", 1015, 1, 1, 0, "(s) -> s"),
        fl_native_def("trim_end", 1016, 1, 1, 0, "(s) -> s"),
        fl_native_def("split", 1017, 2, 3, 0, "(s, sep, [limit]) -> list"),
        fl_native_def("split_lines", 1018, 1, 1, 0, "(s) -> list"),
        fl_native_def("join", 1019, 2, 2, 0, "(list, sep) -> s"),
        fl_native_def("replace", 1020, 3, 4, 0, "(s, from, to, [limit]) -> s"),
        fl_native_def("repeat", 1021, 2, 2, 0, "(s, n) -> s"),
        fl_native_def("pad_start", 1022, 2, 3, 0, "(s, w, [fill]) -> s"),
        fl_native_def("pad_end", 1023, 2, 3, 0, "(s, w, [fill]) -> s"),
        fl_native_def("width", 1024, 1, 2, 0, "(s, [tabw]) -> int"),
        fl_native_def("bytes", 1025, 1, 1, 0, "(s) -> list"),
        fl_native_def("from_bytes", 1026, 1, 1, 0, "(list) -> s"),
        fl_native_def("to_int", 1027, 1, 2, 0, "(s, [base]) -> int|nil"),
        fl_native_def("to_float", 1028, 1, 1, 0, "(s) -> float|nil"),
        fl_native_def("cmp", 1029, 2, 2, 0, "(a, b) -> int"),
    ]
}
