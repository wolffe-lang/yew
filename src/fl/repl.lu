//! fl.repl — the prompt's silent whole-entry classifier.
//! Ports sagitta 9ace98c2 src/fl/repl.h:47-75 and repl.c:88-126.
//! Trial diagnostics have their own context: never grow the caller's
//! source table or print an incomplete entry's provisional diagnostics.

/// Complete, clean input: compile and execute the entry.
pub const FL_REPL_RUN: int = 0

/// Open syntax without an error: retain the accumulated source.
pub const FL_REPL_CONTINUE: int = 1

/// A real syntax error: re-parse with the visible diagnostic sink.
pub const FL_REPL_ERROR: int = 2

/// Classify the entire accumulated entry, not merely its newest line.
/// A real error takes precedence over continuation. The caller re-parses
/// an error with its visible sink; this trial always remains silent.
pub fn fl_repl_classify(mut strings: FlStrings, src: List[byte]) -> int {
    var dc = fl_diag_init()
    let file_id = fl_diag_add_file(mut dc, "<repl>", src)
    let p = fl_parse(src, file_id, mut dc, mut strings)
    if p.had_error || dc.nerrors != 0 { return FL_REPL_ERROR }
    if p.incomplete { return FL_REPL_CONTINUE }
    FL_REPL_RUN
}
