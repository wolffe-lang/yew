//! Temporary integration boundary agreed with yw07b; removed when its std,
//! module and trace implementations land. No pending path is accepted.

fn fl_native_dispatch(mut vm: FlVm, kind: int, base: int, argc: int) -> FlValue {
    let _ = base
    fl_raise(mut vm, "type", "not yet ported: sagitta Sprint 31 native {kind}/{argc} (yw07b std)")
}

fn fl_import(mut vm: FlVm, name_id: int, is_path: bool) -> FlValue {
    let _ = is_path
    fl_raise(mut vm, "import", "not yet ported: sagitta Sprint 31 import {name_id} (yw07b module)")
}

fn fl_trace_attach(mut vm: FlVm) {
    vm.err_caret = "not yet ported: sagitta Sprint 32 escaping trace (yw07b trace)"
    eprint("yew: error: not yet ported: sagitta Sprint 32 escaping trace (yw07b trace)")
}
