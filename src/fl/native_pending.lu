//! Temporary integration boundary of yw07b: the pinned registration rows of
//! families whose implementations have not landed, each raising by name.
//! A family's rows and dispatcher are deleted here in the commit that lands
//! its implementation; nothing pending is accepted at the final head.
//! Rows: sagitta 9ace98c2 stdfmt.c:1264-1272,
//! stdio.c:986-1003, stdre.c:673-686, flapi.c:2085-2136, stdai.c:28-30.

fn fl_pending(mut vm: FlVm, sprint: str) -> FlValue {
    let name = fl_std_name(vm)
    fl_raise(mut vm, "name", "not yet ported: sagitta {sprint} {name} (yw07b)")
}

/// Pinned FMT_DEFS rows (stdfmt.c:1264-1272).
pub fn fl_fmt_defs() -> List[FlNativeDef] {
    [
        fl_native_def("f", 5000, 1, 255, 0, "(template, ...) -> str"),
        fl_native_def("str", 5001, 1, 1, 0, "(v) -> str"),
        fl_native_def("repr", 5002, 1, 2, 0, "(v, [indent]) -> str"),
        fl_native_def("int", 5003, 1, 3, 0, "(i, [base], [width]) -> str"),
        fl_native_def("float", 5004, 1, 2, 0, "(f, [prec]) -> str"),
        fl_native_def("hex", 5005, 1, 2, 0, "(i, [width]) -> str"),
        fl_native_def("pad", 5006, 2, 4, 0, "(s, width, [align], [fill]) -> str"),
    ]
}

/// Pending until the fmt family lands.
pub fn fl_std_fmt_dispatch(mut vm: FlVm, kind: int, base: int, argc: int) -> FlValue {
    let _ = kind + base + argc
    fl_pending(mut vm, "Sprint 31")
}

/// Pinned IO_DEFS rows (stdio.c:986-1003); caps 1 = fs.read, 2 = fs.write.
pub fn fl_io_defs() -> List[FlNativeDef] {
    [
        fl_native_def("stdin", 6000, 0, 0, 0, "() -> str"),
        fl_native_def("read", 6001, 1, 1, 1, "(path) -> str"),
        fl_native_def("read_lines", 6002, 1, 1, 1, "(path) -> list"),
        fl_native_def("write", 6003, 2, 2, 2, "(path, s) -> nil"),
        fl_native_def("append", 6004, 2, 2, 2, "(path, s) -> nil"),
        fl_native_def("exists", 6005, 1, 1, 1, "(path) -> bool"),
        fl_native_def("is_dir", 6006, 1, 1, 1, "(path) -> bool"),
        fl_native_def("size", 6007, 1, 1, 1, "(path) -> int"),
        fl_native_def("remove", 6008, 1, 1, 2, "(path) -> nil"),
        fl_native_def("mkdir", 6009, 1, 2, 2, "(path, [parents]) -> nil"),
        fl_native_def("glob", 6010, 1, 2, 1, "(pattern, [root]) -> list"),
        fl_native_def("env", 6011, 1, 1, 1, "(name) -> str|nil"),
        fl_native_def("print", 6012, 0, 255, 0, "(...) -> nil"),
        fl_native_def("eprint", 6013, 0, 255, 0, "(...) -> nil"),
    ]
}

/// Pending until the io family lands.
pub fn fl_std_io_dispatch(mut vm: FlVm, kind: int, base: int, argc: int) -> FlValue {
    let _ = kind + base + argc
    fl_pending(mut vm, "Sprint 31")
}

