//! fl.host — sagitta 9ace98c2 src/fl/vm.h's FlHost, vm.c:1397-1439,
//! 1539-1552 and 1600-1777; plus the editor-native entry in flapi.c.
//!
//! R-yw09-4 recommendation A: a statically selected host parameter keeps
//! fl below edit without mutable function values (G48, wolf-lang#917).
//! Host methods bridge modules, not command registries: each editor host
//! still uses the single kind-id/match dispatcher required by R-yw07-10.
//! There is one VM body, including every native callback and import.

/// The host services a VM may reach. False on a hook leaves vm.raised set;
/// edit_end(false) rolls back while retaining the in-flight error value.
/// A host must root any FlValue it retains through the VM's host-root API.
pub trait FlHost {
    fn api(mut self, mut vm: FlVm, kind: int, base: int, argc: int) -> FlValue
    fn motion(mut self, mut vm: FlVm, program: FlValue) -> bool
    fn edit_begin(mut self, mut vm: FlVm) -> bool
    fn edit_end(mut self, mut vm: FlVm, commit: bool) -> bool
    fn run_begin(mut self, mut vm: FlVm) -> bool
    fn run_end(mut self, mut vm: FlVm, commit: bool) -> bool
    fn run_active(self) -> bool
}

/// Standalone Fletch has no editor: edit blocks are plain blocks and
/// motion/editor natives keep C's precise null-host diagnostics.
pub struct FlNullHost { reserved: int }

/// Construct the null host without allocating editor state.
pub fn fl_null_host() -> FlNullHost { FlNullHost { reserved: 0 } }

impl FlHost for FlNullHost {
    // The trait's modes belong to real hosts; the null host intentionally
    // neither edits nor owns state. Do not manufacture writes to hide that.
    #[allow(w1002)]
    fn api(mut self, mut vm: FlVm, kind: int, base: int, argc: int) -> FlValue {
        let _ = self.reserved
        if kind < 1000 { return fl_prelude_dispatch(mut vm, kind, base, argc) }
        fl_std_api_dispatch(mut vm, kind, base, argc)
    }
    #[allow(w1002)]
    fn motion(mut self, mut vm: FlVm, program: FlValue) -> bool {
        let _ = self.reserved
        let _ = program
        let _ = fl_raise(mut vm, "motion", "no editor host")
        false
    }
    #[allow(w1002)]
    fn edit_begin(mut self, mut vm: FlVm) -> bool {
        let _ = self.reserved
        let _ = vm.sp
        true
    }
    #[allow(w1002)]
    fn edit_end(mut self, mut vm: FlVm, commit: bool) -> bool {
        let _ = self.reserved
        let _ = vm.sp
        let _ = commit
        true
    }
    #[allow(w1002)]
    fn run_begin(mut self, mut vm: FlVm) -> bool {
        let _ = self.reserved
        let _ = vm.sp
        true
    }
    #[allow(w1002)]
    fn run_end(mut self, mut vm: FlVm, commit: bool) -> bool {
        let _ = self.reserved
        let _ = vm.sp
        let _ = commit
        true
    }
    fn run_active(self) -> bool { let _ = self.reserved; false }
}
