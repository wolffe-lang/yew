//! fl.std — sagitta9ace98c2 src/fl/std.h:29-51, std.c:317-390.
//! One kind-id representation for mutable natives (R10/G48), never fn values.
//! Argument wording lives here; CALL owns arity validation, not each native.

/// Native registration row, in the pinned module's declaration order.
pub struct FlNativeDef {
    name: str,
    kind: int,
    min_ar: int,
    max_ar: int,
    caps: int,
    sig: str,
}

/// Construct one immutable native registration row.
pub fn fl_native_def(
    name: str,
    kind: int,
    min_ar: int,
    max_ar: int,
    caps: int,
    sig: str,
) -> FlNativeDef {
    FlNativeDef { name: name, kind: kind, min_ar: min_ar, max_ar: max_ar, caps: caps, sig: sig }
}

/// Qualified native name used in argument diagnostics, or ? when absent.
pub fn fl_std_name(vm: FlVm) -> str {
    if vm.cur_native <= 0 || vm.cur_native >= vm.strings.items.len { return "?" }
    str_from_utf8(vm.strings.items[vm.cur_native]) else "?"
}

/// Set the current native name around a CALL, restoring the former id after.
pub fn fl_std_set_current(mut vm: FlVm, name_id: int) { vm.cur_native = name_id }

fn fl_arg_type_error(mut vm: FlVm, i: int, want: str, got: FlValue) {
    let name = fl_std_name(vm)
    let actual = fl_type_name(got.t)
    let _ = fl_raise(mut vm, "type", "{name}: argument {i + 1} must be {want}, found {actual}")
}

fn fl_arg_exact(mut vm: FlVm, base: int, i: int, tag: int, want: str) -> FlValue ! {arg} {
    let v = copy vm.stack[base + i]
    if v.t != tag { fl_arg_type_error(mut vm, i, want, v); return arg }
    v
}

/// String argument rooted in the VM stack; arg sets the exact type error.
pub fn fl_arg_str(mut vm: FlVm, base: int, i: int) -> FlValue ! {arg} {
    fl_arg_exact(mut vm, base, i, 4, "str")?
}

/// Integer only, never a truncating float index; arg sets the type error.
pub fn fl_arg_int(mut vm: FlVm, base: int, i: int) -> int ! {arg} {
    let v = fl_arg_exact(mut vm, base, i, 2, "int")?
    v.i
}

/// Integer promoted to float or a float as-is; arg sets the type error.
pub fn fl_arg_num(mut vm: FlVm, base: int, i: int) -> f64 ! {arg} {
    let v = copy vm.stack[base + i]
    if v.t == 2 { return v.i as f64 }
    if v.t == 3 { return v.f }
    fl_arg_type_error(mut vm, i, "number", v)
    arg
}

/// List argument; arg sets the type error.
pub fn fl_arg_list(mut vm: FlVm, base: int, i: int) -> FlValue ! {arg} {
    fl_arg_exact(mut vm, base, i, 5, "list")?
}

/// Map argument; arg sets the type error.
pub fn fl_arg_map(mut vm: FlVm, base: int, i: int) -> FlValue ! {arg} {
    fl_arg_exact(mut vm, base, i, 6, "map")?
}

/// Closure or native only, as pinned std.c:383-390; arg sets type error.
pub fn fl_arg_fn(mut vm: FlVm, base: int, i: int) -> FlValue ! {arg} {
    let v = copy vm.stack[base + i]
    if v.t == 8 || v.t == 9 { return v }
    fl_arg_type_error(mut vm, i, "fn", v)
    arg
}
