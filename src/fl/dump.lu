//! fl.dump — deterministic AST s-expressions, including arbitrary bytes.
//! Ports sagitta 9ace98c2 src/fl/dump.c:18-331.
//! An explicit action stack preserves C's traversal without input-sized
//! recursion (long left-associative and unary chains can be very deep).

use util

struct DumpAction { kind: int, id: int, text: str }

fn dump_text(mut work: List[DumpAction], text: str) { (mut work).push(DumpAction { kind: 0, id: 0, text: copy text }) }

fn dump_child(mut work: List[DumpAction], id: int) { (mut work).push(DumpAction { kind: 1, id: id, text: "" }) }

fn dump_string_action(mut work: List[DumpAction], id: int) { (mut work).push(DumpAction { kind: 2, id: id, text: "" }) }

fn dump_opt(mut work: List[DumpAction], id: int) {
    dump_child(mut work, id)
    dump_text(mut work, " ")
}

fn dump_kids(mut work: List[DumpAction], p: FlProgram, offset: int, count: int) {
    var i = count
    while i > 0 { i -= 1; dump_opt(mut work, p.edges[offset + i]) }
}

fn dump_str(mut out: List[byte], strings: FlStrings, id: int) {
    (mut out).push(34 as byte)
    if id > 0 && id < strings.items.len {
        for byte_value in strings.items[id] {
            let c = byte_value as int
            if c == 34 {
                util.buf_append_str(mut out, "\\\"")
            } else if c == 92 {
                util.buf_append_str(mut out, "\\\\")
            } else if c == 10 {
                util.buf_append_str(mut out, "\\n")
            } else if c == 9 {
                util.buf_append_str(mut out, "\\t")
            } else if c == 13 {
                util.buf_append_str(mut out, "\\r")
            } else if c < 32 {
                util.buf_append_str(mut out, "\\x")
                (mut out).push("0123456789ABCDEF".bytes()[c / 16])
                (mut out).push("0123456789ABCDEF".bytes()[c % 16])
            } else {
                (mut out).push(byte_value)
            }
        }
    }
    (mut out).push(34 as byte)
}

fn dump_motion_word(kind: int) -> str {
    match kind {
        0 => "unit",
        1 => "arrow",
        2 => "highlight",
        3 => "ins",
        4 => "del",
        5 => "esc",
        _ => "word",
    }
}

/// Dump a node by index; -1 is the absent child, printed as bare nil.
pub fn fl_ast_dump_node(mut out: List[byte], p: FlProgram, id: int, strings: FlStrings) {
    var work = List[DumpAction]()
    dump_child(mut work, id)
    while work.len > 0 {
        let action = (mut work).pop() else break
        if action.kind == 0 { util.buf_append_str(mut out, action.text); continue }
        if action.kind == 2 { dump_str(mut out, strings, action.id); continue }
        if action.id < 0 { util.buf_append_str(mut out, "nil"); continue }
        let n = copy p.nodes[action.id]
        if n.kind == FL_A_EXPR_STMT { dump_child(mut work, n.a); continue }
        dump_text(mut work, ")")
        if n.kind == FL_A_LET || n.kind == FL_A_MACRO {
            util.buf_append_str(mut out, if n.kind == FL_A_LET then "(let " else "(macro ")
            dump_str(mut out, strings, n.a)
            dump_opt(mut work, n.b)
        } else if n.kind == FL_A_ASSIGN {
            util.buf_append_str(mut out, "(assign")
            dump_opt(mut work, n.b)
            dump_opt(mut work, n.a)
        } else if n.kind == FL_A_FN || n.kind == FL_A_FN_EXPR {
            util.buf_append_str(mut out, if n.kind == FL_A_FN then "(fn " else "(fn-expr ")
            if n.kind == FL_A_FN {
                dump_str(mut out, strings, n.a)
                util.buf_append_str(mut out, " ")
            }
            util.buf_append_str(mut out, "(params")
            var i = 0
            while i < n.c {
                util.buf_append_str(mut out, " ")
                dump_str(mut out, strings, p.edges[n.b + i])
                i += 1
            }
            util.buf_append_str(mut out, ")")
            dump_opt(mut work, n.d)
        } else if n.kind == FL_A_IMPORT {
            util.buf_append_str(mut out, "(import ")
            if n.flags != 0 {
                dump_str(mut out, strings, n.a)
                util.buf_append_str(mut out, " as ")
            }
            dump_str(mut out, strings, n.b)
        } else if n.kind == FL_A_IF {
            util.buf_append_str(mut out, "(if")
            dump_opt(mut work, n.c)
            dump_opt(mut work, n.b)
            dump_opt(mut work, n.a)
        } else if n.kind == FL_A_WHILE {
            util.buf_append_str(mut out, "(while")
            dump_opt(mut work, n.b)
            dump_opt(mut work, n.a)
        } else if n.kind == FL_A_FOR {
            util.buf_append_str(mut out, "(for ")
            dump_str(mut out, strings, n.a)
            if n.b != 0 { util.buf_append_str(mut out, " "); dump_str(mut out, strings, n.b) }
            dump_opt(mut work, n.d)
            dump_opt(mut work, n.c)
        } else if n.kind == FL_A_RETURN || n.kind == FL_A_EDIT {
            util.buf_append_str(mut out, if n.kind == FL_A_RETURN then "(return" else "(edit")
            dump_opt(mut work, n.a)
        } else if n.kind == FL_A_BREAK || n.kind == FL_A_CONTINUE {
            util.buf_append_str(mut out, if n.kind == FL_A_BREAK then "(break" else "(continue")
        } else if n.kind == FL_A_TRY {
            util.buf_append_str(mut out, "(try")
            dump_opt(mut work, n.b)
            dump_string_action(mut work, n.c)
            dump_text(mut work, " catch ")
            dump_opt(mut work, n.a)
        } else if n.kind == FL_A_BLOCK || n.kind == FL_A_LIST || n.kind == FL_A_MOTION_BLOCK {
            util.buf_append_str(
                mut out,
                if n.kind == FL_A_BLOCK {
                    "(block"
                } else if n.kind == FL_A_LIST {
                    "(list"
                } else {
                    "(motion-block"
                },
            )
            dump_kids(mut work, p, n.a, n.b)
        } else if n.kind == FL_A_BINOP || n.kind == FL_A_UNOP {
            let op = fl_tok_spelling(n.a)
            util.buf_append_str(mut out, if n.kind == FL_A_UNOP then "(u{op}" else "({op}")
            if n.kind == FL_A_BINOP { dump_opt(mut work, n.c) }
            dump_opt(mut work, n.b)
        } else if n.kind == FL_A_CALL {
            util.buf_append_str(mut out, "(call")
            dump_kids(mut work, p, n.b, n.c)
            dump_opt(mut work, n.a)
        } else if n.kind == FL_A_INDEX {
            util.buf_append_str(mut out, "(index")
            dump_opt(mut work, n.b)
            dump_opt(mut work, n.a)
        } else if n.kind == FL_A_FIELD {
            util.buf_append_str(mut out, "(field")
            dump_string_action(mut work, n.b)
            dump_text(mut work, " ")
            dump_opt(mut work, n.a)
        } else if n.kind == FL_A_IDENT {
            util.buf_append_str(mut out, "(id ")
            dump_str(mut out, strings, n.a)
        } else if n.kind == FL_A_LIT {
            if n.a == FL_L_NIL {
                util.buf_append_str(mut out, "(lit nil")
            } else if n.a == FL_L_BOOL {
                util.buf_append_str(
                    mut out,
                    if n.i != 0 then "(lit bool true" else "(lit bool false",
                )
            } else if n.a == FL_L_INT {
                util.buf_append_str(mut out, "(lit int {n.i}")
            } else if n.a == FL_L_FLOAT {
                let value = float_general(n.f, 17)
                util.buf_append_str(mut out, "(lit float {value}")
            } else {
                util.buf_append_str(mut out, "(lit str ")
                dump_str(mut out, strings, n.i)
            }
        } else if n.kind == FL_A_MAP {
            util.buf_append_str(mut out, "(map")
            var i = n.c
            while i > 0 {
                i -= 1
                dump_text(mut work, ")")
                dump_opt(mut work, p.edges[n.b + i])
                dump_child(mut work, p.edges[n.a + i])
                dump_text(mut work, " (")
            }
        } else if n.kind == FL_A_MOTION {
            let word = dump_motion_word(n.a)
            util.buf_append_str(mut out, "(motion {n.i} {word}")
            if n.a == FL_MK_UNIT || n.a == FL_MK_ARROW {
                (mut out).push(32 as byte)
                (mut out).push(n.b as byte)
                if n.a == FL_MK_ARROW && n.flags & 1 != 0 { util.buf_append_str(mut out, " alt") }
            } else if n.a == FL_MK_INSERT || n.a == FL_MK_WORD {
                (mut out).push(32 as byte)
                dump_str(mut out, strings, n.c)
            } else if n.a == FL_MK_HIGHLIGHT {
                dump_kids(mut work, p, n.d, n.e)
            }
        } else {
            util.buf_append_str(mut out, "(?")
        }
    }
}

/// One statement per line, exactly as the pinned C dump.
pub fn fl_ast_dump(mut out: List[byte], p: FlProgram, strings: FlStrings) {
    for id in p.stmts { fl_ast_dump_node(mut out, p, id, strings); (mut out).push(10 as byte) }
}
