//! fl.handle — the scalar slot half of sagitta 9ace98c2
//! src/fl/handle.c:25-203 and handle.h:76-121 (Sprint 34).
//!
//! A handle's signed integer payload preserves all 64 bits: low 32 slot,
//! high 32 generation. Generation zero is never allocated; freeing the
//! maximum generation retires that slot permanently. Kind AND generation
//! must match before a payload is read.
//!
//! The editor owns the second guard (object identity), span-mark release
//! and regex storage. This table contains scalar resource coordinates,
//! never editor pointers or FlValue roots. `fl_h_slot_free` is only the
//! table half of release: its caller must release owned resources first.
//! Editor constructors and object resolvers live in edit.flhandle. The
//! editor-native VM path remains guarded until its binding layer attaches.

/// Scalar handle coordinates, each an unsigned 32-bit value in an int.
pub struct FlHandle { slot: int, gen: int }

/// C's tagged payload union as scalar coordinates. Mark ids retain both
/// components; the regex owner supplies its own storage slot, -1 absent.
pub struct FlHandlePayload {
    buf: int,
    win: int,
    index: int,
    stamp: int,
    lo_id: int,
    lo_gen: int,
    hi_id: int,
    hi_gen: int,
    regex_slot: int,
}

/// Empty payload used before filling the fields of the selected kind.
pub fn fl_h_payload_new() -> FlHandlePayload {
    FlHandlePayload {
        buf: 0,
        win: 0,
        index: 0,
        stamp: 0,
        lo_id: 0,
        lo_gen: 0,
        hi_id: 0,
        hi_gen: 0,
        regex_slot: -1,
    }
}

/// One physical slot. Free-list links are index + 1, zero terminates.
pub struct FlHandleSlot {
    kind: int,
    gen: int,
    next_free: int,
    payload: FlHandlePayload,
}

/// Generation-checked slots. Reuse changes neither list length nor capacity.
pub struct FlHandleTable { slots: List[FlHandleSlot], free_head: int, live: int }

/// No slots are allocated before the first handle is made.
pub fn fl_h_table_new() -> FlHandleTable {
    FlHandleTable { slots: List[FlHandleSlot](), free_head: 0, live: 0 }
}

/// The five scalar value tags, not GC-owned references (handle.c:51-54).
pub fn fl_h_is(v: FlValue) -> bool { fl_h_kind_of(v) != FL_H_NONE }

/// Decode through masks so negative payloads preserve their unsigned bits.
pub fn fl_h_decode(v: FlValue) -> FlHandle {
    FlHandle { slot: v.i & 4294967295, gen: v.i >> 32 & 4294967295 }
}

fn h_tag_of_kind(kind: int) -> int {
    match kind {
        1 => FL_BUF,
        2 => FL_CURSOR,
        3 => FL_SPAN,
        4 => FL_WIN,
        5 => FL_REGEX,
        _ => { assert(false, "fletch handle: no type tag for kind"); FL_NIL },
    }
}

/// Encode the union's bits without an out-of-range unsigned-to-signed cast.
/// High-bit generations are represented by their signed high word first.
pub fn fl_h_encode(kind: int, slot: int, gen: int) -> FlValue {
    assert(slot >= 0 && slot <= 4294967295)
    assert(gen >= 0 && gen <= 4294967295)
    let high = if gen > 2147483647 then gen - 4294967296 else gen
    FlValue { t: h_tag_of_kind(kind), i: high * 4294967296 + slot, f: 0.0 }
}

/// Allocate from the free list or append, preserving the slot's generation.
/// The payload only is copied; callers cannot choose generation or kind.
pub fn fl_h_make(mut table: FlHandleTable, kind: int, init: FlHandlePayload) -> FlValue {
    assert(kind > FL_H_NONE && kind <= FL_H_RE, "fletch handle: bad make")
    var idx: int = 0
    if table.free_head != 0 {
        idx = table.free_head - 1
        table.free_head = table.slots[idx].next_free
    } else {
        idx = table.slots.len
        assert(idx <= 4294967295, "fletch handle: slot space exhausted")
        (mut table.slots).push(FlHandleSlot {
            kind: FL_H_NONE,
            gen: 1,
            next_free: 0,
            payload: fl_h_payload_new(),
        })
    }
    table.slots[idx].payload = copy init
    table.slots[idx].kind = kind
    table.slots[idx].next_free = 0
    table.live += 1
    fl_h_encode(kind, idx, table.slots[idx].gen)
}

/// The one non-raising slot resolver. Object liveness is an independent
/// editor check; a successful table lookup alone proves no editor object.
pub fn fl_h_slot(table: FlHandleTable, v: FlValue) -> int ! {none} {
    let kind = fl_h_kind_of(v)
    if kind == FL_H_NONE { return none }
    let h = fl_h_decode(v)
    if h.slot >= table.slots.len { return none }
    if table.slots[h.slot].kind != kind || table.slots[h.slot].gen != h.gen { return none }
    h.slot
}

/// True precisely when kind, slot and generation resolve in this table.
pub fn fl_h_alive(table: FlHandleTable, v: FlValue) -> bool {
    let _ = fl_h_slot(table, v) else { return false }
    true
}

/// Release a slot AFTER its owner released marks or regex storage. A stale
/// or wrong-kind value cannot alter the free list or decrement the live count.
pub fn fl_h_slot_free(mut table: FlHandleTable, v: FlValue) -> bool {
    let idx = fl_h_slot(table, v) else { return false }
    table.slots[idx].kind = FL_H_NONE
    table.live -= 1
    if table.slots[idx].gen == 4294967295 {
        table.slots[idx].gen = 0
        table.slots[idx].next_free = 0
        return true
    }
    table.slots[idx].gen += 1
    table.slots[idx].next_free = table.free_head
    table.free_head = idx + 1
    true
}
