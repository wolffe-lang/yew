//! fl.flapi — the editor API as a headless VM runs it (R-yw07-6 A):
//! sagitta 9ace98c2 src/fl/flapi.c:1-2143 (the descriptor table
//! `fl_api[]` :1005-1094, `fl_api_invoke` :1778-1884, the queries'
//! headless paths :198-994, `api_ed` :48-56, `fl_api_ed_run` :1946-2060,
//! `fl_api_ed_commands` :2062-2083, the module rows :2085-2136),
//! handle.c's `fl_h_kind_of` :38-48 and `need` :465-485, stdai.c:9-30,
//! flruntime.c's `fl_runtime_on` :282-314, flapi.c's `fl_api_set_options`
//! :1680-1776, and edit/bind.c's `fl_bind_native` :647-701 and
//! `fl_unbind_native` :751-772.
//!
//! A VM has no editor until yw09's `fl_ed_attach` (flapi.c:1131-1137):
//! every native here runs C's checks in C's order — arity, the receiver's
//! handle kind ("%s requires a %s receiver", kind `type`), the query's
//! first step or the capability check, then marshal's editor check — and
//! stops at the first that a headless VM fails, as C does. The bodies past
//! an attached editor are yw09's and refuse by name naming it. One
//! kind-id representation (R10): a row is found by its global native id.
//!
//! `ed.commands` reads the command registry as rows the HOST builds
//! (R-yw07-5: `fl` never imports `edit`); a VM starts with none, and the
//! host hands them over with `fl_vm_set_commands`.

/// `FlHandleKind` (handle.h:62-65): no handle.
pub const FL_H_NONE: int = 0

/// A buffer handle.
pub const FL_H_BUF: int = 1

/// A cursor handle.
pub const FL_H_CUR: int = 2

/// A span handle.
pub const FL_H_SPAN: int = 3

/// A window handle.
pub const FL_H_WIN: int = 4

/// A compiled-regex handle.
pub const FL_H_RE: int = 5

/// `FlArgSlot` (flapi.h:12-25): no argument.
pub const FL_ARG_NONE: int = 0

/// A bool argument.
pub const FL_ARG_BOOL: int = 1

/// An int argument.
pub const FL_ARG_INT: int = 2

/// A str argument.
pub const FL_ARG_STR: int = 3

/// A count argument.
pub const FL_ARG_COUNT: int = 4

/// A window handle argument.
pub const FL_ARG_HANDLE_WIN: int = 5

/// A buffer handle argument.
pub const FL_ARG_HANDLE_BUF: int = 6

/// A cursor handle argument.
pub const FL_ARG_HANDLE_CUR: int = 7

/// A span handle argument.
pub const FL_ARG_HANDLE_SPAN: int = 8

/// A list argument.
pub const FL_ARG_LIST: int = 9

/// A map argument.
pub const FL_ARG_MAP: int = 10

/// Any value.
pub const FL_ARG_VALUE: int = 11

/// A command row: no query.
pub const FL_Q_NONE: int = 0

/// A query whose first step is `api_ed` (the editor itself).
pub const FL_Q_EDITOR: int = 1

/// A query whose first step resolves its receiver (`fl_h_buf` and kin).
pub const FL_Q_HANDLE: int = 2

/// `FlBindDesc` (flapi.h:27-37). `cmd` is "" exactly when `query` is not
/// FL_Q_NONE; C's function pointer is the query's first step (R10), and
/// `kind` the global native id of the module row that reaches it.
pub struct FlBindDesc {
    fl_name: str,
    cmd: str,
    recv: int,
    nmin: int,
    nmax: int,
    arg0: int,
    arg1: int,
    arg2: int,
    caps: int,
    query: int,
    kind: int,
}

/// One command registry row as the host hands it over: the CmdDesc
/// fields `ed.commands` reads (cmd.h:137-160); C's NULL word is
/// `has_word == false`.
pub struct FlHostCmd {
    name: str,
    help: str,
    flags: int,
    word: str,
    has_word: bool,
}

/// The host's command registry, in registry order (`yew fl` builds it
/// from edit's; yw09's editor from its own), copied into the VM.
pub fn fl_vm_set_commands(mut vm: FlVm, rows: List[FlHostCmd]) { vm.host_cmds = copy rows }

fn api_q(name: str, recv: int, nmin: int, nmax: int, query: int, kind: int) -> FlBindDesc {
    FlBindDesc {
        fl_name: name,
        cmd: "",
        recv: recv,
        nmin: nmin,
        nmax: nmax,
        arg0: FL_ARG_NONE,
        arg1: FL_ARG_NONE,
        arg2: FL_ARG_NONE,
        caps: 0,
        query: query,
        kind: kind,
    }
}

fn api_c(
    name: str,
    cmd: str,
    recv: int,
    nmin: int,
    nmax: int,
    caps: int,
    a0: int,
    a1: int,
    a2: int,
    kind: int,
) -> FlBindDesc {
    FlBindDesc {
        fl_name: name,
        cmd: cmd,
        recv: recv,
        nmin: nmin,
        nmax: nmax,
        arg0: a0,
        arg1: a1,
        arg2: a2,
        caps: caps,
        query: FL_Q_NONE,
        kind: kind,
    }
}

/// `fl_api[]` (flapi.c:1005-1094), one row by its native id; each
/// query's class is its first step (flapi.c:198-994).
pub fn fl_api_desc(kind: int) -> FlBindDesc ! {none} {
    let e = FL_Q_EDITOR
    let h = FL_Q_HANDLE
    let b = FL_H_BUF
    let w = FL_H_WIN
    let c = FL_H_CUR
    let s = FL_H_SPAN
    let n = FL_H_NONE
    let x = FL_ARG_NONE
    match kind {
        8000 => api_q("buf.current", n, 0, 0, e, kind),
        8001 => api_q("buf.list", n, 0, 0, e, kind),
        8002 => api_c("buf.open", "ed.buf.open", n, 1, 1, FL_CAP_FS_READ, FL_ARG_STR, x, x, kind),
        8003 => api_c("buf.close", "ed.buf.close", b, 1, 2, 0, FL_ARG_BOOL, x, x, kind),
        8004 =>
            api_c("buf.save", "ed.file.write", b, 1, 2, FL_CAP_FS_WRITE, FL_ARG_VALUE, x, x, kind),
        8005 => api_q("buf.path", b, 1, 1, h, kind),
        8006 => api_q("buf.name", b, 1, 1, h, kind),
        8007 => api_q("buf.lang", b, 1, 1, h, kind),
        8008 => api_q("buf.len", b, 1, 1, h, kind),
        8009 => api_q("buf.lines", b, 1, 1, h, kind),
        8010 => api_q("buf.text", b, 1, 2, h, kind),
        8011 => api_q("buf.line", b, 2, 2, h, kind),
        8012 => api_q("buf.span", b, 3, 3, h, kind),
        8013 => api_q("buf.line_span", b, 2, 2, h, kind),
        8014 =>
            api_c("buf.insert", "ed.edit.insert.at", b, 3, 3, 0, FL_ARG_INT, FL_ARG_STR, x, kind),
        8015 =>
            api_c("buf.delete", "ed.edit.delete.span", b, 2, 2, 0, FL_ARG_HANDLE_SPAN, x, x, kind),
        8016 => api_q("buf.find", b, 2, 3, h, kind),
        8017 => api_q("buf.find_all", b, 2, 2, h, kind),
        8018 => api_q("buf.dirty", b, 1, 1, h, kind),
        8019 => api_q("buf.readonly", b, 1, 1, h, kind),
        8020 => api_q("buf.undo_depth", b, 1, 1, h, kind),
        8021 => api_q("buf.opt", b, 2, 2, e, kind),
        8022 => api_q("buf.opt_set", b, 3, 3, e, kind),
        8023 => api_q("buf.mark", b, 2, 2, h, kind),
        9000 => api_q("win.current", n, 0, 0, e, kind),
        9001 => api_q("win.list", n, 0, 0, e, kind),
        9002 => api_q("win.buf", w, 1, 1, h, kind),
        9003 => api_q("win.cursors", w, 1, 1, h, kind),
        9004 => api_q("win.selection", w, 1, 1, h, kind),
        9005 => api_c("win.split", "ed.win.split", w, 2, 2, 0, FL_ARG_STR, x, x, kind),
        9006 => api_c("win.close", "ed.pane.close", w, 1, 1, 0, x, x, x, kind),
        9007 => api_c("win.focus", "ed.win.focus", w, 1, 1, 0, x, x, x, kind),
        9008 => api_q("win.viewport", w, 1, 1, h, kind),
        9009 => api_c("win.set_cursors", "ed.cursor.set_many", w, 2, 2, 0, FL_ARG_LIST, x, x, kind),
        10000 => api_q("cur.pos", c, 1, 1, h, kind),
        10001 => api_q("cur.line", c, 1, 1, h, kind),
        10002 => api_q("cur.col", c, 1, 1, h, kind),
        10003 => api_q("cur.anchor", c, 1, 1, h, kind),
        10004 => api_q("cur.span", c, 1, 1, h, kind),
        10005 => api_c("cur.goto", "ed.cursor.set", c, 2, 2, 0, FL_ARG_INT, x, x, kind),
        10006 =>
            api_c(
                "cur.move",
                "ed.cursor.move",
                c,
                3,
                4,
                0,
                FL_ARG_STR,
                FL_ARG_STR,
                FL_ARG_COUNT,
                kind,
            ),
        10007 => api_q("cur.word", c, 1, 1, h, kind),
        10008 => api_q("cur.line_span", c, 1, 1, h, kind),
        10009 => api_c("cur.insert", "ed.edit.insert.text", c, 2, 2, 0, FL_ARG_STR, x, x, kind),
        10010 => api_q("cur.is_primary", c, 1, 1, e, kind),
        10011 => api_q("cur.valid", c, 1, 1, e, kind),
        11000 => api_q("span.lo", s, 1, 1, h, kind),
        11001 => api_q("span.hi", s, 1, 1, h, kind),
        11002 => api_q("span.len", s, 1, 1, h, kind),
        11003 => api_q("span.text", s, 1, 1, h, kind),
        11004 => api_q("span.lines", s, 1, 1, h, kind),
        11005 => api_c("span.replace", "ed.edit.replace.span", s, 2, 2, 0, FL_ARG_STR, x, x, kind),
        11006 =>
            api_c(
                "span.replace_lines",
                "ed.edit.replace.span",
                s,
                2,
                2,
                0,
                FL_ARG_LIST,
                x,
                x,
                kind,
            ),
        11007 => api_c("span.prepend", "ed.edit.insert.at", s, 2, 2, 0, FL_ARG_STR, x, x, kind),
        11008 => api_c("span.append", "ed.edit.insert.at", s, 2, 2, 0, FL_ARG_STR, x, x, kind),
        11009 => api_c("span.delete", "ed.edit.delete.span", s, 1, 1, 0, x, x, x, kind),
        11010 => api_c("span.yank", "ed.edit.yank", s, 1, 2, 0, FL_ARG_STR, x, x, kind),
        11011 => api_q("span.valid", s, 1, 1, e, kind),
        12000 => api_c("opt.get", "ed.opt.get", n, 1, 1, 0, FL_ARG_STR, x, x, kind),
        12001 => api_c("opt.set", "ed.opt.set", n, 2, 2, 0, FL_ARG_STR, FL_ARG_VALUE, x, kind),
        13002 => api_q("ed.msg", n, 1, 2, e, kind),
        13003 => api_q("ed.mode", n, 0, 0, e, kind),
        13004 => api_q("ed.recording", n, 0, 0, e, kind),
        13005 => api_q("ed.register", n, 1, 1, e, kind),
        13006 => api_q("ed.fuss", n, 0, 0, e, kind),
        13007 => api_q("ed.workspace", n, 0, 0, e, kind),
        _ => { return none },
    }
}

/// The native ids of `fl_api[]`'s 66 rows, in the table's order.
pub fn fl_api_kinds() -> List[int] {
    var out = List[int]()
    for i in 0..24 { (mut out).push(8000 + i) }
    for i in 0..10 { (mut out).push(9000 + i) }
    for i in 0..12 { (mut out).push(10000 + i) }
    for i in 0..12 { (mut out).push(11000 + i) }
    for i in 0..2 { (mut out).push(12000 + i) }
    for i in 2..8 { (mut out).push(13000 + i) }
    out
}

/// `fl_api_find` (flapi.c:1149-1159): a row by its qualified name.
pub fn fl_api_find(name: List[byte]) -> FlBindDesc ! {none} {
    for k in fl_api_kinds() {
        let d = fl_api_desc(k) else { continue }
        if d.fl_name.len != name.len { continue }
        var same = true
        var i = 0
        for x in d.fl_name.bytes() {
            if x != name[i] { same = false; break }
            i += 1
        }
        if same { return d }
    }
    none
}

/// `fl_api_init`'s startup invariants over the table (flapi.c:1098-1129),
/// "" when every row holds; the command names resolve against the host's
/// registry at the first command call (`api_resolve`).
pub fn fl_api_check_table() -> str {
    for k in fl_api_kinds() {
        let d = fl_api_desc(k) else { return "no row for native {k}" }
        let base = if d.recv == FL_H_NONE then 0 else 1
        if d.nmin > d.nmax || d.nmax < base || d.nmax - base > 3 {
            return "Fletch binding has invalid arity: {d.fl_name}"
        }
        if d.cmd.len == 0 {
            if d.query == FL_Q_NONE {
                return "Fletch binding has neither command nor query: {d.fl_name}"
            }
            continue
        }
        if d.query != FL_Q_NONE { return "Fletch binding has command and query: {d.fl_name}" }
        for mapped in 0..d.nmax - base {
            let slot = if mapped == 0 then d.arg0 else if mapped == 1 then d.arg1 else d.arg2
            if slot == FL_ARG_NONE {
                return "Fletch binding lacks argument mapping: {d.fl_name} arg {mapped + base}"
            }
        }
    }
    ""
}

/// `fl_h_kind_of` (handle.c:38-48): the handle kind a value's tag names.
pub fn fl_h_kind_of(v: FlValue) -> int {
    match v.t {
        12 => FL_H_BUF,
        13 => FL_H_CUR,
        14 => FL_H_SPAN,
        15 => FL_H_WIN,
        16 => FL_H_RE,
        _ => FL_H_NONE,
    }
}

// handle.c:435-446's `kind_word`.
fn api_kind_word(k: int) -> str {
    match k {
        1 => "buffer",
        2 => "cursor",
        3 => "span",
        4 => "window",
        5 => "regex",
        _ => "handle",
    }
}

/// `api_ed` (flapi.c:48-56): the attached editor, else kind `handle`.
/// A VM has none until yw09's fl_ed_attach, so this always raises.
fn api_ed(mut vm: FlVm) -> bool {
    let _ = fl_raise(mut vm, "handle", "no editor is attached")
    false
}

/// Where C goes on with an attached editor: yw09's.
fn api_attached(mut vm: FlVm, what: str) -> FlValue {
    fl_raise(
        mut vm,
        "name",
        "not yet ported: sagitta Sprint 34 {what} with an editor attached (yw09)",
    )
}

/// `need` (handle.c:465-485): the resolvers' shared first steps.
fn api_need(mut vm: FlVm, v: FlValue, want: int) -> bool {
    if fl_h_kind_of(v) != want {
        let _ = fl_raise(
            mut vm,
            "type",
            "expected a {api_kind_word(want)} handle, found {fl_type_name(v.t)}",
        )
        return false
    }
    let _ = fl_raise(mut vm, "handle", "no editor to resolve a {api_kind_word(want)} handle")
    false
}

/// `fl_api_init`'s command resolution (flapi.c:1121-1126), lazy as C's:
/// a row naming a command the host's registry lacks is a startup bug. A
/// VM handed no registry resolves nothing: the id serves only the
/// attached editor's `invoke_command`, yw09's.
fn api_resolve(vm: FlVm, d: FlBindDesc) {
    if vm.host_cmds.len == 0 { return }
    for row in vm.host_cmds { if row.name == d.cmd { return } }
    assert(false, "Fletch binding names unknown command: {d.fl_name} -> {d.cmd}")
}

/// `fl_api_invoke` (flapi.c:1778-1884) for one descriptor.
pub fn fl_api_invoke(mut vm: FlVm, d: FlBindDesc, base: int, argc: int) -> FlValue {
    if argc < d.nmin || argc > d.nmax {
        return fl_raise(mut vm, "arity", "{d.fl_name} got {argc} arguments")
    }
    if d.recv != FL_H_NONE && (argc == 0 || fl_h_kind_of(vm.stack[base]) != d.recv) {
        let word = if d.recv == FL_H_BUF {
            "buffer"
        } else if d.recv == FL_H_WIN {
            "window"
        } else if d.recv == FL_H_CUR {
            "cursor"
        } else {
            "span"
        }
        return fl_raise(mut vm, "type", "{d.fl_name} requires a {word} receiver")
    }
    if d.cmd.len == 0 {
        if d.query == FL_Q_EDITOR {
            if !api_ed(mut vm) { return fl_nil() }
        } else {
            let recv = copy vm.stack[base]
            if !api_need(mut vm, recv, d.recv) { return fl_nil() }
        }
        return api_attached(mut vm, d.fl_name)
    }
    api_resolve(vm, d)
    if d.caps != 0 && !fl_cap_check(mut vm, d.caps) { return fl_nil() }
    // marshal_command (flapi.c:1244-1258): the editor first.
    if !api_ed(mut vm) { return fl_nil() }
    api_attached(mut vm, d.fl_name)
}

/// `fl_api_find_receiver` (flapi.c:1162-1181): the row `member` names for
/// a buf/win/cur/span handle's kind ("buf.len" for `b.len`), or none.
pub fn fl_api_find_receiver(recv: FlValue, member: List[byte]) -> FlBindDesc ! {none} {
    let k = fl_h_kind_of(recv)
    let prefix = match k {
        1 => "buf",
        4 => "win",
        2 => "cur",
        3 => "span",
        _ => { return none },
    }
    if prefix.len + 1 + member.len >= 64 { return none }
    var qualified = List[byte]()
    for x in prefix.bytes() { (mut qualified).push(x) }
    (mut qualified).push(46 as byte)
    for x in member { (mut qualified).push(x) }
    let d = fl_api_find(qualified) else { return none }
    d
}

/// `fl_api_bind_receiver` (flapi.c:1185-1209), the receiver sugar of
/// vm.c:1187-1205's FIELD_GET: `b.len()` binds `b` as argument zero of
/// `buf.len`; none when the value is no buf/win/cur/span handle or the
/// member names no row.
pub fn fl_api_bind_receiver(mut vm: FlVm, recv: FlValue, member: List[byte]) -> FlValue ! {none} {
    let d = fl_api_find_receiver(recv, member) else { return none }
    assert(
        d.recv != FL_H_NONE && d.nmin != 0 && d.nmax != 0,
        "Fletch receiver binding lacks its receiver: {d.fl_name}",
    )
    let id = fl_intern(mut vm.strings, d.fl_name.bytes(), 0, d.fl_name.len)
    let nat = fl_native_new(mut vm, id, d.kind, d.nmin - 1, d.nmax - 1, d.caps)
    let at = fl_obj_index(vm, nat)
    vm.gc.slots[at].has_recv = 1
    vm.gc.slots[at].recv = recv
    nat
}

fn api_put(mut vm: FlVm, root: int, key: str, value: FlValue) {
    let k = fl_str_text(mut vm, key)
    let m = fl_temp_get(vm, root)
    assert(fl_map_set(mut vm, m, k, value))
}

/// `fl_api_ed_commands` (flapi.c:2062-2083): the registry as rows
/// {name, help, flags, word}; no editor is needed.
fn api_ed_commands(mut vm: FlVm) -> FlValue {
    let list = fl_list_new(mut vm)
    let lroot = fl_temp_push(mut vm, list)
    let n = vm.host_cmds.len
    for i in 0..n {
        let row = copy vm.host_cmds[i]
        let m = fl_map_new(mut vm)
        let mroot = fl_temp_push(mut vm, m)
        let name = fl_str_text(mut vm, row.name)
        api_put(mut vm, mroot, "name", name)
        let help = fl_str_text(mut vm, row.help)
        api_put(mut vm, mroot, "help", help)
        api_put(mut vm, mroot, "flags", fl_int(row.flags))
        let word = if row.has_word then fl_str_text(mut vm, row.word) else fl_nil()
        api_put(mut vm, mroot, "word", word)
        let list_now = fl_temp_get(vm, lroot)
        let map_now = fl_temp_get(vm, mroot)
        fl_list_push(mut vm, list_now, map_now)
        fl_temp_pop(mut vm, 1)
    }
    let out = fl_temp_get(vm, lroot)
    fl_temp_pop(mut vm, 1)
    out
}

/// The editor modules' natives: `buf win cur span opt ed` through the
/// table (flapi.c:1886-1893's api_native), `ed.run` and `ed.commands`
/// (flapi.c:1946, :2062) and stdai.c's `ai.backend`, which checks the
/// editor before its arguments (stdai.c:17-18).
pub fn fl_std_api_dispatch(mut vm: FlVm, kind: int, base: int, argc: int) -> FlValue {
    if kind == 13000 {
        // fl_api_ed_run: api_ed first, then the name and the map.
        if !api_ed(mut vm) { return fl_nil() }
        return api_attached(mut vm, "ed.run")
    }
    if kind == 13001 { return api_ed_commands(mut vm) }
    if kind == 14000 {
        let _ = fl_raise(mut vm, "handle", "no editor is attached")
        return fl_nil()
    }
    let d = fl_api_desc(kind) else {
        let name = fl_std_name(vm)
        return fl_raise(mut vm, "name", "unknown editor binding {name}")
    }
    fl_api_invoke(mut vm, d, base, argc)
}

/// The prelude's editor names, locals 1 on, 4 set, 5 bind, 6 unbind
/// (std.c:251-256): each checks the editor first but `set`, which wants
/// its map first (flapi.c:1693-1698).
pub fn fl_prelude_api_dispatch(mut vm: FlVm, local: int, base: int, argc: int) -> FlValue {
    match local {
        1 => fl_raise(mut vm, "handle", "on: no editor is attached"),
        4 => {
            if argc != 1 || vm.stack[base].t != FL_MAP {
                return fl_raise(mut vm, "type", "set expects one map argument")
            }
            if !api_ed(mut vm) { return fl_nil() }
            api_attached(mut vm, "set")
        },
        5 => fl_raise(mut vm, "handle", "bind: no editor is attached"),
        6 => fl_raise(mut vm, "handle", "unbind: no editor is attached"),
        _ => {
            assert(false)
            fl_nil()
        },
    }
}

fn fl_api_row(name: str, kind: int, min_ar: int, max_ar: int) -> FlNativeDef {
    fl_native_def(name, kind, min_ar, max_ar, 0, "editor API")
}

/// Pinned BUF_DEFS rows (flapi.c:2087-2101).
pub fn fl_buf_defs() -> List[FlNativeDef] {
    [
        fl_api_row("current", 8000, 0, 0),
        fl_api_row("list", 8001, 0, 0),
        fl_api_row("open", 8002, 1, 1),
        fl_api_row("close", 8003, 1, 2),
        fl_api_row("save", 8004, 1, 2),
        fl_api_row("path", 8005, 1, 1),
        fl_api_row("name", 8006, 1, 1),
        fl_api_row("lang", 8007, 1, 1),
        fl_api_row("len", 8008, 1, 1),
        fl_api_row("lines", 8009, 1, 1),
        fl_api_row("text", 8010, 1, 2),
        fl_api_row("line", 8011, 2, 2),
        fl_api_row("span", 8012, 3, 3),
        fl_api_row("line_span", 8013, 2, 2),
        fl_api_row("insert", 8014, 3, 3),
        fl_api_row("delete", 8015, 2, 2),
        fl_api_row("find", 8016, 2, 3),
        fl_api_row("find_all", 8017, 2, 2),
