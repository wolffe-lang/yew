// 34-editor.fl:146-153: the config primitives refuse without an editor.
fn api_config_primitives_refuse() {
    var f = api_open()
    refuses(
        mut f,
        "bind(\"H\", \"s\", fn() {{ return 1 }})",
        "!handle: bind: no editor is attached",
    )
    refuses(mut f, "unbind(\"H\", \"s\")", "!handle: unbind: no editor is attached")
    refuses(mut f, "set({{tabwidth: 4}})", NO_ED)
    refuses(mut f, "record(\"q\")", "!handle: ed.macro.record: no editor is attached")
    refuses(mut f, "replay(\"q\")", "!handle: ed.macro.replay: no editor is attached")
    refuses(mut f, "replay(\"q\", 2)", "!handle: ed.macro.replay: no editor is attached")
    // 34-editor.fl:158-161: uncaught, the process error is `handle`.
    flfix.eq(mut f, "{P}buf.current()\n", NO_ED)
    flfix.close(mut f)
}

// errors/kind_handle.fl:12-18: set({}) headless, caught and uncaught.
fn api_kind_handle_set() {
    var f = api_open()
    flfix.eq(
        mut f,
        "import io\ntry {{\n    set({{}})\n}} catch e {{\n    return e.kind\n}}\nreturn 1\n",
        "handle",
    )
    flfix.eq(mut f, "import io\nset({{}})\n", NO_ED)
    flfix.close(mut f)
}

// The order of the checks, witnessed beside the units (api/c.log).
fn api_check_order() {
    var f = api_open()
    refuses(mut f, "set(42)", "!type: set expects one map argument")
    refuses(mut f, "on(\"buf.open\", fn() {{ return 1 }})", "!handle: on: no editor is attached")
    refuses(mut f, "on(1, 2)", "!handle: on: no editor is attached")
    refuses(mut f, "ai.backend(1, 2)", NO_ED)
    refuses(mut f, "ed.run(42, 42)", NO_ED)
    refuses(mut f, "buf.len()", "!arity: buf.len expects 1 argument, got 0")
    refuses(mut f, "(42).len()", "!key: no field 'len' on int")
    // A command's capability comes before marshal's editor check.
    flfix.set_origin(mut f, fl.FL_ORIGIN_CLI, 0)
    refuses(mut f, "buf.open(\"missing\")", "!capability: fs.read denied to the command line")
    refuses(mut f, "buf.save(42)", recv("buf.save", "buffer"))
    refuses(mut f, "ed.run(\"ed.buf.open\", {{}})", NO_ED)
    flfix.close(mut f)
}

// ed.commands' rows (flapi.c:2062-2083): {name, help, flags, word}.
fn api_commands_are_the_registry() {
    var f = api_open()
    flfix.eq(mut f, "{P}return list.len(ed.commands())\n", "16")
    flfix.eq(mut f, "{P}return ed.commands()[0].name\n", "ed.edit.insert.at")
    flfix.eq(mut f, "{P}return ed.commands()[0].help\n", "Insert bytes at an offset")
    flfix.eq(mut f, "{P}return ed.commands()[0].flags\n", "28")
    flfix.eq(mut f, "{P}return ed.commands()[0].word\n", "insert_at")
    flfix.eq(mut f, "{P}let r = ed.commands()[15]\nreturn r.word\n", "nil")
    flfix.eq(mut f, "{P}let r = ed.commands()[15]\nreturn r.name\n", "ed.plug.info")
    // A VM the host handed no registry answers an empty list.
    var g = flfix.open()
    flfix.eq(mut g, "import ed\nimport list\nreturn list.len(ed.commands())\n", "0")
    flfix.close(mut g)
    flfix.close(mut f)
}

fn call_api(mut vm: fl.FlVm, kind: int, args: List[fl.FlValue]) -> fl.FlValue {
    vm.raised = false
    vm.sp = args.len
    for i in 0..args.len { vm.stack[i] = copy args[i] }
    fl.fl_std_api_dispatch(mut vm, kind, 0, args.len)
}

fn err_is(mut vm: fl.FlVm, kind: str, msg: str) {
    assert(vm.raised)
    let k = fl.fl_str_text(mut vm, "kind")
    let m = fl.fl_str_text(mut vm, "msg")
    let err = copy vm.err
    let kv = fl.fl_map_get(vm, err, k) else fl.fl_nil()
    let mv = fl.fl_map_get(vm, err, m) else fl.fl_nil()
    let got_k = str_from_utf8(vm.gc.slots[fl.fl_obj_index(vm, kv)].bytes) else ""
    let got_m = str_from_utf8(vm.gc.slots[fl.fl_obj_index(vm, mv)].bytes) else ""
    if got_k != kind || got_m != msg { eprint("api: got {got_k}: {got_m}, want {kind}: {msg}") }
    assert(got_k == kind && got_m == msg)
    vm.raised = false
}

// The table holds C's startup invariants, and each module row reaches
// the descriptor of its own name and arity (flapi.c:1098-1129, :2085-2136).
fn api_table_matches_the_module_rows() {
    assert(fl.fl_api_check_table() == "")
    assert(fl.fl_api_kinds().len == 66)
    var seen = check_family("buf", fl.fl_buf_defs())
    seen += check_family("win", fl.fl_win_defs())
    seen += check_family("cur", fl.fl_cur_defs())
    seen += check_family("span", fl.fl_span_defs())
    seen += check_family("opt", fl.fl_opt_defs())
    seen += check_family("ed", fl.fl_ed_defs())
    assert(seen == 66)
    assert(!api_found("buf.nope") && !api_found("buf") && api_found("ed.msg"))
}

fn check_family(family: str, defs: List[fl.FlNativeDef]) -> int {
    var seen = 0
    for d in defs {
        if d.kind == 13000 || d.kind == 13001 { continue }
        let desc = fl.fl_api_desc(d.kind) else {
            assert(false, "no descriptor for {family}.{d.name}")
            return 0
        }
        assert(desc.fl_name == "{family}.{d.name}")
        assert(desc.nmin == d.min_ar && desc.nmax == d.max_ar)
        let byname = fl.fl_api_find(bytes_of(desc.fl_name)) else {
            assert(false, "fl_api_find {desc.fl_name}")
            return 0
        }
        assert(byname.kind == d.kind)
        seen += 1
    }
    seen
}

fn api_found(name: str) -> bool {
    let _ = fl.fl_api_find(bytes_of(name)) else { return false }
    true
}

fn bytes_of(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() { (mut out).push(b) }
    out
}

// A handle-tagged receiver passes the kind check and stops at the query's
// first step (handle.c:465-485) or marshal's editor check; a headless VM
// can mint no handle, so the values are made by hand.
fn api_handle_receiver_second_step() {
    var f = api_open()
    let b = fl.FlValue { t: fl.FL_BUF, i: 0, f: 0.0 }
    let w = fl.FlValue { t: fl.FL_WIN, i: 0, f: 0.0 }
    let c = fl.FlValue { t: fl.FL_CURSOR, i: 0, f: 0.0 }
    let s = fl.FlValue { t: fl.FL_SPAN, i: 0, f: 0.0 }
    let _ = call_api(mut f.vm, 8008, [copy b])
    err_is(mut f.vm, "handle", "no editor to resolve a buffer handle")
    let _ = call_api(mut f.vm, 9002, [copy w])
    err_is(mut f.vm, "handle", "no editor to resolve a window handle")
    let _ = call_api(mut f.vm, 10000, [copy c])
    err_is(mut f.vm, "handle", "no editor to resolve a cursor handle")
    let _ = call_api(mut f.vm, 11000, [copy s])
    err_is(mut f.vm, "handle", "no editor to resolve a span handle")
    // Editor-first queries and every command stop at the editor itself.
    let _ = call_api(mut f.vm, 8021, [copy b, fl.fl_nil()])
    err_is(mut f.vm, "handle", "no editor is attached")
    let _ = call_api(mut f.vm, 10011, [copy c])
    err_is(mut f.vm, "handle", "no editor is attached")
    let _ = call_api(mut f.vm, 11011, [copy s])
    err_is(mut f.vm, "handle", "no editor is attached")
    let _ = call_api(mut f.vm, 8003, [copy b])
    err_is(mut f.vm, "handle", "no editor is attached")
    // A regex handle is no buffer: the receiver check holds.
    let _ = call_api(mut f.vm, 8008, [fl.FlValue { t: fl.FL_REGEX, i: 0, f: 0.0 }])
    err_is(mut f.vm, "type", "buf.len requires a buffer receiver")
    // fl_api_invoke's own arity check (CALL's checks first, so only a
    // direct invoke meets it).
    let d = fl.fl_api_desc(8008) else {
        assert(false)
        return
    }
    let _ = fl.fl_api_invoke(mut f.vm, d, 0, 2)
    err_is(mut f.vm, "arity", "buf.len got 2 arguments")
    flfix.close(mut f)
}

// vm.c:1187-1205's receiver sugar: `b.len()` is `buf.len(b)`.
fn api_receiver_binding() {
    var f = api_open()
    let n = fl.fl_api_bind_receiver(mut f.vm, fl.fl_int(42), bytes_of("len")) else fl.fl_nil()
    assert(n.t == fl.FL_NIL)
    let re = fl.FlValue { t: fl.FL_REGEX, i: 0, f: 0.0 }
    let r = fl.fl_api_bind_receiver(mut f.vm, re, bytes_of("len")) else fl.fl_nil()
    assert(r.t == fl.FL_NIL)
    let b = fl.FlValue { t: fl.FL_BUF, i: 0, f: 0.0 }
    let miss = fl.fl_api_bind_receiver(mut f.vm, b, bytes_of("nope")) else fl.fl_nil()
    assert(miss.t == fl.FL_NIL)
    let bound = fl.fl_api_bind_receiver(mut f.vm, b, bytes_of("len")) else fl.fl_nil()
    assert(bound.t == fl.FL_NATIVE)
    let at = fl.fl_obj_index(f.vm, bound)
    assert(f.vm.gc.slots[at].native_kind == 8008 && f.vm.gc.slots[at].min_ar == 0)
    assert(f.vm.gc.slots[at].max_ar == 0 && f.vm.gc.slots[at].has_recv == 1)
    let _ = fl.fl_vm_call(mut f.vm, bound, List[fl.FlValue]())
    err_is(mut f.vm, "handle", "no editor to resolve a buffer handle")
    let w = fl.FlValue { t: fl.FL_WIN, i: 0, f: 0.0 }
    let split = fl.fl_api_bind_receiver(mut f.vm, w, bytes_of("split")) else fl.fl_nil()
    let si = fl.fl_obj_index(f.vm, split)
    assert(f.vm.gc.slots[si].native_kind == 9005 && f.vm.gc.slots[si].min_ar == 1)
    flfix.close(mut f)
}

fn main() {
    // YEW_API_CASE runs one case alone (tools/check-test-cases.txt, G29);
    // unset, all 17 run in order.
    let only = (env_get("YEW_API_CASE") else "-1").to_int() else -1
    let names = [
        "api_module_is_real_and_refuses",
        "api_non_handle_is_a_type_error",
        "api_unit_lines_part_0",
        "api_unit_lines_part_1",
        "api_unit_lines_part_2",
        "api_unit_lines_part_3",
        "api_free_natives_refuse_without_an_editor",
        "api_buf_natives_want_a_buffer",
        "api_win_and_cur_natives_want_their_receiver",
        "api_span_natives_want_a_span",
        "api_config_primitives_refuse",
        "api_kind_handle_set",
        "api_check_order",
        "api_commands_are_the_registry",
        "api_table_matches_the_module_rows",
        "api_handle_receiver_second_step",
        "api_receiver_binding",
    ]
    var ran = 0
    for n in 0..17 {
        if only >= 0 && n != only { continue }
        match n {
            0 => api_module_is_real_and_refuses(),
            1 => api_non_handle_is_a_type_error(),
            2 => api_unit_lines(0),
            3 => api_unit_lines(1),
            4 => api_unit_lines(2),
            5 => api_unit_lines(3),
            6 => api_free_natives_refuse_without_an_editor(),
            7 => api_buf_natives_want_a_buffer(),
            8 => api_win_and_cur_natives_want_their_receiver(),
            9 => api_span_natives_want_a_span(),
            10 => api_config_primitives_refuse(),
            11 => api_kind_handle_set(),
            12 => api_check_order(),
            13 => api_commands_are_the_registry(),
            14 => api_table_matches_the_module_rows(),
            15 => api_handle_receiver_second_step(),
            16 => api_receiver_binding(),
            _ => { assert(false, "unregistered fl_api_headless case") },
        }
        print("{names[n]}: PASS")
        ran += 1
    }
    print("fl_api_headless: {ran} of 17 cases run")
}
