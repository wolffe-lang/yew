//! member: false
//! The editor API's headless natives (R-yw07-6 A), every line of sagitta
//! 9ace98c2 tests/fletch/34-editor.fl and tests/fletch/errors/
//! kind_handle.fl through flfix, each asserted as the whole `!kind: msg`
//! C yew answers (notes/yw07b-evidence/io/api/c.log), then the port's own
//! structure: the table's startup invariants, the module rows against the
//! table, a handle-tagged receiver's second step, the receiver binding and
//! ed.commands' rows. The fixture is `yew fl`'s: the CLI origin with every
//! capability (flcli.c:161-171), with host command rows handed over as
//! the driver hands edit's registry over.

use fl
use flfix

fn cmd_row(name: str, help: str, flags: int, word: str) -> fl.FlHostCmd {
    fl.FlHostCmd { name: name, help: help, flags: flags, word: word, has_word: word.len != 0 }
}

// The rows of edit.cmdtab (generated from cmd.c's builtins[] at the pin)
// that the table's commands name, the first and the last, each with its
// registry index; the whole 408 reach ed.commands through `yew fl`
// (notes/yw07b-evidence/io/api/, C and the port).
fn host_rows() -> List[fl.FlHostCmd] {
    var rows = List[fl.FlHostCmd]()
    (mut rows).push(cmd_row("ed.edit.insert.at", "Insert bytes at an offset", 28, "insert_at")) // 0
    (mut rows).push(cmd_row("ed.edit.delete.span", "Delete the supplied span", 28, "delete_span")) // 1
    (mut rows).push(
        cmd_row("ed.edit.replace.span", "Replace the supplied span", 28, "replace_span"),
    ) // 2
    (mut rows).push(cmd_row("ed.buf.open", "Open a buffer", 0, "")) // 8
    (mut rows).push(cmd_row("ed.buf.close", "Close the current buffer", 8, "")) // 9
    (mut rows).push(cmd_row("ed.cursor.set", "Set the primary cursor offset", 8, "")) // 10
    (mut rows).push(cmd_row("ed.cursor.set_many", "Replace a window's cursor set", 136, "")) // 11
    (mut rows).push(cmd_row("ed.win.split", "Split a window horizontally or vertically", 8, "")) // 13
    (mut rows).push(cmd_row("ed.win.focus", "Focus a specific window", 8, "")) // 14
    (mut rows).push(cmd_row("ed.edit.yank", "Yank a supplied span into a register", 8, "")) // 15
    (mut rows).push(cmd_row("ed.opt.get", "Read an editor option", 0, "")) // 17
    (mut rows).push(cmd_row("ed.opt.set", "Set an editor option", 0, "")) // 18
    (mut rows).push(cmd_row("ed.edit.insert.text", "Insert UTF-8 text at the cursor", 28, "insert")) // 90
    (mut rows).push(
        cmd_row("ed.file.write", "Write the active buffer, optionally to a path", 8, ""),
    ) // 204
    (mut rows).push(cmd_row("ed.pane.close", "Close the focused pane", 8, "")) // 257
    (mut rows).push(cmd_row("ed.plug.info", "Show plugin manifest, grants, and last error", 0, "")) // 407
    rows
}

fn api_open() -> flfix.FlFix {
    var f = flfix.open()
    flfix.set_origin(mut f, fl.FL_ORIGIN_CLI, fl.FL_CAP_ALL)
    let rows = host_rows()
    fl.fl_vm_set_commands(mut f.vm, rows)
    f
}

const P: str = "import io\nimport buf\nimport win\nimport cur\nimport span\nimport opt\nimport ed\nimport ai\nimport list\n"

fn refuses(mut f: flfix.FlFix, call: str, want: str) { flfix.eq(mut f, "{P}return {call}\n", want) }

fn caught(call: str) -> str {
    "{P}try {{\n    io.print({call})\n}} catch e {{\n    return e.kind\n}}\nreturn \"ran\"\n"
}

const NO_ED: str = "!handle: no editor is attached"

fn recv(native: str, word: str) -> str { "!type: {native} requires a {word} receiver" }

// 34-editor.fl:47-54: the module is real, and its natives refuse.
fn api_module_is_real_and_refuses() {
    var f = api_open()
    flfix.eq(mut f, caught("buf.current()"), "handle")
    refuses(mut f, "buf.current()", NO_ED)
    flfix.close(mut f)
}

// 34-editor.fl:56-79: a non-handle is a TYPE error, not a handle one.
fn api_non_handle_is_a_type_error() {
    var f = api_open()
    flfix.eq(mut f, caught("buf.len(42)"), "type")
    flfix.eq(mut f, caught("buf.path(\"not a handle\")"), "type")
    flfix.eq(mut f, caught("buf.text(nil)"), "type")
    refuses(mut f, "buf.len(42)", recv("buf.len", "buffer"))
    refuses(mut f, "buf.path(\"not a handle\")", recv("buf.path", "buffer"))
    refuses(mut f, "buf.text(nil)", recv("buf.text", "buffer"))
    flfix.close(mut f)
}

const REFUSES: str = "fn refuses(kind, thunk) {{\n    try {{\n        thunk()\n        error(\"editor native unexpectedly succeeded\")\n    }} catch e {{\n        if e.kind != kind {{ error(\"editor native raised the wrong kind\") }}\n    }}\n}}\n"

// 34-editor.fl:39-46 and :84-144 as the unit runs them: its helper, then
// every `refuses` line in the unit's order, sixteen a case (one program of
// all 64 is past the checked budget under YEW_FL_GC_STRESS), the registry
// line closing the last.
fn api_unit_lines(part: int) {
    var f = api_open()
    var body = "{P}{REFUSES}"
    if part == 0 {
        body += "refuses(\"handle\", fn() {{ buf.list() }})\n"
        body += "refuses(\"handle\", fn() {{ ed.msg(\"hello\") }})\n"
        body += "refuses(\"handle\", fn() {{ ed.mode() }})\n"
        body += "refuses(\"handle\", fn() {{ ed.recording() }})\n"
        body += "refuses(\"handle\", fn() {{ ed.register(\"a\") }})\n"
        body += "refuses(\"handle\", fn() {{ ed.fuss() }})\n"
        body += "refuses(\"handle\", fn() {{ ed.workspace() }})\n"
        body += "refuses(\"handle\", fn() {{ ai.backend(\"local\", {{}}) }})\n"
        body += "refuses(\"handle\", fn() {{ buf.open(\"missing\") }})\n"
        body += "refuses(\"type\", fn() {{ buf.close(42) }})\n"
        body += "refuses(\"type\", fn() {{ buf.save(42) }})\n"
        body += "refuses(\"type\", fn() {{ buf.name(42) }})\n"
        body += "refuses(\"type\", fn() {{ buf.lang(42) }})\n"
        body += "refuses(\"type\", fn() {{ buf.lines(42) }})\n"
        body += "refuses(\"type\", fn() {{ buf.line(42, 1) }})\n"
        body += "refuses(\"type\", fn() {{ buf.span(42, 0, 0) }})\n"
    }
    if part == 1 {
        body += "refuses(\"type\", fn() {{ buf.line_span(42, 1) }})\n"
        body += "refuses(\"type\", fn() {{ buf.insert(42, 0, \"x\") }})\n"
        body += "refuses(\"type\", fn() {{ buf.delete(42, nil) }})\n"
        body += "refuses(\"type\", fn() {{ buf.find(42, nil) }})\n"
        body += "refuses(\"type\", fn() {{ buf.find_all(42, nil) }})\n"
        body += "refuses(\"type\", fn() {{ buf.dirty(42) }})\n"
        body += "refuses(\"type\", fn() {{ buf.opt(42, \"save.strategy\") }})\n"
        body += "refuses(\"type\", fn() {{ buf.opt_set(42, \"save.strategy\", \"auto\") }})\n"
        body += "refuses(\"type\", fn() {{ buf.readonly(42) }})\n"
        body += "refuses(\"type\", fn() {{ buf.mark(42, 0) }})\n"
        body += "refuses(\"type\", fn() {{ buf.undo_depth(42) }})\n"
        body += "refuses(\"handle\", fn() {{ win.current() }})\n"
        body += "refuses(\"handle\", fn() {{ win.list() }})\n"
        body += "refuses(\"type\", fn() {{ win.buf(42) }})\n"
        body += "refuses(\"type\", fn() {{ win.cursors(42) }})\n"
        body += "refuses(\"type\", fn() {{ win.selection(42) }})\n"
    }
    if part == 2 {
        body += "refuses(\"type\", fn() {{ win.split(42, \"right\") }})\n"
        body += "refuses(\"type\", fn() {{ win.close(42) }})\n"
        body += "refuses(\"type\", fn() {{ win.focus(42) }})\n"
        body += "refuses(\"type\", fn() {{ win.viewport(42) }})\n"
        body += "refuses(\"type\", fn() {{ win.set_cursors(42, []) }})\n"
        body += "refuses(\"type\", fn() {{ cur.pos(42) }})\n"
        body += "refuses(\"type\", fn() {{ cur.line(42) }})\n"
        body += "refuses(\"type\", fn() {{ cur.col(42) }})\n"
        body += "refuses(\"type\", fn() {{ cur.anchor(42) }})\n"
        body += "refuses(\"type\", fn() {{ cur.span(42) }})\n"
        body += "refuses(\"type\", fn() {{ cur.goto(42, 0) }})\n"
        body += "refuses(\"type\", fn() {{ cur.move(42, \"word\", \"next\") }})\n"
        body += "refuses(\"type\", fn() {{ cur.word(42) }})\n"
        body += "refuses(\"type\", fn() {{ cur.line_span(42) }})\n"
        body += "refuses(\"type\", fn() {{ cur.insert(42, \"x\") }})\n"
        body += "refuses(\"type\", fn() {{ cur.is_primary(42) }})\n"
    }
    if part == 3 {
        body += "refuses(\"type\", fn() {{ cur.valid(42) }})\n"
        body += "refuses(\"type\", fn() {{ span.lo(42) }})\n"
        body += "refuses(\"type\", fn() {{ span.hi(42) }})\n"
        body += "refuses(\"type\", fn() {{ span.len(42) }})\n"
        body += "refuses(\"type\", fn() {{ span.text(42) }})\n"
        body += "refuses(\"type\", fn() {{ span.lines(42) }})\n"
        body += "refuses(\"type\", fn() {{ span.replace(42, \"x\") }})\n"
        body += "refuses(\"type\", fn() {{ span.replace_lines(42, [\"x\"]) }})\n"
        body += "refuses(\"type\", fn() {{ span.prepend(42, \"x\") }})\n"
        body += "refuses(\"type\", fn() {{ span.append(42, \"x\") }})\n"
        body += "refuses(\"type\", fn() {{ span.delete(42) }})\n"
        body += "refuses(\"type\", fn() {{ span.yank(42) }})\n"
        body += "refuses(\"type\", fn() {{ span.valid(42) }})\n"
        body += "refuses(\"handle\", fn() {{ opt.get(\"tabwidth\") }})\n"
        body += "refuses(\"handle\", fn() {{ opt.set(\"tabwidth\", 4) }})\n"
        body += "refuses(\"handle\", fn() {{ ed.run(\"ed.mode.normal\", {{}}) }})\n"
        body += "if list.len(ed.commands()) == 0 {{ error(\"editor command registry is empty\") }}\n"
    }
    flfix.eq(mut f, "{body}return 1\n", "1")
    if part == 0 {
        // The helper sees a wrong kind, so a passing line is not vacuous.
        flfix.eq(
            mut f,
            "{P}{REFUSES}refuses(\"type\", fn() {{ buf.list() }})\nreturn 1\n",
            "!user: editor native raised the wrong kind",
        )
    }
    flfix.close(mut f)
}

// Each free native's whole refusal: the editor itself (34-editor.fl:84-92,
// :129-130, :142-143).
fn api_free_natives_refuse_without_an_editor() {
    var f = api_open()
    for call in [
        "buf.list()",
        "ed.msg(\"hello\")",
        "ed.mode()",
        "ed.recording()",
        "ed.register(\"a\")",
        "ed.fuss()",
        "ed.workspace()",
        "ai.backend(\"local\", {{}})",
        "buf.open(\"missing\")",
        "win.current()",
        "win.list()",
        "opt.get(\"tabwidth\")",
        "opt.set(\"tabwidth\", 4)",
        "ed.run(\"ed.mode.normal\", {{}})",
    ] {
        refuses(mut f, call, NO_ED)
    }
    flfix.close(mut f)
}

fn typed(mut f: flfix.FlFix, rows: List[(str, str, str)]) {
    for row in rows {
        let (call, native, word) = row
        refuses(mut f, call, recv(native, word))
    }
}

// Each receiver native's whole refusal, before any editor is consulted
// (34-editor.fl:93-140), one family a case.
