//! member: false
//!
//! The port of sagitta `tests/unit/test_cmdparse.c` (539 lines), one test
//! per C test in registry order (`tests/unit/registry.c:84`, then
//! `:1025-1032`).
//!
//! C's fixture is a hand-built `Ed` over "one two\nthree\nlast" with a
//! path, a realpath, the cursor at byte 4 and a workspace directory, and
//! a fresh registry with three test commands (`test_cmdparse.c:30-53`);
//! the port's is `edit.ed_new()` with its scratch buffer refilled the
//! same way and the three commands registered on the editor's own
//! registry value as probes.
//!
//! Two cases read the shell context lexer through the point parser
//! (Sprint 57.23 §5): `cmdparse_bang_point_splits_the_shell_body` and the
//! second half of `cmdparse_bang_pipe_body_stays_verbatim` — `edit.shctx`
//! (yw04's shell half) wired into `cp_bang_point`.

use edit
use text

fn bytes_of(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() {
        (mut out).push(b)
    }
    out
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn is_text(got: List[byte], want: str) -> bool {
    same(got, bytes_of(want))
}

fn show(b: List[byte]) -> str {
    edit.cmderr_text(edit.CmdErr { tok_lo: 0, tok_hi: 0, msg: copy b, set: true })
}

fn probe(name: str, arity: int) -> edit.CmdDesc {
    edit.CmdDesc {
        name: name,
        handler: edit.HANDLER_PROBE,
        impl_id: 0,
        arity: arity,
        flags: 0,
        help: "Parser test command",
        word: "",
        has_word: false,
    }
}

fn register(mut ed: edit.Ed, name: str, arity: int, argspec: str, policy: int, abbrev: str) {
    let _ = edit.cmd_register_entry(
        mut ed.reg,
        probe(name, arity),
        "parse_nop",
        "",
        argspec,
        true,
        policy,
        abbrev,
        abbrev.len != 0,
    )
}

// The fixture's text, path, cursor and workspace (`parse_fixture_init`).
fn set_text(mut ed: edit.Ed, t: List[byte]) {
    let b = ed.wins[ed.win].buf
    ed.bufs[b].ec.tb = text.textbuf_from_bytes(t, 0, t.len)
}

fn set_sel(mut ed: edit.Ed, anchor: int, pos: int) {
    let w = ed.win
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].anchor = anchor
    ed.wins[w].cs.curs[p].pos = pos
}

fn fixture() -> edit.Ed {
    var ed = edit.ed_new()
    edit.ed_open_scratch(mut ed)
    set_text(mut ed, bytes_of("one two\nthree\nlast"))
    let b = ed.wins[ed.win].buf
    ed.bufs[b].path = "/home/u/proj/main.c"
    ed.bufs[b].has_path = true
    ed.bufs[b].ec.meta.realpath = "/home/u/proj/main.c"
    ed.bufs[b].ec.meta.has_realpath = true
    ed.bufs[b].ec.has_meta = true
    var cur = text.cursor_at(4 as text.ByteOff)
    cur.goal_col = 4
    ed.wins[ed.win].cs = text.cset_init(cur)
    ed.ws_dir = "/home/u/proj"
    register(mut ed, "ed.ui.open", edit.ARITY_STR, "s", edit.RP_OPT, "topen")
    register(mut ed, "ed.ui.grow", edit.ARITY_NONE, "", edit.RP_REQUIRED, "sort")
    register(mut ed, "ed.ui.shrink", edit.ARITY_NONE, "", edit.RP_FORBID, "q")
    ed
}

fn parse(mut ed: edit.Ed, line: str) -> edit.CmdParse {
    edit.cmd_parse(mut ed, bytes_of(line))
}

// `assert_arg` (`test_cmdparse.c:62-72`).
fn assert_arg(mut ed: edit.Ed, line: str, expected: str) {
    let r = parse(mut ed, line)
    assert(edit.cmd_parse_ok(r), "{line}: parses ({show(r.err.msg)})")
    assert(r.argv.len == 2, "{line}: two words")
    assert(is_text(r.argv[0], "ed.file.write"), "{line}: ed.file.write")
    assert(is_text(r.argv[1], expected), "{line}: [{show(r.argv[1])}] is [{expected}]")
}

// `assert_error` (`test_cmdparse.c:74-84`).
fn assert_error_b(mut ed: edit.Ed, line: List[byte], expected: str) {
    let r = edit.cmd_parse(mut ed, line)
    let shown = show(line)
    assert(!edit.cmd_parse_ok(r), "{shown}: refused")
    assert(is_text(r.err.msg, expected), "{shown}: [{show(r.err.msg)}] is [{expected}]")
    assert(r.err.tok_lo < r.err.tok_hi, "{shown}: a token")
    assert(r.err.tok_hi <= line.len, "{shown}: inside the line")
}

fn assert_error(mut ed: edit.Ed, line: str, expected: str) {
    assert_error_b(mut ed, bytes_of(line), expected)
}

// `assert_error_span` (`test_cmdparse.c:86-96`).
fn assert_error_span(mut ed: edit.Ed, line: str, expected: str, lo: int, hi: int) {
    let r = parse(mut ed, line)
    assert(!edit.cmd_parse_ok(r), "{line}: refused")
    assert(is_text(r.err.msg, expected), "{line}: [{show(r.err.msg)}] is [{expected}]")
    assert(
        r.err.tok_lo == lo && r.err.tok_hi == hi,
        "{line}: span {r.err.tok_lo},{r.err.tok_hi} is {lo},{hi}",
    )
}

fn t_cmdparse_prof_subcommands_route_to_registry() {
    var ed = fixture()
    let rows = [
        (":prof", "ed.prof.report", ""),
        (":prof report", "ed.prof.report", ""),
        (":prof reset", "ed.prof.reset", ""),
        (":prof dump '/tmp/prof report'", "ed.prof.dump", "/tmp/prof report"),
        (":prof mark typing", "ed.prof.mark", "typing"),
        (":prof frames", "ed.prof.frames", ""),
        (":prof frames 12", "ed.prof.frames", "12"),
    ]
    for row in rows {
        let (line, command, arg) = row
        let r = parse(mut ed, line)
        assert(edit.cmd_parse_ok(r), "{line}: parses ({show(r.err.msg)})")
        assert(is_text(r.argv[0], command), "{line}: {command}")
        assert(r.argv.len == (if arg.len == 0 then 1 else 2), "{line}: words")
        if arg.len != 0 {
            assert(is_text(r.argv[1], arg), "{line}: the argument")
        }
    }
    assert_error(mut ed, ":prof unknown", "unknown prof action 'unknown'")
    assert_error(mut ed, ":prof report extra", ":prof.report takes no arguments")
}

fn t_cmdparse_tokenizer_expansion_matrix() {
    var ed = fixture()
    let rows = [
        (":w alpha", "alpha"),
        ("w alpha", "alpha"),
        ("  :  w alpha  ", "alpha"),
        (":w alpha\\ beta", "alpha beta"),
        (":w 'alpha beta'", "alpha beta"),
        (":w \"alpha beta\"", "alpha beta"),
        (":w a'b c'd", "ab cd"),
        (":w a\"b c\"d", "ab cd"),
        (":w ''", ""),
        (":w \"\"", ""),
        (":w '\\n'", "\\n"),
        (":w \"\\n\"", "\n"),
        (":w \"\\t\"", "\t"),
        (":w \"\\\\\"", "\\"),
        (":w \"\\\"\"", "\""),
        (":w \"\\%\"", "%"),
        (":w %%", "%"),
        (":w %", "/home/u/proj/main.c"),
        (":w \"%\"", "/home/u/proj/main.c"),
        (":w %p", "/home/u/proj/main.c"),
        (":w %d", "/home/u/proj"),
        (":w %h", "/home/u/proj"),
        (":w %b", "main.c"),
        (":w %l", "1"),
        (":w %c", "5"),
        (":w '%d/lit.c'", "%d/lit.c"),
        (":w %d/backup.txt", "/home/u/proj/backup.txt"),
        (":w \"%d/my file.c\"", "/home/u/proj/my file.c"),
        (":w one\\\ttwo", "one\ttwo"),
        (":w '$HOME'", "$HOME"),
        (":w \"$HOME\"", "$HOME"),
        (":w a\\\"b", "a\"b"),
        (":w a\\'b", "a'b"),
        (":w a\\\\b", "a\\b"),
        (":w 'it''s'", "its"),
        (":w x'y'z", "xyz"),
        (":w x\"y\"z", "xyz"),
        (":w 日本語", "日本語"),
        (":w 👨‍👩‍👧‍👦", "👨‍👩‍👧‍👦"),
        (":w a-b_c.1", "a-b_c.1"),
        (":w ./relative", "./relative"),
        (":w a=b", "a=b"),
    ]
    assert(rows.len >= 40, "at least forty rows")
    for row in rows {
        let (line, arg) = row
        assert_arg(mut ed, line, arg)
    }

    set_sel(mut ed, 0, 2)
    assert_arg(mut ed, ":w %s", "on")
    var binary = List[byte]()
    (mut binary).push(97 as byte)
    (mut binary).push(0 as byte)
    (mut binary).push(98 as byte)
    set_text(mut ed, binary)
    set_sel(mut ed, 0, 3)
    assert_error(mut ed, ":w %s", "NUL byte is not valid in a command line")

    assert_error(mut ed, ":w \"abc", "unterminated \"")
    assert_error(mut ed, ":w 'abc", "unterminated '")
    assert_error(mut ed, ":w \"\\q\"", "unknown escape '\\q'")
    assert_error(mut ed, ":w %z", "unknown expansion '%z'")
    set_sel(mut ed, 4, 4)
    assert_error(mut ed, ":w %s", "%s needs a selection")
    let b = ed.wins[ed.win].buf
    ed.bufs[b].path = ""
    ed.bufs[b].has_path = false
    assert_error(mut ed, ":w %", "buffer has no file name")
    var nul_line = bytes_of(":w a")
    (mut nul_line).push(0 as byte)
    (mut nul_line).push(98 as byte)
    let r = edit.cmd_parse(mut ed, nul_line)
    assert(!edit.cmd_parse_ok(r), "a NUL is refused")
    assert(is_text(r.err.msg, "NUL byte is not valid in a command line"), "the NUL message")
    assert(r.err.tok_lo == 4 && r.err.tok_hi == 5, "at the NUL")
}

fn t_cmdparse_fl_preserves_source_as_one_argument() {
    var ed = fixture()
    let r = parse(mut ed, ":fl answer + 1")
    assert(edit.cmd_parse_ok(r), ":fl parses")
    assert(r.argv.len == 2, "two words")
    assert(is_text(r.argv[0], "ed.fl.eval"), "ed.fl.eval")
    assert(is_text(r.argv[1], "answer + 1"), "the source verbatim")
}

fn t_cmdparse_group_close_full_name_and_abbrev() {
    var ed = fixture()
    for line in [":group.close", ":ed.group.close", ":gclose"] {
        let r = parse(mut ed, line)
        assert(edit.cmd_parse_ok(r), "{line}: parses ({show(r.err.msg)})")
        assert(r.argv.len == 1, "{line}: one word")
        assert(is_text(r.argv[0], "ed.group.close"), "{line}: ed.group.close")
    }
}

fn point(mut ed: edit.Ed, line: str, cursor: int) -> edit.CmdParsePoint {
    let p = edit.cmd_parse_point(mut ed, bytes_of(line), cursor) else {
        assert(false, "{line}: the point parser refused the line")
        return edit.cmdparsepoint_new()
    }
    p
}

fn t_cmdparse_resolution_bang_errors_and_parse_point() {
    var ed = fixture()
    assert(edit.cmd_parse_ok(parse(mut ed, ":ui.open value")), ":ui.open value")
    assert(edit.cmd_parse_ok(parse(mut ed, ":ui.o value")), ":ui.o value")
    let w = parse(mut ed, ":w! value")
    assert(edit.cmd_parse_ok(w) && w.bang, ":w! value carries the bang")
    assert_error(mut ed, ":ui.shrink extra", ":ui.shrink takes no arguments")
    assert_error_span(mut ed, ":quit extra", ":quit takes no arguments", 6, 11)
    assert_error(mut ed, ":1quit", ":quit takes no range")
    assert_error(mut ed, ":sort", ":ui.grow requires a range")
    assert_error(mut ed, ":not_a_command", "unknown command 'not_a_command' (try Tab)")
    let src = parse(mut ed, ":source")
    assert(edit.cmd_parse_ok(src) && is_text(src.argv[0], "ed.config.reload"), ":source")
    assert_error(mut ed, ":source old.vim", ":config.reload takes no arguments")
    assert_error(mut ed, ":cmdline.accept", "unknown command 'cmdline.accept' (try Tab)")
    assert_error(mut ed, ":!", "ed.shell.run needs a command")
    assert_error(mut ed, ":r !", "ed.shell.read needs a command")
    assert_error(mut ed, ":s", ":search.replace requires 1 argument")
    let s1 = parse(mut ed, ":s/a/b/g")
    assert(edit.cmd_parse_ok(s1) && s1.argv.len == 2 && is_text(s1.argv[1], "/a/b/g"), ":s/a/b/g")
    let s2 = parse(mut ed, ":%s#a#b#")
    assert(edit.cmd_parse_ok(s2) && is_text(s2.argv[1], "#a#b#"), ":%s#a#b#")
    assert(s2.range.kind == edit.RANGE_BUFFER, ":%s is the whole buffer")
    let g = parse(mut ed, ":g/re/d")
    assert(edit.cmd_parse_ok(g) && is_text(g.argv[1], "/re/d"), ":g/re/d")
    assert_error(mut ed, ":fl", ":fl needs Fletch source")

    let p1 = point(mut ed, ":w \"my fi", 9)
    assert(p1.command_known, "w is known")
    assert(p1.token_index == 1, "argument 1")
    assert(is_text(p1.stem, "my fi"), "the stem without its quote")
    assert(p1.token.lo == 3 && p1.token.hi == 9, "the token")
    let p2 = point(mut ed, ":w one ", 7)
    assert(p2.token_index == 2, "a fresh argument")
    assert(p2.token.lo == 7 && p2.token.hi == 7, "at the caret")

    assert_error(mut ed, ":file.w", "ambiguous: file.write, file.write_quit")
    assert_error(mut ed, ":file.open", ":file.open requires 1 argument")
}

// Sprint 57.18 §1 / DoD 3: the EXECUTING parser hands every `:!` body to
// the shell as one verbatim argument.
fn t_cmdparse_bang_execution_is_unchanged() {
    var ed = fixture()
    let rows = [
        (":!ls", "ed.shell.run", "ls", 2),
        (":!  ls -l", "ed.shell.run", "ls -l", 4),
        (":!ls | grep x > out", "ed.shell.run", "ls | grep x > out", 2),
        (":!echo \"a b\"", "ed.shell.run", "echo \"a b\"", 2),
        (":!echo 'a b'", "ed.shell.run", "echo 'a b'", 2),
        (":!echo a\\ b", "ed.shell.run", "echo a\\ b", 2),
        (":!echo %", "ed.shell.run", "echo %", 2),
        (":!!top", "ed.shell.run", "!top", 2),
        (":!!", "ed.shell.run", "!", 2),
        (":%!sort", "ed.shell.run", "sort", 3),
        (":1,2!fmt -w 40", "ed.shell.run", "fmt -w 40", 5),
        (":r !date", "ed.shell.read", "date", 4),
        (":r !!date", "ed.shell.read", "!date", 4),
    ]
    for row in rows {
        let (line, command, arg, arg_lo) = row
        let r = parse(mut ed, line)
        assert(edit.cmd_parse_ok(r), "{line}: parses ({show(r.err.msg)})")
        assert(is_text(r.argv[0], command), "{line}: {command}")
        assert(r.argv.len == 2, "{line}: two words")
        assert(is_text(r.argv[1], arg), "{line}: the body verbatim")
        assert(r.arg_tok[1].lo == arg_lo, "{line}: the body starts at {arg_lo}")
        assert(r.arg_tok[1].hi == line.len, "{line}: and runs to the end")
    }
    assert_error(mut ed, ":!", "ed.shell.run needs a command")
    assert_error(mut ed, ":r !", "ed.shell.read needs a command")
}

// Sprint 57.18 §1 / 57.23 §5: the caret's word inside a bang body is the
// shell lexer's (`test_cmdparse.c`'s rows: line, cursor, index, stem,
// token).
fn t_cmdparse_bang_point_splits_the_shell_body() -> int {
    var ed = fixture()
    let rows = [
        (":!", 2, 0, "", 2, 2),
        (":!ch", 4, 0, "ch", 2, 4),
        (":!  ch", 6, 0, "ch", 4, 6),
        (":!ch", 3, 0, "c", 2, 3),
        (":%!so", 5, 0, "so", 3, 5),
        (":1,2!so", 7, 0, "so", 5, 7),
        (":r !da", 6, 0, "da", 4, 6),
        (":!!to", 5, 0, "to", 3, 5),
        (":!ls ", 5, 1, "", 5, 5),
        (":!ls sr", 7, 1, "sr", 5, 7),
        (":!ls a b", 8, 2, "b", 7, 8),
        (":!cat \"my fi", 12, 1, "my fi", 6, 12),
        (":!cat 'my fi", 12, 1, "my fi", 6, 12),
        (":!cat \"my file\" ne", 18, 2, "ne", 16, 18),
        (":!cat my\\ fi", 12, 1, "my fi", 6, 12),
        (":!cat \"a\\\"b", 11, 1, "a\"b", 6, 11),
        (":!echo %", 8, 1, "%", 7, 8),
        (":!ls | gr", 9, 0, "gr", 7, 9),
        (":!ls   x", 5, 1, "", 5, 5),
    ]
    for row in rows {
        let (line, cursor, index, stem, lo, hi) = row
        let p = point(mut ed, line, cursor)
        assert(p.bang_body, "{line}: a bang body")
        assert(p.has_shell, "{line}: the shell context")
        assert(p.token_index == index, "{line}: word {index} (it says {p.token_index})")
        assert(is_text(p.stem, stem), "{line}: stem `{stem}`")
        assert(
            p.token.lo == lo && p.token.hi == hi,
            "{line}: token [{lo},{hi}) (it says [{p.token.lo},{p.token.hi}))",
        )
    }
    0
}

fn t_cmdparse_bang_body_does_not_swallow_the_bang_flag() {
    var ed = fixture()
    let p1 = point(mut ed, ":w! fil", 7)
    assert(!p1.bang_body, ":w! is the bang flag")
    assert(p1.token_index == 1, "argument 1")
    assert(is_text(p1.stem, "fil"), "fil")
    let p2 = point(mut ed, ":!ls", 1)
    assert(!p2.bang_body, "a caret before the bang")
    assert(p2.token_index == 0, "the command name")
    assert(p2.stem.len == 0, "an empty stem")
    let p3 = point(mut ed, ":ui.open val", 12)
    assert(!p3.bang_body, "an ordinary command")
    assert(p3.token_index == 1, "argument 1")
    assert(is_text(p3.stem, "val"), "val")
}

fn t_cmdparse_bang_pipe_body_stays_verbatim() -> int {
    var ed = fixture()
    let r = parse(mut ed, ":!ls | gr")
    assert(edit.cmd_parse_ok(r), "parses")
    assert(is_text(r.argv[0], "ed.shell.run"), "ed.shell.run")
    assert(r.argv.len == 2 && is_text(r.argv[1], "ls | gr"), "one verbatim body")
    assert(r.arg_tok[1].lo == 2 && r.arg_tok[1].hi == 9, "its span")
    let p1 = point(mut ed, ":!ls | gr", 9)
    assert(p1.bang_body && p1.has_shell, "a bang body with its shell context")
    assert(p1.shell.pos == edit.SH_POS_COMMAND, "gr is a command word")
    assert(p1.shell.replace_lo == 7 && p1.shell.replace_hi == 9, "the replace span, rebased")
    assert(is_text(p1.shell.stem, "gr"), "stem gr")
    assert(p1.token.lo == 7 && p1.token_index == 0, "the token")
    let p2 = point(mut ed, ":r !cat > ou", 12)
    assert(p2.has_shell, "the read spelling's body")
    assert(p2.shell.pos == edit.SH_POS_REDIRECT, "a redirection target")
    assert(p2.token.lo == 10, "rebased onto its body start")
    assert(p2.shell.argc != 0 && is_text(p2.shell.argv[0], "cat"), "argv[0] cat")
    let p = point(mut ed, ":w fi", 5)
    assert(!p.bang_body && !p.has_shell, "not a bang body: no shell context")
    0
}

fn main() {
    // The session's `--yew-env0` runs this binary (`unit_main.c:14-19`).
    if edit.shsession_env0_requested() {
        os_exit(edit.shsession_env0_main())
    }
    env_set("YEW_LOG", "/dev/null") else |_| {}
    var skips = 0
    t_cmdparse_prof_subcommands_route_to_registry()
    t_cmdparse_tokenizer_expansion_matrix()
    t_cmdparse_fl_preserves_source_as_one_argument()
    t_cmdparse_group_close_full_name_and_abbrev()
    t_cmdparse_resolution_bang_errors_and_parse_point()
    t_cmdparse_bang_execution_is_unchanged()
    skips += t_cmdparse_bang_point_splits_the_shell_body()
    t_cmdparse_bang_body_does_not_swallow_the_bang_flag()
    skips += t_cmdparse_bang_pipe_body_stays_verbatim()
    print("cmdparse_test: 9 cases run, {skips} SKIP")
}
