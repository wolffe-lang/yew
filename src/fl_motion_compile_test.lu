//! member: false
//! sagitta 9ace98c2 tests/unit/test_fl_motion_compile.c:65-109, both cases.

use fl

fn compile_motion(mut vm: fl.FlVm, text: str) -> fl.FlValue {
    var src = List[byte]()
    for b in text.bytes() { (mut src).push(b) }
    let p = fl.fl_parse(src, 0, mut vm.dc, mut vm.strings)
    assert(!p.had_error)
    let f = fl.fl_compile(mut vm, p, 0, fl.fl_origin_new(4, 0)) else fl.fl_nil()
    assert(f.t == 7)
    let at = fl.fl_obj_index(vm, f)
    for v in vm.gc.slots[at].vals { if v.t == 10 { return copy v } }
    assert(false)
    fl.fl_nil()
}

fn main() {
    var strings = fl.fl_strings()
    var vm = fl.fl_vm_new(take strings)
    let m = compile_motion(mut vm, "@[ H(> H(< v) ^) ]\n")
    let at = fl.fl_obj_index(vm, m)
    assert(vm.gc.slots[at].ops.len == 6)
    assert(vm.gc.slots[at].ops[0].kind == 2 && vm.gc.slots[at].ops[0].arg == 5)
    assert(vm.gc.slots[at].ops[2].kind == 2 && vm.gc.slots[at].ops[2].arg == 2)
    assert(vm.gc.slots[at].ops[5].ch == 94)
    print("PASS fl_motion_compile flattens_nested_highlight_extents")
    let p = compile_motion(mut vm, "@[ > 1> av 1av H(1<) ]\n")
    let pi = fl.fl_obj_index(vm, p)
    assert(vm.gc.slots[pi].ops.len == 6)
    assert(vm.gc.slots[pi].ops[0].count == 1)
    assert(vm.gc.slots[pi].ops[0].flags & 2 == 0)
    assert(vm.gc.slots[pi].ops[1].flags & 2 != 0)
    assert(vm.gc.slots[pi].ops[2].flags & 1 != 0 && vm.gc.slots[pi].ops[2].flags & 2 == 0)
    assert(vm.gc.slots[pi].ops[3].flags & 1 != 0 && vm.gc.slots[pi].ops[3].flags & 2 != 0)
    assert(vm.gc.slots[pi].ops[4].flags & 2 == 0 && vm.gc.slots[pi].ops[5].flags & 2 != 0)
    print("PASS fl_motion_compile preserves_explicit_one_count")
}
