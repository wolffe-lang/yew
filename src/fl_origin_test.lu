//! member: false
//! Pinned origin.h:50-99 and origin.c:230-257 scalar table regression.

use fl

fn main() {
    assert(fl.FL_CAP_ALL == 31)
    assert(fl.fl_cap_name(fl.FL_CAP_FS_READ) == "fs.read")
    assert(fl.fl_cap_name(fl.FL_CAP_FS_WRITE) == "fs.write")
    assert(fl.fl_cap_name(fl.FL_CAP_SHELL) == "shell")
    assert(fl.fl_cap_name(fl.FL_CAP_NET) == "net")
    assert(fl.fl_cap_name(fl.FL_CAP_CLIPBOARD) == "clipboard")
    assert(fl.fl_cap_name(3) == "capability")
    for i in 0..6 {
        let o = fl.fl_origin_new(i, fl.FL_CAP_ALL)
        assert(o.kind == i && o.path_id == 0 && o.caps == 31 && o.principal_id == 0)
    }
    assert(fl.fl_origin_kind_name(fl.FL_ORIGIN_BUILTIN) == "a builtin")
    assert(fl.fl_origin_kind_name(fl.FL_ORIGIN_CONFIG) == "the user config")
    assert(fl.fl_origin_kind_name(fl.FL_ORIGIN_WORKSPACE) == "the workspace config")
    assert(fl.fl_origin_kind_name(fl.FL_ORIGIN_PLUGIN) == "a plugin")
    assert(fl.fl_origin_kind_name(fl.FL_ORIGIN_CLI) == "the command line")
    assert(fl.fl_origin_kind_name(fl.FL_ORIGIN_REPL) == "the REPL")
    assert(fl.fl_origin_kind_name(99) == "an unknown origin")
    print("origin scalar tables: PASS")
}
