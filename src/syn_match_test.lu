//! member: false
//! Direct transition/matching seams from sagitta engine.c:2450–2565,
//! :2963–3173 and :3389–3441 at 9ace98c2. Uses the existing Pike VM,
//! never a replacement tokenizer. Definitions are constructed as test data.
use fl
use search
use syn

fn pattern(mut def: syn.SynDefinition, source: str) -> int {
    var err = search.re_err_new()
    let re = search.re_compile_str(source, 0, mut err) else {
        assert(false, "test pattern failed: {err.msg}")
        return 0
    }
    let id = def.regexes.len
    (mut def.regexes).push(re)
    id
}

fn aux(mut def: syn.SynDefinition, value: str) -> int {
    fl.fl_intern(mut def.strings, value.bytes(), 0, value.len)
}

fn anchored() {
    var def = syn.syn_definition_new("toy")
    let id = pattern(mut def, "abc")
    let rule = syn.syn_rule_new(id, 1)
    let state = syn.syn_state_root(0, 0)
    var scratch = syn.syn_match_scratch_new()
    assert(!syn.syn_rule_match(mut scratch, def, state, 0, rule, "xabc".bytes(), 0), "not unanchored search")
    assert(syn.syn_rule_match(mut scratch, def, state, 0, rule, "xabc".bytes(), 1), "match at exact offset")
    assert(scratch.matched.lo[0] == 1 && scratch.matched.hi[0] == 4, "byte-relative full match")
    let bol = syn.syn_rule_new(pattern(mut def, "^abc"), 1)
    assert(!syn.syn_rule_match(mut scratch, def, state, 0, bol, "xabc".bytes(), 1), "BOL means physical line start")
    assert(syn.syn_rule_match(mut scratch, def, state, 0, bol, "abc".bytes(), 0), "BOL at zero")
}

fn capture_overlay() {
    var def = syn.syn_definition_new("toy")
    var rule = syn.syn_rule_new(pattern(mut def, "(a(b))(c)"), 16)
    rule.caps[1] = 1 as byte
    rule.caps[2] = 2 as byte
    rule.caps[3] = 12 as byte
    var scratch = syn.syn_match_scratch_new()
    let state = syn.syn_state_root(0, 0)
    assert(syn.syn_rule_match(mut scratch, def, state, 0, rule, "abc".bytes(), 0), "capture match")
    var spans = syn.syn_spans_new(8)
    syn.syn_emit_match(mut spans, rule, scratch.matched, 3)
    assert(spans.n == 3, "nested capture edges split spans")
    assert(syn.syn_span_attr(spans, 0) == 1, "outer capture begins")
    assert(syn.syn_span_attr(spans, 1) == 2, "later inner capture overrides")
    assert(syn.syn_span_attr(spans, 2) == 12, "third capture")
    assert(syn.syn_span_start(spans, 2) == 2, "third byte begins third span")
    syn.syn_spans_clear(mut spans, 1)
    syn.syn_emit_match(mut spans, rule, scratch.matched, 1)
    assert(spans.n == 1 && syn.syn_span_len(spans, 0) == 1, "consume ends before later captures")
}

fn heredoc_eq() {
    var def = syn.syn_definition_new("toy")
    var state = syn.syn_state_root(0, 0)
    syn.syn_state_set_aux(mut state, 0, aux(mut def, "END"))
    var rule = syn.syn_rule_new(0, 16)
    rule.aux_match = syn.SYN_AUXM_LINE_EQ
    var scratch = syn.syn_match_scratch_new()
    assert(syn.syn_rule_match(mut scratch, def, state, 0, rule, "END".bytes(), 0), "exact heredoc end")
    assert(!syn.syn_rule_match(mut scratch, def, state, 0, rule, " END".bytes(), 0), "no implicit space strip")
    syn.syn_state_set_flags(mut state, syn.SYN_F_STRIP)
    assert(syn.syn_rule_match(mut scratch, def, state, 0, rule, "\tEND".bytes(), 0), "strip TABs only")
    assert(!syn.syn_rule_match(mut scratch, def, state, 0, rule, " END".bytes(), 0), "strip flag still keeps spaces")
    rule.aux_match = syn.SYN_AUXM_LINE_EQ_WS
    assert(syn.syn_rule_match(mut scratch, def, state, 0, rule, " \tEND".bytes(), 0), "explicit whitespace strip")
    assert(!syn.syn_rule_match(mut scratch, def, state, 0, rule, "ENDx".bytes(), 0), "whole line equality")
}

fn literal_affixes() {
    var def = syn.syn_definition_new("toy")
    var state = syn.syn_state_root(0, 0)
    syn.syn_state_set_aux(mut state, 0, aux(mut def, "END"))
    var rule = syn.syn_rule_new(0, 12)
    rule.aux_match = syn.SYN_AUXM_LITERAL
    rule.aux_pre = aux(mut def, "x")
    rule.aux_post = aux(mut def, "y")
    var scratch = syn.syn_match_scratch_new()
    assert(syn.syn_rule_match(mut scratch, def, state, 0, rule, "_xENDy_".bytes(), 1), "affixes match at scan offset")
    assert(scratch.matched.hi[0] == 6, "affix end")
    assert(!syn.syn_rule_match(mut scratch, def, state, 0, rule, "xENDz".bytes(), 0), "postfix required")
}

fn fences_and_indent() {
    var def = syn.syn_definition_new("toy")
    var state = syn.syn_state_root(0, 0)
    syn.syn_state_set_aux(mut state, 0, aux(mut def, "```"))
    var rule = syn.syn_rule_new(0, 32)
    rule.aux_match = syn.SYN_AUXM_FENCE_CLOSE
    var scratch = syn.syn_match_scratch_new()
    assert(syn.syn_rule_match(mut scratch, def, state, 0, rule, "  ````` \t".bytes(), 0), "long closing fence")
    assert(!syn.syn_rule_match(mut scratch, def, state, 0, rule, "``".bytes(), 0), "short fence not close")
    assert(!syn.syn_rule_match(mut scratch, def, state, 0, rule, "    ```".bytes(), 0), "four-space fence not close")
    assert(!syn.syn_rule_match(mut scratch, def, state, 0, rule, "~~~".bytes(), 0), "wrong marker")
    syn.syn_state_set_aux(mut state, 0, 8)
    rule.aux_match = syn.SYN_AUXM_INDENT_LT
    assert(syn.syn_rule_match(mut scratch, def, state, 0, rule, " x".bytes(), 0), "nonblank dedent")
    assert(!syn.syn_rule_match(mut scratch, def, state, 0, rule, "\tx".bytes(), 0), "TAB advances to eight")
    assert(!syn.syn_rule_match(mut scratch, def, state, 0, rule, "   ".bytes(), 0), "blank lines stay content")
}

fn set_aux_capture() {
    var def = syn.syn_definition_new("toy")
    var rule = syn.syn_rule_new(pattern(mut def, "( +)([A-Z]+)( +)"), 12)
    rule.flags = syn.SYN_RULE_SET_AUX | syn.SYN_RULE_STRIP
    rule.aux_group = 0
    var scratch = syn.syn_match_scratch_new()
    var state = syn.syn_state_root(0, 0)
    let line = "  END  ".bytes()
    assert(syn.syn_rule_match(mut scratch, def, state, 0, rule, line, 0), "capture before setting aux")
    assert(syn.syn_rule_set_aux(mut def.strings, mut state, 0, rule, line, scratch.matched), "aux stored")
    let id = syn.syn_state_aux(state, 0)
    assert(id == aux(mut def, "END"), "strip both capture ends")
    var number = syn.syn_rule_new(pattern(mut def, "([0-9]+)"), 9)
    number.flags = syn.SYN_RULE_SET_AUX | syn.SYN_RULE_AUX_INT
    number.aux_group = 1
    number.aux_add = 2
    assert(syn.syn_rule_match(mut scratch, def, state, 0, number, "0017".bytes(), 0), "numeric capture")
    assert(syn.syn_rule_set_aux(mut def.strings, mut state, 0, number, "0017".bytes(), scratch.matched), "numeric aux stored")
    assert(syn.syn_state_aux(state, 0) == 19, "decimal plus offset")
}

fn local_ops() {
    var state = syn.syn_state_root(0, 2)
    var rule = syn.syn_rule_new(0, 0)
    rule.op = syn.SYN_OP_PUSH
    (mut rule.pushes).push(3)
    (mut rule.pushes).push(4)
    syn.syn_apply_local_op(mut state, rule)
    assert(syn.syn_state_depth(state) == 3, "multi-push")
    assert(syn.syn_state_ctx(state, 1) == 3 && syn.syn_state_ctx(state, 2) == 4, "outermost first")
    syn.syn_state_set_aux(mut state, 0, 7)
    syn.syn_state_set_flags(mut state, syn.SYN_F_STRIP)
    rule.op = syn.SYN_OP_POP
    rule.nop = 2
    rule.flags = syn.SYN_RULE_CLR_AUX
    syn.syn_apply_local_op(mut state, rule)
    assert(syn.syn_state_depth(state) == 1, "multi-pop")
    assert(syn.syn_state_aux(state, 0) == 0, "actual pop clears aux")
    assert(syn.syn_state_flags(state) & syn.SYN_F_STRIP == 0, "actual pop clears strip")
}

fn predicates() {
    var rule = syn.syn_rule_new(0, 0)
    var state = syn.syn_state_root(0, 0)
    rule.flags = syn.SYN_RULE_FIRST_LINE
    assert(syn.syn_rule_enabled(rule, state), "first line enabled")
    syn.syn_state_set_flags(mut state, syn.SYN_F_PAST_FIRST)
    assert(!syn.syn_rule_enabled(rule, state), "first-line rule not reused")
    rule.flags = 0
    rule.value_pred = syn.SYN_VALUE_SET
    assert(!syn.syn_rule_enabled(rule, state), "value required")
    syn.syn_state_set_flags(mut state, syn.SYN_F_VALUE)
    assert(syn.syn_rule_enabled(rule, state), "value predicate")
    rule.value_pred = syn.SYN_VALUE_CLEAR
    assert(!syn.syn_rule_enabled(rule, state), "clear predicate opposite")
}

fn main() {
    let selected = (env_get("YEW_SYN_MATCH_CASE") else "-1").to_int() else -1
    var i = 0
    while i < 8 {
        if selected == -1 || selected == i {
            match i {
                0 => anchored(),
                1 => capture_overlay(),
                2 => heredoc_eq(),
                3 => literal_affixes(),
                4 => fences_and_indent(),
                5 => set_aux_capture(),
                6 => local_ops(),
                _ => predicates(),
            }
            print("syn_match_case_{i}: PASS")
        }
        i += 1
    }
}
