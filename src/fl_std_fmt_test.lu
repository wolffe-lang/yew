//! member: false
//! Sprint 31 deliverable 6, the `fmt` module: sagitta 9ace98c2
//! tests/unit/test_fl_std_fmt.c:1-648 (14 cases, registry order:
//! tests/unit/registry.c:1902 runs the 500-value round trip first, then
//! :2075-2087), over flfix. The pin's 100,000-template fmt.f fuzz
//! (s31-stdlib.md:627) is tests/fuzz/fuzz_fl_std.c:235-305's sweep_template,
//! not a unit case: it is ported with that fuzzer (tools/fuzz-fl-std).

use fl
use flfix
use std.math.float as floats

fn bl(xs: List[int]) -> List[byte] {
    var out = List[byte]()
    for x in xs { (mut out).push(x as byte) }
    out
}

fn show(b: List[byte]) -> str {
    var out = ""
    for x in b {
        let c = x as int
        out = if c >= 32 && c < 127 then out + "{x as int as char}" else out + "\\x{c}"
    }
    out
}

// test_fl_std_fmt.c:199-222, THE repr LAW: the output re-reads through
// fl_parse_literal, adding no diagnostic to the fixture's context.
fn repr_parses(mut f: flfix.FlFix, expr: str) {
    let before = f.ndiag
    let out = flfix.run_bytes(mut f, "import fmt\nreturn fmt.repr({expr})\n")
    assert(out.len == 0 || out[0] as int != 33)
    let entries = f.vm.dc.entries.len
    let id = fl.fl_diag_add_file(mut f.vm.dc, "t.fl", out)
    let p = fl.fl_parse_literal(out, id, mut f.vm.dc, mut f.vm.strings)
    if p.root < 0 { eprint("repr did not re-read: {show(out)}") }
    assert(p.root >= 0)
    assert(f.ndiag + f.vm.dc.entries.len - entries == before)
}

fn fl_fmt_f_copies_text_and_unescapes_braces() {
    var f = flfix.open()
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"plain\")\n", "plain")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{{{}}}}\")\n", "{{}}")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"a{{}}b\", 1)\n", "a1b")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{}} {{}} {{}}\", 1, 2, 3)\n", "1 2 3")
    flfix.close(mut f)
}

fn fl_fmt_f_resolves_arguments_three_ways() {
    var f = flfix.open()
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{1}} {{0}}\", \"a\", \"b\")\n", "b a")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{name}}!\", {{name: \"yew\"}})\n", "yew!")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{0}}{{0}}\", \"x\")\n", "xx")
    flfix.close(mut f)
}

fn fl_fmt_f_aligns_in_display_cells() {
    var f = flfix.open()
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"[{{:>5}}]\", \"ab\")\n", "[   ab]")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"[{{:<5}}]\", \"ab\")\n", "[ab   ]")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"[{{:^5}}]\", \"ab\")\n", "[ ab  ]")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"[{{:*^5}}]\", \"ab\")\n", "[*ab**]")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"[{{:^^5}}]\", \"ab\")\n", "[^ab^^]")
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.f(\"[{{:>10}}]\", \"\\u{{6F22}}\\u{{5B57}}\")\n",
        "[      漢字]",
    )
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"[{{:>2}}]\", \"abcd\")\n", "[abcd]")
    flfix.close(mut f)
}

fn fl_fmt_f_renders_every_type_letter() {
    var f = flfix.open()
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{:s}}\", \"a\")\n", "a")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{:d}}\", 42)\n", "42")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{:d}}\", 3.0)\n", "3")
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.f(\"{{:d}}\", 3.5)\n",
        "!type: fmt.f: {{:d}} at byte 0 needs an integral value",
    )
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{:x}}\", 255)\n", "ff")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{:X}}\", 255)\n", "FF")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{:o}}\", 8)\n", "10")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{:b}}\", 5)\n", "101")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{:.2f}}\", 1.5)\n", "1.50")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{:.2e}}\", 1234.0)\n", "1.23e+03")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{:.1%}}\", 0.5)\n", "50.0%")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{:?}}\", \"a\")\n", "\"a\"")
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.f(\"{{:x}}\", \"a\")\n",
        "!type: fmt.f: {{:x}} at byte 0 needs an int, found str",
    )
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.f(\"{{:f}}\", \"a\")\n",
        "!type: fmt.f: {{:f}} at byte 0 needs a number, found str",
    )
    flfix.close(mut f)
}

fn fl_fmt_f_signs_and_zero_pads_numbers() {
    var f = flfix.open()
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{:+d}}\", 42)\n", "+42")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{: d}}\", 42)\n", " 42")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{:+d}}\", -42)\n", "-42")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"{{:08.3f}}\", -1.5)\n", "-001.500")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"[{{:5}}]\", 42)\n", "[   42]")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"[{{:<5}}]\", 42)\n", "[42   ]")
    flfix.eq(mut f, "import fmt\nreturn fmt.f(\"[{{:5}}]\", \"ab\")\n", "[ab   ]")
    flfix.close(mut f)
}

fn fl_fmt_f_refuses_a_malformed_directive() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.f(\"{{:zz}}\", 1)\n",
        "!type: fmt.f: bad directive \"{{:zz}}\" at byte 0",
    )
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.f(\"ab {{\")\n",
        "!type: fmt.f: bad directive \"{{\" at byte 3",
    )
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.f(\"ab }}\")\n",
        "!type: fmt.f: bad directive \"}}\" at byte 3",
    )
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.f(\"{{}}\")\n",
        "!index: fmt.f: directive at byte 0 wants argument 0, 0 given",
    )
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.f(\"{{x}}\", {{y: 1}})\n",
        "!index: fmt.f: no key \"x\" in argument 1",
    )
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.f(\"{{x}}\", 1)\n",
        "!type: fmt.f: directive at byte 0 names \"x\", so argument 1 must be map, found int",
    )
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.f(\"{{:99999999}}\", 1)\n",
        "!limit: fmt.f: field width at byte 0 exceeds 1048576 cells",
    )
    flfix.close(mut f)
}

fn fl_fmt_str_is_display_and_never_raises() {
    var f = flfix.open()
    flfix.eq(mut f, "import fmt\nreturn fmt.str(nil)\n", "nil")
    flfix.eq(mut f, "import fmt\nreturn fmt.str(true)\n", "true")
    flfix.eq(mut f, "import fmt\nreturn fmt.str(42)\n", "42")
    flfix.eq(mut f, "import fmt\nreturn fmt.str(-7)\n", "-7")
    flfix.eq(mut f, "import fmt\nreturn fmt.str(3.0)\n", "3.0")
    flfix.eq(mut f, "import fmt\nreturn fmt.str(0.1)\n", "0.1")
    flfix.eq(mut f, "import fmt\nreturn fmt.str(1.0e20)\n", "1.0e+20")
    flfix.eq(mut f, "import fmt\nreturn fmt.str(\"hi\")\n", "hi")
    flfix.eq(mut f, "import fmt\nreturn fmt.str([1, \"a\", nil])\n", "[1, \"a\", nil]")
    flfix.eq(mut f, "import fmt\nreturn fmt.str({{a: 1, b: [2]}})\n", "{{a: 1, b: [2]}}")
    flfix.eq(mut f, "import fmt\nreturn fmt.str({{}})\n", "{{}}")
    flfix.eq(mut f, "import fmt\nreturn fmt.str([])\n", "[]")
    flfix.eq(mut f, "import fmt\nlet l = [1]\nl[0] = l\nreturn fmt.str(l)\n", "[[...]]")
    flfix.eq(mut f, "import fmt\nreturn fmt.str(fmt.str)\n", "<fn fmt.str>")
    flfix.close(mut f)
}

fn fl_fmt_repr_round_trips_through_the_literal_parser() {
    var f = flfix.open()
    repr_parses(mut f, "nil")
    repr_parses(mut f, "true")
    repr_parses(mut f, "0")
    repr_parses(mut f, "-1")
    repr_parses(mut f, "0.1")
    repr_parses(mut f, "3.0")
    repr_parses(mut f, "1.0e20")
    repr_parses(mut f, "0.0 - 0.0")
    repr_parses(mut f, "\"\"")
    repr_parses(mut f, "\"a\\nb\\t\\\"c\\\"\"")
    repr_parses(mut f, "[]")
    repr_parses(mut f, "{{}}")
    repr_parses(mut f, "[1, [2, [3, []]]]")
    repr_parses(mut f, "{{a: 1, \"b c\": [nil, true], \"9\": {{}}}}")
    repr_parses(mut f, "{{1: \"one\", 2: [2.5]}}")
    flfix.close(mut f)
}

fn fl_fmt_repr_escapes_exactly_the_s25_table() {
    var f = flfix.open()
    flfix.eq(mut f, "import fmt\nreturn fmt.repr(\"a\\nb\")\n", "\"a\\nb\"")
    flfix.eq(mut f, "import fmt\nreturn fmt.repr(\"q\\\"\\\\\")\n", "\"q\\\"\\\\\"")
    flfix.eq(mut f, "import fmt\nreturn fmt.repr(\"\\t\\r\")\n", "\"\\t\\r\"")
    flfix.eq(mut f, "import fmt\nreturn fmt.repr(\"\\x01\\x7f\")\n", "\"\\x01\\x7f\"")
    flfix.eq_bytes(mut f, "import fmt\nreturn fmt.repr(\"a\\x80b\")\n", bl([34, 97, 128, 98, 34]))
    flfix.eq(mut f, "import fmt\nreturn fmt.repr(\"\\u{{6F22}}\")\n", "\"漢\"")
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.repr({{a: 1, \"b c\": 2, 3: 4}})\n",
        "{{a: 1, \"b c\": 2, 3: 4}}",
    )
    flfix.eq(mut f, "import fmt\nreturn fmt.repr({{\"nil\": 1}})\n", "{{\"nil\": 1}}")
    flfix.eq(mut f, "import fmt\nreturn fmt.repr({{\"_x9\": 1}})\n", "{{_x9: 1}}")
    flfix.close(mut f)
}

fn fl_fmt_repr_pretty_is_the_s25_workspace_format() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.repr([1, [2, 3]], 2)\n",
        "[\n  1,\n  [\n    2,\n    3,\n  ],\n]",
    )
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.repr({{a: {{b: 1}}}}, 2)\n",
        "{{\n  a: {{\n    b: 1,\n  }},\n}}",
    )
    flfix.eq(mut f, "import fmt\nreturn fmt.repr([], 2)\n", "[\n]")
    flfix.eq(mut f, "import fmt\nreturn fmt.repr([1], 4)\n", "[\n    1,\n]")
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.repr(1, 20)\n",
        "!type: fmt.repr: indent must be 0..16, found 20",
    )
    flfix.close(mut f)
}

fn fl_fmt_repr_raises_on_what_12_cannot_spell() {
    var f = flfix.open()
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.repr(fmt.repr)\n",
        "!type: fmt.repr: a fn has no pure-literal form",
    )
    flfix.eq(
        mut f,
        "import fmt\nlet l = [1]\nl[0] = l\nreturn fmt.repr(l)\n",
        "!type: fmt.repr: cycle at [0]",
    )
    flfix.eq(
        mut f,
        "import fmt\nlet m = {{tabs: [{{}}]}}\nm.tabs[0].parent = m\nreturn fmt.repr(m)\n",
        "!type: fmt.repr: cycle at .tabs[0].parent",
    )
    flfix.eq(
        mut f,
        "import fmt\nimport math\nreturn fmt.repr(math.nan)\n",
        "!type: fmt.repr: nan has no float literal",
    )
    flfix.eq(
        mut f,
        "import fmt\nimport math\nreturn fmt.repr(math.inf)\n",
        "!type: fmt.repr: inf has no float literal",
    )
    flfix.eq(
        mut f,
        "import fmt\nimport math\nreturn fmt.repr(math.int_min)\n",
        "!type: fmt.repr: -9223372036854775808 has no integer literal; its magnitude is one past the i64 maximum",
    )
    flfix.eq(
        mut f,
        "import fmt\nimport map\nlet m = {{}}\nmap.set(m, true, 1)\nreturn fmt.repr(m)\n",
        "!type: fmt.repr: map key true is a bool, which pure-literal syntax cannot spell",
    )
    flfix.eq(
        mut f,
        "import fmt\nimport map\nlet m = {{}}\nmap.set(m, 0 - 1, 1)\nreturn fmt.repr(m)\n",
        "!type: fmt.repr: map key -1 is negative, which pure-literal syntax cannot spell",
    )
    flfix.eq(
        mut f,
        "import fmt\nimport map\nlet m = {{}}\nmap.set(m, true, 1)\nreturn fmt.str(m)\n",
        "{{true: 1}}",
    )
    flfix.close(mut f)
}

fn fl_fmt_int_hex_and_float_render_scalars() {
    var f = flfix.open()
    flfix.eq(mut f, "import fmt\nreturn fmt.int(255)\n", "255")
    flfix.eq(mut f, "import fmt\nreturn fmt.int(255, 16)\n", "ff")
    flfix.eq(mut f, "import fmt\nreturn fmt.int(255, 2)\n", "11111111")
    flfix.eq(mut f, "import fmt\nreturn fmt.int(35, 36)\n", "z")
    flfix.eq(mut f, "import fmt\nreturn fmt.int(-5, 10, 4)\n", "-005")
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.int(5, 40)\n",
        "!type: fmt.int: base must be 2..36, found 40",
    )
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.int(5, 10, 99999999)\n",
        "!limit: fmt.int: width must be 0..1048576, found 99999999",
    )
    flfix.eq(mut f, "import fmt\nreturn fmt.hex(255)\n", "ff")
    flfix.eq(mut f, "import fmt\nreturn fmt.hex(255, 6)\n", "0000ff")
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.hex(5, 99999999)\n",
        "!limit: fmt.hex: width must be 0..1048576, found 99999999",
    )
    flfix.eq(mut f, "import fmt\nreturn fmt.float(1.0 / 3.0)\n", "0.3333333333333333")
    flfix.eq(mut f, "import fmt\nreturn fmt.float(1.5, 3)\n", "1.500")
    flfix.eq(mut f, "import fmt\nreturn fmt.float(2)\n", "2.0")
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.float(1.5, 99)\n",
        "!type: fmt.float: prec must be 0..17, found 99",
    )
    flfix.close(mut f)
}

fn fl_fmt_pad_pads_in_cells() {
    var f = flfix.open()
    flfix.eq(mut f, "import fmt\nreturn fmt.pad(\"ab\", 5)\n", "ab   ")
    flfix.eq(mut f, "import fmt\nreturn fmt.pad(\"ab\", 5, \">\")\n", "   ab")
    flfix.eq(mut f, "import fmt\nreturn fmt.pad(\"ab\", 5, \"^\", \".\")\n", ".ab..")
    flfix.eq(mut f, "import fmt\nreturn fmt.pad(\"ab\", 1)\n", "ab")
    flfix.eq(mut f, "import fmt\nreturn fmt.pad(\"\\u{{6F22}}\\u{{5B57}}\", 6, \">\")\n", "  漢字")
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.pad(\"ab\", 5, \"!\")\n",
        "!type: fmt.pad: align must be \"<\", \">\" or \"^\"",
    )
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.pad(\"ab\", 5, \"<\", \"xy\")\n",
        "!type: fmt.pad: fill must be one grapheme cluster",
    )
    flfix.eq(
        mut f,
        "import fmt\nreturn fmt.pad(\"ab\", 99999999)\n",
        "!limit: fmt.pad: width must be 0..1048576, found 99999999",
    )
    flfix.close(mut f)
}

// ---------------------------------------------------------------- //
// DoD 8: 500 generated values, compared DEEPLY (test_fl_std_fmt.c:384-648)
// ---------------------------------------------------------------- //

// xorshift64*, seeded fixed (test_fl_std_fmt.c:388-404).
struct Gen {
    state: wrapping[u64],
}

fn gen_next(mut g: Gen) -> wrapping[u64] {
    var x = g.state
    x = x ^ x >> 12
    x = x ^ x << 25
    x = x ^ x >> 27
    g.state = x
    x * 0x2545F4914F6CDD1D
}

fn gen_below(mut g: Gen, n: int) -> int { (gen_next(mut g) % n as wrapping[u64]) as int }

// C's `(i64)` of a u64: the same 64 bits read signed.
fn gen_signed(n: wrapping[u64]) -> int {
    let high: wrapping[u64] = 9223372036854775807
    if n <= high { return n as int }
    let all: wrapping[u64] = 18446744073709551615
    -((all - n) as int) - 1
}

// test_fl_std_fmt.c:406-417: invalid bytes and NULs included.
fn gen_str(mut vm: fl.FlVm, mut g: Gen) -> fl.FlValue {
    let n = gen_below(mut g, 24)
    var buf = List[byte]()
    for _ in 0..n { (mut buf).push((gen_next(mut g) & 255) as int as byte) }
    fl.fl_str_new(mut vm, buf)
}

// test_fl_std_fmt.c:419-480: a value inside §12's grammar.
fn gen_value(mut vm: fl.FlVm, mut g: Gen, depth: int) -> fl.FlValue {
    let pick = gen_below(mut g, if depth == 0 then 5 else 7)
    if pick == 0 { return fl.fl_nil() }
    if pick == 1 { return fl.fl_bool(gen_next(mut g) & 1 != 0) }
    // never INT64_MIN
    if pick == 2 { return fl.fl_int(gen_signed(gen_next(mut g)) | 1) }
    if pick == 3 {
        var d = floats.from_bits(gen_signed(gen_next(mut g)))
        // Finite only; repr has no spelling for the rest.
        if d != d || d > 1.7976931348623157e308 || d < -1.7976931348623157e308 {
            d = (gen_next(mut g) & 65535) as int as f64 / 8.0
        }
        return fl.fl_float(d)
    }
    if pick == 4 { return gen_str(mut vm, mut g) }
    if pick == 5 {
        let l = fl.fl_list_new(mut vm)
        let n = gen_below(mut g, 4)
        let root = fl.fl_temp_push(mut vm, l)
        for _ in 0..n {
            let item = gen_value(mut vm, mut g, depth - 1)
            let list = fl.fl_temp_get(vm, root)
            fl.fl_list_push(mut vm, list, item)
        }
        let out = fl.fl_temp_get(vm, root)
        fl.fl_temp_pop(mut vm, 1)
        return out
    }
    let m = fl.fl_map_new(mut vm)
    let n = gen_below(mut g, 4)
    let root = fl.fl_temp_push(mut vm, m)
    for _ in 0..n {
        // String and NON-NEGATIVE int keys: §12's pl_entry has no sign and no bool.
        var k = fl.fl_nil()
        if gen_next(mut g) & 1 != 0 {
            k = gen_str(mut vm, mut g)
        } else {
            k = fl.fl_int((gen_next(mut g) & 65535) as int)
        }
        let kr = fl.fl_temp_push(mut vm, k)
        let v = gen_value(mut vm, mut g, depth - 1)
        let map = fl.fl_temp_get(vm, root)
        let key = fl.fl_temp_get(vm, kr)
        let _ = fl.fl_map_set(mut vm, map, key, v)
        fl.fl_temp_pop(mut vm, 1)
    }
    let out = fl.fl_temp_get(vm, root)
    fl.fl_temp_pop(mut vm, 1)
    out
}

// test_fl_std_fmt.c:482-547: the parsed literal back as a value.
fn ast_to_value(mut vm: fl.FlVm, p: fl.FlProgram, node: int) -> fl.FlValue ! {none} {
    if node < 0 { return none }
    let n = copy p.nodes[node]
    if n.kind == fl.FL_A_LIT {
        if n.a == fl.FL_L_NIL { return fl.fl_nil() }
        if n.a == fl.FL_L_BOOL { return fl.fl_bool(n.i != 0) }
        if n.a == fl.FL_L_INT { return fl.fl_int(n.i) }
        if n.a == fl.FL_L_FLOAT { return fl.fl_float(n.f) }
        let bytes = fl.fl_string(vm.strings, n.i)
        return fl.fl_str_new(mut vm, bytes)
    }
    if n.kind == fl.FL_A_LIST {
        let l = fl.fl_list_new(mut vm)
        let root = fl.fl_temp_push(mut vm, l)
        for i in 0..n.b {
            let v = ast_to_value(mut vm, p, p.edges[n.a + i]) else {
                fl.fl_temp_pop(mut vm, 1)
                return none
            }
            let list = fl.fl_temp_get(vm, root)
            fl.fl_list_push(mut vm, list, v)
        }
        let out = fl.fl_temp_get(vm, root)
        fl.fl_temp_pop(mut vm, 1)
        return out
    }
    if n.kind == fl.FL_A_MAP {
        let m = fl.fl_map_new(mut vm)
        let root = fl.fl_temp_push(mut vm, m)
        for i in 0..n.c {
            let k = ast_to_value(mut vm, p, p.edges[n.a + i]) else {
                fl.fl_temp_pop(mut vm, 1)
                return none
            }
            let kr = fl.fl_temp_push(mut vm, k)
            let v = ast_to_value(mut vm, p, p.edges[n.b + i]) else {
                fl.fl_temp_pop(mut vm, 2)
                return none
            }
            let map = fl.fl_temp_get(vm, root)
            let key = fl.fl_temp_get(vm, kr)
            let _ = fl.fl_map_set(mut vm, map, key, v)
            fl.fl_temp_pop(mut vm, 1)
        }
        let out = fl.fl_temp_get(vm, root)
        fl.fl_temp_pop(mut vm, 1)
        return out
    }
    none
}

// test_fl_std_fmt.c:549-600: containers by structure and map ORDER, floats
// bit-exact so -0.0 does not pass for 0.0.
fn deep_equal(vm: fl.FlVm, a: fl.FlValue, b: fl.FlValue) -> bool {
    if a.t != b.t { return false }
    if a.t == fl.FL_LIST {
        let n = fl.fl_list_len(vm, a)
        if n != fl.fl_list_len(vm, b) { return false }
        for i in 0..n {
            let x = fl.fl_list_get(vm, a, i) else { return false }
            let y = fl.fl_list_get(vm, b, i) else { return false }
            if !deep_equal(vm, x, y) { return false }
        }
        return true
    }
    if a.t == fl.FL_MAP {
        if fl.fl_map_count(vm, a) != fl.fl_map_count(vm, b) { return false }
        var cx = 0
        var cy = 0
        loop {
            let (nx, kx, vx) = fl.fl_map_iter(vm, a, cx) else break
            cx = nx
            let (ny, ky, vy) = fl.fl_map_iter(vm, b, cy) else { return false }
            cy = ny
            if !deep_equal(vm, kx, ky) || !deep_equal(vm, vx, vy) { return false }
        }
        return true
    }
    if a.t == fl.FL_FLOAT { return floats.to_bits(a.f) == floats.to_bits(b.f) }
    fl.fl_equal(vm, a, b)
}

fn fl_fmt_repr_round_trips_500_generated_values() {
    var f = flfix.open()
    var g = Gen { state: 0x9E3779B97F4A7C15 }
    for round in 0..500 {
        let before = f.ndiag
        let v = gen_value(mut f.vm, mut g, 3)
        let root = fl.fl_temp_push(mut f.vm, v)
        var text = List[byte]()
        // The serializer directly: a program would test source escaping.
        let held = fl.fl_temp_get(f.vm, root)
        if !fl.fl_fmt_repr(mut f.vm, mut text, held) {
            fl.fl_temp_pop(mut f.vm, 1)
            assert(false)
            continue
        }
        let entries = f.vm.dc.entries.len
        let p = fl.fl_parse_literal(text, 0, mut f.vm.dc, mut f.vm.strings)
        if p.root < 0 { eprint("round {round} did not re-read: {show(text)}") }
        assert(p.root >= 0)
        assert(f.ndiag + f.vm.dc.entries.len - entries == before)
        let back = ast_to_value(mut f.vm, p, p.root) else {
            assert(false)
            fl.fl_nil()
        }
        let orig = fl.fl_temp_get(f.vm, root)
        let same = deep_equal(f.vm, orig, back)
        if !same { eprint("round {round} did not compare equal: {show(text)}") }
        assert(same)
        fl.fl_temp_pop(mut f.vm, 1)
    }
    flfix.close(mut f)
}

fn main() {
    // G29: the whole file is past the checked machine's 20M-step budget, so
    // YEW_FMT_CASE runs one case alone (tools/check-test-cases.txt); unset,
    // all fourteen run in registry order.
    let only = (env_get("YEW_FMT_CASE") else "-1").to_int() else -1
    var ran = 0
    for n in 0..14 {
        if only >= 0 && n != only { continue }
        match n {
            0 => { fl_fmt_repr_round_trips_500_generated_values() },
            1 => { fl_fmt_f_copies_text_and_unescapes_braces() },
            2 => { fl_fmt_f_resolves_arguments_three_ways() },
            3 => { fl_fmt_f_aligns_in_display_cells() },
            4 => { fl_fmt_f_renders_every_type_letter() },
            5 => { fl_fmt_f_signs_and_zero_pads_numbers() },
            6 => { fl_fmt_f_refuses_a_malformed_directive() },
            7 => { fl_fmt_str_is_display_and_never_raises() },
            8 => { fl_fmt_repr_round_trips_through_the_literal_parser() },
            9 => { fl_fmt_repr_escapes_exactly_the_s25_table() },
            10 => { fl_fmt_repr_pretty_is_the_s25_workspace_format() },
            11 => { fl_fmt_repr_raises_on_what_12_cannot_spell() },
            12 => { fl_fmt_int_hex_and_float_render_scalars() },
            13 => { fl_fmt_pad_pads_in_cells() },
            _ => { assert(false, "unregistered fl_std_fmt case") },
        }
        print("fl_std_fmt case {n}: PASS")
        ran += 1
    }
    print("fl_std_fmt: {ran} of 14 cases run")
}
