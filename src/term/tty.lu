//! term.tty — the terminal lifecycle: raw mode, the restore guarantee,
//! the alternate screen, window size, the capability probe, truecolor.
//!
//! Ports sagitta `src/term/tty.c` (1,486 lines) and `tty.h` (167) at
//! 9ace98c2, under `s03-tty-lifecycle.md`. The pure surface — the raw-mode
//! mapping (§2), the restore blob (§4), the capability-probe state machine
//! (§6), truecolor (§7), the probe config — is what `test_tty.c`
//! exercises; the I/O surface (open, raw, restore, the alternate screen,
//! winsize, suspend, the wait) is what the PTY goldens see from the other
//! side through `demo_paint`.
//!
//! **The restore guarantee (invariant 6) in wolf, ruling #93 R1 interim B.**
//! wolf runs no code in a signal handler (`[os.signal.model]`) and the
//! runtime restores nothing on a trap (`[os.term.mode]`; C =
//! `os_term_restore_at_exit`, s248/0.2.34). Until the pin has C, the port
//! ships B, a SUPERVISOR PROCESS: the shape sagitta itself runs for the one
//! death C yew cannot catch either, `SIGKILL` — the guard sibling of
//! `tty.c:243-349` (`yew_tty_guard_start`). The editor spawns itself as
//! `--guard <saved mode>` (`os_spawn_job`, its own process group, the tty
//! inherited, the editor's pipe read end as its descriptor 3) and writes
//! one byte per state change on the pipe (`R` raw, `C` clean, `M`/`S`
//! motion); the guard ignores the job-control signals, reads until EOF —
//! which is the editor's death by any means — and, if the editor died raw,
//! writes the restore blob, sets the saved mode back and prints the fatal
//! note. Why the SIBLING and not a parent that waits on the child: the PTY
//! harness signals the pty-visible process directly (`restore_suspend`,
//! `paint_resize`, `restore_bus`, `restore_abrt` all `kill(c->pty.pid, …)`),
//! a wolf process cannot listen for `BUS_ERROR` (the stack guard's,
//! send-only), so only a process that is NOT the one signalled can restore
//! after a `SIGBUS`, and a sibling needs no forwarding. Every exit path
//! the program owns restores itself first (`tty_restore` is the ONE call
//! site, the swap point for 0.2.34): a normal quit; `TERMINATE`/`RELOAD`/
//! `QUIT` listened, restored, the fatal note written, then
//! `os_exit_signal` (ruling #88 R2); `SUSPEND` restored then the process
//! stopped by its own default-disposition raise (and `CONTINUE` re-enters
//! raw, as C's `yew_tty_cont`); a trap, a `SIGKILL`, a sent `SEGV`/`BUS`/
//! `ABRT` fall to the guard. Divergence stated: the guard cannot tell a
//! `SIGKILL` from a `SIGSEGV`, so it prints the fatal note on every death
//! it restores after, where C's guard prints none (C's note comes from its
//! handler). No wolf code in a handler, no handler at all.
//!
//! **The wait (ruling #93 R2 interim).** `os_signal_wait_fd` takes one
//! descriptor and no deadline, so a deadline (the lone-ESC and probe
//! timers) is served by `VTIME` polling: `tty_wait` is the ONE wait call
//! site (the swap point for `os_signal_wait_fds`, wolf-lang#795); with a
//! deadline pending the mode is `VMIN=0, VTIME=1` and a read returns after
//! at most 100 ms with nothing, a tick; without one it is `VMIN=1` and the
//! wait parks in `signal.wait_fd` until a key or a meaning.
//!
//! The wolf shapes (idiom, `docs/MAP.md` §1):
//!  - C's `yew_tty_rawios` is a termios transform; in wolf the mode is one
//!    int (`[os.term.mode]`), so `rawios` builds a `std_term.Mode` with the
//!    five reachable bits off. The seven bits C also clears (`ICRNL`,
//!    `OPOST`, `ISTRIP`, `BRKINT`, `PARMRK`, `INPCK`, `CS8`) are
//!    unreachable — the witnessed gap (`notes/yw01-evidence/witness/
//!    run.txt`), filed, never worked around. Unlike `std_term.raw`, which
//!    keeps `signals` (ruling #81), the editor clears it too: Ctrl-C,
//!    Ctrl-Z and Ctrl-\ are keys (s03 §2).
//!  - byte blobs are `str` constants read with `.bytes()`; buffers are
//!    `List[byte]`; recognizers answer tuples; `now_ms` is injected; the
//!    env lookup is an `Env` value (`env_process()`, or `env_of(table)`
//!    in a unit test) answering (value, present) so a presence-only
//!    variable (`NO_COLOR`) keeps C's `getenv != NULL`.
//!  - no module state and no `unsafe`: the C statics (`g_raw`, `g_saved`,
//!    `g_wfd`, …) existed for the handlers; without handlers the `Tty`
//!    value carries them.

use std.fs
use std.io as std_io
use std.process
use std.signal
use std.term as std_term

/// The terminal's capabilities after a probe (`TtyCaps`, `tty.h:13-20`).
pub struct TtyCaps {
    probed: bool,
    truecolor: bool,
    kitty_kbd: bool,
    kitty_flags: int,
    sync_output: bool,
    da1_seen: bool,
}

/// A fresh capability set, everything off (`memset` in `yew_tty_open`).
pub fn caps_new() -> TtyCaps {
    TtyCaps {
        probed: false,
        truecolor: false,
        kitty_kbd: false,
        kitty_flags: 0,
        sync_output: false,
        da1_seen: false,
    }
}

/// The background the OSC 11 probe found (`TtyBackground`, `tty.h:27-31`).
pub const BG_UNKNOWN: int = 0

/// A dark background (the OSC 11 reply's luminance was below the midpoint).
pub const BG_DARK: int = 1

/// A light background (the OSC 11 reply's luminance was at or above it).
pub const BG_LIGHT: int = 2

// The probe state machine's states (`tty.c:18-22`).
const PROBE_IDLE: int = 0

const PROBE_AWAIT: int = 1

const PROBE_DONE: int = 2

/// The default capability-probe deadline in ms (`YEW_TTY_PROBE_DEFAULT_MS`,
/// `tty.c:24`).
pub const PROBE_DEFAULT_MS: int = 50

/// The three queries, in order: kitty keyboard, DECRQM 2026, DA1
/// (`YEW_TTY_PROBE_QUERY`, `tty.c:25-28`). The fence is DA1, which every
/// real terminal answers; its reply ends the capability wait.
pub const PROBE_QUERY: str = "\x1b[?u\x1b[?2026$p\x1b[c"

/// The OSC 11 background query (`YEW_TTY_BACKGROUND_QUERY`, `tty.c:29`).
pub const BACKGROUND_QUERY: str = "\x1b]11;?\x07"

/// The alternate-screen enter (`ESC 7` then `CSI ?1049h`, `tty.c:30`).
pub const ALT_ON: str = "\x1b7\x1b[?1049h"

/// The alternate-screen leave (`CSI ?1049l` then `ESC 8`, `tty.c:31`).
pub const ALT_OFF: str = "\x1b[?1049l\x1b8"

/// The 1002 → 1003 mouse transition (`YEW_TTY_MOTION_ON`, `tty.c:74-76`).
pub const MOTION_ON: str = "\x1b[?1002l\x1b[?1003h"

/// The 1003 → 1002 mouse transition (`YEW_TTY_MOTION_OFF`, `tty.c:77-79`).
pub const MOTION_OFF: str = "\x1b[?1003l\x1b[?1002h"

/// The note the fatal path writes after the restore (`tty.c:156-157`).
pub const FATAL_NOTE: str = "yew: fatal signal, terminal restored\r\n"

/// The diagnostic for a stdin that is not a terminal (`tty.c:457-458`).
pub const NOT_TTY_MESSAGE: str = "yew: error: stdin is not a terminal; use --batch SCRIPT for headless execution\n"

/// The diagnostic for a raw mode only partially applied (`tty.c:567-568`).
pub const BROKEN_MESSAGE: str = "yew: error: terminal is broken: raw mode was only partially applied\n"

// The restore blob, byte-pinned against C (`tty.c:54-73`). HEAD then
// TAIL; the motion variant adds `CSI ?1003l` between them when 1003
// (any-motion mouse) was armed. One `str` each, not a built value.
const RESTORE_BLOB: str = "\x1b[<u\x1b[?2004l\x1b[?1002l\x1b[?1006l\x1b[?1004l\x1b[?2026l\x1b[0m\x1b[0 q\x1b[?1049l\x1b[?25h"

const RESTORE_BLOB_MOTION: str = "\x1b[<u\x1b[?2004l\x1b[?1003l\x1b[?1002l\x1b[?1006l\x1b[?1004l\x1b[?2026l\x1b[0m\x1b[0 q\x1b[?1049l\x1b[?25h"

// The guard protocol's bytes (`tty.c:85-90`).
const GUARD_RAW: int = 82

const GUARD_CLEAN: int = 67

const GUARD_MOTION: int = 77

const GUARD_STILL: int = 83

/// The rows `tty_open` answers: `not_tty` (the `--batch` diagnostic was
/// written), `io` (the mode or the guard could not be set up).
pub error TtyOpenError = {not_tty, io}

/// The rows `tty_read` answers: `hangup` at the end of input, `io` otherwise.
pub error TtyReadError = {io, hangup}

/// What `tty_on_signal` tells the loop to do: nothing.
pub const SIG_NONE: int = 0

/// The window changed: re-read the size and repaint (`'W'`).
pub const SIG_WINCH: int = 1

/// Continued after a stop: raw is re-entered here; re-enter the alternate
/// screen, re-enable input and repaint (`'C'`).
pub const SIG_CONT: int = 2

/// A child changed state (`'H'`; consumed from Sprint 19 on).
pub const SIG_CHLD: int = 3

/// The terminal was restored and the process stopped itself; nothing to
/// paint until `SIG_CONT`.
pub const SIG_SUSPENDED: int = 4

/// The exact bytes `tty_restore` writes, 1003l included when `motion`
/// (`yew_tty_restore_blob_for`, `tty.c:1476-1486`).
pub fn restore_blob(motion: bool) -> str {
    if motion {
        return RESTORE_BLOB_MOTION
    }
    RESTORE_BLOB
}

/// The raw mode an editor sets (`yew_tty_rawios`, `tty.c:521-543`), as the
/// five reachable bits: canonical, echo, signals, flow and extended all
/// off, one byte a read (`VMIN=1`), no timer. The other seven termios bits
/// C clears are unreachable through `[os.term.mode]` (the witnessed gap);
/// `signals` IS reachable and IS cleared, unlike `std_term.raw`.
pub fn rawios() -> std_term.Mode {
    std_term.Mode {
        canonical: false,
        echo: false,
        signals: false,
        flow: false,
        extended: false,
        min: 1,
        time: 0,
    }
}

// The VTIME-polling twin of `rawios` (ruling #93 R2 interim): a read
// returns after at most a tenth of a second with nothing when no byte came.
fn pollios() -> std_term.Mode {
    std_term.Mode {
        canonical: false,
        echo: false,
        signals: false,
        flow: false,
        extended: false,
        min: 0,
        time: 1,
    }
}

/// The process environment: the value and whether the variable exists
/// (C's `getenv` NULL distinction, `tty.c:470-473`). Never passed as a
/// function value (G19 in `docs/MAP.md`: wolf 0.2.33 refuses a
/// module-level function used as a value once its module has more than
/// one file, yew commit 7acaa89); `Env` carries the lookup instead.
pub fn env_getv(name: str) -> (str, bool) {
    let v = env_get(name) else {
        return ("", false)
    }
    (v, true)
}

/// The environment a lookup-taking function reads: the process's own
/// (`env_process`) or a table a test sets (`env_of`). A VALUE, not a
/// function: the release tier at wolf 0.2.33 refuses a closure made in
/// one object and called in another ("a vtable slot `@main.cls0` outside
/// this object's subset"), and its inliner moves a closure's making
/// across the partition (`@term.render_new_env.cls0`); docs/MAP.md §5.
pub struct Env {
    process: bool,
    vars: Map[str, str],
}

/// The process environment.
pub fn env_process() -> Env {
    Env { process: true, vars: Map[str, str]() }
}

/// A fixed table (the unit tables): a key absent from `vars` is absent.
pub fn env_of(vars: Map[str, str]) -> Env {
    Env { process: false, vars: copy vars }
}

/// The value and whether the variable exists (C's `getenv` NULL
/// distinction, `tty.c:470-473`).
pub fn env_lookup(env: Env, name: str) -> (str, bool) {
    if env.process {
        return env_getv(name)
    }
    let v = env.vars[name] else {
        return ("", false)
    }
    (v, true)
}

// ---- Truecolor detection (`yew_tty_detect_truecolor`, `tty.c:964-1002`).

fn decimal_at_least(value: str, floor: int) -> bool {
    if value.len == 0 {
        return false
    }
    var parsed: int = 0
    for b in value.bytes() {
        let c = b as int
        if c < 48 || c > 57 {
            return false
        }
        if parsed < 1000000000 {
            parsed = parsed * 10 + (c - 48)
        }
    }
    parsed >= floor
}

/// Whether the terminal takes 24-bit colour, first hit wins (`tty.c:964`).
pub fn detect_truecolor(env: Env) -> bool {
    let (forced, _) = env_lookup(env, "YEW_TRUECOLOR")
    if forced == "0" {
        return false
    }
    if forced == "1" {
        return true
    }
    let (colorterm, _) = env_lookup(env, "COLORTERM")
    if colorterm == "truecolor" || colorterm == "24bit" {
        return true
    }
    let (term, _) = env_lookup(env, "TERM")
    if term.contains("direct") || term.contains("truecolor") {
        return true
    }
    for p in term_prefixes() {
        if term.starts_with(p) {
            return true
        }
    }
    let (program, _) = env_lookup(env, "TERM_PROGRAM")
    for p in program_names() {
        if program == p {
            return true
        }
    }
    let (vte, _) = env_lookup(env, "VTE_VERSION")
    if decimal_at_least(vte, 3600) {
        return true
    }
    let (_, has_konsole) = env_lookup(env, "KONSOLE_VERSION")
    has_konsole
}

fn term_prefixes() -> List[str] {
    var v = List[str]()
    (mut v).push("xterm-kitty")
    (mut v).push("kitty")
    (mut v).push("foot")
    (mut v).push("wezterm")
    (mut v).push("alacritty")
    (mut v).push("ghostty")
    v
}

fn program_names() -> List[str] {
    var v = List[str]()
    (mut v).push("iTerm.app")
    (mut v).push("WezTerm")
    (mut v).push("ghostty")
    (mut v).push("vscode")
    v
}

/// The probe config a program's environment names (`TtyProbeConfig`,
/// `yew_tty_probe_read_config`, `tty.c:1004-1042`).
pub struct ProbeConfig {
    enabled: bool,
    timeout_ms: int,
}

/// The probe config a program's environment names: `YEW_TTY_PROBE=0`
/// disables the probe, `YEW_PROBE_TIMEOUT_MS` overrides the 50 ms deadline
/// (a non-numeric or non-positive value is ignored).
pub fn probe_read_config(env: Env) -> ProbeConfig {
    var enabled = true
    var timeout: int = PROBE_DEFAULT_MS
    let (probe, _) = env_lookup(env, "YEW_TTY_PROBE")
    if probe == "0" {
        enabled = false
    }
    let (raw_timeout, _) = env_lookup(env, "YEW_PROBE_TIMEOUT_MS")
    if raw_timeout.len != 0 {
        var parsed: int = 0
        var valid = true
        for b in raw_timeout.bytes() {
            let c = b as int
            if c < 48 || c > 57 {
                valid = false
            } else if parsed < 1000000000 {
                parsed = parsed * 10 + (c - 48)
            }
        }
        if valid && parsed > 0 {
            timeout = parsed
        }
    }
    ProbeConfig { enabled: enabled, timeout_ms: timeout }
}

/// The terminal object (`Tty`, `tty.h:33-54`): the probe machine's state
/// and buffers, and the I/O state the C statics held for the handlers.
pub struct Tty {
    caps: TtyCaps,
    pending: List[byte],
    pstate: int,
    pdeadline: int,
    background: int,
    background_await: bool,
    capability_await: bool,
    prefix: List[byte],
    opened: bool,
    saved: int,
    raw: bool,
    resume_raw: bool,
    poll_mode: bool,
    alt: bool,
    motion: bool,
    rows: int,
    cols: int,
    poisoned: bool,
    guard_on: bool,
    guard_slot: int,
    guard_wfd: int,
}

/// A terminal with an idle probe, empty buffers and nothing opened.
pub fn tty_new() -> Tty {
    Tty {
        caps: caps_new(),
        pending: List[byte](),
        pstate: PROBE_IDLE,
        pdeadline: 0,
        background: BG_UNKNOWN,
        background_await: false,
        capability_await: false,
        prefix: List[byte](),
        opened: false,
        saved: 0,
        raw: false,
        resume_raw: false,
        poll_mode: false,
        alt: false,
        motion: false,
        rows: 0,
        cols: 0,
        poisoned: false,
        guard_on: false,
        guard_slot: -1,
        guard_wfd: -1,
    }
}

// ---- The probe state machine (`tty.c:1044-1456`), pure.

/// Arm the capability probe (`yew_tty_probe_config`, `tty.c:1329-1362`,
/// the pure half: `tty_probe_start` writes `PROBE_QUERY`). Resets the caps,
/// moves to AWAIT, sets the deadline; `truecolor` is detected by the
/// caller as C does; the three reply caps start false.
pub fn probe_arm(mut t: Tty, now_ms: int, config: ProbeConfig, truecolor: bool) {
    t.caps = caps_new()
    t.caps.truecolor = truecolor
    t.background = BG_UNKNOWN
    t.background_await = false
    t.capability_await = false
    t.prefix = List[byte]()
    if !config.enabled {
        t.pstate = PROBE_DONE
        t.pdeadline = 0
        t.caps.probed = true
        return
    }
    t.pstate = PROBE_AWAIT
    t.capability_await = true
    t.pdeadline = now_ms + config.timeout_ms
}

fn prefix_is(s: List[byte], len: int, fixed: str) -> bool {
    let fb = fixed.bytes()
    var lim = len
    if fb.len < lim {
        lim = fb.len
    }
    var i = 0
    while i < lim {
        if s[i] as int != fb[i] as int {
            return false
        }
        i += 1
    }
    true
}

fn starts_esc_bracket_q(s: List[byte]) -> bool {
    s[0] as int == 27 && s[1] as int == 91 && s[2] as int == 63
}

// kitty: "\x1b[?" digits "u". Answers (cont, complete, flags).
fn probe_kitty(s: List[byte], len: int) -> (bool, bool, int) {
    if len <= 3 {
        return (prefix_is(s, len, "\x1b[?"), false, 0)
    }
    if !starts_esc_bracket_q(s) {
        return (false, false, 0)
    }
    var value: int = 0
    var i = 3
    while i < len {
        let c = s[i] as int
        if c == 117 && i + 1 == len && i > 3 {
            return (true, true, value)
        }
        if c < 48 || c > 57 {
            return (false, false, 0)
        }
        if value < 1000000000 {
            value = value * 10 + (c - 48)
        }
        i += 1
    }
    (true, false, 0)
}

// DA1: "\x1b[?" digits and ';' then 'c'. Answers (cont, complete).
fn probe_da1(s: List[byte], len: int) -> (bool, bool) {
    if len <= 3 {
        return (prefix_is(s, len, "\x1b[?"), false)
    }
    if !starts_esc_bracket_q(s) {
        return (false, false)
    }
    var digit_seen = false
    var i = 3
    while i < len {
        let c = s[i] as int
        if c >= 48 && c <= 57 {
            digit_seen = true
        } else if c == 59 && digit_seen {
            digit_seen = false
        } else if c == 99 && digit_seen && i + 1 == len {
            return (true, true)
        } else {
            return (false, false)
        }
        i += 1
    }
    (true, false)
}

// sync: "\x1b[?2026;" status('0'..'4') '$' 'y'. Answers (cont, complete, supported).
fn probe_sync(s: List[byte], len: int) -> (bool, bool, bool) {
    let prefix = "\x1b[?2026;"
    let plen = prefix.len
    if len <= plen {
        return (prefix_is(s, len, prefix), false, false)
    }
    if !prefix_is(s, plen, prefix) {
        return (false, false, false)
    }
    let status = s[plen] as int
    if status < 48 || status > 52 {
        return (false, false, false)
    }
    if len == plen + 1 {
        return (true, false, false)
    }
    if s[plen + 1] as int != 36 {
        return (false, false, false)
    }
    if len == plen + 2 {
        return (true, false, false)
    }
    if s[plen + 2] as int != 121 || len != plen + 3 {
        return (false, false, false)
    }
    let supported = status == 49 || status == 50 || status == 51
    (true, true, supported)
}

fn hexval(c: int) -> (int, bool) {
    if c >= 48 && c <= 57 {
        return (c - 48, true)
    }
    if c >= 97 && c <= 102 {
        return (10 + c - 97, true)
    }
    if c >= 65 && c <= 70 {
        return (10 + c - 65, true)
    }
    (0, false)
}

fn rgb_component(s: List[byte], at: int, n: int) -> (int, bool) {
    if n == 0 || n > 4 {
        return (0, false)
    }
    var value = 0
    var maximum = 0
    var i = 0
    while i < n {
        let (d, ok) = hexval(s[at + i] as int)
        if !ok {
            return (0, false)
        }
        value = value * 16 + d
        maximum = maximum * 16 + 15
        i += 1
    }
    ((value * 255 + maximum / 2) / maximum, true)
}

// background: "\x1b]11;rgb:" R/G/B then ST or BEL. Answers (cont, complete, light).
fn probe_background(s: List[byte], len: int) -> (bool, bool, bool) {
    let prefix = "\x1b]11;rgb:"
    let plen = prefix.len
    if len <= plen {
        return (prefix_is(s, len, prefix), false, false)
    }
    if !prefix_is(s, plen, prefix) {
        return (false, false, false)
    }
    var end = len
    var terminated = false
    if s[end - 1] as int == 7 {
        end -= 1
        terminated = true
    } else if end >= 2 && s[end - 2] as int == 27 && s[end - 1] as int == 92 {
        end -= 2
        terminated = true
    } else if s[end - 1] as int == 27 {
        return (true, false, false)
    }
    var slash_a = 0
    var slash_b = 0
    var i = plen
    while i < end {
        let c = s[i] as int
        if c == 47 {
            if slash_a == 0 {
                slash_a = i
            } else if slash_b == 0 {
                slash_b = i
            } else {
                return (false, false, false)
            }
        } else {
            let (_, ok) = hexval(c)
            if !ok {
                return (false, false, false)
            }
        }
        i += 1
    }
    if !terminated {
        return (end - plen <= 14, false, false)
    }
    if slash_a == 0 || slash_b == 0 {
        return (false, false, false)
    }
    let (red, okr) = rgb_component(s, plen, slash_a - plen)
    let (green, okg) = rgb_component(s, slash_a + 1, slash_b - slash_a - 1)
    let (blue, okb) = rgb_component(s, slash_b + 1, end - slash_b - 1)
    if !okr || !okg || !okb {
        return (false, false, false)
    }
    let light = 299 * red + 587 * green + 114 * blue >= 128000
    (true, true, light)
}

// Try every recognizer on the current prefix; on a completion set the
// cap and clear the prefix (`yew_tty_probe_candidate`, `tty.c:1243-1299`).
fn probe_candidate(mut t: Tty) -> bool {
    let len = t.prefix.len
    let (kcont, kdone, kflags) = probe_kitty(t.prefix, len)
    let (dcont, ddone) = probe_da1(t.prefix, len)
    let (scont, sdone, ssup) = probe_sync(t.prefix, len)
    var bgcont = false
    var bgdone = false
    var bglight = false
    if t.background_await {
        let (bc, bd, bl) = probe_background(t.prefix, len)
        bgcont = bc
        bgdone = bd
        bglight = bl
    }
    if bgdone {
        t.background = if bglight then BG_LIGHT else BG_DARK
        t.background_await = false
        if !t.capability_await {
            t.pstate = PROBE_DONE
            t.pdeadline = 0
        }
        t.prefix = List[byte]()
        return true
    }
    if kdone {
        t.caps.kitty_kbd = true
        t.caps.kitty_flags = kflags
        t.prefix = List[byte]()
        return true
    }
    if sdone {
        t.caps.sync_output = ssup
        t.prefix = List[byte]()
        return true
    }
    if ddone {
        t.caps.da1_seen = true
        t.caps.probed = true
        t.capability_await = false
        if !t.background_await {
            t.pstate = PROBE_DONE
            t.pdeadline = 0
        }
        t.prefix = List[byte]()
        return true
    }
    kcont || dcont || scont || bgcont
}

fn flush_prefix(mut t: Tty) {
    for b in t.prefix {
        (mut t.pending).push(b)
    }
    t.prefix = List[byte]()
}

// Feed one byte to the probe recognizer (`yew_tty_probe_byte`,
// `tty.c:1301-1327`). Non-reply bytes land in `pending` in arrival order.
fn probe_byte(mut t: Tty, c: int) {
    if t.prefix.len == 0 {
        if c == 27 {
            (mut t.prefix).push(c as byte)
        } else {
            (mut t.pending).push(c as byte)
        }
        return
    }
    if t.prefix.len == 64 {
        flush_prefix(mut t)
        probe_byte(mut t, c)
        return
    }
    (mut t.prefix).push(c as byte)
    if probe_candidate(mut t) {
        return
    }
    if c == 27 {
        // Flush all but the ESC just pushed, then restart on it.
        var kept = List[byte]()
        let last = t.prefix.len - 1
        var i = 0
        while i < last {
            (mut t.pending).push(t.prefix[i])
            i += 1
        }
        (mut kept).push(27 as byte)
        t.prefix = kept
    } else {
        flush_prefix(mut t)
    }
}

/// Feed bytes read from the terminal to the probe (`yew_tty_probe_feed`,
/// `tty.c:1400-1420`). Before AWAIT or after DONE the bytes are pending.
pub fn probe_feed(mut t: Tty, s: List[byte], at: int, end: int) -> int {
    if t.pstate != PROBE_AWAIT {
        var i = at
        while i < end {
            (mut t.pending).push(s[i])
            i += 1
        }
        return end - at
    }
    var i = at
    while i < end {
        if t.pstate == PROBE_AWAIT {
            probe_byte(mut t, s[i] as int)
        } else {
            (mut t.pending).push(s[i])
        }
        i += 1
    }
    end - at
}

/// The deadline check (`yew_tty_probe_tick`, `tty.c:1422-1436`): once the
/// deadline passes with no DA1, the dumb terminal reaches DONE with every
/// capability off.
pub fn probe_tick(mut t: Tty, now_ms: int) {
    if t.pstate != PROBE_AWAIT || now_ms < t.pdeadline {
        return
    }
    flush_prefix(mut t)
    t.background_await = false
    t.capability_await = false
    t.pstate = PROBE_DONE
    t.pdeadline = 0
    t.caps.probed = true
}

/// Whether the probe has reached DONE (`tty.c:1438-1444`).
pub fn probe_done(t: Tty) -> bool {
    t.pstate == PROBE_DONE
}

/// The poll timeout the probe wants now: -1 when not awaiting, 0 when the
/// deadline has passed, else the remaining ms (`tty.c:1446-1456`).
pub fn probe_deadline(t: Tty, now_ms: int) -> int {
    if t.pstate != PROBE_AWAIT {
        return -1
    }
    if now_ms >= t.pdeadline {
        return 0
    }
    t.pdeadline - now_ms
}

/// The capabilities now (a copy, never a lent field: `[mem.tier0.mode.read]`).
pub fn tty_caps(t: Tty) -> TtyCaps {
    copy t.caps
}

/// The background the OSC 11 probe found (`yew_tty_probe_background`).
pub fn tty_background(t: Tty) -> int {
    t.background
}

/// The bytes the probe buffered that were not replies, in arrival order
/// (`t->pending`), for the input decoder to seed (`yew_input_seed`).
pub fn tty_pending(t: Tty) -> List[byte] {
    copy t.pending
}

/// Forget the buffered pending bytes once the decoder has them.
pub fn tty_clear_pending(mut t: Tty) {
    t.pending = List[byte]()
}

/// The window's rows as last read (`t->rows`).
pub fn tty_rows(t: Tty) -> int {
    t.rows
}

/// The window's columns as last read (`t->cols`).
pub fn tty_cols(t: Tty) -> int {
    t.cols
}

/// Whether raw mode is in force (`t->raw`).
pub fn tty_is_raw(t: Tty) -> bool {
    t.raw
}

/// Whether the alternate screen is entered (`t->alt`).
pub fn tty_is_alt(t: Tty) -> bool {
    t.alt
}

// ---- The I/O surface.

fn write_fd2_str(s: str) {
    var err = fs.stderr()
    fs.write_chunk(mut err, s.bytes()) else |_| {}
}

/// Write bytes to the terminal (the one `write(2)` a frame is: the caller
/// renders into a `List[byte]` and writes once, s05 §5).
pub fn tty_write(bytes: List[byte]) -> () ! {io} {
    var out = fs.stdout()
    fs.write_chunk(mut out, bytes) else |_| {
        return io
    }
}

/// Write a `str`'s bytes to the terminal.
pub fn tty_write_str(s: str) -> () ! {io} {
    var out = fs.stdout()
    fs.write_chunk(mut out, s.bytes()) else |_| {
        return io
    }
}

fn guard_note(t: Tty, state: int) {
    if !t.guard_on {
        return
    }
    var w = fs.File { fd: t.guard_wfd }
    var one = List[byte]()
    (mut one).push(state as byte)
    fs.write_chunk(mut w, one) else |_| {}
}

// Spawn the guard sibling (`yew_tty_guard_start`, `tty.c:297-349`): this
// executable as `--guard <saved>`, its own process group, the tty as its
// 0/1/2, the pipe's read end as its 3. This process keeps the write end.
fn guard_start(mut t: Tty) -> () ! {io} {
    let exe = os_exe() else {
        return io
    }
    let p = process.pipe() else {
        return io
    }
    let rfd = p.read.fd
    let wfd = p.write.fd
    var c = process.command(exe)
    process.push_arg(mut c, "--guard")
    process.push_arg(mut c, "{t.saved}")
    process.set_stdin(mut c, fs.stdin())
    process.set_stdout(mut c, fs.stdout())
    process.set_stderr(mut c, fs.stderr())
    process.set_fd(mut c, 3, fs.File { fd: rfd })
    let ch = process.start_job(c, 0, 0) else |_| {
        return io
    }
    fs.close(take fs.File { fd: rfd }) else |_| {}
    t.guard_slot = ch.slot
    t.guard_wfd = wfd
    t.guard_on = true
}

// Close the pipe and reap the guard (`yew_tty_guard_finish`, `tty.c:351-372`).
fn guard_finish(mut t: Tty) {
    if !t.guard_on {
        return
    }
    t.guard_on = false
    fs.close(take fs.File { fd: t.guard_wfd }) else |_| {}
    let _ = process.wait_status(take process.Child { slot: t.guard_slot }) else -1
    t.guard_slot = -1
    t.guard_wfd = -1
}

/// The guard process itself (`guard_child`, `tty.c:243-295`): ignore the
/// job-control signals, read the state bytes on descriptor 3 until EOF —
/// the editor's end by any means — and if it died raw, write the restore
/// blob, set the saved mode back and print the fatal note. Exit 0 when the
/// restore succeeded or was not needed, 1 otherwise. `saved_text` is the
/// packed mode the editor read at open.
pub fn guard_main(saved_text: str) -> int {
    let saved = saved_text.to_int() else {
        return 2
    }
    let ignored = signal.reload() |
        signal.interrupt() |
        signal.quit() |
        signal.terminate() |
        signal.suspend() |
        signal.bg_read() |
        signal.bg_write()
    signal.ignore(ignored) else |_| {}
    var pipe_in = fs.open("/dev/fd/3") else |_| {
        return 1
    }
    var raw = false
    var motion = false
    var ok = true
    loop {
        let chunk = fs.read_chunk(mut pipe_in, 64) else |e| match e {
            eof => { break },
            io => {
                ok = false
                break
            },
        }
        for b in chunk {
            let c = b as int
            if c == GUARD_RAW {
                raw = true
            } else if c == GUARD_CLEAN {
                raw = false
                motion = false
            } else if c == GUARD_MOTION {
                motion = true
            } else if c == GUARD_STILL {
                motion = false
            }
        }
    }
    if raw {
        tty_write_str(restore_blob(motion)) else |_| {
            ok = false
        }
        std_term.set_mode(fs.stdin(), std_term.unpack(saved)) else |_| {
            ok = false
        }
        write_fd2_str(FATAL_NOTE)
    }
    if ok then 0 else 1
}

/// Whether both standard streams are terminals; when not, the `--batch`
/// diagnostic is written to stderr (`yew_tty_not_tty`, `tty.c:455-463`,
/// s03 DoD 8) and the answer is false.
pub fn tty_require_terminal() -> bool {
    let in_tty = std_io.is_terminal(fs.stdin()) else false
    let out_tty = std_io.is_terminal(fs.stdout()) else false
    if !in_tty || !out_tty {
        write_fd2_str(NOT_TTY_MESSAGE)
        return false
    }
    true
}

/// Open the controlling terminal (`yew_tty_open`, `tty.c:475-504`): both
/// standard streams must be terminals (else the `--batch` diagnostic and
/// `not_tty`), the mode is saved, truecolor detected, the size read, and
/// the guard started.
pub fn tty_open(mut t: Tty) -> () ! TtyOpenError {
    assert(!t.poisoned, "terminal access in --batch: tty_open")
    let tin = fs.stdin()
    if !tty_require_terminal() {
        return not_tty
    }
    let m = std_term.mode(tin) else |_| {
        return io
    }
    t.saved = std_term.pack(m)
    t.caps.truecolor = detect_truecolor(env_process())
    let _ = tty_winsize(mut t)
    guard_start(mut t)?
    t.opened = true
}

/// Mark the terminal unusable for `--batch` (`yew_tty_poison`, `tty.c:506`):
/// any later terminal access is an internal error.
pub fn tty_poison(mut t: Tty) {
    t.poisoned = true
}

/// The meanings the editor listens for while raw: the window, a continue,
/// a stop, a child, and the three deaths it restores before (s03 §4-§5).
pub fn tty_signal_set() -> int {
    signal.resize() |
        signal.continued() |
        signal.suspend() |
        signal.child() |
        signal.terminate() |
        signal.reload() |
        signal.quit()
}

/// Enter raw mode (`yew_tty_raw`, `tty.c:577-632`): the guard is told
/// first (pessimistic, as C), the mode set, read back and compared bit for
/// bit (a partial application is the "terminal is broken" diagnostic and
/// `io`), and the signal set listened for.
pub fn tty_raw(mut t: Tty) -> () ! {io} {
    assert(!t.poisoned, "terminal access in --batch: tty_raw")
    if t.raw {
        return
    }
    let tin = fs.stdin()
    t.resume_raw = true
    t.raw = true
    t.poll_mode = false
    guard_note(t, GUARD_RAW)
    std_term.set_mode(tin, rawios()) else |_| {
        tty_restore(mut t)
        t.resume_raw = false
        return io
    }
    let back = std_term.mode(tin) else |_| {
        tty_restore(mut t)
        t.resume_raw = false
        return io
    }
    if back.canonical ||
        back.echo ||
        back.signals ||
        back.flow ||
        back.extended ||
        back.min != 1 ||
        back.time != 0 {
        t.resume_raw = false
        tty_restore(mut t)
        write_fd2_str(BROKEN_MESSAGE)
        return io
    }
    signal.listen(tty_signal_set()) else |_| {
        tty_restore(mut t)
        t.resume_raw = false
        return io
    }
}

/// The restore (`yew_tty_restore`, `tty.c:130-152`): idempotent; writes the
/// blob, sets the saved mode back, tells the guard. THE ONE call site every
/// exit path uses, and the swap point for `os_term_restore_at_exit`
/// (ruling #93 R1 C, 0.2.34).
pub fn tty_restore(mut t: Tty) {
    if !t.raw {
        return
    }
    tty_write_str(restore_blob(t.motion)) else |_| {}
    std_term.set_mode(fs.stdin(), std_term.unpack(t.saved)) else |_| {}
    t.raw = false
    t.motion = false
    t.poll_mode = false
    guard_note(t, GUARD_CLEAN)
}

/// Close the terminal (`yew_tty_close`, `tty.c:634-662`): restore, stop
/// listening, finish the guard. The restore blob must be the final output.
pub fn tty_close(mut t: Tty) {
    if !t.opened {
        return
    }
    t.resume_raw = false
    tty_restore(mut t)
    signal.reset(tty_signal_set()) else |_| {}
    guard_finish(mut t)
    t.alt = false
    t.pending = List[byte]()
    t.opened = false
}

/// Read the window size (`yew_tty_winsize`, `tty.c:664-677`): false when
/// the terminal was never told one.
pub fn tty_winsize(mut t: Tty) -> bool {
    assert(!t.poisoned, "terminal access in --batch: tty_winsize")
    let s = std_term.size(fs.stdout()) else |_| {
        return false
    }
    if s.rows == 0 || s.columns == 0 {
        return false
    }
    t.rows = s.rows
    t.cols = s.columns
    true
}

/// Enter or leave the alternate screen (`yew_tty_altscreen`, `tty.c:679-695`).
pub fn tty_altscreen(mut t: Tty, on: bool) {
    assert(!t.poisoned, "terminal access in --batch: tty_altscreen")
    if !t.raw || t.alt == on {
        return
    }
    tty_write_str(if on then ALT_ON else ALT_OFF) else |_| {
        return
    }
    t.alt = on
}

// Stop this process as the job-control default would (`yew_tty_tstp`,
// `tty.c:181-190`): the disposition back to default, the signal raised,
// then — once continued — the listen re-armed. In an orphaned process
// group the host discards the stop (the PTY harness knows, and SIGSTOPs).
fn stop_self() {
    signal.reset(signal.suspend()) else |_| {}
    signal.raise(signal.suspend()) else |_| {}
    signal.listen(signal.suspend()) else |_| {}
}

/// The editor-command suspend (`yew_tty_suspend`, `tty.c:853-860`): restore,
/// then stop.
pub fn tty_suspend(mut t: Tty) {
    assert(!t.poisoned, "terminal access in --batch: tty_suspend")
    tty_restore(mut t)
    stop_self()
}

/// What a delivered meaning does (the handlers of `tty.c:154-212` and
/// `yew_tty_drain_signals`, done in the loop's own context): the window,
/// a continue (raw re-entered here, `yew_tty_cont`), a stop (restored,
/// stopped, `yew_tty_tstp`), a child, or a death the program restores
/// before (`yew_tty_fatal`: restore, the note, then the signal with its
/// default disposition — this never returns).
pub fn tty_on_signal(mut t: Tty, meaning: int) -> int {
    if meaning == signal.resize() {
        return SIG_WINCH
    }
    if meaning == signal.continued() {
        if t.resume_raw && !t.raw {
            t.raw = true
            t.poll_mode = false
            guard_note(t, GUARD_RAW)
            std_term.set_mode(fs.stdin(), rawios()) else |_| {
                t.raw = false
                guard_note(t, GUARD_CLEAN)
            }
        }
        t.alt = false
        return SIG_CONT
    }
    if meaning == signal.suspend() {
        tty_restore(mut t)
        stop_self()
        return SIG_SUSPENDED
    }
    if meaning == signal.child() {
        return SIG_CHLD
    }
    if meaning == signal.terminate() || meaning == signal.reload() || meaning == signal.quit() {
        tty_restore(mut t)
        write_fd2_str(FATAL_NOTE)
        os_exit_signal(meaning) else |_| {}
        os_exit(1)
    }
    SIG_NONE
}

// Switch between the parked wait (VMIN=1) and the VTIME tick (VMIN=0,
// VTIME=1) only when the deadline state changes.
fn set_poll(mut t: Tty, on: bool) {
    if !t.raw || t.poll_mode == on {
        return
    }
    std_term.set_mode(fs.stdin(), if on then pollios() else rawios()) else |_| {
        return
    }
    t.poll_mode = on
}

/// THE wait (ruling #93 R2 interim; the swap point for `os_signal_wait_fds`).
/// `deadline_ms < 0`: park until a key or a meaning (`signal.wait_fd`),
/// answering the meaning or 0 for input. `deadline_ms >= 0`: VTIME
/// polling — a queued meaning is answered at once, else 0 and the read
/// that follows returns within 100 ms (a tick when it brings nothing).
pub fn tty_wait(mut t: Tty, deadline_ms: int) -> int ! {io} {
    assert(!t.poisoned, "terminal access in --batch: tty_wait")
    let set = tty_signal_set()
    if deadline_ms < 0 {
        set_poll(mut t, false)
        let m = signal.wait_fd(fs.stdin(), set) else |_| {
            return io
        }
        return m
    }
    set_poll(mut t, true)
    let m = signal.poll(set) else |_| {
        return io
    }
    m
}

/// Read what the terminal has (`read(2)` on `t->rfd`): the bytes, an empty
/// list for a VTIME tick, `hangup` at the end of input, `io` otherwise.
pub fn tty_read(t: Tty) -> List[byte] ! TtyReadError {
    assert(!t.poisoned, "terminal access in --batch: tty_read")
    var tin = fs.stdin()
    let chunk = fs.read_chunk(mut tin, 4096) else |e| match e {
        eof => {
            if t.poll_mode {
                return List[byte]()
            }
            return hangup
        },
        io => { return io },
    }
    chunk
}

/// Start the capability probe for real (`yew_tty_probe_start`,
/// `tty.c:1364-1370`): arm from the environment and write the queries.
pub fn tty_probe_start(mut t: Tty, now_ms: int) {
    assert(!t.poisoned, "terminal access in --batch: tty_probe_start")
    let config = probe_read_config(env_process())
    let truecolor = detect_truecolor(env_process())
    probe_arm(mut t, now_ms, config, truecolor)
    if config.enabled {
        tty_write_str(PROBE_QUERY) else |_| {}
    }
}

/// Arm any-motion mouse tracking (`yew_tty_mouse_motion`, `tty.c:862-900`,
/// Sprint 57.13): 1002 and 1003 are exclusive; the flag selects the
/// restore blob the guard and the restore write.
pub fn tty_mouse_motion(mut t: Tty, on: bool) {
    if t.motion == on {
        return
    }
    if on {
        t.motion = true
        guard_note(t, GUARD_MOTION)
    }
    if t.raw {
        tty_write_str(if on then MOTION_ON else MOTION_OFF) else |_| {}
    }
    if !on {
        t.motion = false
        guard_note(t, GUARD_STILL)
    }
}

/// Whether 1003 is armed (`yew_tty_mouse_motion_active`).
pub fn tty_mouse_motion_active(t: Tty) -> bool {
    t.motion
}
