fn prompt_keys_selection_is_never_text() {
    var ed = init()
    prompt(mut ed, ["!git status"], "!git st")
    ghost(mut ed, "atus")
    let hint = ed.cmdline.hint
    run(mut ed, ch("a"), term.MOD_CTRL, "ed.move.line.home")
    shift(mut ed, term.KEY_END, 0, "ed.sel.extend.line_end")
    sel(ed, 0, 7)
    expect(ed, "!git st")
    assert(ed.cmdline.hint == hint, "the hint unchanged")
    ghost(mut ed, "atus")
    assert(!ed.cmdline.walk.on, "no walk yet")
    run(mut ed, term.KEY_UP, 0, "ed.cmdline.up")
    assert(ed.cmdline.walk.on, "a walk")
    assert((str_from_utf8(ed.cmdline.walk.draft) else "") == "!git st", "the draft")
    assert((str_from_utf8(ed.cmdline.walk.term) else "") == "git st", "the term")
    expect(ed, "!git status")
}

fn yank_snap(ed: edit.Ed) -> str {
    var s = "{ed.yank.len} {ed.yank.bytes} {ed.yank.head} {ed.yank.kill_seq} {ed.yank.kill_owner} {ed.yank.kill_open} {ed.yank.yank_seq} {ed.yank.yank_owner} {ed.yank.yank_len} {ed.yank.yank_k}"
    var k = 0
    while k < ed.yank.len {
        let e = text.yank_at(ed.yank, k) else List[byte]()
        s = "{s} [{e}]"
        k += 1
    }
    s
}

fn prompt_keys_clipboard_and_yank_stack_stay_apart() {
    var ed = init()
    let c = clip_open("")
    text.clip_reset(mut ed.regs.clip)
    prompt(mut ed, none(), "e one two three")
    run(mut ed, ch("w"), term.MOD_CTRL, "ed.edit.kill.ws_word_prev")
    type_text(mut ed, "four")
    let before = yank_snap(ed)
    shift(mut ed, term.KEY_LEFT, term.MOD_ALT, "ed.sel.extend.word_prev")
    run(mut ed, ch("c"), term.MOD_CTRL, "ed.cmdline.copy_or_cancel")
    shift(mut ed, term.KEY_LEFT, term.MOD_ALT, "ed.sel.extend.word_prev")
    run(mut ed, ch("x"), term.MOD_CTRL, "ed.clip.cut")
    expect(ed, "e one four")
    assert(yank_snap(ed) == before, "the yank stack byte-identical")
    plus_holds(mut ed, "two ")
    skip("prompt_keys_clipboard_and_yank_stack_stay_apart's clipboard file", writer_gap())
    text.clip_reset(mut ed.regs.clip)
    ed.regs.clipboard_sync = text.CLIP_SYNC_ALL
    shift(mut ed, term.KEY_LEFT, term.MOD_ALT, "ed.sel.extend.word_prev")
    run(mut ed, ch("w"), term.MOD_CTRL, "ed.edit.kill.ws_word_prev")
    shift(mut ed, term.KEY_LEFT, 0, "ed.sel.extend.left")
    run(mut ed, ch("k"), term.MOD_CTRL, "ed.edit.kill.to_end")
    assert(!text.clip_pending(ed.regs.clip), "kills write no clipboard")
    plus_holds(mut ed, "two ")
    clip_done(mut ed, c)
}

fn prompt_keys_insert_mode_ctrl_c_and_ctrl_x() {
    var ed = init()
    let c = clip_open("")
    text.clip_reset(mut ed.regs.clip)
    send(mut ed, ch("i"), 0)
    assert(ed.mode == edit.MODE_I, "I")
    type_text(mut ed, "hello")
    run(mut ed, ch("c"), term.MOD_CTRL, "ed.clip.copy")
    run(mut ed, ch("x"), term.MOD_CTRL, "ed.clip.cut")
    let w = ed.win
    let p = ed.wins[w].cs.primary
    ed.wins[w].cs.curs[p].anchor = 0
    run(mut ed, ch("c"), term.MOD_CTRL, "ed.clip.copy")
    run(mut ed, ch("x"), term.MOD_CTRL, "ed.clip.cut")
    assert(ed.mode == edit.MODE_I, "still I")
    assert(doc_len(ed) == 5, "nothing cut")
    assert(!text.clip_pending(ed.regs.clip), "nothing copied")
    assert(ed.regs.system.bytes.len == 0, "the system register empty")
    ed.wins[w].cs.curs[p].anchor = ed.wins[w].cs.curs[p].pos
    shift(mut ed, term.KEY_LEFT, 0, "ed.sel.extend.left")
    shift(mut ed, term.KEY_LEFT, 0, "ed.sel.extend.left")
    assert(ed.mode == edit.MODE_H, "H")
    run(mut ed, ch("c"), term.MOD_CTRL, "ed.clip.copy")
    plus_holds(mut ed, "lo")
    skip("prompt_keys_insert_mode_ctrl_c_and_ctrl_x's clipboard file", writer_gap())
    clip_done(mut ed, c)
}

// ------------------------------------------------------------ drawing

fn color_eq(a: term.Color, b: term.Color) -> bool {
    "{a}" == "{b}"
}

// `pk_styled` (`test_prompt_keys.c:1357-1375`).
fn styled(ed: edit.Ed, x: int) -> bool {
    let (s, fields) = edit.draw_sel_style(ed)
    let cell = copy ed.grid.back[x]
    assert(fields != 0, "a selection style")
    if fields & term.OVERLAY_BG != 0 && !color_eq(cell.bg, s.bg) {
        return false
    }
    if fields & term.OVERLAY_FG != 0 && !color_eq(cell.fg, s.fg) {
        return false
    }
    if fields & term.OVERLAY_ATTRS != 0 && cell.attrs & s.attrs != s.attrs {
        return false
    }
    true
}

fn draw(mut ed: edit.Ed, cols: int) {
    edit.cmdline_draw(mut ed, edit.rect(0, 0, cols, 1))
}

fn byte0(ed: edit.Ed, x: int) -> int {
    term.cell_byte(ed.grid.back[x], 0)
}

fn prompt_keys_selection_draws_in_the_selection_style() {
    var ed = init()
    ed.grid = term.grid_new(1, 40)
    prompt(mut ed, none(), "e 0123456789abcdef")
    run(mut ed, ch("a"), term.MOD_CTRL, "ed.move.line.home")
    shift(mut ed, term.KEY_END, 0, "ed.sel.extend.line_end")
    draw(mut ed, 12)
    assert(!styled(ed, 0), "the : is not selected")
    var x = 1
    while x <= 10 {
        assert(styled(ed, x), "cell {x} selected")
        x += 1
    }
    assert(!styled(ed, 11), "the caret cell is not")
    assert(byte0(ed, 1) == ch("6"), "scrolled to 6")
    let first = "{ed.grid.back[0..12]}"
    draw(mut ed, 12)
    assert("{ed.grid.back[0..12]}" == first, "the same state draws the same cells")
    run(mut ed, term.KEY_END, 0, "ed.move.line.end")
    shift(mut ed, term.KEY_HOME, 0, "ed.sel.extend.line_home")
    sel(ed, 0, 18)
    draw(mut ed, 12)
    assert(byte0(ed, 1) == ch("e"), "home in view")
    x = 1
    while x <= 11 {
        assert(styled(ed, x), "cell {x} selected")
        x += 1
    }
    assert(!styled(ed, 0), "the : is not")
    prompt(mut ed, none(), "e ")
    paste(mut ed, "\u{65e5}\u{672c}\u{8a9e}")
    shift(mut ed, term.KEY_LEFT, 0, "ed.sel.extend.left")
    draw(mut ed, 12)
    assert(!styled(ed, 5) && !styled(ed, 6), "the neighbour is not selected")
    assert(styled(ed, 7) && styled(ed, 8), "both cells of the wide cluster")
    assert(!styled(ed, 9), "nothing after it")
    prompt(mut ed, ["!git status"], "!git st")
    run(mut ed, ch("a"), term.MOD_CTRL, "ed.move.line.home")
    shift(mut ed, term.KEY_END, 0, "ed.sel.extend.line_end")
    ghost(mut ed, "atus")
    draw(mut ed, 40)
    x = 1
    while x <= 7 {
        assert(styled(ed, x), "cell {x} selected")
        x += 1
    }
    assert(byte0(ed, 8) == ch("a"), "the ghost follows")
    x = 8
    while x <= 11 {
        assert(!styled(ed, x), "the ghost is never selected")
        x += 1
    }
}

// ================================================================== */
// Sprint 57.30: prompt history and the completion table

struct Arrows {
    up: int,
    up_mods: int,
    down: int,
    down_mods: int,
}

fn arrow_keys() -> Arrows {
    Arrows { up: term.KEY_UP, up_mods: 0, down: term.KEY_DOWN, down_mods: 0 }
}

fn ctrl_keys() -> Arrows {
    Arrows { up: ch("p"), up_mods: term.MOD_CTRL, down: ch("n"), down_mods: term.MOD_CTRL }
}

fn up(mut ed: edit.Ed, k: Arrows) {
    run(mut ed, k.up, k.up_mods, "ed.cmdline.up")
}

fn down(mut ed: edit.Ed, k: Arrows) {
    run(mut ed, k.down, k.down_mods, "ed.cmdline.down")
}

fn in_table(ed: edit.Ed) -> bool {
    edit.menu_focused(ed.cmdline.menu)
}

// `pk_enter_table` (`test_prompt_keys.c:1488-1505`): the line as it was
// just before the Tab that entered.
fn enter_table(mut ed: edit.Ed) -> str {
    var before = ""
    var i = 0
    while i < 3 && !in_table(ed) {
        before = txt(ed)
        run(mut ed, term.KEY_TAB, 0, "ed.cmdline.complete_next")
        i += 1
    }
    assert(in_table(ed), "in the table")
    before
}

fn row(ed: edit.Ed, i: int) -> str {
    assert(i < ed.cmdline.menu.items.len, "row {i} exists")
    str_from_utf8(ed.cmdline.menu.items[i].text) else "<not utf-8>"
}

fn table_scene(k: Arrows) {
    let own = ["file.zzz", "set wrap"]
    var ed = init()
    prompt(mut ed, own, "fil")
    assert(ed.cmdline.menu.items.len > 5, "more than five rows")
    assert(!in_table(ed), "not in the table")
    up(mut ed, k)
    expect(ed, "file.zzz")
    assert(!in_table(ed), "history, not the table")
    assert(ed.cmdline.menu.items.len == 0, "the table closed")
    down(mut ed, k)
    expect(ed, "fil")
    assert(ed.cmdline.menu.items.len > 5, "the table back")
    assert(!in_table(ed), "unfocused")
    var typed = enter_table(mut ed)
    assert(ed.cmdline.menu.sel == 0, "row 0")
    expect(ed, row(ed, 0))
    down(mut ed, k)
    assert(in_table(ed), "in the table")
    assert(ed.cmdline.menu.sel == 1, "row 1")
    expect(ed, row(ed, 1))
    up(mut ed, k)
    assert(ed.cmdline.menu.sel == 0, "row 0")
    expect(ed, row(ed, 0))
    let last = ed.cmdline.menu.items.len - 1
    var scrolled = false
    while ed.cmdline.menu.sel < last {
        let top = ed.cmdline.menu.top
        let s = ed.cmdline.menu.sel
        down(mut ed, k)
        assert(in_table(ed), "still in")
        assert(ed.cmdline.menu.sel == s + 1, "one row")
        assert(ed.cmdline.menu.top == top || ed.cmdline.menu.top == top + 1, "the window by one")
        if ed.cmdline.menu.top != top {
            scrolled = true
        }
    }
    assert(scrolled, "the window scrolled")
    down(mut ed, k)
    assert(!in_table(ed), "out of the table")
    assert(ed.cmdline.menu.sel == last, "the last row kept")
    assert(ed.cmdline.menu.items.len == last + 1, "the table open")
    expect(ed, row(ed, last))
    run(mut ed, term.KEY_TAB, 0, "ed.cmdline.complete_next")
    assert(in_table(ed), "Tab enters again")
    assert(ed.cmdline.menu.sel == 0, "row 0")
    down(mut ed, k)
    assert(ed.cmdline.menu.sel == 1, "row 1")
    while ed.cmdline.menu.sel < last {
        down(mut ed, k)
    }
    down(mut ed, k)
    assert(!in_table(ed), "out again")
    let again = "{row(ed, last)} again"
    edit.hist_add_str(mut ed.cmdline.history, again)
    up(mut ed, k)
    expect(ed, again)
    assert(!in_table(ed), "history")
    down(mut ed, k)
    assert(!in_table(ed), "history")
    prompt(mut ed, own, "fil")
    typed = enter_table(mut ed)
    assert(typed != row(ed, 0), "typed is not row 0")
    down(mut ed, k)
    up(mut ed, k)
    assert(ed.cmdline.menu.sel == 0, "row 0")
    up(mut ed, k)
    assert(!in_table(ed), "out")
    assert(ed.cmdline.menu.items.len == 0, "closed")
    assert(
        (str_from_utf8(ed.cmdline.walk.term) else "") == typed,
        "the walk's term is what was typed",
    )
    expect(ed, "file.zzz")
    down(mut ed, k)
    expect(ed, typed)
    assert(!in_table(ed), "out")
    let _ = enter_table(mut ed)
    run(mut ed, term.KEY_PAGE_DOWN, 0, "ed.cmdline.menu.page_next")
    assert(in_table(ed), "in")
    assert(ed.cmdline.menu.sel >= 5, "a page down")
    expect(ed, row(ed, ed.cmdline.menu.sel))
    run(mut ed, term.KEY_PAGE_UP, 0, "ed.cmdline.menu.page_prev")
    assert(ed.cmdline.menu.sel == 0, "a page up")
}

fn prompt_keys_table_rows_on_the_arrows() {
    table_scene(arrow_keys())
}

fn prompt_keys_table_rows_on_ctrl_p_and_ctrl_n() {
    table_scene(ctrl_keys())
}

fn history_scene(k: Arrows) {
    var ed = init()
    prompt(mut ed, ["e notes.txt", "set wrap", "echo wrapped", "set nowrap"], "wrap")
    up(mut ed, k)
    expect(ed, "set nowrap")
    up(mut ed, k)
    expect(ed, "echo wrapped")
    assert((str_from_utf8(ed.cmdline.walk.term) else "") == "wrap", "frozen term")
    up(mut ed, k)
    expect(ed, "set wrap")
    up(mut ed, k)
    expect(ed, "set wrap")
    down(mut ed, k)
    expect(ed, "echo wrapped")
    down(mut ed, k)
    expect(ed, "set nowrap")
    down(mut ed, k)
    expect(ed, "wrap")
    down(mut ed, k)
    expect(ed, "wrap")
    up(mut ed, k)
    up(mut ed, k)
    expect(ed, "echo wrapped")
    type_text(mut ed, "x")
    assert(!ed.cmdline.walk.on, "an edit ends the walk")
    up(mut ed, k)
    expect(ed, "echo wrappedx")
    assert((str_from_utf8(ed.cmdline.walk.term) else "") == "echo wrappedx", "the new term")
    prompt(mut ed, none(), "WRAP")
    up(mut ed, k)
    expect(ed, "WRAP")
    prompt(mut ed, none(), "")
    up(mut ed, k)
    expect(ed, "set nowrap")
    up(mut ed, k)
    expect(ed, "echo wrapped")
    up(mut ed, k)
    expect(ed, "set wrap")
    up(mut ed, k)
    expect(ed, "e notes.txt")
}

fn prompt_keys_history_is_a_substring_walk() {
    history_scene(arrow_keys())
    history_scene(ctrl_keys())
}

fn prompt_keys_search_prompt_walks_its_own_history() {
    var ed = init()
    send(mut ed, ch("/"), 0)
    assert(ed.cmdline.active, "open")
    assert(ed.cmdline.kind == edit.PROMPT_SEARCH_F, "the / prompt")
    edit.hist_add_str(mut ed.cmdline.history, "alpha beta")
    edit.hist_add_str(mut ed.cmdline.history, "gamma")
    type_text(mut ed, "bet")
    run(mut ed, term.KEY_UP, 0, "ed.cmdline.up")
    expect(ed, "alpha beta")
    assert(!ed.cmdline.walk_bang, "not a bang walk")
}

// `pk_match_styled` (`test_prompt_keys.c:1772-1786`).
fn match_styled(ed: edit.Ed, x: int) -> bool {
    let (m, fields) = edit.draw_search_style(ed, false)
    let cell = copy ed.grid.back[x]
    assert(fields != 0, "a match style")
    if fields & term.OVERLAY_BG != 0 && !color_eq(cell.bg, m.bg) {
        return false
    }
    if fields & term.OVERLAY_ATTRS != 0 && cell.attrs & m.attrs != m.attrs {
        return false
    }
    true
}

fn hist_hit(ed: edit.Ed) -> bool {
    let (hit, _) = edit.cmdline_hist_match(ed)
    hit
}

fn prompt_keys_history_highlight_is_state() {
    var ed = init()
    ed.grid = term.grid_new(1, 40)
    prompt(mut ed, ["echo wrapped", "set nowrap"], "wrap")
    assert(!hist_hit(ed), "no walk, no highlight")
    run(mut ed, term.KEY_UP, 0, "ed.cmdline.up")
    run(mut ed, term.KEY_UP, 0, "ed.cmdline.up")
    expect(ed, "echo wrapped")
    let (hit, sp) = edit.cmdline_hist_match(ed)
    assert(hit && sp.lo == 5 && sp.hi == 9, "bytes 5..9")
    draw(mut ed, 40)
    var x = 0
    while x <= 5 {
        assert(!match_styled(ed, x), "cell {x} plain")
        x += 1
    }
    while x <= 9 {
        assert(match_styled(ed, x), "cell {x} highlighted")
        x += 1
    }
    while x <= 13 {
        assert(!match_styled(ed, x), "cell {x} plain")
        x += 1
    }
    ghost(mut ed, "")
    run(mut ed, term.KEY_DOWN, 0, "ed.cmdline.down")
    run(mut ed, term.KEY_DOWN, 0, "ed.cmdline.down")
    expect(ed, "wrap")
    assert(!hist_hit(ed), "back at the draft")
    run(mut ed, term.KEY_UP, 0, "ed.cmdline.up")
    assert(hist_hit(ed), "walked")
    type_text(mut ed, "!")
    assert(!hist_hit(ed), "after an edit")
    expect(ed, "set nowrap!")
    prompt(mut ed, none(), "")
    run(mut ed, term.KEY_UP, 0, "ed.cmdline.up")
    expect(ed, "set nowrap")
    assert(!hist_hit(ed), "an empty term highlights nothing")
}

fn rows(ed: edit.Ed, want: List[str]) {
    assert(
        ed.cmdline.menu.items.len == want.len,
        "{ed.cmdline.menu.items.len} rows, want {want.len}",
    )
    var i = 0
    while i < want.len {
        assert(row(ed, i) == want[i], "row {i}: '{row(ed, i)}'")
        i += 1
    }
}

// `pk_row_has` (`test_prompt_keys.c:1856-1871`).
fn row_has(ed: edit.Ed, r: int, s: str) -> bool {
    var b = List[byte]()
    var x = 0
    while x < ed.grid.cols {
        let c = term.cell_byte(ed.grid.back[r * ed.grid.cols + x], 0)
        (mut b).push((if c >= 32 && c < 127 then c else 46) as byte)
        x += 1
    }
    let line = str_from_utf8(b) else ""
    line.contains(s)
}

fn prompt_keys_ctrl_r_searches_history() {
    let own = [
        "set shell.suggest_history all",
        "e notes.txt",
        "set shell.suggest_history yew",
        "echo hi",
    ]
    var ed = init()
    prompt(mut ed, own, "")
    run(mut ed, ch("r"), term.MOD_CTRL, "ed.cmdline.hist_search")
    assert(ed.cmdline.hsearch, "C-r")
    rows(
        ed,
        [
            "echo hi",
            "set shell.suggest_history yew",
            "e notes.txt",
            "set shell.suggest_history all",
        ],
    )
    assert(ed.cmdline.menu.sel == 0, "the newest")
    assert(ed.cmdline.menu.where == "history search", "the mode named")
    type_text(mut ed, "suggest")
    expect(ed, "suggest")
    assert(ed.cmdline.hsearch, "still searching")
    rows(ed, ["set shell.suggest_history yew", "set shell.suggest_history all"])
    assert(ed.cmdline.menu.sel == 0, "the newest")
    assert(ed.cmdline.menu.items[0].m.pos.len == 7, "seven matched bytes")
    assert(ed.cmdline.menu.items[0].m.pos[0] == 10, "from byte 10")
    ed.grid = term.grid_new(8, 60)
    edit.cmdline_draw(mut ed, edit.rect(0, 7, 60, 1))
    var footer = false
    var r = 0
    while r < 7 {
        footer = footer || row_has(ed, r, "history search 1/2")
        r += 1
    }
    assert(footer, "the footer names the mode and the count")
    run(mut ed, ch("r"), term.MOD_CTRL, "ed.cmdline.hist_search")
    assert(ed.cmdline.menu.sel == 1, "older")
    run(mut ed, ch("r"), term.MOD_CTRL, "ed.cmdline.hist_search")
    assert(ed.cmdline.menu.sel == 1, "stays")
    run(mut ed, term.KEY_UP, 0, "ed.cmdline.up")
    assert(ed.cmdline.menu.sel == 0, "up")
    run(mut ed, term.KEY_DOWN, 0, "ed.cmdline.down")
    assert(ed.cmdline.menu.sel == 1, "down")
    run(mut ed, ch("p"), term.MOD_CTRL, "ed.cmdline.up")
    assert(ed.cmdline.menu.sel == 0, "C-p")
    run(mut ed, ch("n"), term.MOD_CTRL, "ed.cmdline.down")
    assert(ed.cmdline.menu.sel == 1, "C-n")
    run(mut ed, term.KEY_PAGE_UP, 0, "ed.cmdline.menu.page_prev")
    assert(ed.cmdline.menu.sel == 0, "PgUp")
    run(mut ed, term.KEY_PAGE_DOWN, 0, "ed.cmdline.menu.page_next")
    assert(ed.cmdline.menu.sel == 1, "PgDn")
    expect(ed, "suggest")
    run(mut ed, term.KEY_ENTER, 0, "ed.cmdline.accept")
    assert(ed.cmdline.active, "filled, not run")
    assert(!ed.cmdline.hsearch, "left the search")
    expect(ed, "set shell.suggest_history all")
    assert((ed.opts.store["shell.suggest_history"] else "") == "yew", "not run yet")
    run(mut ed, term.KEY_ENTER, 0, "ed.cmdline.accept")
    assert(!ed.cmdline.active, "ran")
    assert((ed.opts.store["shell.suggest_history"] else "") == "all", "and set the option")
}

fn prompt_keys_ctrl_r_escape_restores_the_line() {
    var ed = init()
    prompt(mut ed, ["echo one", "echo two"], "ec")
    run(mut ed, ch("r"), term.MOD_CTRL, "ed.cmdline.hist_search")
    assert(ed.cmdline.menu.items.len == 2, "two rows")
    type_text(mut ed, "ho t")
    expect(ed, "echo t")
    assert(ed.cmdline.menu.items.len == 1, "one row")
    run(mut ed, term.KEY_ESCAPE, 0, "ed.cmdline.cancel")
    assert(ed.cmdline.active, "open")
    assert(!ed.cmdline.hsearch, "left")
    expect(ed, "ec")
    run(mut ed, ch("r"), term.MOD_CTRL, "ed.cmdline.hist_search")
    type_text(mut ed, "zzz")
    assert(ed.cmdline.menu.items.len == 0, "no rows")
    assert(ed.cmdline.hint == "history search: no match", "said: '{ed.cmdline.hint}'")
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    assert(ed.cmdline.active, "open")
    assert(!ed.cmdline.hsearch, "left")
    expect(ed, "ec")
    run(mut ed, ch("r"), term.MOD_CTRL, "ed.cmdline.hist_search")
    run(mut ed, term.KEY_TAB, 0, "ed.cmdline.complete_next")
    assert(!ed.cmdline.hsearch, "Tab leaves the search")
    assert(ed.cmdline.menu.where != "history search", "completion's rows")
}

fn prompt_keys_ctrl_r_on_a_bang_line() {
    var ed = init()
    prompt(mut ed, ["!make all", "!git stage -p"], "r !a")
    run(mut ed, ch("r"), term.MOD_CTRL, "ed.cmdline.hist_search")
    assert(ed.cmdline.menu.items.len == 2, "two rows")
    assert(row(ed, 0) == "git stage -p", "the newest body")
    run(mut ed, ch("r"), term.MOD_CTRL, "ed.cmdline.hist_search")
    run(mut ed, term.KEY_ENTER, 0, "ed.cmdline.accept")
    assert(ed.cmdline.active, "filled")
    expect(ed, "r !make all")
}

fn prompt_keys_token_search_replaces_only_the_token() {
    let own = ["e src/main.c", "e src/util.c", "e docs/main.md", "e src/main.c"]
    var ed = init()
    prompt(mut ed, own, "e main x")
    run(mut ed, ch("b"), term.MOD_ALT, "ed.move.word.prev")
    run(mut ed, ch("b"), term.MOD_ALT, "ed.move.word.prev")
    assert(caret(ed) == 2, "on main")
    run(mut ed, term.KEY_UP, term.MOD_ALT, "ed.cmdline.token_prev")
    expect(ed, "e src/main.c x")
    assert(caret(ed) == 12, "caret after the token")
    run(mut ed, term.KEY_UP, term.MOD_ALT, "ed.cmdline.token_prev")
    expect(ed, "e docs/main.md x")
    run(mut ed, term.KEY_UP, term.MOD_ALT, "ed.cmdline.token_prev")
    expect(ed, "e docs/main.md x")
    run(mut ed, term.KEY_DOWN, term.MOD_ALT, "ed.cmdline.token_next")
    expect(ed, "e src/main.c x")
    run(mut ed, term.KEY_DOWN, term.MOD_ALT, "ed.cmdline.token_next")
    expect(ed, "e main x")
    run(mut ed, term.KEY_DOWN, term.MOD_ALT, "ed.cmdline.token_next")
    expect(ed, "e main x")
    run(mut ed, term.KEY_UP, term.MOD_ALT, "ed.cmdline.token_prev")
    expect(ed, "e src/main.c x")
    run(mut ed, term.KEY_LEFT, 0, "ed.move.char.prev")
    run(mut ed, term.KEY_UP, term.MOD_ALT, "ed.cmdline.token_prev")
    assert((str_from_utf8(ed.cmdline.tok_term) else "") == "src/main.c", "the new term")
    expect(ed, "e src/main.c x")
    prompt(mut ed, own, "x util y")
    run(mut ed, ch("b"), term.MOD_ALT, "ed.move.word.prev")
    run(mut ed, ch("b"), term.MOD_ALT, "ed.move.word.prev")
    run(mut ed, term.KEY_UP, term.MOD_ALT, "ed.cmdline.token_prev")
    expect(ed, "x src/util.c y")
}

fn prompt_keys_token_search_on_a_bang_line() {
    var ed = init()
    prompt(mut ed, ["!cp a \"my file\" b", "!grep -n 'my pat' src"], "!cat my")
    run(mut ed, term.KEY_UP, term.MOD_ALT, "ed.cmdline.token_prev")
    assert(ed.cmdline.tok_bang, "a bang walk")
    expect(ed, "!cat 'my pat'")
    run(mut ed, term.KEY_UP, term.MOD_ALT, "ed.cmdline.token_prev")
    expect(ed, "!cat \"my file\"")
    run(mut ed, term.KEY_DOWN, term.MOD_ALT, "ed.cmdline.token_next")
    run(mut ed, term.KEY_DOWN, term.MOD_ALT, "ed.cmdline.token_next")
    expect(ed, "!cat my")
}

// ----------------------------------------------------- fish's extras

fn sudo(mut ed: edit.Ed) {
    run(mut ed, ch("s"), term.MOD_ALT, "ed.cmdline.toggle_sudo")
}

// `pk_caret_to` (`test_prompt_keys.c:2117-2125`).
fn caret_to(mut ed: edit.Ed, at: int) {
    run(mut ed, ch("a"), term.MOD_CTRL, "ed.move.line.home")
    var i = 0
    while i < at {
        send(mut ed, ch("f"), term.MOD_CTRL)
        i += 1
    }
    assert(caret(ed) == at, "caret {at}")
}

fn prompt_keys_alt_s_toggles_sudo() {
    var ed = init()
    prompt(mut ed, none(), "!make")
    sudo(mut ed)
    expect(ed, "!sudo make")
    assert(caret(ed) == 10, "caret 10")
    sudo(mut ed)
    expect(ed, "!make")
    assert(caret(ed) == 5, "caret 5")
    prompt(mut ed, none(), "!  doas rm x")
    sudo(mut ed)
    expect(ed, "!  rm x")
    sudo(mut ed)
    expect(ed, "!  sudo rm x")
    prompt(mut ed, none(), "!sudo")
    sudo(mut ed)
    expect(ed, "!")
    prompt(mut ed, none(), "!sudoedit x")
    sudo(mut ed)
    expect(ed, "!sudo sudoedit x")
    prompt(mut ed, none(), "r !ls")
    sudo(mut ed)
    expect(ed, "r !sudo ls")
    prompt(mut ed, none(), "%!sort")
    sudo(mut ed)
    expect(ed, "%!sudo sort")
    prompt(mut ed, none(), "!!top")
    sudo(mut ed)
    expect(ed, "!!sudo top")
    prompt(mut ed, ["!make test", "e foo.c"], "!")
    sudo(mut ed)
    expect(ed, "!sudo make test")
    assert(caret(ed) == 15, "caret 15")
    prompt(mut ed, ["!make test", "e foo.c"], "! ")
    sudo(mut ed)
    expect(ed, "! sudo make test")
    prompt(mut ed, ["!sudo apt update"], "!")
    sudo(mut ed)
    expect(ed, "!sudo apt update")
    var fresh = init()
    prompt(mut fresh, none(), "!")
    sudo(mut fresh)
    expect(fresh, "!sudo ")
}

fn prompt_keys_alt_s_keeps_the_caret_on_its_text() {
    var ed = init()
    prompt(mut ed, none(), "!make test")
    caret_to(mut ed, 6)
    sudo(mut ed)
    expect(ed, "!sudo make test")
    assert(caret(ed) == 11, "caret 11")
    sudo(mut ed)
    assert(caret(ed) == 6, "caret 6")
    caret_to(mut ed, 1)
    sudo(mut ed)
    assert(caret(ed) == 6, "caret 6 again")
    caret_to(mut ed, 3)
    sudo(mut ed)
    expect(ed, "!make test")
    assert(caret(ed) == 1, "caret 1")
    caret_to(mut ed, 0)
    sudo(mut ed)
    expect(ed, "!sudo make test")
    assert(caret(ed) == 0, "caret 0")
}

fn prompt_keys_alt_s_refuses_and_undoes_in_one_step() {
    var ed = init()
    prompt(mut ed, none(), "e foo.c")
    sudo(mut ed)
    expect(ed, "e foo.c")
    assert(ed.msg.text == "A-s: not a shell command", "refused")
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    send(mut ed, ch("/"), 0)
    assert(ed.cmdline.kind == edit.PROMPT_SEARCH_F, "the / prompt")
    type_text(mut ed, "!x")
    sudo(mut ed)
    expect(ed, "!x")
    assert(ed.msg.text == "A-s: not a shell command", "refused on /")
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    prompt(mut ed, none(), "!make")
    sudo(mut ed)
    expect(ed, "!sudo make")
    run(mut ed, ch("_"), term.MOD_CTRL, "ed.edit.undo")
    expect(ed, "!make")
    run(mut ed, ch("/"), term.MOD_ALT, "ed.edit.redo")
    expect(ed, "!sudo make")
    sudo(mut ed)
    expect(ed, "!make")
    run(mut ed, ch("_"), term.MOD_CTRL, "ed.edit.undo")
    expect(ed, "!sudo make")
}

fn man(mut ed: edit.Ed, line: str, caret_at: int) -> (List[str], str) {
    edit.cmdline_man_argv(mut ed, bytes_of(line), caret_at)
}

fn prompt_keys_alt_h_builds_the_man_argv() {
    var ed = init()
    let (a1, w1) = man(mut ed, "!git che", 8)
    assert(a1.len == 6, "six: {a1.len} ({w1})")
    assert(a1[0] == "/bin/sh" && a1[1] == "-c", "sh -c")
    assert(a1[2] == "man -- \"$1\" 2>/dev/null || man -- \"$2\"", "the two-page script")
    assert(a1[3] == "sh", "$0")
    assert(a1[4] == "git-che" && a1[5] == "git", "git-che, git: {a1[4]} {a1[5]}")
    assert(w1 == "", "no why")
    let (a2, _) = man(mut ed, "!/usr/bin/git checkout -b fo", 28)
    assert(a2.len == 6 && a2[4] == "git-checkout" && a2[5] == "git", "the walked subcommand")
    let (a3, _) = man(mut ed, "!git log", 3)
    assert(a3.len == 5 && a3[2] == "man -- \"$1\"" && a3[4] == "git", "on the command word")
    let (a4, _) = man(mut ed, "!sudo make", 10)
    assert(a4.len == 5 && a4[4] == "make", "the wrapper stripped")
    let (a5, _) = man(mut ed, "!ls -la | sort -r", 16)
    assert(a5.len == 5 && a5[4] == "sort", "the command under the caret")
    let (a6, _) = man(mut ed, "!ls -la | sort -r", 2)
    assert(a6.len == 5 && a6[4] == "ls", "the first command")
    let (a7, _) = man(mut ed, "!'my tool' x", 12)
    assert(a7.len == 5 && a7[4] == "my tool" && a7[2] == "man -- \"$1\"", "a quoted name decoded")
    let (a8, _) = man(mut ed, "!git ../x", 9)
    assert(a8.len == 5 && a8[4] == "git", "not a plain word")
    let (a9, w9) = man(mut ed, "!", 1)
    assert(a9.len == 0 && w9 == "A-h: no command under the caret", "nothing")
    let (a10, w10) = man(mut ed, "!-rf x", 2)
    assert(a10.len == 0 && w10 == "A-h: no command under the caret", "an option")
    let (a11, w11) = man(mut ed, "e foo", 5)
    assert(a11.len == 0 && w11 == "A-h: man pages are for :! commands", "not a bang line")
}

// `PkMan` (`test_prompt_keys.c:2194-2264`): a fake `man` first on PATH.
struct Man {
    dir: str,
    out: str,
    path: str,
}

fn man_open(mut ed: edit.Ed, have: str) -> Man {
    let script = "#!/bin/sh\n{{ printf '%s\\n' \"$#\"; for a in \"$@\"; do printf '[%s]\\n' \"$a\"; done; }} >> \"$YEW_TEST_MAN_OUT\"\ncase \" $YEW_TEST_MAN_HAVE \" in *\" $2 \"*) exit 0 ;; esac\nexit 1\n"
    let path = env_get("PATH") else "/usr/bin:/bin"
    let cwd = std_env.cwd() else "."
    let dir = "{cwd}/target/tests/yew-pkman-{std_env.pid()}"
    fs.remove_dir_all(dir) else |_| {}
    fs.create_dir_all(dir) else |_| {
        assert(false, "man dir")
    }
    fs.write_text("{dir}/man", script) else |_| {
        assert(false, "man script")
    }
    fs.set_mode("{dir}/man", 493) else |_| {
        assert(false, "chmod man")
    }
    env_set("PATH", "{dir}:{path}") else |_| {}
    env_set("YEW_TEST_MAN_OUT", "{dir}/out") else |_| {}
    env_set("YEW_TEST_MAN_HAVE", have) else |_| {}
    ed.ws_dir = dir
    Man { dir: dir, out: "{dir}/out", path: path }
}

fn man_saw(m: Man, want: str) {
    let got = fs.read_text(m.out) else ""
    fs.remove(m.out) else |_| {}
    assert(got == want, "man saw '{got}', want '{want}'")
}

fn man_done(m: Man) {
    fs.remove_dir_all(m.dir) else |_| {}
    env_set("PATH", m.path) else |_| {}
    env_unset("YEW_TEST_MAN_OUT") else |_| {}
    env_unset("YEW_TEST_MAN_HAVE") else |_| {}
}

fn man_key(mut ed: edit.Ed) {
    run(mut ed, ch("h"), term.MOD_ALT, "ed.cmdline.man_page")
}

fn prompt_keys_alt_h_runs_man_with_names_as_arguments() {
    var ed = init()
    let m = man_open(mut ed, "git a b;$(touch pwned)`touch pwned`")
    let pwned = "{m.dir}/pwned"
    prompt(mut ed, none(), "!'a b;$(touch pwned)`touch pwned`' -x")
    let gen = ed.cmdline.generation
    caret_to(mut ed, 3)
    man_key(mut ed)
    man_saw(m, "2\n[--]\n[a b;$(touch pwned)`touch pwned`]\n")
    assert(!fs.exists(pwned), "nothing ran")
    assert(ed.cmdline.active, "the prompt stays")
    assert(ed.cmdline.generation == gen, "the same prompt")
    assert(ed.cmdline.kind == edit.PROMPT_CMD, "its kind")
    assert(ed.mode == edit.MODE_E, "E")
    expect(ed, "!'a b;$(touch pwned)`touch pwned`' -x")
    assert(caret(ed) == 3, "its caret")
    assert(!ed.msg.active, "no message")
    prompt(mut ed, none(), "!git che")
    shift(mut ed, term.KEY_LEFT, 0, "ed.sel.extend.left")
    sel(ed, 7, 8)
    man_key(mut ed)
    man_saw(m, "2\n[--]\n[git-che]\n2\n[--]\n[git]\n")
    assert(!ed.msg.active, "no message")
    nosel(ed)
    assert(caret(ed) == 7, "caret 7")
    expect(ed, "!git che")
    man_done(m)
}

fn prompt_keys_alt_h_reports_a_missing_page() {
    var ed = init()
    let m = man_open(mut ed, "")
    prompt(mut ed, none(), "!sudo make all")
    caret_to(mut ed, 8)
    man_key(mut ed)
    man_saw(m, "2\n[--]\n[make]\n")
    assert(ed.msg.text == "no man page for make", "said: '{ed.msg.text}'")
    expect(ed, "!sudo make all")
    assert(caret(ed) == 8, "caret 8")
    prompt(mut ed, none(), "!git frob")
    man_key(mut ed)
    man_saw(m, "2\n[--]\n[git-frob]\n2\n[--]\n[git]\n")
    assert(ed.msg.text == "no man page for git-frob or git", "said: '{ed.msg.text}'")
    prompt(mut ed, none(), "e foo.c")
    man_key(mut ed)
    assert(ed.msg.text == "A-h: man pages are for :! commands", "not a bang line")
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    send(mut ed, ch("/"), 0)
    type_text(mut ed, "!ls")
    man_key(mut ed)
    assert(ed.msg.text == "A-h: man pages are for :! commands", "not on /")
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    prompt(mut ed, none(), "!")
    man_key(mut ed)
    assert(ed.msg.text == "A-h: no command under the caret", "nothing")
    man_saw(m, "")
    man_done(m)
}

// ----------------------------------------------------------------- A-e

fn edit_key(mut ed: edit.Ed) {
    run(mut ed, ch("e"), term.MOD_ALT, "ed.cmdline.edit_in_buffer")
}

// `pk_colon` (`test_prompt_keys.c:2306-2315`).
fn colon(mut ed: edit.Ed, line: str, want_ok: bool) {
    send(mut ed, term.KEY_ESCAPE, 0)
    assert(ed.mode == edit.MODE_L, "colon: from L")
    send(mut ed, ch(":"), 0)
    type_text(mut ed, line)
    try_key(mut ed, term.KEY_ENTER, 0)
    if (ed.last_status == edit.CMD_OK) != want_ok {
        say("prompt_keys_test: :{line}: status {ed.last_status}: '{ed.msg.text}'")
    }
    assert((ed.last_status == edit.CMD_OK) == want_ok, ":{line}: status {ed.last_status}")
}

// `pk_scratch` (`test_prompt_keys.c:2317-2350`).
fn scratch(ed: edit.Ed, want: str) {
    let bi = edit.ws_scratch_find(ed, "*command-line*")
    assert(bi >= 0, "the *command-line* buffer exists")
    assert(ed.win >= 0 && ed.wins[ed.win].buf == bi, "and is focused")
    assert(!ed.cmdline.active, "no prompt")
    let got = str_from_utf8(text.textbuf_bytes(ed.bufs[bi].ec.tb)) else "<not utf-8>"
    if got != want {
        say("prompt_keys_test: *command-line* holds '{got}', want '{want}'")
    }
    assert(got == want, "the buffer holds '{got}'")
}

fn doc_caret(ed: edit.Ed) -> int {
    let p = ed.wins[ed.win].cs.primary
    ed.wins[ed.win].cs.curs[p].pos
}

// `pk_back` (`test_prompt_keys.c:2360-2372`).
fn back(ed: edit.Ed, kind: int, want: str, at: int) {
    assert(ed.cmdline.active, "the prompt is back")
    assert(ed.cmdline.kind == kind, "its kind")
    assert(ed.mode == edit.MODE_E, "E")
    expect(ed, want)
    assert(caret(ed) == at, "caret {caret(ed)}, want {at}")
    assert(edit.ws_scratch_find(ed, "*command-line*") < 0, "the buffer gone")
    assert(ed.cmdedit.buf_id == 0, "nothing open")
}

fn tab_id_active(ed: edit.Ed) -> int {
    ed.tabs[ed.tab_active].tab_id
}

fn prompt_keys_alt_e_edits_the_body_and_q_returns_it() {
    var ed = init()
    let tabs = ed.tabs.len
    let origin = tab_id_active(ed)
    prompt(mut ed, none(), "!make test")
    caret_to(mut ed, 3)
    edit_key(mut ed)
    scratch(ed, "make test")
    assert(ed.mode == edit.MODE_I, "I")
    assert(doc_caret(ed) == 2, "the caret where it was")
    assert(ed.tabs.len == tabs + 1, "a tab of its own")
    type_text(mut ed, "x")
    scratch(ed, "maxke test")
    colon(mut ed, "q", true)
    back(ed, edit.PROMPT_CMD, "!maxke test", 11)
    assert(ed.tabs.len == tabs, "its tab closed")
    assert(tab_id_active(ed) == origin, "back in the origin tab")
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    assert(ed.mode == edit.MODE_L, "L")
    prompt(mut ed, none(), "e foo.c")
    run(mut ed, ch("v"), term.MOD_ALT, "ed.cmdline.edit_in_buffer")
    scratch(ed, "e foo.c")
    assert(doc_caret(ed) == 7, "caret 7")
    type_text(mut ed, "x")
    colon(mut ed, "wq", true)
    back(ed, edit.PROMPT_CMD, "e foo.cx", 8)
    edit_key(mut ed)
    colon(mut ed, "close", true)
    back(ed, edit.PROMPT_CMD, "e foo.cx", 8)
    edit_key(mut ed)
    colon(mut ed, "tabclose", true)
    back(ed, edit.PROMPT_CMD, "e foo.cx", 8)
}

fn prompt_keys_alt_e_discard_returns_the_original() {
    var ed = init()
    prompt(mut ed, none(), "r !date -u")
    caret_to(mut ed, 5)
    edit_key(mut ed)
    scratch(ed, "date -u")
    assert(doc_caret(ed) == 2, "caret 2")
    type_text(mut ed, "zzz")
    send(mut ed, term.KEY_ENTER, 0)
    type_text(mut ed, "echo 'open")
    colon(mut ed, "q!", true)
    back(ed, edit.PROMPT_CMD, "r !date -u", 5)
    edit_key(mut ed)
    type_text(mut ed, "qqq")
    colon(mut ed, "close!", true)
    back(ed, edit.PROMPT_CMD, "r !date -u", 5)
}

fn lines(mut ed: edit.Ed, ls: List[str]) {
    var i = 0
    while i < ls.len {
        if i != 0 {
            send(mut ed, term.KEY_ENTER, 0)
        }
        type_text(mut ed, ls[i])
        i += 1
    }
}

fn join_case(mut ed: edit.Ed, ls: List[str], want: str) {
    prompt(mut ed, none(), "!")
    edit_key(mut ed)
    lines(mut ed, ls)
    colon(mut ed, "q", true)
    back(ed, edit.PROMPT_CMD, want, want.len)
}

fn prompt_keys_alt_e_joins_lines_as_the_shell_would() {
    var ed = init()
    join_case(mut ed, ["make", "make install"], "!make; make install")
    join_case(mut ed, ["cc a.c \\", "  -o a"], "!cc a.c -o a")
    join_case(mut ed, ["echo a\\", "b"], "!echo ab")
    join_case(mut ed, ["ls |", "sort &&", "echo ok"], "!ls | sort && echo ok")
    join_case(mut ed, ["if true; then", "  echo y", "fi", ""], "!if true; then echo y; fi")
    join_case(mut ed, ["ls", "", "", "pwd", "", ""], "!ls; pwd")
}

fn prompt_keys_alt_e_refuses_a_newline_it_cannot_join() {
    var ed = init()
    let tabs = ed.tabs.len
    prompt(mut ed, none(), "!")
    edit_key(mut ed)
    lines(mut ed, ["ls", "pwd", "echo 'x", "y'"])
    colon(mut ed, "q", false)
    assert(
        ed.msg.text.contains("line 3: a one-line prompt cannot hold a newline inside quotes"),
        "refused: '{ed.msg.text}'",
    )
    assert(ed.cmdline.active, "the :q line stays up")
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    scratch(ed, "ls\npwd\necho 'x\ny'")
    assert(ed.tabs.len == tabs + 1, "still open")
    colon(mut ed, "tabclose", false)
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    scratch(ed, "ls\npwd\necho 'x\ny'")
    colon(mut ed, "close", false)
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    scratch(ed, "ls\npwd\necho 'x\ny'")
    colon(mut ed, "q!", true)
    back(ed, edit.PROMPT_CMD, "!", 1)
    edit_key(mut ed)
    lines(mut ed, ["ls # list", "pwd"])
    colon(mut ed, "q", false)
    assert(ed.msg.text.contains("line 1: "), "a comment refused: '{ed.msg.text}'")
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    colon(mut ed, "q!", true)
    prompt(mut ed, none(), "e foo")
    edit_key(mut ed)
    send(mut ed, term.KEY_ENTER, 0)
    type_text(mut ed, "bar")
    colon(mut ed, "q", false)
    assert(
        ed.msg.text.contains("line 1: a one-line prompt cannot hold a newline"),
        "not shell: '{ed.msg.text}'",
    )
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    send(mut ed, ch("i"), 0)
    send(mut ed, term.KEY_HOME, 0)
    send(mut ed, term.KEY_BACKSPACE, 0)
    scratch(ed, "e foobar")
    colon(mut ed, "q", true)
    back(ed, edit.PROMPT_CMD, "e foobar", 8)
}

fn prompt_keys_alt_e_returns_on_any_release() {
    var ed = init()
    prompt(mut ed, none(), "!ls")
    edit_key(mut ed)
    type_text(mut ed, " -la")
    send(mut ed, term.KEY_ESCAPE, 0)
    let idx = ed.tab_active
    assert(edit.tab_close(mut ed, idx), "the tab closed")
    edit.cmdedit_settle(mut ed)
    back(ed, edit.PROMPT_CMD, "!ls -la", 7)
    edit_key(mut ed)
    send(mut ed, term.KEY_END, 0)
    send(mut ed, term.KEY_ENTER, 0)
    lines(mut ed, ["echo 'a", "b'"])
    send(mut ed, term.KEY_ESCAPE, 0)
    let idx2 = ed.tab_active
    assert(edit.tab_close(mut ed, idx2), "closed")
    edit.cmdedit_settle(mut ed)
    assert(
        ed.msg.text.contains("line 2: a one-line prompt cannot hold a newline inside quotes"),
        "kept as a buffer: '{ed.msg.text}'",
    )
    scratch(ed, "ls -la\necho 'a\nb'")
    edit.ws_scratch_drop(mut ed, ed.wins[ed.win].buf)
    edit.cmdedit_settle(mut ed)
    assert(edit.ws_scratch_find(ed, "*command-line*") >= 0, "back as a buffer again")
    colon(mut ed, "q!", true)
    back(ed, edit.PROMPT_CMD, "!ls -la", 7)
    edit_key(mut ed)
    type_text(mut ed, " /")
    send(mut ed, term.KEY_ESCAPE, 0)
    send(mut ed, ch(":"), 0)
    type_text(mut ed, "e x")
    edit.ws_scratch_drop(mut ed, edit.ws_scratch_find(ed, "*command-line*"))
    edit.cmdedit_settle(mut ed)
    assert(ed.cmdedit.released, "released, waiting")
    expect(ed, "e x")
    edit_key(mut ed)
    assert(
        ed.msg.text == "A-e: *command-line* is still returning its line",
        "one at a time: '{ed.msg.text}'",
    )
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    back(ed, edit.PROMPT_CMD, "!ls -la /", 9)
}

fn prompt_keys_alt_e_twice_switches_to_the_open_buffer() {
    var ed = init()
    let tabs = ed.tabs.len
    prompt(mut ed, none(), "!make")
    edit_key(mut ed)
    send(mut ed, term.KEY_ESCAPE, 0)
    edit.tab_switch(mut ed, 0)
    send(mut ed, ch(":"), 0)
    type_text(mut ed, "e other")
    edit_key(mut ed)
    scratch(ed, "make")
    assert(ed.tabs.len == tabs + 1, "one buffer")
    assert(ed.msg.text == "*command-line* is already open", "said: '{ed.msg.text}'")
    assert(ed.mode == edit.MODE_I, "I")
    colon(mut ed, "q", true)
    back(ed, edit.PROMPT_CMD, "!make", 5)
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    prompt(mut ed, none(), "e ot")
    run(mut ed, term.KEY_UP, 0, "ed.cmdline.up")
    expect(ed, "e other")
}

fn prompt_keys_alt_e_keeps_the_prompt_kind() {
    var ed = init()
    send(mut ed, ch("?"), 0)
    assert(ed.cmdline.kind == edit.PROMPT_SEARCH_B, "the ? prompt")
    type_text(mut ed, "needle")
    edit_key(mut ed)
    scratch(ed, "needle")
    type_text(mut ed, "s")
    colon(mut ed, "q", true)
    back(ed, edit.PROMPT_SEARCH_B, "needles", 7)
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    edit.cmdline_open_input(mut ed, "answer", edit.INPUT_DONE_NONE, 0)
    edit_key(mut ed)
    assert(ed.cmdline.active, "the prompt stays")
    assert(ed.cmdline.kind == edit.PROMPT_INPUT, "its kind")
    assert(ed.msg.text == "A-e: this prompt cannot become a buffer", "said: '{ed.msg.text}'")
    expect(ed, "answer")
}

// `pk_oneline` (`test_prompt_keys.c:2797-2818`): "" for `want` with
// `refused` is C's NULL.
fn oneline(input: str, shell: bool, want: str, refused: bool, want_line: int) {
    var out = List[byte]()
    let (ok, line, _) = edit.cmdedit_oneline(bytes_of(input), shell, mut out)
    assert(ok == !refused, "'{input}': ok {ok}")
    if !refused {
        let got = str_from_utf8(out) else "<not utf-8>"
        assert(got == want, "'{input}' -> '{got}', want '{want}'")
    } else {
        assert(line == want_line, "'{input}': line {line}, want {want_line}")
    }
}

fn cmdedit_oneline_rules() {
    oneline("make\nmake install\n", true, "make; make install", false, 0)
    oneline("make\r\nmake install\r\n", true, "make; make install", false, 0)
    oneline("a &\nb", true, "a & b", false, 0)
    oneline("a;\nb", true, "a; b", false, 0)
    oneline("a ||\n  b", true, "a || b", false, 0)
    oneline("while true\ndo\n  x\ndone", true, "while true; do x; done", false, 0)
    oneline("{{\n a\n}}", true, "{{ a; }}", false, 0)
    oneline("x=$(\n date\n)", true, "x=$( date; )", false, 0)
    oneline("echo a\\ \nb", true, "echo a\\ ; b", false, 0)
    oneline("echo a \\\nb", true, "echo a b", false, 0)
    oneline("echo \"a\nb\"", true, "", true, 1)
    oneline("ls\ncat <<EOF\nx\nEOF", true, "", true, 2)
    oneline("ls # c\n", true, "ls # c", false, 0)
    oneline("ls\n\n", false, "ls", false, 0)
    oneline("a\nb", false, "", true, 1)
    oneline("", true, "", false, 0)
    var out = List[byte]()
    var nul = bytes_of("a\nb")
    (mut nul).push(0 as byte)
    (mut nul).push(99 as byte)
    let (ok, line, why) = edit.cmdedit_oneline(nul, false, mut out)
    assert(!ok, "a NUL refused")
    assert(line == 2, "on line 2: {line}")
    assert(why == "a prompt cannot hold a NUL byte", "why: '{why}'")
}

fn main() {
