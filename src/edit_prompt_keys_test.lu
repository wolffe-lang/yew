fn prompt_keys_shift_motions_extend_the_selection() {
    var ed = init()
    prompt(mut ed, none(), "e alpha beta")
    nosel(ed)
    shift(mut ed, term.KEY_LEFT, 0, "ed.sel.extend.left")
    sel(ed, 11, 12)
    shift(mut ed, term.KEY_RIGHT, 0, "ed.sel.extend.right")
    nosel(ed)
    shift(mut ed, term.KEY_LEFT, term.MOD_ALT, "ed.sel.extend.word_prev")
    sel(ed, 8, 12)
    shift(mut ed, term.KEY_LEFT, term.MOD_ALT, "ed.sel.extend.word_prev")
    sel(ed, 2, 12)
    assert(caret(ed) == 2, "caret 2")
    shift(mut ed, term.KEY_RIGHT, term.MOD_ALT, "ed.sel.extend.word_next")
    sel(ed, 8, 12)
    shift(mut ed, term.KEY_HOME, 0, "ed.sel.extend.line_home")
    sel(ed, 0, 12)
    assert(caret(ed) == 0, "caret 0")
    shift(mut ed, term.KEY_END, 0, "ed.sel.extend.line_end")
    nosel(ed)
    shift(mut ed, term.KEY_LEFT, term.MOD_CTRL, "ed.sel.extend.line_home")
    sel(ed, 0, 12)
    shift(mut ed, term.KEY_RIGHT, term.MOD_CTRL, "ed.sel.extend.line_end")
    nosel(ed)
    assert(caret(ed) == 12, "caret 12")
    assert(ed.cmdline.active, "open")
    expect(ed, "e alpha beta")
}

fn prompt_keys_left_right_collapse_to_the_selection_edges() {
    var ed = init()
    prompt(mut ed, none(), "e alpha beta")
    shift(mut ed, term.KEY_LEFT, term.MOD_ALT, "ed.sel.extend.word_prev")
    run(mut ed, term.KEY_LEFT, 0, "ed.move.char.prev")
    nosel(ed)
    assert(caret(ed) == 8, "to the start")
    shift(mut ed, term.KEY_RIGHT, 0, "ed.sel.extend.right")
    shift(mut ed, term.KEY_RIGHT, 0, "ed.sel.extend.right")
    sel(ed, 8, 10)
    run(mut ed, term.KEY_LEFT, 0, "ed.move.char.prev")
    assert(caret(ed) == 8, "to the start again")
    nosel(ed)
    shift(mut ed, term.KEY_RIGHT, 0, "ed.sel.extend.right")
    shift(mut ed, term.KEY_RIGHT, 0, "ed.sel.extend.right")
    run(mut ed, term.KEY_LEFT, 0, "ed.move.char.prev")
    shift(mut ed, term.KEY_RIGHT, 0, "ed.sel.extend.right")
    shift(mut ed, term.KEY_RIGHT, 0, "ed.sel.extend.right")
    shift(mut ed, term.KEY_LEFT, 0, "ed.sel.extend.left")
    shift(mut ed, term.KEY_LEFT, 0, "ed.sel.extend.left")
    shift(mut ed, term.KEY_LEFT, 0, "ed.sel.extend.left")
    sel(ed, 7, 8)
    run(mut ed, term.KEY_RIGHT, 0, "ed.cmdline.ghost.accept")
    assert(caret(ed) == 8, "to the end")
    nosel(ed)
    shift(mut ed, term.KEY_LEFT, 0, "ed.sel.extend.left")
    shift(mut ed, term.KEY_LEFT, 0, "ed.sel.extend.left")
    sel(ed, 6, 8)
    run(mut ed, ch("b"), term.MOD_CTRL, "ed.move.char.prev")
    assert(caret(ed) == 6, "C-b to the start")
    shift(mut ed, term.KEY_RIGHT, 0, "ed.sel.extend.right")
    sel(ed, 6, 7)
    run(mut ed, ch("f"), term.MOD_CTRL, "ed.cmdline.ghost.accept")
    assert(caret(ed) == 7, "C-f to the end")
    nosel(ed)
    run(mut ed, term.KEY_LEFT, 0, "ed.move.char.prev")
    assert(caret(ed) == 6, "an ordinary motion")
    expect(ed, "e alpha beta")
}

