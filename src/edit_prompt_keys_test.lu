fn prompt_keys_ghost_tab_history_enter_and_cancel_collapse() {
    var ed = init()
    prompt(mut ed, ["!git status"], "!git st")
    shift(mut ed, term.KEY_HOME, 0, "ed.sel.extend.line_home")
    ghost(mut ed, "")
    run(mut ed, term.KEY_RIGHT, 0, "ed.cmdline.ghost.accept")
    nosel(ed)
    expect(ed, "!git st")
    ghost(mut ed, "atus")
    shift(mut ed, term.KEY_LEFT, 0, "ed.sel.extend.left")
    run(mut ed, ch("e"), term.MOD_CTRL, "ed.cmdline.ghost.accept_line")
    nosel(ed)
    expect(ed, "!git st")
    run(mut ed, ch("e"), term.MOD_CTRL, "ed.cmdline.ghost.accept_line")
    expect(ed, "!git status")
    prompt(mut ed, none(), "se")
    shift(mut ed, term.KEY_LEFT, 0, "ed.sel.extend.left")
    run(mut ed, term.KEY_TAB, 0, "ed.cmdline.complete_next")
    nosel(ed)
    assert(edit.cmdline_len(ed) >= 2, "the line kept or completed")
    edit.cmdline_close(mut ed, false)
    prompt(mut ed, ["e older"], "e ")
    shift(mut ed, term.KEY_LEFT, 0, "ed.sel.extend.left")
    run(mut ed, term.KEY_UP, 0, "ed.cmdline.up")
    expect(ed, "e older")
    nosel(ed)
    prompt(mut ed, none(), "set shell.suggest_history all")
    shift(mut ed, term.KEY_LEFT, term.MOD_ALT, "ed.sel.extend.word_prev")
    run(mut ed, term.KEY_ENTER, 0, "ed.cmdline.accept")
    assert(!ed.cmdline.active, "the whole line ran")
    assert((ed.opts.store["shell.suggest_history"] else "") == "all", "and set the option")
    prompt(mut ed, none(), "e x")
    shift(mut ed, term.KEY_LEFT, 0, "ed.sel.extend.left")
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    assert(!ed.cmdline.active, "cancelled")
    assert(ed.mode == edit.MODE_L, "L")
}

