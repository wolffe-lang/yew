//! member: false
//!
//! The port of sagitta `tests/unit/test_prompt_keys.c` (2,860 lines), one
//! test per C test in registry order (`tests/unit/registry.c:118-173`: the
//! 55 `prompt_keys_*` and `cmdedit_oneline_rules`). Every row is driven
//! as REAL keys through `edit.ed_handle_key` in E mode against the loaded
//! runtime (`runtime/init.fl`); modified chords carry no text. C's fixture
//! (`pk_init`, `test_prompt_keys.c:98-107`): the runtime-configured
//! scratch editor, `--clean` (session-lived histories), clipboard sync
//! off, `shell.suggest_history = yew`.
//!
//! What wolf 0.2.33 cannot do here, each named on both streams:
//!  - the subprocess clipboard WRITER (G30, R-yw02-3: no non-blocking
//!    pipe write, no fork) — the cases that wait for the fake tool to
//!    write its file (`pk_clip_holds`) run every other row and SKIP that
//!    one; the `+` register half runs;
//!  - the subprocess clipboard READER (G30, R-yw03-6 = B) — a C-v that
//!    reaches it is REFUSED with C's deferred status and the session is
//!    kept: those rows assert the refusal and SKIP C's pasted text.
//! The `/` and `?` halves run: the search fork's prompt (`edit.searchui`,
//! sagitta Sprint 21) is merged.

use edit
use std.env as std_env
use std.fs
use term
use text

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn say(line: str) {
    print(line)
    eprint(line)
}

fn skip(what: str, why: str) {
    say("prompt_keys_test: SKIP {what}: {why}")
}

fn writer_gap() -> str {
    "the subprocess clipboard writer is G30's gap at wolf 0.2.33 (no non-blocking pipe write, no fork; R-yw02-2/R-yw02-3), so the fake tool never runs"
}

fn reader_gap() -> str {
    "the subprocess clipboard reader is G30's gap at wolf 0.2.33 (R-yw03-6 = B): the paste is refused with C's deferred status and the session kept, asserted"
}

fn runtime() -> List[byte] {
    let bytes = fs_read_bytes("runtime/init.fl") else List[byte]()
    assert(bytes.len != 0, "runtime/init.fl is readable from the repository root")
    bytes
}

fn ch(c: str) -> int {
    c.bytes()[0] as int
}

// `pk_key` (`test_prompt_keys.c:33-45`).
fn pkey(code: int, mods: int) -> term.Key {
    var k = term.key_new()
    k.code = code
    k.kind = term.EV_KEY
    k.ev = term.KEY_PRESS
    k.mods = mods
    if mods == 0 && code < 128 {
        (mut k.text).push(code as byte)
    }
    k
}

// `pk_send` (`test_prompt_keys.c:47-51`).
fn send(mut ed: edit.Ed, code: int, mods: int) {
    edit.ed_handle_key(mut ed, pkey(code, mods), 0)
    if ed.last_status != edit.CMD_OK {
        say("prompt_keys_test: key {code}/{mods}: status {ed.last_status}: '{ed.msg.text}'")
    }
    assert(ed.last_status == edit.CMD_OK, "key {code}/{mods}: status {ed.last_status}")
}

// `pk_run` (`test_prompt_keys.c:53-59`).
fn run(mut ed: edit.Ed, code: int, mods: int, command: str) {
    send(mut ed, code, mods)
    if ed.last_cmd != edit.cmd_lookup(ed.reg, command) {
        say("prompt_keys_test: key {code}/{mods} ran id {ed.last_cmd}, not {command}")
    }
    assert(ed.last_cmd == edit.cmd_lookup(ed.reg, command), "key {code}/{mods} runs {command}")
}

// A key whose command may refuse (`pk_try`, `test_prompt_keys.c:2300-2304`).
fn try_key(mut ed: edit.Ed, code: int, mods: int) {
    edit.ed_handle_key(mut ed, pkey(code, mods), 0)
}

fn type_text(mut ed: edit.Ed, s: str) {
    for b in s.bytes() {
        send(mut ed, b as int, 0)
    }
}

fn set_suggest(mut ed: edit.Ed, v: str) {
    ed.opts.store["shell.suggest_history"] = v
}

// `pk_prompt` (`test_prompt_keys.c:78-96`).
fn prompt(mut ed: edit.Ed, own: List[str], line: str) {
    if ed.cmdline.active {
        run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    }
    assert(ed.mode == edit.MODE_L, "prompt: from L")
    send(mut ed, ch(":"), 0)
    assert(ed.cmdline.active, "prompt: open")
    assert(ed.mode == edit.MODE_E, "prompt: E")
    for o in own {
        edit.hist_add_str(mut ed.cmdline.history, o)
    }
    type_text(mut ed, line)
}

fn none() -> List[str] {
    List[str]()
}

// `pk_init` (`test_prompt_keys.c:98-107`).
fn init() -> edit.Ed {
    var ed = edit.ed_new_test(runtime(), "")
    // C's fixture runs init.fl in the VM, whose `set` of `theme` applies
    // it (`yew_test_load_runtime`); the port's literal reader takes the
    // option, and the theme is applied as the driver does.
    let name = ed.opts.theme
    edit.ed_theme_set(mut ed, name)
    ed.clean = true
    ed.regs.clipboard_sync = text.CLIP_SYNC_OFF
    set_suggest(mut ed, "yew")
    ed
}

fn txt(ed: edit.Ed) -> str {
    str_from_utf8(edit.cmdline_text(ed)) else "<not utf-8>"
}

// `pk_text` (`test_prompt_keys.c:115-125`).
fn expect(ed: edit.Ed, want: str) {
    let got = txt(ed)
    if got != want {
        say("prompt_keys_test: line '{got}', want '{want}'")
    }
    assert(got == want, "line '{got}', want '{want}'")
}

fn caret(ed: edit.Ed) -> int {
    edit.cmdline_caret(ed)
}

// `pk_ghost` (`test_prompt_keys.c:132-144`): "" is C's NULL.
fn ghost(mut ed: edit.Ed, want: str) {
    let g = str_from_utf8(edit.cmdline_ghost(mut ed)) else "<not utf-8>"
    if g != want {
        say("prompt_keys_test: ghost '{g}', want '{want}'")
    }
    assert(g == want, "ghost '{g}', want '{want}'")
}

fn shift(mut ed: edit.Ed, code: int, mods: int, command: str) {
    run(mut ed, code, mods | term.MOD_SHIFT, command)
}

// `pk_sel` / `pk_nosel` (`test_prompt_keys.c:636-650`).
fn sel(ed: edit.Ed, lo: int, hi: int) {
    let (has, sp) = edit.cmdline_selection(ed)
    assert(has, "a selection")
    assert(sp.lo == lo && sp.hi == hi, "selection {sp.lo}..{sp.hi}, want {lo}..{hi}")
    assert(ed.mode == edit.MODE_E, "still E")
}

fn nosel(ed: edit.Ed) {
    let (has, _) = edit.cmdline_selection(ed)
    assert(!has, "no selection")
}

// `pk_paste` (`test_prompt_keys.c:653-658`): a bracketed paste.
fn paste(mut ed: edit.Ed, s: str) {
    edit.ed_handle_paste(mut ed, List[byte](), true, false)
    edit.ed_handle_paste(mut ed, bytes_of(s), false, false)
    edit.ed_handle_paste(mut ed, List[byte](), false, true)
}

fn yank0(ed: edit.Ed) -> str {
    let e = text.yank_at(ed.yank, 0) else List[byte]()
    str_from_utf8(e) else "<not utf-8>"
}

fn reg_seed(mut ed: edit.Ed, name: int, s: str) {
    var v = text.regval_new()
    v.bytes = bytes_of(s)
    text.reg_yank(mut ed.regs, name, v)
}

// One YEW_CLIPBOARD fixture (`PkClip`, `test_prompt_keys.c:675-724`): the
// fake tool behind both halves, the previous value restored after.
struct Clip {
    path: str,
    saved: str,
    had: bool,
}

fn fake_path() -> str {
    let cwd = std_env.cwd() else "."
    "{cwd}/target/oracle/sagitta/build/fakeclip"
}

fn clip_open(bytes: str) -> Clip {
    let saved = env_get("YEW_CLIPBOARD") else "\u{0}"
    let cwd = std_env.cwd() else "."
    let path = "{cwd}/target/tests/yew-pksel-{std_env.pid()}"
    fs.write_text(path, bytes) else |_| {
        assert(false, "clipboard fixture")
    }
    let fake = fake_path()
    env_set("YEW_CLIPBOARD", "cmd:{fake} {path} write|{fake} {path} read") else |_| {}
    Clip { path: path, saved: saved, had: saved != "\u{0}" }
}

fn clip_done(mut ed: edit.Ed, c: Clip) {
    text.clip_reset(mut ed.regs.clip)
    fs.remove(c.path) else |_| {}
    if c.had {
        env_set("YEW_CLIPBOARD", c.saved) else |_| {}
    } else {
        env_unset("YEW_CLIPBOARD") else |_| {}
    }
}

// `pk_plus_holds` (`test_prompt_keys.c:780-788`).
fn plus_holds(mut ed: edit.Ed, want: str) {
    let v = text.reg_get(mut ed.regs, ch("+")) else text.regval_new()
    let got = str_from_utf8(v.bytes) else "<not utf-8>"
    assert(got == want, "+ holds '{got}', want '{want}'")
}

// ------------------------------------------------------------ motions

fn prompt_keys_char_word_and_line_motions() {
    var ed = init()
    prompt(mut ed, none(), "e one two")
    assert(caret(ed) == 9, "end")
    run(mut ed, ch("b"), term.MOD_CTRL, "ed.move.char.prev")
    assert(caret(ed) == 8, "C-b")
    run(mut ed, ch("f"), term.MOD_CTRL, "ed.cmdline.ghost.accept")
    assert(caret(ed) == 9, "C-f")
    run(mut ed, ch("b"), term.MOD_ALT, "ed.move.word.prev")
    assert(caret(ed) == 6, "A-b")
    run(mut ed, term.KEY_LEFT, term.MOD_ALT, "ed.move.word.prev")
    assert(caret(ed) == 2, "A-left")
    run(mut ed, term.KEY_RIGHT, term.MOD_CTRL, "ed.cmdline.ghost.accept_line")
    assert(caret(ed) == 9, "C-right")
    run(mut ed, term.KEY_LEFT, term.MOD_CTRL, "ed.move.line.home")
    assert(caret(ed) == 0, "C-left")
    run(mut ed, ch("e"), term.MOD_CTRL, "ed.cmdline.ghost.accept_line")
    assert(caret(ed) == 9, "C-e")
    run(mut ed, ch("a"), term.MOD_CTRL, "ed.move.line.home")
    assert(caret(ed) == 0, "C-a")
    run(mut ed, ch("f"), term.MOD_ALT, "ed.cmdline.ghost.accept_word")
    assert(caret(ed) == 2, "A-f")
    run(mut ed, term.KEY_RIGHT, term.MOD_ALT, "ed.cmdline.ghost.accept_word")
    assert(caret(ed) == 6, "A-right")
    expect(ed, "e one two")
}

fn prompt_keys_ghost_accept_is_contextual() {
    var ed = init()
    prompt(mut ed, ["!git status --short"], "!git st")
    ghost(mut ed, "atus --short")
    run(mut ed, ch("f"), term.MOD_ALT, "ed.cmdline.ghost.accept_word")
    expect(ed, "!git status ")
    ghost(mut ed, "--short")
    run(mut ed, term.KEY_RIGHT, term.MOD_ALT, "ed.cmdline.ghost.accept_word")
    expect(ed, "!git status --short")
    ghost(mut ed, "")
    prompt(mut ed, none(), "!git st")
    ghost(mut ed, "atus --short")
    run(mut ed, ch("e"), term.MOD_CTRL, "ed.cmdline.ghost.accept_line")
    expect(ed, "!git status --short")
    prompt(mut ed, none(), "!git st")
    run(mut ed, term.KEY_RIGHT, term.MOD_CTRL, "ed.cmdline.ghost.accept_line")
    expect(ed, "!git status --short")
    prompt(mut ed, none(), "!git st")
    run(mut ed, ch("f"), term.MOD_CTRL, "ed.cmdline.ghost.accept")
    expect(ed, "!git status --short")
    prompt(mut ed, none(), "!git st")
    run(mut ed, ch("a"), term.MOD_CTRL, "ed.move.line.home")
    ghost(mut ed, "")
    run(mut ed, ch("f"), term.MOD_ALT, "ed.cmdline.ghost.accept_word")
    assert(caret(ed) > 0 && caret(ed) < 7, "a word right")
    expect(ed, "!git st")
}

// ------------------------------------------------------------ deletes

fn prompt_keys_ctrl_d_and_ctrl_h() {
    var ed = init()
    prompt(mut ed, none(), "abcd")
    run(mut ed, ch("h"), term.MOD_CTRL, "ed.edit.delete.grapheme_left")
    expect(ed, "abc")
    run(mut ed, term.KEY_BACKSPACE, term.MOD_CTRL, "ed.edit.delete.grapheme_left")
    expect(ed, "ab")
    run(mut ed, ch("a"), term.MOD_CTRL, "ed.move.line.home")
    run(mut ed, ch("d"), term.MOD_CTRL, "ed.edit.delete.grapheme")
    expect(ed, "b")
    run(mut ed, ch("d"), term.MOD_CTRL, "ed.edit.delete.grapheme")
    expect(ed, "")
    run(mut ed, ch("d"), term.MOD_CTRL, "ed.edit.delete.grapheme")
    assert(ed.cmdline.active, "still open")
    assert(ed.mode == edit.MODE_E, "still E")
    assert(!ed.quit, "no quit")
}

fn prompt_keys_ctrl_w_is_whitespace_and_alt_bs_is_word() {
    var ed = init()
    prompt(mut ed, none(), "e a/b/c")
    run(mut ed, ch("w"), term.MOD_CTRL, "ed.edit.kill.ws_word_prev")
    expect(ed, "e ")
    prompt(mut ed, none(), "e a/b/c  ")
    run(mut ed, ch("w"), term.MOD_CTRL, "ed.edit.kill.ws_word_prev")
    expect(ed, "e ")
    prompt(mut ed, none(), "e a/b/c")
    run(mut ed, term.KEY_BACKSPACE, term.MOD_ALT, "ed.edit.kill.word_prev")
    expect(ed, "e a/b/")
}

fn prompt_keys_kill_forward_and_to_the_ends() {
    var ed = init()
    prompt(mut ed, none(), "one two three")
    run(mut ed, ch("a"), term.MOD_CTRL, "ed.move.line.home")
    run(mut ed, ch("d"), term.MOD_ALT, "ed.edit.kill.word_next")
    expect(ed, "two three")
    run(mut ed, term.KEY_DELETE, term.MOD_ALT, "ed.edit.kill.word_next")
    expect(ed, "three")
    assert(ed.yank.len == 1, "one joined entry")
    assert(yank0(ed) == "one two ", "the entry: '{yank0(ed)}'")
    prompt(mut ed, none(), "left right")
    run(mut ed, ch("b"), term.MOD_ALT, "ed.move.word.prev")
    run(mut ed, ch("k"), term.MOD_CTRL, "ed.edit.kill.to_end")
    expect(ed, "left ")
    run(mut ed, ch("u"), term.MOD_CTRL, "ed.edit.kill.to_home")
    expect(ed, "")
    assert(yank0(ed) == "left right", "C-k then C-u joined, backward in front: '{yank0(ed)}'")
}

// ----------------------------------------------------- transpose, case

fn prompt_keys_transpose_and_word_case() {
    var ed = init()
    prompt(mut ed, none(), "ab")
    run(mut ed, ch("t"), term.MOD_CTRL, "ed.edit.transpose.chars")
    expect(ed, "ba")
    prompt(mut ed, none(), "one two")
    run(mut ed, ch("b"), term.MOD_ALT, "ed.move.word.prev")
    run(mut ed, ch("t"), term.MOD_ALT, "ed.edit.transpose.words")
    expect(ed, "two one")
    run(mut ed, ch("a"), term.MOD_CTRL, "ed.move.line.home")
    run(mut ed, ch("u"), term.MOD_ALT, "ed.edit.case.upper_word")
    expect(ed, "TWO one")
    run(mut ed, ch("c"), term.MOD_ALT, "ed.edit.case.cap_word")
    expect(ed, "TWO One")
    run(mut ed, ch("a"), term.MOD_CTRL, "ed.move.line.home")
    run(mut ed, ch("l"), term.MOD_ALT, "ed.edit.case.lower_word")
    expect(ed, "two One")
}

// ------------------------------------------------------ yank, yank-pop

fn prompt_keys_yank_then_yank_pop_wraps() {
    var ed = init()
    prompt(mut ed, none(), "one two three")
    run(mut ed, ch("w"), term.MOD_CTRL, "ed.edit.kill.ws_word_prev")
    send(mut ed, term.KEY_BACKSPACE, 0)
    run(mut ed, ch("w"), term.MOD_CTRL, "ed.edit.kill.ws_word_prev")
    send(mut ed, term.KEY_BACKSPACE, 0)
    run(mut ed, ch("w"), term.MOD_CTRL, "ed.edit.kill.ws_word_prev")
    expect(ed, "")
    assert(ed.yank.len == 3, "three entries")
    type_text(mut ed, "x ")
    run(mut ed, ch("y"), term.MOD_CTRL, "ed.edit.kill.yank")
    expect(ed, "x one")
    run(mut ed, ch("y"), term.MOD_ALT, "ed.edit.kill.yank_pop")
    expect(ed, "x two")
    run(mut ed, ch("y"), term.MOD_ALT, "ed.edit.kill.yank_pop")
    expect(ed, "x three")
    assert(caret(ed) == 7, "caret after")
    run(mut ed, ch("y"), term.MOD_ALT, "ed.edit.kill.yank_pop")
    expect(ed, "x one")
}

fn prompt_keys_kills_leave_registers_untouched() {
    var ed = init()
    ed.regs.clipboard_sync = text.CLIP_SYNC_ALL
    reg_seed(mut ed, 0, "unnamed")
    text.clip_reset(mut ed.regs.clip)
    prompt(mut ed, none(), "one two three")
    let before = "{ed.regs}"
    run(mut ed, ch("w"), term.MOD_CTRL, "ed.edit.kill.ws_word_prev")
    run(mut ed, ch("b"), term.MOD_CTRL, "ed.move.char.prev")
    run(mut ed, ch("u"), term.MOD_CTRL, "ed.edit.kill.to_home")
    run(mut ed, ch("k"), term.MOD_CTRL, "ed.edit.kill.to_end")
    run(mut ed, ch("y"), term.MOD_CTRL, "ed.edit.kill.yank")
    run(mut ed, ch("y"), term.MOD_ALT, "ed.edit.kill.yank_pop")
    expect(ed, "three")
    assert("{ed.regs}" == before, "the register file byte-identical")
    assert((str_from_utf8(ed.regs.unnamed.bytes) else "") == "unnamed", "the unnamed register")
    assert(!text.clip_pending(ed.regs.clip), "no clipboard write")
    text.clip_reset(mut ed.regs.clip)
}

fn prompt_keys_yank_pop_without_a_yank() {
    var ed = init()
    prompt(mut ed, none(), "one two")
    run(mut ed, ch("w"), term.MOD_CTRL, "ed.edit.kill.ws_word_prev")
    type_text(mut ed, "z")
    run(mut ed, ch("y"), term.MOD_ALT, "ed.edit.kill.yank_pop")
    expect(ed, "one z")
    assert(ed.msg.active && ed.msg.text.contains("A-y follows a yank"), "the message")
    run(mut ed, ch("y"), term.MOD_CTRL, "ed.edit.kill.yank")
    expect(ed, "one ztwo")
    run(mut ed, ch("b"), term.MOD_CTRL, "ed.move.char.prev")
    run(mut ed, ch("y"), term.MOD_ALT, "ed.edit.kill.yank_pop")
    expect(ed, "one ztwo")
}

fn doc_len(ed: edit.Ed) -> int {
    let b = ed.wins[ed.win].buf
    text.textbuf_len(ed.bufs[b].ec.tb)
}

fn prompt_keys_yank_stack_is_shared_with_insert_mode() {
    var ed = init()
    prompt(mut ed, none(), "e shared")
    run(mut ed, ch("w"), term.MOD_CTRL, "ed.edit.kill.ws_word_prev")
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    assert(ed.mode == edit.MODE_L, "L")
    send(mut ed, ch("i"), 0)
    assert(ed.mode == edit.MODE_I, "I")
    run(mut ed, ch("y"), term.MOD_CTRL, "ed.edit.kill.yank")
    assert(doc_len(ed) == 6, "the kill yanked into the document")
    type_text(mut ed, " more")
    run(mut ed, ch("w"), term.MOD_CTRL, "ed.edit.kill.word_prev")
    send(mut ed, term.KEY_ESCAPE, 0)
    send(mut ed, term.KEY_ESCAPE, 0)
    assert(ed.mode == edit.MODE_L, "L again")
    prompt(mut ed, none(), "")
    run(mut ed, ch("y"), term.MOD_CTRL, "ed.edit.kill.yank")
    expect(ed, "more")
}

fn prompt_keys_yank_folds_newlines_into_the_prompt() {
    var ed = init()
    text.yank_kill(mut ed.yank, bytes_of("a\nb"), text.KILL_FORWARD, 0, 0)
    prompt(mut ed, none(), "")
    run(mut ed, ch("y"), term.MOD_CTRL, "ed.edit.kill.yank")
    expect(ed, "a b")
}

// -------------------------------------------------------------- undo

fn prompt_keys_kill_yank_pop_are_one_undo_step_each() {
    var ed = init()
    prompt(mut ed, none(), "one two")
    run(mut ed, ch("w"), term.MOD_CTRL, "ed.edit.kill.ws_word_prev")
    send(mut ed, term.KEY_BACKSPACE, 0)
    run(mut ed, ch("w"), term.MOD_CTRL, "ed.edit.kill.ws_word_prev")
    expect(ed, "")
    run(mut ed, ch("y"), term.MOD_CTRL, "ed.edit.kill.yank")
    expect(ed, "one")
    run(mut ed, ch("y"), term.MOD_ALT, "ed.edit.kill.yank_pop")
    expect(ed, "two")
    run(mut ed, ch("_"), term.MOD_CTRL, "ed.edit.undo")
    expect(ed, "one")
    run(mut ed, ch("/"), term.MOD_CTRL, "ed.edit.undo")
    expect(ed, "")
    run(mut ed, ch("z"), term.MOD_CTRL, "ed.edit.undo")
    expect(ed, "one")
    run(mut ed, ch("/"), term.MOD_ALT, "ed.edit.redo")
    expect(ed, "")
    run(mut ed, ch("/"), term.MOD_ALT, "ed.edit.redo")
    expect(ed, "one")
}

// --------------------------------------------------------- last argument

fn prompt_keys_last_arg_walks_older_entries() {
    var ed = init()
    prompt(mut ed, ["!ls -la /tmp", "e foo.c", "w ", "!cp a \"my file\""], "e ")
    run(mut ed, ch("."), term.MOD_ALT, "ed.cmdline.last_arg")
    expect(ed, "e \"my file\"")
    run(mut ed, ch("."), term.MOD_ALT, "ed.cmdline.last_arg")
    expect(ed, "e foo.c")
    run(mut ed, ch("."), term.MOD_ALT, "ed.cmdline.last_arg")
    expect(ed, "e /tmp")
    run(mut ed, ch("."), term.MOD_ALT, "ed.cmdline.last_arg")
    expect(ed, "e /tmp")
    type_text(mut ed, " ")
    run(mut ed, ch("."), term.MOD_ALT, "ed.cmdline.last_arg")
    expect(ed, "e /tmp \"my file\"")
}

// ------------------------------------------- literal, register, paste

fn prompt_keys_ctrl_q_inserts_the_next_key_literally() {
    var ed = init()
    prompt(mut ed, none(), "a")
    send(mut ed, ch("q"), term.MOD_CTRL)
    var tab = pkey(term.KEY_TAB, 0)
    (mut tab.text).push(9 as byte)
    edit.ed_handle_key(mut ed, tab, 0)
    assert(ed.last_status == edit.CMD_OK, "ok")
    assert(ed.last_cmd == edit.cmd_lookup(ed.reg, "ed.cmdline.literal_next"), "literal_next ran")
    expect(ed, "a\t")
}

fn prompt_keys_alt_r_inserts_a_register() {
    var ed = init()
    reg_seed(mut ed, ch("a"), "reg")
    prompt(mut ed, none(), "x ")
    send(mut ed, ch("r"), term.MOD_ALT)
    send(mut ed, ch("a"), 0)
    assert(
        ed.last_cmd == edit.cmd_lookup(ed.reg, "ed.cmdline.insert_register"),
        "insert_register ran",
    )
    expect(ed, "x reg")
    send(mut ed, ch("r"), term.MOD_ALT)
    send(mut ed, ch("a"), 0)
    expect(ed, "x regreg")
    run(mut ed, ch("r"), term.MOD_CTRL, "ed.cmdline.hist_search")
    assert(ed.cmdline.hsearch, "C-r is history search")
    run(mut ed, ch("g"), term.MOD_CTRL, "ed.cmdline.cancel")
    expect(ed, "x regreg")
    assert(!ed.cmdline.hsearch, "left")
}

// The C-v rows: the reader refuses (R-yw03-6 = B), the session kept.
fn paste_refused(mut ed: edit.Ed, what: str) {
    try_key(mut ed, ch("v"), term.MOD_CTRL)
    assert(ed.last_cmd == edit.cmd_lookup(ed.reg, "ed.clip.paste"), "{what}: C-v is the paste")
    assert(
        ed.last_status == edit.CMD_ERR_DEFERRED,
        "{what}: refused with C's deferred status ({ed.last_status})",
    )
    // The refusal's message is cleared at once by the prompt's edit hook,
    // as C's is for any failed paste into the prompt (`clear_error` in
    // `yew_cmdline_edited`, `cmdline.c:1102-1110`); the log keeps it.
    assert(ed.cmdline.active && ed.mode == edit.MODE_E, "{what}: the prompt and the session kept")
    skip(what, reader_gap())
}

fn prompt_keys_ctrl_v_pastes_the_system_clipboard() {
    var ed = init()
    let c = clip_open("git log\n--oneline")
    text.clip_reset(mut ed.regs.clip)
    prompt(mut ed, none(), "!")
    paste_refused(mut ed, "prompt_keys_ctrl_v_pastes_the_system_clipboard")
    expect(ed, "!")
    clip_done(mut ed, c)
}

