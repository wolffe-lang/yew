//! ws.fl_emit — byte-exact pure literals, without the Fletch VM.
//! sagitta 9ace98c2 src/ws/fl_emit.c:42-237; shipping key policy and root
//! scalar punctuation from src/fl/data.c:195-281,302-373.

/// Owned byte output and balanced construction stack; misuse traps.
pub struct FlEmit {
    bytes: List[byte],
    containers: List[int],
    started: bool,
}

/// Starts one canonical literal document.
pub fn fl_emit() -> FlEmit {
    FlEmit { bytes: List[byte](), containers: List[int](), started: false }
}

fn fl_emit_text(mut e: FlEmit, s: str) {
    for c in s.bytes() { (mut e.bytes).push(c) }
}

fn fl_emit_indent(mut e: FlEmit) {
    var i = 0
    while i < e.containers.len { fl_emit_text(mut e, "  "); i += 1 }
}

fn fl_emit_string_span(mut e: FlEmit, src: List[byte], span: FlSpan) {
    (mut e.bytes).push(34 as byte)
    var i = 0
    while i < span.len {
        let c = src[span.at + i] as int
        if c == 34 {
            fl_emit_text(mut e, "\\\"")
        } else if c == 92 {
            fl_emit_text(mut e, "\\\\")
        } else if c == 10 {
            fl_emit_text(mut e, "\\n")
        } else if c == 9 {
            fl_emit_text(mut e, "\\t")
        } else if c == 13 {
            fl_emit_text(mut e, "\\r")
        } else if c == 0 {
            fl_emit_text(mut e, "\\0")
        } else if c < 32 || c == 127 {
            fl_emit_text(mut e, "\\x")
            (mut e.bytes).push("0123456789abcdef".bytes()[c / 16])
            (mut e.bytes).push("0123456789abcdef".bytes()[c % 16])
        } else {
            (mut e.bytes).push(c as byte)
        }
        i += 1
    }
    (mut e.bytes).push(34 as byte)
}

fn fl_bare_key(src: List[byte], span: FlSpan) -> bool {
    if span.len == 0 { return false }
    let first = src[span.at] as int
    if !(first >= 97 && first <= 122 || first == 95) { return false }
    var i = 1
    while i < span.len {
        let c = src[span.at + i] as int
        if !(c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 95) { return false }
        i += 1
    }
    true
}

fn fl_emit_prefix(mut e: FlEmit, has_key: bool, src: List[byte], key: FlSpan) {
    if e.containers.len == 0 {
        assert(!e.started && !has_key, "literal emitter: invalid root")
        e.started = true
    } else {
        assert(
            has_key == (e.containers[e.containers.len - 1] == FL_MAP),
            "literal emitter: key/container mismatch",
        )
    }
    fl_emit_indent(mut e)
    if has_key {
        if fl_bare_key(src, key) {
            var i = 0
            while i < key.len { (mut e.bytes).push(src[key.at + i]); i += 1 }
        } else {
            fl_emit_string_span(mut e, src, key)
        }
        fl_emit_text(mut e, ": ")
    }
}

fn fl_emit_end_value(mut e: FlEmit) {
    if e.containers.len > 0 { (mut e.bytes).push(44 as byte) }
    (mut e.bytes).push(10 as byte)
}

fn fl_emit_open_span(mut e: FlEmit, has_key: bool, src: List[byte], key: FlSpan, kind: int) {
    fl_emit_prefix(mut e, has_key, src, key)
    fl_emit_text(mut e, if kind == FL_MAP then "{{\n" else "[\n")
    (mut e.containers).push(kind)
}

/// Opens a map. has_key distinguishes a map key (even empty) from no key.
pub fn fl_map_open(mut e: FlEmit, has_key: bool, key: List[byte]) {
    fl_emit_open_span(mut e, has_key, key, FlSpan { at: 0, len: key.len }, FL_MAP)
}

/// Opens a list. has_key distinguishes a map key from a list/root value.
pub fn fl_list_open(mut e: FlEmit, has_key: bool, key: List[byte]) {
    fl_emit_open_span(mut e, has_key, key, FlSpan { at: 0, len: key.len }, FL_LIST)
}

fn fl_emit_close(mut e: FlEmit, kind: int) {
    let actual = (mut e.containers).pop() else -1
    assert(actual == kind, "literal emitter: unmatched close")
    fl_emit_indent(mut e)
    (mut e.bytes).push((if kind == FL_MAP then 125 else 93) as byte)
    fl_emit_end_value(mut e)
}

/// Closes the current map; an unmatched close traps.
pub fn fl_map_close(mut e: FlEmit) { fl_emit_close(mut e, FL_MAP) }

/// Closes the current list; an unmatched close traps.
pub fn fl_list_close(mut e: FlEmit) { fl_emit_close(mut e, FL_LIST) }

/// Emits signed decimal i64; invalid key/container balance traps.
pub fn fl_int(mut e: FlEmit, has_key: bool, key: List[byte], value: int) {
    fl_emit_prefix(mut e, has_key, key, FlSpan { at: 0, len: key.len })
    fl_emit_text(mut e, "{value}")
    fl_emit_end_value(mut e)
}

/// Emits true/false; invalid key/container balance traps.
pub fn fl_bool(mut e: FlEmit, has_key: bool, key: List[byte], value: bool) {
    fl_emit_prefix(mut e, has_key, key, FlSpan { at: 0, len: key.len })
    fl_emit_text(mut e, if value then "true" else "false")
    fl_emit_end_value(mut e)
}

/// Emits nil, distinct from an empty string; invalid balance traps.
pub fn fl_nil(mut e: FlEmit, has_key: bool, key: List[byte]) {
    fl_emit_prefix(mut e, has_key, key, FlSpan { at: 0, len: key.len })
    fl_emit_text(mut e, "nil")
    fl_emit_end_value(mut e)
}

/// Emits byte string with frozen escapes; invalid balance traps.
pub fn fl_str(mut e: FlEmit, has_key: bool, key: List[byte], value: List[byte]) {
    fl_emit_prefix(mut e, has_key, key, FlSpan { at: 0, len: key.len })
    fl_emit_string_span(mut e, value, FlSpan { at: 0, len: value.len })
    fl_emit_end_value(mut e)
}

struct FlEmitFrame {
    node: int,
    next: int,
}

fn fl_emit_node(
    mut e: FlEmit,
    has_key: bool,
    keys: List[byte],
    key: FlSpan,
    doc: FlDoc,
    node: int,
) {
    let kind = doc.nodes[node].kind
    if kind == FL_LIST || kind == FL_MAP {
        fl_emit_open_span(mut e, has_key, keys, key, kind)
        return
    }
    fl_emit_prefix(mut e, has_key, keys, key)
    if kind == FL_STR {
        fl_emit_string_span(mut e, doc.bytes, doc.nodes[node].text)
    } else if kind == FL_INT {
        fl_emit_text(mut e, "{doc.nodes[node].num}")
    } else if kind == FL_BOOL {
        fl_emit_text(mut e, if doc.nodes[node].num != 0 then "true" else "false")
    } else {
        assert(kind == FL_NIL, "literal emitter: invalid kind")
        fl_emit_text(mut e, "nil")
    }
    fl_emit_end_value(mut e)
}

/// Emits a retained subtree, preserving its map order and arbitrary key bytes.
pub fn fl_emit_lit(mut e: FlEmit, has_key: bool, key: List[byte], doc: FlDoc, node: int) {
    fl_emit_lit_span(mut e, has_key, key, FlSpan { at: 0, len: key.len }, doc, node)
}

fn fl_emit_lit_span(
    mut e: FlEmit,
    has_key: bool,
    key: List[byte],
    span: FlSpan,
    doc: FlDoc,
    node: int,
) {
    assert(node >= 0 && node < doc.nodes.len, "literal emitter: invalid node")
    fl_emit_node(mut e, has_key, key, span, doc, node)
    var stack = List[FlEmitFrame]()
    if doc.nodes[node].kind >= FL_LIST { (mut stack).push(FlEmitFrame { node: node, next: 0 }) }
    while stack.len > 0 {
        let top = stack.len - 1
        let parent = stack[top].node
        let i = stack[top].next
        let kind = doc.nodes[parent].kind
        if i == doc.nodes[parent].items.len {
            fl_emit_close(mut e, kind)
            let _ = (mut stack).pop() else FlEmitFrame { node: 0, next: 0 }
            continue
        }
        stack[top].next += 1
        let child = doc.nodes[parent].items[i]
        var span = FlSpan { at: 0, len: 0 }
        if kind == FL_MAP { span = copy doc.nodes[parent].keys[i] }
        fl_emit_node(mut e, kind == FL_MAP, doc.bytes, span, doc, child)
        if doc.nodes[child].kind >= FL_LIST { (mut stack).push(FlEmitFrame { node: child, next: 0 }) }
    }
}

/// Consumes a finished emitter; missing root/unbalanced containers trap.
pub fn fl_emit_finish(take e: FlEmit) -> List[byte] {
    assert(e.started && e.containers.len == 0, "literal emitter: unbalanced document")
    e.bytes
}

/// Canonicalizes a valid document without changing map order or byte values.
pub fn fl_reemit(doc: FlDoc) -> List[byte] {
    var e = fl_emit()
    fl_emit_lit(mut e, false, "".bytes(), doc, doc.root)
    fl_emit_finish(take e)
}
