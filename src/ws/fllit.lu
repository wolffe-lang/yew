//! ws.fllit — six-kind byte literals and ordered node pools.
//! sagitta 9ace98c2 src/ws/fllit.h:46-112, state_lit.c:9-62.
//! The yw06 hand-codec interim; yw09 replaces the implementation, not v1.

/// Nil literal tag.
pub const FL_NIL: int = 0

/// Boolean literal tag; num is zero or one.
pub const FL_BOOL: int = 1

/// Signed 64-bit integer literal tag.
pub const FL_INT: int = 2

/// Arbitrary byte string literal tag.
pub const FL_STR: int = 3

/// Ordered list literal tag.
pub const FL_LIST: int = 4

/// Insertion-ordered byte-key map literal tag.
pub const FL_MAP: int = 5

/// Inclusive source byte limit (8 MiB).
pub const FL_MAX_BYTES: int = 8388608

/// Inclusive parser node budget, including every map key.
pub const FL_MAX_NODES: int = 1000000

/// Inclusive container nesting limit.
pub const FL_MAX_DEPTH: int = 32

/// Inclusive decoded string byte limit.
pub const FL_MAX_STRING: int = 4096

/// Byte range in a document byte pool; never a Unicode slice.
pub struct FlSpan {
    at: int,
    len: int,
}

/// One literal; keys parallel items only for map nodes.
pub struct FlLit {
    kind: int,
    num: int,
    text: FlSpan,
    items: List[int],
    keys: List[FlSpan],
}

/// All spans address bytes, all node indices address nodes. Maps retain order.
pub struct FlDoc {
    nodes: List[FlLit],
    bytes: List[byte],
    root: int,
}

/// First parse failure: absolute byte offset and one-based line/column.
pub struct FlParseErr {
    off: int,
    line: int,
    col: int,
    msg: str,
}

/// An explicit result keeps the first positional error without exceptions.
pub struct FlParseResult {
    ok: bool,
    doc: FlDoc,
    err: FlParseErr,
}

/// Constructs an empty node pool; root -1 until parsed.
pub fn fl_doc() -> FlDoc {
    FlDoc { nodes: List[FlLit](), bytes: List[byte](), root: -1 }
}

fn fl_node(mut doc: FlDoc, kind: int, num: int, text: FlSpan) -> int {
    let id = doc.nodes.len
    (mut doc.nodes).push(FlLit {
        kind: kind,
        num: num,
        text: text,
        items: List[int](),
        keys: List[FlSpan](),
    })
    id
}

/// Compares valid byte ranges without allocating; invalid spans trap.
pub fn fl_span_equal(a: List[byte], x: FlSpan, b: List[byte], y: FlSpan) -> bool {
    if x.len != y.len { return false }
    var i = 0
    while i < x.len {
        if a[x.at + i] != b[y.at + i] { return false }
        i += 1
    }
    true
}

/// Returns the matching map child; none for absent key or wrong kind.
pub fn fl_get(doc: FlDoc, node: int, key: List[byte]) -> int ! {none} {
    if node < 0 || node >= doc.nodes.len || doc.nodes[node].kind != FL_MAP {
        return none
    }
    var i = 0
    while i < doc.nodes[node].items.len {
        if fl_span_equal(doc.bytes, doc.nodes[node].keys[i], key, FlSpan { at: 0, len: key.len }) {
            return doc.nodes[node].items[i]
        }
        i += 1
    }
    none
}

/// Returns an indexed child; none for wrong kind or out-of-range index.
pub fn fl_at(doc: FlDoc, node: int, i: int) -> int ! {none} {
    if node < 0 || node >= doc.nodes.len || i < 0 { return none }
    if doc.nodes[node].kind != FL_LIST && doc.nodes[node].kind != FL_MAP { return none }
    doc.nodes[node].items.get(i)?
}

/// Child count for map/list, zero for absent or scalar node.
pub fn fl_len(doc: FlDoc, node: int) -> int {
    if node < 0 || node >= doc.nodes.len { return 0 }
    if doc.nodes[node].kind != FL_LIST && doc.nodes[node].kind != FL_MAP { return 0 }
    doc.nodes[node].items.len
}

/// Reads an integer or returns the default for absent/wrong-typed nodes.
pub fn fl_int_or(doc: FlDoc, node: int, dflt: int) -> int {
    if node >= 0 && node < doc.nodes.len && doc.nodes[node].kind == FL_INT {
        return doc.nodes[node].num
    }
    dflt
}

/// Reads a boolean or returns the default for absent/wrong-typed nodes.
pub fn fl_bool_or(doc: FlDoc, node: int, dflt: bool) -> bool {
    if node >= 0 && node < doc.nodes.len && doc.nodes[node].kind == FL_BOOL {
        return doc.nodes[node].num != 0
    }
    dflt
}

/// Returns the string span; none for absent/wrong-typed nodes.
pub fn fl_string_span(doc: FlDoc, node: int) -> FlSpan ! {none} {
    if node < 0 || node >= doc.nodes.len || doc.nodes[node].kind != FL_STR { return none }
    copy doc.nodes[node].text
}

/// Copy out only when ownership is needed; otherwise lend doc.bytes + span.
pub fn fl_string_bytes(doc: FlDoc, node: int) -> List[byte] ! {none} {
    let span = fl_string_span(doc, node)?
    doc.bytes[span.at..span.at + span.len]
}
