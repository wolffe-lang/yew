//! member: false
//!
//! The port of sagitta `tests/unit/test_narrow.c` (545 lines), one test
//! per C test in registry order (`tests/unit/registry.c:2524-2534`): THE
//! property (DoD 7) — 10,000 random (pattern, appended byte) pairs over a
//! 5,000-item corpus, the narrowed result equal to a full rescan exactly,
//! and the narrow scoring exactly the candidate set — then the work
//! counts, backspace and a mid-line edit rescanning everything, a sliced
//! rescan equal to an unsliced one, a usable monotone count mid-pass, the
//! window agreeing with `ws.fz_rank`, the empty pattern's source order,
//! an item-count change, and the degenerate inputs.
//!
//! The port's shapes. C's `nw_make` corpus (`:50-80`) is the same LCG
//! and the same `"%s/%s%u.%s"` labels. A full rescan from scratch
//! (`nw_full`, `:83-97`) builds a fresh filter: here inside a `copy
//! region` that answers only the comparison, so 10,000 of them keep
//! nothing (G33). C's global `g_scored` is the filter's own `scored`,
//! reset on the state it reads. C's NULL filter and NULL items
//! (`:536-543`) have no wolf shape; their halves — an empty item list, a
//! zero window — are asserted.
//!
//! `YEW_PICK_CASE=N` runs case N alone (the checked machine's per-case
//! run, G29).

use edit
use ws

fn b(s: str) -> List[byte] {
    var v = List[byte]()
    for x in s.bytes() {
        (mut v).push(x)
    }
    v
}

fn lcg(r: wrapping[u64]) -> wrapping[u64] {
    r * 6364136223846793005 + 1442695040888963407
}

// `nw_make` (`test_narrow.c:50-80`).
fn nw_make(n: int, seed: int) -> List[edit.PickItem] {
    var dirs = List[str]()
    for d in "src|src/ui|src/ws|tests|tests/unit|docs|vendor/lib".split("|") {
        (mut dirs).push(d)
    }
    var stems = List[str]()
    for s in "tabs|picker|filter|walk|state|undo|grid|alpha|beta|gamma".split("|") {
        (mut stems).push(s)
    }
    var exts = List[str]()
    for e in "c|h|md|txt".split("|") {
        (mut exts).push(e)
    }
    var rng = seed as wrapping[u64]
    var items = List[edit.PickItem]()
    var i = 0
    while i < n {
        rng = lcg(rng)
        let d = dirs[((rng >> 33) % 7) as int]
        let s = stems[((rng >> 21) % 10) as int]
        let k = ((rng >> 11) % 1000) as int
        let e = exts[((rng >> 7) % 4) as int]
        (mut items).push(edit.pick_item("{d}/{s}{k}.{e}", i, 0))
        i += 1
    }
    items
}

// `nw_full` (`test_narrow.c:83-97`) compared with `got`: a fresh filter
// applied in ONE step from the empty pattern, so it cannot narrow. Only
// the verdict leaves the region.
fn nw_full_equals(
    items: List[edit.PickItem],
    path_mode: bool,
    pat: List[byte],
    plen: int,
    got: edit.TopK,
) -> str {
    copy region full {
        var fresh = edit.filter_new()
        edit.filter_reset(mut fresh, items, items.len, 0)
        let _ = edit.filter_apply(mut fresh, items, items.len, path_mode, pat, plen, 0)
        var want = edit.topk_new()
        let n_want = edit.filter_top_into(fresh, items, path_mode, mut want, edit.FILTER_TOPK)
        var why = ""
        if got.n != n_want {
            why = "narrowed {got.n} rows, full {n_want}"
        } else {
            var k = 0
            while k < n_want {
                if got.idx[k] != want.idx[k] || got.score[k] != want.score[k] {
                    why = "row {k}: narrowed idx={got.idx[k]} score={got.score[k]}, full idx={want.idx[k]} score={want.score[k]}"
                    break
                }
                k += 1
            }
        }
        why
    }
}

// `nw_full` (`test_narrow.c:83-97`) as rows.
fn nw_full(
    items: List[edit.PickItem],
    path_mode: bool,
    pat: List[byte],
    plen: int,
) -> List[ws.FzRanked] {
    var fresh = edit.filter_new()
    edit.filter_reset(mut fresh, items, items.len, 0)
    let _ = edit.filter_apply(mut fresh, items, items.len, path_mode, pat, plen, 0)
    edit.filter_top(fresh, items, path_mode, edit.FILTER_TOPK)
}

// `test_narrow_equals_a_full_rescan` (`:108-198`).
fn narrow_equals_a_full_rescan() {
    let alphabet = "abcdefgpstuw./0123456789"
    let items = nw_make(5000, 12345)
    var fs = edit.filter_new()
    var got = edit.topk_new()
    var rng: wrapping[u64] = 11400714819323198485
    var extensions = 0
    var narrowed_cases = 0
    var pat = List[byte]()
    var k = 0
    while k < 8 {
        (mut pat).push(0 as byte)
        k += 1
    }
    var trial = 0
    while trial < 10000 {
        // A base pattern of 0-3 characters...
        rng = lcg(rng)
        var plen = ((rng >> 33) % 4) as int
        k = 0
        while k < plen {
            rng = lcg(rng)
            pat[k] = alphabet.bytes()[((rng >> 29) % 24) as int]
            k += 1
        }
        // ...applied fresh, then EXTENDED by one character.
        edit.filter_reset(mut fs, items, items.len, 0)
        let _ = edit.filter_apply(mut fs, items, items.len, true, pat, plen, 0)
        rng = lcg(rng)
        pat[plen] = alphabet.bytes()[((rng >> 29) % 24) as int]
        plen += 1
        let before_append = edit.filter_matched(fs)
        fs.scored = 0
        let _ = edit.filter_apply(mut fs, items, items.len, true, pat, plen, 0)
        // It scored EXACTLY the candidate set.
        assert(fs.scored == before_append, "trial {trial}: scored {fs.scored}, set {before_append}")
        extensions += 1
        if before_append < items.len {
            narrowed_cases += 1
        }
        let _ = edit.filter_top_into(fs, items, true, mut got, edit.FILTER_TOPK)
        let why = nw_full_equals(items, true, pat, plen, got)
        assert(why.len == 0, "trial {trial}: {why}")
        trial += 1
    }
    assert(extensions == 10000, "extensions {extensions}")
    assert(narrowed_cases > 7000, "narrowed cases {narrowed_cases}")
}

// `test_narrow_append_scores_only_the_candidate_set` (`:209-237`).
fn narrow_append_scores_only_the_candidate_set() {
    let items = nw_make(5000, 999)
    var fs = edit.filter_new()
    edit.filter_reset(mut fs, items, items.len, 0)
    fs.scored = 0
    let _ = edit.filter_apply(mut fs, items, items.len, true, b("s"), 1, 0)
    assert(fs.scored == items.len, "the first key scores everything: {fs.scored}")
    let after_first = edit.filter_matched(fs)
    assert(after_first > 0 && after_first < items.len, "a strict subset: {after_first}")
    fs.scored = 0
    let _ = edit.filter_apply(mut fs, items, items.len, true, b("st"), 2, 0)
    assert(fs.scored == after_first, "only the survivors: {fs.scored} of {after_first}")
    assert(edit.filter_matched(fs) <= after_first, "the set only shrinks")
}

// `test_narrow_backspace_rescans_everything` (`:245-265`).
fn narrow_backspace_rescans_everything() {
    let items = nw_make(2000, 4242)
    var fs = edit.filter_new()
    edit.filter_reset(mut fs, items, items.len, 0)
    let _ = edit.filter_apply(mut fs, items, items.len, true, b("sta"), 3, 0)
    let narrow_matched = edit.filter_matched(fs)
    fs.scored = 0
    let _ = edit.filter_apply(mut fs, items, items.len, true, b("st"), 2, 0)
    assert(fs.scored == items.len, "the whole set: {fs.scored}")
    assert(edit.filter_matched(fs) >= narrow_matched, "the list grew back")
}

// `test_narrow_mid_edit_rescans_everything` (`:269-284`).
fn narrow_mid_edit_rescans_everything() {
    let items = nw_make(1000, 7)
    var fs = edit.filter_new()
    edit.filter_reset(mut fs, items, items.len, 0)
    let _ = edit.filter_apply(mut fs, items, items.len, true, b("abc"), 3, 0)
    fs.scored = 0
    let _ = edit.filter_apply(mut fs, items, items.len, true, b("abd"), 3, 0)
    assert(fs.scored == items.len, "the whole set: {fs.scored}")
}

fn same_rows(got: List[ws.FzRanked], want: List[ws.FzRanked], scores: bool) -> bool {
    if got.len != want.len {
        return false
    }
    var k = 0
    while k < got.len {
        if got[k].idx != want[k].idx {
            return false
        }
        if scores && got[k].score != want[k].score {
            return false
        }
        k += 1
    }
    true
}

// `test_narrow_sliced_rescan_equals_unsliced` (`:297-327`).
fn narrow_sliced_rescan_equals_unsliced() {
    let items = nw_make(20000, 31337)
    var sliced = edit.filter_new()
    edit.filter_reset(mut sliced, items, items.len, 0)
    let _ = edit.filter_apply(mut sliced, items, items.len, true, b("sc"), 2, 1)
    var steps = 0
    while edit.filter_step(mut sliced, items, true, 1) {
        steps += 1
        if steps >= 100000 {
            break
        }
    }
    assert(steps < 100000, "never loops")
    let got = edit.filter_top(sliced, items, true, edit.FILTER_TOPK)
    let want = nw_full(items, true, b("sc"), 2)
    assert(same_rows(got, want, true), "sliced equals unsliced")
}

// `test_narrow_partial_scan_has_a_usable_count` (`:338-392`).
fn narrow_partial_scan_has_a_usable_count() {
    let items = nw_make(50000, 5)
    var fs = edit.filter_new()
    edit.filter_reset(mut fs, items, items.len, 0)
    let pending = !edit.filter_apply(mut fs, items, items.len, true, b("s"), 1, 1)
    assert(pending, "a 1 us budget stops almost immediately")
    var monotone = true
    var steps = 0
    if pending {
        let seen_partial = edit.filter_matched(fs)
        assert(seen_partial <= items.len, "a usable count")
        let partial = edit.filter_top(fs, items, true, edit.FILTER_TOPK)
        assert(partial.len <= edit.FILTER_TOPK, "drawable mid-pass")
        var last = seen_partial
        while edit.filter_step(mut fs, items, true, 1) {
            let now_matched = edit.filter_matched(fs)
            monotone = monotone && now_matched >= last
            last = now_matched
            steps += 1
            if steps >= 200000 {
                break
            }
        }
    }
    assert(monotone, "monotone")
    assert(steps < 200000, "never loops")
    let whole = nw_full(items, true, b("s"), 1)
    let done = edit.filter_top(fs, items, true, edit.FILTER_TOPK)
    assert(same_rows(done, whole, false), "the finished answer equals an unsliced one")
}

// `test_narrow_top_agrees_with_yew_fz_rank` (`:405-437`).
fn narrow_top_agrees_with_yew_fz_rank() {
    let items = nw_make(500, 2024)
    var fs = edit.filter_new()
    edit.filter_reset(mut fs, items, items.len, 0)
    let _ = edit.filter_apply(mut fs, items, items.len, true, b("tab"), 3, 0)
    let top = edit.filter_top(fs, items, true, edit.FILTER_TOPK)
    var labels = List[List[byte]]()
    for it in items {
        (mut labels).push(b(it.label))
    }
    let pat = b("tab")
    let ranked = ws.fz_rank(pat, 0, 3, labels, true)
    assert(
        edit.filter_matched(fs) == ranked.len,
        "matched {edit.filter_matched(fs)}, ranked {ranked.len}",
    )
    var i = 0
    while i < top.len {
        assert(top[i].idx == ranked[i].idx, "row {i} idx")
        assert(top[i].score == ranked[i].score, "row {i} score")
        i += 1
    }
}

// `test_narrow_empty_pattern_keeps_source_order` (`:449-472`).
fn narrow_empty_pattern_keeps_source_order() {
    let items = nw_make(100, 11)
    var fs = edit.filter_new()
    edit.filter_reset(mut fs, items, items.len, 0)
    assert(edit.filter_matched(fs) == 100, "everything matches")
    let top = edit.filter_top(fs, items, true, edit.FILTER_TOPK)
    assert(top.len == edit.FILTER_TOPK, "a full window")
    var i = 0
    while i < top.len {
        assert(top[i].score == 1, "the empty-pattern score")
        assert(top[i].idx == i, "source order at {i}")
        i += 1
    }
}

// `test_narrow_empty_pattern_agrees_with_yew_fz_rank` (`:479-505`).
fn narrow_empty_pattern_agrees_with_yew_fz_rank() {
    let items = nw_make(200, 77)
    var fs = edit.filter_new()
    edit.filter_reset(mut fs, items, items.len, 0)
    let top = edit.filter_top(fs, items, true, edit.FILTER_TOPK)
    var labels = List[List[byte]]()
    for it in items {
        (mut labels).push(b(it.label))
    }
    let ranked = ws.fz_rank(List[byte](), 0, 0, labels, true)
    var i = 0
    while i < top.len {
        assert(top[i].idx == ranked[i].idx, "row {i}")
        i += 1
    }
}

// `test_narrow_item_count_change_forces_a_rescan` (`:511-527`).
fn narrow_item_count_change_forces_a_rescan() {
    let items = nw_make(100, 3)
    var fs = edit.filter_new()
    edit.filter_reset(mut fs, items, items.len, 0)
    let _ = edit.filter_apply(mut fs, items, items.len, true, b("s"), 1, 0)
    fs.scored = 0
    let _ = edit.filter_apply(mut fs, items, 50, true, b("s"), 1, 0)
    assert(fs.scored == 50, "fifty scored: {fs.scored}")
    assert(edit.filter_matched(fs) <= 50, "at most fifty")
}

// `test_narrow_degenerate_inputs` (`:530-545`): the NULL rows have no
// wolf shape (the header).
fn narrow_degenerate_inputs() {
    var fs = edit.filter_new()
    let none = List[edit.PickItem]()
    edit.filter_reset(mut fs, none, 0, 0)
    assert(edit.filter_apply(mut fs, none, 0, false, b("a"), 1, 0), "complete over nothing")
    assert(!edit.filter_step(mut fs, none, false, 0), "nothing to step")
    assert(edit.filter_matched(fs) == 0, "nothing matched")
    assert(edit.filter_top(fs, none, false, 4).len == 0, "an empty window")
    assert(edit.filter_top(fs, none, false, 0).len == 0, "a zero window")
}

fn main() {
    let chosen = (env_get("YEW_PICK_CASE") else "-1").to_int() else -1
    var n = 0
    if chosen < 0 || chosen == 0 {
        narrow_equals_a_full_rescan()
        print("narrow_equals_a_full_rescan: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 1 {
        narrow_append_scores_only_the_candidate_set()
        print("narrow_append_scores_only_the_candidate_set: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 2 {
        narrow_backspace_rescans_everything()
        print("narrow_backspace_rescans_everything: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 3 {
        narrow_mid_edit_rescans_everything()
        print("narrow_mid_edit_rescans_everything: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 4 {
        narrow_sliced_rescan_equals_unsliced()
        print("narrow_sliced_rescan_equals_unsliced: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 5 {
        narrow_partial_scan_has_a_usable_count()
        print("narrow_partial_scan_has_a_usable_count: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 6 {
        narrow_top_agrees_with_yew_fz_rank()
        print("narrow_top_agrees_with_yew_fz_rank: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 7 {
        narrow_empty_pattern_keeps_source_order()
        print("narrow_empty_pattern_keeps_source_order: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 8 {
        narrow_empty_pattern_agrees_with_yew_fz_rank()
        print("narrow_empty_pattern_agrees_with_yew_fz_rank: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 9 {
        narrow_item_count_change_forces_a_rescan()
        print("narrow_item_count_change_forces_a_rescan: PASS")
        n += 1
    }
    if chosen < 0 || chosen == 10 {
        narrow_degenerate_inputs()
        print("narrow_degenerate_inputs: PASS")
        n += 1
    }
    print("narrow_test: {n} cases pass")
}
