//! member: false
//! Initial integration witnesses; full pinned test_fl_vm.c port pending.

use fl

fn eval(mut vm: fl.FlVm, text: str) -> fl.FlValue {
    var src = List[byte]()
    for b in text.bytes() { (mut src).push(b) }
    let p = fl.fl_parse(src, 0, mut vm.dc, mut vm.strings)
    assert(!p.had_error)
    let f = fl.fl_compile(mut vm, p, 0, fl.fl_origin_new(4, 0)) else {
        for d in vm.dc.entries { eprint(d.msg) }
        fl.fl_nil()
    }
    assert(f.t == 7)
    fl.fl_vm_run(mut vm, f)
}

fn want(src: str, expected: int) {
    region run {
        var strings = fl.fl_strings()
        var vm = fl.fl_vm_new(take strings)
        let v = eval(mut vm, src)
        if vm.raised { eprint("raised: {src}") }
        assert(!vm.raised && v.t == 2 && v.i == expected)
    }
}

fn main() {
    want("return 2 + 3 * 4\n", 14)
    want("return 9223372036854775807 + 1\n", -9223372036854775807 - 1)
    want(
        "fn fib(n) {{ if n < 2 {{ return n }}\nreturn fib(n - 1) + fib(n - 2) }}\nreturn fib(10)\n",
        55,
    )
    want(
        "fn make() {{ let x = 1\nreturn fn() {{ x = x + 1\nreturn x }} }}\nlet f = make()\nf()\nreturn f()\n",
        3,
    )
    want("let x = 0\nfor k, v in [5, 7, 9] {{ x = x + k + v }}\nreturn x\n", 24)
    want("let x = 0\nfor c in \"aé\" {{ x = x + 1 }}\nreturn x\n", 2)
    want("try {{ return 1 / 0 }} catch e {{ return 44 }}\n", 44)
    want("let m = {{a: 2, b: 9}}\nm.a = 5\nreturn m.a + m[\"b\"]\n", 14)
    want(
        "fn a(n) {{ return fn() {{ return fn() {{ n = n + 1\nreturn n }} }} }}\nlet b = a(8)\nlet c = b()\nreturn c()\n",
        9,
    )
    want(
        "let total = 0\nfor x in [1,2,3] {{ if x == 2 {{ continue }}\ntotal = total + x }}\nreturn total\n",
        4,
    )
    print("PASS fl_vm initial integration 10")
}
