// wolf.pkg — yew, the editor, as a wolf package (`[pkg.manifest]`).
//
// No dependency but the pinned std tree (wolf-toolchain.toml `[std]`,
// staged by tools/fetch-toolchain and passed as WOLF_STD): yew has none
// but libc in C and none but wolf-std here (track rule 3). The entry is
// `src/yew.lu` (`//! member: false`); every directory under `src/` is a
// module of the port, named as sagitta's `src/` directory is.
pkg {
    name:    "wolffe-lang/yew",
    version: "0.0.0",
    edition: "1",
}
