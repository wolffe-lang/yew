{
  "revision": "9ace98c2adfeb9d63e7da4bdb4fd6e29ae5c3e4a",
  "reason": "Read on after the reap for an expected output a guard sibling writes after the death (yew#124), without changing the C editor, the cases or their goldens.",
  "files": {
    "tests/pty/harness.c": {
      "before_sha256": "fde2b46d312c61b44890dac358b7a5822e106248cbc5d2cde8ebcc54322e1459",
      "old": [
        "void ptc_expect_output(PtyCtx *c, const void *bytes, size_t len)",
        "{",
        "    if (c == NULL || bytes == NULL || c->failed)",
        "        return;",
        "    if (find_bytes(c->raw.data, c->raw.len, bytes, len) == NULL) {",
        "        /* Name the run.  \"bytes were not observed\" over seven",
        "         * assertions in one case says nothing about which. */",
        "        char shown[64];",
        "        size_t i;",
        "        size_t n = len < sizeof(shown) / 4U ? len : sizeof(shown) / 4U - 1U;",
        "        size_t at = 0U;",
        "",
        "        for (i = 0U; i < n; i++) {",
        "            u8 b = ((const u8 *)bytes)[i];",
        "",
        "            if (b >= 0x20U && b < 0x7FU)",
        "                shown[at++] = (char)b;",
        "            else",
        "                at += (size_t)snprintf(shown + at, sizeof(shown) - at,",
        "                                       \"\\\\x%02x\", (unsigned)b);",
        "        }",
        "        shown[at] = '\\0';",
        "        ptc_fail(c, \"expected output |%s| was not observed\", shown);",
        "    }",
        "}"
      ],
      "new": [
        "/* yew adaptation (yew#124): an outside SIGSEGV, SIGBUS or SIGKILL runs no",
        " * code of the process it kills, so a guard sibling that still holds the",
        " * terminal restores it after the death, and its bytes can land after the",
        " * reap's one read.  When the expected bytes are not captured yet and the",
        " * child has been reaped, read on until they arrive, the terminal's last",
        " * holder closes it (EOF), or 2000 ms pass.  Returns why the wait ended:",
        " * 0 no wait, 1 the bytes arrived, 2 EOF, 3 the deadline. */",
        "static int wait_for_output_after_reap(PtyCtx *c, const void *bytes,",
        "                                      size_t len)",
        "{",
        "    i64 deadline = ptc_now_ms() + 2000;",
        "",
        "    if (!c->pty.reaped || c->eof)",
        "        return 0;",
        "    if (deadline > case_deadline(c))",
        "        deadline = case_deadline(c);",
        "    while (!c->failed && !c->eof && ptc_now_ms() < deadline) {",
        "        struct pollfd fd = {c->pty.master, POLLIN | POLLHUP, 0};",
        "        bool activity = false;",
        "",
        "        (void)poll(&fd, 1U, 10);",
        "        (void)read_available(c, &activity);",
        "        if (find_bytes(c->raw.data, c->raw.len, bytes, len) != NULL)",
        "            return 1;",
        "    }",
        "    return c->eof ? 2 : 3;",
        "}",
        "",
        "void ptc_expect_output(PtyCtx *c, const void *bytes, size_t len)",
        "{",
        "    int waited = 0;",
        "",
        "    if (c == NULL || bytes == NULL || c->failed)",
        "        return;",
        "    if (find_bytes(c->raw.data, c->raw.len, bytes, len) == NULL)",
        "        waited = wait_for_output_after_reap(c, bytes, len);",
        "    if (find_bytes(c->raw.data, c->raw.len, bytes, len) == NULL) {",
        "        /* Name the run.  \"bytes were not observed\" over seven",
        "         * assertions in one case says nothing about which. */",
        "        char shown[64];",
        "        size_t i;",
        "        size_t n = len < sizeof(shown) / 4U ? len : sizeof(shown) / 4U - 1U;",
        "        size_t at = 0U;",
        "",
        "        for (i = 0U; i < n; i++) {",
        "            u8 b = ((const u8 *)bytes)[i];",
        "",
        "            if (b >= 0x20U && b < 0x7FU)",
        "                shown[at++] = (char)b;",
        "            else",
        "                at += (size_t)snprintf(shown + at, sizeof(shown) - at,",
        "                                       \"\\\\x%02x\", (unsigned)b);",
        "        }",
        "        shown[at] = '\\0';",
        "        ptc_fail(c, \"expected output |%s| was not observed%s\", shown,",
        "                 waited == 2 ? \" after the terminal closed\" :",
        "                 waited == 3 ? \" after a 2000 ms wait past the reap\" : \"\");",
        "    }",
        "}"
      ]
    }
  }
}
