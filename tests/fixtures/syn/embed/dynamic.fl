{ syntax: 1, language: { name: "embed-dynamic" },
  contexts: {
    main: { rules: [ { match: "a", attr: "punct", push: ["c1", "c2", "c3", "c4"] } ] },
    c1: { at_eol: "pop:1", rules: [] },
    c2: { at_eol: "pop:1", rules: [] },
    c3: { at_eol: "pop:1", rules: [] },
    c4: { at_eol: "pop:1", rules: [
      { match: "<([a-z]+)", attr: "punct", push: "bridge",
        embed: { lang: "@1", end: "inline", fallback: "code" } },
    ] },
    bridge: { default: "code", rules: [
      { match: ">", attr: "punct", pop: 1, end: true },
    ] },
  } }
