{ syntax: 1, language: { name: "embed-unknown" },
  contexts: {
    main: { rules: [
      { match: "<", attr: "punct", push: "bridge",
        embed: { lang: "nosuch", end: "inline", fallback: "code" } },
    ] },
    bridge: { default: "code", rules: [
      { match: ">", attr: "punct", pop: 1, end: true },
    ] },
  } }
