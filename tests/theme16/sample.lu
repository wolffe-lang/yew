//! THEME16_SAMPLE documentation
// regular comment
#[trace]
pub struct Shade { value: int }
const LIMIT = 42
fn shade(self, plain_word: int) -> int {
    if true { plain_word }
    let text = "green\n{plain_word}"
    let raw = r#"raw"#
    let general = path"literal"
    let bad = "\q" // intentional error-colour witness
    let result = shade(plain_word) + LIMIT
    result.method()
    unsafe c { char c = 'x'; /* neutral code */ }
    select { from item => plain_word }
    asm { in reg("rax") plain_word }
    assume noalias
    copy plain_word
}
// THEME16_END
