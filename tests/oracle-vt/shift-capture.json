{
  "revision": "9ace98c2adfeb9d63e7da4bdb4fd6e29ae5c3e4a",
  "reason": "Record non-visual Shift mouse capture requests without changing the C editor or its goldens.",
  "files": {
    "tests/pty/vt.c": {
      "before_sha256": "80aaae8ba44d70522146623bfcf14afd44ed7edd286ba85d8c56f4766cd4802c",
      "old": [
        "    } else if ((final == 'h' || final == 'l') && exact(body, nbody, \"?1004\")) {",
        "        set_mode(v, VT_MODE_FOCUS, final == 'h');"
      ],
      "new": [
        "    } else if (false && final == 's' && nbody == 2u && body[0] == '>' &&",
        "               (body[1] == '0' || body[1] == '1')) {",
        "        /* XTSHIFTESCAPE is non-visual. Keep state and ordering evidence. */",
        "        u32 mouse = VT_MODE_BUTTON_MOUSE | VT_MODE_ANY_MOTION_MOUSE;",
        "        if (body[1] == '1') {",
        "            v->nshift_requests++;",
        "            v->shift_request_modes = v->modes;",
        "            if ((v->modes & mouse) == 0u || (v->modes & VT_MODE_SGR_MOUSE) == 0u)",
        "                v->nshift_early_requests++;",
        "            v->shift_capture = true;",
        "        } else {",
        "            v->nshift_resets++;",
        "            if (v->shift_capture) {",
        "                v->shift_reset_modes = v->modes;",
        "                if ((v->modes & mouse) == 0u || (v->modes & VT_MODE_SGR_MOUSE) == 0u)",
        "                    v->nshift_late_resets++;",
        "            }",
        "            v->shift_capture = false;",
        "        }",
        "    } else if ((final == 'h' || final == 'l') && exact(body, nbody, \"?1004\")) {",
        "        set_mode(v, VT_MODE_FOCUS, final == 'h');"
      ]
    },
    "tests/pty/vt.h": {
      "before_sha256": "1c42b504a26b1485a3dbaaadc447929f1dd08022a5566c65b98525cdbc82aae8",
      "old": [
        "    u32 modes;",
        "    u32 kitty[8];"
      ],
      "new": [
        "    u32 modes;",
        "    /* Non-visual XTSHIFTESCAPE state, not part of golden snapshots. */",
        "    bool shift_capture;",
        "    u32 nshift_requests;",
        "    u32 nshift_resets;",
        "    u32 shift_request_modes;",
        "    u32 shift_reset_modes;",
        "    u32 nshift_early_requests;",
        "    u32 nshift_late_resets;",
        "    u32 kitty[8];"
      ]
    }
  }
}
